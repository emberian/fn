;;; Physical compression performer. All spans and completion policy are ACL2-owned.
(in-package "ACL2")
(load "host/deflate.lisp")
(defstruct fn2-native-compress
 (transport (create-fn2-compress-transport)) seed input output)

(defun fn2-native-compress-handle (compression)
 (sb-sys:int-sap (fn2-compress-transport-handle (fn2-native-compress-transport compression))))

(defun fn2-native-compress-channel (channel host compression)
 (case channel
  (1 (fn2-native-compress-seed compression))
  (2 (fn2-native-compress-input compression))
  (3 (fn2-native-compress-output compression))
  ((4 5) (fn2-nhost-bytes host))
  (otherwise (error "fn2 compression: no selected byte channel ~S" channel))))

(defun fn2-native-compress-record-step (host slot compression cap)
 (let ((op (aref (fn2-nhost-ops host) slot)))
  (multiple-value-bind (status completed action source in-offset in-count sink out-offset out-count serial record transport)
      (fn2-host-compress-record-next slot (fn2-nop-gen op)
       (fn2-native-compress-op-record op) (fn2-native-compress-transport compression) (fn2-nhost-core host))
   (setf (fn2-nop-compress-record op) record (fn2-native-compress-transport compression) transport)
   (unless (eq status :act)
    (return-from fn2-native-compress-record-step (values status completed)))
   (case action
    ((10 11)
     (let ((input (fn2-native-compress-channel source host compression))
           (output (fn2-native-compress-channel sink host compression)))
      (sb-sys:with-pinned-objects (input output)
       (fn2-n-boundary host "compress-transform")
       (multiple-value-bind (raw used made)
           (fn2-native-deflate-step (fn2-native-compress-handle compression) (if (= action 11) 1 0)
            (sb-sys:sap+ (sb-sys:vector-sap input) in-offset) in-count
            (sb-sys:sap+ (sb-sys:vector-sap output) out-offset) out-count)
        (multiple-value-bind (observed record transport)
            (fn2-compress-record-observe (fn2-nop-cap op) (fn2-nop-nonce op) slot (fn2-nop-gen op)
             serial raw used made 0 record transport)
         (setf (fn2-nop-compress-record op) record (fn2-native-compress-transport compression) transport)
         (unless (member observed '(:progress :need-input :need-output :final :failed))
          (error "fn2 compression: selected transform observation refused: ~S" observed))
         (multiple-value-bind (effect relative-offset effect-count address)
             (fn2-host-compress-input-prefix slot (fn2-nop-gen op) serial action made record transport
                                            (fn2-nhost-core host))
          (case effect
           (:input-prefix (fn2-n-record host (list :input-prefix slot (fn2-nop-gen op)
                             relative-offset effect-count (fn2-n-octets host address effect-count))))
           (:none nil)
           (otherwise (error "fn2 compression: accepted input effect refused: ~S" effect))))
         ;; NEXT, not the physical performer, decides the terminal app prefix.
         (values :progress 0))))))
    ((5 6)
     (if (fn2-ncap-tls cap)
         (multiple-value-bind (status count)
             (fn2-native-tls-child-step host slot (fn2-ncap-tls cap) (fn2-ncap-fd cap)
              transport (fn2-native-compress-input compression) (fn2-native-compress-output compression))
          (multiple-value-bind (observed record transport)
              (fn2-compress-record-carrier-observe status count record transport)
           (setf (fn2-nop-compress-record op) record (fn2-native-compress-transport compression) transport)
           (unless (member observed '(:progress :blocked :failed))
            (error "fn2 compression: selected child settlement refused: ~S" observed))
           (values :progress 0)))
       (let ((input (fn2-native-compress-input compression))
             (output (fn2-native-compress-output compression)))
        (sb-sys:with-pinned-objects (input output)
         (fn2-n-boundary host "compress-carrier")
         (multiple-value-bind (raw errno)
             (case action
              (5 (fn2-native-send (fn2-ncap-fd cap) (sb-sys:sap+ (sb-sys:vector-sap output) in-offset) in-count))
              (6 (fn2-native-recv (fn2-ncap-fd cap) (sb-sys:sap+ (sb-sys:vector-sap input) out-offset) out-count)))
          (multiple-value-bind (observed record transport)
              (fn2-compress-record-socket-observe raw errno record transport)
           (setf (fn2-nop-compress-record op) record (fn2-native-compress-transport compression) transport)
           (unless (member observed '(:progress :blocked :failed))
            (error "fn2 compression: selected child settlement refused: ~S" observed))
           (values :progress 0)))))))
    (otherwise (error "fn2 compression: unselected physical action ~S" action))))))

(defun fn2-native-compress-start (host slot iq oq ratio burst capacity)
 ;; Scalars come from startup settings; no profile traversal on this path.
 (let ((op (aref (fn2-nhost-ops host) slot)))
  (multiple-value-bind (code cap nonce address length)
       (fn2-host-compress-start-op slot (fn2-nop-gen op) (fn2-nhost-core host))
    (declare (ignore address))
    (unless (eq code :ok) (return-from fn2-native-compress-start (values code nil)))
    (let ((compression (make-fn2-native-compress)))
     (multiple-value-bind (code transport)
         (fn2-compress-transport-start cap nonce slot (fn2-nop-gen op) length capacity iq oq ratio burst
                                      (fn2-native-compress-transport compression))
      (setf (fn2-native-compress-transport compression) transport)
      (unless (eq code :ok) (return-from fn2-native-compress-start (values code nil)))
      (setf (fn2-native-compress-seed compression)
            (make-array capacity :element-type '(unsigned-byte 8) :initial-element 0)
            (fn2-native-compress-input compression)
            (make-array iq :element-type '(unsigned-byte 8) :initial-element 0)
            (fn2-native-compress-output compression)
            (make-array oq :element-type '(unsigned-byte 8) :initial-element 0))
      (values :ok compression))))))

(defun fn2-native-compress-upgrade-step (host slot compression)
 ;; Exactly one selected allocate/copy/free action. Handoff is logical and once.
 (let ((op (aref (fn2-nhost-ops host) slot)))
  (multiple-value-bind (code cap nonce address length)
      (fn2-host-compress-start-op slot (fn2-nop-gen op) (fn2-nhost-core host))
   (declare (ignore length))
   (unless (eq code :ok) (return-from fn2-native-compress-upgrade-step (values code 0)))
   (multiple-value-bind (status action offset count serial transport)
       (fn2-compress-transport-next 0 0 (fn2-native-compress-transport compression))
    (setf (fn2-native-compress-transport compression) transport)
    (when (eq status :done)
     (multiple-value-bind (code copied fed il io ol oo transport)
         (fn2-compress-transport-handoff cap nonce slot (fn2-nop-gen op) transport)
      (declare (ignore fed il io ol oo))
      (setf (fn2-native-compress-transport compression) transport)
      (return-from fn2-native-compress-upgrade-step (values (if (eq code :ok) :done code) copied))))
    (unless (member status '(:act :cleanup))
     (return-from fn2-native-compress-upgrade-step (values status 0)))
    (fn2-n-boundary host "compress-upgrade")
    (let ((raw
           (case action
            (8 (sb-sys:sap-int (fn2-deflate-%new)))
            (1 (replace (fn2-native-compress-seed compression) (fn2-nhost-bytes host)
                 :start1 offset :end1 (+ offset count)
                 :start2 (+ address offset) :end2 (+ address offset count)) count)
            (9 (fn2-deflate-%free (fn2-native-compress-handle compression)) 0)
            (otherwise (error "fn2 compression: unselected upgrade action ~S" action)))))
     (multiple-value-bind (observed kick transport)
         (fn2-compress-transport-observe-lifecycle cap nonce slot (fn2-nop-gen op) serial raw 0 0 transport)
      (declare (ignore kick))
      (setf (fn2-native-compress-transport compression) transport)
      (values observed 0)))))))

(defun fn2-native-compress-settings (profile)
 ;; Called only while opening the host, before any connection is admitted.
 (multiple-value-bind (code iq oq ratio burst capacity) (fn2-host-compress-settings profile)
  (when (eq code :ok)
   (let* ((path (or (sb-ext:posix-getenv "FN2_DEFLATE_LIBRARY")
                   #+darwin "build/lib/libfn2-deflate.dylib" #-darwin "build/lib/libfn2-deflate.so"))
          (prepared (sb-ext:run-program "python3"
                      (list "tools/fn_admin.py" "__prepare-native-deflate" path)
                      :search t :wait t :output *standard-output* :error *error-output*)))
    (unless (eql (sb-ext:process-exit-code prepared) 0)
     (error "fn2 native: selected compression library preparation refused"))
    (sb-alien:load-shared-object path)))
  (values code iq oq ratio burst capacity)))

(defun fn2-native-compress-op-record (op)
 (or (fn2-nop-compress-record op)
     (setf (fn2-nop-compress-record op) (create-fn2-compress-operation))))

(defun fn2-native-compress-wait (op compression tls)
 (let ((record (fn2-native-compress-op-record op)))
  (if (and compression tls)
      (fn2-compress-record-stack-wait record (fn2-native-compress-transport compression)
       (fn2-native-tls-transport tls) (fn2-nop-tls-record op))
    (fn2-compress-record-wait record))))

(defun fn2-native-compress-close (host compression tls cap nonce)
 (when compression
  ;; Only the logical parent owner may settle an unfinished TLS child.
  (multiple-value-bind (code owner generation)
      (fn2-host-compress-close-owner cap nonce (fn2-native-compress-transport compression) (fn2-nhost-core host))
   (case code
    (:done nil)
    (:child
     (unless tls (error "fn2 compression: child has no retired lower carrier"))
     (let ((op (aref (fn2-nhost-ops host) owner)))
      (multiple-value-bind (settled record transport)
          (fn2-host-compress-close-child owner generation (fn2-native-compress-op-record op)
           (fn2-native-compress-transport compression) (fn2-native-tls-transport tls)
           (fn2-nop-tls-record op) (fn2-nhost-core host))
       (setf (fn2-nop-compress-record op) record (fn2-native-compress-transport compression) transport)
       (unless (eq settled :ok) (error "fn2 compression: closed child settlement refused: ~S" settled)))))
    (otherwise (error "fn2 compression: close owner refused: ~S" code))))
  (multiple-value-bind (code transport)
      (fn2-compress-transport-retire cap nonce (fn2-native-compress-transport compression))
   (setf (fn2-native-compress-transport compression) transport)
   (case code
    (:done nil)
    (:closing
     (multiple-value-bind (selected action offset count serial transport)
         (fn2-compress-transport-next 0 0 transport)
      (declare (ignore offset count))
      (setf (fn2-native-compress-transport compression) transport)
      (unless (and (eq selected :cleanup) (= action 9)) (error "fn2 compression: reserved cleanup refused"))
      (fn2-n-boundary host "compress-free")
      (fn2-deflate-%free (fn2-native-compress-handle compression))
      (multiple-value-bind (observed kick transport)
          (fn2-compress-transport-observe-lifecycle cap nonce
           (fn2-compress-transport-slot 0 transport) (fn2-compress-transport-generation 0 transport)
           serial 0 0 0 transport)
       (declare (ignore kick))
       (setf (fn2-native-compress-transport compression) transport)
       (unless (eq observed :ok) (error "fn2 compression: physical free observation refused: ~S" observed)))))
    (otherwise (error "fn2 compression: retirement refused: ~S" code))))))

(defun fn2-native-compress-mark-closed (host slot compression)
 (let ((op (aref (fn2-nhost-ops host) slot)))
  (multiple-value-bind (code record)
      (fn2-host-compress-mark-closed slot (fn2-nop-gen op)
       (fn2-native-compress-transport compression) (fn2-native-compress-op-record op) (fn2-nhost-core host))
   (setf (fn2-nop-compress-record op) record)
   (unless (member code '(:ok :kind :child :too-late))
    (error "fn2 compression: closed public loan refused: ~S" code)))))

(defun fn2-native-compress-cancel-result (host slot other)
 (when (fn2-nop-compress-record other)
  (let ((cancel (aref (fn2-nhost-ops host) slot)))
   (multiple-value-bind (decision target code count won address record)
       (fn2-host-compress-cancel-result slot (fn2-nop-gen cancel)
        (fn2-nop-compress-record other) (fn2-nhost-core host))
    (setf (fn2-nop-compress-record other) record)
    (case decision
     ((:productive :cancelled)
      (fn2-n-complete host target code count 0 nil
       (and (eq decision :productive) (fn2-n-octets host address count)))
      (fn2-n-complete host slot :ok 0 0 won) t)
     ((:unbound :kind) nil)
     (:too-late (fn2-n-complete host slot :ok 0 0 nil) t)
     (otherwise (error "fn2 compression: deferred cancellation refused: ~S" decision)))))))

(defun fn2-n-compress-ready (host slot cap)
 ;; One selected physical action per scheduler turn. NEXT owns terminal counts.
 (let* ((op (aref (fn2-nhost-ops host) slot))
        (startp (= (fn2-nop-kind op) *fn2-action-compress-start*)))
  (unless (fn2-ncap-compress cap)
   (unless (and startp (fn2-nhost-compress-settings host))
    (fn2-n-complete host slot :failed 0)
    (return-from fn2-n-compress-ready nil))
   (multiple-value-bind (code compression)
       (apply #'fn2-native-compress-start host slot (fn2-nhost-compress-settings host))
    (unless (eq code :ok)
     (fn2-n-complete host slot :failed 0)
     (return-from fn2-n-compress-ready nil))
    (setf (fn2-ncap-compress cap) compression)))
  (if startp
      (multiple-value-bind (status copied)
          (fn2-native-compress-upgrade-step host slot (fn2-ncap-compress cap))
       (case status
        (:done (fn2-n-complete host slot :ok copied))
        ((:ok :closing) nil)
        (:failed (fn2-n-complete host slot :failed 0))
        (otherwise (error "fn2 compression: upgrade authorization/controller refused: ~S" status))))
    (multiple-value-bind (status count)
        (fn2-native-compress-record-step host slot (fn2-ncap-compress cap) cap)
     (case status
      (:done
       (cond ((= (fn2-nop-kind op) *fn2-action-receive*) (incf (fn2-ncap-rx cap) count))
             ((= (fn2-nop-kind op) *fn2-action-send*) (incf (fn2-ncap-tx cap) count)))
       (fn2-n-complete host slot :ok count 0 nil (fn2-n-octets host (fn2-nop-address op) count)))
      (:eof (setf (fn2-ncap-eof cap) t)
            (fn2-n-complete host slot :eof count 0 nil (fn2-n-octets host (fn2-nop-address op) count)))
      (:failed (fn2-n-complete host slot :failed count 0 nil (fn2-n-octets host (fn2-nop-address op) count)))
      ((:progress :pending :blocked) nil)
      (otherwise (error "fn2 compression: record authorization/controller refused: ~S" status)))))))

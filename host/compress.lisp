;;; Physical compression performer. All spans and completion policy are ACL2-owned.
(in-package "ACL2")
(load "host/deflate.lisp")
(defstruct fn2-native-compress
 (transport (create-fn2-compress-transport)) seed input output)

(defun fn2-native-compress-open (capacity input-quantum output-quantum)
 (make-fn2-native-compress
  :seed (make-array capacity :element-type '(unsigned-byte 8) :initial-element 0)
  :input (make-array input-quantum :element-type '(unsigned-byte 8) :initial-element 0)
  :output (make-array output-quantum :element-type '(unsigned-byte 8) :initial-element 0)))

(defun fn2-native-compress-handle (compression)
 (sb-sys:int-sap (fn2-compress-transport-handle (fn2-native-compress-transport compression))))

(defun fn2-native-compress-channel (channel host compression)
 (case channel
  (1 (fn2-native-compress-seed compression))
  (2 (fn2-native-compress-input compression))
  (3 (fn2-native-compress-output compression))
  ((4 5) (fn2-nhost-bytes host))
  (otherwise (error "fn2 compression: no selected byte channel ~S" channel))))

(defun fn2-native-compress-record-step (host slot compression cap)
 (let ((op (aref (fn2-nhost-ops host) slot)))
  (unless (fn2-nop-compress-record op)
   (setf (fn2-nop-compress-record op) (create-fn2-compress-operation)))
  (multiple-value-bind (status completed action source in-offset in-count sink out-offset out-count serial record transport)
      (fn2-host-compress-record-next slot (fn2-nop-gen op)
       (fn2-nop-compress-record op) (fn2-native-compress-transport compression) (fn2-nhost-core host))
   (setf (fn2-nop-compress-record op) record (fn2-native-compress-transport compression) transport)
   (unless (eq status :act)
    (return-from fn2-native-compress-record-step (values status completed)))
   (case action
    ((10 11)
     (let ((input (fn2-native-compress-channel source host compression))
           (output (fn2-native-compress-channel sink host compression)))
      (sb-sys:with-pinned-objects (input output)
       (fn2-n-boundary host "compress-transform")
       (multiple-value-bind (raw used made)
           (fn2-native-deflate-step (fn2-native-compress-handle compression) (if (= action 11) 1 0)
            (sb-sys:sap+ (sb-sys:vector-sap input) in-offset) in-count
            (sb-sys:sap+ (sb-sys:vector-sap output) out-offset) out-count)
        (multiple-value-bind (observed record transport)
            (fn2-compress-record-observe (fn2-nop-cap op) (fn2-nop-nonce op) slot (fn2-nop-gen op)
             serial raw used made 0 record transport)
         (setf (fn2-nop-compress-record op) record (fn2-native-compress-transport compression) transport)
         (values observed 0))))))
    ((5 6)
     (if (fn2-ncap-tls cap)
         (multiple-value-bind (status count)
             (fn2-native-tls-child-step host slot (fn2-ncap-tls cap) (fn2-ncap-fd cap)
              transport (fn2-native-compress-input compression) (fn2-native-compress-output compression))
          (multiple-value-bind (observed record transport)
              (fn2-compress-record-carrier-observe status count 0 record transport)
           (setf (fn2-nop-compress-record op) record (fn2-native-compress-transport compression) transport)
           (values observed 0)))
       (let ((input (fn2-native-compress-input compression))
             (output (fn2-native-compress-output compression)))
        (sb-sys:with-pinned-objects (input output)
         (fn2-n-boundary host "compress-carrier")
         (multiple-value-bind (raw errno)
             (case action
              (5 (fn2-native-send (fn2-ncap-fd cap) (sb-sys:sap+ (sb-sys:vector-sap output) in-offset) in-count))
              (6 (fn2-native-recv (fn2-ncap-fd cap) (sb-sys:sap+ (sb-sys:vector-sap input) out-offset) out-count)))
          (multiple-value-bind (observed record transport)
              (fn2-compress-record-socket-observe raw errno record transport)
           (setf (fn2-nop-compress-record op) record (fn2-native-compress-transport compression) transport)
           (values observed 0)))))))
    (otherwise (error "fn2 compression: unselected physical action ~S" action))))))

; Read-only operation diagnostics. No payloads, credentials or prepared graph.
; Call under the same owner/extent observation span as the genuine operation.
(in-package "ACL2")
(include-book "owner-host")
(include-book "../books/history-event-backing")
(include-book "../books/history-semantic-writer-state")
(defun fn-owner-history-operation-observe (fn-history-backing fn-page-read-pool state)
 (declare (xargs :stobjs (fn-history-backing fn-page-read-pool state) :mode :program))
 (let* ((current (fn-apr-owner-current state))
        (token (fn-prl-nth 0 current))
        (fault (and (boundp-global 'fn-owner-history-completion-fault state)
                    (f-get-global 'fn-owner-history-completion-fault state)))
        (source (fn-hep-current fn-history-backing))
        (reason (cond (fault :recovery-required)
                      ((null current) :operation-not-issued)
                      (t (fn-owner-history-writer-gate token state)))))
  (mv reason (and (fn-apr-tokenp token) token) (fn-prl-nth 2 current)
      (fn-hep-producer-phase fn-history-backing)
      (fn-owner-canonical-epoch state)
      (and (natp (fn-hed-at 1 source)) (fn-hed-at 1 source))
      (and (natp (fn-hed-at 8 source)) (fn-hed-at 8 source))
      (fn-prl-nth 5 token)
      (fn-prp-alloc-mode fn-page-read-pool)
      (fn-prp-alloc-allocated fn-page-read-pool)
      (fn-prp-alloc-active-turns fn-page-read-pool)
      (and (fn-apr-naturals 5 (fn-prl-nth 1 current)) (fn-prl-nth 1 current))
      (and (symbolp fault) fault))))

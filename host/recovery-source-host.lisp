; PRF-1149: actual cold authority is issued from successful loader STATE.
; This source WIP is not activated until the loader generation/region and
; one-pass SSR carry companion are installed. No caller supplies final count.
(in-package "ACL2")
(include-book "../books/recovery-source-authority")
(include-book "../books/recovery-open-origin")
(include-book "../books/store-node")
(include-book "../books/identity-context-size")
(include-book "../books/owner-canonical-state")
(include-book "store-checkpoint-context-host")

(defun fn-owner-recovery-global (key state)
  (declare (xargs :stobjs state :mode :program))
  (and (boundp-global key state) (f-get-global key state)))

(defun fn-owner-recovery-records-formp (field)
 (declare (xargs :mode :program))
 (if (fn-sfr-basedp field)
     (or (null (fn-sfr-suffix field)) (fn-sl-snoc-formp (fn-sfr-suffix field)))
   (or (null field) (fn-sl-snoc-formp field))))

; Completion generation belongs to the accepted open, not the loader when
; no checkpoint was selected. No borrowed Store graph is compared here.
(defun fn-owner-recovery-source-generation-value (c state)
 (declare (xargs :stobjs state :mode :program))
 (if (fn-rsoa-originp (fn-omk-at 3 c))
     (fn-omk-at 1 (fn-owner-recovery-global 'fn-store-recovery-open-origin state))
   (fn-store-sco-recovery-source-generation-value state)))

(defun fn-owner-recovery-source-currentp-value (c token state)
 (declare (xargs :stobjs state :mode :program))
 (let* ((origin (fn-omk-at 3 c))
        (current (fn-owner-recovery-global 'fn-store-recovery-open-origin state))
        (epoch (fn-owner-canonical-epoch state))
        (generation (fn-owner-recovery-source-generation-value c state)))
  (and (fn-rsa-currentp c token epoch generation)
       (if (fn-rsoa-originp origin)
           (and (fn-rsoa-originp current)
                (equal (fn-omk-at 1 current) (fn-omk-at 1 origin))
                (equal (fn-omk-at 2 current) epoch)
                (eq (fn-omk-at 3 current) (fn-omk-at 3 origin)))
         (fn-rsa-metap (fn-store-sco-recovery-source-value state))))))

; Called only by the successful full-row open branch. The record form gate
; prevents the legacy raw-list count accessor from scanning the history.
(defun fn-store-recovery-open-mark (state)
 (declare (xargs :stobjs state :mode :program))
 (let* ((st (fn-owner-recovery-global 'fn-store-sn state))
        (files (fn-sn-files st)) (field (fn-sf-records-field files))
        (old (fn-owner-recovery-global 'fn-store-recovery-open-next-generation state))
        (generation (if (boundp-global 'fn-store-recovery-open-next-generation state) old 0)))
  (if (not (and (natp generation) (eq (fn-sf-phase files) :recovering)
                (fn-owner-recovery-records-formp field)))
      (let ((state (f-put-global 'fn-store-recovery-open-origin nil state)))
       (value :unavailable))
    (let* ((count (fn-sf-records-count files))
           (origin (list :completed-store-open generation
                         (fn-owner-canonical-epoch state)
                         (if (equal count 0) :empty-initialized :full-log-replay) st))
           (state (f-put-global 'fn-store-recovery-open-next-generation (+ 1 generation) state))
           (state (f-put-global 'fn-store-recovery-open-origin origin state)))
     (value :recorded)))))

; Same-pass completion input: actual SSR identity and its parallel metadata.
; This issues source custody, not canonical/account readiness or funding.
(defun fn-owner-recovery-source-complete-open (ctx fields status state)
 (declare (xargs :stobjs state :mode :program))
 (let* ((origin (fn-owner-recovery-global 'fn-store-recovery-open-origin state))
        (st (fn-owner-recovery-global 'fn-store-sn state)) (files (fn-sn-files st))
        (field (fn-sf-records-field files)) (epoch (fn-owner-canonical-epoch state))
        (prior (fn-owner-recovery-global 'fn-owner-recovery-source state))
        (oldticket (fn-owner-recovery-global 'fn-owner-recovery-next-ticket state))
        (ticket (if (boundp-global 'fn-owner-recovery-next-ticket state) oldticket 0)))
  (if (not (and (fn-rsoa-originp origin) (natp ticket)
                (equal (fn-omk-at 2 origin) epoch)
                (member-eq (fn-sf-phase files) '(:recovering :ready))
                (fn-owner-recovery-records-formp field)
                (not (and (fn-rsoa-originp (fn-omk-at 3 prior))
                          (equal (fn-omk-at 1 (fn-omk-at 3 prior))
                                 (fn-omk-at 1 origin))))))
      (value '(:unavailable :completed-open))
   (let ((count (fn-sf-records-count files)) (frontier (fn-sf-frontier files)))
    (mv-let (actualctx actualfields)
            (if (equal count 0) (fn-ics-begin 0) (mv ctx fields))
     (let* ((carried (and (or (equal count 0) (eq status :carried))
                          (fn-scs-fixed-carriesp 6 actualfields))))
      (mv-let (word next) (fn-rsoa-begin ticket epoch origin actualctx count frontier)
       (if (not (eq word :issued)) (value '(:unavailable :completed-open-lineage))
        (let* ((token (fn-rsa-token next))
               (state (f-put-global 'fn-owner-recovery-next-ticket (+ 1 ticket) state))
               (state (f-put-global 'fn-owner-recovery-source next state))
               (state (f-put-global 'fn-owner-recovery-sized-pending
                        (list token (if carried actualfields nil)
                              (if carried :carried :unavailable) epoch
                              (fn-omk-at 1 origin)) state)))
         (value (list :issued token)))))))))))

; Called only inside the actual quiescent payload-reset lifecycle exclusion,
; before any physical load. Source callbacks retain their issued epoch.
(defun fn-owner-recovery-source-reset (state)
  (declare (xargs :stobjs state :mode :program))
  (let* ((state (fn-owner-canonical-reset state))
         (state (f-put-global 'fn-owner-recovery-sized-pending nil state))
         (state (f-put-global 'fn-store-recovery-open-origin nil state)))
    (value (list :reset (fn-owner-canonical-epoch state)))))
(defun fn-owner-recovery-source-start (state)
  (declare (xargs :stobjs state :mode :program))
  (let* ((meta (fn-store-sco-recovery-source-value state))
         (generation (fn-store-sco-recovery-source-generation-value state))
         (epoch (fn-owner-canonical-epoch state))
         (prior (fn-owner-recovery-global 'fn-owner-recovery-source state))
         (oldticket (fn-owner-recovery-global 'fn-owner-recovery-next-ticket state))
         (ticket (if (not (boundp-global 'fn-owner-recovery-next-ticket state)) 0 oldticket)))
    (if (or (fn-owner-canonical-state state) (not (natp ticket))
            (and (fn-omk-widthp prior 9) (equal (fn-omk-at 2 prior) epoch)))
        (value '(:unavailable :recovery-source))
      (mv-let (word next) (fn-rsa-begin ticket epoch generation meta)
        (if (not (eq word :issued)) (value '(:unavailable :verified-source))
          (let* ((state (f-put-global 'fn-owner-recovery-next-ticket (+ 1 ticket) state))
                 (state (f-put-global 'fn-owner-recovery-source next state))
                 (state (f-put-global 'fn-owner-recovery-sized-pending nil state)))
            (value (list :issued (fn-rsa-token next)))))))))
(defun fn-owner-recovery-source-token (state)
  (declare (xargs :stobjs state :mode :program))
  (let* ((c (fn-owner-recovery-global 'fn-owner-recovery-source state))
         (token (fn-rsa-token c)))
    (value (if (fn-owner-recovery-source-currentp-value c token state)
               token '(:unavailable :recovery-source)))))
(defun fn-owner-recovery-source-observe (token original-context actual-fold state)
  (declare (xargs :stobjs state :mode :program))
  (let ((c (fn-owner-recovery-global 'fn-owner-recovery-source state)))
    ; Keep the original checkpoint provenance refusal distinct from the
    ; scalar stale-token refusal produced by FN-RSA-OBSERVE itself.
    (if (not (if (fn-rsoa-originp (fn-omk-at 3 c))
                 (fn-owner-recovery-source-currentp-value c (fn-rsa-token c) state)
               (fn-rsa-metap (fn-store-sco-recovery-source-value state))))
        (value '(:unavailable :verified-source))
    (mv-let (word next)
      (fn-rsa-observe c token (fn-owner-canonical-epoch state)
                      (fn-owner-recovery-source-generation-value c state)
                      original-context actual-fold)
      (if (not (eq word :counted)) (value (list :unavailable word))
        (let ((state (f-put-global 'fn-owner-recovery-source next state)))
          (value (list :counted (fn-rsa-token next)))))))))

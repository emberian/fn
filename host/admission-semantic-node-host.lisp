; Internal owner-excluded NODE phase; no native supplied row/CN/result.
(in-package "ACL2")
(include-book "admission-preparation-host")
(include-book "../books/admission-semantic-node")
(include-book "../books/history-event-backing")
(include-book "../books/history-semantic-writer-state")

(defun fn-owner-admission-authority-node-step (fuel fn-history-backing state)
 (declare (xargs :stobjs (fn-history-backing state) :mode :program
  :guard (and (natp fuel) (boundp-global 'fn-owner state)
              (boundp-global 'fn-owner-canonical-admission-executor state)
              (boundp-global 'fn-owner-history-semantic-source state)
              (fn-store-event-p
               (fn-hed-at 2 (fn-hep-builder fn-history-backing)))
              (fn-cnode-statep
               (fn-cnode-make
                (fn-sn-node
                 (fn-prl-nth 5
                  (f-get-global 'fn-owner-canonical-admission-executor state)))
                (fn-prl-nth 3
                 (f-get-global 'fn-owner-history-semantic-source state)))))))
 (let* ((current (fn-apr-owner-current state))
        (token (fn-prl-nth 0 current))
        (intent (and (boundp-global 'fn-owner-canonical-admission-executor state)
                     (f-get-global 'fn-owner-canonical-admission-executor state)))
        (source (and (boundp-global 'fn-owner-history-semantic-source state)
                     (f-get-global 'fn-owner-history-semantic-source state)))
        (job (and (boundp-global 'fn-owner-history-node-state state)
                  (f-get-global 'fn-owner-history-node-state state))))
  (cond
   ((not (and (fn-apr-tokenp token) (fn-apr-livep token current)
              (eq (fn-prl-nth 2 current) :reserved)
              (fn-apr-widthp 8 intent)
              (eq (fn-prl-nth 0 intent) :admission-prepare-intent)
              (fn-apr-tokenp (fn-prl-nth 1 intent))
              (equal token (fn-prl-nth 1 intent))
              (fn-apr-widthp 4 source)
              (eq (fn-prl-nth 0 source) :history-semantic-source)
              (fn-apr-tokenp (fn-prl-nth 1 source))
              (equal token (fn-prl-nth 1 source))
              (eq (fn-owner-history-writer-gate token state) :writer-current)
              (fn-apr-tokenp (fn-hep-producer-token fn-history-backing))
              (equal token (fn-hep-producer-token fn-history-backing))))
    (mv :writer-source-changed fn-history-backing state))
   (job
    (mv (if (and (fn-apr-widthp 7 job)
                 (eq (fn-prl-nth 0 job) :history-node-ready)
                 (fn-apr-tokenp (fn-prl-nth 1 job))
                 (equal token (fn-prl-nth 1 job)))
            :node-ready :recovery-required)
        fn-history-backing state))
   ((zp fuel) (mv :yield fn-history-backing state))
   (t
    (mv-let (word row produced context fields)
      (fn-hep-builder-readout fn-history-backing)
     (declare (ignore context fields))
     (if (not (and (eq word :candidate)
                   (equal (fn-evc-sequence row) (fn-prl-nth 4 token))
                   (equal (fn-evc-txid row) (fn-prl-nth 5 token))))
         (mv :writer-stale fn-history-backing state)
      (let* ((cn (fn-cnode-make (fn-sn-node (fn-prl-nth 5 intent))
                                (fn-prl-nth 3 source)))
             (state (f-put-global 'fn-owner-history-node-state
                      (list :history-node-intent token) state)))
       (mv-let (next-word next-cn delta left)
         (fn-asn-authority-one fuel cn row)
        (declare (ignore left))
        (if (eq next-word :node-ready)
            (let ((state (f-put-global 'fn-owner-history-node-state
                          (list :history-node-ready token row produced next-cn delta (fn-prl-nth 2 source))
                          state)))
             (mv :node-ready fn-history-backing state))
          ; Definite pure refusal/yield is safe to retry; retained original
          ; source remains. An escape leaves NODE intent fenced instead.
          (let ((state (f-put-global 'fn-owner-history-node-state nil state)))
           (mv next-word fn-history-backing state)))))))))))

(defun fn-owner-admission-node-result (state)
 (declare (xargs :stobjs state :guard t))
 (let* ((current (fn-apr-owner-current state))
        (token (fn-prl-nth 0 current))
        (source (and (boundp-global 'fn-owner-history-semantic-source state)
                     (f-get-global 'fn-owner-history-semantic-source state)))
        (job (and (boundp-global 'fn-owner-history-node-state state)
                  (f-get-global 'fn-owner-history-node-state state))))
  (if (and (fn-apr-tokenp token) (fn-apr-livep token current)
           (fn-apr-widthp 4 source)
           (eq (fn-prl-nth 0 source) :history-semantic-source)
           (fn-apr-tokenp (fn-prl-nth 1 source))
           (equal token (fn-prl-nth 1 source))
           (fn-apr-widthp 7 job) (eq (fn-prl-nth 0 job) :history-node-ready)
           (fn-apr-tokenp (fn-prl-nth 1 job))
           (equal token (fn-prl-nth 1 job))
           (eq (fn-owner-history-writer-gate token state) :writer-current))
      (mv :node-ready (fn-prl-nth 2 job) (fn-prl-nth 3 job)
          (fn-prl-nth 4 job) (fn-prl-nth 5 job))
    (mv :unavailable nil nil nil nil))))

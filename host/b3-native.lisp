   (dotimes (i used) (fn2-b3-byte 0 (mod i 251) dg b3))
   (let ((dc (map 'vector (lambda (a) (if (vectorp a) (copy-seq a) a)) dg))
         (bc (map 'vector (lambda (a) (if (vectorp a) (copy-seq a) a)) b3)))
    (funcall (fn2-b3-native-reference 'fn2-b3-fragment-into) 0 17 (- 1024 used) dg b3 pool)
    (fn2-b3-native-fragment 0 17 (- 1024 used) dc bc pool)
    (unless (and (equalp dc dg) (equalp bc b3))
     (error 'fn2-b3-native-refused :detail "partial chunk effects"))))
  (dolist (n '(0 1 7 8 9 63 64 4095 4096))
   (dolist (bad (remove-duplicates (list 0 (floor n 2) (max 0 (- n 1)) n)))
    (fill bytes 0 :start 3 :end (+ 3 n))
    (when (< bad n) (setf (aref bytes (+ 3 bad)) 1))
    (unless (= (funcall (fn2-b3-native-reference 'fn2-fc-zero-prefix) 3 n pool)
               (fn2-b3-native-zero-prefix 3 n pool))
     (error 'fn2-b3-native-refused :detail "zero-prefix")))))
 t)
(defun fn2-b3-native-reset ()
 (dolist (pair *fn2-b3-native-references*) (setf (symbol-function (car pair)) (cdr pair)))
 (setf *fn2-b3-native-state* :reference))
(defun fn2-b3-native-startup (&optional (library (if (member :darwin *features*)
                                         "build/lib/libfn-blake3.dylib" "build/lib/libfn-blake3.so")))
 (unless *fn2-b3-native-references*
  (setf *fn2-b3-native-references* (loop for (name . native) in *fn2-b3-native-entries*
                                        collect (cons name (symbol-function name)))))
 (fn2-b3-native-reset)
 (handler-case
  (progn (sb-alien:load-shared-object library :dont-save t)
   (unless (string= (fn2-b3-%version) "1.8.7") (error "unexpected BLAKE3 version"))
   (fn2-b3-native-self-check)
   (dolist (pair *fn2-b3-native-entries*) (setf (symbol-function (car pair)) (symbol-function (cdr pair))))
   (setf *fn2-b3-native-state* :native))
  (error (c) (fn2-b3-native-reset) (error 'fn2-b3-native-refused :detail (princ-to-string c))))
 t)
; Save references in the image; qualify C again in every new process.
(pushnew #'fn2-b3-native-reset sb-ext:*save-hooks*)
(pushnew #'fn2-b3-native-startup sb-ext:*init-hooks*)
(fn2-b3-native-startup)

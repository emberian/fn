; Internal FINISH of the retained semantic producer. No native declaration.
; The semantic dispatcher alone writes :history-semantic-done, and the
; backing producer alone registers the page/forest preparation. Neither
; missing predecessor is replaced by a shaped result supplied by a caller.
(in-package "ACL2")
(include-book "admission-preparation-host")
(include-book "../books/history-event-backing")
(include-book "../books/history-semantic-writer-state")

(defun fn-owner-history-seal-produced (fn-history-backing state)
 (declare (xargs :stobjs (fn-history-backing state) :mode :program
  :guard (and (boundp-global 'fn-owner state)
              (fn-sn-statep (fn-owner-store state))
              (fn-store-event-p (fn-hed-at 2 (fn-hep-builder fn-history-backing))))))
 (let* ((current (fn-apr-owner-current state))
        (token (fn-prl-nth 0 current))
        (intent (and (boundp-global 'fn-owner-canonical-admission-executor state)
                     (f-get-global 'fn-owner-canonical-admission-executor state)))
        (done (and (boundp-global 'fn-owner-history-semantic-state state)
                   (f-get-global 'fn-owner-history-semantic-state state)))
        (seal (and (boundp-global 'fn-owner-history-seal-intent state)
                   (f-get-global 'fn-owner-history-seal-intent state))))
  (cond
   ((not (and (fn-apr-tokenp token) (fn-apr-livep token current)
              (eq (fn-owner-history-writer-gate token state) :writer-current)
              (fn-apr-tokenp (fn-hep-producer-token fn-history-backing))
              (equal token (fn-hep-producer-token fn-history-backing))
              (fn-apr-tokenp (fn-hed-at 6 (fn-hep-builder fn-history-backing)))
              (equal token (fn-hed-at 6 (fn-hep-builder fn-history-backing)))))
    (mv :stale fn-history-backing state))
   ((member-eq (fn-prl-nth 2 current) '(:produced :promoted))
    ; Exact current registration is already complete. Retain all producer
    ; aliases until the downstream install/settlement protocol returns them.
    (mv :already-produced fn-history-backing state))
   ((or seal (not (eq (fn-prl-nth 2 current) :reserved)))
    (mv :recovery-required fn-history-backing state))
   ((not (and (fn-omk-widthp intent 8)
               (eq (fn-omk-at 0 intent) :admission-prepare-intent)
               (fn-apr-tokenp (fn-omk-at 1 intent))
               (equal token (fn-omk-at 1 intent))
               (fn-omk-widthp done 5)
               (eq (fn-omk-at 0 done) :history-semantic-done)
               (fn-apr-tokenp (fn-omk-at 1 done))
               (equal token (fn-omk-at 1 done))))
    (mv :semantic-preparation-unavailable fn-history-backing state))
   (t
    (mv-let (word prepared-token txid ready)
     (fn-hep-operation-readout fn-history-backing)
     (if (not (and (eq word :operation)
                    (eq (fn-hep-producer-phase fn-history-backing) :prepared)
                    (fn-apr-tokenp prepared-token)
                    (equal token prepared-token)))
      (mv :backing-preparation-unavailable fn-history-backing state)
      (mv-let (candidate-word row produced context fields)
       (fn-hep-builder-readout fn-history-backing)
       (declare (ignore context fields))
       (let* ((plan (fn-omk-at 4 ready))
              (store-fields (fn-omk-at 2 plan))
              (semantic-ready (fn-omk-at 4 done))
              (pair (fn-omk-at 4 intent)))
        (if (not (and
                   (eq candidate-word :candidate)
                   (fn-omk-widthp produced 6)
                   (eq (fn-omk-at 2 produced) :carried)
                   (fn-omk-widthp ready 10)
                   (eq (fn-omk-at 0 ready) :history-owner-ready)
                   (fn-omk-widthp semantic-ready 10)
                   (eq (fn-omk-at 0 semantic-ready) :history-owner-ready)
                   (natp (fn-omk-at 2 intent))
                   (natp (fn-omk-at 3 intent))
                   (equal (fn-omk-at 2 intent) (fn-owner-canonical-epoch state))
                   (equal (fn-omk-at 2 intent) (fn-prl-nth 2 token))
                   (equal (fn-omk-at 3 intent) (fn-prl-nth 3 token))
                   (consp pair) (natp (car pair)) (natp (cdr pair))
                   (equal (car pair) (fn-prl-nth 4 token))
                   (equal (cdr pair) (fn-prl-nth 5 token))
                   (natp txid) (equal txid (cdr pair))
                   (eq (fn-sf-phase (fn-sn-files (fn-owner-store state))) :record-staged)
                   (equal (fn-sf-records-count (fn-sn-files (fn-owner-store state)))
                          (fn-omk-at 3 intent))
                   (equal (fn-evc-sequence row) (car pair))
                   (equal (fn-evc-txid row) (cdr pair))
                   (equal (fn-omk-at 1 ready) (fn-omk-at 2 intent))
                   (equal (fn-omk-at 2 ready) (fn-omk-at 3 intent))
                   (consp (fn-omk-at 3 ready))
                   (equal (car (fn-omk-at 3 ready)) (car pair))
                   (equal (cdr (fn-omk-at 3 ready)) (cdr pair))
                   ; Compare only metadata of the independently retained
                   ; semantic result. The complete result association is a
                   ; producer invariant, not a served graph equality.
                   (equal (fn-omk-at 1 semantic-ready) (fn-omk-at 1 ready))
                   (equal (fn-omk-at 2 semantic-ready) (fn-omk-at 2 ready))
                   (consp (fn-omk-at 3 semantic-ready))
                   (equal (car (fn-omk-at 3 semantic-ready)) (car pair))
                   (equal (cdr (fn-omk-at 3 semantic-ready)) (cdr pair))
                   (fn-omk-widthp plan 6)
                   (eq (fn-omk-at 0 plan) :history-install-plan)
                   (eq (fn-omk-at 1 plan) :E)
                   (fn-omk-widthp store-fields 14)
                   (eq (fn-omk-at 0 store-fields) :history-store-fields)))
         (mv :recovery-required fn-history-backing state)
         (let* ((state (f-put-global 'fn-owner-history-seal-intent
                                     (list :history-seal-intent token) state))
                (packet
                  (fn-apr-operation-packet row
                   (fn-omk-at 0 produced) (fn-omk-at 1 produced)
                   (fn-omk-at 2 produced) (fn-omk-at 3 produced)
                   (fn-omk-at 4 produced) (fn-omk-at 5 produced)
                   ready (fn-sn-node (fn-omk-at 5 intent))
                   (fn-omk-at 3 store-fields))))
          (mv-let (produced-word next-current)
           (fn-apr-produced token packet current)
           (if (not (eq produced-word :produced))
            (mv :recovery-required fn-history-backing state)
            (let ((state (f-put-global 'fn-owner-canonical-admission-pending
                                      next-current state)))
             (mv :produced fn-history-backing state))))))))))))))

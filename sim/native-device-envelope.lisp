; Bind the physical file-device capture to actual envelope replay.
; Selected-host premise: one executor submits, one FIFO worker performs;
; direct seed/setup performs are outside this existing-image replay entry.
(in-package "ACL2")
(include-book "check-envelope")
(include-book "native-device-effects")
(include-book "../books/device-boundary")

(defun fn2-nde-kind (kind)
 (cond ((equal kind *fn2-action-read*) :read)
       ((equal kind *fn2-action-write*) :write)
       ((equal kind *fn2-action-fence*) :fence)
       (t nil)))
(defun fn2-nde-job (slot gen records)
 (if (atom records) nil
  (let ((r (car records)))
   (if (and (member-eq (car r) '(:submit :direct))
            (equal slot (nth 1 (nth 2 r))) (equal gen (nth 2 (nth 2 r))))
       r (fn2-nde-job slot gen (cdr records))))))
(defun fn2-nde-return (id records)
 (if (atom records) nil
  (if (and (eq (caar records) :return) (equal (nth 1 (car records)) id))
      (car records) (fn2-nde-return id (cdr records)))))
(defun fn2-nde-submitted-ids (records)
 (if (atom records) nil
  (if (member-eq (caar records) '(:submit :direct))
      (cons (nth 1 (car records)) (fn2-nde-submitted-ids (cdr records)))
    (fn2-nde-submitted-ids (cdr records)))))
(defun fn2-nde-take (slot gen trace)
 (if (atom trace) nil
  (if (and (eq (caar trace) :take) (equal (nth 1 (car trace)) slot)
           (equal (nth 2 (car trace)) gen))
      (car trace) (fn2-nde-take slot gen (cdr trace)))))
(defun fn2-nde-take-descriptor-p (take descriptor)
 (and (eq (nth 3 descriptor) (fn2-nde-kind (nth 3 take)))
      (equal (nth 1 descriptor) (nth 1 take))
      (equal (nth 2 descriptor) (nth 2 take))
      (equal (nth 4 descriptor) (nth 10 take))
      (equal (nth 5 descriptor) (nth 9 take))
      (equal (nth 11 take) 0)))
(defun fn2-nde-post-normalized-p (take post code count read-bytes)
 (declare (xargs :verify-guards nil))
 (mv-let (outcome reason n aux0 aux1)
  (fn2-host-result (nth 3 take) code count 0 (nth 9 take) nil)
  (and (equal (nth 1 post) 0)
       (equal (nth 4 post) (fn2-terminal-event (nth 3 take)))
       (equal (nth 5 post) outcome) (equal (nth 6 post) reason)
       (equal (nth 7 post) n) (equal (nth 8 post) aux0) (equal (nth 9 post) aux1)
       (equal (nth 12 post) (if (eq (fn2-nde-kind (nth 3 take)) :read) read-bytes nil)))))
(defun fn2-nde-post-p (post trace records)
 (declare (xargs :verify-guards nil))
 (let* ((take (fn2-nde-take (nth 2 post) (nth 3 post) trace))
        (kind (fn2-nde-kind (nth 3 take)))
  (if (not kind) t
   (let* ((job (fn2-nde-job (nth 2 post) (nth 3 post) records))
          (returned (and job (fn2-nde-return (nth 1 job) records))))
    (if job
        (and returned
         (mv-let (code count) (fn2-device-io-observation (nth 2 returned) (nth 3 returned))
          (fn2-nde-post-normalized-p take post code count (nth 4 returned))))
      ; The selected file backend refuses FUA before queueing. Never use a
      ; failed ordinary Write as an excuse for missing physical evidence.
      (and (not (equal (nth 11 take) 0))
           (fn2-nde-post-normalized-p take post :unsupported 0 nil))))))))

(defun fn2-nde-bind-take (e records unbound fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let* ((job (fn2-nde-job (nth 1 e) (nth 2 e) records)) (id (nth 1 job)) (d (nth 2 job)))
  (if (not job) (mv nil unbound)
   (if (and (eq (car job) :submit) (member-equal id unbound)
            (fn2-nde-take-descriptor-p e d)
            (or (not (eq (nth 3 d) :write))
                (equal (nth 6 d)
                 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (bytes)
                  (fn2-envelope-read-range (nth 8 e) (+ (nth 8 e) (nth 9 e)) (nth 6 e) fn2-pool)
                  bytes))))
       (mv nil (remove1-equal id unbound))
     (mv :physical-take-mismatch unbound)))))

; Reuse the actual replay step rather than copying its transition semantics.
; The take comparison runs after that step has validated the complete logical
; descriptor. Take itself does not release or mutate its borrowed range.
(defun fn2-native-device-envelope-steps (rest trace records taken caps unbound fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (acl2-count rest)))
 (if (atom rest)
     (mv (if (or rest unbound) :unbound-physical-job :pass) caps fn2-core)
  (let ((e (car rest)))
   (mv-let (failure taken caps fn2-core) (fn2-envelope-step e t taken caps fn2-core)
    (if failure (mv failure caps fn2-core)
     (mv-let (binding unbound)
      (if (eq (car e) :take) (fn2-nde-bind-take e records unbound fn2-core)
       (mv (and (eq (car e) :post) (not (fn2-nde-post-p e trace records)) :physical-post-mismatch) unbound))
      (if binding (mv binding caps fn2-core)
       (fn2-native-device-envelope-steps (cdr rest) trace records taken caps unbound fn2-core))))))))

(defun fn2-native-device-control-replay (profile boot trace records fd)
 (declare (xargs :verify-guards nil))
 (mv-let (physical-code effects) (fn2-native-device-effects records fd)
  (declare (ignore effects))
  (if (not (eq physical-code :ok)) (list :malformed-physical nil)
   (with-local-stobj fn2-core
    (mv-let (verdict caps fn2-core)
     (let ((fn2-core (fn2-init-executor profile :echo nil fn2-core)))
      (mv-let (code fn2-core) (fn2-boot-start (nth 1 boot) (nth 2 boot) fn2-core)
       (if (and (equal (car boot) :boot-start) (equal (len boot) 4)
                (equal code :ok) (equal code (nth 3 boot)))
           (fn2-native-device-envelope-steps trace trace records nil nil (fn2-nde-submitted-ids records) fn2-core)
         (mv :boot-start-mismatch nil fn2-core))))
     (list verdict caps))))))

(defun fn2-own-observe-core-write (slot gen index code byte fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own) :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))

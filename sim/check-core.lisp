(defun fn2-check-own (fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own) :verify-guards nil))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))
              (fn2-ops (fn2-core-ops fn2-core)))
             (answer)
             (fn2-check-own-parts fn2-pool fn2-ops fn2-own)
             answer))

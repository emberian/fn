(in-package "ACL2")
(let ((out (sb-ext:posix-getenv "INV_OUT")) (rows nil) (n 0) (tot 0) (hist (make-hash-table)))
  (sb-vm:map-allocated-objects (lambda (o ty size) (declare (ignore ty)) (when (typep o '(simple-array (unsigned-byte 8) (*))) (incf n) (incf tot size) (incf (gethash (integer-length size) hist 0) size) (push (list size (length o) (sb-kernel:get-lisp-obj-address o)) rows))) :all)
  (with-open-file (s out :direction :output :if-exists :supersede)
    (format s "N ~d TOT ~d~%" n tot)
    (maphash (lambda (k v) (format s "HIST log2size ~d bytes ~d~%" k v)) hist)
    (loop for r in (sort rows #'> :key #'first) repeat 10 do (format s "TOPVEC ~s~%" r))
    (format s "DONE~%")))
(sb-ext:exit :code 0 :abort t)

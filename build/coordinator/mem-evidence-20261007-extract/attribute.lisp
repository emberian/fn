(in-package "ACL2")
;;; owner attribution of octet vectors and conses in a saved core; pagemap part = nmemhook2.lisp 13-101 verbatim
;;; ---- pagemap: which pages of the core and the dynamic space are resident
(defvar *nm-regions* nil)
(defun nm-load-regions ()
  (setq *nm-regions* nil)
  (let* ((dyn-start sb-vm:dynamic-space-start)
         (dyn-end (+ dyn-start (sb-ext:dynamic-space-size))))
    (with-open-file (m "/proc/self/maps")
      (loop for line = (read-line m nil) while line do
        (let* ((dash (position #\- line)) (sp (position #\Space line))
               (a (parse-integer line :end dash :radix 16))
               (b (parse-integer line :start (1+ dash) :end sp :radix 16)))
          (when (or (search ".core" line) (and (>= a dyn-start) (< a dyn-end)))
            (push (list a b) *nm-regions*)))))
    (setq *nm-regions* (sort *nm-regions* #'< :key #'first))
    (with-open-file (pm "/proc/self/pagemap" :element-type '(unsigned-byte 8))
      (setq *nm-regions*
            (loop for (a b) in *nm-regions*
                  collect (let* ((np (floor (- b a) 4096)) (buf (make-array (* 8 np) :element-type '(unsigned-byte 8)))
                                 (bits (make-array np :element-type 'bit)))
                            (file-position pm (* 8 (floor a 4096)))
                            (read-sequence buf pm)
                            (dotimes (i np) (setf (sbit bits i) (ldb (byte 1 7) (aref buf (+ (* 8 i) 7)))))
                            (list a b bits)))))))
(defun nm-present-p (addr)
  ;; :yes / :no / :unmapped
  (dolist (r *nm-regions* :unmapped)
    (destructuring-bind (a b bits) r
      (when (and (>= addr a) (< addr b))
        (return (if (= 1 (sbit bits (floor (- addr a) 4096))) :yes :no))))))
(defun nm-first-symbol (x depth)
  (cond ((symbolp x) x)
        ((and (consp x) (> depth 0)) (or (nm-first-symbol (car x) (1- depth)) (nm-first-symbol (cdr x) (1- depth))))))
(defun nm-sym-class (s)
  (let* ((p (symbol-package s)) (pn (and p (package-name p))) (n (symbol-name s)))
    (cond ((null s) :other)
          ((and pn (or (eql 0 (search "SB-" pn)) (string= pn "COMMON-LISP"))) :sbcl)
          ((or (eql 0 (search "FNN-" n)) (eql 0 (search "*FNN-" n)) (eql 0 (search "+FNN-" n))) :host)
          ((or (eql 0 (search "FN-" n)) (eql 0 (search "*FN-" n)) (eql 0 (search "+FN-" n))) :fn-books)
          ((and pn (string= pn "ACL2")) :acl2-other)
          (t :other))))
(defun nm-code-class (code)
  (or (ignore-errors
       (let* ((n (sb-kernel:code-n-entries code))
              (nm (and (plusp n) (sb-kernel:%simple-fun-name (sb-kernel:%code-entry-point code 0))))
              (s (nm-first-symbol nm 4)))
         (and s (nm-sym-class s))))
      :unnamed))
(defun nm-key2 (obj)
  (typecase obj
    (cons :cons)
    (symbol (list :symbol (nm-sym-class obj)))
    (sb-kernel:code-component (list :code (nm-code-class obj)))
    (sb-kernel:fdefn :fdefn)
    (hash-table :hash-table-header)
    (sb-kernel:funcallable-instance :funcallable-instance)
    (function :closure/function)
    ((simple-array character (*)) :string-char32)
    ((simple-array base-char (*)) :string-base)
    ((simple-array (unsigned-byte 8) (*)) :octets-u8)
    ((simple-array (unsigned-byte 32) (*)) :u32-vec)
    ((simple-array t (*)) :simple-vector)
    (integer :bignum)
    (array (list :other-array (array-element-type obj)))
    (sb-kernel:instance (list :instance (ignore-errors (sb-kernel:classoid-name (sb-kernel:layout-classoid (sb-kernel:layout-of obj))))))
    (t :other)))
(defun nm-pagemap-report (s)
  (nm-load-regions)
  (let ((tab (make-hash-table :test 'equal)) (space (make-hash-table :test 'eq)))
    (dolist (r *nm-regions*)
      (destructuring-bind (a b bits) r
        (format s "REGION ~x-~x pages ~d resident ~d (~,1f MB)~%" a b (length bits) (count 1 bits) (/ (* 4096 (count 1 bits)) 1048576.0))))
    (sb-vm:map-allocated-objects
     (lambda (obj type size)
       (declare (ignore type))
       (let* ((addr (logandc2 (sb-kernel:get-lisp-obj-address obj) 15))
              (res (nm-present-p addr)) (k (nm-key2 obj)) (e (or (gethash k tab) (setf (gethash k tab) (list 0 0 0)))))
         (incf (first e) size)
         (when (eq res :yes) (incf (second e) size))
         (when (eq res :unmapped) (incf (third e) size))))
     :all)
    (let (rows (tot 0) (rtot 0))
      (maphash (lambda (k v) (incf tot (first v)) (incf rtot (second v)) (push (list (second v) (first v) (third v) k) rows)) tab)
      (setq rows (sort rows #'> :key #'first))
      (format s "PM-TOTAL bytes ~d resident-start-page ~d~%" tot rtot)
      (loop for r in rows repeat 60 do (format s "PM ~d ~d ~d ~s~%" (first r) (second r) (third r) (fourth r))))
    space))

;;; ---- reachability with residency
(defvar *nd-seen* nil)
(defvar *at-seen* (make-hash-table :test 'eq :size 8000000))
(defvar *at-owner* nil)
(defvar *at-tab* (make-hash-table :test 'equal))   ; owner -> #(u8 u8res cons consres other otherres)
(defun at-row (own) (or (gethash own *at-tab*) (setf (gethash own *at-tab*) (make-array 6 :initial-element 0))))
(defun at-size (o) (or (ignore-errors (sb-ext:primitive-object-size o)) 0))
(defun at-add (o kind n)
  (let ((r (at-row *at-owner*)) (res (eq :yes (nm-present-p (logandc2 (sb-kernel:get-lisp-obj-address o) 15)))) (i (ecase kind (:u8 0) (:cons 2) (:other 4))))
    (incf (aref r i) n) (when res (incf (aref r (1+ i)) n))))
(defun at-walk (root)
  (let ((stack (list root)))
    (loop while stack do
      (let ((o (pop stack)))
        (typecase o
          (cons (unless (gethash o *at-seen*) (setf (gethash o *at-seen*) t) (at-add o :cons 16) (push (cdr o) stack) (push (car o) stack)))
          ((or symbol fixnum character package null) nil)
          (function (unless (gethash o *at-seen*) (setf (gethash o *at-seen*) t)
                      (when (sb-kernel:closurep o)
                        (loop for i below (1- (sb-kernel:get-closure-length o)) do (push (sb-kernel:%closure-index-ref o i) stack)))))
          ((simple-array (unsigned-byte 8) (*)) (unless (gethash o *at-seen*) (setf (gethash o *at-seen*) t) (at-add o :u8 (at-size o))))
          ((simple-array t (*)) (unless (gethash o *at-seen*) (setf (gethash o *at-seen*) t) (at-add o :other (at-size o)) (loop for x across o do (push x stack))))
          (hash-table (unless (gethash o *at-seen*) (setf (gethash o *at-seen*) t) (at-add o :other (at-size o)) (maphash (lambda (k v) (push k stack) (push v stack)) o)))
          (sb-kernel:instance
           (unless (gethash o *at-seen*) (setf (gethash o *at-seen*) t) (at-add o :other (at-size o))
             (ignore-errors
              (dolist (d (sb-kernel:dd-slots (sb-kernel:layout-info (sb-kernel:layout-of o))))
                (when (eq (sb-kernel:dsd-raw-type d) t) (push (sb-kernel:%instance-ref o (sb-kernel:dsd-index d)) stack))))))
          (array (unless (gethash o *at-seen*) (setf (gethash o *at-seen*) t) (at-add o :other (at-size o))
                   (ignore-errors (when (typep o '(and array (not (simple-array * (*)))))
                     (push (sb-kernel:%array-data o) stack)))))
          (integer (unless (gethash o *at-seen*) (setf (gethash o *at-seen*) t) (at-add o :other (at-size o))))
          (t (unless (gethash o *at-seen*) (setf (gethash o *at-seen*) t) (at-add o :other (at-size o)))))))))
(defun at-run (s)
  (nm-load-regions)
  (let ((syms nil))
    (do-all-symbols (sym) (push sym syms))
    (setq syms (remove-duplicates syms))
    (dolist (sym syms)
      (when (and (boundp sym) (not (member sym '(*at-seen* *at-tab* *at-owner* *nm-regions*))))
        (let ((*at-owner* (list :value (symbol-package sym) sym))) (at-walk (symbol-value sym)))))
    (dolist (sym syms)
      (loop for (k v) on (symbol-plist sym) by #'cddr do
        (let ((*at-owner* (list :plist k))) (at-walk v))))
    (dolist (sym syms)
      (when (fboundp sym)
        (let ((*at-owner* (list :fn-closure (nm-sym-class sym)))) (ignore-errors (at-walk (fdefinition sym))))))
    ;; code constants
    (sb-vm:map-allocated-objects
     (lambda (o ty size) (declare (ignore ty size))
       (when (typep o 'sb-kernel:code-component)
         (let ((*at-owner* (list :code-constants (nm-code-class o))))
           (loop for i from sb-vm:code-constants-offset below (sb-kernel:code-header-words o)
                 do (ignore-errors (at-walk (sb-kernel:code-header-ref o i)))))))
     :all)
    ;; unreached big octet vectors
    (let ((n 0) (b 0))
      (sb-vm:map-allocated-objects
       (lambda (o ty size) (declare (ignore ty))
         (when (and (typep o '(simple-array (unsigned-byte 8) (*))) (not (gethash o *at-seen*)))
           (incf n) (incf b size)
           (when (>= size 65536) (format s "UNREACHED-U8 ~d res=~a~%" size (nm-present-p (logandc2 (sb-kernel:get-lisp-obj-address o) 15))))))
       :all)
      (format s "UNREACHED-U8-TOTAL count ~d bytes ~d~%" n b))
    (let (rows)
      (maphash (lambda (k v) (push (cons k v) rows)) *at-tab*)
      (flet ((top (label idx)
               (loop for r in (sort (copy-list rows) #'> :key (lambda (r) (aref (cdr r) idx))) repeat 12
                     do (format s "~a ~d ~d ~s~%" label (aref (cdr r) idx) (aref (cdr r) (1+ idx)) (let ((*print-length* 4) (*print-level* 3)) (car r))))))
        (top "TOP-U8 (bytes res owner)" 0) (top "TOP-CONS (bytes res owner)" 2) (top "TOP-OTHER (bytes res owner)" 4))
      (format s "SUM u8 ~d cons ~d other ~d~%" (reduce #'+ rows :key (lambda (r) (aref (cdr r) 0))) (reduce #'+ rows :key (lambda (r) (aref (cdr r) 2))) (reduce #'+ rows :key (lambda (r) (aref (cdr r) 4)))))))
(let ((out (sb-ext:posix-getenv "INV_OUT")))
  (with-open-file (s out :direction :output :if-exists :supersede)
    (handler-case (at-run s) (error (e) (format s "ERROR ~a~%" e)))
    (format s "DONE~%")))
(sb-ext:exit :code 0 :abort t)

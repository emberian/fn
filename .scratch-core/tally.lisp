;;; MEM method (MEMORY-20261006 s2.1, s2): map-allocated-objects by type, code/symbols by owner,
;;; plus a reachability attribution of conses/vectors/strings to the owner of the root symbol.
(in-package "CL-USER")
(setf (sb-ext:bytes-consed-between-gcs) (* 1500 1024 1024))
(sb-ext:gc :full t)
(defvar *out* (sb-ext:posix-getenv "TALLY_OUT"))
(defvar *bytype* (make-hash-table :test 'equal))
(defvar *byowner* (make-hash-table :test 'equal))
(defun add (tbl key bytes) (let ((c (or (gethash key tbl) (setf (gethash key tbl) (cons 0 0))))) (incf (car c) bytes) (incf (cdr c))))
(defun classify-symbol (s)
  (let* ((p (symbol-package s)) (pn (if p (package-name p) "uninterned")) (n (symbol-name s)))
    (flet ((pre (x) (and (>= (length n) (length x)) (string= x n :end2 (length x)))))
      (cond ((string= pn "ACL2")
             (cond ((or (pre "FNN-") (pre "*FNN-") (pre "+FNN-")) "ACL2/FNN-host")
                   ((or (pre "FN-") (pre "*FN-") (pre "+FN-")) "ACL2/FN-books")
                   (t "ACL2/other")))
            (t pn)))))
(defun code-owner (code)
  (handler-case
      (let ((f (sb-kernel:%code-entry-point code 0)))
        (if f
            (let ((nm (sb-kernel:%simple-fun-name f)))
              (cond ((symbolp nm) (classify-symbol nm))
                    ((and (consp nm) (symbolp (second nm))) (classify-symbol (second nm)))
                    ((and (consp nm) (consp (second nm)) (symbolp (second (second nm)))) (classify-symbol (second (second nm))))
                    (t (format nil "code:~a" (type-of nm)))))
            "code:no-entry"))
    (error () "code:error")))
(defun tkey (obj)
  (typecase obj
    (cons "cons") (symbol "symbol") (string (format nil "string ~a" (array-element-type obj)))
    (simple-vector "simple-vector")
    (vector (format nil "vector ~a" (array-element-type obj)))
    (array "array") (hash-table "hash-table") (function "function") (double-float "double-float")
    (integer "integer") (sb-kernel:code-component "code")
    (t (format nil "~a" (type-of obj)))))
(dolist (space '(:dynamic :immobile :read-only))
  (sb-vm:map-allocated-objects
   (lambda (obj type size)
     (declare (ignore type))
     (let ((k (tkey obj)))
       (add *bytype* (list space k) size)
       (cond ((typep obj 'sb-kernel:code-component) (add *byowner* (list space "code" (code-owner obj)) size))
             ((symbolp obj) (add *byowner* (list space "symbol" (classify-symbol obj)) size)))))
   space))
;; reachability: conses, vectors, strings reached from symbol values/plists and code constants, once each
(defvar *seen* (make-hash-table :test 'eq :size 9000000))
(defvar *reach* (make-hash-table :test 'equal))
(defvar *stack* nil)
(defun push-obj (o) (when (and (not (typep o '(or fixnum character symbol function sb-kernel:code-component sb-kernel:fdefn))) (not (gethash o *seen*)))
                      (setf (gethash o *seen*) t) (push o *stack*)))
(defun drain (owner)
  (loop while *stack*
        do (let ((o (pop *stack*)))
             (add *reach* (list owner (tkey o)) (sb-ext:primitive-object-size o))
             (typecase o
               (cons (push-obj (car o)) (push-obj (cdr o)))
               (simple-vector (loop for x across o do (push-obj x)))
               (t nil)))))
(do-all-symbols (s)
  (let ((owner (classify-symbol s)))
    (when (boundp s) (ignore-errors (push-obj (symbol-value s)) (drain owner)))
    (ignore-errors (push-obj (symbol-plist s)) (drain owner))))
(sb-vm:map-allocated-objects
 (lambda (obj type size) (declare (ignore type size))
   (when (typep obj 'sb-kernel:code-component)
     (let ((owner (concatenate 'string "codeconst:" (code-owner obj))))
       (ignore-errors
         (loop for i from sb-vm:code-constants-offset below (sb-kernel:code-header-words obj)
               do (push-obj (sb-kernel:code-header-ref obj i))))
       (drain owner))))
 :immobile)
(with-open-file (o *out* :direction :output :if-exists :supersede)
  (format o "TOTAL dynamic-usage ~a~%" (sb-kernel:dynamic-usage))
  (maphash (lambda (k v) (format o "TYPE ~{~a~^|~} ~a ~a~%" k (car v) (cdr v))) *bytype*)
  (maphash (lambda (k v) (format o "OWNER ~{~a~^|~} ~a ~a~%" k (car v) (cdr v))) *byowner*)
  (maphash (lambda (k v) (format o "REACH ~{~a~^|~} ~a ~a~%" k (car v) (cdr v))) *reach*))
(sb-ext:exit :code 0 :abort t)

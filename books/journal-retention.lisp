; Lease actual installed journal extents before reopening C. Each turn
; claims one commit or closes one edge. No source bytes are decoded here.
(in-package "ACL2")
(include-book "machines-b")
(include-book "c-snapshot-state")
(include-book "columns-call-guards")
(fn2-book-layer :c)
(local (in-theory (disable fn2-csnapshot-ownerp fn2-csnapshot-cut-commit
                           fn2-csnapshot-cut-event fn2-journal-lease-ownerp)))

(defun fn2-journal-lease-edge (extent fn2-extents fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-extents fn2-alloc-edges) :guard t))
 (+ (nfix (- (fn2-alloc-edges-rows fn2-alloc-edges) (fn2-extents-rows fn2-extents)))
    (nfix extent)))

(defun fn2-journal-lease-begin (token kind owner generation fn2-csnapshot fn2-journal-lease)
 (declare (xargs :stobjs (fn2-csnapshot fn2-journal-lease)
  :guard (and (fn2-csnapshot-wfp fn2-csnapshot) (fn2-journal-lease-wfp fn2-journal-lease))))
 (cond ((not (and (< 0 (fn2-csnapshot-rows fn2-csnapshot))
                  (fn2-csnapshot-ownerp token kind owner generation fn2-csnapshot)
                  (equal (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-held*)))
        (mv :snapshot fn2-journal-lease))
       ((not (and (< 0 (fn2-journal-lease-rows fn2-journal-lease))
                  (equal (fn2-journal-lease-phase 0 fn2-journal-lease) *fn2-journal-lease-phase-idle*)))
        (mv :busy fn2-journal-lease))
       ((not (and (posp token) (unsigned-byte-p 60 token) (unsigned-byte-p 8 kind)
                  (unsigned-byte-p 32 owner) (unsigned-byte-p 60 generation)
                  (unsigned-byte-p 60 (fn2-csnapshot-cut-commit 0 fn2-csnapshot))
                  (unsigned-byte-p 60 (fn2-csnapshot-cut-event 0 fn2-csnapshot))))
        (mv :owner fn2-journal-lease))
       (t (let ((fn2-journal-lease (fn2-journal-lease-put 0
                  (phase *fn2-journal-lease-phase-collecting*)
                  (token token) (kind kind) (owner owner) (generation generation)
                  (cut-commit (fn2-csnapshot-cut-commit 0 fn2-csnapshot))
                  (cut-event (fn2-csnapshot-cut-event 0 fn2-csnapshot))
                  (scan 0) (next-event 1))))
            (mv :ok fn2-journal-lease)))))
(fn2-journal-lease-preserves fn2-journal-lease-begin
 (token kind owner generation fn2-csnapshot fn2-journal-lease) :position 1)

(defun fn2-journal-directory-entry (commit cut event commit-kind fn2-commit-root fn2-extents)
 (declare (xargs :stobjs (fn2-commit-root fn2-extents)
  :guard (and (fn2-commit-root-wfp fn2-commit-root) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (and (posp commit) (natp cut) (<= commit cut) (natp event)
                     (< commit (fn2-commit-root-rows fn2-commit-root))
                     (<= cut (fn2-commit-root-published 0 fn2-commit-root))
                     (<= cut (fn2-commit-root-installed 0 fn2-commit-root))))
       (mv :bounds 0 0 0 0 0))
      (extent (fn2-commit-root-extent commit fn2-commit-root))
      (first (fn2-commit-root-first-key commit fn2-commit-root))
      (members (fn2-commit-root-members commit fn2-commit-root))
      ((unless (and (posp first) (posp members) (<= (+ first members -1) event)
                     (equal (fn2-commit-root-parent commit fn2-commit-root) (- commit 1))
                     (equal (fn2-commit-root-seal-ready commit fn2-commit-root) 1)
                     (fn2-alloc-slotp extent fn2-extents)
                     (equal (fn2-extents-owner-kind extent fn2-extents) commit-kind)
                     (equal (fn2-extents-owner-id extent fn2-extents) commit)
                     (equal (fn2-extents-release-pending extent fn2-extents) 0)))
       (mv :source 0 0 0 0 0))
      (epoch (fn2-extents-epoch extent fn2-extents))
      (allocation (fn2-extents-counter extent fn2-extents)))
   (if (eq (fn2-alloc-handle-code extent epoch allocation fn2-extents) :ok)
       (mv :ok extent epoch allocation first members)
     (mv :source 0 0 0 0 0))))

; While collecting, the C owner is still required. Failure retains the
; collected prefix so the same owner can close it before reopening C.
(defun fn2-journal-lease-claim
 (token kind owner generation commit-kind fn2-csnapshot fn2-journal-lease fn2-commit-root fn2-extents fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-csnapshot fn2-journal-lease fn2-commit-root fn2-extents fn2-alloc-edges)
  :guard (and (fn2-csnapshot-wfp fn2-csnapshot) (fn2-journal-lease-wfp fn2-journal-lease)
              (fn2-commit-root-wfp fn2-commit-root) (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges))
  :guard-hints ((fn2-columns-call-guard-hint 'fn2-journal-lease-claim
                 '(fn2-journal-directory-entry fn2-alloc-edge-add fn2-alloc-edge-matchesp) nil world))))
 (b* (((unless (and (< 0 (fn2-journal-lease-rows fn2-journal-lease))
                     (fn2-journal-lease-ownerp token kind owner generation fn2-journal-lease)
                     (equal (fn2-journal-lease-phase 0 fn2-journal-lease) *fn2-journal-lease-phase-collecting*)
                     (< 0 (fn2-csnapshot-rows fn2-csnapshot))
                     (fn2-csnapshot-ownerp token kind owner generation fn2-csnapshot)
                     (equal (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-held*)))
       (mv :owner fn2-journal-lease fn2-extents fn2-alloc-edges))
      (cut (fn2-journal-lease-cut-commit 0 fn2-journal-lease))
      (event (fn2-journal-lease-cut-event 0 fn2-journal-lease))
      (scan (fn2-journal-lease-scan 0 fn2-journal-lease))
      (next (fn2-journal-lease-next-event 0 fn2-journal-lease))
      ((when (equal scan cut))
       (if (equal next (+ 1 event))
           (let ((fn2-journal-lease (fn2-journal-lease-set-phase 0 *fn2-journal-lease-phase-ready* fn2-journal-lease)))
             (mv :ready fn2-journal-lease fn2-extents fn2-alloc-edges))
         (mv :sequence fn2-journal-lease fn2-extents fn2-alloc-edges)))
      (commit (+ 1 scan))
      ((mv code extent epoch allocation first members)
       (fn2-journal-directory-entry commit cut event commit-kind fn2-commit-root fn2-extents))
      ((unless (eq code :ok)) (mv code fn2-journal-lease fn2-extents fn2-alloc-edges))
      ((unless (and (natp extent) (posp first) (posp members)
                     (equal next first) (unsigned-byte-p 32 commit)
                     (unsigned-byte-p 60 (+ first members))
                     (unsigned-byte-p 60 token) (unsigned-byte-p 60 epoch)
                     (unsigned-byte-p 60 allocation)))
       (mv :sequence fn2-journal-lease fn2-extents fn2-alloc-edges))
      (root (+ 7 (* 2 extent)))
      ((unless (and (<= (fn2-extents-rows fn2-extents) (fn2-alloc-edges-rows fn2-alloc-edges))
                     (fn2-alloc-edge-slotp root fn2-alloc-edges)
                     (fn2-alloc-edge-matchesp root commit extent epoch allocation :installed-root fn2-alloc-edges)))
       (mv :source fn2-journal-lease fn2-extents fn2-alloc-edges))
      (edge (fn2-journal-lease-edge extent fn2-extents fn2-alloc-edges))
      ((mv code fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add edge token extent epoch allocation :promised-read fn2-extents fn2-alloc-edges))
      ((unless (eq code :ok)) (mv code fn2-journal-lease fn2-extents fn2-alloc-edges))
      (fn2-journal-lease (fn2-journal-lease-put 0 (scan commit) (next-event (+ first members)))))
   (mv :more fn2-journal-lease fn2-extents fn2-alloc-edges)))
(fn2-journal-lease-preserves fn2-journal-lease-claim
 (token kind owner generation commit-kind fn2-csnapshot fn2-journal-lease fn2-commit-root fn2-extents fn2-alloc-edges)
 :carriers ((fn2-journal-lease 1 :prefix "-LEASE")
            (fn2-extents 2 :prefix "-EXTENTS") (fn2-alloc-edges 3 :prefix "-EDGES")))

(defun fn2-journal-lease-source
 (token kind owner generation commit commit-kind fn2-journal-lease fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests)
 (declare (xargs :stobjs (fn2-journal-lease fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests)
  :guard (and (fn2-journal-lease-wfp fn2-journal-lease) (fn2-commit-root-wfp fn2-commit-root)
              (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges)
              (fn2-fc-wfp fn2-fc) (fn2-digests-wfp fn2-digests))
  :guard-hints ((fn2-columns-call-guard-hint 'fn2-journal-lease-source
                 '(fn2-journal-directory-entry fn2-alloc-edge-matchesp fn2-digest-rowp) nil world))))
 (b* (((unless (and (< 0 (fn2-journal-lease-rows fn2-journal-lease))
                     (fn2-journal-lease-ownerp token kind owner generation fn2-journal-lease)
                     (equal (fn2-journal-lease-phase 0 fn2-journal-lease) *fn2-journal-lease-phase-ready*)))
       (mv :owner 0 0 0 0 0 0 0))
      ((mv code extent epoch allocation first members)
       (fn2-journal-directory-entry commit (fn2-journal-lease-cut-commit 0 fn2-journal-lease)
        (fn2-journal-lease-cut-event 0 fn2-journal-lease) commit-kind fn2-commit-root fn2-extents))
      ((unless (and (eq code :ok) (posp commit))) (mv code 0 0 0 0 0 0 0))
      (edge (fn2-journal-lease-edge extent fn2-extents fn2-alloc-edges))
      (seal (+ (* *fn2-digest-stride* (fn2-fc-rows fn2-fc)) commit))
      ((unless (and (fn2-alloc-edge-slotp edge fn2-alloc-edges)
                     (fn2-alloc-edge-matchesp edge token extent epoch allocation :promised-read fn2-alloc-edges)
                     (fn2-digest-rowp seal fn2-digests) (fn2-digest-rowp (- seal 1) fn2-digests)))
       (mv :source 0 0 0 0 0 0 0)))
   (mv :ok extent epoch allocation first members seal (- seal 1))))

(defun fn2-journal-lease-close-start (token kind owner generation fn2-journal-lease)
 (declare (xargs :stobjs fn2-journal-lease :guard (fn2-journal-lease-wfp fn2-journal-lease)))
 (cond ((not (and (< 0 (fn2-journal-lease-rows fn2-journal-lease))
                  (fn2-journal-lease-ownerp token kind owner generation fn2-journal-lease)))
        (mv :owner fn2-journal-lease))
       ((equal (fn2-journal-lease-phase 0 fn2-journal-lease) *fn2-journal-lease-phase-closing*)
        (mv :ok fn2-journal-lease))
       (t (let ((fn2-journal-lease (fn2-journal-lease-put 0
                  (phase *fn2-journal-lease-phase-closing*) (scan 0))))
            (mv :ok fn2-journal-lease)))))
(fn2-journal-lease-preserves fn2-journal-lease-close-start
 (token kind owner generation fn2-journal-lease) :position 1)

; Release walks the edge region rather than the commit directory. After
; handoff, a journal row can be superseded without redirecting this cleanup.
(defun fn2-journal-lease-close-step (token kind owner generation fn2-journal-lease fn2-extents fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-journal-lease fn2-extents fn2-alloc-edges)
  :guard (and (fn2-journal-lease-wfp fn2-journal-lease) (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges))
  :guard-hints ((fn2-columns-call-guard-hint 'fn2-journal-lease-close-step
                 '(fn2-alloc-edge-drop) nil world))))
 (b* (((unless (and (< 0 (fn2-journal-lease-rows fn2-journal-lease))
                     (fn2-journal-lease-ownerp token kind owner generation fn2-journal-lease)
                     (equal (fn2-journal-lease-phase 0 fn2-journal-lease) *fn2-journal-lease-phase-closing*)
                     (unsigned-byte-p 60 token)))
       (mv :owner fn2-journal-lease fn2-extents fn2-alloc-edges))
      (extent (fn2-journal-lease-scan 0 fn2-journal-lease))
      ((unless (< extent (fn2-extents-rows fn2-extents)))
       (let ((fn2-journal-lease (fn2-journal-lease-set-phase 0 *fn2-journal-lease-phase-idle* fn2-journal-lease)))
         (mv :done fn2-journal-lease fn2-extents fn2-alloc-edges)))
      (edge (fn2-journal-lease-edge extent fn2-extents fn2-alloc-edges))
      ((unless (and (unsigned-byte-p 32 (+ 1 extent)) (fn2-alloc-edge-slotp edge fn2-alloc-edges)))
       (mv :bounds fn2-journal-lease fn2-extents fn2-alloc-edges))
      ((mv code fn2-extents fn2-alloc-edges)
       (if (equal (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-free*)
           (mv :ok fn2-extents fn2-alloc-edges)
         (fn2-alloc-edge-drop edge token extent (fn2-alloc-edges-epoch edge fn2-alloc-edges)
          (fn2-alloc-edges-counter edge fn2-alloc-edges) :promised-read fn2-extents fn2-alloc-edges)))
      ((unless (eq code :ok)) (mv code fn2-journal-lease fn2-extents fn2-alloc-edges))
      (fn2-journal-lease (fn2-journal-lease-set-scan 0 (+ 1 extent) fn2-journal-lease)))
   (mv :more fn2-journal-lease fn2-extents fn2-alloc-edges)))
(fn2-journal-lease-preserves fn2-journal-lease-close-step
 (token kind owner generation fn2-journal-lease fn2-extents fn2-alloc-edges)
 :carriers ((fn2-journal-lease 1 :prefix "-LEASE")
            (fn2-extents 2 :prefix "-EXTENTS") (fn2-alloc-edges 3 :prefix "-EDGES")))

  (:checkpoint-adopt-preflight
   (:do (code) (fn2-checkpoint-summary-apply-preflight-op) :accept ()
    :case (((:more) (:next :checkpoint-adopt-preflight) (:charge :steps *fn2-work-stage* :runnable t))

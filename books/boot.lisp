          ((equal row-stage 1) (:set (stage 2) (anchor-slot 1)) (:next :anchor) (:charge :steps *fn2-work-small* :runnable t))
          ((equal row-stage 2) (:next :recover) (:charge :steps *fn2-work-small* :runnable t))
          ((equal row-stage 4) (:set (checkpoint-index 0) (stage 5)) (:next :checkpoint-anchor) (:charge :steps *fn2-work-small* :runnable t))

   (:cond ((equal row-event-ready 0) (:idle))
          ((not (and (equal row-outcome *fn2-outcome-done*) (equal row-count 4096))) (:stop :io))
          (t (:cond ((equal row-stage 4) (:next :bootstrap-verify))
                    ((equal row-stage 5) (:next :checkpoint-check))
                    (t (:next :verify)))

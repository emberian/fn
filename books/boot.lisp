; Boot's operations and arms. Instantiated after B's recovery and C's replay.
(in-package "ACL2")
(include-book "boot-kind")
(include-book "pool-block")
(include-book "machines-a-access")
(fn2-book-layer :b)

(defun fn2-boot-pad (n off slot gen kind id ogen fn2-pool)
 (declare (xargs :stobjs fn2-pool :measure (nfix n)
                 :guard (and (fn2-pool-wfp fn2-pool) (natp n) (natp off))))
 (if (zp n) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen off 0 kind id ogen fn2-pool)
   (if (eq code :ok) (fn2-boot-pad (- n 1) (+ 1 off) slot gen kind id ogen fn2-pool)
    (mv code fn2-pool)))))
(fn2-pool-preserves fn2-boot-pad (n off slot gen kind id ogen fn2-pool) :position 1)
(in-theory (disable fn2-boot-pad))

; Generate scalar field preparation from named codec bindings. This is one
; bounded class of setters, not a second encoding of the geometry record.
(defun fn2-boot-geometry-bindings (bindings)
 (declare (xargs :guard t))
 (if (not (and (consp bindings) (consp (car bindings)) (consp (cdar bindings)))) nil
  (cons `(fn2-fields (fn2-fields-set-value (+ 256 ,(caar bindings)) ,(cadar bindings) fn2-fields))
        (fn2-boot-geometry-bindings (cdr bindings)))))
(make-event
 (value `(defun fn2-boot-geometry-fields (size extents groups fn2-fields)
  (declare (xargs :stobjs fn2-fields
   :guard (and (fn2-fields-wfp fn2-fields) (fn2-checkpoint-image-sizep size extents groups)
               (<= (+ 256 *fn2-checkpoint-geometry-record-num-fields*) (fn2-fields-rows fn2-fields))))
  (let* ,(fn2-boot-geometry-bindings
    '((*fn2-checkpoint-geometry-record-field-version* 1)
      (*fn2-checkpoint-geometry-record-field-image-bytes* size)
      (*fn2-checkpoint-geometry-record-field-sector-bytes* *fn2-format-sector-size*)
      (*fn2-checkpoint-geometry-record-field-page-bytes* *fn2-format-page-size*)
      (*fn2-checkpoint-geometry-record-field-extent-units* *fn2-storage-extent-units*)
      (*fn2-checkpoint-geometry-record-field-extents* extents)
      (*fn2-checkpoint-geometry-record-field-groups* groups)
      (*fn2-checkpoint-geometry-record-field-bootstrap* (fn2-checkpoint-bootstrap-unit extents groups))
      (*fn2-checkpoint-geometry-record-field-anchor-0* (fn2-checkpoint-anchor-unit 0 extents groups))
      (*fn2-checkpoint-geometry-record-field-anchor-1* (fn2-checkpoint-anchor-unit 1 extents groups))
      (*fn2-checkpoint-geometry-record-field-anchor-2* (fn2-checkpoint-anchor-unit 2 extents groups))
      (*fn2-checkpoint-geometry-record-field-anchor-3* (fn2-checkpoint-anchor-unit 3 extents groups))
      (*fn2-checkpoint-geometry-record-field-epoch-0* (- (floor size *fn2-format-sector-size*) 2))
      (*fn2-checkpoint-geometry-record-field-epoch-1* (- (floor size *fn2-format-sector-size*) 1))
      (*fn2-checkpoint-geometry-record-field-storage-domain* 0))) fn2-fields))))

(defun fn2-boot-pack-geometry (size extents groups slot gen id ogen fn2-fields fn2-digests fn2-b3 fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-digests fn2-b3 fn2-pool)
  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)
              (fn2-digests-wfp fn2-digests) (fn2-b3-wfp fn2-b3))))
 (b* (((unless (and (fn2-checkpoint-image-sizep size extents groups)
                     (<= (+ 256 *fn2-checkpoint-geometry-record-num-fields*) (fn2-fields-rows fn2-fields)))))
       (mv :geometry 0 fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv code fn2-pool) (fn2-pool-reset slot gen *fn2-boot-kind* id ogen fn2-pool))
      ((unless (eq code :ok)) (mv code 0 fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv code fn2-pool) (fn2-pool-append-text 0 *fn2-checkpoint-geometry-domain* slot gen *fn2-boot-kind* id ogen fn2-pool))
      ((unless (eq code :ok)) (mv code 0 fn2-fields fn2-digests fn2-b3 fn2-pool))
      (fn2-fields (fn2-boot-geometry-fields size extents groups fn2-fields))
      ((mv code end fn2-pool) (fn2-checkpoint-geometry-record-encode 256 slot gen 21 *fn2-boot-kind* id ogen fn2-fields fn2-pool))
      ((unless (and (eq code :ok) (natp end) (<= end 4096)))
       (mv :format 0 fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv code fn2-digests fn2-b3) (fn2-pool-block-hash 2 slot gen 0 end *fn2-boot-kind* id ogen fn2-digests fn2-b3 fn2-pool))
      (row (fn2-digest-slot 2 *fn2-b3-result*))
      ((unless (and (eq code :ok) (fn2-digest-rowp row fn2-digests)))
       (mv :bounds 0 fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv code fn2-pool) (fn2-digest-store 32 row slot gen end *fn2-boot-kind* id ogen fn2-digests fn2-pool)))
  (mv code end fn2-fields fn2-digests fn2-b3 fn2-pool)))

(fn2-pool-block-shape fn2-boot-pack-geometry-shape
 (fn2-boot-pack-geometry size extents groups slot gen id ogen fn2-fields fn2-digests fn2-b3 fn2-pool)
 (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)
      (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests)
      (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
 ((fn2-fields 2) (fn2-digests 3) (fn2-b3 4) (fn2-pool 5)))
(in-theory (disable fn2-boot-pack-geometry))

(defun fn2-boot-bootstrap-pool (size extents groups slot gen source sgen source-off id ogen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool)
  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (if (not (and (fn2-checkpoint-image-sizep size extents groups)
               (<= (+ 256 *fn2-format-bootstrap-num-fields*) (fn2-fields-rows fn2-fields))
               (unsigned-byte-p 32 source) (unsigned-byte-p 60 sgen) (unsigned-byte-p 32 source-off)
               (unsigned-byte-p 32 id) (unsigned-byte-p 60 ogen)))
     (mv :geometry fn2-fields fn2-pool)
  (b* (((mv code fn2-pool) (fn2-pool-reset slot gen *fn2-boot-kind* id ogen fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-fields fn2-pool))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-magic*) *fn2-format-bootstrap-magic* fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-version*) *fn2-format-version* fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-sector-size*) *fn2-format-sector-size* fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-page-size*) *fn2-format-page-size* fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-anchor-0*) (fn2-checkpoint-anchor-unit 0 extents groups) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-anchor-1*) (fn2-checkpoint-anchor-unit 1 extents groups) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-anchor-2*) (fn2-checkpoint-anchor-unit 2 extents groups) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-anchor-3*) (fn2-checkpoint-anchor-unit 3 extents groups) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-storage-domain*) 0 fn2-fields))
       (fn2-fields (fn2-fields-put (+ 256 *fn2-format-bootstrap-field-geometry-hash*)
                      (value 1) (ref-slot source) (ref-gen sgen) (ref-off source-off) (ref-len 32)))
       ((mv code end fn2-pool) (fn2-format-bootstrap-encode 256 slot gen 0 *fn2-boot-kind* id ogen fn2-fields fn2-pool))
       ((unless (and (eq code :ok) (natp end) (<= end 4096))) (mv :bounds fn2-fields fn2-pool))
       ((mv code fn2-pool) (fn2-boot-pad (- 4096 end) end slot gen *fn2-boot-kind* id ogen fn2-pool)))
   (mv code fn2-fields fn2-pool))))

(fn2-fields-preserves fn2-boot-bootstrap-pool
 (size extents groups slot gen source sgen source-off id ogen fn2-fields fn2-pool)
 :carriers ((fn2-fields 1 :prefix "-FIELDS") (fn2-pool 2 :prefix "-POOL")))
(in-theory (disable fn2-boot-bootstrap-pool))

(defun fn2-boot-save-geometry (i source sgen source-off id ogen fn2-pool fn2-boot-config)
 (declare (xargs :stobjs (fn2-pool fn2-boot-config) :measure (nfix (- 32 (nfix i)))
  :guard (and (fn2-pool-wfp fn2-pool) (fn2-boot-config-wfp fn2-boot-config) (natp i) (<= i 32) (natp source-off))))
 (if (or (not (natp i)) (>= i 32)) (mv :ok fn2-boot-config)
  (mv-let (code byte) (fn2-pool-read source sgen (+ source-off i) *fn2-boot-kind* id ogen fn2-pool)
   (if (not (eq code :ok)) (mv code fn2-boot-config)
    (let ((fn2-boot-config (update-fn2-boot-config-geometryi i byte fn2-boot-config)))
     (fn2-boot-save-geometry (+ 1 i) source sgen source-off id ogen fn2-pool fn2-boot-config))))))

(fn2-boot-config-preserves fn2-boot-save-geometry
 (i source sgen source-off id ogen fn2-pool fn2-boot-config) :position 1)
(in-theory (disable fn2-boot-save-geometry))

; Stage the generated codec's fields separately from pool I/O, so shape
; proofs compose across one field-table operation instead of every setter.
(defun fn2-boot-field-inputsp (kind index size extents groups owner authority textlen value epoch scratch sgen)
 (declare (xargs :guard t))
 (and (unsigned-byte-p 8 kind) (unsigned-byte-p 32 index) (unsigned-byte-p 60 size)
      (unsigned-byte-p 32 extents) (unsigned-byte-p 32 groups) (unsigned-byte-p 32 owner)
      (unsigned-byte-p 1 authority) (unsigned-byte-p 32 textlen)
      (unsigned-byte-p 60 value) (unsigned-byte-p 60 epoch)
      (unsigned-byte-p 32 scratch) (unsigned-byte-p 60 sgen)))
(defun fn2-boot-fields (kind index size extents groups owner authority textlen value epoch scratch sgen fn2-fields)
 (declare (xargs :stobjs fn2-fields
  :guard (and (fn2-fields-wfp fn2-fields)
              (<= (+ 256 *fn2-boot-record-num-fields*) (fn2-fields-rows fn2-fields))
              (fn2-boot-field-inputsp kind index size extents groups owner authority textlen value epoch scratch sgen))))
 (let* (
      (fn2-fields (fn2-fields-set-value (+ 256 *fn2-boot-record-field-magic*) *fn2-boot-magic* fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 256 *fn2-boot-record-field-version*) 1 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 256 *fn2-boot-record-field-kind*) kind fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 256 *fn2-boot-record-field-index*) index fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 256 *fn2-boot-record-field-image-size*) size fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 256 *fn2-boot-record-field-extents*) extents fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 256 *fn2-boot-record-field-groups*) groups fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 256 *fn2-boot-record-field-owner*) owner fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 256 *fn2-boot-record-field-authority*) authority fn2-fields))
      (fn2-fields (fn2-fields-put (+ 256 *fn2-boot-record-field-identity*)
                    (value 1) (ref-slot scratch) (ref-gen sgen) (ref-off 0) (ref-len textlen)))
      (fn2-fields (fn2-fields-set-value (+ 256 *fn2-boot-record-field-value*) value fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 256 *fn2-boot-record-field-epoch*) epoch fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 256 *fn2-boot-record-field-previous*) (if (posp epoch) (- epoch 1) 0) fn2-fields))
) fn2-fields))
(fn2-fields-preserves fn2-boot-fields
 (kind index size extents groups owner authority textlen value epoch scratch sgen fn2-fields)
 :raw-rows t
 :hyps ((fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)
        (<= (+ 256 *fn2-boot-record-num-fields*) (fn2-fields-rows fn2-fields))
        (fn2-boot-field-inputsp kind index size extents groups owner authority textlen value epoch scratch sgen))
 :hints (("Goal" :in-theory (e/d (fn2-boot-fields) (fn2-fieldsp fn2-fields-wfp fn2-fields-rows)))))
(in-theory (disable fn2-boot-fields fn2-boot-field-inputsp))

; The generated record codec is the single encoding. The last 32 bytes
; are BLAKE3 of the whole padded prefix, including geometry and record role.
(defun fn2-boot-pack-pool (kind index size extents groups owner authority text value epoch
                         slot gen scratch sgen okind id ogen fn2-fields fn2-digests fn2-b3 fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-digests fn2-b3 fn2-pool)
                 :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (<= (+ 256 *fn2-boot-record-num-fields*) (fn2-fields-rows fn2-fields))
                    (stringp text) (<= (length text) 250)
                    (fn2-boot-field-inputsp kind index size extents groups owner authority
                                           (length text) value epoch scratch sgen)
                    (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen)
                    (unsigned-byte-p 32 id) (unsigned-byte-p 60 ogen)))
       (mv :bounds fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv c fn2-pool) (fn2-pool-reset slot gen okind id ogen fn2-pool))
      ((unless (eq c :ok)) (mv c fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv c fn2-pool) (if (equal kind 2) (mv :ok fn2-pool)
                         (fn2-pool-reset scratch sgen okind id ogen fn2-pool)))
      ((unless (eq c :ok)) (mv c fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv c fn2-pool) (fn2-pool-append-text 0 text scratch sgen okind id ogen fn2-pool))
      ((unless (eq c :ok)) (mv c fn2-fields fn2-digests fn2-b3 fn2-pool))
      (fn2-fields (fn2-boot-fields kind index size extents groups owner authority (length text) value epoch scratch sgen fn2-fields))
      ((mv c end fn2-pool) (fn2-boot-record-encode 256 slot gen 0 okind id ogen fn2-fields fn2-pool))
      ((unless (and (eq c :ok) (natp end) (<= end *fn2-boot-hash-offset*)))
       (mv :bounds fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv c fn2-pool) (fn2-boot-pad (- *fn2-boot-hash-offset* end) end slot gen okind id ogen fn2-pool))
      ((unless (eq c :ok)) (mv c fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv c fn2-digests fn2-b3) (fn2-pool-block-hash 2 slot gen 0 *fn2-boot-hash-offset* okind id ogen fn2-digests fn2-b3 fn2-pool))
      (dst (fn2-digest-slot 2 *fn2-b3-result*))
      ((unless (and (eq c :ok) (fn2-digest-rowp dst fn2-digests)))
       (mv :bounds fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv c fn2-pool) (fn2-digest-store 32 dst slot gen *fn2-boot-hash-offset* okind id ogen fn2-digests fn2-pool)))
   (mv c fn2-fields fn2-digests fn2-b3 fn2-pool)))
(fn2-pool-block-shape fn2-boot-pack-pool-shape
 (fn2-boot-pack-pool kind index size extents groups owner authority text value epoch slot gen scratch sgen okind id ogen
                     fn2-fields fn2-digests fn2-b3 fn2-pool)
 (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests)
      (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
 ((fn2-fields 1) (fn2-digests 2) (fn2-b3 3) (fn2-pool 4))
 (("Goal" :in-theory (e/d (fn2-boot-pack-pool) (fn2-pool-reset fn2-fieldsp fn2-fields-wfp fn2-digestsp fn2-digests-wfp
         fn2-b3p fn2-b3-wfp fn2-poolp fn2-pool-wfp fn2-fields-rows fn2-pool-rows fn2-digests-rows fn2-b3-rows)))))
(in-theory (disable fn2-boot-pack-pool))

(defcost fn2-boot-pack :answers t :bytes 12288
 :tables (fn2-core-pool fn2-core-fields fn2-core-digests fn2-core-b3)
 :doc "Encode one genesis or epoch unit and its BLAKE3, from trusted configuration scalars.")
(defcost fn2-boot-pack-bootstrap :answers t :bytes 24576
 :tables (fn2-core-pool fn2-core-fields fn2-core-digests fn2-core-b3 fn2-core-boot-config)
 :doc "Generate the four-anchor bootstrap and retain its configuration-bound geometry hash.")
(defcost fn2-boot-checkpoint-offset :answers (:ok :geometry) :doc "Derive bootstrap or checkpoint anchor byte offset from authoritative ACL2 image geometry.")
(defcost fn2-boot-zero-checkpoint :answers t :bytes 4096 :tables (fn2-core-pool)
 :doc "Construct the canonical empty checkpoint anchor unit.")
(defcost fn2-boot-bind-checkpoint-layout :answers t :tables (fn2-core-boot-config)
 :doc "Bind checked bootstrap geometry only at successful final boot fence completion.")
(defcost fn2-boot-match :answers (:ok :different :bounds) :bytes 8192
 :doc "Compare an image unit to its canonical generated encoding, including its BLAKE3.")
(defcost fn2-boot-pop-config :answers (:ok :bounds) :tables (fn2-core-boot-config)
 :doc "Advance exactly one trusted configuration group after its image unit matches or completes.")
(defcost fn2-boot-read-epoch :answers (:ok :bounds :format) :bytes 4096 :tables (fn2-core-fields)
 :doc "Decode a candidate epoch; it has no authority until the whole unit matches a canonical hashed record.")
(defcost fn2-boot-check-anchor :answers t :bytes 24576
 :tables (fn2-core-pool fn2-core-fields fn2-core-digests fn2-core-b3)
 :doc "Decode the epoch and compare the entire anchor to its canonical generated, BLAKE3-covered record.")
(defcost fn2-boot-recover :answers t :tables (fn2-recovery-machine-table fn2-core-pool fn2-core-digests fn2-core-control)
 :doc "Prepare recovery under the declared startup storage fault contract and no external witness; return its row for :wake-row.")
(defcost fn2-boot-recovered :answers (:more :ok :failed) :doc "Observe completion and classification of the real recovery/replay machine.")
(defcost fn2-boot-select-epoch :answers (:ok :bounds) :doc "Choose above both persisted epoch anchors and recovery's allocator epoch.")
(defcost fn2-boot-adopt-epoch :answers t :tables (fn2-core-extents)
 :doc "Begin allocation in the new epoch only after its successful image Fence.")
(defcost fn2-boot-release-listener :answers (:more :ok :bounds)
 :doc "Select one listener after boot's epoch fence; the arm releases it through :wake-row.")
(defcost fn2-boot-release-windows :answers t :tables (fn2-core-pool fn2-core-control)
 :effects ((:release (:storage-window)))
 :doc "Release both startup windows after their last fence; neither is lent now.")

(defmacro fn2-boot-operations ()
 '(progn
 (defun fn2-boot-pack (kind index size epoch slot gen scratch sgen id ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core))
              (fn2-fields (fn2-core-fields fn2-core)) (fn2-digests (fn2-core-digests fn2-core))
              (fn2-b3 (fn2-core-b3 fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
   (code fn2-fields fn2-digests fn2-b3 fn2-pool)
   (let* ((gs (fn2-boot-config-groups fn2-boot-config))
          (text (cond ((equal kind 0) (fn2-boot-config-path fn2-boot-config))
                      ((and (equal kind 1) (consp gs) (consp (car gs))) (caar gs)) (t "")))
          (value (if (and (equal kind 1) (consp gs) (consp (car gs))) (cdar gs) 0)))
    (fn2-boot-pack-pool kind index size (fn2-boot-config-extents fn2-boot-config)
      (fn2-boot-config-count fn2-boot-config) (fn2-boot-config-owner fn2-boot-config)
      (fn2-boot-config-authority fn2-boot-config) text value epoch slot gen scratch sgen *fn2-boot-kind* id ogen
      fn2-fields fn2-digests fn2-b3 fn2-pool))
   (mv code fn2-core)))
 (fn2-core-preserves fn2-boot-pack (kind index size epoch slot gen scratch sgen id ogen fn2-core) :position 1 :rows nil)

 (defun fn2-boot-pack-bootstrap (size slot gen rx rgen id ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core))
              (fn2-fields (fn2-core-fields fn2-core)) (fn2-digests (fn2-core-digests fn2-core))
              (fn2-b3 (fn2-core-b3 fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
   (code fn2-fields fn2-digests fn2-b3 fn2-pool fn2-boot-config)
   (b* (((mv code source-off fn2-fields fn2-digests fn2-b3 fn2-pool)
         (fn2-boot-pack-geometry size (fn2-boot-config-extents fn2-boot-config)
           (fn2-boot-config-count fn2-boot-config) rx rgen id ogen fn2-fields fn2-digests fn2-b3 fn2-pool))
        ((unless (eq code :ok)) (mv code fn2-fields fn2-digests fn2-b3 fn2-pool fn2-boot-config))
        ((mv code fn2-fields fn2-pool)
         (fn2-boot-bootstrap-pool size (fn2-boot-config-extents fn2-boot-config)
          (fn2-boot-config-count fn2-boot-config) slot gen rx rgen source-off id ogen fn2-fields fn2-pool))
        ((unless (eq code :ok)) (mv code fn2-fields fn2-digests fn2-b3 fn2-pool fn2-boot-config))
        ((mv code fn2-boot-config) (fn2-boot-save-geometry 0 rx rgen source-off id ogen fn2-pool fn2-boot-config)))
    (mv code fn2-fields fn2-digests fn2-b3 fn2-pool fn2-boot-config))
   (mv code fn2-core)))
 (fn2-core-preserves fn2-boot-pack-bootstrap (size slot gen rx rgen id ogen fn2-core) :position 1 :rows nil)

 (defun fn2-boot-checkpoint-offset (index size fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core))) (code offset)
   (if (equal index 4)
    (if (fn2-checkpoint-image-sizep size (fn2-boot-config-extents fn2-boot-config) (fn2-boot-config-count fn2-boot-config))
     (mv :ok (* 4096 (fn2-checkpoint-bootstrap-unit (fn2-boot-config-extents fn2-boot-config) (fn2-boot-config-count fn2-boot-config))))
     (mv :geometry 0))
    (fn2-checkpoint-anchor-offset index size (fn2-boot-config-extents fn2-boot-config)
                                 (fn2-boot-config-count fn2-boot-config)))
   (mv code offset)))

 (defun fn2-boot-zero-checkpoint (slot gen id ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
   (mv-let (code fn2-pool) (fn2-pool-reset slot gen *fn2-boot-kind* id ogen fn2-pool)
    (if (eq code :ok) (fn2-boot-pad 4096 0 slot gen *fn2-boot-kind* id ogen fn2-pool) (mv code fn2-pool)))
   (mv code fn2-core)))
 (fn2-core-preserves fn2-boot-zero-checkpoint (slot gen id ogen fn2-core) :position 1 :rows nil)

 ; This binding is reached after bootstrap/anchor checks, recovery, and the
 ; final writer-epoch fence. A size argument alone never marks it ready.
 (defun fn2-boot-bind-checkpoint-layout (id fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (if (not (and (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
                 (equal (fn2-machine-phase id fn2-core) *fn2-boot-state-epoch-result*)
                 (equal (fn2-machine-stage id fn2-core) 3)
                 (equal (fn2-machine-event-ready id fn2-core) 1)
                 (equal (fn2-machine-outcome id fn2-core) *fn2-outcome-done*)))
      (mv :state fn2-core)
   (let ((size (fn2-machine-image-size id fn2-core)))
    (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core))) (code fn2-boot-config)
     (if (not (fn2-checkpoint-image-sizep size (fn2-boot-config-extents fn2-boot-config) (fn2-boot-config-count fn2-boot-config)))
         (mv :geometry fn2-boot-config)
      (let* ((fn2-boot-config (update-fn2-boot-config-image-size size fn2-boot-config))
             (fn2-boot-config (update-fn2-boot-config-checkpoint-layout-ready 1 fn2-boot-config)))
       (mv :ok fn2-boot-config)))
     (mv code fn2-core)))))
 (fn2-core-preserves fn2-boot-bind-checkpoint-layout (id fn2-core) :position 1 :rows nil)

 (defun fn2-boot-match (slot gen rx rgen id ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (mv-let (code result at) (fn2-core-compare slot gen 0 *fn2-boot-kind* id ogen
                           rx rgen 0 *fn2-boot-kind* id ogen 4096 fn2-core)
   (declare (ignore at))
   (cond ((not (eq code :ok)) :bounds) ((eq result :equal) :ok) (t :different))))

 (defun fn2-boot-pop-config (index fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core))) (code fn2-boot-config)
   (let ((gs (fn2-boot-config-groups fn2-boot-config)))
    (cond ((equal index 0) (mv :ok fn2-boot-config))
          ((consp gs)
        (let ((fn2-boot-config (update-fn2-boot-config-groups (cdr gs) fn2-boot-config))) (mv :ok fn2-boot-config)))
          (t (mv :bounds fn2-boot-config))))
   (mv code fn2-core)))
 (fn2-core-preserves fn2-boot-pop-config (index fn2-core) :position 1 :rows nil)

 (defun fn2-boot-read-epoch (slot gen id ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (code epoch fn2-fields)
   (if (and (<= (+ 256 *fn2-boot-record-num-fields*) (fn2-fields-rows fn2-fields))
            (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen) (unsigned-byte-p 32 id) (unsigned-byte-p 60 ogen))
     (mv-let (code end fn2-fields) (fn2-boot-record-decode 256 slot gen 0 4064 *fn2-boot-kind* id ogen fn2-fields fn2-pool)
      (declare (ignore end))
      (mv (if (eq code :ok) :ok :format) (nfix (fn2-fields-value (+ 256 *fn2-boot-record-field-epoch*) fn2-fields)) fn2-fields))
    (mv :bounds 0 fn2-fields))
   (mv code epoch fn2-core)))
 (fn2-core-preserves fn2-boot-read-epoch (slot gen id ogen fn2-core) :position 2 :rows nil)

 (defun fn2-boot-check-anchor (index size slot gen rx rgen id ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((mv code epoch fn2-core) (fn2-boot-read-epoch rx rgen id ogen fn2-core))
       ((unless (eq code :ok)) (mv code 0 fn2-core))
       ((mv code fn2-core) (fn2-boot-pack 2 index size epoch slot gen rx rgen id ogen fn2-core))
       ((unless (eq code :ok)) (mv code 0 fn2-core)))
   (mv (fn2-boot-match slot gen rx rgen id ogen fn2-core) epoch fn2-core)))
 (fn2-core-preserves fn2-boot-check-anchor (index size slot gen rx rgen id ogen fn2-core) :position 2 :rows nil)

 (defun fn2-boot-recover (fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (let ((target (fn2-machine-kind-base *fn2-recovery-machine-kind* fn2-core))
        (assume (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core))) (assume)
                  (fn2-boot-config-recovery-assumptions fn2-boot-config) assume)))
   (mv-let (code fn2-core) (fn2-recovery-prepare target assume 0 fn2-core)
    (mv code target fn2-core))))
 (fn2-core-preserves fn2-boot-recover (fn2-core) :position 2 :rows nil)
 (defun fn2-boot-recovered (fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (let ((id (fn2-machine-kind-base *fn2-recovery-machine-kind* fn2-core)))
   (cond ((not (eq (fn2-recovery-machine-snapshot-read-code id fn2-core) :ok)) :failed)
         ((not (equal (fn2-machine-phase id fn2-core) *fn2-recovery-machine-state-done*)) :more)
         ((member (fn2-machine-rc-class id fn2-core) (list *fn2-rec-class-intact* *fn2-rec-class-torn-tail*)) :ok)
         (t :failed))))
 (defun fn2-boot-select-epoch (e0 e1 fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code epoch)
   (let ((next (+ 1 (max (nfix e0) (nfix e1)))))
    (if (and (unsigned-byte-p 60 next) (<= (abs (- (nfix e0) (nfix e1))) 1)
             (<= (fn2-alloc-current-epoch fn2-extents) next)) (mv :ok next) (mv :bounds 0)))
   (mv code epoch)))
 (defun fn2-boot-adopt-epoch (epoch fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
   (cond ((not (unsigned-byte-p 60 epoch)) (mv :bounds fn2-extents))
         ((equal epoch (fn2-alloc-current-epoch fn2-extents)) (mv :ok fn2-extents))
         (t (fn2-alloc-begin-epoch epoch fn2-extents)))
   (mv code fn2-core)))
 (fn2-core-preserves fn2-boot-adopt-epoch (epoch fn2-core) :position 1 :rows nil)
 (defun fn2-boot-release-listener (index fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (if (and (natp index) (< index (fn2-machine-accept-count fn2-core)))
   (let ((target (+ index (fn2-machine-kind-base *fn2-listener-kind* fn2-core))))
    (mv (if (eq (fn2-listener-snapshot-read-code target fn2-core) :ok) :more :bounds) target fn2-core))
   (mv :ok *fn2-none* fn2-core)))
 (fn2-core-preserves fn2-boot-release-listener (index fn2-core) :position 2 :rows nil)
 (defun fn2-boot-release-windows (slot gen rx rgen id ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (mv-let (code fn2-core) (fn2-core-release rx rgen *fn2-boot-kind* id ogen fn2-core)
   (if (member-eq code '(:ok :retired))
    (mv-let (code fn2-core) (fn2-core-release slot gen *fn2-boot-kind* id ogen fn2-core)
     (mv (if (member-eq code '(:ok :retired)) :ok code) fn2-core))
    (mv code fn2-core))))
 (fn2-core-preserves fn2-boot-release-windows (slot gen rx rgen id ogen fn2-core) :position 1 :rows nil)
 (in-theory (disable fn2-boot-pack fn2-boot-match fn2-boot-pop-config fn2-boot-read-epoch fn2-boot-check-anchor
                     fn2-boot-recover fn2-boot-recovered fn2-boot-select-epoch fn2-boot-adopt-epoch fn2-boot-release-listener
                     fn2-boot-release-windows))
 ))

(defmachine-arms fn2-boot :declare

(defun fn2-boot-geometry-bindings (bindings)
 (declare (xargs :guard t))
 (if (not (and (consp bindings) (consp (car bindings)) (consp (cdar bindings)))) nil
  (cons `(fn2-fields (fn2-fields-set-value (+ 256 ,(caar bindings)) ,(cadar bindings) fn2-fields))
        (fn2-boot-geometry-bindings (cdr bindings)))))
(make-event
 (value `(defun fn2-boot-geometry-fields (size extents groups fn2-fields)
  (declare (xargs :stobjs fn2-fields
   :guard (and (fn2-fields-wfp fn2-fields) (fn2-checkpoint-image-sizep size extents groups)
               (<= (+ 256 *fn2-checkpoint-geometry-record-num-fields*) (fn2-fields-rows fn2-fields)))))
  (let* ,(fn2-boot-geometry-bindings
    '((*fn2-checkpoint-geometry-record-field-version* 1)
      (*fn2-checkpoint-geometry-record-field-image-bytes* size)
      (*fn2-checkpoint-geometry-record-field-sector-bytes* *fn2-format-sector-size*)
      (*fn2-checkpoint-geometry-record-field-page-bytes* *fn2-format-page-size*)
      (*fn2-checkpoint-geometry-record-field-extent-units* *fn2-storage-extent-units*)
      (*fn2-checkpoint-geometry-record-field-extents* extents)
      (*fn2-checkpoint-geometry-record-field-groups* groups)
      (*fn2-checkpoint-geometry-record-field-bootstrap* (fn2-checkpoint-bootstrap-unit extents groups))
      (*fn2-checkpoint-geometry-record-field-anchor-0* (fn2-checkpoint-anchor-unit 0 extents groups))
      (*fn2-checkpoint-geometry-record-field-anchor-1* (fn2-checkpoint-anchor-unit 1 extents groups))
      (*fn2-checkpoint-geometry-record-field-anchor-2* (fn2-checkpoint-anchor-unit 2 extents groups))
      (*fn2-checkpoint-geometry-record-field-anchor-3* (fn2-checkpoint-anchor-unit 3 extents groups))
      (*fn2-checkpoint-geometry-record-field-epoch-0* (- (floor size *fn2-format-sector-size*) 2))
      (*fn2-checkpoint-geometry-record-field-epoch-1* (- (floor size *fn2-format-sector-size*) 1))
      (*fn2-checkpoint-geometry-record-field-storage-domain* 0))) fn2-fields))))

(defun fn2-boot-pack-geometry (size extents groups slot gen id ogen fn2-fields fn2-digests fn2-b3 fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-digests fn2-b3 fn2-pool)
  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)
              (fn2-digests-wfp fn2-digests) (fn2-b3-wfp fn2-b3))))
 (b* (((unless (and (fn2-checkpoint-image-sizep size extents groups)
                     (<= (+ 256 *fn2-checkpoint-geometry-record-num-fields*) (fn2-fields-rows fn2-fields))))
       (mv :geometry 0 fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv code fn2-pool) (fn2-pool-reset slot gen *fn2-boot-kind* id ogen fn2-pool))
      ((unless (eq code :ok)) (mv code 0 fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv code fn2-pool) (fn2-pool-append-text 0 *fn2-checkpoint-geometry-domain* slot gen *fn2-boot-kind* id ogen fn2-pool))
      ((unless (eq code :ok)) (mv code 0 fn2-fields fn2-digests fn2-b3 fn2-pool))
      (fn2-fields (fn2-boot-geometry-fields size extents groups fn2-fields))
      ((mv code end fn2-pool) (fn2-checkpoint-geometry-record-encode 256 slot gen 21 *fn2-boot-kind* id ogen fn2-fields fn2-pool))
      ((unless (and (eq code :ok) (natp end) (<= end 4096)))
       (mv :format 0 fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv code fn2-digests fn2-b3) (fn2-pool-block-hash 2 slot gen 0 end *fn2-boot-kind* id ogen fn2-digests fn2-b3 fn2-pool))
      (row (fn2-digest-slot 2 *fn2-b3-result*))
      ((unless (and (eq code :ok) (fn2-digest-rowp row fn2-digests)))
       (mv :bounds 0 fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv code fn2-pool) (fn2-digest-store 32 row slot gen end *fn2-boot-kind* id ogen fn2-digests fn2-pool)))
  (mv code end fn2-fields fn2-digests fn2-b3 fn2-pool)))

(fn2-pool-block-shape fn2-boot-pack-geometry-shape
 (fn2-boot-pack-geometry size extents groups slot gen id ogen fn2-fields fn2-digests fn2-b3 fn2-pool)
 (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)
      (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests)
      (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
 ((fn2-fields 2) (fn2-digests 3) (fn2-b3 4) (fn2-pool 5)))
(in-theory (disable fn2-boot-pack-geometry))

(defun fn2-boot-bootstrap-pool (size extents groups slot gen source sgen source-off id ogen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool)
  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (if (not (and (fn2-checkpoint-image-sizep size extents groups)
               (<= (+ 256 *fn2-format-bootstrap-num-fields*) (fn2-fields-rows fn2-fields))
               (unsigned-byte-p 32 source) (unsigned-byte-p 60 sgen) (unsigned-byte-p 32 source-off)
               (unsigned-byte-p 32 id) (unsigned-byte-p 60 ogen)))
     (mv :geometry fn2-fields fn2-pool)
  (b* (((mv code fn2-pool) (fn2-pool-reset slot gen *fn2-boot-kind* id ogen fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-fields fn2-pool))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-magic*) *fn2-format-bootstrap-magic* fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-version*) *fn2-format-version* fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-sector-size*) *fn2-format-sector-size* fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-page-size*) *fn2-format-page-size* fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-anchor-0*) (fn2-checkpoint-anchor-unit 0 extents groups) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-anchor-1*) (fn2-checkpoint-anchor-unit 1 extents groups) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-anchor-2*) (fn2-checkpoint-anchor-unit 2 extents groups) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-anchor-3*) (fn2-checkpoint-anchor-unit 3 extents groups) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ 256 *fn2-format-bootstrap-field-storage-domain*) 0 fn2-fields))
       (fn2-fields (fn2-fields-put (+ 256 *fn2-format-bootstrap-field-geometry-hash*)
                      (value 1) (ref-slot source) (ref-gen sgen) (ref-off source-off) (ref-len 32)))
       ((mv code end fn2-pool) (fn2-format-bootstrap-encode 256 slot gen 0 *fn2-boot-kind* id ogen fn2-fields fn2-pool))
       ((unless (and (eq code :ok) (natp end) (<= end 4096))) (mv :bounds fn2-fields fn2-pool))
       ((mv code fn2-pool) (fn2-boot-pad (- 4096 end) end slot gen *fn2-boot-kind* id ogen fn2-pool)))
   (mv code fn2-fields fn2-pool))))

(fn2-fields-preserves fn2-boot-bootstrap-pool
 (size extents groups slot gen source sgen source-off id ogen fn2-fields fn2-pool)
 :carriers ((fn2-fields 1 :prefix "-FIELDS") (fn2-pool 2 :prefix "-POOL")))
(in-theory (disable fn2-boot-bootstrap-pool))

(defun fn2-boot-save-geometry (i source sgen source-off id ogen fn2-pool fn2-boot-config)
 (declare (xargs :stobjs (fn2-pool fn2-boot-config) :measure (nfix (- 32 (nfix i)))
  :guard (and (fn2-pool-wfp fn2-pool) (fn2-boot-config-wfp fn2-boot-config) (natp i) (<= i 32) (natp source-off))))
 (if (or (not (natp i)) (>= i 32)) (mv :ok fn2-boot-config)
  (mv-let (code byte) (fn2-pool-read source sgen (+ source-off i) *fn2-boot-kind* id ogen fn2-pool)
   (if (not (eq code :ok)) (mv code fn2-boot-config)
    (let ((fn2-boot-config (update-fn2-boot-config-geometryi i byte fn2-boot-config)))
     (fn2-boot-save-geometry (+ 1 i) source sgen source-off id ogen fn2-pool fn2-boot-config))))))

(fn2-boot-config-preserves fn2-boot-save-geometry
 (i source sgen source-off id ogen fn2-pool fn2-boot-config) :position 1)
(in-theory (disable fn2-boot-save-geometry))

; Stage the generated codec's fields separately from pool I/O, so shape
; proofs compose across one field-table operation instead of every setter.
(defun fn2-boot-save-anchor-digest (left dst src slot gen id ogen fn2-pool fn2-boot-config)
 (declare (xargs :stobjs (fn2-pool fn2-boot-config) :measure (nfix left)
  :guard (and (fn2-pool-wfp fn2-pool) (fn2-boot-config-wfp fn2-boot-config)
              (natp left) (<= left 32) (natp dst) (<= (+ dst left) 384) (natp src))))
 (if (zp left) (mv :ok fn2-boot-config)
  (mv-let (code byte) (fn2-pool-read slot gen src *fn2-boot-kind* id ogen fn2-pool)
   (if (not (eq code :ok)) (mv code fn2-boot-config)
    (let ((fn2-boot-config (update-fn2-boot-config-anchor-evidencei dst byte fn2-boot-config)))
     (fn2-boot-save-anchor-digest (- left 1) (+ dst 1) (+ src 1) slot gen id ogen fn2-pool fn2-boot-config))))))

(defun fn2-boot-save-anchor-evidence (anchor slot gen id ogen fn2-fields fn2-pool fn2-boot-config)
 (declare (xargs :stobjs (fn2-fields fn2-pool fn2-boot-config)
  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (fn2-boot-config-wfp fn2-boot-config))))
 (b* (((unless (and (fn2-origin-physicalp (fn2-origin-history fn2-origin) (fn2-origin-history-incarnation fn2-origin))
                     (natp anchor) (< anchor 4)
                     (<= (+ 256 *fn2-format-anchor-num-fields*) (fn2-fields-rows fn2-fields)))) (mv :bounds fn2-boot-config))
      ((mv code fn2-boot-config) (fn2-boot-save-anchor-digest 32 (* 96 anchor)
        (fn2-fields-ref-off (+ 256 *fn2-format-anchor-field-checkpoint-batch*) fn2-fields) slot gen id ogen fn2-pool fn2-boot-config))
      ((unless (eq code :ok)) (mv code fn2-boot-config))
      ((mv code fn2-boot-config) (fn2-boot-save-anchor-digest 32 (+ 32 (* 96 anchor))
        (fn2-fields-ref-off (+ 256 *fn2-format-anchor-field-previous-checkpoint*) fn2-fields) slot gen id ogen fn2-pool fn2-boot-config))
      ((unless (eq code :ok)) (mv code fn2-boot-config)))
  (fn2-boot-save-anchor-digest 32 (+ 64 (* 96 anchor))
    (fn2-fields-ref-off (+ 256 *fn2-format-anchor-field-anchor-hash*) fn2-fields) slot gen id ogen fn2-pool fn2-boot-config)))

; Invoked only while boot owns both startup windows after bootstrap match.
; The expected geometry bytes come from boot's own configuration-bound hash.
(defun fn2-boot-scan-checkpoint-pool-inner (anchor length slot gen id ogen
                                    fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                                    fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-origin fn2-digests)
 (declare (xargs :stobjs (fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                          fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-origin fn2-digests)
  :guard (and (fn2-boot-config-wfp fn2-boot-config) (fn2-checkpoints-wfp fn2-checkpoints)
              (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
              (fn2-fc-wfp fn2-fc) (fn2-fc-context-wfp fn2-fc-context) (fn2-b3-wfp fn2-b3)
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (fn2-digests-wfp fn2-digests) (fn2-origin-wfp fn2-origin))))
 (b* ((row 2) (base 256) (geometry (fn2-digest-slot 2 *fn2-fc-geometry*))
      ((unless (and (natp anchor) (< anchor 4) (natp length) (<= length *fn2-format-anchor-max-size*)
                     (< row (fn2-fc-rows fn2-fc)) (< row (fn2-fc-context-rows fn2-fc-context))
                     (fn2-b3-ready row fn2-b3 fn2-digests) (fn2-digest-rowp geometry fn2-digests)
                     (<= (+ base *fn2-format-sealed-batch-num-fields*) (fn2-fields-rows fn2-fields))))
       (mv :bounds 0 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      (empty (if (zp length) (fn2-checkpoint-restore-zero-range 4096 0 slot gen *fn2-boot-kind* id ogen fn2-pool) :padding))
      ((when (eq empty :ok))
       (mv :empty 0 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      ((unless (eq empty :padding))
       (mv empty 0 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      ((unless (fn2-checkpoint-slotp anchor fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes))
       (mv :bounds 0 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      ((mv code len fn2-fields)
       (if (zp length)
        (fn2-format-anchor-decode base slot gen 0 *fn2-format-anchor-max-size* *fn2-boot-kind* id ogen fn2-fields fn2-pool)
        (mv :ok length fn2-fields)))
      ((unless (and (eq code :ok) (posp len) (<= len *fn2-format-anchor-max-size*)))
       (mv :format 0 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      ; The anchor is a sector record with canonical zero tail, not a prefix
      ; parser that silently accepts an unrelated second record in the sector.
      (code (if (zp length) (fn2-checkpoint-restore-zero-range (- 4096 len) len slot gen *fn2-boot-kind* id ogen fn2-pool) :ok))
      ((unless (eq code :ok))
       (mv code 0 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      (fn2-digests (if (zp length) (fn2-checkpoint-boot-geometry-copy 0 geometry fn2-boot-config fn2-digests) fn2-digests))
      (fn2-fc (if (zp length) (fn2-fc-reset row fn2-fc) fn2-fc))
      (fn2-fc-context (if (zp length)
        (fn2-fc-context-put row (location anchor) (history (fn2-origin-history fn2-origin)) (incarnation (fn2-origin-history-incarnation fn2-origin))
          (hash geometry) (geometry geometry) (previous-seal geometry)) fn2-fc-context))
      ((mv code fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
       (fn2-checkpoint-restore-anchor-step anchor anchor row slot gen len base *fn2-boot-kind* id ogen 4096
         fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      ((mv evidence fn2-boot-config)
       (if (eq code :candidate)
        (fn2-boot-save-anchor-evidence anchor slot gen id ogen fn2-fields fn2-pool fn2-boot-config)
        (mv :ok fn2-boot-config)))
      (fn2-checkpoints (if (eq evidence :ok) fn2-checkpoints
        (fn2-checkpoints-set-state anchor *fn2-checkpoint-state-uncertain* fn2-checkpoints))))
  (mv (if (eq evidence :ok) code evidence) len fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)))

(defun fn2-boot-scan-checkpoint-pool (anchor length slot gen id ogen
                                    fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                                    fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-origin fn2-digests)
 (declare (xargs :stobjs (fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                          fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-origin fn2-digests)
  :guard (and (fn2-boot-config-wfp fn2-boot-config) (fn2-checkpoints-wfp fn2-checkpoints)
              (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
              (fn2-fc-wfp fn2-fc) (fn2-fc-context-wfp fn2-fc-context) (fn2-b3-wfp fn2-b3)
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (fn2-digests-wfp fn2-digests) (fn2-origin-wfp fn2-origin))))
 (b* (((mv raw len fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
       (fn2-boot-scan-checkpoint-pool-inner anchor length slot gen id ogen fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
         fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-origin fn2-digests))
      (code (if (member-eq raw '(:empty :more :candidate)) raw :invalid))
      (bit (fn2-checkpoint-recovery-census-bit anchor))
      ; The result is consumed in the same transition as the actual checker.
      ; OR retains contradictory repeated observations instead of erasing them.
      (fn2-boot-config (cond
        ((or (eq code :more) (not (fn2-checkpoint-recovery-census-slotp anchor))) fn2-boot-config)
        ((eq code :empty) (update-fn2-boot-config-anchor-empty-mask (logior bit (fn2-boot-config-anchor-empty-mask fn2-boot-config)) fn2-boot-config))
        ((eq code :candidate) (update-fn2-boot-config-anchor-checked-mask (logior bit (fn2-boot-config-anchor-checked-mask fn2-boot-config)) fn2-boot-config))
        (t (update-fn2-boot-config-anchor-invalid-mask (logior bit (fn2-boot-config-anchor-invalid-mask fn2-boot-config)) fn2-boot-config)))))
  (mv code len fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)))

(defun fn2-boot-checkpoint-descriptor-pool (c slot gen id ogen
                                          fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                                          fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
 (declare (xargs :stobjs (fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                          fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
  :guard (and (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-fc-wfp fn2-fc)
              (fn2-fc-context-wfp fn2-fc-context) (fn2-b3-wfp fn2-b3) (fn2-fields-wfp fn2-fields)
              (fn2-pool-wfp fn2-pool) (fn2-digests-wfp fn2-digests))))
 (b* ((row 2) (base 256) (off 0) (len 4096) (r (* 6 (nfix c)))
      (hash (fn2-digest-slot row *fn2-fc-hash*))
      ((unless (and (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
                     (< row (fn2-fc-rows fn2-fc)) (< row (fn2-fc-context-rows fn2-fc-context))
                     (fn2-b3-ready row fn2-b3 fn2-digests) (fn2-digest-rowp hash fn2-digests)
                     (fn2-digest-rowp (fn2-digest-slot row *fn2-fc-geometry*) fn2-digests)
                     (fn2-digest-rowp (fn2-digest-slot row *fn2-fc-previous-seal*) fn2-digests)
                     (<= (+ base *fn2-format-sealed-batch-num-fields*) (fn2-fields-rows fn2-fields))
                     (equal (fn2-checkpoint-refs-encoded-length r fn2-checkpoint-refs) len)))
       (mv :bounds fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      ; These inputs are reloaded only between checker invocations, from the
      ; immutable anchor candidate. The owned rx lease remains unchanged.
      (fn2-digests (fn2-checkpoint-restore-load-hash 0 r hash fn2-checkpoint-bytes fn2-digests))
      (fn2-fc-context (fn2-fc-context-put row
        (location (fn2-checkpoint-refs-physical-unit r fn2-checkpoint-refs))
        (writer-epoch (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs))
        (allocation (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs))
        (history (fn2-checkpoints-history c fn2-checkpoints))
        (incarnation (fn2-checkpoints-incarnation c fn2-checkpoints))

(defcost fn2-boot-checkpoint-descriptor-check :answers t :bytes 4096
 :tables (fn2-core-checkpoints fn2-core-checkpoint-refs fn2-core-checkpoint-bytes fn2-core-fields fn2-core-pool fn2-core-fc fn2-core-fc-context fn2-core-b3 fn2-core-digests)

                              row-rx-slot row-rx-gen id row-generation))
     (:next :write) (:charge :bytes 12288 :steps *fn2-work-stage* :runnable t))
    ((:do (code) (fn2-core-reset row-rx-slot row-rx-gen))
     (:next :read) (:charge :steps *fn2-work-small* :runnable t))))

    ((:next :bootstrap) (:charge :steps *fn2-work-small* :runnable t))))
  (:bootstrap :on-refusal ((:stop :geometry))
   (:do (code offset) (fn2-boot-checkpoint-offset 4 row-image-size))
   (:do (code) (fn2-boot-pack-bootstrap row-image-size row-pool-slot row-pool-gen row-rx-slot row-rx-gen id row-generation))
   (:set (stage 4) (offset offset))
   (:if (equal row-create 1)
    ((:next :write) (:charge :bytes 24576 :steps *fn2-work-stage* :runnable t))
    ((:do (code) (fn2-core-reset row-rx-slot row-rx-gen))
     (:next :read) (:charge :bytes 24576 :steps *fn2-work-stage* :runnable t))))
  (:bootstrap-verify :on-refusal ((:stop :geometry))
   (:do (code) (fn2-boot-match row-pool-slot row-pool-gen row-rx-slot row-rx-gen id row-generation))
   (:set (checkpoint-index 0) (stage 5)) (:next :checkpoint-anchor)

; Typed adapters read the actual admitted actor generation, not a scalar
; claimed by a caller or a nonexistent generation column in the directory.
(in-package "ACL2")
(include-book "c-source-observer")
(include-book "authority-kind")
(include-book "cns-kind")
(include-book "cursor-kind")
(include-book "checkpoint-master-state")
(include-book "machine-arms")
(include-book "run-physical-core-faces")
(fn2-book-layer :e)
(defun fn2-c-source-reader-currentp (id generation fn2-machines fn2-txn fn2-auth fn2-cns fn2-cursor fn2-sealer)
 (declare (xargs :stobjs (fn2-machines fn2-txn fn2-auth fn2-cns fn2-cursor fn2-sealer)
 :guard (and (fn2-machines-wfp fn2-machines) (fn2-txn-wfp fn2-txn) (fn2-auth-wfp fn2-auth) (fn2-cns-wfp fn2-cns) (fn2-cursor-wfp fn2-cursor) (fn2-sealer-wfp fn2-sealer))))
 (and (natp id) (< id (fn2-machines-rows fn2-machines)) (unsigned-byte-p 60 generation)
  (let* ((kind (fn2-machines-kind id fn2-machines)) (slot (fn2-machines-slot id fn2-machines))
         (base (fn2-machines-kind-basesi kind fn2-machines)))
   (and (not (equal base *fn2-none*)) (equal id (+ base slot))
   (cond
      ((equal kind *fn2-txn-kind*)
       (and (< slot (fn2-txn-rows fn2-txn)) (equal generation (fn2-txn-generation slot fn2-txn)) (not (member-equal (fn2-txn-phase slot fn2-txn) (list *fn2-txn-state-free* *fn2-txn-state-retired*)))))
      ((equal kind *fn2-auth-kind*)
       (and (< slot (fn2-auth-rows fn2-auth)) (equal generation (fn2-auth-generation slot fn2-auth)) (not (member-equal (fn2-auth-phase slot fn2-auth) (list *fn2-auth-state-free* *fn2-auth-state-retired*)))))
      ((equal kind *fn2-cns-kind*)
       (and (< slot (fn2-cns-rows fn2-cns)) (equal generation (fn2-cns-generation slot fn2-cns)) (not (member-equal (fn2-cns-phase slot fn2-cns) (list *fn2-cns-state-free* *fn2-cns-state-retired*)))))
      ((equal kind *fn2-cursor-kind*)
       (and (< slot (fn2-cursor-rows fn2-cursor)) (equal generation (fn2-cursor-generation slot fn2-cursor)) (not (member-equal (fn2-cursor-phase slot fn2-cursor) (list *fn2-cursor-state-free* *fn2-cursor-state-retired*)))))
      ((equal kind *fn2-sealer-kind*)
       (and (< slot (fn2-sealer-rows fn2-sealer)) (equal generation (fn2-sealer-generation slot fn2-sealer)) (not (equal (fn2-sealer-phase slot fn2-sealer) *fn2-sealer-state-stopped*))))
    (t nil))))))
(defun fn2-c-source-master-currentp (id generation fn2-machines fn2-checkpoint-master)
 (declare (xargs :stobjs (fn2-machines fn2-checkpoint-master)
 :guard (and (fn2-machines-wfp fn2-machines) (fn2-checkpoint-master-wfp fn2-checkpoint-master))))
 (and (natp id) (< id (fn2-machines-rows fn2-machines)) (unsigned-byte-p 60 generation)
      (equal (fn2-machines-kind id fn2-machines) *fn2-checkpoint-master-kind*)
      (let ((slot (fn2-machines-slot id fn2-machines))
            (base (fn2-machines-kind-basesi *fn2-checkpoint-master-kind* fn2-machines)))
       (and (not (equal base *fn2-none*)) (equal id (+ base slot)) (< slot (fn2-checkpoint-master-rows fn2-checkpoint-master))
            (equal generation (fn2-checkpoint-master-generation slot fn2-checkpoint-master))
            (equal (fn2-checkpoint-master-stopped slot fn2-checkpoint-master) 0)))))
(defun fn2-c-source-read-acquire-children (id generation fn2-c-source-control fn2-c-source-observers fn2-machines fn2-txn fn2-auth fn2-cns fn2-cursor fn2-sealer)
 (declare (xargs :stobjs (fn2-c-source-control fn2-c-source-observers fn2-machines fn2-txn fn2-auth fn2-cns fn2-cursor fn2-sealer)
 :guard (and (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-observers-wfp fn2-c-source-observers)
             (fn2-machines-wfp fn2-machines) (fn2-txn-wfp fn2-txn) (fn2-auth-wfp fn2-auth) (fn2-cns-wfp fn2-cns) (fn2-cursor-wfp fn2-cursor) (fn2-sealer-wfp fn2-sealer))))
 (if (not (fn2-c-source-reader-currentp id generation fn2-machines fn2-txn fn2-auth fn2-cns fn2-cursor fn2-sealer))
  (mv :stale fn2-c-source-control fn2-c-source-observers)
  (fn2-c-source-read-acquire-raw (fn2-machines-kind id fn2-machines) id generation fn2-c-source-control fn2-c-source-observers)))
(defun fn2-c-source-read-release-children (id generation fn2-c-source-control fn2-c-source-observers fn2-machines fn2-txn fn2-auth fn2-cns fn2-cursor fn2-sealer fn2-checkpoint-master)
 (declare (xargs :stobjs (fn2-c-source-control fn2-c-source-observers fn2-machines fn2-txn fn2-auth fn2-cns fn2-cursor fn2-sealer fn2-checkpoint-master)
 :guard (and (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-observers-wfp fn2-c-source-observers)
             (fn2-machines-wfp fn2-machines) (fn2-txn-wfp fn2-txn) (fn2-auth-wfp fn2-auth) (fn2-cns-wfp fn2-cns) (fn2-cursor-wfp fn2-cursor) (fn2-sealer-wfp fn2-sealer) (fn2-checkpoint-master-wfp fn2-checkpoint-master))))
 (b* (((unless (fn2-c-source-reader-currentp id generation fn2-machines fn2-txn fn2-auth fn2-cns fn2-cursor fn2-sealer))
       (mv :stale *fn2-none* 0 fn2-c-source-control fn2-c-source-observers))
      ((mv code target targetgen fn2-c-source-control fn2-c-source-observers)
       (fn2-c-source-read-release-raw (fn2-machines-kind id fn2-machines) id generation fn2-c-source-control fn2-c-source-observers))
      ((when (equal target *fn2-none*)) (mv code target targetgen fn2-c-source-control fn2-c-source-observers))
      ((unless (and (fn2-c-source-master-currentp target targetgen fn2-machines fn2-checkpoint-master)
                     (equal (fn2-c-source-control-writer-kind 0 fn2-c-source-control) *fn2-checkpoint-master-kind*)))
       ; A dead/reused writer cannot be silently replaced or woken. Keep
       ; source admission closed for actual recovery/cancellation handling.
       (let ((fn2-c-source-control (fn2-c-source-control-set-phase 0 *fn2-c-source-writer-phase-uncertain* fn2-c-source-control)))
        (mv :recovery-required *fn2-none* 0 fn2-c-source-control fn2-c-source-observers))))
  (mv code target targetgen fn2-c-source-control fn2-c-source-observers)))
(defun fn2-c-source-writer-begin-children (id generation fn2-c-source-control fn2-c-source-observers fn2-machines fn2-checkpoint-master)
 (declare (xargs :stobjs (fn2-c-source-control fn2-c-source-observers fn2-machines fn2-checkpoint-master)
 :guard (and (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-observers-wfp fn2-c-source-observers)
             (fn2-machines-wfp fn2-machines) (fn2-checkpoint-master-wfp fn2-checkpoint-master))))
 (if (not (fn2-c-source-master-currentp id generation fn2-machines fn2-checkpoint-master))
  (mv :stale 0 fn2-c-source-control)
  (fn2-c-source-writer-begin-raw *fn2-checkpoint-master-kind* id generation fn2-c-source-control fn2-c-source-observers)))
(defun fn2-c-source-writer-poll-children (token id generation fn2-c-source-control fn2-machines fn2-checkpoint-master)
 (declare (xargs :stobjs (fn2-c-source-control fn2-machines fn2-checkpoint-master)
 :guard (and (fn2-c-source-control-wfp fn2-c-source-control) (fn2-machines-wfp fn2-machines) (fn2-checkpoint-master-wfp fn2-checkpoint-master))))
 (if (not (fn2-c-source-master-currentp id generation fn2-machines fn2-checkpoint-master))
  (mv :stale fn2-c-source-control)
  (fn2-c-source-writer-poll-raw token *fn2-checkpoint-master-kind* id generation fn2-c-source-control)))
(defun fn2-c-source-writer-exclusive-children (token id generation fn2-c-source-control fn2-machines fn2-checkpoint-master)
 (declare (xargs :stobjs (fn2-c-source-control fn2-machines fn2-checkpoint-master)
 :guard (and (fn2-c-source-control-wfp fn2-c-source-control) (fn2-machines-wfp fn2-machines) (fn2-checkpoint-master-wfp fn2-checkpoint-master))))
 (and (fn2-c-source-master-currentp id generation fn2-machines fn2-checkpoint-master)
      (fn2-c-source-writer-ownerp token *fn2-checkpoint-master-kind* id generation fn2-c-source-control)
      (equal (fn2-c-source-control-phase 0 fn2-c-source-control) *fn2-c-source-writer-phase-exclusive*)
      (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 0)))
(defcost fn2-c-source-read-acquire :child fn2-c-source-read-acquire-children :answers (:ok :busy :stale :bounds :exhausted)
 :tables (fn2-core-c-source-control fn2-core-c-source-observers fn2-core-machines fn2-txn-table fn2-auth-table fn2-cns-table fn2-cursor-table fn2-sealer-table)
 :doc "Acquire the actual actor's source observation before any source/page admission; pending writer closes new observers.")
(defcost fn2-c-source-read-release :child fn2-c-source-read-release-children :answers (:ok :absent :stale :bounds :invariant :recovery-required)
 :tables (fn2-core-c-source-control fn2-core-c-source-observers fn2-core-machines fn2-txn-table fn2-auth-table fn2-cns-table fn2-cursor-table fn2-sealer-table fn2-checkpoint-master-table)
 :doc "Release only after actual owned materialization/cancel or complete query drain; return only an exact current writer wake target.")
(defcost fn2-c-source-writer-begin :child fn2-c-source-writer-begin-children :answers t
 :tables (fn2-core-c-source-control fn2-core-c-source-observers fn2-core-machines fn2-checkpoint-master-table)
 :doc "Close new observers first and generate a retained writer session; exclusive only after all existing observers release.")
(defcost fn2-c-source-writer-poll :child fn2-c-source-writer-poll-children :answers (:waiting :exclusive :uncertain :stale)
 :tables (fn2-core-c-source-control fn2-core-machines fn2-checkpoint-master-table)
 :doc "Poll the exact current master session without reopening source admission.")
(defcost fn2-c-source-writer-exclusive :child fn2-c-source-writer-exclusive-children
 :tables (fn2-core-c-source-control fn2-core-machines fn2-checkpoint-master-table)
 :doc "Actual owner/session/count predicate for the adopter's bounded replacement and terminal constructors.")

(defconst *fn2-c-source-core-operations*
 '(fn2-c-source-read-acquire fn2-c-source-read-release fn2-c-source-writer-begin
   fn2-c-source-writer-poll fn2-c-source-writer-exclusive))
(defmacro fn2-c-source-observer-core-faces ()
 '(make-event
   (mv-let (err events) (fn2-run-loader-core-face-events *fn2-c-source-core-operations* (w state))
    (if err (er soft 'fn2-c-source-observer-core-faces "~@0" err) (value (cons 'progn events))))))

(fn2-c-source-control-preserves fn2-c-source-read-acquire-children
 (id generation fn2-c-source-control fn2-c-source-observers fn2-machines fn2-txn fn2-auth fn2-cns fn2-cursor fn2-sealer)
 :position 1
 :carriers ((fn2-c-source-control 1 :prefix "-C-SOURCE-CONTROL" :rows t) (fn2-c-source-observers 2 :prefix "-C-SOURCE-OBSERVERS" :rows t))
 :hyps ((fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-observersp fn2-c-source-observers) (fn2-c-source-observers-wfp fn2-c-source-observers) (fn2-machinesp fn2-machines) (fn2-machines-wfp fn2-machines) (fn2-txnp fn2-txn) (fn2-txn-wfp fn2-txn) (fn2-authp fn2-auth) (fn2-auth-wfp fn2-auth) (fn2-cnsp fn2-cns) (fn2-cns-wfp fn2-cns) (fn2-cursorp fn2-cursor) (fn2-cursor-wfp fn2-cursor) (fn2-sealerp fn2-sealer) (fn2-sealer-wfp fn2-sealer)))

(fn2-c-source-control-preserves fn2-c-source-read-release-children
 (id generation fn2-c-source-control fn2-c-source-observers fn2-machines fn2-txn fn2-auth fn2-cns fn2-cursor fn2-sealer fn2-checkpoint-master)
 :position 3
 :carriers ((fn2-c-source-control 3 :prefix "-C-SOURCE-CONTROL" :rows t) (fn2-c-source-observers 4 :prefix "-C-SOURCE-OBSERVERS" :rows t))
 :hyps ((fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-observersp fn2-c-source-observers) (fn2-c-source-observers-wfp fn2-c-source-observers) (fn2-machinesp fn2-machines) (fn2-machines-wfp fn2-machines) (fn2-txnp fn2-txn) (fn2-txn-wfp fn2-txn) (fn2-authp fn2-auth) (fn2-auth-wfp fn2-auth) (fn2-cnsp fn2-cns) (fn2-cns-wfp fn2-cns) (fn2-cursorp fn2-cursor) (fn2-cursor-wfp fn2-cursor) (fn2-sealerp fn2-sealer) (fn2-sealer-wfp fn2-sealer) (fn2-checkpoint-masterp fn2-checkpoint-master) (fn2-checkpoint-master-wfp fn2-checkpoint-master)))

(fn2-c-source-control-preserves fn2-c-source-writer-begin-children
 (id generation fn2-c-source-control fn2-c-source-observers fn2-machines fn2-checkpoint-master)
 :position 2
 :carriers ((fn2-c-source-control 2 :prefix "-C-SOURCE-CONTROL" :rows t))
 :hyps ((fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-observersp fn2-c-source-observers) (fn2-c-source-observers-wfp fn2-c-source-observers) (fn2-machinesp fn2-machines) (fn2-machines-wfp fn2-machines) (fn2-checkpoint-masterp fn2-checkpoint-master) (fn2-checkpoint-master-wfp fn2-checkpoint-master)))

(fn2-c-source-control-preserves fn2-c-source-writer-poll-children
 (token id generation fn2-c-source-control fn2-machines fn2-checkpoint-master)
 :position 1
 :carriers ((fn2-c-source-control 1 :prefix "-C-SOURCE-CONTROL" :rows t))
 :hyps ((fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control) (fn2-machinesp fn2-machines) (fn2-machines-wfp fn2-machines) (fn2-checkpoint-masterp fn2-checkpoint-master) (fn2-checkpoint-master-wfp fn2-checkpoint-master)))

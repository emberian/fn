; One slot per actual overlay or installed row, independent of output count.
; Original ownership survives all schema rescans and post-Fence replacement.
(in-package "ACL2")
(include-book "columns")
(fn2-book-layer :c)
(defcolumns fn2-checkpoint-predecessors
 ((live :bool) (token :u60) (kind :u8) (row :u32) (schema :u60) (order :u60)
  (source-state :u8) (semantic-live :bool) (empty-verified :bool) (seen :u60) (last-round :u60) (ended :bool)
  (output-rank :u60) (retire-stage :u8)
  (root-token :u60) (root-extent :u32) (root-schema :u60) (root-rank :u60)
  (old-slot :u32)
  (old-gen :u60)
  (old-unit :u60)
  (old-epoch :u60)
  (old-allocation :u60)
  (old-physical :bool)
  (old-tag :u60)
  (old-top :u8)
  (old-entries :u60)
  (old-okind :u8)
  (old-oslot :u32)
  (old-ogen :u60)
  (old-filter :bool)
  (old-funit :u60)
  (old-fcounter :u60)
  (old-ufirst :u60)
  (old-ulast :u60)
  (old-wire-run :u60)
  (old-hash-0 :u32)
  (old-hash-1 :u32)
  (old-hash-2 :u32)
  (old-hash-3 :u32)
  (old-hash-4 :u32)
  (old-hash-5 :u32)
  (old-hash-6 :u32)
  (old-hash-7 :u32)))
(defcolumns fn2-checkpoint-predecessor-control
 ((phase (:enum fn2-checkpoint-predecessor-phase (:idle :capture :ready :checking :complete :retiring :done :empty :mapping)))
  (token :u60) (candidate :u32) (owner-kind :u8) (owner-slot :u32) (owner-gen :u60)
  (cut-commit :u60) (cut-event :u60) (overlay-rows :u32) (run-rows :u32)
  (cursor :u32) (count :u32) (checked :u32)))

; K5: replay the record batches actually released by the bounded FNFD port.
; The native owner calls fn-own-feed-port-{tick,observe,lost,restart}-peer,
; which delegate to fn-feed-live-port-step (owner-feed-port.lisp).  A refused
; step retains its feed and emits no records.  This model does not assert that
; a physical append survived a process death; that is a host barrier premise.
(in-package "ACL2")
(include-book "feed-totality")
(include-book "owner-feed-port")

(defun fn-feed-port-next (f event)
  (declare (xargs :guard t))
  (fn-feed-port-step-feed (fn-feed-live-port-step f event)))

(defun fn-feed-port-records (f event)
  (declare (xargs :guard t))
  (fn-feed-port-step-records (fn-feed-live-port-step f event)))

(defun fn-feed-port-run (f events)
  (declare (xargs :guard t :measure (acl2-count events)))
  (if (atom events) f
    (fn-feed-port-run (fn-feed-port-next f (car events)) (cdr events))))

(defun fn-feed-port-history (f events)
  (declare (xargs :guard t :measure (acl2-count events)))
  (if (atom events) nil
    (append (fn-feed-port-records f (car events))
            (fn-feed-port-history (fn-feed-port-next f (car events))
                                  (cdr events)))))

(defthm fn-feed-port-step-replays-its-records
  (equal (fn-feed-durable-projection
          (fn-feed-replay f (fn-feed-port-records f event)))
         (fn-feed-durable-projection (fn-feed-port-next f event)))
  :hints (("Goal"
           :cases ((and (fn-feedp f)
                        (fn-feed-records-portp
                         (fn-feed-live-records f event))))
           :in-theory (e/d (fn-feed-port-next fn-feed-port-records
                            fn-feed-live-port-step fn-feed-port-step-feed
                            fn-feed-port-step-records fn-feed-replay)
                           (fn-feed-live-records fn-feed-live-next
                            fn-feed-live-effects fn-feed-records-portp
                            fn-feedp fn-feed-durable-projection))
           :use ((:instance fn-feed-live-records-reconstruct-step)))))

(defthm fn-feed-port-next-preserves-feedp
  (implies (fn-feedp f) (fn-feedp (fn-feed-port-next f event)))
  :hints (("Goal" :in-theory (e/d (fn-feed-port-next fn-feed-live-port-step)
                                  (fn-feed-live-records fn-feed-records-portp
                                   fn-feed-live-next fn-feedp))
           :use ((:instance fn-feed-live-next-preserves-feedp)))))

(defthm fn-feed-port-batch-replay-tail
  (implies (fn-feedp f)
           (equal (fn-feed-durable-projection
                   (fn-feed-replay
                    (fn-feed-replay f (fn-feed-port-records f event)) tail))
                  (fn-feed-durable-projection
                   (fn-feed-replay (fn-feed-port-next f event) tail))))
  :hints (("Goal" :use
           ((:instance fn-feed-port-step-replays-its-records)
            (:instance fn-feed-replay-preserves-feedp
                       (es (fn-feed-port-records f event)))
            (:instance fn-feed-port-next-preserves-feedp)
            (:instance fn-feed-replay-respects-projection
                       (f (fn-feed-replay f (fn-feed-port-records f event)))
                       (g (fn-feed-port-next f event))
                       (records tail))))))

(defthm fn-feed-port-run-preserves-feedp
  (implies (fn-feedp f) (fn-feedp (fn-feed-port-run f events)))
  :hints (("Goal" :induct (fn-feed-port-run f events)
           :in-theory (enable fn-feed-port-run))))

; This is the live/replay equation for the bounded port, including its
; refusal arm.  The journal is generated by the port itself, not a sibling
; emitter that the owner never calls.
(defthm fn-feed-port-history-reconstructs-live
  (implies (fn-feedp f)
           (equal (fn-feed-durable-projection
                   (fn-feed-replay f (fn-feed-port-history f events)))
                  (fn-feed-durable-projection
                   (fn-feed-port-run f events))))
  :hints (("Goal" :induct (fn-feed-port-run f events)
           :in-theory (e/d (fn-feed-port-run fn-feed-port-history fn-feed-replay)
                           (fn-feedp fn-feed-port-next fn-feed-port-records
                            fn-feed-durable-projection)))
          ("Subgoal *1/2" :use
           ((:instance fn-feed-port-batch-replay-tail
                       (event (car events))
                       (tail (fn-feed-port-history
                              (fn-feed-port-next f (car events))
                              (cdr events))))))))

; The restart normalization retires an unresolved offer/sent attempt and
; clears the socket.  All persistent feed fields, including next-attempt,
; queue, entry ticks and backoff, agree after this normalization.
(defthm fn-feed-restart-of-durable-projection
  (implies (fn-feedp f)
           (equal (fn-feed-restart (fn-feed-durable-projection f))
                  (fn-feed-restart f)))
  :hints (("Goal" :use ((:instance fn-feedp-of-durable-projection))
           :in-theory (e/d (fn-feed-restart fn-feed-durable-projection
                            fn-feed-with-conn fn-feed-with-queue)
                           (fn-feedp fn-feed-queue-settle)))))

(defthm fn-feed-restart-respects-durable-projection
  (implies (and (fn-feedp f) (fn-feedp g)
                (equal (fn-feed-durable-projection f)
                       (fn-feed-durable-projection g)))
           (equal (fn-feed-restart f) (fn-feed-restart g)))
  :rule-classes nil
  :hints (("Goal" :use ((:instance fn-feed-restart-of-durable-projection
                                  (f f))
                         (:instance fn-feed-restart-of-durable-projection
                                  (f g)))
           :in-theory (disable fn-feed-restart fn-feed-durable-projection))))

(defthm fn-feed-port-invalid-input-is-refused
  (implies (not (fn-feedp f))
           (and (equal (fn-feed-port-run f events) f)
                (equal (fn-feed-port-history f events) nil)))
  :hints (("Goal" :induct (fn-feed-port-run f events)
           :in-theory (e/d (fn-feed-port-run fn-feed-port-history
                            fn-feed-port-next fn-feed-port-records
                            fn-feed-live-port-step fn-feed-port-step-feed
                            fn-feed-port-step-records)
                           (fn-feedp fn-feed-live-records
                            fn-feed-records-portp fn-feed-live-next
                            fn-feed-live-effects)))))

(defthm fn-feed-port-replay-is-live-modulo-inflight-when-feedp
  (implies (and (fn-feedp f)
                (equal records (fn-feed-port-history f events)))
           (equal (fn-feed-restart (fn-feed-replay f records))
                  (fn-feed-restart (fn-feed-port-run f events))))
  :hints (("Goal" :use ((:instance fn-feed-port-history-reconstructs-live)
                         (:instance fn-feed-restart-respects-durable-projection
                                    (f (fn-feed-replay f records))
                                    (g (fn-feed-port-run f events)))
                         (:instance fn-feed-replay-preserves-feedp
                                    (es records))
                         (:instance fn-feed-port-run-preserves-feedp))
           :in-theory (disable fn-feed-restart fn-feed-replay
                               fn-feed-port-run fn-feed-port-history))))

(defthm fn-feed-port-replay-is-live-modulo-inflight
  (implies (equal records (fn-feed-port-history f events))
           (equal (fn-feed-restart (fn-feed-replay f records))
                  (fn-feed-restart (fn-feed-port-run f events))))
  :rule-classes nil
  :hints (("Goal" :cases ((fn-feedp f))
           :use ((:instance fn-feed-port-replay-is-live-modulo-inflight-when-feedp)
                 (:instance fn-feed-port-invalid-input-is-refused))
           :in-theory (e/d (fn-feed-replay)
                           (fn-feed-port-run fn-feed-port-history
                            fn-feed-restart)))))

; The native caller reaches this result through fn-owner-feed-tick in
; host/owner-host.lisp and fnn-feed-tick in host/native/feed-service.lisp.
; The selected owner's table entry supplies F; its emitted records are the
; same batch the bounded port uses in the general history theorem above.
(defthm fn-own-feed-port-tick-replays-the-live-tick
  (let* ((entry (fn-own-feed-entry-of peer tbl))
         (f (fn-own-feed-entry-feed entry))
         (event (list :tick obs)))
    (implies (and entry (fn-feedp f)
                  (fn-feed-records-portp (fn-feed-live-records f event)))
             (equal
              (fn-feed-durable-projection
               (fn-feed-replay
                f (fn-own-feed-port-records
                   (fn-own-feed-port-tick-peer peer tbl obs))))
              (fn-feed-durable-projection
               (mv-nth 0 (fn-feed-tick-step f obs))))))
  :rule-classes nil
  :hints (("Goal" :use ((:instance fn-own-feed-port-peer-ready-is-live-port-step
                                  (event (list :tick obs)))
                         (:instance fn-feed-tick-records-reconstruct-live
                                    (f (fn-own-feed-entry-feed
                                        (fn-own-feed-entry-of peer tbl)))))
           :in-theory (e/d (fn-own-feed-port-tick-peer
                            fn-own-feed-port-result fn-own-feed-port-records
                            fn-feed-live-records fn-feed-live-next)
                           (fn-own-feed-port-peer fn-feedp
                            fn-feed-replay fn-feed-durable-projection
                            fn-feed-tick-step fn-feed-tick-records)))))

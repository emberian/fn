; Resource-only mutation shared by the actual published-source STEP. No cost
; face exports it and CUT is not publication authority; STEP derives and checks
; that authority before calling this exact body. This preserves source-specific
; admission separately from one paired allocator/ledger mutation.
(defun fn2-release-evidence-transfer-transition (journal cut fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
 (declare (xargs :stobjs (fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints) :verify-guards nil
  :guard (and (fn2-release-evidencep fn2-release-evidence) (fn2-release-evidence-wfp fn2-release-evidence)
   (fn2-release-evidence-candidatesp fn2-release-evidence-candidates) (fn2-release-evidence-candidates-wfp fn2-release-evidence-candidates)
   (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents) (fn2-alloc-edgesp fn2-alloc-edges) (fn2-alloc-edges-wfp fn2-alloc-edges)
   (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops) (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints))))
 (b* (((unless (and (natp journal) (< journal (fn2-release-evidence-rows fn2-release-evidence))
                    (unsigned-byte-p 60 cut) (= (fn2-release-evidence-live journal fn2-release-evidence) 1)
                    (<= (fn2-release-evidence-batch journal fn2-release-evidence) cut)))
       (mv :identity fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges))
      ((when (= (fn2-release-evidence-phase journal fn2-release-evidence) *fn2-release-evidence-phase-persisted*))
       (mv :pending fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges))
      ((unless (= (fn2-release-evidence-phase journal fn2-release-evidence) *fn2-release-evidence-phase-settled*))
       (mv :state fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges))
       (batch (fn2-release-evidence-batch journal fn2-release-evidence))
       (jepoch (fn2-release-evidence-journal-epoch journal fn2-release-evidence))
       (jallocation (fn2-release-evidence-journal-allocation journal fn2-release-evidence))
       ((unless (fn2-release-evidence-row-owned-p journal jepoch jallocation batch fn2-release-evidence fn2-release-evidence-candidates
                  fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)) (mv :evidence fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges))
       ((mv layout d-edge j-edge) (fn2-release-evidence-edge-pair journal fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints))
       ((unless (eq layout :ok)) (mv layout fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges))
       (i-edge (fn2-alloc-release-installation-edge journal (fn2-extents-rows fn2-extents) (fn2-ops-rows fn2-ops) (fn2-checkpoints-rows fn2-checkpoints)))
       (descriptor (floor (fn2-release-evidence-physical-unit journal fn2-release-evidence) *fn2-storage-extent-units*))
       (installation (fn2-release-evidence-installation-extent journal fn2-release-evidence))
       (bound (fn2-release-evidence-candidate-bound journal fn2-release-evidence))
       (c (fn2-release-evidence-candidate journal fn2-release-evidence))
       ; ROW-OWNED-P preflights all three distinct exact handles, edge holders,
       ; positive counts and the paired aggregate before any mutation. Drops
       ; cannot affect a foreign CE/source/query edge or any historical target.
       ((mv dcode fn2-extents fn2-alloc-edges)
        (fn2-alloc-edge-drop d-edge batch descriptor (fn2-release-evidence-descriptor-epoch journal fn2-release-evidence)
          (fn2-release-evidence-descriptor-allocation journal fn2-release-evidence) :obligation fn2-extents fn2-alloc-edges))
       ((unless (eq dcode :ok)) (mv :uncertain fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges))
       ((mv icode fn2-extents fn2-alloc-edges)
        (fn2-alloc-edge-drop i-edge batch installation (fn2-release-evidence-installation-epoch journal fn2-release-evidence)
          (fn2-release-evidence-installation-allocation journal fn2-release-evidence) :obligation fn2-extents fn2-alloc-edges))
       ((unless (eq icode :ok)) (mv :uncertain fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges))
       ((mv jcode fn2-extents fn2-alloc-edges)
        (fn2-alloc-edge-drop j-edge batch journal jepoch jallocation :obligation fn2-extents fn2-alloc-edges))
       ((unless (eq jcode :ok)) (mv :uncertain fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges))
       (fn2-release-evidence-candidates (if (= bound 1)
        (fn2-release-evidence-candidates-set-count c (- (fn2-release-evidence-candidates-count c fn2-release-evidence-candidates) 1) fn2-release-evidence-candidates)
        fn2-release-evidence-candidates))
       (fn2-release-evidence (fn2-release-evidence-put journal (live 0) (phase *fn2-release-evidence-phase-empty*))) )
  (mv :transferred fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges)))
(fn2-release-evidence-preserves fn2-release-evidence-transfer-transition
 (journal cut fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
 :position 1
 :hyps ((fn2-release-evidencep fn2-release-evidence) (fn2-release-evidence-wfp fn2-release-evidence)
   (fn2-release-evidence-candidatesp fn2-release-evidence-candidates) (fn2-release-evidence-candidates-wfp fn2-release-evidence-candidates)
   (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents) (fn2-alloc-edgesp fn2-alloc-edges) (fn2-alloc-edges-wfp fn2-alloc-edges)
   (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops) (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints))
 :carriers ((fn2-release-evidence-candidates 2 :prefix "-AGGREGATE") (fn2-extents 3 :prefix "-EXTENTS") (fn2-alloc-edges 4 :prefix "-EDGES")))


; Bounded post-Fence substitution for proof resources of SETTLED releases.
; The durable pending inventory covers the captured cut. Only omitted settled
; rows transfer here; pending rows and every foreign checkpoint claim survive.
(in-package "ACL2")
(include-book "release-inventory-source")
(include-book "event-producer")
(fn2-book-layer :c)

(defun fn2-release-inventory-ref-hash-p (i extent ref fn2-checkpoint-page-verified fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-checkpoint-page-verified fn2-checkpoint-bytes) :verify-guards nil
  :measure (nfix (- 32 (nfix i)))
  :guard (and (fn2-checkpoint-page-verifiedp fn2-checkpoint-page-verified) (fn2-checkpoint-page-verified-wfp fn2-checkpoint-page-verified)
              (fn2-checkpoint-bytesp fn2-checkpoint-bytes) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes))))
 (and (natp i) (<= i 32) (natp extent) (< extent (fn2-checkpoint-page-verified-rows fn2-checkpoint-page-verified))
      (natp ref) (<= (* 32 (+ ref 1)) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes))
      (or (= i 32)
       (let* ((word (fn2-checkpoint-page-verified-word extent (floor i 4) fn2-checkpoint-page-verified))
              (byte (logand 255 (ash word (- (* 8 (mod i 4)))))))
        (and (= byte (fn2-checkpoint-bytes-value (+ (* 32 ref) i) fn2-checkpoint-bytes))
             (fn2-release-inventory-ref-hash-p (+ i 1) extent ref fn2-checkpoint-page-verified fn2-checkpoint-bytes))))))


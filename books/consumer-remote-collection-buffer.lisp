; Internal concrete collection writer. A ready descriptor is data, not a
; native source/buffer grant. The actual caller retains all aliases and must
; recheck READ/account/current source again before publishing its FNCT reply.
(in-package "ACL2")
(include-book "consumer-remote-collection")

(defun fn-crcol-write-state (key scope phase bytes child parts remaining end base count size scanner)
 (declare (xargs :guard t))
 (list :remote-collection-write key scope phase bytes child parts remaining end base count size scanner))

(defun fn-crcol-rebase-visible (s base)
 (declare (xargs :guard t))
 (fn-crvp-state (fn-cp-nth 1 s) (fn-cp-nth 2 s) (fn-cp-nth 3 s)
  (fn-cp-nth 4 s) (fn-cp-nth 5 s) (fn-cp-nth 6 s) (fn-cp-nth 7 s)
  (fn-cp-nth 8 s) (fn-cp-nth 9 s) (nfix base) (nfix base)
  (fn-cp-nth 12 s) (fn-cp-nth 13 s)
  (+ (nfix base) (nfix (fn-cp-nth 14 s))) (fn-cp-nth 15 s)))

(defun fn-crcol-write-begin (ready key scope items ceiling used extent)
 (declare (xargs :guard t :guard-hints (("Goal" :in-theory (enable fn-crcol-profilep fn-cp-uintp)))))
 (let ((count (fn-cp-nth 1 ready)) (size (fn-cp-nth 2 ready)))
  (if (not (and (eq (fn-cp-nth 0 ready) :collection-ready)
                (fn-crcol-profilep items ceiling) (fn-cp-uintp count) (<= count items)
                (natp size) (<= size ceiling) (natp used) (natp extent)
                (<= (+ used size) extent)))
      '(:refused :remote-report-extent)
   (list :yield (fn-crcol-write-state key scope :header
    (if (< 1 count) (append *fn-crcol-magic* (list *fn-crcol-version*)
                           (fn-cbor-u32-bytes count)) nil)
    nil (fn-cp-nth 3 ready) count (+ used size) used count size (fn-cp-nth 4 ready))))))

(defun fn-crcol-write-change (s phase bytes child parts remaining)
 (declare (xargs :guard t))
 (fn-crcol-write-state (fn-cp-nth 1 s) (fn-cp-nth 2 s) phase bytes child parts remaining
  (fn-cp-nth 8 s) (fn-cp-nth 9 s) (fn-cp-nth 10 s) (fn-cp-nth 11 s) (fn-cp-nth 12 s)))

; Header phases append one byte, item phases invoke one existing writer tick.
(defun fn-crcol-write-step (s key scope extent fn-arena fn-octets)
 (declare (xargs :stobjs (fn-arena fn-octets) :guard t :guard-hints (("Goal" :in-theory (enable fn-cp-uintp)))))
 (let ((phase (fn-cp-nth 3 s)) (bytes (fn-cp-nth 4 s))
       (child (fn-cp-nth 5 s)) (parts (fn-cp-nth 6 s))
       (remaining (fn-cp-nth 7 s)) (end (fn-cp-nth 8 s))
       (pos (fn-octets-len fn-octets)))
  (cond
   ((not (and (equal key (fn-cp-nth 1 s)) (equal scope (fn-cp-nth 2 s))))
    (mv '(:refused :remote-semantic-source-changed) fn-octets))
   ((not (and (eq (fn-cp-nth 0 s) :remote-collection-write)
               (natp end) (natp extent) (<= pos end) (<= end extent)
               (natp remaining) (fn-cp-uintp (fn-cp-nth 10 s))))
    (mv '(:refused :remote-report-extent) fn-octets))
   ((member-eq phase '(:header :item-length))
    (cond ((consp bytes)
           (if (and (< pos end) (fn-cbor-octetp (car bytes)))
            (let ((fn-octets (fn-octets-append-list (list (car bytes)) fn-octets)))
             (mv (list :yield (fn-crcol-write-change s phase (cdr bytes) child parts remaining)) fn-octets))
            (mv '(:refused :remote-report-octet) fn-octets)))
          ((not (null bytes)) (mv '(:refused :remote-report-tail) fn-octets))
          (t (mv (list :yield (fn-crcol-write-change s (if (eq phase :header) :next :item)
                                       nil child parts remaining)) fn-octets))))
   ((eq phase :next)
    (cond ((zp remaining)
           (mv (if (and (null parts) (equal pos end))
                   (list :encoded (fn-cp-nth 12 s)) '(:refused :remote-report-end)) fn-octets))
          ((not (consp parts)) (mv '(:refused :remote-report-descriptors) fn-octets))
          (t
           (let* ((descriptor (car parts)) (kind (fn-cp-nth 0 descriptor))
                  (size (fn-cp-nth 1 descriptor)) (writer (fn-cp-nth 2 descriptor))
                  (multi (< 1 (fn-cp-nth 10 s))) (base (+ pos (if multi 4 0))))
            (if (not (and (member-eq kind '(:visible :withdrawal))
                          (posp size) (fn-cp-uintp size) (<= (+ base size) end)))
                (mv '(:refused :remote-report-descriptor) fn-octets)
             (mv (list :yield (fn-crcol-write-change s (if multi :item-length :item)
              (if multi (fn-cbor-u32-bytes size) nil)
              (list kind (if (eq kind :visible) (fn-crcol-rebase-visible writer base)
                           (fn-crwd-state key (fn-cp-nth 2 writer) base (+ base size))))
              (cdr parts) remaining)) fn-octets))))))
   ((eq phase :item)
    (mv-let (answer fn-octets)
      (if (eq (fn-cp-nth 0 child) :visible)
          (fn-crvp-step (fn-cp-nth 1 child) key end fn-arena fn-octets)
        (fn-crwd-step (fn-cp-nth 1 child) key end fn-octets))
     (cond ((eq (fn-cp-nth 0 answer) :yield)
            (mv (list :yield (fn-crcol-write-change s phase nil
                 (list (fn-cp-nth 0 child) (fn-cp-nth 1 answer)) parts remaining)) fn-octets))
           ((eq (fn-cp-nth 0 answer) :encoded)
            (mv (list :yield (fn-crcol-write-change s :next nil nil parts (1- remaining))) fn-octets))
           (t (mv answer fn-octets)))))
   (t (mv '(:refused :remote-collection-phase) fn-octets)))))

; Proof-only complete observation, not another served implementation.
(defun fn-crcol-write-reference (s key scope extent fn-arena octets)
 (declare (xargs :stobjs fn-arena :guard t :guard-hints (("Goal" :in-theory (enable fn-cp-uintp)))))
 (let ((phase (fn-cp-nth 3 s)) (bytes (fn-cp-nth 4 s))
       (child (fn-cp-nth 5 s)) (parts (fn-cp-nth 6 s))
       (remaining (fn-cp-nth 7 s)) (end (fn-cp-nth 8 s))
       (pos (len octets)))
  (cond
   ((not (and (equal key (fn-cp-nth 1 s)) (equal scope (fn-cp-nth 2 s))))
    (mv '(:refused :remote-semantic-source-changed) octets))
   ((not (and (eq (fn-cp-nth 0 s) :remote-collection-write)
               (natp end) (natp extent) (<= pos end) (<= end extent)
               (natp remaining) (fn-cp-uintp (fn-cp-nth 10 s))))
    (mv '(:refused :remote-report-extent) octets))
   ((member-eq phase '(:header :item-length))
    (cond ((consp bytes)
           (if (and (< pos end) (fn-cbor-octetp (car bytes)))
            (let ((octets (ec-call (binary-append octets (list (car bytes))))))
             (mv (list :yield (fn-crcol-write-change s phase (cdr bytes) child parts remaining)) octets))
            (mv '(:refused :remote-report-octet) octets)))
          ((not (null bytes)) (mv '(:refused :remote-report-tail) octets))
          (t (mv (list :yield (fn-crcol-write-change s (if (eq phase :header) :next :item)
                                       nil child parts remaining)) octets))))
   ((eq phase :next)
    (cond ((zp remaining)
           (mv (if (and (null parts) (equal pos end))
                   (list :encoded (fn-cp-nth 12 s)) '(:refused :remote-report-end)) octets))
          ((not (consp parts)) (mv '(:refused :remote-report-descriptors) octets))
          (t
           (let* ((descriptor (car parts)) (kind (fn-cp-nth 0 descriptor))
                  (size (fn-cp-nth 1 descriptor)) (writer (fn-cp-nth 2 descriptor))
                  (multi (< 1 (fn-cp-nth 10 s))) (base (+ pos (if multi 4 0))))
            (if (not (and (member-eq kind '(:visible :withdrawal))
                          (posp size) (fn-cp-uintp size) (<= (+ base size) end)))
                (mv '(:refused :remote-report-descriptor) octets)
             (mv (list :yield (fn-crcol-write-change s (if multi :item-length :item)
              (if multi (fn-cbor-u32-bytes size) nil)
              (list kind (if (eq kind :visible) (fn-crcol-rebase-visible writer base)
                           (fn-crwd-state key (fn-cp-nth 2 writer) base (+ base size))))
              (cdr parts) remaining)) octets))))))
   ((eq phase :item)
    (mv-let (answer octets)
      (if (eq (fn-cp-nth 0 child) :visible)
          (fn-crvp-reference (fn-cp-nth 1 child) key end fn-arena octets)
        (fn-crwd-reference (fn-cp-nth 1 child) key end octets))
     (cond ((eq (fn-cp-nth 0 answer) :yield)
            (mv (list :yield (fn-crcol-write-change s phase nil
                 (list (fn-cp-nth 0 child) (fn-cp-nth 1 answer)) parts remaining)) octets))
           ((eq (fn-cp-nth 0 answer) :encoded)
            (mv (list :yield (fn-crcol-write-change s :next nil nil parts (1- remaining))) octets))
           (t (mv answer octets)))))
   (t (mv '(:refused :remote-collection-phase) octets)))))

(defthm fn-crcol-write-step-is-reference-result-and-buffer-effect
 (equal (fn-crcol-write-step s key scope extent fn-arena fn-octets)
        (fn-crcol-write-reference s key scope extent fn-arena fn-octets))
 :rule-classes nil
 :hints (("Goal" :use ((:instance fn-crvp-step-is-reference-result-and-buffer-effect
                         (s (fn-cp-nth 1 (fn-cp-nth 5 s))) (key key)
                         (extent (fn-cp-nth 8 s)))
                       (:instance fn-crwd-step-is-reference-result-and-buffer-effect
                         (s (fn-cp-nth 1 (fn-cp-nth 5 s))) (key key)
                         (extent (fn-cp-nth 8 s))))
  :in-theory (e/d (fn-crcol-write-step fn-crcol-write-reference
                  fn-oct-len-is-len fn-oct-append-list-is-append)
                 (fn-crvp-step fn-crvp-reference fn-crwd-step fn-crwd-reference
                  fn-crcol-write-change fn-crcol-rebase-visible fn-cp-nth len)))))

(in-theory (disable fn-crcol-write-state fn-crcol-rebase-visible fn-crcol-write-begin
 fn-crcol-write-change fn-crcol-write-step fn-crcol-write-reference))

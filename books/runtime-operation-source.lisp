; Read only the actual compiled source after its sole internal SAMEpool
; publication. Missing complete producers remain unavailable.
(in-package "ACL2")
(include-book "page-read-pool-state")
(include-book "runtime-operation-installed-source")
(defun fn-owner-runtime-operation-source (kind fn-page-read-pool state)
 (declare (xargs :stobjs (fn-page-read-pool state) :guard t))
 (if (not (fn-owner-runtime-operation-binding-currentp fn-page-read-pool state))
     (mv :runtime-operation-unavailable nil)
  (mv-let (word family roles resources) (fn-runtime-operation-compiled-source kind)
   (declare (ignore roles resources))
   (if (eq word :compiled-operation-source)
       (mv :runtime-operation-available family)
     (mv :runtime-operation-unavailable nil)))))

; fn: provenance --- the typed evidence value the retention ledger carries.
;
; Until this book the `evidence' slot of `fn-retain-admissiblep' was required
; to be a STRING (books/retention.lisp, the `stringp evidence' conjunct), so
; every writer rendered its provenance into one: the inbound transit path
; produced "peer-transit:<peer>" (`fn-peer-evidence', books/peer-inbound.lisp)
; and threw away the transit kind, the RFC 5537 section 3.2.1 Path diagnostic
; and the configuration generation it had already computed; the POST path took
; a constant the HOST typed ("unsigned-legacy-v0", tools/run_store.py's
; `metadata'), which is a decision Python owned and ACL2 did not.  A string
; cannot be queried, compared or proved about, and AGENTS.md asks for explicit
; provenance and preserved conflicting evidence.
;
; What this book is:
;
;   * four opaque records, one per provenance kind, generated by
;     `fn-defrecord' (books/defrecord.lisp) --- `:post', `:peer-transit',
;     `:bp-receive' and `:local';
;   * `fn-provp', the union recognizer, WHICH ACCEPTS EVERY STRING.  That is
;     the `:legacy' kind and it is the old value verbatim: no wrapper, no
;     re-encoding.  Replacing `(stringp evidence)' by `(fn-provp evidence)'
;     is therefore a widening --- `fn-provp-of-string' below is the one-line
;     bridge every existing theorem, store, journal and checkpoint crosses
;     unchanged;
;   * `fn-prov-kind', the closed five-way kind;
;   * `fn-prov-render', the LEGACY rendering: for each kind it is exactly the
;     string that kind's writer produced before this lane, so no CLI line, no
;     log line and no stored byte changes meaning.  It is lossy for `:post'
;     by construction (the writer's old string was a constant), which is the
;     honest statement of what the old slot carried;
;   * `fn-prov-describe', the lossless human rendering `fn inspect' prints.
;
; The canonical octet/wire codec is NOT here: it is books/provenance-codec,
; which includes books/records for the one octet/string correspondence the
; tree already proves.  This book is in the closure of books/retention and so
; of most of the tree, and it stays small on purpose: `acceptance-alloc' for
; the two total selectors `fn-defrecord' needs, `cbor' for `fn-cbor-octetp'
; (the Path diagnostic carries identity OCTETS), `defrecord' for the macro.

(in-package "ACL2")
(include-book "acceptance-alloc")
(include-book "defrecord")
(include-book "cbor")

; -----------------------------------------------------------------------------
; Field domains

; RFC 3977 section 6.3.2 / RFC 4644: the two commands that carry a transit
; article.  CHECK is an offer, not a transfer, so it never names an
; acceptance; the closed list is the two that do.
(defun fn-prov-transit-kindp (kind)
  (declare (xargs :guard t))
  (or (equal kind :ihave)
      (equal kind :takethis)))

(defthm fn-prov-transit-kindp-forward
  (implies (fn-prov-transit-kindp kind)
           (or (equal kind :ihave) (equal kind :takethis)))
  :rule-classes :forward-chaining)

; The RFC 5537 section 3.2.1 step-3 diagnostic, exactly as `fn-path-diagnostic'
; (books/path.lisp) computes it: `(:match)' when the leftmost Path entry is
; the expected identity, `(:mismatch <expected-identity-octets>)' otherwise.
; This book does not include books/path --- path is far above retention --- so
; the shape is restated here as a domain, and
; `tests/acl2/provenance-tests.lisp' pins it against the real function's two
; ground answers.
(defun fn-prov-diagnosticp (d)
  (declare (xargs :guard t))
  (or (equal d (list :match))
      (and (true-listp d)
           (equal (len d) 2)
           (equal (car d) :mismatch)
           (fn-cbor-octet-listp (cadr d)))))

(defthm fn-prov-diagnosticp-forward-consp
  (implies (fn-prov-diagnosticp d) (consp d))
  :rule-classes :forward-chaining)

(defthm fn-prov-diagnosticp-is-match-or-mismatch
  (implies (fn-prov-diagnosticp d)
           (or (equal d (list :match))
               (equal (car d) :mismatch)))
  :rule-classes :forward-chaining)

(defthm fn-prov-mismatch-diagnostic-shape
  (implies (and (fn-prov-diagnosticp d)
                (not (equal d (list :match))))
           (and (equal (car d) :mismatch)
                (true-listp d)
                (equal (len d) 2)
                (fn-cbor-octet-listp (car (cdr d)))))
  :rule-classes :forward-chaining)

(defun fn-prov-diagnostic-match ()
  (declare (xargs :guard t))
  (list :match))

(defun fn-prov-diagnostic-mismatch (identity)
  (declare (xargs :guard t))
  (list :mismatch (if (fn-cbor-octet-listp identity) identity nil)))

; -----------------------------------------------------------------------------
; The four structured kinds.  Each is tagged, so the kinds are pairwise
; disjoint and disjoint from a string by their head keyword alone.

; A local injection through POST (RFC 5537 section 3.5): who injected it and
; under which injecting-agent configuration generation.
(fn-defrecord fn-prov-post
  :tag :fn-prov-post
  :constructor (fn-prov-make-post principal generation)
  :fields ((fn-prov-post-principal stringp)
           (fn-prov-post-generation natp)))

; An article taken from a peer (specs/peering.md section 2.4): the peer name
; as the configuration knows it, the command that carried the bytes, the Path
; diagnostic the transfer decision computed, and the configuration generation
; the peer record was read at.
(fn-defrecord fn-prov-transit
  :tag :fn-prov-transit
  :constructor (fn-prov-make-transit peer kind diagnostic generation)
  :fields ((fn-prov-transit-peer stringp)
           (fn-prov-transit-kind
            (fn-prov-transit-kindp (fn-prov-transit-kind x)))
           (fn-prov-transit-diagnostic
            (fn-prov-diagnosticp (fn-prov-transit-diagnostic x)))
           (fn-prov-transit-generation natp)))

; An article delivered over BPv7: the receiving node's endpoint id and the
; bundle identity (RFC 9171 section 4.3.1) that carried it.  `label' is the
; string the ingress policy carried in its evidence slot before this lane
; (`fn-bpi-policy-evidence', books/bp-ingress.lisp), kept so that the
; rendered form of a BP acceptance is byte-identical to the old one.
(fn-defrecord fn-prov-bp
  :tag :fn-prov-bp
  :constructor (fn-prov-make-bp node-id bundle label)
  :fields ((fn-prov-bp-node-id stringp)
           (fn-prov-bp-bundle stringp)
           (fn-prov-bp-label stringp)))

; An acceptance this node decided for itself, with its reason: a container
; import, a sweep re-pin, an operator action.
(fn-defrecord fn-prov-local
  :tag :fn-prov-local
  :constructor (fn-prov-make-local reason)
  :fields ((fn-prov-local-reason stringp)))

; -----------------------------------------------------------------------------
; The union, and the widening

(defun fn-provp (x)
  (declare (xargs :guard t))
  (or (stringp x)
      (fn-prov-postp x)
      (fn-prov-transitp x)
      (fn-prov-bpp x)
      (fn-prov-localp x)))

; THE bridge.  Every `(stringp evidence)' hypothesis in the tree discharges
; `(fn-provp evidence)' through this rule, which is why widening retention's
; slot changes no existing theorem's proof obligation.  It is left enabled
; and `fn-provp' is withdrawn below, so the rule fires instead of the
; recognizer opening.
(defthm fn-provp-of-string
  (implies (stringp x) (fn-provp x)))

; The five kinds are exclusive: a value is a string or exactly one record.
(defthm fn-provp-forward-shape
  (implies (fn-provp x) (or (stringp x) (consp x)))
  :rule-classes :forward-chaining)

(defun fn-prov-kind (x)
  (declare (xargs :guard t))
  (cond ((fn-prov-postp x) :post)
        ((fn-prov-transitp x) :peer-transit)
        ((fn-prov-bpp x) :bp-receive)
        ((fn-prov-localp x) :local)
        (t :legacy)))

(defun fn-prov-kindp (k)
  (declare (xargs :guard t))
  (or (equal k :post) (equal k :peer-transit) (equal k :bp-receive)
      (equal k :local) (equal k :legacy)))

(defthm fn-prov-kind-is-a-kind
  (fn-prov-kindp (fn-prov-kind x)))

; -----------------------------------------------------------------------------
; Disjointness, once.
;
; The four records are tagged, so they are pairwise disjoint and disjoint from
; a string.  The tags are inside the shape predicates, whose `:definition'
; runes `fn-defrecord' withdrew, so the fact is not free: it is proved here,
; in the records' own book, with the four `-internals' theories opened for
; exactly these forms (docs/proof-style.md section 8: `<record>-internals' is
; the name to reach for when one form must open a record).  Above this point
; nothing opens a provenance record again.

(local
 (deftheory fn-prov-opened
   (union-theories
    '(fn-provp fn-prov-postp fn-prov-transitp fn-prov-bpp fn-prov-localp
      fn-prov-kind)
    (union-theories
     (theory 'fn-prov-post-internals)
     (union-theories
      (theory 'fn-prov-transit-internals)
      (union-theories (theory 'fn-prov-bp-internals)
                      (theory 'fn-prov-local-internals)))))))

(defthm fn-provp-of-make-post
  (implies (and (stringp principal) (natp generation))
           (fn-provp (fn-prov-make-post principal generation)))
  :hints (("Goal" :in-theory (enable fn-prov-opened))))

(defthm fn-provp-of-make-transit
  (implies (and (stringp peer)
                (fn-prov-transit-kindp kind)
                (fn-prov-diagnosticp diagnostic)
                (natp generation))
           (fn-provp (fn-prov-make-transit peer kind diagnostic generation)))
  :hints (("Goal" :in-theory (enable fn-prov-opened))))

(defthm fn-provp-of-make-bp
  (implies (and (stringp node-id) (stringp bundle) (stringp label))
           (fn-provp (fn-prov-make-bp node-id bundle label)))
  :hints (("Goal" :in-theory (enable fn-prov-opened))))

(defthm fn-provp-of-make-local
  (implies (stringp reason)
           (fn-provp (fn-prov-make-local reason)))
  :hints (("Goal" :in-theory (enable fn-prov-opened))))

(defthm fn-prov-kind-of-make-post
  (implies (and (stringp principal) (natp generation))
           (equal (fn-prov-kind (fn-prov-make-post principal generation))
                  :post))
  :hints (("Goal" :in-theory (enable fn-prov-opened))))

(defthm fn-prov-kind-of-make-transit
  (implies (and (stringp peer)
                (fn-prov-transit-kindp kind)
                (fn-prov-diagnosticp diagnostic)
                (natp generation))
           (equal (fn-prov-kind
                   (fn-prov-make-transit peer kind diagnostic generation))
                  :peer-transit))
  :hints (("Goal" :in-theory (enable fn-prov-opened))))

(defthm fn-prov-kind-of-make-bp
  (implies (and (stringp node-id) (stringp bundle) (stringp label))
           (equal (fn-prov-kind (fn-prov-make-bp node-id bundle label))
                  :bp-receive))
  :hints (("Goal" :in-theory (enable fn-prov-opened))))

(defthm fn-prov-kind-of-make-local
  (implies (stringp reason)
           (equal (fn-prov-kind (fn-prov-make-local reason)) :local))
  :hints (("Goal" :in-theory (enable fn-prov-opened))))

(defthm fn-prov-kind-of-string
  (implies (stringp x) (equal (fn-prov-kind x) :legacy))
  :hints (("Goal" :in-theory (enable fn-prov-opened))))

; The kind of a recognized value, stated for an arbitrary value rather than
; a constructor call: what a book above needs when it holds a record it did
; not build.
(defthm fn-prov-kind-of-a-recognized-value
  (and (implies (fn-prov-postp x) (equal (fn-prov-kind x) :post))
       (implies (fn-prov-transitp x) (equal (fn-prov-kind x) :peer-transit))
       (implies (fn-prov-bpp x) (equal (fn-prov-kind x) :bp-receive))
       (implies (fn-prov-localp x) (equal (fn-prov-kind x) :local)))
  :hints (("Goal" :in-theory (enable fn-prov-opened))))

; A true list of known length is its own explicit `list' call.  The four
; facts below are what destructor elimination needs to see through a shape
; predicate: `:rule-classes nil' because the equality would loop as a rewrite.

(local
 (defthm fn-prov-list-of-len-2
   (implies (and (true-listp x) (equal (len x) 2))
            (equal x (list (car x) (car (cdr x)))))
   :rule-classes nil
   :hints (("Goal" :in-theory (enable len)))))

; A `:mismatch' diagnostic is its own two-element list: what the codec needs
; to rebuild one from the identity octets it read back.
(defthm fn-prov-mismatch-diagnostic-rebuilds
  (implies (and (fn-prov-diagnosticp d) (equal (car d) :mismatch))
           (equal (list :mismatch (car (cdr d))) d))
  :hints (("Goal" :in-theory (enable fn-prov-diagnosticp)
           :use ((:instance fn-prov-list-of-len-2 (x d))))))

; Constructor of accessors used to be written out here, four times, as
; `fn-prov-post-of-its-accessors' and its siblings.  `fn-defrecord' generates
; the family since 2026-09-20 (w10/dtn-3) as `<ctor>-OF-ACCESSORS', so the
; four are gone and `books/provenance-codec.lisp' cites the generated names.
;
; The generated form differs from what stood here in two ways an includer has
; to know.  It is stated under the SHAPE predicate rather than the recognizer
; --- `fn-prov-post-shapep', reached from `fn-prov-postp' by the generated
; forward-chaining fact --- and it is an ENABLED rewrite rather than
; `:rule-classes nil'.  A form that cites one by `:use' must therefore
; DISABLE it in the same hint, or the rewriter collapses the hypothesis the
; `:use' adds to `(equal p p)' before the goal can spend it.

; The field types, exported so the codec need not open a recognizer to know
; that a peer name is a string.

(defthm fn-prov-post-fields-are-typed
  (implies (fn-prov-postp x)
           (and (stringp (fn-prov-post-principal x))
                (natp (fn-prov-post-generation x))))
  :rule-classes (:rewrite :forward-chaining)
  :hints (("Goal" :in-theory (enable fn-prov-postp))))

(defthm fn-prov-transit-fields-are-typed
  (implies (fn-prov-transitp x)
           (and (stringp (fn-prov-transit-peer x))
                (fn-prov-transit-kindp (fn-prov-transit-kind x))
                (fn-prov-diagnosticp (fn-prov-transit-diagnostic x))
                (natp (fn-prov-transit-generation x))))
  :rule-classes (:rewrite :forward-chaining)
  :hints (("Goal" :in-theory (enable fn-prov-transitp))))

(defthm fn-prov-bp-fields-are-typed
  (implies (fn-prov-bpp x)
           (and (stringp (fn-prov-bp-node-id x))
                (stringp (fn-prov-bp-bundle x))
                (stringp (fn-prov-bp-label x))))
  :rule-classes (:rewrite :forward-chaining)
  :hints (("Goal" :in-theory (enable fn-prov-bpp))))

(defthm fn-prov-local-fields-are-typed
  (implies (fn-prov-localp x)
           (stringp (fn-prov-local-reason x)))
  :rule-classes (:rewrite :forward-chaining)
  :hints (("Goal" :in-theory (enable fn-prov-localp))))

; The four structured kinds are pairwise disjoint: their tags differ.  Six
; rewrite rules, each firing on a recognizer term, so a book above never has
; to open a shape predicate to know that a `:post' is not a `:bp-receive'.
(defthm fn-prov-kinds-are-disjoint
  (and (implies (fn-prov-postp x)
                (and (not (fn-prov-transitp x))
                     (not (fn-prov-bpp x))
                     (not (fn-prov-localp x))))
       (implies (fn-prov-transitp x)
                (and (not (fn-prov-bpp x))
                     (not (fn-prov-localp x))))
       (implies (fn-prov-bpp x) (not (fn-prov-localp x))))
  :hints (("Goal" :in-theory (enable fn-prov-opened))))

; A structured provenance is never a string, and never the other three kinds.
(defthm fn-prov-structured-is-not-a-string
  (implies (or (fn-prov-postp x) (fn-prov-transitp x)
               (fn-prov-bpp x) (fn-prov-localp x))
           (not (stringp x)))
  :hints (("Goal" :in-theory (enable fn-prov-opened))))

; -----------------------------------------------------------------------------
; The legacy rendering
;
; `fn-prov-render' answers, for each kind, EXACTLY the string that kind's
; writer put in the evidence slot before this lane.  The per-kind equalities
; are stated below with a ground witness each in
; tests/acl2/provenance-tests.lisp; the writer-side equalities (that this is
; what `fn-peer-evidence' and the host's POST constant produced) are stated
; in the writers' own books, because they are the books that name them.

; tools/run_store.py's `metadata' returned this constant for every locally
; posted article.  It is a HOST constant no longer: ACL2 owns it here.
(defconst *fn-prov-post-legacy* "unsigned-legacy-v0")

; books/peer-inbound.lisp's `fn-peer-evidence' prefix.
(defconst *fn-prov-transit-prefix* "peer-transit:")

(defun fn-prov-render (x)
  (declare (xargs :guard t :verify-guards nil))
  (cond ((fn-prov-postp x) *fn-prov-post-legacy*)
        ((fn-prov-transitp x)
         (string-append *fn-prov-transit-prefix* (fn-prov-transit-peer x)))
        ((fn-prov-bpp x) (fn-prov-bp-label x))
        ((fn-prov-localp x) (fn-prov-local-reason x))
        ((stringp x) x)
        (t "")))

(verify-guards fn-prov-render
  :hints (("Goal" :in-theory (enable fn-prov-transitp fn-prov-bpp
                                     fn-prov-localp))))

(defthm fn-prov-render-is-a-string
  (stringp (fn-prov-render x))
  :hints (("Goal" :in-theory (enable fn-prov-transitp fn-prov-bpp
                                     fn-prov-localp))))

; One equality per kind: the rendered form of a new record is the string the
; same event produced before this lane.

(defthm fn-prov-render-of-post
  (implies (and (stringp principal) (natp generation))
           (equal (fn-prov-render (fn-prov-make-post principal generation))
                  *fn-prov-post-legacy*))
  :hints (("Goal" :in-theory (enable fn-prov-opened fn-prov-render))))

(defthm fn-prov-render-of-transit
  (implies (and (stringp peer)
                (fn-prov-transit-kindp kind)
                (fn-prov-diagnosticp diagnostic)
                (natp generation))
           (equal (fn-prov-render
                   (fn-prov-make-transit peer kind diagnostic generation))
                  (string-append *fn-prov-transit-prefix* peer)))
  :hints (("Goal" :in-theory (enable fn-prov-opened fn-prov-render))))

(defthm fn-prov-render-of-bp
  (implies (and (stringp node-id) (stringp bundle) (stringp label))
           (equal (fn-prov-render (fn-prov-make-bp node-id bundle label))
                  label))
  :hints (("Goal" :in-theory (enable fn-prov-opened fn-prov-render))))

(defthm fn-prov-render-of-local
  (implies (stringp reason)
           (equal (fn-prov-render (fn-prov-make-local reason))
                  reason))
  :hints (("Goal" :in-theory (enable fn-prov-opened fn-prov-render))))

(defthm fn-prov-render-of-legacy
  (implies (stringp x)
           (equal (fn-prov-render x) x))
  :hints (("Goal" :in-theory (enable fn-prov-opened fn-prov-render))))

; -----------------------------------------------------------------------------
; The lossless human rendering
;
; What `fn inspect' and `fn status' print.  ACL2 owns the whole line: the
; host prints the string this returns and formats nothing itself.

; `explode-nonnegative-integer' is the tree's decimal renderer already
; (books/nntp-effects.lisp proves the same two facts for the same reason);
; `coerce' to a string needs its answer to be a character list.
(local (include-book "arithmetic/top" :dir :system))

(local
 (defthm fn-prov-explode-characters-aux
   (implies (and (natp number) (character-listp accumulator))
            (character-listp
             (explode-nonnegative-integer number 10 accumulator)))))

(local
 (defthm fn-prov-explode-characters
   (implies (natp number)
            (character-listp (explode-nonnegative-integer number 10 nil)))))

(defun fn-prov-nat-string (n)
  (declare (xargs :guard t))
  (coerce (explode-nonnegative-integer (nfix n) 10 nil) 'string))

(defun fn-prov-append3 (a b c)
  (declare (xargs :guard (and (stringp a) (stringp b) (stringp c))))
  (string-append a (string-append b c)))

(defun fn-prov-transit-kind-string (kind)
  (declare (xargs :guard t))
  (cond ((equal kind :ihave) "IHAVE")
        ((equal kind :takethis) "TAKETHIS")
        (t "?")))

(defun fn-prov-diagnostic-string (d)
  (declare (xargs :guard t))
  (cond ((equal d (list :match)) "path-match")
        ((and (consp d) (equal (car d) :mismatch)) "path-mismatch")
        (t "path-unknown")))

(defun fn-prov-describe (x)
  (declare (xargs :guard t :verify-guards nil))
  (cond ((fn-prov-postp x)
         (fn-prov-append3
          "post principal=" (fn-prov-post-principal x)
          (string-append " generation="
                         (fn-prov-nat-string (fn-prov-post-generation x)))))
        ((fn-prov-transitp x)
         (fn-prov-append3
          "peer-transit peer=" (fn-prov-transit-peer x)
          (fn-prov-append3
           (string-append
            " kind="
            (fn-prov-transit-kind-string (fn-prov-transit-kind x)))
           (string-append
            " diagnostic="
            (fn-prov-diagnostic-string (fn-prov-transit-diagnostic x)))
           (string-append " generation="
                          (fn-prov-nat-string
                           (fn-prov-transit-generation x))))))
        ((fn-prov-bpp x)
         (fn-prov-append3
          "bp-receive node=" (fn-prov-bp-node-id x)
          (fn-prov-append3 " bundle=" (fn-prov-bp-bundle x)
                           (string-append " label=" (fn-prov-bp-label x)))))
        ((fn-prov-localp x)
         (string-append "local reason=" (fn-prov-local-reason x)))
        ((stringp x) (string-append "legacy " x))
        (t "legacy")))

(verify-guards fn-prov-describe
  :hints (("Goal" :in-theory (enable fn-prov-postp fn-prov-transitp
                                     fn-prov-bpp fn-prov-localp))))

(defthm fn-prov-describe-is-a-string
  (stringp (fn-prov-describe x))
  :hints (("Goal" :in-theory (enable fn-prov-postp fn-prov-transitp
                                     fn-prov-bpp fn-prov-localp))))

; -----------------------------------------------------------------------------
; Export theory (docs/proof-style.md section 2).
;
; `fn-provp-of-string', `fn-provp-forward-shape', `fn-prov-kind-is-a-kind',
; the five `fn-prov-render-of-*' equalities, the two `-is-a-string' facts and
; the record lemmas stay enabled: they are the keystones an includer uses.
; Every recognizer, `fn-prov-kind', `fn-prov-render' and `fn-prov-describe'
; are withdrawn, so a goal about provenance stays in accessor vocabulary.

(fn-defrecord-export fn-prov-vocabulary
  :records (fn-prov-post fn-prov-transit fn-prov-bp fn-prov-local)
  :recognizers (fn-provp)
  :also (fn-prov-transit-kindp fn-prov-diagnosticp fn-prov-kind
         fn-prov-kindp fn-prov-render fn-prov-describe
         fn-prov-nat-string fn-prov-append3 fn-prov-transit-kind-string
         fn-prov-diagnostic-string fn-prov-diagnostic-match
         fn-prov-diagnostic-mismatch))

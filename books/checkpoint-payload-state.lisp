      ((unless (or (not child) (<= (+ base *fn2-am-entry-fields*) (fn2-fields-rows fn2-fields))))
       (mv :bounds fn2-checkpoint-payload fn2-checkpoint-payload-proofs))
      (unit (if child (fn2-fields-value (+ base *fn2-format-source-manifest-entry-field-block-physical-unit*) fn2-fields)
              (fn2-checkpoint-payload-source-unit 0 fn2-checkpoint-payload)))
      (epoch (if child (fn2-fields-value (+ base *fn2-format-source-manifest-entry-field-block-writer-epoch*) fn2-fields)
               (fn2-checkpoint-payload-source-epoch 0 fn2-checkpoint-payload)))
      (allocation (if child (fn2-fields-value (+ base *fn2-format-source-manifest-entry-field-block-allocation*) fn2-fields)
                    (fn2-checkpoint-payload-source-allocation 0 fn2-checkpoint-payload)))
      (role (if child *fn2-checkpoint-restore-reach-role-payload-block*
              (if (= (fn2-checkpoint-payload-location-kind 0 fn2-checkpoint-payload) 1)
                  *fn2-checkpoint-restore-reach-role-payload-manifest* *fn2-checkpoint-restore-reach-role-payload-raw*)))

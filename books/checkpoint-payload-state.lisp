 (b* (((unless (and (fn2-checkpoint-payload-sourcep fn2-checkpoint-payload fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields)
                     (fn2-checkpoint-payload-proofs-shape-p fn2-checkpoint-payload-proofs fn2-extents)))
       (mv :source fn2-checkpoint-payload fn2-checkpoint-payload-proofs))
      (phase (fn2-checkpoint-payload-phase 0 fn2-checkpoint-payload))
      (child (equal phase *fn2-checkpoint-payload-phase-claim*))
      ((unless (or child
        (and (= (fn2-checkpoint-payload-position 0 fn2-checkpoint-payload) 0)
             (= (fn2-checkpoint-payload-proof-count 0 fn2-checkpoint-payload) 0)
             (= (fn2-checkpoint-payload-proof-head 0 fn2-checkpoint-payload) *fn2-alloc-none*)
             (= (fn2-checkpoint-payload-proof-tail 0 fn2-checkpoint-payload) *fn2-alloc-none*)
             (member-equal phase (list *fn2-checkpoint-payload-phase-manifest-read* *fn2-checkpoint-payload-phase-block-read*)))))
       (mv :state fn2-checkpoint-payload fn2-checkpoint-payload-proofs))

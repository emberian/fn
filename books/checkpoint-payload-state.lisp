; One actual schema2 payload closure, bound to an actual retained entry.
; SOURCE stays the original incoming identity. STORED-SOURCE separately
; commits the exact persisted bytes, including any generated Message-ID.
(in-package "ACL2")
(include-book "checkpoint-retained-entry")
(include-book "checkpoint-payload-carrier")
(include-book "checkpoint-source-retention")
(include-book "machines-b")
(include-book "source-manifest-codec")
(fn2-book-layer :c)

(defun fn2-checkpoint-payload-sourcep (fn2-checkpoint-payload fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields)
 (declare (xargs :stobjs (fn2-checkpoint-payload fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields)
  :guard (and (fn2-checkpoint-payload-wfp fn2-checkpoint-payload) (fn2-checkpoint-retained-entry-wfp fn2-checkpoint-retained-entry)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-fields-wfp fn2-fields))))
 (and (< 0 (fn2-checkpoint-payload-rows fn2-checkpoint-payload))
      (equal (fn2-checkpoint-payload-mode 0 fn2-checkpoint-payload) *fn2-checkpoint-payload-mode-live*)
      (fn2-checkpoint-retained-entry-ownerp fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields)
      (equal (fn2-checkpoint-retained-entry-phase 0 fn2-checkpoint-retained-entry) *fn2-checkpoint-retained-entry-phase-held*)
      (equal (fn2-checkpoint-retained-entry-schema 0 fn2-checkpoint-retained-entry) 2)
      (equal (fn2-checkpoint-payload-entry-serial 0 fn2-checkpoint-payload) (fn2-checkpoint-retained-entry-serial 0 fn2-checkpoint-retained-entry))
      (equal (fn2-checkpoint-payload-token 0 fn2-checkpoint-payload) (fn2-checkpoint-retained-entry-token 0 fn2-checkpoint-retained-entry))
      (equal (fn2-checkpoint-payload-owner-kind 0 fn2-checkpoint-payload) (fn2-checkpoint-retained-entry-owner-kind 0 fn2-checkpoint-retained-entry))
      (equal (fn2-checkpoint-payload-owner-slot 0 fn2-checkpoint-payload) (fn2-checkpoint-retained-entry-owner-slot 0 fn2-checkpoint-retained-entry))
      (equal (fn2-checkpoint-payload-owner-gen 0 fn2-checkpoint-payload) (fn2-checkpoint-retained-entry-owner-gen 0 fn2-checkpoint-retained-entry))
      (equal (fn2-checkpoint-payload-candidate 0 fn2-checkpoint-payload) (fn2-checkpoint-retained-entry-candidate 0 fn2-checkpoint-retained-entry))
      (equal (fn2-checkpoint-payload-checkpoint 0 fn2-checkpoint-payload) (fn2-checkpoint-retained-entry-checkpoint 0 fn2-checkpoint-retained-entry))
      (equal (fn2-checkpoint-payload-entry-base 0 fn2-checkpoint-payload) (fn2-checkpoint-retained-entry-field-base 0 fn2-checkpoint-retained-entry))
      (let ((base (fn2-checkpoint-retained-entry-field-base 0 fn2-checkpoint-retained-entry)))
       (and (equal (fn2-fields-value (+ base *fn2-article-entry-field-article*) fn2-fields) (fn2-checkpoint-payload-article 0 fn2-checkpoint-payload))
            (equal (fn2-fields-value (+ base *fn2-article-entry-field-bytes*) fn2-fields) (fn2-checkpoint-payload-total 0 fn2-checkpoint-payload))
            (equal (fn2-fields-value (+ base *fn2-article-entry-field-location-kind*) fn2-fields) (fn2-checkpoint-payload-location-kind 0 fn2-checkpoint-payload))
            (equal (fn2-fields-value (+ base *fn2-article-entry-field-location-unit*) fn2-fields) (fn2-checkpoint-payload-source-unit 0 fn2-checkpoint-payload))
            (equal (fn2-fields-value (+ base *fn2-article-entry-field-location-epoch*) fn2-fields) (fn2-checkpoint-payload-source-epoch 0 fn2-checkpoint-payload))
            (equal (fn2-fields-value (+ base *fn2-article-entry-field-location-allocation*) fn2-fields) (fn2-checkpoint-payload-source-allocation 0 fn2-checkpoint-payload))))))

(defun fn2-checkpoint-payload-begin (mslot mgen dslot dgen fields hash-row fn2-checkpoint-payload fn2-checkpoint-retained-entry
                                     fn2-csnapshot fn2-checkpoints fn2-fields fn2-pool fn2-b3 fn2-digests fn2-extents fn2-alloc-edges fn2-ops)
 (declare (xargs :stobjs (fn2-checkpoint-payload fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields fn2-pool
                          fn2-b3 fn2-digests fn2-extents fn2-alloc-edges fn2-ops)
  :guard (and (fn2-checkpoint-payload-wfp fn2-checkpoint-payload) (fn2-checkpoint-retained-entry-wfp fn2-checkpoint-retained-entry)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)
              (fn2-b3-wfp fn2-b3) (fn2-digests-wfp fn2-digests) (fn2-extents-wfp fn2-extents)
              (fn2-alloc-edges-wfp fn2-alloc-edges) (fn2-ops-wfp fn2-ops))))
 (b* (((unless (and (fn2-checkpoint-payload-rebindablep fn2-checkpoint-payload)
                     (fn2-checkpoint-retained-entry-ownerp fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields)
                     (equal (fn2-checkpoint-retained-entry-phase 0 fn2-checkpoint-retained-entry) *fn2-checkpoint-retained-entry-phase-held*)
                     (equal (fn2-checkpoint-retained-entry-schema 0 fn2-checkpoint-retained-entry) 2)))
       (mv :source fn2-checkpoint-payload fn2-digests fn2-b3 fn2-extents fn2-alloc-edges))
      (base (fn2-checkpoint-retained-entry-field-base 0 fn2-checkpoint-retained-entry))
      (kind (fn2-checkpoint-retained-entry-owner-kind 0 fn2-checkpoint-retained-entry))
      (owner (fn2-checkpoint-retained-entry-owner-slot 0 fn2-checkpoint-retained-entry))
      (generation (fn2-checkpoint-retained-entry-owner-gen 0 fn2-checkpoint-retained-entry))
      (location (fn2-fields-value (+ base *fn2-article-entry-field-location-kind*) fn2-fields))
      (unit (fn2-fields-value (+ base *fn2-article-entry-field-location-unit*) fn2-fields))
      (epoch (fn2-fields-value (+ base *fn2-article-entry-field-location-epoch*) fn2-fields))
      (allocation (fn2-fields-value (+ base *fn2-article-entry-field-location-allocation*) fn2-fields))
      (total (fn2-fields-value (+ base *fn2-article-entry-field-bytes*) fn2-fields))
      (digest (+ base *fn2-article-entry-field-stored-source*))
      (source (+ base *fn2-article-entry-field-source*))
      (vector (+ base *fn2-article-entry-field-location-hashes*))
      (units (if (equal location 1) (fn2-am-units total) (ceiling total *fn2-commit-unit-bytes*)))
      ((unless (and (equal location (if (fn2-am-manifestp total) 1 0))
                     (posp total) (equal (mod unit *fn2-storage-extent-units*) 0)
                     (posp units) (<= units *fn2-commit-write-resources*)
                     (equal (fn2-fields-ref-len vector fn2-fields) (* 32 units))
                     (equal (fn2-fields-ref-len source fn2-fields) 32)
                     (not (equal mslot (fn2-fields-ref-slot source fn2-fields))) (not (equal dslot (fn2-fields-ref-slot source fn2-fields)))
                     (not (equal mslot (fn2-fields-ref-slot vector fn2-fields))) (not (equal dslot (fn2-fields-ref-slot vector fn2-fields)))
                     (eq (fn2-pool-readable-code (fn2-fields-ref-slot vector fn2-fields) (fn2-fields-ref-gen vector fn2-fields) kind owner generation fn2-pool) :ok)
                     (equal (fn2-fields-value digest fn2-fields) 1) (equal (fn2-fields-ref-len digest fn2-fields) 32)
                     (unsigned-byte-p 32 mslot) (unsigned-byte-p 60 mgen) (unsigned-byte-p 32 dslot) (unsigned-byte-p 60 dgen)
                     (not (equal mslot dslot))
                     (not (equal mslot (fn2-checkpoint-retained-entry-parent-slot 0 fn2-checkpoint-retained-entry)))
                     (not (equal dslot (fn2-checkpoint-retained-entry-parent-slot 0 fn2-checkpoint-retained-entry)))
                     (eq (fn2-pool-readable-code (fn2-checkpoint-retained-entry-parent-slot 0 fn2-checkpoint-retained-entry)
                          (fn2-checkpoint-retained-entry-parent-gen 0 fn2-checkpoint-retained-entry) kind owner generation fn2-pool) :ok)
                     (not (equal mslot (fn2-checkpoint-retained-entry-source-slot 0 fn2-checkpoint-retained-entry)))
                     (not (equal dslot (fn2-checkpoint-retained-entry-source-slot 0 fn2-checkpoint-retained-entry)))
                     (eq (fn2-pool-readable-code (fn2-checkpoint-retained-entry-source-slot 0 fn2-checkpoint-retained-entry)
                          (fn2-checkpoint-retained-entry-source-gen 0 fn2-checkpoint-retained-entry) kind owner generation fn2-pool) :ok)
                     (not (equal mslot (fn2-fields-ref-slot digest fn2-fields))) (not (equal dslot (fn2-fields-ref-slot digest fn2-fields)))
                     (eq (fn2-pool-workspace-code mslot mgen kind owner generation fn2-pool) :ok)
                     (eq (fn2-pool-workspace-code dslot dgen kind owner generation fn2-pool) :ok)
                     (<= *fn2-commit-unit-bytes* (fn2-pool-cap mslot fn2-pool)) (<= *fn2-commit-unit-bytes* (fn2-pool-cap dslot fn2-pool))
                     (unsigned-byte-p 32 fields) (<= (+ fields (max *fn2-am-header-fields* *fn2-am-entry-fields*)) (fn2-fields-rows fn2-fields))
                     (or (<= (+ fields (max *fn2-am-header-fields* *fn2-am-entry-fields*)) base) (<= (+ base *fn2-article-entry-num-fields*) fields))
                     (unsigned-byte-p 32 hash-row) (<= 9 (fn2-b3-rows fn2-b3))
                     (equal hash-row (fn2-b-payload-retention-row (fn2-b3-rows fn2-b3)))
                     (equal fields (fn2-b-payload-retention-field-base (fn2-b3-rows fn2-b3)))
                     (fn2-b3-ready hash-row fn2-b3 fn2-digests)
                     (not (equal hash-row (fn2-b-block-read-row (fn2-b3-rows fn2-b3))))))
       (mv :bounds fn2-checkpoint-payload fn2-digests fn2-b3 fn2-extents fn2-alloc-edges))
      ((mv code fn2-extents fn2-alloc-edges) (fn2-checkpoint-source-claim
       (fn2-checkpoint-retained-entry-candidate 0 fn2-checkpoint-retained-entry) (fn2-checkpoint-retained-entry-checkpoint 0 fn2-checkpoint-retained-entry)
       (floor unit *fn2-storage-extent-units*) epoch allocation fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints))
      ((unless (eq code :ok)) (mv code fn2-checkpoint-payload fn2-digests fn2-b3 fn2-extents fn2-alloc-edges))
      ((mv fn2-digests fn2-b3) (fn2-b3-init hash-row 0 (fn2-digest-slot hash-row *fn2-b3-key*) fn2-digests fn2-b3))
      (fn2-checkpoint-payload (fn2-checkpoint-payload-put 0
       (mode *fn2-checkpoint-payload-mode-live*)
       (phase (if (equal location 1) *fn2-checkpoint-payload-phase-manifest-read* *fn2-checkpoint-payload-phase-block-read*))
       (location-units units) (verify-next 0)
       (original-slot (fn2-fields-ref-slot source fn2-fields)) (original-gen (fn2-fields-ref-gen source fn2-fields)) (original-off (fn2-fields-ref-off source fn2-fields))
       (stored-slot (fn2-fields-ref-slot digest fn2-fields)) (stored-gen (fn2-fields-ref-gen digest fn2-fields)) (stored-off (fn2-fields-ref-off digest fn2-fields))
       (vector-slot (fn2-fields-ref-slot vector fn2-fields)) (vector-gen (fn2-fields-ref-gen vector fn2-fields)) (vector-off (fn2-fields-ref-off vector fn2-fields))
       (vector-length (fn2-fields-ref-len vector fn2-fields))
       (entry-serial (fn2-checkpoint-retained-entry-serial 0 fn2-checkpoint-retained-entry))
       (token (fn2-checkpoint-retained-entry-token 0 fn2-checkpoint-retained-entry)) (owner-kind kind) (owner-slot owner) (owner-gen generation)
       (candidate (fn2-checkpoint-retained-entry-candidate 0 fn2-checkpoint-retained-entry)) (checkpoint (fn2-checkpoint-retained-entry-checkpoint 0 fn2-checkpoint-retained-entry))
       (entry-base base) (article (fn2-fields-value (+ base *fn2-article-entry-field-article*) fn2-fields)) (location-kind location)
       (total total) (position 0) (source-unit unit) (source-epoch epoch) (source-allocation allocation)
       (manifest-position 0) (loaded-unit 0) (manifest-slot mslot) (manifest-gen mgen) (data-slot dslot) (data-gen dgen)
       (field-base fields) (hash-row hash-row) (pending 0)
       (block-unit unit) (block-epoch epoch) (block-allocation allocation) (block-length (min total *fn2-commit-unit-bytes*)) (hash-cursor 0))))
  (mv :ok fn2-checkpoint-payload fn2-digests fn2-b3 fn2-extents fn2-alloc-edges)))

(fn2-checkpoint-payload-preserves fn2-checkpoint-payload-begin
 (mslot mgen dslot dgen fields hash-row fn2-checkpoint-payload fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields fn2-pool fn2-b3 fn2-digests fn2-extents fn2-alloc-edges fn2-ops)
 :hyps ((fn2-checkpoint-payloadp fn2-checkpoint-payload) (fn2-checkpoint-payload-wfp fn2-checkpoint-payload)
        (fn2-checkpoint-retained-entryp fn2-checkpoint-retained-entry) (fn2-checkpoint-retained-entry-wfp fn2-checkpoint-retained-entry)
        (fn2-csnapshotp fn2-csnapshot) (fn2-csnapshot-wfp fn2-csnapshot)
        (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints)
        (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)
        (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
        (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3)
        (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests)
        (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents)
        (fn2-alloc-edgesp fn2-alloc-edges) (fn2-alloc-edges-wfp fn2-alloc-edges)
        (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops))
 :specs (("-CHECKPOINT-PAYLOAD-TYPE" fn2-checkpoint-payloadp 1)
         ("-CHECKPOINT-PAYLOAD-WFP" fn2-checkpoint-payload-wfp 1)
         ("-CHECKPOINT-PAYLOAD-ROWS" fn2-checkpoint-payload-rows 1 :frame fn2-checkpoint-payload)
         ("-DIGESTS-TYPE" fn2-digestsp 2)
         ("-DIGESTS-WFP" fn2-digests-wfp 2)
         ("-DIGESTS-ROWS" fn2-digests-rows 2 :frame fn2-digests)
         ("-B3-TYPE" fn2-b3p 3)
         ("-B3-WFP" fn2-b3-wfp 3)
         ("-B3-ROWS" fn2-b3-rows 3 :frame fn2-b3)
         ("-B3-WORDS" fn2-b3-words-length 3 :frame fn2-b3)
         ("-EXTENTS-TYPE" fn2-extentsp 4)
         ("-EXTENTS-WFP" fn2-extents-wfp 4)
         ("-EXTENTS-ROWS" fn2-extents-rows 4 :frame fn2-extents)
         ("-ALLOC-EDGES-TYPE" fn2-alloc-edgesp 5)
         ("-ALLOC-EDGES-WFP" fn2-alloc-edges-wfp 5)
         ("-ALLOC-EDGES-ROWS" fn2-alloc-edges-rows 5 :frame fn2-alloc-edges)))

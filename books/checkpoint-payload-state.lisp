      (token (fn2-checkpoint-payload-token 0 fn2-checkpoint-payload))
      (count (fn2-checkpoint-payload-proof-count 0 fn2-checkpoint-payload))
      (tail (fn2-checkpoint-payload-proof-tail 0 fn2-checkpoint-payload))
      ((unless (and (posp serial) (posp token) (fn2-alloc-slotp e fn2-extents)
                     (eq (fn2-alloc-handle-code e epoch allocation fn2-extents) :ok)
                     (member-equal (fn2-extents-state e fn2-extents) (list *fn2-extent-state-allocated* *fn2-extent-state-retire-pending*))
                     (= (fn2-extents-release-pending e fn2-extents) 0)))
       (mv :identity fn2-checkpoint-payload fn2-checkpoint-payload-proofs))
      (same (and (= (fn2-checkpoint-payload-proofs-pending-serial e fn2-checkpoint-payload-proofs) serial)
                 (= (fn2-checkpoint-payload-proofs-pending-token e fn2-checkpoint-payload-proofs) token)))
      ((when same)
       (if (not (and (= (fn2-checkpoint-payload-proofs-pending-epoch e fn2-checkpoint-payload-proofs) epoch)
                     (= (fn2-checkpoint-payload-proofs-pending-allocation e fn2-checkpoint-payload-proofs) allocation)
                     (= (fn2-checkpoint-payload-proofs-pending-owner-kind e fn2-checkpoint-payload-proofs) (fn2-extents-owner-kind e fn2-extents))
                     (= (fn2-checkpoint-payload-proofs-pending-owner e fn2-checkpoint-payload-proofs) (fn2-extents-owner-id e fn2-extents))))
           (mv :identity fn2-checkpoint-payload fn2-checkpoint-payload-proofs)
        (let ((fn2-checkpoint-payload-proofs (fn2-checkpoint-payload-proofs-set-pending-roles e
              (logior (fn2-checkpoint-payload-proofs-pending-roles e fn2-checkpoint-payload-proofs) (ash 1 role)) fn2-checkpoint-payload-proofs)))
         (mv :ok fn2-checkpoint-payload fn2-checkpoint-payload-proofs))))
      ((unless (and (< count (fn2-extents-rows fn2-extents)) (unsigned-byte-p 32 (+ count 1))
                     (if (= count 0) (and (= tail *fn2-alloc-none*) (= (fn2-checkpoint-payload-proof-head 0 fn2-checkpoint-payload) *fn2-alloc-none*))
                      (and (fn2-alloc-slotp tail fn2-extents)
                           (= (fn2-checkpoint-payload-proofs-pending-serial tail fn2-checkpoint-payload-proofs) serial)
                           (= (fn2-checkpoint-payload-proofs-pending-token tail fn2-checkpoint-payload-proofs) token)
                           (= (fn2-checkpoint-payload-proofs-next tail fn2-checkpoint-payload-proofs) *fn2-alloc-none*)))))
       (mv :exhausted fn2-checkpoint-payload fn2-checkpoint-payload-proofs))
      (fn2-checkpoint-payload-proofs (fn2-checkpoint-payload-proofs-put e
       (pending-serial serial) (pending-token token) (pending-unit unit) (pending-epoch epoch) (pending-allocation allocation)
       (pending-roles (ash 1 role)) (pending-owner-kind (fn2-extents-owner-kind e fn2-extents))

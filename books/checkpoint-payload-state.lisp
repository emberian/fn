; This factory derives its pending tuples only from the real current retained
; entry or the actual decoded manifest child in CLAIM. Pending is not a proof.
(defun fn2-checkpoint-payload-proof-queue (fn2-checkpoint-payload fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields fn2-checkpoint-payload-proofs fn2-extents)

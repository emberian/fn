; Actual run assembly emits this shared continuation after its codec dispatch
; and overlay comparison operations. No second codec/search implementation.
(in-package "ACL2")
(include-book "overlay-insertion")
(fn2-book-layer :c)
(defun fn2-ra-insertion-frame-hyps (carriers)
 (declare (xargs :verify-guards nil))
 (if (atom carriers) nil
  (cons (list (fn2-columns-sym (car carriers) "P") (car carriers))
   (cons (list (fn2-columns-sym (car carriers) "-WFP") (car carriers))
    (fn2-ra-insertion-frame-hyps (cdr carriers))))))
(defun fn2-ra-insertion-frame-events (fn args carriers inputs pos)
 (declare (xargs :verify-guards nil))
 (if (atom carriers) nil
  (cons `(,(fn2-columns-sym (car carriers) "-PRESERVES") ,fn ,args :position ,pos :raw-rows t
           :hyps ,(fn2-ra-insertion-frame-hyps inputs))
   (fn2-ra-insertion-frame-events fn args (cdr carriers) inputs (+ 1 (nfix pos))))))
(defmacro fn2-ra-insertion-events ()
 `(progn
   (defun fn2-ov-insert-start (o ebase eb qkind qslot qgen fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields)
    (declare (xargs :stobjs (fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields)
     :guard (and (fn2-ov-insertion-wfp fn2-ov-insertion) (fn2-overlays-wfp fn2-overlays)
                 (fn2-overlay-index-wfp fn2-overlay-index) (fn2-fields-wfp fn2-fields))))
    (b* (((unless (and (< 0 (fn2-ov-insertion-rows fn2-ov-insertion))
                       (member (fn2-ov-insertion-phase 0 fn2-ov-insertion)
                               (list *fn2-ov-insertion-phase-idle* *fn2-ov-insertion-phase-done*))))
          (mv :busy fn2-ov-insertion))
         ((unless (and (fn2-ov-okp o fn2-overlays fn2-overlay-index)
                       (= (fn2-overlays-phase o fn2-overlays) *fn2-overlay-phase-private*)
                       (unsigned-byte-p 32 ebase) (unsigned-byte-p 32 eb)
                       (<= (+ ebase *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields))
                       (<= (+ eb *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields))
                       (or (<= (+ ebase (fn2-run-layout-fields (fn2-overlays-schema o fn2-overlays) 0)) eb)
                           (<= (+ eb (fn2-run-layout-fields (fn2-overlays-schema o fn2-overlays) 0)) ebase))
                       (unsigned-byte-p 8 qkind) (unsigned-byte-p 32 qslot) (unsigned-byte-p 60 qgen)))
          (mv :bounds fn2-ov-insertion))
         (fn2-ov-insertion (fn2-ov-insertion-put 0 (phase *fn2-ov-insertion-phase-search*)
          (overlay o) (slot (fn2-overlays-slot o fn2-overlays)) (gen (fn2-overlays-gen o fn2-overlays))
          (schema (fn2-overlays-schema o fn2-overlays)) (batch (fn2-overlays-batch o fn2-overlays))
          (seq (fn2-overlays-seq o fn2-overlays)) (pos 0) (off (fn2-overlays-fill o fn2-overlays))
          (end (fn2-overlays-fill o fn2-overlays)) (count (fn2-overlays-count o fn2-overlays))
          (ibase (fn2-overlays-ibase o fn2-overlays)) (remaining 0) (replace 0)
          (entry-base ebase) (decode-base eb) (query-kind qkind) (query-slot qslot) (query-gen qgen)
          (lo 0) (hi (fn2-overlays-count o fn2-overlays)) (search-left *fn2-ov-search-limit*))))
     (mv :more fn2-ov-insertion)))
   (defun fn2-ov-insert-step (budget fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
     :guard (and (fn2-ov-insertion-wfp fn2-ov-insertion) (fn2-overlays-wfp fn2-overlays)
                 (fn2-overlay-index-wfp fn2-overlay-index) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
    (b* (((unless (and (natp budget) (< 0 budget)))
          (mv :yield fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((unless (and (< 0 (fn2-ov-insertion-rows fn2-ov-insertion))
                       (fn2-ov-insertion-current-p fn2-ov-insertion fn2-overlays fn2-overlay-index)))
          (mv :state fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         (phase (fn2-ov-insertion-phase 0 fn2-ov-insertion))
         ((when (= phase *fn2-ov-insertion-phase-shift*))
          (mv-let (code fn2-ov-insertion fn2-overlays fn2-overlay-index)
           (fn2-ov-insertion-step budget fn2-ov-insertion fn2-overlays fn2-overlay-index)
           (mv code fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
         ((unless (member phase (list *fn2-ov-insertion-phase-search* *fn2-ov-insertion-phase-order* *fn2-ov-insertion-phase-encode*)))
          (mv :state fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         (o (fn2-ov-insertion-overlay 0 fn2-ov-insertion))
         (ebase (fn2-ov-insertion-entry-base 0 fn2-ov-insertion))
         (eb (fn2-ov-insertion-decode-base 0 fn2-ov-insertion))
         ((unless (and (<= (+ ebase *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields))
                       (<= (+ eb *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields))))
          (mv :bounds fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         (lo (fn2-ov-insertion-lo 0 fn2-ov-insertion))
         (hi (fn2-ov-insertion-hi 0 fn2-ov-insertion))
         ((when (and (= phase *fn2-ov-insertion-phase-search*) (<= hi lo)))
          (let ((fn2-ov-insertion (fn2-ov-insertion-put 0 (phase *fn2-ov-insertion-phase-order*) (pos lo))))
           (mv :more fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
         ((when (and (= phase *fn2-ov-insertion-phase-search*) (= (fn2-ov-insertion-search-left 0 fn2-ov-insertion) 0)))
          (let ((fn2-ov-insertion (fn2-ov-insertion-set-phase 0 *fn2-ov-insertion-phase-uncertain* fn2-ov-insertion)))
           (mv :bounds fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
         ((when (or (= phase *fn2-ov-insertion-phase-search*) (= phase *fn2-ov-insertion-phase-order*)))
          (b* ((pos (if (= phase *fn2-ov-insertion-phase-search*) (floor (+ lo hi) 2) (fn2-ov-insertion-pos 0 fn2-ov-insertion)))
               ((mv code order fn2-fields)
                (fn2-ov-order o pos eb ebase (fn2-ov-insertion-query-kind 0 fn2-ov-insertion)
                 (fn2-ov-insertion-query-slot 0 fn2-ov-insertion) (fn2-ov-insertion-query-gen 0 fn2-ov-insertion)
                 fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
               ((unless (eq code :ok))
                (let ((fn2-ov-insertion (fn2-ov-insertion-set-phase 0 *fn2-ov-insertion-phase-uncertain* fn2-ov-insertion)))
                 (mv code fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
               ((when (= phase *fn2-ov-insertion-phase-search*))
                (let ((fn2-ov-insertion (fn2-ov-insertion-put 0
                       (lo (if (eq order :lt) (+ 1 pos) lo)) (hi (if (eq order :lt) hi pos))
                       (search-left (- (fn2-ov-insertion-search-left 0 fn2-ov-insertion) 1)))))
                 (mv :more fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
               (replace (and (eq order :eq) (eq (fn2-run-layout-merge (fn2-overlays-schema o fn2-overlays)) :latest)))
               ((unless (and (or (not (eq order :eq)) replace)
                             (or replace (< (fn2-overlays-count o fn2-overlays) (fn2-overlays-icap o fn2-overlays)))))
                (let ((fn2-ov-insertion (fn2-ov-insertion-set-phase 0 *fn2-ov-insertion-phase-uncertain* fn2-ov-insertion)))
                 (mv (if (eq order :eq) :duplicate :full) fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
               (fn2-ov-insertion (fn2-ov-insertion-put 0 (phase *fn2-ov-insertion-phase-encode*) (replace (if replace 1 0)))))
           (mv :more fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
         (sid (fn2-overlays-schema o fn2-overlays))
         (off (fn2-ov-insertion-off 0 fn2-ov-insertion))
         ((unless (<= (+ off (fn2-run-layout-size sid 0 ebase fn2-fields)) (fn2-overlays-cap o fn2-overlays)))
          (let ((fn2-ov-insertion (fn2-ov-insertion-set-phase 0 *fn2-ov-insertion-phase-uncertain* fn2-ov-insertion)))
           (mv :full fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
         ((mv code end fn2-pool)
          (fn2-run-layout-encode sid 0 ebase (fn2-overlays-slot o fn2-overlays) (fn2-overlays-gen o fn2-overlays) off
           (fn2-overlays-okind o fn2-overlays) (fn2-overlays-oslot o fn2-overlays) (fn2-overlays-ogen o fn2-overlays) fn2-fields fn2-pool))
         ((unless (and (eq code :ok) (unsigned-byte-p 32 end) (<= off end) (<= end (fn2-overlays-cap o fn2-overlays))))
          (let ((fn2-ov-insertion (fn2-ov-insertion-set-phase 0 *fn2-ov-insertion-phase-uncertain* fn2-ov-insertion)))
           (mv (if (eq code :ok) :bounds code) fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
         (fn2-ov-insertion (fn2-ov-insertion-put 0 (phase *fn2-ov-insertion-phase-shift*) (end end)
          (remaining (if (= (fn2-ov-insertion-replace 0 fn2-ov-insertion) 1) 0
                       (- (fn2-ov-insertion-count 0 fn2-ov-insertion) (fn2-ov-insertion-pos 0 fn2-ov-insertion)))))))
     (mv :more fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
   ,@(fn2-ra-insertion-frame-events 'fn2-ov-insert-start
       '(o ebase eb qkind qslot qgen fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields)
       '(fn2-ov-insertion) '(fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields) 1)
   ,@(fn2-ra-insertion-frame-events 'fn2-ov-insert-step
       '(budget fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
       '(fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
       '(fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool) 1)))

; Complete the selected re-investigation from real root1/root3/root4 evidence.
(in-package "ACL2")
(include-book "checkpoint-selected-source")
(include-book "checkpoint-summary-catalog")
(include-book "checkpoint-restore-events-source")
(include-book "std/util/bstar" :dir :system)
(fn2-book-layer :b)
(defun fn2-checkpoint-selected-source-finish (kind owner generation candidate fn2-checkpoint-selected-source fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-reach-control fn2-checkpoint-restore-reader fn2-checkpoint-restore-events fn2-checkpoint-restore-events-work fn2-checkpoint-summary fn2-checkpoint-restore-semantic)
 (declare (xargs :stobjs (fn2-checkpoint-selected-source fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-reach-control fn2-checkpoint-restore-reader fn2-checkpoint-restore-events fn2-checkpoint-restore-events-work fn2-checkpoint-summary fn2-checkpoint-restore-semantic) :guard (and (fn2-checkpoint-selected-source-wfp fn2-checkpoint-selected-source)
              (fn2-boot-config-wfp fn2-boot-config)
              (fn2-checkpoints-wfp fn2-checkpoints)
              (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
              (fn2-origin-wfp fn2-origin)
              (fn2-checkpoint-recovery-evidence-wfp fn2-checkpoint-recovery-evidence)
              (fn2-checkpoint-recovery-census-wfp fn2-checkpoint-recovery-census)
              (fn2-checkpoint-restore-map-wfp fn2-checkpoint-restore-map)
              (fn2-checkpoint-restore-map-control-wfp fn2-checkpoint-restore-map-control)
              (fn2-checkpoint-restore-reach-control-wfp fn2-checkpoint-restore-reach-control)
              (fn2-checkpoint-restore-reader-wfp fn2-checkpoint-restore-reader)
              (fn2-checkpoint-restore-events-wfp fn2-checkpoint-restore-events)
              (fn2-checkpoint-restore-events-work-wfp fn2-checkpoint-restore-events-work)
              (fn2-checkpoint-summary-wfp fn2-checkpoint-summary)
              (fn2-checkpoint-restore-semantic-wfp fn2-checkpoint-restore-semantic))))
 (b* (((unless (and (unsigned-byte-p 8 kind) (posp kind) (unsigned-byte-p 32 owner) (unsigned-byte-p 60 generation)
                    (fn2-checkpoint-recovery-census-slotp candidate)
                    (< 0 (fn2-checkpoint-selected-source-rows fn2-checkpoint-selected-source))
                    (< 0 (fn2-checkpoint-summary-rows fn2-checkpoint-summary))
                    (< 0 (fn2-checkpoint-restore-semantic-rows fn2-checkpoint-restore-semantic))
                    (fn2-checkpoint-summary-current-p fn2-checkpoint-summary fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-semantic)
                    (= (fn2-checkpoint-summary-phase 0 fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-captured*)
                    (= (fn2-checkpoint-restore-semantic-phase 0 fn2-checkpoint-restore-semantic) *fn2-checkpoint-restore-semantic-phase-complete*)
                    (fn2-checkpoint-restore-events-complete-p fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-reach-control fn2-checkpoint-restore-reader fn2-checkpoint-restore-events fn2-checkpoint-restore-events-work)
                    (= (fn2-checkpoint-restore-events-candidate 0 fn2-checkpoint-restore-events) candidate)
                    (= (fn2-checkpoint-restore-reader-owner-kind 0 fn2-checkpoint-restore-reader) kind)
                    (= (fn2-checkpoint-restore-reader-owner-slot 0 fn2-checkpoint-restore-reader) owner)
                    (= (fn2-checkpoint-restore-reader-owner-gen 0 fn2-checkpoint-restore-reader) generation)))
       (mv :state 0 fn2-checkpoint-selected-source))
      (phase (fn2-checkpoint-selected-source-phase 0 fn2-checkpoint-selected-source))
      ((when (= phase *fn2-checkpoint-selected-source-phase-idle*))
       (mv (if (< candidate (- *fn2-checkpoint-anchor-slots* 1)) :next-candidate :census)
           (if (< candidate (- *fn2-checkpoint-anchor-slots* 1)) (+ 1 candidate) candidate) fn2-checkpoint-selected-source))
      ((unless (and (= phase *fn2-checkpoint-selected-source-phase-investigating*)
                    (fn2-checkpoint-selected-source-current-p fn2-checkpoint-selected-source fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census)
                    (= (fn2-checkpoint-selected-source-candidate 0 fn2-checkpoint-selected-source) candidate)
                    (= (fn2-checkpoint-selected-source-owner-kind 0 fn2-checkpoint-selected-source) kind)
                    (= (fn2-checkpoint-selected-source-owner-slot 0 fn2-checkpoint-selected-source) owner)
                    (= (fn2-checkpoint-selected-source-owner-gen 0 fn2-checkpoint-selected-source) generation)
                    (posp (fn2-checkpoint-restore-map-control-reach-generation 0 fn2-checkpoint-restore-map-control))))
       (mv :state 0 fn2-checkpoint-selected-source))
      (fn2-checkpoint-selected-source (fn2-checkpoint-selected-source-put 0
       (phase *fn2-checkpoint-selected-source-phase-validated*)
       (generation (fn2-checkpoint-restore-map-control-reach-generation 0 fn2-checkpoint-restore-map-control)))))
  (mv :validated candidate fn2-checkpoint-selected-source)))

(defcost fn2-boot-checkpoint-investigation-finish :answers (:next-candidate :census :validated :state)
 :bytes 512 :tables (fn2-core-checkpoint-selected-source)
 :doc "Close actual semantic/catalog and journal/frontier investigation; selected provenance becomes projectable, never serving authority.")
(defmacro fn2-boot-checkpoint-selected-finish-operations ()
 '(progn
  (defun fn2-boot-checkpoint-investigation-finish (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (and (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
                  (= (fn2-machine-phase id fn2-core) *fn2-boot-state-checkpoint-events-finish*)
                  (= (fn2-machine-generation id fn2-core) ogen)))
       (mv :state 0 fn2-core)
    (let ((kind (fn2-machine-kind id fn2-core)) (candidate (fn2-machine-checkpoint-index id fn2-core)))
     (stobj-let ((fn2-checkpoint-selected-source (fn2-core-checkpoint-selected-source fn2-core)) (fn2-boot-config (fn2-core-boot-config fn2-core)) (fn2-checkpoints (fn2-core-checkpoints fn2-core)) (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core)) (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core)) (fn2-origin (fn2-core-origin fn2-core)) (fn2-checkpoint-recovery-evidence (fn2-core-checkpoint-recovery-evidence fn2-core)) (fn2-checkpoint-recovery-census (fn2-core-checkpoint-recovery-census fn2-core)) (fn2-checkpoint-restore-map (fn2-core-checkpoint-restore-map fn2-core)) (fn2-checkpoint-restore-map-control (fn2-core-checkpoint-restore-map-control fn2-core)) (fn2-checkpoint-restore-reach-control (fn2-core-checkpoint-restore-reach-control fn2-core)) (fn2-checkpoint-restore-reader (fn2-core-checkpoint-restore-reader fn2-core)) (fn2-checkpoint-restore-events (fn2-core-checkpoint-restore-events fn2-core)) (fn2-checkpoint-restore-events-work (fn2-core-checkpoint-restore-events-work fn2-core)) (fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core)) (fn2-checkpoint-restore-semantic (fn2-core-checkpoint-restore-semantic fn2-core)))
      (code next fn2-checkpoint-selected-source)
      (fn2-checkpoint-selected-source-finish kind id ogen candidate fn2-checkpoint-selected-source fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-reach-control fn2-checkpoint-restore-reader fn2-checkpoint-restore-events fn2-checkpoint-restore-events-work fn2-checkpoint-summary fn2-checkpoint-restore-semantic)
      (mv code next fn2-core)))))
  (fn2-core-preserves fn2-boot-checkpoint-investigation-finish (id ogen fn2-core) :position 2 :rows nil)))

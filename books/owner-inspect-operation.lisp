; Actual source-specific inspect BODY. Installed source factories remain owned
; by the runtime installer; this book supplies no fallback or numeric setter.
(in-package "ACL2")
(include-book "operation-diagnostics")
(include-book "runtime-acceptance-observation")
(include-book "history-operation-observation")
(include-book "allocation-turn-body-authority")

(defun fn-owner-inspect-response-source
 (slot nonce request cached fn-allocation-turn-slots fn-page-read-pool state)
 (declare (xargs :stobjs (fn-allocation-turn-slots fn-page-read-pool state)
                 :guard t))
 (declare (ignore request cached))
 (if (not (and (fn-ats-slotp slot fn-allocation-turn-slots)
               (fn-ats-matchingp slot nonce fn-allocation-turn-slots fn-page-read-pool)
               (eq (fn-ats-kindsi slot fn-allocation-turn-slots) :owner-control)
               (or (eql (fn-ats-phasesi slot fn-allocation-turn-slots) 2)
                   (fn-ats-role-bodyp slot nonce :owner-control
                                     fn-allocation-turn-slots fn-page-read-pool))))
     (mv :inspect-source-unavailable nil nil)
  (mv-let (word source)
   (fn-owner-runtime-operation-resources :owner-control-inspect fn-page-read-pool state)
   ; A full report recipe keeps its job/rescue claim separate from the
   ; nested original response recipe. Never render against the job subtotal.
   (let ((source (if (and (consp source)
                          (eq (car source) :inspect-report-source)
                          (consp (cdr source)) (consp (cddr source))
                          (consp (cdddr source)) (null (cddddr source))
                          (fn-apr-naturals 5 (cadr source))
                          (fn-apr-naturals 5 (caddr source)))
                     (cadddr source) source)))
   (if (and (eq word :runtime-operation-available)
            (consp source) (eq (car source) :inspect-response-source)
            (consp (cdr source)) (natp (cadr source))
            (consp (cddr source)) (null (cdddr source))
            (fn-apr-naturals 5 (caddr source)))
       (mv :inspect-source-available (cadr source) (caddr source))
    (mv :inspect-source-unavailable nil nil))))))

(defun fn-owner-inspect-operation-answer
 (request cached slot nonce fn-allocation-turn-slots fn-history-backing fn-page-read-pool state)
 (declare (xargs :stobjs (fn-allocation-turn-slots fn-history-backing fn-page-read-pool state)
                 :guard t))
 ; Phase3 reentry cannot reuse an earlier paid BODY for another request. All
 ; source lookup, cost and rendering below share these lexical request/cache.
 (if (not (and (fn-ats-slotp slot fn-allocation-turn-slots)
               (eql (fn-ats-phasesi slot fn-allocation-turn-slots) 2)
               (fn-aec-pool-statep fn-page-read-pool)))
     (mv :inspect-source-unavailable nil fn-allocation-turn-slots fn-page-read-pool state)
  (mv-let (source-word response-octets original-prs)
   (fn-owner-inspect-response-source slot nonce request cached
                                    fn-allocation-turn-slots fn-page-read-pool state)
   (declare (ignore original-prs))
   (if (not (eq source-word :inspect-source-available))
       (mv source-word nil fn-allocation-turn-slots fn-page-read-pool state)
    (mv-let (cost-word body-octets)
     (fn-owner-runtime-operation-body-cost :owner-control-inspect request cached fn-page-read-pool state)
     (if (not (and (eq cost-word :runtime-operation-available) (natp body-octets)))
         (mv :inspect-source-unavailable nil fn-allocation-turn-slots fn-page-read-pool state)
      (mv-let (paid fn-allocation-turn-slots fn-page-read-pool)
       (fn-ats-prepay-body-internal slot nonce body-octets fn-allocation-turn-slots fn-page-read-pool)
       (if (not (and (eq paid :prepaid)
                     (fn-ats-role-bodyp slot nonce :owner-control fn-allocation-turn-slots fn-page-read-pool)))
           (mv paid nil fn-allocation-turn-slots fn-page-read-pool state)
        (mv-let (observation family mode epoch occupied allocated turns)
         (fn-owner-runtime-acceptance-observe :owner-control-inspect fn-page-read-pool state)
         (declare (ignore family mode epoch occupied allocated turns))
         (mv-let (reason token phase producer epoch source publication txid mode allocated turns charge fault)
          (fn-owner-history-operation-observe fn-history-backing fn-page-read-pool state)
          (mv-let (word octets)
           (fn-od-correlated-report (fn-prl-nth 1 token) (fn-prl-nth 6 token)
            (if (eq observation :runtime-operation-available) :observed :unavailable)
            reason phase producer epoch source publication txid mode allocated turns
            (fn-prl-nth 0 charge) (fn-prl-nth 1 charge) (fn-prl-nth 2 charge)
            (fn-prl-nth 3 charge) (fn-prl-nth 4 charge) fault response-octets)
           (mv word octets fn-allocation-turn-slots fn-page-read-pool state))))))))))))

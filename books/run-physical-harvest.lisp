; Actual completion observer, independent of issuing any read.
(in-package "ACL2")
(include-book "run-physical-resources")
(fn2-book-layer :c)
(defun fn2-run-load-harvest (opslot opgen cell evkind outcome reason count aux0 aux1 fn2-run-loads fn2-run-load-ops)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-load-ops)
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-run-load-ops-wfp fn2-run-load-ops))))
 (declare (ignore reason aux0 aux1))
 (b* (((unless (and (natp opslot) (< opslot (fn2-run-load-ops-rows fn2-run-load-ops))
                    (equal (fn2-run-load-ops-live opslot fn2-run-load-ops) 1)
                    (equal (fn2-run-load-ops-generation opslot fn2-run-load-ops) opgen)
                    (equal cell 0) (equal evkind *fn2-event-read-result*)))
       (mv :ok fn2-run-loads fn2-run-load-ops))
      (c (fn2-run-load-ops-cursor opslot fn2-run-load-ops))
      ((unless (and (< c (fn2-run-loads-rows fn2-run-loads))
                    (equal (fn2-run-loads-phase c fn2-run-loads) *fn2-run-load-phase-wait*)
                    (equal (fn2-run-loads-pending c fn2-run-loads) 1)
                    (equal (fn2-run-loads-op-slot c fn2-run-loads) opslot)
                    (equal (fn2-run-loads-op-gen c fn2-run-loads) opgen)))
       (mv :ok fn2-run-loads fn2-run-load-ops))
      (fn2-run-loads (fn2-run-loads-put c (pending 0)
       (phase (if (and (equal outcome *fn2-outcome-done*) (equal count *fn2-commit-unit-bytes*))
               *fn2-run-load-phase-copy* *fn2-run-load-phase-uncertain*))))
      (fn2-run-load-ops (fn2-run-load-ops-set-live opslot 0 fn2-run-load-ops)))
  (mv :ok fn2-run-loads fn2-run-load-ops)))
(fn2-run-load-frames fn2-run-load-harvest
 (opslot opgen cell evkind outcome reason count aux0 aux1 fn2-run-loads fn2-run-load-ops)
 (fn2-run-loads fn2-run-load-ops)
 ((fn2-run-loads 1) (fn2-run-load-ops 2)))

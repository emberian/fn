; Provisional local workflow-journal records and replay into fn-bp-step.
; The host validates the FNWF length/checksum frame; this book validates
; the decoded bounded fields and makes every workflow decision through fn-bp-step.
(in-package "ACL2")
(include-book "bp-workflow")

(defun fn-bp-journal-textp (x)
  (declare (xargs :guard t :verify-guards nil))
  (and (stringp x) (< 0 (length x)) (<= (length x) 512)))
(verify-guards fn-bp-journal-textp)
(defun fn-bp-u64p (x)
  (declare (xargs :guard t :verify-guards nil))
  (and (natp x) (< x 18446744073709551616)))
(verify-guards fn-bp-u64p)
(defun fn-bp-journal-nth (n x)
  (declare (xargs :guard t :measure (nfix n)))
  (if (not (and (integerp n) (< 0 n)))
      (if (consp x) (car x) nil)
    (fn-bp-journal-nth (1- n) (if (consp x) (cdr x) nil))))

(defun fn-bp-config-recordp (r)
  (declare (xargs :guard t :verify-guards nil))
  (and (true-listp r) (equal (len r) 8) (equal (car r) :config)
       (fn-bp-journal-textp (fn-bp-journal-nth 1 r))
       (fn-bp-journal-textp (fn-bp-journal-nth 2 r))
       (fn-bp-journal-textp (fn-bp-journal-nth 3 r))
       (fn-bp-journal-textp (fn-bp-journal-nth 4 r))
       (posp (fn-bp-journal-nth 5 r))
       (fn-bp-journal-textp (fn-bp-journal-nth 6 r))
       (fn-bp-journal-textp (fn-bp-journal-nth 7 r))))
(verify-guards fn-bp-config-recordp)
(defun fn-bp-config-from-record (r)
  (declare (xargs :guard t :verify-guards nil))
  (fn-bp-make-config (fn-bp-journal-nth 1 r) (fn-bp-journal-nth 2 r)
   (fn-bp-journal-nth 3 r) (fn-bp-journal-nth 4 r) (fn-bp-journal-nth 5 r)
   (fn-bp-journal-nth 6 r) (fn-bp-journal-nth 7 r)))
(verify-guards fn-bp-config-from-record)

(defun fn-bp-journal-recordp (r)
 (declare (xargs :guard t :verify-guards nil))
 (let ((k (fn-bp-journal-nth 0 r)))
  (cond
   ((equal k :config) (fn-bp-config-recordp r))
   ((equal k :enqueue)
    (and (true-listp r) (equal (len r) 11)
     (fn-bp-u64p (fn-bp-journal-nth 1 r)) (fn-bp-u64p (fn-bp-journal-nth 2 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 3 r)) (fn-bp-journal-textp (fn-bp-journal-nth 4 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 5 r)) (fn-bp-journal-textp (fn-bp-journal-nth 6 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 7 r)) (fn-bp-journal-textp (fn-bp-journal-nth 8 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 9 r)) (fn-bp-journal-textp (fn-bp-journal-nth 10 r))))
   ((equal k :attempt)
    (and (true-listp r) (equal (len r) 10)
     (fn-bp-u64p (fn-bp-journal-nth 1 r)) (fn-bp-u64p (fn-bp-journal-nth 2 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 3 r)) (fn-bp-journal-textp (fn-bp-journal-nth 4 r))
     (fn-bp-u64p (fn-bp-journal-nth 5 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 6 r)) (fn-bp-journal-textp (fn-bp-journal-nth 7 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 8 r)) (posp (fn-bp-journal-nth 9 r))))
   ((equal k :transport)
    (and (true-listp r) (equal (len r) 5)
     (fn-bp-journal-textp (fn-bp-journal-nth 1 r)) (fn-bp-journal-textp (fn-bp-journal-nth 2 r))
     (fn-bp-u64p (fn-bp-journal-nth 3 r)) (fn-bp-transport-statusp (fn-bp-journal-nth 4 r))))
   ((equal k :receipt-intent)
    (and (true-listp r) (equal (len r) 12)
     (fn-bp-u64p (fn-bp-journal-nth 1 r)) (fn-bp-u64p (fn-bp-journal-nth 2 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 3 r)) (fn-bp-journal-textp (fn-bp-journal-nth 4 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 5 r)) (fn-bp-journal-textp (fn-bp-journal-nth 6 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 7 r)) (fn-bp-journal-textp (fn-bp-journal-nth 8 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 9 r)) (fn-bp-journal-textp (fn-bp-journal-nth 10 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 11 r))))
   ((equal k :outcome)
    (and (true-listp r) (equal (len r) 5)
     (fn-bp-u64p (fn-bp-journal-nth 1 r)) (fn-bp-u64p (fn-bp-journal-nth 2 r))
     (or (and (equal (fn-bp-journal-nth 3 r) :ordinary)
              (member-equal (fn-bp-journal-nth 4 r) '(:durable :aborted)))
         (and (equal (fn-bp-journal-nth 3 r) :recovery)
              (member-equal (fn-bp-journal-nth 4 r) '(:committed :absent))))))
   ((equal k :retry-request)
    (and (true-listp r) (equal (len r) 5)
     (fn-bp-journal-textp (fn-bp-journal-nth 1 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 2 r))
     (fn-bp-u64p (fn-bp-journal-nth 3 r))
     (fn-bp-journal-textp (fn-bp-journal-nth 4 r))))
   (t nil))))
(verify-guards fn-bp-journal-recordp)

(defun fn-bp-record-event (r)
 (declare (xargs :guard t :verify-guards nil))
 (let ((k (fn-bp-journal-nth 0 r)))
  (cond
   ((equal k :enqueue) (fn-bp-enqueue-prepare-event
     (fn-bp-journal-nth 1 r) (fn-bp-journal-nth 2 r) (fn-bp-journal-nth 3 r)
     (fn-bp-journal-nth 4 r) (fn-bp-journal-nth 7 r) (fn-bp-journal-nth 9 r)
     (fn-bp-journal-nth 10 r)))
   ((equal k :attempt) (fn-bp-attempt-prepare-event
     (fn-bp-journal-nth 1 r) (fn-bp-journal-nth 2 r) (fn-bp-journal-nth 3 r)
     (fn-bp-journal-nth 4 r)))
   ((equal k :receipt-intent) (fn-bp-receipt-prepare-event
     (fn-bp-journal-nth 1 r) (fn-bp-journal-nth 2 r)
     (fn-bp-make-receipt (fn-bp-journal-nth 3 r) (fn-bp-journal-nth 4 r)
      (fn-bp-journal-nth 5 r) (fn-bp-journal-nth 6 r) (fn-bp-journal-nth 7 r)
      (fn-bp-journal-nth 8 r) (fn-bp-journal-nth 9 r) (fn-bp-journal-nth 10 r)
      (fn-bp-journal-nth 11 r)) t))
   ((equal k :transport) (fn-bp-transport-event (fn-bp-journal-nth 1 r)
     (fn-bp-journal-nth 2 r) (fn-bp-journal-nth 3 r) (fn-bp-journal-nth 4 r)))
   ((equal k :retry-request) (fn-bp-retry-request-event
     (fn-bp-journal-nth 1 r) (fn-bp-journal-nth 2 r)
     (fn-bp-journal-nth 3 r) (fn-bp-journal-nth 4 r)))
   (t nil))))
(verify-guards fn-bp-record-event)

(defun fn-bp-record-contextp (s r prepared)
 (declare (xargs :guard t :verify-guards nil))
 (let ((k (fn-bp-journal-nth 0 r)) (c (fn-bp-state-config s)))
  (cond
   ((equal k :enqueue)
    (let ((p (fn-bp-state-pending prepared)))
     (and (consp p) (equal (fn-bp-pending-kind p) :enqueue)
      (equal (fn-bp-work-subject (fn-bp-pending-work p)) (fn-bp-journal-nth 5 r))
      (equal (fn-bp-work-archive-id (fn-bp-pending-work p)) (fn-bp-journal-nth 6 r))
      (equal (fn-bp-config-peer-eid c) (fn-bp-journal-nth 8 r)))))
   ((equal k :attempt)
    (and (consp (fn-bp-state-pending prepared))
     (equal (fn-bp-attempt-generation
             (fn-bp-work-attempt
              (fn-bp-pending-work (fn-bp-state-pending prepared))))
            (fn-bp-journal-nth 5 r))
     (equal (fn-bp-config-local-eid c) (fn-bp-journal-nth 6 r))
     (equal (fn-bp-config-peer-eid c) (fn-bp-journal-nth 7 r))
     (equal (fn-bp-config-policy-id c) (fn-bp-journal-nth 8 r))
     (equal (fn-bp-config-lifetime c) (fn-bp-journal-nth 9 r))))
   ((equal k :receipt-intent) (consp (fn-bp-state-pending prepared)))
   ((equal k :transport) (not (consp (fn-bp-state-pending s))))
   ((equal k :retry-request) (not (consp (fn-bp-state-pending s))))
   (t nil))))
(verify-guards fn-bp-record-contextp)

; Apply one already decoded record to a live image.  Unlike disk replay this
; never fabricates restart or indeterminate observations.  A no-op transition
; is rejection, so stale pairs and ordinary completion of a recovered fence
; cannot authorize effects.
(defun fn-bp-apply-journal-record (s r)
 (declare (xargs :guard t :verify-guards nil))
 (mbe :logic
(if (or (not (fn-bp-journal-recordp r)) (equal (car r) :config))
     (list nil s nil)
  (if (equal (car r) :outcome)
      (let* ((recoveryp (equal (fn-bp-journal-nth 3 r) :recovery))
             (event (if recoveryp
               (fn-bp-storage-recover-event (fn-bp-journal-nth 1 r)
                (fn-bp-journal-nth 2 r) (fn-bp-journal-nth 4 r))
               (fn-bp-storage-complete-event (fn-bp-journal-nth 1 r)
                (fn-bp-journal-nth 2 r) (fn-bp-journal-nth 4 r))))
             (answer (fn-bp-step s event)) (next (fn-bp-result-state answer)))
       (if (equal next s) (list nil s nil)
         (list t next (fn-bp-result-effects answer))))
    (let* ((answer (fn-bp-step s (fn-bp-record-event r)))
           (next (fn-bp-result-state answer)))
      (if (or (equal next s) (not (fn-bp-record-contextp s r next)))
          (list nil s nil)
        (list t next (fn-bp-result-effects answer))))))
      :exec
(if (or (not (fn-bp-journal-recordp r)) (equal (fn-ag-car r) :config))
     (list nil s nil)
  (if (equal (fn-ag-car r) :outcome)
      (let* ((recoveryp (equal (fn-bp-journal-nth 3 r) :recovery))
             (event (if recoveryp
               (fn-bp-storage-recover-event (fn-bp-journal-nth 1 r)
                (fn-bp-journal-nth 2 r) (fn-bp-journal-nth 4 r))
               (fn-bp-storage-complete-event (fn-bp-journal-nth 1 r)
                (fn-bp-journal-nth 2 r) (fn-bp-journal-nth 4 r))))
             (answer (fn-bp-step s event)) (next (fn-bp-result-state answer)))
       (if (equal next s) (list nil s nil)
         (list t next (fn-bp-result-effects answer))))
    (let* ((answer (fn-bp-step s (fn-bp-record-event r)))
           (next (fn-bp-result-state answer)))
      (if (or (equal next s) (not (fn-bp-record-contextp s r next)))
          (list nil s nil)
        (list t next (fn-bp-result-effects answer)))))) ))
(verify-guards fn-bp-apply-journal-record)

; Result is (okp state effects). A false okp makes the recovered prefix unusable.
(defun fn-bp-replay-records (s records effects)
 (declare (xargs :guard t :verify-guards nil :measure (acl2-count records)))
 (mbe :logic
(if (endp records) (list t (fn-bp-result-state (fn-bp-step s (fn-bp-restart-event))) effects)
  (let* ((r (car records)) (kind (fn-bp-journal-nth 0 r)))
   (if (or (not (fn-bp-journal-recordp r)) (equal kind :config))
       (list nil s effects)
     (if (equal kind :outcome)
       (if (not (fn-bp-pending-matchesp s (fn-bp-journal-nth 1 r)
                                            (fn-bp-journal-nth 2 r)))
           (list nil s effects)
         (let* ((recoveryp (equal (fn-bp-journal-nth 3 r) :recovery))
                (fenced (if recoveryp
                  (fn-bp-result-state (fn-bp-step s (fn-bp-storage-complete-event
                    (fn-bp-journal-nth 1 r) (fn-bp-journal-nth 2 r) :indeterminate))) s))
                (done (fn-bp-step fenced
                  (if recoveryp (fn-bp-storage-recover-event
                    (fn-bp-journal-nth 1 r) (fn-bp-journal-nth 2 r) (fn-bp-journal-nth 4 r))
                   (fn-bp-storage-complete-event (fn-bp-journal-nth 1 r)
                    (fn-bp-journal-nth 2 r) (fn-bp-journal-nth 4 r))))))
           (fn-bp-replay-records (fn-bp-result-state done) (cdr records)
            (append effects (fn-bp-result-effects done)))))
       (let* ((event (fn-bp-record-event r)) (first (fn-bp-step s event))
              (prepared (fn-bp-result-state first)))
         (if (or (equal prepared s)
                 (not (fn-bp-record-contextp s r prepared)))
             (list nil s effects)
           (fn-bp-replay-records prepared (cdr records)
            (append effects (fn-bp-result-effects first)))))))))
      :exec
(if (atom records) (list t (fn-bp-result-state (fn-bp-step s (fn-bp-restart-event))) effects)
  (let* ((r (fn-ag-car records)) (kind (fn-bp-journal-nth 0 r)))
   (if (or (not (fn-bp-journal-recordp r)) (equal kind :config))
       (list nil s effects)
     (if (equal kind :outcome)
       (if (not (fn-bp-pending-matchesp s (fn-bp-journal-nth 1 r)
                                            (fn-bp-journal-nth 2 r)))
           (list nil s effects)
         (let* ((recoveryp (equal (fn-bp-journal-nth 3 r) :recovery))
                (fenced (if recoveryp
                  (fn-bp-result-state (fn-bp-step s (fn-bp-storage-complete-event
                    (fn-bp-journal-nth 1 r) (fn-bp-journal-nth 2 r) :indeterminate))) s))
                (done (fn-bp-step fenced
                  (if recoveryp (fn-bp-storage-recover-event
                    (fn-bp-journal-nth 1 r) (fn-bp-journal-nth 2 r) (fn-bp-journal-nth 4 r))
                   (fn-bp-storage-complete-event (fn-bp-journal-nth 1 r)
                    (fn-bp-journal-nth 2 r) (fn-bp-journal-nth 4 r))))))
           (fn-bp-replay-records (fn-bp-result-state done) (fn-ag-cdr records)
            (fn-ag-append effects (fn-bp-result-effects done)))))
       (let* ((event (fn-bp-record-event r)) (first (fn-bp-step s event))
              (prepared (fn-bp-result-state first)))
         (if (or (equal prepared s)
                 (not (fn-bp-record-contextp s r prepared)))
             (list nil s effects)
           (fn-bp-replay-records prepared (fn-ag-cdr records)
            (fn-ag-append effects (fn-bp-result-effects first))))))))) ))
(verify-guards fn-bp-replay-records)

(defun fn-bp-replay-journal (node records)
 (declare (xargs :guard t :verify-guards nil))
 (mbe :logic
(if (or (endp records) (not (fn-bp-config-recordp (car records))))
     (list nil nil nil)
   (let ((s (fn-bp-initial-state node (fn-bp-config-from-record (car records)))))
    (if (not (fn-bp-statep s)) (list nil nil nil)
      (fn-bp-replay-records s (cdr records) nil))))
      :exec
(if (or (atom records) (not (fn-bp-config-recordp (fn-ag-car records))))
     (list nil nil nil)
   (let ((s (fn-bp-initial-state node (fn-bp-config-from-record (fn-ag-car records)))))
    (if (not (fn-bp-statep s)) (list nil nil nil)
      (fn-bp-replay-records s (fn-ag-cdr records) nil))))))
(verify-guards fn-bp-replay-journal)

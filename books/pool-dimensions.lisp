; Requested observations, separately proved on the actual logical producer.
(in-package "ACL2")
(include-book "pool-ranges")
(include-book "columns-call-guards")
(fn2-book-layer :b)

(defun fn2-pool-dimension-specs (observations position)
 (declare (xargs :verify-guards nil))
 (if (atom observations) nil
  (cons (if (eq (car observations) :rows)
            (list "-DIMENSION-ROWS" 'fn2-pool-rows position :frame 'fn2-pool)
          (list "-DIMENSION-DATA" 'fn2-pool-data-length position :frame 'fn2-pool))
        (fn2-pool-dimension-specs (cdr observations) position))))
(defun fn2-pool-output-position (outputs index)
 (declare (xargs :verify-guards nil))
 (if (atom outputs) nil
  (if (eq (car outputs) 'fn2-pool) (nfix index)
    (fn2-pool-output-position (cdr outputs) (+ 1 (nfix index))))))
(defun fn2-pool-dimension-events (name observations opaque enables world)
 (declare (xargs :verify-guards nil))
 (let* ((args (getpropc name 'formals nil world))
        (inputs (getpropc name 'stobjs-in nil world))
        (outputs (getpropc name 'stobjs-out nil world))
        (position (fn2-pool-output-position outputs 0)))
  (if (or (not (consp observations)) (not (true-listp observations))
          (not (subsetp-eq observations '(:rows :data)))
          (not (no-duplicatesp-eq observations))
          (not (member-eq 'fn2-pool args))
          (not (member-eq 'fn2-pool inputs)) (not position)
          (not (equal (len args) (len inputs)))
          (not (equal (fn2-pool-output-position args 0)
                      (fn2-pool-output-position inputs 0)))
          (member-eq 'fn2-pool (cdr (member-eq 'fn2-pool outputs)))
          (not (getpropc name 'unnormalized-body nil world))
          (eq (getpropc name 'symbol-class nil world) :program))
      (er hard 'fn2-pool-dimension-events "Invalid requested pool dimension ABI for ~x0: ~x1." name observations)
   (fn2-columns-preservation-facts name (cons name args)
    (fn2-pool-dimension-specs observations (and (not (equal (len outputs) 1)) position))
    nil `((fn2-columns-call-guard-hint ',name ',opaque ',(cons name enables) world))))))
(defmacro fn2-pool-dimensions (name &key (observations '(:rows :data)) (opaque 'nil) (enables 'nil))
 `(make-event
   (value (cons 'progn (fn2-pool-dimension-events ',name ',observations ',opaque ',enables (w state))))))

; These producers only write metadata columns. DATA is an independent outer
; field, even on malformed logical inputs; no recognizer or guard is borrowed.
(fn2-pool-dimensions fn2-pool-lease-in :observations (:data)
 :opaque (fn2-pool-workspace-code) :enables (fn2-pool-data-length))
(fn2-pool-dimensions fn2-pool-lease-out :observations (:data)
 :opaque (fn2-pool-readable-code) :enables (fn2-pool-data-length))
(fn2-pool-dimensions fn2-pool-truncate :observations (:data)
 :opaque (fn2-pool-workspace-code) :enables (fn2-pool-data-length))

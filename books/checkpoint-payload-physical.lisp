; Shared physical payload checks over retained concrete references. This
; layer grants no source/allocator authority; live and cold wrappers bind it.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-payload-carrier")
(include-book "checkpoint-payload-format")
(include-book "block-integrity")
(fn2-book-layer :b)
(defun fn2-checkpoint-payload-location-check (fn2-checkpoint-payload fn2-b3 fn2-digests fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-payload fn2-b3 fn2-digests fn2-pool)
 :guard (and (fn2-checkpoint-payload-wfp fn2-checkpoint-payload) (fn2-b3-wfp fn2-b3) (fn2-digests-wfp fn2-digests) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (< 0 (fn2-checkpoint-payload-rows fn2-checkpoint-payload))
                    (equal (fn2-checkpoint-payload-phase 0 fn2-checkpoint-payload) *fn2-checkpoint-payload-phase-location-verify*)
                    (equal (fn2-checkpoint-payload-pending 0 fn2-checkpoint-payload) 0)))
       (mv :state fn2-checkpoint-payload fn2-b3 fn2-digests))
      (manifestp (equal (fn2-checkpoint-payload-location-kind 0 fn2-checkpoint-payload) 1))
      (index (if manifestp (fn2-checkpoint-payload-loaded-unit 0 fn2-checkpoint-payload)
               (floor (fn2-checkpoint-payload-position 0 fn2-checkpoint-payload) *fn2-commit-unit-bytes*)))
      (len (if manifestp *fn2-commit-unit-bytes* (fn2-checkpoint-payload-block-length 0 fn2-checkpoint-payload)))
      (next (fn2-checkpoint-payload-verify-next 0 fn2-checkpoint-payload))
      ((unless (and (posp (fn2-checkpoint-payload-location-units 0 fn2-checkpoint-payload))
                    (equal (fn2-checkpoint-payload-vector-length 0 fn2-checkpoint-payload) (* 32 (fn2-checkpoint-payload-location-units 0 fn2-checkpoint-payload)))
                    (< index (fn2-checkpoint-payload-location-units 0 fn2-checkpoint-payload))
                    (member next (list *fn2-checkpoint-payload-phase-header* *fn2-checkpoint-payload-phase-entry* *fn2-checkpoint-payload-phase-block-verify*))))
       (mv :location-vector fn2-checkpoint-payload fn2-b3 fn2-digests))
      ((mv code fn2-b3 fn2-digests)
       (fn2-block-read-commitment-children len len
        (if manifestp (fn2-checkpoint-payload-manifest-slot 0 fn2-checkpoint-payload) (fn2-checkpoint-payload-data-slot 0 fn2-checkpoint-payload))
        (if manifestp (fn2-checkpoint-payload-manifest-gen 0 fn2-checkpoint-payload) (fn2-checkpoint-payload-data-gen 0 fn2-checkpoint-payload)) 0
        (fn2-checkpoint-payload-vector-slot 0 fn2-checkpoint-payload) (fn2-checkpoint-payload-vector-gen 0 fn2-checkpoint-payload)
        (+ (fn2-checkpoint-payload-vector-off 0 fn2-checkpoint-payload) (* 32 index))
        (fn2-checkpoint-payload-owner-kind 0 fn2-checkpoint-payload) (fn2-checkpoint-payload-owner-slot 0 fn2-checkpoint-payload)
        (fn2-checkpoint-payload-owner-gen 0 fn2-checkpoint-payload) fn2-b3 fn2-digests fn2-pool))
      (fn2-checkpoint-payload (fn2-checkpoint-payload-set-phase 0
       (if (eq code :ok) next *fn2-checkpoint-payload-phase-uncertain*) fn2-checkpoint-payload)))
  (mv (if (eq code :ok) :more code) fn2-checkpoint-payload fn2-b3 fn2-digests)))
(fn2-fc-shape fn2-checkpoint-payload-location-check-shape
 (fn2-checkpoint-payload-location-check fn2-checkpoint-payload fn2-b3 fn2-digests fn2-pool)
 (and (fn2-checkpoint-payloadp fn2-checkpoint-payload) (fn2-checkpoint-payload-wfp fn2-checkpoint-payload)
      (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3) (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests) (fn2-pool-wfp fn2-pool))
 ((fn2-checkpoint-payload 1) (fn2-b3 2) (fn2-digests 3)))

; Only wrappers that just accepted the shared decoder's :claim result call
; this internal writer. NEXT is its actual generated-codec boundary, not a
; caller readiness assertion. All cursor arithmetic is checked before update.
(defun fn2-checkpoint-payload-physical-child-bind (next fn2-checkpoint-payload fn2-fields)
 (declare (xargs :stobjs (fn2-checkpoint-payload fn2-fields)
 :guard (and (fn2-checkpoint-payload-wfp fn2-checkpoint-payload) (fn2-fields-wfp fn2-fields))))
 (b* (((unless (and (< 0 (fn2-checkpoint-payload-rows fn2-checkpoint-payload))
                    (equal (fn2-checkpoint-payload-phase 0 fn2-checkpoint-payload) *fn2-checkpoint-payload-phase-entry*)))
       (mv :state fn2-checkpoint-payload))
      (base (fn2-checkpoint-payload-field-base 0 fn2-checkpoint-payload))
      ((unless (<= (+ base *fn2-am-entry-fields*) (fn2-fields-rows fn2-fields))) (mv :bounds fn2-checkpoint-payload))
      (at (fn2-am-entry-at (fn2-checkpoint-payload-manifest-position 0 fn2-checkpoint-payload)))
      (relative (floor at *fn2-commit-unit-bytes*))
      (position (+ (* relative *fn2-commit-unit-bytes*) (nfix next)))
      (unit (fn2-fields-value (+ base *fn2-format-source-manifest-entry-field-block-physical-unit*) fn2-fields))
      (epoch (fn2-fields-value (+ base *fn2-format-source-manifest-entry-field-block-writer-epoch*) fn2-fields))
      (allocation (fn2-fields-value (+ base *fn2-format-source-manifest-entry-field-block-allocation*) fn2-fields))
      (len (fn2-fields-value (+ base *fn2-format-source-manifest-entry-field-length*) fn2-fields))
      (h (+ base *fn2-format-source-manifest-entry-field-block-expected-hash*))
      (cv (+ base *fn2-format-source-manifest-entry-field-subtree-cv*))
      ((unless (and (natp next) (<= next *fn2-commit-unit-bytes*) (unsigned-byte-p 32 position)
                    (< relative *fn2-storage-extent-units*) (unsigned-byte-p 60 unit) (unsigned-byte-p 60 epoch) (unsigned-byte-p 60 allocation)
                    (posp len) (<= len *fn2-commit-unit-bytes*)
                    (equal (fn2-fields-ref-len h fn2-fields) 32) (equal (fn2-fields-ref-len cv fn2-fields) 32)))
       (mv :bounds fn2-checkpoint-payload))
      (fn2-checkpoint-payload (fn2-checkpoint-payload-put 0 (manifest-position position)
       (block-unit unit) (block-epoch epoch) (block-allocation allocation) (block-length len) (hash-cursor 0)
       (hash-offset (fn2-fields-ref-off h fn2-fields)) (cv-offset (fn2-fields-ref-off cv fn2-fields))
       (phase *fn2-checkpoint-payload-phase-block-read*))))
  (mv :need-read fn2-checkpoint-payload)))
(fn2-checkpoint-payload-preserves fn2-checkpoint-payload-physical-child-bind
 (next fn2-checkpoint-payload fn2-fields) :position 1
 :hyps ((fn2-checkpoint-payloadp fn2-checkpoint-payload) (fn2-checkpoint-payload-wfp fn2-checkpoint-payload)
        (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)))

; The existing I/O owner supplies the observed byte count only after its
; exact operation completion. Source authority remains in live/cold callers.
(defun fn2-checkpoint-payload-physical-loaded (count fn2-checkpoint-payload)
 (declare (xargs :stobjs fn2-checkpoint-payload :guard (fn2-checkpoint-payload-wfp fn2-checkpoint-payload)))
 (b* (((unless (and (< 0 (fn2-checkpoint-payload-rows fn2-checkpoint-payload))
                    (equal (fn2-checkpoint-payload-pending 0 fn2-checkpoint-payload) 1)
                    (member (fn2-checkpoint-payload-phase 0 fn2-checkpoint-payload)
                     (list *fn2-checkpoint-payload-phase-wait-manifest* *fn2-checkpoint-payload-phase-wait-block*))))
       (mv :state fn2-checkpoint-payload))
      (manifestp (equal (fn2-checkpoint-payload-phase 0 fn2-checkpoint-payload) *fn2-checkpoint-payload-phase-wait-manifest*))
      (len (if manifestp 4096 (fn2-checkpoint-payload-block-length 0 fn2-checkpoint-payload)))
      (good (and (posp len) (<= len 4096) (equal count len)))
      (next (if manifestp (if (equal (fn2-checkpoint-payload-manifest-position 0 fn2-checkpoint-payload) 0)
                           *fn2-checkpoint-payload-phase-header* *fn2-checkpoint-payload-phase-entry*)
               *fn2-checkpoint-payload-phase-block-verify*))
      (verify (or manifestp (equal (fn2-checkpoint-payload-location-kind 0 fn2-checkpoint-payload) 0)))
      (fn2-checkpoint-payload (fn2-checkpoint-payload-put 0 (pending 0) (verify-next next)
       (phase (if good (if verify *fn2-checkpoint-payload-phase-location-verify* next) *fn2-checkpoint-payload-phase-uncertain*)))))
  (mv (if good :more :io) fn2-checkpoint-payload)))
(fn2-checkpoint-payload-preserves fn2-checkpoint-payload-physical-loaded (count fn2-checkpoint-payload) :position 1)

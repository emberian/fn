(defun fn-lc-adopt-map-loop (cells lane fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (if (consp cells)
  (let ((fn-lbc (stobj-let ((fn-dmap (fn-lbc-number-store fn-lbc)))
          (fn-dmap) (ec-call (fn-dmap-put (mod (nfix lane) 3)
                    (fn-lc-head (car cells)) (fn-lc-rest (car cells)) fn-dmap)) fn-lbc)))
    (fn-lc-adopt-map-loop (cdr cells) lane fn-lbc)) fn-lbc))
(defun fn-lc-adopt-escapes-loop (cells fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (if (consp cells)
  (let ((fn-lbc (ec-call (fn-lbc-escape-store-put
                   (fn-lc-head (car cells)) (fn-lc-rest (car cells)) fn-lbc))))
    (fn-lc-adopt-escapes-loop (cdr cells) fn-lbc)) fn-lbc))
(defun fn-lc-install-columns (value fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((fn-lbc (ec-call (fn-lbc-clear-columns fn-lbc)))
        (fn-lbc (fn-lc-adopt-rowwords-loop (fn-lc-at 0 value) fn-lbc))
        (fn-lbc (fn-lc-adopt-msgid-octets-loop (fn-lc-at 1 value) fn-lbc))
        (fn-lbc (fn-lc-adopt-overview-octets-loop (fn-lc-at 2 value) fn-lbc))
        (fn-lbc (fn-lc-adopt-msgid-slots-loop (fn-lc-at 4 value) fn-lbc))
        (fn-lbc (fn-lc-adopt-directory-loop (fn-lc-at 5 value) fn-lbc))
        (fn-lbc (fn-lc-adopt-memberships-loop (fn-lc-at 6 value) fn-lbc))
        (fn-lbc (fn-lc-adopt-nov-loop (fn-lc-at 7 value) fn-lbc))
        (fn-lbc (fn-lc-adopt-map-loop (ec-call (reverse (fn-lc-at 0 (fn-lc-at 3 value)))) 0 fn-lbc))
        (fn-lbc (fn-lc-adopt-map-loop (ec-call (reverse (fn-lc-at 1 (fn-lc-at 3 value)))) 1 fn-lbc))
        (fn-lbc (fn-lc-adopt-map-loop (ec-call (reverse (fn-lc-at 2 (fn-lc-at 3 value)))) 2 fn-lbc))
        (fn-lbc (fn-lc-adopt-escapes-loop (ec-call (reverse (fn-lc-at 9 value))) fn-lbc))
        (fn-lbc (update-fn-lbc-summary-groups (fn-lc-at 8 value) fn-lbc)))
   (update-fn-lbc-slot-escape-keys (fn-lc-at 10 value) fn-lbc)))

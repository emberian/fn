; LC adoption uses LB's generated representations and public exports.
; The directory delimits the seven independent column tapes and map tape.
; No article/history tape or second array representation is introduced.
(in-package "ACL2")
(include-book "log-checkpoint-publication")
(include-book "log-checkpoint-control")
(include-book "log-checkpoint-open-guards")

(defun fn-lc-layout-pages (lengths)
 (declare (xargs :guard t :verify-guards nil))
 (ec-call (fn-lc-map-observation-pages-of
  (list (ec-call (fn-lc-map-observation-tree-enc (list (list :lc-layout lengths))))))))
(defun fn-lc-layout-lengths (header)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((rows (ec-call (fn-lc-map-observation-of-pages (fn-lc-at 4 header))))
        (value (fn-lc-at 1 (ec-call (fn-scc-decode-tree (fn-lc-head (fn-lc-head rows)))))))
  (if (equal (fn-lc-head value) :lc-layout) (fn-lc-at 1 value) :bad)))
(defun fn-lc-lengths-p (lengths)
 (declare (xargs :guard t))
 (if (consp lengths) (and (natp (car lengths)) (fn-lc-lengths-p (cdr lengths)))
  (equal lengths nil)))
(defun fn-lc-lengths-sum (lengths)
 (declare (xargs :guard t))
 (if (consp lengths) (+ (nfix (car lengths)) (fn-lc-lengths-sum (cdr lengths))) 0))
(defun fn-lc-column-components (lengths pages)
 (declare (xargs :guard t))
 (if (consp lengths)
  (cons (fn-lc-take (nfix (car lengths)) pages)
        (fn-lc-column-components (cdr lengths) (fn-lc-drop (nfix (car lengths)) pages))) nil))
(defun fn-lc-column-lengths-value (value)
 (declare (xargs :guard t :verify-guards nil))
 (let ((lengths (list
  (len (ec-call (fn-lbc-rowwords-pages-of (fn-lc-at *fn-lbc-row-store* value))))
  (len (ec-call (fn-lbc-msgid-octets-pages-of (fn-lc-at *fn-lbc-msgid-store* value))))
  (len (ec-call (fn-lbc-overview-octets-pages-of (fn-lc-at *fn-lbc-overview-store* value))))
  (len (ec-call (fn-lbc-msgid-slots-pages-of (fn-lc-at *fn-lbc-slot-store* value))))
  (len (ec-call (fn-lbc-directory-pages-of (fn-lc-at *fn-lbc-directory-store* value))))
  (len (ec-call (fn-lbc-memberships-pages-of (fn-lc-at *fn-lbc-membership-store* value))))
  (len (ec-call (fn-lbc-nov-pages-of (fn-lc-at *fn-lbc-nov-store* value))))
  )))
  (append lengths (list (nfix (- (len (ec-call (fn-lc-columns-value value))) (fn-lc-lengths-sum lengths)))))))
(defun-nx fn-lc-column-lengths (fn-lbc)
 (ec-call (fn-lc-column-lengths-value fn-lbc)))
(defun fn-lc-adopted-columns (disk r mode)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((opened (pgs-open disk r mode))
        (header (fn-lc-header-of-open opened))
        (lengths (fn-lc-layout-lengths header)))
  (if (and (fn-lc-lengths-p lengths) (equal (len lengths) 8))
      (fn-lc-take (fn-lc-lengths-sum lengths) (fn-lc-rest (fn-lc-at 3 opened))) :bad)))
(defun fn-lc-decoded-columns (columns lengths)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((parts (fn-lc-column-components lengths columns))
        (maps (ec-call (fn-lc-map-observation-of-pages (fn-lc-at 7 parts))))
        (map-value (fn-lc-at 1 (ec-call (fn-scc-decode-tree
                             (fn-lc-head (fn-lc-head maps)))))))
  (list
   (ec-call (fn-lbc-rowwords-of-pages (fn-lc-at 0 parts)))
   (ec-call (fn-lbc-msgid-octets-of-pages (fn-lc-at 1 parts)))
   (ec-call (fn-lbc-overview-octets-of-pages (fn-lc-at 2 parts)))
   (fn-lc-at 0 map-value)
   (ec-call (fn-lbc-msgid-slots-of-pages (fn-lc-at 3 parts)))
   (ec-call (fn-lbc-directory-of-pages (fn-lc-at 4 parts)))
   (ec-call (fn-lbc-memberships-of-pages (fn-lc-at 5 parts)))
   (ec-call (fn-lbc-nov-of-pages (fn-lc-at 6 parts)))
   (fn-lc-at 1 map-value)
   (fn-lc-at 2 map-value)
   (fn-lc-at 3 map-value))))
(defun fn-lc-decoded-columnsp (value)
 (declare (xargs :guard t :verify-guards nil))
 (and (true-listp value) (equal (len value) 11)
  (ec-call (fn-lbc-rowwords$ap (fn-lc-at 0 value)))
  (ec-call (fn-lbc-msgid-octets$ap (fn-lc-at 1 value)))
  (ec-call (fn-lbc-overview-octets$ap (fn-lc-at 2 value)))
  (ec-call (fn-lbc-msgid-slots$ap (fn-lc-at 4 value)))
  (ec-call (fn-lbc-directory$ap (fn-lc-at 5 value)))
  (ec-call (fn-lbc-memberships$ap (fn-lc-at 6 value)))
  (ec-call (fn-lbc-nov$ap (fn-lc-at 7 value)))
  (fn-dmap$ap (fn-lc-at 3 value))
  (true-listp (fn-lc-at 8 value)) (alistp (fn-lc-at 9 value))
  (true-listp (fn-lc-at 10 value))))
(defun fn-lc-adopt-rowwords-loop (records fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (if (consp records)
  (let ((fn-lbc (stobj-let ((fn-lbc-rowwords (fn-lbc-row-store fn-lbc)))
          (fn-lbc-rowwords) (ec-call (fn-lbc-rowwords-append (car records) fn-lbc-rowwords)) fn-lbc)))
    (fn-lc-adopt-rowwords-loop (cdr records) fn-lbc)) fn-lbc))

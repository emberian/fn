; Stable C catalog promise identity. These predicates deliberately do not
; consult mutable cold investigation state after acquisition has completed.
(in-package "ACL2")
(include-book "checkpoint-cbase-state")
(include-book "checkpoint-summary-state")
(fn2-book-layer :c)
(defun fn2-checkpoint-cbase-row-summary-word (r i fn2-checkpoint-summary)
 (declare (xargs :stobjs fn2-checkpoint-summary
 :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (natp r) (< r 2)
             (< r (fn2-checkpoint-summary-rows fn2-checkpoint-summary)) (natp i) (< i 8))))
 (fn2-checkpoint-summary-descriptor-word r i fn2-checkpoint-summary))
(defun fn2-checkpoint-cbase-summary-word (i fn2-checkpoint-summary)
 (declare (xargs :stobjs fn2-checkpoint-summary
 :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (< 0 (fn2-checkpoint-summary-rows fn2-checkpoint-summary)) (natp i) (< i 8))))
 (fn2-checkpoint-cbase-row-summary-word 0 i fn2-checkpoint-summary))
(defun fn2-checkpoint-cbase-word (c i fn2-checkpoint-cbase-holds)
 (declare (xargs :stobjs fn2-checkpoint-cbase-holds
  :guard (and (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds)
              (natp c) (< c (fn2-checkpoint-cbase-holds-rows fn2-checkpoint-cbase-holds)) (natp i) (< i 8))))
 (case i
  (0 (fn2-checkpoint-cbase-holds-hash-0 c fn2-checkpoint-cbase-holds))
  (1 (fn2-checkpoint-cbase-holds-hash-1 c fn2-checkpoint-cbase-holds))
  (2 (fn2-checkpoint-cbase-holds-hash-2 c fn2-checkpoint-cbase-holds))
  (3 (fn2-checkpoint-cbase-holds-hash-3 c fn2-checkpoint-cbase-holds))
  (4 (fn2-checkpoint-cbase-holds-hash-4 c fn2-checkpoint-cbase-holds))
  (5 (fn2-checkpoint-cbase-holds-hash-5 c fn2-checkpoint-cbase-holds))
  (6 (fn2-checkpoint-cbase-holds-hash-6 c fn2-checkpoint-cbase-holds))
  (otherwise (fn2-checkpoint-cbase-holds-hash-7 c fn2-checkpoint-cbase-holds))))
(defun fn2-checkpoint-cbase-row-hash-p (i r c fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-cbase-holds) :measure (nfix (- 8 (nfix i)))
  :guard (and (natp r) (< r 2) (< r (fn2-checkpoint-summary-rows fn2-checkpoint-summary)) (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds)
              (natp c) (< c (fn2-checkpoint-cbase-holds-rows fn2-checkpoint-cbase-holds)) (natp i) (<= i 8))))
 (if (or (not (natp i)) (>= i 8)) t
  (and (equal (fn2-checkpoint-cbase-row-summary-word r i fn2-checkpoint-summary)
              (fn2-checkpoint-cbase-word c i fn2-checkpoint-cbase-holds))
       (fn2-checkpoint-cbase-row-hash-p (+ 1 i) r c fn2-checkpoint-summary fn2-checkpoint-cbase-holds))))
(defun fn2-checkpoint-cbase-hash-p (i c fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
 :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds)
             (< 0 (fn2-checkpoint-summary-rows fn2-checkpoint-summary)) (natp i) (<= i 8) (natp c) (< c (fn2-checkpoint-cbase-holds-rows fn2-checkpoint-cbase-holds)))))
 (fn2-checkpoint-cbase-row-hash-p i 0 c fn2-checkpoint-summary fn2-checkpoint-cbase-holds))
(defun fn2-checkpoint-cbase-row-identity-p (r fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
  :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds))))
 (and (natp r) (< r 2) (< r (fn2-checkpoint-summary-rows fn2-checkpoint-summary))
      (posp (fn2-checkpoint-summary-tag r fn2-checkpoint-summary))
      (posp (fn2-checkpoint-summary-checkpoint r fn2-checkpoint-summary))
      (posp (fn2-checkpoint-summary-generation r fn2-checkpoint-summary))
      (posp (fn2-checkpoint-summary-owner-gen r fn2-checkpoint-summary))
      (let ((c (fn2-checkpoint-summary-candidate r fn2-checkpoint-summary)))
       (and (< c (fn2-checkpoint-cbase-holds-rows fn2-checkpoint-cbase-holds))
            (equal (fn2-checkpoint-cbase-holds-tag c fn2-checkpoint-cbase-holds) (fn2-checkpoint-summary-tag r fn2-checkpoint-summary))
            (equal (fn2-checkpoint-cbase-holds-checkpoint c fn2-checkpoint-cbase-holds) (fn2-checkpoint-summary-checkpoint r fn2-checkpoint-summary))
            (equal (fn2-checkpoint-cbase-holds-cut-commit c fn2-checkpoint-cbase-holds) (fn2-checkpoint-summary-cut-commit r fn2-checkpoint-summary))
            (equal (fn2-checkpoint-cbase-holds-cut-event c fn2-checkpoint-cbase-holds) (fn2-checkpoint-summary-cut-event r fn2-checkpoint-summary))
            (equal (fn2-checkpoint-cbase-holds-history c fn2-checkpoint-cbase-holds) (fn2-checkpoint-summary-history r fn2-checkpoint-summary))
            (equal (fn2-checkpoint-cbase-holds-incarnation c fn2-checkpoint-cbase-holds) (fn2-checkpoint-summary-incarnation r fn2-checkpoint-summary))
            (equal (fn2-checkpoint-cbase-holds-generation c fn2-checkpoint-cbase-holds) (fn2-checkpoint-summary-generation r fn2-checkpoint-summary))
            (equal (fn2-checkpoint-cbase-holds-owner-kind c fn2-checkpoint-cbase-holds) (fn2-checkpoint-summary-owner-kind r fn2-checkpoint-summary))
            (equal (fn2-checkpoint-cbase-holds-owner-slot c fn2-checkpoint-cbase-holds) (fn2-checkpoint-summary-owner-slot r fn2-checkpoint-summary))
            (equal (fn2-checkpoint-cbase-holds-owner-gen c fn2-checkpoint-cbase-holds) (fn2-checkpoint-summary-owner-gen r fn2-checkpoint-summary))
            (posp (fn2-checkpoint-cbase-holds-limit c fn2-checkpoint-cbase-holds))
            (fn2-checkpoint-cbase-row-hash-p 0 r c fn2-checkpoint-summary fn2-checkpoint-cbase-holds)))))
(defun fn2-checkpoint-cbase-identity-p (fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
 :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds))))
 (fn2-checkpoint-cbase-row-identity-p 0 fn2-checkpoint-summary fn2-checkpoint-cbase-holds))

; Only this predicate may admit adoption. A partial hold, or a closing catalog,
; never grants permission to publish new physical C sources.
(defun fn2-checkpoint-cbase-row-held-p (r fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
  :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds))))
 (and (fn2-checkpoint-cbase-row-identity-p r fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
      (member-equal (fn2-checkpoint-summary-phase r fn2-checkpoint-summary)
       (list *fn2-checkpoint-summary-phase-captured* *fn2-checkpoint-summary-phase-applying* *fn2-checkpoint-summary-phase-applied*))
      (let ((c (fn2-checkpoint-summary-candidate r fn2-checkpoint-summary)))
       (and (posp (fn2-checkpoint-cbase-holds-seen c fn2-checkpoint-cbase-holds))
            (equal (fn2-checkpoint-cbase-holds-phase c fn2-checkpoint-cbase-holds) *fn2-checkpoint-cbase-phase-held*)
            (equal (fn2-checkpoint-cbase-holds-cursor c fn2-checkpoint-cbase-holds) (fn2-checkpoint-cbase-holds-limit c fn2-checkpoint-cbase-holds))))))
(defun fn2-checkpoint-cbase-held-p (fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
 :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds))))
 (fn2-checkpoint-cbase-row-held-p 0 fn2-checkpoint-summary fn2-checkpoint-cbase-holds))
; Existing leased queries may continue during close; the loader must ALSO
; validate its actual catalog lease. This is not an adoption predicate.
(defun fn2-checkpoint-cbase-row-promised-p (r fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
  :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds))))
 (and (fn2-checkpoint-cbase-row-identity-p r fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
      (member-equal (fn2-checkpoint-summary-phase r fn2-checkpoint-summary)
       (list *fn2-checkpoint-summary-phase-applying* *fn2-checkpoint-summary-phase-applied* *fn2-checkpoint-summary-phase-retiring*))
      (let ((c (fn2-checkpoint-summary-candidate r fn2-checkpoint-summary)))
       (and (posp (fn2-checkpoint-cbase-holds-seen c fn2-checkpoint-cbase-holds))
            (member-equal (fn2-checkpoint-cbase-holds-phase c fn2-checkpoint-cbase-holds)
             (list *fn2-checkpoint-cbase-phase-held* *fn2-checkpoint-cbase-phase-closing*))))))
(defun fn2-checkpoint-cbase-promised-p (fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-cbase-holds)
 :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds))))
 (fn2-checkpoint-cbase-row-promised-p 0 fn2-checkpoint-summary fn2-checkpoint-cbase-holds))

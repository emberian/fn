; Pure selection and root/pin/tail refusal decisions.
(in-package "ACL2")
(include-book "log-checkpoint-tail")
(include-book "log-cleaning")
(include-book "defkeystone")
(defthm fn-lc-open-selection-bounds-the-suffix
  (let ((selection (fn-lc-open-selection disk r mode count segs header)))
    (implies (equal (car selection) :checkpoint)
             (and (equal (car (pgs-open disk r mode)) :ok)
                  (natp count)
                  (equal header (fn-lc-header-of-open (pgs-open disk r mode)))
                  (equal (fn-lc-selection-sequence selection) (fn-lc-header-sequence header))
                  (<= (fn-lc-selection-sequence selection) count)
                  (fn-lc-segs-retain segs header)
                  (equal (fn-lc-selection-S selection) (fn-lc-header-S header))
                  (equal (fn-lc-selection-tail selection) (fn-lc-tail-history segs header)))))
  :rule-classes nil
  :hints (("Goal" :in-theory (e/d (fn-lc-open-selection fn-lc-selection-sequence fn-lc-selection-S fn-lc-selection-tail)
                                (pgs-open fn-lc-header-of-open fn-lc-header-sequence fn-lc-segs-retain fn-lc-header-S fn-lc-tail-history)))))
(defthm fn-lc-unlink-only-unreferenced
  (implies (fn-lc-unlink-allowedp seg disk r fn-lc-pins tail)
           (and (not (fn-lc-slot-references (car (pgs-root-slots r disk)) seg))
                (not (fn-lc-slot-references (cdr (pgs-root-slots r disk)) seg))
                (not (fn-lc-pin-references fn-lc-pins seg))
                (not (fn-lc-tail-references tail seg))))
  :rule-classes nil
  :hints (("Goal" :in-theory (enable fn-lc-unlink-allowedp))))
(defteeth fn-lc-unlink-only-unreferenced
 :claim (((allowed (fn-lc-unlink-allowedp seg disk r fn-lc-pins tail)))
           (and (not (fn-lc-slot-references (car (pgs-root-slots r disk)) seg))
                (not (fn-lc-slot-references (cdr (pgs-root-slots r disk)) seg))
                (not (fn-lc-pin-references fn-lc-pins seg))
                (not (fn-lc-tail-references tail seg))))
 :subject fn-lc-unlink-allowedp
 :witness ((seg 0) (disk nil) (r :lc) (fn-lc-pins nil) (tail 1))
 :breaks ((allowed ((tail 0))))
 :mutations ((missed-tail (:conclusion
           (and (not (fn-lc-slot-references (car (pgs-root-slots r disk)) seg))
                (not (fn-lc-slot-references (cdr (pgs-root-slots r disk)) seg))
                (not (fn-lc-pin-references fn-lc-pins seg))
                (fn-lc-tail-references tail seg)))
  ((seg 0) (disk nil) (r :lc) (fn-lc-pins nil) (tail 1))
  :fault "unlink verdict inverted its active-tail obligation")))

(defun fn-lc-proof-digest (x) (declare (xargs :guard t)) (acl2-count x))
(defun fn-lc-proof-header-disk (header)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((table (list (list 2 1 (pgs-digest header))))
        (directory (list (list 1 1 (pgs-digest table))))
        (record (pgs-make-rec 1 3 1 (pgs-digest directory))))
  (cons (list (cons 1 table) (cons 2 header) (cons 3 directory))
        (list (cons :lc (cons record nil))))))

(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
 (defteeth fn-lc-open-selection-bounds-the-suffix
  :claim (let ((selection (fn-lc-open-selection disk r mode count segs header)))
           (((chosen (equal (car selection) :checkpoint))) (and (equal (car (pgs-open disk r mode)) :ok)
                  (natp count)
                  (equal header (fn-lc-header-of-open (pgs-open disk r mode)))
                  (equal (fn-lc-selection-sequence selection) (fn-lc-header-sequence header))
                  (<= (fn-lc-selection-sequence selection) count)
                  (fn-lc-segs-retain segs header)
                  (equal (fn-lc-selection-S selection) (fn-lc-header-S header))
                  (equal (fn-lc-selection-tail selection) (fn-lc-tail-history segs header)))))
  :subject fn-lc-open-selection
  :witness ((header (list :lc-header (list 0 0 0 0 *fn-lg-genesis*) 1 nil nil nil)) (disk (fn-lc-proof-header-disk header)) (r :lc) (mode :eager) (count 0) (segs '((0 nil nil))))
  :breaks ((chosen ((count -1))))
  :mutations ((strict-bound (:conclusion (and (equal (car (pgs-open disk r mode)) :ok)
                  (natp count)
                  (equal header (fn-lc-header-of-open (pgs-open disk r mode)))
                  (equal (fn-lc-selection-sequence selection) (fn-lc-header-sequence header))
                  (< (fn-lc-selection-sequence selection) count)
                  (fn-lc-segs-retain segs header)
                  (equal (fn-lc-selection-S selection) (fn-lc-header-S header))
                  (equal (fn-lc-selection-tail selection) (fn-lc-tail-history segs header)))) ((header (list :lc-header (list 0 0 0 0 *fn-lg-genesis*) 1 nil nil nil)) (disk (fn-lc-proof-header-disk header)) (r :lc) (mode :eager) (count 0) (segs '((0 nil nil))))
    :fault "selection improperly demands a sequence strictly before the recovered count"))))
(defteeth-check (fn-lc-open-selection-bounds-the-suffix fn-lc-unlink-only-unreferenced))

                    (equal (fn2-checkpoint-metadata-held 0 fn2-checkpoint-metadata) 0)))
       (fn2-checkpoint-compaction-output-mv :source))
      ((unless (unsigned-byte-p 60 (+ 1 (fn2-checkpoint-compaction-lower-round 0 fn2-checkpoint-compaction))))
       (fn2-checkpoint-compaction-output-mv :exhausted))
      (kind (fn2-checkpoint-compaction-owner-kind 0 fn2-checkpoint-compaction))
      (owner (fn2-checkpoint-compaction-owner-slot 0 fn2-checkpoint-compaction))
      (gen (fn2-checkpoint-compaction-owner-gen 0 fn2-checkpoint-compaction))
      (lb (fn2-checkpoint-compaction-lower-base 0 fn2-checkpoint-compaction))
      ((mv code fn2-fields fn2-pool)
       (if (and (equal (fn2-checkpoint-compaction-copy-field 0 fn2-checkpoint-compaction) 0)
                (equal (fn2-checkpoint-compaction-copy-offset 0 fn2-checkpoint-compaction) 0))
        (b* (((mv code fn2-pool) (fn2-pool-reset (fn2-checkpoint-compaction-lower-slot 0 fn2-checkpoint-compaction)
                                            (fn2-checkpoint-compaction-lower-gen 0 fn2-checkpoint-compaction) kind owner gen fn2-pool))
             ((unless (eq code :ok)) (mv code fn2-fields fn2-pool))
             ((mv code fn2-fields) (fn2-range-copy-rows *fn2-run-entry-rows* (fn2-checkpoint-compaction-entry-base 0 fn2-checkpoint-compaction) lb fn2-fields)))
         (mv code fn2-fields fn2-pool))
        (mv :ok fn2-fields fn2-pool)))
      ((unless (eq code :ok)) (fn2-checkpoint-compaction-output-mv code))
      ((mv code field copied end fn2-fields fn2-pool)
       (fn2-run-entry-rehome-step (fn2-checkpoint-compaction-schema 0 fn2-checkpoint-compaction) lb
        (fn2-checkpoint-compaction-copy-field 0 fn2-checkpoint-compaction)
        (fn2-checkpoint-compaction-copy-offset 0 fn2-checkpoint-compaction)
        (fn2-checkpoint-compaction-copy-end 0 fn2-checkpoint-compaction)
        (fn2-checkpoint-compaction-lower-slot 0 fn2-checkpoint-compaction) (fn2-checkpoint-compaction-lower-gen 0 fn2-checkpoint-compaction)
        kind owner gen kind owner gen (floor budget 2) fn2-fields fn2-pool))
      ((unless (member-eq code '(:more :done))) (fn2-checkpoint-compaction-output-mv code))
      (fn2-checkpoint-compaction (fn2-checkpoint-compaction-put 0 (copy-field field) (copy-offset copied) (copy-end end)))
      (fn2-checkpoint-compaction (if (eq code :done)
       (fn2-checkpoint-compaction-put 0 (phase *fn2-checkpoint-compaction-phase-sources*) (scan-kind 0) (scan-row 0)
        (has-lower 1) (lower-round (+ 1 (fn2-checkpoint-compaction-lower-round 0 fn2-checkpoint-compaction)))
        (best 0) (source-started 0) (copy-field 0) (copy-offset 0) (copy-end 0)) fn2-checkpoint-compaction)))

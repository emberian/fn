 fn2-overlays fn2-run-installed fn2-checkpoint-metadata fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fc fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-compaction fn2-checkpoint-root1 fn2-checkpoint-windows fn2-checkpoint-build fn2-csnapshot fn2-checkpoints
 fn2-overlays fn2-run-installed fn2-checkpoint-metadata fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fc fn2-fields fn2-pool)
 :guard (fn2-checkpoint-compaction-output-guard)))
 (b* (((unless (and (posp budget) (<= 2 budget))) (fn2-checkpoint-compaction-output-mv :yield))
      ((unless (and (fn2-checkpoint-compaction-output-bound-p fn2-checkpoint-compaction fn2-checkpoint-root1 fn2-checkpoint-windows fn2-checkpoint-build fn2-csnapshot fn2-checkpoints
                            fn2-overlays fn2-run-installed fn2-checkpoint-metadata fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fc fn2-fields fn2-pool)

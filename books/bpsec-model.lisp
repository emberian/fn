; BPSec ASB reference objects and immutable-span abstraction.
; RFC 9172 sections 3.5/3.6; RFC 9173 contexts 1 and 2.
; No crypto decision, key policy or production span provider is defined here.
(in-package "ACL2")
(include-book "bp-primary")

(defun fn-bps-field (n x)
  (declare (xargs :guard (natp n)))
  (if (zp n) (if (consp x) (car x) nil)
    (if (consp x) (fn-bps-field (1- n) (cdr x)) nil)))

(defun fn-bps-uintp (x)
  (declare (xargs :guard t))
  (and (natp x) (<= x *fn-bpc-max-uint*)))

(defun fn-bps-security-resultp (x)
  (declare (xargs :guard t))
  (or (eq x :verified) (eq x :failed) (eq x :unsupported)))

(defun fn-bps-limits-make (bytes targets params results value-bytes metadata)
  (declare (xargs :guard t))
  (list :bps-limits bytes targets params results value-bytes metadata))

(defun fn-bps-limitsp (x)
  (declare (xargs :guard t))
  (and (true-listp x) (equal (len x) 7)
       (eq (fn-bps-field 0 x) :bps-limits)
       (fn-bps-uintp (fn-bps-field 1 x))
       (fn-bps-uintp (fn-bps-field 2 x))
       (fn-bps-uintp (fn-bps-field 3 x))
       (fn-bps-uintp (fn-bps-field 4 x))
       (fn-bps-uintp (fn-bps-field 5 x))
       (fn-bps-uintp (fn-bps-field 6 x))))

(defun fn-bps-asb-make (kind targets context flags source params results)
  (declare (xargs :guard t))
  (list :asb kind targets context flags source params results))

(defun fn-bps-uint-listp (xs)
  (declare (xargs :guard t))
  (if (consp xs)
      (and (fn-bps-uintp (car xs)) (fn-bps-uint-listp (cdr xs)))
    (null xs)))

; The reference value vocabulary deliberately omits generic CBOR budgets.
; Count/byte admission is the parser's operator-profile decision.
(defun fn-bps-valuep (x)
  (declare (xargs :guard t))
  (and (consp x)
       (or (and (eq (car x) :uint) (fn-bps-uintp (cdr x)))
           (and (eq (car x) :bytes) (fn-cbor-octet-listp (cdr x))))))

(defun fn-bps-pairsp (xs)
  (declare (xargs :guard t))
  (if (consp xs)
      (and (true-listp (car xs)) (equal (len (car xs)) 2)
           (fn-bps-uintp (caar xs)) (fn-bps-valuep (cadar xs))
           (fn-bps-pairsp (cdr xs)))
    (null xs)))

(defun fn-bps-resultsp (xs)
  (declare (xargs :guard t))
  (if (consp xs)
      (and (fn-bps-pairsp (car xs)) (fn-bps-resultsp (cdr xs)))
    (null xs)))

(defun fn-bps-asbp (x)
  (declare (xargs :guard t))
  (and (true-listp x) (equal (len x) 8) (eq (car x) :asb)
       (member-equal (fn-bps-field 1 x) '(11 12))
       (consp (fn-bps-field 2 x)) (fn-bps-uint-listp (fn-bps-field 2 x))
       (no-duplicatesp-equal (fn-bps-field 2 x))
       (fn-bps-uintp (fn-bps-field 3 x)) (fn-bps-uintp (fn-bps-field 4 x))
       (fn-bpp-eidp (fn-bps-field 5 x))
       (fn-bps-pairsp (fn-bps-field 6 x))
       (equal (logand (fn-bps-field 4 x) 1)
              (if (consp (fn-bps-field 6 x)) 1 0))
       (fn-bps-resultsp (fn-bps-field 7 x))
       (equal (len (fn-bps-field 2 x)) (len (fn-bps-field 7 x)))))

(defun fn-bps-pairs-value (pairs)
  (declare (xargs :guard t))
  (if (consp pairs)
      (cons (cons :array (list (cons :uint (fn-bps-field 0 (car pairs)))
                              (fn-bps-field 1 (car pairs))))
            (fn-bps-pairs-value (cdr pairs)))
    nil))

(defun fn-bps-results-value (results)
  (declare (xargs :guard t))
  (if (consp results)
      (cons (cons :array (fn-bps-pairs-value (car results)))
            (fn-bps-results-value (cdr results)))
    nil))

(defun fn-bps-targets-value (targets)
  (declare (xargs :guard t))
  (if (consp targets)
      (cons (cons :uint (car targets)) (fn-bps-targets-value (cdr targets)))
    nil))

(defun fn-bps-asb-encode (asb)
  (declare (xargs :guard t))
  (if (not (fn-bps-asbp asb)) nil
    (append
     (fn-bpc-enc :item (cons :array (fn-bps-targets-value (fn-bps-field 2 asb))))
     (fn-bpc-argument 0 (fn-bps-field 3 asb))
     ; RFC 9172 3.6: clear reserved bits on generation, retain raw read flags.
     (fn-bpc-argument 0 (if (consp (fn-bps-field 6 asb)) 1 0))
     (fn-bpc-enc :item (fn-bpp-eid-value (fn-bps-field 5 asb)))
     (if (consp (fn-bps-field 6 asb))
         (fn-bpc-enc :item (cons :array (fn-bps-pairs-value (fn-bps-field 6 asb)))) nil)
     (fn-bpc-enc :item (cons :array (fn-bps-results-value (fn-bps-field 7 asb)))))))

(defun fn-bps-window-make (backing-id offset octets)
  (declare (xargs :guard t))
  (list :bps-window backing-id offset octets))

(defun fn-bps-windowp (x)
  (declare (xargs :guard t))
  (and (true-listp x) (equal (len x) 4) (eq (car x) :bps-window)
       (fn-bps-uintp (fn-bps-field 2 x))
       (fn-cbor-octet-listp (fn-bps-field 3 x))))

(defun fn-bps-span-make (tag backing-id offset length)
  (declare (xargs :guard t))
  (list tag backing-id offset length))

(defun fn-bps-spanp (x)
  (declare (xargs :guard t))
  (and (true-listp x) (equal (len x) 4)
       (member-equal (car x) '(:bytes-span :text-span))
       (fn-bps-uintp (fn-bps-field 2 x)) (fn-bps-uintp (fn-bps-field 3 x))
       (<= (+ (fn-bps-field 2 x) (fn-bps-field 3 x)) *fn-bpc-max-uint*)))

(defun fn-bps-backing-entry (id backings)
  (declare (xargs :guard t))
  (if (consp backings)
      (if (and (consp (car backings)) (equal (caar backings) id))
          (car backings)
        (fn-bps-backing-entry id (cdr backings)))
    nil))

(defun fn-bps-backing (id backings)
  (declare (xargs :guard t))
  (let ((entry (fn-bps-backing-entry id backings)))
    (if (consp entry) (cdr entry) nil)))

(defun fn-bps-span-octets (span backings)
  (declare (xargs :guard t))
  (let ((bytes (fn-bps-backing (fn-bps-field 1 span) backings)))
    (if (and (fn-bps-spanp span)
             (consp (fn-bps-backing-entry (fn-bps-field 1 span) backings))
             (fn-cbor-octet-listp bytes)
             (<= (+ (fn-bps-field 2 span) (fn-bps-field 3 span)) (len bytes)))
        (take (fn-bps-field 3 span) (nthcdr (fn-bps-field 2 span) bytes))
      (list :invalid-span))))

; Only the logical abstraction reads whole values. The served cursor stores
; the spans and never calls this function to copy a received large value.
(defun fn-bps-value-alpha (mode value backings)
  (declare (xargs :guard t :measure (acl2-count value)))
  (if (eq mode :list)
      (if (consp value)
          (cons (fn-bps-value-alpha :item (car value) backings)
                (fn-bps-value-alpha :list (cdr value) backings)) nil)
    (cond ((fn-bps-spanp value)
           (cons (if (eq (car value) :bytes-span) :bytes :text)
                 (fn-bps-span-octets value backings)))
          ((and (consp value) (eq (car value) :array))
           (cons :array (fn-bps-value-alpha :list (cdr value) backings)))
          (t value))))

(defun fn-bps-pairs-alpha (pairs backings)
  (declare (xargs :guard t))
  (if (consp pairs)
      (cons (list (fn-bps-field 0 (car pairs))
                  (fn-bps-value-alpha :item (fn-bps-field 1 (car pairs)) backings))
            (fn-bps-pairs-alpha (cdr pairs) backings)) nil))

(defun fn-bps-results-alpha (results backings)
  (declare (xargs :guard t))
  (if (consp results)
      (cons (fn-bps-pairs-alpha (car results) backings)
            (fn-bps-results-alpha (cdr results) backings)) nil))

(defun fn-bps-asb-span-alpha (asb backings)
  (declare (xargs :guard t))
  (fn-bps-asb-make
   (fn-bps-field 1 asb) (fn-bps-field 2 asb) (fn-bps-field 3 asb)
   (fn-bps-field 4 asb)
   (fn-bpp-value-eid (fn-bps-value-alpha :item (fn-bps-field 5 asb) backings))
   (fn-bps-pairs-alpha (fn-bps-field 6 asb) backings)
   (fn-bps-results-alpha (fn-bps-field 7 asb) backings)))

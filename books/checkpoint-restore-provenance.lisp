; Durable source binding for cold semantic readers. A candidate slot is a
; locator, not an identity; the exact authenticated descriptor is retained.
(in-package "ACL2")
(include-book "checkpoint-restore-map")
(fn2-book-layer :b)
(defun fn2-checkpoint-restore-map-descriptor-equal (i c fn2-checkpoint-bytes fn2-checkpoint-restore-map-control)
 (declare (xargs :stobjs (fn2-checkpoint-bytes fn2-checkpoint-restore-map-control)
  :measure (nfix (- 32 (nfix i)))
  :guard (and (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
              (fn2-checkpoint-restore-map-control-wfp fn2-checkpoint-restore-map-control)
              (natp i) (<= i 32) (natp c)
              (<= (+ (* 192 c) 32) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes)))))
 (or (>= (nfix i) 32)
  (and (equal (fn2-checkpoint-restore-map-control-descriptori i fn2-checkpoint-restore-map-control)
              (fn2-checkpoint-bytes-value (+ (* 192 c) i) fn2-checkpoint-bytes))
       (fn2-checkpoint-restore-map-descriptor-equal (+ i 1) c fn2-checkpoint-bytes fn2-checkpoint-restore-map-control))))

(defun fn2-checkpoint-restore-map-current-p (fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control)
 (declare (xargs :stobjs (fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control)
  :guard (and (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-checkpoint-restore-map-wfp fn2-checkpoint-restore-map)
              (fn2-checkpoint-restore-map-control-wfp fn2-checkpoint-restore-map-control))))
 (and (< 0 (fn2-checkpoint-restore-map-control-rows fn2-checkpoint-restore-map-control))
  (let ((c (fn2-checkpoint-restore-map-control-candidate 0 fn2-checkpoint-restore-map-control)))
   (and (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
        (equal (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-checked*)
        (posp (fn2-checkpoints-anchor-mask c fn2-checkpoints))
        (equal (fn2-checkpoints-builder-token c fn2-checkpoints) 0)
        (equal (fn2-checkpoint-restore-map-control-phase 0 fn2-checkpoint-restore-map-control) *fn2-checkpoint-restore-map-phase-validated*)
        (equal (fn2-checkpoint-restore-map-control-total 0 fn2-checkpoint-restore-map-control) (fn2-checkpoint-restore-map-rows fn2-checkpoint-restore-map))
        (equal (fn2-checkpoint-restore-map-control-source-checkpoint 0 fn2-checkpoint-restore-map-control) (fn2-checkpoints-checkpoint c fn2-checkpoints))
        (equal (fn2-checkpoint-restore-map-control-source-cut-commit 0 fn2-checkpoint-restore-map-control) (fn2-checkpoints-cut-commit c fn2-checkpoints))
        (equal (fn2-checkpoint-restore-map-control-source-cut-event 0 fn2-checkpoint-restore-map-control) (fn2-checkpoints-cut-event c fn2-checkpoints))
        (equal (fn2-checkpoint-restore-map-control-source-history 0 fn2-checkpoint-restore-map-control) (fn2-checkpoints-history c fn2-checkpoints))
        (equal (fn2-checkpoint-restore-map-control-source-incarnation 0 fn2-checkpoint-restore-map-control) (fn2-checkpoints-incarnation c fn2-checkpoints))
        (fn2-checkpoint-restore-map-descriptor-equal 0 c fn2-checkpoint-bytes fn2-checkpoint-restore-map-control)))))

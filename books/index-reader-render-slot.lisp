; Exact unchanged immutable source factoring; no issuer authority.
(in-package "ACL2")
(include-book "index-reader-request-shape")
(include-book "index-range-render-custody")
(include-book "index-reader-render-ready")

(defun fn-irc-slot-sourcep (token fn-ibp-query-segment)
 (declare (xargs :stobjs fn-ibp-query-segment :guard (fn-ibp-query-tokenp token)))
 (let* ((slot (nth 3 token))
        (context (fn-ibp-qs-inputsi slot fn-ibp-query-segment))
        (control (fn-ibp-qs-controlsi slot fn-ibp-query-segment))
        (capture (fn-ibp-qs-capturesi slot fn-ibp-query-segment))
        (admission (fn-ibp-qs-admissionsi slot fn-ibp-query-segment))
        (grant (fn-omk-at 0 admission))
        (receipt (fn-omk-at 8 context))
        (actor (fn-ira-receipt-root receipt))
        (row (fn-irc-context-custody context)))
  (and (fn-ibp-query-slot-livep token fn-ibp-query-segment)
       (fn-omk-widthp context 10)
       (fn-irr-context-matchesp token capture context control grant)
       (fn-iqr-tokenp grant) (eq (fn-omk-at 2 admission) :active)
       (fn-ibp-control-kindp :range control)
       (eq (fn-omk-at 3 control) :position)
       (equal (fn-omk-at 1 control) (nth 1 token))
       (equal (fn-omk-at 2 control) (nth 4 token))
       (equal (fn-spp-resource (fn-omk-at 4 control)) grant)
       (fn-omk-widthp actor 6) (eq (fn-omk-at 0 actor) :reader-actor)
       (eq (fn-omk-at 3 actor) :response-owned)
       (fn-omk-widthp row 12) (eq (fn-omk-at 0 row) :receiver-custody)
       (fn-omk-widthp (fn-omk-at 1 row) 4)
       (fn-omk-widthp (fn-omk-at 2 actor) 4)
       (equal (fn-omk-at 1 row) (fn-omk-at 2 actor))
       (equal (fn-omk-at 2 row) (fn-omk-at 1 actor))
       (equal (fn-omk-at 7 row) token))))

(defun fn-irc-slot-render-intent (token fn-ibp-query-segment)
 (declare (xargs :stobjs fn-ibp-query-segment :guard (fn-ibp-query-tokenp token)))
 (if (not (fn-irc-slot-sourcep token fn-ibp-query-segment))
     (mv :unavailable-custody fn-ibp-query-segment)
  (let* ((slot (nth 3 token))
         (context (fn-ibp-qs-inputsi slot fn-ibp-query-segment))
         (row (fn-irc-context-custody context))
         (control (fn-ibp-qs-controlsi slot fn-ibp-query-segment)))
   (cond
    ((eq (fn-omk-at 6 row) :render-install-intent)
     (mv :recovery-required fn-ibp-query-segment))
    ((not (and (eq (fn-omk-at 6 row) :query-owned) (null (fn-omk-at 8 row))))
     (mv :unavailable-custody fn-ibp-query-segment))
    (t
     (let* ((intent (list :receiver-render-intent token control))
            (next-row (list (fn-omk-at 0 row) (fn-omk-at 1 row) (fn-omk-at 2 row)
                     (fn-omk-at 3 row) (fn-omk-at 4 row) (fn-omk-at 5 row)
                     :render-install-intent (fn-omk-at 7 row) intent
                     (fn-omk-at 9 row) (fn-omk-at 10 row) (fn-omk-at 11 row)))
            (next-context (list (fn-omk-at 0 context) (fn-omk-at 1 context)
                     (fn-omk-at 2 context) (fn-omk-at 3 context)
                     (fn-omk-at 4 context) (fn-omk-at 5 context)
                     (fn-omk-at 6 context) (fn-omk-at 7 context)
                     (fn-omk-at 8 context) next-row))
            (fn-ibp-query-segment
             (update-fn-ibp-qs-inputsi slot next-context fn-ibp-query-segment)))
      (mv :render-intent-recorded fn-ibp-query-segment)))))))

(defun fn-irc-slot-render-install (token fn-ibp-query-segment fn-render-holder)
 (declare (xargs :stobjs (fn-ibp-query-segment fn-render-holder)
                 :guard (fn-ibp-query-tokenp token)))
 (if (or (fn-rh-live fn-render-holder)
         (not (fn-irc-slot-sourcep token fn-ibp-query-segment)))
     (mv :recovery-required fn-ibp-query-segment fn-render-holder)
  (let* ((slot (nth 3 token))
         (context (fn-ibp-qs-inputsi slot fn-ibp-query-segment))
         (row (fn-irc-context-custody context))
         (intent (fn-omk-at 8 row)))
   (if (not (and (eq (fn-omk-at 6 row) :render-install-intent)
                 (fn-omk-widthp intent 3)
                 (eq (fn-omk-at 0 intent) :receiver-render-intent)
                 (equal (fn-omk-at 1 intent) token)))
       (mv :recovery-required fn-ibp-query-segment fn-render-holder)
    (let ((prepared (list (fn-omk-at 0 row) (fn-omk-at 1 row) (fn-omk-at 2 row)
                         (fn-omk-at 3 row) (fn-omk-at 4 row) (fn-omk-at 5 row)
                         :query-owned (fn-omk-at 7 row) nil
                         (fn-omk-at 9 row) (fn-omk-at 10 row) (fn-omk-at 11 row))))
     (mv-let (word candidate fn-render-holder)
      (fn-ibr-registered-render-custody-install (fn-omk-at 2 intent) token prepared fn-render-holder)
      (if (not (and (eq word :installed) (fn-rh-live fn-render-holder)
                    (equal (fn-rh-query fn-render-holder) token)))
          (mv :recovery-required fn-ibp-query-segment fn-render-holder)
       (let* ((next-context
               (list (fn-omk-at 0 context) (fn-omk-at 1 context)
                     (fn-omk-at 2 context) (fn-omk-at 3 context)
                     (fn-omk-at 4 context) (fn-omk-at 5 context)
                     (fn-omk-at 6 context) (fn-omk-at 7 context)
                     (fn-omk-at 8 context) candidate))
              (fn-ibp-query-segment
               (update-fn-ibp-qs-inputsi slot next-context fn-ibp-query-segment)))
        (mv :installed fn-ibp-query-segment fn-render-holder)))))))))

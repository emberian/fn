; Shared immutable physical cursor binding; no catalog or descriptor authority.
(in-package "ACL2")
(include-book "run-physical-resources")
(fn2-book-layer :c)
(defun fn2-run-load-hash-current-p (c i fn2-run-loads fn2-run-cursors)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-cursors) :measure (nfix (- 8 (nfix i)))
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-run-cursors-wfp fn2-run-cursors)
  (natp c) (< c (fn2-run-loads-rows fn2-run-loads)) (< c (fn2-run-cursors-rows fn2-run-cursors)) (natp i) (<= i 8))))
 (or (>= (nfix i) 8)
  (and (equal (fn2-run-load-word c i fn2-run-loads) (fn2-run-cursor-hash-word c i fn2-run-cursors))
       (fn2-run-load-hash-current-p c (+ i 1) fn2-run-loads fn2-run-cursors))))
; The physical binding is shared by source-specific authorities. It is
; necessary but never sufficient to admit a catalog or archive source.
(defun fn2-run-load-boundp (c fn2-run-loads fn2-run-cursors)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-cursors)
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-run-cursors-wfp fn2-run-cursors))))
 (and (natp c)
      (< c (fn2-run-loads-rows fn2-run-loads))
      (< c (fn2-run-cursors-rows fn2-run-cursors))
      (equal (fn2-run-cursors-physical c fn2-run-cursors) 1)
      (equal (mod (fn2-run-cursors-unit c fn2-run-cursors) *fn2-storage-extent-units*) 0)
      (equal (fn2-run-loads-kind c fn2-run-loads) (fn2-run-cursors-okind c fn2-run-cursors))
      (equal (fn2-run-loads-owner c fn2-run-loads) (fn2-run-cursors-oslot c fn2-run-cursors))
      (equal (fn2-run-loads-generation c fn2-run-loads) (fn2-run-cursors-ogen c fn2-run-cursors))
      (equal (fn2-run-loads-source c fn2-run-loads) (fn2-run-cursors-source-row c fn2-run-cursors))
      (equal (fn2-run-loads-tag c fn2-run-loads) (fn2-run-cursors-catalog-tag c fn2-run-cursors))
      (equal (fn2-run-loads-unit c fn2-run-loads) (fn2-run-cursors-unit c fn2-run-cursors))
      (equal (fn2-run-loads-epoch c fn2-run-loads) (fn2-run-cursors-epoch c fn2-run-cursors))
      (equal (fn2-run-loads-allocation c fn2-run-loads) (fn2-run-cursors-counter c fn2-run-cursors))
      (equal (fn2-run-loads-schema c fn2-run-loads) (fn2-run-cursors-schema c fn2-run-cursors))
      (equal (fn2-run-loads-run c fn2-run-loads) (fn2-run-cursors-run c fn2-run-cursors))
      (equal (fn2-run-loads-level c fn2-run-loads) (fn2-run-cursors-level c fn2-run-cursors))
      (fn2-run-load-hash-current-p c 0 fn2-run-loads fn2-run-cursors)))

; Actual B member claim interface, emitted after the declaration-owned B table.
; No C runtime or parallel provenance carrier is introduced.
(in-package "ACL2")
(include-book "commit-members")
(fn2-book-layer :b)
(defmacro fn2-commit-successor-binding-state-events ()
 '(progn
 (make-event (value `(assert-event
  (equal 2 ,(fn2-machine-property 'fn2-commit :capacity (w state))))))
 (defun fn2-commit-successor-bind-row (batch fn2-commit)
  (declare (xargs :stobjs fn2-commit :guard (fn2-commit-wfp fn2-commit)))
  (let ((a (and (posp batch) (< 0 (fn2-commit-rows fn2-commit))
                (equal batch (fn2-commit-batch-no 0 fn2-commit))
                (not (= (fn2-commit-phase 0 fn2-commit) *fn2-commit-state-free*))))
        (b (and (posp batch) (< 1 (fn2-commit-rows fn2-commit))
                (equal batch (fn2-commit-batch-no 1 fn2-commit))
                (not (= (fn2-commit-phase 1 fn2-commit) *fn2-commit-state-free*)))))
   (cond ((and a (not b)) (mv t 0)) ((and b (not a)) (mv t 1)) (t (mv nil 0)))))
 (defun fn2-commit-successor-bind-member (batch event fn2-commit fn2-commit-member)
  (declare (xargs :stobjs (fn2-commit fn2-commit-member)
   :guard (and (fn2-commit-wfp fn2-commit) (fn2-commit-member-wfp fn2-commit-member))))
  (mv-let (found row) (fn2-commit-successor-bind-row batch fn2-commit)
   (if (not (and found (natp event) (<= (fn2-commit-first-key row fn2-commit) event))) (mv nil 0 0)
    (let* ((m (- event (fn2-commit-first-key row fn2-commit)))
           (r (+ (* *fn2-commit-members-per-batch* row) m)))
     (if (and (< m (fn2-commit-member-count row fn2-commit))
              (< m *fn2-commit-members-per-batch*) (< r (fn2-commit-member-rows fn2-commit-member))
              (= (fn2-commit-member-kind r fn2-commit-member) *fn2-commit-member-kind-txn*)
              (equal event (fn2-commit-member-event r fn2-commit-member)))
         (mv t row r) (mv nil 0 0))))))
 (defun fn2-commit-successor-bind-pending-p (batch event tx txgen slot gen len kind owner ogen fn2-commit fn2-commit-member)
  (declare (xargs :stobjs (fn2-commit fn2-commit-member)
   :guard (and (fn2-commit-wfp fn2-commit) (fn2-commit-member-wfp fn2-commit-member))))
  (mv-let (found row r) (fn2-commit-successor-bind-member batch event fn2-commit fn2-commit-member)
   (and found (< 0 (fn2-commit-cb-bind-pending row fn2-commit))
        (= (fn2-commit-member-bind-state r fn2-commit-member) *fn2-commit-bind-state-pending*)
        (equal tx (fn2-commit-member-bind-subject r fn2-commit-member))
        (equal txgen (fn2-commit-member-bind-generation r fn2-commit-member)) (posp txgen)
        (equal slot (fn2-commit-member-slot r fn2-commit-member))
        (equal gen (fn2-commit-member-gen r fn2-commit-member))
        (equal len (fn2-commit-member-len r fn2-commit-member))
        (equal kind (fn2-commit-member-okind r fn2-commit-member))
        (equal owner (fn2-commit-member-oslot r fn2-commit-member))
        (equal ogen (fn2-commit-member-ogen r fn2-commit-member)))))
 ))

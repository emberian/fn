;; TLS admission is a bounded token partition. The connection retains its RX
;; range, operation and timer until terminal harvest; releasing a token never
;; releases a still-live external loan.
(in-package "ACL2")
(include-book "machines-a")
(include-book "core-children")
(include-book "machine-arms")
(fn2-book-layer :d)

(defconst *fn2-tls-io-bytes* 1024)
(defconst *fn2-tls-minimum-version* #x0303) ; TLS 1.2, with TLS 1.3 preferred by OpenSSL

(defun fn2-host-tls-span (total offset room quantum)
 (declare (xargs :guard t))
 (if (and (unsigned-byte-p 32 total) (unsigned-byte-p 32 offset)
          (<= offset total) (unsigned-byte-p 32 room)
          (posp quantum) (unsigned-byte-p 32 quantum))
     (mv :ok (min (- total offset) (min room quantum)))
   (mv :bounds 0)))
(defthm-owed fn2-host-tls-span-bounded (total offset room quantum)
 (implies (equal (mv-nth 0 (fn2-host-tls-span total offset room quantum)) :ok) (let ((count (mv-nth 1 (fn2-host-tls-span total offset room quantum)))) (and (natp count) (<= count quantum) (<= count room) (<= (+ offset count) total))))
 :teeth (fn2-tls-span-positive fn2-tls-span-negative)
 :doc "TLS per-turn span: successful admission bounds count by available BIO room, source remainder and profile quantum.")
(defthm fn2-host-tls-span-bounded
 (implies (equal (mv-nth 0 (fn2-host-tls-span total offset room quantum)) :ok)
  (let ((count (mv-nth 1 (fn2-host-tls-span total offset room quantum))))
   (and (natp count) (<= count quantum) (<= count room)
        (<= (+ offset count) total)))))
(defun fn2-host-tls-stage-span (total offset capacity quantum)
 (declare (xargs :guard t))
 (if (and (unsigned-byte-p 32 total) (unsigned-byte-p 32 capacity) (<= total capacity))
     (fn2-host-tls-span total offset capacity quantum)
   (mv :bounds 0)))
(defthm-owed fn2-host-tls-stage-span-bounded (total offset capacity quantum)
 (implies (equal (mv-nth 0 (fn2-host-tls-stage-span total offset capacity quantum)) :ok) (let ((count (mv-nth 1 (fn2-host-tls-stage-span total offset capacity quantum)))) (and (natp count) (<= count quantum) (<= (+ offset count) total) (<= (+ offset count) capacity))))
 :teeth (fn2-tls-stage-span-positive fn2-tls-stage-span-negative)
 :doc "TLS retained-input copy: successful admission bounds source and staging destination ends and the profile quantum.")
(defthm fn2-host-tls-stage-span-bounded
 (implies (equal (mv-nth 0 (fn2-host-tls-stage-span total offset capacity quantum)) :ok)
  (let ((count (mv-nth 1 (fn2-host-tls-stage-span total offset capacity quantum))))
   (and (natp count) (<= count quantum) (<= (+ offset count) total)
        (<= (+ offset count) capacity)))))
(fn2-owed-discharge fn2-host-tls-span-bounded fn2-host-tls-span-bounded)
(fn2-owed-discharge fn2-host-tls-stage-span-bounded fn2-host-tls-stage-span-bounded)
(in-theory (disable fn2-host-tls-span fn2-host-tls-stage-span))

(defun fn2-host-tls-next-turn (remaining)
 (declare (xargs :guard t))
 (cond ((not (unsigned-byte-p 32 remaining)) (mv :bounds 0))
       ((zp remaining) (mv :exhausted 0))
       (t (mv :ok (- remaining 1)))))
(defthm-owed fn2-host-tls-turn-budget-decreases (remaining)
 (implies (equal (mv-nth 0 (fn2-host-tls-next-turn remaining)) :ok)
  (and (natp (mv-nth 1 (fn2-host-tls-next-turn remaining)))
       (< (mv-nth 1 (fn2-host-tls-next-turn remaining)) remaining)))
 :teeth (fn2-tls-turn-budget-positive fn2-tls-turn-budget-negative)
 :doc "Each admitted native handshake transport turn strictly decreases its ACL2 profile budget before BIO or SSL work.")
(defthm fn2-host-tls-turn-budget-decreases
 (implies (equal (mv-nth 0 (fn2-host-tls-next-turn remaining)) :ok)
  (and (natp (mv-nth 1 (fn2-host-tls-next-turn remaining)))
       (< (mv-nth 1 (fn2-host-tls-next-turn remaining)) remaining))))
(fn2-owed-discharge fn2-host-tls-turn-budget-decreases fn2-host-tls-turn-budget-decreases)
(in-theory (disable fn2-host-tls-next-turn))

(defun fn2-tls-setting (key default profile)
  (declare (xargs :guard t))
  (let ((value (fn2-profile-get key profile))) (if (null value) default value)))
(defun fn2-tls-pathp (path)
 (declare (xargs :guard t))
 (and (stringp path) (< 0 (length path)) (<= (length path) 4096)
      (not (member (code-char 0) (coerce path 'list)))))
(defun fn2-tls-requested-p (profile)
 (declare (xargs :guard t))
 (or (not (null (fn2-profile-get :tls-certificate profile)))
     (not (null (fn2-profile-get :tls-key profile)))))
(defun fn2-tls-seed-capacity (profile)
 (declare (xargs :guard t))
 ;; The connection generator admits RX from class zero (machines.lisp).
 (let ((classes (fn2-profile-pool-classes profile)))
  (if (and (consp classes) (consp (car classes))) (nfix (cdar classes)) 0)))
(defun fn2-tls-seed-reservation-bytes (profile)
 (declare (xargs :guard t))
 (* (nfix (fn2-profile-c profile)) (fn2-tls-seed-capacity profile)))
(defun fn2-tls-profilep (profile)
  (declare (xargs :guard t))
  (let ((slots (fn2-tls-setting :tls-handshakes 16 profile))
        (window (fn2-tls-setting :tls-window 16384 profile))
        (timeout (fn2-tls-setting :tls-handshake-ms 10000 profile))
        (turns (fn2-tls-setting :tls-handshake-turns 65536 profile)))
    (and (or (not (fn2-tls-requested-p profile))
             (and (fn2-tls-pathp (fn2-profile-get :tls-certificate profile))
                  (fn2-tls-pathp (fn2-profile-get :tls-key profile))))
         (posp slots) (unsigned-byte-p 16 slots)
         ;; BIO APIs take signed C int lengths; no implicit narrowing.
         (posp window) (unsigned-byte-p 31 window)
         (posp timeout) (unsigned-byte-p 32 timeout)
         (posp turns) (unsigned-byte-p 32 turns))))
(defun fn2-tls-admission-capacity (profile)
  (declare (xargs :guard t))
  (if (and (fn2-tls-profilep profile) (fn2-tls-requested-p profile))
      (nfix (fn2-tls-setting :tls-handshakes 16 profile)) 0))
(defthm fn2-tls-admission-capacity-natp
  (natp (fn2-tls-admission-capacity profile)) :rule-classes :type-prescription)

(defcolumns fn2-tls-config ((enabled :bool) (window :u32) (timeout-ms :u32)))
(defun fn2-tls-config-from (profile fn2-tls-config)
  (declare (xargs :stobjs fn2-tls-config :guard (fn2-tls-profilep profile)))
  (let* ((fn2-tls-config (fn2-tls-config-init 1 fn2-tls-config))
         (window (fn2-tls-setting :tls-window 16384 profile))
         (timeout (fn2-tls-setting :tls-handshake-ms 10000 profile)))
    (fn2-tls-config-put 0
      (enabled (if (fn2-tls-requested-p profile) 1 0))
      (window (if (unsigned-byte-p 32 window) window 16384))
      (timeout-ms (if (unsigned-byte-p 32 timeout) timeout 10000)))))
(defthm fn2-tls-config-from-type
  (implies (fn2-tls-configp fn2-tls-config)
           (fn2-tls-configp (fn2-tls-config-from profile fn2-tls-config))))
(defthm fn2-tls-config-from-wfp
  (fn2-tls-config-wfp (fn2-tls-config-from profile fn2-tls-config)))
(in-theory (disable fn2-tls-config-from fn2-tls-profilep fn2-tls-admission-capacity))
(defcorechild fn2-core-tls-config fn2-tls-config
 :init (fn2-tls-config-from profile fn2-tls-config) :profilep (fn2-tls-profilep profile)
 :why "STARTTLS enablement, bounded BIO storage and handshake deadline from the supported profile.")

(defmachine fn2-tls-admit
 :phases (:free :held :draining :retired)
 :fields ((conn :link) (conn-gen :u60) (next-free :link) (stopped :bool))
 :holds ((:held :tls-slot) (:draining :tls-slot))
 :budget (:bytes 0 :steps 32 :descriptors 0)
 :capacity (fn2-tls-admission-capacity profile)
 :taken (:phase :held :rows :tls-slot :ranges () :copy (conn conn-gen) :clear (stopped))
 :initial ((generation fn2-machine-initial-generation)
           (ready-prev *fn2-none*) (ready-next *fn2-none*) (conn *fn2-none*)
           (next-free fn2-machine-initial-next-free))
 :arms ((:free) (:held) (:draining) (:retired))
 :observes ())
(defmachine-registry fn2-tls-admit)

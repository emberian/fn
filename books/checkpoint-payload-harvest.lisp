; The sole canonical payload completion observer. It records physical I/O
; completion for LIVE only; semantic source/cut admission stays in the worker.
; COLD completions are owned by boot. Ignoring a packet never finishes the op
; or drops read pins/loans: the generic operation finish path still does that.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-payload-physical")
(include-book "vocab")
(fn2-book-layer :b)
(defun fn2-checkpoint-payload-harvest (opslot opgen cell evkind outcome reason count aux0 aux1 fn2-checkpoint-payload fn2-ops)
 (declare (xargs :stobjs (fn2-checkpoint-payload fn2-ops)
 :guard (and (fn2-checkpoint-payload-wfp fn2-checkpoint-payload) (fn2-ops-wfp fn2-ops))) (ignore reason aux0 aux1))
 (b* (((unless (and (< 0 (fn2-checkpoint-payload-rows fn2-checkpoint-payload))
                    (equal (fn2-checkpoint-payload-mode 0 fn2-checkpoint-payload) *fn2-checkpoint-payload-mode-live*)
                    (equal (fn2-checkpoint-payload-pending 0 fn2-checkpoint-payload) 1)
                    (member (fn2-checkpoint-payload-phase 0 fn2-checkpoint-payload)
                     (list *fn2-checkpoint-payload-phase-wait-manifest* *fn2-checkpoint-payload-phase-wait-block*))
                    (natp opslot) (< opslot (fn2-ops-rows fn2-ops))
                    (equal opslot (fn2-checkpoint-payload-op-slot 0 fn2-checkpoint-payload))
                    (equal opgen (fn2-checkpoint-payload-op-gen 0 fn2-checkpoint-payload))
                    (equal (fn2-ops-gen opslot fn2-ops) opgen)
                    (equal (fn2-ops-kind opslot fn2-ops) *fn2-action-read*)
                    (equal cell 0) (equal evkind *fn2-event-read-result*)
                    (equal (fn2-ops-owner-kind opslot fn2-ops) (fn2-checkpoint-payload-owner-kind 0 fn2-checkpoint-payload))
                    (equal (fn2-ops-owner-slot opslot fn2-ops) (fn2-checkpoint-payload-owner-slot 0 fn2-checkpoint-payload))
                    (equal (fn2-ops-owner-gen opslot fn2-ops) (fn2-checkpoint-payload-owner-gen 0 fn2-checkpoint-payload))))
       (mv :ok fn2-checkpoint-payload))
      (manifestp (equal (fn2-checkpoint-payload-phase 0 fn2-checkpoint-payload) *fn2-checkpoint-payload-phase-wait-manifest*))
      (slot (if manifestp (fn2-checkpoint-payload-manifest-slot 0 fn2-checkpoint-payload) (fn2-checkpoint-payload-data-slot 0 fn2-checkpoint-payload)))
      (gen (if manifestp (fn2-checkpoint-payload-manifest-gen 0 fn2-checkpoint-payload) (fn2-checkpoint-payload-data-gen 0 fn2-checkpoint-payload)))
      (len (if manifestp 4096 (fn2-checkpoint-payload-block-length 0 fn2-checkpoint-payload)))
      ((unless (and (equal (fn2-ops-range-slot opslot fn2-ops) slot) (equal (fn2-ops-range-gen opslot fn2-ops) gen)
                    (equal (fn2-ops-range-off opslot fn2-ops) 0) (equal (fn2-ops-range-len opslot fn2-ops) len)))
       (mv :ok fn2-checkpoint-payload))
      ((mv & fn2-checkpoint-payload)
       (if (equal outcome *fn2-outcome-done*) (fn2-checkpoint-payload-physical-loaded count fn2-checkpoint-payload)
        (let ((fn2-checkpoint-payload (fn2-checkpoint-payload-put 0 (pending 0) (phase *fn2-checkpoint-payload-phase-uncertain*))))
         (mv :io fn2-checkpoint-payload)))))
  (mv :ok fn2-checkpoint-payload)))
(fn2-checkpoint-payload-preserves fn2-checkpoint-payload-harvest
 (opslot opgen cell evkind outcome reason count aux0 aux1 fn2-checkpoint-payload fn2-ops) :position 1
 :hyps ((fn2-checkpoint-payloadp fn2-checkpoint-payload) (fn2-checkpoint-payload-wfp fn2-checkpoint-payload) (fn2-ops-wfp fn2-ops)))
(defun fn2-checkpoint-payload-harvest-children (opslot opgen cell evkind outcome reason count aux0 aux1 fn2-checkpoint-payload fn2-ops)
 (declare (xargs :stobjs (fn2-checkpoint-payload fn2-ops) :guard (and (fn2-checkpoint-payload-wfp fn2-checkpoint-payload) (fn2-ops-wfp fn2-ops))))
 (b* (((mv code fn2-checkpoint-payload) (fn2-checkpoint-payload-harvest opslot opgen cell evkind outcome reason count aux0 aux1 fn2-checkpoint-payload fn2-ops)))
  (mv code fn2-checkpoint-payload fn2-ops)))
(fn2-fc-shape fn2-checkpoint-payload-harvest-children-shape
 (fn2-checkpoint-payload-harvest-children opslot opgen cell evkind outcome reason count aux0 aux1 fn2-checkpoint-payload fn2-ops)
 (and (fn2-checkpoint-payloadp fn2-checkpoint-payload) (fn2-checkpoint-payload-wfp fn2-checkpoint-payload) (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops))
 ((fn2-checkpoint-payload 1) (fn2-ops 2)))

; LC value layer: logical page observations, independent of LB's columns.
; Column/control/directory namespace refinement and the physical codec land in
; the dependent half; no host whole-state scan is supplied by this book.
(in-package "ACL2")
(include-book "pagestore")
(include-book "log-locator")
(include-book "log-checkpoint-total-accessors")

(defun fn-lc-headerp (header)
  (declare (xargs :guard t :verify-guards nil))
  (and (true-listp header) (equal (len header) 6)
       (equal (mbe :logic (car header) :exec (fn-lc-head header)) :lc-header)
       (true-listp (mbe :logic (cadr header) :exec (fn-lc-head (fn-lc-rest header)))) (equal (len (mbe :logic (cadr header) :exec (fn-lc-head (fn-lc-rest header)))) 5)
       (unsigned-byte-p 64 (mbe :logic (nth 2 header) :exec (fn-lc-at 2 header)))
       (booleanp (mbe :logic (nth 3 header) :exec (fn-lc-at 3 header)))
       (true-listp (mbe :logic (nth 4 header) :exec (fn-lc-at 4 header))) (true-listp (mbe :logic (nth 5 header) :exec (fn-lc-at 5 header)))))
(defun fn-lc-zero-words (n)
  (declare (xargs :guard (natp n) :verify-guards nil))
  (if (mbe :logic (zp n) :exec (not (posp n))) nil (cons 0 (fn-lc-zero-words (1- n)))))
(defun fn-lc-zero-page ()
  (declare (xargs :guard t :verify-guards nil)) (fn-lc-zero-words 2048))
(defun fn-lc-page-at (i pages)
  (declare (xargs :guard t :verify-guards nil))
  (if (< (nfix i) (len pages)) (mbe :logic (nth (nfix i) pages) :exec (fn-lc-at (nfix i) pages)) (fn-lc-zero-page)))
(defun fn-lc-observe-from (i count pages)
  (declare (xargs :guard (and (natp i) (natp count) (true-listp pages))
    :measure (nfix count) :verify-guards nil))
  (if (mbe :logic (zp count) :exec (not (posp count))) nil (cons (fn-lc-page-at i pages)
    (fn-lc-observe-from (+ 1 i) (1- count) pages))))
(defun fn-lc-observe-pages (pages count)
  (declare (xargs :guard (and (true-listp pages) (natp count)) :verify-guards nil))
  (fn-lc-observe-from 0 count pages))

(defun fn-lc-column-pages (columns)
  (declare (xargs :guard t))
  (true-list-fix columns))
(defun fn-lc-directory-pages (columns header)
  (declare (xargs :guard t :verify-guards nil))
  (declare (ignore columns))
  (mbe :logic (append (true-list-fix (nth 4 header)) (true-list-fix (nth 5 header))) :exec (fn-lc-join (true-list-fix (fn-lc-at 4 header)) (true-list-fix (fn-lc-at 5 header)))))
(defun fn-lc-pages (columns header)
  (declare (xargs :guard t :verify-guards nil))
  (cons header (mbe :logic (append (fn-lc-column-pages columns)
                       (fn-lc-directory-pages columns header)) :exec (fn-lc-join (fn-lc-column-pages columns) (fn-lc-directory-pages columns header)))))
(defun fn-lc-snapshotp (columns header)
  (declare (xargs :guard t :verify-guards nil))
  (and (true-listp columns) (fn-lc-headerp header)))
(defun fn-lc-value-dirty-from (old new i count)
  (declare (xargs :guard t :measure (nfix count) :verify-guards nil))
  (if (mbe :logic (zp count) :exec (not (posp count))) nil
    (let* ((a (fn-lc-page-at (nfix i) old))
           (b (fn-lc-page-at (nfix i) new))
           (rest (fn-lc-value-dirty-from old new (+ 1 (nfix i)) (1- count))))
      ; A newly allocated zero page changes the image's extent even though
      ; its value equals an absent page. Emit that allocation too: PGS cannot
      ; infer growth from value equality, and no zero page may disappear.
      (if (and (equal a b)
               (not (and (<= (len old) (nfix i)) (< (nfix i) (len new)))))
          rest (cons (cons (nfix i) b) rest)))))
(defun fn-lc-dirty (old old-header new new-header)
  (declare (xargs :guard t :verify-guards nil))
  (let ((a (fn-lc-pages old old-header)) (b (fn-lc-pages new new-header)))
    (fn-lc-value-dirty-from a b 0 (max (len a) (len b)))))
(defun fn-lc-changed-part (dirty lo hi)
  (declare (xargs :guard t :measure (len dirty) :verify-guards nil))
  (if (consp dirty)
      (if (and (<= (nfix lo) (nfix (mbe :logic (caar dirty) :exec (fn-lc-head (fn-lc-head dirty)))))
               (< (nfix (mbe :logic (caar dirty) :exec (fn-lc-head (fn-lc-head dirty)))) (nfix hi)))
          (cons (mbe :logic (car dirty) :exec (fn-lc-head dirty)) (fn-lc-changed-part (mbe :logic (cdr dirty) :exec (fn-lc-rest dirty)) lo hi))
        (fn-lc-changed-part (mbe :logic (cdr dirty) :exec (fn-lc-rest dirty)) lo hi))
    nil))
(defun fn-lc-dirty-column-pages (old new)
  (declare (xargs :guard t :verify-guards nil))
  (fn-lc-value-dirty-from (true-list-fix old) (true-list-fix new) 0
    (max (len (true-list-fix old)) (len (true-list-fix new)))))
(defun fn-lc-in-either-range (i lo0 hi0 lo1 hi1)
  (declare (xargs :guard t :verify-guards nil))
  (or (and (<= (nfix lo0) (nfix i)) (< (nfix i) (nfix hi0)))
      (and (<= (nfix lo1) (nfix i)) (< (nfix i) (nfix hi1)))))
(defun fn-lc-changed-in-either-range (dirty lo0 hi0 lo1 hi1)
  (declare (xargs :guard t :measure (len dirty) :verify-guards nil))
  (if (consp dirty)
      (let ((rest (fn-lc-changed-in-either-range (mbe :logic (cdr dirty) :exec (fn-lc-rest dirty)) lo0 hi0 lo1 hi1)))
        (if (fn-lc-in-either-range (mbe :logic (caar dirty) :exec (fn-lc-head (fn-lc-head dirty))) lo0 hi0 lo1 hi1)
            (cons (mbe :logic (car dirty) :exec (fn-lc-head dirty)) rest) rest))
    nil))

(defun fn-lc-table-dirty-keys (tables)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp tables) (cons (list :pgs-table (mbe :logic (car tables) :exec (fn-lc-head tables)))
                          (fn-lc-table-dirty-keys (mbe :logic (cdr tables) :exec (fn-lc-rest tables)))) nil))
(defun fn-lc-directory-run-keys (n)
  (declare (xargs :guard (natp n) :verify-guards nil))
  (if (mbe :logic (zp n) :exec (not (posp n))) nil (cons (list :pgs-directory (1- n))
                       (fn-lc-directory-run-keys (1- n)))))

(defun fn-lc-dirty-directory-structure-pages (old old-header new new-header)
  (declare (xargs :guard t :verify-guards nil))
  (let* ((dirty (fn-lc-dirty old old-header new new-header))
         (o (+ 1 (len (true-list-fix old))))
         (n (+ 1 (len (true-list-fix new)))))
    (mbe :logic (append
     (fn-lc-changed-part dirty 0 1)
     (fn-lc-changed-in-either-range dirty
       o (+ o (len (true-list-fix (nth 4 old-header))))
       n (+ n (len (true-list-fix (nth 4 new-header)))))
     ; PGS table chunks and its directory run are physical structure writes.
     ; Their logical keys are disjoint from column/control data page numbers.
     (fn-lc-table-dirty-keys (pgs-touched (pgs-dirty-lpages dirty) nil))
     (fn-lc-directory-run-keys (pgs-dir-run-pages
                              (len (fn-lc-pages new new-header))))) :exec (fn-lc-join (fn-lc-changed-part dirty 0 1) (fn-lc-join (fn-lc-changed-in-either-range dirty o (+ o (len (true-list-fix (fn-lc-at 4 old-header)))) n (+ n (len (true-list-fix (fn-lc-at 4 new-header))))) (fn-lc-join (fn-lc-table-dirty-keys (pgs-touched (pgs-dirty-lpages dirty) nil)) (fn-lc-directory-run-keys (pgs-dir-run-pages (len (fn-lc-pages new new-header))))))))))
(defun fn-lc-dirty-control-pages (old old-header new new-header)
  (declare (xargs :guard t :verify-guards nil))
  (let ((o (+ 1 (len (true-list-fix old)) (len (true-list-fix (mbe :logic (nth 4 old-header) :exec (fn-lc-at 4 old-header))))))
        (n (+ 1 (len (true-list-fix new)) (len (true-list-fix (mbe :logic (nth 4 new-header) :exec (fn-lc-at 4 new-header)))))))
    (fn-lc-changed-in-either-range (fn-lc-dirty old old-header new new-header)
      o (+ o (len (true-list-fix (mbe :logic (nth 5 old-header) :exec (fn-lc-at 5 old-header)))))
      n (+ n (len (true-list-fix (mbe :logic (nth 5 new-header) :exec (fn-lc-at 5 new-header))))))))
(defun fn-lc-dirty-directory-pages (old old-header new new-header)
  (declare (xargs :guard t :verify-guards nil))
  (union-equal (fn-lc-dirty-directory-structure-pages old old-header new new-header)
               (fn-lc-dirty-control-pages old old-header new new-header)))
(defun fn-lc-publish-plan (old old-header new header)
  (declare (xargs :guard t :verify-guards nil))
  (if (and (fn-lc-snapshotp old old-header) (fn-lc-snapshotp new header))
      (list :commit (fn-lc-dirty old old-header new header))
    '(:refused :snapshot-shape)))

(defun fn-lc-header-S (header)
  (declare (xargs :guard t :verify-guards nil)) (mbe :logic (nth 1 header) :exec (fn-lc-at 1 header)))
(defun fn-lc-header-sequence (header)
  (declare (xargs :guard t :verify-guards nil)) (nfix (mbe :logic (nth 2 (fn-lc-header-S header)) :exec (fn-lc-at 2 (fn-lc-header-S header)))))
(defun fn-lc-header-next-id (header)
  (declare (xargs :guard t :verify-guards nil)) (mbe :logic (nth 2 header) :exec (fn-lc-at 2 header)))
(defun fn-lc-header-exhaustedp (header)
  (declare (xargs :guard t :verify-guards nil)) (mbe :logic (nth 3 header) :exec (fn-lc-at 3 header)))
(defun fn-lc-header-of-open (opened)
  (declare (xargs :guard t :verify-guards nil))
  (let ((header (mbe :logic (car (nth 3 opened)) :exec (fn-lc-head (fn-lc-at 3 opened)))))
    (if (and (equal (mbe :logic (car opened) :exec (fn-lc-head opened)) :ok) (fn-lc-headerp header)) header :bad)))
(defun fn-lc-adopted-header (disk r mode)
  (declare (xargs :guard t :verify-guards nil))
  (fn-lc-header-of-open (pgs-open disk r mode)))
(defun fn-lc-selection-sequence (selection)
  (declare (xargs :guard t :verify-guards nil)) (mbe :logic (nth 1 selection) :exec (fn-lc-at 1 selection)))
(defun fn-lc-selection-S (selection)
  (declare (xargs :guard t :verify-guards nil)) (mbe :logic (nth 2 selection) :exec (fn-lc-at 2 selection)))
(defun fn-lc-selection-tail (selection)
  (declare (xargs :guard t :verify-guards nil)) (mbe :logic (nth 3 selection) :exec (fn-lc-at 3 selection)))
(defun fn-lc-seg-ids (segs)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp segs) (cons (mbe :logic (caar segs) :exec (fn-lc-head (fn-lc-head segs))) (fn-lc-seg-ids (mbe :logic (cdr segs) :exec (fn-lc-rest segs)))) nil))
(defun fn-lc-record-admission (encoded-record segment-unit)
  (declare (xargs :guard (and (true-listp encoded-record) (posp segment-unit)
                              (< segment-unit 4294967296)) :verify-guards nil))
  (if (<= (len encoded-record) segment-unit) :ok
    '(:refused :record-exceeds-segment)))
(defun fn-lc-allocate-segment (next-id exhaustedp)
  (declare (xargs :guard (and (unsigned-byte-p 64 next-id) (booleanp exhaustedp))
                  :verify-guards nil))
  (cond (exhaustedp (mv '(:refused :segment-id-exhausted) nil next-id t))
        ((equal next-id 18446744073709551615) (mv :ok next-id next-id t))
        (t (mv :ok next-id (+ 1 next-id) nil))))
(defun fn-lc-roll-segment (header segs)
  (declare (xargs :guard (fn-lc-headerp header) :verify-guards nil))
  (mv-let (answer id next-id exhaustedp)
    (fn-lc-allocate-segment (fn-lc-header-next-id header)
                            (fn-lc-header-exhaustedp header))
    (if (not (equal answer :ok)) (mv answer header segs)
      (if (member-equal id (fn-lc-seg-ids segs))
          (mv '(:refused :segment-id-in-use) header segs)
        (mv :ok (update-nth 3 exhaustedp (update-nth 2 next-id header))
            (cons (list id nil nil) segs))))))

; Source-owned bootstrap projection from the actual image compiler result.
; No native/caller capsule, installation or tariff parameter is accepted.
(in-package "ACL2")
(include-book "runtime-operation-compiled-source")
(include-book "runtime-bootstrap-source")
(include-book "allocation-epoch")
(defun fn-rbcp-request ()
 (declare (xargs :guard t))
 (mv-let (word family roles resources)
  (fn-runtime-operation-compiled-source :runtime-bootstrap)
  (declare (ignore roles))
  (let* ((capsule (fn-aec-at 1 resources))
         (installation (fn-aec-at 2 resources))
         (suffix (fn-aec-at 3 resources))
         (association (fn-aec-at 1 installation)))
   (if (and (eq word :compiled-operation-source)
             (eq (fn-aec-at 0 resources) :runtime-bootstrap-resources)
             (equal (len resources) 5)
             (fn-rbs-sourcep capsule)
             (fn-aec-installationp installation)
             (natp suffix) (<= suffix (fn-aec-at 2 installation))
             (equal association (fn-aec-at 4 capsule))
             (equal (fn-aec-at 2 installation)
                    (fn-aec-at 2 (fn-aec-at 3 capsule)))
             (equal (fn-aec-at 12 installation) (fn-aec-at 8 capsule))
             (equal (fn-aec-at 1 capsule) (fn-aec-at 2 family))
             (equal (fn-aec-at 2 capsule) (fn-aec-at 3 family))
             (equal (fn-aec-at 3 capsule) (fn-aec-at 4 family))
             (equal (fn-aec-at 4 capsule) (fn-aec-at 5 family))
             (or (and (fn-rbs-physical-sourcep capsule)
                       (fn-aec-physical-installationp installation))
                 (and (fn-rbs-request-budget-sourcep capsule)
                       (fn-aec-request-budget-installationp installation))))
       (mv :runtime-bootstrap-source-available capsule installation suffix)
     (mv :runtime-bootstrap-source-unavailable nil nil nil)))))

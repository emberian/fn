; Serialize a semantic frontier only from the real authenticated reader cut.
; A peak write does not claim page construction or root completion.
(in-package "ACL2")
(include-book "event-read-verify")
(fn2-book-layer :c)

(defun fn2-event-frontier-source-p-at-phase (phase token okind oslot ogen fn2-event-read fn2-csnapshot fn2-mk fn2-fc fn2-digests)
 (declare (xargs :stobjs (fn2-event-read fn2-csnapshot fn2-mk fn2-fc fn2-digests)
  :guard (and (fn2-event-read-wfp fn2-event-read) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-mk-wfp fn2-mk) (fn2-fc-wfp fn2-fc) (fn2-digests-wfp fn2-digests))))
 (and (fn2-csnapshot-ownerp token okind oslot ogen fn2-csnapshot)
      (equal (fn2-csnapshot-phase 0 fn2-csnapshot) phase)
      (let ((row (fn2-b-event-row (fn2-fc-rows fn2-fc))))
       (and (fn2-mk-ready row fn2-mk fn2-digests)
            (equal (fn2-mk-size row fn2-mk) (fn2-csnapshot-cut-event 0 fn2-csnapshot))
            (if (equal (fn2-csnapshot-cut-commit 0 fn2-csnapshot) 0)
                (equal (fn2-csnapshot-cut-event 0 fn2-csnapshot) 0)
              (and (fn2-event-read-ownerp-at-phase phase fn2-event-read fn2-csnapshot)
                   (equal (fn2-event-read-phase 0 fn2-event-read) *fn2-event-read-phase-complete*)
                   (equal token (fn2-event-read-token 0 fn2-event-read))
                   (equal okind (fn2-event-read-owner-kind 0 fn2-event-read))
                   (equal oslot (fn2-event-read-owner-slot 0 fn2-event-read))
                   (equal ogen (fn2-event-read-owner-gen 0 fn2-event-read))
                   (equal (fn2-event-read-checker 0 fn2-event-read) row)
                   (equal (fn2-event-read-commit 0 fn2-event-read) (fn2-csnapshot-cut-commit 0 fn2-csnapshot))
                   (equal (fn2-event-read-next-event 0 fn2-event-read) (+ 1 (fn2-csnapshot-cut-event 0 fn2-csnapshot)))))))))
(defun fn2-event-frontier-source-p (token okind oslot ogen fn2-event-read fn2-csnapshot fn2-mk fn2-fc fn2-digests)
 (declare (xargs :stobjs (fn2-event-read fn2-csnapshot fn2-mk fn2-fc fn2-digests)
  :guard (and (fn2-event-read-wfp fn2-event-read) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-mk-wfp fn2-mk) (fn2-fc-wfp fn2-fc) (fn2-digests-wfp fn2-digests))))
 (fn2-event-frontier-source-p-at-phase *fn2-csnapshot-phase-held* token okind oslot ogen fn2-event-read fn2-csnapshot fn2-mk fn2-fc fn2-digests))

(defun fn2-event-frontier-pack-peak (token level slot gen okind oslot ogen
                                    fn2-event-read fn2-csnapshot fn2-mk fn2-fc fn2-digests fn2-pool)
 (declare (xargs :stobjs (fn2-event-read fn2-csnapshot fn2-mk fn2-fc fn2-digests fn2-pool)
  :guard (and (fn2-event-read-wfp fn2-event-read) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-mk-wfp fn2-mk) (fn2-fc-wfp fn2-fc) (fn2-digests-wfp fn2-digests) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (fn2-event-frontier-source-p token okind oslot ogen fn2-event-read fn2-csnapshot fn2-mk fn2-fc fn2-digests))
       (mv :source fn2-pool))
      ((unless (and (natp level) (< level 60) (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen)
                     (eq (fn2-pool-workspace-code slot gen okind oslot ogen fn2-pool) :ok)
                     (<= (+ *fn2-event-frontier-peaks-start* (* 60 32)) (fn2-pool-cap slot fn2-pool))))
       (mv :bounds fn2-pool))
      (row (fn2-b-event-row (fn2-fc-rows fn2-fc)))
      (off (+ *fn2-event-frontier-peaks-start* (* 32 level))))
  (if (logbitp level (fn2-mk-size row fn2-mk))
      (fn2-digest-store 32 (+ (fn2-digest-slot row *fn2-mk-frontier*) level) slot gen off okind oslot ogen fn2-digests fn2-pool)
    (fn2-run-zero 32 slot gen off okind oslot ogen fn2-pool))))
(fn2-pool-preserves fn2-event-frontier-pack-peak
 (token level slot gen okind oslot ogen fn2-event-read fn2-csnapshot fn2-mk fn2-fc fn2-digests fn2-pool) :position 1)

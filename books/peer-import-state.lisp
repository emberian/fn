; Transaction-owned import snapshot metadata. Octets live in its own pool taking.
(in-package "ACL2")
(include-book "columns")
(fn2-book-layer :c)
(defcolumns fn2-peer-imports
 ((phase (:enum fn2-peer-import-phase (:idle :reading :building :declared :failed :interfered)))
  (query-incarnation :u60) (query-held :bool)
  (slot :u32) (gen :u60) (ok :u8) (os :u32) (og :u60)
  (base :u32) (hbase :u32) (receipt :bool) (name-len :u32)
  (namespace :u60)
  (profile :u8)
  (algorithm :u8)
  (lineage :u60)
  (domain :u60)
  (incarnation :u60)
  (occurrence :u60)
  (kind :u8)
  (issuer :u60)
  (position :u60) (evidence :u60) (article :u60)))

; Shared actual range source selection. The actor proves its retained G and
; schema/geometry before calling this fold; no source parser is duplicated.
(in-package "ACL2")
(include-book "range-served")
(include-book "machines-b")
(fn2-book-layer :c)
(defun fn2-run-load-range-miss (i n g schema fn2-ranges fn2-range-sources fn2-run-cursors)
 (declare (xargs :stobjs (fn2-ranges fn2-range-sources fn2-run-cursors)
 :measure (nfix (- (nfix n) (nfix i)))
 :guard (and (fn2-ranges-wfp fn2-ranges) (fn2-range-sources-wfp fn2-range-sources) (fn2-run-cursors-wfp fn2-run-cursors)
  (natp i) (natp n) (<= n *fn2-b-range-source-cursors*) (natp g) (< g (fn2-ranges-rows fn2-ranges)))))
 (if (>= (nfix i) (nfix n)) (mv :absent 0)
  (b* ((s (+ (fn2-ranges-sbase g fn2-ranges) i)) (c (+ (fn2-ranges-cbase g fn2-ranges) i))
       ((unless (and (< s (fn2-range-sources-rows fn2-range-sources)) (< c (fn2-run-cursors-rows fn2-run-cursors)))) (mv :bounds 0))
       ((when (and (equal (fn2-range-sources-kind s fn2-range-sources) *fn2-range-kind-run*)
                    (equal (fn2-range-sources-cursor s fn2-range-sources) c)
                    (equal (fn2-run-cursors-physical c fn2-run-cursors) 1)
                    (equal (fn2-run-cursors-phase c fn2-run-cursors) *fn2-run-cursor-phase-miss*)
                    (equal (fn2-run-cursors-schema c fn2-run-cursors) schema)
                    (equal (fn2-run-cursors-source-row c fn2-run-cursors) (fn2-range-sources-src s fn2-range-sources)))) (mv :ok c)))
   (fn2-run-load-range-miss (+ i 1) n g schema fn2-ranges fn2-range-sources fn2-run-cursors))))

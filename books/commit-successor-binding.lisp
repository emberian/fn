; B's exact C-binding debt. Actual C emission/terminal state supplies authority;
; no caller readiness or cancellation flag can discharge a member claim.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "successor-state")
(include-book "commit-successor-binding-state")
(fn2-book-layer :b)
(defmacro fn2-commit-successor-binding-events ()
 '(progn
 (defun fn2-commit-successor-emit-current-p (tx txgen slot gen len kind owner ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))
              (fn2-id-engine (fn2-core-id-engine fn2-core))) (yes)
   (and (fn2-successor-binder-idle-p fn2-id-engine)
        (fn2-successor-emit-claim-current-p tx txgen slot gen len kind owner ogen fn2-succ-txns)) yes))
 (defun fn2-commit-successor-member-identity-p (r tx txgen slot gen len kind owner ogen fn2-commit-member)
  (declare (xargs :stobjs fn2-commit-member :guard (fn2-commit-member-wfp fn2-commit-member)))
  (and (natp r) (< r (fn2-commit-member-rows fn2-commit-member))
       (equal tx (fn2-commit-member-bind-subject r fn2-commit-member))
       (equal txgen (fn2-commit-member-bind-generation r fn2-commit-member))
       (equal slot (fn2-commit-member-slot r fn2-commit-member))
       (equal gen (fn2-commit-member-gen r fn2-commit-member))
       (equal len (fn2-commit-member-len r fn2-commit-member))
       (equal kind (fn2-commit-member-okind r fn2-commit-member))
       (equal owner (fn2-commit-member-oslot r fn2-commit-member))
       (equal ogen (fn2-commit-member-ogen r fn2-commit-member))))

 (defun fn2-commit-successor-bind-register (batch event tx txgen slot gen len kind owner ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (if (not (and (unsigned-byte-p 32 tx) (posp txgen) (unsigned-byte-p 60 txgen)
                (fn2-commit-successor-emit-current-p tx txgen slot gen len kind owner ogen fn2-core)))
      (mv :owner fn2-core)
   (stobj-let ((fn2-commit (fn2-commit-table fn2-core))
               (fn2-commit-member (fn2-core-commit-members fn2-core))) (code fn2-commit fn2-commit-member)
    (b* (((mv found row r) (fn2-commit-successor-bind-member batch event fn2-commit fn2-commit-member))
         ((unless (and found (= (fn2-commit-phase row fn2-commit) *fn2-commit-state-collect*)
                       (= (fn2-commit-cb-wrote row fn2-commit) 0)
                       (= (fn2-commit-cb-issued row fn2-commit) 0)
                       (= (fn2-commit-member-bind-state r fn2-commit-member) *fn2-commit-bind-state-none*)
                       (equal slot (fn2-commit-member-slot r fn2-commit-member))
                       (equal gen (fn2-commit-member-gen r fn2-commit-member))
                       (equal len (fn2-commit-member-len r fn2-commit-member))
                       (equal kind (fn2-commit-member-okind r fn2-commit-member))
                       (equal owner (fn2-commit-member-oslot r fn2-commit-member))
                       (equal ogen (fn2-commit-member-ogen r fn2-commit-member))))
          (mv :owner fn2-commit fn2-commit-member))
         (pending (fn2-commit-cb-bind-pending row fn2-commit))
         ((unless (and (< pending (fn2-commit-member-count row fn2-commit))
                       (< pending *fn2-commit-members-per-batch*))) (mv :state fn2-commit fn2-commit-member))
         (fn2-commit-member (fn2-commit-member-put r (bind-state *fn2-commit-bind-state-pending*)
                             (bind-subject tx) (bind-generation txgen)))
         (fn2-commit (fn2-commit-set-cb-bind-pending row (+ 1 pending) fn2-commit)))
     (mv :ok fn2-commit fn2-commit-member)) (mv code fn2-core))))
 (fn2-core-preserves fn2-commit-successor-bind-register
  (batch event tx txgen slot gen len kind owner ogen fn2-core) :position 1 :rows nil)

 (defun fn2-commit-successor-bind-complete (batch event tx txgen slot gen len kind owner ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* ((ready (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (yes)
                (and (natp tx) (< tx (fn2-succ-txns-rows fn2-succ-txns))
                     (equal len (fn2-succ-txns-emit-len tx fn2-succ-txns))
                     (fn2-successor-bind-claim-ready-p tx txgen batch event slot gen kind owner ogen fn2-succ-txns)) yes))
       ((unless ready) (mv :owner fn2-core))
       ((mv code row fn2-core)
        (stobj-let ((fn2-commit (fn2-commit-table fn2-core))
                    (fn2-commit-member (fn2-core-commit-members fn2-core))) (code row fn2-commit fn2-commit-member)
         (b* (((mv found row r) (fn2-commit-successor-bind-member batch event fn2-commit fn2-commit-member))
              ((unless (and found (fn2-commit-successor-member-identity-p r tx txgen slot gen len kind owner ogen fn2-commit-member)))
               (mv :owner 0 fn2-commit fn2-commit-member))
              ((when (= (fn2-commit-member-bind-state r fn2-commit-member) *fn2-commit-bind-state-complete*))
               (mv :already row fn2-commit fn2-commit-member))
              ((unless (fn2-commit-successor-bind-pending-p batch event tx txgen slot gen len kind owner ogen fn2-commit fn2-commit-member))
               (mv :state row fn2-commit fn2-commit-member))
              (pending (fn2-commit-cb-bind-pending row fn2-commit))
              (fn2-commit-member (fn2-commit-member-set-bind-state r *fn2-commit-bind-state-complete* fn2-commit-member))
              (fn2-commit (fn2-commit-set-cb-bind-pending row (- pending 1) fn2-commit)))
          (mv :ok row fn2-commit fn2-commit-member)) (mv code row fn2-core)))
       (id (+ (fn2-machine-kind-base *fn2-commit-kind* fn2-core) row))
       (fn2-core (if (and (eq code :ok) (fn2-commit-idp id fn2-core))
                     (fn2-machine-wake-row id fn2-core) fn2-core)))
   (mv code fn2-core)))
 (fn2-core-preserves fn2-commit-successor-bind-complete
  (batch event tx txgen slot gen len kind owner ogen fn2-core) :position 1 :rows nil)

 ; Actual global-lock release wakes the finite declared B waiters, including
 ; an earlier DROPPING batch parked behind a later volatile binder. This is
 ; scheduling only and grants no binding, publication or cancellation authority.
 (defun fn2-commit-successor-bind-wake-waiters (fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* ((a (fn2-machine-kind-base *fn2-commit-kind* fn2-core)) (b (+ 1 a))
       (fn2-core (if (fn2-commit-idp a fn2-core) (fn2-machine-wake-row a fn2-core) fn2-core))
       (fn2-core (if (fn2-commit-idp b fn2-core) (fn2-machine-wake-row b fn2-core) fn2-core))) fn2-core))
 (fn2-core-preserves fn2-commit-successor-bind-wake-waiters (fn2-core) :rows nil :prefix "")

 (defun fn2-commit-successor-bind-cancel (batch event tx txgen slot gen len kind owner ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* ((cancelled (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (yes)
                   (fn2-successor-bind-claim-cancelled-p tx txgen batch event slot gen len kind owner ogen fn2-succ-txns) yes))
       ((unless cancelled) (mv :owner fn2-core)))
   (stobj-let ((fn2-commit (fn2-commit-table fn2-core))
               (fn2-commit-member (fn2-core-commit-members fn2-core))) (code fn2-commit fn2-commit-member)
    (b* (((mv found row r) (fn2-commit-successor-bind-member batch event fn2-commit fn2-commit-member))
         ((unless (and found (= (fn2-commit-phase row fn2-commit) *fn2-commit-state-dropping*)
                       (= (fn2-commit-cb-wrote row fn2-commit) 0)
                       (= (fn2-commit-pending row fn2-commit) 0)
                       (= (fn2-commit-cb-fence-live row fn2-commit) 0)
                       (fn2-commit-successor-member-identity-p r tx txgen slot gen len kind owner ogen fn2-commit-member)))
          (mv :owner fn2-commit fn2-commit-member))
         (state (fn2-commit-member-bind-state r fn2-commit-member))
         ((when (= state *fn2-commit-bind-state-cancelled*)) (mv :already fn2-commit fn2-commit-member))
         (pending (fn2-commit-cb-bind-pending row fn2-commit))
         ((unless (or (= state *fn2-commit-bind-state-complete*)
                       (and (= state *fn2-commit-bind-state-pending*) (posp pending))))
          (mv :state fn2-commit fn2-commit-member))
         (fn2-commit-member (fn2-commit-member-set-bind-state r *fn2-commit-bind-state-cancelled* fn2-commit-member))
         (fn2-commit (if (= state *fn2-commit-bind-state-pending*)
                         (fn2-commit-set-cb-bind-pending row (- pending 1) fn2-commit) fn2-commit)))
     (mv :ok fn2-commit fn2-commit-member)) (mv code fn2-core))))
 (fn2-core-preserves fn2-commit-successor-bind-cancel
  (batch event tx txgen slot gen len kind owner ogen fn2-core) :position 1 :rows nil)
 ))

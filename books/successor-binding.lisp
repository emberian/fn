; Actual C binding owner. B's retained member is the admission authority;
; caller integers and an idle cursor are insufficient to start construction.
(in-package "ACL2")
(include-book "machines-c-bind")
(fn2-book-layer :c)
(defun fn2-succ-binder-current-p (tx generation batch event fn2-succ-txns fn2-id-engine)
 (declare (xargs :stobjs (fn2-succ-txns fn2-id-engine)
  :guard (and (fn2-succ-txns-wfp fn2-succ-txns) (fn2-id-engine-wfp fn2-id-engine))))
 (and (natp tx) (< tx (fn2-succ-txns-rows fn2-succ-txns))
      (< 0 (fn2-id-engine-rows fn2-id-engine))
      (not (equal (fn2-id-engine-binding-phase 0 fn2-id-engine) *fn2-succ-binder-phase-idle*))
      (equal tx (fn2-id-engine-binding-tx 0 fn2-id-engine))
      (posp generation) (equal generation (fn2-id-engine-binding-generation 0 fn2-id-engine))
      (equal generation (fn2-succ-txns-generation tx fn2-succ-txns))
      (equal batch (fn2-id-engine-binding-batch 0 fn2-id-engine))
      (equal event (fn2-id-engine-binding-event 0 fn2-id-engine))
      (equal batch (fn2-succ-txns-batch tx fn2-succ-txns))
      (equal event (fn2-succ-txns-event tx fn2-succ-txns))
      (equal (fn2-succ-txns-phase tx fn2-succ-txns) *fn2-succ-phase-binding*)
      (equal (fn2-id-engine-binding-slot 0 fn2-id-engine) (fn2-succ-txns-bind-slot tx fn2-succ-txns))))
(defun fn2-succ-binder-pending-code (tx generation batch event fn2-succ-txns fn2-commit fn2-commit-member)
 (declare (xargs :stobjs (fn2-succ-txns fn2-commit fn2-commit-member)
  :guard (and (fn2-succ-txns-wfp fn2-succ-txns) (fn2-commit-wfp fn2-commit)
              (fn2-commit-member-wfp fn2-commit-member))))
 (if (not (and (natp tx) (< tx (fn2-succ-txns-rows fn2-succ-txns))
               (fn2-commit-successor-bind-pending-p batch event tx generation
                (fn2-succ-txns-emit-slot tx fn2-succ-txns) (fn2-succ-txns-emit-gen tx fn2-succ-txns)
                (fn2-succ-txns-emit-len tx fn2-succ-txns) (fn2-succ-txns-emit-kind tx fn2-succ-txns)
                (fn2-succ-txns-emit-owner tx fn2-succ-txns) (fn2-succ-txns-emit-owner-gen tx fn2-succ-txns)
                fn2-commit fn2-commit-member))) :state
  ; This is volatile PRIVATE construction, not persistence acceptance. Actual
  ; PENDING identity remains authoritative while B is DROPPING or UNCERTAIN;
  ; finishing it releases the global writer for bounded B refusal cleanup.
  :ok))
(defun fn2-succ-bind-begin (tx generation batch event budget b0 fn2-succ-txns fn2-id-engine fn2-ov-insertion fn2-commit fn2-commit-member fn2-fields)
 (declare (xargs :stobjs (fn2-succ-txns fn2-id-engine fn2-ov-insertion fn2-commit fn2-commit-member fn2-fields)
  :guard (and (fn2-succ-txns-wfp fn2-succ-txns) (fn2-id-engine-wfp fn2-id-engine)
              (fn2-ov-insertion-wfp fn2-ov-insertion) (fn2-commit-wfp fn2-commit)
              (fn2-commit-member-wfp fn2-commit-member) (fn2-fields-wfp fn2-fields))))
 (b* (((unless (and (natp budget) (< 0 budget))) (mv :yield fn2-succ-txns fn2-id-engine fn2-ov-insertion))
      ((unless (and (fn2-successor-binder-idle-p fn2-id-engine)
                    (< 0 (fn2-ov-insertion-rows fn2-ov-insertion))
                    (member (fn2-ov-insertion-phase 0 fn2-ov-insertion)
                            (list *fn2-ov-insertion-phase-idle* *fn2-ov-insertion-phase-done*))
                    (unsigned-byte-p 32 tx) (< tx (fn2-succ-txns-rows fn2-succ-txns))
                    (unsigned-byte-p 60 generation) (posp batch) (unsigned-byte-p 60 batch) (unsigned-byte-p 60 event)
                    (unsigned-byte-p 32 b0) (<= (+ b0 *fn2-idc-stride*) (fn2-fields-rows fn2-fields))
                    (fn2-successor-emit-claim-current-p tx generation
                     (fn2-succ-txns-emit-slot tx fn2-succ-txns) (fn2-succ-txns-emit-gen tx fn2-succ-txns)
                     (fn2-succ-txns-emit-len tx fn2-succ-txns) (fn2-succ-txns-emit-kind tx fn2-succ-txns)
                     (fn2-succ-txns-emit-owner tx fn2-succ-txns) (fn2-succ-txns-emit-owner-gen tx fn2-succ-txns) fn2-succ-txns)))
       (mv :state fn2-succ-txns fn2-id-engine fn2-ov-insertion))
      (pending (fn2-succ-binder-pending-code tx generation batch event fn2-succ-txns fn2-commit fn2-commit-member))
      ((unless (eq pending :ok)) (mv pending fn2-succ-txns fn2-id-engine fn2-ov-insertion))
      (fn2-id-engine (fn2-id-engine-put 0 (binding-phase *fn2-succ-binder-phase-prepare*)
       (binding-tx tx) (binding-generation generation) (binding-batch batch) (binding-event event)
       (binding-base b0) (binding-slot 0) (binding-scan 0) (binding-overlay 0)))
      (fn2-succ-txns (fn2-succ-txns-put tx (phase *fn2-succ-phase-binding*) (batch batch) (event event)
       (bind-phase *fn2-succ-bind-phase-claimed*) (bind-slot 0))))
  (mv :more fn2-succ-txns fn2-id-engine fn2-ov-insertion)))

; The family returns its seven actual mutable carriers; B tables are readonly.
(defmacro fn2-succ-binder-return (code)
 `(mv ,code fn2-succ-txns fn2-id-engine fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
(defmacro fn2-succ-binder-fault (code)
 `(let ((fn2-id-engine (fn2-id-engine-set-binding-phase 0 *fn2-succ-binder-phase-failed* fn2-id-engine)))
   (fn2-succ-binder-return ,code)))
(defun fn2-succ-bind-step (tx generation batch event budget fn2-succ-txns fn2-succ-slots fn2-id-engine fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool fn2-commit fn2-commit-member)
 (declare (xargs :stobjs (fn2-succ-txns fn2-succ-slots fn2-id-engine fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool fn2-commit fn2-commit-member)
  :guard (and (fn2-succ-txns-wfp fn2-succ-txns) (fn2-succ-slots-wfp fn2-succ-slots)
              (fn2-id-engine-wfp fn2-id-engine) (fn2-ov-insertion-wfp fn2-ov-insertion)
              (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index)
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)
              (fn2-commit-wfp fn2-commit) (fn2-commit-member-wfp fn2-commit-member))))
 (b* (((unless (and (natp budget) (< 0 budget))) (fn2-succ-binder-return :yield))
      ((unless (fn2-succ-binder-current-p tx generation batch event fn2-succ-txns fn2-id-engine))
       (fn2-succ-binder-return :state))
      (pending (fn2-succ-binder-pending-code tx generation batch event fn2-succ-txns fn2-commit fn2-commit-member))
      ((unless (eq pending :ok)) (fn2-succ-binder-return pending))
      (phase (fn2-id-engine-binding-phase 0 fn2-id-engine))
      (b0 (fn2-id-engine-binding-base 0 fn2-id-engine))
      (i (fn2-id-engine-binding-slot 0 fn2-id-engine))
      ((unless (and (<= i *fn2-succ-slots*) (<= (+ b0 *fn2-idc-stride*) (fn2-fields-rows fn2-fields))))
       (fn2-succ-binder-fault :bounds))
      ((when (equal phase *fn2-succ-binder-phase-prepare*))
       (b* (((when (= i *fn2-succ-slots*))
             (let ((fn2-id-engine (fn2-id-engine-put 0 (binding-phase *fn2-succ-binder-phase-unstage*) (binding-scan 0))))
              (fn2-succ-binder-return :more)))
            (s (+ (* tx *fn2-succ-slots*) i))
            ((unless (< s (fn2-succ-slots-rows fn2-succ-slots))) (fn2-succ-binder-fault :bounds))
            ((mv code sid fn2-id-engine fn2-overlays fn2-fields fn2-pool)
             (fn2-succ-bind-slot-prepare i s b0 batch event fn2-succ-slots fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
            ((when (eq code :skip))
             (let* ((fn2-id-engine (fn2-id-engine-set-binding-slot 0 (+ 1 i) fn2-id-engine))
                    (fn2-succ-txns (fn2-succ-txns-set-bind-slot tx (+ 1 i) fn2-succ-txns)))
              (fn2-succ-binder-return :more)))
            ((unless (eq code :ok)) (fn2-succ-binder-fault code))
            (rows (fn2-overlays-rows fn2-overlays))
            (fn2-id-engine (fn2-id-engine-put 0 (binding-phase *fn2-succ-binder-phase-target*)
             (binding-sid sid) (binding-size (fn2-succ-slots-size s fn2-succ-slots))
             (binding-target-cursor 0) (binding-best rows) (binding-spare rows)))
            (fn2-succ-txns (fn2-succ-txns-set-bind-phase tx *fn2-succ-bind-phase-slot* fn2-succ-txns)))
        (fn2-succ-binder-return :more)))
      ((when (equal phase *fn2-succ-binder-phase-target*))
       (b* ((row (fn2-id-engine-binding-target-cursor 0 fn2-id-engine))
            (rows (fn2-overlays-rows fn2-overlays))
            ((when (<= rows row))
             (let ((fn2-id-engine (fn2-id-engine-set-binding-phase 0 *fn2-succ-binder-phase-target-finish* fn2-id-engine)))
              (fn2-succ-binder-return :more)))
            (best (fn2-id-engine-binding-best 0 fn2-id-engine))
            (spare (fn2-id-engine-binding-spare 0 fn2-id-engine))
            (sid (fn2-id-engine-binding-sid 0 fn2-id-engine))
            (newer (and (= (fn2-overlays-phase row fn2-overlays) *fn2-overlay-phase-private*)
                        (= (fn2-overlays-batch row fn2-overlays) batch) (= (fn2-overlays-schema row fn2-overlays) sid)
                        (or (<= rows best) (< (fn2-overlays-seq best fn2-overlays) (fn2-overlays-seq row fn2-overlays)))))
            (first-spare (and (<= rows spare) (= (fn2-overlays-phase row fn2-overlays) *fn2-overlay-phase-spare*)))
            (fn2-id-engine (fn2-id-engine-put 0 (binding-target-cursor (+ 1 row))
             (binding-best (if newer row best)) (binding-spare (if first-spare row spare)))))
        (fn2-succ-binder-return :more)))
      ((when (equal phase *fn2-succ-binder-phase-target-finish*))
       (b* (((unless (< i *fn2-succ-slots*)) (fn2-succ-binder-fault :bounds))
            ((mv code o fn2-id-engine fn2-overlays)
             (fn2-succ-target-finish batch (fn2-id-engine-binding-sid 0 fn2-id-engine)
              (fn2-id-engine-binding-size 0 fn2-id-engine) (fn2-id-engine-binding-best 0 fn2-id-engine)
              (fn2-id-engine-binding-spare 0 fn2-id-engine) fn2-id-engine fn2-overlays))
            ((unless (eq code :ok)) (fn2-succ-binder-fault code))
            ((mv code fn2-ov-insertion)
             (fn2-ov-insert-start o (+ b0 (* *fn2-succ-block* i)) (+ b0 *fn2-idc-eb*)
              *fn2-idc-owner-kind* *fn2-idc-owner-slot* *fn2-idc-owner-gen*
              fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields))
            ((unless (eq code :more)) (fn2-succ-binder-fault code))
            (fn2-id-engine (fn2-id-engine-put 0 (binding-phase *fn2-succ-binder-phase-insert*) (binding-overlay o)))
            (fn2-succ-txns (fn2-succ-txns-set-bind-phase tx *fn2-succ-bind-phase-insert* fn2-succ-txns)))
        (fn2-succ-binder-return :more)))
      ((when (equal phase *fn2-succ-binder-phase-insert*))
       (b* (((unless (and (< i *fn2-succ-slots*) (< 0 (fn2-ov-insertion-rows fn2-ov-insertion))
                              (= (fn2-ov-insertion-overlay 0 fn2-ov-insertion) (fn2-id-engine-binding-overlay 0 fn2-id-engine))
                              (= (fn2-ov-insertion-entry-base 0 fn2-ov-insertion) (+ b0 (* *fn2-succ-block* i)))
                              (= (fn2-ov-insertion-decode-base 0 fn2-ov-insertion) (+ b0 *fn2-idc-eb*))))
             (fn2-succ-binder-fault :state))
            ((mv code fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
             (fn2-ov-insert-step budget fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
            ((when (member-eq code '(:more :yield))) (fn2-succ-binder-return code))
            ((unless (eq code :done)) (fn2-succ-binder-fault code))
            (fn2-id-engine (fn2-id-engine-put 0 (binding-phase *fn2-succ-binder-phase-prepare*) (binding-slot (+ 1 i))))
            (fn2-succ-txns (fn2-succ-txns-put tx (bind-phase *fn2-succ-bind-phase-slot*) (bind-slot (+ 1 i)))))
        (fn2-succ-binder-return :more)))
      ((when (equal phase *fn2-succ-binder-phase-unstage*))
       (b* ((row (fn2-id-engine-binding-scan 0 fn2-id-engine))
            ((when (< row (fn2-succ-txns-rows fn2-succ-txns)))
             (let* ((fn2-succ-txns
                     (if (and (not (= row tx)) (= (fn2-succ-txns-phase row fn2-succ-txns) *fn2-succ-phase-staged*))
                         (fn2-succ-txns-put row (phase *fn2-succ-phase-open*) (emit-valid 0) (emit-origin *fn2-succ-emit-origin-none*))
                       fn2-succ-txns))
                    (fn2-id-engine (fn2-id-engine-set-binding-scan 0 (+ 1 row) fn2-id-engine)))
              (fn2-succ-binder-return :more)))
            ((unless (= i *fn2-succ-slots*)) (fn2-succ-binder-fault :state))
            (fn2-succ-txns (fn2-succ-txns-put tx (phase *fn2-succ-phase-bound*)
             (bind-phase *fn2-succ-bind-phase-complete*) (bind-slot *fn2-succ-slots*)))
            (fn2-id-engine (fn2-id-engine-set-binding-phase 0 *fn2-succ-binder-phase-idle* fn2-id-engine)))
        (fn2-succ-binder-return :done))))
  (fn2-succ-binder-return :state)))
(fn2-idc-fn-shape fn2-succ-bind-begin
 (tx generation batch event budget b0 fn2-succ-txns fn2-id-engine fn2-ov-insertion fn2-commit fn2-commit-member fn2-fields)
 (fn2-succ-txns fn2-id-engine fn2-ov-insertion)
 (fn2-succ-txns fn2-id-engine fn2-ov-insertion fn2-commit fn2-commit-member fn2-fields) t
 (fn2-successor-emit-claim-current-p fn2-succ-binder-pending-code))

                    (equal (fn2-checkpoint-root1-owner-slot 0 fn2-checkpoint-root1) owner)
                    (equal (fn2-checkpoint-root1-owner-gen 0 fn2-checkpoint-root1) gen)
                    (equal (fn2-checkpoint-page-token 0 fn2-checkpoint-page) token)
                    (equal (fn2-checkpoint-page-owner-kind 0 fn2-checkpoint-page) kind)
                    (equal (fn2-checkpoint-page-owner-slot 0 fn2-checkpoint-page) owner)
                    (equal (fn2-checkpoint-page-owner-gen 0 fn2-checkpoint-page) gen)
                    (equal (fn2-checkpoint-page-phase 0 fn2-checkpoint-page) *fn2-checkpoint-page-phase-complete*)
                    (equal (fn2-checkpoint-page-pending 0 fn2-checkpoint-page) 0)
                    (equal (fn2-checkpoint-page-transferred 0 fn2-checkpoint-page) 0)))
       (mv :owner fn2-checkpoint-build fn2-checkpoint-plan fn2-checkpoint-map-build))
      (fn2-checkpoint-build (fn2-checkpoint-build-set-phase 0 *fn2-checkpoint-build-phase-idle* fn2-checkpoint-build))
      (fn2-checkpoint-plan (fn2-checkpoint-plan-set-phase 0 *fn2-checkpoint-plan-phase-idle* fn2-checkpoint-plan))
      (fn2-checkpoint-map-build (fn2-checkpoint-map-build-set-phase 0 *fn2-checkpoint-map-build-phase-idle* fn2-checkpoint-map-build)))
  (mv :ok fn2-checkpoint-build fn2-checkpoint-plan fn2-checkpoint-map-build)))

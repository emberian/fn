                    (fn2-checkpoint-plan-closedp-at-phase phase token kind owner gen fn2-checkpoint-plan fn2-csnapshot)))
       (mv :state fn2-checkpoint-build fn2-checkpoint-plan fn2-checkpoint-map-build))
      (c (fn2-checkpoint-build-candidate 0 fn2-checkpoint-build))
      ((unless (and (natp c) (< c (fn2-checkpoints-rows fn2-checkpoints))
                    (fn2-checkpoint-builder-claimp c token kind owner gen fn2-checkpoints)
                    (< 0 (fn2-checkpoints-installation-commit c fn2-checkpoints))
                    (member-equal (fn2-checkpoints-state c fn2-checkpoints)
                     (list *fn2-checkpoint-state-installed* *fn2-checkpoint-state-promoted*))
                    (equal c (fn2-checkpoint-plan-candidate 0 fn2-checkpoint-plan))
                    (equal c (fn2-checkpoint-map-build-candidate 0 fn2-checkpoint-map-build))
                    (equal token (fn2-checkpoint-map-build-token 0 fn2-checkpoint-map-build))
                    (equal kind (fn2-checkpoint-map-build-owner-kind 0 fn2-checkpoint-map-build))
                    (equal owner (fn2-checkpoint-map-build-owner-slot 0 fn2-checkpoint-map-build))
                    (equal gen (fn2-checkpoint-map-build-owner-gen 0 fn2-checkpoint-map-build))
                    (equal (fn2-checkpoint-map-build-phase 0 fn2-checkpoint-map-build) *fn2-checkpoint-map-build-phase-done*)
                    (equal (fn2-alloc-freeze-phase fn2-extents) 0)
                    (equal (fn2-alloc-freeze-token fn2-extents) token)
                    (equal (fn2-alloc-freeze-owner-kind fn2-extents) kind)
                    (equal (fn2-alloc-freeze-owner-slot fn2-extents) owner)
                    (equal (fn2-alloc-freeze-owner-gen fn2-extents) gen)
                    (equal (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication) *fn2-checkpoint-publication-phase-complete*)
                    (equal (fn2-checkpoint-publication-candidate 0 fn2-checkpoint-publication) c)
                    (equal (fn2-checkpoint-publication-bundle-released 0 fn2-checkpoint-publication) 1)
                    (equal (fn2-checkpoint-root1-phase 0 fn2-checkpoint-root1) *fn2-checkpoint-root1-phase-idle*)
                    (equal (fn2-checkpoint-root1-reserved 0 fn2-checkpoint-root1) 0)

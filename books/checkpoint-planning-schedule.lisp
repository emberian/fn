; Exact suffix identity schedule, using the production fixed-slot page counts
; and ticket fixed point. No physical completion or hash is fabricated.
(in-package "ACL2")
(include-book "checkpoint-planning")
(fn2-book-layer :c)

(defun fn2-checkpoint-planning-directory-code (fn2-checkpoint-planning fn2-csnapshot fn2-commit-root)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-csnapshot fn2-commit-root)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-commit-root-wfp fn2-commit-root))))
 (cond ((not (and (< 0 (fn2-checkpoint-planning-rows fn2-checkpoint-planning)) (< 0 (fn2-csnapshot-rows fn2-csnapshot))
                  (< 0 (fn2-commit-root-rows fn2-commit-root)))) :directory-state)
       ((not (and (equal (fn2-commit-root-proposed 0 fn2-commit-root) (fn2-checkpoint-planning-directory-proposed 0 fn2-checkpoint-planning))
                  (equal (fn2-commit-root-proposed 0 fn2-commit-root) (fn2-csnapshot-cut-commit 0 fn2-csnapshot))
                  (equal (fn2-commit-root-installed 0 fn2-commit-root) (fn2-csnapshot-cut-commit 0 fn2-csnapshot))
                  (equal (fn2-commit-root-published 0 fn2-commit-root) (fn2-csnapshot-cut-commit 0 fn2-csnapshot))
                  (equal (if (zp (fn2-commit-root-first-key 0 fn2-commit-root)) 0 (- (fn2-commit-root-first-key 0 fn2-commit-root) 1))
                         (fn2-csnapshot-cut-event 0 fn2-csnapshot)))) :directory-cut)
       (t (mv-let (status available)
           (fn2-commit-directory-headroom (fn2-checkpoint-planning-tickets 0 fn2-checkpoint-planning) fn2-commit-root)
           (declare (ignore available))
           (case status (:ok :ok) (:no-space :directory-no-space) (otherwise :directory-state))))))

(defun fn2-checkpoint-planning-directoryp (fn2-checkpoint-planning fn2-csnapshot fn2-commit-root)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-csnapshot fn2-commit-root)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-commit-root-wfp fn2-commit-root))))
 (eq (fn2-checkpoint-planning-directory-code fn2-checkpoint-planning fn2-csnapshot fn2-commit-root) :ok))

(defun fn2-checkpoint-planning-suffix-begin (c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-csnapshot fn2-extents)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (and (fn2-checkpoint-planning-ownerp c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents)
                    (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-preview*)
                    (equal (fn2-checkpoint-planning-sealed 0 fn2-checkpoint-planning) (fn2-checkpoint-planning-count 0 fn2-checkpoint-planning))
                    (posp (fn2-checkpoint-planning-count 0 fn2-checkpoint-planning)))) (mv :owner fn2-checkpoint-planning))
      (events (fn2-checkpoint-map-page-count (fn2-csnapshot-cut-commit 0 fn2-csnapshot) *fn2-event-proof-slots*))
      (maps (fn2-checkpoint-map-page-count (fn2-extents-rows fn2-extents) *fn2-checkpoint-map-slots*))
      ((unless (and (unsigned-byte-p 32 events) (unsigned-byte-p 32 maps))) (mv :bounds fn2-checkpoint-planning))
      (fn2-checkpoint-planning (fn2-checkpoint-planning-put 0 (phase *fn2-checkpoint-planning-phase-size*)
       (root1-count (fn2-checkpoint-planning-count 0 fn2-checkpoint-planning)) (event-pages events) (map-pages maps)
       (tickets 1) (arena-pages 1) (schedule 0) (suffix-role 3) (suffix-ordinal (- events 1)))))
  (mv :ok fn2-checkpoint-planning)))

(defun fn2-checkpoint-planning-size-step (c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents fn2-commit-root)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-csnapshot fn2-extents fn2-commit-root)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-extents-wfp fn2-extents) (fn2-commit-root-wfp fn2-commit-root))))
 (b* (((unless (and (fn2-checkpoint-planning-ownerp c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents)
                    (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-size*)
                    (< 0 (fn2-commit-root-rows fn2-commit-root)))) (mv :owner fn2-checkpoint-planning))
      (base (+ 1 (fn2-checkpoint-planning-root1-count 0 fn2-checkpoint-planning) (fn2-checkpoint-planning-event-pages 0 fn2-checkpoint-planning) 1))
      (maps (fn2-checkpoint-planning-map-pages 0 fn2-checkpoint-planning))
      (tickets (fn2-checkpoint-planning-tickets 0 fn2-checkpoint-planning))
      (next (fn2-checkpoint-ticket-demand base maps tickets))
      (arena (fn2-checkpoint-map-page-count next *fn2-checkpoint-arena-slots*))
      (need (+ (- base 1) maps arena next))
      ((unless (and (<= tickets next) (<= next (fn2-extents-rows fn2-extents)) (unsigned-byte-p 32 next) (unsigned-byte-p 32 arena)
                    (<= need (fn2-alloc-total-free fn2-extents)))) (mv :no-space fn2-checkpoint-planning))
      (fixed (equal tickets next))
      (fn2-checkpoint-planning (fn2-checkpoint-planning-put 0 (tickets next) (arena-pages arena)
       (directory-proposed (fn2-csnapshot-cut-commit 0 fn2-csnapshot))))
      (directory (fn2-checkpoint-planning-directory-code fn2-checkpoint-planning fn2-csnapshot fn2-commit-root))
      ((unless (eq directory :ok)) (mv directory fn2-checkpoint-planning))
      (fn2-checkpoint-planning (if fixed (fn2-checkpoint-planning-set-phase 0 *fn2-checkpoint-planning-phase-append* fn2-checkpoint-planning) fn2-checkpoint-planning)))
  (mv (if fixed :sized :more) fn2-checkpoint-planning)))

(defun fn2-checkpoint-planning-role-kind (role)
 (declare (xargs :guard (natp role)))
 (case role (2 *page-kind-allocation-map*) (3 *page-kind-manifest*) (4 *page-kind-merkle-node*) (5 *page-kind-recovery-arena*) (otherwise 0)))
(defun fn2-checkpoint-planning-role-count (role fn2-checkpoint-planning)
 (declare (xargs :stobjs fn2-checkpoint-planning :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (< 0 (fn2-checkpoint-planning-rows fn2-checkpoint-planning)))))
 (case role (2 (fn2-checkpoint-planning-map-pages 0 fn2-checkpoint-planning)) (3 (fn2-checkpoint-planning-event-pages 0 fn2-checkpoint-planning))
            (4 1) (5 (fn2-checkpoint-planning-arena-pages 0 fn2-checkpoint-planning)) (6 (fn2-checkpoint-planning-tickets 0 fn2-checkpoint-planning)) (otherwise 0)))

(defun fn2-checkpoint-planning-append-step (c token kind owner gen fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents fn2-commit-root)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents fn2-commit-root)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-checkpoint-recipe-wfp fn2-checkpoint-recipe)
              (fn2-checkpoint-recipe-order-wfp fn2-checkpoint-recipe-order) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extents-wfp fn2-extents) (fn2-commit-root-wfp fn2-commit-root))))
 (b* (((unless (and (fn2-checkpoint-planning-ownerp c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents)
                    (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-append*)))
       (mv :owner fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order))
      (directory (fn2-checkpoint-planning-directory-code fn2-checkpoint-planning fn2-csnapshot fn2-commit-root))
      ((unless (eq directory :ok)) (mv directory fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order))
      (role (fn2-checkpoint-planning-suffix-role 0 fn2-checkpoint-planning)) (ordinal (fn2-checkpoint-planning-suffix-ordinal 0 fn2-checkpoint-planning))
      (pages (fn2-checkpoint-planning-role-count role fn2-checkpoint-planning))
      ((unless (and (member-equal role '(2 3 4 5 6)) (posp pages) (< ordinal pages)))
       (mv :bounds fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order))
      ((mv code & & & fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order)
       (fn2-checkpoint-planning-preview c token kind owner gen role ordinal
        (if (equal role 6) (* *fn2-commit-unit-bytes* *fn2-commit-write-resources*) *fn2-format-page-size*)
        (fn2-checkpoint-planning-role-kind role) 0 fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents))
      ((unless (eq code :ok)) (mv code fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order))
      (last (if (equal role 3) (equal ordinal 0) (equal (+ ordinal 1) pages)))
      (next-role (case role (3 4) (4 2) (2 5) (otherwise 6)))
      (done (and last (equal role 6)))
      (fn2-checkpoint-planning (fn2-checkpoint-planning-put 0
       (phase (if done *fn2-checkpoint-planning-phase-planned* *fn2-checkpoint-planning-phase-append*))
       (schedule (if done 1 0)) (suffix-role (if last next-role role))
       (suffix-ordinal (if last 0 (if (equal role 3) (- ordinal 1) (+ ordinal 1)))))))
  (mv (if done :planned :more) fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order)))

; The descriptor is reserved by the actual build BEGIN before preview; it is
; counted once without pretending its body has been produced or installed.
(defun fn2-checkpoint-planning-descriptorp (c token kind owner gen fn2-checkpoint-build fn2-checkpoint-construction fn2-csnapshot fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-build fn2-checkpoint-construction fn2-csnapshot fn2-extents)
  :guard (and (fn2-checkpoint-build-wfp fn2-checkpoint-build) (fn2-checkpoint-construction-wfp fn2-checkpoint-construction)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extents-wfp fn2-extents))))
 (and (fn2-checkpoint-build-ownerp token kind owner gen fn2-checkpoint-build fn2-csnapshot)
      (equal c (fn2-checkpoint-build-candidate 0 fn2-checkpoint-build))
      (equal (fn2-checkpoint-build-phase 0 fn2-checkpoint-build) *fn2-checkpoint-build-phase-await-roots*)
      (let ((e (fn2-checkpoint-build-extent 0 fn2-checkpoint-build)))
       (and (< e (fn2-checkpoint-construction-rows fn2-checkpoint-construction)) (fn2-alloc-slotp e fn2-extents)
            (equal (fn2-checkpoint-construction-live e fn2-checkpoint-construction) 1)
            (equal token (fn2-checkpoint-construction-token e fn2-checkpoint-construction))
            (equal kind (fn2-checkpoint-construction-owner-kind e fn2-checkpoint-construction))
            (equal owner (fn2-checkpoint-construction-owner-slot e fn2-checkpoint-construction))
            (equal gen (fn2-checkpoint-construction-owner-gen e fn2-checkpoint-construction))
            (equal (fn2-checkpoint-construction-role e fn2-checkpoint-construction) 0)
            (equal (fn2-checkpoint-construction-ordinal e fn2-checkpoint-construction) 0)
            (equal (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction) 4096)
            (equal (fn2-checkpoint-construction-completed-bytes e fn2-checkpoint-construction) 0)
            (equal (fn2-checkpoint-construction-ticket-claimed e fn2-checkpoint-construction) 0)
            (equal (fn2-checkpoint-construction-epoch e fn2-checkpoint-construction) (fn2-checkpoint-build-epoch 0 fn2-checkpoint-build))
            (equal (fn2-checkpoint-construction-counter e fn2-checkpoint-construction) (fn2-checkpoint-build-allocation 0 fn2-checkpoint-build))
            (eq (fn2-alloc-handle-code e (fn2-checkpoint-build-epoch 0 fn2-checkpoint-build) (fn2-checkpoint-build-allocation 0 fn2-checkpoint-build) fn2-extents) :ok)
            (equal (fn2-extents-state e fn2-extents) *fn2-extent-state-reserved*)))))

(defun fn2-checkpoint-planning-materialize-full (c token kind owner gen fn2-checkpoint-planning fn2-checkpoint-build fn2-checkpoint-construction fn2-csnapshot fn2-extents fn2-commit-root)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-checkpoint-build fn2-checkpoint-construction fn2-csnapshot fn2-extents fn2-commit-root)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-checkpoint-build-wfp fn2-checkpoint-build)
              (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-extents-wfp fn2-extents) (fn2-commit-root-wfp fn2-commit-root))))
 (cond ((not (and (fn2-checkpoint-planning-ownerp c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents)
                  (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-planned*)
                  (equal (fn2-checkpoint-planning-schedule 0 fn2-checkpoint-planning) 1)
                  (equal (fn2-checkpoint-planning-count 0 fn2-checkpoint-planning)
                   (+ (fn2-checkpoint-planning-root1-count 0 fn2-checkpoint-planning) (fn2-checkpoint-planning-event-pages 0 fn2-checkpoint-planning) 1
                      (fn2-checkpoint-planning-map-pages 0 fn2-checkpoint-planning) (fn2-checkpoint-planning-arena-pages 0 fn2-checkpoint-planning)
                      (fn2-checkpoint-planning-tickets 0 fn2-checkpoint-planning))))) (mv :schedule fn2-checkpoint-planning))
       ((not (fn2-checkpoint-planning-descriptorp c token kind owner gen fn2-checkpoint-build fn2-checkpoint-construction fn2-csnapshot fn2-extents)) (mv :descriptor fn2-checkpoint-planning))
       ((not (fn2-checkpoint-planning-directoryp fn2-checkpoint-planning fn2-csnapshot fn2-commit-root))
        (mv (fn2-checkpoint-planning-directory-code fn2-checkpoint-planning fn2-csnapshot fn2-commit-root) fn2-checkpoint-planning))
       (t (fn2-checkpoint-planning-materialize c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents))))

(defun fn2-checkpoint-planning-consumedp (c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents fn2-commit-root)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-csnapshot fn2-extents fn2-commit-root)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-extents-wfp fn2-extents) (fn2-commit-root-wfp fn2-commit-root))))
 (and (fn2-checkpoint-planning-root1-consumedp c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents)
      (fn2-checkpoint-planning-directoryp fn2-checkpoint-planning fn2-csnapshot fn2-commit-root)
      (equal (fn2-checkpoint-planning-position 0 fn2-checkpoint-planning) (fn2-checkpoint-planning-count 0 fn2-checkpoint-planning))
      (equal (fn2-checkpoint-planning-reserved 0 fn2-checkpoint-planning) (fn2-checkpoint-planning-count 0 fn2-checkpoint-planning))
      (equal (fn2-alloc-free-head fn2-extents) (fn2-checkpoint-planning-next-free 0 fn2-checkpoint-planning))
      (equal (fn2-alloc-next-counter fn2-extents) (+ (fn2-checkpoint-planning-first-counter 0 fn2-checkpoint-planning) (fn2-checkpoint-planning-count 0 fn2-checkpoint-planning)))))

(fn2-checkpoint-planning-preserves fn2-checkpoint-planning-suffix-begin
 (c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents) :position 1)
(fn2-checkpoint-planning-preserves fn2-checkpoint-planning-size-step
 (c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents fn2-commit-root) :position 1)
(fn2-checkpoint-planning-preserves fn2-checkpoint-planning-append-step
 (c token kind owner gen fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents fn2-commit-root)
 :carriers ((fn2-checkpoint-planning 1 :prefix "-PLANNING") (fn2-checkpoint-recipe 2 :prefix "-RECIPE") (fn2-checkpoint-recipe-order 3 :prefix "-ORDER")))
(fn2-checkpoint-planning-preserves fn2-checkpoint-planning-materialize-full
 (c token kind owner gen fn2-checkpoint-planning fn2-checkpoint-build fn2-checkpoint-construction fn2-csnapshot fn2-extents fn2-commit-root) :position 1)

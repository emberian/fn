; Sole actual catalog-to-hold initialization, called only after the
; cold or live constructor has established its own physical source authority.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-cbase-identity")
(fn2-book-layer :c)
(defun fn2-checkpoint-cbase-start (r fn2-checkpoint-summary fn2-ops fn2-checkpoints fn2-extents fn2-checkpoint-cbase-holds)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-ops fn2-checkpoints fn2-extents fn2-checkpoint-cbase-holds) :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-ops-wfp fn2-ops) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-extents-wfp fn2-extents) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds))))
 (b* (((unless (and (natp r) (< r 2) (< r (fn2-checkpoint-summary-rows fn2-checkpoint-summary))
                    (posp (fn2-checkpoint-summary-tag r fn2-checkpoint-summary))
                    (posp (fn2-extents-rows fn2-extents)))) (mv :source fn2-checkpoint-cbase-holds))
      (c (fn2-checkpoint-summary-candidate r fn2-checkpoint-summary))
      (tag (fn2-checkpoint-summary-tag r fn2-checkpoint-summary))
      (n (fn2-extents-rows fn2-extents))
      (base (fn2-checkpoint-cbase-edge c 0 fn2-extents fn2-ops fn2-checkpoints))
      ((unless (and (unsigned-byte-p 32 base)
                    (fn2-checkpoint-cbase-catalog-available-p c tag fn2-checkpoint-cbase-holds)))
       (mv :retained fn2-checkpoint-cbase-holds)))
  (let ((fn2-checkpoint-cbase-holds (fn2-checkpoint-cbase-holds-put c
              (phase *fn2-checkpoint-cbase-phase-acquiring*) (tag tag)
              (checkpoint (fn2-checkpoint-summary-checkpoint r fn2-checkpoint-summary))
              (cut-commit (fn2-checkpoint-summary-cut-commit r fn2-checkpoint-summary))
              (cut-event (fn2-checkpoint-summary-cut-event r fn2-checkpoint-summary))
              (history (fn2-checkpoint-summary-history r fn2-checkpoint-summary))
              (incarnation (fn2-checkpoint-summary-incarnation r fn2-checkpoint-summary))
              (generation (fn2-checkpoint-summary-generation r fn2-checkpoint-summary))
              (owner-kind (fn2-checkpoint-summary-owner-kind r fn2-checkpoint-summary))
              (owner-slot (fn2-checkpoint-summary-owner-slot r fn2-checkpoint-summary))
              (owner-gen (fn2-checkpoint-summary-owner-gen r fn2-checkpoint-summary))
              (limit n) (cursor 0) (seen 0) (edge-base base)
              (run-limit 0) (run-cursor 0) (drain-started 0)
              (hash-0 (fn2-checkpoint-summary-descriptor-word r 0 fn2-checkpoint-summary))
              (hash-1 (fn2-checkpoint-summary-descriptor-word r 1 fn2-checkpoint-summary))
              (hash-2 (fn2-checkpoint-summary-descriptor-word r 2 fn2-checkpoint-summary))
              (hash-3 (fn2-checkpoint-summary-descriptor-word r 3 fn2-checkpoint-summary))
              (hash-4 (fn2-checkpoint-summary-descriptor-word r 4 fn2-checkpoint-summary))
              (hash-5 (fn2-checkpoint-summary-descriptor-word r 5 fn2-checkpoint-summary))
              (hash-6 (fn2-checkpoint-summary-descriptor-word r 6 fn2-checkpoint-summary))
              (hash-7 (fn2-checkpoint-summary-descriptor-word r 7 fn2-checkpoint-summary)))))
        (mv :more fn2-checkpoint-cbase-holds))))

(fn2-checkpoint-cbase-holds-preserves fn2-checkpoint-cbase-start
 (r fn2-checkpoint-summary fn2-ops fn2-checkpoints fn2-extents fn2-checkpoint-cbase-holds)
 :hyps ((fn2-checkpoint-summaryp fn2-checkpoint-summary) (fn2-checkpoint-summary-wfp fn2-checkpoint-summary)
        (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops)
        (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints)
        (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents)
        (fn2-checkpoint-cbase-holdsp fn2-checkpoint-cbase-holds) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds)) :position 1)

      ((unless (and (< e (fn2-checkpoint-restore-map-rows fn2-checkpoint-restore-map))
                     (< seen count) (unsigned-byte-p 32 (+ seen 1))
                     (equal (fn2-checkpoint-restore-map-present e fn2-checkpoint-restore-map) 1)

; LC physical-tail model. Framing reuses the project's one frame grammar;
; ordinary/batch decisions reuse the existing log decoder. A MOVE carries
; original sequence, wire length, wire octets and unchanged home bytes.
; The decoded :move event changes a locator, never adds an acceptance.
(in-package "ACL2")
(include-book "log-checkpoint-values")
(include-book "store-log-entry-bound")
(include-book "records")

(defconst *fn-lc-move-kind* 4)
(defun fn-lc-entry-octets-bound (max)
  (declare (xargs :guard t :verify-guards nil))
  (max (+ *fn-frame-overhead-octets* (nfix max)) (fn-lg-batch-entry-bound)))
(defun fn-lc-tail-unit (header)
  (declare (xargs :guard t :verify-guards nil))
  (let ((policy (mbe :logic (car (nth 5 header)) :exec (fn-lc-head (fn-lc-at 5 header)))))
    (if (and (equal (mbe :logic (car policy) :exec (fn-lc-head policy)) :lc-tail-policy) (posp (mbe :logic (nth 1 policy) :exec (fn-lc-at 1 policy))))
        (mbe :logic (nth 1 policy) :exec (fn-lc-at 1 policy)) 1)))
(defun fn-lc-tail-max (header)
  (declare (xargs :guard t :verify-guards nil))
  (let ((policy (mbe :logic (car (nth 5 header)) :exec (fn-lc-head (fn-lc-at 5 header)))))
    (if (and (equal (mbe :logic (car policy) :exec (fn-lc-head policy)) :lc-tail-policy) (natp (mbe :logic (nth 2 policy) :exec (fn-lc-at 2 policy))))
        (mbe :logic (nth 2 policy) :exec (fn-lc-at 2 policy)) *fn-lg-batch-payload-max*)))
(defun fn-lc-move-frame (prev sequence wire home)
  (declare (xargs :guard (and (unsigned-byte-p 64 sequence)
                              (true-listp wire) (true-listp home))
                  :verify-guards nil))
  (mbe :logic (fn-frame-seal *fn-lg-magic* *fn-lg-version* *fn-lc-move-kind*
    (mbe :logic (append prev (fn-cbor-u64-bytes sequence) (fn-cbor-u32-bytes (len wire)) wire home) :exec (fn-lc-join prev (fn-lc-join (fn-cbor-u64-bytes sequence) (fn-lc-join (fn-cbor-u32-bytes (len wire)) (fn-lc-join wire home)))))) :exec (ec-call (fn-frame-seal *fn-lg-magic* *fn-lg-version* *fn-lc-move-kind* (fn-lc-join prev (fn-lc-join (fn-cbor-u64-bytes sequence) (fn-lc-join (ec-call (fn-cbor-u32-bytes (len wire))) (fn-lc-join wire home))))))))
(defun fn-lc-move-framep (frame prev max)
  (declare (xargs :guard t :verify-guards nil))
  (let* ((opened (mbe :logic (fn-frame-open frame max) :exec (ec-call (fn-frame-open frame max))))
         (payload (fn-frame-result-payload opened))
         (body (mbe :logic (nthcdr *fn-frame-trailer-octets* payload) :exec (fn-lc-drop *fn-frame-trailer-octets* payload))))
    (and (fn-frame-result-okp opened)
         (equal (fn-frame-result-magic opened) *fn-lg-magic*)
         (equal (fn-frame-result-version opened) *fn-lg-version*)
         (equal (fn-frame-result-kind opened) *fn-lc-move-kind*)
         (equal (mbe :logic (take *fn-frame-trailer-octets* payload) :exec (fn-lc-take *fn-frame-trailer-octets* payload)) prev)
         (<= 12 (len body))
         (<= (+ 12 (nfix (mbe :logic (fn-cbor-u32-from (mbe :logic (take 4 (nthcdr 8 body)) :exec (fn-lc-take 4 (fn-lc-drop 8 body)))) :exec (ec-call (fn-cbor-u32-from (fn-lc-take 4 (fn-lc-drop 8 body))))))) (len body)))))

(defun fn-lc-move-event (frame max)
  (declare (xargs :guard t :verify-guards nil))
  (let* ((opened (mbe :logic (fn-frame-open frame max) :exec (ec-call (fn-frame-open frame max))))
         (body (mbe :logic (nthcdr *fn-frame-trailer-octets* (fn-frame-result-payload opened)) :exec (fn-lc-drop *fn-frame-trailer-octets* (fn-frame-result-payload opened))))
         (n (nfix (mbe :logic (fn-cbor-u32-from (mbe :logic (take 4 (nthcdr 8 body)) :exec (fn-lc-take 4 (fn-lc-drop 8 body)))) :exec (ec-call (fn-cbor-u32-from (fn-lc-take 4 (fn-lc-drop 8 body))))))))
    (list :move (mbe :logic (fn-cbor-u64-from (mbe :logic (take 8 body) :exec (fn-lc-take 8 body))) :exec (ec-call (fn-cbor-u64-from (fn-lc-take 8 body))))
          (mbe :logic (take n (nthcdr 12 body)) :exec (fn-lc-take n (fn-lc-drop 12 body))) (mbe :logic (nthcdr (+ 12 n) body) :exec (fn-lc-drop (+ 12 n) body)))))

; Scan result: (STATUS RAW-RECORDS REQUESTED-ENTRY-OCTETS LAST-TRAILER).
; The fuel bounds model recursion; each read is admitted by its header's
; length before the slice is taken. Terminal/torn requests are charged.
(defun fn-lc-scan-bytes (bytes prev unit max fuel)
  (declare (xargs :guard t :verify-guards nil :measure (nfix fuel)))
  (if (or (atom bytes) (mbe :logic (zp fuel) :exec (not (posp fuel)))) (list :ok nil nil prev)
    (let* ((n (mbe :logic (fn-lg-declared-len bytes) :exec (ec-call (fn-lg-declared-len bytes))))
           (bounded (and (natp n) (posp n) (<= n (len bytes))
                         (<= n (fn-lc-entry-octets-bound max))))
           (frame (and bounded (mbe :logic (take n bytes) :exec (fn-lc-take n bytes))))
           (move (and bounded (fn-lc-move-framep frame prev max)))
           ; Rotation belongs to the old log layout. LC rollover adds an empty
           ; segment; every tail extension goes through fn-lc-commit.
           (ordinary (and bounded (not move)
                          (not (equal (mbe :logic (nth 5 frame) :exec (fn-lc-at 5 frame)) *fn-lg-rotation-kind*))
                          (mbe :logic (fn-lg-entry-okp frame prev max) :exec (ec-call (fn-lg-entry-okp frame prev max))))))
      (if (not (or move ordinary))
          (list :terminal nil (list (if bounded n (min (len bytes) *fn-frame-header-octets*))) prev)
        (let* ((step (+ n (fn-lg-pad-len n unit)))
               (rest (fn-lc-scan-bytes (mbe :logic (nthcdr step bytes) :exec (fn-lc-drop step bytes)) (fn-lg-trailer frame)
                                      unit max (1- (nfix fuel)))))
          (list (mbe :logic (car rest) :exec (fn-lc-head rest))
                (mbe :logic (append (if move (list (fn-lc-move-event frame max))
                          (fn-lg-slice-records frame max)) (nth 1 rest)) :exec (fn-lc-join (if move (list (fn-lc-move-event frame max)) (ec-call (fn-lg-slice-records frame max))) (fn-lc-at 1 rest)))
                (cons n (mbe :logic (nth 2 rest) :exec (fn-lc-at 2 rest))) (mbe :logic (nth 3 rest) :exec (fn-lc-at 3 rest))))))))
(defun fn-lc-insert-segment (segment segs)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp segs)
      (if (< (nfix (mbe :logic (car segment) :exec (fn-lc-head segment))) (nfix (mbe :logic (caar segs) :exec (fn-lc-head (fn-lc-head segs))))) (cons segment segs)
        (cons (mbe :logic (car segs) :exec (fn-lc-head segs)) (fn-lc-insert-segment segment (mbe :logic (cdr segs) :exec (fn-lc-rest segs)))))
    (list segment)))
(defun fn-lc-ordered-segments (segs)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp segs) (fn-lc-insert-segment (mbe :logic (car segs) :exec (fn-lc-head segs)) (fn-lc-ordered-segments (mbe :logic (cdr segs) :exec (fn-lc-rest segs)))) nil))
(defun fn-lc-scan-segments (segs segment offset prev unit max)
  (declare (xargs :guard t :verify-guards nil :measure (acl2-count segs)))
  (if (atom segs) (list :ok nil nil prev)
    (if (< (nfix (mbe :logic (caar segs) :exec (fn-lc-head (fn-lc-head segs)))) (nfix segment))
        (fn-lc-scan-segments (mbe :logic (cdr segs) :exec (fn-lc-rest segs)) segment offset prev unit max)
      (let* ((bytes (if (equal (mbe :logic (caar segs) :exec (fn-lc-head (fn-lc-head segs))) segment) (mbe :logic (nthcdr (nfix offset) (cadar segs)) :exec (fn-lc-drop (nfix offset) (fn-lc-head (fn-lc-rest (fn-lc-head segs))))) (mbe :logic (cadar segs) :exec (fn-lc-head (fn-lc-rest (fn-lc-head segs))))))
             (one (fn-lc-scan-bytes bytes prev unit max (len bytes))))
        (if (not (equal (mbe :logic (car one) :exec (fn-lc-head one)) :ok)) one
          (let ((rest (fn-lc-scan-segments (mbe :logic (cdr segs) :exec (fn-lc-rest segs)) segment 0 (mbe :logic (nth 3 one) :exec (fn-lc-at 3 one)) unit max)))
            (list (mbe :logic (car rest) :exec (fn-lc-head rest)) (mbe :logic (append (nth 1 one) (nth 1 rest)) :exec (fn-lc-join (fn-lc-at 1 one) (fn-lc-at 1 rest)))
                  (mbe :logic (append (nth 2 one) (nth 2 rest)) :exec (fn-lc-join (fn-lc-at 2 one) (fn-lc-at 2 rest))) (mbe :logic (nth 3 rest) :exec (fn-lc-at 3 rest)))))))))
(defun fn-lc-tail-scan (segs header)
  (declare (xargs :guard t :verify-guards nil))
  (let ((s (fn-lc-header-S header)))
    (fn-lc-scan-segments (fn-lc-ordered-segments segs) (mbe :logic (nth 0 s) :exec (fn-lc-at 0 s)) (mbe :logic (nth 1 s) :exec (fn-lc-at 1 s)) (mbe :logic (nth 4 s) :exec (fn-lc-at 4 s))
                         (fn-lc-tail-unit header) (fn-lc-tail-max header))))
(defun fn-lc-decode-tail-records (records)
  (declare (xargs :guard t :verify-guards nil))
  (if (atom records) nil
    (if (equal (mbe :logic (caar records) :exec (fn-lc-head (fn-lc-head records))) :move)
        (let ((rest (fn-lc-decode-tail-records (mbe :logic (cdr records) :exec (fn-lc-rest records)))))
          (if (equal rest :bad) :bad (cons (mbe :logic (car records) :exec (fn-lc-head records)) rest)))
      (let* ((frame (mbe :logic (fn-frame-store-decode (mbe :logic (car records) :exec (fn-lc-head records))
                    (fn-frame-digest (fn-frame-protected-prefix (mbe :logic (car records) :exec (fn-lc-head records))))) :exec (ec-call (fn-frame-store-decode (fn-lc-head records) (fn-frame-digest (ec-call (fn-frame-protected-prefix (fn-lc-head records))))))))
           (record (fn-record-decode-exact-impl (fn-frame-result-payload frame)))
           (rest (fn-lc-decode-tail-records (mbe :logic (cdr records) :exec (fn-lc-rest records)))))
      (if (and (fn-frame-result-okp frame) (fn-record-parse-okp record) (not (equal rest :bad)))
          (cons (fn-record-parse-value record) rest) :bad)))))
(defun fn-lc-tail-history (segs header)
  (declare (xargs :guard t :verify-guards nil))
  (fn-lc-decode-tail-records (mbe :logic (nth 1 (fn-lc-tail-scan segs header)) :exec (fn-lc-at 1 (fn-lc-tail-scan segs header)))))
(defun fn-lc-segs-retain (segs header)
  (declare (xargs :guard t :verify-guards nil))
  (let ((s (fn-lc-header-S header)) (scan (fn-lc-tail-scan segs header)))
    (and (fn-lc-headerp header) (mbe :logic (assoc-equal (mbe :logic (nth 0 s) :exec (fn-lc-at 0 s)) segs) :exec (fn-lc-assoc (fn-lc-at 0 s) segs))
         (natp (mbe :logic (nth 1 s) :exec (fn-lc-at 1 s))) (natp (mbe :logic (nth 2 s) :exec (fn-lc-at 2 s)))
         (member-equal (mbe :logic (car scan) :exec (fn-lc-head scan)) '(:ok :terminal))
         (not (equal (fn-lc-decode-tail-records (mbe :logic (nth 1 scan) :exec (fn-lc-at 1 scan))) :bad)))))
(defun fn-lc-open-selection (disk r mode count segs header)
  (declare (xargs :guard t :verify-guards nil))
  (let ((opened (pgs-open disk r mode)))
    (if (and (equal (mbe :logic (car opened) :exec (fn-lc-head opened)) :ok) (natp count)
             (equal header (fn-lc-header-of-open opened))
             (<= (fn-lc-header-sequence header) count) (fn-lc-segs-retain segs header))
        (list :checkpoint (fn-lc-header-sequence header) (fn-lc-header-S header)
              (fn-lc-tail-history segs header) header)
      '(:refused :checkpoint-tail))))
(defun fn-lc-tail-entries (disk r mode segs)
  (declare (xargs :guard t :verify-guards nil))
  (mbe :logic (nth 2 (fn-lc-tail-scan segs (fn-lc-adopted-header disk r mode))) :exec (fn-lc-at 2 (fn-lc-tail-scan segs (fn-lc-adopted-header disk r mode)))))
(defun fn-lc-tail-octets (entries)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp entries) (+ (nfix (mbe :logic (car entries) :exec (fn-lc-head entries))) (fn-lc-tail-octets (mbe :logic (cdr entries) :exec (fn-lc-rest entries)))) 0))

; Local receiver receipt journal replay. Framing/checksum is a host boundary;
; all request, Store, policy, and receipt decisions are made by fn-bpr.
(in-package "ACL2")
(include-book "bp-receipt")
; codecs withdrew the record and cbor proof vocabularies at export (2026-09-19);
; this book reasons under them, so open them here, locally.
(local (in-theory (enable fn-record-record-vocabulary fn-record-codec-vocabulary fn-record-guard-vocabulary
                          fn-record-invariants-vocabulary fn-cbor-record-vocabulary
                          fn-cbor-codec-vocabulary fn-cbor-invariants-vocabulary)))

(defun fn-bprr-nth (n x)
 (declare (xargs :guard t :measure (nfix n)))
 (if (not (and (integerp n) (< 0 n))) (if (consp x) (car x) nil)
  (fn-bprr-nth (1- n) (if (consp x) (cdr x) nil))))
(defun fn-bprr-textp (x)
 (declare (xargs :guard t :verify-guards nil)) (and (stringp x) (< 0 (length x)) (<= (length x) 512)))
(defun fn-bprr-configp (r)
 (declare (xargs :guard t :verify-guards nil))
 (and (true-listp r) (equal (len r) 4) (equal (car r) :config)
  (fn-bprr-textp (fn-bprr-nth 1 r)) (fn-bprr-textp (fn-bprr-nth 2 r))
  (fn-bprr-textp (fn-bprr-nth 3 r))))
(defun fn-bprr-config (r)
 (declare (xargs :guard t :verify-guards nil))
 (fn-bpr-make-config (fn-bprr-nth 1 r) (fn-bprr-nth 2 r) (fn-bprr-nth 3 r)))
(defun fn-bprr-octetsp (x)
 (declare (xargs :guard t :verify-guards nil)) (and (true-listp x) (fn-cbor-octet-listp x)))
(defun fn-bprr-recordp (r)
 (declare (xargs :guard t :verify-guards nil))
 (let ((kind (fn-bprr-nth 0 r)))
  (cond ((equal kind :config) (fn-bprr-configp r))
   ((equal kind :request-context)
    (and (true-listp r) (equal (len r) 5) (fn-bprr-textp (fn-bprr-nth 1 r))
     (fn-bprr-octetsp (fn-bprr-nth 2 r)) (fn-bprr-octetsp (fn-bprr-nth 3 r))
     (equal (fn-bprr-nth 4 r) t)))
   ((equal kind :receipt-intent)
    (and (true-listp r) (equal (len r) 5)
     (fn-bprr-textp (fn-bprr-nth 1 r)) (fn-bprr-textp (fn-bprr-nth 2 r))
     (fn-bprr-octetsp (fn-bprr-nth 3 r)) (equal (fn-bprr-nth 4 r) t)))
   ((equal kind :receipt-decision)
    (and (true-listp r) (equal (len r) 4)
     (fn-bprr-textp (fn-bprr-nth 1 r)) (fn-bprr-textp (fn-bprr-nth 2 r))
     (member-equal (fn-bprr-nth 3 r) '(:committed :absent))))
   (t nil))))
(defun fn-bprr-decode-value (octets which)
 (declare (xargs :guard t :verify-guards nil))
 (let ((parsed (if (equal which :request) (fn-bpa-decode-exact octets)
                 (fn-record-decode-exact octets))))
  (if (fn-record-parse-okp parsed) (fn-record-parse-value parsed) nil)))

; Result is (okp state). A valid request record must change state exactly once.
(defun fn-bprr-apply-record (st store r)
 (declare (xargs :guard t :verify-guards nil))
 (if (not (fn-bprr-recordp r)) (list nil st)
  (let ((kind (car r)))
   (cond
    ((equal kind :request-context)
     (let* ((request (fn-bprr-decode-value (fn-bprr-nth 2 r) :request))
            (record (fn-bprr-decode-value (fn-bprr-nth 3 r) :record))
            (answer (fn-bpr-accept-request st store record request (fn-bprr-nth 4 r))))
      (if (equal (car answer) :accepted) (list t (fn-bprr-nth 1 answer))
       (list nil st))))
    ((equal kind :receipt-intent)
     (let* ((next (fn-bpr-prepare-receipt st (fn-bprr-nth 1 r)
                    (fn-bprr-nth 2 r) (fn-bprr-nth 4 r)))
            (pending (fn-bpr-state-pending next))
            (expected (and (consp pending)
             (fn-bpa-encode (fn-bpr-receipt-entry-receipt pending)))))
      (if (and (not (equal next st)) (equal expected (fn-bprr-nth 3 r)))
          (list t next) (list nil st))))
    ((equal kind :receipt-decision)
     (let* ((pending (fn-bpr-state-pending st))
            (receipt (and (consp pending) (fn-bpr-receipt-entry-receipt pending)))
            (next (fn-bpr-commit-receipt st (fn-bprr-nth 1 r)
                                          (fn-bprr-nth 2 r) (fn-bprr-nth 3 r))))
      (if (and (consp pending) (equal (fn-bpa-receipt-work-id receipt) (fn-bprr-nth 1 r))
               (equal (fn-bpa-receipt-id receipt) (fn-bprr-nth 2 r))
               (not (equal next st))) (list t next) (list nil st))))
    (t (list nil st))))))
(defun fn-bprr-replay-rest (st store records)
(declare (xargs :guard t :verify-guards nil :measure (acl2-count records)))
 (if (endp records) (list t st)
  (let ((answer (fn-bprr-apply-record st store (car records))))
   (if (not (car answer)) (list nil st)
    (fn-bprr-replay-rest (fn-bprr-nth 1 answer) store (cdr records))))))
(defun fn-bprr-replay (store records)
 (declare (xargs :guard t :verify-guards nil))
 (if (or (endp records) (not (fn-bprr-configp (car records)))) (list nil nil)
  (let ((st (fn-bpr-initial-state (fn-bprr-config (car records)))))
   (if (not (fn-bpr-statep st)) (list nil nil)
    (fn-bprr-replay-rest st store (cdr records))))))

; Export theory.  The journal-record recognizers, decoder, replay step and
; replay are proof vocabulary for the receiver books, which open them locally
; (fn-bp-receiver-records-vocabulary).  fn-bprr-nth, fn-bprr-textp and
; fn-bprr-octetsp stay enabled as total readers.
(deftheory fn-bp-receiver-records-vocabulary
  '(fn-bprr-configp fn-bprr-config fn-bprr-recordp fn-bprr-decode-value
    fn-bprr-apply-record fn-bprr-replay-rest fn-bprr-replay))
(in-theory (disable fn-bp-receiver-records-vocabulary))

; LC cold-open MODEL: root selection and column adoption, then tail folds.
; Column and prefix-row projections are logical observations of the adopted
; page/locator image. They are not a checkpoint event tape or a native copy.
; Native lazy adoption and installation are the separate B2 refinement.
(in-package "ACL2")
(include-book "log-checkpoint-adoption")
(include-book "log-checkpoint-record")
(include-book "owner-checkpoint-open")
(include-book "log-checkpoint-allocation")
(include-book "log-checkpoint-allocation-proof")
(include-book "log-checkpoint-open-read-trace")

(defun fn-lc-control-pages (control)
 (declare (xargs :guard t :verify-guards nil))
 (ec-call (fn-lc-map-observation-pages-of
            (list (ec-call (fn-lc-map-observation-tree-enc (list control)))))))
(defun fn-lc-selected-control (disk r mode)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((header (fn-lc-adopted-header disk r mode))
        (pages (fn-lc-at 5 header))
        (rows (ec-call (fn-lc-map-observation-of-pages pages)))
        (decoded (ec-call (fn-scc-decode-tree (fn-lc-head (fn-lc-head rows))))))
   (if (and (equal (fn-lc-head decoded) :ok)
            (equal (fn-lc-head (fn-lc-at 1 decoded)) :lc-control))
       (fn-lc-at 1 decoded) :bad)))
(defun fn-lc-snapshot-header-value (value header control)
 (declare (xargs :guard t :verify-guards nil))
 (list :lc-header (fn-lc-header-S header) (fn-lc-header-next-id header)
       (fn-lc-header-exhaustedp header)
       (fn-lc-layout-pages (fn-lc-column-lengths-value value))
       (fn-lc-control-pages control)))
(defun-nx fn-lc-snapshot-header (fn-lbc header control)
 (ec-call (fn-lc-snapshot-header-value fn-lbc header control)))

(defun fn-lc-replayed-header (disk r mode segs)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((header (fn-lc-adopted-header disk r mode))
        (allocated (ec-call (fn-lc-allocation-header header segs)))
        (next (fn-lc-header-next-id allocated))
        (exhausted (fn-lc-header-exhaustedp allocated))
        (scan (fn-lc-tail-scan segs header))
        (tail (fn-lc-tail-history segs header))
        (ordered (fn-lc-ordered-segments segs))
        (last-id (if (consp ordered) (fn-lc-last-segment-id ordered)
                   (fn-lc-at 0 (fn-lc-header-S header))))
        (last-seg (fn-lc-assoc last-id segs))
        (S (if (consp tail)
               (list last-id (len (fn-lc-at 1 last-seg))
                     (+ (fn-lc-header-sequence header) (len tail))
                     (fn-lc-at 3 (fn-lc-header-S header)) (fn-lc-at 3 scan))
             (fn-lc-header-S header))))
   (list :lc-header S next exhausted (fn-lc-at 4 header) (fn-lc-at 5 header))))
(defun fn-lc-page-addresses (count offset)
 (declare (xargs :guard t :measure (nfix count)))
 (if (zp (nfix count)) nil
  (cons (nfix offset) (fn-lc-page-addresses (1- (nfix count)) (+ 1 (nfix offset))))))
(defun fn-lc-directory-path-pages (disk r mode)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((opened (pgs-open disk r mode))
        (header (fn-lc-adopted-header disk r mode))
        (col-count (fn-lc-lengths-sum (fn-lc-layout-lengths header)))
        (dir-count (len (fn-lc-at 4 header)))
        (ctl-count (len (fn-lc-at 5 header)))
        (indices (if (fn-lc-headerp header)
                     (cons 0 (fn-lc-page-addresses (+ dir-count ctl-count) (+ 1 col-count))) nil))
        (rec (pgs-slot (fn-lc-at 1 opened) (pgs-root-slots r disk)))
        (table (fn-lc-selected-page-table disk r mode)))
  (fn-lc-memo-page-requests
   (fn-lc-join (fn-lc-at 0 (fn-lc-pgs-open-requests disk r mode))
    (fn-lc-join (fn-lc-path-table-physes indices rec (pgs-pages disk))
               (fn-lc-logical-page-physes indices table))))))
(defun fn-lc-open-page-program (pages)
 (declare (xargs :guard t))
 (if (consp pages)
  (cons (list :pread :page (car pages) (fn-lc-page-octets))
        (fn-lc-open-page-program (cdr pages))) nil))
(defun fn-lc-open-tail-program (entries)
 (declare (xargs :guard t))
 (if (consp entries)
  (cons (list :pread :tail (car entries) (nfix (car entries)))
        (fn-lc-open-tail-program (cdr entries))) nil))
(defun fn-lc-open-program (disk r mode segs)
 (declare (xargs :guard t :verify-guards nil))
 (let ((pages (fn-lc-memo-page-requests
               (fn-lc-join (fn-lc-directory-path-pages disk r mode)
                          (fn-lc-at 1 (fn-lc-pgs-open-requests disk r mode))))))
  (fn-lc-join (list (list :pread :root 0 (fn-lc-root-slot-octets))
                   (list :pread :root 1 (fn-lc-root-slot-octets)))
   (fn-lc-join (fn-lc-open-page-program pages)
              (fn-lc-open-tail-program (fn-lc-tail-entries disk r mode segs))))))
(defun fn-lc-read-octets (trace)
 (declare (xargs :guard t))
 (if (consp trace)
  (+ (if (equal (fn-lc-head (car trace)) :pread) (nfix (fn-lc-at 3 (car trace))) 0)
     (fn-lc-read-octets (cdr trace))) 0))
(defun fn-lc-adopt (disk r mode segs fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((header (fn-lc-adopted-header disk r mode))
        (lengths (fn-lc-layout-lengths header))
        (columns (fn-lc-adopted-columns disk r mode))
        (value (fn-lc-decoded-columns columns lengths))
        (trace (fn-lc-join
                 (list (list :pread :root 0 (fn-lc-root-slot-octets))
                       (list :pread :root 1 (fn-lc-root-slot-octets)))
                 (fn-lc-open-page-program
                   (fn-lc-memo-page-requests
                    (fn-lc-join (fn-lc-directory-path-pages disk r mode)
                      (fn-lc-at 1 (fn-lc-pgs-open-requests disk r mode))))))))
   (if (and (fn-lc-headerp header) (fn-lc-lengths-p lengths)
            (equal (len lengths) 8) (not (equal columns :bad))
            (fn-lc-decoded-columnsp value)
            (not (equal (fn-lc-selected-control disk r mode) :bad)))
       (let ((fn-lbc (fn-lc-install-columns value fn-lbc)))
         (mv :ok fn-lbc disk segs trace))
     (mv :checkpoint-image fn-lbc disk segs trace))))
(defun fn-lc-prefix-rows (i count segs fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil :measure (nfix count)))
 (if (zp (nfix count)) nil
  (cons (ec-call (fn-lbc-at (nfix i) fn-lbc segs))
        (fn-lc-prefix-rows (+ 1 (nfix i)) (1- (nfix count)) segs fn-lbc))))
(defun fn-lc-prefix-articles (rows)
 (declare (xargs :guard t))
 (if (consp rows)
  (cons (fn-make-article (fn-record-msgid (car rows)) (fn-record-payload (car rows))
                       (fn-record-groups (car rows)) (fn-held-numbers (car rows))
                       t (fn-record-stamp (car rows)))
        (fn-lc-prefix-articles (cdr rows))) nil))
(defun fn-lc-adopt-cpr (control rows)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((c (fn-lc-at 1 control)) (position (fn-lc-at 1 c))
        (acceptance (fn-make-state (fn-lc-at 3 c) (fn-lc-at 4 c)
                          (ec-call (reverse (fn-lc-prefix-articles rows)))
                          (fn-lc-at 5 c) nil (fn-lc-at 6 c)))
        (cn (fn-cnode-make (fn-node-make-state acceptance (fn-lc-at 7 c)
                                (fn-lc-at 8 c) (fn-lc-at 9 c)) (fn-lc-at 2 c))))
   (if (equal (fn-lc-at 0 c) :paused)
       (fn-sco-paused cn (fn-lc-at 0 position) (fn-lc-at 1 position))
     (if (equal (fn-lc-at 0 c) :ok)
         (fn-replay-ok cn (fn-lc-at 0 position))
       (fn-replay-fault cn (fn-lc-at 0 position) (fn-lc-at 1 position))))))
(defun fn-lc-owner-seed (control rows)
 (declare (xargs :guard t :verify-guards nil))
 ; The record projection supplies the existing logical file/index fields.
 ; It is not an input to any prefix fold: every fold starts from CONTROL.
 (fn-sco-make (ec-call (fn-lc-recompose-history (fn-lc-at 5 control) rows))
              (fn-lc-adopt-cpr control rows) (fn-lc-at 2 control)
              (fn-lc-at 3 control) (fn-lc-at 4 control) nil))
(defun fn-lc-owner-from-seed (seed configs frontier tail max-conns)
 (declare (xargs :guard t :verify-guards nil))
 (ec-call (fn-ock-recover-extended (ec-call (fn-sco-extend seed configs tail))
                                 configs frontier max-conns)))
(defun fn-lc-owner-rows (owner)
 (declare (xargs :guard t :verify-guards nil))
 (if (equal owner :fault) :fault
  (fn-lc-history-rows nil (fn-sf-records (fn-sn-files (fn-own-store (fn-ocfg-owner owner)))))))
(defun fn-lc-replay-article-tail (tail segs fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (if (consp tail)
  (let* ((h (car tail)) (entry (ec-call (fn-lb-log-model-row-entry h segs)))
         (id (ec-call (fn-lb-log-model-row-segment h segs)))
         (loc (+ (* (nfix (fn-lc-at 3 entry)) 4294967296) (nfix (fn-lc-at 4 entry)))))
    (mv-let (answer fn-lbc after) (fn-lc-commit-record h id loc fn-lbc segs)
      (if (equal answer :ok) (fn-lc-replay-article-tail (cdr tail) after fn-lbc)
        (mv answer fn-lbc after))))
  (mv :ok fn-lbc segs)))
(defun fn-lc-open (disk r mode configs frontier max-conns segs outcome fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((program (fn-lc-open-program disk r mode segs))
        (cut (fn-lc-outcome-ok-count outcome (len program)))
        (trace (fn-lc-take (min (+ 1 cut) (len program)) program))
        (header (fn-lc-adopted-header disk r mode)))
   (if (not (equal cut (len program))) (mv :uncertain fn-lbc disk segs trace :fault)
    (mv-let (answer fn-lbc adopted-disk adopted-segs adopted-trace)
      (fn-lc-adopt disk r mode segs fn-lbc)
      (declare (ignore adopted-trace))
      (if (or (not (equal answer :ok)) (not (fn-lc-segs-retain segs header)))
          (mv :checkpoint-image fn-lbc adopted-disk adopted-segs trace :fault)
        (let* ((rows (fn-lc-prefix-rows 0 (fn-lbc-count fn-lbc) segs fn-lbc))
               (tail (fn-lc-tail-history segs header))
               (seed (fn-lc-owner-seed (fn-lc-selected-control disk r mode) rows))
               (owner (fn-lc-owner-from-seed seed configs frontier tail max-conns)))
          (if (equal owner :fault) (mv :owner-replay fn-lbc disk segs trace :fault)
            (mv-let (answer fn-lbc replayed-segs)
              (fn-lc-replay-article-tail tail segs fn-lbc)
              (mv answer fn-lbc disk replayed-segs trace
                  (if (equal answer :ok) owner :fault))))))))))
(defun fn-lc-opened-owner (out)
 (declare (xargs :guard t)) (fn-lc-at 5 out))


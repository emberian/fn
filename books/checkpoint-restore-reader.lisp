                     (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen) (unsigned-byte-p 8 okind)
                     (unsigned-byte-p 32 oslot) (unsigned-byte-p 60 ogen)
                     (eq (fn2-pool-workspace-code slot gen okind oslot ogen fn2-pool) :ok)
                     (<= *fn2-format-page-size* (fn2-pool-cap slot fn2-pool)))) (mv :state fn2-checkpoint-restore-reader))
      (r (+ (* 6 c) role)) (unit (fn2-checkpoint-refs-physical-unit r fn2-checkpoint-refs))
      ((unless (and (equal (fn2-checkpoint-refs-storage-domain r fn2-checkpoint-refs) 0)

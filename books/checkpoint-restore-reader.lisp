      ((unless (and (member-eq shape '(:ok :frontier)) (< 0 (fn2-checkpoint-restore-reader-rows fn2-checkpoint-restore-reader))
                     (equal (fn2-checkpoint-restore-reader-phase 0 fn2-checkpoint-restore-reader) *fn2-checkpoint-restore-reader-phase-idle*)
                     (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
                     (equal (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-checked*)

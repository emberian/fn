  :guard (and (fn2-pool-wfp fn2-pool) (fn2-checkpoint-restore-reader-wfp fn2-checkpoint-restore-reader)
              (natp left) (<= left 32) (natp dst) (<= (+ dst left) 64) (natp src))))

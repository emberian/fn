  (let ((fn2-checkpoint-restore-reader (update-fn2-checkpoint-restore-reader-hashi dst
          (fn2-checkpoint-bytes-value src fn2-checkpoint-bytes) fn2-checkpoint-restore-reader)))
   (fn2-checkpoint-restore-reader-root-hash (- left 1) (+ dst 1) (+ src 1) fn2-checkpoint-bytes fn2-checkpoint-restore-reader))))


    (let ((fn2-checkpoint-restore-reader (update-fn2-checkpoint-restore-reader-hashi dst byte fn2-checkpoint-restore-reader)))
     (fn2-checkpoint-restore-reader-next-hash (- left 1) (+ dst 1) (+ src 1) slot gen okind oslot ogen fn2-pool fn2-checkpoint-restore-reader))))))


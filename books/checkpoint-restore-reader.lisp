  (let* ((at (* i 4))
         (word (fn-b3-word (+ (fn2-checkpoint-restore-reader-hashi at fn2-checkpoint-restore-reader)
                  (* 256 (fn2-checkpoint-restore-reader-hashi (+ at 1) fn2-checkpoint-restore-reader))

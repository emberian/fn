                (equal (fn2-checkpoint-restore-reader-phase 0 fn2-checkpoint-restore-reader) *fn2-checkpoint-restore-reader-phase-page*)
                (natp cursor) (< cursor *fn2-format-page-size*) (equal (mod cursor *fn2-format-sector-size*) 0)))
  (mv :state 0 0)
  (mv :read (+ (* (fn2-checkpoint-restore-reader-unit 0 fn2-checkpoint-restore-reader) *fn2-format-sector-size*) cursor)
            *fn2-format-sector-size*)))


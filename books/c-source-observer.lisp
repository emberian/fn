; Constant-work transitions. The typed adapters validate actual actor
; admission; aggregate reader accounting is maintained by these operations.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "c-source-observer-state")
(fn2-book-layer :c)
(defun fn2-c-source-observer-ownerp (kind id generation fn2-c-source-observers)
 (declare (xargs :stobjs fn2-c-source-observers :guard (fn2-c-source-observers-wfp fn2-c-source-observers)))
 (and (natp id) (< id (fn2-c-source-observers-rows fn2-c-source-observers))
      (equal (fn2-c-source-observers-live id fn2-c-source-observers) 1)
      (equal kind (fn2-c-source-observers-kind id fn2-c-source-observers))
      (equal generation (fn2-c-source-observers-generation id fn2-c-source-observers))))
(defun fn2-c-source-writer-ownerp (token kind id generation fn2-c-source-control)
 (declare (xargs :stobjs fn2-c-source-control :guard (fn2-c-source-control-wfp fn2-c-source-control)))
 (and (< 0 (fn2-c-source-control-rows fn2-c-source-control))
      (not (equal (fn2-c-source-control-phase 0 fn2-c-source-control) *fn2-c-source-writer-phase-idle*))
      (posp token) (equal token (fn2-c-source-control-serial 0 fn2-c-source-control))
      (equal kind (fn2-c-source-control-writer-kind 0 fn2-c-source-control))
      (equal id (fn2-c-source-control-writer-id 0 fn2-c-source-control))
      (equal generation (fn2-c-source-control-writer-gen 0 fn2-c-source-control))))
(defun fn2-c-source-read-acquire-raw (kind id generation fn2-c-source-control fn2-c-source-observers)
 (declare (xargs :stobjs (fn2-c-source-control fn2-c-source-observers)
 :guard (and (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-observers-wfp fn2-c-source-observers))))
 (b* (((unless (and (< 0 (fn2-c-source-control-rows fn2-c-source-control))
                    (unsigned-byte-p 8 kind) (< 0 kind) (unsigned-byte-p 32 id)
                    (< id (fn2-c-source-observers-rows fn2-c-source-observers)) (unsigned-byte-p 60 generation)))
       (mv :bounds fn2-c-source-control fn2-c-source-observers))
      ((when (equal (fn2-c-source-observers-live id fn2-c-source-observers) 1))
       (mv (if (fn2-c-source-observer-ownerp kind id generation fn2-c-source-observers) :ok :stale)
        fn2-c-source-control fn2-c-source-observers))
      ((unless (equal (fn2-c-source-control-phase 0 fn2-c-source-control) *fn2-c-source-writer-phase-idle*))
       (mv :busy fn2-c-source-control fn2-c-source-observers))
      (n (+ 1 (fn2-c-source-control-readers 0 fn2-c-source-control)))
      ((unless (and (unsigned-byte-p 32 n) (<= n (fn2-c-source-observers-rows fn2-c-source-observers))))
       (mv :exhausted fn2-c-source-control fn2-c-source-observers))
      (fn2-c-source-observers (fn2-c-source-observers-put id (live 1) (kind kind) (generation generation)))
      (fn2-c-source-control (fn2-c-source-control-set-readers 0 n fn2-c-source-control)))
  (mv :ok fn2-c-source-control fn2-c-source-observers)))
(defun fn2-c-source-read-release-raw (kind id generation fn2-c-source-control fn2-c-source-observers)
 (declare (xargs :stobjs (fn2-c-source-control fn2-c-source-observers)
 :guard (and (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-observers-wfp fn2-c-source-observers))))
 (b* (((unless (and (< 0 (fn2-c-source-control-rows fn2-c-source-control)) (natp id)
                    (< id (fn2-c-source-observers-rows fn2-c-source-observers))))
       (mv :bounds *fn2-none* 0 fn2-c-source-control fn2-c-source-observers))
      ((when (equal (fn2-c-source-observers-live id fn2-c-source-observers) 0))
       (mv :absent *fn2-none* 0 fn2-c-source-control fn2-c-source-observers))
      ((unless (fn2-c-source-observer-ownerp kind id generation fn2-c-source-observers))
       (mv :stale *fn2-none* 0 fn2-c-source-control fn2-c-source-observers))
      ((unless (posp (fn2-c-source-control-readers 0 fn2-c-source-control)))
       (mv :invariant *fn2-none* 0 fn2-c-source-control fn2-c-source-observers))
      (n (- (fn2-c-source-control-readers 0 fn2-c-source-control) 1))
      (wake (and (equal n 0) (equal (fn2-c-source-control-phase 0 fn2-c-source-control) *fn2-c-source-writer-phase-pending*)))
      (target (if wake (fn2-c-source-control-writer-id 0 fn2-c-source-control) *fn2-none*))
      (targetgen (if wake (fn2-c-source-control-writer-gen 0 fn2-c-source-control) 0))
      (fn2-c-source-observers (fn2-c-source-observers-put id (live 0) (kind 0) (generation 0)))
      (fn2-c-source-control (fn2-c-source-control-set-readers 0 n fn2-c-source-control)))
  (mv :ok target targetgen fn2-c-source-control fn2-c-source-observers)))
(defun fn2-c-source-writer-poll-raw (token kind id generation fn2-c-source-control)
 (declare (xargs :stobjs fn2-c-source-control :guard (fn2-c-source-control-wfp fn2-c-source-control)))
 (b* (((unless (fn2-c-source-writer-ownerp token kind id generation fn2-c-source-control)) (mv :stale fn2-c-source-control))
      (phase (fn2-c-source-control-phase 0 fn2-c-source-control))
      ((when (equal phase *fn2-c-source-writer-phase-uncertain*)) (mv :uncertain fn2-c-source-control))
      ((when (equal phase *fn2-c-source-writer-phase-exclusive*)) (mv :exclusive fn2-c-source-control))
      ((unless (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 0)) (mv :waiting fn2-c-source-control))
      (fn2-c-source-control (fn2-c-source-control-set-phase 0 *fn2-c-source-writer-phase-exclusive* fn2-c-source-control)))
  (mv :exclusive fn2-c-source-control)))
(defun fn2-c-source-writer-begin-raw (kind id generation fn2-c-source-control fn2-c-source-observers)
 (declare (xargs :stobjs (fn2-c-source-control fn2-c-source-observers)
 :guard (and (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-observers-wfp fn2-c-source-observers))))
 (b* (((unless (and (< 0 (fn2-c-source-control-rows fn2-c-source-control))
                    (unsigned-byte-p 8 kind) (< 0 kind) (unsigned-byte-p 32 id)
                    (< id (fn2-c-source-observers-rows fn2-c-source-observers)) (unsigned-byte-p 60 generation)))
       (mv :bounds 0 fn2-c-source-control))
      ((when (equal (fn2-c-source-observers-live id fn2-c-source-observers) 1))
       (mv :observer-held 0 fn2-c-source-control))
      (old (fn2-c-source-control-serial 0 fn2-c-source-control))
      ((unless (equal (fn2-c-source-control-phase 0 fn2-c-source-control) *fn2-c-source-writer-phase-idle*))
       (if (fn2-c-source-writer-ownerp old kind id generation fn2-c-source-control)
        (mv-let (code fn2-c-source-control) (fn2-c-source-writer-poll-raw old kind id generation fn2-c-source-control)
         (mv code old fn2-c-source-control))
        (mv :busy 0 fn2-c-source-control)))
      (token (+ 1 old))
      ((unless (unsigned-byte-p 60 token)) (mv :exhausted 0 fn2-c-source-control))
      ; Closure is installed before waiting; no new reader can overtake it.
      (fn2-c-source-control (fn2-c-source-control-put 0 (phase *fn2-c-source-writer-phase-pending*)
       (serial token) (writer-kind kind) (writer-id id) (writer-gen generation)))
      ((mv code fn2-c-source-control) (fn2-c-source-writer-poll-raw token kind id generation fn2-c-source-control)))
  (mv code token fn2-c-source-control)))
; Internal terminal helpers have no public core face. The adopter's actual
; terminal or cancellation constructor must establish permission to reopen.
(defun fn2-c-source-writer-end-raw (token kind id generation fn2-c-source-control)
 (declare (xargs :stobjs fn2-c-source-control :guard (fn2-c-source-control-wfp fn2-c-source-control)))
 (if (not (and (fn2-c-source-writer-ownerp token kind id generation fn2-c-source-control)
               (equal (fn2-c-source-control-phase 0 fn2-c-source-control) *fn2-c-source-writer-phase-exclusive*)
               (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 0)))
  (mv :stale fn2-c-source-control)
  (let ((fn2-c-source-control (fn2-c-source-control-put 0 (phase *fn2-c-source-writer-phase-idle*)
         (writer-kind 0) (writer-id 0) (writer-gen 0))))
   (mv :ok fn2-c-source-control))))
(defun fn2-c-source-writer-cancel-pending-raw (token kind id generation fn2-c-source-control)
 (declare (xargs :stobjs fn2-c-source-control :guard (fn2-c-source-control-wfp fn2-c-source-control)))
 (if (not (and (fn2-c-source-writer-ownerp token kind id generation fn2-c-source-control)
               (equal (fn2-c-source-control-phase 0 fn2-c-source-control) *fn2-c-source-writer-phase-pending*)))
  (mv :stale fn2-c-source-control)
  (let ((fn2-c-source-control (fn2-c-source-control-put 0 (phase *fn2-c-source-writer-phase-idle*)
         (writer-kind 0) (writer-id 0) (writer-gen 0))))
   (mv :ok fn2-c-source-control))))

(defun fn2-c-source-writer-uncertain-raw (token kind id generation fn2-c-source-control)
 (declare (xargs :stobjs fn2-c-source-control :guard (fn2-c-source-control-wfp fn2-c-source-control)))
 (if (not (fn2-c-source-writer-ownerp token kind id generation fn2-c-source-control))
  (mv :stale fn2-c-source-control)
  (let ((fn2-c-source-control (fn2-c-source-control-set-phase 0 *fn2-c-source-writer-phase-uncertain* fn2-c-source-control)))
   (mv :uncertain fn2-c-source-control))))

(fn2-c-source-control-preserves fn2-c-source-read-acquire-raw
 (kind id generation fn2-c-source-control fn2-c-source-observers)
 :position 1
 :carriers ((fn2-c-source-control 1 :prefix "-C-SOURCE-CONTROL" :rows t) (fn2-c-source-observers 2 :prefix "-C-SOURCE-OBSERVERS" :rows t))
 :hyps ((fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-observersp fn2-c-source-observers) (fn2-c-source-observers-wfp fn2-c-source-observers)))

(fn2-c-source-control-preserves fn2-c-source-read-release-raw
 (kind id generation fn2-c-source-control fn2-c-source-observers)
 :position 3
 :carriers ((fn2-c-source-control 3 :prefix "-C-SOURCE-CONTROL" :rows t) (fn2-c-source-observers 4 :prefix "-C-SOURCE-OBSERVERS" :rows t))
 :hyps ((fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-observersp fn2-c-source-observers) (fn2-c-source-observers-wfp fn2-c-source-observers)))

(fn2-c-source-control-preserves fn2-c-source-writer-poll-raw
 (token kind id generation fn2-c-source-control)
 :position 1
 :carriers ((fn2-c-source-control 1 :prefix "-C-SOURCE-CONTROL" :rows t))
 :hyps ((fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control)))

(fn2-c-source-control-preserves fn2-c-source-writer-begin-raw
 (kind id generation fn2-c-source-control fn2-c-source-observers)
 :position 2
 :carriers ((fn2-c-source-control 2 :prefix "-C-SOURCE-CONTROL" :rows t))
 :hyps ((fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-observersp fn2-c-source-observers) (fn2-c-source-observers-wfp fn2-c-source-observers)))

(fn2-c-source-control-preserves fn2-c-source-writer-end-raw
 (token kind id generation fn2-c-source-control)
 :position 1
 :carriers ((fn2-c-source-control 1 :prefix "-C-SOURCE-CONTROL" :rows t))
 :hyps ((fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control)))

(fn2-c-source-control-preserves fn2-c-source-writer-cancel-pending-raw
 (token kind id generation fn2-c-source-control)
 :position 1
 :carriers ((fn2-c-source-control 1 :prefix "-C-SOURCE-CONTROL" :rows t))
 :hyps ((fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control)))

(fn2-c-source-control-preserves fn2-c-source-writer-uncertain-raw
 (token kind id generation fn2-c-source-control)
 :position 1
 :carriers ((fn2-c-source-control 1 :prefix "-C-SOURCE-CONTROL" :rows t))
 :hyps ((fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control)))

; Receiver operations over the actual protected pull actor. Verify an entire
; held page before declaring the first C item. B settles every item before
; the actor can enter its separate checkpoint transaction.
(in-package "ACL2")
(include-book "peer-pull-reply")
(include-book "xfnc-batch-codec")
(include-book "xfnc-view-chain")
(include-book "assembly-callbacks-e-cns")

(defmacro fn2-pull-row (field)
 `(,(fn2-columns-sym 'fn2-peer-pull-row- (symbol-name field)) id fn2-core))

(defun fn2-peer-pull-import-live-p (id generation fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (and (posp generation) (eq (fn2-peer-pull-snapshot-read-code id fn2-core) :ok)
      (equal generation (fn2-machine-generation id fn2-core))
      (equal (fn2-pull-row protected) 1) (equal (fn2-pull-row connected) 1)
      (equal (fn2-pull-row dialog) *fn2-pull-dialog-read*)
      (posp (fn2-pull-row source-principal)) (posp (fn2-pull-row source-stream))
      (posp (fn2-pull-row source-epoch)) (posp (fn2-pull-row source-version))))

(defun fn2-peer-pull-c-rows (id fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                 :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
 (b* ((slot (fn2-machine-slot id fn2-core))
      (p (nfix (fn2-machine-connection-count *fn2-peer-pull-admission-ordinal* fn2-core)))
      (a (nfix (fn2-machine-connection-count *fn2-auth-admission-ordinal* fn2-core)))
      (c (nfix (fn2-machine-connection-count *fn2-cns-admission-ordinal* fn2-core)))
      (posts (nfix (fn2-machine-connection-count *fn2-txn-admission-ordinal* fn2-core)))
      (r (stobj-let ((fn2-reads (fn2-core-reads fn2-core))) (n) (fn2-reads-rows fn2-reads) (nfix n)))
      (trows (stobj-let ((fn2-id-decides (fn2-core-id-decides fn2-core))) (n) (fn2-id-decides-rows fn2-id-decides) (nfix n)))
      ((unless (and (natp slot) (< slot p) (<= (+ p a c) r) (<= (+ posts a c p) trows))) (mv :state 0 0))
      (tx (+ posts a c slot))
      (read-row (+ (- r (+ p a c)) slot)))
   (if (and (unsigned-byte-p 32 tx) (unsigned-byte-p 32 read-row)) (mv :ok tx read-row) (mv :state 0 0))))
(in-theory (disable fn2-peer-pull-import-live-p fn2-peer-pull-c-rows))

(fn2-csnapshot-op fn2-peer-pull-resume-turn (id generation budget) 2
 (b* (((unless (and (fn2-peer-pull-import-live-p id generation fn2-core)
                    (equal (fn2-pull-row phase) *fn2-peer-pull-state-resume*)))
        (mv :scope 0 fn2-core))
      ((mv rc tx x) (fn2-peer-pull-c-rows id fn2-core))
      ((unless (eq rc :ok)) (mv :state 0 fn2-core))
      ((when (equal (fn2-pull-row import-keyed) 0))
       (b* (((mv code fn2-core) (fn2-peer-checkpoint-key x (fn2-pull-row local-principal) (fn2-pull-row consumer) fn2-core))
            ((unless (eq code :ok)) (mv :state 0 fn2-core))
            (fn2-core (fn2-peer-pull-put-core id (import-keyed 1))))
         (mv :more 0 fn2-core)))
      ((mv code stream history incarnation revision view view-version interpretation position a b c d e
         principal epoch query-version fn2-core)
       (fn2-peer-checkpoint-read-full x (min 2048 (nfix budget)) fn2-core))
      ((when (eq code :more)) (mv :more 0 fn2-core))
      ((when (eq code :miss))
       (mv-let (released fn2-core) (fn2-read-release x fn2-core) (declare (ignore released)) (mv :state 0 fn2-core)))
      ((unless (and (member-eq code '(:ok :absent)) (unsigned-byte-p 32 tx))) (mv :scope 0 fn2-core))
      (absent (eq code :absent))
      ((unless (or absent
                   (and (equal stream (fn2-pull-row stream)) (equal history (fn2-pull-row remote-history))
                        (equal incarnation (fn2-pull-row remote-incarnation)) (equal view (fn2-pull-row source-stream))
                        (equal view-version (fn2-pull-row remote-view)) (equal interpretation *fn2-xfnc-batch-interpretation*)
                        (equal principal (fn2-pull-row source-principal)) (equal epoch (fn2-pull-row source-epoch))
                        (equal query-version (fn2-pull-row source-version)) (posp revision)
                        (unsigned-byte-p 60 revision) (unsigned-byte-p 60 position)
                        (unsigned-byte-p 56 a) (unsigned-byte-p 56 b) (unsigned-byte-p 48 c)
                        (unsigned-byte-p 48 d) (unsigned-byte-p 48 e)))) (mv :scope 0 fn2-core))
      (fn2-core (fn2-peer-pull-put-core id (import-keyed 0) (import-tx tx) (import-step 0)
                   (import-absent (if absent 1 0)) (import-revision (if absent 0 revision))
                   (import-prev-a (if absent 0 a)) (import-prev-b (if absent 0 b)) (import-prev-c (if absent 0 c))
                   (import-prev-d (if absent 0 d)) (import-prev-e (if absent 0 e)))))
   (mv :ready (if absent 0 (nfix position)) fn2-core)))

(defun fn2-peer-pull-pack-digest (dst i packed fn2-digests)
 (declare (xargs :stobjs fn2-digests :measure (nfix (- 8 (nfix i)))
                 :guard (and (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests)
                             (fn2-digest-rowp dst fn2-digests) (natp i) (natp packed))))
 (if (or (not (natp i)) (>= i 8)) fn2-digests
   (let* ((bits (loghead 32 (logtail (* 32 (- 7 i)) packed)))
          (word (logior (loghead 8 (logtail 24 bits)) (ash (loghead 8 (logtail 16 bits)) 8)
                        (ash (loghead 8 (logtail 8 bits)) 16) (ash (loghead 8 bits) 24))))
     (fn2-peer-pull-pack-digest dst (+ 1 i) packed
       (fn2-digest-set-word dst i (loghead 32 word) fn2-digests)))))
(fn2-digests-preserves fn2-peer-pull-pack-digest (dst i packed fn2-digests) :position nil)
(in-theory (disable fn2-peer-pull-pack-digest))

(defmacro fn2-pull-header-value (name)
 `(fn2-fields-value (+ base ,(fn2-codec-constant 'fn2-xfnc-batch-header (concatenate 'string "-FIELD-" (symbol-name name)))) fn2-fields))

(fn2-csnapshot-op fn2-peer-pull-header-turn (id generation start end row) 1
 (b* ((slot (fn2-pull-row rx-slot)) (gen (fn2-pull-row rx-gen)) (after (fn2-pull-row resume-position))
      (history (fn2-pull-row remote-history)) (incarnation (fn2-pull-row remote-incarnation))
      (pid (fn2-pull-row source-principal)) (cid (fn2-pull-row consumer)) (view (fn2-pull-row source-stream))
      (version (fn2-pull-row remote-view)) (ep (fn2-pull-row source-epoch)) (qv (fn2-pull-row source-version))
      (absent (equal (fn2-pull-row import-absent) 1))
      (tx (fn2-pull-row import-tx))
      (base (* 128 (nfix row)))
      ((mv code first next revision count stop chain fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core))
                   (fn2-fc (fn2-core-fc fn2-core)) (fn2-id-decides (fn2-core-id-decides fn2-core)))
         (code first next revision count stop chain fn2-fields)
         (b* (((mv rc b0) (fn2-idc-stripe tx (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields))
              ((unless (and (eq rc :ok) (natp b0) (<= (+ base *fn2-xfnc-batch-header-num-fields*) (fn2-fields-rows fn2-fields))))
               (mv :state 0 0 0 0 0 0 fn2-fields))
              (cursor-base (+ b0 (- *fn2-idc-stride* 128)))
              ((mv code first fn2-fields)
               (fn2-xfnc-get-batch-header base cursor-base start end pid cid ep qv history incarnation view version after
                  slot gen *fn2-peer-pull-kind* id generation fn2-fields fn2-pool)))
           (mv code first (fn2-pull-header-value next) (fn2-pull-header-value revision)
               (fn2-pull-header-value count) (fn2-pull-header-value stop)
               (fn2-fields-ref-off (+ base *fn2-xfnc-batch-header-field-chain*) fn2-fields) fn2-fields))
         (mv code first next revision count stop chain fn2-core)))
      ((unless (and (eq code :ok) (unsigned-byte-p 32 first) (unsigned-byte-p 60 after)
                    (unsigned-byte-p 60 next) (posp revision) (unsigned-byte-p 60 revision)
                    (unsigned-byte-p 32 count) (<= count *fn2-peer-pull-max-page-items*)
                    (unsigned-byte-p 32 chain)
                    (or absent (equal revision (fn2-pull-row import-revision)))))
       (mv :scope fn2-core))
      (a (nfix (fn2-pull-row import-prev-a))) (b (nfix (fn2-pull-row import-prev-b)))
      (c (nfix (fn2-pull-row import-prev-c))) (d (nfix (fn2-pull-row import-prev-d))) (e (nfix (fn2-pull-row import-prev-e)))
      ((mv hash fn2-core)
       (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-b3 (fn2-core-b3 fn2-core)))
         (hash fn2-digests fn2-b3)
         (let ((dst (fn2-digest-slot (nfix row) *fn2-xfnc-chain-region*)))
           (cond ((not (fn2-digest-rowp dst fn2-digests)) (mv :state fn2-digests fn2-b3))
                 (absent (fn2-xfnc-chain-genesis row history incarnation revision pid view version
                           *fn2-xfnc-batch-interpretation* fn2-digests fn2-b3))
                 (t (mv :ok (fn2-peer-pull-pack-digest dst 0
                             (logior (ash a 200) (ash b 144) (ash c 96) (ash d 48) e) fn2-digests) fn2-b3))))
         (mv hash fn2-core)))
      ((unless (eq hash :ok)) (mv :state fn2-core))
      (fn2-core (fn2-peer-pull-put-core id (import-step 1) (import-first first) (import-off first)
                   (import-left count) (import-count count) (import-last after) (import-next next)
                   (import-chain-off chain) (import-revision revision) (import-more (if (equal stop 0) 0 1)))))
   (mv :more fn2-core)))

(defun fn2-peer-pull-get-item (id generation row end fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                 :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
 (b* ((base (* 128 (nfix row))) (slot (fn2-pull-row rx-slot)) (gen (fn2-pull-row rx-gen))
      (offset (fn2-pull-row import-off)) (left (fn2-pull-row import-left))
      (previous (fn2-pull-row import-last)) (next (fn2-pull-row import-next)))
   (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
     (code off remaining position hs he es ee fn2-fields)
     (fn2-xfnc-get-batch-item base offset end left previous next slot gen *fn2-peer-pull-kind* id generation
       fn2-fields fn2-pool)
     (mv code off remaining position hs he es ee fn2-core))))
(fn2-core-preserves fn2-peer-pull-get-item (id generation row end fn2-core) :position 8 :rows nil)
(in-theory (disable fn2-peer-pull-get-item))

(fn2-csnapshot-op fn2-peer-pull-hash-item (id generation row position hs he ee) 1
 (b* ((slot (fn2-pull-row rx-slot)) (gen (fn2-pull-row rx-gen))
      ((unless (and (unsigned-byte-p 32 hs) (unsigned-byte-p 32 he) (unsigned-byte-p 32 ee)
                    (< hs he) (< he ee) (unsigned-byte-p 32 (- ee hs)))) (mv :scope fn2-core)))
   (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-b3 (fn2-core-b3 fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
     (code fn2-digests fn2-b3)
     (b* (((mv code fn2-digests fn2-b3)
           (fn2-xfnc-chain-item-begin row position (- he hs) (- ee he) fn2-digests fn2-b3))
          ((unless (and (eq code :ok) (fn2-b3-ready row fn2-b3 fn2-digests))) (mv :scope fn2-digests fn2-b3))
          ((mv code used fn2-digests fn2-b3)
           (fn2-b3-update row slot gen hs (- ee hs) *fn2-peer-pull-kind* id generation fn2-digests fn2-b3 fn2-pool))
          ((unless (and (eq code :ok) (equal used (- ee hs)))) (mv :scope fn2-digests fn2-b3))
          ((mv code fn2-digests) (fn2-xfnc-chain-item-finish row fn2-digests fn2-b3)))
       (mv code fn2-digests fn2-b3))
     (mv code fn2-core))))

(fn2-csnapshot-op fn2-peer-pull-chain-turn (id generation row end) 1
 (b* (((when (equal (fn2-pull-row import-left) 0))
       (b* ((slot (fn2-pull-row rx-slot)) (gen (fn2-pull-row rx-gen)) (chain (fn2-pull-row import-chain-off))
            (dst (fn2-digest-slot (nfix row) *fn2-xfnc-chain-region*))
            (match (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (match)
                     (and (fn2-digest-rowp dst fn2-digests) (natp chain)
                          (fn2-fnct-trailer-matchp 0 dst slot gen chain *fn2-peer-pull-kind* id generation fn2-digests fn2-pool))
                     match))
            ((unless (and match (equal end (fn2-pull-row import-off))
                          (equal (fn2-pull-row import-last) (fn2-pull-row import-next)))) (mv :scope fn2-core))
            ((when (equal (fn2-pull-row import-count) 0)) (mv :done fn2-core))
            (fn2-core (fn2-peer-pull-put-core id (import-step 2) (import-off (fn2-pull-row import-first))
                       (import-left (fn2-pull-row import-count)) (import-last (fn2-pull-row resume-position))
                       (import-right 0) (import-own-step 0) (import-head 0) (import-grant 0)
                       (import-anchor 0) (import-depend 0))))
         (mv :more fn2-core)))
      ((mv code off left position hs he & ee fn2-core) (fn2-peer-pull-get-item id generation row end fn2-core))
      ((unless (and (eq code :ok) (unsigned-byte-p 32 off) (unsigned-byte-p 32 left) (unsigned-byte-p 60 position)))
       (mv :scope fn2-core))
      ((mv hash fn2-core) (fn2-peer-pull-hash-item id generation row position hs he ee fn2-core))
      ((unless (eq hash :ok)) (mv hash fn2-core))
      (fn2-core (fn2-peer-pull-put-core id (import-off off) (import-left left) (import-last position))))
   (mv :more fn2-core)))

(fn2-csnapshot-op fn2-peer-pull-authority-turn (id) 1
 (b* (((mv rc & x) (fn2-peer-pull-c-rows id fn2-core))
      ((unless (eq rc :ok)) (mv :state fn2-core))
      (right (fn2-pull-row import-right))
      (pid (fn2-pull-row local-principal))
      ((unless (and (member-equal right '(0 1 2)) (eq (fn2-auth-known pid fn2-core) :ok))) (mv :scope fn2-core))
      ((mv code step head grant fn2-core)
       (fn2-authority-principal-allows x pid
        (case right (0 *fn2-authority-right-peer*) (1 *fn2-authority-right-peer-accept*) (otherwise *fn2-authority-right-append*))
        (if (equal right 0) *fn2-authority-scope-principal* *fn2-authority-scope-stream*)
        (if (equal right 0) 0 (fn2-pull-row stream))
        (fn2-pull-row import-own-step) (fn2-pull-row import-head) (fn2-pull-row import-grant) 2048 fn2-core))
      ((when (and (eq code :more) (unsigned-byte-p 8 step) (unsigned-byte-p 60 head) (unsigned-byte-p 60 grant)))
       (mv :more (fn2-peer-pull-put-core id (import-own-step step) (import-head head) (import-grant grant))))
      ((unless (and (eq code :ok) (posp head) (unsigned-byte-p 60 head) (posp grant) (unsigned-byte-p 60 grant)
                    (or (equal right 0) (equal head (fn2-pull-row import-anchor)))))
       (mv :scope fn2-core)))
   (mv :more (fn2-peer-pull-put-core id (import-step (if (equal right 2) 3 2))
              (import-right (if (equal right 0) 1 2)) (import-own-step 0) (import-head 0) (import-grant 0)
              (import-anchor head) (import-depend grant)))))

(fn2-csnapshot-op fn2-peer-pull-import-turn (id generation start end budget) 1
 (b* (((unless (and (fn2-peer-pull-import-live-p id generation fn2-core)
                    (equal (fn2-pull-row phase) *fn2-peer-pull-state-import*)
                    (equal start (fn2-pull-row result-off)) (equal end (fn2-pull-row result-end))))
        (mv :scope fn2-core))
      ((mv fc row) (fn2-peer-pull-fc-row id fn2-core))
      ((unless (eq fc :ok)) (mv :state fn2-core))
      (tx (fn2-pull-row import-tx)) (step (fn2-pull-row import-step))
      (hbase (* 128 (nfix row))) (ebase (+ hbase *fn2-identity-history-entry-num-fields*)))
   (case step
    (0 (fn2-peer-pull-header-turn id generation start end row fn2-core))
    (1 (fn2-peer-pull-chain-turn id generation row end fn2-core))
    (2 (fn2-peer-pull-authority-turn id fn2-core))
    (3 (b* (((mv code off left position hs he es ee fn2-core) (fn2-peer-pull-get-item id generation row end fn2-core))
            ((unless (and (eq code :ok) (unsigned-byte-p 32 off) (unsigned-byte-p 32 left) (unsigned-byte-p 60 position)))
             (mv :scope fn2-core))
            ((mv began fn2-core)
             (fn2-peer-import-start-item tx ebase hbase (fn2-pull-row rx-slot) (fn2-pull-row rx-gen)
                hs he es ee *fn2-peer-pull-kind* id generation fn2-core))
            ((unless (eq began :ok)) (mv began fn2-core))
            (fn2-core (fn2-peer-pull-put-core id (import-step 4) (import-off off) (import-left left) (import-last position))))
         (mv :more fn2-core)))
    (4 (b* (((mv code fn2-core) (fn2-identity-decide tx (min 2048 (nfix budget)) fn2-core))
            ((when (eq code :more)) (mv :more fn2-core))
            ((unless (member-eq code '(:stored :evidence :conflict :duplicate))) (mv code fn2-core)))
         (mv :more (fn2-peer-pull-put-core id (import-step 5)))))
    (5 (b* (((mv code fn2-core) (fn2-peer-import-declare tx ebase hbase t *fn2-peer-pull-kind* id generation fn2-core))
            ((unless (eq code :ok)) (mv code fn2-core))
            ((mv code fn2-core) (fn2-authority-depend tx (fn2-pull-row local-principal)
                                  (fn2-pull-row import-depend) (fn2-pull-row import-anchor) fn2-core))
            ((unless (eq code :ok)) (mv code fn2-core)))
         (mv :more (fn2-peer-pull-put-core id (import-step 6)))))
    (6 (mv-let (code fn2-core) (fn2-successor-resolve tx (min 2048 (nfix budget)) fn2-core)
         (mv (if (eq code :ok) :ready code) fn2-core)))
    (otherwise (mv :state fn2-core)))))

;; This callback is reached by :commit's accepted settlement or by its
;; already-present outcome after exact union comparison. It has no way to
;; declare the checkpoint. The caller enters :checkpoint on :last only.
(fn2-csnapshot-op fn2-peer-pull-import-settled (id generation) 1
 (b* ((tx (fn2-pull-row import-tx))
      ((unless (and (fn2-peer-pull-import-live-p id generation fn2-core)
                    (member-equal (fn2-pull-row phase) (list *fn2-peer-pull-state-item-ready* *fn2-peer-pull-state-item-settled*))
                    (equal (fn2-pull-row import-step) 6))) (mv :state fn2-core))
      ((mv code fn2-core) (fn2-peer-import-release tx *fn2-peer-pull-kind* id generation fn2-core))
      ((unless (eq code :ok)) (mv code fn2-core))
      (last (equal (fn2-pull-row import-left) 0))
      ((unless (or (not last) (equal (fn2-pull-row import-last) (fn2-pull-row import-next)))) (mv :state fn2-core))
      (fn2-core (fn2-peer-pull-put-core id (import-step (if last 0 3)))))
   (mv (if last :last :more) fn2-core)))

(fn2-csnapshot-op fn2-peer-pull-checkpoint-turn (id generation budget) 1
 (b* (((unless (and (fn2-peer-pull-import-live-p id generation fn2-core)
                    (equal (fn2-pull-row phase) *fn2-peer-pull-state-checkpoint*)
                    (posp (fn2-pull-row import-count)) (equal (fn2-pull-row import-left) 0)
                    (equal (fn2-pull-row import-last) (fn2-pull-row import-next))))
        (mv :state fn2-core))
      (tx (fn2-pull-row import-tx))
      ((unless (equal (fn2-pull-row import-step) 0))
       (mv-let (code fn2-core) (fn2-successor-resolve tx (min 2048 (nfix budget)) fn2-core)
         (mv (if (eq code :ok) :ready code) fn2-core)))
      (slot (fn2-pull-row rx-slot)) (gen (fn2-pull-row rx-gen)) (off (nfix (fn2-pull-row import-chain-off)))
      ((mv match a b c d e)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (match a b c d e)
         (b* (((mv oa a) (fn2-cns-read-be 0 7 off 0 slot gen *fn2-peer-pull-kind* id generation fn2-pool))
              ((mv ob b) (fn2-cns-read-be 0 7 (+ off 7) 0 slot gen *fn2-peer-pull-kind* id generation fn2-pool))
              ((mv oc c) (fn2-cns-read-be 0 6 (+ off 14) 0 slot gen *fn2-peer-pull-kind* id generation fn2-pool))
              ((mv od d) (fn2-cns-read-be 0 6 (+ off 20) 0 slot gen *fn2-peer-pull-kind* id generation fn2-pool))
              ((mv oe e) (fn2-cns-read-be 0 6 (+ off 26) 0 slot gen *fn2-peer-pull-kind* id generation fn2-pool)))
           (mv (and oa ob oc od oe) a b c d e))
         (mv match a b c d e)))
      ((unless match) (mv :scope fn2-core))
      ((mv code fn2-core)
       (fn2-peer-checkpoint-declare tx (fn2-pull-row local-principal) (fn2-pull-row consumer) (fn2-pull-row stream)
         (fn2-pull-row remote-history) (fn2-pull-row remote-incarnation) (fn2-pull-row import-revision)
         (fn2-pull-row source-stream) (fn2-pull-row remote-view) (fn2-pull-row source-principal)
         (fn2-pull-row source-epoch) (fn2-pull-row source-version) *fn2-xfnc-batch-interpretation*
         (fn2-pull-row resume-position) (fn2-pull-row import-next) (fn2-pull-row import-absent)
         (fn2-pull-row import-prev-a) (fn2-pull-row import-prev-b) (fn2-pull-row import-prev-c)
         (fn2-pull-row import-prev-d) (fn2-pull-row import-prev-e) a b c d e fn2-core))
      ((unless (eq code :ok)) (mv code fn2-core))
      ((mv code fn2-core) (fn2-authority-depend tx (fn2-pull-row local-principal)
                            (fn2-pull-row import-depend) (fn2-pull-row import-anchor) fn2-core))
      ((unless (eq code :ok)) (mv code fn2-core))
      (fn2-core (fn2-peer-pull-put-core id (import-step 1))))
   (mv :more fn2-core)))

(fn2-csnapshot-op fn2-peer-pull-import-drain (id generation) 1
 (b* (((unless (and (eq (fn2-peer-pull-snapshot-read-code id fn2-core) :ok)
                    (equal generation (fn2-machine-generation id fn2-core))
                    (equal (fn2-pull-row phase) *fn2-peer-pull-state-draining*)))
        (mv :state fn2-core))
      ((mv code tx x) (fn2-peer-pull-c-rows id fn2-core))
      ((unless (eq code :ok)) (mv :state fn2-core))
      ((mv read fn2-core) (fn2-read-release x fn2-core))
      ((unless (eq read :ok)) (mv :state fn2-core)))
   (if (fn2-peer-import-owned-p tx *fn2-peer-pull-kind* id generation fn2-core)

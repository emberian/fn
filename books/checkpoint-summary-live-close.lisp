; Close the live catalog only from the actual completed publication authority.
; Source-build1 and shared metadata scratch may already serve archive work.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-summary-live-catalog")
(include-book "checkpoint-summary-authority-state")
(fn2-book-layer :c)
(defun fn2-checkpoint-summary-live-close-source-p (fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes) :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary)
              (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority)
              (fn2-checkpoints-wfp fn2-checkpoints)
              (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes))))
 (and (< 1 (fn2-checkpoint-summary-rows fn2-checkpoint-summary))
      (= (fn2-checkpoint-summary-phase 1 fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-capture*)
      (fn2-checkpoint-summary-authority-row-complete-p 1 fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
      (= (fn2-checkpoint-summary-authority-origin 1 fn2-checkpoint-summary-authority) *fn2-checkpoint-summary-authority-origin-live*)
      (= (fn2-checkpoint-summary-tag 1 fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-catalog-tag 1 fn2-checkpoint-summary-authority))
      (= (fn2-checkpoint-summary-generation 1 fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-tag 1 fn2-checkpoint-summary-authority))
      (= (fn2-checkpoint-summary-count 1 fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-source-count 1 fn2-checkpoint-summary-authority))
      (= (fn2-checkpoint-summary-installed 1 fn2-checkpoint-summary) 0)
      (= (fn2-checkpoint-summary-lease-count 1 fn2-checkpoint-summary) 0)
      (= (fn2-checkpoint-summary-candidate 1 fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-candidate 1 fn2-checkpoint-summary-authority))
      (= (fn2-checkpoint-summary-checkpoint 1 fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-checkpoint 1 fn2-checkpoint-summary-authority))
      (= (fn2-checkpoint-summary-cut-commit 1 fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-cut-commit 1 fn2-checkpoint-summary-authority))
      (= (fn2-checkpoint-summary-cut-event 1 fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-cut-event 1 fn2-checkpoint-summary-authority))
      (= (fn2-checkpoint-summary-history 1 fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-history 1 fn2-checkpoint-summary-authority))
      (= (fn2-checkpoint-summary-incarnation 1 fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-incarnation 1 fn2-checkpoint-summary-authority))
      (= (fn2-checkpoint-summary-owner-kind 1 fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-owner-kind 1 fn2-checkpoint-summary-authority))
      (= (fn2-checkpoint-summary-owner-slot 1 fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-owner-slot 1 fn2-checkpoint-summary-authority))
      (= (fn2-checkpoint-summary-owner-gen 1 fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-owner-gen 1 fn2-checkpoint-summary-authority))))
(defun fn2-checkpoint-summary-live-copy-descriptor (i fn2-checkpoint-summary fn2-checkpoint-summary-authority)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-summary-authority) :measure (nfix (- 32 (nfix i)))
  :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority)
              (natp i) (<= i 32))))
 (if (>= (nfix i) 32) fn2-checkpoint-summary
  (let ((fn2-checkpoint-summary (update-fn2-checkpoint-summary-descriptori (+ 32 i)
          (fn2-checkpoint-summary-authority-descriptori (+ 32 i) fn2-checkpoint-summary-authority) fn2-checkpoint-summary)))
   (fn2-checkpoint-summary-live-copy-descriptor (+ 1 i) fn2-checkpoint-summary fn2-checkpoint-summary-authority))))
(defun fn2-checkpoint-summary-live-close (fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes) :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary)
              (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority)
              (fn2-checkpoints-wfp fn2-checkpoints)
              (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes))))
 (if (not (fn2-checkpoint-summary-live-close-source-p fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)) (mv :source fn2-checkpoint-summary)
  (let* ((fn2-checkpoint-summary (fn2-checkpoint-summary-live-copy-descriptor 0 fn2-checkpoint-summary fn2-checkpoint-summary-authority))
         (fn2-checkpoint-summary (fn2-checkpoint-summary-set-phase 1 *fn2-checkpoint-summary-phase-captured* fn2-checkpoint-summary)))
   (mv :captured fn2-checkpoint-summary))))
(defcost fn2-checkpoint-summary-live-close-op :child fn2-checkpoint-summary-live-close :answers (:source :captured)
 :steps *fn2-work-stage* :bytes 32 :descriptors 0
 :tables (fn2-core-checkpoint-summary fn2-core-checkpoint-summary-authority fn2-core-checkpoints fn2-core-checkpoint-refs fn2-core-checkpoint-bytes)
 :doc "Close the exact pending live catalog from the completed actual publication authority.")

; Role0/1 are runtime bank publications. Role2..5 preserve every individual
; cold anchor; state1=selectable,2=displaced pending exact evidence transfer,
; state3=transferred. Transfer does not remove candidate lifetime edges.
(defun fn2-checkpoint-bank-obligation-state (role fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :guard (and (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
  (fn2-checkpoint-bank-obligations-capacityp fn2-checkpoint-publication) (natp role) (< role 6))))
 (case role
  (0 (fn2-checkpoint-publication-bank0-valid 0 fn2-checkpoint-publication))
  (1 (fn2-checkpoint-publication-bank1-valid 0 fn2-checkpoint-publication))
  (otherwise (let ((s (- role 2)))
   (cond ((fn2-checkpoint-bank-obligation-memberp s (fn2-checkpoint-publication-cold-live-mask 0 fn2-checkpoint-publication)) 1)
         ((fn2-checkpoint-bank-obligation-memberp s (fn2-checkpoint-publication-cold-pending-mask 0 fn2-checkpoint-publication)) 2)
         ((fn2-checkpoint-bank-obligation-memberp s (fn2-checkpoint-publication-cold-retired-mask 0 fn2-checkpoint-publication)) 3)
         (t 0))))))
(defun fn2-checkpoint-bank-obligation-identity (role field fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :guard (and (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
  (fn2-checkpoint-bank-obligations-capacityp fn2-checkpoint-publication) (natp role) (< role 6) (natp field) (< field 5))))
 (cond ((equal field 0) (fn2-checkpoint-bank-obligation-state role fn2-checkpoint-publication))
       ((< role 2) (fn2-checkpoint-bank-evidence-id-scalar role field fn2-checkpoint-publication))
       ((equal field 1) (fn2-checkpoint-publication-cold-catalogi (- role 2) fn2-checkpoint-publication))
       (t (fn2-checkpoint-publication-cold-metai (+ (* 12 (- role 2)) field) fn2-checkpoint-publication))))
; Thirty raw role fields plus binding phase and mask. This is exact equality
; evidence for wake decisions, not a hash, version counter or eligibility flag.
(defun fn2-checkpoint-bank-obligations-observe (i fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :guard (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)))
 (if (not (and (natp i) (< i 32) (fn2-checkpoint-bank-obligations-capacityp fn2-checkpoint-publication))) 0
  (cond ((equal i 0) (fn2-checkpoint-publication-cold-bind-phase 0 fn2-checkpoint-publication))
        ((equal i 1) (fn2-checkpoint-publication-cold-bound-mask 0 fn2-checkpoint-publication))
        (t (fn2-checkpoint-bank-obligation-identity (floor (- i 2) 5) (mod (- i 2) 5) fn2-checkpoint-publication)))))
(defun fn2-checkpoint-bank-obligations-exclude-loop (role c checkpoint history incarnation fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :measure (nfix (- 6 (nfix role)))
 :guard (and (fn2-checkpoint-publication-wfp fn2-checkpoint-publication) (fn2-checkpoint-bank-obligations-capacityp fn2-checkpoint-publication)
  (natp role) (<= role 6))))
 (or (>= (nfix role) 6)
  (and (or (not (member-equal (fn2-checkpoint-bank-obligation-state role fn2-checkpoint-publication) '(1 2)))
           (and (not (equal c (fn2-checkpoint-bank-obligation-identity role 1 fn2-checkpoint-publication)))
                (not (and (equal checkpoint (fn2-checkpoint-bank-obligation-identity role 2 fn2-checkpoint-publication))
                          (equal history (fn2-checkpoint-bank-obligation-identity role 3 fn2-checkpoint-publication))
                          (equal incarnation (fn2-checkpoint-bank-obligation-identity role 4 fn2-checkpoint-publication))))))
       (fn2-checkpoint-bank-obligations-exclude-loop (+ role 1) c checkpoint history incarnation fn2-checkpoint-publication))))


  (and (or (not (fn2-checkpoint-bank-obligation-memberp slot (fn2-checkpoint-publication-cold-bound-mask 0 fn2-checkpoint-publication)))
           (and (equal (fn2-checkpoint-publication-cold-metai (* 12 slot) fn2-checkpoint-publication) 2)
                (equal (fn2-checkpoint-publication-cold-metai (+ (* 12 slot) 11) fn2-checkpoint-publication) 48)
                (equal (fn2-checkpoint-publication-cold-metai (+ (* 12 slot) 1) fn2-checkpoint-publication) slot)

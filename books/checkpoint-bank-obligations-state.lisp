(defun fn2-checkpoint-bank-obligations-complete-p (fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :guard (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)))
 (and (fn2-checkpoint-bank-obligations-masksp fn2-checkpoint-publication)
      (equal (fn2-checkpoint-publication-cold-bind-phase 0 fn2-checkpoint-publication) *fn2-checkpoint-cold-bind-phase-complete*)

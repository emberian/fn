; A successful covering Fence replaces both physical slots of its exact bank.
; Keep both old obligations pending until candidate-owned evidence transfer.
(defun fn2-checkpoint-bank-obligations-record-fence (fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :guard (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)))
 (if (not (and (fn2-checkpoint-bank-obligations-complete-p fn2-checkpoint-publication)
               (equal (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication) *fn2-checkpoint-publication-phase-wait-fence*)
               (equal (fn2-checkpoint-publication-cold-pending-mask 0 fn2-checkpoint-publication) 0)))
     fn2-checkpoint-publication
  (let* ((bank-mask (if (equal (fn2-checkpoint-publication-bank 0 fn2-checkpoint-publication) 0) 3 12))
         (live (fn2-checkpoint-publication-cold-live-mask 0 fn2-checkpoint-publication))
         (replaced (logand live bank-mask))
         (fn2-checkpoint-publication (fn2-checkpoint-publication-put 0
          (cold-live-mask (logand live (logxor 15 bank-mask))) (cold-pending-mask replaced))))
   fn2-checkpoint-publication)))

; The scoped peer profile of the R carrier's existing FNCT requests.
; The carrier retains the authenticated connection's exact, opened frame.
(in-package "ACL2")
(include-book "cns")
(fn2-book-layer :e)

; A peer registers one stream. The canonical stream list encodes each
; name as (:octets 64), inside REGISTER's length-prefixed streams field.
(deflayout fn2-xfnc-stream-name '((name (:octets 64))))

(defun fn2-xfnc-decode-register (base start end slot gen kind owner generation fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool)
                  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)
                              (natp base) (<= (+ base 128) (fn2-fields-rows fn2-fields)))))
  (b* (((mv code next fn2-fields)
        (fn2-fnct-k4-register-query-decode base slot gen start end kind owner generation fn2-fields fn2-pool))
       ((unless (and (eq code :ok) (equal next end)
                     (equal (fn2-fields-value (+ base *fn2-fnct-k4-register-query-field-code*) fn2-fields)
                            (cadr (fn2-consumer-remote-binding 'register)))))
        (mv :frame 0 0 0 fn2-fields))
       ((unless (equal 1 (fn2-fields-value (+ base *fn2-fnct-k4-register-query-field-start*) fn2-fields)))
        (mv :query 0 0 0 fn2-fields))
       (ci (+ base *fn2-fnct-k4-register-query-field-consumer*))
       ((mv ok consumer width) (fn2-cns-field-be ci 8 slot gen kind owner generation fn2-fields fn2-pool))
       ((unless (and ok (posp consumer) (equal width (fn2-fnct-be-width consumer))))
        (mv :query 0 0 0 fn2-fields))
       (si (+ base *fn2-fnct-k4-register-query-field-streams*))
       (begin (nfix (fn2-fields-ref-off si fn2-fields)))
       (limit (+ begin (nfix (fn2-fields-ref-len si fn2-fields))))
       ((mv sc snext fn2-fields)
        (fn2-xfnc-stream-name-decode base slot gen begin limit kind owner generation fn2-fields fn2-pool))
       (offset (fn2-fields-ref-off (+ base *fn2-xfnc-stream-name-field-name*) fn2-fields))
       (length (fn2-fields-ref-len (+ base *fn2-xfnc-stream-name-field-name*) fn2-fields)))
    (if (and (eq sc :ok) (equal snext limit) (unsigned-byte-p 32 offset) (posp length) (<= length 64))
        (mv :ok consumer offset length fn2-fields)
      (mv :query 0 0 0 fn2-fields))))
(fn2-pool-block-shape fn2-xfnc-decode-register-shape
  (fn2-xfnc-decode-register base start end slot gen kind owner generation fn2-fields fn2-pool)
  (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
       (natp base) (<= (+ base 128) (fn2-fields-rows fn2-fields)))
  ((fn2-fields 4))
  (("Goal" :in-theory (e/d (fn2-xfnc-decode-register)
                           (fn2-fieldsp fn2-fields-wfp fn2-poolp fn2-pool-wfp fn2-fields-rows)))))
(in-theory (disable fn2-xfnc-decode-register))

; Both published cursor versions have identical identity fields. The
; domain and counters are decoded with their respective generated layouts.
(assert-event
 (and (equal *fn2-fncu-v1-field-magic* *fn2-fncu-v2-field-magic*)
      (equal *fn2-fncu-v1-field-history* *fn2-fncu-v2-field-history*)
      (equal *fn2-fncu-v1-field-incarnation* *fn2-fncu-v2-field-incarnation*)
      (equal *fn2-fncu-v1-field-consumer* *fn2-fncu-v2-field-consumer*)
      (equal *fn2-fncu-v1-field-principal* *fn2-fncu-v2-field-principal*)
      (equal *fn2-fncu-v1-field-query* *fn2-fncu-v2-field-query*)
      (<= *fn2-fncu-v1-num-fields* 128) (<= *fn2-fncu-v2-num-fields* 128)))
(defun fn2-xfnc-cursor-id (i slot gen kind owner generation fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool)
                  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)
                              (natp i) (< i (fn2-fields-rows fn2-fields)))))
  (mv-let (ok id width) (fn2-cns-field-be i 8 slot gen kind owner generation fn2-fields fn2-pool)
    (if (and ok (posp id) (equal width (fn2-fnct-be-width id))) id 0)))
(in-theory (disable fn2-xfnc-cursor-id))

(defun fn2-xfnc-decode-cursor (base start end principal history incarnation
                               slot gen kind owner generation fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool)
                  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)
                              (natp base) (<= (+ base 128) (fn2-fields-rows fn2-fields)))))
  (b* (((unless (< (+ 4 (nfix start)) (nfix end))) (mv :frame 0 0 0 0 0 0 fn2-fields))
       ((mv vc version) (fn2-pool-read slot gen (+ 4 (nfix start)) kind owner generation fn2-pool))
       ((unless (and (eq vc :ok) (member-equal version '(1 2))))
        (mv :cursor-version 0 0 0 0 0 0 fn2-fields))
       (v1 (equal version 1))
       ((mv code next fn2-fields)
        (if v1
            (fn2-fncu-v1-decode base slot gen start end kind owner generation fn2-fields fn2-pool)
          (fn2-fncu-v2-decode base slot gen start end kind owner generation fn2-fields fn2-pool)))
       ((unless (and (eq code :ok) (equal next end)
                     (equal *fn2-fncu-magic* (fn2-fields-value (+ base *fn2-fncu-v1-field-magic*) fn2-fields))))
        (mv :frame 0 0 0 0 0 0 fn2-fields))
       (h (fn2-xfnc-cursor-id (+ base *fn2-fncu-v1-field-history*) slot gen kind owner generation fn2-fields fn2-pool))
       (inc (fn2-xfnc-cursor-id (+ base *fn2-fncu-v1-field-incarnation*) slot gen kind owner generation fn2-fields fn2-pool))
       (pid (fn2-xfnc-cursor-id (+ base *fn2-fncu-v1-field-principal*) slot gen kind owner generation fn2-fields fn2-pool))
       (consumer (fn2-xfnc-cursor-id (+ base *fn2-fncu-v1-field-consumer*) slot gen kind owner generation fn2-fields fn2-pool))
       (query (fn2-xfnc-cursor-id (+ base *fn2-fncu-v1-field-query*) slot gen kind owner generation fn2-fields fn2-pool))
       ((unless (and (fn2-origin-physicalp history incarnation) (equal h history) (equal inc incarnation)
                     (posp pid) (equal pid principal) (posp consumer) (posp query)
                     (or v1 (equal 0 (fn2-fields-value (+ base *fn2-fncu-v2-field-domain*) fn2-fields)))))
        (mv :scope 0 0 0 0 0 0 fn2-fields))
       (query-version (fn2-fields-value (+ base (if v1 *fn2-fncu-v1-field-query-version*
                                                 *fn2-fncu-v2-field-query-version*)) fn2-fields))
       (view (fn2-fields-value (+ base (if v1 *fn2-fncu-v1-field-view-version*
                                        *fn2-fncu-v2-field-view-version*)) fn2-fields))
       (epoch (fn2-fields-value (+ base (if v1 *fn2-fncu-v1-field-epoch* *fn2-fncu-v2-field-epoch*)) fn2-fields))
       (position (fn2-fields-value (+ base (if v1 *fn2-fncu-v1-field-position*
                                            *fn2-fncu-v2-field-position*)) fn2-fields)))
    (if (and (posp query-version) (unsigned-byte-p 60 query-version)
             (posp view) (unsigned-byte-p 60 view) (posp epoch) (unsigned-byte-p 32 epoch)
             (unsigned-byte-p 60 position))
        (mv :ok query consumer epoch query-version view position fn2-fields)
      (mv :scope 0 0 0 0 0 0 fn2-fields))))
(fn2-pool-block-shape fn2-xfnc-decode-cursor-shape
  (fn2-xfnc-decode-cursor base start end principal history incarnation slot gen kind owner generation fn2-fields fn2-pool)
  (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
       (natp base) (<= (+ base 128) (fn2-fields-rows fn2-fields)))
  ((fn2-fields 7))
  (("Goal" :in-theory (e/d (fn2-xfnc-decode-cursor)
                           (fn2-fieldsp fn2-fields-wfp fn2-poolp fn2-pool-wfp fn2-fields-rows)))))
(in-theory (disable fn2-xfnc-decode-cursor))

(defun fn2-xfnc-decode-read (base start end principal history incarnation
                             slot gen kind owner generation fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool)
                  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)
                              (natp base) (<= (+ base 128) (fn2-fields-rows fn2-fields)))))
  (b* (((mv code next fn2-fields)
        (fn2-fnct-k4-read-decode base slot gen start end kind owner generation fn2-fields fn2-pool))
       ((unless (and (eq code :ok) (equal next end)
                     (equal (fn2-fields-value (+ base *fn2-fnct-k4-read-field-code*) fn2-fields)
                            (cadr (fn2-consumer-remote-binding 'read)))))
        (mv :frame 0 0 0 0 0 0 0 0 fn2-fields))
       (items (fn2-fields-value (+ base *fn2-fnct-k4-read-field-max-items*) fn2-fields))
       (octets (fn2-fields-value (+ base *fn2-fnct-k4-read-field-max-octets*) fn2-fields))
       ((unless (and (posp items) (unsigned-byte-p 32 items) (posp octets) (unsigned-byte-p 32 octets)))
        (mv :meter 0 0 0 0 0 0 0 0 fn2-fields))
       (ci (+ base *fn2-fnct-k4-read-field-cursor*))
       (offset (nfix (fn2-fields-ref-off ci fn2-fields)))
       (limit (+ offset (nfix (fn2-fields-ref-len ci fn2-fields))))
       ((mv cursor query consumer epoch version view position fn2-fields)
        (fn2-xfnc-decode-cursor base offset limit principal history incarnation
                                 slot gen kind owner generation fn2-fields fn2-pool)))
    (if (eq cursor :ok)
        (mv :ok query consumer epoch version view position items octets fn2-fields)
      (mv cursor 0 0 0 0 0 0 0 0 fn2-fields))))
(fn2-pool-block-shape fn2-xfnc-decode-read-shape
  (fn2-xfnc-decode-read base start end principal history incarnation slot gen kind owner generation fn2-fields fn2-pool)
  (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
       (natp base) (<= (+ base 128) (fn2-fields-rows fn2-fields)))
  ((fn2-fields 9))
  (("Goal" :in-theory (e/d (fn2-xfnc-decode-read)
                           (fn2-fieldsp fn2-fields-wfp fn2-poolp fn2-pool-wfp fn2-fields-rows)))))
(in-theory (disable fn2-xfnc-decode-read))

(defcost fn2-xfnc-peer-request :answers t :bytes 8192
 :tables (fn2-core-reads fn2-core-ranges fn2-core-seeks fn2-core-succ-txns fn2-core-run-cursors fn2-core-run-paths
          fn2-core-fields fn2-core-machines fn2-core-control fn2-cursor-table fn2-cns-table fn2-core-pool)
 :doc "Decode, authorize and settle one step of the linked protected REGISTER or READ.")
(defcost fn2-xfnc-peer-cancel :answers (:ok)
 :tables (fn2-core-machines fn2-core-control)
 :doc "Wake the exact peer registration row for owner-loss cleanup, without changing an admitted ticket.")

(defmacro fn2-xfnc-request-status (code)
  `(mv ,code 0 0 0 0 0 0 0 0 fn2-core))

(defmacro fn2-xfnc-request-events ()
 '(progn
   (fn2-csnapshot-op fn2-xfnc-peer-open-request (cursor conn cgen principal verb) 1
    (b* (((mv fc row) (fn2-xfnc-fc-row conn fn2-core))
         (first (fn2-conn-row-line-s conn fn2-core))
         (last (fn2-conn-row-line-e conn fn2-core))
         (slot (fn2-conn-row-rx-slot conn fn2-core)) (gen (fn2-conn-row-rx-gen conn fn2-core))
         ((unless (and (eq fc :ok) (natp row) (natp first) (natp last)
                       (equal first (fn2-cursor-row-line-s cursor fn2-core))
                       (equal last (fn2-cursor-row-line-e cursor fn2-core))
                       (equal slot (fn2-cursor-row-rx-slot cursor fn2-core))
                       (equal gen (fn2-cursor-row-rx-gen cursor fn2-core))
                       (< (+ first *fn2-fnct-overhead*) last)))
          (mv :frame fn2-core))
         (base (* 128 row)) (start (+ first *fn2-fnct-header-octets*))
         (end (- last *fn2-fnct-trailer-octets*)))
     (if (equal verb 1)
         (b* (((mv code consumer off len fn2-core)
               (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
                (code consumer off len fn2-fields)
                (if (and (<= (+ base 128) (fn2-fields-rows fn2-fields))
                         (eq (fn2-pool-workspace-code slot gen *fn2-conn-kind* conn cgen fn2-pool) :ok))
                    (fn2-xfnc-decode-register base start end slot gen *fn2-conn-kind* conn cgen fn2-fields fn2-pool)
                  (mv :frame 0 0 0 fn2-fields))
                (mv code consumer off len fn2-core)))
              ((unless (eq code :ok)) (mv code fn2-core))
              ((unless (and (posp consumer) (unsigned-byte-p 60 consumer) (unsigned-byte-p 32 off)
                            (posp len) (unsigned-byte-p 8 len))) (mv :frame fn2-core))
              (fn2-core (fn2-cursor-put-core cursor (peer-consumer consumer) (peer-name-off off) (peer-name-len len)
                                              (peer-stage *fn2-xfnc-request-stage-name-key*))))
          (mv :more fn2-core))
       (b* (((mv history incarnation) (fn2-core-history-values fn2-core))
            ((mv code stream consumer epoch version view position items octets fn2-core)
             (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
              (code stream consumer epoch version view position items octets fn2-fields)
              (if (and (<= (+ base 128) (fn2-fields-rows fn2-fields))
                       (eq (fn2-pool-workspace-code slot gen *fn2-conn-kind* conn cgen fn2-pool) :ok))
                  (fn2-xfnc-decode-read base start end principal history incarnation
                                       slot gen *fn2-conn-kind* conn cgen fn2-fields fn2-pool)
                (mv :frame 0 0 0 0 0 0 0 0 fn2-fields))
              (mv code stream consumer epoch version view position items octets fn2-core)))
            ((unless (eq code :ok)) (mv code fn2-core))
            ((unless (and (posp stream) (unsigned-byte-p 60 stream) (posp consumer) (unsigned-byte-p 60 consumer)
                          (unsigned-byte-p 32 epoch) (unsigned-byte-p 60 version) (unsigned-byte-p 60 view)
                          (unsigned-byte-p 60 position) (unsigned-byte-p 32 items) (unsigned-byte-p 32 octets)))
             (mv :scope fn2-core))
            (fn2-core (fn2-cursor-put-core cursor (peer-stage *fn2-xfnc-request-stage-rights*)
                      (peer-stream stream) (peer-consumer consumer) (peer-epoch epoch) (peer-version version)
                      (peer-view view) (peer-position position) (peer-items items) (peer-octets octets))))
        (mv :more fn2-core)))))
   (in-theory (disable fn2-xfnc-peer-open-request))

   (defun fn2-xfnc-peer-cns-owned-p (id gen cursor cgen fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (and (posp gen) (eq (fn2-cns-snapshot-read-code id fn2-core) :ok)
         (equal gen (fn2-machine-generation id fn2-core))
         (equal cursor (fn2-cns-row-request id fn2-core))
         (equal cgen (fn2-cns-row-peer-cursor-gen id fn2-core))
         (posp (fn2-cns-row-peer-stream id fn2-core))))
   (in-theory (disable fn2-xfnc-peer-cns-owned-p))

   (fn2-csnapshot-op fn2-xfnc-peer-cancel (cursor generation) 1
    (b* (((unless (and (eq (fn2-cursor-snapshot-read-code cursor fn2-core) :ok)
                       (equal generation (fn2-machine-generation cursor fn2-core))
                       (equal *fn2-xfnc-request-stage-waiting* (fn2-cursor-row-peer-stage cursor fn2-core))))
          (mv :ok fn2-core))
         (id (fn2-cursor-row-peer-cns cursor fn2-core))
         (gen (fn2-cursor-row-peer-cns-gen cursor fn2-core)))
      (mv :ok (if (fn2-xfnc-peer-cns-owned-p id gen cursor generation fn2-core)
                  (fn2-machine-wake-row id fn2-core) fn2-core))))
   (in-theory (disable fn2-xfnc-peer-cancel))

   (fn2-csnapshot-op fn2-xfnc-peer-submit (cursor generation conn cgen pid stream consumer head epoch) 1
    (b* ((grant (fn2-conn-row-peer-role-grant conn fn2-core))
         ((unless (and (unsigned-byte-p 32 cursor) (posp generation) (unsigned-byte-p 60 generation)
                       (unsigned-byte-p 32 conn) (posp cgen) (unsigned-byte-p 60 cgen)
                       (posp pid) (unsigned-byte-p 60 pid) (posp stream) (unsigned-byte-p 60 stream)
                       (posp consumer) (unsigned-byte-p 60 consumer) (posp head) (unsigned-byte-p 60 head)
                       (unsigned-byte-p 32 epoch) (unsigned-byte-p 32 (+ 1 epoch))
                       (posp grant) (unsigned-byte-p 60 grant))) (mv :scope fn2-core))
         ((mv code id gen fn2-core)
          (fn2-machine-take-fn2-cns *fn2-none* conn cgen cursor 0 0 0 *fn2-none* 0 fn2-core))
         ((unless (eq code :ok)) (mv :capacity fn2-core))
         ((unless (and (unsigned-byte-p 32 id) (posp gen) (unsigned-byte-p 60 gen))) (mv :state fn2-core))
         (fn2-core (fn2-cns-put-core id (phase *fn2-cns-state-peer-commit*)
                      (peer-cursor-gen generation) (peer-stream stream) (address-principal pid)
                      (consumer consumer) (epoch epoch) (page-head head) (xgrant grant)))
         (fn2-core (fn2-cursor-put-core cursor (peer-cns id) (peer-cns-gen gen)
                      (peer-stage *fn2-xfnc-request-stage-waiting*))))
      (mv :wait fn2-core)))
   (in-theory (disable fn2-xfnc-peer-submit))

   (fn2-csnapshot-op fn2-xfnc-peer-poll (cursor generation) 1
    (b* ((id (fn2-cursor-row-peer-cns cursor fn2-core)) (gen (fn2-cursor-row-peer-cns-gen cursor fn2-core))
         ((unless (fn2-xfnc-peer-cns-owned-p id gen cursor generation fn2-core)) (mv :state fn2-core))
         ((unless (equal (fn2-cns-row-phase id fn2-core) *fn2-cns-state-peer-settled*)) (mv :wait fn2-core))
         (outcome (fn2-cns-row-outcome id fn2-core))
         (fn2-core (fn2-cns-put-core id (phase *fn2-cns-state-draining*)))
         (fn2-core (fn2-machine-wake-row id fn2-core))
         (fn2-core (fn2-cursor-put-core cursor (peer-cns *fn2-none*) (peer-cns-gen 0)
                      (peer-readback 1) (peer-stage *fn2-xfnc-request-stage-rights*))))
      (mv (cond ((equal outcome *fn2-cns-outcome-accepted*) :more)
                ((equal outcome *fn2-cns-outcome-uncertain*) :uncertain)
                (t :refused)) fn2-core)))
   (in-theory (disable fn2-xfnc-peer-poll))

   ;; The secondary read row follows directory/registration lookups. The
   ;; primary row is reserved for the four coherent authority lookups.
   (fn2-csnapshot-op fn2-xfnc-peer-registration (cursor generation conn cgen pid verb x budget) 9
    (b* ((consumer (fn2-cursor-row-peer-consumer cursor fn2-core))
         (stream (fn2-cursor-row-peer-stream cursor fn2-core))
         (head (fn2-cursor-row-peer-head cursor fn2-core))
         ((mv code fn2-core) (fn2-read-lookup x *fn2-consumer-cursor-sid* budget fn2-core))
         ((when (eq code :more)) (fn2-xfnc-request-status :more))
         ((mv ps pos) (fn2-read-value x *fn2-consumer-cursor-entry-field-position* fn2-core))
         ((mv vs ver) (fn2-read-value x *fn2-consumer-cursor-entry-field-version* fn2-core))
         ((mv hs view) (fn2-read-value x *fn2-consumer-cursor-entry-field-view* fn2-core))
         ((mv es epoch) (fn2-read-value x *fn2-consumer-cursor-entry-field-epoch* fn2-core))
         ((mv ss stored) (fn2-read-value x *fn2-consumer-cursor-entry-field-peer-stream* fn2-core))
         ((mv release fn2-core) (fn2-read-release x fn2-core))
         ((unless (and (eq release :ok)
                       (or (eq code :absent)
                           (and (eq code :ok) (eq ps :ok) (eq vs :ok) (eq hs :ok) (eq es :ok) (eq ss :ok)
                                (unsigned-byte-p 32 epoch) (posp epoch) (unsigned-byte-p 60 pos)))))
          (fn2-xfnc-request-status :state))
         (inactive (or (eq code :absent) (and (equal ver 0) (equal stored 0))))
      (cond
       ((and inactive (equal verb 1))
        (if (equal (fn2-cursor-row-peer-readback cursor fn2-core) 0)
            (mv-let (answer fn2-core)
              (fn2-xfnc-peer-submit cursor generation conn cgen pid stream consumer head (if (eq code :absent) 0 epoch) fn2-core)
              (fn2-xfnc-request-status answer))
          (fn2-xfnc-request-status :uncertain)))
       (inactive (fn2-xfnc-request-status :unknown-consumer))
       ((not (and (equal stored stream) (equal ver 1) (equal view head)))
        (fn2-xfnc-request-status :rebase-required))
       ((equal verb 1)
        (let ((fn2-core (fn2-cursor-put-core cursor (peer-stage *fn2-xfnc-request-stage-confirm*)
                          (peer-epoch epoch) (peer-version 1) (peer-view view) (peer-position pos))))
          (fn2-xfnc-request-status :more)))
       (t
        (b* ((asked (fn2-cursor-row-peer-position cursor fn2-core))
             ((mv published tip) (fn2-successor-published fn2-core))
             ((unless (and (eq published :ok) (natp asked) (natp tip))) (fn2-xfnc-request-status :state))
             ((unless (and (equal epoch (fn2-cursor-row-peer-epoch cursor fn2-core))
                           (equal ver (fn2-cursor-row-peer-version cursor fn2-core))
                           (equal view (fn2-cursor-row-peer-view cursor fn2-core))))
              (fn2-xfnc-request-status :rebase-required))
             ((when (< asked pos)) (fn2-xfnc-request-status :behind))
             ((when (> asked tip)) (fn2-xfnc-request-status :beyond-frontier))
             (fn2-core (fn2-cursor-put-core cursor (peer-stage *fn2-xfnc-request-stage-confirm*))))
          (fn2-xfnc-request-status :more)))))))
   (in-theory (disable fn2-xfnc-peer-registration))

   (fn2-csnapshot-op fn2-xfnc-peer-request (cursor generation verb budget) 9
    (b* (((mv login pid conn cgen) (fn2-xfnc-live-login cursor generation fn2-core))
         ((unless (and (eq login :ok) (member-equal verb '(1 2)) (posp budget)))
          (fn2-xfnc-request-status :access))
         (x (+ 1 (* 2 (nfix (fn2-machine-slot cursor fn2-core)))))
         (stage (fn2-cursor-row-peer-stage cursor fn2-core))
         (stream (fn2-cursor-row-peer-stream cursor fn2-core)))
      (cond
       ((equal stage *fn2-xfnc-request-stage-decode*)
        (mv-let (code fn2-core) (fn2-xfnc-peer-open-request cursor conn cgen pid verb fn2-core)
          (fn2-xfnc-request-status code)))
       ((equal stage *fn2-xfnc-request-stage-name-key*)
        (b* (((mv code fn2-core)
              (fn2-read-key-octets x 0 (fn2-cursor-row-rx-slot cursor fn2-core) (fn2-cursor-row-rx-gen cursor fn2-core)
                 (fn2-cursor-row-peer-name-off cursor fn2-core) (fn2-cursor-row-peer-name-len cursor fn2-core)
                 *fn2-conn-kind* conn cgen fn2-core))
             ((unless (eq code :ok)) (fn2-xfnc-request-status :state))
             (fn2-core (fn2-cursor-put-core cursor (peer-stage *fn2-xfnc-request-stage-name*))))
          (fn2-xfnc-request-status :more)))
       ((equal stage *fn2-xfnc-request-stage-name*)

; Dedicated typed source retention, shared by actual checkpoint producers.
; The C/D caller establishes provenance from its held entry or verified page;
; this B seam checks exact allocation and individually owned edge identity.
(in-package "ACL2")
(include-book "checkpoint")
(fn2-book-layer :b)

(defun fn2-checkpoint-source-edge (c extent fn2-extents fn2-ops fn2-checkpoints)
 (declare (xargs :stobjs (fn2-extents fn2-ops fn2-checkpoints)
  :guard (and (fn2-extents-wfp fn2-extents) (fn2-ops-wfp fn2-ops) (fn2-checkpoints-wfp fn2-checkpoints)
              (natp c) (natp extent))))
 (+ 6 (* 2 (fn2-extents-rows fn2-extents)) (fn2-ops-rows fn2-ops)
    (* 6 (fn2-checkpoints-rows fn2-checkpoints)) (* c (fn2-extents-rows fn2-extents)) extent))

(defun fn2-checkpoint-source-claimedp (c checkpoint extent epoch allocation fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
 (declare (xargs :stobjs (fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
  :guard (and (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges)
              (fn2-ops-wfp fn2-ops) (fn2-checkpoints-wfp fn2-checkpoints))))
 (and (natp c) (< c (fn2-checkpoints-rows fn2-checkpoints)) (fn2-alloc-slotp extent fn2-extents)
      (posp checkpoint) (unsigned-byte-p 60 checkpoint)
      (equal (fn2-checkpoints-checkpoint c fn2-checkpoints) checkpoint)
      (fn2-checkpoint-builder-claimp c (fn2-checkpoints-builder-token c fn2-checkpoints)
       (fn2-checkpoints-builder-owner-kind c fn2-checkpoints) (fn2-checkpoints-builder-owner-slot c fn2-checkpoints)
       (fn2-checkpoints-builder-owner-gen c fn2-checkpoints) fn2-checkpoints)
      (let ((edge (fn2-checkpoint-source-edge c extent fn2-extents fn2-ops fn2-checkpoints)))
       (and (fn2-alloc-edge-slotp edge fn2-alloc-edges)
            (eq (fn2-alloc-handle-code extent epoch allocation fn2-extents) :ok)
            (or (fn2-alloc-edge-matchesp edge checkpoint extent epoch allocation :prepared-successor fn2-alloc-edges)
                (fn2-alloc-edge-matchesp edge checkpoint extent epoch allocation :selectable-checkpoint fn2-alloc-edges))))))

(defun fn2-checkpoint-source-claim (c checkpoint extent epoch allocation fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
 (declare (xargs :stobjs (fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
  :guard (and (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges)
              (fn2-ops-wfp fn2-ops) (fn2-checkpoints-wfp fn2-checkpoints))))
 (b* (((unless (and (natp c) (< c (fn2-checkpoints-rows fn2-checkpoints)) (fn2-alloc-slotp extent fn2-extents)
                     (posp checkpoint) (unsigned-byte-p 60 checkpoint) (unsigned-byte-p 60 epoch) (unsigned-byte-p 60 allocation)
                     (equal (fn2-checkpoints-checkpoint c fn2-checkpoints) checkpoint)
                     (fn2-checkpoint-builder-claimp c (fn2-checkpoints-builder-token c fn2-checkpoints)
                      (fn2-checkpoints-builder-owner-kind c fn2-checkpoints) (fn2-checkpoints-builder-owner-slot c fn2-checkpoints)
                      (fn2-checkpoints-builder-owner-gen c fn2-checkpoints) fn2-checkpoints)))
       (mv :bounds fn2-extents fn2-alloc-edges))
      (edge (fn2-checkpoint-source-edge c extent fn2-extents fn2-ops fn2-checkpoints))
      ((unless (fn2-alloc-edge-slotp edge fn2-alloc-edges)) (mv :edge-bounds fn2-extents fn2-alloc-edges))
      ((when (fn2-checkpoint-source-claimedp c checkpoint extent epoch allocation fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints))
       (mv :ok fn2-extents fn2-alloc-edges))
      ((unless (equal (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-building*))
       (mv :candidate fn2-extents fn2-alloc-edges)))
  (fn2-alloc-edge-add edge checkpoint extent epoch allocation :prepared-successor fn2-extents fn2-alloc-edges)))

; The same owned edge changes class atomically. There is no intermediate
; unprotected extent and no search through another producer's reserved rows.
; Only the installation coordinator may call this after its durable member.
(defun fn2-checkpoint-source-promote (c token okind oslot ogen checkpoint extent epoch allocation fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
 (declare (xargs :stobjs (fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
  :guard (and (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges)
              (fn2-ops-wfp fn2-ops) (fn2-checkpoints-wfp fn2-checkpoints))))
 (b* (((unless (and (natp c) (< c (fn2-checkpoints-rows fn2-checkpoints)) (fn2-alloc-slotp extent fn2-extents)
                     (posp checkpoint) (unsigned-byte-p 60 checkpoint)
                     (equal (fn2-checkpoints-checkpoint c fn2-checkpoints) checkpoint)
                     (fn2-checkpoint-builder-claimp c token okind oslot ogen fn2-checkpoints)
                     (member (fn2-checkpoints-state c fn2-checkpoints)
                      (list *fn2-checkpoint-state-installed* *fn2-checkpoint-state-promoting* *fn2-checkpoint-state-promoted*))
                     (posp (fn2-checkpoints-installation-commit c fn2-checkpoints))
                     (eq (fn2-alloc-handle-code extent epoch allocation fn2-extents) :ok)))
       (mv :identity fn2-extents fn2-alloc-edges))
      (edge (fn2-checkpoint-source-edge c extent fn2-extents fn2-ops fn2-checkpoints))
      ((unless (fn2-alloc-edge-slotp edge fn2-alloc-edges)) (mv :edge-bounds fn2-extents fn2-alloc-edges))
      ((when (fn2-alloc-edge-matchesp edge checkpoint extent epoch allocation :selectable-checkpoint fn2-alloc-edges))
       (mv :ok fn2-extents fn2-alloc-edges))
      ((unless (and (posp token) (unsigned-byte-p 60 token)
                     (unsigned-byte-p 8 okind) (unsigned-byte-p 32 oslot) (unsigned-byte-p 60 ogen)
                     (equal (fn2-alloc-freeze-phase fn2-extents) 2)
                     (equal (fn2-alloc-freeze-token fn2-extents) token)
                     (equal (fn2-alloc-freeze-owner-kind fn2-extents) okind)
                     (equal (fn2-alloc-freeze-owner-slot fn2-extents) oslot)
                     (equal (fn2-alloc-freeze-owner-gen fn2-extents) ogen)
                     (fn2-alloc-edge-matchesp edge checkpoint extent epoch allocation :prepared-successor fn2-alloc-edges)
                     (posp (fn2-extents-prepared-successor extent fn2-extents))
                     (< (fn2-extents-selectable-checkpoint extent fn2-extents) *fn2-alloc-edge-count-max*)
                     (equal (fn2-extents-release-pending extent fn2-extents) 0)))
       (mv :edge-holder fn2-extents fn2-alloc-edges))
      (state (fn2-extents-state extent fn2-extents))
      (reason (fn2-alloc-reason extent (fn2-alloc-cut fn2-extents) fn2-extents))
      (fn2-extents (fn2-alloc-set-edge extent :prepared-successor (- (fn2-extents-prepared-successor extent fn2-extents) 1) fn2-extents))
      (fn2-extents (fn2-alloc-set-edge extent :selectable-checkpoint (+ (fn2-extents-selectable-checkpoint extent fn2-extents) 1) fn2-extents))
      (fn2-alloc-edges (fn2-alloc-edges-set-kind edge (fn2-alloc-edge-kind-keyword->code :selectable-checkpoint) fn2-alloc-edges))
      (fn2-extents (fn2-alloc-account extent state reason fn2-extents)))
  (mv :ok fn2-extents fn2-alloc-edges)))

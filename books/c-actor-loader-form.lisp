; Scoped actor instrumentation: one declared actor body, one shared loader.
(in-package "ACL2")
(include-book "machine-arms")
(fn2-book-layer :c)
(defun fn2-c-actor-loader-symbol (name suffix)
 (declare (xargs :verify-guards nil))
 (intern-in-package-of-symbol (concatenate 'string "*" (symbol-name name) "-LOADER-" suffix "*") name))
(defun fn2-c-actor-loader-resource (name)
 (declare (xargs :verify-guards nil))
 (if (eq name 'fn2-cns) '(:storage-window :while (storage :held)) '(:storage-window :while (loader :held))))
(defun fn2-c-actor-loader-kind-holds (name holds)
 (declare (xargs :verify-guards nil))
 (if (atom holds) nil
  (cons (append (remove-equal '(:storage-window :while (lease :held)) (car holds))
                (list (fn2-c-actor-loader-resource name)))
        (fn2-c-actor-loader-kind-holds name (cdr holds)))))
(defmacro fn2-c-actor-loader-kind (name &rest args)
 (let* ((enum (fn2-columns-sym name "-LOADER"))
        (phases (fn2-decl-get :phases args)) (holds (fn2-decl-get :holds args))
        (refusal-base (remove-equal '(:storage-window :while (lease :held))
                       (cdr (assoc-eq (if (eq name 'fn2-txn) :lookup :decode) holds))))
        (taken (fn2-decl-get :taken args))
        (taken (fn2-decl-set :clear (append (fn2-decl-get :clear taken) '(loader loader-row source-observation source-row) (if (eq name 'fn2-cns) '(register-check storage) nil)) taken))
        (args (fn2-decl-set :taken taken args))
        (extra (if (eq name 'fn2-cns) '(:load-refused :item-output :article-output :register-output) '(:load-refused)))
        (args (fn2-decl-set :phases (append phases extra) args))
        (args (fn2-decl-set :arms (append (fn2-decl-get :arms args) (pairlis$ extra nil)) args))
        (args (fn2-decl-set :fields (append (fn2-decl-get :fields args)
              (append `((loader (:enum ,enum (:none :held))) (loader-row :u32)
                        (source-observation (:enum ,(fn2-columns-sym name "-SOURCE-OBSERVATION") (:none :held :released))) (source-row :u32))
                      (if (eq name 'fn2-cns) '((register-check :bool) (storage (:enum fn2-cns-storage (:none :held)))) nil))) args))
        (args (fn2-decl-set :holds (append (fn2-c-actor-loader-kind-holds name holds)
              (list (cons :load-refused (append refusal-base (list (fn2-c-actor-loader-resource name)))))) args))
        (args (if (eq name 'fn2-cns)
                (fn2-decl-set :holds (append (fn2-decl-get :holds args)
                 '((:item-output :tx-range :wait-row (:storage-window :while (storage :held)))
                   (:article-output :tx-range :wait-row (:storage-window :while (storage :held)))
                   (:register-output :tx-range :wait-row (:storage-window :while (storage :held))))) args) args))
        (observes (fn2-decl-get :observes args))
        (args (if (assoc-eq :read-result observes) args
                (fn2-decl-set :observes (append observes '((:read-result))) args))))
  `(defmachine ,name ,@args)))

(defun fn2-c-actor-loader-refusal (name)
 (declare (xargs :verify-guards nil))
 (cond ((eq name 'fn2-txn) '((:set (word *fn2-upload-word-not-stored*)) (:next :refused) (:charge :steps *fn2-work-transition* :runnable t)))
       ((eq name 'fn2-auth) '((:goto fault)))
       (t '((:set (reason *fn2-cns-reason-unavailable*)) (:goto refuse)))))
(defun fn2-c-actor-loader-admit-op (name original effects)
 (declare (xargs :verify-guards nil))
 (let ((held (fn2-c-actor-loader-symbol name "HELD")))
  `(:do (load-code complete) (,(if effects 'fn2-c-actor-loader-reserve 'fn2-c-actor-loader-reserve-held) id row-generation)
    :accept ()
    :case (((:ok) (:set (loader ,held) (loader-row 0))
             ,@(if (eq name 'fn2-cns) '((:set (storage *fn2-cns-storage-held*))) nil)
             (:if (equal complete 1)
              ((:charge :steps *fn2-work-transition* :runnable t))
              ((:next :load-refused) (:charge :steps *fn2-work-transition* :runnable t))))
           ((:resident) ,@original)
           ((:exhausted) ,@(fn2-c-actor-loader-refusal name))
           (:otherwise (:stop :pool-release :steps *fn2-work-state*))))))
(defun fn2-c-actor-loader-work (name phase original)
 (declare (xargs :verify-guards nil))
 (let ((none (fn2-c-actor-loader-symbol name "NONE")))
  `((:cond
     ((not (and (natp budget) (< 0 budget))) (:yield))
     ,@(if (and (eq name 'fn2-txn) (eq phase :lookup))
          `(((and (equal row-loader ,none)
                   (not (equal (:read upload phase) *fn2-upload-state-sealed*))) ,@original)) nil)
     ((equal row-loader ,none)
      ,@(if (eq name 'fn2-cns)
          `((:if (equal row-lease *fn2-cns-lease-held*)
             (,(fn2-c-actor-loader-admit-op name original nil))
             (,(fn2-c-actor-loader-admit-op name original t))))
          (list (fn2-c-actor-loader-admit-op name original t))))
     (t
      (:do (load-code load-job load-phase) (fn2-c-actor-loader-state id row-generation)
       :accept ()
       :case (((:clear) ,@original)
              ((:bind) (:if (member load-phase (list *fn2-run-load-phase-reserved* *fn2-run-load-phase-ready*))
                        ((:do (load-bind) (fn2-run-page-bind load-job ,(intern-in-package-of-symbol (concatenate 'string "*" (symbol-name name) "-KIND*") name) id row-generation) :accept (:need-read)
                          :why "The bound physical producer needs its first explicit sector read.")
                         (:charge :bytes 64 :steps *fn2-work-transition* :runnable t))
                        ((:stop :machine-phase))))
              ((:step) (:do (load-step) (fn2-run-page-step load-job (min budget *fn2-commit-unit-bytes*))
                         :accept ()
                         :case (((:more :ready :need-read) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
                                ((:wait) (:wait :completion :steps *fn2-work-small*))
                                ((:yield) (:yield))
                                (:otherwise (:stop :machine-phase)))))
              ((:read) (:issue (fn2-run-page-read load-job (min budget *fn2-commit-unit-bytes*))
                        :ok ((:wait :completion :steps *fn2-work-small*))))
              ((:wait) (:charge :steps *fn2-work-poll*))
              (:otherwise (:stop :machine-phase)))))))))
(defun fn2-c-actor-loader-last-op (name effects)
 (declare (xargs :verify-guards nil))
 (let ((none (fn2-c-actor-loader-symbol name "NONE"))
       (kind (intern-in-package-of-symbol (concatenate 'string "*" (symbol-name name) "-KIND*") name)))
  `((:do (load-release) ,(if effects `(fn2-run-page-release load-job ,kind id row-generation)
                          '(fn2-c-actor-loader-last-held id row-generation row-loader-row))
     ,@(if effects '(:effects ((:release (:storage-window)))) nil) :accept (:ok))
    (:set (loader ,none) (loader-row (+ 1 row-loader-row)))
    ,@(if (and (eq name 'fn2-cns) effects) '((:set (storage *fn2-cns-storage-none*))) nil)
    (:charge :steps *fn2-work-transition* :runnable t))))
(defun fn2-c-actor-loader-drain-body (name terminal)
 (declare (xargs :verify-guards nil))
 (let ((held (fn2-c-actor-loader-symbol name "HELD")))
  `((:cond
     ,@(if (eq name 'fn2-cns) '(((not (equal row-pending 0)) (:wait :completion :steps *fn2-work-small*))) nil)
     ((not (equal row-loader ,held)) ,@terminal)
     (t (:do (load-code load-job) (fn2-c-actor-loader-drain id row-generation row-loader-row)
          :accept ()
          :case (((:absent) (:set (loader-row (+ 1 row-loader-row))) (:charge :steps *fn2-work-transition* :runnable t))
                 ((:member) (:do (load-release) (fn2-c-actor-loader-member-release id row-generation row-loader-row) :accept (:ok))
                            (:set (loader-row (+ 1 row-loader-row))) (:charge :steps *fn2-work-transition* :runnable t))
                 ((:last)
                  ,@(if (eq name 'fn2-cns)
                      `((:if (equal row-lease *fn2-cns-lease-held*)
                          ,(fn2-c-actor-loader-last-op name nil)
                          ,(fn2-c-actor-loader-last-op name t)))
                      (fn2-c-actor-loader-last-op name t)))
                 ((:done) (:stop :machine-phase))
                 ((:wait) (:charge :steps *fn2-work-poll*))
                 (:otherwise (:stop :pool-release :steps *fn2-work-state*)))))))))
; Releasing the observer does not materialize octets. Existing scalar-only
; folds and stage's strict per-schema run-version check protect retained RES;
; the physical adopter must publish a strictly greater query priority first.
(defun fn2-c-actor-source-symbol (name suffix)
 (declare (xargs :verify-guards nil))
 (intern-in-package-of-symbol (concatenate 'string "*" (symbol-name name) "-SOURCE-OBSERVATION-" suffix "*") name))
(defun fn2-c-actor-source-boundary (name phase)
 (declare (xargs :verify-guards nil))
 (cond ((and (eq name 'fn2-txn) (eq phase :ready)) '(equal row-prepared 1))
       ((and (eq name 'fn2-auth) (eq phase :ready)) '(equal row-wstep 2))
       ((and (eq name 'fn2-cns) (eq phase :commit)) '(equal row-wstep 2))
       (t nil)))
(defun fn2-c-actor-source-release (name terminal)
 (declare (xargs :verify-guards nil))
 ; Waking the source writer occupies this turn's single wake slot. The
 ; actor's original drain (which may wake its requester) runs next turn.
 `((:if (equal row-source-observation ,(fn2-c-actor-source-symbol name "NONE"))
     ,terminal
     ((:do (observed-release source-target source-targetgen)
       (fn2-c-source-read-release id row-generation) :accept (:ok :absent))
      (:if (not (equal source-target *fn2-none*)) ((:wake-row source-target)) ())
      (:set (source-observation ,(fn2-c-actor-source-symbol name "NONE")) (source-row 0))
      (:charge :steps *fn2-work-transition* :runnable t)))))
(defun fn2-c-actor-source-work (name phase original body)
 (declare (xargs :verify-guards nil))
 (let ((none (fn2-c-actor-source-symbol name "NONE"))
       (held (fn2-c-actor-source-symbol name "HELD"))
       (released (fn2-c-actor-source-symbol name "RELEASED"))
       (boundary (fn2-c-actor-source-boundary name phase)))
 `((:cond
    ,@(if (and (eq name 'fn2-txn) (eq phase :lookup))
        `(((not (equal (:read upload phase) *fn2-upload-state-sealed*)) ,@body)) nil)
    ((equal row-source-observation ,none)
     (:do (observed) (fn2-c-source-read-acquire id row-generation) :accept ()
      :case (((:ok) (:set (source-observation ,held) (source-row 0))
                    (:charge :steps *fn2-work-transition* :runnable t))
             ,@(if (and (eq name 'fn2-cns) (eq phase :register-output))
                 '(((:busy) (:charge :steps *fn2-work-poll* :runnable t))
                   ((:exhausted) (:stop :machine-phase)))
                 '(((:busy :exhausted) (:next :load-refused) (:charge :steps *fn2-work-transition* :runnable t))))
             (:otherwise (:stop :machine-phase)))))
    ((equal row-source-observation ,released)
     ,@(if boundary
          `((:if ,boundary ,original
              ((:set (source-observation ,none) (source-row 0)) (:charge :steps *fn2-work-transition* :runnable t))))
          `((:set (source-observation ,none) (source-row 0)) (:charge :steps *fn2-work-transition* :runnable t))))
    ,@(if boundary
      `(((and (equal row-source-observation ,held) ,boundary)
         (:do (parked next-source-row) (fn2-c-actor-loader-park-step id row-generation row-source-row)
          :accept () :case
          (((:more) (:set (source-row next-source-row)) (:charge :steps *fn2-work-transition* :runnable t))
           ((:done)
            (:do (observed-release source-target source-targetgen) (fn2-c-source-read-release id row-generation) :accept (:ok))
            (:if (not (equal source-target *fn2-none*)) ((:wake-row source-target)) ())
            (:set (source-observation ,released)) (:charge :steps *fn2-work-transition* :runnable t))
           (:otherwise (:stop :machine-phase)))))) nil)
    (t ,@body)))))
(defun fn2-c-actor-loader-wrap-arm (name arm)
 (declare (xargs :verify-guards nil))
 (let* ((phase (car arm)) (prefixed (eq (cadr arm) :on-refusal))
        (prefix (if prefixed (take 3 arm) (list phase))) (body (if prefixed (nthcdr 3 arm) (cdr arm)))
        (work (case name (fn2-txn '(:lookup :prepare :ready))
                         (fn2-auth '(:lookup :allocate :bhead :outcome :head :get :ready))
                         (otherwise '(:decode :check :lookup :read :page :commit :item-output :article-output :register-output)))))
  (cond ((member-eq phase work) (append prefix (fn2-c-actor-source-work name phase body (fn2-c-actor-loader-work name phase body))))
        ((eq phase :draining) (append prefix (fn2-c-actor-loader-drain-body name (fn2-c-actor-source-release name body))))
        (t arm))))
(defun fn2-c-actor-loader-wrap-arms (name arms)
 (declare (xargs :verify-guards nil))
 (if (atom arms) nil
  (cons (fn2-c-actor-loader-wrap-arm name (car arms)) (fn2-c-actor-loader-wrap-arms name (cdr arms)))))
(defun fn2-c-actor-loader-cns-lease-forms (forms)
 (declare (xargs :verify-guards nil))
 (if (atom forms) forms
  (if (and (eq (car forms) :do) (consp (caddr forms))
           (member-eq (car (caddr forms)) '(fn2-cns-lease-reserve fn2-cns-lease-release)))
   (let* ((reserve (eq (car (caddr forms)) 'fn2-cns-lease-reserve))
          (plain (append (take 3 forms) (fn2-decl-set :effects nil (cdddr forms))))
          (effect (append (take 3 forms) (fn2-decl-set :effects
                   (if reserve '((:acquire (:storage-window))) '((:release (:storage-window)))) (cdddr forms)))))
    `(:if (equal row-loader *fn2-cns-loader-held*)
      (,plain ,@(if reserve '((:set (storage *fn2-cns-storage-held*))) nil))
      (,effect (:set (storage ,(if reserve '*fn2-cns-storage-held* '*fn2-cns-storage-none*))))))
   (cons (fn2-c-actor-loader-cns-lease-forms (car forms))
         (fn2-c-actor-loader-cns-lease-forms (cdr forms))))))
(defun fn2-c-actor-loader-cns-output-arms (args)
 (declare (xargs :verify-guards nil))
 (let* ((args (fn2-decl-set :arms (fn2-c-actor-loader-cns-lease-forms (fn2-decl-get :arms args)) args))
        (args (fn2-decl-set :subarms (fn2-c-actor-loader-cns-lease-forms (fn2-decl-get :subarms args)) args))
        (subarms (fn2-decl-get :subarms args))
        (put (assoc-eq 'put subarms)) (article (assoc-eq 'put-article subarms))
        (subarms (put-assoc-eq 'put '((:next :item-output) (:charge :steps *fn2-work-transition* :runnable t)) subarms))
        (subarms (put-assoc-eq 'put-article '((:next :article-output) (:charge :steps *fn2-work-transition* :runnable t)) subarms))
        (register '(:register-output :on-refusal ((:stop :machine-phase))
         (:do (r-code r-pos r-ver r-frontier)
          (fn2-cns-lookup-cursor (fn2-cns-cid-default row-consumer) (fn2-cns-ep-default row-epoch)
           row-principal-slot row-cpos row-version row-pub-frontier row-xrow)
          :accept (:ok) :case (((:more :miss) (:charge :bytes *fn2-c-read-callback-bytes* :steps *fn2-work-transition* :runnable t))))
         (:set (cpos r-pos) (version r-ver) (pub-frontier r-frontier))
         (:if (and (equal row-register-check 1) (not (< 0 r-ver)))
          ((:set (reason *fn2-cns-reason-equal*)) (:goto refuse))
          ((:set (outcome *fn2-cns-outcome-accepted*)) (:goto answer))))))
  (fn2-decl-set :arms (append (fn2-decl-get :arms args)
   (list (cons :item-output (cdr put)) (cons :article-output (cdr article)) register))
   (fn2-decl-set :subarms subarms args))))
(defmacro fn2-c-actor-loader-arms (name mode &rest args)
 (let* ((args (if (eq name 'fn2-cns) (fn2-c-actor-loader-cns-output-arms args) args))
        (arms (fn2-c-actor-loader-wrap-arms name (fn2-decl-get :arms args)))
        (arms (append arms (list (cons :load-refused
                       (fn2-c-actor-loader-drain-body name (fn2-c-actor-source-release name (fn2-c-actor-loader-refusal name)))))))
        (args (fn2-decl-set :arms arms args))
        (observes (fn2-decl-get :observes args))
        (args (if (assoc-eq :read-result observes) args
                (fn2-decl-set :observes (append observes '((:read-result (:wake)))) args))))
  `(defmachine-arms ,name ,mode ,@args)))

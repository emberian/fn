; Scoped txn/auth instrumentation of the actual declared bodies. CNS owns its
; source/output phases and consumes the shared runtime helpers separately.
(in-package "ACL2")
(include-book "machine-arms")
(fn2-book-layer :c)
(defun fn2-c-actor-loader-symbol (name suffix)
 (declare (xargs :verify-guards nil))
 (intern-in-package-of-symbol (concatenate 'string "*" (symbol-name name) "-LOADER-" suffix "*") name))
(defun fn2-c-actor-loader-kind-holds (holds)
 (declare (xargs :verify-guards nil))
 (if (atom holds) nil
  (cons (append (car holds) '((:storage-window :while (loader :held))))
        (fn2-c-actor-loader-kind-holds (cdr holds)))))
(defmacro fn2-c-actor-loader-kind (name &rest args)
 (let* ((taken (fn2-decl-get :taken args))
        (taken (fn2-decl-set :clear (append (fn2-decl-get :clear taken) '(loader loader-row)) taken))
        (args (fn2-decl-set :taken taken args))
        (args (fn2-decl-set :phases (append (fn2-decl-get :phases args) '(:load-refused)) args))
        (args (fn2-decl-set :arms (append (fn2-decl-get :arms args) '((:load-refused))) args))
        (args (fn2-decl-set :fields (append (fn2-decl-get :fields args)
               `((loader (:enum ,(fn2-columns-sym name "-LOADER") (:none :held))) (loader-row :u32))) args))
        (holds (fn2-c-actor-loader-kind-holds (fn2-decl-get :holds args)))
        (base (cdr (assoc-eq (if (eq name 'fn2-txn) :lookup :decode) holds)))
        (args (fn2-decl-set :holds (append holds (list (cons :load-refused base))) args))
        (observes (fn2-decl-get :observes args))
        (args (if (assoc-eq :read-result observes) args (fn2-decl-set :observes (append observes '((:read-result))) args))))
  `(defmachine ,name ,@args)))
(defun fn2-c-actor-loader-refusal (name)
 (declare (xargs :verify-guards nil))
 (if (eq name 'fn2-txn)
  '((:set (word *fn2-upload-word-not-stored*)) (:next :refused) (:charge :steps *fn2-work-transition* :runnable t))
  '((:goto fault))))
(defun fn2-c-actor-loader-work (name phase original)
 (declare (xargs :verify-guards nil))
 (let ((none (fn2-c-actor-loader-symbol name "NONE")) (held (fn2-c-actor-loader-symbol name "HELD"))
       (kind (intern-in-package-of-symbol (concatenate 'string "*" (symbol-name name) "-KIND*") name)))
 `((:cond
    ((not (and (natp budget) (< 0 budget))) (:yield))
    ,@(if (and (eq name 'fn2-txn) (eq phase :lookup))
       `(((and (equal row-loader ,none) (not (equal (:read upload phase) *fn2-upload-state-sealed*))) ,@original)) nil)
    ((equal row-loader ,none)
     (:do (load-code complete) (fn2-c-actor-loader-reserve id row-generation) :accept ()
      :case (((:ok) (:set (loader ,held) (loader-row 0))
              (:if (equal complete 1) ((:charge :steps *fn2-work-transition* :runnable t))
                ((:next :load-refused) (:charge :steps *fn2-work-transition* :runnable t))))
             ((:resident) ,@original)
             ((:exhausted) ,@(fn2-c-actor-loader-refusal name))
             (:otherwise (:stop :pool-release :steps *fn2-work-state*)))))
    (t (:do (load-code load-job load-phase) (fn2-c-actor-loader-state id row-generation) :accept ()
      :case (((:clear) ,@original)
             ((:bind) (:do (bound) (fn2-run-page-bind load-job ,kind id row-generation) :accept (:need-read)
                         :why "The actual selected Ref needs its first explicit sector read.")
                      (:charge :bytes 64 :steps *fn2-work-transition* :runnable t))
             ((:step) (:do (progress) (fn2-run-page-step load-job (min budget *fn2-commit-unit-bytes*)) :accept ()
                       :case (((:more :ready :need-read :wait) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
                              ((:yield) (:yield)) (:otherwise (:stop :machine-phase)))))
             ((:read) (:issue (fn2-run-page-read load-job (min budget *fn2-commit-unit-bytes*))
                       :ok ((:wait :completion :steps *fn2-work-small*))))
             ((:wait) (:wait :completion :steps *fn2-work-small*))
             (:otherwise (:stop :machine-phase)))))))))
(defun fn2-c-actor-loader-drain-body (name terminal)
 (declare (xargs :verify-guards nil))
 (let ((held (fn2-c-actor-loader-symbol name "HELD")) (none (fn2-c-actor-loader-symbol name "NONE"))
       (kind (intern-in-package-of-symbol (concatenate 'string "*" (symbol-name name) "-KIND*") name)))
 `((:if (not (equal row-loader ,held)) ,terminal
    ((:do (load-code load-job) (fn2-c-actor-loader-drain id row-generation row-loader-row) :accept ()
      :case (((:absent) (:set (loader-row (+ 1 row-loader-row))) (:charge :steps *fn2-work-transition* :runnable t))
             ((:member) (:do (released) (fn2-c-actor-loader-member-release id row-generation row-loader-row) :accept (:ok))
                        (:set (loader-row (+ 1 row-loader-row))) (:charge :steps *fn2-work-transition* :runnable t))
             ((:last) (:do (released) (fn2-run-page-release load-job ,kind id row-generation)
                       :effects ((:release (:storage-window))) :accept (:ok))
                      (:set (loader ,none) (loader-row (+ 1 row-loader-row))) (:charge :steps *fn2-work-transition* :runnable t))
             ((:wait) (:wait :completion :steps *fn2-work-small*))
             (:otherwise (:stop :pool-release :steps *fn2-work-state*)))))))))
(defun fn2-c-actor-loader-wrap-arms (name arms)
 (declare (xargs :verify-guards nil))
 (if (atom arms) nil
  (let* ((arm (car arms)) (phase (car arm)) (refusal (eq (cadr arm) :on-refusal))
         (prefix (if refusal (take 3 arm) (list phase))) (body (if refusal (nthcdr 3 arm) (cdr arm)))
         (work (if (eq name 'fn2-txn) '(:lookup :prepare :ready) '(:lookup :allocate :bhead :outcome :head :get :ready)))
         (new (cond ((member-eq phase work) (append prefix (fn2-c-actor-loader-work name phase body)))
                    ((eq phase :draining) (append prefix (fn2-c-actor-loader-drain-body name body))) (t arm))))
   (cons new (fn2-c-actor-loader-wrap-arms name (cdr arms))))))
(defmacro fn2-c-actor-loader-arms (name mode &rest args)
 (let* ((arms (fn2-c-actor-loader-wrap-arms name (fn2-decl-get :arms args)))
        (arms (append arms (list (cons :load-refused (fn2-c-actor-loader-drain-body name (fn2-c-actor-loader-refusal name))))))
        (args (fn2-decl-set :arms arms args))
        (args (fn2-decl-set :observes (append (fn2-decl-get :observes args) '((:read-result (:wake)))) args)))
  `(defmachine-arms ,name ,mode ,@args)))

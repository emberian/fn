; Unconditional row-count frames for the concrete storage hashing path.
(in-package "ACL2")
(include-book "blake3")
(include-book "pool-digest")
(fn2-book-layer :b)

; Positions come from the admitted ABI, never from a duplicated result layout.
; A single-result stobj is the call itself; MV zero is CAR in ACL2's logic.
(defun fn2-row-frame-output-claims (outputs call single index tables)
 (declare (xargs :verify-guards nil))
 (if (atom outputs) nil
  (let* ((table (car outputs))
         (rows (fn2-columns-sym table "-ROWS"))
         (result (cond (single call) ((zp index) `(car ,call))
                       (t `(mv-nth ,index ,call)))))
   (append (and (member-eq table tables)
                `((equal (,rows ,result) (,rows ,table))))
           (fn2-row-frame-output-claims (cdr outputs) call single (+ 1 index) tables)))))

(defun fn2-row-frame-event (name tables world)
 (declare (xargs :verify-guards nil))
 (let* ((formals (getpropc name 'formals nil world))
        (outputs (getpropc name 'stobjs-out nil world))
        (call (cons name formals))
        (claims (fn2-row-frame-output-claims outputs call (equal (len outputs) 1) 0 tables))
        (recursive (getpropc name 'recursivep nil world)))
  (if (or (not claims) (not (subsetp-eq tables formals)))
      (er hard 'fn2-row-frame-event "Missing actual carrier ABI for ~x0: ~x1." name tables)
    `(defthm ,(fn2-columns-sym name "-ROW-FRAMES")
      (and ,@claims)
      :hints (("Goal" ,@(and recursive `(:induct ,call))
               :in-theory (e/d (,name) (fn2-b3-rows fn2-digests-rows))))))))

(defmacro fn2-hash-row-frames (name &rest tables)
 `(make-event (value (fn2-row-frame-event ',name ',tables (w state)))))

; Bottom-up boundaries: each proof opens only its own actual implementation.
(fn2-hash-row-frames fn2-digest-set-word fn2-digests)
(fn2-hash-row-frames fn2-digest-copy fn2-digests)

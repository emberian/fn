; Actual pending physical-anchor evidence comparison. The terminal bank owner
; derives the candidate from its pending source; no caller completion flag.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-teardown-state")
(include-book "checkpoint-bank-obligations-state")
(fn2-book-layer :b)
(defun fn2-checkpoint-teardown-cold-kind (i)
 (declare (xargs :guard (and (natp i) (< i 48))))
 (case (floor i 8) (0 :installation-seal) (1 :cut-seal) (2 :installation-predecessor) (3 :previous-descriptor) (4 :descriptor) (otherwise :anchor-hash)))
(defun fn2-checkpoint-teardown-cold-words-p (i end slot c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil
  :measure (nfix (- (nfix end) (nfix i)))
  :guard (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
              (natp i) (natp end) (<= i end) (<= end 48) (natp slot) (< slot 4) (natp c)
              (<= (* 40 (+ 1 c)) (fn2-checkpoint-teardown-debt-words-length fn2-checkpoint-teardown-debt))
              (<= (* 32 (+ 1 c)) (fn2-checkpoint-teardown-debt-anchors-length fn2-checkpoint-teardown-debt)))))
 (if (>= (nfix i) (nfix end)) t
  (mv-let (code word) (fn2-checkpoint-bank-obligations-pending-word slot (fn2-checkpoint-teardown-cold-kind i) (mod i 8) fn2-checkpoint-publication)
   (and (eq code :ok)
        (equal word (if (< i 40) (fn2-checkpoint-teardown-debt-wordsi (+ (* 40 c) i) fn2-checkpoint-teardown-debt)
                     (fn2-checkpoint-teardown-debt-anchorsi (+ (* 32 c) (* 8 slot) (- i 40)) fn2-checkpoint-teardown-debt)))
        (fn2-checkpoint-teardown-cold-words-p (+ 1 i) end slot c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)))))
(defun fn2-checkpoint-teardown-cold-subject-p (slot c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil
  :guard (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (mv-let (code candidate checkpoint history incarnation cut cutevent batch) (fn2-checkpoint-bank-obligations-pending-snapshot slot fn2-checkpoint-publication)
  (mv-let (eventcode event) (fn2-checkpoint-bank-obligations-pending-event slot fn2-checkpoint-publication)
   (and (eq code :ok) (eq eventcode :ok) (equal c candidate)
        (fn2-checkpoint-teardown-debt-heldp c fn2-checkpoint-teardown-debt)
        (<= (* 40 (+ 1 c)) (fn2-checkpoint-teardown-debt-words-length fn2-checkpoint-teardown-debt))
        (<= (* 32 (+ 1 c)) (fn2-checkpoint-teardown-debt-anchors-length fn2-checkpoint-teardown-debt))
        (equal (fn2-checkpoint-teardown-debt-checkpoint c fn2-checkpoint-teardown-debt) checkpoint)
        (equal (fn2-checkpoint-teardown-debt-history c fn2-checkpoint-teardown-debt) history)
        (equal (fn2-checkpoint-teardown-debt-incarnation c fn2-checkpoint-teardown-debt) incarnation)
        (equal (fn2-checkpoint-teardown-debt-cut-commit c fn2-checkpoint-teardown-debt) cut)
        (equal (fn2-checkpoint-teardown-debt-cut-event c fn2-checkpoint-teardown-debt) cutevent)
        (equal (fn2-checkpoint-teardown-debt-installation-commit c fn2-checkpoint-teardown-debt) batch)
        (equal (fn2-checkpoint-teardown-debt-installation-event c fn2-checkpoint-teardown-debt) event)))))
(defun fn2-checkpoint-teardown-cold-retainedp (slot fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil
  :guard (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (mv-let (code c checkpoint history incarnation cut cutevent batch) (fn2-checkpoint-bank-obligations-pending-snapshot slot fn2-checkpoint-publication)
  (declare (ignore checkpoint history incarnation cut cutevent batch))
  (and (eq code :ok) (natp slot) (< slot 4)
       (fn2-checkpoint-teardown-cold-subject-p slot c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
       (member-equal (fn2-checkpoint-teardown-debt-phase c fn2-checkpoint-teardown-debt)
        (list *fn2-checkpoint-teardown-debt-phase-held* *fn2-checkpoint-teardown-debt-phase-drop*))
       (equal (fn2-checkpoint-teardown-debt-cold-copy c fn2-checkpoint-teardown-debt) 0)
       (equal (fn2-checkpoint-teardown-debt-word-cursor c fn2-checkpoint-teardown-debt) 40)
       (unsigned-byte-p 4 (fn2-checkpoint-teardown-debt-anchor-mask c fn2-checkpoint-teardown-debt))
       (fn2-checkpoint-bank-obligation-memberp slot (fn2-checkpoint-teardown-debt-anchor-mask c fn2-checkpoint-teardown-debt))
       (fn2-checkpoint-teardown-cold-words-p 0 48 slot c fn2-checkpoint-teardown-debt fn2-checkpoint-publication))))

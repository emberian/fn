; Protected working and ordinary-drain groups are profile resources, not data
; limits. Only actual producer wrappers may authorize a bound group claim.
; This book does not register a host face or grant runtime activation.
(in-package "ACL2")
(include-book "pool")
(include-book "std/util/bstar" :dir :system)

(defconst *fn2-pool-credit-working* 1)
(defconst *fn2-pool-credit-drain* 2)
(defconst *fn2-pool-credit-idle* 0)
(defconst *fn2-pool-credit-redeeming* 1)
(defconst *fn2-pool-credit-held* 2)
(defconst *fn2-pool-credit-depleted* 3)
(defconst *fn2-pool-credit-aborted-empty* 4)

(defun fn2-pool-credit-shapep (fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (let ((g (fn2-pool-credit-group-count fn2-pool)) (c (fn2-pool-nclasses fn2-pool)))
  (and (equal (fn2-pool-credit-configured fn2-pool) 1) (posp g) (posp c)
       (equal (fn2-pool-credit-protected-length fn2-pool) c)
       (equal (fn2-pool-credit-purpose-length fn2-pool) g)
       (equal (fn2-pool-credit-phase-length fn2-pool) g)
       (equal (fn2-pool-credit-group-nonce-length fn2-pool) g)
       (equal (fn2-pool-credit-group-owner-kind-length fn2-pool) g)
       (equal (fn2-pool-credit-group-owner-slot-length fn2-pool) g)
       (equal (fn2-pool-credit-group-owner-gen-length fn2-pool) g)
       (equal (fn2-pool-credit-demand-length fn2-pool) (* g c))
       (equal (fn2-pool-credit-available-length fn2-pool) (* g c)))))

; Init-only input: (PURPOSE DEMAND-CLASS0 ...), one row per actual group.
(defun fn2-pool-credit-demandsp (xs n)
 (declare (xargs :guard t))
 (if (atom xs) (and (null xs) (equal n 0))
  (and (posp n) (unsigned-byte-p 32 (car xs))
       (fn2-pool-credit-demandsp (cdr xs) (- n 1)))))
(defun fn2-pool-credit-nonzerop (xs)
 (declare (xargs :guard t))
 (and (consp xs) (or (posp (car xs)) (fn2-pool-credit-nonzerop (cdr xs)))))
(defun fn2-pool-credit-groupsp (groups n)
 (declare (xargs :guard t))
 (if (atom groups) (null groups)
  (and (consp (car groups))
       (member-equal (caar groups) (list *fn2-pool-credit-working* *fn2-pool-credit-drain*))
       (fn2-pool-credit-demandsp (cdar groups) n)
       (fn2-pool-credit-nonzerop (cdar groups))
       (fn2-pool-credit-groupsp (cdr groups) n))))
(defun fn2-pool-credit-request (class groups)
 (declare (xargs :guard t))
 (if (atom groups) 0
  (+ (if (and (consp (car groups)) (true-listp (cdar groups)))
         (nfix (nth (nfix class) (cdar groups))) 0)
     (fn2-pool-credit-request class (cdr groups)))))
(defun fn2-pool-credit-config-roomp (class groups fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (fn2-pool-wfp fn2-pool) (natp class))
  :measure (nfix (- (nfix (fn2-pool-nclasses fn2-pool)) (nfix class)))))
 (if (not (and (natp class) (< class (nfix (fn2-pool-nclasses fn2-pool))))) t
  (and (<= (fn2-pool-credit-request class groups) (fn2-pool-class-countsi class fn2-pool))
       (fn2-pool-credit-config-roomp (+ 1 class) groups fn2-pool))))
(defun fn2-pool-credit-store-demands (xs i fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (fn2-pool-wfp fn2-pool) (true-listp xs) (natp i))))
 (if (atom xs) fn2-pool
  (if (not (and (natp i) (< i (fn2-pool-credit-demand-length fn2-pool))
                (< i (fn2-pool-credit-available-length fn2-pool))
                (unsigned-byte-p 32 (car xs)))) fn2-pool
   (let* ((fn2-pool (update-fn2-pool-credit-demandi i (car xs) fn2-pool))
          (fn2-pool (update-fn2-pool-credit-availablei i (car xs) fn2-pool)))
    (fn2-pool-credit-store-demands (cdr xs) (+ i 1) fn2-pool)))))
(defthm fn2-pool-credit-demandsp-true-listp
 (implies (fn2-pool-credit-demandsp xs n) (true-listp xs))
 :hints (("Goal" :induct (fn2-pool-credit-demandsp xs n)
                 :in-theory (enable fn2-pool-credit-demandsp))))
(defthm fn2-pool-credit-store-demands-nclasses
 (equal (fn2-pool-nclasses (fn2-pool-credit-store-demands xs i fn2-pool))
        (fn2-pool-nclasses fn2-pool))
 :hints (("Goal" :induct (fn2-pool-credit-store-demands xs i fn2-pool)
  :in-theory (enable fn2-pool-credit-store-demands fn2-pool-nclasses))))
(defthm fn2-pool-credit-store-demands-wfp
 (implies (fn2-pool-wfp fn2-pool)
          (fn2-pool-wfp (fn2-pool-credit-store-demands xs i fn2-pool)))
 :hints (("Goal" :induct (fn2-pool-credit-store-demands xs i fn2-pool)
  :in-theory (enable fn2-pool-credit-store-demands fn2-pool-wfp))))


(defun fn2-pool-credit-store-groups (groups i fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (fn2-pool-wfp fn2-pool) (natp i)
  (fn2-pool-credit-groupsp groups (fn2-pool-nclasses fn2-pool)))
  :guard-hints (("Goal" :in-theory (disable fn2-pool-credit-store-demands)))))
 (if (atom groups) fn2-pool
  (if (not (and (natp i) (< i (fn2-pool-credit-purpose-length fn2-pool))
                (< i (fn2-pool-credit-phase-length fn2-pool))
                (< i (fn2-pool-credit-group-nonce-length fn2-pool))
                (< i (fn2-pool-credit-group-owner-kind-length fn2-pool))
                (< i (fn2-pool-credit-group-owner-slot-length fn2-pool))
                (< i (fn2-pool-credit-group-owner-gen-length fn2-pool))
                (unsigned-byte-p 8 (caar groups)))) fn2-pool
   (let* ((fn2-pool (update-fn2-pool-credit-purposei i (caar groups) fn2-pool))
          (fn2-pool (update-fn2-pool-credit-phasei i *fn2-pool-credit-idle* fn2-pool))
          (fn2-pool (update-fn2-pool-credit-group-noncei i 0 fn2-pool))
          (fn2-pool (update-fn2-pool-credit-group-owner-kindi i 0 fn2-pool))
          (fn2-pool (update-fn2-pool-credit-group-owner-sloti i 0 fn2-pool))
          (fn2-pool (update-fn2-pool-credit-group-owner-geni i 0 fn2-pool))
          (fn2-pool (fn2-pool-credit-store-demands (cdar groups) (* i (fn2-pool-nclasses fn2-pool)) fn2-pool)))
    (fn2-pool-credit-store-groups (cdr groups) (+ 1 i) fn2-pool)))))
(defun fn2-pool-credit-store-protected (class groups fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (fn2-pool-wfp fn2-pool) (natp class))
  :measure (nfix (- (nfix (fn2-pool-nclasses fn2-pool)) (nfix class)))))
 (if (not (and (natp class) (< class (nfix (fn2-pool-nclasses fn2-pool))))) fn2-pool
  (if (not (and (< class (fn2-pool-credit-protected-length fn2-pool))
                (unsigned-byte-p 32 (fn2-pool-credit-request class groups)))) fn2-pool
   (let ((fn2-pool (update-fn2-pool-credit-protectedi class (fn2-pool-credit-request class groups) fn2-pool)))
    (fn2-pool-credit-store-protected (+ class 1) groups fn2-pool)))))

(defun fn2-pool-credit-configure (groups fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (b* (((unless (and (equal (fn2-pool-credit-configured fn2-pool) 0)
                    (true-listp groups) (posp (len groups)) (posp (fn2-pool-nclasses fn2-pool))
                    (< (len groups) *fn2-none*) (<= (len groups) (fn2-pool-rows fn2-pool))
                    (unsigned-byte-p 32 (* (len groups) (fn2-pool-nclasses fn2-pool)))
                    (fn2-pool-credit-groupsp groups (fn2-pool-nclasses fn2-pool)))) (mv :bounds fn2-pool))
      ((unless (fn2-pool-credit-config-roomp 0 groups fn2-pool)) (mv :exhausted fn2-pool))
      (g (len groups)) (c (fn2-pool-nclasses fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-protected c fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-purpose g fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-phase g fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-group-nonce g fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-group-owner-kind g fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-group-owner-slot g fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-group-owner-gen g fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-demand (* g c) fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-available (* g c) fn2-pool))
      (fn2-pool (fn2-pool-credit-store-groups groups 0 fn2-pool))
      (fn2-pool (fn2-pool-credit-store-protected 0 groups fn2-pool))
      (fn2-pool (update-fn2-pool-credit-group-count g fn2-pool))
      (fn2-pool (update-fn2-pool-credit-configured 1 fn2-pool)))
  (mv :ok fn2-pool)))

(defun fn2-pool-credit-ownerp (group nonce kind owner generation fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (and (fn2-pool-credit-shapep fn2-pool) (natp group) (< group (fn2-pool-credit-group-count fn2-pool))
      (posp nonce) (equal nonce (fn2-pool-credit-group-noncei group fn2-pool))
      (fn2-pool-mrefp kind owner generation) (posp kind) (posp generation)
      (equal kind (fn2-pool-credit-group-owner-kindi group fn2-pool))
      (equal owner (fn2-pool-credit-group-owner-sloti group fn2-pool))
      (equal generation (fn2-pool-credit-group-owner-geni group fn2-pool))))
(defun fn2-pool-credit-fullp (group class fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (fn2-pool-wfp fn2-pool) (natp class))
  :measure (nfix (- (nfix (fn2-pool-nclasses fn2-pool)) (nfix class)))))
 (if (not (and (fn2-pool-credit-shapep fn2-pool) (natp group) (< group (fn2-pool-credit-group-count fn2-pool)))) nil
  (if (not (and (natp class) (< class (nfix (fn2-pool-nclasses fn2-pool))))) t
   (let ((i (+ (* group (fn2-pool-nclasses fn2-pool)) class)))
    (and (equal (fn2-pool-credit-availablei i fn2-pool) (fn2-pool-credit-demandi i fn2-pool))
         (fn2-pool-credit-fullp group (+ class 1) fn2-pool))))))
(defun fn2-pool-credit-emptyp (group class fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (fn2-pool-wfp fn2-pool) (natp class))
  :measure (nfix (- (nfix (fn2-pool-nclasses fn2-pool)) (nfix class)))))
 (if (not (and (fn2-pool-credit-shapep fn2-pool) (natp group) (< group (fn2-pool-credit-group-count fn2-pool)))) nil
  (if (not (and (natp class) (< class (nfix (fn2-pool-nclasses fn2-pool))))) t
   (let ((i (+ (* group (fn2-pool-nclasses fn2-pool)) class)))
    (and (equal (fn2-pool-credit-availablei i fn2-pool) 0)
         (fn2-pool-credit-emptyp group (+ class 1) fn2-pool))))))
(defun fn2-pool-credit-begin (group purpose nonce kind owner generation fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (if (not (and (fn2-pool-credit-shapep fn2-pool) (natp group) (< group (fn2-pool-credit-group-count fn2-pool))
               (fn2-pool-mrefp kind owner generation) (posp kind) (posp generation) (posp nonce) (unsigned-byte-p 60 nonce)
               (equal purpose (fn2-pool-credit-purposei group fn2-pool))
               (member-equal (fn2-pool-credit-phasei group fn2-pool)
                (list *fn2-pool-credit-idle* *fn2-pool-credit-aborted-empty*))
               (or (< (fn2-pool-credit-group-noncei group fn2-pool) nonce)
                   (and (equal (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-aborted-empty*)
                        (fn2-pool-credit-ownerp group nonce kind owner generation fn2-pool)))
               (fn2-pool-credit-fullp group 0 fn2-pool))) (mv :owner fn2-pool)
  (let* ((fn2-pool (update-fn2-pool-credit-group-owner-kindi group kind fn2-pool))
         (fn2-pool (update-fn2-pool-credit-group-owner-sloti group owner fn2-pool))
         (fn2-pool (update-fn2-pool-credit-group-owner-geni group generation fn2-pool))
         (fn2-pool (update-fn2-pool-credit-group-noncei group nonce fn2-pool))
         (fn2-pool (update-fn2-pool-credit-phasei group *fn2-pool-credit-redeeming* fn2-pool)))
   (mv :ok fn2-pool))))
(defun fn2-pool-reserve-credit (group nonce class kind owner generation fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (b* (((unless (and (fn2-pool-credit-ownerp group nonce kind owner generation fn2-pool)
                    (equal (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-redeeming*)
                    (natp class) (< class (fn2-pool-nclasses fn2-pool)))) (mv :owner 0 0 fn2-pool))
      (i (+ (* group (fn2-pool-nclasses fn2-pool)) class))
      (available (fn2-pool-credit-availablei i fn2-pool)) (protected (fn2-pool-credit-protectedi class fn2-pool))
      ((unless (and (posp available) (posp protected) (<= protected (fn2-pool-class-countsi class fn2-pool))))
       (mv :exhausted 0 0 fn2-pool))
      ((mv code slot gen fn2-pool) (fn2-pool-reserve-body class kind owner generation fn2-pool))
      ((unless (eq code :ok)) (mv code slot gen fn2-pool))
      (fn2-pool (update-fn2-pool-credit-availablei i (- available 1) fn2-pool))
      (fn2-pool (update-fn2-pool-credit-protectedi class (- protected 1) fn2-pool))
      (fn2-pool (fn2-pool-put slot (credit-group group) (credit-nonce nonce)
       (credit-owner-kind kind) (credit-owner-slot owner) (credit-owner-gen generation))))
  (mv :ok slot gen fn2-pool)))
(defun fn2-pool-credit-end (group nonce kind owner generation fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (if (not (and (fn2-pool-credit-ownerp group nonce kind owner generation fn2-pool)
               (equal (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-redeeming*)
               (fn2-pool-credit-emptyp group 0 fn2-pool))) (mv :pending fn2-pool)
  (let ((fn2-pool (update-fn2-pool-credit-phasei group *fn2-pool-credit-held* fn2-pool))) (mv :ok fn2-pool))))
; Actual producers must establish no issue before END; full quota alone
; describes resources and does not prove absence of past IO.
(defun fn2-pool-credit-abort-empty (group nonce kind owner generation fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (if (not (and (fn2-pool-credit-ownerp group nonce kind owner generation fn2-pool)
               (equal (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-redeeming*)
               (fn2-pool-credit-fullp group 0 fn2-pool))) (mv :pending fn2-pool)
  (let ((fn2-pool (update-fn2-pool-credit-phasei group *fn2-pool-credit-aborted-empty* fn2-pool))) (mv :ok fn2-pool))))

(defun fn2-pool-release-credit (slot gen group nonce kind owner generation fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (b* (((unless (and (fn2-pool-credit-ownerp group nonce kind owner generation fn2-pool)
                    (member-equal (fn2-pool-credit-phasei group fn2-pool)
                     (list *fn2-pool-credit-redeeming* *fn2-pool-credit-held* *fn2-pool-credit-depleted*))
                    (natp slot) (< slot (fn2-pool-rows fn2-pool))
                    (equal group (fn2-pool-credit-group slot fn2-pool))
                    (equal nonce (fn2-pool-credit-nonce slot fn2-pool))
                    (equal kind (fn2-pool-credit-owner-kind slot fn2-pool))
                    (equal owner (fn2-pool-credit-owner-slot slot fn2-pool))
                    (equal generation (fn2-pool-credit-owner-gen slot fn2-pool))
                    (fn2-pool-release-countp slot fn2-pool))) (mv :owner fn2-pool))
      (class (fn2-pool-class slot fn2-pool))
      ((unless (< class (fn2-pool-nclasses fn2-pool))) (mv :bounds fn2-pool))
      (i (+ (* group (fn2-pool-nclasses fn2-pool)) class))
      (available (fn2-pool-credit-availablei i fn2-pool)) (protected (fn2-pool-credit-protectedi class fn2-pool))
      ((unless (and (< available (fn2-pool-credit-demandi i fn2-pool))
                    (unsigned-byte-p 32 (+ protected 1))
                    (<= protected (fn2-pool-class-countsi class fn2-pool)))) (mv :state fn2-pool))
      ((mv code fn2-pool) (fn2-pool-release-body slot gen kind owner generation fn2-pool))
      ((when (eq code :retired))
       (let ((fn2-pool (update-fn2-pool-credit-phasei group *fn2-pool-credit-depleted* fn2-pool))) (mv :retired fn2-pool)))
      ((unless (eq code :ok)) (mv code fn2-pool))
      (fn2-pool (fn2-pool-put slot (credit-group *fn2-none*) (credit-nonce 0)
       (credit-owner-kind 0) (credit-owner-slot 0) (credit-owner-gen 0)))
      (fn2-pool (update-fn2-pool-credit-availablei i (+ available 1) fn2-pool))
      (fn2-pool (update-fn2-pool-credit-protectedi class (+ protected 1) fn2-pool))
      (fn2-pool (if (and (equal (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-held*)
                               (fn2-pool-credit-fullp group 0 fn2-pool))
                       (update-fn2-pool-credit-phasei group *fn2-pool-credit-idle* fn2-pool) fn2-pool)))
  (mv :ok fn2-pool)))

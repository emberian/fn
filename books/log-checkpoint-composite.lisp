(local (include-book "../tests/acl2/lc-open-composite-counterexample-tests"))
(local (include-book "../tests/acl2/lc-cold-control-fallback-tests"))
(local (defun lca4-observe (disk fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((input (lco-id5-input 1)) (segs (fn-lc-at 3 input))
        (header (fn-lc-adopted-header disk :lc :eager))
        (selection (fn-lc-open-selection disk :lc :eager 0 segs header))
        (before (fn-lbc-p fn-lbc)) (k 0) (max (fn-lc-tail-max header)))
  (mv-let (answer fn-lbc after-disk after-segs trace owner)
   (fn-lc-open disk :lc :eager (fn-lc-at 2 input) 8 4 segs
               (make-list 1100 :initial-element :ok) fn-lbc)
   (declare (ignore after-disk after-segs owner))
   (mv (list before (fn-lc-segsp segs)
             (equal (car selection) :checkpoint) (natp k)
             (<= (len (ec-call (fn-lc-selection-tail selection))) k)
             answer (fn-lc-read-octets trace)
             (+ (* 2 (fn-lc-root-slot-octets))
                (* (len (fn-lc-open-metadata-pages disk :lc :eager))
                   (fn-lc-page-octets))
                (* (+ 1 k) (fn-lc-entry-octets-bound max)))
             (+ (* 2 (fn-lc-root-slot-octets))
                (* (len (fn-lc-directory-path-pages disk :lc :eager))
                   (fn-lc-page-octets))
                (* (+ 1 k) (fn-lc-entry-octets-bound max)))) fn-lbc)))))
(local (defun lca4-fixture (kind)
 (declare (xargs :guard t :verify-guards nil))
 (let ((disk (case kind (:page99 (lcc-fallback-disk))
                       (:wide (lco-wide-fallback-disk 1030))
                       (otherwise (fn-lc-at 0 (lco-id5-input 1))))))
  (with-local-stobj fn-lbc
   (mv-let (out fn-lbc) (lca4-observe disk fn-lbc) out)))))
(local (verify-guards lca4-observe))
(local (verify-guards lca4-fixture))
; Whole five-hypothesis SAT controls and checked old-text mutation BEFORE proof.
(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
 (assert-event
  (let ((out (lca4-fixture :empty)))
   (and (nth 0 out) (nth 1 out) (nth 2 out) (nth 3 out) (nth 4 out)
        (<= (nth 6 out) (nth 7 out)))))
 (assert-event
  (let ((out (lca4-fixture :page99)))
   (and (nth 0 out) (nth 1 out) (nth 2 out) (nth 3 out) (nth 4 out)
        (<= (nth 6 out) (nth 7 out)))))
 (assert-event
  (let ((out (lca4-fixture :wide)))
   (and (nth 0 out) (nth 1 out) (nth 2 out) (nth 3 out) (nth 4 out)
        (equal (nth 6 out) 17088772)
        (<= (nth 6 out) (nth 7 out))
        (> (nth 6 out) (nth 8 out)))))
 (value-triple (list (lca4-fixture :empty) (lca4-fixture :page99)
                     (lca4-fixture :wide))))

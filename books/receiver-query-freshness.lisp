; Internal bounded registered observations. No STATE/frontier mutation.
; Publication-to-durable-Store correspondence and owner authority capture
; remain obligations of the actual publication/owner producers.
(in-package "ACL2")
(include-book "index-backing-generations")

(defthm fn-ibp-node-query-read-retains-natural-fuel
 (implies (and (natp fuel) (natp depth))
  (and (natp (mv-nth 4 (fn-ibp-node-query-read token fuel slot depth fn-ibp-node)))
       (<= (mv-nth 4 (fn-ibp-node-query-read token fuel slot depth fn-ibp-node)) fuel)))
 :hints (("Goal" :induct (fn-ibp-node-query-read token fuel slot depth fn-ibp-node)
          :in-theory (e/d (fn-ibp-node-query-read)
                          (fn-ibp-query-slot-livep fn-ibp-query-tokenp))))
 :rule-classes
 (:rewrite
  (:type-prescription
   :corollary
   (implies (and (natp fuel) (natp depth))
    (natp (mv-nth 4 (fn-ibp-node-query-read token fuel slot depth fn-ibp-node)))))))

(defun fn-mio-query-capture-read (token fuel fn-mio$c)
 (declare (xargs :stobjs fn-mio$c :guard (natp fuel) :verify-guards nil))
 (stobj-let ((fn-index-backing (fn-mio$c-provider fn-mio$c)))
  (word capture left)
  (if (not (fn-ibp-query-tokenp token))
      (mv :stale nil fuel)
   (let ((depth (fn-ibp-slot-depth fn-index-backing)))
    (if (>= (- (nth 2 token) 1) (fn-ibp-pool-capacity fn-index-backing))
        (mv :stale nil fuel)
     (stobj-let ((fn-ibp-node (fn-ibp-registry fn-index-backing)))
      (word capture left)
      (mv-let (word control capture borrow left)
       (fn-ibp-node-query-read token fuel (- (nth 2 token) 1) depth fn-ibp-node)
       (declare (ignore control borrow))
       (mv word capture left))
      (mv word capture left)))))
  (mv word capture left)))
(verify-guards fn-mio-query-capture-read)

(defun fn-mio-current-publication-read (fuel fn-mio$c)
 (declare (xargs :stobjs fn-mio$c :guard (natp fuel) :verify-guards nil))
 (let* ((association (fn-ibp-current-publication fn-mio$c))
        (token (fn-omk-at 1 association)))
  (if (not (and (fn-omk-widthp association 3)
                (eq (fn-omk-at 0 association) :installed-publication)
                (fn-ibp-generation-tokenp token)))
      (mv :unavailable nil fuel)
   (mv-let (word row left) (fn-mio-generation-read token fuel fn-mio$c)
    (if (and (eq word :present)
             (equal token (fn-omk-at 1 row))
             (eq (fn-omk-at 7 row) :live)
             (posp (fn-omk-at 3 row))
             (equal (fn-ipub-generation (fn-omk-at 2 association))
                    (fn-ipub-generation (fn-omk-at 2 row)))
             (equal (fn-ipub-table-id (fn-omk-at 2 association))
                    (fn-ipub-table-id (fn-omk-at 2 row)))
             (equal (fn-ipub-row-id (fn-omk-at 2 association))
                    (fn-ipub-row-id (fn-omk-at 2 row))))
        (mv :published (fn-omk-at 2 row) left)
      (mv (if (eq word :yield) :yield :unavailable) nil left))))))
(verify-guards fn-mio-current-publication-read)

; Internal scalar comparison only. Generation is the maintained key-binding
; identity; opaque keys and retained table/row graphs are never compared here.
; :current is a publication-coordinate result, not durable or authority credit.
(defun fn-rqf-publication-status (capture publication)
 (declare (xargs :guard t))
 (if (not (and (natp (fn-ibp-capture-count capture))
               (natp (fn-ibp-capture-frontier capture))
               (posp (fn-ibp-capture-generation capture))
               (posp (fn-ibp-capture-table-root-id capture))
               (posp (fn-ibp-capture-row-root-id capture))
               (natp (fn-ipub-count publication))
               (natp (fn-ipub-frontier publication))
               (posp (fn-ipub-generation publication))
               (posp (fn-ipub-table-id publication))
               (posp (fn-ipub-row-id publication))))
     :unavailable
  (if (and (equal (fn-ibp-capture-count capture) (fn-ipub-count publication))
           (equal (fn-ibp-capture-frontier capture) (fn-ipub-frontier publication))
           (equal (fn-ibp-capture-generation capture) (fn-ipub-generation publication))
           (equal (fn-ibp-capture-table-root-id capture) (fn-ipub-table-id publication))
           (equal (fn-ibp-capture-row-root-id capture) (fn-ipub-row-id publication)))
      :current :recapture-required)))

(defun fn-mio-query-publication-recheck (token fuel fn-mio$c)
 (declare (xargs :stobjs fn-mio$c :guard (natp fuel) :verify-guards nil))
 (mv-let (word capture left) (fn-mio-query-capture-read token fuel fn-mio$c)
  (if (not (eq word :live))
      (mv word left)
   (mv-let (published publication remaining)
    (fn-mio-current-publication-read left fn-mio$c)
    (if (not (eq published :published))
        (mv published remaining)
      (mv (fn-rqf-publication-status capture publication) remaining))))))
(verify-guards fn-mio-query-publication-recheck)

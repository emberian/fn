; Typed semantic reachability is emitted while the actual decoded source
; entry is retained, before its cursor may advance. Pending transitive work
; cannot masquerade as retention completion or permit root1 completion.
(in-package "ACL2")
(include-book "checkpoint-metadata-state")
(include-book "checkpoint-source-retention")
(include-book "checkpoint-build-state")
(include-book "checkpoint-retained-entry")
(include-book "source-manifest-codec")
(fn2-book-layer :c)

(defun fn2-checkpoint-metadata-retain-entry (fn2-checkpoint-metadata fn2-csnapshot fn2-checkpoint-build
                                            fn2-run-builds fn2-run-writers fn2-fields fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
 (declare (xargs :stobjs (fn2-checkpoint-metadata fn2-csnapshot fn2-checkpoint-build fn2-run-builds fn2-run-writers fn2-fields
                          fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
  :guard (and (fn2-checkpoint-metadata-wfp fn2-checkpoint-metadata) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-checkpoint-build-wfp fn2-checkpoint-build) (fn2-run-builds-wfp fn2-run-builds) (fn2-run-writers-wfp fn2-run-writers)
              (fn2-fields-wfp fn2-fields) (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges)
              (fn2-ops-wfp fn2-ops) (fn2-checkpoints-wfp fn2-checkpoints))))
 (b* (((unless (and (fn2-checkpoint-metadata-ownerp fn2-checkpoint-metadata fn2-csnapshot fn2-run-builds fn2-run-writers)
                     (equal (fn2-checkpoint-metadata-held 0 fn2-checkpoint-metadata) 1)))
       (mv :source fn2-checkpoint-metadata fn2-extents fn2-alloc-edges))
      (token (fn2-checkpoint-metadata-token 0 fn2-checkpoint-metadata))
      (kind (fn2-checkpoint-metadata-owner-kind 0 fn2-checkpoint-metadata))
      (owner (fn2-checkpoint-metadata-owner-slot 0 fn2-checkpoint-metadata))
      (generation (fn2-checkpoint-metadata-owner-gen 0 fn2-checkpoint-metadata))
      (b (fn2-checkpoint-metadata-build 0 fn2-checkpoint-metadata))
      (sid (fn2-run-builds-schema b fn2-run-builds))
      (base (fn2-checkpoint-metadata-entry-base 0 fn2-checkpoint-metadata))
      ((unless (and (fn2-checkpoint-build-ownerp token kind owner generation fn2-checkpoint-build fn2-csnapshot)
                     (fn2-checkpoint-builder-ownerp (fn2-checkpoint-build-candidate 0 fn2-checkpoint-build) token kind owner generation fn2-checkpoints)
                     (equal (fn2-checkpoint-build-phase 0 fn2-checkpoint-build) *fn2-checkpoint-build-phase-await-roots*)
                     (equal (fn2-checkpoint-metadata-copy-field 0 fn2-checkpoint-metadata) (fn2-run-layout-fields sid 0))
                     (equal (fn2-checkpoint-metadata-copy-offset 0 fn2-checkpoint-metadata) 0)
                     (<= (+ base (fn2-run-layout-fields sid 0)) (fn2-fields-rows fn2-fields))))
       (mv :source fn2-checkpoint-metadata fn2-extents fn2-alloc-edges))
      (c (fn2-checkpoint-build-candidate 0 fn2-checkpoint-build))
      (checkpoint (fn2-checkpoint-build-checkpoint 0 fn2-checkpoint-build)))
  (cond
   ((equal sid 2)
    (b* ((unit (fn2-fields-value (+ base *fn2-article-entry-field-location-unit*) fn2-fields))
         (epoch (fn2-fields-value (+ base *fn2-article-entry-field-location-epoch*) fn2-fields))
         (allocation (fn2-fields-value (+ base *fn2-article-entry-field-location-allocation*) fn2-fields))
         (location (fn2-fields-value (+ base *fn2-article-entry-field-location-kind*) fn2-fields))
         (bytes (fn2-fields-value (+ base *fn2-article-entry-field-bytes*) fn2-fields))
         (extent (floor unit *fn2-storage-extent-units*))
         ((unless (and (equal (mod unit *fn2-storage-extent-units*) 0) (fn2-alloc-slotp extent fn2-extents)
                        (equal location (if (fn2-am-manifestp bytes) 1 0))
                        (member (fn2-extents-state extent fn2-extents) (list *fn2-extent-state-allocated* *fn2-extent-state-retire-pending*))))
          (mv :reference fn2-checkpoint-metadata fn2-extents fn2-alloc-edges))
         ((mv code fn2-extents fn2-alloc-edges)
          (fn2-checkpoint-source-claim c checkpoint extent epoch allocation fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints))
         ((unless (eq code :ok)) (mv code fn2-checkpoint-metadata fn2-extents fn2-alloc-edges))
         (fn2-checkpoint-metadata (fn2-checkpoint-metadata-set-retention-stage 0 2 fn2-checkpoint-metadata)))
     ; Raw and manifest sources both require the actual stored-byte digest
     ; before integrity closure; direct protection is only reachability.
     (mv :payload-required fn2-checkpoint-metadata fn2-extents fn2-alloc-edges)))
   ((equal sid 10)
    (b* ((unit (fn2-fields-value (+ base *fn2-manifest-entry-field-root-unit*) fn2-fields))
         (epoch (fn2-fields-value (+ base *fn2-manifest-entry-field-root-epoch*) fn2-fields))
         (allocation (fn2-fields-value (+ base *fn2-manifest-entry-field-root-allocation*) fn2-fields))
         ((unless (equal (mod unit *fn2-storage-extent-units*) 0)) (mv :reference fn2-checkpoint-metadata fn2-extents fn2-alloc-edges))
         ((mv code fn2-extents fn2-alloc-edges)
          (fn2-checkpoint-source-claim c checkpoint (floor unit *fn2-storage-extent-units*) epoch allocation
           fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints))
         ((unless (eq code :ok)) (mv code fn2-checkpoint-metadata fn2-extents fn2-alloc-edges))
         (fu (fn2-fields-value (+ base *fn2-manifest-entry-field-filter-unit*) fn2-fields))
         (fe (fn2-fields-value (+ base *fn2-manifest-entry-field-filter-epoch*) fn2-fields))
         (fa (fn2-fields-value (+ base *fn2-manifest-entry-field-filter-allocation*) fn2-fields))
         ((mv code fn2-extents fn2-alloc-edges)
          (if (and (equal fu 0) (equal fe 0) (equal fa 0)) (mv :ok fn2-extents fn2-alloc-edges)
           (if (equal (mod fu *fn2-storage-extent-units*) 0)
            (fn2-checkpoint-source-claim c checkpoint (floor fu *fn2-storage-extent-units*) fe fa fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
            (mv :reference fn2-extents fn2-alloc-edges))))
         ((unless (eq code :ok)) (mv code fn2-checkpoint-metadata fn2-extents fn2-alloc-edges))
         (fn2-checkpoint-metadata (fn2-checkpoint-metadata-set-retention-stage 0 3 fn2-checkpoint-metadata)))
     ; Preserve semantic schema10 rows, but do not call its existing run tree
     ; closed merely because the root and filter were retained.
     (mv :tree-required fn2-checkpoint-metadata fn2-extents fn2-alloc-edges)))
   ((fn2-run-layout-physical-ref-p sid) (mv :unsupported-reference fn2-checkpoint-metadata fn2-extents fn2-alloc-edges))
   (t (let ((fn2-checkpoint-metadata (fn2-checkpoint-metadata-set-retention-stage 0 1 fn2-checkpoint-metadata)))
       (mv :ready fn2-checkpoint-metadata fn2-extents fn2-alloc-edges))))))

(defun fn2-checkpoint-metadata-entry-bind (fn2-checkpoint-retained-entry fn2-checkpoint-metadata fn2-checkpoint-build fn2-csnapshot
                                         fn2-run-builds fn2-run-writers fn2-checkpoints fn2-fields)
 (declare (xargs :stobjs (fn2-checkpoint-retained-entry fn2-checkpoint-metadata fn2-checkpoint-build fn2-csnapshot
                          fn2-run-builds fn2-run-writers fn2-checkpoints fn2-fields)
  :guard (and (fn2-checkpoint-retained-entry-wfp fn2-checkpoint-retained-entry) (fn2-checkpoint-metadata-wfp fn2-checkpoint-metadata)
              (fn2-checkpoint-build-wfp fn2-checkpoint-build) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-run-builds-wfp fn2-run-builds) (fn2-run-writers-wfp fn2-run-writers)
              (fn2-checkpoints-wfp fn2-checkpoints) (fn2-fields-wfp fn2-fields))))
 (b* (((unless (and (< 0 (fn2-checkpoint-retained-entry-rows fn2-checkpoint-retained-entry))
                     (equal (fn2-checkpoint-retained-entry-phase 0 fn2-checkpoint-retained-entry) *fn2-checkpoint-retained-entry-phase-free*)
                     (unsigned-byte-p 60 (+ 1 (fn2-checkpoint-retained-entry-serial 0 fn2-checkpoint-retained-entry)))
                     (fn2-checkpoint-metadata-ownerp fn2-checkpoint-metadata fn2-csnapshot fn2-run-builds fn2-run-writers)
                     (equal (fn2-checkpoint-metadata-held 0 fn2-checkpoint-metadata) 1)
                     (equal (fn2-checkpoint-metadata-phase 0 fn2-checkpoint-metadata) *fn2-checkpoint-metadata-phase-feeding*)))
       (mv :source fn2-checkpoint-retained-entry))
      (token (fn2-checkpoint-metadata-token 0 fn2-checkpoint-metadata))
      (kind (fn2-checkpoint-metadata-owner-kind 0 fn2-checkpoint-metadata))
      (owner (fn2-checkpoint-metadata-owner-slot 0 fn2-checkpoint-metadata))
      (generation (fn2-checkpoint-metadata-owner-gen 0 fn2-checkpoint-metadata))
      (b (fn2-checkpoint-metadata-build 0 fn2-checkpoint-metadata))
      (base (fn2-checkpoint-metadata-entry-base 0 fn2-checkpoint-metadata))
      ((unless (and (fn2-checkpoint-build-ownerp token kind owner generation fn2-checkpoint-build fn2-csnapshot)
                     (fn2-checkpoint-builder-ownerp (fn2-checkpoint-build-candidate 0 fn2-checkpoint-build) token kind owner generation fn2-checkpoints)
                     (equal (fn2-run-builds-schema b fn2-run-builds) 2)
                     (equal (fn2-checkpoint-metadata-copy-field 0 fn2-checkpoint-metadata) (fn2-run-layout-fields 2 0))
                     (equal (fn2-checkpoint-metadata-copy-offset 0 fn2-checkpoint-metadata) 0)
                     (<= (+ base *fn2-article-entry-num-fields*) (fn2-fields-rows fn2-fields))
                     (equal (fn2-checkpoint-metadata-retention-stage 0 fn2-checkpoint-metadata) 2)))
       (mv :entry fn2-checkpoint-retained-entry))
      (fn2-checkpoint-retained-entry (fn2-checkpoint-retained-entry-put 0 (phase *fn2-checkpoint-retained-entry-phase-held*)
       (serial (+ 1 (fn2-checkpoint-retained-entry-serial 0 fn2-checkpoint-retained-entry)))
       (token token) (owner-kind kind) (owner-slot owner) (owner-gen generation)
       (candidate (fn2-checkpoint-build-candidate 0 fn2-checkpoint-build)) (checkpoint (fn2-checkpoint-build-checkpoint 0 fn2-checkpoint-build))
       (schema 2) (field-base base)
       (source-slot (fn2-checkpoint-metadata-scratch 0 fn2-checkpoint-metadata))
       (source-gen (fn2-checkpoint-metadata-scratch-gen 0 fn2-checkpoint-metadata)) (origin *fn2-checkpoint-retained-entry-origin-snapshot*)
       (source-kind (fn2-checkpoint-metadata-source-kind 0 fn2-checkpoint-metadata))
       (source-row (fn2-checkpoint-metadata-source-row 0 fn2-checkpoint-metadata))
       (source-rank (fn2-checkpoint-metadata-run-rank 0 fn2-checkpoint-metadata))
       (source-position (fn2-checkpoint-metadata-position 0 fn2-checkpoint-metadata)))))
  (mv :ok fn2-checkpoint-retained-entry)))

; Only the matching actual snapshot origin can consume a completed payload
; closure and unblock ingestion. The entry and byte window stayed retained.
(defun fn2-checkpoint-metadata-entry-consume (fn2-checkpoint-retained-entry fn2-checkpoint-metadata fn2-csnapshot
                                            fn2-checkpoints fn2-fields)
 (declare (xargs :stobjs (fn2-checkpoint-retained-entry fn2-checkpoint-metadata fn2-csnapshot fn2-checkpoints fn2-fields)
  :guard (and (fn2-checkpoint-retained-entry-wfp fn2-checkpoint-retained-entry) (fn2-checkpoint-metadata-wfp fn2-checkpoint-metadata)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-fields-wfp fn2-fields))))
 (b* (((unless (and (fn2-checkpoint-retained-entry-ownerp fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields)
                     (equal (fn2-checkpoint-retained-entry-phase 0 fn2-checkpoint-retained-entry) *fn2-checkpoint-retained-entry-phase-payload-complete*)
                     (equal (fn2-checkpoint-retained-entry-origin 0 fn2-checkpoint-retained-entry) *fn2-checkpoint-retained-entry-origin-snapshot*)
                     (< 0 (fn2-checkpoint-metadata-rows fn2-checkpoint-metadata))
                     (equal (fn2-checkpoint-metadata-held 0 fn2-checkpoint-metadata) 1)
                     (equal (fn2-checkpoint-metadata-token 0 fn2-checkpoint-metadata) (fn2-checkpoint-retained-entry-token 0 fn2-checkpoint-retained-entry))
                     (equal (fn2-checkpoint-metadata-run-rank 0 fn2-checkpoint-metadata) (fn2-checkpoint-retained-entry-source-rank 0 fn2-checkpoint-retained-entry))
                     (equal (fn2-checkpoint-metadata-position 0 fn2-checkpoint-metadata) (fn2-checkpoint-retained-entry-source-position 0 fn2-checkpoint-retained-entry))
                     (equal (fn2-checkpoint-metadata-source-kind 0 fn2-checkpoint-metadata) (fn2-checkpoint-retained-entry-source-kind 0 fn2-checkpoint-retained-entry))
                     (equal (fn2-checkpoint-metadata-source-row 0 fn2-checkpoint-metadata) (fn2-checkpoint-retained-entry-source-row 0 fn2-checkpoint-retained-entry))
                     (equal (fn2-checkpoint-metadata-scratch 0 fn2-checkpoint-metadata) (fn2-checkpoint-retained-entry-source-slot 0 fn2-checkpoint-retained-entry))
                     (equal (fn2-checkpoint-metadata-scratch-gen 0 fn2-checkpoint-metadata) (fn2-checkpoint-retained-entry-source-gen 0 fn2-checkpoint-retained-entry))
                     (equal (fn2-checkpoint-metadata-entry-base 0 fn2-checkpoint-metadata) (fn2-checkpoint-retained-entry-field-base 0 fn2-checkpoint-retained-entry))))
       (mv :source fn2-checkpoint-retained-entry fn2-checkpoint-metadata))
      (fn2-checkpoint-metadata (fn2-checkpoint-metadata-set-retention-stage 0 1 fn2-checkpoint-metadata))
      (fn2-checkpoint-retained-entry (fn2-checkpoint-retained-entry-set-phase 0 *fn2-checkpoint-retained-entry-phase-free* fn2-checkpoint-retained-entry)))
  (mv :ok fn2-checkpoint-retained-entry fn2-checkpoint-metadata)))

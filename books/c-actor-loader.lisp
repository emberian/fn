   (defun fn2-c-actor-loader-resolvedp (id gen fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (b* (((mv code kind tx & & & & &) (fn2-c-actor-loader-plan id gen fn2-core))
         ((unless (and (eq code :ok)
           (cond ((equal kind *fn2-txn-kind*)

; Actual non-query actors derive their bounded loader jobs from admitted
; machine geometry. This book shares the physical loader and region walker.
(in-package "ACL2")
(include-book "machines-c-read-loader")
(include-book "run-physical-region")
(fn2-book-layer :c)

(defun fn2-c-actor-load-active (i b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads)
 (declare (xargs :stobjs fn2-run-loads :guard (fn2-run-loads-wfp fn2-run-loads)
 :measure (nfix (- (fn2-run-load-region-count n0 n1 n2) (nfix i)))))
 (b* (((when (>= (nfix i) (fn2-run-load-region-count n0 n1 n2))) (mv :clear 0 0))
      (c (fn2-run-load-region-cursor i b0 n0 b1 n1 b2 n2))
      ((unless (< c (fn2-run-loads-rows fn2-run-loads))) (mv :bounds 0 0))
      (phase (fn2-run-loads-phase c fn2-run-loads))
      ((unless (or (equal phase *fn2-run-load-phase-idle*)
                    (fn2-run-load-ownerp c kind owner generation fn2-run-loads))) (mv :owner c phase))
      ((unless (member phase (list *fn2-run-load-phase-idle* *fn2-run-load-phase-reserved* *fn2-run-load-phase-ready*)))
       (mv (cond ((equal phase *fn2-run-load-phase-read*) :read)
                 ((equal phase *fn2-run-load-phase-wait*) :wait)
                 ((member phase (list *fn2-run-load-phase-copy* *fn2-run-load-phase-context* *fn2-run-load-phase-verify* *fn2-run-load-phase-header*)) :step)
                 (t :recovery-required)) c phase)))
  (fn2-c-actor-load-active (+ (nfix i) 1) b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads)))

; A successor resolver and XL share TX's cursor but retain different active
; selectors. Neither a cursor number nor an owner scalar alone proves a MISS.
(defun fn2-c-actor-tx-missp (tx fn2-succ-txns fn2-succ-slots fn2-run-cursors)
 (declare (xargs :stobjs (fn2-succ-txns fn2-succ-slots fn2-run-cursors)
 :guard (and (fn2-succ-txns-wfp fn2-succ-txns) (fn2-succ-slots-wfp fn2-succ-slots) (fn2-run-cursors-wfp fn2-run-cursors))))
 (and (natp tx) (< tx (fn2-succ-txns-rows fn2-succ-txns)) (< tx (fn2-run-cursors-rows fn2-run-cursors))
      (equal (fn2-run-cursors-physical tx fn2-run-cursors) 1)
      (equal (fn2-run-cursors-phase tx fn2-run-cursors) *fn2-run-cursor-phase-miss*)
      (or (and (equal (fn2-succ-txns-lphase tx fn2-succ-txns) *fn2-succ-lookup-scan*)
               (equal (fn2-run-cursors-source-row tx fn2-run-cursors) (fn2-succ-txns-lrow tx fn2-succ-txns)))
          (let ((s (+ (* tx *fn2-succ-slots*) (fn2-succ-txns-ri tx fn2-succ-txns))))
           (and (equal (fn2-succ-txns-rstate tx fn2-succ-txns) *fn2-succ-resolve-look*)
                (< (fn2-succ-txns-ri tx fn2-succ-txns) *fn2-succ-slots*) (< s (fn2-succ-slots-rows fn2-succ-slots))
                (equal (fn2-run-cursors-schema tx fn2-run-cursors) (fn2-succ-slots-sid s fn2-succ-slots))
                (equal (fn2-run-cursors-priority tx fn2-run-cursors) (fn2-succ-txns-rbound tx fn2-succ-txns)))))))
(defun fn2-c-actor-tx-owner (tx kind owner generation fn2-succ-txns fn2-succ-slots fn2-run-cursors fn2-run-loads fn2-checkpoint-summary-leases)
 (declare (xargs :stobjs (fn2-succ-txns fn2-succ-slots fn2-run-cursors fn2-run-loads fn2-checkpoint-summary-leases)
 :guard (and (fn2-succ-txns-wfp fn2-succ-txns) (fn2-succ-slots-wfp fn2-succ-slots) (fn2-run-cursors-wfp fn2-run-cursors)
  (fn2-run-loads-wfp fn2-run-loads) (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases))))
 (b* (((unless (and (fn2-c-actor-tx-missp tx fn2-succ-txns fn2-succ-slots fn2-run-cursors)
                    (< tx (fn2-run-loads-rows fn2-run-loads)) (< tx (fn2-checkpoint-summary-leases-rows fn2-checkpoint-summary-leases))
                    (fn2-run-load-ownerp tx kind owner generation fn2-run-loads)
                    (or (equal (fn2-checkpoint-summary-leases-live tx fn2-checkpoint-summary-leases) 0)
                        (and (equal kind (fn2-checkpoint-summary-leases-owner-kind tx fn2-checkpoint-summary-leases))
                             (equal owner (fn2-checkpoint-summary-leases-owner-slot tx fn2-checkpoint-summary-leases))
                             (equal generation (fn2-checkpoint-summary-leases-owner-gen tx fn2-checkpoint-summary-leases))))))
       (mv :source 0 0 fn2-run-cursors))
      (phase (fn2-run-loads-phase tx fn2-run-loads))
      (fn2-run-cursors (fn2-run-cursors-put tx (okind kind) (oslot owner) (ogen generation))))
  (mv :bind tx phase fn2-run-cursors)))
(fn2-rd-shape fn2-c-actor-tx-owner
 (tx kind owner generation fn2-succ-txns fn2-succ-slots fn2-run-cursors fn2-run-loads fn2-checkpoint-summary-leases)
 ((fn2-run-cursors 3))
 (fn2-succ-txns fn2-succ-slots fn2-run-cursors fn2-run-loads fn2-checkpoint-summary-leases)
 (fn2-c-actor-tx-missp fn2-run-load-ownerp))

; Terminal inspection follows the actual park updates, not a caller's ordinal.
(defun fn2-c-actor-loader-parkedp (i b0 n0 b1 n1 b2 n2 kind owner generation
 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary-leases fn2-pool)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary-leases fn2-pool)
 :measure (nfix (- (fn2-run-load-region-count n0 n1 n2) (nfix i)))
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-run-cursors-wfp fn2-run-cursors)
             (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases) (fn2-pool-wfp fn2-pool))))
 (and (<= (fn2-run-load-region-count n0 n1 n2) *fn2-b-query-loader-jobs*)
  (or (>= (nfix i) (fn2-run-load-region-count n0 n1 n2))
   (let ((c (fn2-run-load-region-cursor i b0 n0 b1 n1 b2 n2)))
    (and (< c (fn2-run-loads-rows fn2-run-loads)) (< c (fn2-run-cursors-rows fn2-run-cursors))
         (< c (fn2-checkpoint-summary-leases-rows fn2-checkpoint-summary-leases))
         (equal (fn2-checkpoint-summary-leases-live c fn2-checkpoint-summary-leases) 0)
         (equal (fn2-run-cursors-phase c fn2-run-cursors) *fn2-run-cursor-phase-idle*)
         (equal (fn2-run-cursors-physical c fn2-run-cursors) 0)
         (or (and (equal (fn2-run-loads-phase c fn2-run-loads) *fn2-run-load-phase-idle*)
                  (equal (fn2-run-loads-windows c fn2-run-loads) 0))
             (and (fn2-run-load-ownerp c kind owner generation fn2-run-loads)
                  (equal (fn2-run-loads-lease-mode c fn2-run-loads) *fn2-run-load-lease-mode-owned*)
                  (equal (fn2-run-loads-phase c fn2-run-loads) *fn2-run-load-phase-reserved*)
                  (equal (fn2-run-loads-windows c fn2-run-loads) 2) (equal (fn2-run-loads-pending c fn2-run-loads) 0)
                  (equal (fn2-run-loads-tag c fn2-run-loads) 0) (equal (fn2-run-loads-source c fn2-run-loads) *fn2-none*)
                  (eq (fn2-pool-workspace-code (fn2-run-loads-page c fn2-run-loads) (fn2-run-loads-page-gen c fn2-run-loads) kind owner generation fn2-pool) :ok)
                  (eq (fn2-pool-workspace-code (fn2-run-loads-scratch c fn2-run-loads) (fn2-run-loads-scratch-gen c fn2-run-loads) kind owner generation fn2-pool) :ok)))
         (fn2-c-actor-loader-parkedp (+ (nfix i) 1) b0 n0 b1 n1 b2 n2 kind owner generation
          fn2-run-loads fn2-run-cursors fn2-checkpoint-summary-leases fn2-pool))))))

(defcost fn2-c-actor-loader-park-step :answers t
 :tables (fn2-core-machines fn2-txn-table fn2-auth-table fn2-cns-table fn2-core-id-decides fn2-core-reads fn2-core-succ-txns fn2-core-run-loads fn2-core-run-cursors fn2-core-checkpoint-summary fn2-core-checkpoint-summary-leases fn2-core-pool)

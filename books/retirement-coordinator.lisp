(in-package "ACL2")
(include-book "retirement")

; Materialized after B's existing planner and member-admission operations.
; No general transaction decoder is opened to lifecycle input: this producer
; constructs the sole record after selecting its actual containing batch.
(defmacro fn2-retirement-coordinator-events ()
 '(progn
 (defun fn2-retirement-admit (extent epoch allocation slot gen okind oslot ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((unless (and (unsigned-byte-p 32 extent) (unsigned-byte-p 60 epoch)
                     (unsigned-byte-p 60 allocation) (unsigned-byte-p 32 slot)
                     (unsigned-byte-p 60 gen) (posp okind) (unsigned-byte-p 8 okind)
                     (unsigned-byte-p 32 oslot) (unsigned-byte-p 60 ogen)
                     (not (fn2-core-stopped-p fn2-core))))
        (mv :admission 0 0 fn2-core))
       ((mv pick id partner) (fn2-commit-pick fn2-core))
       ((when (or (eq pick :exhausted) (not (fn2-commit-settled-room 1 fn2-core))))
        (mv :exhausted 0 0 fn2-core))
       ((unless (fn2-commit-idp id fn2-core)) (mv :admission 0 0 fn2-core))
       ((mv frontier & & &) (fn2-commit-frontier fn2-core))
       (batch (if (eq pick :open) frontier (fn2-machine-batch-no id fn2-core)))
       ((unless (and (posp batch) (unsigned-byte-p 60 batch))) (mv :admission 0 0 fn2-core))
       (valid
        (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (valid)
         (and (eq (fn2-alloc-handle-code extent epoch allocation fn2-extents) :ok)
              (= (fn2-extents-state extent fn2-extents) *fn2-extent-state-allocated*)) valid))
       ((unless valid) (mv :admission 0 0 fn2-core))
       (base (* 128 (fn2-commit-row id fn2-core)))
       ((mv packed len need fn2-core)
        (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
         (packed len need fn2-fields fn2-pool)
         (mv-let (code end fn2-fields fn2-pool)
          (fn2-retirement-pack-member extent epoch allocation batch base slot gen 0
                                      okind oslot ogen fn2-fields fn2-pool)
          (mv code (nfix end)
              (if (and (eq code :ok) (natp base)
                       (<= (+ base *fn2-format-txn-record-num-fields* *fn2-format-retirement-num-fields*)
                           (fn2-fields-rows fn2-fields)))
                  (+ *fn2-commit-txn-header-room*
                     (fn2-format-retirement-size (+ base *fn2-format-txn-record-num-fields*) fn2-fields)) 0)
              fn2-fields fn2-pool))
         (mv packed len need fn2-core)))
       ((unless (and (eq packed :ok) (posp len) (natp need) (<= need *fn2-commit-records-room*)))
        (mv :admission 0 0 fn2-core))
       ; No scheduling/host boundary lies between selection, encoding and join.
       ((mv code admitted event fn2-core)
        (if (eq pick :open)
            (fn2-commit-txn-open id partner slot gen len okind oslot ogen need fn2-core)
          (fn2-commit-txn-join id slot gen len okind oslot ogen need fn2-core)))
       ((when (and (eq code :ok) (not (equal admitted batch))))
        (let ((fn2-core (fn2-core-stop *fn2-stop-reason-commit-settle* fn2-core)))
         (mv :uncertain admitted event fn2-core))))
   (mv code admitted event fn2-core)))
 (fn2-core-preserves fn2-retirement-admit
  (extent epoch allocation slot gen okind oslot ogen fn2-core) :position 3 :rows nil)

 (defun fn2-retirement-submit (extent epoch allocation okind oslot ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((unless (and (unsigned-byte-p 32 extent) (unsigned-byte-p 60 epoch)
                     (unsigned-byte-p 60 allocation) (posp okind) (unsigned-byte-p 8 okind)
                     (unsigned-byte-p 32 oslot) (unsigned-byte-p 60 ogen)
                     (not (fn2-core-stopped-p fn2-core))))
        (mv :admission 0 0 fn2-core))
       (idle (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))) (idle)
              (and (< 0 (fn2-retirement-control-rows fn2-retirement-control))
                   (= (fn2-retirement-control-state 0 fn2-retirement-control) *fn2-retirement-state-idle*)) idle))
       ((unless idle) (mv :busy 0 0 fn2-core))
       (class (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (class)
                (fn2-pool-class-for (+ *fn2-format-txn-record-max-size* *fn2-format-retirement-max-size*) fn2-pool) class))
       ((unless class) (mv :admission 0 0 fn2-core))
       ((mv reserved slot gen fn2-core) (fn2-core-reserve class okind oslot ogen fn2-core))
       ((unless (eq reserved :ok)) (mv :exhausted 0 0 fn2-core))
       ((mv code batch event fn2-core)
        (fn2-retirement-admit extent epoch allocation slot gen okind oslot ogen fn2-core))
       ((when (and (not (eq code :ok)) (not (fn2-core-stopped-p fn2-core))))
        (mv-let (released fn2-core) (fn2-core-release slot gen okind oslot ogen fn2-core)
         (let ((fn2-core (if (member-eq released '(:ok :retired)) fn2-core
                          (fn2-core-stop *fn2-stop-reason-commit-pool* fn2-core))))
          (mv code batch event fn2-core))))
       ((unless (and (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen)
                     (unsigned-byte-p 60 batch) (unsigned-byte-p 60 event)))
        (let ((fn2-core (fn2-core-stop *fn2-stop-reason-commit-settle* fn2-core)))
         (mv :uncertain 0 0 fn2-core))))
   (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core)))
    (fn2-retirement-control)
    (if (and (< 0 (fn2-retirement-control-rows fn2-retirement-control))
             (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen)
             (unsigned-byte-p 60 batch) (unsigned-byte-p 60 event))
        (fn2-retirement-control-put 0
         (state (if (eq code :ok) *fn2-retirement-state-waiting* *fn2-retirement-state-uncertain*))
         (owner-kind okind) (owner-slot oslot) (owner-gen ogen)
         (extent extent) (epoch epoch) (allocation allocation)
         (slot slot) (gen gen) (batch batch) (event event))
      fn2-retirement-control)
    (mv (if (eq code :ok) :ok :uncertain) batch event fn2-core))))
 (fn2-core-preserves fn2-retirement-submit
  (extent epoch allocation okind oslot ogen fn2-core) :position 3 :rows nil)

 (defun fn2-retirement-poll (okind oslot ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((mv match phase slot gen batch event)
        (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core)))
         (match phase slot gen batch event)
         (if (< 0 (fn2-retirement-control-rows fn2-retirement-control))
             (mv (and (equal okind (fn2-retirement-control-owner-kind 0 fn2-retirement-control))
                      (equal oslot (fn2-retirement-control-owner-slot 0 fn2-retirement-control))
                      (equal ogen (fn2-retirement-control-owner-gen 0 fn2-retirement-control)))
                 (fn2-retirement-control-state 0 fn2-retirement-control)
                 (fn2-retirement-control-slot 0 fn2-retirement-control)
                 (fn2-retirement-control-gen 0 fn2-retirement-control)
                 (fn2-retirement-control-batch 0 fn2-retirement-control)
                 (fn2-retirement-control-event 0 fn2-retirement-control))
           (mv nil *fn2-retirement-state-idle* 0 0 0 0))
         (mv match phase slot gen batch event)))
       ((when (= phase *fn2-retirement-state-idle*)) (mv :none 0 0 fn2-core))
       ((unless match) (mv :owner 0 0 fn2-core))
       ((when (or (= phase *fn2-retirement-state-uncertain*) (fn2-core-stopped-p fn2-core)))
        (mv :uncertain batch event fn2-core))
       ((mv code settled-batch settled-event outcome fn2-core)
        (fn2-commit-take-exact okind oslot ogen batch event fn2-core))
       ((when (eq code :pending)) (mv :pending batch event fn2-core))
       (certain (and (eq code :ok) (equal settled-batch batch) (equal settled-event event)
                     (member-equal outcome (list *fn2-commit-outcome-accepted* *fn2-commit-outcome-refused*))))
       ((unless certain)
        (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core)))
         (fn2-retirement-control)
         (if (< 0 (fn2-retirement-control-rows fn2-retirement-control))
             (fn2-retirement-control-set-state 0 *fn2-retirement-state-uncertain* fn2-retirement-control)
           fn2-retirement-control)
         (let ((fn2-core (fn2-core-stop *fn2-stop-reason-commit-settle* fn2-core)))
          (mv :uncertain batch event fn2-core))))
       ((mv released fn2-core) (fn2-core-release slot gen okind oslot ogen fn2-core))
       ((unless (member-eq released '(:ok :retired)))
        (let ((fn2-core (fn2-core-stop *fn2-stop-reason-commit-pool* fn2-core)))
         (mv :uncertain batch event fn2-core))))
   (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core)))
    (fn2-retirement-control)
    (if (< 0 (fn2-retirement-control-rows fn2-retirement-control))
        (fn2-retirement-control-set-state 0 *fn2-retirement-state-idle* fn2-retirement-control)
      fn2-retirement-control)
    (mv (if (equal outcome *fn2-commit-outcome-accepted*) :accepted :refused) batch event fn2-core))))
 (fn2-core-preserves fn2-retirement-poll (okind oslot ogen fn2-core) :position 3 :rows nil)
 ))

; Emitted in the persisted installation section, before the commit's arms.
(defmacro fn2-retirement-install-events ()
 '(progn
 (defun fn2-commit-lifecycle-step (id member off fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((unless (and (fn2-commit-idp id fn2-core) (natp member) (natp off)
                     (= (fn2-machine-phase id fn2-core) *fn2-commit-state-publish*)
                     (= (fn2-machine-cb-deps-ok id fn2-core) 1)
                     (= (fn2-machine-cb-log-ok id fn2-core) 1)
                     (= (fn2-machine-cb-fence-ok id fn2-core) 1)
                     (= (fn2-machine-cb-failed id fn2-core) 0)))
        (mv :invalid 0 0 fn2-core))
       ((when (>= member (fn2-machine-member-count id fn2-core))) (mv :done member 0 fn2-core))
       (batch (fn2-machine-batch-no id fn2-core))
       (installed (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (installed)
                    (and (< 0 (fn2-commit-root-rows fn2-commit-root))
                         (= (fn2-commit-root-installed 0 fn2-commit-root) batch)) installed))
       ((unless installed) (mv :invalid 0 0 fn2-core))
       ((mv found kind slot gen len okind oslot ogen)
        (fn2-commit-member-ws (+ (* *fn2-commit-members-per-batch* (fn2-commit-row id fn2-core)) member) fn2-core))
       ((unless found) (mv :invalid 0 0 fn2-core))
       ((when (not (= kind *fn2-commit-member-kind-txn*))) (mv :more (+ 1 member) 0 fn2-core))
       ((when (= off len)) (mv :more (+ 1 member) 0 fn2-core))
       ((unless (< off len)) (mv :invalid 0 0 fn2-core))
       (base (* 128 (fn2-commit-row id fn2-core)))
       ((mv framed rkind bytes next fn2-core)
        (fn2-commit-txn-frame base slot gen off len okind oslot ogen fn2-core))
       ((unless (and (eq framed :ok) (< off next) (<= (+ next bytes) len)))
        (mv :invalid 0 0 fn2-core))
       ((mv code fn2-core)
        (if (not (= rkind *record-kind-retirement*)) (mv :ok fn2-core)
         (stobj-let ((fn2-fields (fn2-core-fields fn2-core))
                     (fn2-pool (fn2-core-pool fn2-core))
                     (fn2-extents (fn2-core-extents fn2-core))
                     (fn2-retirement-control (fn2-core-retirement-control fn2-core)))
          (code fn2-fields fn2-extents)
          (if (not (and (natp base) (<= (+ base *fn2-format-retirement-num-fields*) (fn2-fields-rows fn2-fields))
                        (unsigned-byte-p 32 next) (unsigned-byte-p 32 (+ next bytes))
                        (unsigned-byte-p 8 okind) (unsigned-byte-p 32 oslot) (unsigned-byte-p 60 ogen)))
              (mv :invalid fn2-fields fn2-extents)
           (mv-let (decoded end fn2-fields)
            (fn2-format-retirement-decode base slot gen next (+ next bytes) okind oslot ogen fn2-fields fn2-pool)
            (if (not (and (eq decoded :ok) (= end (+ next bytes))
                          (< 0 (fn2-retirement-control-rows fn2-retirement-control))
                          (= (fn2-retirement-control-state 0 fn2-retirement-control) *fn2-retirement-state-waiting*)
                          (= (fn2-retirement-control-slot 0 fn2-retirement-control) slot)
                          (= (fn2-retirement-control-gen 0 fn2-retirement-control) gen)
                          (= (fn2-retirement-control-batch 0 fn2-retirement-control) batch)
                          (= (fn2-retirement-control-owner-kind 0 fn2-retirement-control) okind)
                          (= (fn2-retirement-control-owner-slot 0 fn2-retirement-control) oslot)
                          (= (fn2-retirement-control-owner-gen 0 fn2-retirement-control) ogen)
                          (= (fn2-retirement-control-extent 0 fn2-retirement-control)
                             (fn2-fields-value (+ base *fn2-format-retirement-field-extent*) fn2-fields))
                          (= (fn2-retirement-control-epoch 0 fn2-retirement-control)
                             (fn2-fields-value (+ base *fn2-format-retirement-field-writer-epoch*) fn2-fields))
                          (= (fn2-retirement-control-allocation 0 fn2-retirement-control)
                             (fn2-fields-value (+ base *fn2-format-retirement-field-allocation*) fn2-fields))))
                (mv :invalid fn2-fields fn2-extents)
             (mv-let (code fn2-extents) (fn2-retirement-install batch base fn2-fields fn2-extents)
              (mv code fn2-fields fn2-extents)))))
          (mv code fn2-core)))))
   (mv (if (eq code :ok) :more :invalid) member (+ next bytes) fn2-core)))
 (fn2-core-preserves fn2-commit-lifecycle-step (id member off fn2-core) :position 3 :rows nil)
 (defthm fn2-commit-lifecycle-step-naturals
  (and (natp (mv-nth 1 (fn2-commit-lifecycle-step id member off fn2-core)))
       (natp (mv-nth 2 (fn2-commit-lifecycle-step id member off fn2-core))))
  :hints (("Goal" :in-theory (enable fn2-commit-lifecycle-step))))
 ))

; Init-only credit schedule from the SAME live window declarations. B row and
; I/O-row counts must come from their actual initialized children, not flags.
(in-package "ACL2")
(include-book "pool-credit-contracts")
(include-book "checkpoint-working-geometry")
(include-book "checkpoint-service-geometry")
(include-book "allocation-release-geometry")
(fn2-book-layer :c)
(defun fn2-checkpoint-working-credit-vector (class fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (fn2-pool-wfp fn2-pool) (natp class))
  :measure (nfix (- (nfix (fn2-pool-nclasses fn2-pool)) (nfix class)))))
 (if (not (and (natp class) (< class (nfix (fn2-pool-nclasses fn2-pool))))) nil
  (cons (+ (fn2-checkpoint-window-class-demand 0 class fn2-pool)
           (fn2-checkpoint-future-class-demand 0 class fn2-pool))
        (fn2-checkpoint-working-credit-vector (+ class 1) fn2-pool))))
(defun fn2-checkpoint-drain-credit-vector (class journal-class windows fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (fn2-pool-wfp fn2-pool) (natp class) (natp journal-class) (natp windows))
  :measure (nfix (- (nfix (fn2-pool-nclasses fn2-pool)) (nfix class)))))
 (if (not (and (natp class) (< class (nfix (fn2-pool-nclasses fn2-pool))))) nil
  (cons (if (equal class journal-class) windows 0)
        (fn2-checkpoint-drain-credit-vector (+ class 1) journal-class windows fn2-pool))))
(defun fn2-checkpoint-drain-credit-groups (rows vector)
 (declare (xargs :guard t :measure (nfix rows)))
 (if (not (posp rows)) nil
  (cons (cons *fn2-pool-credit-drain* vector)
        (fn2-checkpoint-drain-credit-groups (- rows 1) vector))))
; Static startup overlap: protected working/drain quotas plus the actual
; supported foreground service envelope. This does not reserve service F.
(defun fn2-checkpoint-working-profile-fitp (class groups service fn2-pool)
 (declare (xargs :stobjs fn2-pool
  :guard (and (fn2-pool-wfp fn2-pool) (natp class) (true-listp service))
  :measure (nfix (- (nfix (fn2-pool-nclasses fn2-pool)) (nfix class)))))
 (if (not (and (natp class) (< class (nfix (fn2-pool-nclasses fn2-pool))))) t
  (and (<= (+ (fn2-pool-credit-request class groups)
              (nfix (nth class service)))
           (fn2-pool-class-countsi class fn2-pool))
       (fn2-checkpoint-working-profile-fitp (+ class 1) groups service fn2-pool))))
(defun fn2-checkpoint-working-credit-configure (profile commitrows commit-io-rows paths uploads fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (b* (((unless (and (fn2-profilep profile) (posp (fn2-profile-generation-start profile))))
       (mv :profile fn2-pool))
      ((unless (and (posp commitrows) (unsigned-byte-p 32 commitrows)
                    (posp commit-io-rows) (unsigned-byte-p 32 commit-io-rows)
                    (unsigned-byte-p 32 (+ 2 commitrows))
                    (equal commit-io-rows (* *fn2-commit-write-resources* commitrows)))) (mv :geometry fn2-pool))
      ; Each actual row owns its I/O windows plus its separate encoder scratch.
      (windows (+ 1 (floor commit-io-rows commitrows)))
      (journal-class (fn2-pool-class-for *fn2-format-sector-bytes* fn2-pool))
      (release-class (fn2-pool-class-for (fn2-allocation-release-member-capacity) fn2-pool))
      ((unless (and (natp release-class) (< release-class (fn2-pool-nclasses fn2-pool))
                    (natp journal-class) (< journal-class (fn2-pool-nclasses fn2-pool))
                    (fn2-checkpoint-admission-roomp 0 fn2-pool))) (mv :exhausted fn2-pool))
      ((mv service-code service) (fn2-checkpoint-service-demand-vector profile paths uploads fn2-pool))
      ((unless (eq service-code :ok)) (mv service-code fn2-pool))
      (working (fn2-checkpoint-working-credit-vector 0 fn2-pool))
      (drain (fn2-checkpoint-drain-credit-vector 0 journal-class windows fn2-pool))
      (groups (cons (cons *fn2-pool-credit-working* working)
                    (append (fn2-checkpoint-drain-credit-groups commitrows drain)
                            (list (cons *fn2-pool-credit-working*
                                        (fn2-allocation-release-credit-vector 0 fn2-pool))))))
      ((unless (and (fn2-pool-credit-demandsp service (fn2-pool-nclasses fn2-pool))
                    (fn2-checkpoint-working-profile-fitp 0 groups service fn2-pool)))
       (mv :exhausted fn2-pool)))
  (fn2-pool-credit-configure groups fn2-pool)))

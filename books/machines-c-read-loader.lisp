; The actual read row selects a physical MISS; callers cannot substitute a
; cursor scalar. Query octet ownership remains distinct from page ownership.
(in-package "ACL2")
(include-book "machines-c-read")
(include-book "run-physical-bundle")
(include-book "run-physical-range")
(include-book "run-physical-region")
(include-book "machine-arms")
(include-book "run-physical-core-faces")
(fn2-book-layer :c)
(defun fn2-read-loader-range-select (i n x fn2-reads fn2-ranges fn2-range-sources fn2-run-cursors)
 (declare (xargs :stobjs (fn2-reads fn2-ranges fn2-range-sources fn2-run-cursors)
 :measure (nfix (- (nfix n) (nfix i)))
 :guard (and (fn2-reads-wfp fn2-reads) (fn2-ranges-wfp fn2-ranges)
  (fn2-range-sources-wfp fn2-range-sources) (fn2-run-cursors-wfp fn2-run-cursors)
  (natp i) (natp n) (<= n *fn2-read-sources*) (natp x)
  (< x (fn2-reads-rows fn2-reads)) (< x (fn2-ranges-rows fn2-ranges)))))
 (fn2-run-load-range-miss i n x (fn2-reads-sid x fn2-reads) fn2-ranges fn2-range-sources fn2-run-cursors))
(defun fn2-read-loader-selected (x fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors)
 (declare (xargs :stobjs (fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors)
 :guard (and (fn2-reads-wfp fn2-reads) (fn2-id-decides-wfp fn2-id-decides) (fn2-succ-txns-wfp fn2-succ-txns)
  (fn2-ranges-wfp fn2-ranges) (fn2-range-sources-wfp fn2-range-sources) (fn2-run-cursors-wfp fn2-run-cursors))))
 (b* (((unless (and (natp x) (< x (fn2-reads-rows fn2-reads)))) (mv :bounds 0))
      (tn (fn2-id-decides-rows fn2-id-decides)) (c (+ tn x))
      (op (fn2-reads-op x fn2-reads))
      ((when (member op (list *fn2-read-op-lookup* *fn2-read-op-identity*)))
       (mv (if (and (< c (fn2-succ-txns-rows fn2-succ-txns)) (< c (fn2-run-cursors-rows fn2-run-cursors))
                     (equal (fn2-succ-txns-lphase c fn2-succ-txns) *fn2-succ-lookup-scan*)
                     (equal (fn2-run-cursors-physical c fn2-run-cursors) 1)
                     (equal (fn2-run-cursors-phase c fn2-run-cursors) *fn2-run-cursor-phase-miss*)
                     (equal (fn2-run-cursors-schema c fn2-run-cursors) (fn2-reads-sid x fn2-reads))
                     (equal (fn2-run-cursors-source-row c fn2-run-cursors) (fn2-succ-txns-lrow c fn2-succ-txns))) :ok :source) c))
      ((unless (and (member op (list *fn2-read-op-range* *fn2-read-op-seek* *fn2-read-op-scan*))
                     (< x (fn2-ranges-rows fn2-ranges))
                     (not (equal (fn2-ranges-phase x fn2-ranges) *fn2-range-phase-idle*))
                     (equal (fn2-ranges-schema x fn2-ranges) (fn2-reads-sid x fn2-reads))
                     (equal (fn2-ranges-cbase x fn2-ranges) (+ tn (fn2-reads-rows fn2-reads) (* *fn2-read-sources* x)))
                     (<= (fn2-ranges-scount x fn2-ranges) *fn2-read-sources*)))
       (mv :source 0)))
  (fn2-read-loader-range-select 0 (fn2-ranges-scount x fn2-ranges) x fn2-reads fn2-ranges fn2-range-sources fn2-run-cursors)))
(defun fn2-read-loader-owner (x kind owner generation fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources
 fn2-run-cursors fn2-run-loads fn2-checkpoint-summary-leases)
 (declare (xargs :stobjs (fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-loads fn2-checkpoint-summary-leases)
 :guard (and (fn2-reads-wfp fn2-reads) (fn2-id-decides-wfp fn2-id-decides) (fn2-succ-txns-wfp fn2-succ-txns)
  (fn2-ranges-wfp fn2-ranges) (fn2-range-sources-wfp fn2-range-sources) (fn2-run-cursors-wfp fn2-run-cursors)
  (fn2-run-loads-wfp fn2-run-loads) (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases))))
 (b* (((mv code c) (fn2-read-loader-selected x fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors))
      ((unless (and (eq code :ok) (unsigned-byte-p 8 kind) (< 0 kind) (unsigned-byte-p 32 owner) (unsigned-byte-p 60 generation)
                     (< c (fn2-run-loads-rows fn2-run-loads)) (< c (fn2-checkpoint-summary-leases-rows fn2-checkpoint-summary-leases))
                     (or (equal (fn2-run-loads-phase c fn2-run-loads) *fn2-run-load-phase-idle*)
                         (fn2-run-load-ownerp c kind owner generation fn2-run-loads))
                     (or (equal (fn2-checkpoint-summary-leases-live c fn2-checkpoint-summary-leases) 0)
                         (and (equal kind (fn2-checkpoint-summary-leases-owner-kind c fn2-checkpoint-summary-leases))
                              (equal owner (fn2-checkpoint-summary-leases-owner-slot c fn2-checkpoint-summary-leases))
                              (equal generation (fn2-checkpoint-summary-leases-owner-gen c fn2-checkpoint-summary-leases))))))
       (mv :source 0 0 fn2-run-cursors))
      (phase (fn2-run-loads-phase c fn2-run-loads))
      (fn2-run-cursors (fn2-run-cursors-put c (okind kind) (oslot owner) (ogen generation))))
  (mv :ok c phase fn2-run-cursors)))
(defcost fn2-read-loader-owner-op :child fn2-read-loader-owner :answers (:ok :source)
 :tables (fn2-core-reads fn2-core-id-decides fn2-core-succ-txns fn2-core-ranges fn2-core-range-sources fn2-core-run-cursors
          fn2-core-run-loads fn2-core-checkpoint-summary-leases)
 :doc "Bind the actual reader actor to the exact selected physical MISS; retain separate query-key ownership.")

; The bundle's declared geometry is shared with admission and the profile.
(defun fn2-read-loader-job (read0 ordinal fn2-reads fn2-id-decides fn2-run-loads)
 (declare (xargs :stobjs (fn2-reads fn2-id-decides fn2-run-loads)
 :guard (and (fn2-reads-wfp fn2-reads) (fn2-id-decides-wfp fn2-id-decides) (fn2-run-loads-wfp fn2-run-loads))))
 (if (not (and (natp read0) (<= (+ read0 *fn2-b-query-read-rows*) (fn2-reads-rows fn2-reads))
               (natp ordinal) (< ordinal *fn2-b-query-loader-jobs*))) (mv :bounds 0)
  (let ((c (fn2-run-query-bundle-cursor read0 ordinal (fn2-id-decides-rows fn2-id-decides) (fn2-reads-rows fn2-reads))))
   (mv (if (< c (fn2-run-loads-rows fn2-run-loads)) :ok :bounds) c))))

(defun fn2-read-loader-drain (read0 ordinal kind owner generation fn2-reads fn2-id-decides fn2-run-loads)
 (declare (xargs :stobjs (fn2-reads fn2-id-decides fn2-run-loads)
 :guard (and (fn2-reads-wfp fn2-reads) (fn2-id-decides-wfp fn2-id-decides) (fn2-run-loads-wfp fn2-run-loads))))
 (b* (((mv code &) (fn2-read-loader-job read0 ordinal fn2-reads fn2-id-decides fn2-run-loads))
      ((unless (eq code :ok)) (mv code 0))
      (transactions (fn2-id-decides-rows fn2-id-decides)) (reads (fn2-reads-rows fn2-reads)))
  (fn2-run-load-region-drain ordinal (+ transactions read0) *fn2-b-query-read-rows*
   (+ transactions reads (* *fn2-b-range-source-cursors* read0))
   (* *fn2-b-query-read-rows* *fn2-b-range-source-cursors*) 0 0 kind owner generation fn2-run-loads)))
(defcost fn2-read-loader-drain-op :child fn2-read-loader-drain :answers (:member :last :absent :wait :bounds :owner)
 :tables (fn2-core-reads fn2-core-id-decides fn2-core-run-loads)
 :doc "Inspect one request-owned job and its bounded suffix; pending physical reads must finish before reuse.")
(defun fn2-read-loader-member-release (read0 ordinal kind owner generation fn2-reads fn2-id-decides
 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (declare (xargs :stobjs (fn2-reads fn2-id-decides fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 :guard (and (fn2-reads-wfp fn2-reads) (fn2-id-decides-wfp fn2-id-decides) (fn2-run-loads-wfp fn2-run-loads)
  (fn2-run-cursors-wfp fn2-run-cursors) (fn2-checkpoint-summary-wfp fn2-checkpoint-summary)
  (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases) (fn2-pool-wfp fn2-pool))))
 (b* (((mv code &) (fn2-read-loader-job read0 ordinal fn2-reads fn2-id-decides fn2-run-loads))
      ((unless (eq code :ok))
       (mv code fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      (transactions (fn2-id-decides-rows fn2-id-decides)) (reads (fn2-reads-rows fn2-reads)))
  (fn2-run-load-region-member-release ordinal (+ transactions read0) *fn2-b-query-read-rows*
   (+ transactions reads (* *fn2-b-range-source-cursors* read0))
   (* *fn2-b-query-read-rows* *fn2-b-range-source-cursors*) 0 0 kind owner generation
   fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))
(fn2-run-load-frames fn2-read-loader-member-release
 (read0 ordinal kind owner generation fn2-reads fn2-id-decides fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (fn2-reads fn2-id-decides fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 ((fn2-run-loads 1) (fn2-run-cursors 2) (fn2-checkpoint-summary 3) (fn2-checkpoint-summary-leases 4) (fn2-pool 5)))
(defcost fn2-read-loader-member-release-op :child fn2-read-loader-member-release :answers t
 :tables (fn2-core-reads fn2-core-id-decides fn2-core-run-loads fn2-core-run-cursors fn2-core-checkpoint-summary fn2-core-checkpoint-summary-leases fn2-core-pool)
 :doc "Release one actual page/catalog member while an exact owned suffix retains the request bundle rank.")
(fn2-rd-shape fn2-read-loader-owner
 (x kind owner generation fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-loads fn2-checkpoint-summary-leases)
 ((fn2-run-cursors 3))
 (fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-loads fn2-checkpoint-summary-leases)
 (fn2-read-loader-selected fn2-run-load-ownerp))

; These costs live below the D kind's book, so its ordinary book-local
; face emitter cannot discover them. Materialize the same shared generator
; against each actual declared child after the served core exists.
(defconst *fn2-read-loader-core-operations*
 '(fn2-run-page-bundle-reserve fn2-read-loader-owner-op fn2-read-loader-drain-op fn2-read-loader-member-release-op))
(defmacro fn2-read-loader-core-faces ()
 '(make-event
   (mv-let (err events) (fn2-run-loader-core-face-events *fn2-read-loader-core-operations* (w state))
    (if err (er soft 'fn2-read-loader-core-faces "~@0" err) (value (cons 'progn events))))))

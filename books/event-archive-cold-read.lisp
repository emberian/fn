; Single armed candidate read. The real boot transport supplies completion;
; recipient generation alone never establishes the read address.
(in-package "ACL2")
(include-book "event-archive-cold-cursor")
(fn2-book-layer :c)
(defconst *fn2-event-archive-read-scalars*
 '((read-sector (fn2-run-loads-sector c fn2-run-loads))
   (read-unit (fn2-run-loads-unit c fn2-run-loads)) (read-epoch (fn2-run-loads-epoch c fn2-run-loads))
   (read-allocation (fn2-run-loads-allocation c fn2-run-loads)) (read-schema (fn2-run-loads-schema c fn2-run-loads))
   (read-run (fn2-run-loads-run c fn2-run-loads)) (read-level (fn2-run-loads-level c fn2-run-loads))
   (read-page (fn2-run-loads-page c fn2-run-loads)) (read-page-gen (fn2-run-loads-page-gen c fn2-run-loads))
   (read-scratch (fn2-run-loads-scratch c fn2-run-loads)) (read-scratch-gen (fn2-run-loads-scratch-gen c fn2-run-loads))
   (read-owner-kind (fn2-run-loads-kind c fn2-run-loads)) (read-owner-slot (fn2-run-loads-owner c fn2-run-loads))
   (read-owner-gen (fn2-run-loads-generation c fn2-run-loads))
   (read-candidate (fn2-event-archive-candidate 1 fn2-event-archive))
   (read-checkpoint (fn2-event-archive-checkpoint 1 fn2-event-archive))
   (read-history (fn2-event-archive-history 1 fn2-event-archive))
   (read-incarnation (fn2-event-archive-incarnation 1 fn2-event-archive))))
(defun fn2-event-archive-read-equalities (rows)
 (declare (xargs :verify-guards nil))
 (if (atom rows) nil
  (cons `(equal (,(fn2-columns-sym 'fn2-event-archive (concatenate 'string "-" (symbol-name (caar rows)))) 1 fn2-event-archive)
                ,(cadar rows))
        (fn2-event-archive-read-equalities (cdr rows)))))
(defmacro fn2-event-archive-read-save-scalars (offset)
 `(fn2-event-archive-put 1 (read-armed 1) (read-offset ,offset) ,@*fn2-event-archive-read-scalars*))
(defmacro fn2-event-archive-read-scalars-current-p ()
 `(and ,@(fn2-event-archive-read-equalities *fn2-event-archive-read-scalars*)))

(defun fn2-event-archive-read-copy-bytes (i c fn2-run-loads fn2-event-archive)
 (declare (xargs :stobjs (fn2-run-loads fn2-event-archive) :measure (nfix (- 32 (nfix i)))
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-event-archive-wfp fn2-event-archive)
             (natp c) (< c (fn2-run-loads-rows fn2-run-loads)) (natp i) (<= i 32))))
 (if (>= (nfix i) 32) fn2-event-archive
  (let* ((fn2-event-archive (update-fn2-event-archive-read-descriptori i
          (fn2-event-archive-descriptori (+ 32 i) fn2-event-archive) fn2-event-archive))
         (fn2-event-archive (if (< i 8) (update-fn2-event-archive-read-hashi i
          (fn2-run-load-word c i fn2-run-loads) fn2-event-archive) fn2-event-archive)))
   (fn2-event-archive-read-copy-bytes (+ 1 (nfix i)) c fn2-run-loads fn2-event-archive))))
(fn2-event-archive-preserves fn2-event-archive-read-copy-bytes (i c fn2-run-loads fn2-event-archive) :position nil)
(defun fn2-event-archive-read-bytes-current-p (i c fn2-run-loads fn2-event-archive)
 (declare (xargs :stobjs (fn2-run-loads fn2-event-archive) :measure (nfix (- 32 (nfix i)))
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-event-archive-wfp fn2-event-archive)
             (natp c) (< c (fn2-run-loads-rows fn2-run-loads)) (natp i) (<= i 32))))
 (or (>= (nfix i) 32)
  (and (equal (fn2-event-archive-read-descriptori i fn2-event-archive) (fn2-event-archive-descriptori (+ 32 i) fn2-event-archive))
       (or (<= 8 i) (equal (fn2-event-archive-read-hashi i fn2-event-archive) (fn2-run-load-word c i fn2-run-loads)))
       (fn2-event-archive-read-bytes-current-p (+ 1 (nfix i)) c fn2-run-loads fn2-event-archive))))

(defun fn2-event-archive-cold-read-current-p (fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool)
 (declare (xargs :stobjs (fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool)
 :guard (and (fn2-event-archive-wfp fn2-event-archive) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
             (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-run-loads-wfp fn2-run-loads) (fn2-run-cursors-wfp fn2-run-cursors) (fn2-pool-wfp fn2-pool))))
 (and (fn2-event-archive-cold-cursor-source-p fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool)
      (equal (fn2-event-archive-read-armed 1 fn2-event-archive) 1)
      (equal (fn2-event-archive-entry-pending 1 fn2-event-archive) 0)
      (let ((c (fn2-b-event-archive-cursor-from-rows (fn2-run-loads-rows fn2-run-loads))))
       (and (equal (fn2-run-loads-phase c fn2-run-loads) *fn2-run-load-phase-read*)
            (equal (fn2-run-loads-pending c fn2-run-loads) 0)
            (< (fn2-run-loads-sector c fn2-run-loads) *fn2-storage-extent-units*)
            (fn2-run-load-boundp c fn2-run-loads fn2-run-cursors)
            (fn2-event-archive-read-scalars-current-p)
            (fn2-event-archive-read-bytes-current-p 0 c fn2-run-loads fn2-event-archive)))))

(fn2-event-archive-operation fn2-event-archive-cold-read-arm
 (fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool)
 (fn2-event-archive)
 (b* (((unless (and (fn2-event-archive-cold-cursor-source-p fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool)
                    (equal (fn2-event-archive-read-armed 1 fn2-event-archive) 0)
                    (equal (fn2-event-archive-entry-pending 1 fn2-event-archive) 0)))
       (mv :source fn2-event-archive 0))
      (c (fn2-b-event-archive-cursor-from-rows (fn2-run-loads-rows fn2-run-loads)))
      (offset (* *fn2-commit-unit-bytes* (+ (fn2-run-loads-unit c fn2-run-loads) (fn2-run-loads-sector c fn2-run-loads))))
      ((unless (and (equal (fn2-run-loads-phase c fn2-run-loads) *fn2-run-load-phase-read*)
                    (equal (fn2-run-loads-pending c fn2-run-loads) 0)
                    (< (fn2-run-loads-sector c fn2-run-loads) *fn2-storage-extent-units*)
                    (fn2-run-load-boundp c fn2-run-loads fn2-run-cursors) (unsigned-byte-p 60 offset)))
       (mv :state fn2-event-archive 0))
      (fn2-event-archive (fn2-event-archive-read-copy-bytes 0 c fn2-run-loads fn2-event-archive))
      (fn2-event-archive (fn2-event-archive-read-save-scalars offset)))
  (mv :read fn2-event-archive offset)))

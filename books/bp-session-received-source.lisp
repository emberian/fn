; Private received-transfer operation beneath an installed BP session grant.
; This never issues a public SAMEPRS :bps-ref or decoded provider authority.
(in-package "ACL2")
(include-book "bp-session-profile")
(include-book "tcpcl-segment-source-cursor")
(defun fn-bpsrx-live-incomingp (row)
 (declare (xargs :guard t))
 (and (true-listp row) (equal (len row) 6)
      (eq (first row) :bp-session-grant) (natp (second row))
      (natp (third row)) (eq (fourth row) :incoming)
      (not (fifth row)) (not (sixth row))))
(defun fn-bpsrx-key (row id count)
 (declare (xargs :guard t))
 (list :bp-private-received (fn-tsc-at 1 row) (fn-tsc-at 2 row) id count))
(defun fn-bpsrx-start (row id count limit chain)
 (declare (xargs :guard t))
 (cond ((not (and (fn-bpsrx-live-incomingp row) (natp id)))
        (list :uncertain :session-incarnation))
       ((not (and (natp count) (natp limit) (<= count limit)
                  (<= count 18446744073709551615)))
        (list :refused :private-source-count))
       (t (list :source-operation (fn-bpsrx-key row id count) count
                (fn-tsc-begin chain count)))))
(defun fn-bpsrx-authorizedp (key row job)
 (declare (xargs :guard t))
 (and (fn-bpsrx-live-incomingp row)
      (equal (fn-tsc-at 0 key) :bp-private-received)
      (equal (fn-tsc-at 1 key) (fn-tsc-at 1 row))
      (equal (fn-tsc-at 2 key) (fn-tsc-at 2 row))
      (equal (fn-tsc-at 4 key) (fn-tsc-at 2 job))))
(defun fn-bpsrx-turn (key row job)
 (declare (xargs :guard t))
 (if (not (fn-bpsrx-authorizedp key row job))
  (list :uncertain job nil 0)
  (mv-let (word next bytes used) (fn-tsc-turn job 64)
   (list word next bytes used))))

; The one-writer host disables the continuation before this pre-publication
; retirement. Publication entry changes the phase first; it is never retired
; by a timeout or by the existence of a physical socket receipt.
(defun fn-bpsrx-abort-plan (key row cursor phase)
 (declare (xargs :guard t))
 (if (and (fn-bpsrx-authorizedp key row cursor)
          (member-eq phase '(:copy :convert :publish)))
  (list :retire-private-source :pre-publication)
  (list :retain-private-source :publication-or-authority)))

; Actual descriptor page codec. Cut comes from the retained C table and the
; physical identity comes from the reserved allocator handle, never the host.
(in-package "ACL2")
(include-book "checkpoint-build-state")
(include-book "checkpoint-publication")
(fn2-book-layer :b)
(defconst *fn2-checkpoint-descriptor-header* (* 32 (ceiling *fn2-format-page-header-max-size* 32)))

(defun fn2-checkpoint-descriptor-root (role c base scratch sgen okind oslot ogen
                                     fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
  :guard (and (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (if (not (and (natp role) (< role 5) (natp c) (natp base)
               (<= (* 6 (+ c 1)) (fn2-checkpoint-refs-rows fn2-checkpoint-refs))
               (<= (* 192 (+ c 1)) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes))
               (<= (+ base *fn2-format-checkpoint-descriptor-num-fields*) (fn2-fields-rows fn2-fields))
               (unsigned-byte-p 32 scratch) (unsigned-byte-p 60 sgen)))
     (mv :bounds fn2-fields fn2-pool)
  (b* ((r (+ (* 6 c) role 1)) (f (+ base 3 (* 7 role)))
       ((unless (equal (fn2-checkpoint-refs-storage-domain r fn2-checkpoint-refs) *fn2-checkpoint-served-storage-domain*))
        (mv :storage-domain fn2-fields fn2-pool))
       ((mv code fn2-pool) (fn2-checkpoint-member-hash 32 (* 32 role) (* 32 r) scratch sgen okind oslot ogen fn2-checkpoint-bytes fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-fields fn2-pool))
       (fn2-fields (fn2-fields-set-value f (fn2-checkpoint-refs-storage-domain r fn2-checkpoint-refs) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ f 1) (fn2-checkpoint-refs-physical-unit r fn2-checkpoint-refs) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ f 2) (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ f 3) (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ f 4) (fn2-checkpoint-refs-page-kind r fn2-checkpoint-refs) fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ f 5) (fn2-checkpoint-refs-encoded-length r fn2-checkpoint-refs) fn2-fields))
       (fn2-fields (fn2-fields-put (+ f 6) (value 1) (ref-slot scratch) (ref-gen sgen) (ref-off (* 32 role)) (ref-len 32))))
   (mv :ok fn2-fields fn2-pool))))

(defun fn2-checkpoint-descriptor-roots (role c base scratch sgen okind oslot ogen
                                      fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
  :measure (nfix (- 5 (nfix role)))
  :guard (and (natp role) (<= role 5) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (if (or (not (natp role)) (>= role 5)) (mv :ok fn2-fields fn2-pool)
  (mv-let (code fn2-fields fn2-pool)
   (fn2-checkpoint-descriptor-root role c base scratch sgen okind oslot ogen fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
   (if (not (eq code :ok)) (mv code fn2-fields fn2-pool)
    (fn2-checkpoint-descriptor-roots (+ 1 role) c base scratch sgen okind oslot ogen fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)))))

(defun fn2-checkpoint-descriptor-pack-page (checkpoint c token extent epoch allocation base slot gen scratch sgen okind oslot ogen
                                          fn2-csnapshot fn2-extents fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-csnapshot fn2-extents fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
  :guard (and (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extents-wfp fn2-extents)
              (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (fn2-csnapshot-ownerp token okind oslot ogen fn2-csnapshot)
                     (equal (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-held*)
                     (equal (fn2-csnapshot-complete 0 fn2-csnapshot) 1)))
       (mv :snapshot fn2-fields fn2-pool))
      ((unless (and (natp c) (<= (* 6 (+ c 1)) (fn2-checkpoint-refs-rows fn2-checkpoint-refs))
                     (<= (* 192 (+ c 1)) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes))
                     (posp checkpoint) (unsigned-byte-p 60 checkpoint)
                     (natp base) (<= (+ base *fn2-format-sealed-batch-num-fields*) (fn2-fields-rows fn2-fields))
                     (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen)
                     (unsigned-byte-p 32 scratch) (unsigned-byte-p 60 sgen) (not (equal slot scratch))
                     (unsigned-byte-p 32 extent) (unsigned-byte-p 60 epoch) (unsigned-byte-p 60 allocation)
                     (eq (fn2-alloc-handle-code extent epoch allocation fn2-extents) :ok)
                     (equal (fn2-extents-state extent fn2-extents) *fn2-extent-state-reserved*)))
       (mv :identity fn2-fields fn2-pool))
      ((unless (fn2-checkpoint-built-roots-p 1 c token fn2-checkpoint-refs))
       (mv :roots-pending fn2-fields fn2-pool))
      ((mv code fn2-pool) (fn2-pool-reset slot gen okind oslot ogen fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields fn2-pool))
      ((mv code fn2-pool) (fn2-checkpoint-publication-buffer 4096 0 t c 0 slot gen okind oslot ogen fn2-checkpoint-bytes fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields fn2-pool))
      ((mv code fn2-pool) (fn2-pool-reset scratch sgen okind oslot ogen fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-checkpoint-descriptor-field-checkpoint*) checkpoint fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-checkpoint-descriptor-field-cut-commit*) (fn2-csnapshot-cut-commit 0 fn2-csnapshot) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-checkpoint-descriptor-field-cut-event*) (fn2-csnapshot-cut-event 0 fn2-csnapshot) fn2-fields))
      ((mv code fn2-fields fn2-pool) (fn2-checkpoint-descriptor-roots 0 c base scratch sgen okind oslot ogen fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields fn2-pool))
      (payload (fn2-format-checkpoint-descriptor-size base fn2-fields))
      ((mv code end fn2-pool) (fn2-format-checkpoint-descriptor-encode base slot gen *fn2-checkpoint-descriptor-header* okind oslot ogen fn2-fields fn2-pool))
      ((unless (and (eq code :ok) (equal end (+ *fn2-checkpoint-descriptor-header* payload)) (<= end 4096)))
       (mv :format fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-page-header-field-magic*) *fn2-format-page-magic* fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-page-header-field-version*) *fn2-format-version* fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-page-header-field-page-kind*) *page-kind-checkpoint-descriptor* fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-page-header-field-history*) 1 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-page-header-field-incarnation*) 1 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-page-header-field-physical-unit*) (* extent *fn2-storage-extent-units*) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-page-header-field-writer-epoch*) epoch fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-page-header-field-allocation*) allocation fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-page-header-field-header-length*) *fn2-checkpoint-descriptor-header* fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-page-header-field-payload-length*) payload fn2-fields))
      ((mv code end fn2-pool) (fn2-format-page-header-encode base slot gen 0 okind oslot ogen fn2-fields fn2-pool)))
  (mv (if (and (eq code :ok) (> end *fn2-checkpoint-descriptor-header*)) :format code) fn2-fields fn2-pool)))
(fn2-fields-preserves fn2-checkpoint-descriptor-pack-page
 (checkpoint c token extent epoch allocation base slot gen scratch sgen okind oslot ogen
    fn2-csnapshot fn2-extents fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
 :carriers ((fn2-fields 1 :prefix "-FIELDS") (fn2-pool 2 :prefix "-POOL")))

; Verification of a built descriptor never overwrites its root provenance with
; decoded external refs. Compare every field and hash against the actual built
; root carriers, retaining those carriers unchanged on success or refusal.
(defun fn2-checkpoint-descriptor-matches-roots-p (role c base slot gen okind oslot ogen
                                               fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
  :measure (nfix (- 5 (nfix role)))
  :guard (and (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)
              (natp role) (<= role 5) (natp c) (natp base)
              (<= (* 6 (+ c 1)) (fn2-checkpoint-refs-rows fn2-checkpoint-refs))
              (<= (* 192 (+ c 1)) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes))
              (<= (+ base *fn2-format-checkpoint-descriptor-num-fields*) (fn2-fields-rows fn2-fields)))))
 (if (or (not (natp role)) (>= role 5)) t
  (let ((r (+ (* 6 c) role 1)) (f (+ base 3 (* 7 role))))
   (and (equal (fn2-fields-value f fn2-fields) (fn2-checkpoint-refs-storage-domain r fn2-checkpoint-refs))
        (equal (fn2-fields-value (+ f 1) fn2-fields) (fn2-checkpoint-refs-physical-unit r fn2-checkpoint-refs))
        (equal (fn2-fields-value (+ f 2) fn2-fields) (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs))
        (equal (fn2-fields-value (+ f 3) fn2-fields) (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs))
        (equal (fn2-fields-value (+ f 4) fn2-fields) (fn2-checkpoint-refs-page-kind r fn2-checkpoint-refs))
        (equal (fn2-fields-value (+ f 5) fn2-fields) (fn2-checkpoint-refs-encoded-length r fn2-checkpoint-refs))
        (equal (fn2-fields-value (+ f 6) fn2-fields) 1)
        (fn2-checkpoint-pool-hash-matchesp 32 (* 32 r) (fn2-fields-ref-off (+ f 6) fn2-fields)
                                         slot gen okind oslot ogen fn2-pool fn2-checkpoint-bytes)
        (fn2-checkpoint-descriptor-matches-roots-p (+ 1 role) c base slot gen okind oslot ogen
                                                  fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)))))

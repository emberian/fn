; Bounded copies only after the actual verifier has entered the corresponding
; private witness phase. The archive constructor owns the destination lease;
; this kernel cannot turn copied values into verified source authority.
(in-package "ACL2")
(include-book "event-read-state")
(include-book "pool-ranges")
(fn2-book-layer :b)
(defun fn2-event-read-witness-copy-step (budget fn2-event-read fn2-pool)
 (declare (xargs :stobjs (fn2-event-read fn2-pool) :verify-guards nil
  :guard (and (fn2-event-read-wfp fn2-event-read) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (< 0 (fn2-event-read-rows fn2-event-read))) (mv :state fn2-event-read fn2-pool))
      (phase (fn2-event-read-phase 0 fn2-event-read))
      (seal (equal phase *fn2-event-read-phase-witness-seal*))
      (slot (fn2-event-read-slot 0 fn2-event-read)) (gen (fn2-event-read-gen 0 fn2-event-read))
      (dst (fn2-event-read-witness-slot 0 fn2-event-read)) (dgen (fn2-event-read-witness-gen 0 fn2-event-read))
      (kind (fn2-event-read-owner-kind 0 fn2-event-read)) (owner (fn2-event-read-owner-slot 0 fn2-event-read))
      (generation (fn2-event-read-owner-gen 0 fn2-event-read))
      (length (if seal (fn2-event-read-witness-seal-length 0 fn2-event-read) (fn2-event-read-witness-header-length 0 fn2-event-read)))
      (offset (if seal (fn2-event-read-body-off 0 fn2-event-read) 0))
      (to (if seal *fn2-event-witness-seal-offset* *fn2-event-witness-header-offset*))
      (cursor (fn2-event-read-witness-cursor 0 fn2-event-read))
      ((unless (and (or seal (equal phase *fn2-event-read-phase-witness-header*))
                    (equal (fn2-event-read-witness-enabled 0 fn2-event-read) 1)
                    (equal (fn2-event-read-witness-token 0 fn2-event-read) (fn2-event-read-token 0 fn2-event-read))
                    (equal (fn2-event-read-witness-commit 0 fn2-event-read) (fn2-event-read-commit 0 fn2-event-read))
                    (equal (fn2-event-read-witness-first 0 fn2-event-read) (fn2-event-read-first 0 fn2-event-read))
                    (equal (fn2-event-read-witness-members 0 fn2-event-read) (fn2-event-read-members 0 fn2-event-read))
                    (equal (fn2-event-read-witness-phase 0 fn2-event-read)
                     (if seal *fn2-event-witness-phase-seal* *fn2-event-witness-phase-records*))
                    (posp length) (<= length (if seal *fn2-format-sealed-batch-max-size* *fn2-format-frame-header-max-size*))
                    (<= cursor length) (<= (+ offset length) *fn2-commit-unit-bytes*)
                    (not (equal slot dst))
                    (eq (fn2-pool-workspace-code slot gen kind owner generation fn2-pool) :ok)
                    (eq (fn2-pool-workspace-code dst dgen kind owner generation fn2-pool) :ok)
                    (<= *fn2-event-witness-work-bytes* (fn2-pool-fill dst fn2-pool))
                    (natp budget) (<= budget *fn2-commit-unit-bytes*)))
       (mv :source fn2-event-read fn2-pool))
      ((when (zp budget)) (mv :more fn2-event-read fn2-pool))
      (count (min budget (- length cursor)))
      ((mv code fn2-pool) (fn2-pool-copy-range slot gen (+ offset cursor) dst dgen (+ to cursor) count kind owner generation fn2-pool))
      (next (+ cursor count)) (complete (equal next length))
      (fn2-event-read (fn2-event-read-put 0
       (witness-cursor (if (eq code :ok) (if complete 0 next) cursor))
       (witness-phase (if (eq code :ok)
        (if complete (if seal *fn2-event-witness-phase-records* *fn2-event-witness-phase-ready*)
          (fn2-event-read-witness-phase 0 fn2-event-read)) *fn2-event-witness-phase-uncertain*))
       (phase (if (eq code :ok)
        (if complete (if seal *fn2-event-read-phase-read-records* *fn2-event-read-phase-members*) phase)
        *fn2-event-read-phase-uncertain*)))))
  (mv (if (eq code :ok) :more code) fn2-event-read fn2-pool)))
(fn2-event-read-preserves fn2-event-read-witness-copy-step (budget fn2-event-read fn2-pool)
 :carriers ((fn2-event-read 1 :prefix "-READER") (fn2-pool 2 :prefix "-POOL")))

; Predecode raw source control. SAME PRS supplies incarnation; this internal
; storage protocol does not install the received operation/factory allowance.
; Original TCPCL chain is retained until actual publication/abort/alias joins.
(in-package "ACL2")
(include-book "tcpcl-segment-source-cursor")
(include-book "bp-received-byte-storage")
(set-verify-guards-eagerness 2)
(defstobj fn-bprx-byte-node (fn-bprxb-children :type (stobj-table 16)) :inline t)
(defstobj fn-bprx-byte-left (fn-bprxbl-children :type (stobj-table 16))
 :congruent-to fn-bprx-byte-node :inline t)
(defstobj fn-bprx-byte-right (fn-bprxbr-children :type (stobj-table 16))
 :congruent-to fn-bprx-byte-node :inline t)
(defstobj fn-bprx-raw-source
 (fn-bprxs-slot :type (integer 0 *) :initially 0)
 (fn-bprxs-nonce :type (integer 0 *) :initially 0)
 (fn-bprxs-owner :initially nil)
 (fn-bprxs-transfer :initially nil)
 (fn-bprxs-count :type (integer 0 *) :initially 0)
 (fn-bprxs-copied :type (integer 0 *) :initially 0)
 (fn-bprxs-cursor :initially nil)
 (fn-bprxs-pending-byte :initially nil)
 (fn-bprxs-phase :initially :uninstalled)
 (fn-bprxs-pin :initially nil)
 (fn-bprxs-claim :initially nil)
 (fn-bprxs-pin-claim :initially nil)
 (fn-bprxs-bytes :type fn-bprx-byte-node)
 :inline t)
(set-verify-guards-eagerness 0)
(local (include-book "arithmetic-5/top" :dir :system))
(defun fn-bprx-source-ref (fn-bprx-raw-source)
 (declare (xargs :stobjs fn-bprx-raw-source))
 (list :bps-ref (fn-bprxs-slot fn-bprx-raw-source)
               (fn-bprxs-nonce fn-bprx-raw-source)))
(defun fn-bprx-source-matchp (ref fn-bprx-raw-source)
 (declare (xargs :stobjs fn-bprx-raw-source :guard t))
 (and (consp ref) (eq (car ref) :bps-ref)
      (consp (cdr ref)) (equal (cadr ref) (fn-bprxs-slot fn-bprx-raw-source))
      (consp (cddr ref)) (equal (caddr ref) (fn-bprxs-nonce fn-bprx-raw-source))
      (null (cdddr ref)) (not (eq (fn-bprxs-phase fn-bprx-raw-source) :uninstalled))))
; Core-only after SAMEpool reservation, actual selected source construction
; allowance and actual transfer source event. No public native supplied row.
; This function retains raw chain before copying and returns fixed interned ref.
(defun fn-bprx-source-retain (slot nonce owner transfer chain count claim fn-bprx-raw-source)
 (declare (xargs :stobjs fn-bprx-raw-source
  :guard (and (natp slot) (natp nonce) (natp count))))
 (if (not (eq (fn-bprxs-phase fn-bprx-raw-source) :uninstalled))
  (mv :source-busy nil fn-bprx-raw-source)
  (let* ((fn-bprx-raw-source (update-fn-bprxs-slot slot fn-bprx-raw-source))
         (fn-bprx-raw-source (update-fn-bprxs-nonce nonce fn-bprx-raw-source))
         (fn-bprx-raw-source (update-fn-bprxs-owner owner fn-bprx-raw-source))
         (fn-bprx-raw-source (update-fn-bprxs-transfer transfer fn-bprx-raw-source))
         (fn-bprx-raw-source (update-fn-bprxs-count count fn-bprx-raw-source))
         (fn-bprx-raw-source (update-fn-bprxs-cursor (fn-tsc-begin chain count) fn-bprx-raw-source))
         (fn-bprx-raw-source (update-fn-bprxs-claim claim fn-bprx-raw-source))
         (fn-bprx-raw-source (update-fn-bprxs-phase :retained fn-bprx-raw-source)))
   (mv :source-retained (fn-bprx-source-ref fn-bprx-raw-source) fn-bprx-raw-source))))
; No implicit lazy GET/constructor in reader. Address is actual leaf ordinal,
; full LSB path, so no slot alias or arbitrary transfer ceiling.
(defun fn-bprx-byte-read (nonce ordinal address at count fuel fn-bprx-byte-node)
 (declare (xargs :stobjs fn-bprx-byte-node :measure (nfix address)
  :guard (and (natp nonce) (natp ordinal) (natp address) (natp at)
              (natp count) (<= count 64) (natp fuel)) :verify-guards nil))
 (cond
  ((zp fuel) (mv :yield nil fuel))
  ((zp address)
   (if (not (fn-bprxb-children-boundp 'fn-bprx-segment fn-bprx-byte-node))
    (mv :source-unpublished nil (1- fuel))
    (stobj-let ((fn-bprx-segment (fn-bprxb-children-get 'fn-bprx-segment
                      fn-bprx-byte-node (create-fn-bprx-segment))))
     (word bytes) (fn-bprx-segment-window nonce ordinal at count fn-bprx-segment)
     (mv word bytes (1- fuel)))))
  ((equal (mod address 2) 0)
   (if (not (fn-bprxb-children-boundp 'fn-bprx-byte-left fn-bprx-byte-node))
    (mv :source-unpublished nil (1- fuel))
    (stobj-let ((fn-bprx-byte-left (fn-bprxb-children-get 'fn-bprx-byte-left
                         fn-bprx-byte-node (create-fn-bprx-byte-left))))
     (word bytes left)
     (fn-bprx-byte-read nonce ordinal (floor address 2) at count (1- fuel) fn-bprx-byte-left)
     (mv word bytes left))))
  (t
   (if (not (fn-bprxb-children-boundp 'fn-bprx-byte-right fn-bprx-byte-node))
    (mv :source-unpublished nil (1- fuel))
    (stobj-let ((fn-bprx-byte-right (fn-bprxb-children-get 'fn-bprx-byte-right
                         fn-bprx-byte-node (create-fn-bprx-byte-right))))
     (word bytes left)
     (fn-bprx-byte-read nonce ordinal (floor address 2) at count (1- fuel) fn-bprx-byte-right)
     (mv word bytes left))))))
; Read-copy crosses leaf boundaries without exposing leaf pointer or native
; authoritative byte tuple. Every node/byte consumes actual caller fuel.
(defun fn-bprx-source-copy-loop (nonce at count fuel fn-bprx-byte-node)
 (declare (xargs :stobjs fn-bprx-byte-node :measure (nfix count)
  :guard (and (natp nonce) (natp at) (natp count) (<= count 64) (natp fuel))
  :verify-guards nil))
 (if (zp count) (mv :source-window nil fuel)
  (mv-let (word one left)
   (fn-bprx-byte-read nonce (floor at 256) (floor at 256) (mod at 256) 1 fuel fn-bprx-byte-node)
   (if (not (eq word :source-window)) (mv word nil left)
    (mv-let (word bytes left)
     (fn-bprx-source-copy-loop nonce (1+ at) (1- count) left fn-bprx-byte-node)
     (if (eq word :source-window) (mv word (cons (car one) bytes) left)
      (mv word nil left)))))))
; One active borrowed copy/crypto/parser lease per actual source. Other jobs
; yield/busy rather than overwrite. Pin token identity must be SAMEPRS issued;
; public issuer remains gated until installed operation role/allowance exists.
(defun fn-bprx-source-pin-tokenp (token ref)
 (declare (xargs :guard t))
 (and (consp token) (eq (car token) :bps-source-pin)
      (consp (cdr token)) (natp (cadr token))
      (consp (cddr token)) (equal (caddr token) (fn-tsc-at 1 ref))
      (consp (cdddr token)) (equal (cadddr token) (fn-tsc-at 2 ref))
      (null (cddddr token))))
(defun fn-bprx-source-pin (ref pin-token pin-claim fn-bprx-raw-source)
 (declare (xargs :stobjs fn-bprx-raw-source :guard t))
 (cond ((not (fn-bprx-source-matchp ref fn-bprx-raw-source)) (mv :stale-source fn-bprx-raw-source))
       ((not (eq (fn-bprxs-phase fn-bprx-raw-source) :published)) (mv :source-unpublished fn-bprx-raw-source))
       ((not (fn-bprx-source-pin-tokenp pin-token ref)) (mv :stale-source-pin fn-bprx-raw-source))
       ((fn-bprxs-pin fn-bprx-raw-source) (mv :source-busy fn-bprx-raw-source))
       (t (let* ((fn-bprx-raw-source (update-fn-bprxs-pin-claim pin-claim fn-bprx-raw-source))
                 (fn-bprx-raw-source (update-fn-bprxs-pin pin-token fn-bprx-raw-source)))
            (mv :source-pinned fn-bprx-raw-source)))))
(defun fn-bprx-source-copy (ref pin-token at count fuel fn-bprx-raw-source)
 (declare (xargs :stobjs fn-bprx-raw-source
  :guard (and (natp at) (natp count) (<= count 64) (natp fuel)) :verify-guards nil))
 (cond
  ((not (fn-bprx-source-matchp ref fn-bprx-raw-source)) (mv :stale-source nil fuel))
  ((not (and (fn-bprx-source-pin-tokenp pin-token ref)
             (equal pin-token (fn-bprxs-pin fn-bprx-raw-source))))
   (mv :stale-source-pin nil fuel))
  ((not (eq (fn-bprxs-phase fn-bprx-raw-source) :published)) (mv :source-unpublished nil fuel))
  ((> (+ at count) (fn-bprxs-count fn-bprx-raw-source)) (mv :source-range nil fuel))
  (t (let ((nonce (fn-bprxs-nonce fn-bprx-raw-source)))
   (stobj-let ((fn-bprx-byte-node (fn-bprxs-bytes fn-bprx-raw-source)))
    (word bytes left) (fn-bprx-source-copy-loop nonce at count fuel fn-bprx-byte-node)
    (mv word bytes left))))))
; Fence does not discard source/cursor/pin/claim or refund. Pin settlement and
; final storage retirement must be driven by actual worker/alias joins.
(defun fn-bprx-source-fence (ref fn-bprx-raw-source)
 (declare (xargs :stobjs fn-bprx-raw-source :guard t))
 (if (not (fn-bprx-source-matchp ref fn-bprx-raw-source)) (mv :stale-source fn-bprx-raw-source)
  (let ((fn-bprx-raw-source (update-fn-bprxs-phase :fenced fn-bprx-raw-source)))
   (mv :source-fenced fn-bprx-raw-source))))

; Constructor action is explicit, one missing child/leaf per call, only under
; source construction intent. No reader or put operation invokes a creator.
(defun fn-bprx-byte-construct (nonce ordinal address fuel fn-bprx-byte-node)
 (declare (xargs :stobjs fn-bprx-byte-node :measure (nfix address)
  :guard (and (natp nonce) (natp ordinal) (natp address) (natp fuel)) :verify-guards nil))
 (cond ((zp fuel) (mv :yield fuel fn-bprx-byte-node))
       ((zp address)
        (if (fn-bprxb-children-boundp 'fn-bprx-segment fn-bprx-byte-node)
         (mv :source-leaf-present (1- fuel) fn-bprx-byte-node)
         (stobj-let ((fn-bprx-segment (fn-bprxb-children-get 'fn-bprx-segment
                         fn-bprx-byte-node (create-fn-bprx-segment))))
          (word fn-bprx-segment) (fn-bprx-segment-begin nonce ordinal fn-bprx-segment)
          (mv word (1- fuel) fn-bprx-byte-node))))
       ((equal (mod address 2) 0)
        (let ((present (fn-bprxb-children-boundp 'fn-bprx-byte-left fn-bprx-byte-node)))
         (stobj-let ((fn-bprx-byte-left (fn-bprxb-children-get 'fn-bprx-byte-left
                            fn-bprx-byte-node (create-fn-bprx-byte-left))))
          (word left fn-bprx-byte-left)
          (if present
           (fn-bprx-byte-construct nonce ordinal (floor address 2) (1- fuel) fn-bprx-byte-left)
           (mv :source-directory-created (1- fuel) fn-bprx-byte-left))
          (mv word left fn-bprx-byte-node))))
       (t
        (let ((present (fn-bprxb-children-boundp 'fn-bprx-byte-right fn-bprx-byte-node)))
         (stobj-let ((fn-bprx-byte-right (fn-bprxb-children-get 'fn-bprx-byte-right
                            fn-bprx-byte-node (create-fn-bprx-byte-right))))
          (word left fn-bprx-byte-right)
          (if present
           (fn-bprx-byte-construct nonce ordinal (floor address 2) (1- fuel) fn-bprx-byte-right)
           (mv :source-directory-created (1- fuel) fn-bprx-byte-right))
          (mv word left fn-bprx-byte-node))))
))
(defun fn-bprx-byte-write (nonce ordinal address at octet freeze fuel fn-bprx-byte-node)
 (declare (xargs :stobjs fn-bprx-byte-node :measure (nfix address)
  :guard (and (natp nonce) (natp ordinal) (natp address) (natp at)
              (fn-cbor-octetp octet) (natp fuel)) :verify-guards nil))
 (cond ((zp fuel) (mv :yield fuel fn-bprx-byte-node))
       ((zp address)
        (if (not (fn-bprxb-children-boundp 'fn-bprx-segment fn-bprx-byte-node))
         (mv :source-needs-leaf (1- fuel) fn-bprx-byte-node)
         (stobj-let ((fn-bprx-segment (fn-bprxb-children-get 'fn-bprx-segment
                          fn-bprx-byte-node (create-fn-bprx-segment))))
          (word fn-bprx-segment)
          (mv-let (word fn-bprx-segment)
           (fn-bprx-segment-put nonce ordinal at octet fn-bprx-segment)
           (if (and (eq word :source-byte) freeze)
            (mv-let (frozen fn-bprx-segment)
             (fn-bprx-segment-freeze nonce ordinal (1+ at) fn-bprx-segment)
             (mv (if (eq frozen :source-frozen) :source-byte frozen) fn-bprx-segment))
            (mv word fn-bprx-segment)))
          (mv word (1- fuel) fn-bprx-byte-node))))
       ((equal (mod address 2) 0)
        (if (not (fn-bprxb-children-boundp 'fn-bprx-byte-left fn-bprx-byte-node))
         (mv :source-needs-leaf (1- fuel) fn-bprx-byte-node)
         (stobj-let ((fn-bprx-byte-left (fn-bprxb-children-get 'fn-bprx-byte-left
                           fn-bprx-byte-node (create-fn-bprx-byte-left))))
          (word left fn-bprx-byte-left)
          (fn-bprx-byte-write nonce ordinal (floor address 2) at octet freeze (1- fuel) fn-bprx-byte-left)
          (mv word left fn-bprx-byte-node))))
       (t
        (if (not (fn-bprxb-children-boundp 'fn-bprx-byte-right fn-bprx-byte-node))
         (mv :source-needs-leaf (1- fuel) fn-bprx-byte-node)
         (stobj-let ((fn-bprx-byte-right (fn-bprxb-children-get 'fn-bprx-byte-right
                           fn-bprx-byte-node (create-fn-bprx-byte-right))))
          (word left fn-bprx-byte-right)
          (fn-bprx-byte-write nonce ordinal (floor address 2) at octet freeze (1- fuel) fn-bprx-byte-right)
          (mv word left fn-bprx-byte-node))))
))
(defun fn-bprx-source-construct (ref fuel fn-bprx-raw-source)
 (declare (xargs :stobjs fn-bprx-raw-source :guard (natp fuel) :verify-guards nil))
 (cond ((not (fn-bprx-source-matchp ref fn-bprx-raw-source)) (mv :stale-source fuel fn-bprx-raw-source))
       ((not (member-eq (fn-bprxs-phase fn-bprx-raw-source) '(:retained :filling)))
        (mv :source-fenced fuel fn-bprx-raw-source))
       ((zp fuel) (mv :yield fuel fn-bprx-raw-source))
       ((not (consp (fn-bprxs-pending-byte fn-bprx-raw-source)))
        (mv :source-no-constructor fuel fn-bprx-raw-source))
       (t
        ; Stored phase precedes actual lazy constructor. Raw escape requires
        ; fence/recovery; no automatic constructor retry or claim refund.
        (let* ((ordinal (floor (fn-bprxs-copied fn-bprx-raw-source) 256))
               (nonce (fn-bprxs-nonce fn-bprx-raw-source))
               (fn-bprx-raw-source (update-fn-bprxs-phase :constructing fn-bprx-raw-source)))
         (stobj-let ((fn-bprx-byte-node (fn-bprxs-bytes fn-bprx-raw-source)))
          (word left fn-bprx-byte-node)
          (fn-bprx-byte-construct nonce ordinal ordinal fuel fn-bprx-byte-node)
          (let ((fn-bprx-raw-source (update-fn-bprxs-phase :filling fn-bprx-raw-source)))
           (if (member-eq word '(:yield :source-directory-created :source-filling :source-leaf-present))
       (mv word left fn-bprx-raw-source)
       (let ((fn-bprx-raw-source (update-fn-bprxs-phase :fenced fn-bprx-raw-source)))
        (mv word left fn-bprx-raw-source)))))))))
(defun fn-bprx-source-populate (ref fuel fn-bprx-raw-source)
 (declare (xargs :stobjs fn-bprx-raw-source :guard (natp fuel) :verify-guards nil))
 (cond
  ((not (fn-bprx-source-matchp ref fn-bprx-raw-source)) (mv :stale-source fuel fn-bprx-raw-source))
  ((not (member-eq (fn-bprxs-phase fn-bprx-raw-source) '(:retained :filling)))
   (mv :source-fenced fuel fn-bprx-raw-source))
  ((zp fuel) (mv :yield fuel fn-bprx-raw-source))
  ((not (consp (fn-bprxs-pending-byte fn-bprx-raw-source)))
   (mv-let (word octet cursor) (fn-tsc-one (fn-bprxs-cursor fn-bprx-raw-source))
    (let ((fn-bprx-raw-source (update-fn-bprxs-cursor cursor fn-bprx-raw-source)))
     (cond
      ((eq word :refused)
       (let ((fn-bprx-raw-source (update-fn-bprxs-phase :fenced fn-bprx-raw-source)))
        (mv :source-fenced (1- fuel) fn-bprx-raw-source)))
      ((eq word :source-complete)
       (if (equal (fn-bprxs-copied fn-bprx-raw-source) (fn-bprxs-count fn-bprx-raw-source))
        (let ((fn-bprx-raw-source (update-fn-bprxs-phase :published fn-bprx-raw-source)))
         (mv :source-published (1- fuel) fn-bprx-raw-source))
        (let ((fn-bprx-raw-source (update-fn-bprxs-phase :fenced fn-bprx-raw-source)))
         (mv :source-count-mismatch (1- fuel) fn-bprx-raw-source))))
      ((eq word :source-byte)
       (let ((fn-bprx-raw-source (update-fn-bprxs-pending-byte (list octet) fn-bprx-raw-source)))
        (mv :source-byte-pending (1- fuel) fn-bprx-raw-source)))
      (t (mv :yield (1- fuel) fn-bprx-raw-source))))))
  (t
   (let* ((copied (fn-bprxs-copied fn-bprx-raw-source))
          (ordinal (floor copied 256)) (local (mod copied 256))
          (nonce (fn-bprxs-nonce fn-bprx-raw-source))
          (octet (car (fn-bprxs-pending-byte fn-bprx-raw-source)))
          (freeze (or (equal local 255) (equal (1+ copied) (fn-bprxs-count fn-bprx-raw-source)))))
    (stobj-let ((fn-bprx-byte-node (fn-bprxs-bytes fn-bprx-raw-source)))
     (word left fn-bprx-byte-node)
     (fn-bprx-byte-write nonce ordinal ordinal local octet freeze fuel fn-bprx-byte-node)
     (if (eq word :source-byte)
      (let* ((fn-bprx-raw-source (update-fn-bprxs-copied (1+ copied) fn-bprx-raw-source))
             (fn-bprx-raw-source (update-fn-bprxs-pending-byte nil fn-bprx-raw-source))
             (fn-bprx-raw-source (update-fn-bprxs-phase :filling fn-bprx-raw-source)))
       (mv word left fn-bprx-raw-source))
      (if (member-eq word '(:yield :source-needs-leaf))
       (mv word left fn-bprx-raw-source)
       (let ((fn-bprx-raw-source (update-fn-bprxs-phase :fenced fn-bprx-raw-source)))
        (mv word left fn-bprx-raw-source)))))))))

; Actual overlay-slot arena reservation. Groups belong to C slots, not uploads.
(in-package "ACL2")
(include-book "overlay")
(include-book "pool-credit-contracts")
(fn2-book-layer :c)
(defun fn2-idc-arena-credit-total (commitrows overlays)
 (declare (xargs :guard t))
 (+ 2 (nfix commitrows) (nfix overlays)))
(defun fn2-idc-arena-credit-group (o commitrows)
 (declare (xargs :guard t))
 (+ 2 (nfix commitrows) (nfix o)))
(defun fn2-idc-arena-credit-vector (class arena-class fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (fn2-pool-wfp fn2-pool) (natp class))
  :measure (nfix (- (nfix (fn2-pool-nclasses fn2-pool)) (nfix class)))))
 (if (not (and (natp class) (< class (nfix (fn2-pool-nclasses fn2-pool))))) nil
  (cons (if (equal class arena-class) 1 0)
        (fn2-idc-arena-credit-vector (+ class 1) arena-class fn2-pool))))
(defun fn2-idc-arena-credit-groups (rows vector)
 (declare (xargs :guard t :measure (nfix rows)))
 (if (zp rows) nil
  (cons (cons *fn2-pool-credit-working* vector)
        (fn2-idc-arena-credit-groups (- rows 1) vector))))
(defun fn2-idc-arena-credit-quota-p (class group arena-class fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (fn2-pool-wfp fn2-pool) (natp class))
  :measure (nfix (- (nfix (fn2-pool-nclasses fn2-pool)) (nfix class)))))
 (if (not (and (natp class) (< class (nfix (fn2-pool-nclasses fn2-pool))))) t
  (let ((i (+ (* (nfix group) (fn2-pool-nclasses fn2-pool)) class)))
   (and (< i (fn2-pool-credit-demand-length fn2-pool))
        (equal (fn2-pool-credit-demandi i fn2-pool) (if (equal class arena-class) 1 0))
        (fn2-idc-arena-credit-quota-p (+ class 1) group arena-class fn2-pool)))))
(defun fn2-idc-arena-credit-layout-p (o commitrows class fn2-overlays fn2-pool)
 (declare (xargs :stobjs (fn2-overlays fn2-pool)
  :guard (and (fn2-overlays-wfp fn2-overlays) (fn2-pool-wfp fn2-pool))))
 (let ((group (fn2-idc-arena-credit-group o commitrows)))
  (and (posp commitrows) (unsigned-byte-p 32 commitrows)
       (natp o) (< o (fn2-overlays-rows fn2-overlays))
       (natp class) (< class (fn2-pool-nclasses fn2-pool))
       (equal (fn2-pool-credit-configured fn2-pool) 1)
       (fn2-pool-credit-shapep fn2-pool)
       (equal (fn2-pool-credit-group-count fn2-pool)
              (fn2-idc-arena-credit-total commitrows (fn2-overlays-rows fn2-overlays)))
       (< group (fn2-pool-credit-purpose-length fn2-pool))
       (equal (fn2-pool-credit-purposei group fn2-pool) *fn2-pool-credit-working*)
       (fn2-idc-arena-credit-quota-p 0 group class fn2-pool))))
; Only the genuine unconfigured mode uses the ordinary allocator. A configured
; old/partial layout refuses; group positions cannot be inferred from G-O.
(defun fn2-idc-arena-reserve (o commitrows class kind owner ogen fn2-overlays fn2-pool)
 (declare (xargs :stobjs (fn2-overlays fn2-pool)
  :guard (and (fn2-overlays-wfp fn2-overlays) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (natp o) (< o (fn2-overlays-rows fn2-overlays))
                    (equal (fn2-overlays-phase o fn2-overlays) *fn2-overlay-phase-free*)))
       (mv :state 0 0 fn2-pool))
      ((when (equal (fn2-pool-credit-configured fn2-pool) 0))
       (if (natp class) (fn2-pool-reserve class kind owner ogen fn2-pool)
        (mv :capacity 0 0 fn2-pool)))
      ((unless (fn2-idc-arena-credit-layout-p o commitrows class fn2-overlays fn2-pool))
       (mv :capacity 0 0 fn2-pool))
      (group (fn2-idc-arena-credit-group o commitrows))
      (old (fn2-pool-credit-group-noncei group fn2-pool))
      (nonce (if (equal (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-aborted-empty*) old (+ 1 old)))
      ((unless (and (posp nonce) (unsigned-byte-p 60 nonce)
                    (not (equal (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-depleted*))))
       (mv :exhausted 0 0 fn2-pool))
      ((mv code fn2-pool) (fn2-pool-credit-begin group *fn2-pool-credit-working* nonce kind owner ogen fn2-pool))
      ((unless (eq code :ok)) (mv code 0 0 fn2-pool))
      ((mv code slot gen fn2-pool) (fn2-pool-reserve-credit group nonce class kind owner ogen fn2-pool))
      ((unless (eq code :ok))
       (mv-let (ac fn2-pool) (fn2-pool-credit-abort-empty group nonce kind owner ogen fn2-pool)
        (mv (if (eq ac :ok) code :state) 0 0 fn2-pool))))
  (mv :ok slot gen fn2-pool)))
(defun fn2-idc-arena-return-handle (o commitrows slot gen kind owner ogen fn2-overlays fn2-pool)
 (declare (xargs :stobjs (fn2-overlays fn2-pool)
  :guard (and (fn2-overlays-wfp fn2-overlays) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (natp slot) (< slot (fn2-pool-rows fn2-pool)))) (mv :bounds fn2-pool))
      ((when (equal (fn2-pool-credit-configured fn2-pool) 0))
       (fn2-pool-release slot gen kind owner ogen fn2-pool))
      (class (fn2-pool-class slot fn2-pool))
      ((unless (and (fn2-idc-arena-credit-layout-p o commitrows class fn2-overlays fn2-pool)
                    (equal (fn2-pool-credit-group slot fn2-pool) (fn2-idc-arena-credit-group o commitrows))))
       (mv :owner fn2-pool)))
  (fn2-pool-release-credit slot gen (fn2-idc-arena-credit-group o commitrows)
    (fn2-pool-credit-nonce slot fn2-pool) kind owner ogen fn2-pool)))
(defun fn2-idc-arena-return (o commitrows fn2-overlays fn2-pool)
 (declare (xargs :stobjs (fn2-overlays fn2-pool)
  :guard (and (fn2-overlays-wfp fn2-overlays) (fn2-pool-wfp fn2-pool))))
 (if (not (and (natp o) (< o (fn2-overlays-rows fn2-overlays)))) (mv :bounds fn2-pool)
  (fn2-idc-arena-return-handle o commitrows
   (fn2-overlays-slot o fn2-overlays) (fn2-overlays-gen o fn2-overlays)
   (fn2-overlays-okind o fn2-overlays) (fn2-overlays-oslot o fn2-overlays) (fn2-overlays-ogen o fn2-overlays)
   fn2-overlays fn2-pool)))
; No issue or publication occurs in this primitive. If ov-start rejects its
; index range, return the fresh exact lease before ABORTED-EMPTY rearm.
(defun fn2-idc-arena-start (o commitrows arena ibase icap kind owner ogen fn2-overlays fn2-overlay-index fn2-pool)
 (declare (xargs :stobjs (fn2-overlays fn2-overlay-index fn2-pool)
  :guard (and (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (unsigned-byte-p 32 arena)) (mv :capacity fn2-overlays fn2-pool))
      (class (fn2-pool-class-for arena fn2-pool))
      ((unless (natp class)) (mv :capacity fn2-overlays fn2-pool))
      ((mv code slot gen fn2-pool) (fn2-idc-arena-reserve o commitrows class kind owner ogen fn2-overlays fn2-pool))
      ((unless (eq code :ok))
       (mv (if (and (equal (fn2-pool-credit-configured fn2-pool) 0) (eq code :exhausted)) :full code)
           fn2-overlays fn2-pool))
      ((mv code fn2-overlays fn2-pool)
       (fn2-ov-start o 0 slot gen ibase icap kind owner ogen 0 fn2-overlays fn2-overlay-index fn2-pool))
      ((unless (eq code :ok))
       (mv-let (rc fn2-pool) (fn2-idc-arena-return-handle o commitrows slot gen kind owner ogen fn2-overlays fn2-pool)
        (if (eq rc :ok)
            (if (equal (fn2-pool-credit-configured fn2-pool) 0) (mv code fn2-overlays fn2-pool)
             (mv-let (ac fn2-pool)
              (fn2-pool-credit-abort-empty (fn2-idc-arena-credit-group o commitrows)
                (fn2-pool-credit-group-noncei (fn2-idc-arena-credit-group o commitrows) fn2-pool)
                kind owner ogen fn2-pool)
              (mv (if (eq ac :ok) code :state) fn2-overlays fn2-pool)))
          (if (eq rc :retired) (mv :exhausted fn2-overlays fn2-pool)
           ; Retain exact ownership in a non-free C row on an unexpected
           ; nonterminal return. The caller must refuse, never reuse it.
           (let ((fn2-overlays (fn2-overlays-put o (phase *fn2-overlay-phase-active*)
                     (slot slot) (gen gen) (okind kind) (oslot owner) (ogen ogen))))
            (mv :state fn2-overlays fn2-pool))))))
      ((mv code fn2-overlays) (fn2-ov-advance o *fn2-overlay-phase-active* *fn2-overlay-phase-spare* fn2-overlays))
      ((unless (eq code :ok)) (mv code fn2-overlays fn2-pool))
      ((when (equal (fn2-pool-credit-configured fn2-pool) 0)) (mv :ok fn2-overlays fn2-pool))
      (group (fn2-idc-arena-credit-group o commitrows))
      ((mv code fn2-pool) (fn2-pool-credit-end group (fn2-pool-credit-group-noncei group fn2-pool) kind owner ogen fn2-pool)))
  (mv code fn2-overlays fn2-pool)))
(fn2-pool-preserves fn2-idc-arena-reserve
 (o commitrows class kind owner ogen fn2-overlays fn2-pool) :position 3 :raw-rows t)
(fn2-pool-preserves fn2-idc-arena-return-handle
 (o commitrows slot gen kind owner ogen fn2-overlays fn2-pool) :position 1 :raw-rows t)
(fn2-pool-preserves fn2-idc-arena-return
 (o commitrows fn2-overlays fn2-pool) :position 1 :raw-rows t)
(fn2-overlays-preserves fn2-idc-arena-start
 (o commitrows arena ibase icap kind owner ogen fn2-overlays fn2-overlay-index fn2-pool) :position 1 :raw-rows t)
(fn2-pool-preserves fn2-idc-arena-start
 (o commitrows arena ibase icap kind owner ogen fn2-overlays fn2-overlay-index fn2-pool) :position 2 :raw-rows t)

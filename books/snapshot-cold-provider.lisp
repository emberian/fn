; The outer source adapter maps an issued cold-codec byte demand to the
; authenticated page reader. No host computes a pool offset or reconstructs
; a child request. A pending mapping freezes the child until supplied.
(in-package "ACL2")
(include-book "snapshot-based-provider")
(defun fn-ocb-childp (request)
  (declare (xargs :guard t))
  (and (fn-omk-widthp request 4) (eq (fn-omk-at 0 request) :need-byte)
       (natp (fn-omk-at 1 request))
       (member-eq (fn-omk-at 2 request)
                  '(:octet-nil :symbol-normalize :span-body :opaque-span))
       (natp (fn-omk-at 3 request))))
(defun fn-ocb-child-matchp (a b)
  (declare (xargs :guard t))
  (and (fn-ocb-childp a) (fn-ocb-childp b)
       (equal (fn-omk-at 1 a) (fn-omk-at 1 b))
       (equal (fn-omk-at 2 a) (fn-omk-at 2 b))
       (equal (fn-omk-at 3 a) (fn-omk-at 3 b))))
(defun fn-ocb-offer (handle source serial child)
  (declare (xargs :guard t))
  (if (not (and (fn-obp-headerp handle) (fn-omk-tokenp source)
                (natp serial) (fn-ocb-childp child)
                (< (nfix (fn-omk-at 1 child))
                   (nfix (fn-omk-at 4 (fn-omk-at 5 handle))))))
      '(:refused :cold-byte-domain)
    (let ((absolute (+ (* 16384 (nfix (fn-omk-at 4 (fn-omk-at 6 handle))))
                       (nfix (fn-omk-at 1 child)))))
      (list :waiting child
            (list :need-byte source (fn-omk-at 2 child) serial
                  (floor absolute 16384) (mod absolute 16384))))))
(defun fn-ocb-observation-word (mapping current-source current-child observation)
  (declare (xargs :guard t))
  (let ((demand (fn-omk-at 2 mapping)))
    (if (not (and (fn-omk-widthp mapping 3)
                  (equal (fn-omk-at 0 mapping) :waiting)
                  (fn-ocb-child-matchp (fn-omk-at 1 mapping) current-child)
                  (fn-omk-widthp demand 6)
                  (equal (fn-omk-at 0 demand) :need-byte)
                  (fn-omk-token-matchp current-source (fn-omk-at 1 demand))
                  (fn-omk-widthp observation 7)
                  (equal (fn-omk-at 0 observation) :byte)
                  (fn-omk-token-matchp current-source (fn-omk-at 1 observation))
                  (equal (fn-omk-at 2 observation) (fn-omk-at 2 demand))
                  (equal (fn-omk-at 3 observation) (fn-omk-at 3 demand))
                  (equal (fn-omk-at 4 observation) (fn-omk-at 4 demand))
                  (equal (fn-omk-at 5 observation) (fn-omk-at 5 demand))
                  (natp (fn-omk-at 6 observation))
                  (< (fn-omk-at 6 observation) 256)))
        '(:refused :cold-byte-completion)
      (list :supply (fn-omk-at 1 current-child) (fn-omk-at 6 observation)))))
(defthm fn-ocb-supply-requires-the-current-child
  (implies (equal (car (fn-ocb-observation-word mapping source child observation)) :supply)
           (fn-ocb-child-matchp (fn-omk-at 1 mapping) child))
  :hints (("Goal" :in-theory (enable fn-ocb-observation-word))))
(in-theory (disable fn-ocb-childp fn-ocb-child-matchp fn-ocb-offer
                    fn-ocb-observation-word))

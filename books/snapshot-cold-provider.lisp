; The outer source adapter maps an issued cold-codec byte demand to the
; authenticated page reader. No host computes a pool offset or reconstructs
; a child request. A pending mapping freezes the child until supplied.
(in-package "ACL2")
(include-book "snapshot-based-provider")
(defun fn-ocb-childp (request)
  (declare (xargs :guard t))
  (and (fn-omk-widthp request 4) (eq (fn-omk-at 0 request) :need-byte)
       (natp (fn-omk-at 1 request))
       (member-eq (fn-omk-at 2 request)
                  '(:octet-nil :symbol-normalize :span-body :opaque-span :key))
       (natp (fn-omk-at 3 request))))
(defun fn-ocb-child-matchp (a b)
  (declare (xargs :guard t))
  (and (fn-ocb-childp a) (fn-ocb-childp b)
       (equal (fn-omk-at 1 a) (fn-omk-at 1 b))
       (equal (fn-omk-at 2 a) (fn-omk-at 2 b))
       (equal (fn-omk-at 3 a) (fn-omk-at 3 b))))
(defun fn-ocb-offer (handle source serial child)
  (declare (xargs :guard t))
  (if (not (and (fn-obp-headerp handle) (fn-omk-tokenp source)
                (natp serial) (fn-ocb-childp child)
                (< (nfix (fn-omk-at 1 child))
                   (nfix (fn-omk-at 4 (fn-omk-at 5 handle))))))
      '(:refused :cold-byte-domain)
    (let ((absolute (+ (* 16384 (nfix (fn-omk-at 4 (fn-omk-at 6 handle))))
                       (nfix (fn-omk-at 1 child)))))
      (list :waiting child
            (list :need-byte source (fn-omk-at 2 child) serial
                  (floor absolute 16384) (mod absolute 16384))))))
(defun fn-ocb-observation-word (mapping current-source current-child observation)
  (declare (xargs :guard t))
  (let ((demand (fn-omk-at 2 mapping)))
    (if (not (and (fn-omk-widthp mapping 3)
                  (equal (fn-omk-at 0 mapping) :waiting)
                  (fn-ocb-child-matchp (fn-omk-at 1 mapping) current-child)
                  (fn-omk-widthp demand 6)
                  (equal (fn-omk-at 0 demand) :need-byte)
                  (fn-omk-token-matchp current-source (fn-omk-at 1 demand))
                  (fn-omk-widthp observation 7)
                  (equal (fn-omk-at 0 observation) :byte)
                  (fn-omk-token-matchp current-source (fn-omk-at 1 observation))
                  (equal (fn-omk-at 2 observation) (fn-omk-at 2 demand))
                  (equal (fn-omk-at 3 observation) (fn-omk-at 3 demand))
                  (equal (fn-omk-at 4 observation) (fn-omk-at 4 demand))
                  (equal (fn-omk-at 5 observation) (fn-omk-at 5 demand))
                  (natp (fn-omk-at 6 observation))
                  (< (fn-omk-at 6 observation) 256)))
        '(:refused :cold-byte-completion)
      (list :supply (fn-omk-at 1 current-child) (fn-omk-at 6 observation)))))
(defthm fn-ocb-supply-requires-the-current-child
  (implies (equal (car (fn-ocb-observation-word mapping source child observation)) :supply)
           (fn-ocb-child-matchp (fn-omk-at 1 mapping) child))
  :hints (("Goal" :in-theory (enable fn-ocb-observation-word))))
(defun fn-ocb-begin (handle source resource)
  (declare (xargs :guard t))
  (list (if (and (fn-obp-headerp handle) (fn-omk-tokenp source)) :idle :refused)
        handle source 0 nil resource))
(defun fn-ocb-request (cursor child)
  (declare (xargs :guard t))
  (if (not (and (fn-omk-widthp cursor 6) (eq (fn-omk-at 0 cursor) :idle)
                (natp (fn-omk-at 3 cursor))))
      (mv '(:refused :cold-byte-phase) cursor)
    (let ((mapping (fn-ocb-offer (fn-omk-at 1 cursor) (fn-omk-at 2 cursor)
                                  (fn-omk-at 3 cursor) child)))
      (if (not (eq (car mapping) :waiting)) (mv mapping cursor)
        (mv :waiting (list :waiting (fn-omk-at 1 cursor) (fn-omk-at 2 cursor)
                           (fn-omk-at 3 cursor) mapping (fn-omk-at 5 cursor)))))))
(defun fn-ocb-demand (cursor)
  (declare (xargs :guard t))
  (if (and (fn-omk-widthp cursor 6) (eq (fn-omk-at 0 cursor) :waiting))
      (fn-omk-at 2 (fn-omk-at 4 cursor))
    '(:refused :cold-byte-phase)))
(defun fn-ocb-complete (cursor current-source current-child observation)
  (declare (xargs :guard t))
  (if (not (and (fn-omk-widthp cursor 6) (eq (fn-omk-at 0 cursor) :waiting)
                (natp (fn-omk-at 3 cursor))
                (fn-omk-token-matchp current-source (fn-omk-at 2 cursor))))
      (mv '(:refused :cold-byte-phase) cursor)
    (let ((word (fn-ocb-observation-word (fn-omk-at 4 cursor)
                                         current-source current-child observation)))
      (if (not (eq (fn-omk-at 0 word) :supply)) (mv word cursor)
        (mv word (list :idle (fn-omk-at 1 cursor) (fn-omk-at 2 cursor)
                       (1+ (fn-omk-at 3 cursor)) nil (fn-omk-at 5 cursor)))))))
(defthm fn-ocb-rejected-completion-preserves-the-issued-request
  (implies (not (equal (car (mv-nth 0 (fn-ocb-complete cursor source child observation))) :supply))
           (equal (mv-nth 1 (fn-ocb-complete cursor source child observation)) cursor))
  :hints (("Goal" :in-theory (enable fn-ocb-complete))))
(in-theory (disable fn-ocb-childp fn-ocb-child-matchp fn-ocb-offer
                    fn-ocb-observation-word fn-ocb-begin fn-ocb-request
                    fn-ocb-demand fn-ocb-complete))

; Project the ACTUAL issued key child. Index is a core cursor coordinate,
; not a host reconstruction of a Message-ID span or its target salt.
(defun fn-ocb-key-child (keycursor)
  (declare (xargs :guard t))
  (if (not (fn-omk-guardp keycursor)) '(:refused :key-cursor)
    (let ((issued (fn-omk-tick keycursor nil)))
      (if (eq (car issued) :need-byte)
          (list :need-byte (fn-omk-at 1 issued) :key (fn-omk-at 3 keycursor))
        '(:refused :key-not-waiting)))))
(defun fn-ocb-key-observation (keycursor word)
  (declare (xargs :guard t))
  (let ((child (fn-ocb-key-child keycursor)))
    (if (and (fn-ocb-childp child) (fn-omk-widthp word 3)
             (eq (fn-omk-at 0 word) :supply)
             (equal (fn-omk-at 1 word) (fn-omk-at 1 child))
             (unsigned-byte-p 8 (fn-omk-at 2 word)))
        (list :byte (fn-omk-at 6 keycursor) (fn-omk-at 1 child)
                    (fn-omk-at 2 word))
      '(:refused :key-byte))))

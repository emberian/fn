; Runtime frontier continuation over the authenticated current recovery unit.
; The selected C frontier is retained: no initialisation or caller leaf hash.
(in-package "ACL2")
(include-book "recovery-payload")
(include-book "event-frontier")
(fn2-book-layer :d)

(defun fn2-recovery-frontier-step (id fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (b* (((unless (fn2-recovery-idp id fn2-core)) (mv :state fn2-core))
      (ogen (fn2-machine-generation id fn2-core))
      ((unless (and (fn2-rp-current-unit-auth-p id ogen fn2-core)
                    (= (fn2-machine-rc-mode id fn2-core) *fn2-rec-mode-replay*)
                    (= (fn2-machine-rc-stage id fn2-core) 4))) (mv :state fn2-core))
      ((mv arena base fits) (fn2-recovery-geometry fn2-core))
      ((unless fits) (mv :bounds fn2-core))
      (leaf (fn2-rec-scratch-row base arena))
      (first (fn2-machine-rc-frontier-first id fn2-core))
      (last (fn2-machine-rc-frontier-last id fn2-core))
      (started (fn2-machine-rc-frontier-started id fn2-core))
      (p (fn2-machine-rc-pos id fn2-core))
      (off (fn2-machine-rc-auth-roff id fn2-core))
      (end (fn2-machine-rc-auth-rend id fn2-core))
      (slot (fn2-machine-pool-slot id fn2-core))
      (gen (fn2-machine-pool-gen id fn2-core))
      (current
       (stobj-let ((fn2-rec-cand (fn2-core-rec-cand fn2-core))) (current)
        (and (< p (fn2-rec-cand-rows fn2-rec-cand)) (posp first) (<= first last)
             (unsigned-byte-p 60 (+ 1 last))
             (= first (fn2-rec-cand-first p fn2-rec-cand))
             (= last (fn2-rec-cand-last p fn2-rec-cand))) current))
      ((unless current) (mv :state fn2-core))
      ((when (= started 0))
       (b* (((mv code fn2-core)
             (stobj-let ((fn2-journal-members (fn2-core-journal-members fn2-core))
                         (fn2-mk (fn2-core-mk fn2-core)) (fn2-digests (fn2-core-digests fn2-core)))
              (code fn2-journal-members)
              (if (and (fn2-mk-ready 0 fn2-mk fn2-digests) (= (+ 1 (fn2-mk-size 0 fn2-mk)) first))
                  (fn2-journal-members-begin first (+ 1 (- last first)) off end slot gen
                    *fn2-recovery-machine-kind* id ogen fn2-journal-members)
                (mv :state fn2-journal-members))
              (mv code fn2-core)))
            (fn2-core (if (eq code :ok)
                         (fn2-recovery-machine-put-core id (rc-frontier-started 1)) fn2-core)))
        (mv (if (eq code :ok) :more code) fn2-core)))
      ((mv code fn2-core)
       (stobj-let ((fn2-journal-members (fn2-core-journal-members fn2-core))
                   (fn2-mk (fn2-core-mk fn2-core)) (fn2-b3 (fn2-core-b3 fn2-core))
                   (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core))
                   (fn2-digests (fn2-core-digests fn2-core)))
        (code fn2-journal-members fn2-mk fn2-b3 fn2-fields fn2-digests)
        (if (and (< 0 (fn2-journal-members-rows fn2-journal-members))
                 (= (fn2-journal-members-slot 0 fn2-journal-members) slot)
                 (= (fn2-journal-members-gen 0 fn2-journal-members) gen)
                 (= (fn2-journal-members-owner-kind 0 fn2-journal-members) *fn2-recovery-machine-kind*)
                 (= (fn2-journal-members-owner-slot 0 fn2-journal-members) id)
                 (= (fn2-journal-members-owner-gen 0 fn2-journal-members) ogen)
                 (= (fn2-journal-members-end 0 fn2-journal-members) end)
                 (= (fn2-journal-members-end-event 0 fn2-journal-members) (+ 1 last))
                 (<= off (fn2-journal-members-start 0 fn2-journal-members))
                 (<= first (fn2-journal-members-next-event 0 fn2-journal-members)))
            (mv-let (code fn2-journal-members fn2-mk fn2-b3 fn2-fields fn2-digests)
             (fn2-event-members-step *fn2-rec-field-base* 0 leaf fn2-journal-members fn2-mk fn2-b3 fn2-fields fn2-pool fn2-digests)
             (mv (if (eq code :done)
                     (if (and (= (fn2-journal-members-next-event 0 fn2-journal-members) (+ 1 last))
                              (= (fn2-mk-size 0 fn2-mk) last)) :done :state) code)
                 fn2-journal-members fn2-mk fn2-b3 fn2-fields fn2-digests))
          (mv :state fn2-journal-members fn2-mk fn2-b3 fn2-fields fn2-digests))
        (mv code fn2-core))))
  ; The actual scanner completion is the sole ownership-cursor initializer.
  ; Full-base and selected replay take the same transition; the ownership
  ; consumer chooses their existing allocation paths after this boundary.
  (let ((fn2-core (if (eq code :done)
                      (fn2-recovery-machine-put-core id
                        (rc-stage 5) (rc-own-token 0) (rc-own-left 0))
                    fn2-core)))
   (mv (if (member-eq code '(:more :leaf :appended)) :more code) fn2-core))))
(fn2-core-preserves fn2-recovery-frontier-step (id fn2-core) :position 1 :rows nil)
(defcost fn2-recovery-frontier-step :answers (:more :done :state :bounds :owner :invalid) :bytes 4096
 :tables (fn2-core-machines fn2-core-rec-cand fn2-core-journal-members fn2-core-mk fn2-core-b3 fn2-core-fields fn2-core-pool fn2-core-digests)
 :doc "One authenticated recovery member scan/hash/carry transition, preserving the selected runtime frontier and immutable source lease.")

; Selected reconstruction publishes its mapped terminal while issuance stays
; closed. Only the later boot's actual persisted newer-epoch Fence may open
; phase4. The ordinary full-discovery path retains its existing entry.
(defun fn2-recovery-install-finish (id fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (b* (((unless (and (fn2-recovery-idp id fn2-core)
                    (= (fn2-machine-phase id fn2-core) *fn2-recovery-machine-state-install*)
                    (= (fn2-machine-rc-stage id fn2-core) 2)
                    (<= (fn2-machine-rc-high id fn2-core) (fn2-machine-rc-found id fn2-core))
                    (member-equal (fn2-machine-rc-class id fn2-core)
                     (list *fn2-rec-class-intact* *fn2-rec-class-torn-tail*)))) (mv :state fn2-core))
      (chain (fn2-machine-rc-chain id fn2-core))
      (epoch (fn2-machine-rc-epoch id fn2-core))
      ((when (fn2-recovery-selected-current-p id fn2-core))
       (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))
                   (fn2-extents (fn2-core-extents fn2-core)))
        (code fn2-commit-root)
        (if (and (fn2-commit-directory-recovery-terminal-p chain fn2-commit-root)
                 (= (fn2-alloc-freeze-phase fn2-extents) 4)
                 (= (fn2-alloc-epoch-begun fn2-extents) 0)
                 (unsigned-byte-p 60 (+ 1 epoch)))
            (let* ((fn2-commit-root (fn2-commit-root-set-installed 0 chain fn2-commit-root))
                   (fn2-commit-root (fn2-commit-root-set-published 0 chain fn2-commit-root))
                   (fn2-commit-root (fn2-commit-root-set-proposed 0 chain fn2-commit-root)))
             (mv :ok fn2-commit-root))
          (mv :state fn2-commit-root))
        (mv code fn2-core)))
      ((unless (and (fn2-rp-current-source-p id fn2-core)
                    (= (fn2-machine-rc-base id fn2-core) 0)
                    (= (fn2-machine-rc-base-tag id fn2-core) 0))) (mv :state fn2-core)))
  (b* ((ogen (fn2-machine-generation id fn2-core))
       ((mv index fn2-core) (fn2-recovery-fullbase-index id ogen fn2-core))
       ((unless (eq index :active)) (mv index fn2-core)))
   (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))
               (fn2-extents (fn2-core-extents fn2-core))) (code fn2-commit-root)
    (if (and (fn2-commit-directory-recovery-terminal-p chain fn2-commit-root)
             (fn2-alloc-identity-owner-p *fn2-recovery-machine-kind* id ogen ogen fn2-extents)
             (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-idle*)
             (= (fn2-alloc-identity-op fn2-extents) *fn2-alloc-identity-op-none*)
             (= (fn2-alloc-epoch-begun fn2-extents) 0)
             (unsigned-byte-p 60 (+ 1 epoch)))
        (let* ((fn2-commit-root (fn2-commit-root-set-installed 0 chain fn2-commit-root))
               (fn2-commit-root (fn2-commit-root-set-published 0 chain fn2-commit-root))
               (fn2-commit-root (fn2-commit-root-set-proposed 0 chain fn2-commit-root)))
         (mv :ok fn2-commit-root))
      (mv :state fn2-commit-root))
    (mv code fn2-core)))))
(fn2-core-preserves fn2-recovery-install-finish (id fn2-core) :position 1 :rows nil)
(defcost fn2-recovery-install-finish :answers (:ok :more :active :owner :cursor :state :bounds :busy)
 :tables (fn2-core-commit-root fn2-core-extents)
 :doc "Publish the actual recovered directory terminal; selected cold reconstruction keeps issuance closed through ordered replay and the later boot Fence.")

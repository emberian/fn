; Registered BP CURRENT storage. Internal effects are not constructor grants.
; Allocation must be reserved from the ONE shared pool before any child creation.
(in-package "ACL2")
(include-book "bp-node-foundation")
; Generated stobj-table helpers must all have the guarded raw class even
; when an enclosing BP source prefix used eagerness0.
(set-verify-guards-eagerness 2)
(defstobj fn-bpc-segment
  (fn-bpcs-rows :type (array t (64)) :initially nil)
  (fn-bpcs-id :type (integer 0 *) :initially 0)
  :inline t)
(defstobj fn-bpc-node
  (fn-bpcn-children :type (stobj-table 16))
  :inline t)
(defstobj fn-bpc-left
  (fn-bpcl-children :type (stobj-table 16))
  :congruent-to fn-bpc-node :inline t)
(defstobj fn-bpc-right
  (fn-bpcr-children :type (stobj-table 16))
  :congruent-to fn-bpc-node :inline t)
(defstobj fn-bp-controller-registry
  (fn-bpcr-root :type fn-bpc-node)
  (fn-bpcr-depth :type (integer 0 *) :initially 0)
  (fn-bpcr-highwater :type (integer 0 *) :initially 0)
  (fn-bpcr-runtime :initially nil)
  :inline t)
(defun fn-bpc-tokenp (token)
  (declare (xargs :guard t))
  (and (consp token) (equal (car token) :bp-controller)
       (consp (cdr token)) (natp (cadr token))
       (consp (cddr token)) (natp (caddr token)) (null (cdddr token))))
; Issued KEY can retain an entire delivery. Never compare it on this fence.
(defun fn-bpc-issued-fencep (a b)
  (declare (xargs :guard t))
  (and (equal (fn-bpn-nth 0 a) (fn-bpn-nth 0 b))
       (equal (fn-bpn-nth 1 a) (fn-bpn-nth 1 b))
       (equal (fn-bpn-nth 2 a) (fn-bpn-nth 2 b))
       (equal (fn-bpn-nth 3 a) (fn-bpn-nth 3 b))
       (equal (fn-bpn-nth 5 a) (fn-bpn-nth 5 b))))
; Rows: nonce, phase, CURRENT, resource receipt, distinct pending checkpoint job.
(defun fn-bpc-row-livep (nonce row)
  (declare (xargs :guard (natp nonce)))
  (and (equal (fn-bpn-nth 0 row) nonce)
       (equal (fn-bpn-nth 1 row) :live)))
(defun fn-bpc-node-current (nonce local-slot physical-segment depth fuel fn-bpc-node)
  (declare (xargs :stobjs fn-bpc-node :measure (nfix depth)
                  :guard (and (natp nonce) (natp local-slot) (< local-slot 64)
                              (natp physical-segment) (natp depth) (natp fuel))))
  (cond ((<= fuel depth) (mv :yield nil fuel))
        ((zp depth)
         (if (not (fn-bpcn-children-boundp 'fn-bpc-segment fn-bpc-node))
             (mv :controller-unavailable nil (- fuel 1))
           (stobj-let ((fn-bpc-segment (fn-bpcn-children-get 'fn-bpc-segment fn-bpc-node (create-fn-bpc-segment))))
             (status current)
             (let ((row (fn-bpcs-rowsi local-slot fn-bpc-segment)))
               (cond ((not (equal (fn-bpn-nth 0 row) nonce)) (mv :stale-controller nil))
                     ((equal (fn-bpn-nth 1 row) :fenced) (mv :controller-fenced nil))
                     ((not (fn-bpc-row-livep nonce row)) (mv :stale-controller nil))
                     ((fn-bpn-nth 4 row) (mv :controller-busy nil))
                     (t (mv :current (fn-bpn-nth 2 row)))))
             (mv status current (- fuel 1)))))
        ((equal (mod physical-segment 2) 0)
         (if (not (fn-bpcn-children-boundp 'fn-bpc-left fn-bpc-node))
             (mv :controller-unavailable nil (- fuel 1))
           (stobj-let ((fn-bpc-left (fn-bpcn-children-get 'fn-bpc-left fn-bpc-node (create-fn-bpc-left))))
             (status current left)
             (fn-bpc-node-current nonce local-slot (floor physical-segment 2) (- depth 1) (- fuel 1) fn-bpc-left)
             (mv status current left))))
        (t
         (if (not (fn-bpcn-children-boundp 'fn-bpc-right fn-bpc-node))
             (mv :controller-unavailable nil (- fuel 1))
           (stobj-let ((fn-bpc-right (fn-bpcn-children-get 'fn-bpc-right fn-bpc-node (create-fn-bpc-right))))
             (status current left)
             (fn-bpc-node-current nonce local-slot (floor physical-segment 2) (- depth 1) (- fuel 1) fn-bpc-right)
             (mv status current left))))
))
(local (include-book "arithmetic-5/top" :dir :system))
(defun fn-bpc-current (token fuel fn-bp-controller-registry)
  (declare (xargs :stobjs fn-bp-controller-registry :guard (natp fuel)))
  (cond ((not (fn-bpc-tokenp token)) (mv :stale-controller nil fuel))
        ((<= (fn-bpcr-highwater fn-bp-controller-registry) (caddr token))
         (mv :stale-controller nil fuel))
        (t (stobj-let ((fn-bpc-node (fn-bpcr-root fn-bp-controller-registry)))
             (status current left)
             (fn-bpc-node-current (cadr token) (mod (caddr token) 64)
               (floor (caddr token) 64) (fn-bpcr-depth fn-bp-controller-registry) fuel fn-bpc-node)
             (mv status current left)))))

(defun fn-bpc-node-replace (nonce local-slot physical-segment depth expected-epoch expected-issued next-current fuel fn-bpc-node)
  (declare (xargs :stobjs fn-bpc-node :measure (nfix depth)
                  :guard (and (natp nonce) (natp local-slot) (< local-slot 64)
                              (natp physical-segment) (natp depth) (natp fuel))))
  (cond ((<= fuel depth) (mv :yield fuel fn-bpc-node))
        ((zp depth)
         (if (not (fn-bpcn-children-boundp 'fn-bpc-segment fn-bpc-node))
             (mv :controller-unavailable (- fuel 1) fn-bpc-node)
           (stobj-let ((fn-bpc-segment (fn-bpcn-children-get 'fn-bpc-segment fn-bpc-node (create-fn-bpc-segment))))
             (status fn-bpc-segment)
             (let* ((row (fn-bpcs-rowsi local-slot fn-bpc-segment))
                    (current (fn-bpn-nth 2 row)))
               (cond ((not (equal (fn-bpn-nth 0 row) nonce)) (mv :stale-controller fn-bpc-segment))
                     ((equal (fn-bpn-nth 1 row) :fenced) (mv :controller-fenced fn-bpc-segment))
                     ((not (fn-bpc-row-livep nonce row)) (mv :stale-controller fn-bpc-segment))
                     ((fn-bpn-nth 4 row) (mv :controller-busy fn-bpc-segment))
                     ((not (and (equal (fn-bpnf-epoch current) expected-epoch)
                                (fn-bpc-issued-fencep (fn-bpnf-issued current) expected-issued)))
                      (mv :stale-current fn-bpc-segment))
                     (t (let ((fn-bpc-segment
                               (update-fn-bpcs-rowsi local-slot
                                 (list nonce :live next-current (fn-bpn-nth 3 row) nil) fn-bpc-segment)))
                          (mv :updated fn-bpc-segment)))))
             (mv status (- fuel 1) fn-bpc-node))))
        ((equal (mod physical-segment 2) 0)
         (if (not (fn-bpcn-children-boundp 'fn-bpc-left fn-bpc-node))
             (mv :controller-unavailable (- fuel 1) fn-bpc-node)
           (stobj-let ((fn-bpc-left (fn-bpcn-children-get 'fn-bpc-left fn-bpc-node (create-fn-bpc-left))))
             (status left fn-bpc-left)
             (fn-bpc-node-replace nonce local-slot (floor physical-segment 2) (- depth 1)
               expected-epoch expected-issued next-current (- fuel 1) fn-bpc-left)
             (mv status left fn-bpc-node))))
        (t
         (if (not (fn-bpcn-children-boundp 'fn-bpc-right fn-bpc-node))
             (mv :controller-unavailable (- fuel 1) fn-bpc-node)
           (stobj-let ((fn-bpc-right (fn-bpcn-children-get 'fn-bpc-right fn-bpc-node (create-fn-bpc-right))))
             (status left fn-bpc-right)
             (fn-bpc-node-replace nonce local-slot (floor physical-segment 2) (- depth 1)
               expected-epoch expected-issued next-current (- fuel 1) fn-bpc-right)
             (mv status left fn-bpc-node))))
))
(defun fn-bpc-current-replace (token expected-epoch expected-issued next-current fuel fn-bp-controller-registry)
  (declare (xargs :stobjs fn-bp-controller-registry :guard (natp fuel)))
  (cond ((not (fn-bpc-tokenp token)) (mv :stale-controller fuel fn-bp-controller-registry))
        ((<= (fn-bpcr-highwater fn-bp-controller-registry) (caddr token))
         (mv :stale-controller fuel fn-bp-controller-registry))
        (t (let ((depth (fn-bpcr-depth fn-bp-controller-registry)))
           (stobj-let ((fn-bpc-node (fn-bpcr-root fn-bp-controller-registry)))
             (status left fn-bpc-node)
             (fn-bpc-node-replace (cadr token) (mod (caddr token) 64)
               (floor (caddr token) 64) depth
               expected-epoch expected-issued next-current fuel fn-bpc-node)
             (mv status left fn-bp-controller-registry))))))

; Internal fixed-segment installation effect. Parent must reserve constructor
; and retained CURRENT debt first and bind a fresh shared issuer nonce.
(defun fn-bpc-segment-install (nonce slot current receipt fn-bpc-segment)
  (declare (xargs :stobjs fn-bpc-segment
                  :guard (and (natp nonce) (natp slot) (< slot 64))))
  (if (fn-bpcs-rowsi slot fn-bpc-segment)
      (mv :controller-busy fn-bpc-segment)
    (let ((fn-bpc-segment
           (update-fn-bpcs-rowsi slot (list nonce :live current receipt nil) fn-bpc-segment)))
      (mv :registered fn-bpc-segment))))

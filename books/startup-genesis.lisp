; Bounded actual startup NAME writer. Only the boot's fresh branch starts it.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "startup-genesis-state")
(include-book "machines-c-groups")
(fn2-book-layer :c)
(defun fn2-genesis-names-next-role (fn2-genesis-names)
 (declare (xargs :stobjs fn2-genesis-names :guard (fn2-genesis-names-wfp fn2-genesis-names)))
 (if (not (< 0 (fn2-genesis-names-rows fn2-genesis-names))) fn2-genesis-names
  (cond ((not (= (fn2-genesis-names-cursor 0 fn2-genesis-names) (fn2-genesis-names-expected 0 fn2-genesis-names)))
         (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names))
        ((= (fn2-genesis-names-role 0 fn2-genesis-names) *fn2-genesis-name-role-principals*)
         (if (and (= (fn2-genesis-names-groups-done 0 fn2-genesis-names) (fn2-genesis-names-group-count fn2-genesis-names))
                  (= (fn2-genesis-names-cursor 0 fn2-genesis-names) (fn2-genesis-names-principal-count fn2-genesis-names))
                  (null (fn2-genesis-names-groups fn2-genesis-names)) (null (fn2-genesis-names-principals fn2-genesis-names)))
             (fn2-genesis-names-put 0 (phase *fn2-genesis-name-phase-complete*)
               (principals-done (fn2-genesis-names-cursor 0 fn2-genesis-names)))
           (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)))
        ((= (fn2-genesis-names-role 0 fn2-genesis-names) *fn2-genesis-name-role-groups*)
         (let ((n (len (fn2-genesis-names-principals fn2-genesis-names))))
          (if (not (unsigned-byte-p 32 n))
              (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)
           (fn2-genesis-names-put 0 (groups-done (fn2-genesis-names-cursor 0 fn2-genesis-names))
             (role *fn2-genesis-name-role-principals*)
             (phase *fn2-genesis-name-phase-opening*) (expected n) (cursor 0)
             (overlay *fn2-none*) (slot *fn2-none*) (gen 0) (base 0)))))
        (t (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)))))
(fn2-genesis-names-preserves fn2-genesis-names-next-role (fn2-genesis-names) :position nil)
(defun fn2-genesis-names-answer (fn2-genesis-names)
 (declare (xargs :stobjs fn2-genesis-names :guard (fn2-genesis-names-wfp fn2-genesis-names)))
 (if (not (< 0 (fn2-genesis-names-rows fn2-genesis-names))) :state
  (cond ((= (fn2-genesis-names-phase 0 fn2-genesis-names) *fn2-genesis-name-phase-complete*)
         (if (fn2-genesis-names-completep fn2-genesis-names) :complete :uncertain))
        ((= (fn2-genesis-names-phase 0 fn2-genesis-names) *fn2-genesis-name-phase-uncertain*) :uncertain)
        (t :more))))
(defun fn2-genesis-names-overlayp (sid b0 fn2-genesis-names fn2-overlays fn2-pool)
 (declare (xargs :stobjs (fn2-genesis-names fn2-overlays fn2-pool) :guard t))
 (and (fn2-genesis-names-wfp fn2-genesis-names) (fn2-overlays-wfp fn2-overlays) (fn2-pool-wfp fn2-pool)
      (< 0 (fn2-genesis-names-rows fn2-genesis-names))
      (let ((o (fn2-genesis-names-overlay 0 fn2-genesis-names)))
       (and (< o (fn2-overlays-rows fn2-overlays))
            (= (fn2-overlays-phase o fn2-overlays) *fn2-overlay-phase-active*)
            (= (fn2-overlays-cov o fn2-overlays) 0) (= (fn2-overlays-batch o fn2-overlays) 0)
            (= (fn2-overlays-seq o fn2-overlays) 0)
            (equal (fn2-overlays-schema o fn2-overlays) sid)
            (= (fn2-overlays-count o fn2-overlays) (fn2-genesis-names-cursor 0 fn2-genesis-names))
            (= (fn2-overlays-slot o fn2-overlays) (fn2-genesis-names-slot 0 fn2-genesis-names))
            (= (fn2-overlays-gen o fn2-overlays) (fn2-genesis-names-gen 0 fn2-genesis-names))
            (equal (fn2-genesis-names-base 0 fn2-genesis-names) b0)
            (= (fn2-overlays-okind o fn2-overlays) *fn2-idc-owner-kind*)
            (= (fn2-overlays-oslot o fn2-overlays) *fn2-idc-owner-slot*)
            (= (fn2-overlays-ogen o fn2-overlays) *fn2-idc-owner-gen*)
            (eq (fn2-pool-workspace-code (fn2-genesis-names-slot 0 fn2-genesis-names)
                  (fn2-genesis-names-gen 0 fn2-genesis-names)
                  *fn2-idc-owner-kind* *fn2-idc-owner-slot* *fn2-idc-owner-gen* fn2-pool) :ok)))))

; This leaf advances one actual role state. No recursive list writer occurs.
(defun fn2-genesis-names-step-children (fn2-genesis-names fn2-id-engine fn2-id-decides fn2-overlays fn2-overlay-index fn2-fields fn2-fc fn2-pool)
 (declare (xargs :stobjs (fn2-genesis-names fn2-id-engine fn2-id-decides fn2-overlays fn2-overlay-index fn2-fields fn2-fc fn2-pool)
  :guard (and (fn2-genesis-names-wfp fn2-genesis-names) (fn2-id-engine-wfp fn2-id-engine)
              (fn2-id-decides-wfp fn2-id-decides) (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index)
              (fn2-fields-wfp fn2-fields) (fn2-fc-wfp fn2-fc) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (< 0 (fn2-genesis-names-rows fn2-genesis-names)))
       (mv :state fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (phase (fn2-genesis-names-phase 0 fn2-genesis-names))
      ((when (= phase *fn2-genesis-name-phase-complete*))
       (if (fn2-genesis-names-completep fn2-genesis-names)
           (mv :complete fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
        (let ((fn2-genesis-names (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)))
         (mv :uncertain fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool))))
      ((when (= phase *fn2-genesis-name-phase-uncertain*))
       (mv :uncertain fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (role (fn2-genesis-names-role 0 fn2-genesis-names))
      (groups (= role *fn2-genesis-name-role-groups*))
      (sid (if groups *fn2-groups-sid* *fn2-principals-sid*))
      (max (if groups *fn2-groups-name-max* *fn2-principals-name-max*))
      (data (fn2-genesis-names-current fn2-genesis-names))
      (expected (fn2-genesis-names-expected 0 fn2-genesis-names))
      (cursor (fn2-genesis-names-cursor 0 fn2-genesis-names))
      ((unless (and (<= cursor expected)
                     (= expected (if groups (fn2-genesis-names-group-count fn2-genesis-names)
                                   (fn2-genesis-names-principal-count fn2-genesis-names)))))
       (let ((fn2-genesis-names (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)))
        (mv :state fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
      ; Preserve empty-role semantics without requiring unused codec rows.
      ((when (and (= phase *fn2-genesis-name-phase-opening*) (= expected 0) (= cursor 0) (null data)))
       (let ((fn2-genesis-names (fn2-genesis-names-next-role fn2-genesis-names)))
        (mv (fn2-genesis-names-answer fn2-genesis-names)
            fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
      ((mv stripe b0) (fn2-idc-stripe 0 (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields))
      ((unless (and (eq stripe :ok) (unsigned-byte-p 32 b0)
                     (member-equal role (list *fn2-genesis-name-role-groups* *fn2-genesis-name-role-principals*))))
       (let ((fn2-genesis-names (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)))
        (mv :state fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool))))
  (cond
   ((= phase *fn2-genesis-name-phase-opening*)
    (b* (((unless (and (posp expected) (= cursor 0) (consp data)))
          (let ((fn2-genesis-names (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)))
           (mv :groups fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
         ((mv code o fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
          (fn2-grp-genesis-open sid expected b0 fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((unless (and (eq code :ok) (unsigned-byte-p 32 o) (< o (fn2-overlays-rows fn2-overlays))))
          (let ((fn2-genesis-names (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)))
           (mv (if (eq code :ok) :state code) fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
         (fn2-genesis-names (fn2-genesis-names-put 0 (phase *fn2-genesis-name-phase-inserting*)
           (overlay o) (slot (fn2-overlays-slot o fn2-overlays)) (gen (fn2-overlays-gen o fn2-overlays)) (base b0))))
     (mv :more fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
   ((= phase *fn2-genesis-name-phase-inserting*)
    (b* (((unless (and (< cursor expected) (consp data) (consp (car data))
                       (fn2-genesis-names-overlayp sid b0 fn2-genesis-names fn2-overlays fn2-pool)))
          (let ((fn2-genesis-names (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)))
           (mv :state fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
         ((mv code fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
          (fn2-grp-insert-one max (caar data) (cdar data) (fn2-genesis-names-overlay 0 fn2-genesis-names)
            b0 (+ b0 *fn2-idc-eb*) fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((unless (eq code :ok))
          (let ((fn2-genesis-names (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)))
           (mv code fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
         (fn2-genesis-names (if groups (update-fn2-genesis-names-groups (cdr data) fn2-genesis-names)
                              (update-fn2-genesis-names-principals (cdr data) fn2-genesis-names)))
         (fn2-genesis-names (fn2-genesis-names-put 0 (cursor (+ 1 cursor))
           (phase (if (= (+ 1 cursor) expected) *fn2-genesis-name-phase-closing* *fn2-genesis-name-phase-inserting*)))))
     (mv :more fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
   ((= phase *fn2-genesis-name-phase-closing*)
    (b* (((unless (and (posp expected) (= cursor expected) (null data)
                       (fn2-genesis-names-overlayp sid b0 fn2-genesis-names fn2-overlays fn2-pool)))
          (let ((fn2-genesis-names (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)))
           (mv :state fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
         ((mv code fn2-id-engine fn2-overlays)
          (fn2-grp-genesis-close (fn2-genesis-names-overlay 0 fn2-genesis-names) expected fn2-id-engine fn2-overlays))
         ((unless (eq code :ok))
          (let ((fn2-genesis-names (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)))
           (mv code fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
         (fn2-genesis-names (fn2-genesis-names-next-role fn2-genesis-names)))
     (mv (fn2-genesis-names-answer fn2-genesis-names)
         fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
   (t (let ((fn2-genesis-names (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)))
       (mv :state fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool))))))
(fn2-genesis-names-preserves fn2-genesis-names-step-children
 (fn2-genesis-names fn2-id-engine fn2-id-decides fn2-overlays fn2-overlay-index fn2-fields fn2-fc fn2-pool)
 :carriers ((fn2-genesis-names 1 :prefix "-NAMES") (fn2-id-engine 2 :prefix "-ENGINE")
            (fn2-overlays 3 :prefix "-OVERLAYS") (fn2-overlay-index 4 :prefix "-INDEX")
            (fn2-fields 5 :prefix "-FIELDS") (fn2-pool 6 :prefix "-POOL")))

(defmacro fn2-startup-name-events ()
 '(progn
 (defun fn2-startup-name-contextp (id generation phase fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (and (not (fn2-core-stopped-p fn2-core))
       (not (stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core)))
              (closed) (fn2-csnapshot-source-closed-p fn2-csnapshot) closed))
       (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
       (equal (fn2-machine-stopped id fn2-core) 0)
       (equal (fn2-machine-kind id fn2-core) *fn2-boot-kind*)
       (equal (fn2-machine-generation id fn2-core) generation)
       (equal (fn2-machine-phase id fn2-core) phase)))
 (defun fn2-startup-name-begin (id generation fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((unless (and (unsigned-byte-p 32 id) (unsigned-byte-p 60 generation)
                     (fn2-startup-name-contextp id generation *fn2-boot-state-genesis-begin* fn2-core))) (mv :owner fn2-core))
       ((mv captured owner authority)
        (stobj-let ((fn2-genesis-names (fn2-core-genesis-names fn2-core))) (captured owner authority)
         (mv (and (< 0 (fn2-genesis-names-rows fn2-genesis-names))
                  (= (fn2-genesis-names-phase 0 fn2-genesis-names) *fn2-genesis-name-phase-captured*))
             (fn2-genesis-names-owner-slot fn2-genesis-names) (fn2-genesis-names-authority fn2-genesis-names))
         (mv captured owner authority)))
       ((unless captured) (mv :state fn2-core))
       ((mv code ids) (fn2-principals-bound-genesis-ids owner fn2-core))
       ((unless (and (eq code :ok) (alistp ids)
                      (unsigned-byte-p 60 (cdr (assoc-equal "anonymous" ids)))
                      (or (not (assoc-equal "owner" ids))
                          (unsigned-byte-p 60 (cdr (assoc-equal "owner" ids))))))
        (mv :state fn2-core)))
   (stobj-let ((fn2-genesis-names (fn2-core-genesis-names fn2-core))) (fn2-genesis-names)
    (let* ((fn2-genesis-names (update-fn2-genesis-names-principals (if (= authority 1) ids nil) fn2-genesis-names))
           (fn2-genesis-names (fn2-genesis-names-put 0 (phase *fn2-genesis-name-phase-opening*)
            (role *fn2-genesis-name-role-groups*) (kind *fn2-boot-kind*) (owner id) (generation generation)
            (expected (fn2-genesis-names-group-count fn2-genesis-names)) (cursor 0) (groups-done 0) (principals-done 0)
            (overlay *fn2-none*) (slot *fn2-none*) (gen 0) (base 0)
            (anonymous-id (cdr (assoc-equal "anonymous" ids)))
            (owner-id (if (assoc-equal "owner" ids) (cdr (assoc-equal "owner" ids)) 0))
            (have-owner (if (assoc-equal "owner" ids) 1 0))))) fn2-genesis-names)
    (mv :ok fn2-core))))
 (fn2-core-preserves fn2-startup-name-begin (id generation fn2-core) :position 1 :rows nil)
 (defun fn2-startup-name-step (id generation fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((unless (and (unsigned-byte-p 32 id) (unsigned-byte-p 60 generation)
                     (fn2-startup-name-contextp id generation *fn2-boot-state-genesis-step* fn2-core))) (mv :owner fn2-core))
       ((mv match owner anonymous owner-id have-owner)
        (stobj-let ((fn2-genesis-names (fn2-core-genesis-names fn2-core))) (match owner anonymous owner-id have-owner)
         (if (< 0 (fn2-genesis-names-rows fn2-genesis-names))
             (mv (fn2-genesis-names-ownerp *fn2-boot-kind* id generation fn2-genesis-names)
                 (fn2-genesis-names-owner-slot fn2-genesis-names) (fn2-genesis-names-anonymous-id 0 fn2-genesis-names)
                 (fn2-genesis-names-owner-id 0 fn2-genesis-names) (fn2-genesis-names-have-owner 0 fn2-genesis-names))
           (mv nil 0 0 0 0))
         (mv match owner anonymous owner-id have-owner)))
       ((unless match) (mv :owner fn2-core))
       ((mv code ids) (fn2-principals-bound-genesis-ids owner fn2-core))
       ((unless (and (eq code :ok) (alistp ids) (equal anonymous (cdr (assoc-equal "anonymous" ids)))
                      (equal have-owner (if (assoc-equal "owner" ids) 1 0))
                      (equal owner-id (if (assoc-equal "owner" ids) (cdr (assoc-equal "owner" ids)) 0))))
        (mv :owner fn2-core)))
   (stobj-let ((fn2-genesis-names (fn2-core-genesis-names fn2-core)) (fn2-id-engine (fn2-core-id-engine fn2-core))
               (fn2-id-decides (fn2-core-id-decides fn2-core)) (fn2-overlays (fn2-core-overlays fn2-core))
               (fn2-overlay-index (fn2-core-overlay-index fn2-core)) (fn2-fields (fn2-core-fields fn2-core))
               (fn2-fc (fn2-core-fc fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
    (code fn2-genesis-names fn2-id-engine fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
    (fn2-genesis-names-step-children fn2-genesis-names fn2-id-engine fn2-id-decides fn2-overlays fn2-overlay-index fn2-fields fn2-fc fn2-pool)
    (mv (if (member-eq code '(:more :complete)) code :uncertain) fn2-core))))
 (fn2-core-preserves fn2-startup-name-step (id generation fn2-core) :position 1 :rows nil)
 ))
(defcost fn2-startup-name-begin :answers (:ok :owner :state)
 :tables (fn2-core-genesis-names fn2-core-accounts fn2-core-machines fn2-core-boot fn2-core-control fn2-core-csnapshot)
 :doc "Bind the actual fresh boot actor to its trusted NAME cursor and already-bound account identities.")
(defcost fn2-startup-name-step :answers (:more :complete :owner :uncertain) :bytes 4096
 :tables (fn2-core-genesis-names fn2-core-accounts fn2-core-id-engine fn2-core-id-decides fn2-core-overlays
          fn2-core-overlay-index fn2-core-fields fn2-core-fc fn2-core-pool fn2-core-machines fn2-core-boot fn2-core-control fn2-core-csnapshot)
 :doc "One actual genesis role open, one bounded NAME insert, or one exact count/sequence/freeze close.")

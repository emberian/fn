; Bounded retained executor root. Phase classification is not ATS authority.
(in-package "ACL2")
(include-book "snapshot-source-token")
(include-book "state-globals")
(defun fn-owner-index-writer-ticket (state)
 (declare (xargs :stobjs state :guard t))
 (if (f-boundp-global 'fn-owner-index-writer-ticket state)
     (f-get-global 'fn-owner-index-writer-ticket state) nil))
(defun fn-iwt-idlep (ticket)
 (declare (xargs :guard t))
 (or (null ticket)
     (and (fn-omk-widthp ticket 12)
          (eq (fn-omk-at 0 ticket) :index-writer-ticket)
          (eq (fn-omk-at 1 ticket) :finished))))

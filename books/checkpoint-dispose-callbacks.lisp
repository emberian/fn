; Only the real singleton master phase supplies subject and debt generation.
; These faces do no I/O and never cancel an accepted/uncertain member.
(in-package "ACL2")
(include-book "checkpoint-dispose")
(include-book "checkpoint-child-contracts")
(include-book "core-children")
(fn2-book-layer :c)
(defmacro fn2-checkpoint-dispose-costs ()
 (let ((tables (append '(fn2-core-machines fn2-checkpoint-master-table fn2-checkpoint-writer-table
                        fn2-core-event-build fn2-core-event-read)
                       (fn2-checkpoint-root1-child-tables *fn2-checkpoint-dispose-children*))))
 `(progn
   (defcost fn2-checkpoint-dispose-begin-op :answers (:ok :resume :held :state) :bytes 256
    :tables ,tables :doc "Derive the retained subject from the actual terminal master and close candidate admission before any claim withdrawal.")
   (defcost fn2-checkpoint-dispose-step-op :answers t :bytes 4096
    :tables ,tables :doc "Advance one actual terminal claim/ref/byte under its captured debt generation and all live holder vetoes; never physical FREE."))))
(fn2-checkpoint-dispose-costs)

(defmacro fn2-checkpoint-dispose-events ()
 (let* ((children *fn2-checkpoint-dispose-children*)
        (fields (fn2-checkpoint-root1-child-tables children))
        (bindings (fn2-core-child-bindings (pairlis$ fields (pairlis$ children nil))))
 `(progn
   (defun fn2-checkpoint-dispose-control-held-p (c fn2-core)
    (declare (xargs :stobjs fn2-core :verify-guards nil :guard (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core))))
    (let ((writer (fn2-machine-kind-base *fn2-checkpoint-writer-kind* fn2-core)))
     (or (equal writer *fn2-none*) (not (fn2-machine-idp writer fn2-core))
         (not (eq (fn2-checkpoint-writer-snapshot-read-code writer fn2-core) :ok))
         (and (equal (fn2-checkpoint-writer-row-candidate writer fn2-core) c)
              (not (equal (fn2-machine-phase writer fn2-core) *fn2-checkpoint-writer-state-free*)))
         (stobj-let ((fn2-event-build (fn2-core-event-build fn2-core))
                     (fn2-event-read (fn2-core-event-read fn2-core))
                     (fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core))) (held)
          (or (not (< 0 (fn2-event-build-rows fn2-event-build)))
              (not (< 0 (fn2-event-read-rows fn2-event-read)))
              (not (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication)))
              (not (= (fn2-event-build-phase 0 fn2-event-build) *fn2-event-build-phase-idle*))
              (not (= (fn2-event-read-phase 0 fn2-event-read) *fn2-event-read-phase-idle*))
              (and (equal c (fn2-checkpoint-publication-candidate 0 fn2-checkpoint-publication))
                   (not (member-equal (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication)
                      (list *fn2-checkpoint-publication-phase-idle* *fn2-checkpoint-publication-phase-complete*))))) held)))))
   (defun fn2-checkpoint-dispose-begin-op (id gen fn2-core)
    (declare (xargs :stobjs fn2-core :verify-guards nil :guard (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core))))
    (if (not (and (unsigned-byte-p 32 id) (unsigned-byte-p 60 gen)
                   (not (fn2-core-stopped-p fn2-core))
                   (eq (fn2-checkpoint-master-snapshot-read-code id fn2-core) :ok)
                   (= (fn2-machine-kind id fn2-core) *fn2-checkpoint-master-kind*)
                   (= (fn2-machine-generation id fn2-core) gen)
                   (= (fn2-machine-phase id fn2-core) *fn2-checkpoint-master-state-teardown-dispose-begin*)))
        (mv :state 0 fn2-core)
     (let ((c (fn2-checkpoint-master-row-debt-scan id fn2-core))
           (token (fn2-checkpoint-master-row-token id fn2-core)))
      (if (fn2-checkpoint-dispose-control-held-p c fn2-core) (mv :held 0 fn2-core)
       (stobj-let ,bindings (code generation fn2-checkpoint-teardown-debt fn2-checkpoints)
        (fn2-checkpoint-dispose-begin c token *fn2-checkpoint-master-kind* id gen
         fn2-checkpoint-teardown-debt fn2-checkpoint-bytes fn2-checkpoint-publication fn2-csnapshot fn2-extents
         fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events
         fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control fn2-event-archive fn2-release-evidence-candidates)
        (mv code generation fn2-core))))))
   (fn2-core-preserves fn2-checkpoint-dispose-begin-op (id gen fn2-core) :position 2 :rows nil)
   (defun fn2-checkpoint-dispose-step-op (budget id gen fn2-core)
    (declare (xargs :stobjs fn2-core :verify-guards nil :guard (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core))))
    (if (not (and (unsigned-byte-p 32 id) (unsigned-byte-p 60 gen)
                   (not (fn2-core-stopped-p fn2-core))
                   (eq (fn2-checkpoint-master-snapshot-read-code id fn2-core) :ok)
                   (= (fn2-machine-kind id fn2-core) *fn2-checkpoint-master-kind*)
                   (= (fn2-machine-generation id fn2-core) gen)
                   (= (fn2-machine-phase id fn2-core) *fn2-checkpoint-master-state-teardown-dispose-step*)))
        (mv :state fn2-core)
     (let ((c (fn2-checkpoint-master-row-debt-scan id fn2-core))
           (token (fn2-checkpoint-master-row-token id fn2-core))
           (generation (fn2-checkpoint-master-row-teardown-debt-generation id fn2-core)))
      (if (fn2-checkpoint-dispose-control-held-p c fn2-core) (mv :held fn2-core)
       (stobj-let ,bindings (code ,@*fn2-checkpoint-dispose-outputs*)
        (fn2-checkpoint-dispose-step budget c token *fn2-checkpoint-master-kind* id gen generation *fn2-commit-kind* ,@children)
        (mv code fn2-core))))))
   (fn2-core-preserves fn2-checkpoint-dispose-step-op (budget id gen fn2-core) :position 1 :rows nil))))

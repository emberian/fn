; Policy for one selected pair from a frozen XFNC view. END records every
; selected event. NEXT and its chain stop at the last pair in the page.
(in-package "ACL2")
(include-book "xfnc-view-chain")
(fn2-book-layer :e)

(defun fn2-xfnc-page-pair-action (event requested end next stopped items max-items bytes max-bytes pair room)
 (declare (xargs :guard t))
 (cond
  ((not (and (posp event) (unsigned-byte-p 60 event)
             (unsigned-byte-p 60 requested) (unsigned-byte-p 60 end)
             (unsigned-byte-p 60 next) (<= next end) (< end event)
             (unsigned-byte-p 32 items) (unsigned-byte-p 32 max-items)
             (unsigned-byte-p 32 bytes) (unsigned-byte-p 32 max-bytes)
             (posp pair) (unsigned-byte-p 32 pair)
             (member-eq stopped '(:none :item-limit :octet-limit))))
   (mv :state stopped))
  ((<= event requested) (mv :prefix stopped))
  ; Ascending selected positions have passed a cursor the view never issued.
  ((< next requested) (mv :scope stopped))
  ((not (eq stopped :none)) (mv :frontier stopped))
  ((>= items max-items) (mv :frontier :item-limit))
  ((or (> (+ bytes pair) max-bytes) (not room)) (mv :frontier :octet-limit))
  (t (mv :include stopped))))

(defun fn2-xfnc-page-scan-verdict (requested end next)
 (declare (xargs :guard t))
 (cond ((not (and (unsigned-byte-p 60 requested) (unsigned-byte-p 60 end)
                  (unsigned-byte-p 60 next) (<= next end)))
        :state)
       ((< end requested) :beyond-frontier)
       ((< next requested) :scope)
       (t :ok)))

; Instantiated after the concrete XFNC view and wire pair codec. The caller
; supplies the durable sender revision read by the boot-bound source.
(defmacro fn2-xfnc-read-page-events ()
 '(progn
 (defun fn2-xfnc-page-stop-word (stop)
  (declare (xargs :guard t))
  (cond ((equal stop *fn2-xfnc-page-stop-item-limit*) :item-limit)
        ((equal stop *fn2-xfnc-page-stop-octet-limit*) :octet-limit)
        (t :none)))

 (defun fn2-xfnc-page-stop-code (stop)
  (declare (xargs :guard t))
  (case stop
    (:item-limit *fn2-xfnc-page-stop-item-limit*)
    (:octet-limit *fn2-xfnc-page-stop-octet-limit*)
    (otherwise *fn2-xfnc-page-stop-none*)))

 (defun fn2-xfnc-page-fault-code (reason)
  (declare (xargs :guard t))
  (case reason
    (:scope *fn2-xfnc-page-fault-scope*)
    (:beyond-frontier *fn2-xfnc-page-fault-beyond-frontier*)
    (:access *fn2-xfnc-page-fault-access*)
    (:absent *fn2-xfnc-page-fault-absent*)
    (:dependency *fn2-xfnc-page-fault-dependency*)
    (:uncertain *fn2-xfnc-page-fault-uncertain*)
    (otherwise *fn2-xfnc-page-fault-state*)))

 (fn2-csnapshot-op fn2-xfnc-page-fail (cursor reason) 1
  (let ((fn2-core (fn2-cursor-put-core cursor
                   (peer-page-phase *fn2-xfnc-page-phase-close*)
                   (peer-page-fault (fn2-xfnc-page-fault-code reason)))))
   (mv :more fn2-core)))
 (in-theory (disable fn2-xfnc-page-fail))

 (fn2-csnapshot-op fn2-xfnc-page-seed (cursor conn pid row revision) 1
  (b* (((mv history incarnation) (fn2-core-history-values fn2-core))
       (stream (fn2-cursor-row-peer-stream cursor fn2-core))
       (view (fn2-cursor-row-peer-view cursor fn2-core))
       (slot (fn2-conn-row-tx-slot conn fn2-core))
       ((unless (and (posp revision) (unsigned-byte-p 60 revision))) (mv :state fn2-core))
       ((mv code fn2-core)
        (stobj-let ((fn2-digests (fn2-core-digests fn2-core))
                    (fn2-b3 (fn2-core-b3 fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
         (code fn2-digests fn2-b3)
         (if (and (zp (fn2-pool-fill-value slot fn2-pool))
                  (fn2-xfnc-batch-items-fit-p 0 (fn2-pool-slot-capacity slot fn2-pool)))
             (fn2-xfnc-chain-genesis row history incarnation revision pid stream view
              *fn2-xfnc-evidence-interpretation* fn2-digests fn2-b3)
           (mv :state fn2-digests fn2-b3))
         (mv code fn2-core)))
       ((unless (eq code :ok)) (mv code fn2-core))
       (fn2-core (fn2-cursor-put-core cursor
                    (peer-page-phase *fn2-xfnc-page-phase-scan*) (peer-page-revision revision))))
   (mv :more fn2-core)))
 (in-theory (disable fn2-xfnc-page-seed))

 (fn2-csnapshot-op fn2-xfnc-page-hash-start (cursor row event hlen elen output) 1
  (b* (((mv code fn2-core)
        (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-b3 (fn2-core-b3 fn2-core)))
         (code fn2-digests fn2-b3)
         (fn2-xfnc-chain-item-begin row event hlen elen fn2-digests fn2-b3)
         (mv code fn2-core)))
       ((unless (eq code :ok)) (fn2-xfnc-page-fail cursor code fn2-core))
       (fn2-core (fn2-cursor-put-core cursor
                    (peer-page-phase *fn2-xfnc-page-phase-history*) (peer-page-hashed 0)
                    (peer-page-output (if output 1 0)))))
   (mv :more fn2-core)))
 (in-theory (disable fn2-xfnc-page-hash-start))

 (fn2-csnapshot-op fn2-xfnc-page-hash-span (cursor conn cgen row source sgen start end phase budget) 1
  (b* ((hashed (fn2-cursor-row-peer-page-hashed cursor fn2-core))
       (start (+ (nfix start) (nfix hashed)))
       (left (- (nfix end) start))
       (count (min left (nfix budget) *fn2-commit-unit-bytes*))
       ((unless (and (posp left) (unsigned-byte-p 32 start)
                     (member-equal phase (list *fn2-xfnc-page-phase-evidence*
                                               *fn2-xfnc-page-phase-append* *fn2-xfnc-page-phase-finish*))))
        (fn2-xfnc-page-fail cursor :state fn2-core))
       ((when (zp count)) (mv :more fn2-core))
       ((mv code used fn2-core)
        (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-b3 (fn2-core-b3 fn2-core))
                    (fn2-pool (fn2-core-pool fn2-core))) (code used fn2-digests fn2-b3)
         (fn2-fnct-stream-update row source sgen start count *fn2-conn-kind* conn cgen
                                 fn2-digests fn2-b3 fn2-pool)
         (mv code used fn2-core)))
       (next (+ (nfix hashed) (nfix used)))
       ((unless (and (eq code :ok) (equal used count) (unsigned-byte-p 32 next)))
        (fn2-xfnc-page-fail cursor :state fn2-core))
       (fn2-core (if (equal count left)
                      (fn2-cursor-put-core cursor (peer-page-phase phase) (peer-page-hashed 0))
                    (fn2-cursor-put-core cursor (peer-page-hashed next)))))
   (mv :more fn2-core)))
 (in-theory (disable fn2-xfnc-page-hash-span))

 (fn2-csnapshot-op fn2-xfnc-page-put-pair (cursor conn cgen row source sgen event hs he es ee) 1
  (b* ((tx (fn2-conn-row-tx-slot conn fn2-core)) (tgen (fn2-conn-row-tx-gen conn fn2-core))
       (at (fn2-cursor-row-peer-page-bytes cursor fn2-core))
       (count (+ 1 (fn2-cursor-row-peer-page-count cursor fn2-core)))
       (base (* 128 (nfix row)))
       ((unless (unsigned-byte-p 32 count)) (fn2-xfnc-page-fail cursor :state fn2-core))
       ((mv code next fn2-core)
        (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
         (code next fn2-fields fn2-pool)
         (if (and (equal at (fn2-pool-fill-value tx fn2-pool))
                  (<= (+ base 128) (fn2-fields-rows fn2-fields)))
             (fn2-xfnc-put-batch-item base source sgen hs he es ee event tx tgen at
                                      *fn2-conn-kind* conn cgen fn2-fields fn2-pool)
           (mv :state at fn2-fields fn2-pool))
         (mv code next fn2-core)))
       ((unless (and (eq code :ok) (unsigned-byte-p 32 next) (< at next)))
        (fn2-xfnc-page-fail cursor code fn2-core))
       (fn2-core (fn2-cursor-put-core cursor (peer-page-phase *fn2-xfnc-page-phase-finish*)
                   (peer-page-count count) (peer-page-bytes next))))
   (mv :more fn2-core)))
 (in-theory (disable fn2-xfnc-page-put-pair))

 (fn2-csnapshot-op fn2-xfnc-page-advance (cursor conn cgen event next stop) 1
  (b* (((unless (and (posp event) (unsigned-byte-p 60 event) (unsigned-byte-p 60 next)))
        (fn2-xfnc-page-fail cursor :state fn2-core))
       ((mv code fn2-core) (fn2-xfnc-reader-advance conn cgen fn2-core))
       ((unless (eq code :more)) (fn2-xfnc-page-fail cursor code fn2-core))
       (fn2-core (fn2-cursor-put-core cursor (peer-page-end event) (peer-page-next next)
                    (peer-page-stop (fn2-xfnc-page-stop-code stop))
                    (peer-page-phase *fn2-xfnc-page-phase-scan*))))
   (mv :more fn2-core)))
 (in-theory (disable fn2-xfnc-page-advance))

 (fn2-csnapshot-op fn2-xfnc-page-finish-pair (cursor conn cgen row event) 1
  (b* (((mv code fn2-core)
        (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-b3 (fn2-core-b3 fn2-core)))
         (code fn2-digests)
         (fn2-xfnc-chain-item-finish row fn2-digests fn2-b3)
         (mv code fn2-core)))
       ((unless (eq code :ok)) (fn2-xfnc-page-fail cursor code fn2-core)))
   (fn2-xfnc-page-advance cursor conn cgen event event :none fn2-core)))
 (in-theory (disable fn2-xfnc-page-finish-pair))

 (fn2-csnapshot-op fn2-xfnc-page-close (cursor generation conn cgen) 1
  (b* (((mv closed fn2-core) (fn2-xfnc-close-view cursor generation fn2-core))
       ((when (member-eq closed '(:more :drain :stopped))) (mv closed fn2-core))
       (fault (fn2-cursor-row-peer-page-fault cursor fn2-core))
       ((when (and (equal fault *fn2-xfnc-page-fault-none*) (eq closed :done)))
        (let ((fn2-core (fn2-cursor-put-core cursor (peer-page-phase *fn2-xfnc-page-phase-confirm*))))
         (mv :more fn2-core)))
       ((mv reset fn2-core)
        (fn2-core-reset (fn2-conn-row-tx-slot conn fn2-core) (fn2-conn-row-tx-gen conn fn2-core)
                        *fn2-conn-kind* conn cgen fn2-core))
       ((unless (eq reset :ok)) (mv reset fn2-core)))
   (mv (cond ((equal fault *fn2-xfnc-page-fault-scope*) :scope)
             ((equal fault *fn2-xfnc-page-fault-beyond-frontier*) :beyond-frontier)
             ((equal fault *fn2-xfnc-page-fault-access*) :access)
             ((equal fault *fn2-xfnc-page-fault-absent*) :absent)
             ((equal fault *fn2-xfnc-page-fault-dependency*) :dependency)
             ((equal fault *fn2-xfnc-page-fault-uncertain*) :uncertain)
             (t :state))
       fn2-core)))
 (in-theory (disable fn2-xfnc-page-close))

 (fn2-csnapshot-op fn2-xfnc-page-scan (cursor generation conn cgen row budget) 1
  (b* ((stream (fn2-cursor-row-peer-stream cursor fn2-core))
       ((mv code & & & & fn2-core) (fn2-xfnc-peer-read-turn cursor generation stream budget fn2-core))
       ((when (member-eq code '(:more :wait :busy :exhausted :drain :stopped))) (mv code fn2-core))
       (requested (fn2-cursor-row-peer-position cursor fn2-core))
       (end (fn2-cursor-row-peer-page-end cursor fn2-core))
       (next (fn2-cursor-row-peer-page-next cursor fn2-core))
       ((when (member-eq code '(:empty :complete)))
        (let ((verdict (fn2-xfnc-page-scan-verdict requested end next)))
         (if (eq verdict :ok)
             (let ((fn2-core (fn2-cursor-put-core cursor (peer-page-phase *fn2-xfnc-page-phase-close*))))
              (mv :more fn2-core))
           (fn2-xfnc-page-fail cursor verdict fn2-core))))
       ((unless (eq code :item)) (fn2-xfnc-page-fail cursor code fn2-core))
       (token (fn2-xfnc-reader-project-token conn cgen fn2-core))
       ((mv source & & event hs he es ee) (fn2-xfnc-projected-window token conn cgen fn2-core))
       ((unless (eq source :ok)) (fn2-xfnc-page-fail cursor source fn2-core))
       (pair (fn2-xfnc-batch-pair-size hs he es ee))
       (bytes (fn2-cursor-row-peer-page-bytes cursor fn2-core))
       (tx (fn2-conn-row-tx-slot conn fn2-core))
       (cap (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (cap)
             (fn2-pool-slot-capacity tx fn2-pool) cap))
       ((mv action stop)
        (fn2-xfnc-page-pair-action event requested end next
          (fn2-xfnc-page-stop-word (fn2-cursor-row-peer-page-stop cursor fn2-core))
          (fn2-cursor-row-peer-page-count cursor fn2-core) (fn2-cursor-row-peer-items cursor fn2-core)
          bytes (fn2-cursor-row-peer-octets cursor fn2-core) pair
          (fn2-xfnc-batch-items-fit-p (+ bytes (nfix pair)) cap))))
   (case action
    (:frontier (fn2-xfnc-page-advance cursor conn cgen event next stop fn2-core))
    ((:prefix :include) (fn2-xfnc-page-hash-start cursor row event (- (nfix he) (nfix hs)) (- (nfix ee) (nfix es))
                                                (eq action :include) fn2-core))
    (otherwise (fn2-xfnc-page-fail cursor action fn2-core)))))
 (in-theory (disable fn2-xfnc-page-scan))

 (fn2-csnapshot-op fn2-xfnc-read-page-turn (cursor generation revision budget) 1
  (b* (((unless (fn2-xfnc-linked-request-p cursor generation fn2-core)) (mv :state fn2-core))
       (conn (fn2-cursor-row-conn cursor fn2-core))
       (cgen (fn2-cursor-row-conn-gen cursor fn2-core))
       (phase (fn2-cursor-row-peer-page-phase cursor fn2-core))
       ((when (equal phase *fn2-xfnc-page-phase-close*))
        (fn2-xfnc-page-close cursor generation conn cgen fn2-core))
       ((mv login pid & &) (fn2-xfnc-live-login cursor generation fn2-core))
       ((unless (eq login :ok)) (fn2-xfnc-page-fail cursor :access fn2-core))
       ((mv workspace row) (fn2-xfnc-fc-row conn fn2-core))
       ((unless (eq workspace :ok)) (fn2-xfnc-page-fail cursor workspace fn2-core))
       ((when (equal phase *fn2-xfnc-page-phase-start*))
        (fn2-xfnc-page-seed cursor conn pid row revision fn2-core))
       ((unless (equal revision (fn2-cursor-row-peer-page-revision cursor fn2-core)))
        (fn2-xfnc-page-fail cursor :scope fn2-core))
       ((when (equal phase *fn2-xfnc-page-phase-ready*)) (mv :ready fn2-core))
       (budget (min (nfix budget) *fn2-commit-unit-bytes*))
       ((when (equal phase *fn2-xfnc-page-phase-confirm*))
        (b* (((mv rights current head fn2-core)
              (fn2-xfnc-read-rights cursor generation (fn2-cursor-row-peer-stream cursor fn2-core) budget fn2-core))
             ((when (eq rights :more)) (mv :more fn2-core))
             ((unless (and (eq rights :ok) (equal current pid) (equal head (fn2-cursor-row-peer-head cursor fn2-core))))
              (fn2-xfnc-page-fail cursor (if (eq rights :ok) :access rights) fn2-core))
             (fn2-core (fn2-cursor-put-core cursor (peer-page-phase *fn2-xfnc-page-phase-ready*))))
         (mv :ready fn2-core)))
       ((when (equal phase *fn2-xfnc-page-phase-scan*))
        (fn2-xfnc-page-scan cursor generation conn cgen row budget fn2-core))
       (token (fn2-xfnc-reader-project-token conn cgen fn2-core))
       ((mv code source sgen event hs he es ee) (fn2-xfnc-projected-window token conn cgen fn2-core))
       ((unless (eq code :ok)) (fn2-xfnc-page-fail cursor code fn2-core)))
   (cond
    ((equal phase *fn2-xfnc-page-phase-history*)
     (fn2-xfnc-page-hash-span cursor conn cgen row source sgen hs he *fn2-xfnc-page-phase-evidence* budget fn2-core))
    ((equal phase *fn2-xfnc-page-phase-evidence*)
     (fn2-xfnc-page-hash-span cursor conn cgen row source sgen es ee
       (if (equal (fn2-cursor-row-peer-page-output cursor fn2-core) 1)
           *fn2-xfnc-page-phase-append* *fn2-xfnc-page-phase-finish*) budget fn2-core))
    ((equal phase *fn2-xfnc-page-phase-append*)
     (fn2-xfnc-page-put-pair cursor conn cgen row source sgen event hs he es ee fn2-core))
    ((equal phase *fn2-xfnc-page-phase-finish*)
     (fn2-xfnc-page-finish-pair cursor conn cgen row event fn2-core))
    (t (fn2-xfnc-page-fail cursor :state fn2-core)))))
 (in-theory (disable fn2-xfnc-read-page-turn))))

(defcost fn2-xfnc-read-page-turn :answers t :bytes 4096 :descriptors 1
 :tables (fn2-core-reads fn2-core-ranges fn2-core-seeks fn2-core-run-cursors fn2-core-run-paths
          fn2-core-csnapshot fn2-core-journal-lease fn2-core-event-read fn2-core-journal-members
          fn2-core-commit-root fn2-core-extents fn2-core-alloc-edges fn2-core-ops fn2-core-control
          fn2-core-mk fn2-core-b3 fn2-core-fc fn2-core-fc-context fn2-core-fields fn2-core-digests
          fn2-core-pool fn2-cursor-table)
 :doc "Build one bounded portion of a protected peer history page and drain its exact retained cut.")

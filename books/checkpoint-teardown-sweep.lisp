; One actual maintenance actor sweeps every retained candidate after a real
; bank/protection change. Notifications never replace the permission checks.
(in-package "ACL2")
(include-book "checkpoint-teardown-transfer")
(include-book "checkpoint-dispose-owner")
(include-book "checkpoint-bank-obligations-state")
(fn2-book-layer :c)
; Fixed protocol roles, bounded32-field exact comparison/copy. A protection
; change during this whole sweep remains latched for another whole sweep.
(defun fn2-checkpoint-teardown-bank-fields-samep (i fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil :measure (nfix (- 32 (nfix i)))
  :guard (and (natp i) (<= i 32) (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)))))
 (or (>= (nfix i) 32)
     (and (equal (fn2-checkpoint-teardown-debt-observedi i fn2-checkpoint-teardown-debt)
                 (fn2-checkpoint-bank-obligations-observe i fn2-checkpoint-publication))
          (fn2-checkpoint-teardown-bank-fields-samep (+ 1 i) fn2-checkpoint-teardown-debt fn2-checkpoint-publication))))
(defun fn2-checkpoint-teardown-banks-samep (fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil
  :guard (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (fn2-checkpoint-teardown-bank-fields-samep 0 fn2-checkpoint-teardown-debt fn2-checkpoint-publication))
(defun fn2-checkpoint-teardown-bank-fields-observe (i fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil :measure (nfix (- 32 (nfix i)))
  :guard (and (natp i) (<= i 32) (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)))))
 (if (>= (nfix i) 32) fn2-checkpoint-teardown-debt
  (let ((fn2-checkpoint-teardown-debt (update-fn2-checkpoint-teardown-debt-observedi i
         (fn2-checkpoint-bank-obligations-observe i fn2-checkpoint-publication) fn2-checkpoint-teardown-debt)))
   (fn2-checkpoint-teardown-bank-fields-observe (+ 1 i) fn2-checkpoint-teardown-debt fn2-checkpoint-publication))))
(defun fn2-checkpoint-teardown-banks-observe (fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil
  :guard (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (fn2-checkpoint-teardown-bank-fields-observe 0 fn2-checkpoint-teardown-debt fn2-checkpoint-publication))
(defun fn2-checkpoint-teardown-needed (fn2-checkpoint-teardown-debt fn2-checkpoint-publication fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication fn2-extents) :verify-guards nil
  :guard (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication) (fn2-extents-wfp fn2-extents))))
 (mv :ok (or (= (fn2-alloc-orphan-dirty fn2-extents) 1)
              (and (< 0 (fn2-checkpoint-teardown-debt-count fn2-checkpoint-teardown-debt))
              (or (equal (fn2-checkpoint-teardown-debt-notified fn2-checkpoint-teardown-debt) 1)
                  (equal (fn2-alloc-protection-dirty fn2-extents) 1)
                  (not (fn2-checkpoint-teardown-banks-samep fn2-checkpoint-teardown-debt fn2-checkpoint-publication)))))))
(defcost fn2-checkpoint-teardown-needed-op :child fn2-checkpoint-teardown-needed :answers (:ok)
 :doc "Constant-work notification from actual complete debt transfer, bank exclusion tuple change or actual allocator protector-count mutation.")

(defun fn2-checkpoint-teardown-select (scan kind owner gen fn2-checkpoint-teardown-debt fn2-checkpoints fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoints fn2-checkpoint-bytes) :verify-guards nil
  :guard (and (fn2-checkpoint-teardown-debtp fn2-checkpoint-teardown-debt) (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-bytesp fn2-checkpoint-bytes) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes))))
 (cond ((not (unsigned-byte-p 32 scan)) (mv :state scan 0 0 0 0 0 0 0))
       ((>= scan (fn2-checkpoint-teardown-debt-rows fn2-checkpoint-teardown-debt)) (mv :done scan 0 0 0 0 0 0 0))
       ((equal (fn2-checkpoint-teardown-debt-phase scan fn2-checkpoint-teardown-debt) *fn2-checkpoint-teardown-debt-phase-empty*)
        (mv :more (+ 1 scan) 0 0 0 0 0 0 0))
       ((not (member-equal (fn2-checkpoint-teardown-debt-phase scan fn2-checkpoint-teardown-debt)
              (list *fn2-checkpoint-teardown-debt-phase-held* *fn2-checkpoint-teardown-debt-phase-drop*)))
        ; A WAITING/ambiguous member is never a new source scan or resubmission.
        (mv :state scan 0 0 0 0 0 0 0))
       ((and (= (fn2-checkpoints-state scan fn2-checkpoints) *fn2-checkpoint-state-disposing*)
             (fn2-checkpoint-dispose-current-p scan (fn2-checkpoint-teardown-debt-token scan fn2-checkpoint-teardown-debt)
               kind owner gen (fn2-checkpoint-teardown-debt-generation scan fn2-checkpoint-teardown-debt)
               fn2-checkpoint-teardown-debt fn2-checkpoints fn2-checkpoint-bytes))
        (mv :dispose scan (fn2-checkpoint-teardown-debt-token scan fn2-checkpoint-teardown-debt) 0 0 0 0 0
            (fn2-checkpoint-teardown-debt-phase scan fn2-checkpoint-teardown-debt)))
       ((not (fn2-checkpoint-teardown-admission-ownerp scan (fn2-checkpoint-teardown-debt-token scan fn2-checkpoint-teardown-debt) kind owner gen fn2-checkpoint-teardown-debt fn2-checkpoints fn2-checkpoint-bytes))
        (mv :state scan 0 0 0 0 0 0 0))
       (t (mv (if (equal (fn2-checkpoint-teardown-debt-phase scan fn2-checkpoint-teardown-debt) *fn2-checkpoint-teardown-debt-phase-drop*) :drop :source)
              scan (fn2-checkpoint-teardown-debt-token scan fn2-checkpoint-teardown-debt)
              (fn2-checkpoint-teardown-debt-extent scan fn2-checkpoint-teardown-debt)
              (fn2-checkpoint-teardown-debt-epoch scan fn2-checkpoint-teardown-debt)
              (fn2-checkpoint-teardown-debt-allocation scan fn2-checkpoint-teardown-debt)
              (fn2-checkpoint-teardown-debt-batch scan fn2-checkpoint-teardown-debt)
              (fn2-checkpoint-teardown-debt-event scan fn2-checkpoint-teardown-debt)
              (fn2-checkpoint-teardown-debt-phase scan fn2-checkpoint-teardown-debt)))))
(defcost fn2-checkpoint-teardown-select-op :child fn2-checkpoint-teardown-select :answers t :bytes 32)
(defcost fn2-checkpoint-teardown-sweep-begin-op :answers (:more :state) :bytes 256
 :tables (fn2-core-checkpoint-teardown-debt fn2-core-extents))
(defcost fn2-checkpoint-teardown-submission-ready-op :answers (:ok))
(defmacro fn2-checkpoint-teardown-sweep-events ()
 '(progn
  (defun fn2-checkpoint-teardown-sweep-begin-op (id gen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (and (eq (fn2-checkpoint-master-snapshot-read-code id fn2-core) :ok)
                  (equal (fn2-machine-kind id fn2-core) *fn2-checkpoint-master-kind*)
                  (equal (fn2-machine-generation id fn2-core) gen)
                  (equal (fn2-machine-phase id fn2-core) *fn2-checkpoint-master-state-idle*)
                  (not (fn2-core-stopped-p fn2-core)))) (mv :state fn2-core)
    (stobj-let ((fn2-checkpoint-teardown-debt (fn2-core-checkpoint-teardown-debt fn2-core))
                (fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core))
                (fn2-extents (fn2-core-extents fn2-core))) (code fn2-checkpoint-teardown-debt fn2-extents)
     (if (not (mv-nth 1 (fn2-checkpoint-teardown-needed fn2-checkpoint-teardown-debt fn2-checkpoint-publication fn2-extents)))
         (mv :state fn2-checkpoint-teardown-debt fn2-extents)
      ; Clear once for the WHOLE candidate/extent sweep. Changes during any
      ; later candidate's turn relatch and request another complete sweep.
      (let* ((fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-banks-observe fn2-checkpoint-teardown-debt fn2-checkpoint-publication))
             (fn2-checkpoint-teardown-debt (update-fn2-checkpoint-teardown-debt-notified 0 fn2-checkpoint-teardown-debt))
             (fn2-extents (update-fn2-alloc-protection-dirty 0 fn2-extents)))
       (mv :more fn2-checkpoint-teardown-debt fn2-extents)))
     (mv code fn2-core))))
  (fn2-core-preserves fn2-checkpoint-teardown-sweep-begin-op (id gen fn2-core) :position 1 :rows nil)
  (defun fn2-checkpoint-teardown-submission-ready-op (fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (mv-let (pick id partner) (fn2-commit-pick fn2-core)
    (declare (ignore id partner))
    (mv :ok (and (not (fn2-core-stopped-p fn2-core)) (not (fn2-storage-checkpoint-active fn2-core))
                 (not (eq pick :exhausted)) (fn2-commit-settled-room 1 fn2-core)
     (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (ready)
      (let ((class (fn2-pool-class-for *fn2-checkpoint-teardown-member-bytes* fn2-pool)))
       (and (< 0 (fn2-retirement-control-rows fn2-retirement-control))
            (equal (fn2-retirement-control-state 0 fn2-retirement-control) *fn2-retirement-state-idle*)
            (natp class) (< class (fn2-pool-nclasses fn2-pool)) (< 0 (fn2-pool-free-count class fn2-pool)))) ready)))))))

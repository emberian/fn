; Recovery's LIVE identity index over the actual allocator. This does not
; authenticate records, grant a release cut, or remember discarded history.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "alloc")
(fn2-book-layer :b)
(make-event (cons 'progn (fn2-columns-enum-events
 '((phase (:enum fn2-alloc-identity-phase (:idle :clearing :probe :ready :refused)))
   (bucket (:enum fn2-alloc-identity-bucket (:empty :used :tombstone)))
   (op (:enum fn2-alloc-identity-op (:none :adopt :free :check :insert)))))))

(defun fn2-alloc-identity-bindings (fields)
 (declare (xargs :verify-guards nil))
 (if (atom fields) nil
  (cons `(fn2-extents (,(fn2-columns-pre "UPDATE-" (fn2-columns-pre "FN2-ALLOC-IDENTITY-" (caar fields))) ,(cadar fields) fn2-extents))
        (fn2-alloc-identity-bindings (cdr fields)))))
(defmacro fn2-alloc-identity-put (&rest fields)
 `(let* ,(fn2-alloc-identity-bindings fields) fn2-extents))

(defun fn2-alloc-identity-geometry-p (fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (let ((n (fn2-extents-rows fn2-extents)))
  (and (<= n *fn2-alloc-none*)
       (= n (fn2-alloc-identity-states-length fn2-extents))
       (= n (fn2-alloc-identity-epochs-length fn2-extents))
       (= n (fn2-alloc-identity-counters-length fn2-extents))
       (= n (fn2-alloc-identity-extents-length fn2-extents)))))
(defun fn2-alloc-identity-owner-p (kind owner ogen source fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (and (unsigned-byte-p 8 kind) (unsigned-byte-p 32 owner)
      (posp ogen) (unsigned-byte-p 60 ogen) (posp source) (unsigned-byte-p 60 source)
      (= (fn2-alloc-identity-active fn2-extents) 1)
      (equal kind (fn2-alloc-identity-owner-kind fn2-extents))
      (equal owner (fn2-alloc-identity-owner-slot fn2-extents))
      (equal ogen (fn2-alloc-identity-owner-gen fn2-extents))
      (equal source (fn2-alloc-identity-source-generation fn2-extents))))
(defun fn2-alloc-identity-home (epoch counter n)
 (declare (xargs :guard (and (unsigned-byte-p 60 epoch) (unsigned-byte-p 60 counter) (natp n))))
 (if (zp n) 0 (mod (logxor epoch counter) n)))

(defun fn2-alloc-identity-begin (kind owner ogen source fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (if (not (and (fn2-alloc-identity-geometry-p fn2-extents)
               (unsigned-byte-p 8 kind) (unsigned-byte-p 32 owner)
               (posp ogen) (unsigned-byte-p 60 ogen) (posp source) (unsigned-byte-p 60 source)
               (= (fn2-alloc-identity-active fn2-extents) 0)
               (member-equal (fn2-alloc-freeze-phase fn2-extents) '(0 4))
               (= (fn2-alloc-retirement-intent-batch fn2-extents) 0)
               (= (fn2-alloc-epoch-begun fn2-extents) 0)
               (= (fn2-alloc-total-free fn2-extents) (fn2-extents-rows fn2-extents))
               (= (fn2-alloc-total-reserved fn2-extents) 0) (= (fn2-alloc-total-allocated fn2-extents) 0)
               (= (fn2-alloc-total-retired fn2-extents) 0)))
  (mv :state fn2-extents)
  (let ((fn2-extents (fn2-alloc-identity-put (active 1) (phase *fn2-alloc-identity-phase-clearing*)
         (owner-kind kind) (owner-slot owner) (owner-gen ogen) (source-generation source)
         (op *fn2-alloc-identity-op-none*) (probe 0) (visited 0) (count 0)
         (tombstone *fn2-alloc-none*) (bucket *fn2-alloc-none*)))) (mv :more fn2-extents))))
(defun fn2-alloc-identity-clear-step (kind owner ogen source fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (b* (((unless (and (fn2-alloc-identity-owner-p kind owner ogen source fn2-extents)
                    (fn2-alloc-identity-geometry-p fn2-extents)
                    (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-clearing*))) (mv :owner fn2-extents))
      (at (fn2-alloc-identity-probe fn2-extents)) (n (fn2-extents-rows fn2-extents))
      ((unless (<= at n)) (mv :cursor fn2-extents))
      (fn2-extents (if (< at n) (update-fn2-alloc-identity-statesi at *fn2-alloc-identity-bucket-empty* fn2-extents) fn2-extents))
      (next (if (< at n) (+ 1 at) at))
      (done (= next n))
      (fn2-extents (fn2-alloc-identity-put (probe next)
       (phase (if done *fn2-alloc-identity-phase-idle* *fn2-alloc-identity-phase-clearing*)))))
  (mv (if done :active :more) fn2-extents)))

; The caller binds NEW to the actual launched child. SOURCE never changes;
; an outstanding lookup cannot be delegated or retargeted to another record.
(defun fn2-alloc-identity-transfer (kind owner ogen source new-kind new-owner new-gen fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (if (not (and (fn2-alloc-identity-owner-p kind owner ogen source fn2-extents)
               (fn2-alloc-identity-geometry-p fn2-extents)
               (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-idle*)
               (= (fn2-alloc-identity-op fn2-extents) *fn2-alloc-identity-op-none*)
               (unsigned-byte-p 8 new-kind) (unsigned-byte-p 32 new-owner)
               (posp new-gen) (unsigned-byte-p 60 new-gen))) (mv :owner fn2-extents)
  (let ((fn2-extents (fn2-alloc-identity-put (owner-kind new-kind) (owner-slot new-owner) (owner-gen new-gen))))
   (mv :ok fn2-extents))))

; Private terminal handoff. The actual post-Fence finalizer establishes all
; recovery/source/lease obligations and calls this immediately before ordinary
; begin-epoch in the same nonyielding arm. This is not a served disable face.
(defun fn2-alloc-identity-end (kind owner ogen source fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (if (not (and (fn2-alloc-identity-owner-p kind owner ogen source fn2-extents)
               (fn2-alloc-identity-geometry-p fn2-extents)
               (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-idle*)
               (= (fn2-alloc-identity-op fn2-extents) *fn2-alloc-identity-op-none*)))
  (mv :owner fn2-extents)
  (let ((fn2-extents (update-fn2-alloc-identity-active 0 fn2-extents))) (mv :ok fn2-extents))))

; Pending lookup binds OLD actual row and exact NEW tuple. No row is changed
; by prepare/probe; publication and the original transition are one step.
(defun fn2-alloc-identity-prepare (kind owner ogen source op i previous state epoch counter cut fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (b* (((unless (and (fn2-alloc-identity-owner-p kind owner ogen source fn2-extents)
                    (fn2-alloc-identity-geometry-p fn2-extents)
                    (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-idle*))) (mv :owner fn2-extents))
      ((unless (and (fn2-alloc-slotp i fn2-extents) (unsigned-byte-p 32 previous)
                    (unsigned-byte-p 60 epoch) (unsigned-byte-p 60 counter) (unsigned-byte-p 60 cut)
                    (member-equal op (list *fn2-alloc-identity-op-adopt* *fn2-alloc-identity-op-free*
                                          *fn2-alloc-identity-op-check* *fn2-alloc-identity-op-insert*)))) (mv :bounds fn2-extents))
      (old (fn2-extents-state i fn2-extents)) (oe (fn2-extents-epoch i fn2-extents)) (oc (fn2-extents-counter i fn2-extents))
      (insert (member-equal op (list *fn2-alloc-identity-op-adopt* *fn2-alloc-identity-op-insert*)))
      ((unless (if insert
        (and (= old *fn2-extent-state-free*)
             (if (= op *fn2-alloc-identity-op-adopt*) (equal state *fn2-extent-state-reserved*)
              (member-equal state (list *fn2-extent-state-reserved* *fn2-extent-state-allocated* *fn2-extent-state-retire-pending*))))
        (and (not (= old *fn2-extent-state-free*)) (= epoch oe) (= counter oc)))) (mv :state fn2-extents))
      (ns (cond (insert state) ((= op *fn2-alloc-identity-op-free*) *fn2-extent-state-free*) (t old)))
      (fn2-extents (fn2-alloc-identity-put (phase *fn2-alloc-identity-phase-probe*) (op op) (extent i) (previous previous)
       (old-state old) (old-epoch oe) (old-counter oc) (new-state ns)
       (new-epoch (if (= op *fn2-alloc-identity-op-free*) 0 epoch))
       (new-counter (if (= op *fn2-alloc-identity-op-free*) 0 counter)) (cut cut)
       (probe (fn2-alloc-identity-home epoch counter (fn2-extents-rows fn2-extents))) (visited 0)
       (tombstone *fn2-alloc-none*) (bucket *fn2-alloc-none*))))
  (mv :more fn2-extents)))
(defmacro fn2-alloc-identity-prepare-faces ()
 `(progn
   (defun fn2-alloc-identity-prepare-adopt (kind owner ogen source i previous epoch counter fn2-extents)
    (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
    (fn2-alloc-identity-prepare kind owner ogen source *fn2-alloc-identity-op-adopt* i previous *fn2-extent-state-reserved* epoch counter 0 fn2-extents))
   (defun fn2-alloc-identity-prepare-insert (kind owner ogen source i state epoch counter fn2-extents)
    (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
    (fn2-alloc-identity-prepare kind owner ogen source *fn2-alloc-identity-op-insert* i *fn2-alloc-none* state epoch counter 0 fn2-extents))
   (defun fn2-alloc-identity-prepare-free (kind owner ogen source i epoch counter cut fn2-extents)
    (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
    (fn2-alloc-identity-prepare kind owner ogen source *fn2-alloc-identity-op-free* i *fn2-alloc-none* *fn2-extent-state-free* epoch counter cut fn2-extents))
   (defun fn2-alloc-identity-prepare-check (kind owner ogen source i epoch counter fn2-extents)
    (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
    (fn2-alloc-identity-prepare kind owner ogen source *fn2-alloc-identity-op-check* i *fn2-alloc-none* *fn2-extent-state-free* epoch counter 0 fn2-extents))))
(fn2-alloc-identity-prepare-faces)

(defun fn2-alloc-identity-pending-current-p (kind owner ogen source fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (and (fn2-alloc-identity-owner-p kind owner ogen source fn2-extents) (fn2-alloc-identity-geometry-p fn2-extents)
      (member-equal (fn2-alloc-identity-phase fn2-extents) (list *fn2-alloc-identity-phase-probe* *fn2-alloc-identity-phase-ready*))
      (let ((i (fn2-alloc-identity-extent fn2-extents)))
       (and (fn2-alloc-slotp i fn2-extents)
            (= (fn2-extents-state i fn2-extents) (fn2-alloc-identity-old-state fn2-extents))
            (= (fn2-extents-epoch i fn2-extents) (fn2-alloc-identity-old-epoch fn2-extents))
            (= (fn2-extents-counter i fn2-extents) (fn2-alloc-identity-old-counter fn2-extents))))))
(defun fn2-alloc-identity-ready (bucket fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (and (fn2-extents-wfp fn2-extents) (unsigned-byte-p 32 bucket))))
 (fn2-alloc-identity-put (bucket bucket) (phase *fn2-alloc-identity-phase-ready*)))

(defun fn2-alloc-identity-step (kind owner ogen source fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (b* (((unless (fn2-alloc-identity-owner-p kind owner ogen source fn2-extents)) (mv :owner fn2-extents))
      ((unless (and (fn2-alloc-identity-pending-current-p kind owner ogen source fn2-extents)
                    (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-probe*))) (mv :changed fn2-extents))
      (n (fn2-extents-rows fn2-extents)) (at (fn2-alloc-identity-probe fn2-extents))
      (seen (fn2-alloc-identity-visited fn2-extents)) (tomb (fn2-alloc-identity-tombstone fn2-extents))
      ((unless (and (< at n) (< seen n))) (mv :cursor fn2-extents))
      (op (fn2-alloc-identity-op fn2-extents))
      (insert (member-equal op (list *fn2-alloc-identity-op-adopt* *fn2-alloc-identity-op-insert*)))
      (epoch (if insert (fn2-alloc-identity-new-epoch fn2-extents) (fn2-alloc-identity-old-epoch fn2-extents)))
      (counter (if insert (fn2-alloc-identity-new-counter fn2-extents) (fn2-alloc-identity-old-counter fn2-extents)))
      (used (fn2-alloc-identity-statesi at fn2-extents))
      ((when (= used *fn2-alloc-identity-bucket-empty*))
       (if insert
        (if (< (fn2-alloc-identity-count fn2-extents) n)
         (let* ((fn2-extents (fn2-alloc-identity-put (visited (+ 1 seen))))
                (fn2-extents (fn2-alloc-identity-ready (if (= tomb *fn2-alloc-none*) at tomb) fn2-extents)))
          (mv :ready fn2-extents)) (mv :full fn2-extents))
        (mv :missing fn2-extents)))
      ((when (and (= used *fn2-alloc-identity-bucket-used*) (= (fn2-alloc-identity-epochsi at fn2-extents) epoch)
                   (= (fn2-alloc-identity-countersi at fn2-extents) counter)))
       (cond ((not (= (fn2-alloc-identity-extentsi at fn2-extents) (fn2-alloc-identity-extent fn2-extents))) (mv :conflict fn2-extents))
             (insert (mv :index fn2-extents))
             (t (let* ((fn2-extents (fn2-alloc-identity-put (visited (+ 1 seen))))
                       (fn2-extents (fn2-alloc-identity-ready at fn2-extents))) (mv :ready fn2-extents)))))
      ((unless (member-equal used (list *fn2-alloc-identity-bucket-used* *fn2-alloc-identity-bucket-tombstone*))) (mv :index fn2-extents))
      (tomb (if (and (= tomb *fn2-alloc-none*) (= used *fn2-alloc-identity-bucket-tombstone*)) at tomb))
      (visited (+ 1 seen)) (next (if (= (+ 1 at) n) 0 (+ 1 at)))
      (fn2-extents (fn2-alloc-identity-put (probe next) (visited visited) (tombstone tomb))))
  (if (< visited n) (mv :more fn2-extents)
   (if (and insert (not (= tomb *fn2-alloc-none*)) (< (fn2-alloc-identity-count fn2-extents) n))
    (let ((fn2-extents (fn2-alloc-identity-ready tomb fn2-extents))) (mv :ready fn2-extents))
    (mv (if insert :full :missing) fn2-extents)))))

(defun fn2-alloc-identity-reusable-p (fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (let ((b (fn2-alloc-identity-bucket fn2-extents)))
  (and (fn2-alloc-identity-geometry-p fn2-extents) (< b (fn2-extents-rows fn2-extents))
       (< (fn2-alloc-identity-count fn2-extents) (fn2-extents-rows fn2-extents))
       (member-equal (fn2-alloc-identity-statesi b fn2-extents)
        (list *fn2-alloc-identity-bucket-empty* *fn2-alloc-identity-bucket-tombstone*)))))
(defun fn2-alloc-identity-insert-ready-p (kind owner ogen source i state epoch counter fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (and (fn2-alloc-identity-pending-current-p kind owner ogen source fn2-extents)
      (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-ready*)
      (= (fn2-alloc-identity-op fn2-extents) *fn2-alloc-identity-op-insert*)
      (= (fn2-alloc-identity-old-state fn2-extents) *fn2-extent-state-free*)
      (equal i (fn2-alloc-identity-extent fn2-extents)) (equal state (fn2-alloc-identity-new-state fn2-extents))
      (equal epoch (fn2-alloc-identity-new-epoch fn2-extents)) (equal counter (fn2-alloc-identity-new-counter fn2-extents))
      (fn2-alloc-identity-reusable-p fn2-extents)))
(defun fn2-alloc-identity-publishable-p (kind owner ogen source fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (and (fn2-alloc-identity-owner-p kind owner ogen source fn2-extents) (fn2-alloc-identity-geometry-p fn2-extents)
      (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-ready*)
      (member-equal (fn2-alloc-identity-op fn2-extents) (list *fn2-alloc-identity-op-insert* *fn2-alloc-identity-op-adopt*))
      (= (fn2-alloc-identity-old-state fn2-extents) *fn2-extent-state-free*)
      (fn2-alloc-identity-reusable-p fn2-extents)
      (let ((i (fn2-alloc-identity-extent fn2-extents)))
       (and (fn2-alloc-slotp i fn2-extents)
            (= (fn2-extents-state i fn2-extents) (fn2-alloc-identity-new-state fn2-extents))
            (not (= (fn2-extents-state i fn2-extents) *fn2-extent-state-free*))
            (= (fn2-extents-epoch i fn2-extents) (fn2-alloc-identity-new-epoch fn2-extents))
            (= (fn2-extents-counter i fn2-extents) (fn2-alloc-identity-new-counter fn2-extents))))))
; Guarded private publication has no soft result after the caller's row put.
(defun fn2-alloc-identity-publish-existing-row (kind owner ogen source fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (and (fn2-extents-wfp fn2-extents)
   (fn2-alloc-identity-publishable-p kind owner ogen source fn2-extents))))
 (if (not (fn2-alloc-identity-publishable-p kind owner ogen source fn2-extents)) fn2-extents
  (b* ((b (fn2-alloc-identity-bucket fn2-extents)) (i (fn2-alloc-identity-extent fn2-extents))
       (fn2-extents (update-fn2-alloc-identity-epochsi b (fn2-alloc-identity-new-epoch fn2-extents) fn2-extents))
       (fn2-extents (update-fn2-alloc-identity-countersi b (fn2-alloc-identity-new-counter fn2-extents) fn2-extents))
       (fn2-extents (update-fn2-alloc-identity-extentsi b i fn2-extents))
       (fn2-extents (update-fn2-alloc-identity-statesi b *fn2-alloc-identity-bucket-used* fn2-extents))
       (fn2-extents (fn2-alloc-identity-put (count (+ 1 (fn2-alloc-identity-count fn2-extents)))
        (phase *fn2-alloc-identity-phase-idle*) (op *fn2-alloc-identity-op-none*)))) fn2-extents)))

(defun fn2-alloc-identity-commit-adopt (kind owner ogen source fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (b* (((unless (and (fn2-alloc-identity-pending-current-p kind owner ogen source fn2-extents)
                    (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-ready*)
                    (= (fn2-alloc-identity-op fn2-extents) *fn2-alloc-identity-op-adopt*)
                    (= (fn2-alloc-identity-old-state fn2-extents) *fn2-extent-state-free*)
                    (= (fn2-alloc-identity-new-state fn2-extents) *fn2-extent-state-reserved*)
                    (fn2-alloc-identity-reusable-p fn2-extents))) (mv :changed fn2-extents))
      ((mv code fn2-extents) (fn2-alloc-adopt-transition (fn2-alloc-identity-extent fn2-extents)
        (fn2-alloc-identity-previous fn2-extents) (fn2-alloc-identity-new-epoch fn2-extents)
        (fn2-alloc-identity-new-counter fn2-extents) fn2-extents))
      ((unless (eq code :ok)) (mv code fn2-extents))
      (fn2-extents (fn2-alloc-identity-publish-existing-row kind owner ogen source fn2-extents))) (mv :ok fn2-extents)))
; Shared replay/full-base continuation. Every resumed call names the exact
; retained subject; a different record cannot consume a READY receipt.
(defun fn2-alloc-identity-adopt-subject-p (i previous epoch counter fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (and (= (fn2-alloc-identity-op fn2-extents) *fn2-alloc-identity-op-adopt*)
      (equal i (fn2-alloc-identity-extent fn2-extents))
      (equal previous (fn2-alloc-identity-previous fn2-extents))
      (equal epoch (fn2-alloc-identity-new-epoch fn2-extents))
      (equal counter (fn2-alloc-identity-new-counter fn2-extents))
      (= (fn2-alloc-identity-old-state fn2-extents) *fn2-extent-state-free*)
      (= (fn2-alloc-identity-new-state fn2-extents) *fn2-extent-state-reserved*)))
(defun fn2-alloc-identity-adopt-progress (kind owner ogen source i previous epoch counter fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (b* (((unless (fn2-alloc-identity-owner-p kind owner ogen source fn2-extents)) (mv :owner fn2-extents))
      (phase (fn2-alloc-identity-phase fn2-extents))
      ((when (= phase *fn2-alloc-identity-phase-idle*))
       (fn2-alloc-identity-prepare-adopt kind owner ogen source i previous epoch counter fn2-extents))
      ((unless (and (fn2-alloc-identity-adopt-subject-p i previous epoch counter fn2-extents)
                    (fn2-alloc-identity-pending-current-p kind owner ogen source fn2-extents))) (mv :changed fn2-extents))
      ((when (= phase *fn2-alloc-identity-phase-ready*))
       (fn2-alloc-identity-commit-adopt kind owner ogen source fn2-extents))
      ((unless (= phase *fn2-alloc-identity-phase-probe*)) (mv :state fn2-extents))
      ((mv code fn2-extents) (fn2-alloc-identity-step kind owner ogen source fn2-extents)))
  (mv (if (eq code :ready) :more code) fn2-extents)))

(defun fn2-alloc-identity-old-bucket-p (fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (let ((b (fn2-alloc-identity-bucket fn2-extents)))
  (and (fn2-alloc-identity-geometry-p fn2-extents) (< b (fn2-extents-rows fn2-extents)) (< 0 (fn2-alloc-identity-count fn2-extents))
       (= (fn2-alloc-identity-statesi b fn2-extents) *fn2-alloc-identity-bucket-used*)
       (= (fn2-alloc-identity-extentsi b fn2-extents) (fn2-alloc-identity-extent fn2-extents))
       (= (fn2-alloc-identity-epochsi b fn2-extents) (fn2-alloc-identity-old-epoch fn2-extents))
       (= (fn2-alloc-identity-countersi b fn2-extents) (fn2-alloc-identity-old-counter fn2-extents)))))
(defun fn2-alloc-identity-free-ready-p (kind owner ogen source i epoch counter cut fn2-extents)
 (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
 (and (fn2-alloc-identity-pending-current-p kind owner ogen source fn2-extents)
      (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-ready*)
      (= (fn2-alloc-identity-op fn2-extents) *fn2-alloc-identity-op-free*)
      (equal i (fn2-alloc-identity-extent fn2-extents)) (equal epoch (fn2-alloc-identity-old-epoch fn2-extents))
      (equal counter (fn2-alloc-identity-old-counter fn2-extents)) (equal cut (fn2-alloc-identity-cut fn2-extents))
      (fn2-alloc-identity-old-bucket-p fn2-extents)))
(defun fn2-alloc-identity-commit-free (kind owner ogen source fn2-extents)

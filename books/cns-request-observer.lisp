; One metadata observation per actual CNS incarnation. This parent is not a
; Send lease: owned replies, or captured FETCH commitments + physical holds,
; replace C references before transport may wait on the client.
(in-package "ACL2")
(include-book "cns-kind")
(include-book "cursor-kind")
(include-book "c-source-observer")
(fn2-book-layer :e)
(defun fn2-cns-request-acquire-children (slot generation x fn2-cns fn2-reads fn2-succ-txns fn2-cursor-table
                                      fn2-c-source-control fn2-c-source-readers)
 (declare (xargs :stobjs (fn2-cns fn2-reads fn2-succ-txns fn2-cursor-table fn2-c-source-control fn2-c-source-readers)
  :guard (and (fn2-cns-wfp fn2-cns) (fn2-reads-wfp fn2-reads) (fn2-succ-txns-wfp fn2-succ-txns)
              (fn2-cursor-wfp fn2-cursor-table) (fn2-c-source-control-wfp fn2-c-source-control)
              (fn2-c-source-readers-wfp fn2-c-source-readers))))
 (b* (((unless (and (natp slot) (< slot (fn2-cns-rows fn2-cns))
                    (equal generation (fn2-cns-generation slot fn2-cns))
                    (member-equal (fn2-cns-phase slot fn2-cns)
                     (list *fn2-cns-state-decode* *fn2-cns-state-check* *fn2-cns-state-lookup*
                           *fn2-cns-state-read* *fn2-cns-state-page* *fn2-cns-state-refresh*))
                    (equal x (fn2-cns-xrow slot fn2-cns))
                    (< 0 (fn2-c-source-control-rows fn2-c-source-control))
                    (not (equal (fn2-c-source-control-phase 0 fn2-c-source-control) *fn2-c-source-writer-phase-uncertain*))))
       (mv :fault 0 fn2-reads fn2-c-source-control fn2-c-source-readers))
      (parent (fn2-c-source-cns-endpoint (fn2-reads-rows fn2-reads) (fn2-succ-txns-rows fn2-succ-txns)
                                        (fn2-cursor-rows fn2-cursor-table) slot))
      (expected (fn2-cns-observer-serial slot fn2-cns))
      ((mv code receipt fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire parent expected fn2-c-source-control fn2-c-source-readers))
      ((unless (eq code :ok))
       (mv (if (eq code :busy) :admission :fault) 0 fn2-reads fn2-c-source-control fn2-c-source-readers))
      ; A resumed operation may have a live nested READ. Rebinding would
      ; refuse its dead-child preflight; retain the exact existing binding.
      ((when (posp expected))
       (mv (if (fn2-read-parent-binding-current-p x parent receipt fn2-reads fn2-c-source-readers) :ok :fault)
           receipt fn2-reads fn2-c-source-control fn2-c-source-readers))
      ((mv bound fn2-reads) (fn2-read-parent-bind-one x parent receipt fn2-reads fn2-c-source-readers))
      ((when (eq bound :ok)) (mv :ok receipt fn2-reads fn2-c-source-control fn2-c-source-readers))
      ; A failed new binding is rolled back inside this callback, before a
      ; yield, metadata read or prefix. Existing receipts are never stolen.
      ((mv & & & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release parent receipt fn2-c-source-control fn2-c-source-readers)))
  (mv :fault 0 fn2-reads fn2-c-source-control fn2-c-source-readers)))
(defun fn2-cns-request-release-children (slot generation x fn2-cns fn2-reads fn2-succ-txns fn2-cursor-table
                                      fn2-c-source-control fn2-c-source-readers)
 (declare (xargs :stobjs (fn2-cns fn2-reads fn2-succ-txns fn2-cursor-table fn2-c-source-control fn2-c-source-readers)
  :guard (and (fn2-cns-wfp fn2-cns) (fn2-reads-wfp fn2-reads) (fn2-succ-txns-wfp fn2-succ-txns)
              (fn2-cursor-wfp fn2-cursor-table) (fn2-c-source-control-wfp fn2-c-source-control)
              (fn2-c-source-readers-wfp fn2-c-source-readers))))
 (b* (((unless (and (natp slot) (< slot (fn2-cns-rows fn2-cns))
                    (equal generation (fn2-cns-generation slot fn2-cns))
                    (equal x (fn2-cns-xrow slot fn2-cns))))
       (mv :fault fn2-reads fn2-c-source-control fn2-c-source-readers))
      (receipt (fn2-cns-observer-serial slot fn2-cns))
      ((when (equal receipt 0)) (mv :ok fn2-reads fn2-c-source-control fn2-c-source-readers))
      (parent (fn2-c-source-cns-endpoint (fn2-reads-rows fn2-reads) (fn2-succ-txns-rows fn2-succ-txns)
                                        (fn2-cursor-rows fn2-cursor-table) slot))
      ((mv cleared fn2-reads) (fn2-read-parent-clear-one x parent receipt fn2-reads fn2-c-source-readers))
      ((unless (eq cleared :ok)) (mv :fault fn2-reads fn2-c-source-control fn2-c-source-readers))
      ; The writer retains wake-pending and polls/yields. No made-up reader
      ; machine ID is used as a wake target at this scalar endpoint.
      ((mv code & & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release parent receipt fn2-c-source-control fn2-c-source-readers)))
  (mv (if (eq code :ok) :ok :fault) fn2-reads fn2-c-source-control fn2-c-source-readers)))
(defmacro fn2-cns-request-frames (name args position)
 `(fn2-reads-preserves ,name ,args :position ,position
   :hyps ((fn2-cnsp fn2-cns) (fn2-cns-wfp fn2-cns) (fn2-readsp fn2-reads) (fn2-reads-wfp fn2-reads)
          (fn2-succ-txnsp fn2-succ-txns) (fn2-succ-txns-wfp fn2-succ-txns)
          (fn2-cursorp fn2-cursor-table) (fn2-cursor-wfp fn2-cursor-table)
          (fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control)
          (fn2-c-source-readersp fn2-c-source-readers) (fn2-c-source-readers-wfp fn2-c-source-readers))
   :carriers ((fn2-reads ,position :prefix "-READS")
              (fn2-c-source-control ,(+ 1 position) :prefix "-CONTROL")
              (fn2-c-source-readers ,(+ 2 position) :prefix "-READERS"))))
(fn2-cns-request-frames fn2-cns-request-acquire-children
 (slot generation x fn2-cns fn2-reads fn2-succ-txns fn2-cursor-table fn2-c-source-control fn2-c-source-readers) 2)
(fn2-cns-request-frames fn2-cns-request-release-children
 (slot generation x fn2-cns fn2-reads fn2-succ-txns fn2-cursor-table fn2-c-source-control fn2-c-source-readers) 1)
(defmacro fn2-cns-request-observer-events ()
 '(progn
   (make-event (value (cons 'progn
     (append (fn2-arms-op-face-events 'fn2-cns-request-acquire-core 'fn2-cns-request-acquire-children (w state))
             (fn2-arms-op-face-events 'fn2-cns-request-release-core 'fn2-cns-request-release-children (w state))))))
   (defun fn2-cns-request-acquire (id generation fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (mv-let (code x) (fn2-cns-read-row id fn2-core)
     (if (not (and (eq code :ok) (eq (fn2-cns-snapshot-read-code id fn2-core) :ok)
                   (equal generation (fn2-machine-generation id fn2-core))))
      (mv :fault 0 fn2-core)
      (fn2-cns-request-acquire-core (fn2-machine-slot id fn2-core) generation x fn2-core))))
   (fn2-core-preserves fn2-cns-request-acquire (id generation fn2-core) :position 2 :rows nil)
   (defun fn2-cns-request-release (id generation fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (b* (((unless (and (eq (fn2-cns-snapshot-read-code id fn2-core) :ok)
                        (equal generation (fn2-machine-generation id fn2-core)))) (mv :fault fn2-core))
         ((when (equal (fn2-cns-row-observer-serial id fn2-core) 0)) (mv :ok fn2-core))
         ((mv code x) (fn2-cns-read-row id fn2-core))
         ((unless (and (eq code :ok) (equal x (fn2-cns-row-xrow id fn2-core)))) (mv :fault fn2-core))
         (slot (fn2-machine-slot id fn2-core))
         (receipt (fn2-cns-row-observer-serial id fn2-core))
         (parent (fn2-c-source-cns-endpoint
                   (stobj-let ((fn2-reads (fn2-core-reads fn2-core))) (n) (fn2-reads-rows fn2-reads) n)
                   (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (n) (fn2-succ-txns-rows fn2-succ-txns) n)
                   (stobj-let ((fn2-cursor-table (fn2-cursor-table fn2-core))) (n) (fn2-cursor-rows fn2-cursor-table) n) slot))
         (bound (stobj-let ((fn2-reads (fn2-core-reads fn2-core)) (fn2-c-source-readers (fn2-core-c-source-readers fn2-core)))
                 (yes) (fn2-read-parent-binding-current-p x parent receipt fn2-reads fn2-c-source-readers) yes))
         ((unless bound) (mv :fault fn2-core))
         ((mv rc fn2-core) (fn2-read-release x fn2-core))
         ((unless (eq rc :ok)) (mv :fault fn2-core)))
     (fn2-cns-request-release-core slot generation x fn2-core)))
   (fn2-core-preserves fn2-cns-request-release (id generation fn2-core) :position 1 :rows nil)
 ))

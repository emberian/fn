; The actual successor transaction carrier, shared with B's typed membership
; admission. Runtime C producers own these fields; no duplicate ready model.
(in-package "ACL2")
(include-book "successor-workspace-geometry")
(fn2-book-layer :b)
(defcolumns fn2-id-engine
 ((scratch :bool) (slot :u32) (gen :u60) (arena :u32) (seq :u60) (published :u60)
  (binding-phase (:enum fn2-succ-binder-phase (:idle :prepare :insert :unstage :uncertain :target :target-finish :failed)))
  (binding-tx :u32) (binding-generation :u60) (binding-batch :u60) (binding-event :u60)
  (binding-base :u32) (binding-slot :u32) (binding-scan :u32) (binding-overlay :u32)
  (binding-sid :u60) (binding-size :u32) (binding-target-cursor :u32) (binding-best :u32) (binding-spare :u32)))
(defun fn2-successor-binder-idle-p (fn2-id-engine)
 (declare (xargs :stobjs fn2-id-engine :guard (fn2-id-engine-wfp fn2-id-engine)))
 (and (< 0 (fn2-id-engine-rows fn2-id-engine))
      (equal (fn2-id-engine-binding-phase 0 fn2-id-engine) *fn2-succ-binder-phase-idle*)))
(defcolumns fn2-succ-txns
 ((phase (:enum fn2-succ-phase (:idle :open :staged :bound :published :binding)))
  (batch :u60) (event :u60)
  (ri :u32) (rstate (:enum fn2-succ-resolve (:fresh :next :look))) (rbound :u60)
  (lphase (:enum fn2-succ-lookup (:idle :overlays :runs :scan))) (lbound :u60) (lrow :u32) (lver :u60)
  (generation :u60) (emit-origin (:enum fn2-succ-emit-origin (:none :live :replay))) (emit-valid :bool) (emit-slot :u32) (emit-gen :u60) (emit-off :u32) (emit-len :u32)
  (emit-kind :u8) (emit-owner :u32) (emit-owner-gen :u60)
  (bind-phase (:enum fn2-succ-bind-phase (:idle :claimed :slot :insert :complete :uncertain :cancelled)))
  (bind-slot :u32)))
(defun fn2-successor-emission-identity-p (tx generation slot gen len kind owner owner-gen fn2-succ-txns)
 (declare (xargs :stobjs fn2-succ-txns :guard (fn2-succ-txns-wfp fn2-succ-txns)))
 (and (natp tx) (< tx (fn2-succ-txns-rows fn2-succ-txns))
      (posp generation) (equal generation (fn2-succ-txns-generation tx fn2-succ-txns))
      (equal (fn2-succ-txns-emit-valid tx fn2-succ-txns) 1)
      (equal (fn2-succ-txns-emit-origin tx fn2-succ-txns) *fn2-succ-emit-origin-live*)
      (equal slot (fn2-succ-txns-emit-slot tx fn2-succ-txns))
      (equal gen (fn2-succ-txns-emit-gen tx fn2-succ-txns))
      (equal (fn2-succ-txns-emit-off tx fn2-succ-txns) 0)
      (equal len (fn2-succ-txns-emit-len tx fn2-succ-txns))
      (equal kind (fn2-succ-txns-emit-kind tx fn2-succ-txns))
      (equal owner (fn2-succ-txns-emit-owner tx fn2-succ-txns))
      (equal owner-gen (fn2-succ-txns-emit-owner-gen tx fn2-succ-txns))))
(defun fn2-successor-emit-claim-current-p (tx generation slot gen len kind owner owner-gen fn2-succ-txns)
 (declare (xargs :stobjs fn2-succ-txns :guard (fn2-succ-txns-wfp fn2-succ-txns)))
 (and (fn2-successor-emission-identity-p tx generation slot gen len kind owner owner-gen fn2-succ-txns)
      (equal (fn2-succ-txns-phase tx fn2-succ-txns) *fn2-succ-phase-staged*)))
(defun fn2-successor-bind-claim-ready-p (tx generation batch event slot gen kind owner owner-gen fn2-succ-txns)
 (declare (xargs :stobjs fn2-succ-txns :guard (fn2-succ-txns-wfp fn2-succ-txns)))
 (and (natp tx) (< tx (fn2-succ-txns-rows fn2-succ-txns))
      (fn2-successor-emission-identity-p tx generation slot gen (fn2-succ-txns-emit-len tx fn2-succ-txns)
                                       kind owner owner-gen fn2-succ-txns)
      (equal (fn2-succ-txns-phase tx fn2-succ-txns) *fn2-succ-phase-bound*)
      (equal (fn2-succ-txns-bind-phase tx fn2-succ-txns) *fn2-succ-bind-phase-complete*)
      (equal (fn2-succ-txns-bind-slot tx fn2-succ-txns) *fn2-succ-slots*)
      (equal batch (fn2-succ-txns-batch tx fn2-succ-txns))
      (equal event (fn2-succ-txns-event tx fn2-succ-txns))))
(defun fn2-successor-bind-claim-cancelled-p (tx generation batch event slot gen len kind owner owner-gen fn2-succ-txns)
 (declare (xargs :stobjs fn2-succ-txns :guard (fn2-succ-txns-wfp fn2-succ-txns)))
 (and (fn2-successor-emission-identity-p tx generation slot gen len kind owner owner-gen fn2-succ-txns)
      (equal (fn2-succ-txns-phase tx fn2-succ-txns) *fn2-succ-phase-open*)
      (equal (fn2-succ-txns-bind-phase tx fn2-succ-txns) *fn2-succ-bind-phase-cancelled*)
      (equal batch (fn2-succ-txns-batch tx fn2-succ-txns))
      (equal event (fn2-succ-txns-event tx fn2-succ-txns))))

(in-package "ACL2")
(include-book "cns-fetch-prefix-codec")
(defmacro fn2-ctl-output-events ()
 '(progn
  (defun fn2-ctl-stream-reply-start (ctl gen request child cgen length fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                   :guard-hints (("Goal" :do-not '(preprocess)))))
   (if (not (and (fn2-ctl-stream-live-p ctl gen request fn2-core)
                 (equal (fn2-ctl-row-phase ctl fn2-core) *fn2-ctl-state-waiting*)
                 (equal (fn2-ctl-row-cns ctl fn2-core) child)
                 (equal (fn2-ctl-row-cns-gen ctl fn2-core) cgen)
                 (fn2-ctl-stream-child-live-p child cgen fn2-core)
                 (equal (fn2-cns-row-ctl child fn2-core) ctl)
                 (equal (fn2-cns-row-ctl-gen child fn2-core) gen)
                 (equal (fn2-cns-row-request child fn2-core) request)
                 (equal (fn2-ctl-row-pending ctl fn2-core) 0)
                 (equal (fn2-ctl-row-tx-len ctl fn2-core) 0)
                 (equal (fn2-ctl-row-ophase ctl fn2-core) *fn2-ctl-output-none*)
                 (natp length) (<= length *fn2-cns-fetch-wire-max*)))
       (mv :stale fn2-core)
    (let* ((fn2-core (fn2-ctl-put-core ctl (ototal length) (oleft length) (ochecked 0) (ophase *fn2-ctl-output-prefix*) (phase *fn2-ctl-state-stream-reply*)))
           (fn2-core (fn2-core-scheduler-wake ctl fn2-core)))
     (if (fn2-core-stopped-p fn2-core) (mv :stale fn2-core)
      (let ((fn2-core (fn2-core-record-enqueue ctl fn2-core)))
       (mv :ok fn2-core))))))
  (fn2-core-preserves fn2-ctl-stream-reply-start
   (ctl gen request child cgen length fn2-core) :position 1 :rows nil
   :hints (("Goal" :do-not '(preprocess))))

  (defun fn2-ctl-stream-output-prefix (ctl gen length slot sgen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                   :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
   (mv-let (rc row) (fn2-ctl-fc-row ctl fn2-core)
    (if (not (eq rc :ok)) (mv :bounds 0 fn2-core)
     (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-digests (fn2-core-digests fn2-core))
                 (fn2-b3 (fn2-core-b3 fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
      (code end fn2-fields fn2-digests fn2-b3 fn2-pool)
      (mv-let (sc fn2-digests fn2-b3) (fn2-fnct-stream-start row fn2-digests fn2-b3)
       (if (not (eq sc :ok)) (mv :bounds 0 fn2-fields fn2-digests fn2-b3 fn2-pool)
        (mv-let (pc end fn2-fields fn2-pool)
         (fn2-cns-fetch-stream-prefix (* 128 row) length slot sgen *fn2-ctl-kind* ctl gen fn2-fields fn2-pool)
         (mv (if (eq pc :ok) :ok :bounds) end fn2-fields fn2-digests fn2-b3 fn2-pool))))
      (mv code end fn2-core)))))
  (fn2-core-preserves fn2-ctl-stream-output-prefix
   (ctl gen length slot sgen fn2-core) :position 2 :rows nil)

  (defun fn2-ctl-stream-output-trailer (ctl gen slot sgen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                   :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
   (mv-let (rc row) (fn2-ctl-fc-row ctl fn2-core)
    (if (not (eq rc :ok)) (mv :bounds fn2-core)
     (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
      (code fn2-pool)
      (let ((dst (fn2-digest-slot (nfix row) *fn2-b3-result*)))
       (if (not (fn2-digest-rowp dst fn2-digests)) (mv :bounds fn2-pool)
        (mv-let (code fn2-pool)
         (fn2-digest-store 32 dst slot sgen 0 *fn2-ctl-kind* ctl gen fn2-digests fn2-pool)
         (mv (if (eq code :ok) :ok :bounds) fn2-pool))))
      (mv code fn2-core)))))
  (fn2-core-preserves fn2-ctl-stream-output-trailer
   (ctl gen slot sgen fn2-core) :position 1 :rows nil)
 ))

; Expanded before CNS source wrappers so cancellation uses the transport's
; actual row and loan state, not caller-supplied readiness flags.
(defmacro fn2-ctl-output-status-events ()
 '(progn
   (defun fn2-ctl-stream-reply-status (ctl gen request child cgen fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                    :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
    (if (not (and (fn2-ctl-stream-live-p ctl gen request fn2-core)
                  (equal (fn2-ctl-row-cns ctl fn2-core) child)
                  (equal (fn2-ctl-row-cns-gen ctl fn2-core) cgen)
                  (fn2-ctl-stream-child-live-p child cgen fn2-core))) :stale
     (let* ((phase (fn2-ctl-row-phase ctl fn2-core))
            (out (fn2-ctl-row-ophase ctl fn2-core))
            (slot (fn2-ctl-row-rx-slot ctl fn2-core))
            (sgen (fn2-ctl-row-rx-gen ctl fn2-core))
            (quiet (and (equal (fn2-ctl-row-pending ctl fn2-core) 0)
                        (equal (fn2-ctl-row-borrows ctl fn2-core) 0)
                        (eq (fn2-machine-pool-borrows-read-code slot fn2-core) :ok)
                        (equal (fn2-machine-pool-borrows slot fn2-core) 0)
                        (not (fn2-core-query-heldp slot sgen fn2-core)))))
      (cond ((or (member-equal phase (list *fn2-ctl-state-closing* *fn2-ctl-state-draining*))
                 (equal out *fn2-ctl-output-cancelled*))
             (if (and (equal phase *fn2-ctl-state-draining*) quiet) :cancelled :aborting))
            ((and (equal phase *fn2-ctl-state-stream-reply*)
                  (equal out *fn2-ctl-output-done*) quiet) :handback)
            ((member-equal phase (list *fn2-ctl-state-waiting* *fn2-ctl-state-stream-reply*)) :active)
            (t :stale)))))
   (defthm fn2-ctl-stream-reply-status-snapshot
     (implies (and (equal (fn2-ctl-stream-reply-status ctl gen request child cgen fn2-core) status)
                   (syntaxp (quotep status))
                   (not (equal status :stale)))
              (and (equal (fn2-ctl-snapshot-read-code ctl fn2-core) :ok)
                   (fn2-machine-idp ctl fn2-core)
                   (equal (fn2-machine-kind ctl fn2-core) *fn2-ctl-kind*)
                   (< (fn2-machine-slot ctl fn2-core)
                      (fn2-ctl-rows (fn2-ctl-table fn2-core)))
                   (equal (fn2-cns-snapshot-read-code child fn2-core) :ok)
                   (fn2-machine-idp child fn2-core)
                   (equal (fn2-machine-kind child fn2-core) *fn2-cns-kind*)
                   (< (fn2-machine-slot child fn2-core)
                      (fn2-cns-rows (fn2-cns-table fn2-core)))))
     :hints (("Goal" :in-theory (e/d (fn2-ctl-snapshot-read-code fn2-cns-snapshot-read-code
                                      fn2-machine-phase-read-code)
                                     (fn2-core-query-heldp fn2-machine-pool-borrows
                                      fn2-machine-pool-borrows-read-code member-equal)))))
   (in-theory (disable fn2-ctl-stream-reply-status))))

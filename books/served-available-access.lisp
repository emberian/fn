  :hints (("Goal" :in-theory (e/d (fn-av-otm-restrictedp fn-av-otm-read-span fn-otm-read-span)
                                  (fn-av-orr-read-span fn-orr-read-span fn-av-orr-restrictedp
                                   fn-otm-shed-ocfg fn-otm-admit-post fn-otm-conn-allow
                                   fn-otm-disk-effects fn-otm-unshed-ocfg)))))

;; KEYSTONE (PRF-1328).  The host's read, on a read every event of which
;; goes to a read-restricted session, is the legacy read.
(defthm fn-av-mca-read-span-restricted-is-legacy
  (implies (and (fn-gacc-okp cache)
                (fn-av-read-restrictedp oc views id i end cache s fn-octets fn-arena fn-cat))
           (equal (fn-av-mca-read-span credits oc views id i end cache s slots reserve
                                       fn-octets fn-arena fn-cat)
                  (fn-mca-read-span credits oc views id i end cache s slots reserve
                                    fn-octets fn-arena fn-cat)))
  :hints (("Goal" :in-theory (e/d (fn-av-read-restrictedp fn-av-mca-read-span fn-mca-read-span
                                   fn-av-mca-refused-read fn-mca-refused-read
                                   fn-av-oas-read-span fn-oas-read-span
                                   fn-av-oas-posting-off-read fn-oas-posting-off-read)
                                  (fn-av-otm-read-span fn-otm-read-span fn-av-otm-restrictedp
                                   fn-mcr-resize fn-mca-need fn-mca-shut-read fn-oas-tiers
                                   fn-oas-over-p fn-oas-articlep fn-oas-close-result

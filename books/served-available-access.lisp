                                  (fn-av-scr-feed-span fn-scr-feed-span fn-av-span-restrictedp
                                   fn-av-scr-scan-span fn-scr-scan-span)))))

(defun fn-av-own-restrictedp (o id i end cache fn-octets fn-arena fn-cat)
  (declare (xargs :stobjs (fn-octets fn-arena fn-cat) :verify-guards nil))
  (let ((conn (fn-own-find-conn id (fn-own-conns o))))
    (or (not conn)
        (fn-av-span-restrictedp (fn-own-tls-served-conn o conn) i end
                                (fn-sn-node (fn-own-store o))
                                (fn-own-view-index (fn-own-view o))
                                (fn-own-view-version (fn-own-view o))
                                (fn-state-articles (fn-own-view-archive (fn-own-view o)))
                                cache fn-octets fn-arena fn-cat))))

(defun fn-av-orr-restrictedp (oc views id i end cache fn-octets fn-arena fn-cat)
  (declare (xargs :stobjs (fn-octets fn-arena fn-cat) :verify-guards nil))
  (fn-av-own-restrictedp (fn-ocfg-owner (if (consp views) (fn-ocfg-at-reader-view oc views) oc))
                         id i end cache fn-octets fn-arena fn-cat))

(defun fn-av-otm-restrictedp (oc views id i end cache s fn-octets fn-arena fn-cat)
  (declare (xargs :stobjs (fn-octets fn-arena fn-cat) :verify-guards nil))
  (fn-av-orr-restrictedp (if (eq (fn-otm-admit-post s) :shed) (fn-otm-shed-ocfg oc id) oc)
                         views id i end cache fn-octets fn-arena fn-cat))

;; The read the host calls, as configured and with posting off (the re-read
;; fn-oas-posting-off-read makes for a slot or credit refusal).
(defun fn-av-read-restrictedp (oc views id i end cache s fn-octets fn-arena fn-cat)
  (declare (xargs :stobjs (fn-octets fn-arena fn-cat) :verify-guards nil))
  (and (fn-av-otm-restrictedp oc views id i end cache s fn-octets fn-arena fn-cat)
       (fn-av-otm-restrictedp (fn-otm-owner-with-allow oc id nil) views id i end cache s
                              fn-octets fn-arena fn-cat)))

(defthm fn-av-scr-own-read-span-restricted-is-legacy
  (implies (and (fn-gacc-okp cache)
                (fn-av-own-restrictedp o id i end cache fn-octets fn-arena fn-cat))
           (equal (fn-av-scr-own-read-span o id i end cache fn-octets fn-arena fn-cat)
                  (fn-scr-own-read-span o id i end cache fn-octets fn-arena fn-cat)))
  :hints (("Goal" :in-theory (e/d (fn-av-own-restrictedp fn-av-scr-own-read-span
                                   fn-scr-own-read-span)
                                  (fn-av-scr-step-span-fast fn-scr-step-span-fast
                                   fn-av-span-restrictedp fn-own-tls-served-conn
                                   fn-scar-finish-read)))))

(defthm fn-av-orr-read-span-restricted-is-legacy
  (implies (and (fn-gacc-okp cache)
                (fn-av-orr-restrictedp oc views id i end cache fn-octets fn-arena fn-cat))
           (equal (fn-av-orr-read-span oc views id i end cache fn-octets fn-arena fn-cat)
                  (fn-orr-read-span oc views id i end cache fn-octets fn-arena fn-cat)))
  :hints (("Goal" :in-theory (e/d (fn-av-orr-restrictedp fn-av-orr-read-span fn-orr-read-span
                                   fn-av-scr-ocfg-read-span fn-scr-ocfg-read-span)
                                  (fn-av-scr-own-read-span fn-scr-own-read-span
                                   fn-av-own-restrictedp fn-ocfg-at-reader-view
                                   fn-ocfg-with-read-owner fn-ocfg-with-view)))))

(defthm fn-av-otm-read-span-restricted-is-legacy
  (implies (and (fn-gacc-okp cache)
                (fn-av-otm-restrictedp oc views id i end cache s fn-octets fn-arena fn-cat))
           (equal (fn-av-otm-read-span oc views id i end cache s fn-octets fn-arena fn-cat)

; PRF-1143: unactivated exclusive incoming fn-octets holder algebra.
; The actual pool and holder slot must be serialized as one product state.
; Supplied demand is NOT an actual constructor census or runtime adequacy.
(in-package "ACL2")
(include-book "page-read-ledger")

; Slot = (typed-token phase remaining-demand). No binding-list scan. Incoming
; binding/groups/input aliases belong to the retained owner job, not TOKEN.
(defun fn-ioh-token (id)
  (declare (xargs :guard t))
  (list :incoming id))
(defun fn-ioh-tokenp (token)
  (declare (xargs :guard t))
  (and (consp token) (equal (car token) :incoming)
       (consp (cdr token)) (natp (cadr token)) (null (cddr token))))
(defun fn-ioh-matches (slot token)
  (declare (xargs :guard t))
  (and (fn-ioh-tokenp token) (fn-ioh-tokenp (fn-prl-nth 0 slot))
       (equal token (fn-prl-nth 0 slot))))
(defun fn-ioh-admit (ledger slot demand)
  (declare (xargs :guard t))
  (if slot (mv :incoming-busy nil ledger slot)
    (let ((next (fn-prl-nth 2 ledger)))
      (mv-let (word next1 charged1)
        (if (and (fn-prs-vectorp demand)
                 (equal (fn-prl-nth 1 demand) 0)
                 (equal (fn-prl-nth 2 demand) 0)
                 (equal (fn-prl-nth 3 demand) 0)
                 (equal (fn-prl-nth 4 demand) 1))
            (fn-prs-issue (fn-prl-nth 0 ledger) (fn-prl-baseline ledger)
                          '(0 0 0 0 0) (fn-prl-nth 1 ledger)
                          next (fn-prl-nth 4 (fn-prl-nth 0 ledger)) demand)
          (mv :invalid-incoming-demand next (fn-prl-nth 1 ledger)))
        (if (not (equal word :admitted)) (mv word nil ledger slot)
          (let ((token (fn-ioh-token next)))
            (mv :admitted token
                (fn-prl-build (fn-prl-nth 0 ledger) charged1 next1
                              (fn-prl-nth 3 ledger) (fn-prl-nth 4 ledger))
                (list token :setup demand))))))))
(defun fn-ioh-access (slot token operation)
  (declare (xargs :guard t))
  (cond ((not (member-equal operation '(:read :mutate))) :invalid-buffer-operation)
        ((not slot) (if (null token) :unheld :incoming-busy))
        ((not (fn-ioh-matches slot token)) :incoming-busy)
        ((equal (fn-prl-nth 1 slot) :setup) :holder-setup)
        ((and (equal operation :read) (equal (fn-prl-nth 1 slot) :readonly))
         :holder-readonly)
        (t :incoming-busy)))
(defun fn-ioh-seal (slot token)
  (declare (xargs :guard t))
  (if (and slot (fn-ioh-matches slot token)
           (equal (fn-prl-nth 1 slot) :setup))
      (mv :sealed (list token :readonly (fn-prl-nth 2 slot)))
    (mv :stale slot)))
(defun fn-ioh-cancel (slot token)
  (declare (xargs :guard t))
  (if (and slot (fn-ioh-matches slot token)
           (member-equal (fn-prl-nth 1 slot) '(:setup :readonly :cancelled)))
      (if (equal (fn-prl-nth 1 slot) :cancelled) (mv :cancelled slot)
      (mv :cancelled (list token :cancelled (fn-prl-nth 2 slot))))
    (mv :stale slot)))
; JOINED/ALIASES-CLEAR are actual observations owed by the host-called
; composed completion boundary. A timeout or cancellation does not settle.
(defun fn-ioh-release (ledger slot token joined aliases-clear)
  (declare (xargs :guard t))
  (if (not (and slot (fn-ioh-matches slot token)
                (member-equal (fn-prl-nth 1 slot) '(:setup :readonly :cancelled))
                (equal joined t) (equal aliases-clear t)
                (true-listp (fn-prl-nth 1 ledger))
                (true-listp (fn-prl-nth 2 slot))))
      (mv :incoming-held ledger slot)
    (mv :released
        (fn-prl-build (fn-prl-nth 0 ledger)
                      (fn-prs-release-reusable (fn-prl-nth 1 ledger)
                                              (fn-prl-nth 2 slot))
                      (fn-prl-nth 2 ledger) (fn-prl-nth 3 ledger)
                      (fn-prl-nth 4 ledger)) nil)))

(defthm fn-ioh-sealed-or-cancelled-forbids-mutation
  (implies (and slot (member-equal (fn-prl-nth 1 slot) '(:readonly :cancelled)))
           (equal (fn-ioh-access slot token :mutate) :incoming-busy)))
(defthm fn-ioh-refused-release-keeps-owned-state-by-definition
  (implies (not (equal (mv-nth 0 (fn-ioh-release ledger slot token joined aliases-clear))
                       :released))
           (and (equal (mv-nth 1 (fn-ioh-release ledger slot token joined aliases-clear)) ledger)
                (equal (mv-nth 2 (fn-ioh-release ledger slot token joined aliases-clear)) slot))))
(defthm fn-ioh-admission-uses-shared-nonreused-identity
  (implies (equal (mv-nth 0 (fn-ioh-admit ledger slot demand)) :admitted)
           (and (equal (mv-nth 1 (fn-ioh-admit ledger slot demand))
                       (fn-ioh-token (fn-prl-nth 2 ledger)))
                (equal (fn-prl-nth 2 (mv-nth 2 (fn-ioh-admit ledger slot demand)))
                       (+ 1 (fn-prl-nth 2 ledger)))))
  :hints (("Goal" :in-theory (enable fn-ioh-admit fn-prs-issue fn-prl-nth fn-prl-build))))
(in-theory (disable fn-ioh-token fn-ioh-admit fn-ioh-access fn-ioh-seal
                    fn-ioh-cancel fn-ioh-release))

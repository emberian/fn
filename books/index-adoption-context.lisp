; Internal custody preservation at the actual indexed adoption boundary.
; All references come from the current receipt/context producer. No host
; context/row setter is exported. Legacy NIL custody confers no terminal right.
(in-package "ACL2")
(logic)
(include-book "index-query-slot-issuer")
(include-book "receiver-query-binding")
(defun fn-ibp-adoption-context (token context receipt)
 (declare (xargs :guard t))
 (let* ((row (fn-omk-at 9 context))
        (original (list :index-query (fn-omk-at 1 token)
                        (fn-omk-at 2 token) (fn-omk-at 3 token)
                        (fn-irq-receipt-request-generation receipt))))
  (mv-let (word bound)
   (if (null row) (mv :legacy-custody nil)
     (fn-ric-custody-bind-query row original token))
   (if (not (member-eq word '(:legacy-custody :query-bound :already-bound)))
       (mv :unavailable-custody nil)
     (mv :context-ready
      (list (fn-omk-at 0 context) (fn-omk-at 1 context)
            (fn-omk-at 2 context) (fn-omk-at 3 context)
            (fn-omk-at 4 context) (fn-omk-at 5 context)
            (fn-omk-at 6 context) (fn-omk-at 7 context) receipt bound))))))
(defthm fn-ibp-adoption-context-prefix-by-definition
 (let ((answer (fn-ibp-adoption-context token context receipt)))
  (implies (eq (mv-nth 0 answer) :context-ready)
   (and (equal (fn-omk-at 0 (mv-nth 1 answer)) (fn-omk-at 0 context))
        (equal (fn-omk-at 1 (mv-nth 1 answer)) (fn-omk-at 1 context))
        (equal (fn-omk-at 2 (mv-nth 1 answer)) (fn-omk-at 2 context))
        (equal (fn-omk-at 3 (mv-nth 1 answer)) (fn-omk-at 3 context))
        (equal (fn-omk-at 4 (mv-nth 1 answer)) (fn-omk-at 4 context))
        (equal (fn-omk-at 5 (mv-nth 1 answer)) (fn-omk-at 5 context))
        (equal (fn-omk-at 6 (mv-nth 1 answer)) (fn-omk-at 6 context))
        (equal (fn-omk-at 7 (mv-nth 1 answer)) (fn-omk-at 7 context))
        (equal (fn-omk-at 8 (mv-nth 1 answer)) receipt))))
 :hints (("Goal" :in-theory (e/d (fn-ibp-adoption-context fn-omk-at)
                                (fn-ric-custody-bind-query fn-irq-receipt-request-generation))))
 :rule-classes nil)

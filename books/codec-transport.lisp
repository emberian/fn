; Shared concrete ownership envelope for bounded transport codecs.
(in-package "ACL2")
(include-book "columns")
(fn2-book-layer :a)

(defun fn2-codec-span-p (offset count extent quantum)
 (declare (xargs :guard t))
 (and (unsigned-byte-p 32 offset) (unsigned-byte-p 32 count)
      (unsigned-byte-p 32 extent) (unsigned-byte-p 32 quantum)
      (<= count quantum) (<= (+ offset count) extent)))

(defun fn2-codec-transfer-counts-p (used made requested-input requested-output)
 (declare (xargs :guard t))
 (and (natp used) (natp made) (natp requested-input) (natp requested-output)
      (<= used requested-input) (<= made requested-output)))

(defun fn2-codec-source-span-p (channel offset extent copied fed il io ol oo)
 (declare (xargs :guard t))
 (case channel
  (0 t) (1 (and (equal extent copied) (equal offset fed)))
  (2 (and (equal extent il) (equal offset io)))
  (3 (and (equal extent ol) (equal offset oo)))
  (4 t) (otherwise nil)))
(defun fn2-codec-target-span-p (channel offset extent iq oq il io ol oo)
 (declare (xargs :guard t))
 (case channel
  (0 t) (2 (and (equal il io) (equal offset 0) (equal extent iq)))
  (3 (and (equal ol oo) (equal offset 0) (equal extent oq)))
  (5 t) (otherwise nil)))

; A codec supplies policy columns, never a twin ownership/observation envelope.
; The instance keeps the actual caller's stobj name and generated accessors.
(defconst *fn2-codec-transport-columns*
 '((cap :u32) (nonce :u60) (slot :u32) (generation :u60)
   (alive :bool) (cleanup-credit :bool)
   (handle-id :u64 :why "Opaque physical codec allocation identity, never protocol identity.")
   (budget :u60) (serial :u60) (window :u32)
   (seed-total :u32) (seed-capacity :u32) (copied :u32) (fed :u32)
   (input-length :u32) (input-offset :u32)
   (output-length :u32) (output-offset :u32)
   (terminal :u8) (pending :u8) (offset :u32) (requested :u32)
   (raw-negative :bool)
   (raw-code :u64 :why "Exact raw primitive result magnitude or opaque allocation identity.")
   (raw-count :u32) (raw-errno :u32) (raw-used :u32) (raw-made :u32)
   (request-in-channel :u8) (request-in-offset :u32) (request-in-count :u32) (request-in-extent :u32)
   (request-out-channel :u8) (request-out-offset :u32) (request-out-count :u32) (request-out-extent :u32)))

(defmacro defcodec-transport (name policy-columns &key (rows-bound '2))
 (let ((wfp (fn2-columns-sym name "-WFP"))
       (rows (fn2-columns-sym name "-ROWS"))
       (match (fn2-columns-sym name "-MATCH-P")))
  `(progn
(defcolumns ,name ,(append *fn2-codec-transport-columns* policy-columns)
      :rows-bound ,rows-bound)
(defun ,match (cap nonce slot generation serial ,name)
     (declare (xargs :stobjs ,name :guard (and (,wfp ,name) (= (,rows ,name) 1))))
     (and (equal cap (,(fn2-columns-sym name "-CAP") 0 ,name))
          (equal nonce (,(fn2-columns-sym name "-NONCE") 0 ,name))
          (equal slot (,(fn2-columns-sym name "-SLOT") 0 ,name))
          (equal generation (,(fn2-columns-sym name "-GENERATION") 0 ,name))
          (equal serial (,(fn2-columns-sym name "-SERIAL") 0 ,name))
          (< 0 (,(fn2-columns-sym name "-PENDING") 0 ,name)))))))

; Common observation changes raw/staging fields, never codec policy columns.
(defun fn2-codec-transport-policy-frame-events (name fields readers)
 (declare (xargs :verify-guards nil))
 (if (atom fields) nil
  (let ((reader (fn2-columns-col-name name (caar fields)))
        (recognizer (fn2-columns-sym name "P"))
        (wfp (fn2-columns-sym name "-WFP"))
        (rows (fn2-columns-sym name "-ROWS"))
        (advance (fn2-columns-sym name "-ADVANCE-SPANS"))
        (observe (fn2-columns-sym name "-OBSERVE-SPANS")))
   (append
    (list
     `(defthm ,(fn2-columns-sym reader "-OF-ADVANCE-SPANS")
       (implies (and (,recognizer ,name) (,wfp ,name) (= (,rows ,name) 1))
        (equal (,reader 0 (mv-nth 1 (,advance cap nonce slot generation serial used made ,name)))
               (,reader 0 ,name)))
       :hints (("Goal" :in-theory
        (union-theories '(,reader)
         (set-difference-theories (current-theory :here) ',readers)))))
     `(defthm ,(fn2-columns-sym reader "-OF-OBSERVE-SPANS")
       (implies (and (,recognizer ,name) (,wfp ,name) (= (,rows ,name) 1))
        (equal (,reader 0 (mv-nth 1 (,observe cap nonce slot generation serial raw-code used made errno ,name)))
               (,reader 0 ,name)))
       :hints (("Goal" :in-theory
        (union-theories '(,reader)
         (set-difference-theories (current-theory :here) '(,advance ,@readers)))
        :use ((:instance ,(fn2-columns-sym reader "-OF-ADVANCE-SPANS")
               (,name (,(fn2-columns-sym name "-PUT") 0
                (raw-negative (if (< raw-code 0) 1 0)) (raw-code (abs raw-code))
                (raw-used used) (raw-made made) (raw-errno errno)))))))))
    (fn2-codec-transport-policy-frame-events name (cdr fields) readers)))))

(defun fn2-codec-transport-operation-events (name input-quantum-field output-quantum-field world)
 (declare (xargs :verify-guards nil))
(let ((wfp (fn2-columns-sym name "-WFP"))
       (recognizer (fn2-columns-sym name "P"))
       (readers (cons (fn2-columns-sym name "-ROWS")
                     (fn2-columns-projection-readers name (fn2-decl-get :columns (fn2-decl-row (list :columns name) world)))))
       (rows (fn2-columns-sym name "-ROWS"))
       (match (fn2-columns-sym name "-MATCH-P"))
       (select (fn2-columns-sym name "-SELECT"))
       (observe (fn2-columns-sym name "-OBSERVE-SPANS"))
       (advance (fn2-columns-sym name "-ADVANCE-SPANS"))
       (put (fn2-columns-sym name "-PUT"))
       (iq (fn2-columns-sym name (concatenate 'string "-" (symbol-name input-quantum-field))))
       (oq (fn2-columns-sym name (concatenate 'string "-" (symbol-name output-quantum-field)))))
  `(progn
(defun ,select (cap nonce slot generation action
                   in-channel in-offset in-count in-extent
                   out-channel out-offset out-count out-extent ,name)
     (declare (xargs :stobjs ,name :verify-guards nil
                    :guard (and (,wfp ,name) (= (,rows ,name) 1))))
     (if (not (and (unsigned-byte-p 32 slot) (unsigned-byte-p 60 generation)
                   (unsigned-byte-p 8 action) (< 0 action) (not (member-equal action '(8 9)))
                   (member-equal in-channel '(0 1 2 3 4))
                   (member-equal out-channel '(0 2 3 5))
                   (or (not (equal in-channel 0)) (and (equal in-offset 0) (equal in-count 0) (equal in-extent 0)))
                   (or (not (equal out-channel 0)) (and (equal out-offset 0) (equal out-count 0) (equal out-extent 0)))
                   (fn2-codec-span-p in-offset in-count in-extent (,iq 0 ,name))
                   (fn2-codec-span-p out-offset out-count out-extent (,oq 0 ,name))
                   (or (equal in-channel 0) (not (equal in-channel out-channel)))
                   (fn2-codec-source-span-p in-channel in-offset in-extent
                     (,(fn2-columns-sym name "-COPIED") 0 ,name) (,(fn2-columns-sym name "-FED") 0 ,name)
                     (,(fn2-columns-sym name "-INPUT-LENGTH") 0 ,name) (,(fn2-columns-sym name "-INPUT-OFFSET") 0 ,name)
                     (,(fn2-columns-sym name "-OUTPUT-LENGTH") 0 ,name) (,(fn2-columns-sym name "-OUTPUT-OFFSET") 0 ,name))
                   (fn2-codec-target-span-p out-channel out-offset out-extent (,iq 0 ,name) (,oq 0 ,name)
                     (,(fn2-columns-sym name "-INPUT-LENGTH") 0 ,name) (,(fn2-columns-sym name "-INPUT-OFFSET") 0 ,name)
                     (,(fn2-columns-sym name "-OUTPUT-LENGTH") 0 ,name) (,(fn2-columns-sym name "-OUTPUT-OFFSET") 0 ,name))))
         (mv :bounds 0 ,name)
      (if (not (and (equal cap (,(fn2-columns-sym name "-CAP") 0 ,name))
                    (equal nonce (,(fn2-columns-sym name "-NONCE") 0 ,name))
                    (= (,(fn2-columns-sym name "-ALIVE") 0 ,name) 1)
                    (= (,(fn2-columns-sym name "-TERMINAL") 0 ,name) 3)
                    (= (,(fn2-columns-sym name "-PENDING") 0 ,name) 0)
                    (< (,(fn2-columns-sym name "-SERIAL") 0 ,name) #xffffffffffffffe)))
          (mv :state 0 ,name)
       (let* ((serial (+ 1 (,(fn2-columns-sym name "-SERIAL") 0 ,name)))
              (,name (,put 0 (slot slot) (generation generation) (serial serial) (pending action)
                       (request-in-channel in-channel) (request-in-offset in-offset)
                       (request-in-count in-count) (request-in-extent in-extent)
                       (request-out-channel out-channel) (request-out-offset out-offset)
                       (request-out-count out-count) (request-out-extent out-extent))))
        (mv :ok serial ,name)))))
; Internal child completion settles owned spans without inventing a raw syscall.
(defun ,advance (cap nonce slot generation serial used made ,name)
     (declare (xargs :stobjs ,name :verify-guards nil
                    :guard (and (,wfp ,name) (= (,rows ,name) 1))))
     (if (not (and (,match cap nonce slot generation serial ,name)
                   (= (,(fn2-columns-sym name "-TERMINAL") 0 ,name) 3)
                   (= (,(fn2-columns-sym name "-ALIVE") 0 ,name) 1)
                   (not (member-equal (,(fn2-columns-sym name "-PENDING") 0 ,name) '(8 9)))
                   (unsigned-byte-p 32 used) (unsigned-byte-p 32 made)))
         (mv :stale ,name)
      (let* ((in-channel (,(fn2-columns-sym name "-REQUEST-IN-CHANNEL") 0 ,name))
             (out-channel (,(fn2-columns-sym name "-REQUEST-OUT-CHANNEL") 0 ,name))
             (in-offset (,(fn2-columns-sym name "-REQUEST-IN-OFFSET") 0 ,name))
             (out-offset (,(fn2-columns-sym name "-REQUEST-OUT-OFFSET") 0 ,name))
             (valid (and (fn2-codec-transfer-counts-p used made
                           (,(fn2-columns-sym name "-REQUEST-IN-COUNT") 0 ,name)
                           (,(fn2-columns-sym name "-REQUEST-OUT-COUNT") 0 ,name))
                         (unsigned-byte-p 32 (+ in-offset used))
                         (unsigned-byte-p 32 (+ out-offset made)))))
       (if (not valid) (mv :bounds ,name)
        (let* ((,name (,put 0 (pending 0)))
               (,name (case in-channel
                        (1 (,put 0 (fed (+ in-offset used))))
                        (2 (,put 0 (input-offset (+ in-offset used))))
                        (3 (,put 0 (output-offset (+ in-offset used))))
                        (otherwise ,name)))
               (,name (case out-channel
                        (2 (,put 0 (input-length (+ out-offset made)) (input-offset 0)))
                        (3 (,put 0 (output-length (+ out-offset made)) (output-offset 0)))
                        (otherwise ,name))))
         (mv :ok ,name))))))
(defun ,observe (cap nonce slot generation serial raw-code used made errno ,name)
     (declare (xargs :stobjs ,name :verify-guards nil
                    :guard (and (,wfp ,name) (= (,rows ,name) 1))))
     (if (not (and (,match cap nonce slot generation serial ,name)
                   (= (,(fn2-columns-sym name "-TERMINAL") 0 ,name) 3)
                   (= (,(fn2-columns-sym name "-ALIVE") 0 ,name) 1)
                   (not (member-equal (,(fn2-columns-sym name "-PENDING") 0 ,name) '(8 9)))
                   (integerp raw-code) (unsigned-byte-p 64 (abs raw-code))
                   (unsigned-byte-p 32 used) (unsigned-byte-p 32 made) (unsigned-byte-p 32 errno)))
         (mv :stale ,name)
      (let ((,name (,put 0 (raw-negative (if (< raw-code 0) 1 0)) (raw-code (abs raw-code))
                      (raw-used used) (raw-made made) (raw-errno errno))))
       (,advance cap nonce slot generation serial used made ,name))))
; Callers may keep the physical observer opaque while using its accepted
; scalar packet. The widths are the observer's existing admission checks.
(defthm ,(fn2-columns-sym name "-OBSERVE-SPANS-OK-INPUTS")
 (implies (equal (mv-nth 0 (,observe cap nonce slot generation serial raw-code used made errno ,name)) :ok)
  (and (integerp raw-code) (unsigned-byte-p 64 (abs raw-code))
       (unsigned-byte-p 32 used) (unsigned-byte-p 32 made) (unsigned-byte-p 32 errno)))
 :hints (("Goal" :in-theory (disable ,@readers ,advance))))
(verify-guards ,select :hints (("Goal" :in-theory (disable ,@readers))))
(verify-guards ,advance :hints (("Goal" :in-theory (disable ,@readers))))
(verify-guards ,observe :hints (("Goal" :in-theory (disable ,@readers))))
(defthm ,(fn2-columns-sym name "-SELECT-WFP")
     (implies (and (,recognizer ,name) (,wfp ,name) (= (,rows ,name) 1))
      (,wfp (mv-nth 2 (,select cap nonce slot generation action
                   in-channel in-offset in-count in-extent
                   out-channel out-offset out-count out-extent ,name))))
     :hints (("Goal" :in-theory (disable ,@readers))))
; Opaque callers need the concrete recognizer and one-row shape as well
; as WFP when a selected request becomes their next physical action.
(defthm ,(fn2-columns-sym name "-SELECT-PRESERVES-TYPE")
     (implies (and (,recognizer ,name) (,wfp ,name) (= (,rows ,name) 1))
      (,recognizer (mv-nth 2 (,select cap nonce slot generation action
                   in-channel in-offset in-count in-extent
                   out-channel out-offset out-count out-extent ,name))))
     :hints (("Goal" :in-theory (disable ,@readers))))
(defthm ,(fn2-columns-sym name "-SELECT-ROWS")
     (implies (and (,recognizer ,name) (,wfp ,name) (= (,rows ,name) 1))
      (equal (,rows (mv-nth 2 (,select cap nonce slot generation action
                   in-channel in-offset in-count in-extent
                   out-channel out-offset out-count out-extent ,name))) 1))
     :hints (("Goal" :in-theory (disable ,@readers))))
(defthm ,(fn2-columns-sym name "-ADVANCE-SPANS-ROWS")
     (implies (and (,recognizer ,name) (,wfp ,name) (= (,rows ,name) 1))
      (equal (,rows (mv-nth 1 (,advance cap nonce slot generation serial used made ,name))) 1))
     :hints (("Goal" :in-theory (disable ,@readers))))
(defthm ,(fn2-columns-sym name "-ADVANCE-SPANS-WFP")
     (implies (and (,recognizer ,name) (,wfp ,name) (= (,rows ,name) 1))
      (,wfp (mv-nth 1 (,advance cap nonce slot generation serial used made ,name))))
     :hints (("Goal" :in-theory (disable ,@readers))))
(defthm ,(fn2-columns-sym name "-OBSERVE-SPANS-ROWS")
     (implies (and (,recognizer ,name) (,wfp ,name) (= (,rows ,name) 1))
      (equal (,rows (mv-nth 1 (,observe cap nonce slot generation serial raw-code used made errno ,name))) 1))
     :hints (("Goal" :in-theory (disable ,@readers))))
(defthm ,(fn2-columns-sym name "-OBSERVE-SPANS-WFP")
     (implies (and (,recognizer ,name) (,wfp ,name) (= (,rows ,name) 1))
      (,wfp (mv-nth 1 (,observe cap nonce slot generation serial raw-code used made errno ,name))))
     :hints (("Goal" :in-theory (disable ,@readers))))
,@(fn2-codec-transport-policy-frame-events name
    (nthcdr (len *fn2-codec-transport-columns*)
     (fn2-decl-get :columns (fn2-decl-row (list :columns name) world))) readers))))

(defmacro defcodec-transport-operations (name &key (input-quantum-field 'quantum)
                                                (output-quantum-field 'quantum))
 `(make-event
   (value (fn2-codec-transport-operation-events ',name ',input-quantum-field ',output-quantum-field (w state)))))

; Lifecycle bodies are shared with the existing TLS caller; codec policy remains separate.
(defun fn2-codec-transport-lifecycle-events (name input-quantum-field output-quantum-field world)
 (declare (xargs :verify-guards nil))
 (let ((begin (fn2-columns-sym name "-BEGIN"))
       (wfp (fn2-columns-sym name "-WFP"))
       (recognizer (fn2-columns-sym name "P"))
       (rows (fn2-columns-sym name "-ROWS"))
       (init (fn2-columns-sym name "-INIT"))
       (put (fn2-columns-sym name "-PUT"))
       (readers (cons (fn2-columns-sym name "-ROWS")
                 (fn2-columns-projection-readers name
                  (fn2-decl-get :columns (fn2-decl-row (list :columns name) world))))))
  `(progn
    (defun ,begin (cap nonce slot generation total capacity input-quantum output-quantum window budget ,name)
     (declare (xargs :stobjs ,name :verify-guards nil :guard (,wfp ,name)))
     (cond
      ((not (and (unsigned-byte-p 32 cap) (unsigned-byte-p 60 nonce)
                 (unsigned-byte-p 32 slot) (unsigned-byte-p 60 generation)
                 (unsigned-byte-p 32 total) (unsigned-byte-p 32 capacity) (<= total capacity)
                 (posp input-quantum) (unsigned-byte-p 32 input-quantum)
                 (posp output-quantum) (unsigned-byte-p 32 output-quantum)
                 ,(if (eq input-quantum-field output-quantum-field) '(equal input-quantum output-quantum) t)
                 (posp window) (unsigned-byte-p 32 window)
                 (posp budget) (unsigned-byte-p 60 budget)))
       (mv :bounds ,name))
      ((and (= (,rows ,name) 1)
            (or (= (,(fn2-columns-sym name "-ALIVE") 0 ,name) 1)
                (not (= (,(fn2-columns-sym name "-PENDING") 0 ,name) 0))
                (and (equal cap (,(fn2-columns-sym name "-CAP") 0 ,name))
                     (equal nonce (,(fn2-columns-sym name "-NONCE") 0 ,name)))))
       (mv :state ,name))
      (t (let* ((,name (,init 1 ,name))
                (,name (,put 0 (cap cap) (nonce nonce) (slot slot) (generation generation)
                         (seed-total total) (seed-capacity capacity) (window window)
                         (budget budget) (cleanup-credit 1)
                         ,@(if (eq input-quantum-field output-quantum-field)
                               `((,input-quantum-field input-quantum))
                             `((,input-quantum-field input-quantum) (,output-quantum-field output-quantum))))))
           (mv :ok ,name)))))
    (verify-guards ,begin :hints (("Goal" :in-theory (disable ,@readers))))
    (defthm ,(fn2-columns-sym name "-BEGIN-WFP")
     (implies (and (,recognizer ,name) (,wfp ,name))
      (,wfp (mv-nth 1 (,begin cap nonce slot generation total capacity input-quantum output-quantum window budget ,name))))
     :hints (("Goal" :in-theory (disable ,@readers))))
(defun ,(fn2-columns-sym name "-RETIRE") (cap nonce ,name)
 (declare (xargs :stobjs ,name :verify-guards nil
                 :guard (,(fn2-columns-sym name "-WFP") ,name)))
 (cond
  ((= (,(fn2-columns-sym name "-ROWS") ,name) 0) (mv :done ,name))
  ((or (not (equal cap (,(fn2-columns-sym name "-CAP") 0 ,name)))
       (not (equal nonce (,(fn2-columns-sym name "-NONCE") 0 ,name))))
   (mv :stale ,name))
  ((not (= (,(fn2-columns-sym name "-PENDING") 0 ,name) 0))
   (mv :pending ,name))
  (t
   (let* ((alive (,(fn2-columns-sym name "-ALIVE") 0 ,name))
          (handle (,(fn2-columns-sym name "-HANDLE-ID") 0 ,name))
          ;; No primitive is pending here. Only an unused reservation can be
          ;; discharged without selecting and observing the physical free.
          (unused (and (= alive 0) (= handle 0)))
          (,name (if unused
                     (,(fn2-columns-sym name "-PUT") 0 (terminal 4) (cleanup-credit 0))
                   (,(fn2-columns-sym name "-PUT") 0 (terminal 4)))))
    (mv (if unused :done :closing) ,name)))))
(defun ,(fn2-columns-sym name "-RETIRED-P") (cap nonce ,name)
 (declare (xargs :stobjs ,name :verify-guards nil :guard (,wfp ,name)))
 (and (= (,rows ,name) 1)
      (equal cap (,(fn2-columns-sym name "-CAP") 0 ,name))
      (equal nonce (,(fn2-columns-sym name "-NONCE") 0 ,name))
      (= (,(fn2-columns-sym name "-TERMINAL") 0 ,name) 4)
      (= (,(fn2-columns-sym name "-PENDING") 0 ,name) 0)
      (= (,(fn2-columns-sym name "-ALIVE") 0 ,name) 0)
      (= (,(fn2-columns-sym name "-HANDLE-ID") 0 ,name) 0)
      (= (,(fn2-columns-sym name "-CLEANUP-CREDIT") 0 ,name) 0)))
(defun ,(fn2-columns-sym name "-HANDLE") (,name)
 (declare (xargs :stobjs ,name :verify-guards nil
                 :guard (,(fn2-columns-sym name "-WFP") ,name)))
 (if (= (,(fn2-columns-sym name "-ROWS") ,name) 0) 0
   (,(fn2-columns-sym name "-HANDLE-ID") 0 ,name)))
(defun ,(fn2-columns-sym name "-SELECTED-P") (cap nonce ,name)
 (declare (xargs :stobjs ,name :verify-guards nil
                 :guard (,(fn2-columns-sym name "-WFP") ,name)))
 (and (= (,(fn2-columns-sym name "-ROWS") ,name) 1)
      (equal cap (,(fn2-columns-sym name "-CAP") 0 ,name))
      (equal nonce (,(fn2-columns-sym name "-NONCE") 0 ,name))))
(defun ,(fn2-columns-sym name "-HANDOFF") (cap nonce slot generation ,name)
 (declare (xargs :stobjs ,name
  :guard (and (,(fn2-columns-sym name "-WFP") ,name) (= (,(fn2-columns-sym name "-ROWS") ,name) 1))))
 (if (and (equal cap (,(fn2-columns-sym name "-CAP") 0 ,name))
          (equal nonce (,(fn2-columns-sym name "-NONCE") 0 ,name))
          (equal slot (,(fn2-columns-sym name "-SLOT") 0 ,name))
          (equal generation (,(fn2-columns-sym name "-GENERATION") 0 ,name))
          (= (,(fn2-columns-sym name "-TERMINAL") 0 ,name) 1)
          (= (,(fn2-columns-sym name "-ALIVE") 0 ,name) 1)
          (= (,(fn2-columns-sym name "-PENDING") 0 ,name) 0)
          (= (,(fn2-columns-sym name "-COPIED") 0 ,name) (,(fn2-columns-sym name "-SEED-TOTAL") 0 ,name))
          (= (,(fn2-columns-sym name "-OUTPUT-OFFSET") 0 ,name) (,(fn2-columns-sym name "-OUTPUT-LENGTH") 0 ,name)))
  (let* ((copied (,(fn2-columns-sym name "-COPIED") 0 ,name))
         (fed (,(fn2-columns-sym name "-FED") 0 ,name))
         (il (,(fn2-columns-sym name "-INPUT-LENGTH") 0 ,name))
         (io (,(fn2-columns-sym name "-INPUT-OFFSET") 0 ,name))
         (ol (,(fn2-columns-sym name "-OUTPUT-LENGTH") 0 ,name))
         (oo (,(fn2-columns-sym name "-OUTPUT-OFFSET") 0 ,name))
         (,name (,(fn2-columns-sym name "-PUT") 0 (terminal 3))))
   (mv :ok copied fed il io ol oo ,name))
  (mv :stale 0 0 0 0 0 0 ,name)))
(defun ,(fn2-columns-sym name "-OBSERVE-LIFECYCLE") (cap nonce slot generation serial code count errno ,name)
 (declare (xargs :stobjs ,name :verify-guards nil
  :guard (and (,(fn2-columns-sym name "-WFP") ,name) (= (,(fn2-columns-sym name "-ROWS") ,name) 1))))
 ;; Malformed/stale returns change neither the pending action nor its ledger.
 (if (not (and (member-equal (,(fn2-columns-sym name "-PENDING") 0 ,name) '(1 8 9)) (,(fn2-columns-sym name "-MATCH-P") cap nonce slot generation serial ,name)
               (integerp code) (unsigned-byte-p 64 (abs code))
               (unsigned-byte-p 32 count) (unsigned-byte-p 32 errno))) (mv :stale nil ,name)
 (let* ((action (,(fn2-columns-sym name "-PENDING") 0 ,name))
(offset (,(fn2-columns-sym name "-OFFSET") 0 ,name))
(requested (,(fn2-columns-sym name "-REQUESTED") 0 ,name))
(total (,(fn2-columns-sym name "-SEED-TOTAL") 0 ,name))
(,name (,(fn2-columns-sym name "-PUT") 0
           (raw-negative (if (< code 0) 1 0)) (raw-code (abs code))
           (raw-count count) (raw-errno errno) (pending 0))))
  (cond
((equal action 8)
     (cond
      ((or (< code 0) (not (= count 0)))
       (let ((,name (,(fn2-columns-sym name "-PUT") 0 (pending 8))))
        (mv :state nil ,name)))
      ((< 0 code)
       (let ((,name (,(fn2-columns-sym name "-PUT") 0 (alive 1) (handle-id code))))
        (mv :ok t ,name)))
      (t
       (let ((,name (,(fn2-columns-sym name "-PUT") 0 (terminal 2))))
        (mv :closing t ,name)))))
((equal action 9)
     (if (and (= code 0) (= count 0))
         (let ((,name (,(fn2-columns-sym name "-PUT") 0 (alive 0) (handle-id 0))))
          (mv :ok t ,name))
       (let ((,name (,(fn2-columns-sym name "-PUT") 0 (pending 9))))
        (mv :state nil ,name))))
((not (and (fn2-codec-transfer-counts-p code 0 requested 0) (= count 0)
               (unsigned-byte-p 32 (+ offset code))
               (or (not (member-equal action '(1 5 6))) (< 0 code))))
     (let ((,name (,(fn2-columns-sym name "-PUT") 0 (terminal 2))))
 (mv :closing t ,name)))
((equal action 1)
     (if (<= (+ offset code) total)
         (let ((,name (,(fn2-columns-sym name "-PUT") 0 (copied (+ offset code)))))
 (mv :ok t ,name))
       (let ((,name (,(fn2-columns-sym name "-PUT") 0 (terminal 2))))
 (mv :closing t ,name))))
   (t (mv :state nil ,name))))))
    (verify-guards ,(fn2-columns-sym name "-OBSERVE-LIFECYCLE")
     :hints (("Goal" :in-theory (disable ,@readers))))
    (defthm ,(fn2-columns-sym name "-OBSERVE-LIFECYCLE-WFP")
     (implies (and (,(fn2-columns-sym name "P") ,name) (,wfp ,name) (= (,rows ,name) 1))
      (,wfp (mv-nth 2 (,(fn2-columns-sym name "-OBSERVE-LIFECYCLE") cap nonce slot generation serial code count errno ,name))))
     :hints (("Goal" :in-theory (disable ,@readers))))
    (verify-guards ,(fn2-columns-sym name "-RETIRE") :hints (("Goal" :in-theory (disable ,@readers))))
    (verify-guards ,(fn2-columns-sym name "-RETIRED-P") :hints (("Goal" :in-theory (disable ,@readers))))
    (verify-guards ,(fn2-columns-sym name "-HANDLE") :hints (("Goal" :in-theory (disable ,@readers))))
    (verify-guards ,(fn2-columns-sym name "-SELECTED-P") :hints (("Goal" :in-theory (disable ,@readers)))))))
(defmacro defcodec-transport-lifecycle (name &key (input-quantum-field 'quantum) (output-quantum-field 'quantum))
 `(make-event (value (fn2-codec-transport-lifecycle-events ',name ',input-quantum-field ',output-quantum-field (w state)))))

; Per-operation application progress is separate from per-capability staging.
; Codec policy adds status/flush fields; no native counter authorizes a span.
(defconst *fn2-codec-operation-columns*
 '((cap :u32) (nonce :u60) (slot :u32) (generation :u60) (extent :u32)
   (source-progress :u32) (sink-progress :u32)
   (parent-serial :u60) (terminal :bool) (carrier-closed :bool) (last-serial :u60) (pending-serial :u60) (pending-action :u8)
   (observed-serial :u60) (observed-action :u8) (observed-used :u32) (observed-made :u32)
   (source-count :u32) (sink-count :u32)))
; A productive Receive cannot use :cancelled: the shared terminal ABI erases
; cancelled input counts. Output cancellation retains accepted application
; progress; it does not claim that buffered ciphertext reached the peer.
(defun fn2-codec-cancel-values (receivep progress extent)
 (declare (xargs :guard t))
 (cond ((not (and (booleanp receivep) (unsigned-byte-p 32 progress)
                  (unsigned-byte-p 32 extent) (<= progress extent)))
        (mv :bounds nil 0 nil))
       ((and receivep (< 0 progress)) (mv :productive :ok progress nil))
       (t (mv :cancelled :cancelled progress t))))

; Composite operation effects preserve the concrete column recognizer as
; well as its row shape. Callers need both for opaque scalar projections.
(defun fn2-codec-operation-type-events (name specs readers)
 (declare (xargs :verify-guards nil))
 (if (atom specs) nil
  (let* ((spec (car specs)) (suffix (car spec)) (args (cadr spec))
         (one-row (caddr spec)) (fn (fn2-columns-sym name suffix))
         (p (fn2-columns-sym name "P")) (wfp (fn2-columns-sym name "-WFP"))
         (rows (fn2-columns-sym name "-ROWS")))
   (cons
    `(defthm ,(fn2-columns-sym fn "-PRESERVES-TYPE")
      (implies (and (,p ,name) (,wfp ,name) ,@(if one-row `((= (,rows ,name) 1)) nil))
       (,p (mv-nth 1 (,fn ,@args ,name))))
      :hints (("Goal" :in-theory (disable ,@readers))))
    (fn2-codec-operation-type-events name (cdr specs) readers)))))

(defmacro defcodec-operation (name policy-columns)
 (let ((start (fn2-columns-sym name "-INIT-EPOCH"))
       (readers (cons (fn2-columns-sym name "-ROWS")
                      (fn2-columns-projection-readers name (append *fn2-codec-operation-columns* policy-columns))))
       (wfp (fn2-columns-sym name "-WFP"))
       (rows (fn2-columns-sym name "-ROWS"))
       (init (fn2-columns-sym name "-INIT"))
       (put (fn2-columns-sym name "-PUT")))
  `(progn
    (defcolumns ,name ,(append *fn2-codec-operation-columns* policy-columns) :rows-bound 2)
    ; Internal reset is called only by checked external/child binding.
    (defun ,start (cap nonce slot generation extent parent-serial last-serial ,name)
     (declare (xargs :stobjs ,name :verify-guards nil
      :guard (and (,wfp ,name) (unsigned-byte-p 32 cap) (unsigned-byte-p 60 nonce)
                  (unsigned-byte-p 32 slot) (unsigned-byte-p 60 generation)
                  (unsigned-byte-p 32 extent) (unsigned-byte-p 60 parent-serial)
                  (unsigned-byte-p 60 last-serial))))
     (let* ((,name (,init 1 ,name))
            (,name (,put 0 (cap cap) (nonce nonce) (slot slot) (generation generation)
                            (extent extent) (parent-serial parent-serial) (last-serial last-serial))))
      (mv :ok ,name)))
    (verify-guards ,start :hints (("Goal" :in-theory (disable ,@readers))))
    (defthm ,(fn2-columns-sym name "-INIT-EPOCH-WFP")
     (implies (and (,(fn2-columns-sym name "P") ,name) (,wfp ,name)
                   (unsigned-byte-p 32 cap) (unsigned-byte-p 60 nonce)
                   (unsigned-byte-p 32 slot) (unsigned-byte-p 60 generation)
                   (unsigned-byte-p 32 extent) (unsigned-byte-p 60 parent-serial)
                   (unsigned-byte-p 60 last-serial))
      (,wfp (mv-nth 1 (,start cap nonce slot generation extent parent-serial last-serial ,name))))
     :hints (("Goal" :in-theory (disable ,@readers))))
    (defthm ,(fn2-columns-sym name "-INIT-EPOCH-PRESERVES-TYPE")
     (implies (and (,(fn2-columns-sym name "P") ,name) (,wfp ,name)
                   (unsigned-byte-p 32 cap) (unsigned-byte-p 60 nonce)
                   (unsigned-byte-p 32 slot) (unsigned-byte-p 60 generation)
                   (unsigned-byte-p 32 extent) (unsigned-byte-p 60 parent-serial)
                   (unsigned-byte-p 60 last-serial))
      (,(fn2-columns-sym name "P")
       (mv-nth 1 (,start cap nonce slot generation extent parent-serial last-serial ,name))))
     :hints (("Goal" :in-theory (disable ,@readers))))
    (defun ,(fn2-columns-sym name "-BIND") (cap nonce slot generation extent ,name)
     (declare (xargs :stobjs ,name :verify-guards nil :guard (,wfp ,name)))
     (cond
      ((not (and (unsigned-byte-p 32 cap) (unsigned-byte-p 60 nonce)
                 (unsigned-byte-p 32 slot) (unsigned-byte-p 60 generation)
                 (unsigned-byte-p 32 extent))) (mv :bounds ,name))
      ((= (,rows ,name) 0)
       (,start cap nonce slot generation extent 0 0 ,name))
      ((not (= (,rows ,name) 1)) (mv :state ,name))
      ((and (= (,(fn2-columns-sym name "-PARENT-SERIAL") 0 ,name) 0)
            (equal cap (,(fn2-columns-sym name "-CAP") 0 ,name))
            (equal nonce (,(fn2-columns-sym name "-NONCE") 0 ,name))
            (equal slot (,(fn2-columns-sym name "-SLOT") 0 ,name))
            (equal generation (,(fn2-columns-sym name "-GENERATION") 0 ,name))
            (equal extent (,(fn2-columns-sym name "-EXTENT") 0 ,name)))
       (mv :ok ,name))
      (t (mv :stale ,name))))
    (defun ,(fn2-columns-sym name "-BIND-CHILD") (cap nonce slot generation extent parent-serial ,name)
     (declare (xargs :stobjs ,name :verify-guards nil :guard (,wfp ,name)))
     (cond
      ((not (and (unsigned-byte-p 32 cap) (unsigned-byte-p 60 nonce)
                 (unsigned-byte-p 32 slot) (unsigned-byte-p 60 generation)
                 (unsigned-byte-p 32 extent) (posp parent-serial)
                 (unsigned-byte-p 60 parent-serial))) (mv :bounds ,name))
      ((= (,rows ,name) 0) (,start cap nonce slot generation extent parent-serial 0 ,name))
      ((not (= (,rows ,name) 1)) (mv :state ,name))
      ((not (and (equal cap (,(fn2-columns-sym name "-CAP") 0 ,name))
                  (equal nonce (,(fn2-columns-sym name "-NONCE") 0 ,name))
                  (equal slot (,(fn2-columns-sym name "-SLOT") 0 ,name))
                  (equal generation (,(fn2-columns-sym name "-GENERATION") 0 ,name))))
       (mv :stale ,name))
      ((and (equal parent-serial (,(fn2-columns-sym name "-PARENT-SERIAL") 0 ,name))
            (equal extent (,(fn2-columns-sym name "-EXTENT") 0 ,name))) (mv :ok ,name))
      ((and (< 0 (,(fn2-columns-sym name "-PARENT-SERIAL") 0 ,name))
            (= (,(fn2-columns-sym name "-TERMINAL") 0 ,name) 1)
            (= (,(fn2-columns-sym name "-PENDING-SERIAL") 0 ,name) 0)
            (< (,(fn2-columns-sym name "-PARENT-SERIAL") 0 ,name) parent-serial))
       (,start cap nonce slot generation extent parent-serial
               (,(fn2-columns-sym name "-LAST-SERIAL") 0 ,name) ,name))
      (t (mv :state ,name))))
    ; Codec policy calls FINISH only after its own terminal/drain predicate.
    (defun ,(fn2-columns-sym name "-FINISH") (,name)
     (declare (xargs :stobjs ,name :verify-guards nil :guard (and (,wfp ,name) (= (,rows ,name) 1))))
     (if (not (= (,(fn2-columns-sym name "-PENDING-SERIAL") 0 ,name) 0)) (mv :pending ,name)
       (let ((,name (,put 0 (terminal 1)))) (mv :ok ,name))))
    ; Codec policy supplies its public-input action (TLS12, DEFLATE10).
    ; The shared operation ledger supplies accepted incarnation and prefix.
    (defun ,(fn2-columns-sym name "-INPUT-PREFIX") (serial action expected-action offset count ,name)
     (declare (xargs :stobjs ,name :verify-guards nil
      :guard (and (,wfp ,name) (= (,rows ,name) 1))))
     (cond
      ((or (not (equal action expected-action)) (equal count 0)
           (not (= (,(fn2-columns-sym name "-PARENT-SERIAL") 0 ,name) 0))) (mv :none 0 0))
      ((not (and (posp serial) (unsigned-byte-p 60 serial)
                  (posp expected-action) (unsigned-byte-p 8 expected-action)
                  (unsigned-byte-p 32 offset) (posp count) (unsigned-byte-p 32 count)
                  (= (,(fn2-columns-sym name "-PENDING-SERIAL") 0 ,name) 0)
                  (equal (,(fn2-columns-sym name "-OBSERVED-ACTION") 0 ,name) expected-action)
                  (= (,(fn2-columns-sym name "-LAST-SERIAL") 0 ,name) serial)
                  (= (,(fn2-columns-sym name "-OBSERVED-SERIAL") 0 ,name) serial)
                  (equal count (,(fn2-columns-sym name "-OBSERVED-MADE") 0 ,name))
                  (= (+ offset count) (,(fn2-columns-sym name "-SINK-PROGRESS") 0 ,name))
                  (<= (+ offset count) (,(fn2-columns-sym name "-EXTENT") 0 ,name))))
       (mv :stale 0 0))
      (t (mv :input-prefix offset count))))
    (defun ,(fn2-columns-sym name "-CANCEL") (receivep ,name)
     (declare (xargs :stobjs ,name :verify-guards nil :guard (and (,wfp ,name) (= (,rows ,name) 1))))
     (cond ((not (booleanp receivep)) (mv :bounds nil 0 nil ,name))
           ((not (= (,(fn2-columns-sym name "-PENDING-SERIAL") 0 ,name) 0))
            (mv :pending nil 0 nil ,name))
           ((= (,(fn2-columns-sym name "-TERMINAL") 0 ,name) 1)
            (mv :too-late nil 0 nil ,name))
           ((not (= (,(fn2-columns-sym name "-CARRIER-CLOSED") 0 ,name) 1))
            (mv :live nil 0 nil ,name))
           (t
            (mv-let (decision code count won)
             (fn2-codec-cancel-values receivep
              (if receivep (,(fn2-columns-sym name "-SINK-PROGRESS") 0 ,name)
                           (,(fn2-columns-sym name "-SOURCE-PROGRESS") 0 ,name))
              (,(fn2-columns-sym name "-EXTENT") 0 ,name))
             (if (eq decision :bounds) (mv :bounds nil 0 nil ,name)
              (mv-let (finished ,name) (,(fn2-columns-sym name "-FINISH") ,name)
               (declare (ignore finished))
               (mv decision code count won ,name)))))))
    (defun ,(fn2-columns-sym name "-REQUESTABLE-P") (serial action source-count sink-count ,name)
     (declare (xargs :stobjs ,name :verify-guards nil :guard (and (,wfp ,name) (= (,rows ,name) 1))))
     (and (posp serial) (unsigned-byte-p 60 serial)
                   (< (,(fn2-columns-sym name "-LAST-SERIAL") 0 ,name) serial)
                   (posp action) (unsigned-byte-p 8 action)
                   (unsigned-byte-p 32 source-count) (unsigned-byte-p 32 sink-count)
                   (= (,(fn2-columns-sym name "-TERMINAL") 0 ,name) 0)
                   (= (,(fn2-columns-sym name "-PENDING-SERIAL") 0 ,name) 0)
                   (<= (+ (,(fn2-columns-sym name "-SOURCE-PROGRESS") 0 ,name) source-count)
                       (,(fn2-columns-sym name "-EXTENT") 0 ,name))
                   (<= (+ (,(fn2-columns-sym name "-SINK-PROGRESS") 0 ,name) sink-count)
                       (,(fn2-columns-sym name "-EXTENT") 0 ,name))))
    (defun ,(fn2-columns-sym name "-REQUEST") (serial action source-count sink-count ,name)
     (declare (xargs :stobjs ,name :verify-guards nil :guard (and (,wfp ,name) (= (,rows ,name) 1))))
     (if (not (,(fn2-columns-sym name "-REQUESTABLE-P") serial action source-count sink-count ,name))
         (mv :bounds ,name)
       (let ((,name (,put 0 (last-serial serial) (pending-serial serial) (pending-action action)
                            (source-count source-count) (sink-count sink-count))))
        (mv :ok ,name))))
    (defun ,(fn2-columns-sym name "-OBSERVABLE-P") (serial used made ,name)
     (declare (xargs :stobjs ,name :verify-guards nil :guard (and (,wfp ,name) (= (,rows ,name) 1))))
     (and (posp serial)
                   (equal serial (,(fn2-columns-sym name "-PENDING-SERIAL") 0 ,name))
                   (fn2-codec-transfer-counts-p used made
                    (,(fn2-columns-sym name "-SOURCE-COUNT") 0 ,name)
                    (,(fn2-columns-sym name "-SINK-COUNT") 0 ,name))
                   (<= (+ (,(fn2-columns-sym name "-SOURCE-PROGRESS") 0 ,name) used)
                       (,(fn2-columns-sym name "-EXTENT") 0 ,name))
                   (<= (+ (,(fn2-columns-sym name "-SINK-PROGRESS") 0 ,name) made)
                       (,(fn2-columns-sym name "-EXTENT") 0 ,name))))
    (defun ,(fn2-columns-sym name "-OBSERVE") (serial used made ,name)
     (declare (xargs :stobjs ,name :verify-guards nil :guard (and (,wfp ,name) (= (,rows ,name) 1))))
     (if (not (,(fn2-columns-sym name "-OBSERVABLE-P") serial used made ,name))
         (mv :bounds ,name)
       (let* ((next-source (+ (,(fn2-columns-sym name "-SOURCE-PROGRESS") 0 ,name) used))
              (next-sink (+ (,(fn2-columns-sym name "-SINK-PROGRESS") 0 ,name) made))
              (action (,(fn2-columns-sym name "-PENDING-ACTION") 0 ,name))
              (,name (,put 0 (source-progress next-source) (sink-progress next-sink)
                            (observed-serial serial) (observed-action action) (observed-used used) (observed-made made)
                            (pending-serial 0) (pending-action 0) (source-count 0) (sink-count 0))))
        (mv :ok ,name))))
    (verify-guards ,(fn2-columns-sym name "-BIND") :hints (("Goal" :in-theory (disable ,@readers))))
    (verify-guards ,(fn2-columns-sym name "-BIND-CHILD") :hints (("Goal" :in-theory (disable ,@readers))))
    (verify-guards ,(fn2-columns-sym name "-FINISH") :hints (("Goal" :in-theory (disable ,@readers))))
    (verify-guards ,(fn2-columns-sym name "-INPUT-PREFIX") :hints (("Goal" :in-theory (disable ,@readers))))
    (verify-guards ,(fn2-columns-sym name "-CANCEL") :hints (("Goal" :in-theory (disable ,@readers))))
    (verify-guards ,(fn2-columns-sym name "-REQUESTABLE-P") :hints (("Goal" :in-theory (disable ,@readers))))
    (verify-guards ,(fn2-columns-sym name "-REQUEST") :hints (("Goal" :in-theory (disable ,@readers))))
    (verify-guards ,(fn2-columns-sym name "-OBSERVABLE-P") :hints (("Goal" :in-theory (disable ,@readers))))
    (verify-guards ,(fn2-columns-sym name "-OBSERVE") :hints (("Goal" :in-theory (disable ,@readers))))
    ,@(fn2-codec-operation-type-events name
       '(("-BIND" (cap nonce slot generation extent) nil)
         ("-BIND-CHILD" (cap nonce slot generation extent parent-serial) nil)
         ("-REQUEST" (serial action source-count sink-count) t)
         ("-OBSERVE" (serial used made) t)
         ("-FINISH" () t)) readers)
    (defthm ,(fn2-columns-sym name "-BIND-OK-INPUTS")
     (implies (equal (mv-nth 0 (,(fn2-columns-sym name "-BIND") cap nonce slot generation extent ,name)) :ok)
      (and (unsigned-byte-p 32 cap) (unsigned-byte-p 60 nonce)
           (unsigned-byte-p 32 slot) (unsigned-byte-p 60 generation) (unsigned-byte-p 32 extent)))
     :hints (("Goal" :in-theory (disable ,@readers))))
    (defthm ,(fn2-columns-sym name "-BIND-CHILD-OK-INPUTS")
     (implies (equal (mv-nth 0 (,(fn2-columns-sym name "-BIND-CHILD") cap nonce slot generation extent parent-serial ,name)) :ok)
      (and (unsigned-byte-p 32 cap) (unsigned-byte-p 60 nonce)
           (unsigned-byte-p 32 slot) (unsigned-byte-p 60 generation) (unsigned-byte-p 32 extent)
           (posp parent-serial) (unsigned-byte-p 60 parent-serial)))
     :hints (("Goal" :in-theory (disable ,@readers))))
    (defthm ,(fn2-columns-sym name "-BIND-WFP")
     (implies (and (,(fn2-columns-sym name "P") ,name) (,wfp ,name))
      (,wfp (mv-nth 1 (,(fn2-columns-sym name "-BIND") cap nonce slot generation extent ,name))))
     :hints (("Goal" :in-theory (disable ,@readers))))
    (defthm ,(fn2-columns-sym name "-REQUEST-WFP")
     (implies (and (,(fn2-columns-sym name "P") ,name) (,wfp ,name) (= (,rows ,name) 1))
      (,wfp (mv-nth 1 (,(fn2-columns-sym name "-REQUEST") serial action source-count sink-count ,name))))
     :hints (("Goal" :in-theory (disable ,@readers))))
    (defthm ,(fn2-columns-sym name "-OBSERVE-ROWS")
     (implies (and (,(fn2-columns-sym name "P") ,name) (,wfp ,name) (= (,rows ,name) 1))
      (equal (,rows (mv-nth 1 (,(fn2-columns-sym name "-OBSERVE") serial used made ,name))) 1))
     :hints (("Goal" :in-theory (disable ,@readers))))
    (defthm ,(fn2-columns-sym name "-OBSERVE-WFP")
     (implies (and (,(fn2-columns-sym name "P") ,name) (,wfp ,name) (= (,rows ,name) 1))
      (,wfp (mv-nth 1 (,(fn2-columns-sym name "-OBSERVE") serial used made ,name))))
     :hints (("Goal" :in-theory (disable ,@readers))))
    (defthm ,(fn2-columns-sym name "-OBSERVE-REFUSAL-FRAME-BY-DEFINITION")
     (implies (not (,(fn2-columns-sym name "-OBSERVABLE-P") serial used made ,name))
      (equal (mv-nth 1 (,(fn2-columns-sym name "-OBSERVE") serial used made ,name)) ,name))
     :hints (("Goal" :in-theory (disable ,@readers))))
    (defthm ,(fn2-columns-sym name "-OBSERVE-ACCEPTED-RECEIPT")
     (implies (and (,(fn2-columns-sym name "P") ,name) (,wfp ,name) (= (,rows ,name) 1)
                   (,(fn2-columns-sym name "-OBSERVABLE-P") serial used made ,name))
      (and
       (equal (,(fn2-columns-sym name "-OBSERVED-SERIAL") 0
                (mv-nth 1 (,(fn2-columns-sym name "-OBSERVE") serial used made ,name))) serial)
       (equal (,(fn2-columns-sym name "-OBSERVED-ACTION") 0
                (mv-nth 1 (,(fn2-columns-sym name "-OBSERVE") serial used made ,name)))
              (,(fn2-columns-sym name "-PENDING-ACTION") 0 ,name))
       (equal (,(fn2-columns-sym name "-OBSERVED-USED") 0

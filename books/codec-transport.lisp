; Shared allocation, bounded upgrade action admission, and reserved cleanup.
; PLAN is guarded codec policy; its width theorem must precede instantiation.
(defun fn2-codec-transport-upgrade-events (name plan quantum-field status-field world)
 (declare (xargs :verify-guards nil))
 (let ((quantum (fn2-columns-sym name (concatenate 'string "-" (symbol-name quantum-field))))
       (status (and status-field (fn2-columns-sym name (concatenate 'string "-" (symbol-name status-field)))))
       (readers (cons (fn2-columns-sym name "-ROWS")
                 (fn2-columns-projection-readers name
                  (fn2-decl-get :columns (fn2-decl-row (list :columns name) world))))))
  `(progn
(defun ,(fn2-columns-sym name "-NEXT") (room pending ,name)
 (declare (xargs :stobjs ,name :verify-guards nil
  :guard (and (,(fn2-columns-sym name "-WFP") ,name) (= (,(fn2-columns-sym name "-ROWS") ,name) 1))))
 (cond
  ((not (equal (,(fn2-columns-sym name "-PENDING") 0 ,name) 0)) (mv :pending 0 0 0 0 ,name))
  ((equal (,(fn2-columns-sym name "-TERMINAL") 0 ,name) 1) (mv :done 0 0 0 0 ,name))
  ((member-equal (,(fn2-columns-sym name "-TERMINAL") 0 ,name) '(2 4))
   (if (= (,(fn2-columns-sym name "-ALIVE") 0 ,name) 0)
       (mv (if (= (,(fn2-columns-sym name "-TERMINAL") 0 ,name) 4) :retired :failed)
           0 0 0 0 ,name)
     (if (or (= (,(fn2-columns-sym name "-CLEANUP-CREDIT") 0 ,name) 0)
             (= (,(fn2-columns-sym name "-SERIAL") 0 ,name) #xfffffffffffffff))
         (mv :state 0 0 0 0 ,name)
       (let* ((serial (+ 1 (,(fn2-columns-sym name "-SERIAL") 0 ,name)))
              (,name (,(fn2-columns-sym name "-PUT") 0
                 (pending 9) (offset 0) (requested 0) (serial serial) (cleanup-credit 0))))
        (mv :cleanup 9 0 0 serial ,name)))))
  ((not (= (,(fn2-columns-sym name "-TERMINAL") 0 ,name) 0))
   (mv :state 0 0 0 0 ,name))
  (t
   (mv-let (code action offset count)
    (if (= (,(fn2-columns-sym name "-ALIVE") 0 ,name) 0)
        (mv :act 8 (,(fn2-columns-sym name "-WINDOW") 0 ,name) 0)
     (,plan
      (,(fn2-columns-sym name "-SEED-TOTAL") 0 ,name)
      (,(fn2-columns-sym name "-COPIED") 0 ,name) (,(fn2-columns-sym name "-FED") 0 ,name)
      (,(fn2-columns-sym name "-INPUT-LENGTH") 0 ,name) (,(fn2-columns-sym name "-INPUT-OFFSET") 0 ,name)
      (,(fn2-columns-sym name "-OUTPUT-LENGTH") 0 ,name) (,(fn2-columns-sym name "-OUTPUT-OFFSET") 0 ,name)
      ,(if status `(,status 0 ,name) 0) room pending
      (,quantum 0 ,name)))
    (cond
     ((eq code :done)
      (let ((,name (,(fn2-columns-sym name "-PUT") 0 (terminal 1))))
 (mv :done 0 0 0 0 ,name)))
     ((or (not (eq code :act)) (zp (,(fn2-columns-sym name "-BUDGET") 0 ,name))
          (<= #xffffffffffffffe (,(fn2-columns-sym name "-SERIAL") 0 ,name)))
      (let ((,name (,(fn2-columns-sym name "-PUT") 0 (terminal 2))))
 (mv :closing 0 0 0 0 ,name)))
     (t
      (let ((serial (+ 1 (,(fn2-columns-sym name "-SERIAL") 0 ,name)))
            (budget (- (,(fn2-columns-sym name "-BUDGET") 0 ,name) 1)))
       (let ((,name (,(fn2-columns-sym name "-PUT") 0 (pending action) (offset offset) (requested count)
          (serial serial) (budget budget))))
 (mv :act action offset count serial
        ,name)))))))))
    (verify-guards ,(fn2-columns-sym name "-NEXT")
     :hints (("Goal" :in-theory (disable ,plan ,@readers))))
    (defthm ,(fn2-columns-sym name "-NEXT-WFP")
     (implies (and (,(fn2-columns-sym name "P") ,name)
                   (= (,(fn2-columns-sym name "-ROWS") ,name) 1)
                   (,(fn2-columns-sym name "-WFP") ,name))
      (,(fn2-columns-sym name "-WFP")
       (mv-nth 5 (,(fn2-columns-sym name "-NEXT") room pending ,name))))
     :hints (("Goal" :in-theory (disable ,plan ,@readers)))))))
(defmacro defcodec-transport-upgrade (name plan &key (input-quantum-field 'quantum) (status-field 'upgrade-status))
 `(make-event (value (fn2-codec-transport-upgrade-events ',name ',plan ',input-quantum-field ',status-field (w state)))))

; Common finite retained-loan copy policy. Codecs choose only what follows it.
(defun fn2-codec-copy-plan (total copied fed input-length input-offset output-length output-offset ssl room pending quantum)
 (declare (ignore ssl))
 (declare (xargs :guard t))
 (if (not (and (unsigned-byte-p 32 total) (natp copied) (<= copied total)
               (natp fed) (<= fed copied)
               (unsigned-byte-p 32 input-length) (natp input-offset) (<= input-offset input-length)
               (unsigned-byte-p 32 output-length) (natp output-offset) (<= output-offset output-length)
               (unsigned-byte-p 32 room) (unsigned-byte-p 32 pending)
               (posp quantum) (unsigned-byte-p 32 quantum))) (mv :bounds 0 0 0)
  (cond ((< copied total) (mv :act 1 copied (min quantum (- total copied)))) (t (mv :done 0 0 0)))))
(defthm fn2-codec-copy-plan-widths
 (and (unsigned-byte-p 8 (mv-nth 1 (fn2-codec-copy-plan total copied fed input-length input-offset output-length output-offset ssl room pending quantum)))
      (unsigned-byte-p 32 (mv-nth 2 (fn2-codec-copy-plan total copied fed input-length input-offset output-length output-offset ssl room pending quantum)))
      (unsigned-byte-p 32 (mv-nth 3 (fn2-codec-copy-plan total copied fed input-length input-offset output-length output-offset ssl room pending quantum)))))

; C-owned checkpoint source admission over the actual B installed directory.
; This entry packer grants no completion or durability status. The page builder
; must cover every deterministic ordinal and retain each journal allocation.
; The existing exact installed-chain edge protects source storage before the
; allocator copy freezes; root dependency transfer must precede its release.
(in-package "ACL2")
(include-book "event-proof-format")
(include-book "machines-b")
(include-book "c-snapshot")
(fn2-book-layer :c)

(defun fn2-event-proof-pack-entry (token ordinal base slot gen off scratch sgen okind oslot ogen
                                  fn2-csnapshot fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-csnapshot fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests fn2-fields fn2-pool)
  :guard (and (fn2-csnapshot-wfp fn2-csnapshot) (fn2-commit-root-wfp fn2-commit-root)
              (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges) (fn2-fc-wfp fn2-fc) (fn2-digests-wfp fn2-digests)
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (fn2-csnapshot-ownerp token okind oslot ogen fn2-csnapshot)
                     (equal (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-held*)))
       (mv :snapshot off fn2-fields fn2-pool))
      (cut (fn2-csnapshot-cut-commit 0 fn2-csnapshot))
      (events (fn2-csnapshot-cut-event 0 fn2-csnapshot))
      (commit (+ 1 (nfix ordinal)))
      ((unless (and (natp ordinal) (< ordinal cut)
                     (< 0 (fn2-commit-root-rows fn2-commit-root))
                     (< commit (fn2-commit-root-rows fn2-commit-root))
                     (<= cut (fn2-commit-root-installed 0 fn2-commit-root))
                     (<= cut (fn2-commit-root-published 0 fn2-commit-root))
                     (natp base) (<= (+ base *fn2-event-proof-entry-num-fields*) (fn2-fields-rows fn2-fields))
                     (unsigned-byte-p 32 off)
                     (equal off (+ *fn2-checkpoint-map-entries-start*
                                   (* (mod ordinal *fn2-event-proof-slots*) *fn2-event-proof-entry-width*)))
                     (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen)
                     (unsigned-byte-p 32 scratch) (unsigned-byte-p 60 sgen) (not (equal slot scratch))
                     (eq (fn2-pool-workspace-code slot gen okind oslot ogen fn2-pool) :ok)
                     (eq (fn2-pool-workspace-code scratch sgen okind oslot ogen fn2-pool) :ok)
                     (<= *fn2-format-page-size* (fn2-pool-cap slot fn2-pool))
                     (<= 32 (fn2-pool-cap scratch fn2-pool))))
       (mv :bounds off fn2-fields fn2-pool))
      (extent (fn2-commit-root-extent commit fn2-commit-root))
      (first (fn2-commit-root-first-key commit fn2-commit-root))
      (members (fn2-commit-root-members commit fn2-commit-root))
      (seal (+ (* *fn2-digest-stride* (fn2-fc-rows fn2-fc)) commit))
      ((unless (and (equal (fn2-commit-root-parent commit fn2-commit-root) (- commit 1))
                     (equal (fn2-commit-root-seal-ready commit fn2-commit-root) 1)
                     (posp first) (posp members) (<= (+ first members -1) events)
                     (equal first (if (equal commit 1) 1
                                    (+ (fn2-commit-root-first-key (- commit 1) fn2-commit-root)
                                       (fn2-commit-root-members (- commit 1) fn2-commit-root))))
                     (or (< commit cut) (equal (+ first members -1) events))
                     (fn2-alloc-slotp extent fn2-extents)
                     (or (equal (fn2-extents-state extent fn2-extents) *fn2-extent-state-allocated*)
                         (equal (fn2-extents-state extent fn2-extents) *fn2-extent-state-retire-pending*))
                     (equal (fn2-extents-owner-kind extent fn2-extents) *fn2-commit-kind*)
                     (equal (fn2-extents-owner-id extent fn2-extents) commit)
                     (equal (fn2-extents-release-pending extent fn2-extents) 0)
                     (fn2-alloc-edge-matchesp (+ 7 (* 2 extent)) commit extent
                       (fn2-extents-epoch extent fn2-extents) (fn2-extents-counter extent fn2-extents)
                       :installed-root fn2-alloc-edges)
                     (fn2-digest-rowp seal fn2-digests)))
       (mv :source off fn2-fields fn2-pool))
      ((mv code fn2-pool) (fn2-digest-store 32 seal scratch sgen 0 okind oslot ogen fn2-digests fn2-pool))
      ((unless (eq code :ok)) (mv code off fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-event-proof-entry-field-commit*) commit fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-event-proof-entry-field-event-first*) first fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-event-proof-entry-field-members*) members fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-event-proof-entry-field-extent*) extent fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-event-proof-entry-field-writer-epoch*) (fn2-extents-epoch extent fn2-extents) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-event-proof-entry-field-allocation*) (fn2-extents-counter extent fn2-extents) fn2-fields))
      (fn2-fields (fn2-fields-put (+ base *fn2-event-proof-entry-field-semantic-seal*)
                    (value 1) (ref-slot scratch) (ref-gen sgen) (ref-off 0) (ref-len 32))))
  (fn2-event-proof-entry-encode base slot gen off okind oslot ogen fn2-fields fn2-pool)))
(fn2-fields-preserves fn2-event-proof-pack-entry
 (token ordinal base slot gen off scratch sgen okind oslot ogen
  fn2-csnapshot fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests fn2-fields fn2-pool)
 :carriers ((fn2-fields 2 :prefix "-FIELDS") (fn2-pool 3 :prefix "-POOL")))

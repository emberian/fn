; C-owned checkpoint source admission over the actual B installed directory.
; This entry packer grants no completion or durability status. The page builder
; must cover every deterministic ordinal and retain each journal allocation.
; The existing exact installed-chain edge protects source storage before the
; allocator copy freezes; root dependency transfer must precede its release.
(in-package "ACL2")
(include-book "event-proof-format")
(include-book "machines-b")
(include-book "event-catalog")
(include-book "c-snapshot")
(fn2-book-layer :c)


; Exact source selection shared by the live packer and verifier. A base
; predecessor alone is insufficient to serve a canonical historical record.
(defun fn2-event-source-lookup (batch fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-commit-root fn2-checkpoint-restore-events fn2-checkpoint-restore-events-work)
 (declare (xargs :stobjs (fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-commit-root fn2-checkpoint-restore-events fn2-checkpoint-restore-events-work)
 :guard (and (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-commit-root-wfp fn2-commit-root) (fn2-checkpoint-restore-events-wfp fn2-checkpoint-restore-events) (fn2-checkpoint-restore-events-work-wfp fn2-checkpoint-restore-events-work))))
 (cond ((not (and (unsigned-byte-p 60 batch) (< 0 (fn2-commit-root-rows fn2-commit-root)))) (mv :source nil 0))
       ((= batch 0) (mv :genesis nil 0))
       ((<= batch (fn2-commit-root-base-batch 0 fn2-commit-root))
        (mv-let (code row) (fn2-event-catalog-lookup batch fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-commit-root fn2-checkpoint-restore-events fn2-checkpoint-restore-events-work)
         (mv code t row)))
       (t (mv-let (code row) (fn2-commit-directory-lookup batch fn2-commit-root) (mv code nil row)))))
(defun fn2-event-source-store-seal (i row slot gen off kind owner generation fn2-checkpoint-restore-events-work fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-restore-events-work fn2-pool) :measure (nfix (- 32 (nfix i)))
 :guard (and (fn2-checkpoint-restore-events-work-wfp fn2-checkpoint-restore-events-work) (fn2-pool-wfp fn2-pool)
             (natp i) (<= i 32) (natp row) (natp off)
             (<= (* 32 (+ 1 row)) (fn2-checkpoint-restore-events-work-seals-length fn2-checkpoint-restore-events-work)))))
 (if (>= (nfix i) 32) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen (+ off i)
    (fn2-checkpoint-restore-events-work-sealsi (+ (* 32 row) i) fn2-checkpoint-restore-events-work) kind owner generation fn2-pool)
   (if (not (eq code :ok)) (mv code fn2-pool)
    (fn2-event-source-store-seal (+ 1 i) row slot gen off kind owner generation fn2-checkpoint-restore-events-work fn2-pool)))))
(defun fn2-event-proof-pack-entry (token ordinal base slot gen off scratch sgen okind oslot ogen
                                  fn2-csnapshot fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests fn2-fields fn2-pool fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-events fn2-checkpoint-restore-events-work fn2-ops)
 (declare (xargs :stobjs (fn2-csnapshot fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests fn2-fields fn2-pool fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-events fn2-checkpoint-restore-events-work fn2-ops)
  :guard (and (fn2-csnapshot-wfp fn2-csnapshot) (fn2-commit-root-wfp fn2-commit-root)
              (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges) (fn2-fc-wfp fn2-fc) (fn2-digests-wfp fn2-digests)
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-checkpoint-restore-events-wfp fn2-checkpoint-restore-events) (fn2-checkpoint-restore-events-work-wfp fn2-checkpoint-restore-events-work) (fn2-ops-wfp fn2-ops))))
 (b* (((unless (and (fn2-csnapshot-ownerp token okind oslot ogen fn2-csnapshot) (= (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-held*)))
       (mv :snapshot off fn2-fields fn2-pool))
      (cut (fn2-csnapshot-cut-commit 0 fn2-csnapshot)) (events (fn2-csnapshot-cut-event 0 fn2-csnapshot))
      (commit (+ 1 (nfix ordinal)))
      ((unless (and (natp ordinal) (< ordinal cut) (< 0 (fn2-commit-root-rows fn2-commit-root))
                    (<= cut (fn2-commit-root-installed 0 fn2-commit-root)) (<= cut (fn2-commit-root-published 0 fn2-commit-root))
                    (natp base) (<= (+ base *fn2-event-proof-entry-num-fields*) (fn2-fields-rows fn2-fields))
                    (unsigned-byte-p 32 off) (= off (+ *fn2-checkpoint-map-entries-start* (* (mod ordinal *fn2-event-proof-slots*) *fn2-event-proof-entry-width*)))
                    (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen) (unsigned-byte-p 32 scratch) (unsigned-byte-p 60 sgen) (not (= slot scratch))
                    (eq (fn2-pool-workspace-code slot gen okind oslot ogen fn2-pool) :ok) (eq (fn2-pool-workspace-code scratch sgen okind oslot ogen fn2-pool) :ok)
                    (<= *fn2-format-page-size* (fn2-pool-cap slot fn2-pool)) (<= 32 (fn2-pool-cap scratch fn2-pool))))
       (mv :bounds off fn2-fields fn2-pool))
      ((mv source archived row) (fn2-event-source-lookup commit fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-commit-root fn2-checkpoint-restore-events fn2-checkpoint-restore-events-work))
      ((mv predecessor prev-archived prev) (fn2-event-source-lookup (- commit 1) fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-commit-root fn2-checkpoint-restore-events fn2-checkpoint-restore-events-work))
      ((unless (and (eq source :ok) (or (= commit 1) (eq predecessor :ok)))) (mv :source off fn2-fields fn2-pool))
      (extent (if archived (fn2-checkpoint-restore-events-work-extent row fn2-checkpoint-restore-events-work) (fn2-commit-root-extent row fn2-commit-root)))
      (first (if archived (fn2-checkpoint-restore-events-work-first row fn2-checkpoint-restore-events-work) (fn2-commit-root-first-key row fn2-commit-root)))
      (members (if archived (fn2-checkpoint-restore-events-work-members row fn2-checkpoint-restore-events-work) (fn2-commit-root-members row fn2-commit-root)))
      (expected-first (if (= commit 1) 1
       (if prev-archived (+ (fn2-checkpoint-restore-events-work-first prev fn2-checkpoint-restore-events-work) (fn2-checkpoint-restore-events-work-members prev fn2-checkpoint-restore-events-work))
         (+ (fn2-commit-root-first-key prev fn2-commit-root) (fn2-commit-root-members prev fn2-commit-root)))))
      ((unless (and (fn2-alloc-slotp extent fn2-extents) (posp first) (posp members) (= first expected-first)
                    (unsigned-byte-p 60 (+ first members -1)) (<= (+ first members -1) events)
                    (or (< commit cut) (= (+ first members -1) events)))) (mv :source off fn2-fields fn2-pool))
      (epoch (if archived (fn2-checkpoint-restore-events-work-epoch row fn2-checkpoint-restore-events-work) (fn2-extents-epoch extent fn2-extents)))
      (allocation (if archived (fn2-checkpoint-restore-events-work-allocation row fn2-checkpoint-restore-events-work) (fn2-extents-counter extent fn2-extents)))
      ((unless (fn2-event-catalog-held-p commit extent epoch allocation fn2-checkpoint-restore-events fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)) (mv :source off fn2-fields fn2-pool))
      ((mv sealed seal) (if archived (mv :ok 0) (fn2-commit-directory-seal-slot commit (fn2-fc-rows fn2-fc) fn2-commit-root)))
      ((unless (or archived (and (eq sealed :ok) (fn2-digest-rowp seal fn2-digests)))) (mv :source off fn2-fields fn2-pool))
      ((mv code fn2-pool) (if archived
       (fn2-event-source-store-seal 0 row scratch sgen 0 okind oslot ogen fn2-checkpoint-restore-events-work fn2-pool)
       (fn2-digest-store 32 seal scratch sgen 0 okind oslot ogen fn2-digests fn2-pool)))
      ((unless (eq code :ok)) (mv code off fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-event-proof-entry-field-commit*) commit fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-event-proof-entry-field-event-first*) first fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-event-proof-entry-field-members*) members fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-event-proof-entry-field-extent*) extent fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-event-proof-entry-field-writer-epoch*) epoch fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-event-proof-entry-field-allocation*) allocation fn2-fields))
      (fn2-fields (fn2-fields-put (+ base *fn2-event-proof-entry-field-semantic-seal*) (value 1) (ref-slot scratch) (ref-gen sgen) (ref-off 0) (ref-len 32))))
  (mv-let (code next fn2-pool) (fn2-event-proof-entry-encode base slot gen off okind oslot ogen fn2-fields fn2-pool)
   (mv code next fn2-fields fn2-pool))))

(fn2-fields-preserves fn2-event-proof-pack-entry
 (token ordinal base slot gen off scratch sgen okind oslot ogen
  fn2-csnapshot fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests fn2-fields fn2-pool fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-events fn2-checkpoint-restore-events-work fn2-ops)
 :carriers ((fn2-fields 2 :prefix "-FIELDS") (fn2-pool 3 :prefix "-POOL")))

(fn2-pool-preserves fn2-event-source-store-seal
 (i row slot gen off kind owner generation fn2-checkpoint-restore-events-work fn2-pool)
 :hyps ((fn2-checkpoint-restore-events-workp fn2-checkpoint-restore-events-work) (fn2-checkpoint-restore-events-work-wfp fn2-checkpoint-restore-events-work) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
 :carriers ((fn2-pool 1 :prefix "-0")))

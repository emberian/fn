 :hyps ((fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-summary-sources-wfp fn2-checkpoint-summary-sources) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds) (fn2-run-installed-wfp fn2-run-installed) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-extents-wfp fn2-extents) (fn2-ops-wfp fn2-ops) (fn2-alloc-edges-wfp fn2-alloc-edges))
 :specs (("-CHECKPOINT-SUMMARY-TYPE" fn2-checkpoint-summaryp 1) ("-CHECKPOINT-SUMMARY-WFP" fn2-checkpoint-summary-wfp 1)

(defcost fn2-checkpoint-cbase-release-op :child fn2-checkpoint-cbase-release-step :answers t
 :tables (fn2-core-checkpoint-summary fn2-core-checkpoint-summary-sources fn2-core-checkpoint-cbase-holds fn2-core-run-installed fn2-core-checkpoints fn2-core-extents fn2-core-ops fn2-core-alloc-edges)

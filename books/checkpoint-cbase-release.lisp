          ("-ALLOC-EDGES-TYPE" fn2-alloc-edgesp 4) ("-ALLOC-EDGES-WFP" fn2-alloc-edges-wfp 4)
          ("-ALLOC-EDGES-ROWS" fn2-alloc-edges-rows 4 :frame fn2-alloc-edges)

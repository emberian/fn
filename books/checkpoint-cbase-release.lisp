; Close only an actually replaced C catalog. Promises outlive bank movement,
; source-row retirement and idle query intervals, and release through the same
; exact allocator edge operation after both row obligations and leases drain.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-cbase-identity")
(include-book "checkpoint-summary-retire")
(fn2-book-layer :c)
(defun fn2-checkpoint-cbase-tagged-row-p (r retired tag fn2-run-installed)
 (declare (xargs :stobjs fn2-run-installed
  :guard (and (fn2-run-installed-wfp fn2-run-installed) (natp r) (< r (fn2-run-installed-rows fn2-run-installed)))))
 (and (equal (fn2-run-installed-physical r fn2-run-installed) 1)
      (equal (fn2-run-installed-catalog-tag r fn2-run-installed) tag)
      (or (equal (fn2-run-installed-state r fn2-run-installed) *fn2-run-installed-state-live*)
          (and retired (equal (fn2-run-installed-state r fn2-run-installed) *fn2-run-installed-state-retired*)))))

(defun fn2-checkpoint-cbase-row-release-step (budget s fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-cbase-holds fn2-run-installed fn2-checkpoints fn2-extents fn2-ops fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-cbase-holds fn2-run-installed fn2-checkpoints fn2-extents fn2-ops fn2-alloc-edges)
  :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-summary-sources-wfp fn2-checkpoint-summary-sources) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds)
              (fn2-run-installed-wfp fn2-run-installed) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-extents-wfp fn2-extents)
              (fn2-ops-wfp fn2-ops) (fn2-alloc-edges-wfp fn2-alloc-edges))))
 (b* (((unless (and (natp budget) (< 0 budget))) (mv :yield fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
      ((unless (fn2-checkpoint-cbase-row-identity-p s fn2-checkpoint-summary fn2-checkpoint-cbase-holds))
       (mv :source fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
      (c (fn2-checkpoint-summary-candidate s fn2-checkpoint-summary))
      (tag (fn2-checkpoint-summary-tag s fn2-checkpoint-summary))
      (phase (fn2-checkpoint-cbase-holds-phase c fn2-checkpoint-cbase-holds))
      (n (fn2-checkpoint-cbase-holds-limit c fn2-checkpoint-cbase-holds))
      ((unless (and (< c (fn2-checkpoints-rows fn2-checkpoints))
                    (equal n (fn2-extents-rows fn2-extents))
                    (equal (fn2-checkpoint-cbase-holds-edge-base c fn2-checkpoint-cbase-holds)
                           (fn2-checkpoint-cbase-edge c 0 fn2-extents fn2-ops fn2-checkpoints))
                    (<= (+ (fn2-checkpoint-cbase-holds-edge-base c fn2-checkpoint-cbase-holds) n) (fn2-alloc-edges-rows fn2-alloc-edges))))
       (mv :geometry fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
      ((when (equal phase *fn2-checkpoint-cbase-phase-released*))
       (mv (if (and (equal (fn2-checkpoint-cbase-holds-cursor c fn2-checkpoint-cbase-holds) n)
                    (equal (fn2-checkpoint-cbase-holds-seen c fn2-checkpoint-cbase-holds) 0)) :released :source)
           fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
      ((unless (member-equal phase (list *fn2-checkpoint-cbase-phase-held* *fn2-checkpoint-cbase-phase-protecting*
                                        *fn2-checkpoint-cbase-phase-acquiring* *fn2-checkpoint-cbase-phase-closing* *fn2-checkpoint-cbase-phase-releasing*)))
       (mv :source fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
      ((when (equal (fn2-checkpoint-cbase-holds-drain-started c fn2-checkpoint-cbase-holds) 0))
       (if (not (unsigned-byte-p 32 (fn2-run-installed-rows fn2-run-installed)))
           (mv :geometry fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed)
        (let ((fn2-checkpoint-cbase-holds (fn2-checkpoint-cbase-holds-put c (drain-started 1)
               (run-limit (fn2-run-installed-rows fn2-run-installed)) (run-cursor 0))))
         (mv :more fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))))
      ((unless (equal (fn2-checkpoint-cbase-holds-run-limit c fn2-checkpoint-cbase-holds) (fn2-run-installed-rows fn2-run-installed)))
       (mv :geometry fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
      (r (fn2-checkpoint-cbase-holds-run-cursor c fn2-checkpoint-cbase-holds))
      ((when (or (member-equal phase (list *fn2-checkpoint-cbase-phase-protecting* *fn2-checkpoint-cbase-phase-acquiring*))
                 (and (equal phase *fn2-checkpoint-cbase-phase-held*)
                      (equal (fn2-checkpoint-summary-phase s fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-captured*))))
       ; An unpublished partial holder cannot be forgotten by a catalog reset.
       ; Close its real zero-installed/zero-query captured catalog first.
       (b* (((unless (and (equal (fn2-checkpoint-summary-phase s fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-captured*)
                          (equal (fn2-checkpoint-summary-installed s fn2-checkpoint-summary) 0)
                          (equal (fn2-checkpoint-summary-lease-count s fn2-checkpoint-summary) 0)))
              (mv :source fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
            ((mv code fn2-checkpoint-summary) (fn2-checkpoint-summary-row-retire-begin s fn2-checkpoint-summary))
            ((unless (eq code :retiring)) (mv :source fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
            (fn2-checkpoint-cbase-holds (fn2-checkpoint-cbase-holds-put c (phase *fn2-checkpoint-cbase-phase-closing*) (run-cursor 0))))
        (mv :more fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed)))
      ((when (equal phase *fn2-checkpoint-cbase-phase-held*))
       ; Do not close an active base before its compactor can take source
       ; leases. Only actual replacement of every LIVE old row ends preflight.
       (cond
        ((not (equal (fn2-checkpoint-summary-phase s fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-applied*))
         (mv :source fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
        ((< r (fn2-run-installed-rows fn2-run-installed))
         (if (fn2-checkpoint-cbase-tagged-row-p r nil tag fn2-run-installed)
             (mv :retained fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed)
          (let ((fn2-checkpoint-cbase-holds (fn2-checkpoint-cbase-holds-set-run-cursor c (+ 1 r) fn2-checkpoint-cbase-holds)))
           (mv :more fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))))
        ((not (equal r (fn2-run-installed-rows fn2-run-installed)))
         (mv :source fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
        (t (b* (((mv code fn2-checkpoint-summary) (fn2-checkpoint-summary-row-retire-begin s fn2-checkpoint-summary))
                 ((unless (eq code :retiring)) (mv :source fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
                 (fn2-checkpoint-cbase-holds (fn2-checkpoint-cbase-holds-put c (phase *fn2-checkpoint-cbase-phase-closing*) (run-cursor 0))))
             (mv :more fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed)))))
      ((unless (and (equal (fn2-checkpoint-summary-phase s fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-retiring*)
                    (equal (fn2-checkpoint-summary-lease-count s fn2-checkpoint-summary) 0)))
       (mv :retained fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
      ((when (equal phase *fn2-checkpoint-cbase-phase-closing*))
       (cond
        ((< r (fn2-run-installed-rows fn2-run-installed))
         (if (fn2-checkpoint-cbase-tagged-row-p r t tag fn2-run-installed)
             (b* (((mv code fn2-checkpoint-summary fn2-run-installed)
                    (fn2-checkpoint-summary-row-retire-row s r fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-cbase-holds fn2-run-installed))
                  ((unless (eq code :retired))
                   (mv (if (eq code :leased) :retained :source) fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
                  (fn2-checkpoint-cbase-holds (fn2-checkpoint-cbase-holds-set-run-cursor c (+ 1 r) fn2-checkpoint-cbase-holds)))
              (mv :more fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
          (let ((fn2-checkpoint-cbase-holds (fn2-checkpoint-cbase-holds-set-run-cursor c (+ 1 r) fn2-checkpoint-cbase-holds)))
           (mv :more fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))))
        ((not (and (equal r (fn2-run-installed-rows fn2-run-installed))
                   (equal (fn2-checkpoint-summary-installed s fn2-checkpoint-summary) 0)))
         (mv :retained fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
        (t (let ((fn2-checkpoint-cbase-holds (fn2-checkpoint-cbase-holds-put c (phase *fn2-checkpoint-cbase-phase-releasing*) (cursor 0))))
            (mv :more fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed)))))
      (e (fn2-checkpoint-cbase-holds-cursor c fn2-checkpoint-cbase-holds))
      ((when (< e n))
       (b* ((edge (+ (fn2-checkpoint-cbase-holds-edge-base c fn2-checkpoint-cbase-holds) e))
            (free (equal (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-free*))
            ((unless (or free (and (posp (fn2-checkpoint-cbase-holds-seen c fn2-checkpoint-cbase-holds))
                                  (fn2-alloc-edge-matchesp edge tag e (fn2-alloc-edges-epoch edge fn2-alloc-edges)
                                   (fn2-alloc-edges-counter edge fn2-alloc-edges) :promised-read fn2-alloc-edges))))
             (mv :uncertain fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
            ((mv code fn2-extents fn2-alloc-edges)
             (if free (mv :ok fn2-extents fn2-alloc-edges)
              (fn2-alloc-edge-drop edge tag e (fn2-alloc-edges-epoch edge fn2-alloc-edges)
               (fn2-alloc-edges-counter edge fn2-alloc-edges) :promised-read fn2-extents fn2-alloc-edges)))
            ((unless (eq code :ok)) (mv :uncertain fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
            (fn2-checkpoint-cbase-holds (fn2-checkpoint-cbase-holds-put c (cursor (+ 1 e))
              (seen (if free (fn2-checkpoint-cbase-holds-seen c fn2-checkpoint-cbase-holds)
                        (- (fn2-checkpoint-cbase-holds-seen c fn2-checkpoint-cbase-holds) 1))))))
        (mv :more fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed)))
      ((unless (and (equal e n) (equal (fn2-checkpoint-cbase-holds-seen c fn2-checkpoint-cbase-holds) 0)))
       (mv :uncertain fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed))
      (fn2-checkpoint-summary (fn2-checkpoint-summary-set-phase s *fn2-checkpoint-summary-phase-retired* fn2-checkpoint-summary))
      (fn2-checkpoint-cbase-holds (fn2-checkpoint-cbase-holds-set-phase c *fn2-checkpoint-cbase-phase-released* fn2-checkpoint-cbase-holds)))
  (mv :released fn2-checkpoint-summary fn2-checkpoint-cbase-holds fn2-extents fn2-alloc-edges fn2-run-installed)))
(defun fn2-checkpoint-cbase-release-step (budget fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-cbase-holds fn2-run-installed fn2-checkpoints fn2-extents fn2-ops fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-cbase-holds fn2-run-installed fn2-checkpoints fn2-extents fn2-ops fn2-alloc-edges) :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-summary-sources-wfp fn2-checkpoint-summary-sources) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds) (fn2-run-installed-wfp fn2-run-installed) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-extents-wfp fn2-extents) (fn2-ops-wfp fn2-ops) (fn2-alloc-edges-wfp fn2-alloc-edges))))
 (fn2-checkpoint-cbase-row-release-step budget 0 fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-cbase-holds fn2-run-installed fn2-checkpoints fn2-extents fn2-ops fn2-alloc-edges))


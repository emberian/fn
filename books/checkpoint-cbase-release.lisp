 (budget s fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-cbase-holds fn2-run-installed fn2-checkpoints fn2-extents fn2-ops fn2-alloc-edges)
 :hyps ((fn2-checkpoint-summaryp fn2-checkpoint-summary) (fn2-checkpoint-summary-sourcesp fn2-checkpoint-summary-sources) (fn2-checkpoint-cbase-holdsp fn2-checkpoint-cbase-holds) (fn2-run-installedp fn2-run-installed) (fn2-checkpointsp fn2-checkpoints) (fn2-extentsp fn2-extents) (fn2-opsp fn2-ops) (fn2-alloc-edgesp fn2-alloc-edges) (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-summary-sources-wfp fn2-checkpoint-summary-sources) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds) (fn2-run-installed-wfp fn2-run-installed) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-extents-wfp fn2-extents) (fn2-ops-wfp fn2-ops) (fn2-alloc-edges-wfp fn2-alloc-edges))
 :specs (("-CHECKPOINT-SUMMARY-TYPE" fn2-checkpoint-summaryp 1) ("-CHECKPOINT-SUMMARY-WFP" fn2-checkpoint-summary-wfp 1)
          ("-CHECKPOINT-SUMMARY-ROWS" fn2-checkpoint-summary-rows 1 :frame fn2-checkpoint-summary)

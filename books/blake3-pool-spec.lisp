; Scalar differential oracle for the native whole-subtree entry.
; These are compression internals, not served digest APIs. No octet lists.
(in-package "ACL2")
(include-book "pool")
(include-book "digests")
(include-book "blake3-spec")
(local (include-book "arithmetic-3/floor-mod/floor-mod" :dir :system))
(defun fn-b3-pool-word (off fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (natp off) (<= (+ off 4) (fn2-pool-data-length fn2-pool)))))
 (+ (fn-b3-word (fn2-pool-datai off fn2-pool)) (* 256 (fn-b3-word (fn2-pool-datai (+ off 1) fn2-pool)))
    (* 65536 (fn-b3-word (fn2-pool-datai (+ off 2) fn2-pool))) (* 16777216 (fn-b3-word (fn2-pool-datai (+ off 3) fn2-pool)))))
(in-theory (disable fn-b3-pool-word))
(defun fn-b3-pool-blocks (off counter count j c0 c1 c2 c3 c4 c5 c6 c7 fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :guard (and (natp off) (unsigned-byte-p 54 counter) (natp count) (natp j) (<= (+ count j) 16) (<= (+ off (* 64 count)) (fn2-pool-data-length fn2-pool)) (and (unsigned-byte-p 32 c0) (unsigned-byte-p 32 c1) (unsigned-byte-p 32 c2) (unsigned-byte-p 32 c3) (unsigned-byte-p 32 c4) (unsigned-byte-p 32 c5) (unsigned-byte-p 32 c6) (unsigned-byte-p 32 c7))) :measure (nfix count)))
 (if (zp count) (mv c0 c1 c2 c3 c4 c5 c6 c7)
  (mv-let (c0 c1 c2 c3 c4 c5 c6 c7)
   (fn-b3-compress-core c0 c1 c2 c3 c4 c5 c6 c7 (fn-b3-pool-word (+ off 0) fn2-pool) (fn-b3-pool-word (+ off 4) fn2-pool) (fn-b3-pool-word (+ off 8) fn2-pool) (fn-b3-pool-word (+ off 12) fn2-pool) (fn-b3-pool-word (+ off 16) fn2-pool) (fn-b3-pool-word (+ off 20) fn2-pool) (fn-b3-pool-word (+ off 24) fn2-pool) (fn-b3-pool-word (+ off 28) fn2-pool) (fn-b3-pool-word (+ off 32) fn2-pool) (fn-b3-pool-word (+ off 36) fn2-pool) (fn-b3-pool-word (+ off 40) fn2-pool) (fn-b3-pool-word (+ off 44) fn2-pool) (fn-b3-pool-word (+ off 48) fn2-pool) (fn-b3-pool-word (+ off 52) fn2-pool) (fn-b3-pool-word (+ off 56) fn2-pool) (fn-b3-pool-word (+ off 60) fn2-pool)
    counter 64 (logior (if (equal j 0) 1 0) (if (equal j 15) 2 0)))
   (fn-b3-pool-blocks (+ off 64) counter (- count 1) (+ j 1) c0 c1 c2 c3 c4 c5 c6 c7 fn2-pool))))
(defthm fn-b3-pool-blocks-type
 (implies (and (unsigned-byte-p 32 c0) (unsigned-byte-p 32 c1) (unsigned-byte-p 32 c2) (unsigned-byte-p 32 c3) (unsigned-byte-p 32 c4) (unsigned-byte-p 32 c5) (unsigned-byte-p 32 c6) (unsigned-byte-p 32 c7)) (and (unsigned-byte-p 32 (mv-nth 0 (fn-b3-pool-blocks off counter count j c0 c1 c2 c3 c4 c5 c6 c7 fn2-pool))) (unsigned-byte-p 32 (mv-nth 1 (fn-b3-pool-blocks off counter count j c0 c1 c2 c3 c4 c5 c6 c7 fn2-pool))) (unsigned-byte-p 32 (mv-nth 2 (fn-b3-pool-blocks off counter count j c0 c1 c2 c3 c4 c5 c6 c7 fn2-pool))) (unsigned-byte-p 32 (mv-nth 3 (fn-b3-pool-blocks off counter count j c0 c1 c2 c3 c4 c5 c6 c7 fn2-pool))) (unsigned-byte-p 32 (mv-nth 4 (fn-b3-pool-blocks off counter count j c0 c1 c2 c3 c4 c5 c6 c7 fn2-pool))) (unsigned-byte-p 32 (mv-nth 5 (fn-b3-pool-blocks off counter count j c0 c1 c2 c3 c4 c5 c6 c7 fn2-pool))) (unsigned-byte-p 32 (mv-nth 6 (fn-b3-pool-blocks off counter count j c0 c1 c2 c3 c4 c5 c6 c7 fn2-pool))) (unsigned-byte-p 32 (mv-nth 7 (fn-b3-pool-blocks off counter count j c0 c1 c2 c3 c4 c5 c6 c7 fn2-pool)))))
 :hints (("Goal" :in-theory (disable mv-nth))))
(verify-guards fn-b3-pool-blocks :hints (("Goal" :in-theory (disable mv-nth))))
(in-theory (disable fn-b3-pool-blocks))
(defun fn-b3-pool-tree (off chunks counter fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :guard (and (natp off) (member chunks '(1 2 4 8 16 32 64)) (unsigned-byte-p 54 counter) (<= (+ counter chunks) (expt 2 54)) (<= (+ off (* 1024 chunks)) (fn2-pool-data-length fn2-pool))) :measure (nfix chunks)))
 (if (or (not (natp chunks)) (<= chunks 1))
  (fn-b3-pool-blocks off counter 16 0 (nth 0 *fn2-b3-iv*) (nth 1 *fn2-b3-iv*) (nth 2 *fn2-b3-iv*) (nth 3 *fn2-b3-iv*) (nth 4 *fn2-b3-iv*) (nth 5 *fn2-b3-iv*) (nth 6 *fn2-b3-iv*) (nth 7 *fn2-b3-iv*) fn2-pool)
  (let ((half (floor chunks 2)))
   (mv-let (l0 l1 l2 l3 l4 l5 l6 l7) (fn-b3-pool-tree off half counter fn2-pool)
    (mv-let (r0 r1 r2 r3 r4 r5 r6 r7) (fn-b3-pool-tree (+ off (* half 1024)) half (+ counter half) fn2-pool)
     (fn-b3-compress-core (nth 0 *fn2-b3-iv*) (nth 1 *fn2-b3-iv*) (nth 2 *fn2-b3-iv*) (nth 3 *fn2-b3-iv*) (nth 4 *fn2-b3-iv*) (nth 5 *fn2-b3-iv*) (nth 6 *fn2-b3-iv*) (nth 7 *fn2-b3-iv*) l0 l1 l2 l3 l4 l5 l6 l7 r0 r1 r2 r3 r4 r5 r6 r7 0 64 4))))))
(defthm fn-b3-pool-tree-type
 (and (unsigned-byte-p 32 (mv-nth 0 (fn-b3-pool-tree off chunks counter fn2-pool))) (unsigned-byte-p 32 (mv-nth 1 (fn-b3-pool-tree off chunks counter fn2-pool))) (unsigned-byte-p 32 (mv-nth 2 (fn-b3-pool-tree off chunks counter fn2-pool))) (unsigned-byte-p 32 (mv-nth 3 (fn-b3-pool-tree off chunks counter fn2-pool))) (unsigned-byte-p 32 (mv-nth 4 (fn-b3-pool-tree off chunks counter fn2-pool))) (unsigned-byte-p 32 (mv-nth 5 (fn-b3-pool-tree off chunks counter fn2-pool))) (unsigned-byte-p 32 (mv-nth 6 (fn-b3-pool-tree off chunks counter fn2-pool))) (unsigned-byte-p 32 (mv-nth 7 (fn-b3-pool-tree off chunks counter fn2-pool))))
 :hints (("Goal" :in-theory (disable mv-nth))))
(verify-guards fn-b3-pool-tree :hints (("Goal" :in-theory (disable mv-nth))))
(in-theory (disable fn-b3-pool-tree))
(defthm fn-b3-pool-tree-car-type
 (unsigned-byte-p 32 (car (fn-b3-pool-tree off chunks counter fn2-pool)))
 :hints (("Goal" :use fn-b3-pool-tree-type :in-theory (disable fn-b3-pool-tree fn-b3-pool-tree-type))))
(defthm fn-b3-pool-blocks-car-type
 (implies (and (unsigned-byte-p 32 c0) (unsigned-byte-p 32 c1) (unsigned-byte-p 32 c2) (unsigned-byte-p 32 c3) (unsigned-byte-p 32 c4) (unsigned-byte-p 32 c5) (unsigned-byte-p 32 c6) (unsigned-byte-p 32 c7)) (unsigned-byte-p 32 (car (fn-b3-pool-blocks off counter count j c0 c1 c2 c3 c4 c5 c6 c7 fn2-pool))))
 :hints (("Goal" :use fn-b3-pool-blocks-type :in-theory (disable fn-b3-pool-blocks fn-b3-pool-blocks-type))))

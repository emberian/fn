; The native image node profile: NNTP TCP listener, local FNCT control/consumer/authority
; Unix listener, durable accounts and grants, and configurable startup groups/peering.
(in-package "ACL2")
(include-book "host-boundary")
; Startup overrides replace keys; profiles reject duplicate keys.
(defun fn2-node-profile-overlay (updates profile)
 (declare (xargs :guard (and (alistp updates) (alistp profile))))
 (if (endp updates) profile
  (fn2-node-profile-overlay (cdr updates)
    (put-assoc-equal (caar updates) (cdar updates) profile))))
(defconst *fn2-node-profile*
 (fn2-node-profile-overlay
  '((:listener-targets . fn2-conn)
    (:storage-fault-model . "broad")
    (:listener-local-target . fn2-ctl)
    (:owner-account . 2)
    (:authority . 4)
    (:control-connections . 16)
    (:cns . 8)
    (:groups . (("local.test" . 1)))
    (:posting-interim . t)
    (:reading . t)
    (:peering-interim . nil)
    (:c . 32)
    (:p . 32)
    (:u . 8)
    (:t . 20)
    (:x . 8)
    (:w . 16)
    (:o . 64)
    (:qa . 64)
    (:h . 16)
    (:k . 16)
    (:aturn . 32)
    (:ncancel . 8)
    (:jread . 16)
    (:jwrite . 8)
    (:accept-credits . 8)
    (:identity-overlays . 64)
    (:identity-runs . 128)
    (:identity-arena-bytes . 4096)
    (:large-upload-windows . 4)
    (:extent-slots . 128)
    (:trace . nil)
    (:pool-classes . ((256 . 4096) (64 . 65536))))
  *fn2-profile-tiny*))
(assert-event (fn2-core-profilep *fn2-node-profile*))
(assert-event (fn2-core-profilep (fn2-image-profile *fn2-node-profile*)))
(assert-event
 (fn2-core-profilep
  (fn2-image-profile (put-assoc-equal :peering-interim t *fn2-node-profile*))))

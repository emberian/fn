; Fixed-width LC root header. Page values are observations reached through
; pointers; only the three u64 pointers themselves enter the root codec.
(in-package "ACL2")
(include-book "log-checkpoint-values")
(include-book "frame")

(defconst *fn-lc-header-magic* '(70 78 76 67))
(defun fn-lc-root-headerp (root)
  (declare (xargs :guard t :verify-guards nil))
  (and (true-listp root) (equal (len root) 8) (equal (mbe :logic (car root) :exec (fn-lc-head root)) :lc-root)
       (true-listp (mbe :logic (nth 1 root) :exec (fn-lc-at 1 root))) (equal (len (mbe :logic (nth 1 root) :exec (fn-lc-at 1 root))) 5)
       (unsigned-byte-p 64 (mbe :logic (nth 0 (nth 1 root)) :exec (fn-lc-at 0 (fn-lc-at 1 root))))
       (unsigned-byte-p 32 (mbe :logic (nth 1 (nth 1 root)) :exec (fn-lc-at 1 (fn-lc-at 1 root))))
       (unsigned-byte-p 64 (mbe :logic (nth 2 (nth 1 root)) :exec (fn-lc-at 2 (fn-lc-at 1 root))))
       (unsigned-byte-p 64 (mbe :logic (nth 3 (nth 1 root)) :exec (fn-lc-at 3 (fn-lc-at 1 root))))
       (fn-frame-digestp (mbe :logic (nth 4 (nth 1 root)) :exec (fn-lc-at 4 (fn-lc-at 1 root))))
       (unsigned-byte-p 64 (mbe :logic (nth 2 root) :exec (fn-lc-at 2 root))) (booleanp (mbe :logic (nth 3 root) :exec (fn-lc-at 3 root)))
       (unsigned-byte-p 64 (mbe :logic (nth 4 root) :exec (fn-lc-at 4 root)))
       (unsigned-byte-p 64 (mbe :logic (nth 5 root) :exec (fn-lc-at 5 root)))
       (unsigned-byte-p 64 (mbe :logic (nth 6 root) :exec (fn-lc-at 6 root)))
       (equal (mbe :logic (nth 7 root) :exec (fn-lc-at 7 root)) 1)))
(defun fn-lc-header-body (root)
  (declare (xargs :guard (fn-lc-root-headerp root) :verify-guards nil))
  (let ((s (mbe :logic (nth 1 root) :exec (fn-lc-at 1 root))))
    (mbe :logic (append *fn-lc-header-magic* '(1)
      (fn-cbor-u64-bytes (nth 0 s)) (fn-cbor-u32-bytes (nth 1 s))
      (fn-cbor-u64-bytes (nth 2 s)) (fn-cbor-u64-bytes (nth 3 s)) (nth 4 s)
      (fn-cbor-u64-bytes (nth 2 root)) (list (if (nth 3 root) 1 0))
      (fn-cbor-u64-bytes (nth 4 root)) (fn-cbor-u64-bytes (nth 5 root))
      (fn-cbor-u64-bytes (nth 6 root))) :exec (fn-lc-join *fn-lc-header-magic* (fn-lc-join '(1) (fn-lc-join (fn-cbor-u64-bytes (fn-lc-at 0 s)) (fn-lc-join (ec-call (fn-cbor-u32-bytes (fn-lc-at 1 s))) (fn-lc-join (fn-cbor-u64-bytes (fn-lc-at 2 s)) (fn-lc-join (fn-cbor-u64-bytes (fn-lc-at 3 s)) (fn-lc-join (fn-lc-at 4 s) (fn-lc-join (fn-cbor-u64-bytes (fn-lc-at 2 root)) (fn-lc-join (list (if (fn-lc-at 3 root) 1 0)) (fn-lc-join (fn-cbor-u64-bytes (fn-lc-at 4 root)) (fn-lc-join (fn-cbor-u64-bytes (fn-lc-at 5 root)) (fn-cbor-u64-bytes (fn-lc-at 6 root))))))))))))))))
(defun fn-lc-header-encode (root)
  (declare (xargs :guard (fn-lc-root-headerp root) :verify-guards nil))
  (let ((body (fn-lc-header-body root)))
    (mbe :logic (append body (fn-frame-digest body)) :exec (fn-lc-join body (fn-frame-digest body)))))
(defun fn-lc-header-codec-fixed-width ()
  (declare (xargs :guard t))
  (+ 4 1 8 4 8 8 32 8 1 8 8 8 32))
(defconst *fn-lc-root-slot-octets* (fn-lc-header-codec-fixed-width))
(defun fn-lc-root-slot-octets () (declare (xargs :guard t)) *fn-lc-root-slot-octets*)
(defun fn-lc-page-octets () (declare (xargs :guard t)) 16384)
(defun fn-lc-header-decode (bytes)
  (declare (xargs :guard t :verify-guards nil))
  (let* ((body (mbe :logic (take 98 bytes) :exec (fn-lc-take 98 bytes)))
         (root (list :lc-root
                (list (mbe :logic (fn-cbor-u64-from (mbe :logic (take 8 (nthcdr 5 bytes)) :exec (fn-lc-take 8 (fn-lc-drop 5 bytes)))) :exec (ec-call (fn-cbor-u64-from (fn-lc-take 8 (fn-lc-drop 5 bytes)))))
                      (mbe :logic (fn-cbor-u32-from (mbe :logic (take 4 (nthcdr 13 bytes)) :exec (fn-lc-take 4 (fn-lc-drop 13 bytes)))) :exec (ec-call (fn-cbor-u32-from (fn-lc-take 4 (fn-lc-drop 13 bytes)))))
                      (mbe :logic (fn-cbor-u64-from (mbe :logic (take 8 (nthcdr 17 bytes)) :exec (fn-lc-take 8 (fn-lc-drop 17 bytes)))) :exec (ec-call (fn-cbor-u64-from (fn-lc-take 8 (fn-lc-drop 17 bytes)))))
                      (mbe :logic (fn-cbor-u64-from (mbe :logic (take 8 (nthcdr 25 bytes)) :exec (fn-lc-take 8 (fn-lc-drop 25 bytes)))) :exec (ec-call (fn-cbor-u64-from (fn-lc-take 8 (fn-lc-drop 25 bytes)))))
                      (mbe :logic (take 32 (nthcdr 33 bytes)) :exec (fn-lc-take 32 (fn-lc-drop 33 bytes))))
                (mbe :logic (fn-cbor-u64-from (mbe :logic (take 8 (nthcdr 65 bytes)) :exec (fn-lc-take 8 (fn-lc-drop 65 bytes)))) :exec (ec-call (fn-cbor-u64-from (fn-lc-take 8 (fn-lc-drop 65 bytes)))))
                (equal (mbe :logic (nth 73 bytes) :exec (fn-lc-at 73 bytes)) 1)
                (mbe :logic (fn-cbor-u64-from (mbe :logic (take 8 (nthcdr 74 bytes)) :exec (fn-lc-take 8 (fn-lc-drop 74 bytes)))) :exec (ec-call (fn-cbor-u64-from (fn-lc-take 8 (fn-lc-drop 74 bytes)))))
                (mbe :logic (fn-cbor-u64-from (mbe :logic (take 8 (nthcdr 82 bytes)) :exec (fn-lc-take 8 (fn-lc-drop 82 bytes)))) :exec (ec-call (fn-cbor-u64-from (fn-lc-take 8 (fn-lc-drop 82 bytes)))))
                (mbe :logic (fn-cbor-u64-from (mbe :logic (take 8 (nthcdr 90 bytes)) :exec (fn-lc-take 8 (fn-lc-drop 90 bytes)))) :exec (ec-call (fn-cbor-u64-from (fn-lc-take 8 (fn-lc-drop 90 bytes))))) 1)))
    (if (and (fn-cbor-octet-listp bytes)
             (equal (len bytes) (fn-lc-header-codec-fixed-width))
             (equal (mbe :logic (take 5 bytes) :exec (fn-lc-take 5 bytes)) (mbe :logic (append *fn-lc-header-magic* '(1)) :exec (fn-lc-join *fn-lc-header-magic* '(1))))
             (member-equal (mbe :logic (nth 73 bytes) :exec (fn-lc-at 73 bytes)) '(0 1))
             (equal (mbe :logic (nthcdr 98 bytes) :exec (fn-lc-drop 98 bytes)) (fn-frame-digest body))
             (fn-lc-root-headerp root))
        root :bad)))

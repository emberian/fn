; Catalog-image observation of the actual cold adoption and physical-tail
; replay operations. Owner installation is the separate fold in fn-lc-open.
; Slot observations are model annotations, never bytes passed to PGS.
(in-package "ACL2")
(include-book "log-checkpoint-open")
(include-book "log-cleaning-replay")

(defun fn-lc-slot-record (slot)
 (declare (xargs :guard t))
 (if (and (true-listp slot) (equal (len slot) 3)
          (equal (fn-lc-head slot) :lc-slot-observation))
     (fn-lc-at 1 slot) slot))
(defun fn-lc-physical-roots (roots)
 (declare (xargs :guard t))
 (if (consp roots)
  (cons (if (consp (car roots))
         (let ((slots (cdar roots)))
          (cons (caar roots) (cons (fn-lc-slot-record (pgs-slot 0 slots))
                                  (fn-lc-slot-record (pgs-slot 1 slots)))))
         (car roots))
        (fn-lc-physical-roots (cdr roots))) nil))
(defun fn-lc-physical-disk (disk)
 (declare (xargs :guard t))
 (cons (pgs-pages disk) (fn-lc-physical-roots (pgs-roots disk))))

(defun-nx fn-lc-open-image (disk r mode segs)
 (let* ((disk (fn-lc-physical-disk disk))
        (fn-lbc (create-fn-lbc))
        (adopted (ec-call (fn-lc-adopt disk r mode segs fn-lbc)))
        (fn-lbc (mv-nth 1 adopted)))
  (if (or (not (equal (mv-nth 0 adopted) :ok))
          (not (fn-lc-segs-retain segs (fn-lc-cold-adopted-header disk r mode))))
      (list :checkpoint-image fn-lbc disk segs)
   (let* ((tail (fn-lc-positioned-tail segs (fn-lc-cold-adopted-header disk r mode)))
          (replayed (ec-call (fn-lc-replay-positioned-tail tail segs fn-lbc))))
    (list (mv-nth 0 replayed) (mv-nth 1 replayed) disk (mv-nth 2 replayed))))))
(defun-nx fn-lc-image-locator (image i)
 (let ((fn-lbc (fn-lc-at 1 image)))
  (if (equal (fn-lc-head image) :ok)
      (list (ec-call (fn-lbc-loc0 i fn-lbc)) (ec-call (fn-lbc-loc1 i fn-lbc)))
    :bad)))
(defun-nx fn-lc-open-image-resolvesp (image segs)
 (or (equal (fn-lc-head image) :empty)
     (and (equal (fn-lc-head image) :ok)
          (ec-call (fn-lc-locators-resolve (fn-lc-at 1 image) segs)))))
(defun-nx fn-lc-pgs-slot-open (disk r mode root-slot segs)
 (let* ((physical (fn-lc-physical-disk disk))
        (record (pgs-slot root-slot (pgs-root-slots r physical)))
        (single (pgs-set-root-slot r (if (equal root-slot 1) 0 1) nil physical)))
  ; An absent/torn record is not an eligible root. A valid record whose
  ; pages or replay fail remains a failure; it cannot satisfy RESOLVESP.
  (if (not record) (list :empty (create-fn-lbc) physical segs)
    (if (not (pgs-rec-valid record)) (list :checkpoint-image (create-fn-lbc) physical segs)
      (fn-lc-open-image single r mode segs)))))

(defun fn-lc-pair-range (pair segs)
 (declare (xargs :guard t))
 (ec-call (fn-lc-read-range (fn-lc-at 0 pair) (fn-lc-at 1 pair) segs)))
(defun fn-lc-pair-home (pair segs)
 (declare (xargs :guard t))
 (ec-call (fn-lc-read-home-frame
             (ec-call (fn-lc-home-position (fn-lc-at 0 pair) (fn-lc-at 1 pair))) segs)))
(defun fn-lc-pair-suf (pair segs)
 (declare (xargs :guard t))
 (fn-lc-read-suf (fn-lc-at 0 pair) (fn-lc-at 1 pair) segs))

(verify-guards fn-lc-open-image)
(verify-guards fn-lc-image-locator)
(verify-guards fn-lc-open-image-resolvesp)
(verify-guards fn-lc-pgs-slot-open)

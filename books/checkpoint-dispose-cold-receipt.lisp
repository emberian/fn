; Postboot carried evidence, not the phase4-only completion predicate.
; ACK transfers metadata; these checks additionally bind actual protected
; capture identity and the independent physical edge namespace.
(in-package "ACL2")
(include-book "checkpoint-bank-cold-state")
(include-book "checkpoint-bank-protection-state")
(include-book "checkpoint-teardown-cold-evidence")
(include-book "checkpoint-bank-closure-edges")
(include-book "checkpoint-payload-proof-state")
(fn2-book-layer :c)

(defun fn2-checkpoint-dispose-cold-words-p (i slot c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil
 :measure (nfix (- 48 (nfix i)))
 :guard (and (fn2-checkpoint-teardown-debtp fn2-checkpoint-teardown-debt) (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt)
             (fn2-checkpoint-publicationp fn2-checkpoint-publication) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
             (natp i) (<= i 48) (natp slot) (< slot 4) (natp c)
             (<= (* 40 (+ c 1)) (fn2-checkpoint-teardown-debt-words-length fn2-checkpoint-teardown-debt))
             (<= (* 32 (+ c 1)) (fn2-checkpoint-teardown-debt-anchors-length fn2-checkpoint-teardown-debt)))))
 (if (>= (nfix i) 48) t
  (mv-let (code word) (fn2-checkpoint-bank-cold-word slot (fn2-checkpoint-teardown-cold-kind i) (mod i 8) fn2-checkpoint-publication)
   (and (eq code :ok)
        (= word (if (< i 40) (fn2-checkpoint-teardown-debt-wordsi (+ (* 40 c) i) fn2-checkpoint-teardown-debt)
                  (fn2-checkpoint-teardown-debt-anchorsi (+ (* 32 c) (* 8 slot) (- i 40)) fn2-checkpoint-teardown-debt)))
        (fn2-checkpoint-dispose-cold-words-p (+ 1 (nfix i)) slot c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)))))

(defun fn2-checkpoint-dispose-cold-subject-p (slot c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil
 :guard (and (fn2-checkpoint-teardown-debtp fn2-checkpoint-teardown-debt) (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt)
             (fn2-checkpoint-publicationp fn2-checkpoint-publication) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (b* (((mv code actual checkpoint history incarnation cut cutevent batch) (fn2-checkpoint-bank-cold-snapshot slot fn2-checkpoint-publication))
      ((mv eventcode event) (fn2-checkpoint-bank-cold-event slot fn2-checkpoint-publication)))
  (and (eq code :ok) (eq eventcode :ok) (equal slot actual)
       (fn2-checkpoint-teardown-debt-heldp c fn2-checkpoint-teardown-debt)
       (equal c (fn2-checkpoint-publication-cold-catalogi slot fn2-checkpoint-publication))
       (<= (* 40 (+ c 1)) (fn2-checkpoint-teardown-debt-words-length fn2-checkpoint-teardown-debt))
       (<= (* 32 (+ c 1)) (fn2-checkpoint-teardown-debt-anchors-length fn2-checkpoint-teardown-debt))
       (= (fn2-checkpoint-teardown-debt-cold-copy c fn2-checkpoint-teardown-debt) 0)
       (= (fn2-checkpoint-teardown-debt-word-cursor c fn2-checkpoint-teardown-debt) 40)
       (fn2-checkpoint-bank-obligation-memberp slot (fn2-checkpoint-teardown-debt-anchor-mask c fn2-checkpoint-teardown-debt))
       (= (fn2-checkpoint-teardown-debt-checkpoint c fn2-checkpoint-teardown-debt) checkpoint)
       (= (fn2-checkpoint-teardown-debt-history c fn2-checkpoint-teardown-debt) history)
       (= (fn2-checkpoint-teardown-debt-incarnation c fn2-checkpoint-teardown-debt) incarnation)
       (= (fn2-checkpoint-teardown-debt-cut-commit c fn2-checkpoint-teardown-debt) cut)
       (= (fn2-checkpoint-teardown-debt-cut-event c fn2-checkpoint-teardown-debt) cutevent)
       (= (fn2-checkpoint-teardown-debt-installation-commit c fn2-checkpoint-teardown-debt) batch)
       (= (fn2-checkpoint-teardown-debt-installation-event c fn2-checkpoint-teardown-debt) event)
       (fn2-checkpoint-dispose-cold-words-p 0 slot c fn2-checkpoint-teardown-debt fn2-checkpoint-publication))))

(defun fn2-checkpoint-dispose-cold-receipt-p (fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-extents fn2-ops fn2-checkpoints fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-extents fn2-ops fn2-checkpoints fn2-alloc-edges) :verify-guards nil
 :guard (and (fn2-checkpoint-publicationp fn2-checkpoint-publication) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
             (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures) (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures)
             (fn2-checkpoint-bank-protectionp fn2-checkpoint-bank-protection) (fn2-checkpoint-bank-protection-wfp fn2-checkpoint-bank-protection)
             (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents) (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops)
             (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints)
             (fn2-alloc-edgesp fn2-alloc-edges) (fn2-alloc-edges-wfp fn2-alloc-edges))))
 (and (< 0 (fn2-checkpoint-bank-protection-rows fn2-checkpoint-bank-protection))
      (fn2-checkpoint-bank-obligations-complete-p fn2-checkpoint-publication)
      (= (fn2-alloc-freeze-phase fn2-extents) 0)
      (= (fn2-checkpoint-bank-protection-phase 0 fn2-checkpoint-bank-protection) *fn2-checkpoint-bank-protection-phase-protected*)
      (= (fn2-checkpoint-bank-protection-total 0 fn2-checkpoint-bank-protection) (* *fn2-checkpoint-anchor-slots* (fn2-extents-rows fn2-extents)))
      (= (fn2-checkpoint-bank-protection-cursor 0 fn2-checkpoint-bank-protection) (fn2-checkpoint-bank-protection-total 0 fn2-checkpoint-bank-protection))
      (= (fn2-checkpoint-bank-protection-bound-mask 0 fn2-checkpoint-bank-protection) (fn2-checkpoint-publication-cold-bound-mask 0 fn2-checkpoint-publication))
      (= (fn2-checkpoint-bank-protection-edge-total 0 fn2-checkpoint-bank-protection) (fn2-alloc-edges-rows fn2-alloc-edges))
      (= (fn2-checkpoint-bank-protection-ops-rows 0 fn2-checkpoint-bank-protection) (fn2-ops-rows fn2-ops))
      (= (fn2-checkpoint-bank-protection-candidate-rows 0 fn2-checkpoint-bank-protection) (fn2-checkpoints-rows fn2-checkpoints))
      (= (fn2-checkpoint-bank-closures-extents fn2-checkpoint-bank-closures) (fn2-extents-rows fn2-extents))
      (= (fn2-checkpoint-bank-closures-rows fn2-checkpoint-bank-closures) (* *fn2-checkpoint-anchor-slots* (fn2-extents-rows fn2-extents)))
      (fn2-checkpoint-bank-protection-sources-p 0 fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection)))

(defun fn2-checkpoint-dispose-cold-row-p (slot c e epoch allocation fn2-checkpoint-teardown-debt fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-extents fn2-ops fn2-checkpoints fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-extents fn2-ops fn2-checkpoints fn2-alloc-edges) :verify-guards nil
 :guard (and (fn2-checkpoint-teardown-debtp fn2-checkpoint-teardown-debt) (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt)
             (fn2-checkpoint-publicationp fn2-checkpoint-publication) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
             (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures) (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures)
             (fn2-checkpoint-bank-protectionp fn2-checkpoint-bank-protection) (fn2-checkpoint-bank-protection-wfp fn2-checkpoint-bank-protection)
             (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents) (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops)
             (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints)
             (fn2-alloc-edgesp fn2-alloc-edges) (fn2-alloc-edges-wfp fn2-alloc-edges))))
 (and (natp slot) (< slot *fn2-checkpoint-anchor-slots*)
      (fn2-alloc-slotp e fn2-extents)
      (fn2-checkpoint-dispose-cold-receipt-p fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-extents fn2-ops fn2-checkpoints fn2-alloc-edges)
      (= (fn2-checkpoint-bank-obligation-state (+ 2 slot) fn2-checkpoint-publication) 3)
      (fn2-checkpoint-dispose-cold-subject-p slot c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
      (fn2-checkpoint-bank-closure-row-p slot e fn2-checkpoint-bank-closures fn2-checkpoint-publication)
      (let ((r (+ (* slot (fn2-extents-rows fn2-extents)) e)))
       (and (= (fn2-checkpoint-bank-closures-present r fn2-checkpoint-bank-closures) 1)
            (= (fn2-checkpoint-bank-closures-epoch r fn2-checkpoint-bank-closures) epoch)
            (= (fn2-checkpoint-bank-closures-allocation r fn2-checkpoint-bank-closures) allocation)))
      (eq (fn2-alloc-handle-code e epoch allocation fn2-extents) :ok)
      (if (member-equal (fn2-extents-state e fn2-extents) (list *fn2-extent-state-allocated* *fn2-extent-state-retire-pending*)) t nil)
      (= (fn2-extents-release-pending e fn2-extents) 0)))

; Extent-granularity location is the actual common reach namespace: aliases
; within one allocation OR their authenticated role bits, never page hashes.
(defun fn2-checkpoint-dispose-cold-payload-p (slot c e epoch allocation fn2-checkpoint-teardown-debt fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-extents fn2-ops fn2-checkpoints fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-extents fn2-ops fn2-checkpoints fn2-alloc-edges) :verify-guards nil :measure (nfix (- 4 (nfix slot)))
 :guard (and (fn2-checkpoint-teardown-debtp fn2-checkpoint-teardown-debt) (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt)
             (fn2-checkpoint-publicationp fn2-checkpoint-publication) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
             (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures) (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures)
             (fn2-checkpoint-bank-protectionp fn2-checkpoint-bank-protection) (fn2-checkpoint-bank-protection-wfp fn2-checkpoint-bank-protection)
             (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents) (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops)
             (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints)
             (fn2-alloc-edgesp fn2-alloc-edges) (fn2-alloc-edges-wfp fn2-alloc-edges))))
 (and (natp slot) (< slot *fn2-checkpoint-anchor-slots*)
  (or (and (fn2-checkpoint-dispose-cold-row-p slot c e epoch allocation fn2-checkpoint-teardown-debt fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-extents fn2-ops fn2-checkpoints fn2-alloc-edges)
           (not (= (logand (fn2-checkpoint-bank-closures-role-bits (+ (* slot (fn2-extents-rows fn2-extents)) e) fn2-checkpoint-bank-closures)
                            *fn2-checkpoint-payload-proof-roles*) 0)))
      (fn2-checkpoint-dispose-cold-payload-p (+ 1 slot) c e epoch allocation fn2-checkpoint-teardown-debt fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-extents fn2-ops fn2-checkpoints fn2-alloc-edges))))

; Fixed admission/source gate. This does not issue a lease or allocation grant.
(in-package "ACL2")
(include-book "admission-preallocation-resources")
(defun fn-hsw-parentp (x)
 (declare (xargs :guard t))
 (and (fn-apr-widthp 6 x) (eq (fn-prl-nth 0 x) :history-installed)
      (natp (fn-prl-nth 1 x)) (natp (fn-prl-nth 2 x))
      (natp (fn-prl-nth 3 x)) (natp (fn-prl-nth 4 x))
      (natp (fn-prl-nth 5 x))))
(defun fn-hsw-gate (token current base installed epoch)
 (declare (xargs :guard t))
 (cond ((not (and (fn-apr-tokenp token) (fn-apr-livep token current))) :writer-stale)
       ((eq (fn-prl-nth 2 current) :uncertain) :recovery-required)
       ((not (and (fn-hsw-parentp base) (fn-hsw-parentp installed)
                  (natp epoch) (equal (fn-prl-nth 2 token) epoch)
                  (equal (fn-prl-nth 5 base) epoch)
                  (equal (fn-prl-nth 5 installed) epoch)
                  (equal (fn-prl-nth 1 base) (fn-prl-nth 1 installed))
                  (equal (fn-prl-nth 2 base) (fn-prl-nth 2 installed))
                  (equal (fn-prl-nth 3 base) (fn-prl-nth 3 installed))
                  (equal (fn-prl-nth 4 base) (fn-prl-nth 4 installed)))) :writer-source-changed)
       (t :writer-current)))
; Direct legacy setters have no semantic publication receipt. They are legal
; only before a dense source is installed and while no operation is retained.
(defun fn-owner-history-bootstrap-mutationp (state)
 (declare (xargs :stobjs state :guard t))
 (and (null (fn-apr-owner-current state))
      (not (and (boundp-global 'fn-owner-history-publication state)
                (f-get-global 'fn-owner-history-publication state)))))

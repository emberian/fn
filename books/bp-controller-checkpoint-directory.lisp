; Internal token-selected directory job authority. Constructor census,
; allocation-epoch admission and native atomic publication remain separate.
(in-package "ACL2")
(include-book "bp-controller-checkpoint-current")
(local (include-book "arithmetic-5/top" :dir :system))
(local (defthm fn-bpcc-natural-address-ranges
  (implies (natp address)
           (and (natp (mod address 64))
                (< (mod address 64) 64)
                (natp (floor address 64))))
  :hints (("Goal" :in-theory (disable mod floor)))))
; Unlike the standalone reserve algebra, parent preparation is never READY
; before committing the shared pool. Unknown cuts retain an :issuing job.
(defun fn-bpcc-segment-issue-prepare (controller slot demand ledger fn-bpc-segment)
  (declare (xargs :stobjs fn-bpc-segment
                  :guard (and (natp slot) (< slot 64))))
  (let* ((row (fn-bpcs-rowsi slot fn-bpc-segment))
         (current (fn-bpn-nth 2 row)))
    (cond ((not (and (fn-bpc-tokenp controller)
                     (equal (mod (caddr controller) 64) slot)
                     (fn-bpc-row-livep (cadr controller) row)))
           (mv :stale-controller nil ledger fn-bpc-segment))
          ((fn-bpn-nth 4 row)
           (mv :controller-busy nil ledger fn-bpc-segment))
          ((not (fn-bpco-checkpoint-operation-p current))
           (mv :checkpoint-unavailable nil ledger fn-bpc-segment))
          ((not (and (fn-prs-vectorp demand)
                     (equal (fn-prl-nth 4 demand) 1)))
           (mv :invalid-checkpoint-demand nil ledger fn-bpc-segment))
          (t
           (mv-let (word next charged)
             (fn-prs-issue (fn-prl-nth 0 ledger) (fn-prl-baseline ledger)
                           '(0 0 0 0 0) (fn-prl-nth 1 ledger)
                           (fn-prl-nth 2 ledger)
                           (fn-prl-nth 4 (fn-prl-nth 0 ledger)) demand)
             (if (not (eq word :admitted))
                 (mv word nil ledger fn-bpc-segment)
               (let* ((token (list :bp-job (fn-prl-nth 2 ledger) controller
                                   (fn-bpco-checkpoint-epoch current)
                                   (fn-bpco-checkpoint-generation current)))
                      (job (list token demand :issuing current))
                      (ledger1 (fn-prl-build (fn-prl-nth 0 ledger) charged next
                                  (fn-prl-nth 3 ledger) (fn-prl-baseline ledger)))
                      (fn-bpc-segment
                       (update-fn-bpcs-rowsi slot
                         (list (fn-bpn-nth 0 row) (fn-bpn-nth 1 row) current
                               (fn-bpn-nth 3 row) job) fn-bpc-segment)))
                 (mv :checkpoint-prepared token ledger1 fn-bpc-segment))))))))
(defun fn-bpcc-segment-issued-publish (token slot fn-bpc-segment)
  (declare (xargs :stobjs fn-bpc-segment
                  :guard (and (natp slot) (< slot 64))))
  (let* ((row (fn-bpcs-rowsi slot fn-bpc-segment))
         (job (fn-bpn-nth 4 row)))
    (if (not (and (fn-bpcc-job-tokenp token)
                  (equal token (fn-bpn-nth 0 job))
                  (eq (fn-bpn-nth 2 job) :issuing)
                  (equal (mod (caddr (caddr token)) 64) slot)
                  (fn-bpc-row-livep (cadr (caddr token)) row)))
        (mv :stale-checkpoint fn-bpc-segment)
      (let ((fn-bpc-segment
             (update-fn-bpcs-rowsi slot
               (list (fn-bpn-nth 0 row) (fn-bpn-nth 1 row)
                     (fn-bpn-nth 2 row) (fn-bpn-nth 3 row)
                     (list token (fn-bpn-nth 1 job) :reserved (fn-bpn-nth 3 job)))
               fn-bpc-segment)))
        (mv :checkpoint-reserved fn-bpc-segment)))))
(defun fn-bpcc-segment-fence-current (controller slot fn-bpc-segment)
  (declare (xargs :stobjs fn-bpc-segment
                  :guard (and (natp slot) (< slot 64))))
  (let* ((row (fn-bpcs-rowsi slot fn-bpc-segment))
         (job (fn-bpn-nth 4 row))
         (token (fn-bpn-nth 0 job)))
    (if (not (and (fn-bpc-tokenp controller)
                  (equal (mod (caddr controller) 64) slot)
                  (fn-bpc-row-livep (cadr controller) row)
                  (fn-bpcc-job-tokenp token)
                  (equal (caddr token) controller)))
        (mv :stale-checkpoint fn-bpc-segment)
      (fn-bpcc-segment-cancel token slot fn-bpc-segment))))
(defun fn-bpcc-node-job (controller token operation slot physical-segment depth demand ledger fuel fn-bpc-node)
  (declare (xargs :stobjs fn-bpc-node :measure (nfix depth)
                  :guard (and (natp slot) (< slot 64) (natp physical-segment)
                              (natp depth) (natp fuel))))
  (cond ((<= fuel depth) (mv :yield nil ledger fuel fn-bpc-node))
        ((zp depth)
         (if (not (fn-bpcn-children-boundp 'fn-bpc-segment fn-bpc-node))
             (mv :controller-unavailable nil ledger (- fuel 1) fn-bpc-node)
           (stobj-let ((fn-bpc-segment
                        (fn-bpcn-children-get 'fn-bpc-segment fn-bpc-node (create-fn-bpc-segment))))
             (word answer next-ledger fn-bpc-segment)
             (cond ((eq operation :prepare)
                    (fn-bpcc-segment-issue-prepare controller slot demand ledger fn-bpc-segment))
                   ((eq operation :publish)
                    (mv-let (word fn-bpc-segment)
                      (fn-bpcc-segment-issued-publish token slot fn-bpc-segment)
                      (mv word token ledger fn-bpc-segment)))
                   ((eq operation :fence-current)
                    (mv-let (word fn-bpc-segment)
                      (fn-bpcc-segment-fence-current controller slot fn-bpc-segment)
                      (mv word nil ledger fn-bpc-segment)))
                   ((eq operation :cancel)
                    (mv-let (word fn-bpc-segment)
                      (fn-bpcc-segment-cancel token slot fn-bpc-segment)
                      (mv word nil ledger fn-bpc-segment)))
                   (t (mv :checkpoint-operation-unavailable nil ledger fn-bpc-segment)))
             (mv word answer next-ledger (- fuel 1) fn-bpc-node))))
        ((equal (mod physical-segment 2) 0)
         (if (not (fn-bpcn-children-boundp 'fn-bpc-left fn-bpc-node))
             (mv :controller-unavailable nil ledger (- fuel 1) fn-bpc-node)
           (stobj-let ((fn-bpc-left
                        (fn-bpcn-children-get 'fn-bpc-left fn-bpc-node (create-fn-bpc-left))))
             (word answer next-ledger left fn-bpc-left)
             (fn-bpcc-node-job controller token operation slot (floor physical-segment 2)
                              (- depth 1) demand ledger (- fuel 1) fn-bpc-left)
             (mv word answer next-ledger left fn-bpc-node))))
        (t
         (if (not (fn-bpcn-children-boundp 'fn-bpc-right fn-bpc-node))
             (mv :controller-unavailable nil ledger (- fuel 1) fn-bpc-node)
           (stobj-let ((fn-bpc-right
                        (fn-bpcn-children-get 'fn-bpc-right fn-bpc-node (create-fn-bpc-right))))
             (word answer next-ledger left fn-bpc-right)
             (fn-bpcc-node-job controller token operation slot (floor physical-segment 2)
                              (- depth 1) demand ledger (- fuel 1) fn-bpc-right)
             (mv word answer next-ledger left fn-bpc-node))))))
(defun fn-bpcc-directory-job (controller token operation demand ledger fuel fn-bp-controller-registry)
  (declare (xargs :stobjs fn-bp-controller-registry :guard (natp fuel)))
  (if (not (and (fn-bpc-tokenp controller)
                (< (caddr controller) (fn-bpcr-highwater fn-bp-controller-registry))
                (or (eq operation :prepare) (eq operation :fence-current)
                    (and (fn-bpcc-job-tokenp token) (equal (caddr token) controller)))))
      (mv :stale-controller nil ledger fuel fn-bp-controller-registry)
    (let ((depth (fn-bpcr-depth fn-bp-controller-registry)))
      (stobj-let ((fn-bpc-node (fn-bpcr-root fn-bp-controller-registry)))
        (word answer next-ledger left fn-bpc-node)
        (fn-bpcc-node-job controller token operation (mod (caddr controller) 64)
                         (floor (caddr controller) 64) depth demand ledger fuel fn-bpc-node)
        (mv word answer next-ledger left fn-bp-controller-registry)))))
(verify-guards fn-bpcc-segment-issue-prepare)
(verify-guards fn-bpcc-segment-issued-publish)
(verify-guards fn-bpcc-segment-fence-current)
(verify-guards fn-bpcc-node-job)
(verify-guards fn-bpcc-directory-job
  :hints (("Goal" :in-theory (disable mod floor)
                  :use ((:instance fn-bpcc-natural-address-ranges
                          (address (caddr controller)))))))

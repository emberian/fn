; One numeric source map feeds actual RELEASE packing and persisted matching.
; This does not grant release/FREE authority or replace the typed producer.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "release-allocation-state")
(include-book "commit-format")
(include-book "pool")
(fn2-book-layer :b)
(defconst *fn2-release-numeric-bindings*
 '((*fn2-format-release-allocation-field-extent* fn2-allocation-release-extent)
   (*fn2-format-release-allocation-field-writer-epoch* fn2-allocation-release-epoch)
   (*fn2-format-release-allocation-field-allocation* fn2-allocation-release-allocation)
   (*fn2-format-release-allocation-field-retirement-commit* fn2-allocation-release-retirement)
   (*fn2-format-release-allocation-field-promoted-checkpoint* fn2-allocation-release-checkpoint)
   (*fn2-format-release-allocation-field-installation-commit* fn2-allocation-release-installation-commit)
   (*fn2-format-release-allocation-field-installation-event* fn2-allocation-release-installation-event)
   ((+ *fn2-format-release-allocation-field-release-evidence-storage-domain* 0) fn2-allocation-release-storage-domain)
   ((+ *fn2-format-release-allocation-field-release-evidence-storage-domain* 1) fn2-allocation-release-physical-unit)
   ((+ *fn2-format-release-allocation-field-release-evidence-storage-domain* 2) fn2-allocation-release-descriptor-epoch)
   ((+ *fn2-format-release-allocation-field-release-evidence-storage-domain* 3) fn2-allocation-release-descriptor-allocation)
   ((+ *fn2-format-release-allocation-field-release-evidence-storage-domain* 4) fn2-allocation-release-page-kind)
   ((+ *fn2-format-release-allocation-field-release-evidence-storage-domain* 5) fn2-allocation-release-encoded-length)))
(defun fn2-release-numeric-store-forms (bindings)
 (declare (xargs :verify-guards nil))
 (if (atom bindings) nil
  (cons `(fn2-fields (fn2-fields-set-value (+ base ,(caar bindings))
           (,(cadar bindings) 0 fn2-allocation-release) fn2-fields))
        (fn2-release-numeric-store-forms (cdr bindings)))))
(defun fn2-release-numeric-match-forms (bindings)
 (declare (xargs :verify-guards nil))
 (if (atom bindings) nil
  (cons `(equal (fn2-fields-value (+ base ,(caar bindings)) fn2-fields)
                (,(cadar bindings) 0 fn2-allocation-release))
        (fn2-release-numeric-match-forms (cdr bindings)))))
(make-event
 (value
  `(progn
    (defun fn2-release-store-numeric-fields (base fn2-allocation-release fn2-fields)
     (declare (xargs :stobjs (fn2-allocation-release fn2-fields)
      :guard (and (fn2-allocation-release-wfp fn2-allocation-release) (fn2-fields-wfp fn2-fields))))
     (if (not (and (natp base) (< 0 (fn2-allocation-release-rows fn2-allocation-release))
                    (<= (+ base *fn2-format-release-allocation-num-fields*) (fn2-fields-rows fn2-fields)))) fn2-fields
      (let* ,(fn2-release-numeric-store-forms *fn2-release-numeric-bindings*) fn2-fields)))
    (fn2-fields-preserves fn2-release-store-numeric-fields (base fn2-allocation-release fn2-fields)
     :hyps ((fn2-allocation-releasep fn2-allocation-release) (fn2-allocation-release-wfp fn2-allocation-release)
            (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)))
    (defun fn2-release-numeric-fields-match-p (base fn2-allocation-release fn2-fields)
     (declare (xargs :stobjs (fn2-allocation-release fn2-fields)
      :guard (and (fn2-allocation-release-wfp fn2-allocation-release) (fn2-fields-wfp fn2-fields))))
     (and (natp base) (< 0 (fn2-allocation-release-rows fn2-allocation-release))
          (<= (+ base *fn2-format-release-allocation-num-fields*) (fn2-fields-rows fn2-fields))
          ,@(fn2-release-numeric-match-forms *fn2-release-numeric-bindings*))))))
(defun fn2-release-member-hash-p (i off slot gen kind owner generation fn2-allocation-release fn2-pool)
 (declare (xargs :stobjs (fn2-allocation-release fn2-pool) :measure (nfix (- 32 (nfix i)))
  :guard (and (fn2-allocation-release-wfp fn2-allocation-release) (fn2-pool-wfp fn2-pool) (natp i) (<= i 32) (natp off))))
 (or (>= (nfix i) 32)
  (mv-let (code byte) (fn2-pool-read slot gen (+ off i) kind owner generation fn2-pool)
   (and (eq code :ok) (equal byte (fn2-allocation-release-descriptori i fn2-allocation-release))
    (fn2-release-member-hash-p (+ i 1) off slot gen kind owner generation fn2-allocation-release fn2-pool)))))
(defun fn2-release-member-fields-match-p (base slot gen kind owner generation fn2-allocation-release fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-allocation-release fn2-fields fn2-pool)
  :guard (and (fn2-allocation-release-wfp fn2-allocation-release) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (let ((hash (+ (nfix base) *fn2-format-release-allocation-field-release-evidence-storage-domain* 6)))
  (and (fn2-release-numeric-fields-match-p base fn2-allocation-release fn2-fields)
       (< hash (fn2-fields-rows fn2-fields))
       (equal (fn2-fields-ref-slot hash fn2-fields) slot)
       (equal (fn2-fields-ref-gen hash fn2-fields) gen)
       (equal (fn2-fields-ref-len hash fn2-fields) 32)
       (fn2-release-member-hash-p 0 (fn2-fields-ref-off hash fn2-fields) slot gen kind owner generation fn2-allocation-release fn2-pool))))

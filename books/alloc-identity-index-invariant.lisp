; Logical observations of the ACTUAL index continuation, never executable
; admission scans. READY is justified by the bounded prepare/probe history.
(in-package "ACL2")
(include-book "alloc-identity-index")
(fn2-book-layer :b)

(defun fn2-alloc-identity-examined-p (fuel at epoch counter fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) t
  (and (natp at) (< at (fn2-extents-rows fn2-extents))
   (let ((bucket-state (fn2-alloc-identity-statesi at fn2-extents)))
    (and (member-equal bucket-state (list *fn2-alloc-identity-bucket-used* *fn2-alloc-identity-bucket-tombstone*))
         (not (and (= bucket-state *fn2-alloc-identity-bucket-used*)
                   (equal epoch (fn2-alloc-identity-epochsi at fn2-extents))
                   (equal counter (fn2-alloc-identity-countersi at fn2-extents))))
         (fn2-alloc-identity-examined-p (- fuel 1)
          (if (= (+ 1 at) (fn2-extents-rows fn2-extents)) 0 (+ 1 at)) epoch counter fn2-extents))))))
(defun fn2-alloc-identity-first-tombstone (fuel at fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil :measure (nfix fuel)))
 (if (or (zp fuel) (not (natp at)) (>= at (fn2-extents-rows fn2-extents))) *fn2-alloc-none*
  (if (= (fn2-alloc-identity-statesi at fn2-extents) *fn2-alloc-identity-bucket-tombstone*) at
   (fn2-alloc-identity-first-tombstone (- fuel 1)
    (if (= (+ 1 at) (fn2-extents-rows fn2-extents)) 0 (+ 1 at)) fn2-extents))))
(defun fn2-alloc-identity-ready-reachable-p (home epoch counter fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (let* ((n (fn2-extents-rows fn2-extents)) (b (fn2-alloc-identity-bucket fn2-extents)))
  (and (posp n) (natp home) (< home n) (natp b) (< b n)
       (fn2-alloc-identity-examined-p (mod (- b home) n) home epoch counter fn2-extents))))

(defun fn2-alloc-identity-captured-subject-p (fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (let ((op (fn2-alloc-identity-op fn2-extents))
       (old (fn2-alloc-identity-old-state fn2-extents))
       (new (fn2-alloc-identity-new-state fn2-extents)))
  (if (member-equal op (list *fn2-alloc-identity-op-adopt* *fn2-alloc-identity-op-insert*))
   (and (= old *fn2-extent-state-free*)
        (if (= op *fn2-alloc-identity-op-adopt*) (= new *fn2-extent-state-reserved*)
         (member-equal new (list *fn2-extent-state-reserved* *fn2-extent-state-allocated* *fn2-extent-state-retire-pending*))))
   (and (not (= old *fn2-extent-state-free*))
    (if (= op *fn2-alloc-identity-op-free*)
     (and (= new *fn2-extent-state-free*) (= (fn2-alloc-identity-new-epoch fn2-extents) 0)
          (= (fn2-alloc-identity-new-counter fn2-extents) 0))
     (and (= op *fn2-alloc-identity-op-check*) (= new old)
          (= (fn2-alloc-identity-new-epoch fn2-extents) (fn2-alloc-identity-old-epoch fn2-extents))
          (= (fn2-alloc-identity-new-counter fn2-extents) (fn2-alloc-identity-old-counter fn2-extents))))))))

(defun fn2-alloc-identity-probe-provenance-p (fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (let* ((kind (fn2-alloc-identity-owner-kind fn2-extents))
        (owner (fn2-alloc-identity-owner-slot fn2-extents))
        (ogen (fn2-alloc-identity-owner-gen fn2-extents))
        (source (fn2-alloc-identity-source-generation fn2-extents))
        (phase (fn2-alloc-identity-phase fn2-extents))
        (op (fn2-alloc-identity-op fn2-extents))
        (insert (member-equal op (list *fn2-alloc-identity-op-adopt* *fn2-alloc-identity-op-insert*)))
        (epoch (if insert (fn2-alloc-identity-new-epoch fn2-extents) (fn2-alloc-identity-old-epoch fn2-extents)))
        (counter (if insert (fn2-alloc-identity-new-counter fn2-extents) (fn2-alloc-identity-old-counter fn2-extents)))
        (n (fn2-extents-rows fn2-extents))
        (home (fn2-alloc-identity-home epoch counter n)))
  (and (fn2-alloc-identity-owner-p kind owner ogen source fn2-extents)
       (fn2-alloc-identity-captured-subject-p fn2-extents)
       (member-equal op (list *fn2-alloc-identity-op-adopt* *fn2-alloc-identity-op-insert*
                             *fn2-alloc-identity-op-free* *fn2-alloc-identity-op-check*))
       ; A key-preserving settlement may stale the captured state. Such a
       ; continuation has no authority: the actual mutators require CURRENT.
       (or (not (fn2-alloc-identity-pending-current-p kind owner ogen source fn2-extents))
        (if (= phase *fn2-alloc-identity-phase-probe*)
         (let ((seen (fn2-alloc-identity-visited fn2-extents)))
          (and (posp n) (natp seen) (<= seen n)
               (= (fn2-alloc-identity-probe fn2-extents) (mod (+ home seen) n))
               (fn2-alloc-identity-examined-p seen home epoch counter fn2-extents)
               (= (fn2-alloc-identity-tombstone fn2-extents)
                  (fn2-alloc-identity-first-tombstone seen home fn2-extents))))
         (and (= phase *fn2-alloc-identity-phase-ready*)
          (if insert
           (and (= (fn2-alloc-identity-old-state fn2-extents) *fn2-extent-state-free*)
                (fn2-alloc-identity-reusable-p fn2-extents)
                (= (fn2-alloc-identity-model-find n home epoch counter fn2-extents) *fn2-alloc-none*)
                (fn2-alloc-identity-ready-reachable-p home epoch counter fn2-extents))
           (and (fn2-alloc-identity-old-bucket-p fn2-extents)
                (= (fn2-alloc-identity-model-find n home epoch counter fn2-extents)
                   (fn2-alloc-identity-extent fn2-extents))
                (fn2-alloc-identity-ready-reachable-p home epoch counter fn2-extents)))))))))
(defun fn2-alloc-identity-maintained-p (fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (and (fn2-alloc-identity-refines-p fn2-extents)
      (if (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-idle*)
       (= (fn2-alloc-identity-op fn2-extents) *fn2-alloc-identity-op-none*)
       (fn2-alloc-identity-probe-provenance-p fn2-extents))))

; The pointwise bridge lets the actual allocator consume uniqueness, rather
; than importing a separate allocator or assuming pair compatibility.
(defthm fn2-alloc-identity-model-rows-lookup
 (implies (and (natp n) (natp i) (< i n)
               (fn2-alloc-identity-model-rows n fn2-extents)
               (not (= (fn2-extents-state i fn2-extents) *fn2-extent-state-free*)))
  (equal (fn2-alloc-identity-model-find (fn2-extents-rows fn2-extents)
          (fn2-alloc-identity-home (fn2-extents-epoch i fn2-extents)
           (fn2-extents-counter i fn2-extents) (fn2-extents-rows fn2-extents))
          (fn2-extents-epoch i fn2-extents) (fn2-extents-counter i fn2-extents) fn2-extents) i))
 :hints (("Goal" :induct (fn2-alloc-identity-model-rows n fn2-extents)
          :in-theory (e/d (fn2-alloc-identity-model-rows)
                          (fn2-alloc-identity-model-find fn2-alloc-identity-home)))))
(defthm fn2-alloc-identity-refinement-live-key-injective
 (implies (and (fn2-alloc-identity-refines-p fn2-extents)
               (fn2-alloc-slotp i fn2-extents) (fn2-alloc-slotp j fn2-extents)
               (not (= (fn2-extents-state i fn2-extents) *fn2-extent-state-free*))
               (not (= (fn2-extents-state j fn2-extents) *fn2-extent-state-free*))
               (equal (fn2-extents-epoch i fn2-extents) (fn2-extents-epoch j fn2-extents))
               (equal (fn2-extents-counter i fn2-extents) (fn2-extents-counter j fn2-extents)))
  (equal i j))
 :hints (("Goal" :in-theory (e/d (fn2-alloc-identity-refines-p fn2-alloc-slotp)
                                (fn2-alloc-identity-model-rows fn2-alloc-identity-model-find fn2-alloc-identity-home))
          :use ((:instance fn2-alloc-identity-model-rows-lookup (n (fn2-extents-rows fn2-extents)))
                (:instance fn2-alloc-identity-model-rows-lookup (n (fn2-extents-rows fn2-extents)) (i j))))))

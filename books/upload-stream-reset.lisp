; Materialize after the concrete core and the rolling upload schema.
; This operation changes no phase and grants no new lease or durability.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "upload")
(fn2-book-layer :d)

(defmacro fn2-upload-stream-reset-op-events ()
 '(progn
   (defun fn2-upload-stream-reset-owner-p (id gen end fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (and (eq (fn2-upload-snapshot-read-code id fn2-core) :ok)
     (equal (fn2-machine-generation id fn2-core) gen)
     (let ((owner (fn2-upload-row-conn id fn2-core))
           (ogen (fn2-upload-row-conn-gen id fn2-core))
           (request (fn2-upload-row-request id fn2-core)))
      (cond
        ((eq (fn2-cns-snapshot-read-code owner fn2-core) :ok)
         (and (equal (fn2-machine-generation owner fn2-core) ogen)
          (equal (fn2-cns-row-phase owner fn2-core) *fn2-cns-state-append*)
          (equal (fn2-cns-row-upload owner fn2-core) id)
          (equal (fn2-cns-row-upload-gen owner fn2-core) gen)
          (equal (fn2-cns-row-request owner fn2-core) request)
          (equal (fn2-cns-row-feed-discard owner fn2-core) 0)
          (equal (fn2-cns-row-fed owner fn2-core) end)))
        ((eq (fn2-conn-snapshot-read-code owner fn2-core) :ok)
         (and (equal (fn2-machine-generation owner fn2-core) ogen)
          (equal (fn2-conn-row-phase owner fn2-core) *fn2-conn-state-article-input*)
          (equal (fn2-conn-row-upload owner fn2-core) id)
          (equal (fn2-conn-row-upload-gen owner fn2-core) gen)
          (equal (fn2-conn-row-request owner fn2-core) request)
          (equal (fn2-conn-row-stopped owner fn2-core) 0)
          (equal (fn2-conn-row-feed-discard owner fn2-core) 0)
          (equal (fn2-conn-row-fed owner fn2-core) end)))
        (t nil)))))
   (in-theory (disable fn2-upload-stream-reset-owner-p))

   (defun fn2-upload-stream-reset (id gen fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                    :guard-hints (("Goal" :do-not '(preprocess)))))
    (b* (((unless (and (eq (fn2-upload-snapshot-read-code id fn2-core) :ok)
                       (posp gen) (unsigned-byte-p 60 gen)
                       (equal (fn2-machine-generation id fn2-core) gen)))
          (mv :owner fn2-core))
         (end (fn2-upload-row-stream-end id fn2-core))
         (used (fn2-upload-row-stream-stage-used id fn2-core))
         (resets (fn2-upload-row-stream-resets id fn2-core))
         ((unless (and
          (equal (fn2-upload-row-phase id fn2-core) *fn2-upload-state-stream-fenced*)
          (equal (fn2-upload-row-stopped id fn2-core) 0)
          (equal (fn2-upload-row-pending id fn2-core) 0)
          (equal (fn2-upload-row-sready id fn2-core) 1)
          (equal (fn2-upload-row-sevent id fn2-core) *fn2-event-fence-result*)
          (equal (fn2-upload-row-soutcome id fn2-core) *fn2-outcome-done*)))
          (mv :state fn2-core))
         ((unless (and (unsigned-byte-p 60 end)
          (unsigned-byte-p 60 (+ (fn2-upload-row-ilen id fn2-core) end))
          (<= end (fn2-upload-row-hashed id fn2-core))
          (<= (+ (fn2-upload-row-ilen id fn2-core) end)
              (fn2-upload-row-stored-hashed id fn2-core))
          (natp used) (<= used *fn2-commit-unit-bytes*)
          (natp resets) (unsigned-byte-p 60 (+ 1 resets))))
          (mv :bounds fn2-core))
         ((unless (fn2-upload-stream-reset-owner-p id gen end fn2-core))
          (mv :owner fn2-core))
         (slot (fn2-upload-row-c1-slot id fn2-core))
         (lease (fn2-upload-row-c1-gen id fn2-core))
         (page (fn2-upload-row-lslot id fn2-core))
         (pgen (fn2-upload-row-lgen id fn2-core))
         ((when (or (equal slot page)
                    (equal slot (fn2-upload-row-c0-slot id fn2-core))))
          (mv :workspace fn2-core))
         ((mv code fn2-core)
          (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
           (code fn2-pool)
           (if (and
             (eq (fn2-pool-workspace-code slot lease *fn2-upload-kind* id gen fn2-pool) :ok)
             (eq (fn2-pool-workspace-code page pgen *fn2-upload-kind* id gen fn2-pool) :ok)
             (eq (fn2-layout-range-code page pgen *fn2-upload-page-stage*
                   (+ *fn2-upload-page-stage* used) nil *fn2-upload-kind* id gen fn2-pool) :ok))
            (fn2-pool-reset slot lease *fn2-upload-kind* id gen fn2-pool)
            (mv :workspace fn2-pool))
           (mv code fn2-core)))
         ((unless (eq code :ok)) (mv code fn2-core))
         (fn2-core (fn2-upload-put-core id (stream-resets (+ 1 resets)) (sready 0))))
     (mv :ok fn2-core)))

   (fn2-core-preserves fn2-upload-stream-reset (id gen fn2-core)
    :position 1 :rows nil
    :hints (("Goal" :do-not '(preprocess))))
   (defcost fn2-upload-stream-reset
    :answers (:ok :owner :state :bounds :workspace)
    :tables (fn2-upload-table fn2-core-pool)
    :doc "After the exact completed window Fence, clear only C1 fill and acknowledge reset; preserve staged bytes and all leases.")))

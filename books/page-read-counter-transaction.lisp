; Internal SAMEpool counter publication around actual caller row effects.
; Actual issued nonce and continuation come from registered CURRENT, never
; a host receipt. No new issuer, domain, pool schema, or refund authority.
(in-package "ACL2")
(include-book "page-read-binding-revision")
(defun fn-prb-fixed-widthp (n x)
 (declare (xargs :guard (natp n)))
 (if (zp n) (null x)
  (and (consp x) (fn-prb-fixed-widthp (- n 1) (cdr x)))))
(defun fn-prb-counter-receiptp (x)
 (declare (xargs :guard t))
 (and (fn-prb-fixed-widthp 6 x) (eq (fn-prl-nth 0 x) :counter-publication)
      (natp (fn-prl-nth 1 x)) (natp (fn-prl-nth 2 x))
      (natp (fn-prl-nth 3 x)) (natp (fn-prl-nth 4 x))
      (symbolp (fn-prl-nth 5 x))))
(defun fn-owner-page-read-counter-begin (next nonce kind continuation fn-page-read-pool)
 (declare (xargs :stobjs fn-page-read-pool :guard t))
 (let* ((data (fn-prp-data fn-page-read-pool))
        (mode (fn-prp-mode fn-page-read-pool))
        (epoch-mode (fn-prp-alloc-mode fn-page-read-pool))
        (revision (fn-prb-data-revision data))
        (current (fn-prl-nth 0 data)))
  (if (not (and data (natp nonce) (symbolp kind) (natp revision)
                (natp (fn-prl-nth 2 current)) (natp (fn-prl-nth 2 next))
                (eq mode :served) (member-eq epoch-mode '(:active :draining))))
   (mv :counter-publication-unavailable nil fn-page-read-pool)
   (let* ((ledger (fn-prb-keep-current-bindings next current))
          (receipt (list :counter-publication nonce (fn-prl-nth 2 current)
                         (fn-prl-nth 2 ledger) revision kind))
          (intent (list :counter-publishing mode epoch-mode data ledger revision receipt continuation))
          (fn-page-read-pool (update-fn-prp-mode intent fn-page-read-pool))
          (fn-page-read-pool (update-fn-prp-alloc-mode :recovery fn-page-read-pool))
          (fn-page-read-pool (update-fn-prp-data (fn-prb-data6 ledger data revision) fn-page-read-pool)))
    (mv :counter-publishing receipt fn-page-read-pool)))))
; Equality is bounded six scalar fields. No binding/continuation graph scan.
(defun fn-prb-counter-receipt-matchesp (a b)
 (declare (xargs :guard t))
 (and (fn-prb-counter-receiptp a) (fn-prb-counter-receiptp b)
      (equal (fn-prl-nth 1 a) (fn-prl-nth 1 b))
      (equal (fn-prl-nth 2 a) (fn-prl-nth 2 b))
      (equal (fn-prl-nth 3 a) (fn-prl-nth 3 b))
      (equal (fn-prl-nth 4 a) (fn-prl-nth 4 b))
      (eq (fn-prl-nth 5 a) (fn-prl-nth 5 b))))
(defun fn-owner-page-read-counter-finish (receipt fn-page-read-pool)
 (declare (xargs :stobjs fn-page-read-pool :guard t))
 (let* ((intent (fn-prp-mode fn-page-read-pool))
        (data (fn-prp-data fn-page-read-pool)))
  (if (not (and (fn-prb-fixed-widthp 8 intent)
                (eq (fn-prl-nth 0 intent) :counter-publishing)
                (eq (fn-prp-alloc-mode fn-page-read-pool) :recovery)
                (fn-prb-counter-receipt-matchesp receipt (fn-prl-nth 6 intent))
                (equal (fn-prb-data-revision data) (fn-prl-nth 4 receipt))
                (equal (fn-prl-nth 2 (fn-prl-nth 0 data)) (fn-prl-nth 3 receipt))))
   (mv :counter-publication-stale fn-page-read-pool)
   (let* ((fn-page-read-pool (update-fn-prp-alloc-mode (fn-prl-nth 2 intent) fn-page-read-pool))
          (fn-page-read-pool (update-fn-prp-mode (fn-prl-nth 1 intent) fn-page-read-pool)))
    (mv :published fn-page-read-pool)))))

; Pre-child variant for actual index transitions whose next ledger is known
; only AFTER their registered child effect. CURRENT references are retained
; before that effect; this is not a host snapshot or a recovery permission.
(defun fn-owner-page-read-counter-prepare (nonce kind continuation fn-page-read-pool)
 (declare (xargs :stobjs fn-page-read-pool :guard t))
 (let* ((data (fn-prp-data fn-page-read-pool))
        (mode (fn-prp-mode fn-page-read-pool))
        (epoch-mode (fn-prp-alloc-mode fn-page-read-pool))
        (revision (fn-prb-data-revision data))
        (current (fn-prl-nth 0 data)))
  (if (not (and data (natp nonce) (symbolp kind) (natp revision)
                (natp (fn-prl-nth 2 current)) (eq mode :served)
                (member-eq epoch-mode '(:active :draining))))
   (mv :counter-publication-unavailable nil fn-page-read-pool)
   (let* ((receipt (list :counter-publication nonce (fn-prl-nth 2 current)
                         (fn-prl-nth 2 current) revision kind))
          (intent (list :counter-preparing mode epoch-mode data current revision receipt continuation))
          (fn-page-read-pool (update-fn-prp-mode intent fn-page-read-pool))
          (fn-page-read-pool (update-fn-prp-alloc-mode :recovery fn-page-read-pool)))
    (mv :counter-preparing receipt fn-page-read-pool)))))
(defun fn-owner-page-read-counter-apply (next prepared-receipt fn-page-read-pool)
 (declare (xargs :stobjs fn-page-read-pool :guard t))
 (let* ((intent (fn-prp-mode fn-page-read-pool))
        (data (fn-prp-data fn-page-read-pool)))
  (if (not (and (fn-prb-fixed-widthp 8 intent)
                (eq (fn-prl-nth 0 intent) :counter-preparing)
                (eq (fn-prp-alloc-mode fn-page-read-pool) :recovery)
                (fn-prb-counter-receipt-matchesp prepared-receipt (fn-prl-nth 6 intent))
                (equal (fn-prb-data-revision data) (fn-prl-nth 4 prepared-receipt))
                (equal (fn-prl-nth 2 (fn-prl-nth 0 data)) (fn-prl-nth 2 prepared-receipt))
                (natp (fn-prl-nth 2 next))))
   (mv :counter-publication-stale nil fn-page-read-pool)
   (let* ((old-data (fn-prl-nth 3 intent))
          (ledger (fn-prb-keep-current-bindings next (fn-prl-nth 0 old-data)))
          (revision (fn-prl-nth 4 prepared-receipt))
          (receipt (list :counter-publication (fn-prl-nth 1 prepared-receipt)
                         (fn-prl-nth 2 prepared-receipt) (fn-prl-nth 2 ledger)
                         revision (fn-prl-nth 5 prepared-receipt)))
          (intent1 (list :counter-publishing (fn-prl-nth 1 intent)
                         (fn-prl-nth 2 intent) old-data ledger revision receipt
                         (fn-prl-nth 7 intent)))
          (fn-page-read-pool (update-fn-prp-mode intent1 fn-page-read-pool))
          (fn-page-read-pool (update-fn-prp-data (fn-prb-data6 ledger old-data revision) fn-page-read-pool)))
    (mv :counter-publishing receipt fn-page-read-pool)))))

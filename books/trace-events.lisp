; Independent queue replay of the diagnostic protocol. A machine visit is
; opened by its actual dequeue, contains completed enqueue effects in order,
; and closes with its ordinary wake and optional self-tail. The existing
; ring's loss counter and incomplete visit suffixes are refusals, never proof.
(in-package "ACL2")
(include-book "trace")
(include-book "queue-model")
(include-book "run-budget")
(defun fn2-trace-event-scalars-p (record widths)
 (declare (xargs :verify-guards nil))
 (if (atom widths) (null record)
  (and (consp record) (unsigned-byte-p (car widths) (car record))
       (fn2-trace-event-scalars-p (cdr record) (cdr widths)))))
(defun fn2-trace-eventp (record)
 (declare (xargs :verify-guards nil))
 (and (true-listp record)
      (fn2-trace-event-scalars-p record '(8 32 16 32 32 32 8 1 32 16 32 32 60 32 60 32 60 32 60))
      (< (car record) *fn2-trace-kind-count*)))
(defun fn2-trace-meta-eventp (record)
 (declare (xargs :verify-guards nil))
 (and (equal (nth 4 record) 0) (equal (nth 5 record) 0) (equal (nth 6 record) 0)
      (equal (nth 7 record) 0) (equal (nth 8 record) *fn2-none*) (equal (nth 9 record) 0)
      (equal (nthcdr 11 record) '(0 0 0 0 0 0 0 0))))
(defun fn2-trace-protocol-step (record open)
 ; (:ok NEXT-OPEN), or (:fail WORD). ENQUEUE is also a complete standalone
 ; event when no machine callback is executing; it creates no pending work.
 (declare (xargs :verify-guards nil))
 (let ((kind (car record)) (identity (list (nth 1 record) (nth 2 record) (nth 3 record) (nth 10 record))))
  (cond
   ((not (fn2-trace-eventp record)) '(:fail :event))
   ((equal kind *fn2-trace-kind-enqueue*)
    (if (and (fn2-trace-meta-eventp record) (not (equal (nth 1 record) *fn2-none*))
             (equal (nth 3 record) 0) (equal (nth 10 record) 0))
        (list :ok open) '(:fail :enqueue)))
   ((equal kind *fn2-trace-kind-machine-start*)
    (if (and (not open) (fn2-trace-meta-eventp record))
        (list :ok identity) '(:fail :nested-start)))
   ((equal kind *fn2-trace-kind-machine*)
    (if (and open (equal identity open)
             (or (not (equal (nth 1 record) *fn2-none*))
                 (and (equal (nth 4 record) 0) (equal (nth 5 record) *fn2-work-empty*)
                      (equal (nth 6 record) 0) (equal (nth 7 record) 0)
                      (equal (nth 8 record) *fn2-none*))))
        (list :ok nil) '(:fail :machine-end)))
   (open '(:fail :interleaved-visit))
   (t (list :ok nil)))))
(defun fn2-trace-events-complete-aux (records open)
 (declare (xargs :verify-guards nil))
 (if (atom records) (and (null records) (not open))
  (let ((step (fn2-trace-protocol-step (car records) open)))
   (and (eq (car step) :ok) (fn2-trace-events-complete-aux (cdr records) (cadr step))))))
(defun fn2-trace-events-completep (records)
 (declare (xargs :verify-guards nil))
 (fn2-trace-events-complete-aux records nil))
(defun fn2-trace-calendar-next (cursor calendar)
 (declare (xargs :verify-guards nil))
 (if (< (+ 1 (nfix cursor)) (len calendar)) (+ 1 (nfix cursor)) 0))
(defun fn2-trace-known-principal-p (principal calendar)
 (declare (xargs :verify-guards nil))
 (if (member-equal (list :principal principal) calendar) t nil))
(defun fn2-trace-enqueue-lists (id principal calendar queues)
 (declare (xargs :verify-guards nil))
 (if (equal id *fn2-none*) (list :ok queues)
  (if (fn2-trace-known-principal-p principal calendar)
      (list :ok (fn2-ref-enqueue id principal queues)) '(:fail :enqueue-principal))))
(defun fn2-trace-replay-aux (records calendar cursor queues open)
 (declare (xargs :verify-guards nil))
 (if (atom records)
     (if (and (null records) (not open)) (list :ok cursor queues) '(:fail :open-visit))
  (let* ((record (car records)) (protocol (fn2-trace-protocol-step record open))
         (kind (nth 0 record)) (id (nth 1 record))
         (principal (nth 2 record)) (position (nth 3 record)))
   (cond
    ((not (eq (car protocol) :ok)) protocol)
    ((equal kind *fn2-trace-kind-enqueue*)
     (let ((enqueued (fn2-trace-enqueue-lists id principal calendar queues)))
      (if (eq (car enqueued) :ok)
          (fn2-trace-replay-aux (cdr records) calendar cursor (cadr enqueued) open) enqueued)))
    ((equal kind *fn2-trace-kind-machine-start*)
     (let ((queue (fn2-ref-queue principal queues)))
      (if (and (equal position cursor) (equal (nth cursor calendar) (list :principal principal))
               (equal id (if (consp queue) (car queue) *fn2-none*)))
          (fn2-trace-replay-aux (cdr records) calendar (fn2-trace-calendar-next cursor calendar)
           (if (consp queue) (fn2-ref-set-queue principal (cdr queue) queues) queues) (cadr protocol))
        '(:fail :dequeue))))
    ((equal kind *fn2-trace-kind-machine*)
     (let* ((ordinary (fn2-trace-enqueue-lists (nth 8 record) (nth 9 record) calendar queues))
            (tail (if (and (eq (car ordinary) :ok) (equal (nth 7 record) 1))
                      (fn2-trace-enqueue-lists id principal calendar (cadr ordinary)) ordinary)))
      (if (eq (car tail) :ok)
          (fn2-trace-replay-aux (cdr records) calendar cursor (cadr tail) nil) tail)))
    ((equal kind *fn2-trace-kind-service*)
     (if (and (equal position cursor) (equal (nth cursor calendar) (list :service principal)))
         (let ((ordinary (fn2-trace-enqueue-lists (nth 8 record) (nth 9 record) calendar queues)))
          (if (eq (car ordinary) :ok)
              (fn2-trace-replay-aux (cdr records) calendar (fn2-trace-calendar-next cursor calendar) (cadr ordinary) nil)
            ordinary))
       '(:fail :service)))
    ((equal kind *fn2-trace-kind-mailbox*)
     ; The established mailbox record names the observed wake target and
     ; its principal in MACHINE/PRINCIPAL; it makes no calendar visit.
     (let ((ordinary (fn2-trace-enqueue-lists id principal calendar queues)))
      (if (eq (car ordinary) :ok)
          (fn2-trace-replay-aux (cdr records) calendar cursor (cadr ordinary) nil) ordinary)))
    (t (fn2-trace-replay-aux (cdr records) calendar cursor queues nil))))))
(defun fn2-trace-calendarp (calendar)
 (declare (xargs :verify-guards nil))
 (if (atom calendar) (null calendar)
  (and (true-listp (car calendar)) (equal (len (car calendar)) 2)
       (member-eq (caar calendar) '(:principal :service)) (unsigned-byte-p 16 (cadar calendar))
       (fn2-trace-calendarp (cdr calendar)))))
(defun fn2-trace-queue-ids-p (ids seen)
 (declare (xargs :verify-guards nil))
 (if (atom ids) (null ids)
  (and (unsigned-byte-p 32 (car ids)) (not (equal (car ids) *fn2-none*))
       (not (member-equal (car ids) seen))
       (fn2-trace-queue-ids-p (cdr ids) (cons (car ids) seen)))))
(defun fn2-trace-queues-p (queues calendar principals ids)
 (declare (xargs :verify-guards nil))
 (if (atom queues) (null queues)
  (and (true-listp (car queues)) (consp (car queues))
       (unsigned-byte-p 16 (caar queues)) (fn2-trace-known-principal-p (caar queues) calendar)
       (not (member-equal (caar queues) principals)) (fn2-trace-queue-ids-p (cdar queues) ids)
       (fn2-trace-queues-p (cdr queues) calendar (cons (caar queues) principals) (append (cdar queues) ids)))))
(defun fn2-trace-replay (records lost calendar cursor queues)
 (declare (xargs :verify-guards nil))
 (if (not (and (equal lost 0) (true-listp calendar) (consp calendar) (fn2-trace-calendarp calendar)
               (natp cursor) (< cursor (len calendar)) (fn2-trace-queues-p queues calendar nil nil)))
     '(:fail :lost-or-calendar)
  (fn2-trace-replay-aux records calendar cursor queues nil)))

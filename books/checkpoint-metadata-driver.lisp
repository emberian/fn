       ((eq (car tree) 'quote) tree)
       ((eq (car tree) 'fn2-checkpoint-root1-mv)
        (cons 'mv (cons (cadr tree) outputs)))
       ((eq (car tree) 'fn2-checkpoint-root1-call)

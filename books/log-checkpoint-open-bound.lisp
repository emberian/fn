; Proof and registry: controls above were checked first.
(local (defthm lca3-read-natural
 (natp (fn-lc-read-octets trace)) :rule-classes :type-prescription
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
     '((:COMPOUND-RECOGNIZER NATP-COMPOUND-RECOGNIZER)
       (:TYPE-PRESCRIPTION FN-LC-READ-OCTETS)))))))
(local (defthm lca3-read-cons-unfolds
 (equal (fn-lc-read-octets (cons request rest))
  (+ (if (equal (car request) :pread) (nfix (nth 3 request)) 0)
     (fn-lc-read-octets rest)))
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
     '((:DEFINITION FIX)
       (:DEFINITION FN-LC-HEAD)
       (:DEFINITION FN-LC-READ-OCTETS)
       (:DEFINITION NFIX)
       (:EXECUTABLE-COUNTERPART TAU-SYSTEM)
       (:REWRITE CAR-CONS)
       (:REWRITE CDR-CONS)
       (:REWRITE COMMUTATIVITY-OF-+)
       (:REWRITE FN-LC-AT-IS-NTH)
       (:REWRITE UNICITY-OF-0)
       (:TYPE-PRESCRIPTION LCA3-READ-NATURAL)))))))
(local (defthm lca3-read-nil-unfolds (equal (fn-lc-read-octets nil) 0)
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
     '((:EXECUTABLE-COUNTERPART EQUAL)
       (:EXECUTABLE-COUNTERPART FN-LC-READ-OCTETS)))))))
(local (defthm lca3-read-of-append
 (equal (fn-lc-read-octets (append a b))
        (+ (fn-lc-read-octets a) (fn-lc-read-octets b)))
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
     '((:DEFINITION BINARY-APPEND)
       (:DEFINITION FIX)
       (:DEFINITION FN-LC-HEAD)
       (:DEFINITION FN-LC-READ-OCTETS)
       (:DEFINITION NFIX)
       (:DEFINITION NOT)
       (:EXECUTABLE-COUNTERPART TAU-SYSTEM)
       (:INDUCTION BINARY-APPEND)
       (:INDUCTION FN-LC-READ-OCTETS)
       (:REWRITE COMMUTATIVITY-OF-+)
       (:REWRITE FN-LC-AT-IS-NTH)
       (:REWRITE LCA3-READ-CONS-UNFOLDS)
       (:REWRITE UNICITY-OF-0)
       (:TYPE-PRESCRIPTION LCA3-READ-NATURAL)))))))
(local (defthm lca3-read-of-take
 (implies (natp n)
  (<= (fn-lc-read-octets (take n trace)) (fn-lc-read-octets trace)))
 
 :rule-classes (:rewrite :linear)
 :hints (("Goal" :induct (take n trace) :in-theory (union-theories (theory 'minimal-theory)
     '((:COMPOUND-RECOGNIZER NATP-COMPOUND-RECOGNIZER)
       (:COMPOUND-RECOGNIZER ZP-COMPOUND-RECOGNIZER)
       (:DEFINITION FIX)
       (:DEFINITION FN-LC-HEAD)
       (:DEFINITION FN-LC-READ-OCTETS)
       (:DEFINITION NATP)
       (:DEFINITION NFIX)
       (:DEFINITION NOT)
       (:DEFINITION TAKE)
       (:EXECUTABLE-COUNTERPART <)
       (:EXECUTABLE-COUNTERPART BINARY-+)
       (:EXECUTABLE-COUNTERPART CAR)
       (:EXECUTABLE-COUNTERPART EQUAL)
       (:EXECUTABLE-COUNTERPART FN-LC-READ-OCTETS)
       (:EXECUTABLE-COUNTERPART INTEGERP)
       (:EXECUTABLE-COUNTERPART NOT)
       (:EXECUTABLE-COUNTERPART NTH)
       (:EXECUTABLE-COUNTERPART TAU-SYSTEM)
       (:EXECUTABLE-COUNTERPART ZP)
       (:INDUCTION TAKE)
       (:REWRITE COMMUTATIVITY-OF-+)
       (:REWRITE DEFAULT-CAR)
       (:REWRITE DEFAULT-CDR)
       (:REWRITE FN-LC-AT-IS-NTH)
       (:REWRITE LCA3-READ-CONS-UNFOLDS)
       (:REWRITE UNICITY-OF-0)
       (:TYPE-PRESCRIPTION LCA3-READ-NATURAL)))))))

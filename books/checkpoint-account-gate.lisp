; Fixed CP7 authority metadata only; no graph validation or account replay.
(in-package "ACL2")
(include-book "snapshot-source-token")
(defun fn-cpa-checkpoint-word (publication)
 (declare (xargs :guard t))
 (let* ((cp (fn-omk-at 1 publication))
        (authority (fn-omk-at 6 cp)))
  (cond ((not (eq (fn-omk-at 0 publication) :ok)) :unavailable)
        ((and cp (not (and (fn-omk-widthp cp 7)
                          (eq (fn-omk-at 0 cp) :consumer-state)
                          (fn-omk-widthp authority 6)
                          (eq (fn-omk-at 0 authority) :authority)))) :unavailable)
        ((fn-omk-at 5 authority) :defer)
        (t :checkpoint))))

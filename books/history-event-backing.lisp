; Canonical all-event backing. Registered records are internal custody, never
; an allocator grant. The genuine producer/family issuer remains unavailable.
(in-package "ACL2")
(include-book "history-event-directory")
(include-book "history-event-provider")
(include-book "state-globals")
(local (defthm fn-hep-fixed-is-true-list
 (implies (fn-hed-fixedp x n) (true-listp x))
 :hints (("Goal" :in-theory (enable fn-hed-fixedp)))))
(defstobj fn-history-backing
 (fn-hep-installed-source :type t :initially nil)
 (fn-hep-epoch :type t :initially nil)
 (fn-hep-provider :type fn-hep-node)
 (fn-hep-provider-depth :type (integer 0 *) :initially 0)
 (fn-hep-builder :type t :initially nil)
 (fn-hep-producer-token :type t :initially nil)
 (fn-hep-producer-phase :type t :initially :unavailable)
 (fn-hep-producer-receipts :type t :initially nil)
 (fn-hep-completion :type t :initially nil)
 (fn-hep-read-cursor :type t :initially nil)
 (fn-hep-capture :type t :initially nil)
 (fn-hep-retirement-cursor :type t :initially nil)
 :inline t)
(defun fn-hep-current (fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (fn-hep-installed-source fn-history-backing))
(defun fn-hep-sourcep (source)
 (declare (xargs :guard t))
 (and (fn-hed-fixedp source 9) (eq (fn-hed-at 0 source) :history-source)
      (natp (fn-hed-at 1 source)) (posp (fn-hed-at 2 source))
      (natp (fn-hed-at 3 source)) (natp (fn-hed-at 5 source))
      (natp (fn-hed-at 6 source)) (natp (fn-hed-at 7 source))
      (natp (fn-hed-at 8 source))))
(defun fn-hep-source-stamps-equal (a b)
 (declare (xargs :guard t))
 (and (fn-hep-sourcep a) (fn-hep-sourcep b)
      (equal (fn-hed-at 1 a) (fn-hed-at 1 b))
      (equal (fn-hed-at 2 a) (fn-hed-at 2 b))
      (equal (fn-hed-at 3 a) (fn-hed-at 3 b))
      (equal (fn-hed-at 7 a) (fn-hed-at 7 b))
      (equal (fn-hed-at 8 a) (fn-hed-at 8 b))))
(defun fn-hep-epoch-livep (source fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (let ((epoch (fn-hep-epoch fn-history-backing)))
  (and (fn-hep-sourcep source) (fn-hed-fixedp epoch 12)
       (eq (fn-hed-at 0 epoch) :history-epoch)
       (equal (fn-hed-at 1 epoch) (fn-hed-at 2 source))
       (eq (fn-hed-at 4 epoch) :live))))
(defun fn-hep-offer-currentp (token fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (and token (equal token (fn-hep-producer-token fn-history-backing))
      (eq (fn-hep-producer-phase fn-history-backing) :reserved)
      (null (fn-hep-builder fn-history-backing))
      (fn-hep-epoch-livep (fn-hep-current fn-history-backing) fn-history-backing)))
; Builder10: tag,phase,row,produced6,context,fields,token,oldSource,cursor,receipts.
(defun fn-hep-offer-produced (row produced context fields token fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (if (not (and (fn-hep-offer-currentp token fn-history-backing)
               (fn-hed-fixedp produced 6)))
  (mv :unavailable fn-history-backing)
  (let* ((builder (list :history-builder :offered row produced context fields token
                       (fn-hep-current fn-history-backing) nil
                       (fn-hep-producer-receipts fn-history-backing)))
         (fn-history-backing (update-fn-hep-builder builder fn-history-backing))
         (fn-history-backing (update-fn-hep-producer-phase :offered fn-history-backing)))
   (mv :offered fn-history-backing))))
(defun fn-hep-builder-readout (fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (let ((builder (fn-hep-builder fn-history-backing)))
  (if (and (fn-hed-fixedp builder 10) (eq (fn-hed-at 0 builder) :history-builder)
           (member-eq (fn-hep-producer-phase fn-history-backing)
                      '(:offered :prepared :completed)))
   (mv :candidate (fn-hed-at 2 builder) (fn-hed-at 3 builder)
                  (fn-hed-at 4 builder) (fn-hed-at 5 builder))
   (mv :unavailable nil nil nil nil))))
; Preparation7 retains actual owner next-ready/paired Store result at slot6.
; Its registration belongs to the actual owner producer, not a public setter.
(defun fn-hep-operation-readout (fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (let ((p (fn-hep-producer-receipts fn-history-backing)))
  (if (and (fn-hed-fixedp p 7) (eq (fn-hed-at 0 p) :history-preparation)
           (member-eq (fn-hep-producer-phase fn-history-backing) '(:prepared :completed :published)))
   (mv :operation (fn-hed-at 1 p) (fn-hed-at 2 p) (fn-hed-at 6 p))
   (mv :unavailable nil nil nil))))
(defun fn-hep-completion-matchesp (receipt token fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (let ((p (fn-hep-producer-receipts fn-history-backing)))
  (and (fn-hed-fixedp receipt 3) (eq (fn-hed-at 0 receipt) :history-completion)
       (natp (fn-hed-at 2 receipt)) token
       (equal token (fn-hep-producer-token fn-history-backing))
       (equal token (fn-hed-at 1 receipt))
       (fn-hed-fixedp p 7) (eq (fn-hed-at 0 p) :history-preparation)
       (equal token (fn-hed-at 1 p))
       (equal (fn-hed-at 2 receipt) (fn-hed-at 2 p))
       (fn-hep-epoch-livep (fn-hed-at 7 (fn-hep-builder fn-history-backing)) fn-history-backing))))
(defun fn-hep-register-completion-internal (receipt token fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (cond ((not (fn-hep-completion-matchesp receipt token fn-history-backing))
        (mv :unavailable fn-history-backing))
       ((and (member-eq (fn-hep-producer-phase fn-history-backing) '(:completed :published))
             (equal receipt (fn-hep-completion fn-history-backing)))
        (mv :already-completed fn-history-backing))
       ((not (eq (fn-hep-producer-phase fn-history-backing) :prepared))
        (mv :unavailable fn-history-backing))
       (t (let* ((fn-history-backing (update-fn-hep-completion receipt fn-history-backing))
                 (fn-history-backing (update-fn-hep-producer-phase :completed fn-history-backing)))
            (mv :completed fn-history-backing)))))
(defun fn-hep-fence-current (token fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (if (and token (equal token (fn-hep-producer-token fn-history-backing))
          (not (eq (fn-hep-producer-phase fn-history-backing) :published)))
  (let ((fn-history-backing (update-fn-hep-producer-phase :fenced fn-history-backing)))
   (mv :recovery-required fn-history-backing))
  (mv :unavailable fn-history-backing)))
(defun fn-hep-page-read (source leaf ordinal captured fuel fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (if (not (and (fn-hep-epoch-livep source fn-history-backing) (fn-hed-leafp leaf)
               (equal (fn-hed-at 4 leaf) (fn-hed-at 2 source))
               (natp ordinal) (< ordinal (fn-hed-at 7 source))
               (natp captured) (<= captured 256) (natp fuel)
               (<= (fn-hed-at 5 leaf) ordinal)
               (< ordinal (+ 256 (fn-hed-at 5 leaf)))))
  (mv :unavailable nil (nfix fuel))
  (stobj-let ((fn-hep-node (fn-hep-provider fn-history-backing)))
   (word row left)
   (fn-hep-node-read (fn-hed-at 1 leaf) (fn-hep-provider-depth fn-history-backing)
     (fn-hed-at 4 leaf) (fn-hed-at 2 leaf) (fn-hed-at 3 leaf) ordinal
     (fn-hed-at 5 leaf) captured fuel fn-hep-node)
   (mv word row left))))
(defun fn-hep-publish-current (receipt fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (let* ((p (fn-hep-producer-receipts fn-history-backing))
        (builder (fn-hep-builder fn-history-backing))
        (old (fn-hed-at 7 builder)) (next (fn-hed-at 3 p)) (leaf (fn-hed-at 4 p))
        (expected (fn-hed-at 5 p)) (depth (fn-hep-provider-depth fn-history-backing)))
  (cond
   ((not (and (equal receipt (fn-hep-completion fn-history-backing))
              (fn-hep-completion-matchesp receipt (fn-hep-producer-token fn-history-backing)
                                          fn-history-backing)))
    (mv :unavailable fn-history-backing))
   ((eq (fn-hep-producer-phase fn-history-backing) :published)
    (mv :consumed fn-history-backing))
   ; C-only preparation is recorded by the actual owner issuer. It changes
   ; the persisted publication association, with no row append or F growth.
   ((and (eq (fn-hep-producer-phase fn-history-backing) :completed)
          (fn-hed-fixedp builder 10) (eq (fn-hed-at 0 builder) :history-builder)
          (fn-hep-source-stamps-equal old (fn-hep-current fn-history-backing))
          (fn-hep-sourcep next) (eq expected :control)
          (equal (fn-hed-at 2 next) (fn-hed-at 2 old))
          (equal (fn-hed-at 3 next) (fn-hed-at 3 old))
          (equal (fn-hed-at 7 next) (fn-hed-at 7 old)))
    (let* ((fn-history-backing (update-fn-hep-installed-source next fn-history-backing))
           (fn-history-backing (update-fn-hep-producer-phase :published fn-history-backing)))
     (mv :published fn-history-backing)))
   ((not (and (eq (fn-hep-producer-phase fn-history-backing) :completed)
               (fn-hed-fixedp builder 10) (eq (fn-hed-at 0 builder) :history-builder)
               (fn-hep-source-stamps-equal old (fn-hep-current fn-history-backing))
               (fn-hep-sourcep next) (fn-hed-leafp leaf) (natp expected) (< expected 256)
               (equal (fn-hed-at 2 next) (fn-hed-at 2 old))
               (equal (fn-hed-at 7 next) (+ 1 (fn-hed-at 7 old)))
               (equal (fn-hed-at 4 leaf) (fn-hed-at 2 old))
               (equal (+ (fn-hed-at 5 leaf) expected) (fn-hed-at 7 old))))
    (mv :unavailable fn-history-backing))
   (t
    (mv-let (word fn-history-backing)
     (stobj-let ((fn-hep-node (fn-hep-provider fn-history-backing)))
      (word fn-hep-node)
      (fn-hep-node-append (fn-hed-at 1 leaf) depth
       (fn-hed-at 4 leaf) (fn-hed-at 2 leaf) (fn-hed-at 3 leaf) (fn-hed-at 5 leaf)
       expected (fn-hed-at 2 builder) fn-hep-node)
      (mv word fn-history-backing))
     (if (eq word :appended)
      (let* ((fn-history-backing (update-fn-hep-installed-source next fn-history-backing))
             (fn-history-backing (update-fn-hep-producer-phase :published fn-history-backing)))
       (mv :published fn-history-backing))
      (mv word fn-history-backing)))))))
(defun fn-hep-candidate-read-begin (ordinal fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (let* ((b (fn-hep-builder fn-history-backing)) (old (fn-hed-at 7 b)))
  (if (not (and (fn-hed-fixedp b 10) (eq (fn-hed-at 0 b) :history-builder)
                (member-eq (fn-hep-producer-phase fn-history-backing) '(:offered :prepared :completed))
                (fn-hep-sourcep old) (natp ordinal) (<= ordinal (fn-hed-at 7 old))))
   (mv :range fn-history-backing)
   (let ((cursor (if (equal ordinal (fn-hed-at 7 old)) (list :pending-row ordinal)
                   (fn-hed-read-begin (fn-hed-at 4 old) (fn-hed-at 6 old) ordinal))))
    (let ((fn-history-backing (update-fn-hep-read-cursor cursor fn-history-backing)))
     (mv :reading fn-history-backing))))))
(defun fn-hep-candidate-read-step (fuel fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (let ((cursor (fn-hep-read-cursor fn-history-backing))
       (b (fn-hep-builder fn-history-backing)))
  (cond ((or (not (natp fuel)) (zp fuel)) (mv :yield nil (nfix fuel) fn-history-backing))
        ((not (member-eq (fn-hep-producer-phase fn-history-backing) '(:offered :prepared :completed)))
         (mv :unavailable nil fuel fn-history-backing))
        ((eq (fn-hed-at 0 cursor) :pending-row)
         (mv :row (fn-hed-at 2 b) (- fuel 1) fn-history-backing))
        (t (mv-let (word next leaf) (fn-hed-read-step cursor)
             (let ((fn-history-backing (update-fn-hep-read-cursor next fn-history-backing)))
              (if (eq word :leaf)
               (let* ((source (fn-hed-at 7 b)) (base (fn-hed-at 5 leaf))
                      (count (if (and (natp base) (fn-hep-sourcep source) (<= base (fn-hed-at 7 source)))
                               (min 256 (- (fn-hed-at 7 source) base)) 0)))
                (mv-let (w row left) (fn-hep-page-read source leaf (fn-hed-at 7 next) count (- fuel 1) fn-history-backing)
                 (mv w row left fn-history-backing)))
               (mv word nil (- fuel 1) fn-history-backing))))))))

; Actual STATE capture slot is authority to establish/return this one pin.
; The singleton custody format bounds the transition; epochs have no data cap.
(defun fn-hep-capture-retain (token state fn-history-backing)
 (declare (xargs :stobjs (state fn-history-backing) :guard t))
 (let* ((slot (if (f-boundp-global 'fn-owner-history-capture state)
                (f-get-global 'fn-owner-history-capture state) nil))
        (source (fn-hed-at 3 slot)) (epoch (fn-hep-epoch fn-history-backing)))
  (cond
   ((and token (fn-hed-fixedp slot 7) (eq (fn-hed-at 0 slot) :history-capture)
          (equal token (fn-hed-at 1 slot)) (eq (fn-hed-at 5 slot) :retained)
          (equal token (fn-hed-at 0 (fn-hep-capture fn-history-backing)))
          (fn-hep-source-stamps-equal source (fn-hed-at 1 (fn-hep-capture fn-history-backing)))
          (fn-hep-epoch-livep source fn-history-backing)
          (equal (fn-hed-at 2 slot) (fn-hed-at 2 epoch))
          (equal (fn-hed-at 6 epoch) 1))
    (mv :already-retained fn-history-backing))
   ((not (and token (fn-hed-fixedp slot 7) (eq (fn-hed-at 0 slot) :history-capture)
              (equal token (fn-hed-at 1 slot)) (eq (fn-hed-at 5 slot) :retained)
              (fn-hep-source-stamps-equal source (fn-hep-current fn-history-backing))
              (fn-hep-epoch-livep source fn-history-backing)
              (equal (fn-hed-at 2 slot) (fn-hed-at 2 epoch))
              (equal (fn-hed-at 6 epoch) 0) (null (fn-hep-capture fn-history-backing))))
    (mv :unavailable fn-history-backing))
   (t (let* ((fn-history-backing
              (update-fn-hep-capture (list token (fn-hep-current fn-history-backing)) fn-history-backing))
             (fn-history-backing (update-fn-hep-epoch (update-nth 6 1 epoch) fn-history-backing)))
        (mv :retained fn-history-backing))))))
(defun fn-hep-capture-return (token state fn-history-backing)
 (declare (xargs :stobjs (state fn-history-backing) :guard t))
 (let* ((slot (if (f-boundp-global 'fn-owner-history-capture state)
                (f-get-global 'fn-owner-history-capture state) nil))
        (read (if (f-boundp-global 'fn-owner-history-read state)
                (f-get-global 'fn-owner-history-read state) nil))
        (capture (fn-hep-capture fn-history-backing)) (epoch (fn-hep-epoch fn-history-backing)))
  (if (not (and token (fn-hed-fixedp slot 7) (eq (fn-hed-at 0 slot) :history-capture)
                (equal token (fn-hed-at 1 slot)) (eq (fn-hed-at 5 slot) :quiescent)
                (null (fn-hed-at 6 slot)) (null read)
                (equal token (fn-hed-at 0 capture))
                (fn-hep-source-stamps-equal (fn-hed-at 3 slot) (fn-hed-at 1 capture))
                (fn-hed-fixedp epoch 12) (equal (fn-hed-at 6 epoch) 1)))
   (mv :unavailable fn-history-backing)
   (let* ((fn-history-backing (update-fn-hep-capture nil fn-history-backing))
          (fn-history-backing (update-fn-hep-epoch (update-nth 6 0 epoch) fn-history-backing)))
    (mv :returned fn-history-backing)))))
(defun fn-hep-capture-livep (source token fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (let ((capture (fn-hep-capture fn-history-backing)) (epoch (fn-hep-epoch fn-history-backing)))
  (and token (equal token (fn-hed-at 0 capture))
       (fn-hep-source-stamps-equal source (fn-hed-at 1 capture))
       (fn-hep-epoch-livep source fn-history-backing)
       (equal (fn-hed-at 6 epoch) 1))))

(defthm fn-hep-offer-retains-exact-row-and-complete-producer
 (implies (and (fn-hep-offer-currentp token fn-history-backing)
                (fn-hed-fixedp produced 6))
  (equal (fn-hep-builder-readout
           (mv-nth 1 (fn-hep-offer-produced row produced context fields token fn-history-backing)))
         (mv :candidate row produced context fields)))
 :rule-classes nil
 :hints (("Goal" :in-theory (enable fn-hep-offer-produced fn-hep-builder-readout fn-hed-at))))
(defthm fn-hep-completion-replay-by-definition
 (implies (and (fn-hep-completion-matchesp receipt token fn-history-backing)
                (member-eq (fn-hep-producer-phase fn-history-backing) '(:completed :published))
                (equal receipt (fn-hep-completion fn-history-backing)))
  (equal (fn-hep-register-completion-internal receipt token fn-history-backing)
         (mv :already-completed fn-history-backing)))
 :rule-classes nil)
(defthm fn-hep-published-replay-by-definition
 (implies (and (fn-hep-completion-matchesp receipt (fn-hep-producer-token fn-history-backing)
                                          fn-history-backing)
                (equal receipt (fn-hep-completion fn-history-backing))
                (eq (fn-hep-producer-phase fn-history-backing) :published))
  (equal (fn-hep-publish-current receipt fn-history-backing)
         (mv :consumed fn-history-backing)))
 :rule-classes nil
 :hints (("Goal" :in-theory (e/d (fn-hep-publish-current)
                        (fn-hep-completion-matchesp fn-hep-node-append)))))
(defthm fn-hep-uncertain-keeps-candidate-roots-and-debt
 (let ((after (mv-nth 1 (fn-hep-fence-current token fn-history-backing))))
  (and (equal (fn-hep-current after) (fn-hep-current fn-history-backing))
       (equal (fn-hep-builder after) (fn-hep-builder fn-history-backing))
       (equal (fn-hep-producer-receipts after) (fn-hep-producer-receipts fn-history-backing))
       (equal (fn-hep-epoch after) (fn-hep-epoch fn-history-backing))))
 :rule-classes nil)
(defthm fn-hep-return-cannot-drop-nonquiescent-custody
 (implies (and (f-boundp-global 'fn-owner-history-capture state)
                (not (eq (fn-hed-at 5 (f-get-global 'fn-owner-history-capture state)) :quiescent)))
  (equal (fn-hep-capture-return token state fn-history-backing)
         (mv :unavailable fn-history-backing)))
 :rule-classes nil
 :hints (("Goal" :in-theory (e/d (fn-hep-capture-return) (fn-hep-source-stamps-equal fn-hed-at)))))

; Retirement plans are readouts, not authority to free. A registered physical
; return producer must fill retirement-cursor from its actual relinquishment
; receipt. No native setter or Boolean-completion route exists here.
(defun fn-hep-retirement-ready-p (fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (let ((epoch (fn-hep-epoch fn-history-backing)))
  (and (fn-hed-fixedp epoch 12) (eq (fn-hed-at 0 epoch) :history-epoch)
       (posp (fn-hed-at 1 epoch)) (eq (fn-hed-at 4 epoch) :retiring)
       (null (fn-hed-at 5 epoch)) (equal (fn-hed-at 6 epoch) 0)
       (equal (fn-hed-at 7 epoch) 0) (null (fn-hep-capture fn-history-backing))
       (not (equal (fn-hed-at 1 epoch) (fn-hed-at 2 (fn-hep-current fn-history-backing)))))))
(defun fn-hep-retirement-plan (fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (let* ((epoch (fn-hep-epoch fn-history-backing)) (pages (fn-hed-at 8 epoch))
        (metadata (fn-hed-at 9 epoch)))
  (cond ((not (fn-hep-retirement-ready-p fn-history-backing))
         (mv :unavailable nil nil nil nil))
        ((consp pages) (mv :retirement-candidate :page (car pages) (fn-hed-at 1 epoch) (fn-hed-at 3 epoch)))
        ((consp metadata) (mv :retirement-candidate :metadata (car metadata) (fn-hed-at 1 epoch) (fn-hed-at 3 epoch)))
        ((and (null pages) (null metadata))
         (mv :inventory-exhausted nil nil (fn-hed-at 1 epoch) (fn-hed-at 3 epoch)))
        (t (mv :recovery-required nil nil nil nil)))))
(defun fn-hep-retire-return-internal (fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :guard t))
 (let* ((epoch (fn-hep-epoch fn-history-backing))
        (receipt (fn-hep-retirement-cursor fn-history-backing))
        (pages (fn-hed-at 8 epoch)) (metadata (fn-hed-at 9 epoch))
        (kind (if (consp pages) :page :metadata))
        (head (if (consp pages) (car pages) (if (consp metadata) (car metadata) nil))))
  (if (not (and (fn-hep-retirement-ready-p fn-history-backing)
                (or (consp pages) (and (null pages) (consp metadata)))
                (fn-hed-fixedp receipt 6) (eq (fn-hed-at 0 receipt) :history-handle-return)
                (equal (fn-hed-at 1 receipt) (fn-hed-at 1 epoch))
                (equal (fn-hed-at 2 receipt) (fn-hed-at 3 epoch))
                (eq (fn-hed-at 3 receipt) kind) (equal (fn-hed-at 4 receipt) head)
                (fn-hed-at 5 receipt)))
   (mv :unavailable fn-history-backing)
   (let* ((next (update-nth (if (eq kind :page) 8 9)
                           (if (eq kind :page) (cdr pages) (cdr metadata)) epoch))
          (fn-history-backing (update-fn-hep-epoch next fn-history-backing))
          (fn-history-backing (update-fn-hep-retirement-cursor nil fn-history-backing)))
    (mv :retired-handle fn-history-backing)))))
; Empty inventory alone never retires the epoch or returns retained debt.
(local (defthm fn-hep-at-is-nth
 (implies (natp n) (equal (fn-hed-at n x) (nth n x)))
 :hints (("Goal" :in-theory (enable fn-hed-at nth)))))
(defthm fn-hep-retirement-keeps-epoch-and-retained-debt
 (let* ((after (mv-nth 1 (fn-hep-retire-return-internal fn-history-backing)))
        (before-epoch (fn-hep-epoch fn-history-backing)) (after-epoch (fn-hep-epoch after)))
  (and (equal (fn-hed-at 1 after-epoch) (fn-hed-at 1 before-epoch))
       (equal (fn-hed-at 4 after-epoch) (fn-hed-at 4 before-epoch))
       (equal (fn-hed-at 10 after-epoch) (fn-hed-at 10 before-epoch))
       (equal (fn-hep-current after) (fn-hep-current fn-history-backing))))
 :rule-classes nil)

(defthm fn-hep-completion-registration-is-once-only
 (implies (and (fn-hep-completion-matchesp receipt token fn-history-backing)
                (eq (fn-hep-producer-phase fn-history-backing) :prepared))
  (let ((after (mv-nth 1 (fn-hep-register-completion-internal receipt token fn-history-backing))))
   (equal (fn-hep-register-completion-internal receipt token after)
          (mv :already-completed after))))
 :rule-classes nil
 :hints (("Goal" :in-theory (enable fn-hep-register-completion-internal
                                    fn-hep-completion-matchesp))))
(defthm fn-hep-successful-publication-is-once-only
 (implies (and (fn-history-backingp fn-history-backing)
               (equal (mv-nth 0 (fn-hep-publish-current receipt fn-history-backing)) :published))
  (let ((after (mv-nth 1 (fn-hep-publish-current receipt fn-history-backing))))

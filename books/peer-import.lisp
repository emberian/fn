; Internal C import producer. Its snapshot pool taking is owned privately;
; the pool has no immutable mode. No carrier or authority entry is added here.
(in-package "ACL2")
(include-book "machines-c-read")
(fn2-book-layer :c)
; These fixed bounded copies share the generated schema's physical layout.
(assert-event
 (and (equal *fn2-identity-evidence-entry-num-fields* 11)
      (equal *fn2-identity-history-entry-num-fields* 11)
      (equal (fn2-run-layout-keys 1) 9) (equal (fn2-run-layout-keys 11) 9)
      (equal (fn2-run-layout-octets-max 1 1) 250) (equal (fn2-run-layout-octets-max 1 4) 32)
      (equal (fn2-run-layout-octets-max 11 1) 250) (equal (fn2-run-layout-octets-max 11 4) 32)
      (equal *fn2-identity-evidence-entry-field-namespace* 0)
      (equal *fn2-identity-evidence-entry-field-name* 1)
      (equal *fn2-identity-evidence-entry-field-profile* 2)
      (equal *fn2-identity-evidence-entry-field-algorithm* 3)
      (equal *fn2-identity-evidence-entry-field-digest* 4)
      (equal *fn2-identity-evidence-entry-field-lineage* 5)
      (equal *fn2-identity-evidence-entry-field-domain* 6)
      (equal *fn2-identity-evidence-entry-field-incarnation* 7)
      (equal *fn2-identity-evidence-entry-field-occurrence* 8)
      (equal *fn2-identity-evidence-entry-field-kind* 9)
      (equal *fn2-identity-evidence-entry-field-issuer* 10)
      (equal *fn2-identity-history-entry-field-namespace* 0)
      (equal *fn2-identity-history-entry-field-name* 1)
      (equal *fn2-identity-history-entry-field-profile* 2)
      (equal *fn2-identity-history-entry-field-algorithm* 3)
      (equal *fn2-identity-history-entry-field-digest* 4)
      (equal *fn2-identity-history-entry-field-lineage* 5)
      (equal *fn2-identity-history-entry-field-domain* 6)
      (equal *fn2-identity-history-entry-field-incarnation* 7)
      (equal *fn2-identity-history-entry-field-position* 8)
      (equal *fn2-identity-history-entry-field-evidence* 9)
      (equal *fn2-identity-history-entry-field-article* 10)
      ))


; These two transient materializations use empty upper slot regions; only
; slots 0..3 are declared. They precede the separate identity query/run area.
(defconst *fn2-peer-import-e* (* 20 *fn2-succ-block*))
(defconst *fn2-peer-import-h* (* 21 *fn2-succ-block*))
(defconst *fn2-peer-import-checkpoint-slot* 4)
(defconst *fn2-peer-import-checkpoint-sid* 6)
(assert-event (and (< 3 20) (<= (+ *fn2-peer-import-e* 11) *fn2-peer-import-h*)
                   (<= (+ *fn2-peer-import-h* 11) *fn2-idc-ident*)))

(defun fn2-peer-import-room (base b0 fn2-fields)
 (declare (xargs :stobjs fn2-fields :guard (fn2-fields-wfp fn2-fields)))
 (and (unsigned-byte-p 32 base) (natp b0) (<= (+ base 11) (fn2-fields-rows fn2-fields))
      (or (<= (+ base 11) b0) (<= (+ b0 *fn2-idc-stride*) base))))
(in-theory (disable fn2-peer-import-room))

; Validate all logical scalar fields and both concrete octet tags.
(defun fn2-peer-import-typed (n j sid base fn2-fields)
 (declare (xargs :stobjs fn2-fields :measure (nfix n)
 :guard (and (fn2-fields-wfp fn2-fields) (natp n) (natp j))))
 (if (zp n) t
  (and (natp base) (< (+ base j) (fn2-fields-rows fn2-fields))
       (if (or (equal j 1) (equal j 4))
           (and (equal (fn2-fields-value (+ base j) fn2-fields) (if (equal j 4) 1 0))
                (if (equal j 4) (equal (fn2-fields-ref-len (+ base j) fn2-fields) 32)
                  (and (< 0 (fn2-fields-ref-len (+ base j) fn2-fields))
                       (<= (fn2-fields-ref-len (+ base j) fn2-fields) 250))))
         (and (unsigned-byte-p 60 (fn2-fields-value (+ base j) fn2-fields))
              (fn2-run-layout-value-ok sid j (fn2-fields-value (+ base j) fn2-fields))))
       (fn2-peer-import-typed (- n 1) (+ j 1) sid base fn2-fields))))
(in-theory (disable fn2-peer-import-typed))

; Compare tags, logical scalars and actual octets, never reference equality.
(defun fn2-peer-import-equal (j n a b ok os og fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :measure (nfix (- (nfix n) (nfix j)))
 :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (natp j) (natp n) (< j n))) t)
      ((unless (and (<= n 11) (natp a) (natp b)
                    (< (+ a j) (fn2-fields-rows fn2-fields)) (< (+ b j) (fn2-fields-rows fn2-fields)))) nil)
      ((unless (equal (fn2-fields-value (+ a j) fn2-fields) (fn2-fields-value (+ b j) fn2-fields))) nil)
      ((mv code order)
       (if (or (equal j 1) (equal j 4))
           (fn2-run-octets-field-compare (+ a j) (+ b j) ok os og ok os og fn2-fields fn2-pool)
         (mv :ok :eq)))
      ((unless (and (eq code :ok) (eq order :eq))) nil))
  (fn2-peer-import-equal (+ j 1) n a b ok os og fn2-fields fn2-pool)))
(in-theory (disable fn2-peer-import-equal))

; Materialize only retained state, not current caller input.
(defun fn2-peer-import-materialize (tx b0 fn2-peer-imports fn2-fields)
 (declare (xargs :stobjs (fn2-peer-imports fn2-fields)
 :guard (and (fn2-peer-imports-wfp fn2-peer-imports) (fn2-fields-wfp fn2-fields))))
 (b* (((unless (and (natp tx) (< tx (fn2-peer-imports-rows fn2-peer-imports)) (natp b0)
                    (<= (+ b0 *fn2-idc-stride*) (fn2-fields-rows fn2-fields)))) (mv :bounds fn2-fields))
      (slot (fn2-peer-imports-slot tx fn2-peer-imports)) (gen (fn2-peer-imports-gen tx fn2-peer-imports))
      (nl (fn2-peer-imports-name-len tx fn2-peer-imports))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-e* 0) (value (fn2-peer-imports-namespace tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-e* 1) (value 0) (ref-slot slot) (ref-gen gen) (ref-off 0) (ref-len nl)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-e* 2) (value (fn2-peer-imports-profile tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-e* 3) (value (fn2-peer-imports-algorithm tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-e* 4) (value 1) (ref-slot slot) (ref-gen gen) (ref-off nl) (ref-len 32)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-e* 5) (value (fn2-peer-imports-lineage tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-e* 6) (value (fn2-peer-imports-domain tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-e* 7) (value (fn2-peer-imports-incarnation tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-e* 8) (value (fn2-peer-imports-occurrence tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-e* 9) (value (fn2-peer-imports-kind tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-e* 10) (value (fn2-peer-imports-issuer tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-h* 0) (value (fn2-peer-imports-namespace tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-h* 1) (value 0) (ref-slot slot) (ref-gen gen) (ref-off 0) (ref-len nl)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-h* 2) (value (fn2-peer-imports-profile tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-h* 3) (value (fn2-peer-imports-algorithm tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-h* 4) (value 1) (ref-slot slot) (ref-gen gen) (ref-off nl) (ref-len 32)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-h* 5) (value (fn2-peer-imports-lineage tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-h* 6) (value (fn2-peer-imports-domain tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-h* 7) (value (fn2-peer-imports-incarnation tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-h* 8) (value (fn2-peer-imports-position tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-h* 9) (value (fn2-peer-imports-evidence tx fn2-peer-imports)) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ b0 *fn2-peer-import-h* 10) (value (fn2-peer-imports-article tx fn2-peer-imports)) (ref-len 0)))
      ) (mv :ok fn2-fields)))
(fn2-rd-shape fn2-peer-import-materialize (tx b0 fn2-peer-imports fn2-fields)
 ((fn2-fields 1)) (fn2-peer-imports fn2-fields))

(defun fn2-peer-import-start-key (tx base ok os og b0 fn2-succ-txns fn2-id-decides fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-succ-txns fn2-id-decides fn2-fields fn2-pool)
 :guard (and (fn2-succ-txns-wfp fn2-succ-txns) (fn2-id-decides-wfp fn2-id-decides) (fn2-fields-wfp fn2-fields)
             (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (natp tx) (< tx (fn2-id-decides-rows fn2-id-decides))
                    (natp base) (<= (+ base 11) (fn2-fields-rows fn2-fields))))
       (mv :bounds fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
      (ns (fn2-fields-value base fn2-fields)) (profile (fn2-fields-value (+ base 2) fn2-fields))
      (algorithm (fn2-fields-value (+ base 3) fn2-fields))
      ((unless (and (unsigned-byte-p 60 ns) (unsigned-byte-p 8 profile) (unsigned-byte-p 8 algorithm)))
       (mv :bounds fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
      ((mv code fn2-succ-txns fn2-id-decides fn2-fields fn2-pool)
       (fn2-id-decide-start tx (fn2-fields-ref-slot (+ base 1) fn2-fields) (fn2-fields-ref-gen (+ base 1) fn2-fields)
        (fn2-fields-ref-off (+ base 1) fn2-fields) (fn2-fields-ref-len (+ base 1) fn2-fields)
        (fn2-fields-ref-slot (+ base 4) fn2-fields) (fn2-fields-ref-gen (+ base 4) fn2-fields)
        (fn2-fields-ref-off (+ base 4) fn2-fields) ok os og b0 fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
      (fn2-id-decides (fn2-id-decides-put tx (qnamespace ns) (qprofile profile) (qalgorithm algorithm)))
      ((mv code fn2-fields) (fn2-id-query-rebuild tx b0 fn2-id-decides fn2-fields)))
  (mv code fn2-succ-txns fn2-id-decides fn2-fields fn2-pool)))
(fn2-idc-fn-shape fn2-peer-import-start-key
 (tx base ok os og b0 fn2-succ-txns fn2-id-decides fn2-fields fn2-pool)
 (fn2-succ-txns fn2-id-decides fn2-fields fn2-pool) (fn2-succ-txns fn2-id-decides fn2-fields fn2-pool) t
 (fn2-id-decide-start fn2-id-query-rebuild fn2-fields-value fn2-fields-ref-slot fn2-fields-ref-gen fn2-fields-ref-off fn2-fields-ref-len))

(defun fn2-peer-import-empty (n s fn2-succ-slots)
 (declare (xargs :stobjs fn2-succ-slots :measure (nfix n)
 :guard (and (fn2-succ-slots-wfp fn2-succ-slots) (natp n) (natp s))))
 (if (zp n) t
  (and (< s (fn2-succ-slots-rows fn2-succ-slots))
       (equal (fn2-succ-slots-phase s fn2-succ-slots) *fn2-succ-slot-phase-empty*)
       (fn2-peer-import-empty (- n 1) (+ s 1) fn2-succ-slots))))
(in-theory (disable fn2-peer-import-empty))

(defun fn2-peer-import-start-child (tx base hb receipt ok os og b0
 fn2-peer-imports fn2-succ-txns fn2-succ-slots fn2-id-decides fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-peer-imports fn2-succ-txns fn2-succ-slots fn2-id-decides fn2-fields fn2-pool)
 :guard (and (fn2-peer-imports-wfp fn2-peer-imports) (fn2-succ-txns-wfp fn2-succ-txns)
             (fn2-succ-slots-wfp fn2-succ-slots) (fn2-id-decides-wfp fn2-id-decides)
             (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))
 :guard-hints (("Goal" :in-theory (enable fn2-peer-import-room fn2-peer-import-typed)))))
 (b* (((unless (and (natp tx) (< tx (fn2-peer-imports-rows fn2-peer-imports))
                    (< tx (fn2-succ-txns-rows fn2-succ-txns)) (< tx (fn2-id-decides-rows fn2-id-decides))
                    (equal (fn2-peer-imports-phase tx fn2-peer-imports) *fn2-peer-import-phase-idle*)
                    (equal (fn2-id-decides-phase tx fn2-id-decides) *fn2-id-decide-phase-idle*)
                    (equal (fn2-id-decides-qmask tx fn2-id-decides) 0)
                    (equal (fn2-id-decides-qwake tx fn2-id-decides) 0)
                    (equal (fn2-succ-txns-phase tx fn2-succ-txns) *fn2-succ-phase-idle*)
                    (fn2-peer-import-empty *fn2-succ-slots* (* tx *fn2-succ-slots*) fn2-succ-slots)))
       (mv :state fn2-peer-imports fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
      ((unless (and (fn2-peer-import-room base b0 fn2-fields) (natp b0)
                    (<= (+ b0 *fn2-idc-stride*) (fn2-fields-rows fn2-fields))
                    (unsigned-byte-p 8 ok) (unsigned-byte-p 32 os) (unsigned-byte-p 60 og)
                    (fn2-peer-import-typed 11 0 1 base fn2-fields)
                    (or (not receipt) (and (fn2-peer-import-room hb b0 fn2-fields)
                       (fn2-peer-import-typed 11 0 11 hb fn2-fields)
                       (fn2-peer-import-equal 0 8 base hb ok os og fn2-fields fn2-pool)
                       (equal (fn2-fields-value (+ base 8) fn2-fields) (fn2-fields-value (+ hb 9) fn2-fields))))))
       (mv :bounds fn2-peer-imports fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
      (class (fn2-pool-class-for 282 fn2-pool))
      ((when (null class)) (mv :pool fn2-peer-imports fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
      ((mv code slot gen fn2-pool) (fn2-pool-reserve class ok os og fn2-pool))
      ((unless (and (eq code :ok) (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen)))
       (mv code fn2-peer-imports fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
      (nl (fn2-fields-ref-len (+ base 1) fn2-fields))
      ; Register the taking before any fallible copy; failed starts retain it for abort.
      (fn2-peer-imports (fn2-peer-imports-put tx (phase *fn2-peer-import-phase-failed*)
       (query-incarnation (fn2-id-decides-query-incarnation tx fn2-id-decides)) (query-held 0)
       (slot slot) (gen gen) (ok ok) (os os) (og og) (base base) (hbase (if receipt hb 0))
       (receipt (if receipt 1 0)) (name-len nl)
       (namespace (fn2-fields-value (+ base 0) fn2-fields))
       (profile (fn2-fields-value (+ base 2) fn2-fields))
       (algorithm (fn2-fields-value (+ base 3) fn2-fields))
       (lineage (fn2-fields-value (+ base 5) fn2-fields))
       (domain (fn2-fields-value (+ base 6) fn2-fields))
       (incarnation (fn2-fields-value (+ base 7) fn2-fields))
       (occurrence (fn2-fields-value (+ base 8) fn2-fields))
       (kind (fn2-fields-value (+ base 9) fn2-fields))
       (issuer (fn2-fields-value (+ base 10) fn2-fields))
       (position (if receipt (fn2-fields-value (+ hb 8) fn2-fields) 0))
       (evidence (if receipt (fn2-fields-value (+ hb 9) fn2-fields) 0))
       (article (if receipt (fn2-fields-value (+ hb 10) fn2-fields) 0))
       ))
      ((mv code fn2-pool)
       (fn2-rd-copy nl (fn2-fields-ref-slot (+ base 1) fn2-fields) (fn2-fields-ref-gen (+ base 1) fn2-fields)
        (fn2-fields-ref-off (+ base 1) fn2-fields) ok os og slot gen 0 ok os og fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-peer-imports fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
      ((mv code fn2-pool)
       (fn2-rd-copy 32 (fn2-fields-ref-slot (+ base 4) fn2-fields) (fn2-fields-ref-gen (+ base 4) fn2-fields)
        (fn2-fields-ref-off (+ base 4) fn2-fields) ok os og slot gen nl ok os og fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-peer-imports fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
      ((mv code fn2-fields) (fn2-peer-import-materialize tx b0 fn2-peer-imports fn2-fields))
      ((unless (eq code :ok)) (mv code fn2-peer-imports fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
      ((mv code fn2-succ-txns fn2-id-decides fn2-fields fn2-pool)
       (fn2-peer-import-start-key tx (+ b0 *fn2-peer-import-e*) ok os og b0 fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
      ((unless (eq code :ok))
       (if (and (equal (fn2-id-decides-qmask tx fn2-id-decides) 3)
                (equal (fn2-id-decides-qk tx fn2-id-decides) ok)
                (equal (fn2-id-decides-qs tx fn2-id-decides) os)
                (equal (fn2-id-decides-qg tx fn2-id-decides) og))
           (let ((fn2-peer-imports (fn2-peer-imports-put tx (query-held 1)
                                   (query-incarnation (fn2-id-decides-query-incarnation tx fn2-id-decides)))))
             (mv code fn2-peer-imports fn2-succ-txns fn2-id-decides fn2-fields fn2-pool))
         (mv code fn2-peer-imports fn2-succ-txns fn2-id-decides fn2-fields fn2-pool)))
      (fn2-peer-imports (fn2-peer-imports-put tx (phase *fn2-peer-import-phase-reading*) (query-held 1)
                        (query-incarnation (fn2-id-decides-query-incarnation tx fn2-id-decides)))))
  (mv :ok fn2-peer-imports fn2-succ-txns fn2-id-decides fn2-fields fn2-pool)))

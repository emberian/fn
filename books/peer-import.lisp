; Internal C producer for imported observations; no carrier or authority entry.
(in-package "ACL2")
(include-book "machines-c-read")
(fn2-book-layer :c)

; The decoded input remains outside the whole transaction scratch stripe.
(defun fn2-peer-import-room (base b0 fn2-fields)
 (declare (xargs :stobjs fn2-fields :guard (fn2-fields-wfp fn2-fields)))
 (and (natp base) (natp b0) (<= (+ base 11) (fn2-fields-rows fn2-fields))
      (or (<= (+ base 11) b0) (<= (+ b0 *fn2-idc-stride*) base))))
(in-theory (disable fn2-peer-import-room))

; Compare a bounded prefix of the common evidence/history field sequence.
(defun fn2-peer-import-equal (j n a b ok os og fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :measure (nfix (- (nfix n) (nfix j)))
 :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (natp j) (natp n) (< j n))) t)
      ((unless (and (<= n 8) (natp a) (natp b)
                    (< (+ a j) (fn2-fields-rows fn2-fields)) (< (+ b j) (fn2-fields-rows fn2-fields)))) nil)
      ((mv code order)
       (if (or (equal j 1) (equal j 4))
           (fn2-run-octets-field-compare (+ a j) (+ b j) ok os og ok os og fn2-fields fn2-pool)
         (mv :ok (fn2-run-value-compare (+ a j) (+ b j) fn2-fields))))
      ((unless (and (eq code :ok) (eq order :eq))) nil))
  (fn2-peer-import-equal (+ j 1) n a b ok os og fn2-fields fn2-pool)))
(in-theory (disable fn2-peer-import-equal))

(defun fn2-peer-import-start-child (tx base ok os og b0 fn2-succ-txns fn2-id-decides fn2-fields)
 (declare (xargs :stobjs (fn2-succ-txns fn2-id-decides fn2-fields)
 :guard (and (fn2-succ-txns-wfp fn2-succ-txns) (fn2-id-decides-wfp fn2-id-decides) (fn2-fields-wfp fn2-fields))
 :guard-hints (("Goal" :in-theory (enable fn2-peer-import-room)))))
 (b* (((unless (fn2-peer-import-room base b0 fn2-fields)) (mv :bounds fn2-succ-txns fn2-id-decides fn2-fields))
      (ns (fn2-fields-value base fn2-fields)) (profile (fn2-fields-value (+ base 2) fn2-fields))
      (algorithm (fn2-fields-value (+ base 3) fn2-fields))
      ((unless (and (unsigned-byte-p 60 ns) (unsigned-byte-p 8 profile) (unsigned-byte-p 8 algorithm)
                    (equal (fn2-fields-ref-len (+ base 4) fn2-fields) 32)))
       (mv :bounds fn2-succ-txns fn2-id-decides fn2-fields))
      ((mv code fn2-succ-txns fn2-id-decides fn2-fields)
       (fn2-id-decide-start tx (fn2-fields-ref-slot (+ base 1) fn2-fields) (fn2-fields-ref-gen (+ base 1) fn2-fields)
        (fn2-fields-ref-off (+ base 1) fn2-fields) (fn2-fields-ref-len (+ base 1) fn2-fields)
        (fn2-fields-ref-slot (+ base 4) fn2-fields) (fn2-fields-ref-gen (+ base 4) fn2-fields)
        (fn2-fields-ref-off (+ base 4) fn2-fields) ok os og b0 fn2-succ-txns fn2-id-decides fn2-fields))
      ((unless (and (eq code :ok) (natp b0) (< (+ b0 *fn2-idc-eb* 3) (fn2-fields-rows fn2-fields))))
       (mv code fn2-succ-txns fn2-id-decides fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ b0 *fn2-idc-eb*) ns fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ b0 *fn2-idc-eb* 2) profile fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ b0 *fn2-idc-eb* 3) algorithm fn2-fields)))
  (mv :ok fn2-succ-txns fn2-id-decides fn2-fields)))
(fn2-idc-fn-shape fn2-peer-import-start-child
 (tx base ok os og b0 fn2-succ-txns fn2-id-decides fn2-fields)
 (fn2-succ-txns fn2-id-decides fn2-fields) (fn2-succ-txns fn2-id-decides fn2-fields) t
 (fn2-peer-import-room fn2-id-decide-start fn2-fields-value fn2-fields-ref-slot fn2-fields-ref-gen fn2-fields-ref-off fn2-fields-ref-len))

; Return original typed row values after checking the actual completed query.
(defun fn2-peer-import-source (tx base hb receipt ok os og b0 fn2-id-decides fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-id-decides fn2-fields fn2-pool)
 :guard (and (fn2-id-decides-wfp fn2-id-decides) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))
 :guard-hints (("Goal" :in-theory (enable fn2-peer-import-room)))))
 (b* (((unless (and (fn2-peer-import-room base b0 fn2-fields)
                    (natp tx) (< tx (fn2-id-decides-rows fn2-id-decides))
                    (natp b0) (<= (+ b0 *fn2-idc-stride*) (fn2-fields-rows fn2-fields))
                    (equal (fn2-id-decides-qk tx fn2-id-decides) ok)
                    (equal (fn2-id-decides-qs tx fn2-id-decides) os)
                    (equal (fn2-id-decides-qg tx fn2-id-decides) og))) (mv :state 0 0))
      ((mv code & & h & &) (fn2-id-facts tx fn2-id-decides))
      ((unless (and (eq code :ok) (fn2-peer-import-equal 0 5 base (+ b0 *fn2-idc-eb*) ok os og fn2-fields fn2-pool)))
       (mv :state 0 0))
      ((unless (or (not receipt)
                   (and (fn2-peer-import-room hb b0 fn2-fields)
                        (fn2-peer-import-equal 0 8 base hb ok os og fn2-fields fn2-pool)
                        (equal (fn2-fields-value (+ base 8) fn2-fields) (fn2-fields-value (+ hb 9) fn2-fields)))))
       (mv :inconsistent 0 0)))
  (mv :ok h (if (equal (fn2-fields-value (+ base 9) fn2-fields) *fn2-identity-evidence-kind-binding*) 1 0))))
(in-theory (disable fn2-peer-import-source))

; Core events are materialized beside the existing C operations.
(defmacro fn2-peer-import-core-events ()
 '(progn
   (defun fn2-peer-import-start (tx base ok os og fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core)) (fn2-id-decides (fn2-core-id-decides fn2-core))
                (fn2-fields (fn2-core-fields fn2-core)) (fn2-fc (fn2-core-fc fn2-core)))
     (code fn2-succ-txns fn2-id-decides fn2-fields)
     (mv-let (code b0) (fn2-idc-stripe tx (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields)
      (if (eq code :ok) (fn2-peer-import-start-child tx base ok os og b0 fn2-succ-txns fn2-id-decides fn2-fields)
       (mv code fn2-succ-txns fn2-id-decides fn2-fields)))
     (mv code fn2-core)))
   (fn2-core-preserves fn2-peer-import-start (tx base ok os og fn2-core) :position 1 :rows nil
    :hints (("Goal" :in-theory (enable fn2-core-wfp))))
   ; Read one source arg, then release the child borrow before writing the successor.
   (defun fn2-peer-import-copy-arg (tx slot j base src ok os og fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (stobj-let ((fn2-fields (fn2-core-fields fn2-core)))
     (valid v rs rg ro rl)
     (if (and (natp base) (natp src) (< (+ base src) (fn2-fields-rows fn2-fields)))
      (mv t (fn2-fields-value (+ base src) fn2-fields) (fn2-fields-ref-slot (+ base src) fn2-fields)
       (fn2-fields-ref-gen (+ base src) fn2-fields) (fn2-fields-ref-off (+ base src) fn2-fields)
       (fn2-fields-ref-len (+ base src) fn2-fields)) (mv nil 0 0 0 0 0))
     (if (not valid) (mv :bounds fn2-core)
      (if (or (equal src 1) (equal src 4))
       (fn2-successor-arg-octets tx slot j rs rg ro rl ok os og fn2-core)
       (fn2-successor-arg tx slot j :value v fn2-core)))))
   (fn2-core-preserves fn2-peer-import-copy-arg (tx slot j base src ok os og fn2-core) :position 1 :rows nil
    :hints (("Goal" :in-theory (enable fn2-core-wfp))))
   (defun fn2-peer-import-copy-args (n j tx slot base ok os og fn2-core)
    (declare (xargs :stobjs fn2-core :guard (and (fn2-core-wfp fn2-core) (natp n) (natp j)) :measure (nfix n)))
    (if (zp n) (mv :ok fn2-core)
     (mv-let (code fn2-core) (fn2-peer-import-copy-arg tx slot j base j ok os og fn2-core)
      (if (not (eq code :ok)) (mv code fn2-core)
       (fn2-peer-import-copy-args (- n 1) (+ j 1) tx slot base ok os og fn2-core)))))
   (fn2-core-preserves fn2-peer-import-copy-args (n j tx slot base ok os og fn2-core) :position 1 :rows nil
    :hints (("Goal" :in-theory (enable fn2-core-wfp))))
   (defun fn2-peer-import-declare (tx base hb receipt ok os og fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (b* (((mv code h qualified)
          (stobj-let ((fn2-id-decides (fn2-core-id-decides fn2-core)) (fn2-fields (fn2-core-fields fn2-core))
                      (fn2-pool (fn2-core-pool fn2-core)) (fn2-fc (fn2-core-fc fn2-core)))
           (code h qualified)
           (mv-let (code b0) (fn2-idc-stripe tx (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields)
            (if (eq code :ok) (fn2-peer-import-source tx base hb receipt ok os og b0 fn2-id-decides fn2-fields fn2-pool)
             (mv code 0 0)))
           (mv code h qualified)))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-successor-put tx 0 1 :insert fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-peer-import-copy-args 11 0 tx 0 base ok os og fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (if receipt (fn2-successor-put tx 1 11 :insert fn2-core) (mv :ok fn2-core)))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (if receipt (fn2-peer-import-copy-args 11 0 tx 1 hb ok os og fn2-core) (mv :ok fn2-core)))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-successor-put tx 2 13 :admit fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-peer-import-copy-args 2 0 tx 2 base ok os og fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-successor-arg tx 2 2 :new 0 fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-successor-arg tx 2 3 (if receipt :new :value) (if receipt 1 0) fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-successor-arg tx 2 4 :value 0 fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-successor-arg tx 2 5 :value h fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-successor-put tx 3 12 :admit fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-peer-import-copy-args 5 0 tx 3 base ok os og fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-successor-arg tx 3 5 (if (equal h 0) :out :value) (if (equal h 0) (+ (* 2 256) *fn2-identity-summary-entry-field-candidates*) h) fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-successor-arg tx 3 6 :new 0 fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-successor-arg tx 3 7 :value qualified fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         ((mv code fn2-core) (fn2-successor-arg tx 3 8 :value 0 fn2-core))
         ((unless (eq code :ok)) (mv code fn2-core))
         )
     (mv :ok fn2-core)))
   (fn2-core-preserves fn2-peer-import-declare (tx base hb receipt ok os og fn2-core) :position 1 :rows nil
    :hints (("Goal" :in-theory (enable fn2-core-wfp))))
   (in-theory (disable fn2-peer-import-start fn2-peer-import-copy-arg fn2-peer-import-copy-args fn2-peer-import-declare))))

(local (defthm lca6-segment-floor
 (implies (and (fn-lc-segsp segs) (natp next)
               (<= (fn-lc-largest-physical-id segs) next)
               (or exhausted (< (fn-lc-largest-physical-id segs) next)))
          (fn-lc-seg-ids-allocatedp segs next exhausted))
 :hints (("Goal" :induct (fn-lc-largest-physical-id segs)
          :in-theory (union-theories (theory 'minimal-theory)
     '((:COMPOUND-RECOGNIZER NATP-COMPOUND-RECOGNIZER)
       (:CONGRUENCE IFF-IMPLIES-EQUAL-NOT)
       (:DEFINITION FN-LB-LOG-MODEL-SEGSP)
       (:DEFINITION FN-LC-ID-ALLOCATEDP)
       (:DEFINITION FN-LC-LARGEST-PHYSICAL-ID)
       (:DEFINITION FN-LC-SEG-IDS-ALLOCATEDP)
       (:DEFINITION FN-LC-SEGSP)
       (:DEFINITION INTEGER-RANGE-P)
       (:DEFINITION MAX)
       (:DEFINITION NATP)
       (:DEFINITION NOT)
       (:DEFINITION UNSIGNED-BYTE-P)
       (:EXECUTABLE-COUNTERPART <)
       (:EXECUTABLE-COUNTERPART CONSP)
       (:EXECUTABLE-COUNTERPART EXPT)
       (:EXECUTABLE-COUNTERPART FN-LC-LARGEST-PHYSICAL-ID)
       (:EXECUTABLE-COUNTERPART INTEGERP)
       (:EXECUTABLE-COUNTERPART TAU-SYSTEM)
       (:INDUCTION FN-LC-LARGEST-PHYSICAL-ID)
       (:REWRITE PGS-X-NFIX-WHEN-NATP)
       (:TYPE-PRESCRIPTION FN-LC-SEG-IDS-ALLOCATEDP)
       (:TYPE-PRESCRIPTION LCA6-LARGEST-NATURAL)))))))


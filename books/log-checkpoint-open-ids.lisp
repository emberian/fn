(defthm fn-lc-open-establishes-segment-ids-below-next
 (let* ((out (fn-lc-open disk r mode configs frontier max-conns segs outcome fn-lbc))
        (h (fn-lc-replayed-header disk r mode segs)))
  (implies (fn-lc-segsp segs)
           (and (fn-lc-header-ids-coverp h (mv-nth 3 out) nil)
                (<= (fn-lc-header-next-id (fn-lc-cold-adopted-header disk r mode))
                    (fn-lc-header-next-id h)))))
 :rule-classes nil
 :hints (("Goal" :use (lca6-cold-header-format
   (:instance lca6-allocation-covers (header (fn-lc-cold-adopted-header disk r mode)))
   (:instance lca6-allocation-floor (header (fn-lc-cold-adopted-header disk r mode))))
  :in-theory (union-theories (theory 'minimal-theory)
     '((:DEFINITION FN-LC-HEADER-IDS-COVERP)
       (:DEFINITION NOT)
       (:EXECUTABLE-COUNTERPART EQUAL)
       (:EXECUTABLE-COUNTERPART FN-LC-HEADER-NEXT-ID)
       (:EXECUTABLE-COUNTERPART FN-LC-HEADERP)
       (:EXECUTABLE-COUNTERPART NOT)
       (:REWRITE DEFAULT-<-2)
       (:REWRITE LCA6-ALLOCATION-FLOOR)
       (:REWRITE LCA6-OPEN-RETAINS-SEGMENTS)
       (:REWRITE LCA6-REPLAYED-ALLOCATION-FIELDS-BY-DEFINITION)
       (:TYPE-PRESCRIPTION FN-LC-HEADERP)
       (:TYPE-PRESCRIPTION FN-LC-SEGMENT-IDS-BELOW-NEXT)
       (:TYPE-PRESCRIPTION FN-LC-SEGSP))))))

(local (defun lca6-shape-tooth (segs fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc)))
 (mv (fn-lc-segsp segs) fn-lbc)))
(local (defun lca6-conclusion-tooth (mutant disk r mode configs frontier max-conns segs outcome fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (mv-let (answer fn-lbc nextdisk aftersegs trace owner)
  (fn-lc-open disk r mode configs frontier max-conns segs outcome fn-lbc)
  (declare (ignore answer nextdisk trace owner))
  (let* ((h (if mutant (fn-lc-cold-adopted-header disk r mode)
              (fn-lc-replayed-header disk r mode segs)))
         (before (fn-lc-header-next-id (fn-lc-cold-adopted-header disk r mode)))
         (next (fn-lc-header-next-id h)))
   (mv (and (fn-lc-header-ids-coverp h aftersegs nil)
            (mbe :logic (<= before next) :exec (not (fn-ag-less next before)))) fn-lbc)))))
(local (verify-guards lca6-conclusion-tooth :hints (("Goal" :in-theory (enable fn-ag-less)))))
(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
(defteeth fn-lc-open-establishes-segment-ids-below-next
 :claim (let* ((out (fn-lc-open disk r mode configs frontier max-conns segs outcome fn-lbc))
               (h (fn-lc-replayed-header disk r mode segs)))
  (((shape (fn-lc-segsp segs)))
   (and (fn-lc-header-ids-coverp h (mv-nth 3 out) nil)
        (<= (fn-lc-header-next-id (fn-lc-cold-adopted-header disk r mode))
            (fn-lc-header-next-id h)))))
 :subject fn-lc-open
 :witness ((disk (fn-lc-at 0 (lco-id5-input 1))) (r :lc) (mode :eager)
           (configs (fn-lc-at 2 (lco-id5-input 1))) (frontier 8) (max-conns 4)
           (segs (fn-lc-at 3 (lco-id5-input 1))) (outcome (fn-lc-proof-ok-outcomes 100)))
 :stobjs ((fn-lbc (fn-lc-teeth-empty-columns fn-lbc)))
 :stobj-checks
 (((let* ((out (fn-lc-open disk r mode configs frontier max-conns segs outcome fn-lbc))
          (h (fn-lc-replayed-header disk r mode segs))) (declare (ignorable out h))
    (fn-lc-segsp segs))
   (lca6-shape-tooth segs fn-lbc)
   :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
    '(lca6-shape-tooth mv-nth nth car-cons cdr-cons (:executable-counterpart zp))))))
  ((let* ((out (fn-lc-open disk r mode configs frontier max-conns segs outcome fn-lbc))
          (h (fn-lc-replayed-header disk r mode segs))) (declare (ignorable out h))
    (and (fn-lc-header-ids-coverp h (mv-nth 3 out) nil)
         (<= (fn-lc-header-next-id (fn-lc-cold-adopted-header disk r mode))
             (fn-lc-header-next-id h))))
   (lca6-conclusion-tooth nil disk r mode configs frontier max-conns segs outcome fn-lbc)
   :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
    '(lca6-conclusion-tooth mv-nth nth car-cons cdr-cons (:executable-counterpart zp))))))
  ((let* ((out (fn-lc-open disk r mode configs frontier max-conns segs outcome fn-lbc))
          (h (fn-lc-replayed-header disk r mode segs))) (declare (ignorable out h))
    (and (fn-lc-header-ids-coverp (fn-lc-cold-adopted-header disk r mode) (mv-nth 3 out) nil)
         (<= (fn-lc-header-next-id (fn-lc-cold-adopted-header disk r mode))
             (fn-lc-header-next-id (fn-lc-cold-adopted-header disk r mode)))))
   (lca6-conclusion-tooth t disk r mode configs frontier max-conns segs outcome fn-lbc)
   :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
    '(lca6-conclusion-tooth mv-nth nth car-cons cdr-cons (:executable-counterpart zp)))))))
 :breaks ((shape ((segs '((bad nil nil) (0 nil nil) (1 nil nil))))))
 :mutations ((root-only-replay
  (:conclusion
   (and (fn-lc-header-ids-coverp (fn-lc-cold-adopted-header disk r mode) (mv-nth 3 out) nil)
        (<= (fn-lc-header-next-id (fn-lc-cold-adopted-header disk r mode))
            (fn-lc-header-next-id (fn-lc-cold-adopted-header disk r mode)))))
  nil :fault "replay omits the persisted physical segment reservation")))
(defteeth-check (fn-lc-open-establishes-segment-ids-below-next))

)

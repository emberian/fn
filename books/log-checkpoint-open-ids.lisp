(local (defthm lca6-largest-natural
 (natp (fn-lc-largest-physical-id segs))
 :rule-classes :type-prescription
 :hints (("Goal" :induct (fn-lc-largest-physical-id segs)
          :in-theory (union-theories (theory 'minimal-theory)

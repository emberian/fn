; A connection drives one operation on the retained journal per turn. The C
; cut, journal lease, pending descriptor and member cursor are the continuation.
(in-package "ACL2")
(include-book "assembly-callbacks-c-prepare")
(fn2-book-layer :e)

(defun fn2-xfnc-reader-live-p (conn gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (and (eq (fn2-conn-snapshot-read-code conn fn2-core) :ok)
      (equal (fn2-machine-generation conn fn2-core) gen)))

(defun fn2-xfnc-reader-lease-token (conn gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-journal-lease (fn2-core-journal-lease fn2-core))) (token)
  (if (zp (fn2-journal-lease-rows fn2-journal-lease)) 0
    (let ((token (fn2-journal-lease-token 0 fn2-journal-lease)))
     (if (fn2-journal-lease-ownerp token *fn2-conn-kind* conn gen fn2-journal-lease) token 0)))
  token))

(defun fn2-xfnc-reader-cut-token (conn gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core))) (token)
  (if (zp (fn2-csnapshot-rows fn2-csnapshot)) 0
    (let ((token (fn2-csnapshot-token 0 fn2-csnapshot)))
     (if (fn2-csnapshot-ownerp token *fn2-conn-kind* conn gen fn2-csnapshot) token 0)))
  token))

(defun fn2-xfnc-reader-project-token (conn gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (if (or (fn2-core-stopped-p fn2-core) (not (fn2-xfnc-reader-live-p conn gen fn2-core))) 0
  (stobj-let ((fn2-journal-lease (fn2-core-journal-lease fn2-core))
              (fn2-event-read (fn2-core-event-read fn2-core))
              (fn2-journal-members (fn2-core-journal-members fn2-core))) (token)
   (if (and (fn2-event-read-ownerp fn2-event-read fn2-journal-lease)
            (equal (fn2-event-read-owner-kind 0 fn2-event-read) *fn2-conn-kind*)
            (equal (fn2-event-read-owner-slot 0 fn2-event-read) conn)
            (equal (fn2-event-read-owner-gen 0 fn2-event-read) gen)
            (equal (fn2-event-read-phase 0 fn2-event-read) *fn2-event-read-phase-members*)
            (< 0 (fn2-journal-members-rows fn2-journal-members))
            (equal (fn2-journal-members-phase 0 fn2-journal-members) *fn2-journal-members-phase-leaf*)
            (equal (fn2-journal-members-hash-phase 0 fn2-journal-members) 3))
       (fn2-event-read-token 0 fn2-event-read)
     0)
   token)))

(fn2-csnapshot-op fn2-xfnc-reader-member-step (token conn gen) 1
 (b* (((mv source & &) (fn2-retained-journal-seals token *fn2-conn-kind* conn gen fn2-core))
      ((unless (eq source :ok)) (mv source fn2-core)))
  (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))
              (fn2-journal-lease (fn2-core-journal-lease fn2-core))
              (fn2-journal-members (fn2-core-journal-members fn2-core))
              (fn2-mk (fn2-core-mk fn2-core))
              (fn2-b3 (fn2-core-b3 fn2-core))
              (fn2-fields (fn2-core-fields fn2-core))
              (fn2-pool (fn2-core-pool fn2-core))
              (fn2-digests (fn2-core-digests fn2-core)))
   (code fn2-event-read fn2-journal-members fn2-mk fn2-b3 fn2-fields fn2-digests)
   (fn2-event-read-member-step fn2-event-read fn2-journal-lease fn2-journal-members
    fn2-mk fn2-b3 fn2-fields fn2-pool fn2-digests)
   (mv code fn2-core))))

; The caller takes this transition only after accepting projected output or
; deciding the current member is hidden. Projection itself keeps the leaf.
(fn2-csnapshot-op fn2-xfnc-reader-advance (conn gen) 1
 (let ((token (fn2-xfnc-reader-project-token conn gen fn2-core)))
  (if (zp token) (mv :state fn2-core)
    (fn2-xfnc-reader-member-step token conn gen fn2-core))))

(defun fn2-xfnc-reader-state (token conn gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))) (phase pending slot sgen)
  (if (and (< 0 (fn2-event-read-rows fn2-event-read))
           (equal (fn2-event-read-token 0 fn2-event-read) token)
           (equal (fn2-event-read-owner-kind 0 fn2-event-read) *fn2-conn-kind*)
           (equal (fn2-event-read-owner-slot 0 fn2-event-read) conn)
           (equal (fn2-event-read-owner-gen 0 fn2-event-read) gen))
      (mv (fn2-event-read-phase 0 fn2-event-read) (fn2-event-read-pending 0 fn2-event-read)
          (fn2-event-read-slot 0 fn2-event-read) (fn2-event-read-gen 0 fn2-event-read))
    (mv *fn2-event-read-phase-idle* 0 0 0))
  (mv phase pending slot sgen)))

(fn2-csnapshot-op fn2-xfnc-reader-open (token conn gen) 1
 (b* ((class (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (class)
               (fn2-pool-class-for *fn2-commit-unit-bytes* fn2-pool) class))
      ((unless class) (mv :bounds fn2-core))
      ((mv code slot sgen fn2-core) (fn2-core-reserve class *fn2-conn-kind* conn gen fn2-core))
      ((unless (eq code :ok)) (mv code fn2-core))
      ((mv opened fn2-core) (fn2-retained-journal-open token *fn2-conn-kind* conn gen slot sgen fn2-core))
      ((when (eq opened :ok)) (mv :more fn2-core))
      ((mv released fn2-core) (fn2-core-release slot sgen *fn2-conn-kind* conn gen fn2-core)))
  (mv (if (member-eq released '(:ok :retired)) opened released) fn2-core)))

(fn2-csnapshot-op fn2-xfnc-reader-step (conn gen budget) 1
 (b* (((when (fn2-core-stopped-p fn2-core)) (mv :stopped fn2-core))
      ((unless (fn2-xfnc-reader-live-p conn gen fn2-core)) (mv :owner fn2-core))
      (cut-token (fn2-xfnc-reader-cut-token conn gen fn2-core))
      (token (fn2-xfnc-reader-lease-token conn gen fn2-core))
      ((when (and (zp token) (zp cut-token)))
       (mv-let (code & fn2-core) (fn2-retained-journal-acquire *fn2-conn-kind* conn gen fn2-core)
        (mv (if (eq code :ok) :more code) fn2-core)))
      ((when (zp token))
       (b* (((mv code & & fn2-core) (fn2-csnapshot-poll cut-token *fn2-conn-kind* conn gen fn2-core))
            ((unless (eq code :held)) (mv code fn2-core))
            ((mv began fn2-core) (fn2-retained-journal-begin cut-token *fn2-conn-kind* conn gen fn2-core)))
        (mv (if (eq began :ok) :more began) fn2-core)))
      ((mv lease-phase cut)
       (stobj-let ((fn2-journal-lease (fn2-core-journal-lease fn2-core))) (phase cut)
        (if (< 0 (fn2-journal-lease-rows fn2-journal-lease))
            (mv (fn2-journal-lease-phase 0 fn2-journal-lease)
                (fn2-journal-lease-cut-commit 0 fn2-journal-lease))
          (mv *fn2-journal-lease-phase-idle* 0))
        (mv phase cut)))
      ((when (equal lease-phase *fn2-journal-lease-phase-collecting*))
       (mv-let (code fn2-core) (fn2-retained-journal-collect token *fn2-conn-kind* conn gen fn2-core)
        (mv (if (eq code :ready) :more code) fn2-core)))
      ((unless (and (equal lease-phase *fn2-journal-lease-phase-ready*) (zp cut-token)))
       (mv :state fn2-core))
      ((when (zp cut)) (mv :empty fn2-core))
      ((mv phase pending slot sgen) (fn2-xfnc-reader-state token conn gen fn2-core)))
  (cond ((equal phase *fn2-event-read-phase-idle*) (fn2-xfnc-reader-open token conn gen fn2-core))
        ((equal phase *fn2-event-read-phase-complete*) (mv :complete fn2-core))
        ((equal phase *fn2-event-read-phase-uncertain*) (mv :uncertain fn2-core))
        ((equal pending 1) (mv :wait fn2-core))
        ((equal phase *fn2-event-read-phase-next*)
         (mv-let (code fn2-core) (fn2-retained-journal-open token *fn2-conn-kind* conn gen slot sgen fn2-core)
          (mv (if (eq code :ok) :more code) fn2-core)))
        ((or (equal phase *fn2-event-read-phase-read-seal*) (equal phase *fn2-event-read-phase-read-records*))
         (mv-let (code fn2-core) (fn2-retained-journal-issue token *fn2-conn-kind* conn gen fn2-core)
          (mv (if (eq code :ok) :wait code) fn2-core)))
        ((fn2-event-read-format-phase-p phase)
         (mv-let (code fn2-core) (fn2-retained-journal-format token *fn2-conn-kind* conn gen
                                 (min (nfix budget) *fn2-commit-unit-bytes*) fn2-core)
          (mv (if (eq code :ok) :more code) fn2-core)))
        ((equal phase *fn2-event-read-phase-members*)
         (if (equal token (fn2-xfnc-reader-project-token conn gen fn2-core))
             (mv :project fn2-core)
           (mv-let (code fn2-core) (fn2-xfnc-reader-member-step token conn gen fn2-core)
            (mv (if (eq code :next) :more code) fn2-core))))
        (t (mv :state fn2-core)))))

; Closing a pending read keeps C's promise and the loan until the exact
; terminal harvest. Thereafter the workspace can return and promised edges
; drain one at a time. The saved handle's generation excludes later reuse.
(fn2-csnapshot-op fn2-xfnc-reader-close (conn gen) 1
 (b* (((when (fn2-core-stopped-p fn2-core)) (mv :stopped fn2-core))
      ((unless (fn2-xfnc-reader-live-p conn gen fn2-core)) (mv :owner fn2-core))
      (lease-token (fn2-xfnc-reader-lease-token conn gen fn2-core))
      (token (if (zp lease-token) (fn2-xfnc-reader-cut-token conn gen fn2-core) lease-token))
      ((when (zp token)) (mv :done fn2-core))
      ((mv phase pending slot sgen) (fn2-xfnc-reader-state token conn gen fn2-core))
      ((when (equal pending 1)) (fn2-retained-journal-close token *fn2-conn-kind* conn gen fn2-core))
      (workspace
       (and (not (equal phase *fn2-event-read-phase-idle*))
            (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (owns)
             (and (eq (fn2-pool-handle-code slot sgen fn2-pool) :ok)
                  (natp slot) (< slot (fn2-pool-rows fn2-pool))
                  (not (equal (fn2-pool-state slot fn2-pool) *fn2-pool-state-retired*))
                  (fn2-pool-ownerp slot *fn2-conn-kind* conn gen fn2-pool))
             owns)))
      ((mv released fn2-core)
       (if workspace (fn2-core-release slot sgen *fn2-conn-kind* conn gen fn2-core)
         (mv :ok fn2-core)))
      ((unless (member-eq released '(:ok :retired)))
       (mv (if (eq released :held) :drain released) fn2-core)))
  (fn2-retained-journal-close token *fn2-conn-kind* conn gen fn2-core)))

; Bounded cancellation of actual unissued candidate reservations. No generic
; thaw is provided. A possibly issued page remains reserved behind phase3 and
; returns recovery-required: process recovery owns its disposition.
(in-package "ACL2")
(include-book "checkpoint-planning-construction")
(include-book "checkpoint-page-state")
(fn2-book-layer :c)

; Recovery cancellation uses the retained planning/allocator claim even if C
; lost its token. That loss never grants permission to a new tuple.
(defun fn2-checkpoint-planning-cancel-ownerp (c token kind owner gen fn2-checkpoint-planning fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-extents)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-extents-wfp fn2-extents))))
 (and (< 0 (fn2-checkpoint-planning-rows fn2-checkpoint-planning))
      (fn2-alloc-planning-ownerp token kind owner gen fn2-extents)
      (equal c (fn2-checkpoint-planning-candidate 0 fn2-checkpoint-planning))
      (equal token (fn2-checkpoint-planning-token 0 fn2-checkpoint-planning))
      (equal kind (fn2-checkpoint-planning-owner-kind 0 fn2-checkpoint-planning))
      (equal owner (fn2-checkpoint-planning-owner-slot 0 fn2-checkpoint-planning))
      (equal gen (fn2-checkpoint-planning-owner-gen 0 fn2-checkpoint-planning))))

(defun fn2-checkpoint-planning-cancel-begin (c token kind owner gen fn2-checkpoint-planning fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-extents)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-extents-wfp fn2-extents))))
 (if (not (and (fn2-checkpoint-planning-cancel-ownerp c token kind owner gen fn2-checkpoint-planning fn2-extents)
               (member (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning)
                (list *fn2-checkpoint-planning-phase-clear* *fn2-checkpoint-planning-phase-preview*
                      *fn2-checkpoint-planning-phase-materialize* *fn2-checkpoint-planning-phase-size* *fn2-checkpoint-planning-phase-append*
                      *fn2-checkpoint-planning-phase-planned* *fn2-checkpoint-planning-phase-uncertain*))))
  (mv :owner fn2-checkpoint-planning)
  (let ((fn2-checkpoint-planning (fn2-checkpoint-planning-put 0 (phase *fn2-checkpoint-planning-phase-cancel*) (abort-row 0))))
   (mv :ok fn2-checkpoint-planning))))

(defun fn2-checkpoint-planning-cancel-step (c token kind owner gen fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-construction fn2-checkpoint-page fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-construction fn2-checkpoint-page fn2-extents)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-checkpoint-recipe-wfp fn2-checkpoint-recipe)
              (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-checkpoint-page-wfp fn2-checkpoint-page) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (and (fn2-checkpoint-planning-cancel-ownerp c token kind owner gen fn2-checkpoint-planning fn2-extents)
                    (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-cancel*)
                    (equal (fn2-checkpoint-construction-rows fn2-checkpoint-construction) (fn2-extents-rows fn2-extents))))
       (mv :owner fn2-checkpoint-planning fn2-checkpoint-construction fn2-extents))
      (i (fn2-checkpoint-planning-abort-row 0 fn2-checkpoint-planning))
      ((when (>= i (fn2-checkpoint-construction-rows fn2-checkpoint-construction)))
       (let ((fn2-checkpoint-planning (fn2-checkpoint-planning-set-phase 0 *fn2-checkpoint-planning-phase-cancel-empty* fn2-checkpoint-planning)))
        (mv :ledger-empty fn2-checkpoint-planning fn2-checkpoint-construction fn2-extents)))
      ((unless (unsigned-byte-p 32 (+ i 1))) (mv :bounds fn2-checkpoint-planning fn2-checkpoint-construction fn2-extents))
      ((when (or (equal (fn2-checkpoint-construction-live i fn2-checkpoint-construction) 0)
                 (not (equal token (fn2-checkpoint-construction-token i fn2-checkpoint-construction)))))
       (let ((fn2-checkpoint-planning (fn2-checkpoint-planning-set-abort-row 0 (+ i 1) fn2-checkpoint-planning)))
        (mv :more fn2-checkpoint-planning fn2-checkpoint-construction fn2-extents)))
      ((unless (and (equal kind (fn2-checkpoint-construction-owner-kind i fn2-checkpoint-construction))
                    (equal owner (fn2-checkpoint-construction-owner-slot i fn2-checkpoint-construction))
                    (equal gen (fn2-checkpoint-construction-owner-gen i fn2-checkpoint-construction))))
       (mv :owner fn2-checkpoint-planning fn2-checkpoint-construction fn2-extents))
      (epoch (fn2-checkpoint-construction-epoch i fn2-checkpoint-construction))
      (allocation (fn2-checkpoint-construction-counter i fn2-checkpoint-construction))
      (recipe (and (< i (fn2-checkpoint-recipe-rows fn2-checkpoint-recipe))
                   (equal (fn2-checkpoint-recipe-used i fn2-checkpoint-recipe) 1)
                   (equal epoch (fn2-checkpoint-recipe-epoch i fn2-checkpoint-recipe))
                   (equal allocation (fn2-checkpoint-recipe-allocation i fn2-checkpoint-recipe))))
      ((when (or (not (equal (fn2-checkpoint-construction-completed-bytes i fn2-checkpoint-construction) 0))
                 (not (equal (fn2-checkpoint-construction-ticket-claimed i fn2-checkpoint-construction) 0))
                 (not (equal (fn2-checkpoint-construction-ticket-batch i fn2-checkpoint-construction) 0))
                 (and recipe (equal (fn2-checkpoint-recipe-issued i fn2-checkpoint-recipe) 1))
                 (and (< 0 (fn2-checkpoint-page-rows fn2-checkpoint-page))
                      (equal token (fn2-checkpoint-page-token 0 fn2-checkpoint-page))
                      (not (equal (fn2-checkpoint-page-phase 0 fn2-checkpoint-page) *fn2-checkpoint-page-phase-idle*)))))
       (let ((fn2-checkpoint-planning (fn2-checkpoint-planning-set-phase 0 *fn2-checkpoint-planning-phase-uncertain* fn2-checkpoint-planning)))
        (mv :recovery-required fn2-checkpoint-planning fn2-checkpoint-construction fn2-extents)))
      ((mv code fn2-extents) (fn2-alloc-planning-cancel token kind owner gen i epoch allocation fn2-extents))
      ((unless (eq code :ok)) (mv code fn2-checkpoint-planning fn2-checkpoint-construction fn2-extents))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-set-live i 0 fn2-checkpoint-construction))
      (fn2-checkpoint-planning (fn2-checkpoint-planning-put 0 (abort-row (+ i 1))
       (reserved (if (and recipe (posp (fn2-checkpoint-planning-reserved 0 fn2-checkpoint-planning)))
                  (- (fn2-checkpoint-planning-reserved 0 fn2-checkpoint-planning) 1)
                  (fn2-checkpoint-planning-reserved 0 fn2-checkpoint-planning))))))
  (mv :more fn2-checkpoint-planning fn2-checkpoint-construction fn2-extents)))

(fn2-checkpoint-planning-preserves fn2-checkpoint-planning-cancel-begin
 (c token kind owner gen fn2-checkpoint-planning fn2-extents) :position 1)
(fn2-checkpoint-planning-preserves fn2-checkpoint-planning-cancel-step
 (c token kind owner gen fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-construction fn2-checkpoint-page fn2-extents)
 :carriers ((fn2-checkpoint-planning 1 :prefix "-PLANNING") (fn2-checkpoint-construction 2 :prefix "-CONSTRUCTION") (fn2-extents 3 :prefix "-EXTENTS")))

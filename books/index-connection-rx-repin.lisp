(in-package "ACL2")
(include-book "index-connection-repin")
(include-book "connection-receiver-repin")
(defun fn-icr-repin-rx-accept
 (id old-token new-token fuel fn-index-backing fn-page-read-pool)
 (declare (xargs :stobjs (fn-index-backing fn-page-read-pool) :guard (natp fuel)
                 :verify-guards nil))
 (let ((ready (if (< fuel (* 9 (+ 1 (fn-ibp-slot-depth fn-index-backing)))) :yield (fn-icr-repin-preflight id old-token new-token fuel fn-index-backing))))
  (if (not (eq ready :ready))
      (mv ready fuel fn-index-backing fn-page-read-pool)
   (mv-let (found old-row left) (fn-ibp-connection-read old-token fuel fn-index-backing)
    (mv-let (source old-pin) (fn-ich-row-source id old-row)
     (declare (ignore old-pin))
     (if (not (and (eq found :present) (eq source :current) (natp left)))
         (mv :recovery-required left fn-index-backing fn-page-read-pool)
      (mv-let (rx-word origin after-rx fn-index-backing)
       (fn-ibp-connection-event old-token :rx-origin id nil left fn-index-backing)
       (let ((rebound (fn-crx-repin-origin origin id old-token new-token)))
        (if (not (and (natp after-rx)
                      (or (and (eq rx-word :current) rebound)
                          (eq rx-word :receiver-unavailable))))
            (mv :recovery-required after-rx fn-index-backing fn-page-read-pool)
         (mv-let (finished remaining fn-index-backing)
          (fn-icr-finish-open id new-token after-rx fn-index-backing)
          (if (not (and (eq finished :opened) (natp remaining)))
              (mv :recovery-required remaining fn-index-backing fn-page-read-pool)
           (mv-let (bound ignored after-bind fn-index-backing)
            (if rebound
                (fn-ibp-connection-event new-token :rx-bind id rebound remaining fn-index-backing)
              (mv :associated nil remaining fn-index-backing))
            (declare (ignore ignored))
            (if (not (and (eq bound :associated) (natp after-bind)))
                (mv :recovery-required after-bind fn-index-backing fn-page-read-pool)
             (mv-let (closed unused after fn-index-backing)
              (fn-ibp-connection-event old-token :close id nil after-bind fn-index-backing)
              (declare (ignore unused))
              (if (not (and (eq closed :closing) (natp after)))
                  (mv :recovery-required after fn-index-backing fn-page-read-pool)
               (mv-let (settled final fn-index-backing fn-page-read-pool)
                (fn-icr-settle old-token after fn-index-backing fn-page-read-pool)
                (mv (case settled (:released :repinned) (:held :repinned-held)
                       (otherwise :recovery-required))
                    final fn-index-backing fn-page-read-pool))))))))))))))))
)
(verify-guards fn-icr-repin-rx-accept)

  (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))) (fn2-allocation-release)
   (if (< 0 (fn2-allocation-release-rows fn2-allocation-release))
       (fn2-allocation-release-set-phase 0 *fn2-allocation-release-phase-uncertain* fn2-allocation-release)
     fn2-allocation-release)
   (fn2-core-stop *fn2-stop-reason-commit-settle* fn2-core)))
 (fn2-core-preserves fn2-release-live-uncertain (fn2-core) :rows nil :prefix "")

 (defun fn2-release-live-ownerp (kind owner generation fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (and (unsigned-byte-p 8 kind) (unsigned-byte-p 32 owner)
       (posp generation) (unsigned-byte-p 60 generation)
   (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))) (yes)
    (and (< 0 (fn2-allocation-release-rows fn2-allocation-release))
         (equal kind (fn2-allocation-release-owner-kind 0 fn2-allocation-release))
         (equal owner (fn2-allocation-release-owner-slot 0 fn2-allocation-release))
         (equal generation (fn2-allocation-release-owner-gen 0 fn2-allocation-release))) yes)))

 (defun fn2-release-live-credit-info (fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-commit (fn2-commit-table fn2-core))
              (fn2-pool (fn2-core-pool fn2-core))) (code group class)
   (let ((group (fn2-allocation-release-credit-group (fn2-commit-rows fn2-commit)))
         (class (fn2-pool-class-for (fn2-allocation-release-member-capacity) fn2-pool)))
    (mv (if (and (posp (fn2-commit-rows fn2-commit)) (fn2-pool-credit-shapep fn2-pool)
                 (natp class) (< class (fn2-pool-nclasses fn2-pool))
                 (< group (fn2-pool-credit-group-count fn2-pool))
                 (= (fn2-pool-credit-purposei group fn2-pool) *fn2-pool-credit-working*)) :ok :configuration)
        group class)) (mv code group class)))

 (defun fn2-release-live-return-empty (group nonce slot gen kind owner generation fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((mv returned fn2-core)

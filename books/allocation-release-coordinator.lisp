; Typed outgoing RELEASE admission. Encoded lifecycle bytes alone never grant
; admission: this producer re-packs the current actual staged source and owns
; all three evidence edges before exposing its dedicated B member.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "release-evidence")
(include-book "allocation-release-geometry")
(include-book "release-member-binding")
(fn2-book-layer :b)
(defmacro fn2-allocation-release-coordinator-events ()
 '(progn
 (defun fn2-release-live-uncertain (fn2-core)

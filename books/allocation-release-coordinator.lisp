 (fn2-core-preserves fn2-release-live-return-empty
  (group nonce slot gen kind owner generation fn2-core) :position 1 :rows nil)

 (defun fn2-release-live-start-refused-p (id nonce key fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (and (not (fn2-core-stopped-p fn2-core)) (fn2-commit-idp id fn2-core)
       (= (fn2-machine-phase id fn2-core) *fn2-commit-state-free*)
       (= (fn2-machine-pending id fn2-core) 0) (= (fn2-machine-cb-issued id fn2-core) 0)
       (= (fn2-machine-cb-wrote id fn2-core) 0) (= (fn2-machine-cb-fence-live id fn2-core) 0)
       (= (fn2-machine-pool-gen id fn2-core) 0)
       (mv-let (batch first capacity mode) (fn2-commit-frontier fn2-core)
        (declare (ignore capacity mode)) (and (equal batch nonce) (equal first key)))
       (stobj-let ((fn2-commit-io (fn2-core-commit-io fn2-core))) (yes)
        (let ((r (* *fn2-commit-write-resources* (fn2-commit-row id fn2-core))))
         (and (< (+ r 2) (fn2-commit-io-rows fn2-commit-io))
              (= (fn2-commit-io-pool-gen r fn2-commit-io) 0)
              (= (fn2-commit-io-pool-gen (+ r 1) fn2-commit-io) 0)
              (= (fn2-commit-io-pool-gen (+ r 2) fn2-commit-io) 0)
              (= (fn2-commit-io-ready r fn2-commit-io) 0)
              (= (fn2-commit-io-ready (+ r 1) fn2-commit-io) 0)
              (= (fn2-commit-io-ready (+ r 2) fn2-commit-io) 0))) yes)))


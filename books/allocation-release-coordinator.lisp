 (defun fn2-allocation-release-submit (kind owner generation fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((unless (and (fn2-release-live-ownerp kind owner generation fn2-core)
                     (not (fn2-core-stopped-p fn2-core)) (not (fn2-storage-checkpoint-active fn2-core))))
        (mv :source 0 0 fn2-core))
       (staged (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))) (yes)
                 (and (< 0 (fn2-allocation-release-rows fn2-allocation-release))
                      (= (fn2-allocation-release-phase 0 fn2-allocation-release) *fn2-allocation-release-phase-staged*)
                      (= (fn2-allocation-release-evidence-owned 0 fn2-allocation-release) 0)) yes))
       ((unless staged) (mv :source 0 0 fn2-core))
       ((mv pick id partner) (fn2-commit-pick fn2-core))
       ; Dedicated one-member batch: no unrelated member can become exposed
       ; between this subject's evidence claim and actual journal publication.
       ((unless (and (eq pick :open) (fn2-commit-idp id fn2-core)
                     (fn2-commit-settled-room 1 fn2-core))) (mv :waiting 0 0 fn2-core))
       ((mv nonce key capacity mode) (fn2-commit-frontier fn2-core))
       ((unless (and (posp nonce) (unsigned-byte-p 60 nonce) (< nonce capacity)
                     (posp key) (unsigned-byte-p 60 key))) (mv :exhausted 0 0 fn2-core))
       ((mv info group class) (fn2-release-live-credit-info fn2-core))
       ((unless (eq info :ok)) (mv info 0 0 fn2-core))
       ((mv begun fn2-core)
        (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
         (fn2-pool-credit-begin group *fn2-pool-credit-working* nonce kind owner generation fn2-pool)
         (mv code fn2-core)))
       ((unless (eq begun :ok)) (mv begun 0 0 fn2-core))
       ((mv reserved slot gen fn2-core)
        (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code slot gen fn2-pool)
         (fn2-pool-reserve-credit group nonce class kind owner generation fn2-pool)
         (mv code slot gen fn2-core)))
       ((unless (eq reserved :ok))
        (mv-let (aborted fn2-core)
         (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
          (fn2-pool-credit-abort-empty group nonce kind owner generation fn2-pool)
          (mv code fn2-core))
         (if (eq aborted :ok) (mv reserved 0 0 fn2-core)
          (let ((fn2-core (fn2-release-live-uncertain fn2-core))) (mv :uncertain 0 0 fn2-core)))))
       (base (* 128 (fn2-commit-row id fn2-core)))
       ((mv packed len need fn2-core)
        (stobj-let ((fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core))
                    (fn2-checkpoint-lifecycle (fn2-core-checkpoint-lifecycle fn2-core))
                    (fn2-checkpoints (fn2-core-checkpoints fn2-core))
                    (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core))
                    (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core))
                    (fn2-extents (fn2-core-extents fn2-core))
                    (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))
                    (fn2-ops (fn2-core-ops fn2-core))
                    (fn2-allocation-release (fn2-core-allocation-release fn2-core))
                    (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
         (code len need fn2-allocation-release fn2-fields fn2-pool)
         (mv-let (code len fn2-allocation-release fn2-fields fn2-pool)
          (fn2-allocation-release-pack-staged base slot gen kind owner generation fn2-checkpoint-publication fn2-checkpoint-lifecycle
           fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges fn2-ops fn2-allocation-release fn2-fields fn2-pool)
          (mv code len (if (and (eq code :packed) (natp base)
                                  (<= (+ base *fn2-format-txn-record-num-fields* *fn2-format-release-allocation-num-fields*)
                                      (fn2-fields-rows fn2-fields)))
                           (+ *fn2-commit-txn-header-room*
                              (fn2-format-release-allocation-size (+ base *fn2-format-txn-record-num-fields*) fn2-fields)) 0)
              fn2-allocation-release fn2-fields fn2-pool))
         (mv code len need fn2-core)))
       ((unless (and (eq packed :packed) (posp len) (unsigned-byte-p 32 len)
                     (posp need) (<= need *fn2-commit-records-room*)))
        (mv-let (returned fn2-core) (fn2-release-live-return-empty group nonce slot gen kind owner generation fn2-core)
         (mv (if (eq returned :ok) :source :uncertain) 0 0 fn2-core)))
       ; Retain the selected writer identity even if START later reports an
       ; unexpected refusal before its own row generation assignment.
       (expected-writer-gen (if (< 0 (fn2-machine-batch-no id fn2-core))
                                (+ 1 (fn2-machine-generation id fn2-core))
                              (fn2-machine-generation id fn2-core)))
       (fn2-core
        (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))) (fn2-allocation-release)
         (fn2-allocation-release-put 0 (writer-slot id) (writer-gen expected-writer-gen)
          (member-length len) (batch nonce) (event key) (workspace-released 0)) fn2-core))
       ((mv started fn2-core) (fn2-commit-start id 1 key mode partner fn2-core))
       ((unless (eq started :ok))
        (if (and (member-eq started '(:admission :exhausted :no-space))
                 (fn2-release-live-start-refused-p id nonce key fn2-core))
            (mv-let (returned fn2-core) (fn2-release-live-return-empty group nonce slot gen kind owner generation fn2-core)
             (mv (if (eq returned :ok) started :uncertain) 0 0 fn2-core))
          (let ((fn2-core (fn2-release-live-uncertain fn2-core))) (mv :uncertain nonce key fn2-core))))
       ((mv claimed fn2-core) (fn2-release-live-claim id kind owner generation fn2-core))
       ((unless (eq claimed :owned)) (let ((fn2-core (fn2-release-live-uncertain fn2-core))) (mv :uncertain nonce key fn2-core)))
       (writer-gen (fn2-machine-generation id fn2-core))
       (fn2-core
        (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))) (fn2-allocation-release)
         (fn2-allocation-release-put 0 (phase *fn2-allocation-release-phase-prepared*)
          (writer-slot id) (writer-gen writer-gen) (member-length len) (batch nonce) (event key)) fn2-core))
       ((mv ended fn2-core)
        (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
         (fn2-pool-credit-end group nonce kind owner generation fn2-pool) (mv code fn2-core)))
       ((unless (eq ended :ok)) (let ((fn2-core (fn2-release-live-uncertain fn2-core))) (mv :uncertain nonce key fn2-core)))
       ((mv member fn2-core) (fn2-commit-put-txn-member (fn2-commit-row id fn2-core) 0 slot gen len kind owner generation key fn2-core))
       ((unless (eq member :ok)) (let ((fn2-core (fn2-release-live-uncertain fn2-core))) (mv :uncertain nonce key fn2-core)))
       (fn2-core (fn2-commit-put-core id (rec-bytes need)))
       (fn2-core
        (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))) (fn2-allocation-release)
         (fn2-allocation-release-set-phase 0 *fn2-allocation-release-phase-waiting* fn2-allocation-release) fn2-core)))
   (mv :submitted nonce key fn2-core)))
 (fn2-core-preserves fn2-allocation-release-submit (kind owner generation fn2-core) :position 3 :rows nil)

 (defun fn2-allocation-release-install-member (base slot gen off next bytes len batch event kind owner generation fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((unless (fn2-release-live-ownerp kind owner generation fn2-core)) (mv :invalid fn2-core))
       (writer (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))) (id)
                 (fn2-allocation-release-writer-slot 0 fn2-allocation-release) id))
       ((unless (and (fn2-commit-idp writer fn2-core)
                     (= (fn2-machine-phase writer fn2-core) *fn2-commit-state-publish*)
                     (= (fn2-machine-batch-no writer fn2-core) batch)
                     (= (fn2-machine-member-count writer fn2-core) 1)
                     (= (fn2-machine-cb-deps-ok writer fn2-core) 1)
                     (= (fn2-machine-cb-log-ok writer fn2-core) 1)
                     (= (fn2-machine-cb-fence-ok writer fn2-core) 1)
                     (= (fn2-machine-cb-failed writer fn2-core) 0))) (mv :invalid fn2-core))
       (writer-gen (fn2-machine-generation writer fn2-core)))
   (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))
               (fn2-release-evidence (fn2-core-release-evidence fn2-core))
               (fn2-release-evidence-candidates (fn2-core-release-evidence-candidates fn2-core))
               (fn2-extents (fn2-core-extents fn2-core))
               (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))
               (fn2-ops (fn2-core-ops fn2-core))
               (fn2-checkpoints (fn2-core-checkpoints fn2-core))
               (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
    (code fn2-allocation-release fn2-fields)
    (b* (((unless (and (natp base) (<= (+ base *fn2-format-release-allocation-num-fields*) (fn2-fields-rows fn2-fields))
                       (unsigned-byte-p 32 next) (natp bytes) (unsigned-byte-p 32 (+ next bytes))
                       (= off 0) (= (+ next bytes) len)
                       (< 0 (fn2-allocation-release-rows fn2-allocation-release))
                       (= (fn2-allocation-release-phase 0 fn2-allocation-release) *fn2-allocation-release-phase-waiting*)
                       (= (fn2-allocation-release-evidence-owned 0 fn2-allocation-release) 1)
                       (= (fn2-allocation-release-workspace-released 0 fn2-allocation-release) 0)
                       (equal slot (fn2-allocation-release-slot 0 fn2-allocation-release))
                       (equal gen (fn2-allocation-release-gen 0 fn2-allocation-release))
                       (equal len (fn2-allocation-release-member-length 0 fn2-allocation-release))
                       (equal writer-gen (fn2-allocation-release-writer-gen 0 fn2-allocation-release))
                       (equal batch (fn2-allocation-release-batch 0 fn2-allocation-release))
                       (equal event (fn2-allocation-release-event 0 fn2-allocation-release))))
          (mv :invalid fn2-allocation-release fn2-fields))
         (journal (fn2-allocation-release-journal 0 fn2-allocation-release))
         ((unless (and (fn2-release-evidence-row-matches journal fn2-allocation-release fn2-release-evidence)
                        (fn2-release-evidence-row-owned-p journal
                         (fn2-allocation-release-journal-epoch 0 fn2-allocation-release)
                         (fn2-allocation-release-journal-allocation 0 fn2-allocation-release) batch
                         fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)))
          (mv :invalid fn2-allocation-release fn2-fields))
         ((mv decoded end fn2-fields)
          (fn2-format-release-allocation-decode base slot gen next (+ next bytes) kind owner generation fn2-fields fn2-pool))
         ((unless (and (eq decoded :ok) (equal end len)
                        (fn2-release-member-fields-match-p base slot gen kind owner generation fn2-allocation-release fn2-fields fn2-pool)))
          (mv :invalid fn2-allocation-release fn2-fields))
         ; Persisted typed evidence is established here, never FREE authority.
         (fn2-allocation-release (fn2-allocation-release-set-phase 0 *fn2-allocation-release-phase-persisted* fn2-allocation-release)))
     (mv :ok fn2-allocation-release fn2-fields)) (mv code fn2-core))))
 (fn2-core-preserves fn2-allocation-release-install-member
  (base slot gen off next bytes len batch event kind owner generation fn2-core) :position 1 :rows nil)

 (defun fn2-release-live-workspace-terminal-p (writer writer-gen batch fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (and (fn2-commit-idp writer fn2-core) (posp writer-gen)
       (or (< writer-gen (fn2-machine-generation writer fn2-core))
           (and (equal writer-gen (fn2-machine-generation writer fn2-core))
                (equal batch (fn2-machine-batch-no writer fn2-core))
                (= (fn2-machine-pending writer fn2-core) 0)
                (= (fn2-machine-cb-fence-live writer fn2-core) 0)
                (= (fn2-machine-cb-published writer fn2-core) 1)
                (= (fn2-machine-member-count writer fn2-core) 1)
                (= (fn2-machine-cb-acks writer fn2-core) 1)
                (member-equal (fn2-machine-phase writer fn2-core)
                 (list *fn2-commit-state-notify* *fn2-commit-state-draining* *fn2-commit-state-free*))))))

 (defun fn2-allocation-release-poll (kind owner generation fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((unless (fn2-release-live-ownerp kind owner generation fn2-core)) (mv :owner 0 0 fn2-core))
       ((mv phase released slot gen batch event writer writer-gen)
        (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core)))
         (phase released slot gen batch event writer writer-gen)
         (mv (fn2-allocation-release-phase 0 fn2-allocation-release)
             (fn2-allocation-release-workspace-released 0 fn2-allocation-release)
             (fn2-allocation-release-slot 0 fn2-allocation-release)
             (fn2-allocation-release-gen 0 fn2-allocation-release)
             (fn2-allocation-release-batch 0 fn2-allocation-release)
             (fn2-allocation-release-event 0 fn2-allocation-release)
             (fn2-allocation-release-writer-slot 0 fn2-allocation-release)
             (fn2-allocation-release-writer-gen 0 fn2-allocation-release))
         (mv phase released slot gen batch event writer writer-gen)))
       ((when (or (fn2-core-stopped-p fn2-core) (= phase *fn2-allocation-release-phase-uncertain*)))
        (mv :uncertain batch event fn2-core))
       ((when (and (= phase *fn2-allocation-release-phase-persisted*) (= released 1)))
        (mv :persisted batch event fn2-core))
       ((unless (member-equal phase (list *fn2-allocation-release-phase-waiting* *fn2-allocation-release-phase-persisted*)))
        (mv :waiting batch event fn2-core))
       ; After accepted notification, the dedicated member has no later byte
       ; consumer: NOTIFY is complete, DRAINING reads only journal resources.
       ; A strictly newer row generation also proves the old drain terminated.
       ((when (and (= phase *fn2-allocation-release-phase-persisted*)
                   (not (fn2-release-live-workspace-terminal-p writer writer-gen batch fn2-core))))
        (mv :waiting batch event fn2-core))
       ((mv code settled-batch settled-event outcome fn2-core)
        (fn2-commit-take-exact kind owner generation batch event fn2-core))
       ((when (eq code :pending)) (mv :waiting batch event fn2-core))
       ((unless (and (eq code :ok) (= phase *fn2-allocation-release-phase-persisted*)
                     (equal batch settled-batch) (equal event settled-event)
                     (= outcome *fn2-commit-outcome-accepted*)))
        (let ((fn2-core (fn2-release-live-uncertain fn2-core))) (mv :uncertain batch event fn2-core)))
       ((mv info group &) (fn2-release-live-credit-info fn2-core))
       ((unless (eq info :ok)) (let ((fn2-core (fn2-release-live-uncertain fn2-core))) (mv :uncertain batch event fn2-core)))
       ((mv returned fn2-core)
        (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
         (fn2-pool-release-credit slot gen group batch kind owner generation fn2-pool) (mv code fn2-core)))
       ((unless (eq returned :ok)) (let ((fn2-core (fn2-release-live-uncertain fn2-core))) (mv :uncertain batch event fn2-core))))
   (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))) (fn2-allocation-release)
    ; Preserve the exact historical slot/generation for ownership auditing.
    (fn2-allocation-release-set-workspace-released 0 1 fn2-allocation-release)
    (mv :persisted batch event fn2-core))))
 (fn2-core-preserves fn2-allocation-release-poll (kind owner generation fn2-core) :position 3 :rows nil)
 ))

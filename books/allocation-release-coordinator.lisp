   (b* (((mv journal epoch allocation & &) (fn2-commit-resource id 0 fn2-core))
        (batch (fn2-machine-batch-no id fn2-core)))
    (stobj-let ((fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core))

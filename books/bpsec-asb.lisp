; RFC 9172 section 3.6: resumable ASB SEQUENCE grammar, contexts 1/2.
; Input is immutable backing windows; large values remain spans.
(in-package "ACL2")
(include-book "bpsec-head")

; This fixed cursor map contains metadata, never an input/body accumulator.
; Updating its spine does not traverse the target, pair or result lists.
(defun fn-bps-get (key cursor)
  (declare (xargs :guard t))
  (if (consp cursor)
      (if (and (consp (car cursor)) (equal (caar cursor) key)) (cdar cursor)
        (fn-bps-get key (cdr cursor))) nil))

(defun fn-bps-put (key value cursor)
  (declare (xargs :guard t))
  (if (consp cursor)
      (if (and (consp (car cursor)) (equal (caar cursor) key))
          (cons (cons key value) (cdr cursor))
        (cons (car cursor) (fn-bps-put key value (cdr cursor)))) nil))

(defun fn-bps-stop (status reason cursor)
  (declare (xargs :guard t))
  (fn-bps-put :reason reason (fn-bps-put :status status cursor)))

(defun fn-bps-stage (stage cursor)
  (declare (xargs :guard t))
  (fn-bps-put :head (fn-bps-head-start) (fn-bps-put :stage stage cursor)))

(defun fn-bps-charge (count cursor)
  (declare (xargs :guard t))
  (let ((new (+ (nfix count) (nfix (fn-bps-get :charge cursor)))))
    (if (< (nfix (fn-bps-field 6 (fn-bps-get :limits cursor))) new)
        (fn-bps-stop :refused :metadata-limit cursor)
      (fn-bps-put :charge new cursor))))

(defun fn-bps-asb-start (kind backing-id start-offset declared-length limits)
  (declare (xargs :guard t))
  (let ((cursor
         (list (cons :status :more) (cons :reason nil) (cons :stage :targets-array)
               (cons :kind kind) (cons :backing backing-id) (cons :start start-offset)
               (cons :offset start-offset) (cons :length declared-length) (cons :limits limits)
               (cons :head (fn-bps-head-start)) (cons :charge 0)
               (cons :targets nil) (cons :target-count 0) (cons :remaining 0)
               (cons :pending nil) (cons :scan nil) (cons :reverse nil) (cons :after nil)
               (cons :context 0) (cons :flags 0) (cons :source nil) (cons :scheme 0)
               (cons :params nil) (cons :pairs nil) (cons :results nil)
               (cons :result-remaining 0) (cons :id 0) (cons :seen 0)
               (cons :variant 0) (cons :iv nil) (cons :body nil)
               (cons :body-left 0) (cons :body-index 0) (cons :delimiter nil))))
    (cond ((not (and (member-equal kind '(11 12)) (fn-bps-limitsp limits)
                     (fn-bps-uintp start-offset) (fn-bps-uintp declared-length)
                     (<= (+ start-offset declared-length) *fn-bpc-max-uint*)))
           (fn-bps-stop :refused :unrepresentable-profile cursor))
          ((< (fn-bps-field 1 limits) declared-length)
           (fn-bps-stop :refused :totalbytes-limit cursor))
          (t cursor))))

; Reverse work is scheduled one metadata cell at a time, including at EOF.
(defun fn-bps-reverse-start (values after cursor)
  (declare (xargs :guard t))
  (fn-bps-put :scan values
              (fn-bps-put :reverse nil (fn-bps-put :after after (fn-bps-stage :reverse cursor)))))

(defun fn-bps-next-param-or-results (cursor)
  (declare (xargs :guard t))
  (if (equal (mod (nfix (fn-bps-get :flags cursor)) 2) 1)
      (fn-bps-stage :params-array cursor) (fn-bps-stage :results-array cursor)))

(defun fn-bps-next-pair (cursor)
  (declare (xargs :guard t))
  (let ((remaining (nfix (fn-bps-get :remaining cursor))))
    (if (zp remaining)
        (fn-bps-reverse-start (fn-bps-get :pairs cursor)
                             (if (eq (fn-bps-get :after cursor) :params) :params-done :target-result-done)
                             cursor)
      (fn-bps-stage :pair-array cursor))))

(defun fn-bps-finish-value (value cursor)
  (declare (xargs :guard t))
  (fn-bps-next-pair
   (fn-bps-put :remaining (1- (nfix (fn-bps-get :remaining cursor)))
               (fn-bps-put :pairs (cons (list (fn-bps-get :id cursor) value)
                                        (fn-bps-get :pairs cursor)) cursor))))

(defun fn-bps-result-array (count cursor)
  (declare (xargs :guard t))
  (cond ((< (nfix (fn-bps-field 4 (fn-bps-get :limits cursor))) (nfix count))
         (fn-bps-stop :refused :results-limit cursor))
        ((and (equal (fn-bps-get :context cursor) 1) (zp (nfix count)))
         (fn-bps-stop :refused :security-result-count cursor))
        (t (fn-bps-next-pair
            (fn-bps-put :after :result
             (fn-bps-put :remaining count (fn-bps-put :seen 0 (fn-bps-put :pairs nil
                  (fn-bps-charge (* 2 (nfix count)) cursor)))))))))

(defun fn-bps-bytes-start (length textp cursor)
  (declare (xargs :guard t))
  (let ((offset (nfix (fn-bps-get :offset cursor))))
    (cond ((< (nfix (fn-bps-field 5 (fn-bps-get :limits cursor))) (nfix length))
           (fn-bps-stop :refused :valuebytes-limit cursor))
          ((< (+ (nfix (fn-bps-get :start cursor)) (nfix (fn-bps-get :length cursor)))
              (+ offset (nfix length)))
           (fn-bps-stop :refused :truncated cursor))
          ((and textp (< *fn-bpc-max-text* (nfix length)))
           ; Existing EID codec's representable profile, not a new BPSec ceiling.
           (fn-bps-stop :refused :eid-codec-profile cursor))
          (t (fn-bps-put :body (fn-bps-span-make (if textp :text-span :bytes-span)
                                               (fn-bps-get :backing cursor) offset length)
              (fn-bps-put :body-left length (fn-bps-put :body-index 0
               (fn-bps-put :delimiter nil (fn-bps-stage :body cursor)))))))))

(defun fn-bps-typed-head (major value cursor)
  (declare (xargs :guard t))
  (let* ((id (nfix (fn-bps-get :id cursor)))
         (context (fn-bps-get :context cursor))
         (parameter (eq (fn-bps-get :after cursor) :params))
         (variantp (and parameter (equal id (if (equal context 1) 1 2))))
         (scopep (and parameter (equal id (if (equal context 1) 3 4))))
         (bytesp (or (not parameter)
                     (equal id (if (equal context 1) 2 3))
                     (and (equal context 2) (equal id 1)))))
    (cond
     ((or variantp scopep)
      (cond ((not (equal major 0)) (fn-bps-stop :refused :parameter-type cursor))
            ((and variantp (not (member-equal value (if (equal context 1) '(5 6 7) '(1 3)))))
             (fn-bps-stop :unsupported :algorithm-variant cursor))
            ((and scopep (< 65535 (nfix value))) (fn-bps-stop :refused :scope-width cursor))
            (t (fn-bps-finish-value (cons :uint value)
                 (if variantp (fn-bps-put :variant value cursor) cursor)))))
     (bytesp
      (cond ((not (equal major 2)) (fn-bps-stop :refused :parameter-or-result-type cursor))
            ((and parameter (equal context 2) (equal id 1)
                  (or (< (nfix value) 8) (< 16 (nfix value))))
             (fn-bps-stop :refused :iv-length cursor))
            ((and (not parameter)
                  (not (equal value (if (equal context 2) 16
                                     (cond ((equal (fn-bps-get :variant cursor) 5) 32)
                                           ((equal (fn-bps-get :variant cursor) 7) 64) (t 48))))))
             (fn-bps-stop :refused :result-length cursor))
            (t (fn-bps-bytes-start value nil
                 (if (and parameter (equal context 2) (equal id 1))
                     (fn-bps-put :iv t cursor) cursor)))))
     (t (fn-bps-stop :unsupported :unknown-parameter cursor)))))

; Each head transition has a fixed amount of structural work. Counts are
; checked and charged before the corresponding lists receive any cells.
(defun fn-bps-accept-head (major value cursor)
  (declare (xargs :guard t))
  (let ((stage (fn-bps-get :stage cursor)) (limits (fn-bps-get :limits cursor)))
    (cond
     ((eq stage :targets-array)
      (cond ((or (not (equal major 4)) (zp (nfix value))) (fn-bps-stop :refused :empty-or-invalid-targets cursor))
            ((< (nfix (fn-bps-field 2 limits)) (nfix value)) (fn-bps-stop :refused :targets-limit cursor))
            (t (fn-bps-stage :target
                 (fn-bps-put :target-count value (fn-bps-put :remaining value
                  (fn-bps-charge value cursor)))))))
     ((eq stage :target)
      (if (not (equal major 0)) (fn-bps-stop :refused :target-type cursor)
        (fn-bps-put :pending value (fn-bps-put :scan (fn-bps-get :targets cursor)
                                             (fn-bps-stage :target-duplicate cursor)))))
     ((eq stage :context)
      (cond ((not (equal major 0)) (fn-bps-stop :unsupported :context-type cursor))
            ((not (equal value (if (equal (fn-bps-get :kind cursor) 11) 1 2)))
             (fn-bps-stop :unsupported :security-context cursor))
            (t (fn-bps-stage :flags (fn-bps-put :context value
                    (fn-bps-put :variant (if (equal value 1) 6 3) cursor))))))
     ((eq stage :flags)
      (if (not (equal major 0)) (fn-bps-stop :refused :flags-type cursor)
        (fn-bps-stage :source-array (fn-bps-put :flags value cursor))))
     ((eq stage :source-array)
      (if (and (equal major 4) (equal value 2)) (fn-bps-stage :source-scheme cursor)
        (fn-bps-stop :refused :source-shape cursor)))
     ((eq stage :source-scheme)
      (cond ((not (equal major 0)) (fn-bps-stop :refused :source-scheme cursor))
            ((not (member-equal value '(1 2))) (fn-bps-stop :unsupported :source-scheme cursor))
            (t (fn-bps-stage :source-ssp (fn-bps-put :scheme value cursor)))))
     ((eq stage :source-ssp)
      (cond ((equal (fn-bps-get :scheme cursor) 1)
             (cond ((and (equal major 0) (equal value 0))
                    (fn-bps-next-param-or-results
                     (fn-bps-put :source '(:array (:uint . 1) (:uint . 0)) cursor)))
                   ((equal major 3) (fn-bps-bytes-start value t cursor))
                   (t (fn-bps-stop :refused :source-ssp cursor))))
            ((and (equal major 4) (equal value 2)) (fn-bps-stage :source-node cursor))
            (t (fn-bps-stop :refused :source-ssp cursor))))
     ((eq stage :source-node)
      (if (equal major 0) (fn-bps-stage :source-service (fn-bps-put :pending value cursor))
        (fn-bps-stop :refused :source-node cursor)))
     ((eq stage :source-service)
      (if (equal major 0)
          (fn-bps-next-param-or-results
           (fn-bps-put :source (list :array (cons :uint 2)
                                    (list :array (cons :uint (fn-bps-get :pending cursor)) (cons :uint value))) cursor))
        (fn-bps-stop :refused :source-service cursor)))
     ((eq stage :params-array)
      (cond ((or (not (equal major 4)) (zp (nfix value))) (fn-bps-stop :refused :empty-parameters cursor))
            ((< (nfix (fn-bps-field 3 limits)) (nfix value)) (fn-bps-stop :refused :params-limit cursor))
            (t (fn-bps-next-pair (fn-bps-put :after :params (fn-bps-put :remaining value
                  (fn-bps-put :seen 0 (fn-bps-put :pairs nil (fn-bps-charge (* 2 (nfix value)) cursor)))))))))
     ((eq stage :results-array)
      (cond ((or (not (equal major 4)) (not (equal value (fn-bps-get :target-count cursor))))
             (fn-bps-stop :refused :target-result-cardinality cursor))
            ((and (equal (fn-bps-get :context cursor) 2) (not (fn-bps-get :iv cursor)))
             (fn-bps-stop :unsupported :missing-explicit-iv cursor))
            (t (fn-bps-stage :target-result-array
                 (fn-bps-put :result-remaining value (fn-bps-charge value cursor))))))
     ((eq stage :target-result-array)
      (if (equal major 4) (fn-bps-result-array value cursor)
        (fn-bps-stop :refused :target-result-type cursor)))
     ((eq stage :pair-array)
      (if (and (equal major 4) (equal value 2)) (fn-bps-stage :pair-id cursor)
        (fn-bps-stop :refused :pair-shape cursor)))
     ((eq stage :pair-id)
      (let ((max-id (if (eq (fn-bps-get :after cursor) :params)
                        (if (equal (fn-bps-get :context cursor) 1) 3 4) 1)))
        (cond ((not (equal major 0)) (fn-bps-stop :refused :pair-id-type cursor))
              ((or (zp (nfix value)) (< max-id (nfix value))) (fn-bps-stop :unsupported :unknown-parameter-or-result cursor))
              ((not (equal (logand (nfix (fn-bps-get :seen cursor)) (expt 2 (nfix value))) 0))
               (fn-bps-stop :refused :duplicate-parameter-or-result cursor))
              (t (fn-bps-stage :pair-value
                   (fn-bps-put :id value (fn-bps-put :seen
                    (+ (nfix (fn-bps-get :seen cursor)) (expt 2 (nfix value))) cursor)))))))
     ((eq stage :pair-value) (fn-bps-typed-head major value cursor))
     (t (fn-bps-stop :refused :invalid-grammar-stage cursor)))))

(defun fn-bps-internal-stagep (stage)
  (declare (xargs :guard t))
  (member-equal stage '(:target-duplicate :reverse :body-finish :done)))

(defun fn-bps-internal-step (cursor)
  (declare (xargs :guard t))
  (let ((stage (fn-bps-get :stage cursor)) (scan (fn-bps-get :scan cursor)))
    (cond
     ((eq stage :target-duplicate)
      (cond ((consp scan)
             (if (equal (car scan) (fn-bps-get :pending cursor))
                 (fn-bps-stop :refused :duplicate-target cursor)
               (fn-bps-put :scan (cdr scan) cursor)))
            (t (let ((next (fn-bps-put :targets (cons (fn-bps-get :pending cursor) (fn-bps-get :targets cursor))
                            (fn-bps-put :remaining (1- (nfix (fn-bps-get :remaining cursor))) cursor))))
                 (if (zp (nfix (fn-bps-get :remaining next)))
                     (fn-bps-reverse-start (fn-bps-get :targets next) :targets-done next)
                   (fn-bps-stage :target next))))))
     ((eq stage :reverse)
      (if (consp scan) (fn-bps-put :scan (cdr scan)
                       (fn-bps-put :reverse (cons (car scan) (fn-bps-get :reverse cursor)) cursor))
        (let ((after (fn-bps-get :after cursor)) (values (fn-bps-get :reverse cursor)))
          (cond ((eq after :targets-done) (fn-bps-stage :context (fn-bps-put :targets values cursor)))
                ((eq after :params-done) (fn-bps-stage :results-array (fn-bps-put :params values cursor)))
                ((eq after :target-result-done)
                 (let ((next (fn-bps-put :results (cons values (fn-bps-get :results cursor))
                              (fn-bps-put :result-remaining (1- (nfix (fn-bps-get :result-remaining cursor))) cursor))))
                   (if (zp (nfix (fn-bps-get :result-remaining next)))
                       (fn-bps-reverse-start (fn-bps-get :results next) :results-done next)
                     (fn-bps-stage :target-result-array next))))
                ((eq after :results-done) (fn-bps-stage :done (fn-bps-put :results values cursor)))
                (t (fn-bps-stop :refused :invalid-reverse-stage cursor))))))
     ((eq stage :body-finish)
      (let ((span (fn-bps-get :body cursor)))
        (if (eq (fn-bps-field 0 span) :text-span)
            (if (and (<= 4 (nfix (fn-bps-field 3 span))) (fn-bps-get :delimiter cursor))
                (fn-bps-next-param-or-results (fn-bps-put :source (list :array (cons :uint 1) span) cursor))
              (fn-bps-stop :refused :source-text cursor))
          (fn-bps-finish-value span cursor))))
     ((eq stage :done)
      (if (equal (fn-bps-get :offset cursor)
                 (+ (nfix (fn-bps-get :start cursor)) (nfix (fn-bps-get :length cursor))))
          (fn-bps-stop :parsed nil cursor) (fn-bps-stop :refused :trailing-data cursor)))
     (t (fn-bps-stop :refused :invalid-internal-stage cursor)))))

(defun fn-bps-asb-octet (octet cursor)
  (declare (xargs :guard t))
  (let ((next (fn-bps-put :offset (1+ (nfix (fn-bps-get :offset cursor))) cursor)))
    (cond ((not (fn-cbor-octetp octet)) (fn-bps-stop :refused :invalid-octet next))
          ((eq (fn-bps-get :stage cursor) :body)
           (let* ((textp (eq (fn-bps-field 0 (fn-bps-get :body cursor)) :text-span))
                  (index (nfix (fn-bps-get :body-index cursor)))
                  (left (1- (nfix (fn-bps-get :body-left cursor)))))
             (if (and textp (or (not (fn-bpp-vcharp octet))
                               (and (< index 2) (not (equal octet 47)))
                               (and (equal index 2) (equal octet 47))))
                 (fn-bps-stop :refused :source-text next)
               (fn-bps-put :body-index (1+ index)
                (fn-bps-put :body-left left
                 (fn-bps-put :delimiter (or (fn-bps-get :delimiter cursor)
                                            (and textp (< 2 index) (equal octet 47)))
                  (if (zp (nfix left)) (fn-bps-stage :body-finish next) next)))))))
          (t (let* ((one (fn-bps-head-feed (fn-bps-get :head cursor) octet))
                    (status (fn-bps-field 0 one))
                    (held (fn-bps-put :head (fn-bps-field 2 one) next)))
               (cond ((eq status :more) held)
                     ((eq status :ready)
                      (fn-bps-accept-head (fn-bps-field 0 (fn-bps-field 1 one))
                                          (fn-bps-field 1 (fn-bps-field 1 one)) held))
                     (t (fn-bps-stop status (fn-bps-field 1 one) held))))))))

(defun fn-bps-asb-drive (cursor octets quantum)
  (declare (xargs :guard t :measure (nfix quantum)))
  (cond
   ((not (eq (fn-bps-get :status cursor) :more)) (list cursor 0 octets))
   ((zp (nfix quantum)) (list cursor 0 octets))
   ((or (fn-bps-internal-stagep (fn-bps-get :stage cursor))
        (and (eq (fn-bps-get :stage cursor) :body) (zp (nfix (fn-bps-get :body-left cursor)))))
    (fn-bps-asb-drive
     (fn-bps-internal-step (if (eq (fn-bps-get :stage cursor) :body)
                              (fn-bps-stage :body-finish cursor) cursor)) octets (1- (nfix quantum))))
   ((<= (+ (nfix (fn-bps-get :start cursor)) (nfix (fn-bps-get :length cursor)))
        (nfix (fn-bps-get :offset cursor)))
    (list (fn-bps-stop :refused :truncated cursor) 0 octets))
   ((not (consp octets)) (list (fn-bps-stop :need-input nil cursor) 0 octets))
   (t (let ((tail (fn-bps-asb-drive (fn-bps-asb-octet (car octets) cursor) (cdr octets) (1- (nfix quantum)))))
        (list (fn-bps-field 0 tail) (1+ (nfix (fn-bps-field 1 tail))) (fn-bps-field 2 tail))))))

(defun fn-bps-asb-step (cursor window quantum)
  (declare (xargs :guard t))
  (let* ((active (if (eq (fn-bps-get :status cursor) :need-input)
                     (fn-bps-stop :more nil cursor) cursor))
         (driven (if (and (eq (fn-bps-field 0 window) :bps-window)
                          (equal (fn-bps-get :backing active) (fn-bps-field 1 window))
                          (equal (fn-bps-get :offset active) (fn-bps-field 2 window)))
                     (fn-bps-asb-drive active (fn-bps-field 3 window) quantum)
                   (list (fn-bps-stop :refused :window-coordinate active) 0 (fn-bps-field 3 window))))
         (next (fn-bps-field 0 driven)))
    (list (fn-bps-get :status next) (fn-bps-get :reason next) next
          (fn-bps-field 1 driven) (fn-bps-field 2 driven))))

(defun fn-bps-asb-span-result (cursor)
  (declare (xargs :guard t))
  (list :asb-span (fn-bps-get :kind cursor) (fn-bps-get :targets cursor)
        (fn-bps-get :context cursor) (fn-bps-get :flags cursor)
        (fn-bps-get :source cursor) (fn-bps-get :params cursor) (fn-bps-get :results cursor)))

; Logical whole-input reference. The host serves STEP, never this allocation
; or the span abstraction. The generous reference fuel is not a served
; scheduling quantum; it includes the explicit duplicate-check work.
(defun fn-bps-asb-decode (kind octets limits)
  (declare (xargs :guard t))
  (let* ((size (len octets)) (targets (nfix (fn-bps-field 2 limits)))
         (metadata (nfix (fn-bps-field 6 limits)))
         (cursor (fn-bps-asb-start kind :reference 0 size limits))
         (step (fn-bps-asb-step cursor (fn-bps-window-make :reference 0 octets)
                                (+ 256 size (* 4 targets targets) (* 20 metadata))))
         (status (fn-bps-field 0 step)) (next (fn-bps-field 2 step)))
    (cond ((eq status :parsed)
           (list :parsed (fn-bps-asb-span-alpha (fn-bps-asb-span-result next)
                                              (list (cons :reference octets)))))
          ((eq status :unsupported)
           (list :unsupported (list (fn-bps-field 1 step) (list :raw-asb kind octets))))
          ((eq status :refused)
           (list :refused (fn-bps-field 1 step) (fn-bps-get :offset next)))
          (t (list :refused :reference-fuel-or-input (fn-bps-get :offset next))))))

(defthm fn-bps-asb-drive-consumes-at-most-quantum
  (<= (fn-bps-field 1 (fn-bps-asb-drive cursor octets quantum)) (nfix quantum))
  :hints (("Goal" :induct (fn-bps-asb-drive cursor octets quantum)
           :in-theory (e/d (fn-bps-asb-drive fn-bps-field)
                           (fn-bps-get fn-bps-stop fn-bps-internal-stagep fn-bps-internal-step
                            fn-bps-stage fn-bps-asb-octet)))))

(defthm fn-bps-asb-drive-consumes-at-most-window
  (<= (fn-bps-field 1 (fn-bps-asb-drive cursor octets quantum)) (len octets))
  :hints (("Goal" :induct (fn-bps-asb-drive cursor octets quantum)
           :in-theory (e/d (fn-bps-asb-drive fn-bps-field)
                           (fn-bps-get fn-bps-stop fn-bps-internal-stagep fn-bps-internal-step
                            fn-bps-stage fn-bps-asb-octet)))))

(defthm fn-bps-asb-drive-rest-is-exact-unconsumed-suffix
  (equal (fn-bps-field 2 (fn-bps-asb-drive cursor octets quantum))
         (nthcdr (fn-bps-field 1 (fn-bps-asb-drive cursor octets quantum)) octets))
  :hints (("Goal" :induct (fn-bps-asb-drive cursor octets quantum)
           :in-theory (e/d (fn-bps-asb-drive fn-bps-field)
                           (fn-bps-get fn-bps-stop fn-bps-internal-stagep fn-bps-internal-step
                            fn-bps-stage fn-bps-asb-octet)))))

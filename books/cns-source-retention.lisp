; A streamed query retains its complete immutable source closure independently
; of per-operation pins. This book grants no decoder or SEND-completion flag.
(in-package "ACL2")
(include-book "cns-source-state")
(include-book "checkpoint")
(include-book "txn-kind")
(fn2-book-layer :d)
(defconst *fn2-cns-source-retention-unclaimed* 0)
(defconst *fn2-cns-source-retention-collecting* 1)
(defconst *fn2-cns-source-retention-ready* 2)
(defconst *fn2-cns-source-retention-releasing* 3)
(defconst *fn2-cns-source-retention-released* 4)
(defun fn2-cns-source-edge-base (fn2-checkpoints fn2-extents fn2-ops)
 (declare (xargs :stobjs (fn2-checkpoints fn2-extents fn2-ops)
 :guard (and (fn2-checkpoints-wfp fn2-checkpoints) (fn2-extents-wfp fn2-extents) (fn2-ops-wfp fn2-ops))))
 (+ 6 (* 2 (fn2-extents-rows fn2-extents)) (fn2-ops-rows fn2-ops)
    (* 6 (fn2-checkpoints-rows fn2-checkpoints))
    (* (fn2-extents-rows fn2-extents) (fn2-checkpoints-rows fn2-checkpoints))))
(defun fn2-cns-source-edge (s e fn2-checkpoints fn2-extents fn2-ops)
 (declare (xargs :stobjs (fn2-checkpoints fn2-extents fn2-ops)
 :guard (and (fn2-checkpoints-wfp fn2-checkpoints) (fn2-extents-wfp fn2-extents) (fn2-ops-wfp fn2-ops))))
 (+ (fn2-cns-source-edge-base fn2-checkpoints fn2-extents fn2-ops)
    (* (nfix s) (fn2-extents-rows fn2-extents)) (nfix e)))
(defun fn2-cns-source-retain-ownerp (s cns cnsgen ctl ctlgen request fn2-cns-sources)
 (declare (xargs :stobjs fn2-cns-sources :guard (fn2-cns-sources-wfp fn2-cns-sources)))
 (and (fn2-cns-source-ownerp s cns cnsgen ctl ctlgen request fn2-cns-sources)
      (unsigned-byte-p 32 cns) (unsigned-byte-p 60 cnsgen)
      (unsigned-byte-p 32 ctl) (unsigned-byte-p 60 ctlgen) (unsigned-byte-p 60 request)))
(defun fn2-cns-source-heldp (s cns cnsgen ctl ctlgen request unit epoch allocation
 fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)
 (declare (xargs :stobjs (fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)
 :guard (and (fn2-cns-sources-wfp fn2-cns-sources) (fn2-checkpoints-wfp fn2-checkpoints)
  (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges) (fn2-ops-wfp fn2-ops))))
 (and (fn2-cns-source-retain-ownerp s cns cnsgen ctl ctlgen request fn2-cns-sources)
      (unsigned-byte-p 60 unit) (unsigned-byte-p 60 epoch) (unsigned-byte-p 60 allocation)
      (let* ((e (floor unit *fn2-storage-extent-units*))
             (edge (fn2-cns-source-edge s e fn2-checkpoints fn2-extents fn2-ops)))
       (and (fn2-alloc-slotp e fn2-extents) (fn2-alloc-edge-slotp edge fn2-alloc-edges)
            (eq (fn2-alloc-handle-code e epoch allocation fn2-extents) :ok)
            (fn2-alloc-edge-matchesp edge cnsgen e epoch allocation :promised-read fn2-alloc-edges)))))
; Internal actual-producer seam. Root capture supplies the retained root;
; the authenticated manifest decoder supplies its retained CLAIM target.
; This primitive cannot assert coverage, advance a cursor, or emit a prefix.
(defun fn2-cns-source-claim-identity (s cns cnsgen ctl ctlgen request unit epoch allocation
 fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)
 (declare (xargs :stobjs (fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)
 :guard (and (fn2-cns-sources-wfp fn2-cns-sources) (fn2-checkpoints-wfp fn2-checkpoints)
  (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges) (fn2-ops-wfp fn2-ops))))
 (b* (((unless (and (fn2-cns-source-retain-ownerp s cns cnsgen ctl ctlgen request fn2-cns-sources)
                    (unsigned-byte-p 60 unit) (unsigned-byte-p 60 epoch) (unsigned-byte-p 60 allocation)
                    (equal (fn2-cns-sources-pending s fn2-cns-sources) 0)
                    (equal (fn2-cns-sources-borrow-count s fn2-cns-sources) 0)
                    (or
                     (and (equal (fn2-cns-sources-phase s fn2-cns-sources) *fn2-cns-source-phase-retain*)
                          (equal (fn2-cns-sources-retention-phase s fn2-cns-sources) *fn2-cns-source-retention-unclaimed*)
                          (equal unit (fn2-cns-sources-root-unit s fn2-cns-sources))
                          (equal epoch (fn2-cns-sources-root-epoch s fn2-cns-sources))
                          (equal allocation (fn2-cns-sources-root-allocation s fn2-cns-sources)))
                     (and (equal (fn2-cns-sources-phase s fn2-cns-sources) *fn2-cns-source-phase-manifest*)
                          (equal (fn2-cns-sources-retention-phase s fn2-cns-sources) *fn2-cns-source-retention-collecting*)
                          (equal (fn2-cns-sources-manifest-stage s fn2-cns-sources) *fn2-cns-source-manifest-stage-claim*)
                          (equal unit (fn2-cns-sources-unit s fn2-cns-sources))
                          (equal epoch (fn2-cns-sources-epoch s fn2-cns-sources))
                          (equal allocation (fn2-cns-sources-allocation s fn2-cns-sources))))))
       (mv :source fn2-extents fn2-alloc-edges))
      (e (floor unit *fn2-storage-extent-units*))
      (edge (fn2-cns-source-edge s e fn2-checkpoints fn2-extents fn2-ops)))
  (cond ((not (and (fn2-alloc-slotp e fn2-extents) (fn2-alloc-edge-slotp edge fn2-alloc-edges)))
         (mv :edge-bounds fn2-extents fn2-alloc-edges))
        ((not (eq (fn2-alloc-handle-code e epoch allocation fn2-extents) :ok))
         (mv :stale fn2-extents fn2-alloc-edges))
        ((not (member (fn2-extents-state e fn2-extents)
                      (list *fn2-extent-state-allocated* *fn2-extent-state-retire-pending*)))
         (mv :state fn2-extents fn2-alloc-edges))
        ((fn2-alloc-edge-matchesp edge cnsgen e epoch allocation :promised-read fn2-alloc-edges)
         (mv :ok fn2-extents fn2-alloc-edges))
        ((not (equal (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-free*))
         (mv :edge-owner fn2-extents fn2-alloc-edges))
        ((equal (fn2-extents-promised-read e fn2-extents) (1- (expt 2 32)))
         (mv :capacity fn2-extents fn2-alloc-edges))
        (t (fn2-alloc-edge-add edge cnsgen e epoch allocation :promised-read fn2-extents fn2-alloc-edges)))))
(defun fn2-cns-source-root-hold-children (s cns cnsgen ctl ctlgen request
 fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)
 (declare (xargs :stobjs (fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)
 :guard (and (fn2-cns-sources-wfp fn2-cns-sources) (fn2-checkpoints-wfp fn2-checkpoints)
  (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges) (fn2-ops-wfp fn2-ops))))
 (b* (((unless (and (fn2-cns-source-retain-ownerp s cns cnsgen ctl ctlgen request fn2-cns-sources)
                    (equal (fn2-cns-sources-phase s fn2-cns-sources) *fn2-cns-source-phase-retain*)
                    (equal (fn2-cns-sources-retention-phase s fn2-cns-sources) *fn2-cns-source-retention-unclaimed*)))
       (mv :source fn2-cns-sources fn2-extents fn2-alloc-edges))
      (total (fn2-cns-sources-total s fn2-cns-sources))
      (raw (equal (fn2-cns-sources-location-kind s fn2-cns-sources) *fn2-txn-location-raw-source*))
      (unit (fn2-cns-sources-root-unit s fn2-cns-sources))
      (span (if raw (fn2-am-blocks total) (fn2-am-units total)))
      ((unless (and (posp total) (posp span)
                    (if raw (not (fn2-am-manifestp total))
                     (and (equal (fn2-cns-sources-location-kind s fn2-cns-sources) *fn2-txn-location-source-manifest*)
                          (fn2-am-manifestp total)))
                    (<= (+ (mod unit *fn2-storage-extent-units*) span) *fn2-storage-extent-units*)))
       (mv :location fn2-cns-sources fn2-extents fn2-alloc-edges))
      ((mv code fn2-extents fn2-alloc-edges)
       (fn2-cns-source-claim-identity s cns cnsgen ctl ctlgen request unit
        (fn2-cns-sources-root-epoch s fn2-cns-sources) (fn2-cns-sources-root-allocation s fn2-cns-sources)
        fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops))
      ((unless (eq code :ok)) (mv code fn2-cns-sources fn2-extents fn2-alloc-edges))
      (fn2-cns-sources (fn2-cns-sources-put s
       (retention-phase (if raw *fn2-cns-source-retention-ready* *fn2-cns-source-retention-collecting*))
       (phase (if raw *fn2-cns-source-phase-raw-read* *fn2-cns-source-phase-manifest*))
       (manifest-stage (if raw *fn2-cns-source-manifest-stage-none* *fn2-cns-source-manifest-stage-read*))
       (retain-row 0) (release-row 0) (retain-entry-index 0) (retain-entry-count 0)
       (manifest-position 0) (manifest-index 0) (manifest-count (if raw 0 (fn2-am-units total)))
       (manifest-seen 0))))
  (mv :ok fn2-cns-sources fn2-extents fn2-alloc-edges)))
(fn2-extents-preserves fn2-cns-source-claim-identity
 (s cns cnsgen ctl ctlgen request unit epoch allocation fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)
 :carriers ((fn2-extents 1 :prefix "-EXTENTS") (fn2-alloc-edges 2 :prefix "-EDGES")))
(fn2-cns-sources-preserves fn2-cns-source-root-hold-children
 (s cns cnsgen ctl ctlgen request fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)
 :position 1 :carriers ((fn2-cns-sources 1 :prefix "-SOURCES") (fn2-extents 2 :prefix "-EXTENTS") (fn2-alloc-edges 3 :prefix "-EDGES")))

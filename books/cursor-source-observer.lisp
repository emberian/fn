; The actual cursor request owns one parent observation across every transient
; READ. CANCEL is returned by connection draining only after pending/borrows0;
; ordinary DONE returns TURN only after the last SEND completion.
(in-package "ACL2")
(include-book "cursor-kind")
(include-book "c-source-observer")
(fn2-book-layer :d)
(defun fn2-cursor-request-acquire-children (slot generation fn2-cursor-table fn2-reads fn2-succ-txns fn2-c-source-control fn2-c-source-readers)
 (declare (xargs :stobjs (fn2-cursor-table fn2-reads fn2-succ-txns fn2-c-source-control fn2-c-source-readers)
 :guard (and (fn2-cursor-wfp fn2-cursor-table) (fn2-reads-wfp fn2-reads) (fn2-succ-txns-wfp fn2-succ-txns)
             (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-readers-wfp fn2-c-source-readers))))
 (b* (((unless (and (natp slot) (< slot (fn2-cursor-rows fn2-cursor-table))
                    (equal generation (fn2-cursor-generation slot fn2-cursor-table))
                    (equal (fn2-cursor-phase slot fn2-cursor-table) *fn2-cursor-state-select*)))
       (mv :fault 0 fn2-reads fn2-c-source-control fn2-c-source-readers))
      (endpoint (fn2-c-source-request-endpoint (fn2-reads-rows fn2-reads) (fn2-succ-txns-rows fn2-succ-txns) slot))
      (expected (fn2-cursor-observer-serial slot fn2-cursor-table))
      ((mv code receipt fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire endpoint expected fn2-c-source-control fn2-c-source-readers))
      ((unless (eq code :ok))
       (mv (if (eq code :busy) :more :fault) 0 fn2-reads fn2-c-source-control fn2-c-source-readers))
      ((mv bound fn2-reads)
       (fn2-read-parent-bind-pair (* 2 slot) (+ 1 (* 2 slot)) endpoint receipt fn2-reads fn2-c-source-readers))
      ((when (eq bound :ok)) (mv :ok receipt fn2-reads fn2-c-source-control fn2-c-source-readers))
      ; Failed pair preflight writes neither child. A newly acquired parent is
      ; relinquished within this same callback, before any yield or prefix.
      ((mv & & & fn2-c-source-control fn2-c-source-readers)
       (if (equal expected 0)
        (fn2-c-source-reader-release endpoint receipt fn2-c-source-control fn2-c-source-readers)
        (mv :held *fn2-none* 0 fn2-c-source-control fn2-c-source-readers))))
  (mv :fault 0 fn2-reads fn2-c-source-control fn2-c-source-readers)))
(defun fn2-cursor-request-release-children (slot generation fn2-cursor-table fn2-reads fn2-succ-txns fn2-c-source-control fn2-c-source-readers)
 (declare (xargs :stobjs (fn2-cursor-table fn2-reads fn2-succ-txns fn2-c-source-control fn2-c-source-readers)
 :guard (and (fn2-cursor-wfp fn2-cursor-table) (fn2-reads-wfp fn2-reads) (fn2-succ-txns-wfp fn2-succ-txns)
             (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-readers-wfp fn2-c-source-readers))))
 (b* (((unless (and (natp slot) (< slot (fn2-cursor-rows fn2-cursor-table))
                    (equal generation (fn2-cursor-generation slot fn2-cursor-table))
                    (equal (fn2-cursor-phase slot fn2-cursor-table) *fn2-cursor-state-draining*)
                    (equal (fn2-cursor-pending slot fn2-cursor-table) 0)
                    (equal (fn2-cursor-turn slot fn2-cursor-table) 1)
                    (equal (fn2-cursor-lease slot fn2-cursor-table) *fn2-cursor-lease-none*)
                    (equal (fn2-cursor-query-bundle slot fn2-cursor-table) *fn2-cursor-query-bundle-none*)
                    (equal (fn2-cursor-load-active slot fn2-cursor-table) 0)
                    (equal (fn2-cursor-storage-hold slot fn2-cursor-table) *fn2-cursor-storage-hold-none*)))
       (mv :fault fn2-reads fn2-c-source-control fn2-c-source-readers))
      (receipt (fn2-cursor-observer-serial slot fn2-cursor-table))
      ((when (equal receipt 0)) (mv :ok fn2-reads fn2-c-source-control fn2-c-source-readers))
      (endpoint (fn2-c-source-request-endpoint (fn2-reads-rows fn2-reads) (fn2-succ-txns-rows fn2-succ-txns) slot))
      ((unless (and (< 0 (fn2-c-source-control-rows fn2-c-source-control))
                    (posp (fn2-c-source-control-readers 0 fn2-c-source-control))
                    (fn2-c-source-reader-current-p endpoint receipt fn2-c-source-readers)))
       (mv :fault fn2-reads fn2-c-source-control fn2-c-source-readers))
      ((mv cleared fn2-reads)
       (fn2-read-parent-clear-pair (* 2 slot) (+ 1 (* 2 slot)) endpoint receipt fn2-reads fn2-c-source-readers))
      ((unless (eq cleared :ok)) (mv :fault fn2-reads fn2-c-source-control fn2-c-source-readers))
      ((mv code & & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release endpoint receipt fn2-c-source-control fn2-c-source-readers)))
  (mv (if (eq code :ok) :ok :fault) fn2-reads fn2-c-source-control fn2-c-source-readers)))

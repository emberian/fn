; One bounded physical-checker step over the three retained journal sectors.
; The boot driver owns all input windows and the authenticated arena ordinal.
(in-package "ACL2")
(include-book "origin")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-recovery-evidence-state")
(fn2-book-layer :b)
(defmacro fn2-cpe (field)
 (list (fn2-columns-sym 'fn2-checkpoint-recovery-evidence (concatenate 'string "-" (symbol-name field))) 0 'fn2-checkpoint-recovery-evidence))
(defmacro fn2-cpe-f (field)
 `(fn2-fields-value (+ *fn2-rec-field-base* ,field) fn2-fields))
(defmacro fn2-cpe-answer (code)
 `(mv ,code fn2-checkpoint-recovery-evidence fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))

(defun fn2-checkpoint-recovery-evidence-bound-candidate-p (fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)
 (declare (xargs :stobjs (fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)
  :guard (and (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-checkpoint-recovery-evidence-wfp fn2-checkpoint-recovery-evidence))))
 (and (< 0 (fn2-checkpoint-recovery-evidence-rows fn2-checkpoint-recovery-evidence))
  (let* ((c (fn2-cpe candidate)) (r (* 6 c)))
   (and (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
        (= (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-checked*)
        (= (fn2-checkpoints-builder-token c fn2-checkpoints) 0)
        (= (fn2-checkpoints-checkpoint c fn2-checkpoints) (fn2-cpe checkpoint))
        (= (fn2-checkpoints-cut-commit c fn2-checkpoints) (fn2-cpe cut-commit))
        (= (fn2-checkpoints-cut-event c fn2-checkpoints) (fn2-cpe cut-event))
        (= (fn2-checkpoint-refs-storage-domain r fn2-checkpoint-refs) (fn2-cpe descriptor-domain))
        (= (fn2-checkpoint-refs-physical-unit r fn2-checkpoint-refs) (fn2-cpe descriptor-unit))
        (= (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs) (fn2-cpe descriptor-epoch))
        (= (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs) (fn2-cpe descriptor-allocation))
        (= (fn2-checkpoint-refs-page-kind r fn2-checkpoint-refs) (fn2-cpe descriptor-kind))
        (= (fn2-checkpoint-refs-encoded-length r fn2-checkpoint-refs) (fn2-cpe descriptor-length))
        (fn2-checkpoint-recovery-evidence-bound-hash-p 32 0 (* 32 r) fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)))))

(defun fn2-checkpoint-recovery-evidence-physical (budget fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence
                                                fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-origin fn2-digests)
 (declare (xargs :stobjs (fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-origin fn2-digests)
  :guard (and (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-checkpoint-recovery-evidence-wfp fn2-checkpoint-recovery-evidence)
              (fn2-fc-wfp fn2-fc) (fn2-fc-context-wfp fn2-fc-context) (fn2-b3-wfp fn2-b3)
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (fn2-digests-wfp fn2-digests) (fn2-origin-wfp fn2-origin))))
 (b* ((row *fn2-rec-checker-row*) (base *fn2-rec-field-base*)
      ((unless (and (fn2-origin-physicalp (fn2-origin-history fn2-origin) (fn2-origin-history-incarnation fn2-origin))
                     (<= 5 (fn2-checkpoint-recovery-evidence-rows fn2-checkpoint-recovery-evidence))
                     (< row (fn2-fc-rows fn2-fc)) (< row (fn2-fc-context-rows fn2-fc-context))
                     (fn2-b3-ready row fn2-b3 fn2-digests)
                     (<= (+ base *fn2-format-sealed-batch-num-fields*) (fn2-fields-rows fn2-fields))
                     (natp budget) (<= budget 4096))) (fn2-cpe-answer :bounds))
      (slot (fn2-cpe slot)) (gen (fn2-cpe gen))
      (okind (fn2-cpe owner-kind)) (oslot (fn2-cpe owner-slot)) (ogen (fn2-cpe owner-gen))
      (e (fn2-cpe extent)) (ep (fn2-cpe epoch)) (al (fn2-cpe allocation))
      (c (fn2-cpe candidate)) (phase (fn2-cpe phase)) (commit (fn2-cpe commit))
      (history (fn2-cpe journal-history)) (incarnation (fn2-cpe journal-incarnation))
      (hash (fn2-digest-slot row *fn2-fc-hash*)) (prev (fn2-digest-slot row *fn2-fc-previous-seal*))
      (geometry (fn2-digest-slot row *fn2-fc-geometry*))
      ((unless (and (fn2-checkpoint-recovery-evidence-bound-candidate-p fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)
                     (< c (fn2-checkpoints-rows fn2-checkpoints))
                     (= (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-checked*)
                     (= (fn2-checkpoints-builder-token c fn2-checkpoints) 0)
                     (= (fn2-checkpoints-history c fn2-checkpoints) (fn2-origin-history fn2-origin))
                     (= (fn2-checkpoints-incarnation c fn2-checkpoints) (fn2-origin-history-incarnation fn2-origin))
                     (fn2-digest-rowp hash fn2-digests) (fn2-digest-rowp prev fn2-digests)
                     (fn2-digest-rowp geometry fn2-digests)
                     (eq (fn2-pool-workspace-code slot gen okind oslot ogen fn2-pool) :ok)
                     (<= 12288 (fn2-pool-fill slot fn2-pool)))) (fn2-cpe-answer :state)))
  (cond
   ((= phase *fn2-checkpoint-recovery-evidence-phase-frame*)
    (if (= (fn2-cpe started) 0)
     (b* (((mv code next fn2-fields) (fn2-format-frame-header-decode base slot gen 8192 12288 okind oslot ogen fn2-fields fn2-pool))
          ((unless (eq code :ok)) (fn2-cpe-answer :skip))
          ; Tentative identity from actual bytes. The sealed body must agree,
          ; then :seal authenticates this pair against the anchor batch hash.
          ; Historical journal identity need not equal current anchor identity.
          (history (fn2-cpe-f *fn2-format-frame-header-field-history*))
          (incarnation (fn2-cpe-f *fn2-format-frame-header-field-incarnation*))
          ((unless (fn2-origin-physicalp history incarnation)) (fn2-cpe-answer :skip))
          ((mv ok batch epoch allocation payload) (fn2-rec-header-check e history incarnation fn2-fields))
          ((unless (and ok (= epoch ep) (= allocation al) (natp next) (<= (+ next payload) 12288)
                         (unsigned-byte-p 32 next) (unsigned-byte-p 32 payload))) (fn2-cpe-answer :skip))
          (fn2-fc-context (fn2-rec-context row e 2 ep al batch hash prev geometry history incarnation fn2-fc-context))
          (fn2-fc (fn2-fc-reset row fn2-fc))
          (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-put 0
            (journal-history history) (journal-incarnation incarnation)
            (commit batch) (seal-off next) (seal-len payload) (started 1))))
      (fn2-cpe-answer :more))
     (mv-let (code fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
      (fn2-format-run :frame nil row slot gen 8192 4096 base okind oslot ogen budget fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
      (let ((fn2-checkpoint-recovery-evidence (if (eq code :ok)
             (fn2-checkpoint-recovery-evidence-put 0 (phase *fn2-checkpoint-recovery-evidence-phase-decode*) (started 0)) fn2-checkpoint-recovery-evidence)))
       (fn2-cpe-answer (if (member-eq code '(:ok :more)) :more :skip))))))
   ((= phase *fn2-checkpoint-recovery-evidence-phase-decode*)
    (b* (((mv code end fn2-fields) (fn2-format-sealed-batch-decode base slot gen (fn2-cpe seal-off)
          (+ (fn2-cpe seal-off) (fn2-cpe seal-len)) okind oslot ogen fn2-fields fn2-pool))
         ((unless (eq code :ok)) (fn2-cpe-answer :skip))
         ((mv ok first last) (fn2-rec-seal-check e commit ep al history incarnation fn2-fields))
         (f *fn2-format-sealed-batch-field-dependencies-storage-domain*)
         ((unless (and ok (natp end) (<= (fn2-cpe seal-off) end) (unsigned-byte-p 32 (- end (fn2-cpe seal-off)))
                        (unsigned-byte-p 60 first) (unsigned-byte-p 60 last)
                        (= (fn2-cpe-f f) 0) (= (fn2-cpe-f (+ f 1)) (* e *fn2-storage-extent-units*))
                        (= (fn2-cpe-f (+ f 2)) ep) (= (fn2-cpe-f (+ f 3)) al)
                        (= (fn2-cpe-f (+ f 4)) *page-kind-manifest*) (= (fn2-cpe-f (+ f 5)) 4096))) (fn2-cpe-answer :skip))
         ((mv a fn2-checkpoint-recovery-evidence) (fn2-checkpoint-recovery-evidence-fetch 32 96
          (fn2-fields-ref-off (+ base *fn2-format-sealed-batch-field-previous-seal*) fn2-fields) slot gen okind oslot ogen fn2-pool fn2-checkpoint-recovery-evidence))
         ((mv b fn2-checkpoint-recovery-evidence) (fn2-checkpoint-recovery-evidence-fetch 32 128
          (fn2-fields-ref-off (+ base *fn2-format-sealed-batch-field-record-stream*) fn2-fields) slot gen okind oslot ogen fn2-pool fn2-checkpoint-recovery-evidence))
         ((mv d fn2-checkpoint-recovery-evidence) (fn2-checkpoint-recovery-evidence-fetch 32 160
          (fn2-fields-ref-off (+ base *fn2-format-sealed-batch-field-dependencies-expected-hash*) fn2-fields) slot gen okind oslot ogen fn2-pool fn2-checkpoint-recovery-evidence))
         ((mv z fn2-checkpoint-recovery-evidence) (fn2-checkpoint-recovery-evidence-fetch 32 192
          (fn2-fields-ref-off (+ base *fn2-format-sealed-batch-field-final-seal*) fn2-fields) slot gen okind oslot ogen fn2-pool fn2-checkpoint-recovery-evidence))
         ((unless (and (eq a :ok) (eq b :ok) (eq d :ok) (eq z :ok)
                        (fn2-checkpoint-recovery-evidence-equal 32 0 192 fn2-checkpoint-recovery-evidence))) (fn2-cpe-answer :skip))
         ; This is the sealed immediate predecessor, never anchor+32's previous
         ; checkpoint batch. Its final seal is authenticated against anchor+0.
         (fn2-digests (fn2-checkpoint-recovery-evidence-load 0 96 prev fn2-checkpoint-recovery-evidence fn2-digests))
         (fn2-fc-context (fn2-rec-context row e 2 ep al commit hash prev geometry history incarnation fn2-fc-context))
         (fn2-fc (fn2-fc-reset row fn2-fc))
         (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-put 0
          (phase *fn2-checkpoint-recovery-evidence-phase-seal*) (seal-len (- end (fn2-cpe seal-off))) (first first) (last last))))
     (fn2-cpe-answer :more)))
   ((= phase *fn2-checkpoint-recovery-evidence-phase-seal*)
    (mv-let (code fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
     (fn2-format-run :seal nil row slot gen (fn2-cpe seal-off) (fn2-cpe seal-len) base okind oslot ogen budget
      fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
     (b* (((unless (eq code :ok)) (fn2-cpe-answer (if (eq code :more) :more :invalid)))
          (fn2-fc-context (fn2-rec-context row e 1 ep al commit hash prev geometry history incarnation fn2-fc-context))
          (fn2-fc (fn2-fc-reset row fn2-fc))
          (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-put 0 (phase *fn2-checkpoint-recovery-evidence-phase-records*))))
      (fn2-cpe-answer :more))))
   ((= phase *fn2-checkpoint-recovery-evidence-phase-records*)
    (mv-let (code fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
     (fn2-format-run :frame nil row slot gen 4096 4096 base okind oslot ogen budget fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
     (b* (((unless (eq code :ok)) (fn2-cpe-answer (if (eq code :more) :more :invalid)))
          ((mv decoded start fn2-fields) (fn2-format-frame-header-decode base slot gen 4096 8192 okind oslot ogen fn2-fields fn2-pool))
          ((mv ok payload) (fn2-rec-records-check e commit fn2-fields))
          ((unless (and (eq decoded :ok) ok (natp start) (<= 4096 start) (<= (+ start payload) 8192))) (fn2-cpe-answer :invalid))
          (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-put 0
           (phase *fn2-checkpoint-recovery-evidence-phase-commitment*) (cursor (- start 4096)) (end (- (+ start payload) 4096)))))
      (fn2-cpe-answer :more))))
   ((= phase *fn2-checkpoint-recovery-evidence-phase-commitment*)
    (b* (((mv code fn2-digests) (fn2-rec-fetch 0 hash slot gen (+ 4096 *fn2-commit-frame-digest*) okind oslot ogen fn2-pool fn2-digests))
         (fn2-digests (fn2-checkpoint-recovery-evidence-load 0 128 prev fn2-checkpoint-recovery-evidence fn2-digests))
         ((unless (and (eq code :ok) (fn2-digest-equal hash prev fn2-digests))) (fn2-cpe-answer :invalid))
         (fn2-digests (fn2-checkpoint-recovery-evidence-load 0 160 hash fn2-checkpoint-recovery-evidence fn2-digests))
         (fn2-fc-context (fn2-rec-context row e 0 ep al commit hash prev geometry history incarnation fn2-fc-context))
         (fn2-fc (fn2-fc-reset row fn2-fc))
         (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-put 0 (phase *fn2-checkpoint-recovery-evidence-phase-dependencies*))))
     (fn2-cpe-answer :more)))
   ((= phase *fn2-checkpoint-recovery-evidence-phase-dependencies*)
    (mv-let (code fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
     (fn2-format-run :page nil row slot gen 0 4096 base okind oslot ogen budget fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
     (b* (((unless (eq code :ok)) (fn2-cpe-answer (if (eq code :more) :more :invalid)))
          (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-put 0
           (phase *fn2-checkpoint-recovery-evidence-phase-walk*) (matches 0) (previous-event 0) (event 0))))
      (fn2-cpe-answer :verified))))
   (t (fn2-cpe-answer :state)))))
(fn2-checkpoint-recovery-evidence-preserves fn2-checkpoint-recovery-evidence-physical
 (budget fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-origin fn2-digests)
 :carriers ((fn2-checkpoint-recovery-evidence 1 :prefix "-EVIDENCE") (fn2-fc 2 :prefix "-FC")
            (fn2-fc-context 3 :prefix "-CONTEXT") (fn2-b3 4 :prefix "-B3") (fn2-fields 5 :prefix "-FIELDS")
            (fn2-pool 6 :prefix "-POOL") (fn2-digests 7 :prefix "-DIGESTS"))
 :hyps ((fn2-checkpoint-recovery-evidencep fn2-checkpoint-recovery-evidence) (fn2-checkpoint-recovery-evidence-wfp fn2-checkpoint-recovery-evidence) (fn2-fcp fn2-fc) (fn2-fc-wfp fn2-fc) (fn2-fc-contextp fn2-fc-context) (fn2-fc-context-wfp fn2-fc-context) (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3) (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool) (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests) (fn2-originp fn2-origin) (fn2-origin-wfp fn2-origin)))

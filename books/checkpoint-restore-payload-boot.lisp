; Boot-only payload adapters over the actual cold authority/physical engine.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "boot-kind")
(include-book "checkpoint-restore-payload")
(fn2-book-layer :c)
(defconst *fn2-boot-cold-payload-bindings*
 '((fn2-checkpoints (fn2-core-checkpoints fn2-core)) (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core))
   (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core)) (fn2-checkpoint-restore-map (fn2-core-checkpoint-restore-map fn2-core))
   (fn2-checkpoint-restore-map-control (fn2-core-checkpoint-restore-map-control fn2-core))
   (fn2-checkpoint-restore-semantic (fn2-core-checkpoint-restore-semantic fn2-core))
   (fn2-checkpoint-restore-reach (fn2-core-checkpoint-restore-reach fn2-core)) (fn2-checkpoint-restore-reach-control (fn2-core-checkpoint-restore-reach-control fn2-core))
   (fn2-checkpoint-payload (fn2-core-checkpoint-payload fn2-core))
   (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core))
   (fn2-b3 (fn2-core-b3 fn2-core)) (fn2-digests (fn2-core-digests fn2-core))))
; Output carriers are explicit per operation; readonly inputs are NOT output
; children. This avoids returning every borrowed child through an ACL2 MV.
(defmacro fn2-boot-cold-payload-bind (scalars outputs body)
 (if (> (+ (len scalars) (len outputs)) 32)
  (er hard 'fn2-boot-cold-payload-bind "Child result exceeds ACL2 MV limit.")
  (case (len scalars)
   (1 `(stobj-let ,*fn2-boot-cold-payload-bindings* ,(append scalars outputs) ,body (mv ,(car scalars) fn2-core)))
   (3 `(stobj-let ,*fn2-boot-cold-payload-bindings* ,(append scalars outputs) ,body (mv ,(car scalars) ,(cadr scalars) ,(caddr scalars) fn2-core)))
   (otherwise (er hard 'fn2-boot-cold-payload-bind "Unsupported scalar result shape.")))))
(defmacro fn2-boot-cold-payload-read (result body)
 `(stobj-let ,*fn2-boot-cold-payload-bindings* (,result) ,body ,result))
(defcost fn2-boot-checkpoint-payload-begin :answers t
 :tables (fn2-core-checkpoint-payload fn2-core-checkpoint-restore-reach fn2-core-fields fn2-core-b3 fn2-core-digests))
(defcost fn2-boot-checkpoint-payload-target :answers t
 :tables (fn2-core-checkpoint-payload fn2-core-checkpoint-restore-reach))
(defcost fn2-boot-checkpoint-payload-loaded :answers t
 :tables (fn2-core-checkpoint-payload fn2-core-pool))
(defcost fn2-boot-checkpoint-payload-step :answers t
 :tables (fn2-core-checkpoint-restore-semantic fn2-core-checkpoint-payload fn2-core-checkpoint-restore-reach fn2-core-fields fn2-core-b3 fn2-core-digests))

(defmacro fn2-boot-checkpoint-payload-operations ()
 '(progn
  (defun fn2-boot-checkpoint-payload-bound-p (id ogen phase fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (and (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
        (equal (fn2-machine-generation id fn2-core) ogen) (equal (fn2-machine-phase id fn2-core) phase)
        (let ((c (fn2-machine-checkpoint-index id fn2-core)) (slot (fn2-machine-root-slot id fn2-core)) (gen (fn2-machine-root-gen id fn2-core))
              (mslot (fn2-machine-pool-slot id fn2-core)) (mgen (fn2-machine-pool-gen id fn2-core))
              (dslot (fn2-machine-rx-slot id fn2-core)) (dgen (fn2-machine-rx-gen id fn2-core)))
         (stobj-let ((fn2-checkpoint-restore-semantic (fn2-core-checkpoint-restore-semantic fn2-core))
                     (fn2-checkpoint-payload (fn2-core-checkpoint-payload fn2-core))) (bound)
          (and (< 0 (fn2-checkpoint-restore-semantic-rows fn2-checkpoint-restore-semantic))
               (equal (fn2-checkpoint-restore-semantic-candidate 0 fn2-checkpoint-restore-semantic) c)
               (equal (fn2-checkpoint-restore-semantic-slot 0 fn2-checkpoint-restore-semantic) slot)
               (equal (fn2-checkpoint-restore-semantic-gen 0 fn2-checkpoint-restore-semantic) gen)
               (equal (fn2-checkpoint-restore-semantic-owner-kind 0 fn2-checkpoint-restore-semantic) *fn2-boot-kind*)
               (equal (fn2-checkpoint-restore-semantic-owner-slot 0 fn2-checkpoint-restore-semantic) id)
               (equal (fn2-checkpoint-restore-semantic-owner-gen 0 fn2-checkpoint-restore-semantic) ogen)
               ; BEGIN derives these tuples. Every resumed callback must bind
               ; them BEFORE resetting or copying a machine-owned window.
               (or (equal phase *fn2-boot-state-checkpoint-payload-begin*)
                   (and (< 0 (fn2-checkpoint-payload-rows fn2-checkpoint-payload))
                        (equal (fn2-checkpoint-payload-mode 0 fn2-checkpoint-payload) *fn2-checkpoint-payload-mode-cold*)
                        (equal (fn2-checkpoint-payload-owner-kind 0 fn2-checkpoint-payload) *fn2-boot-kind*)
                        (equal (fn2-checkpoint-payload-owner-slot 0 fn2-checkpoint-payload) id)
                        (equal (fn2-checkpoint-payload-owner-gen 0 fn2-checkpoint-payload) ogen)
                        (equal (fn2-checkpoint-payload-manifest-slot 0 fn2-checkpoint-payload) mslot)
                        (equal (fn2-checkpoint-payload-manifest-gen 0 fn2-checkpoint-payload) mgen)
                        (equal (fn2-checkpoint-payload-data-slot 0 fn2-checkpoint-payload) dslot)
                        (equal (fn2-checkpoint-payload-data-gen 0 fn2-checkpoint-payload) dgen)))) bound))))
  (defun fn2-boot-checkpoint-payload-begin (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (fn2-boot-checkpoint-payload-bound-p id ogen *fn2-boot-state-checkpoint-payload-begin* fn2-core)) (mv :state fn2-core)
    (let ((mslot (fn2-machine-pool-slot id fn2-core)) (mgen (fn2-machine-pool-gen id fn2-core))
          (dslot (fn2-machine-rx-slot id fn2-core)) (dgen (fn2-machine-rx-gen id fn2-core)))
     (fn2-boot-cold-payload-bind (code) (fn2-checkpoint-payload fn2-checkpoint-restore-reach fn2-fields fn2-b3 fn2-digests)
      (fn2-checkpoint-restore-payload-begin mslot mgen dslot dgen fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control
       fn2-checkpoint-restore-semantic fn2-checkpoint-restore-reach fn2-checkpoint-restore-reach-control fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests)))))
  (fn2-core-preserves fn2-boot-checkpoint-payload-begin (id ogen fn2-core) :position 1 :rows nil)
  (defun fn2-boot-checkpoint-payload-target (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (fn2-boot-checkpoint-payload-bound-p id ogen *fn2-boot-state-checkpoint-payload-load* fn2-core)) (mv :state 0 0 fn2-core)
    (fn2-boot-cold-payload-bind (code offset len) (fn2-checkpoint-payload fn2-checkpoint-restore-reach)
     (fn2-checkpoint-restore-payload-target fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control
      fn2-checkpoint-restore-semantic fn2-checkpoint-restore-reach fn2-checkpoint-restore-reach-control fn2-checkpoint-payload fn2-pool))))
  (fn2-core-preserves fn2-boot-checkpoint-payload-target (id ogen fn2-core) :position 3 :rows nil)
  (defun fn2-boot-checkpoint-payload-loaded (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (b* (((unless (and (fn2-boot-checkpoint-payload-bound-p id ogen *fn2-boot-state-checkpoint-payload-copy* fn2-core)
                      (equal (fn2-machine-event-ready id fn2-core) 1) (equal (fn2-machine-outcome id fn2-core) *fn2-outcome-done*)
                      (equal (fn2-machine-count id fn2-core) (fn2-machine-read-length id fn2-core)))) (mv :state fn2-core))
        (current (fn2-boot-cold-payload-read valid
          (fn2-checkpoint-restore-payload-current-p fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control
           fn2-checkpoint-restore-semantic fn2-checkpoint-restore-reach-control fn2-checkpoint-payload fn2-pool)))
        ((unless current) (mv :source fn2-core))
        (mslot (fn2-machine-pool-slot id fn2-core)) (mgen (fn2-machine-pool-gen id fn2-core))
        (dslot (fn2-machine-rx-slot id fn2-core)) (dgen (fn2-machine-rx-gen id fn2-core))
        (count (fn2-machine-count id fn2-core))
        (manifestp (stobj-let ((fn2-checkpoint-payload (fn2-core-checkpoint-payload fn2-core))) (yes)
          (and (< 0 (fn2-checkpoint-payload-rows fn2-checkpoint-payload))
               (equal (fn2-checkpoint-payload-phase 0 fn2-checkpoint-payload) *fn2-checkpoint-payload-phase-wait-manifest*)) yes))
        ((mv reset fn2-core) (if manifestp (fn2-core-reset mslot mgen fn2-core) (mv :ok fn2-core)))
        ((unless (eq reset :ok)) (mv reset fn2-core))
        ((mv copied fn2-core) (if manifestp (fn2-core-copy-range dslot dgen 0 mslot mgen 0 4096 *fn2-boot-kind* id ogen fn2-core) (mv :ok fn2-core)))
        ((unless (eq copied :ok)) (mv copied fn2-core)))
    (fn2-boot-cold-payload-bind (code) (fn2-checkpoint-payload)
     (fn2-checkpoint-restore-payload-loaded count fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control
      fn2-checkpoint-restore-semantic fn2-checkpoint-restore-reach-control fn2-checkpoint-payload fn2-pool))))
  (fn2-core-preserves fn2-boot-checkpoint-payload-loaded (id ogen fn2-core) :position 1 :rows nil)
  (defun fn2-boot-checkpoint-payload-step (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (fn2-boot-checkpoint-payload-bound-p id ogen *fn2-boot-state-checkpoint-payload-step* fn2-core)) (mv :state fn2-core)
    (fn2-boot-cold-payload-bind (code) (fn2-checkpoint-restore-semantic fn2-checkpoint-payload fn2-checkpoint-restore-reach fn2-fields fn2-b3 fn2-digests)
     (fn2-checkpoint-restore-payload-step 4096 fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control
      fn2-checkpoint-restore-semantic fn2-checkpoint-restore-reach fn2-checkpoint-restore-reach-control fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests))))
  (fn2-core-preserves fn2-boot-checkpoint-payload-step (id ogen fn2-core) :position 1 :rows nil)))

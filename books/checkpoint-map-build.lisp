 (b* (((unless (and (fn2-checkpoint-map-ownerp fn2-checkpoint-map-build fn2-csnapshot fn2-extents)
                     (equal (fn2-checkpoint-map-build-phase 0 fn2-checkpoint-map-build) *fn2-checkpoint-map-build-phase-page*)))
       (mv :state fn2-checkpoint-map-build fn2-checkpoint-page))

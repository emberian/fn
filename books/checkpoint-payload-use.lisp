; Authenticated payload USE is a positive metadata-retirement veto, even if
; an allocation's physical owner belongs to the checkpoint family. This does
; not turn absent use facts into absence-of-readers or retirement authority.
(in-package "ACL2")
(include-book "checkpoint-payload-proof-state")
(include-book "checkpoint-bank-closure-state")
(include-book "checkpoint-geometry")
(fn2-book-layer :b)
(defun fn2-checkpoint-payload-use-capacity-p (fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication fn2-extents)
 :guard (and (fn2-checkpoint-payload-proofsp fn2-checkpoint-payload-proofs) (fn2-checkpoint-payload-proofs-wfp fn2-checkpoint-payload-proofs)
             (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures) (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures)
             (fn2-checkpoint-publicationp fn2-checkpoint-publication) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
             (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents))))
 (and (fn2-checkpoint-payload-proofs-shape-p fn2-checkpoint-payload-proofs fn2-extents)
      (fn2-checkpoint-bank-closures-capacityp fn2-checkpoint-bank-closures)
      (= (fn2-checkpoint-bank-closures-extents fn2-checkpoint-bank-closures) (fn2-extents-rows fn2-extents))
      (= (fn2-checkpoint-bank-closures-rows fn2-checkpoint-bank-closures)
         (* *fn2-checkpoint-anchor-slots* (fn2-extents-rows fn2-extents)))
      (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication))
      (<= 48 (fn2-checkpoint-publication-cold-meta-length fn2-checkpoint-publication))
      (<= 192 (fn2-checkpoint-publication-cold-words-length fn2-checkpoint-publication))))
(defun fn2-checkpoint-cold-payload-use-p (slot e epoch allocation fn2-checkpoint-bank-closures fn2-checkpoint-publication fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-bank-closures fn2-checkpoint-publication fn2-extents) :verify-guards nil :measure (nfix (- *fn2-checkpoint-anchor-slots* (nfix slot)))
 :guard (and (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures) (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures)
             (fn2-checkpoint-publicationp fn2-checkpoint-publication) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
             (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents))))
 (and (natp slot) (< slot *fn2-checkpoint-anchor-slots*) (fn2-alloc-slotp e fn2-extents)
      (= (fn2-checkpoint-bank-closures-extents fn2-checkpoint-bank-closures) (fn2-extents-rows fn2-extents))
  (or (and (fn2-checkpoint-bank-closure-row-p slot e fn2-checkpoint-bank-closures fn2-checkpoint-publication)
           (let ((r (+ (* slot (fn2-extents-rows fn2-extents)) e)))
            (and (= (fn2-checkpoint-bank-closures-present r fn2-checkpoint-bank-closures) 1)
                 (= (fn2-checkpoint-bank-closures-epoch r fn2-checkpoint-bank-closures) epoch)
                 (= (fn2-checkpoint-bank-closures-allocation r fn2-checkpoint-bank-closures) allocation)
                 (not (= (logand (fn2-checkpoint-bank-closures-role-bits r fn2-checkpoint-bank-closures) *fn2-checkpoint-payload-proof-roles*) 0)))))
      (fn2-checkpoint-cold-payload-use-p (+ 1 slot) e epoch allocation fn2-checkpoint-bank-closures fn2-checkpoint-publication fn2-extents))))
(defun fn2-checkpoint-known-payload-use-p (e fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication fn2-extents) :verify-guards nil
 :guard (and (fn2-checkpoint-payload-proofsp fn2-checkpoint-payload-proofs) (fn2-checkpoint-payload-proofs-wfp fn2-checkpoint-payload-proofs)
             (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures) (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures)
             (fn2-checkpoint-publicationp fn2-checkpoint-publication) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
             (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents))))
 (and (fn2-alloc-slotp e fn2-extents)
      (fn2-checkpoint-payload-use-capacity-p fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication fn2-extents)
      (eq (fn2-alloc-handle-code e (fn2-extents-epoch e fn2-extents) (fn2-extents-counter e fn2-extents) fn2-extents) :ok)
      (if (member-equal (fn2-extents-state e fn2-extents) (list *fn2-extent-state-allocated* *fn2-extent-state-retire-pending*)) t nil)
      (or (fn2-checkpoint-payload-proof-p (fn2-extents-owner-kind e fn2-extents) e (fn2-extents-epoch e fn2-extents) (fn2-extents-counter e fn2-extents) fn2-checkpoint-payload-proofs fn2-extents)
          (fn2-checkpoint-cold-payload-use-p 0 e (fn2-extents-epoch e fn2-extents) (fn2-extents-counter e fn2-extents) fn2-checkpoint-bank-closures fn2-checkpoint-publication fn2-extents))))

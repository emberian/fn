; CTL callbacks expanded after the concrete core and per-CTL format-row map.
(in-package "ACL2")
(include-book "fnct-stream")
(defmacro fn2-ctl-stream-events ()
 '(progn
  (defun fn2-ctl-stream-live-p (ctl gen request fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                   :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
   (and (eq (fn2-ctl-snapshot-read-code ctl fn2-core) :ok)
        (equal (fn2-machine-generation ctl fn2-core) gen)
        (equal (fn2-ctl-row-request ctl fn2-core) request)))

  (defun fn2-ctl-stream-child-live-p (child gen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                   :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
   (and (eq (fn2-cns-snapshot-read-code child fn2-core) :ok)
        (equal (fn2-machine-generation child fn2-core) gen)
        (not (member-equal (fn2-cns-row-phase child fn2-core)
                    (list *fn2-cns-state-free* *fn2-cns-state-retired*)))))

  (defun fn2-ctl-stream-metadata (ctl gen request fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                   :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
   (if (not (fn2-ctl-stream-live-p ctl gen request fn2-core)) (mv :stale 0 0)
    (if (equal (fn2-ctl-row-sphase ctl fn2-core) *fn2-ctl-stream-none*) (mv :none 0 0)
     (mv :ok (fn2-ctl-row-sop ctl fn2-core) (fn2-ctl-row-slength ctl fn2-core)))))

  (defun fn2-ctl-stream-window (ctl gen request fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                   :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
   (cond ((not (fn2-ctl-stream-live-p ctl gen request fn2-core)) (mv :stale 0 0 0 0 nil 0))
         ((or (member-equal (fn2-ctl-row-phase ctl fn2-core)
                    (list *fn2-ctl-state-closing* *fn2-ctl-state-draining* *fn2-ctl-state-retired*))
              (equal (fn2-ctl-row-sphase ctl fn2-core) *fn2-ctl-stream-bad*))
          (mv :bad 0 0 0 0 nil 0))
         ((equal (fn2-ctl-row-sphase ctl fn2-core) *fn2-ctl-stream-verified*)
          (mv :ok (fn2-ctl-row-rx-slot ctl fn2-core) (fn2-ctl-row-rx-gen ctl fn2-core) 0 0 t (fn2-ctl-row-swindow ctl fn2-core)))
         ((and (equal (fn2-ctl-row-sphase ctl fn2-core) *fn2-ctl-stream-feed*)
               (equal (fn2-ctl-row-sack ctl fn2-core) 0))
          (mv :ok (fn2-ctl-row-rx-slot ctl fn2-core) (fn2-ctl-row-rx-gen ctl fn2-core)
                  (fn2-ctl-row-sstart ctl fn2-core) (fn2-ctl-row-send ctl fn2-core) nil (fn2-ctl-row-swindow ctl fn2-core)))
         (t (mv :wait 0 0 0 0 nil 0))))

  (defun fn2-ctl-stream-consumed (ctl gen request seq end fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                   :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
   (if (not (and (fn2-ctl-stream-live-p ctl gen request fn2-core)
                 (equal (fn2-ctl-row-sphase ctl fn2-core) *fn2-ctl-stream-feed*)
                 (equal seq (fn2-ctl-row-swindow ctl fn2-core))
                 (equal end (fn2-ctl-row-send ctl fn2-core))
                 (equal (fn2-ctl-row-sack ctl fn2-core) 0)))
       (mv :stale fn2-core)
    (let ((fn2-core (fn2-core-scheduler-wake ctl fn2-core)))
     (if (fn2-core-stopped-p fn2-core) (mv :stale fn2-core)
      (let* ((fn2-core (fn2-core-record-enqueue ctl fn2-core))
             (fn2-core (fn2-machine-write-sack ctl 1 fn2-core)))
       (mv :ok fn2-core))))))
  (fn2-core-preserves fn2-ctl-stream-consumed (ctl gen request seq end fn2-core) :position 1 :rows nil)

  (defun fn2-ctl-receive-cap (ctl gen slot sgen fill fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                   :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
   (mv-let (rc row) (fn2-ctl-fc-row ctl fn2-core)
    (if (not (eq rc :ok)) (mv :bounds 0 fn2-core)
     (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
      (code cap fn2-fields)
      (b* ((capacity (min *fn2-ctl-io-bytes* (fn2-fnct-cap slot fn2-pool)))
           ((unless (and (natp fill) (equal fill (fn2-pool-fill-value slot fn2-pool))
                         (< fill capacity))) (mv :bounds 0 fn2-fields))
           ((when (< fill *fn2-fnct-header-octets*))
            (mv :ok (min (- *fn2-fnct-header-octets* fill) (- capacity fill)) fn2-fields))
           ((mv hc kind plen fn2-fields)
            (fn2-fnct-stream-head (* 128 row) slot sgen *fn2-ctl-kind* ctl gen fn2-fields fn2-pool))
           ((unless (and (eq hc :ok) (natp kind) (natp plen))) (mv :frame 0 fn2-fields))
           (total (+ *fn2-fnct-header-octets* plen *fn2-fnct-trailer-octets*)))
       (if (<= total fill) (mv :bounds 0 fn2-fields)
        (mv :ok (min (- capacity fill) (- total fill)) fn2-fields)))
      (mv code cap fn2-core)))))
  (fn2-core-preserves fn2-ctl-receive-cap
   (ctl gen slot sgen fill fn2-core) :position 2 :rows nil)

  (defun fn2-ctl-stream-begin (ctl gen slot sgen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                   :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
   (mv-let (rc row) (fn2-ctl-fc-row ctl fn2-core)
    (if (not (eq rc :ok)) (mv :bounds 0 0 0 0 fn2-core)
     (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-digests (fn2-core-digests fn2-core))
                 (fn2-b3 (fn2-core-b3 fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
      (code op length start remaining fn2-fields fn2-digests fn2-b3)
      (b* (((mv hc kind plen fn2-fields)
            (fn2-fnct-stream-head (* 128 row) slot sgen *fn2-ctl-kind* ctl gen fn2-fields fn2-pool))
           ((unless (and (eq hc :ok) (equal kind *fn2-fnct-request-kind*)))
            (mv :frame 0 0 0 0 fn2-fields fn2-digests fn2-b3))
           ((unless (<= (+ (* 128 row) 128) (fn2-fields-rows fn2-fields)))
            (mv :bounds 0 0 0 0 fn2-fields fn2-digests fn2-b3))
           ((mv pc op length start fn2-fields)
            (fn2-cns-append-prefix (* 128 row) slot sgen *fn2-fnct-header-octets*
              (fn2-pool-fill-value slot fn2-pool) *fn2-ctl-kind* ctl gen fn2-fields fn2-pool))
           ((unless (eq pc :ok)) (mv pc 0 0 0 0 fn2-fields fn2-digests fn2-b3))
           ((unless (and (unsigned-byte-p 60 op) (unsigned-byte-p 32 length)
                         (unsigned-byte-p 32 start) (<= *fn2-fnct-header-octets* start)
                         (equal (+ start length) (+ *fn2-fnct-header-octets* plen))))
            (mv :frame 0 0 0 0 fn2-fields fn2-digests fn2-b3))
           ((mv sc fn2-digests fn2-b3) (fn2-fnct-stream-start row fn2-digests fn2-b3)))
       (mv sc op length start (+ *fn2-fnct-header-octets* plen) fn2-fields fn2-digests fn2-b3))
      (mv code op length start remaining fn2-core)))))
  (fn2-core-preserves fn2-ctl-stream-begin (ctl gen slot sgen fn2-core) :position 5 :rows nil)

  (defun fn2-ctl-stream-hash (ctl gen slot sgen off count final fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                   :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
   (mv-let (rc row) (fn2-ctl-fc-row ctl fn2-core)
    (if (not (eq rc :ok)) (mv :bounds 0 fn2-core)
     (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-b3 (fn2-core-b3 fn2-core))
                 (fn2-pool (fn2-core-pool fn2-core)))
      (code count fn2-digests fn2-b3)
      (mv-let (hc copied fn2-digests fn2-b3)
       (fn2-fnct-stream-update row slot sgen off count *fn2-ctl-kind* ctl gen fn2-digests fn2-b3 fn2-pool)
       (if (and (eq hc :ok) (equal copied count) final)
           (mv-let (fc fn2-digests fn2-b3) (fn2-fnct-stream-finish row fn2-digests fn2-b3)
            (mv fc copied fn2-digests fn2-b3))
         (mv hc copied fn2-digests fn2-b3)))
      (mv code count fn2-core)))))
  (fn2-core-preserves fn2-ctl-stream-hash (ctl gen slot sgen off count final fn2-core) :position 2 :rows nil)

  (defun fn2-ctl-stream-trailer (ctl gen index slot sgen off end fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                   :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
   (mv-let (rc row) (fn2-ctl-fc-row ctl fn2-core)
    (if (not (eq rc :ok)) (mv :bounds 0)
     (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
      (code count)
      (fn2-fnct-stream-trailer row index slot sgen off end *fn2-ctl-kind* ctl gen fn2-digests fn2-pool)
      (mv code count)))))
 ))

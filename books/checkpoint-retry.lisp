; Refusal fingerprint is a wake hint, never reservation or admission authority.
; Capture only through the composing master's post-cleanup operation.
(in-package "ACL2")
(include-book "commit-directory")
(include-book "checkpoint-metadata-resources")
(fn2-book-layer :c)

(defconst *fn2-checkpoint-retry-pool* 1)
(defconst *fn2-checkpoint-retry-directory* 2)
(defconst *fn2-checkpoint-retry-physical* 3)

(defcolumns fn2-checkpoint-retry
 ((valid :bool) (owner-kind :u8) (owner-slot :u32) (owner-gen :u60) (reason :u8)
  (cut-commit :u60) (cut-event :u60) (source-published :u60) (source-sealed :u60)
  (proposed :u60) (installed :u60) (published :u60) (first-key :u60)
  (base-batch :u60) (base-event :u60) (base-ready :bool) (directory-available :u60)
  (epoch :u60) (counter :u60) (free-head :u32) (free-count :u60) (retirement :u60)
  (pool-classes :u8)))
(defcolumns fn2-checkpoint-retry-classes ((free :u32)))
(defcorechild fn2-core-checkpoint-retry fn2-checkpoint-retry
 :init (fn2-checkpoint-retry-init 1 fn2-checkpoint-retry) :profilep t
 :why "Last exact post-cleanup refusal stamp suppresses identical maintenance retries without discharging debt.")
(defcorechild fn2-core-checkpoint-retry-classes fn2-checkpoint-retry-classes
 :init (fn2-checkpoint-retry-classes-init (len (fn2-profile-pool-classes profile)) fn2-checkpoint-retry-classes)
 :profilep (fn2-pool-profilep (fn2-profile-pool-classes profile))
 :why "Actual declared pool class geometry determines the refusal vector; no independent class cap.")

(defun fn2-checkpoint-retry-copy-classes (n i fn2-checkpoint-retry-classes fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-retry-classes fn2-pool) :measure (nfix n)
  :guard (and (fn2-checkpoint-retry-classes-wfp fn2-checkpoint-retry-classes) (fn2-pool-wfp fn2-pool))))
 (cond ((zp n) (mv :ok fn2-checkpoint-retry-classes))
       ((not (and (natp i) (< i (fn2-pool-nclasses fn2-pool)) (< i (fn2-checkpoint-retry-classes-rows fn2-checkpoint-retry-classes))))
        (mv :bounds fn2-checkpoint-retry-classes))
       (t (let ((fn2-checkpoint-retry-classes (fn2-checkpoint-retry-classes-set-free i (fn2-pool-free-count i fn2-pool) fn2-checkpoint-retry-classes)))
           (fn2-checkpoint-retry-copy-classes (- n 1) (+ i 1) fn2-checkpoint-retry-classes fn2-pool)))))
(defun fn2-checkpoint-retry-same-classes (n i fn2-checkpoint-retry-classes fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-retry-classes fn2-pool) :measure (nfix n)
  :guard (and (fn2-checkpoint-retry-classes-wfp fn2-checkpoint-retry-classes) (fn2-pool-wfp fn2-pool))))
 (or (zp n)
     (and (natp i) (< i (fn2-pool-nclasses fn2-pool)) (< i (fn2-checkpoint-retry-classes-rows fn2-checkpoint-retry-classes))
          (equal (fn2-checkpoint-retry-classes-free i fn2-checkpoint-retry-classes) (fn2-pool-free-count i fn2-pool))
          (fn2-checkpoint-retry-same-classes (- n 1) (+ i 1) fn2-checkpoint-retry-classes fn2-pool))))

(defun fn2-checkpoint-retry-record (kind owner gen reason fn2-checkpoint-retry fn2-checkpoint-retry-classes fn2-csnapshot fn2-id-engine fn2-seals fn2-extents fn2-commit-root fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-retry fn2-checkpoint-retry-classes fn2-csnapshot fn2-id-engine fn2-seals fn2-extents fn2-commit-root fn2-pool)
  :guard (and (fn2-checkpoint-retry-wfp fn2-checkpoint-retry) (fn2-checkpoint-retry-classes-wfp fn2-checkpoint-retry-classes)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-id-engine-wfp fn2-id-engine) (fn2-seals-wfp fn2-seals)
              (fn2-extents-wfp fn2-extents) (fn2-commit-root-wfp fn2-commit-root) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (unsigned-byte-p 8 kind) (unsigned-byte-p 32 owner) (posp gen) (unsigned-byte-p 60 gen)
                    (posp reason) (unsigned-byte-p 8 reason) (< 0 (fn2-checkpoint-retry-rows fn2-checkpoint-retry))
                    (< 0 (fn2-csnapshot-rows fn2-csnapshot)) (< 0 (fn2-id-engine-rows fn2-id-engine)) (< 0 (fn2-seals-rows fn2-seals))
                    (< 0 (fn2-commit-root-rows fn2-commit-root))
                    (equal (fn2-checkpoint-retry-classes-rows fn2-checkpoint-retry-classes) (fn2-pool-nclasses fn2-pool))))
       (mv :bounds fn2-checkpoint-retry fn2-checkpoint-retry-classes))
      ((mv base-code base-batch base-event base-ready) (fn2-commit-directory-base-state fn2-commit-root))
      ((mv directory available) (fn2-commit-directory-headroom 0 fn2-commit-root))
      ((unless (and (eq base-code :ok) (eq directory :ok))) (mv :directory-state fn2-checkpoint-retry fn2-checkpoint-retry-classes))
      ((mv code fn2-checkpoint-retry-classes) (fn2-checkpoint-retry-copy-classes (fn2-pool-nclasses fn2-pool) 0 fn2-checkpoint-retry-classes fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-checkpoint-retry fn2-checkpoint-retry-classes))
      (fn2-checkpoint-retry (fn2-checkpoint-retry-put 0 (valid 1) (owner-kind kind) (owner-slot owner) (owner-gen gen) (reason reason)
       (cut-commit (fn2-csnapshot-cut-commit 0 fn2-csnapshot)) (cut-event (fn2-csnapshot-cut-event 0 fn2-csnapshot))
       (source-published (fn2-id-engine-published 0 fn2-id-engine)) (source-sealed (fn2-seals-published-source 0 fn2-seals))
       (proposed (fn2-commit-root-proposed 0 fn2-commit-root)) (installed (fn2-commit-root-installed 0 fn2-commit-root))
       (published (fn2-commit-root-published 0 fn2-commit-root)) (first-key (fn2-commit-root-first-key 0 fn2-commit-root))
       (base-batch base-batch) (base-event base-event) (base-ready base-ready) (directory-available available)
       (epoch (fn2-alloc-current-epoch fn2-extents)) (counter (fn2-alloc-next-counter fn2-extents))
       (free-head (fn2-alloc-free-head fn2-extents)) (free-count (fn2-alloc-total-free fn2-extents))
       (retirement (fn2-alloc-last-retirement fn2-extents)) (pool-classes (fn2-pool-nclasses fn2-pool)))))
  (mv :ok fn2-checkpoint-retry fn2-checkpoint-retry-classes)))

(defun fn2-checkpoint-retry-samep (kind owner gen fn2-checkpoint-retry fn2-checkpoint-retry-classes fn2-csnapshot fn2-id-engine fn2-seals fn2-extents fn2-commit-root fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-retry fn2-checkpoint-retry-classes fn2-csnapshot fn2-id-engine fn2-seals fn2-extents fn2-commit-root fn2-pool)
  :guard (and (fn2-checkpoint-retry-wfp fn2-checkpoint-retry) (fn2-checkpoint-retry-classes-wfp fn2-checkpoint-retry-classes)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-id-engine-wfp fn2-id-engine) (fn2-seals-wfp fn2-seals)
              (fn2-extents-wfp fn2-extents) (fn2-commit-root-wfp fn2-commit-root) (fn2-pool-wfp fn2-pool))))
 (and (< 0 (fn2-checkpoint-retry-rows fn2-checkpoint-retry)) (< 0 (fn2-csnapshot-rows fn2-csnapshot))
      (< 0 (fn2-id-engine-rows fn2-id-engine)) (< 0 (fn2-seals-rows fn2-seals)) (< 0 (fn2-commit-root-rows fn2-commit-root))
      (equal (fn2-checkpoint-retry-valid 0 fn2-checkpoint-retry) 1)
      (equal kind (fn2-checkpoint-retry-owner-kind 0 fn2-checkpoint-retry)) (equal owner (fn2-checkpoint-retry-owner-slot 0 fn2-checkpoint-retry))
      (equal gen (fn2-checkpoint-retry-owner-gen 0 fn2-checkpoint-retry))
      (equal (fn2-csnapshot-cut-commit 0 fn2-csnapshot) (fn2-checkpoint-retry-cut-commit 0 fn2-checkpoint-retry))
      (equal (fn2-csnapshot-cut-event 0 fn2-csnapshot) (fn2-checkpoint-retry-cut-event 0 fn2-checkpoint-retry))
      (equal (fn2-id-engine-published 0 fn2-id-engine) (fn2-checkpoint-retry-source-published 0 fn2-checkpoint-retry))
      (equal (fn2-seals-published-source 0 fn2-seals) (fn2-checkpoint-retry-source-sealed 0 fn2-checkpoint-retry))
      (equal (fn2-commit-root-proposed 0 fn2-commit-root) (fn2-checkpoint-retry-proposed 0 fn2-checkpoint-retry))
      (equal (fn2-commit-root-installed 0 fn2-commit-root) (fn2-checkpoint-retry-installed 0 fn2-checkpoint-retry))
      (equal (fn2-commit-root-published 0 fn2-commit-root) (fn2-checkpoint-retry-published 0 fn2-checkpoint-retry))
      (equal (fn2-commit-root-first-key 0 fn2-commit-root) (fn2-checkpoint-retry-first-key 0 fn2-checkpoint-retry))
      (mv-let (status base-batch base-event base-ready) (fn2-commit-directory-base-state fn2-commit-root)
       (and (eq status :ok) (equal base-batch (fn2-checkpoint-retry-base-batch 0 fn2-checkpoint-retry))
            (equal base-event (fn2-checkpoint-retry-base-event 0 fn2-checkpoint-retry)) (equal base-ready (fn2-checkpoint-retry-base-ready 0 fn2-checkpoint-retry))))
      (mv-let (status available) (fn2-commit-directory-headroom 0 fn2-commit-root)
       (and (eq status :ok) (equal available (fn2-checkpoint-retry-directory-available 0 fn2-checkpoint-retry))))
      (equal (fn2-alloc-current-epoch fn2-extents) (fn2-checkpoint-retry-epoch 0 fn2-checkpoint-retry))
      (equal (fn2-alloc-next-counter fn2-extents) (fn2-checkpoint-retry-counter 0 fn2-checkpoint-retry))
      (equal (fn2-alloc-free-head fn2-extents) (fn2-checkpoint-retry-free-head 0 fn2-checkpoint-retry))
      (equal (fn2-alloc-total-free fn2-extents) (fn2-checkpoint-retry-free-count 0 fn2-checkpoint-retry))
      (equal (fn2-alloc-last-retirement fn2-extents) (fn2-checkpoint-retry-retirement 0 fn2-checkpoint-retry))
      (or (not (equal (fn2-checkpoint-retry-reason 0 fn2-checkpoint-retry) *fn2-checkpoint-retry-pool*))
          (and (equal (fn2-pool-nclasses fn2-pool) (fn2-checkpoint-retry-pool-classes 0 fn2-checkpoint-retry))
               (equal (fn2-checkpoint-retry-classes-rows fn2-checkpoint-retry-classes) (fn2-pool-nclasses fn2-pool))
               (fn2-checkpoint-retry-same-classes (fn2-pool-nclasses fn2-pool) 0 fn2-checkpoint-retry-classes fn2-pool)))))
(fn2-checkpoint-retry-classes-preserves fn2-checkpoint-retry-copy-classes (n i fn2-checkpoint-retry-classes fn2-pool) :position 1)
(fn2-checkpoint-retry-preserves fn2-checkpoint-retry-record
 (kind owner gen reason fn2-checkpoint-retry fn2-checkpoint-retry-classes fn2-csnapshot fn2-id-engine fn2-seals fn2-extents fn2-commit-root fn2-pool)
 :carriers ((fn2-checkpoint-retry 1 :prefix "-RETRY") (fn2-checkpoint-retry-classes 2 :prefix "-CLASSES")))

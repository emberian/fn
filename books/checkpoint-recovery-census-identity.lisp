; Actual readonly identity predicates, independent of boot orchestration.
(in-package "ACL2")
(include-book "origin")
(include-book "boot-config-state")
(include-book "checkpoint-recovery-census-state")
(include-book "checkpoint-recovery-evidence-state")
(fn2-book-layer :b)

(defun fn2-checkpoint-recovery-census-anchor-bytes-p (left anchor evidence fn2-boot-config fn2-checkpoint-recovery-evidence)
 (declare (xargs :stobjs (fn2-boot-config fn2-checkpoint-recovery-evidence) :measure (nfix left)
  :guard (and (fn2-boot-config-wfp fn2-boot-config) (fn2-checkpoint-recovery-evidence-wfp fn2-checkpoint-recovery-evidence)
              (natp left) (<= left 96) (natp anchor) (<= (+ anchor left) 384)
              (natp evidence) (<= (+ evidence left) 896))))
 (if (zp left) t
  (and (= (fn2-boot-config-anchor-evidencei anchor fn2-boot-config)
          (fn2-checkpoint-recovery-evidence-bytesi evidence fn2-checkpoint-recovery-evidence))
       (fn2-checkpoint-recovery-census-anchor-bytes-p (- left 1) (+ anchor 1) (+ evidence 1) fn2-boot-config fn2-checkpoint-recovery-evidence))))

(defun fn2-checkpoint-recovery-census-descriptor-bytes-p (left source evidence fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)
 (declare (xargs :stobjs (fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence) :measure (nfix left)
  :guard (and (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-checkpoint-recovery-evidence-wfp fn2-checkpoint-recovery-evidence)
              (natp left) (<= left 32) (natp source) (<= (+ source left) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes))
              (natp evidence) (<= (+ evidence left) 896))))
 (if (zp left) t
  (and (= (fn2-checkpoint-bytes-value source fn2-checkpoint-bytes)
          (fn2-checkpoint-recovery-evidence-bytesi evidence fn2-checkpoint-recovery-evidence))
       (fn2-checkpoint-recovery-census-descriptor-bytes-p (- left 1) (+ source 1) (+ evidence 1) fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence))))

(defun fn2-checkpoint-recovery-census-bound-p (c fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence)
 (declare (xargs :stobjs (fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence)
  :guard (and (fn2-boot-config-wfp fn2-boot-config) (fn2-checkpoints-wfp fn2-checkpoints)
              (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
              (fn2-checkpoint-recovery-evidence-wfp fn2-checkpoint-recovery-evidence) (fn2-origin-wfp fn2-origin))))
 (and (fn2-origin-physicalp (fn2-origin-history fn2-origin) (fn2-origin-history-incarnation fn2-origin))
      (fn2-checkpoint-recovery-census-slotp c)
      (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
      (fn2-checkpoint-recovery-evidence-ready-p c fn2-checkpoint-recovery-evidence)
      (fn2-checkpoint-recovery-census-memberp c (fn2-boot-config-anchor-checked-mask fn2-boot-config))
      (fn2-checkpoint-recovery-census-memberp c (fn2-boot-config-map-fifo-mask fn2-boot-config))
      (fn2-checkpoint-recovery-census-memberp c (fn2-boot-config-arena-mask fn2-boot-config))
      (let ((r (* 6 c)) (e (+ 1 c)) (at (+ 256 (* 160 c))))
       (and (= (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-checked*)
            (= (fn2-checkpoints-builder-token c fn2-checkpoints) 0)
            (posp (fn2-checkpoints-checkpoint c fn2-checkpoints))
            (= (fn2-checkpoints-anchor-mask c fn2-checkpoints) (fn2-checkpoint-recovery-census-bit c))
            (= (fn2-checkpoints-bank c fn2-checkpoints) (floor c 2))
            (= (fn2-checkpoints-history c fn2-checkpoints) (fn2-origin-history fn2-origin)) (= (fn2-checkpoints-incarnation c fn2-checkpoints) (fn2-origin-history-incarnation fn2-origin))
            (= (fn2-checkpoints-checkpoint c fn2-checkpoints) (fn2-checkpoint-recovery-evidence-checkpoint e fn2-checkpoint-recovery-evidence))
            (= (fn2-checkpoints-cut-commit c fn2-checkpoints) (fn2-checkpoint-recovery-evidence-cut-commit e fn2-checkpoint-recovery-evidence))
            (= (fn2-checkpoints-cut-event c fn2-checkpoints) (fn2-checkpoint-recovery-evidence-cut-event e fn2-checkpoint-recovery-evidence))
            (< (fn2-checkpoints-cut-commit c fn2-checkpoints) (fn2-checkpoint-recovery-evidence-commit e fn2-checkpoint-recovery-evidence))
            (< (fn2-checkpoints-cut-event c fn2-checkpoints) (fn2-checkpoint-recovery-evidence-event e fn2-checkpoint-recovery-evidence))
            (posp (fn2-checkpoint-recovery-evidence-first e fn2-checkpoint-recovery-evidence))
            (<= (fn2-checkpoint-recovery-evidence-first e fn2-checkpoint-recovery-evidence) (fn2-checkpoint-recovery-evidence-event e fn2-checkpoint-recovery-evidence))
            (<= (fn2-checkpoint-recovery-evidence-event e fn2-checkpoint-recovery-evidence) (fn2-checkpoint-recovery-evidence-last e fn2-checkpoint-recovery-evidence))
            (= (fn2-checkpoint-refs-storage-domain r fn2-checkpoint-refs) 0)
            (= (fn2-checkpoint-refs-page-kind r fn2-checkpoint-refs) *page-kind-checkpoint-descriptor*)
            (= (fn2-checkpoint-refs-encoded-length r fn2-checkpoint-refs) *fn2-format-sector-size*)
            (= (fn2-checkpoint-refs-storage-domain r fn2-checkpoint-refs) (fn2-checkpoint-recovery-evidence-descriptor-domain e fn2-checkpoint-recovery-evidence))
            (= (fn2-checkpoint-refs-physical-unit r fn2-checkpoint-refs) (fn2-checkpoint-recovery-evidence-descriptor-unit e fn2-checkpoint-recovery-evidence))
            (= (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs) (fn2-checkpoint-recovery-evidence-descriptor-epoch e fn2-checkpoint-recovery-evidence))
            (= (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs) (fn2-checkpoint-recovery-evidence-descriptor-allocation e fn2-checkpoint-recovery-evidence))
            (= (fn2-checkpoint-refs-page-kind r fn2-checkpoint-refs) (fn2-checkpoint-recovery-evidence-descriptor-kind e fn2-checkpoint-recovery-evidence))
            (= (fn2-checkpoint-refs-encoded-length r fn2-checkpoint-refs) (fn2-checkpoint-recovery-evidence-descriptor-length e fn2-checkpoint-recovery-evidence))
            (fn2-checkpoint-recovery-census-anchor-bytes-p 96 (* 96 c) at fn2-boot-config fn2-checkpoint-recovery-evidence)
            (fn2-checkpoint-recovery-census-descriptor-bytes-p 32 (* 32 r) (+ at 96) fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)))))

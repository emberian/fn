; Materialize the registered core and its bounded transitions.
(in-package "ACL2")
(include-book "assembly-index")
(fn2-core-events)

;; ---------------------------------------------------------------------------
;; FN2-CORE-POOL-WRITE-FRAME: a pool write through one row never changes
;; another row's carved extent. The core's octet writers are a machine's
;; write, range copy and compaction (fn2-core-write, -copy-range,
;; -drop-prefix) and the host's loan write (fn2-pool-adapter-write on the
;; core's pool); each writes only inside the row it names (the destination of
;; a copy). From FN2-POOL-CONSERVATION's invariant: carved extents are
;; disjoint (fn2-pool-extents-apart).
(defconst *fn2-core-pool-writers* '(:write :copy-range :drop-prefix :loan-write))
(defun fn2-core-pool-write-step (op a fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (case op
    (:write (mv-let (code fn2-core)
              (fn2-core-write (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) (nth 4 a) (nth 5 a) (nth 6 a) fn2-core)
              (declare (ignore code)) fn2-core))
    (:copy-range (mv-let (code fn2-core)
                   (fn2-core-copy-range (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) (nth 4 a) (nth 5 a)
                                        (nth 6 a) (nth 7 a) (nth 8 a) (nth 9 a) fn2-core)
                   (declare (ignore code)) fn2-core))
    (:drop-prefix (mv-let (code next fn2-core)
                    (fn2-core-drop-prefix (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) (nth 4 a) (nth 5 a)
                                          (nth 6 a) (nth 7 a) fn2-core)
                    (declare (ignore code next)) fn2-core))
    (:loan-write (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
                   (code fn2-pool)
                   (fn2-pool-adapter-write (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) (nth 4 a) (nth 5 a) fn2-pool)
                   (let ((ignored code)) (declare (ignore ignored)) fn2-core)))
    (otherwise fn2-core)))
(defun fn2-core-pool-write-row (op a)
  (declare (xargs :verify-guards nil))
  (if (eq op :copy-range) (nth 3 a) (nth 0 a)))
(defun fn2-core-pool-semanticp (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (ok) (fn2-pool-semanticp fn2-pool) ok))
(defun fn2-core-pool-rows (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (n) (fn2-pool-rows fn2-pool) n))
; The octets of pool row SLOT's carved extent.
(defun fn2-core-pool-extent (slot fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (octets)
    (if (and (natp slot) (< slot (fn2-pool-rows fn2-pool)))
        (fn2-pool-logical-octets (fn2-pool-cap slot fn2-pool) (fn2-pool-base slot fn2-pool) fn2-pool)
      nil)
    octets))
(defun fn2-core-pool-frame-hyps (other op a fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (and (member-eq op *fn2-core-pool-writers*) (fn2-core-pool-semanticp fn2-core)
       (natp other) (< other (fn2-core-pool-rows fn2-core))
       (not (equal other (fn2-core-pool-write-row op a)))))
(defun fn2-core-pool-frame-resultp (before after) (equal before after))
(defun-nx fn2-core-pool-frame-conclusion (other op a fn2-core)
  (fn2-core-pool-frame-resultp (fn2-core-pool-extent other fn2-core)
                               (fn2-core-pool-extent other (fn2-core-pool-write-step op a fn2-core))))
(defthm-owed fn2-core-pool-write-frame (other op a fn2-core)
  (implies (fn2-core-pool-frame-hyps other op a fn2-core)
           (fn2-core-pool-frame-conclusion other op a fn2-core))
  :schema :invariant :from (:columns fn2-pool)
  :teeth (fn2-core-pool-frame-teeth)
  :doc "A pool write through one row (a machine's write, range copy or compaction, or the host's loan write) never changes another row's carved extent: under the pool invariant extents are disjoint.")

(encapsulate ()
(local
 (defthm fn2-core-pool-of-write-step
   (equal (fn2-core-pool (fn2-core-pool-write-step op a fn2-core))
          (case op
            (:write (mv-nth 1 (fn2-pool-write (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) (nth 4 a) (nth 5 a)
                                              (nth 6 a) (fn2-core-pool fn2-core))))
            (:copy-range (mv-nth 1 (fn2-pool-copy-range (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) (nth 4 a)
                                                        (nth 5 a) (nth 6 a) (nth 7 a) (nth 8 a) (nth 9 a)
                                                        (fn2-core-pool fn2-core))))
            (:drop-prefix (mv-nth 2 (fn2-pool-drop-prefix (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) (nth 4 a)
                                                          (nth 5 a) (nth 6 a) (nth 7 a)
                                                          (fn2-core-pool fn2-core))))
            (:loan-write (mv-nth 1 (fn2-pool-adapter-write (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) (nth 4 a)
                                                           (nth 5 a) (fn2-core-pool fn2-core))))
            (otherwise (fn2-core-pool fn2-core))))
   :hints (("Goal" :in-theory (enable fn2-core-write fn2-core-copy-range fn2-core-drop-prefix)))))
(defthm fn2-core-pool-write-frame-proved
  (implies (fn2-core-pool-frame-hyps other op a fn2-core)
           (fn2-core-pool-frame-conclusion other op a fn2-core))
  :hints (("Goal" :in-theory (disable fn2-core-pool-write-step fn2-pool-semanticp fn2-pool-logical-octets fn2-pool-cap fn2-pool-base fn2-pool-rows
                                      fn2-pool-write fn2-pool-adapter-write fn2-pool-copy-range
                                      fn2-pool-drop-prefix)
           :use ((:instance fn2-pool-write-other-extent (fn2-pool (fn2-core-pool fn2-core))
                            (slot (nth 0 a)) (gen (nth 1 a)) (idx (nth 2 a)) (byte (nth 3 a))
                            (okind (nth 4 a)) (oslot (nth 5 a)) (ogen (nth 6 a)))
                 (:instance fn2-pool-adapter-write-other-extent (fn2-pool (fn2-core-pool fn2-core))
                            (slot (nth 0 a)) (gen (nth 1 a)) (opslot (nth 2 a)) (opgen (nth 3 a))
                            (idx (nth 4 a)) (byte (nth 5 a)))
                 (:instance fn2-pool-copy-range-other-extent (fn2-pool (fn2-core-pool fn2-core))
                            (src (nth 0 a)) (sgen (nth 1 a)) (soff (nth 2 a)) (dst (nth 3 a))
                            (dgen (nth 4 a)) (doff (nth 5 a)) (len (nth 6 a)) (okind (nth 7 a))
                            (oslot (nth 8 a)) (ogen (nth 9 a)))
                 (:instance fn2-pool-drop-prefix-other-extent (fn2-pool (fn2-core-pool fn2-core))
                            (slot (nth 0 a)) (gen (nth 1 a)) (k (nth 2 a)) (cursor (nth 3 a))
                            (limit (nth 4 a)) (okind (nth 5 a)) (oslot (nth 6 a)) (ogen (nth 7 a)))))))
(defthm fn2-core-pool-write-frame-statement
  (fn2-core-pool-write-frame$owed other op a fn2-core)
  :hints (("Goal" :in-theory '(fn2-core-pool-write-frame$owed) :use fn2-core-pool-write-frame-proved))))
(fn2-owed-discharge fn2-core-pool-write-frame fn2-core-pool-write-frame-statement)

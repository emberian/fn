; Checkpoint extension of the one ordinary lifecycle generator.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "retirement-coordinator")
(include-book "checkpoint-allocation-coordinator")
(include-book "checkpoint-installation-coordinator")
(include-book "checkpoint-maintenance-staging")
(defun fn2-checkpoint-retirement-adapter ()
 '(
  (fn2-retirement-adapter-prelude . (fn2-checkpoint-maintenance-staging-events))
  (fn2-retirement-adapter-release . (fn2-checkpoint-lifecycle-release slot gen okind oslot ogen fn2-core))
  (fn2-retirement-adapter-record-match . (fn2-checkpoint-staging-match-p slot gen okind oslot ogen fn2-core))
  (fn2-retirement-adapter-installation . (fn2-checkpoint-installation-install-member base slot gen off next bytes len batch event okind oslot ogen fn2-core))
  (fn2-retirement-adapter-release-allocation . (fn2-allocation-release-install-member base slot gen off next bytes len batch event okind oslot ogen fn2-core))
  (fn2-retirement-adapter-allocation . (fn2-checkpoint-allocation-install-member base slot gen off next bytes len batch event okind oslot ogen fn2-core))
  (fn2-retirement-adapter-install-prefix . (progn
 (defun fn2-checkpoint-allocation-install-member (base slot gen off next bytes len batch event okind oslot ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core))
              (fn2-extents (fn2-core-extents fn2-core))
              (fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core))
              (fn2-retirement-control (fn2-core-retirement-control fn2-core)))
   (code fn2-fields fn2-extents fn2-retirement-control)
   (b* (((unless (and (natp base) (<= (+ base *fn2-format-allocation-num-fields*) (fn2-fields-rows fn2-fields))
                      (natp bytes) (unsigned-byte-p 32 next) (unsigned-byte-p 32 (+ next bytes))
                      (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen)
                      (unsigned-byte-p 8 okind) (unsigned-byte-p 32 oslot) (unsigned-byte-p 60 ogen)
                      (< 0 (fn2-retirement-control-rows fn2-retirement-control))
                      (= (fn2-retirement-control-state 0 fn2-retirement-control) *fn2-retirement-state-waiting*)
                      (= (fn2-retirement-control-allocation-member 0 fn2-retirement-control) 1)
                      (= (fn2-retirement-control-token 0 fn2-retirement-control) (fn2-alloc-freeze-token fn2-extents))
                      (equal slot (fn2-retirement-control-slot 0 fn2-retirement-control))
                      (equal gen (fn2-retirement-control-gen 0 fn2-retirement-control))
                      (equal batch (fn2-retirement-control-batch 0 fn2-retirement-control))
                      (equal event (fn2-retirement-control-event 0 fn2-retirement-control))
                      (equal okind (fn2-retirement-control-owner-kind 0 fn2-retirement-control))
                      (equal oslot (fn2-retirement-control-owner-slot 0 fn2-retirement-control))
                      (equal ogen (fn2-retirement-control-owner-gen 0 fn2-retirement-control))
                      (equal len (fn2-retirement-control-bytes 0 fn2-retirement-control))
                      (equal off (fn2-retirement-control-install-offset 0 fn2-retirement-control))))
         (mv :invalid fn2-fields fn2-extents fn2-retirement-control))
        (n (fn2-retirement-control-installed 0 fn2-retirement-control))
        ((unless (and (< n (fn2-retirement-control-count 0 fn2-retirement-control))
                       (< n *fn2-checkpoint-allocation-records-per-ticket*)
                       (< (+ 1 n) (fn2-retirement-control-rows fn2-retirement-control))))
         (mv :invalid fn2-fields fn2-extents fn2-retirement-control))
        ((mv decoded end fn2-fields)
         (fn2-format-allocation-decode base slot gen next (+ next (nfix bytes)) okind oslot ogen fn2-fields fn2-pool))
        ((unless (and (eq decoded :ok) (equal end (+ next bytes))
                       (equal (fn2-fields-value (+ base *fn2-format-allocation-field-extent*) fn2-fields)
                              (fn2-retirement-control-extent (+ 1 n) fn2-retirement-control))
                       (equal (fn2-fields-value (+ base *fn2-format-allocation-field-writer-epoch*) fn2-fields)
                              (fn2-retirement-control-epoch (+ 1 n) fn2-retirement-control))
                       (equal (fn2-fields-value (+ base *fn2-format-allocation-field-allocation*) fn2-fields)
                              (fn2-retirement-control-allocation (+ 1 n) fn2-retirement-control))
                       (if (= (+ 1 n) (fn2-retirement-control-count 0 fn2-retirement-control))
                           (equal end len) (< end len))))
         (mv :invalid fn2-fields fn2-extents fn2-retirement-control))
        ((mv code fn2-extents) (fn2-checkpoint-allocation-install base fn2-checkpoint-construction fn2-fields fn2-extents))
        ((unless (eq code :ok)) (mv code fn2-fields fn2-extents fn2-retirement-control))
        (fn2-retirement-control (fn2-retirement-control-put 0 (installed (+ 1 n)) (install-offset end))))
    (mv :ok fn2-fields fn2-extents fn2-retirement-control))
   (mv code fn2-core)))
 (fn2-core-preserves fn2-checkpoint-allocation-install-member
  (base slot gen off next bytes len batch event okind oslot ogen fn2-core) :position 1 :rows nil)
 ; Called only by the persisted lifecycle dispatch below. The shared control
 ; binds this exact candidate and containing member before opening the codec.
 (defun fn2-checkpoint-installation-install-member (base slot gen off next bytes len batch event okind oslot ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))
              (fn2-checkpoints (fn2-core-checkpoints fn2-core))
              (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core))
              (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core))
              (fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core))
              (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core))
              (fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))
              (fn2-ops (fn2-core-ops fn2-core))) (code fn2-retirement-control fn2-checkpoints fn2-fields)
   (b* (((unless (and (natp base) (<= (+ base *fn2-format-checkpoint-installation-num-fields*) (fn2-fields-rows fn2-fields))
                      (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen) (unsigned-byte-p 32 next)
                      (natp bytes) (unsigned-byte-p 32 (+ next bytes))
                      (unsigned-byte-p 8 okind) (unsigned-byte-p 32 oslot) (unsigned-byte-p 60 ogen)
                      (< 0 (fn2-retirement-control-rows fn2-retirement-control))
                      (= (fn2-retirement-control-state 0 fn2-retirement-control) *fn2-retirement-state-waiting*)
                      (= (fn2-retirement-control-installation-member 0 fn2-retirement-control) 1)
                      (= (fn2-retirement-control-count 0 fn2-retirement-control) 1)
                      (= (fn2-retirement-control-installed 0 fn2-retirement-control) 0)
                      (equal off 0) (equal (+ next bytes) len)
                      (equal slot (fn2-retirement-control-slot 0 fn2-retirement-control))
                      (equal gen (fn2-retirement-control-gen 0 fn2-retirement-control))
                      (equal len (fn2-retirement-control-bytes 0 fn2-retirement-control))
                      (equal batch (fn2-retirement-control-batch 0 fn2-retirement-control))
                      (equal event (fn2-retirement-control-event 0 fn2-retirement-control))
                      (equal okind (fn2-retirement-control-owner-kind 0 fn2-retirement-control))
                      (equal oslot (fn2-retirement-control-owner-slot 0 fn2-retirement-control))
                      (equal ogen (fn2-retirement-control-owner-gen 0 fn2-retirement-control))
                      (= (fn2-alloc-freeze-phase fn2-extents) 2)
                      (= (fn2-retirement-control-token 0 fn2-retirement-control) (fn2-alloc-freeze-token fn2-extents))))
         (mv :invalid fn2-retirement-control fn2-checkpoints fn2-fields))
        (c (fn2-retirement-control-candidate 0 fn2-retirement-control))
        (ticket (fn2-retirement-control-extent 0 fn2-retirement-control))
        ((unless (and (fn2-checkpoint-construction-ownerp ticket fn2-checkpoint-construction fn2-extents)
                       (= (fn2-checkpoint-construction-role ticket fn2-checkpoint-construction) 6)
                       (= (fn2-checkpoint-construction-ordinal ticket fn2-checkpoint-construction) (fn2-retirement-control-journal-ticket 0 fn2-retirement-control))
                       (= (fn2-checkpoint-construction-ticket-claimed ticket fn2-checkpoint-construction) 1)
                       (equal batch (fn2-checkpoint-construction-ticket-batch ticket fn2-checkpoint-construction))
                       (= (fn2-retirement-control-epoch 0 fn2-retirement-control) (fn2-checkpoint-construction-epoch ticket fn2-checkpoint-construction))
                       (= (fn2-retirement-control-allocation 0 fn2-retirement-control) (fn2-checkpoint-construction-counter ticket fn2-checkpoint-construction))
                       (fn2-checkpoint-builder-claimp c (fn2-retirement-control-token 0 fn2-retirement-control) okind oslot ogen fn2-checkpoints)
                       (= (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-checked*)
                       (posp event) (unsigned-byte-p 60 event)
                       (or (= (fn2-checkpoints-installation-event c fn2-checkpoints) 0)
                           (= (fn2-checkpoints-installation-event c fn2-checkpoints) event))))
         (mv :invalid fn2-retirement-control fn2-checkpoints fn2-fields))
        ((mv decoded end fn2-fields)
         (fn2-format-checkpoint-installation-decode base slot gen next (+ next bytes) okind oslot ogen fn2-fields fn2-pool))
        ((unless (and (eq decoded :ok) (equal end len)))
         (mv :invalid fn2-retirement-control fn2-checkpoints fn2-fields))
        ((mv code fn2-checkpoints)
         (fn2-checkpoint-install c batch base slot gen okind oslot ogen fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
          fn2-fields fn2-pool fn2-alloc-edges fn2-extents fn2-ops))
        ((unless (eq code :ok)) (mv code fn2-retirement-control fn2-checkpoints fn2-fields))
        ; EVENT is the exact persisted member identity already matched above,
        ; not the directory's first event or a number inferred from its cut.
        (fn2-checkpoints (fn2-checkpoints-set-installation-event c event fn2-checkpoints))
        (fn2-retirement-control (fn2-retirement-control-put 0 (installed 1) (install-offset end))))
    (mv :ok fn2-retirement-control fn2-checkpoints fn2-fields)) (mv code fn2-core)))
 (fn2-core-preserves fn2-checkpoint-installation-install-member
  (base slot gen off next bytes len batch event okind oslot ogen fn2-core) :position 1 :rows nil)
 ))))

(defmacro fn2-checkpoint-retirement-coordinator-events ()
 `(fn2-retirement-coordinator-events ,(fn2-checkpoint-retirement-adapter)))
(defmacro fn2-checkpoint-retirement-install-events ()
 `(fn2-retirement-install-events ,(fn2-checkpoint-retirement-adapter)))

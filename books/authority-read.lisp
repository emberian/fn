(in-package "ACL2")
(include-book "machines-c-read")
(include-book "ordered")

(defcost fn2-authority-principal-allows :child fn2-authority-principal-allows-children
 :answers (:ok :more :access :state) :bytes 4096
 :tables (fn2-core-reads fn2-core-ranges fn2-core-seeks fn2-core-succ-txns fn2-core-run-cursors fn2-core-run-paths fn2-core-fields)
 :doc "One exact committed-grant decision step on a caller-owned read row for a validated principal.")

(defun fn2-authority-read-key-children (x keys fn2-reads fn2-id-decides fn2-fields fn2-fc)
 (declare (xargs :stobjs (fn2-reads fn2-id-decides fn2-fields fn2-fc)
                 :guard (and (fn2-reads-wfp fn2-reads) (fn2-id-decides-wfp fn2-id-decides)
                             (fn2-fields-wfp fn2-fields) (fn2-fc-wfp fn2-fc))))
 (cond
  ((atom keys) (mv :ok fn2-reads fn2-fields))
  ((not (consp (car keys))) (mv :state fn2-reads fn2-fields))
  (t (mv-let (code fn2-reads fn2-fields)
       (fn2-read-key-children x :lo (caar keys) (cdar keys) fn2-reads fn2-id-decides fn2-fields fn2-fc)
     (if (eq code :ok)
         (fn2-authority-read-key-children x (cdr keys) fn2-reads fn2-id-decides fn2-fields fn2-fc)
       (mv :state fn2-reads fn2-fields))))))

(defun fn2-authority-principal-allows-children
    (x pid right scope target xstep head grant budget fn2-reads fn2-id-decides fn2-ranges fn2-seeks fn2-succ-txns fn2-overlays fn2-overlay-index fn2-run-installed fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool fn2-fc)
 (declare (xargs :stobjs (fn2-reads fn2-id-decides fn2-ranges fn2-seeks fn2-succ-txns fn2-overlays fn2-overlay-index fn2-run-installed fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool fn2-fc)
                 :guard (and (fn2-reads-wfp fn2-reads) (fn2-id-decides-wfp fn2-id-decides) (fn2-ranges-wfp fn2-ranges) (fn2-seeks-wfp fn2-seeks) (fn2-succ-txns-wfp fn2-succ-txns) (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index) (fn2-run-installed-wfp fn2-run-installed) (fn2-run-cursors-wfp fn2-run-cursors) (fn2-run-paths-wfp fn2-run-paths) (fn2-run-cache-wfp fn2-run-cache) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (fn2-fc-wfp fn2-fc))))
 (b* (((unless (and (posp pid) (unsigned-byte-p 60 pid)
                    (unsigned-byte-p 60 right) (unsigned-byte-p 60 scope)
                    (unsigned-byte-p 60 target) (unsigned-byte-p 60 head)
                    (unsigned-byte-p 60 grant) (unsigned-byte-p 32 x)
                    (< x (fn2-reads-rows fn2-reads))))
       (mv :state 0 0 0 fn2-reads fn2-ranges fn2-seeks fn2-succ-txns fn2-run-cursors fn2-run-paths fn2-fields))
      ((mv rc fn2-reads fn2-ranges fn2-seeks fn2-succ-txns)
       (if (posp xstep) (mv :ok fn2-reads fn2-ranges fn2-seeks fn2-succ-txns)
         (fn2-read-release-children x fn2-reads fn2-id-decides fn2-ranges fn2-seeks fn2-succ-txns)))
      ((unless (eq rc :ok))
       (mv :state 0 0 0 fn2-reads fn2-ranges fn2-seeks fn2-succ-txns fn2-run-cursors fn2-run-paths fn2-fields))
      (step (if (and (posp xstep) (<= xstep 4)) xstep 1))
      (sid (case step (2 *fn2-grant-current-sid*) (3 *fn2-grants-sid*) (otherwise *fn2-authority-head-sid*)))
      (field (case step (2 *fn2-grant-current-entry-field-grant*)
                        (3 *fn2-grants-entry-field-enabled*)
                        (otherwise *fn2-authority-head-entry-field-grant*)))
      ((mv kc fn2-reads fn2-fields)
       (if (and (equal (fn2-reads-op x fn2-reads) *fn2-read-op-lookup*)
                (equal (fn2-reads-sid x fn2-reads) sid))
           (mv :ok fn2-reads fn2-fields)
         (fn2-authority-read-key-children
          x
          (case step
           (2 (list (cons *fn2-grant-current-entry-field-grantee* pid)
                    (cons *fn2-grant-current-entry-field-right* right)
                    (cons *fn2-grant-current-entry-field-scope* scope)
                    (cons *fn2-grant-current-entry-field-target* target)))
           (3 (list (cons *fn2-grants-entry-field-grant* grant)))
           (otherwise (list (cons *fn2-authority-head-entry-field-principal* pid))))
          fn2-reads fn2-id-decides fn2-fields fn2-fc)))
      ((mv lc fn2-reads fn2-succ-txns fn2-run-cursors fn2-run-paths fn2-fields)
       (if (eq kc :ok)
           (fn2-read-lookup-children x sid budget fn2-reads fn2-id-decides fn2-succ-txns
             fn2-overlays fn2-overlay-index fn2-run-installed fn2-run-cursors fn2-run-paths fn2-run-cache
             fn2-fields fn2-pool fn2-fc)
         (mv :state fn2-reads fn2-succ-txns fn2-run-cursors fn2-run-paths fn2-fields)))
      ((when (eq lc :more))
       (mv :more step head grant fn2-reads fn2-ranges fn2-seeks fn2-succ-txns fn2-run-cursors fn2-run-paths fn2-fields))
      ((mv vc value)
       (if (eq lc :ok) (fn2-read-value-children x field fn2-reads fn2-run-installed fn2-fields)
         (if (and (eq lc :absent) (not (equal step 3))) (mv :ok 0) (mv :state 0))))
      ((mv released fn2-reads fn2-ranges fn2-seeks fn2-succ-txns)
       (fn2-read-release-children x fn2-reads fn2-id-decides fn2-ranges fn2-seeks fn2-succ-txns))
      ((unless (and (eq vc :ok) (eq released :ok) (unsigned-byte-p 60 value)))
       (mv :state 0 0 0 fn2-reads fn2-ranges fn2-seeks fn2-succ-txns fn2-run-cursors fn2-run-paths fn2-fields))
      ((mv code next observed selected)
       (case step
        (1 (if (posp value) (mv :more 2 value 0) (mv :access 1 0 0)))
        (2 (if (posp value) (mv :more 3 head value) (mv :access 2 head 0)))
        (3 (if (equal value 1) (mv :more 4 head grant) (mv :access 3 head grant)))
        (otherwise (if (equal value head) (mv :ok 4 head grant) (mv :more 1 0 0))))))
   (mv code next observed selected fn2-reads fn2-ranges fn2-seeks fn2-succ-txns fn2-run-cursors fn2-run-paths fn2-fields)))

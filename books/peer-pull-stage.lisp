; Attribute held local input to the actual AF_UNIX control connection.
(in-package "ACL2")
(include-book "assembly-callbacks-d")
(include-book "peer-pull-line")
(include-book "cns")
(include-book "c-snapshot")

(fn2-csnapshot-op fn2-peer-pull-stage-credentials
 (id generation ctl ctl-gen stream-off stream-len user-off user-len pass-off pass-len) 1
 (b* (((unless (and (eq (fn2-peer-pull-snapshot-read-code id fn2-core) :ok)
                    (equal generation (fn2-machine-generation id fn2-core))
                    (equal (fn2-peer-pull-row-phase id fn2-core) *fn2-peer-pull-state-stage*)
                    (equal (fn2-peer-pull-row-ctl id fn2-core) ctl)
                    (equal (fn2-peer-pull-row-ctl-gen id fn2-core) ctl-gen)))
       (mv :access fn2-core))
      (local-family (fn2-ctl-row-peer-family ctl fn2-core))
      (local-word (fn2-ctl-row-peer-w0 ctl fn2-core))
      (owner (and (eq (fn2-ctl-snapshot-read-code ctl fn2-core) :ok)
                  (equal ctl-gen (fn2-machine-generation ctl fn2-core))
                  (stobj-let ((fn2-control (fn2-core-control fn2-core))) (ok)
                    (fn2-ctl-owner-p local-family local-word fn2-control) ok)))
      (enabled (and owner (equal 1 (fn2-peer-pull-row-trust-ref id fn2-core))
                    (posp (fn2-peer-pull-row-timeout-ms id fn2-core))
                    (posp (fn2-peer-pull-row-local-principal id fn2-core))
                    (not (equal *fn2-none* (fn2-peer-pull-row-account-ref id fn2-core)))
                    (posp (fn2-peer-pull-row-stream id fn2-core))
                    (posp (fn2-peer-pull-row-remote-history id fn2-core))
                    (posp (fn2-peer-pull-row-remote-incarnation id fn2-core))
                    (posp (fn2-peer-pull-row-remote-view id fn2-core))
                    (member-equal (fn2-peer-pull-row-family id fn2-core)
                                  (list *fn2-peer-family-inet* *fn2-peer-family-inet6*))
                    (posp (fn2-peer-pull-row-port id fn2-core))))
      ((unless (and enabled (unsigned-byte-p 16 stream-len) (unsigned-byte-p 16 user-len) (unsigned-byte-p 16 pass-len)))
       (mv :access (fn2-peer-pull-put-core id (phase *fn2-peer-pull-state-draining*))))
      (src (fn2-ctl-row-rx-slot ctl fn2-core)) (sg (fn2-ctl-row-rx-gen ctl fn2-core))
      (dest (fn2-peer-pull-row-secret-slot id fn2-core)) (dg (fn2-peer-pull-row-secret-gen id fn2-core))
      ((mv code fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
         (fn2-peer-pull-copy-credentials src sg *fn2-ctl-kind* ctl ctl-gen stream-off stream-len user-off user-len pass-off pass-len
                                         dest dg *fn2-peer-pull-kind* id generation fn2-pool)
         (mv code fn2-core))))
   (if (eq code :ok)
       (mv :ok (fn2-peer-pull-put-core id (stream-len stream-len) (user-len user-len) (pass-len pass-len)
                                      (phase *fn2-peer-pull-state-connect*)))
     (mv code (fn2-peer-pull-put-core id (phase *fn2-peer-pull-state-draining*))))))

(in-theory (disable fn2-peer-pull-stage-credentials))
(defcost fn2-peer-pull-stage-credentials :answers (:ok :access :frame :capacity) :bytes 8192
 :tables (fn2-peer-pull-table fn2-core-pool)
 :doc "Copy the owner control frame's stream and remote credentials into the newly reserved private range.")

; Fixed CURRENT capacity claim. Internal algebra, not an installed runtime
; census or a public allocation grant. No legacy PRL binding lookup/copy.
(in-package "ACL2")
(include-book "index-query-resources")
(defstobj fn-rx-capacity-current
  (fn-rxcc-token :initially nil)
  (fn-rxcc-phase :initially :fresh)
  (fn-rxcc-claim :initially nil)
  (fn-rxcc-instance :initially nil)
  :inline t)
(defun fn-rxcc-freshp (fn-rx-capacity-current)
  (declare (xargs :stobjs fn-rx-capacity-current :guard t))
  (and (eq (fn-rxcc-phase fn-rx-capacity-current) :fresh)
       (null (fn-rxcc-token fn-rx-capacity-current))
       (null (fn-rxcc-claim fn-rx-capacity-current))
       (null (fn-rxcc-instance fn-rx-capacity-current))))
(defun fn-rxcc-capacity-tokenp (token)
  (declare (xargs :guard t))
  (and (consp token) (eq (car token) :rx-capacity)
       (consp (cdr token)) (natp (cadr token))
       (consp (cddr token)) (natp (caddr token))
       (consp (cdddr token)) (equal (cadddr token) 4096)
       (null (cddddr token))))
(defun fn-rxcc-exactp (token fn-rx-capacity-current)
  (declare (xargs :stobjs fn-rx-capacity-current :guard t))
  (and (fn-rxcc-capacity-tokenp token)
       (equal token (fn-rxcc-token fn-rx-capacity-current))))
(defun fn-rxcc-reserve (instance demand ledger fn-rx-capacity-current)
  (declare (xargs :stobjs fn-rx-capacity-current :guard t))
  (cond ((not (fn-rxcc-freshp fn-rx-capacity-current))
         (mv :receiver-capacity-busy nil ledger fn-rx-capacity-current))
        ((not (and (natp instance) (fn-prs-vectorp demand)
                   (equal (fn-prl-nth 1 demand) 0)
                   (equal (fn-prl-nth 2 demand) 0)
                   (equal (fn-prl-nth 3 demand) 0)
                   (equal (fn-prl-nth 4 demand) 1)))
         (mv :invalid-capacity-request nil ledger fn-rx-capacity-current))
        (t
         (mv-let (word next charged)
           (fn-prs-issue (fn-prl-nth 0 ledger) (fn-prl-baseline ledger)
                         '(0 0 0 0 0) (fn-prl-nth 1 ledger)
                         (fn-prl-nth 2 ledger)
                         (fn-prl-nth 4 (fn-prl-nth 0 ledger)) demand)
           (if (not (eq word :admitted))
               (mv word nil ledger fn-rx-capacity-current)
             (let* ((token (list :rx-capacity (fn-prl-nth 2 ledger) instance 4096))
                    (ledger1 (fn-prl-build (fn-prl-nth 0 ledger) charged next
                                (fn-prl-nth 3 ledger) (fn-prl-baseline ledger)))
                    (fn-rx-capacity-current (update-fn-rxcc-token token fn-rx-capacity-current))
                    (fn-rx-capacity-current (update-fn-rxcc-claim demand fn-rx-capacity-current))
                    (fn-rx-capacity-current (update-fn-rxcc-instance instance fn-rx-capacity-current))
                    (fn-rx-capacity-current (update-fn-rxcc-phase :reserved fn-rx-capacity-current)))
               (mv :admitted token ledger1 fn-rx-capacity-current)))))))
; Commit this fence BEFORE invoking the allocator. An escape keeps the exact
; authority and charge, and a second allocation attempt cannot pass.
(defun fn-rxcc-allocation-begin (token fn-rx-capacity-current)
  (declare (xargs :stobjs fn-rx-capacity-current :guard t))
  (if (not (and (fn-rxcc-exactp token fn-rx-capacity-current)
                (eq (fn-rxcc-phase fn-rx-capacity-current) :reserved)))
      (mv :stale-capacity fn-rx-capacity-current)
    (let ((fn-rx-capacity-current
           (update-fn-rxcc-phase :allocating fn-rx-capacity-current)))
      (mv :allocate fn-rx-capacity-current))))
; A definite constructor return is an actual caller obligation. This decision
; computes the pool transfer but does not install it. The caller persists the
; :promoting fence first, then pool U, then invokes installed-publish. Unknown
; cuts cannot replay the transfer; neither C nor U is refunded here.
(defun fn-rxcc-install-prepare (token ledger fn-rx-capacity-current)
  (declare (xargs :stobjs fn-rx-capacity-current :guard t))
  (let* ((claim (fn-rxcc-claim fn-rx-capacity-current))
         (retained (list (fn-prl-nth 0 claim) 0 0 0 0)))
    (if (not (and (fn-rxcc-exactp token fn-rx-capacity-current)
                  (eq (fn-rxcc-phase fn-rx-capacity-current) :allocating)
                  (fn-prs-vectorp claim) (fn-prs-vectorp (fn-prl-nth 1 ledger))
                  (fn-prs-vectorp (fn-prl-baseline ledger))
                  (fn-prs-fundedp (fn-prl-nth 0 ledger) (fn-prl-baseline ledger)
                                  '(0 0 0 0 0) (fn-prl-nth 1 ledger))
                  (true-listp (fn-prl-nth 1 ledger))
                  (fn-prs-below retained (fn-prl-nth 1 ledger))))
        (mv :stale-capacity ledger fn-rx-capacity-current)
      (let* ((ledger1 (fn-iqr-promoted-ledger ledger retained))
             (fn-rx-capacity-current
              (update-fn-rxcc-phase :promoting fn-rx-capacity-current)))
        (mv :install-pool ledger1 fn-rx-capacity-current)))))
; Internal final publication only after SAME pool installation; this function
; alone is not an observation that the pool commit or constructor happened.
(defun fn-rxcc-installed-publish (token fn-rx-capacity-current)
  (declare (xargs :stobjs fn-rx-capacity-current :guard t))
  (if (not (and (fn-rxcc-exactp token fn-rx-capacity-current)
                (eq (fn-rxcc-phase fn-rx-capacity-current) :promoting)))
      (mv :stale-capacity fn-rx-capacity-current)
    (let* ((fn-rx-capacity-current
            (update-fn-rxcc-claim '(0 0 0 0 1) fn-rx-capacity-current))
           (fn-rx-capacity-current
            (update-fn-rxcc-phase :installed fn-rx-capacity-current)))
      (mv :installed fn-rx-capacity-current))))
(defthm fn-rxcc-busy-preserves-current-and-pool
  (implies (not (fn-rxcc-freshp fn-rx-capacity-current))
           (and (equal (mv-nth 0 (fn-rxcc-reserve instance demand ledger fn-rx-capacity-current))
                       :receiver-capacity-busy)
                (equal (mv-nth 2 (fn-rxcc-reserve instance demand ledger fn-rx-capacity-current)) ledger)
                (equal (mv-nth 3 (fn-rxcc-reserve instance demand ledger fn-rx-capacity-current))
                       fn-rx-capacity-current))))
(defthm fn-rxcc-fenced-allocation-cannot-repeat
  (implies (not (eq (fn-rxcc-phase fn-rx-capacity-current) :reserved))
           (and (equal (mv-nth 0 (fn-rxcc-allocation-begin token fn-rx-capacity-current)) :stale-capacity)
                (equal (mv-nth 1 (fn-rxcc-allocation-begin token fn-rx-capacity-current)) fn-rx-capacity-current))))
(defthm fn-rxcc-fenced-promotion-cannot-repeat
  (implies (not (eq (fn-rxcc-phase fn-rx-capacity-current) :allocating))
           (and (equal (mv-nth 0 (fn-rxcc-install-prepare token ledger fn-rx-capacity-current)) :stale-capacity)
                (equal (mv-nth 1 (fn-rxcc-install-prepare token ledger fn-rx-capacity-current)) ledger)
                (equal (mv-nth 2 (fn-rxcc-install-prepare token ledger fn-rx-capacity-current)) fn-rx-capacity-current))))
(verify-guards fn-rxcc-freshp)
(verify-guards fn-rxcc-capacity-tokenp)
(verify-guards fn-rxcc-exactp)
(verify-guards fn-rxcc-reserve)
(verify-guards fn-rxcc-allocation-begin)
(verify-guards fn-rxcc-install-prepare)
(verify-guards fn-rxcc-installed-publish)

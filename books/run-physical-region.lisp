; Shared bounded active-actor job sets. Callers derive three disjoint
; segments from their actual retained actor geometry, never from host lists.
(in-package "ACL2")
(include-book "run-physical-release")
(fn2-book-layer :c)
(defun fn2-run-load-region-count (n0 n1 n2)
 (declare (xargs :guard t)) (+ (nfix n0) (nfix n1) (nfix n2)))
(defun fn2-run-load-region-cursor (i b0 n0 b1 n1 b2 n2)
 (declare (xargs :guard t) (ignore n2))
 (cond ((< (nfix i) (nfix n0)) (+ (nfix b0) (nfix i)))
       ((< (nfix i) (+ (nfix n0) (nfix n1))) (+ (nfix b1) (- (nfix i) (nfix n0))))
       (t (+ (nfix b2) (- (nfix i) (+ (nfix n0) (nfix n1)))))))
(defun fn2-run-load-region-pairp (b n c m)
 (declare (xargs :guard t))
 (or (zp n) (zp m) (<= (+ (nfix b) (nfix n)) (nfix c)) (<= (+ (nfix c) (nfix m)) (nfix b))))
(defun fn2-run-load-regionp (b0 n0 b1 n1 b2 n2 loads cursors leases)
 (declare (xargs :guard t))
 (and (natp b0) (natp n0) (natp b1) (natp n1) (natp b2) (natp n2)
      (< 0 (fn2-run-load-region-count n0 n1 n2))
      (<= (fn2-run-load-region-count n0 n1 n2) *fn2-b-query-loader-jobs*)
      (<= (+ b0 n0) (nfix loads)) (<= (+ b1 n1) (nfix loads)) (<= (+ b2 n2) (nfix loads))
      (<= (+ b0 n0) (nfix cursors)) (<= (+ b1 n1) (nfix cursors)) (<= (+ b2 n2) (nfix cursors))
      (<= (+ b0 n0) (nfix leases)) (<= (+ b1 n1) (nfix leases)) (<= (+ b2 n2) (nfix leases))
      (fn2-run-load-region-pairp b0 n0 b1 n1) (fn2-run-load-region-pairp b0 n0 b2 n2) (fn2-run-load-region-pairp b1 n1 b2 n2)))
(defun fn2-run-load-region-freep (i b0 n0 b1 n1 b2 n2 fn2-run-loads fn2-checkpoint-summary-leases)
 (declare (xargs :stobjs (fn2-run-loads fn2-checkpoint-summary-leases)
 :measure (nfix (- (fn2-run-load-region-count n0 n1 n2) (nfix i)))
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases))))
 (or (>= (nfix i) (fn2-run-load-region-count n0 n1 n2))
  (let ((c (fn2-run-load-region-cursor i b0 n0 b1 n1 b2 n2)))
   (and (< c (fn2-run-loads-rows fn2-run-loads)) (< c (fn2-checkpoint-summary-leases-rows fn2-checkpoint-summary-leases))
        (equal (fn2-run-loads-phase c fn2-run-loads) *fn2-run-load-phase-idle*)
        (equal (fn2-checkpoint-summary-leases-live c fn2-checkpoint-summary-leases) 0)
        (fn2-run-load-region-freep (+ (nfix i) 1) b0 n0 b1 n1 b2 n2 fn2-run-loads fn2-checkpoint-summary-leases)))))
(defmacro fn2-run-load-region-mv (code)
 `(mv ,code fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
(defun fn2-run-load-region-fill (i b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 :measure (nfix (- (fn2-run-load-region-count n0 n1 n2) (nfix i))) :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-run-cursors-wfp fn2-run-cursors)
 (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases) (fn2-pool-wfp fn2-pool))))
 (b* (((when (>= (nfix i) (fn2-run-load-region-count n0 n1 n2))) (fn2-run-load-region-mv :ok))
      (c (fn2-run-load-region-cursor i b0 n0 b1 n1 b2 n2))
      ((mv code fn2-run-loads fn2-pool) (fn2-run-load-reserve c kind owner generation fn2-run-loads fn2-pool))
      ((unless (eq code :ok)) (fn2-run-load-region-mv code)))
  (fn2-run-load-region-fill (+ (nfix i) 1) b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))
(defun fn2-run-load-region-clean (i b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 :measure (nfix (- (fn2-run-load-region-count n0 n1 n2) (nfix i))) :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-run-cursors-wfp fn2-run-cursors)
 (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases) (fn2-pool-wfp fn2-pool))))
 (b* (((when (>= (nfix i) (fn2-run-load-region-count n0 n1 n2))) (fn2-run-load-region-mv :ok))
      (c (fn2-run-load-region-cursor i b0 n0 b1 n1 b2 n2))
      ((mv code fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
       (fn2-run-load-release c kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      ((unless (eq code :ok)) (fn2-run-load-region-mv code)))
  (fn2-run-load-region-clean (+ (nfix i) 1) b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))
(defun fn2-run-load-region-retainedp (i b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-pool)
 (declare (xargs :stobjs (fn2-run-loads fn2-pool)
 :measure (nfix (- (fn2-run-load-region-count n0 n1 n2) (nfix i)))
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-pool-wfp fn2-pool))))
 (and (< (nfix i) (fn2-run-load-region-count n0 n1 n2))
  (let ((c (fn2-run-load-region-cursor i b0 n0 b1 n1 b2 n2)))
   (or (and (fn2-run-load-ownerp c kind owner generation fn2-run-loads)
            (or (eq (fn2-pool-workspace-code (fn2-run-loads-page c fn2-run-loads) (fn2-run-loads-page-gen c fn2-run-loads) kind owner generation fn2-pool) :ok)
                (eq (fn2-pool-workspace-code (fn2-run-loads-scratch c fn2-run-loads) (fn2-run-loads-scratch-gen c fn2-run-loads) kind owner generation fn2-pool) :ok)))
       (fn2-run-load-region-retainedp (+ (nfix i) 1) b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-pool)))))
(defun fn2-run-load-region-reserve (b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool) :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-run-cursors-wfp fn2-run-cursors)
 (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (fn2-run-load-regionp b0 n0 b1 n1 b2 n2 (fn2-run-loads-rows fn2-run-loads) (fn2-run-cursors-rows fn2-run-cursors) (fn2-checkpoint-summary-leases-rows fn2-checkpoint-summary-leases))
                    (fn2-pool-mrefp kind owner generation)
                    (fn2-run-load-region-freep 0 b0 n0 b1 n1 b2 n2 fn2-run-loads fn2-checkpoint-summary-leases)))
       (mv :state 0 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      ((unless (fn2-run-load-roomp (fn2-run-load-region-count n0 n1 n2) fn2-pool)) (mv :exhausted 0 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      ((mv code fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool) (fn2-run-load-region-fill 0 b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      ((when (eq code :ok)) (mv :ok 1 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      ((mv clean fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool) (fn2-run-load-region-clean 0 b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))
  (mv (if (fn2-run-load-region-retainedp 0 b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-pool) :ok
        (if (eq clean :ok) code :recovery-required)) 0 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))

(defun fn2-run-load-region-suffix (i b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads)
 (declare (xargs :stobjs fn2-run-loads :measure (nfix (- (fn2-run-load-region-count n0 n1 n2) (nfix i)))
 :guard (fn2-run-loads-wfp fn2-run-loads)))
 (if (>= (nfix i) (fn2-run-load-region-count n0 n1 n2)) (mv :ok nil)
  (b* ((c (fn2-run-load-region-cursor i b0 n0 b1 n1 b2 n2))
       ((unless (< c (fn2-run-loads-rows fn2-run-loads))) (mv :bounds nil))
       (live (not (equal (fn2-run-loads-phase c fn2-run-loads) *fn2-run-load-phase-idle*)))
       ((unless (or (not live) (and (fn2-run-load-ownerp c kind owner generation fn2-run-loads)
                                    (member (fn2-run-loads-windows c fn2-run-loads) '(1 2))))) (mv :owner nil))
       ((mv code rest) (fn2-run-load-region-suffix (+ (nfix i) 1) b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads)))
   (mv code (or live rest)))))
(defun fn2-run-load-region-drain (i b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads)
 (declare (xargs :stobjs fn2-run-loads :guard (fn2-run-loads-wfp fn2-run-loads)))
 (b* (((unless (and (natp i) (< i (fn2-run-load-region-count n0 n1 n2))
                    (<= (fn2-run-load-region-count n0 n1 n2) *fn2-b-query-loader-jobs*))) (mv :bounds 0))
      (c (fn2-run-load-region-cursor i b0 n0 b1 n1 b2 n2))
      ((unless (< c (fn2-run-loads-rows fn2-run-loads))) (mv :bounds 0))
      ((when (equal (fn2-run-loads-phase c fn2-run-loads) *fn2-run-load-phase-idle*)) (mv :absent c))
      ((unless (fn2-run-load-ownerp c kind owner generation fn2-run-loads)) (mv :owner c))
      ((when (equal (fn2-run-loads-pending c fn2-run-loads) 1)) (mv :wait c))
      ((mv code retained) (fn2-run-load-region-suffix (+ i 1) b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads)))
  (mv (if (eq code :ok) (if retained :member :last) code) c)))
(defun fn2-run-load-region-member-release (i b0 n0 b1 n1 b2 n2 kind owner generation
 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-run-cursors-wfp fn2-run-cursors)
  (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases) (fn2-pool-wfp fn2-pool))))
 (b* (((mv code c) (fn2-run-load-region-drain i b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads))
      ((unless (eq code :member)) (fn2-run-load-region-mv :owner)))
  (fn2-run-load-release c kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))

(fn2-run-load-frames fn2-run-load-region-reserve
 (b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 ((fn2-run-loads 2) (fn2-run-cursors 3) (fn2-checkpoint-summary 4) (fn2-checkpoint-summary-leases 5) (fn2-pool 6)))

(fn2-run-load-frames fn2-run-load-region-fill
 (i b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 ((fn2-run-loads 1) (fn2-run-cursors 2) (fn2-checkpoint-summary 3) (fn2-checkpoint-summary-leases 4) (fn2-pool 5)))

(fn2-run-load-frames fn2-run-load-region-clean
 (i b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 ((fn2-run-loads 1) (fn2-run-cursors 2) (fn2-checkpoint-summary 3) (fn2-checkpoint-summary-leases 4) (fn2-pool 5)))

(fn2-run-load-frames fn2-run-load-region-member-release
 (i b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 ((fn2-run-loads 1) (fn2-run-cursors 2) (fn2-checkpoint-summary 3) (fn2-checkpoint-summary-leases 4) (fn2-pool 5)))

   (if (not (fn2-boot-checkpoint-archive-owner-p id ogen *fn2-boot-state-checkpoint-archive-begin* fn2-core)) (mv :state fn2-core)
    (let ((scratch (fn2-machine-rx-slot id fn2-core)) (sgen (fn2-machine-rx-gen id fn2-core)))

   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (and (fn2-boot-checkpoint-archive-owner-p id ogen *fn2-boot-state-checkpoint-archive-copy* fn2-core)

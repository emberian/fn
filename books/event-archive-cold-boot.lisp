; Delayed real boot faces: invoked only after the archive states are declared.
; Parent owns stage12 routing through the existing :read/:read-result machine.
(in-package "ACL2")
(include-book "boot-kind")
(include-book "event-archive-cold-read")
(fn2-book-layer :c)
(defcost fn2-boot-checkpoint-archive-begin :answers t :bytes (* 2 *fn2-run-layout-max-entry-bytes*)
 :tables (fn2-core-event-archive fn2-core-checkpoints fn2-core-checkpoint-refs fn2-core-checkpoint-bytes fn2-core-checkpoint-restore-reader
          fn2-core-run-loads fn2-core-run-cursors fn2-core-fc fn2-core-fields fn2-core-pool))
(defcost fn2-boot-checkpoint-archive-arm :answers t :bytes 512
 :tables (fn2-core-event-archive fn2-core-checkpoints fn2-core-checkpoint-refs fn2-core-checkpoint-bytes fn2-core-run-loads fn2-core-run-cursors fn2-core-pool))
(defcost fn2-boot-checkpoint-archive-received :answers t :bytes 512
 :tables (fn2-core-event-archive fn2-core-checkpoints fn2-core-checkpoint-refs fn2-core-checkpoint-bytes fn2-core-run-loads fn2-core-run-cursors fn2-core-pool))
(defcost fn2-boot-checkpoint-archive-check-raw :child fn2-event-archive-cold-cursor-step :answers t :bytes (* 2 *fn2-run-layout-max-entry-bytes*)
 :tables (fn2-core-event-archive fn2-core-checkpoints fn2-core-checkpoint-refs fn2-core-checkpoint-bytes fn2-core-run-loads fn2-core-run-cursors
          fn2-core-run-paths fn2-core-run-cache fn2-core-boot-config fn2-core-fc fn2-core-fc-context fn2-core-b3 fn2-core-fields fn2-core-pool fn2-core-digests))
(defcost fn2-boot-checkpoint-archive-check :answers t :bytes (* 2 *fn2-run-layout-max-entry-bytes*)
 :tables (fn2-core-event-archive fn2-core-checkpoints fn2-core-checkpoint-refs fn2-core-checkpoint-bytes fn2-core-run-loads fn2-core-run-cursors
          fn2-core-run-paths fn2-core-run-cache fn2-core-boot-config fn2-core-fc fn2-core-fc-context fn2-core-b3 fn2-core-fields fn2-core-pool fn2-core-digests))

(defmacro fn2-boot-checkpoint-archive-operations ()
 '(progn
  (make-event (value (cons 'progn (fn2-arms-op-face-events 'fn2-boot-checkpoint-archive-check-raw 'fn2-event-archive-cold-cursor-step (w state)))))
  (defun fn2-boot-checkpoint-archive-owner-p (id ogen phase fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (and (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
        (equal (fn2-machine-phase id fn2-core) phase) (equal (fn2-machine-generation id fn2-core) ogen)
        (stobj-let ((fn2-event-archive (fn2-core-event-archive fn2-core))) (answer)
         (and (< 1 (fn2-event-archive-rows fn2-event-archive))
              (equal (fn2-event-archive-candidate 1 fn2-event-archive) (fn2-machine-checkpoint-index id fn2-core))
              (equal (fn2-event-archive-header-slot 1 fn2-event-archive) (fn2-machine-root-slot id fn2-core))
              (equal (fn2-event-archive-header-gen 1 fn2-event-archive) (fn2-machine-root-gen id fn2-core))
              (equal (fn2-event-archive-owner-kind 1 fn2-event-archive) *fn2-boot-kind*)
              (equal (fn2-event-archive-owner-slot 1 fn2-event-archive) id)
              (equal (fn2-event-archive-owner-gen 1 fn2-event-archive) ogen)) answer)))
  (defun fn2-boot-checkpoint-archive-begin (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (fn2-boot-checkpoint-archive-owner-p id ogen *fn2-boot-state-checkpoint-archive-begin* fn2-core)) (mv :state fn2-core)
    (let ((scratch (fn2-machine-rx-slot id fn2-core)) (sgen (fn2-machine-rx-gen id fn2-core)))
     (stobj-let ((fn2-event-archive (fn2-core-event-archive fn2-core)) (fn2-checkpoints (fn2-core-checkpoints fn2-core))
       (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core)) (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core))
       (fn2-checkpoint-restore-reader (fn2-core-checkpoint-restore-reader fn2-core)) (fn2-run-loads (fn2-core-run-loads fn2-core))
       (fn2-run-cursors (fn2-core-run-cursors fn2-core)) (fn2-fc (fn2-core-fc fn2-core)) (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
      (code fn2-event-archive fn2-run-loads fn2-run-cursors fn2-fields)
      (fn2-event-archive-cold-cursor-begin scratch sgen fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
       fn2-checkpoint-restore-reader fn2-run-loads fn2-run-cursors fn2-fc fn2-fields fn2-pool) (mv code fn2-core)))))
  (fn2-core-preserves fn2-boot-checkpoint-archive-begin (id ogen fn2-core) :position 1 :rows nil)
  (defun fn2-boot-checkpoint-archive-arm (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (fn2-boot-checkpoint-archive-owner-p id ogen *fn2-boot-state-checkpoint-archive-load* fn2-core)) (mv :state 0 fn2-core)
    (stobj-let ((fn2-event-archive (fn2-core-event-archive fn2-core)) (fn2-checkpoints (fn2-core-checkpoints fn2-core))
      (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core)) (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core))
      (fn2-run-loads (fn2-core-run-loads fn2-core)) (fn2-run-cursors (fn2-core-run-cursors fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
     (code fn2-event-archive offset)
     (b* (((unless (< 1 (fn2-run-loads-rows fn2-run-loads))) (mv :state fn2-event-archive 0))
          (c (fn2-b-event-archive-cursor-from-rows (fn2-run-loads-rows fn2-run-loads)))
          (offset (* *fn2-commit-unit-bytes* (+ (fn2-run-loads-unit c fn2-run-loads) (fn2-run-loads-sector c fn2-run-loads))))
          ((unless (and (equal (fn2-run-loads-scratch c fn2-run-loads) (fn2-machine-rx-slot id fn2-core))
                        (equal (fn2-run-loads-scratch-gen c fn2-run-loads) (fn2-machine-rx-gen id fn2-core))
                        (<= (+ offset *fn2-commit-unit-bytes*) (fn2-machine-image-size id fn2-core))))
           (mv :bounds fn2-event-archive 0)))
      (fn2-event-archive-cold-read-arm fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool))
     (mv code offset fn2-core))))
  (fn2-core-preserves fn2-boot-checkpoint-archive-arm (id ogen fn2-core) :position 2 :rows nil)
  (defun fn2-boot-checkpoint-archive-received (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (and (fn2-boot-checkpoint-archive-owner-p id ogen *fn2-boot-state-checkpoint-archive-copy* fn2-core)
                  (equal (fn2-machine-stage id fn2-core) 12)
                  (equal (fn2-machine-pending id fn2-core) 1) (equal (fn2-machine-event-ready id fn2-core) 1)
                  (equal (fn2-machine-outcome id fn2-core) *fn2-outcome-done*)
                  (equal (fn2-machine-count id fn2-core) *fn2-commit-unit-bytes*))) (mv :state fn2-core)
    (stobj-let ((fn2-event-archive (fn2-core-event-archive fn2-core)) (fn2-checkpoints (fn2-core-checkpoints fn2-core))
      (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core)) (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core))
      (fn2-run-loads (fn2-core-run-loads fn2-core)) (fn2-run-cursors (fn2-core-run-cursors fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
     (code fn2-event-archive fn2-run-loads)
     (b* (((unless (fn2-event-archive-cold-read-current-p fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool))
            (mv :source fn2-event-archive fn2-run-loads))
          (c (fn2-b-event-archive-cursor-from-rows (fn2-run-loads-rows fn2-run-loads)))
          ((unless (and (equal (fn2-machine-offset id fn2-core) (fn2-event-archive-read-offset 1 fn2-event-archive))
                        (equal (fn2-machine-rx-slot id fn2-core) (fn2-event-archive-read-scratch 1 fn2-event-archive))
                        (equal (fn2-machine-rx-gen id fn2-core) (fn2-event-archive-read-scratch-gen 1 fn2-event-archive))
                        (equal (fn2-pool-fill (fn2-event-archive-read-scratch 1 fn2-event-archive) fn2-pool) *fn2-commit-unit-bytes*)))
           (mv :source fn2-event-archive fn2-run-loads))
          (fn2-run-loads (fn2-run-loads-set-phase c *fn2-run-load-phase-copy* fn2-run-loads))
          (fn2-event-archive (fn2-event-archive-set-read-armed 1 0 fn2-event-archive)))
      (mv :copy fn2-event-archive fn2-run-loads)) (mv code fn2-core))))
  (fn2-core-preserves fn2-boot-checkpoint-archive-received (id ogen fn2-core) :position 1 :rows nil)
  (defun fn2-boot-checkpoint-archive-check (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (fn2-boot-checkpoint-archive-owner-p id ogen *fn2-boot-state-checkpoint-archive-check* fn2-core)) (mv :state fn2-core)
    (fn2-boot-checkpoint-archive-check-raw fn2-core)))
  (fn2-core-preserves fn2-boot-checkpoint-archive-check (id ogen fn2-core) :position 1 :rows nil)))

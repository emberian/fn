     (code fn2-event-archive fn2-run-loads)
     (b* (((unless (fn2-event-archive-cold-read-current-p fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool))
            (mv :source fn2-event-archive fn2-run-loads))
          (c (fn2-b-event-archive-cursor-from-rows (fn2-run-loads-rows fn2-run-loads)))
          ((unless (and (equal (fn2-machine-offset id fn2-core) (fn2-event-archive-read-offset 1 fn2-event-archive))
                        (equal (fn2-machine-rx-slot id fn2-core) (fn2-event-archive-read-scratch 1 fn2-event-archive))
                        (equal (fn2-machine-rx-gen id fn2-core) (fn2-event-archive-read-scratch-gen 1 fn2-event-archive))
                        (equal (fn2-pool-fill (fn2-event-archive-read-scratch 1 fn2-event-archive) fn2-pool) *fn2-commit-unit-bytes*)))
           (mv :source fn2-event-archive fn2-run-loads))
          (fn2-run-loads (fn2-run-loads-set-phase c *fn2-run-load-phase-copy* fn2-run-loads))
          (fn2-event-archive (fn2-event-archive-set-read-armed 1 0 fn2-event-archive)))
      (mv :copy fn2-event-archive fn2-run-loads)) (mv code fn2-core))))
  (fn2-core-preserves fn2-boot-checkpoint-archive-received (id ogen fn2-core) :position 1 :rows nil)
  (defun fn2-boot-checkpoint-archive-check (id ogen fn2-core)

     ((:no-space :exhausted) (:next :refused) (:charge :steps *fn2-work-small* :runnable t)) (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:plan-reserve :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-plan-reserve-op) :accept (:more))
   (:do (code phase) (fn2-checkpoint-plan-phase-op))
   (:if (equal phase *fn2-checkpoint-plan-phase-validate*)
    ((:next :plan-validate) (:charge :steps *fn2-work-stage* :runnable t))
    ((:charge :steps *fn2-work-stage* :runnable t))))
  (:plan-validate :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-plan-validate-op) :accept () :case
    (((:more) (:charge :steps *fn2-work-stage* :runnable t))
     ((:closed) (:next :freeze) (:charge :steps *fn2-work-stage* :runnable t))
     ((:no-space :exhausted) (:next :refused) (:charge :steps *fn2-work-small* :runnable t)) (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:freeze :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-plan-freeze) :accept (:copy))
   (:set (map-role 2)) (:next :map-begin) (:charge :steps *fn2-work-stage* :runnable t))
  (:map-begin :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-map-begin row-map-role row-page-slot row-page-gen row-scratch-slot row-scratch-gen))
   (:next :map-source) (:charge :steps *fn2-work-small* :runnable t))
  (:map-source :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-map-source-step-op budget row-field-base) :accept () :case
    (((:more) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
     ((:yield) (:yield))
     ((:page) (:set (source 2)) (:next :page-bind) (:charge :steps *fn2-work-small* :runnable t))
     ((:done) (:if (equal row-map-role 2)
       ((:set (map-role 5)) (:next :map-begin) (:charge :steps *fn2-work-small* :runnable t))

     (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:allocation-source :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-allocation-step) :accept () :case
    (((:more) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
     ((:pending) (:idle))
     ((:staged) (:do (status count) (fn2-checkpoint-master-allocation-count-op row-token *fn2-checkpoint-master-kind* id row-generation))
      (:if (equal count 0)
       ((:next :allocation-empty) (:charge :steps *fn2-work-small* :runnable t))
       ((:next :allocation-submit) (:charge :steps *fn2-work-small* :runnable t))))
     (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:allocation-submit :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code batch event) (fn2-checkpoint-allocation-submit) :accept () :case
    (((:ok) (:set (batch batch) (event event)) (:next :allocation-wait) (:charge :steps *fn2-work-stage*))
     ((:exhausted) (:yield))
     (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:allocation-wait :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code batch event) (fn2-retirement-poll *fn2-checkpoint-master-kind* id row-generation) :accept () :case
    (((:pending) (:idle))
     ((:accepted) (:if (and (equal batch row-batch) (equal event row-event))
       ((:next :allocation-begin) (:charge :steps *fn2-work-stage* :runnable t))
       ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))))
     ((:refused) (:next :refused) (:charge :steps *fn2-work-small* :runnable t))
     (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:allocation-empty :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-allocation-finish-empty) :accept (:done))
   (:next :installation-begin) (:charge :steps *fn2-work-stage* :runnable t))
  (:installation-begin :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code candidate) (fn2-checkpoint-master-ready-op row-token *fn2-checkpoint-master-kind* id row-generation) :accept (:ready))
   (:do (code) (fn2-checkpoint-installation-begin candidate row-token *fn2-checkpoint-master-kind* id row-generation) :accept () :case
    (((:ok) (:next :installation-source) (:charge :steps *fn2-work-stage* :runnable t))

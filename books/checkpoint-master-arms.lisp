; The actual maintenance actor dispatches the existing bounded source leaves.
; No second page writer or host/caller completion flag exists in this machine.
(in-package "ACL2")
(include-book "checkpoint-master-rearm")
(include-book "checkpoint-teardown-sweep")
(include-book "checkpoint-teardown-cold-transfer")
(include-book "checkpoint-bank-transfer")
(include-book "checkpoint-metadata-driver")
(include-book "event-build-kind")
(include-book "checkpoint-summary-authority-live")
(include-book "checkpoint-live-adoption-rearm")
(include-book "checkpoint-directory-consume")
(fn2-book-layer :c)

(defmachine-arms fn2-checkpoint-master :declare
 :arms
 ((:idle :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:if *fn2-checkpoint-activation-qualified*
    ((:do (notify cleanup) (fn2-checkpoint-teardown-needed-op))
     (:if cleanup
      ((:do (begin) (fn2-checkpoint-teardown-sweep-begin-op id row-generation) :accept (:more))
       (:set (debt-scan 0) (scan 0)) (:next :teardown-select) (:charge :steps *fn2-work-stage* :runnable t))
      ((:do (code needed retirement) (fn2-checkpoint-master-pressure-op row-retirement-seen))
       (:if needed
        ((:set (scan 0) (highest 0) (candidate 0) (candidate-found 0))
         (:next :catalog) (:charge :steps *fn2-work-small* :runnable t))
        ((:park :checkpoint-needed))))))
    ((:next :disabled) (:charge :steps *fn2-work-small*))))
  (:disabled (:idle))
  (:catalog :on-refusal ((:next :admission-refused) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code scan highest candidate found checkpoint)
    (fn2-checkpoint-catalog-op row-scan row-highest row-candidate (equal row-candidate-found 1))
    :accept () :case
    (((:more) (:set (scan scan) (highest highest) (candidate candidate) (candidate-found (if found 1 0)))
       (:charge :steps *fn2-work-stage* :runnable t))
     ((:ready) (:set (candidate candidate) (checkpoint checkpoint)) (:next :snapshot-begin)
       (:charge :steps *fn2-work-stage* :runnable t)))))
  (:reserve :on-refusal ((:next :abort-empty) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-root1-reserve-op row-candidate row-token *fn2-checkpoint-master-kind* id row-generation)
    :effects ((:acquire (:storage-window :storage-window))))
   (:next :workspaces) (:charge :steps *fn2-work-stage* :runnable t))
  (:workspaces :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code page pgen scratch sgen read rgen)
    (fn2-checkpoint-root1-workspaces-op *fn2-checkpoint-master-kind* id row-generation))
   (:do (check row base) (fn2-checkpoint-writer-checker))
   (:set (page-slot page) (page-gen pgen) (scratch-slot scratch) (scratch-gen sgen)
         (read-slot read) (read-gen rgen) (field-base base))
   (:next :directory) (:charge :steps *fn2-work-small* :runnable t))
  (:snapshot-begin :on-refusal ((:next :admission-refused) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code token) (fn2-csnapshot-begin *fn2-checkpoint-master-kind* id row-generation))
   (:set (token token)) (:next :snapshot-poll) (:charge :steps *fn2-work-small* :runnable t))
  (:snapshot-poll :on-refusal ((:stop :checkpoint) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code cut event) (fn2-csnapshot-poll row-token *fn2-checkpoint-master-kind* id row-generation)
    :accept () :case (((:more) (:charge :steps *fn2-work-stage* :runnable t))
                     ((:held) (:do (retirement) (fn2-checkpoint-retirement-frontier-op))
                      (:set (covered cut) (attempt-retirement retirement)) (:next :reserve)
                      (:charge :steps *fn2-work-stage* :runnable t)))))
  (:directory :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-directory-op row-candidate row-token *fn2-checkpoint-master-kind* id row-generation)
    :accept () :case
    (((:ok) (:next :descriptor-begin) (:charge :steps *fn2-work-stage* :runnable t))
     ((:no-space) (:next :abort-snapshot) (:charge :steps *fn2-work-stage* :runnable t))
     (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:abort-empty :on-refusal ((:stop :checkpoint))
   (:do (code) (fn2-checkpoint-master-abort-empty-ready-op))
   (:do (code) (fn2-checkpoint-live-adoption-finish-op row-token *fn2-checkpoint-master-kind* id row-generation) :accept (:complete))
   (:set (pending 0) (token 0)) (:next :idle) (:charge :steps *fn2-work-small* :runnable t))
  (:abort-snapshot :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-master-abort-snapshot-ready-op))
   (:do (code) (fn2-csnapshot-release row-token *fn2-checkpoint-master-kind* id row-generation))
   (:next :abort-working) (:charge :steps *fn2-work-stage* :runnable t))
  (:abort-working :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-master-abort-step-op budget) :accept () :case
    (((:more) (:charge :steps *fn2-work-stage* :runnable t)) ((:yield) (:yield))
     ((:done) (:next :abort-complete) (:charge :steps *fn2-work-stage* :runnable t))
     (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:abort-complete :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-master-abort-complete-op))
   (:set (pending 0) (token 0)) (:next :idle) (:charge :steps *fn2-work-small* :runnable t))
  (:descriptor-begin :on-refusal ((:next :refused) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-build-begin-op row-checkpoint row-candidate row-token
    row-page-slot row-page-gen row-scratch-slot row-scratch-gen *fn2-checkpoint-master-kind* id row-generation))
   (:next :root1-begin) (:charge :steps *fn2-work-stage* :runnable t))
  (:root1-begin :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-root1-begin-op row-token *fn2-checkpoint-master-kind* id row-generation) :accept (:more)) (:next :root1-source) (:charge :steps *fn2-work-small* :runnable t))
  (:root1-source :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-root1-step-op budget *fn2-checkpoint-master-kind* id row-generation) :accept () :case
    (((:more) (:charge :bytes (+ *fn2-c-read-callback-bytes* 4096) :steps *fn2-work-stage* :runnable t)) ((:yield) (:yield)) ((:wait) (:idle))
     ((:page) (:set (source 1)) (:next :page-bind) (:charge :bytes (+ *fn2-c-read-callback-bytes* 4096) :steps *fn2-work-stage* :runnable t))
     ((:need-read) (:next :root1-read) (:charge :bytes (+ *fn2-c-read-callback-bytes* 4096) :steps *fn2-work-stage* :runnable t))
     ((:done) (:next :events-begin) (:charge :bytes (+ *fn2-c-read-callback-bytes* 4096) :steps *fn2-work-stage* :runnable t))
     ((:no-space :exhausted) (:next :refused) (:charge :bytes (+ *fn2-c-read-callback-bytes* 4096) :steps *fn2-work-stage* :runnable t)) (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:root1-read :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:if (and (natp budget) (< 0 budget))
    ((:issue (fn2-checkpoint-root1-read-op budget *fn2-checkpoint-master-kind* id row-generation) :ok ((:next :root1-source) (:wait :completion :bytes 4096 :steps *fn2-work-stage*))))
    ((:yield))))
  (:events-begin :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-events-begin row-token *fn2-checkpoint-master-kind* id row-generation row-page-slot row-page-gen row-scratch-slot row-scratch-gen row-read-slot row-read-gen)) (:next :events-source) (:charge :steps *fn2-work-small* :runnable t))
  (:events-source :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-events-step budget) :accept () :case
    (((:more) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t)) ((:yield) (:yield)) ((:wait) (:idle))
     ((:page) (:set (source 3)) (:next :page-bind) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
     ((:need-read) (:next :events-read) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
     ((:done) (:next :plan-begin) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
     ((:no-space :exhausted) (:next :refused) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t)) (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:events-read :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:if (and (natp budget) (< 0 budget))
    ((:issue (fn2-checkpoint-events-read) :ok ((:next :events-source) (:wait :completion :bytes 4096 :steps *fn2-work-stage*))))
    ((:yield))))
  (:page-bind :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:if (and (natp budget) (< 0 budget))
    ((:cond
     ((equal row-source 1) (:do (code) (fn2-checkpoint-root1-bind-op *fn2-checkpoint-master-kind* id row-generation))
      (:next :page-take) (:charge :steps *fn2-work-small* :runnable t))
     ((equal row-source 3) (:do (code) (fn2-checkpoint-events-bind))
      (:next :page-take) (:charge :steps *fn2-work-small* :runnable t))
     ((equal row-source 2) (:do (code) (fn2-checkpoint-map-bind-page-op))
      (:next :page-take) (:charge :steps *fn2-work-small* :runnable t))
     ((equal row-source 0) (:do (code) (fn2-checkpoint-build-bind-op budget))
      (:next :page-take) (:charge :steps *fn2-work-small* :runnable t))
     (t (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))))
    ((:yield))))
  (:page-take :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code target generation) (fn2-checkpoint-page-take) :effects ((:release (:storage-window))))
   (:set (target target) (target-gen generation)) (:next :page-wait)
   (:wake-row target) (:charge :steps *fn2-work-small*))
  (:page-wait (:next :page-accept-return) (:charge :steps *fn2-work-small* :runnable t))
  (:page-accept-return :on-refusal ((:next :loan-uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-page-accept-return *fn2-checkpoint-master-kind* id row-generation)
    :effects ((:acquire (:storage-window))) :accept () :case
    (((:ok) (:next :page-consume) (:charge :steps *fn2-work-small* :runnable t))
     ((:pending) (:idle))
     (:otherwise (:next :loan-uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:page-consume :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:cond
    ((equal row-source 1)
     (:do (code) (fn2-checkpoint-root1-consume-op budget *fn2-checkpoint-master-kind* id row-generation) :accept () :case
      (((:pending) (:idle)) ((:yield) (:yield))
       ((:more :done :ready) (:next :root1-source) (:charge :bytes (+ *fn2-c-read-callback-bytes* 4096) :steps *fn2-work-stage* :runnable t)) (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
    ((equal row-source 3)
     (:do (code) (fn2-checkpoint-events-consume) :accept () :case
      (((:pending) (:idle)) ((:yield) (:yield))
       ((:more :done :ready) (:next :events-source) (:charge :bytes (+ *fn2-c-read-callback-bytes* 4096) :steps *fn2-work-stage* :runnable t)) (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
    ((equal row-source 2)
     (:do (code) (fn2-checkpoint-map-consume-page-op) :accept () :case
      (((:pending) (:idle)) ((:yield) (:yield))
       ((:more :done :ready) (:next :map-source) (:charge :bytes (+ *fn2-c-read-callback-bytes* 4096) :steps *fn2-work-stage* :runnable t)) (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
    ((equal row-source 0)
     (:do (code) (fn2-checkpoint-build-consume-op budget) :accept () :case
      (((:pending) (:idle)) ((:yield) (:yield))
       ((:more :done :ready) (:next :barrier-begin) (:charge :bytes (+ *fn2-c-read-callback-bytes* 4096) :steps *fn2-work-stage* :runnable t)) (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
    (t (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))))
  (:plan-begin :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-plan-begin-op) :accept () :case
    (((:more) (:charge :steps *fn2-work-stage* :runnable t))
     ((:ok) (:next :plan-count) (:charge :steps *fn2-work-stage* :runnable t))
     ((:no-space :exhausted) (:next :refused) (:charge :steps *fn2-work-small* :runnable t)) (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:plan-count :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-plan-count-op) :accept () :case
    (((:more) (:charge :steps *fn2-work-stage* :runnable t))
     ((:counted) (:next :plan-size) (:charge :steps *fn2-work-stage* :runnable t))
     ((:no-space :exhausted) (:next :refused) (:charge :steps *fn2-work-small* :runnable t)) (:otherwise (:next :uncertain) (:charge :steps *fn2-work-small* :runnable t)))))
  (:plan-size :on-refusal ((:next :uncertain) (:charge :steps *fn2-work-small* :runnable t))
   (:do (code) (fn2-checkpoint-plan-size-op) :accept () :case
    (((:more) (:charge :steps *fn2-work-stage* :runnable t))

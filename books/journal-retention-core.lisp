; Events over actual C and B children. The reader's workspace belongs to its
; machine until terminal harvest or a completed close.
(in-package "ACL2")
(include-book "journal-retention")
(include-book "c-snapshot")
(include-book "storage-block-io")
(fn2-book-layer :c)

(defmacro fn2-journal-retention-core-events ()
 '(progn
 (fn2-csnapshot-op fn2-retained-journal-begin (token kind owner generation) 1
  (if (fn2-core-stopped-p fn2-core) (mv :stopped fn2-core)
   (stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core))
               (fn2-journal-lease (fn2-core-journal-lease fn2-core)))
    (code fn2-journal-lease)
    (fn2-journal-lease-begin token kind owner generation fn2-csnapshot fn2-journal-lease)
    (mv code fn2-core))))

 (fn2-csnapshot-op fn2-retained-journal-collect (token kind owner generation) 1
  (if (fn2-core-stopped-p fn2-core) (mv :stopped fn2-core)
   (b* (((mv code fn2-core)
         (stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core))
                     (fn2-journal-lease (fn2-core-journal-lease fn2-core))
                     (fn2-commit-root (fn2-core-commit-root fn2-core))
                     (fn2-extents (fn2-core-extents fn2-core))
                     (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
          (code fn2-journal-lease fn2-extents fn2-alloc-edges)
          (fn2-journal-lease-claim token kind owner generation *fn2-commit-kind* fn2-csnapshot fn2-journal-lease
           fn2-commit-root fn2-extents fn2-alloc-edges)
          (mv code fn2-core)))
        ((unless (eq code :ready)) (mv code fn2-core))
        ((mv release fn2-core) (fn2-csnapshot-release token kind owner generation fn2-core)))
    (mv (if (eq release :ok) :ready release) fn2-core))))

 (fn2-csnapshot-op fn2-retained-journal-open (token kind owner generation slot gen) 1
  (cond ((fn2-core-stopped-p fn2-core) (mv :stopped fn2-core))
        ((stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core))) (owns)
          (fn2-csnapshot-ownerp token kind owner generation fn2-csnapshot) owns)
         (mv :snapshot fn2-core))
        (t
   (stobj-let ((fn2-journal-lease (fn2-core-journal-lease fn2-core))
               (fn2-event-read (fn2-core-event-read fn2-core))
               (fn2-commit-root (fn2-core-commit-root fn2-core))
               (fn2-extents (fn2-core-extents fn2-core))
               (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))
               (fn2-origin (fn2-core-origin fn2-core))
               (fn2-fc (fn2-core-fc fn2-core))
               (fn2-digests (fn2-core-digests fn2-core))
               (fn2-mk (fn2-core-mk fn2-core))
               (fn2-pool (fn2-core-pool fn2-core)))
    (code fn2-event-read fn2-mk)
    (b* (((unless (and (fn2-journal-lease-ownerp token kind owner generation fn2-journal-lease)
                       (= (fn2-journal-lease-phase 0 fn2-journal-lease) *fn2-journal-lease-phase-ready*)
                       (< 0 (fn2-event-read-rows fn2-event-read))))
         (mv :owner fn2-event-read fn2-mk))
        (phase (fn2-event-read-phase 0 fn2-event-read))
        (start (= phase *fn2-event-read-phase-idle*))
        ((unless (or start
                     (and (= phase *fn2-event-read-phase-next*)
                          (equal token (fn2-event-read-token 0 fn2-event-read))
                          (equal kind (fn2-event-read-owner-kind 0 fn2-event-read))
                          (equal owner (fn2-event-read-owner-slot 0 fn2-event-read))
                          (equal generation (fn2-event-read-owner-gen 0 fn2-event-read))
                          (equal slot (fn2-event-read-slot 0 fn2-event-read))
                          (equal gen (fn2-event-read-gen 0 fn2-event-read))
                          (= 0 (fn2-event-read-pending 0 fn2-event-read)))))
         (mv :busy fn2-event-read fn2-mk))
        (cut (fn2-journal-lease-cut-commit 0 fn2-journal-lease))
        (event (fn2-journal-lease-cut-event 0 fn2-journal-lease))
        ((when (and start (= cut 0))) (mv :complete fn2-event-read fn2-mk))
        (commit (if start 1 (+ 1 (fn2-event-read-commit 0 fn2-event-read))))
        ((mv code extent epoch allocation first members & &)
         (fn2-journal-lease-source token kind owner generation commit *fn2-commit-kind*
          fn2-journal-lease fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests))
        ((unless (eq code :ok)) (mv code fn2-event-read fn2-mk))
        (checker (fn2-b-event-row (fn2-fc-rows fn2-fc)))
        (base (* 128 checker))
        (leaf (fn2-b-event-leaf-digest (fn2-fc-rows fn2-fc) (fn2-extents-rows fn2-extents)))
        (history (fn2-origin-history fn2-origin))
        (incarnation (fn2-origin-history-incarnation fn2-origin))
        ((unless (and (fn2-origin-physicalp history incarnation)
                       (unsigned-byte-p 60 token) (unsigned-byte-p 8 kind)
                       (unsigned-byte-p 32 owner) (unsigned-byte-p 60 generation)
                       (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen)
                       (unsigned-byte-p 60 commit) (unsigned-byte-p 32 extent)
                       (unsigned-byte-p 60 epoch) (unsigned-byte-p 60 allocation)
                       (unsigned-byte-p 60 first) (unsigned-byte-p 32 members)
                       (unsigned-byte-p 32 checker) (unsigned-byte-p 32 base) (unsigned-byte-p 32 leaf)
                       (< checker (fn2-fc-rows fn2-fc))
                       (equal (fn2-fc-phase checker fn2-fc) *fn2-fc-phase-idle*)
                       (fn2-mk-ready checker fn2-mk fn2-digests)
                       (fn2-digest-rowp leaf fn2-digests)
                       (equal first (if start 1 (fn2-event-read-next-event 0 fn2-event-read)))
                       (eq (fn2-pool-workspace-code slot gen kind owner generation fn2-pool) :ok)
                       (<= *fn2-commit-unit-bytes* (fn2-pool-cap slot fn2-pool))))
         (mv :state fn2-event-read fn2-mk))
        (fn2-mk (if start (fn2-mk-init checker fn2-mk) fn2-mk))
        (fn2-event-read (fn2-event-read-put 0
          (phase *fn2-event-read-phase-read-seal*)
          (token token) (owner-kind kind) (owner-slot owner) (owner-gen generation)
          (cut-commit cut) (cut-event event) (commit commit) (next-event first)
          (extent extent) (epoch epoch) (allocation allocation) (first first) (members members)
          (slot slot) (gen gen) (checker checker) (field-base base) (leaf-digest leaf)
          (body-off 0) (body-len 0) (pending 0) (history history) (history-incarnation incarnation))))
     (mv :ok fn2-event-read fn2-mk))
    (mv code fn2-core)))))

 (fn2-csnapshot-op fn2-retained-journal-issue (token kind owner generation) 1
  (if (fn2-core-stopped-p fn2-core) (mv :stopped fn2-core)
   (stobj-let ((fn2-journal-lease (fn2-core-journal-lease fn2-core))
               (fn2-event-read (fn2-core-event-read fn2-core))
               (fn2-extents (fn2-core-extents fn2-core))
               (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))
               (fn2-pool (fn2-core-pool fn2-core))
               (fn2-ops (fn2-core-ops fn2-core))
               (fn2-control (fn2-core-control fn2-core)))
    (code fn2-event-read fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control)
    (b* (((unless (and (fn2-journal-lease-ownerp token kind owner generation fn2-journal-lease)
                       (= (fn2-journal-lease-phase 0 fn2-journal-lease) *fn2-journal-lease-phase-ready*)
                       (< 0 (fn2-event-read-rows fn2-event-read))
                       (equal token (fn2-event-read-token 0 fn2-event-read))
                       (equal kind (fn2-event-read-owner-kind 0 fn2-event-read))
                       (equal owner (fn2-event-read-owner-slot 0 fn2-event-read))
                       (equal generation (fn2-event-read-owner-gen 0 fn2-event-read))
                       (= 0 (fn2-event-read-pending 0 fn2-event-read))))
         (mv :owner fn2-event-read fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control))
        (phase (fn2-event-read-phase 0 fn2-event-read))
        (seal (= phase *fn2-event-read-phase-read-seal*))
        (extent (fn2-event-read-extent 0 fn2-event-read))
        (epoch (fn2-event-read-epoch 0 fn2-event-read))
        (allocation (fn2-event-read-allocation 0 fn2-event-read))
        (edge (fn2-journal-lease-edge extent fn2-extents fn2-alloc-edges))
        ((unless (and (or seal (= phase *fn2-event-read-phase-read-records*))
                       (fn2-alloc-edge-slotp edge fn2-alloc-edges)
                       (fn2-alloc-edge-matchesp edge token extent epoch allocation :promised-read fn2-alloc-edges)))
         (mv :source fn2-event-read fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control))
        ((mv code op opgen fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges)
         (fn2-block-read-children (+ (* extent *fn2-storage-extent-units*) (if seal 2 1))
          epoch allocation 0 *fn2-commit-unit-bytes*
          (fn2-event-read-slot 0 fn2-event-read) (fn2-event-read-gen 0 fn2-event-read)
          kind owner generation 0 fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control))
        ((unless (eq code :ok)) (mv code fn2-event-read fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control))
        (fn2-event-read (fn2-event-read-put 0 (pending 1) (op-slot op) (op-gen opgen)
          (phase (if seal *fn2-event-read-phase-wait-seal* *fn2-event-read-phase-wait-records*)))))
     (mv :ok fn2-event-read fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control))
    (mv code fn2-core))))

 ; The verifier uses these indices in ACL2 at the same turn as its read
 ; state. Neither a caller-provided digest nor a frame can select a seal.
 (defun fn2-retained-journal-seals (token kind owner generation fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))
              (fn2-journal-lease (fn2-core-journal-lease fn2-core))
              (fn2-commit-root (fn2-core-commit-root fn2-core))
              (fn2-extents (fn2-core-extents fn2-core))
              (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))
              (fn2-fc (fn2-core-fc fn2-core))
              (fn2-digests (fn2-core-digests fn2-core)))
   (code seal previous)
   (b* (((unless (and (< 0 (fn2-event-read-rows fn2-event-read))
                      (equal token (fn2-event-read-token 0 fn2-event-read))
                      (equal kind (fn2-event-read-owner-kind 0 fn2-event-read))
                      (equal owner (fn2-event-read-owner-slot 0 fn2-event-read))
                      (equal generation (fn2-event-read-owner-gen 0 fn2-event-read))
                      (not (= (fn2-event-read-phase 0 fn2-event-read) *fn2-event-read-phase-idle*))))
         (mv :owner 0 0))
        ((mv code extent epoch allocation first members seal previous)
         (fn2-journal-lease-source token kind owner generation (fn2-event-read-commit 0 fn2-event-read) *fn2-commit-kind*
          fn2-journal-lease fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests))
        ((unless (eq code :ok)) (mv code 0 0))
        ((unless (and (equal extent (fn2-event-read-extent 0 fn2-event-read))
                      (equal epoch (fn2-event-read-epoch 0 fn2-event-read))
                      (equal allocation (fn2-event-read-allocation 0 fn2-event-read))
                      (equal first (fn2-event-read-first 0 fn2-event-read))
                      (equal members (fn2-event-read-members 0 fn2-event-read))))
         (mv :source 0 0)))
    (mv :ok seal previous))
   (mv code seal previous)))

 ; Close first excludes new reads, then waits for the exact terminal
 ; completion. A caller cannot return the workspace to the pool before DONE.
 (fn2-csnapshot-op fn2-retained-journal-close (token kind owner generation) 1
  (if (fn2-core-stopped-p fn2-core) (mv :stopped fn2-core)
   (b* (((mv code fn2-core)
         (stobj-let ((fn2-journal-lease (fn2-core-journal-lease fn2-core))
                     (fn2-event-read (fn2-core-event-read fn2-core))
                     (fn2-extents (fn2-core-extents fn2-core))
                     (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
          (code fn2-journal-lease fn2-event-read fn2-extents fn2-alloc-edges)
          (b* (((mv code fn2-journal-lease)
                (fn2-journal-lease-close-start token kind owner generation fn2-journal-lease))
               ((unless (eq code :ok)) (mv code fn2-journal-lease fn2-event-read fn2-extents fn2-alloc-edges))
               ((when (and (< 0 (fn2-event-read-rows fn2-event-read))
                           (= 1 (fn2-event-read-pending 0 fn2-event-read))))
                (mv :drain fn2-journal-lease fn2-event-read fn2-extents fn2-alloc-edges))
               ((mv code fn2-journal-lease fn2-extents fn2-alloc-edges)
                (fn2-journal-lease-close-step token kind owner generation fn2-journal-lease fn2-extents fn2-alloc-edges))
               (fn2-event-read (if (and (eq code :done) (< 0 (fn2-event-read-rows fn2-event-read)))
                   (fn2-event-read-set-phase 0 *fn2-event-read-phase-idle* fn2-event-read)
                 fn2-event-read)))
           (mv code fn2-journal-lease fn2-event-read fn2-extents fn2-alloc-edges))
          (mv code fn2-core)))
        ((unless (eq code :done)) (mv code fn2-core))
        (owns-cut (stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core))) (owns)
                    (fn2-csnapshot-ownerp token kind owner generation fn2-csnapshot) owns))
        ((mv released fn2-core)
         (if owns-cut (fn2-csnapshot-release token kind owner generation fn2-core)
            (mv :ok fn2-core)))
        ((unless (eq released :ok)) (mv released fn2-core)))
    (stobj-let ((fn2-journal-lease (fn2-core-journal-lease fn2-core))) (fn2-journal-lease)
     (if (< 0 (fn2-journal-lease-rows fn2-journal-lease))
         (fn2-journal-lease-set-phase 0 *fn2-journal-lease-phase-idle* fn2-journal-lease)
       fn2-journal-lease)
     (mv :done fn2-core)))))))


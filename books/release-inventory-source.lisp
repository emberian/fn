; Frozen unfinished RELEASE inventory. Count pass visits E ascending; encoding
; visits E descending and fills ascending fixed slots, permitting real child
; hashes without a second allocator/index or whole-state validation per turn.
(in-package "ACL2")
(include-book "release-inventory-state")
(include-book "release-inventory-format")
(include-book "release-evidence")
(include-book "c-snapshot")
(include-book "checkpoint-page-header")
(include-book "checkpoint-linked-header")
(include-book "checkpoint-source-retention")
(include-book "checkpoint-page-io")
(include-book "runs-page")
(fn2-book-layer :c)

(defun fn2-release-inventory-output-carriers (outputs n)
 (declare (xargs :verify-guards nil))
 (if (atom outputs) nil
  (cons (list (car outputs) n :prefix (concatenate 'string "-" (subseq (symbol-name (car outputs)) 4)))
        (fn2-release-inventory-output-carriers (cdr outputs) (+ 1 n)))))
(defun fn2-release-inventory-row-specs (outputs n)
 (declare (xargs :verify-guards nil))
 (if (atom outputs) nil
  (cons (list (concatenate 'string "-" (subseq (symbol-name (car outputs)) 4) "-ROWS")
              (fn2-columns-sym (car outputs) "-ROWS") n :frame (car outputs))
        (fn2-release-inventory-row-specs (cdr outputs) (+ 1 n)))))
(defmacro fn2-release-inventory-operation (name scalars inputs outputs body)
 (let* ((typed (fn2-columns-carrier-hyps (pairlis$ inputs nil)))
        (carriers (fn2-release-inventory-output-carriers (cdr outputs) 2)))
 `(progn
   (defun ,name (,@scalars ,@inputs)
    (declare (xargs :stobjs ,inputs :verify-guards nil :guard (and ,@typed)))
    ,body)
   (fn2-release-inventory-build-preserves ,name (,@scalars ,@inputs)
    :position 1 :hyps ,typed
    :specs ,(append (fn2-columns-carrier-specs carriers)
                    (fn2-release-inventory-row-specs (cdr outputs) 2))))))

(defun fn2-release-inventory-subject-p (fn2-release-inventory-build fn2-csnapshot fn2-checkpoints)
 (declare (xargs :stobjs (fn2-release-inventory-build fn2-csnapshot fn2-checkpoints)
  :guard (and (fn2-release-inventory-buildp fn2-release-inventory-build) (fn2-release-inventory-build-wfp fn2-release-inventory-build)
              (fn2-csnapshotp fn2-csnapshot) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints))))
 (and (= (fn2-release-inventory-build-rows fn2-release-inventory-build) 1)
  (let ((token (fn2-release-inventory-build-token 0 fn2-release-inventory-build))
        (kind (fn2-release-inventory-build-owner-kind 0 fn2-release-inventory-build))
        (owner (fn2-release-inventory-build-owner-slot 0 fn2-release-inventory-build))
        (gen (fn2-release-inventory-build-owner-gen 0 fn2-release-inventory-build))
        (c (fn2-release-inventory-build-candidate 0 fn2-release-inventory-build)))
   (and (fn2-csnapshot-ownerp token kind owner gen fn2-csnapshot)
        (= (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-held*)
        (fn2-checkpoint-builder-claimp c token kind owner gen fn2-checkpoints)
        (= (fn2-release-inventory-build-cut-commit 0 fn2-release-inventory-build) (fn2-csnapshot-cut-commit 0 fn2-csnapshot))
        (= (fn2-release-inventory-build-cut-event 0 fn2-release-inventory-build) (fn2-csnapshot-cut-event 0 fn2-csnapshot))
        (= (fn2-release-inventory-build-history 0 fn2-release-inventory-build) (fn2-checkpoints-history c fn2-checkpoints))
        (= (fn2-release-inventory-build-incarnation 0 fn2-release-inventory-build) (fn2-checkpoints-incarnation c fn2-checkpoints))))))
(defun fn2-release-inventory-owner-p (fn2-release-inventory-build fn2-csnapshot fn2-checkpoints fn2-extents)
 (declare (xargs :stobjs (fn2-release-inventory-build fn2-csnapshot fn2-checkpoints fn2-extents)
  :guard (and (fn2-release-inventory-buildp fn2-release-inventory-build) (fn2-release-inventory-build-wfp fn2-release-inventory-build)
              (fn2-csnapshotp fn2-csnapshot) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints)
              (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents))))
 (and (fn2-release-inventory-subject-p fn2-release-inventory-build fn2-csnapshot fn2-checkpoints)
  (let ((token (fn2-release-inventory-build-token 0 fn2-release-inventory-build))
        (kind (fn2-release-inventory-build-owner-kind 0 fn2-release-inventory-build))
        (owner (fn2-release-inventory-build-owner-slot 0 fn2-release-inventory-build))
        (gen (fn2-release-inventory-build-owner-gen 0 fn2-release-inventory-build))
        (c (fn2-release-inventory-build-candidate 0 fn2-release-inventory-build)))
   (and (fn2-checkpoint-builder-ownerp c token kind owner gen fn2-checkpoints)
        (= (fn2-release-inventory-build-rows-count 0 fn2-release-inventory-build) (fn2-extents-rows fn2-extents))
        (member-equal (fn2-alloc-freeze-phase fn2-extents) '(0 1 2 3))
        (= (fn2-alloc-freeze-token fn2-extents) token)
        (= (fn2-alloc-freeze-owner-kind fn2-extents) kind)
        (= (fn2-alloc-freeze-owner-slot fn2-extents) owner)
        (= (fn2-alloc-freeze-owner-gen fn2-extents) gen)))))

; ROWS is already the table row-count accessor. The retained dimension column
; is called ROWS-COUNT to keep those identities distinct in generated code.

; This checks one source row. SETTLED intentionally never reads its historical
; target's current allocator tuple: a later allocation may already own it.
(defun fn2-release-inventory-row-code (journal cut cut-event fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
 (declare (xargs :stobjs (fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)
  :guard (and (fn2-release-evidencep fn2-release-evidence) (fn2-release-evidence-wfp fn2-release-evidence)
              (fn2-release-evidence-candidatesp fn2-release-evidence-candidates) (fn2-release-evidence-candidates-wfp fn2-release-evidence-candidates)
              (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents) (fn2-alloc-edgesp fn2-alloc-edges) (fn2-alloc-edges-wfp fn2-alloc-edges)
              (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops) (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints))))
 (b* (((unless (and (natp journal) (< journal (fn2-release-evidence-rows fn2-release-evidence))
                    (unsigned-byte-p 60 cut) (unsigned-byte-p 60 cut-event))) :state)
      ((when (= (fn2-release-evidence-live journal fn2-release-evidence) 0)) :skip)
      (batch (fn2-release-evidence-batch journal fn2-release-evidence))
      ((when (> batch cut)) :skip)
      (phase (fn2-release-evidence-phase journal fn2-release-evidence))
      ((unless (and (member-equal phase (list *fn2-release-evidence-phase-persisted* *fn2-release-evidence-phase-settled*))
                    (fn2-origin-physicalp (fn2-release-evidence-journal-history journal fn2-release-evidence) (fn2-release-evidence-journal-incarnation journal fn2-release-evidence))
                    (fn2-origin-physicalp (fn2-release-evidence-installation-history journal fn2-release-evidence) (fn2-release-evidence-installation-incarnation journal fn2-release-evidence))
                    (posp (fn2-release-evidence-event journal fn2-release-evidence))
                    (<= (fn2-release-evidence-event journal fn2-release-evidence) cut-event)
                    (< (fn2-release-evidence-installation-event journal fn2-release-evidence) (fn2-release-evidence-event journal fn2-release-evidence))
                    (fn2-release-evidence-row-owned-p journal
                     (fn2-release-evidence-journal-epoch journal fn2-release-evidence)
                     (fn2-release-evidence-journal-allocation journal fn2-release-evidence) batch
                     fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints))) :evidence)
      ((when (= phase *fn2-release-evidence-phase-settled*)) :settled)
      (e (fn2-release-evidence-extent journal fn2-release-evidence))
      (retirement (fn2-release-evidence-retirement journal fn2-release-evidence)))
  (if (and (posp retirement) (<= retirement (fn2-release-evidence-cut-commit journal fn2-release-evidence))
           (eq (fn2-alloc-handle-code e (fn2-release-evidence-epoch journal fn2-release-evidence)
                 (fn2-release-evidence-allocation journal fn2-release-evidence) fn2-extents) :ok)
           (= (fn2-extents-state e fn2-extents) *fn2-extent-state-retire-pending*)
           (= (fn2-extents-retirement e fn2-extents) retirement)
           (not (= e journal)) (not (= e (fn2-release-evidence-installation-extent journal fn2-release-evidence)))
           (not (= e (floor (fn2-release-evidence-physical-unit journal fn2-release-evidence) *fn2-storage-extent-units*))))
      :pending :identity)))

(fn2-release-inventory-operation fn2-release-inventory-begin
 (c token slot gen scratch sgen kind owner ogen)
 (fn2-release-inventory-build fn2-csnapshot fn2-checkpoints fn2-extents fn2-pool)
 (fn2-release-inventory-build)
 (b* (((unless (and (= (fn2-release-inventory-build-rows fn2-release-inventory-build) 1)
                    (= (fn2-release-inventory-build-phase 0 fn2-release-inventory-build) *fn2-release-inventory-build-phase-idle*)
                    (fn2-csnapshot-ownerp token kind owner ogen fn2-csnapshot)
                    (= (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-held*)
                    (fn2-checkpoint-builder-ownerp c token kind owner ogen fn2-checkpoints)
                    (= (fn2-alloc-freeze-phase fn2-extents) 0)
                    (= (fn2-alloc-freeze-token fn2-extents) token)
                    (= (fn2-alloc-freeze-owner-kind fn2-extents) kind)
                    (= (fn2-alloc-freeze-owner-slot fn2-extents) owner)
                    (= (fn2-alloc-freeze-owner-gen fn2-extents) ogen)
                    (fn2-origin-physicalp (fn2-checkpoints-history c fn2-checkpoints) (fn2-checkpoints-incarnation c fn2-checkpoints))
                    (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen) (unsigned-byte-p 32 scratch) (unsigned-byte-p 60 sgen)
                    (not (= slot scratch))
                    (eq (fn2-pool-workspace-code slot gen kind owner ogen fn2-pool) :ok)
                    (eq (fn2-pool-workspace-code scratch sgen kind owner ogen fn2-pool) :ok)
                    (<= *fn2-format-page-size* (fn2-pool-cap slot fn2-pool)) (<= 32 (fn2-pool-cap scratch fn2-pool))))
       (mv :source fn2-release-inventory-build))
      ; The job owns exactly one idle row. Initialize its declared local state,
      ; not any E row or global allocation/proof table.
      (fn2-release-inventory-build (fn2-release-inventory-build-init 1 fn2-release-inventory-build))
      (fn2-release-inventory-build (fn2-release-inventory-build-put 0
       (phase *fn2-release-inventory-build-phase-scan*) (token token)
       (owner-kind kind) (owner-slot owner) (owner-gen ogen) (candidate c)
       (cut-commit (fn2-csnapshot-cut-commit 0 fn2-csnapshot)) (cut-event (fn2-csnapshot-cut-event 0 fn2-csnapshot))
       (history (fn2-checkpoints-history c fn2-checkpoints)) (incarnation (fn2-checkpoints-incarnation c fn2-checkpoints))
       (slot slot) (gen gen) (scratch scratch) (scratch-gen sgen)
       (rows-count (fn2-extents-rows fn2-extents)) (cursor (fn2-extents-rows fn2-extents)))))
  (mv :ok fn2-release-inventory-build)))

; One source declaration owns every numeric encoder field; no pool identity,
; runtime candidate index or caller-selected scalar is substituted here.
(defconst *fn2-release-inventory-numeric-bindings*
 '((journal-history journal-history) (journal-incarnation journal-incarnation)
   (journal-extent :row) (journal-writer-epoch journal-epoch) (journal-allocation journal-allocation)
   (commit batch) (event event) (extent extent) (writer-epoch epoch) (allocation allocation)
   (retirement-commit retirement) (checkpoint checkpoint) (cut-commit cut-commit) (cut-event cut-event)
   (history history) (incarnation incarnation) (installation-commit installation-commit)
   (installation-event installation-event) (installation-history installation-history)
   (installation-incarnation installation-incarnation) (installation-extent installation-extent)
   (installation-writer-epoch installation-epoch) (installation-allocation installation-allocation)
   (descriptor-storage-domain storage-domain) (descriptor-physical-unit physical-unit)
   (descriptor-writer-epoch descriptor-epoch) (descriptor-allocation descriptor-allocation)
   (descriptor-page-kind page-kind) (descriptor-encoded-length encoded-length)))
(defun fn2-release-inventory-store-forms (bindings)
 (declare (xargs :verify-guards nil))
 (if (atom bindings) nil
  (cons `(fn2-fields (fn2-fields-set-value
          (+ base ,(fn2-columns-sym '*fn2-release-inventory-entry-field (concatenate 'string "-" (symbol-name (caar bindings)) "*")))
          ,(if (eq (cadar bindings) :row) 'journal
            `(,(fn2-columns-sym 'fn2-release-evidence (concatenate 'string "-" (symbol-name (cadar bindings)))) journal fn2-release-evidence)) fn2-fields))
        (fn2-release-inventory-store-forms (cdr bindings)))))
(defmacro fn2-release-inventory-store-numerics ()
 `(let* ,(fn2-release-inventory-store-forms *fn2-release-inventory-numeric-bindings*) fn2-fields))
(defun fn2-release-inventory-word-cases (i)
 (declare (xargs :verify-guards nil :measure (nfix (- 8 (nfix i)))))
 (if (>= (nfix i) 8) nil
  (cons (list i (list (fn2-columns-sym 'fn2-release-evidence (concatenate 'string "-H" (coerce (explode-atom i 10) 'string))) 'journal 'fn2-release-evidence))
        (fn2-release-inventory-word-cases (+ 1 (nfix i))))))
(defmacro fn2-release-inventory-word-event ()
 `(defun fn2-release-inventory-descriptor-word (journal i fn2-release-evidence)
   (declare (xargs :stobjs fn2-release-evidence
    :guard (and (fn2-release-evidencep fn2-release-evidence) (fn2-release-evidence-wfp fn2-release-evidence)
                (natp journal) (< journal (fn2-release-evidence-rows fn2-release-evidence)) (natp i) (< i 8))))
   (case i ,@(fn2-release-inventory-word-cases 0) (otherwise 0))))
(fn2-release-inventory-word-event)
(defun fn2-release-inventory-store-hash (left i journal scratch sgen kind owner gen fn2-release-evidence fn2-pool)
 (declare (xargs :stobjs (fn2-release-evidence fn2-pool) :verify-guards nil :measure (nfix left)
  :guard (and (fn2-release-evidencep fn2-release-evidence) (fn2-release-evidence-wfp fn2-release-evidence)
              (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))))
 (if (zp left) (mv :ok fn2-pool)
  (if (not (and (natp journal) (< journal (fn2-release-evidence-rows fn2-release-evidence))
                 (natp i) (< i 32))) (mv :bounds fn2-pool)
   (let* ((word (fn2-release-inventory-descriptor-word journal (floor i 4) fn2-release-evidence))
          (byte (logand 255 (ash word (- (* 8 (mod i 4)))))))
    (mv-let (code fn2-pool) (fn2-pool-write scratch sgen i byte kind owner gen fn2-pool)
     (if (not (eq code :ok)) (mv code fn2-pool)
      (fn2-release-inventory-store-hash (- left 1) (+ i 1) journal scratch sgen kind owner gen fn2-release-evidence fn2-pool)))))))

(fn2-release-inventory-operation fn2-release-inventory-pack-entry
 (journal ordinal base)
 (fn2-release-inventory-build fn2-release-evidence fn2-release-evidence-candidates fn2-csnapshot fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops fn2-fields fn2-pool)
 (fn2-release-inventory-build fn2-fields fn2-pool)
 (b* (((unless (and (natp journal) (natp ordinal) (fn2-release-inventory-owner-p fn2-release-inventory-build fn2-csnapshot fn2-checkpoints fn2-extents)
                    (= (fn2-release-inventory-build-phase 0 fn2-release-inventory-build) *fn2-release-inventory-build-phase-entries*)
                    (posp (fn2-release-inventory-build-cursor 0 fn2-release-inventory-build))
                    (= journal (- (fn2-release-inventory-build-cursor 0 fn2-release-inventory-build) 1))
                    (posp (fn2-release-inventory-build-remaining 0 fn2-release-inventory-build))
                    (= ordinal (- (fn2-release-inventory-build-remaining 0 fn2-release-inventory-build) 1))
                    (<= (fn2-release-inventory-build-first 0 fn2-release-inventory-build) ordinal)
                    (< ordinal (fn2-release-inventory-build-end 0 fn2-release-inventory-build))
                    (eq (fn2-release-inventory-row-code journal (fn2-release-inventory-build-cut-commit 0 fn2-release-inventory-build)
                         (fn2-release-inventory-build-cut-event 0 fn2-release-inventory-build)
                         fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints) :pending)
                    (natp base) (<= (+ base *fn2-release-inventory-entry-num-fields*) (fn2-fields-rows fn2-fields))))
       (mv :source fn2-release-inventory-build fn2-fields fn2-pool))
      (slot (fn2-release-inventory-build-slot 0 fn2-release-inventory-build)) (gen (fn2-release-inventory-build-gen 0 fn2-release-inventory-build))
      (scratch (fn2-release-inventory-build-scratch 0 fn2-release-inventory-build)) (sgen (fn2-release-inventory-build-scratch-gen 0 fn2-release-inventory-build))
      (kind (fn2-release-inventory-build-owner-kind 0 fn2-release-inventory-build))
      (owner (fn2-release-inventory-build-owner-slot 0 fn2-release-inventory-build)) (ogen (fn2-release-inventory-build-owner-gen 0 fn2-release-inventory-build))
      (off (+ *fn2-checkpoint-map-entries-start* (* (mod ordinal *fn2-release-inventory-slots*) *fn2-release-inventory-entry-width*)))
      ((unless (and (eq (fn2-pool-workspace-code slot gen kind owner ogen fn2-pool) :ok)
                    (eq (fn2-pool-workspace-code scratch sgen kind owner ogen fn2-pool) :ok)
                    (<= (+ off *fn2-release-inventory-entry-width*) *fn2-format-page-size*)))
       (mv :owner fn2-release-inventory-build fn2-fields fn2-pool))
      ((mv reset fn2-pool) (fn2-pool-reset scratch sgen kind owner ogen fn2-pool))
      ((unless (eq reset :ok)) (mv reset fn2-release-inventory-build fn2-fields fn2-pool))
      ((mv hashed fn2-pool) (fn2-release-inventory-store-hash 32 0 journal scratch sgen kind owner ogen fn2-release-evidence fn2-pool))
      ((unless (eq hashed :ok)) (mv hashed fn2-release-inventory-build fn2-fields fn2-pool))
      (fn2-fields (fn2-release-inventory-store-numerics))
      (fn2-fields (fn2-fields-put (+ base *fn2-release-inventory-entry-field-descriptor-expected-hash*)
       (value 1) (ref-slot scratch) (ref-gen sgen) (ref-off 0) (ref-len 32)))
      ((mv code next fn2-pool) (fn2-release-inventory-entry-encode base slot gen off kind owner ogen fn2-fields fn2-pool))
      ((unless (and (eq code :ok) (<= next (+ off *fn2-release-inventory-entry-width*))))
       (mv :format fn2-release-inventory-build fn2-fields fn2-pool))
      (fn2-release-inventory-build (fn2-release-inventory-build-put 0
       (cursor journal) (remaining ordinal)
       (phase (if (= ordinal (fn2-release-inventory-build-first 0 fn2-release-inventory-build))
                  *fn2-release-inventory-build-phase-header* *fn2-release-inventory-build-phase-entries*)))))
  (mv :more fn2-release-inventory-build fn2-fields fn2-pool)))

(fn2-release-inventory-operation fn2-release-inventory-claim-pending (journal)
 (fn2-release-inventory-build fn2-release-evidence fn2-release-evidence-candidates fn2-csnapshot fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)
 (fn2-release-inventory-build fn2-extents fn2-alloc-edges)
 (b* (((unless (and (fn2-release-inventory-owner-p fn2-release-inventory-build fn2-csnapshot fn2-checkpoints fn2-extents)
                    (= (fn2-alloc-freeze-phase fn2-extents) 0)
                    (eq (fn2-release-inventory-row-code journal
                         (fn2-release-inventory-build-cut-commit 0 fn2-release-inventory-build)
                         (fn2-release-inventory-build-cut-event 0 fn2-release-inventory-build)
                         fn2-release-evidence fn2-release-evidence-candidates fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints) :pending)))
       (mv :source fn2-release-inventory-build fn2-extents fn2-alloc-edges))
      (c (fn2-release-inventory-build-candidate 0 fn2-release-inventory-build))
      (checkpoint (fn2-checkpoints-checkpoint c fn2-checkpoints))
      (descriptor (floor (fn2-release-evidence-physical-unit journal fn2-release-evidence) *fn2-storage-extent-units*))
      (installation (fn2-release-evidence-installation-extent journal fn2-release-evidence))
      ; Ordinary durable claim admission must win for every proof resource.
      ; An old proof in RETIRE_PENDING is an actionable refusal, not a bypass.
      ((unless (and (= (fn2-extents-state descriptor fn2-extents) *fn2-extent-state-allocated*)
                    (= (fn2-extents-state installation fn2-extents) *fn2-extent-state-allocated*)
                    (= (fn2-extents-state journal fn2-extents) *fn2-extent-state-allocated*)))
       (mv :retired fn2-release-inventory-build fn2-extents fn2-alloc-edges))
      ((mv dcode fn2-extents fn2-alloc-edges)
       (fn2-checkpoint-source-claim c checkpoint descriptor
        (fn2-release-evidence-descriptor-epoch journal fn2-release-evidence)
        (fn2-release-evidence-descriptor-allocation journal fn2-release-evidence)
        fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints))
      ((unless (eq dcode :ok)) (mv dcode fn2-release-inventory-build fn2-extents fn2-alloc-edges))
      ((mv icode fn2-extents fn2-alloc-edges)
       (fn2-checkpoint-source-claim c checkpoint installation
        (fn2-release-evidence-installation-epoch journal fn2-release-evidence)
        (fn2-release-evidence-installation-allocation journal fn2-release-evidence)
        fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints))
      ((unless (eq icode :ok)) (mv icode fn2-release-inventory-build fn2-extents fn2-alloc-edges))
      ((mv jcode fn2-extents fn2-alloc-edges)
       (fn2-checkpoint-source-claim c checkpoint journal
        (fn2-release-evidence-journal-epoch journal fn2-release-evidence)
        (fn2-release-evidence-journal-allocation journal fn2-release-evidence)
        fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints)))
  (mv jcode fn2-release-inventory-build fn2-extents fn2-alloc-edges)))

(defconst *fn2-release-inventory-source-children*
 '(fn2-release-inventory-build fn2-release-evidence fn2-release-evidence-candidates fn2-csnapshot fn2-checkpoints
   fn2-checkpoint-construction fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoint-page-verified fn2-fc fn2-fields fn2-pool fn2-control))
(defconst *fn2-release-inventory-source-outputs*
 '(fn2-release-inventory-build fn2-checkpoint-construction fn2-extents fn2-alloc-edges fn2-fields fn2-pool fn2-control))
(defmacro fn2-release-inventory-mv (code)
 `(mv ,code ,@*fn2-release-inventory-source-outputs*))
(defmacro fn2-release-inventory-step-event ()
 `(fn2-release-inventory-operation fn2-release-inventory-source-step (budget)
  ,*fn2-release-inventory-source-children* ,*fn2-release-inventory-source-outputs*
  (b* (((unless (and (natp budget) (< 0 budget))) (fn2-release-inventory-mv :yield))
       ((unless (and (fn2-release-inventory-owner-p fn2-release-inventory-build fn2-csnapshot fn2-checkpoints fn2-extents)
                     (= (fn2-release-evidence-rows fn2-release-evidence) (fn2-extents-rows fn2-extents))
                     (= (fn2-release-evidence-candidates-rows fn2-release-evidence-candidates) (fn2-checkpoints-rows fn2-checkpoints))))
        (fn2-release-inventory-mv :source))
       (phase (fn2-release-inventory-build-phase 0 fn2-release-inventory-build))

; One retained published-article stream per actual CNS row. The copied
; commitments are from a live typed READ; physical input cannot replace them.
(in-package "ACL2")
(include-book "machines-c-read")
(include-book "article-manifest")
(include-book "cns-source-workspace")
(fn2-book-layer :d)
(defconst *fn2-cns-source-next-bytes* (+ 1024 1024))
(defcolumns fn2-cns-sources
 ((phase (:enum fn2-cns-source-phase (:free :capturing :retain :raw-read :raw-wait :raw-check :raw-hash :raw-copy :manifest :final :complete :releasing :bad)))
  (cns-id :u32) (cns-gen :u60) (ctl-id :u32) (ctl-gen :u60) (request :u60)
  (lslot :u32) (lgen :u60) (article :u60) (version :u60) (total :u60)
  (location-kind :u8) (unit :u60) (epoch :u60) (allocation :u60) (hashes :u32)
  (root-unit :u60) (root-epoch :u60) (root-allocation :u60)
  (offset :u60) (unit-index :u32) (unit-length :u32) (unit-copied :u32) (unit-hashed :u32)
  (hash-offset :u60) (hash-phase :u8) (pending :bool) (borrow-count :u32)
  (op-slot :u32) (op-gen :u60) (result-kind :u8) (result-outcome :u8) (result-reason :u8) (result-count :u32)
  (retention-phase :u8) (retain-row :u32) (release-row :u32)
  (retain-entry-index :u32) (retain-entry-count :u32) (manifest-position :u32)
  (manifest-index :u32) (manifest-count :u32) (manifest-seen :u60)
  (manifest-stage (:enum fn2-cns-source-manifest-stage (:none :read :wait :check :entry :claim :next :covered :data-read :data-wait :data-check)))
  (manifest-loaded-index :u32) (proof-hash-offset :u32) (proof-cv-offset :u32)))
(defun fn2-cns-source-ownerp (s cns cnsgen ctl ctlgen request fn2-cns-sources)
 (declare (xargs :stobjs fn2-cns-sources :guard (fn2-cns-sources-wfp fn2-cns-sources)))
 (and (natp s) (< s (fn2-cns-sources-rows fn2-cns-sources))
      (not (equal (fn2-cns-sources-phase s fn2-cns-sources) *fn2-cns-source-phase-free*))
      (equal cns (fn2-cns-sources-cns-id s fn2-cns-sources))
      (equal cnsgen (fn2-cns-sources-cns-gen s fn2-cns-sources))
      (equal ctl (fn2-cns-sources-ctl-id s fn2-cns-sources))
      (equal ctlgen (fn2-cns-sources-ctl-gen s fn2-cns-sources))
      (equal request (fn2-cns-sources-request s fn2-cns-sources))))

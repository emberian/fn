; Scalar witnesses for the exact logical creator; no served snapshot copy.
(in-package "ACL2")
(include-book "log-checkpoint-publication")
(defun fn-lc-proof-empty-columns ()
 (declare (xargs :guard t :verify-guards nil))
 (fn-lc-columns-value '(nil nil nil (nil nil nil) nil nil nil nil nil nil)))
(defthm fn-lc-created-columns-ground-refinement
 (equal (fn-lc-columns (create-fn-lbc)) (fn-lc-proof-empty-columns))
 :hints (("Goal" :in-theory (enable fn-lc-columns create-fn-lbc create-fn-dmap
                                   fn-lc-proof-empty-columns))))
(defun fn-lc-proof-header (next)
 (declare (xargs :guard (unsigned-byte-p 64 next) :verify-guards nil))
 (list :lc-header (list 0 0 0 0 (fn-lc-zero-words 32)) next nil nil nil))
(defun fn-lc-proof-data-pages (contents addr)
 (declare (xargs :guard (natp addr) :verify-guards nil))
 (if (consp contents)
  (cons (cons addr (mbe :logic (car contents) :exec (fn-lc-head contents))) (fn-lc-proof-data-pages (mbe :logic (cdr contents) :exec (fn-lc-rest contents)) (+ 1 addr))) nil))
(defun fn-lc-proof-table (contents addr)
 (declare (xargs :guard (natp addr) :verify-guards nil))
 (if (consp contents)
  (cons (list addr 1 (pgs-digest (mbe :logic (car contents) :exec (fn-lc-head contents))))
        (fn-lc-proof-table (mbe :logic (cdr contents) :exec (fn-lc-rest contents)) (+ 1 addr))) nil))
(defun fn-lc-proof-image-disk (contents)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((n (len contents)) (ta (+ 1 n)) (da (+ 2 n))
        (table (fn-lc-proof-table contents 1))
        (directory (list (list ta 1 (pgs-digest table))))
        (record (pgs-make-rec 1 da n (pgs-digest directory))))
  (cons (mbe :logic (append (fn-lc-proof-data-pages contents 1)
                (list (cons ta table) (cons da directory))) :exec (fn-lc-join (fn-lc-proof-data-pages contents 1) (list (cons ta table) (cons da directory))))
        (list (cons :lc (cons record nil))))))
(defun fn-lc-proof-ok-outcomes (n)
 (declare (xargs :guard (natp n) :verify-guards nil))
 (if (mbe :logic (zp n) :exec (not (posp n))) nil (cons :ok (fn-lc-proof-ok-outcomes (1- n)))))

; Shared bounded private-overlay index insertion. Encoding is complete before
; BEGIN. Neither count nor fill is published until every shifted row is placed.
(in-package "ACL2")
(include-book "overlay")
(fn2-book-layer :c)
(defconst *fn2-ov-search-limit* 40)
(defcolumns fn2-ov-insertion
 ((phase (:enum fn2-ov-insertion-phase (:idle :shift :done :search :order :encode :uncertain)))
  (overlay :u32) (slot :u32) (gen :u60) (schema :u60) (batch :u60) (seq :u60)
  (pos :u32) (off :u32) (end :u32) (count :u32) (ibase :u32) (remaining :u32) (replace :bool)
  (entry-base :u32) (decode-base :u32) (query-kind :u8) (query-slot :u32) (query-gen :u60)
  (lo :u32) (hi :u32) (search-left :u8)))
(defun fn2-ov-insertion-current-p (fn2-ov-insertion fn2-overlays fn2-overlay-index)
 (declare (xargs :stobjs (fn2-ov-insertion fn2-overlays fn2-overlay-index)
  :guard (and (fn2-ov-insertion-wfp fn2-ov-insertion) (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index))))
 (and (< 0 (fn2-ov-insertion-rows fn2-ov-insertion))
  (let ((o (fn2-ov-insertion-overlay 0 fn2-ov-insertion)))
   (and (fn2-ov-okp o fn2-overlays fn2-overlay-index)
    (= (fn2-overlays-phase o fn2-overlays) *fn2-overlay-phase-private*)
    (= (fn2-overlays-slot o fn2-overlays) (fn2-ov-insertion-slot 0 fn2-ov-insertion))
    (= (fn2-overlays-gen o fn2-overlays) (fn2-ov-insertion-gen 0 fn2-ov-insertion))
    (= (fn2-overlays-schema o fn2-overlays) (fn2-ov-insertion-schema 0 fn2-ov-insertion))
    (= (fn2-overlays-batch o fn2-overlays) (fn2-ov-insertion-batch 0 fn2-ov-insertion))
    (= (fn2-overlays-seq o fn2-overlays) (fn2-ov-insertion-seq 0 fn2-ov-insertion))
    (= (fn2-overlays-count o fn2-overlays) (fn2-ov-insertion-count 0 fn2-ov-insertion))
    (= (fn2-overlays-ibase o fn2-overlays) (fn2-ov-insertion-ibase 0 fn2-ov-insertion))
    (= (fn2-overlays-fill o fn2-overlays) (fn2-ov-insertion-off 0 fn2-ov-insertion))
    (<= (fn2-ov-insertion-pos 0 fn2-ov-insertion) (fn2-ov-insertion-count 0 fn2-ov-insertion))
    (<= (fn2-ov-insertion-remaining 0 fn2-ov-insertion)
        (- (fn2-ov-insertion-count 0 fn2-ov-insertion) (fn2-ov-insertion-pos 0 fn2-ov-insertion)))
    (<= (fn2-ov-insertion-off 0 fn2-ov-insertion) (fn2-ov-insertion-end 0 fn2-ov-insertion))
    (<= (fn2-ov-insertion-end 0 fn2-ov-insertion) (fn2-overlays-cap o fn2-overlays))
    (if (member (fn2-ov-insertion-phase 0 fn2-ov-insertion)
                (list *fn2-ov-insertion-phase-search* *fn2-ov-insertion-phase-order* *fn2-ov-insertion-phase-encode*))
        (and (<= (fn2-ov-insertion-lo 0 fn2-ov-insertion) (fn2-ov-insertion-hi 0 fn2-ov-insertion))
             (<= (fn2-ov-insertion-hi 0 fn2-ov-insertion) (fn2-ov-insertion-count 0 fn2-ov-insertion)))
     (if (= (fn2-ov-insertion-replace 0 fn2-ov-insertion) 1)
         (and (< (fn2-ov-insertion-pos 0 fn2-ov-insertion) (fn2-ov-insertion-count 0 fn2-ov-insertion))
              (= (fn2-ov-insertion-remaining 0 fn2-ov-insertion) 0))
       (< (fn2-ov-insertion-count 0 fn2-ov-insertion) (fn2-overlays-icap o fn2-overlays))))))))
(defun fn2-ov-insertion-begin (o pos off end replace fn2-ov-insertion fn2-overlays fn2-overlay-index)
 (declare (xargs :stobjs (fn2-ov-insertion fn2-overlays fn2-overlay-index)
  :guard (and (fn2-ov-insertion-wfp fn2-ov-insertion) (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index))))
 (b* (((unless (< 0 (fn2-ov-insertion-rows fn2-ov-insertion))) (mv :bounds fn2-ov-insertion))
      ((unless (member (fn2-ov-insertion-phase 0 fn2-ov-insertion)
                       (list *fn2-ov-insertion-phase-idle* *fn2-ov-insertion-phase-done*)))
       (mv :busy fn2-ov-insertion))
      ((unless (and (fn2-ov-okp o fn2-overlays fn2-overlay-index)
                    (= (fn2-overlays-phase o fn2-overlays) *fn2-overlay-phase-private*)
                    (natp pos) (<= pos (fn2-overlays-count o fn2-overlays))
                    (unsigned-byte-p 32 off) (unsigned-byte-p 32 end)
                    (= off (fn2-overlays-fill o fn2-overlays)) (<= off end)
                    (<= end (fn2-overlays-cap o fn2-overlays))
                    (if replace (< pos (fn2-overlays-count o fn2-overlays))
                     (< (fn2-overlays-count o fn2-overlays) (fn2-overlays-icap o fn2-overlays)))))
       (mv :bounds fn2-ov-insertion))
      (fn2-ov-insertion (fn2-ov-insertion-put 0 (phase *fn2-ov-insertion-phase-shift*)
       (overlay o) (slot (fn2-overlays-slot o fn2-overlays)) (gen (fn2-overlays-gen o fn2-overlays))
       (schema (fn2-overlays-schema o fn2-overlays)) (batch (fn2-overlays-batch o fn2-overlays))
       (seq (fn2-overlays-seq o fn2-overlays)) (pos pos) (off off) (end end)
       (count (fn2-overlays-count o fn2-overlays)) (ibase (fn2-overlays-ibase o fn2-overlays))
       (remaining (if replace 0 (- (fn2-overlays-count o fn2-overlays) pos))) (replace (if replace 1 0)))))
  (mv :more fn2-ov-insertion)))
(defun fn2-ov-insertion-step (budget fn2-ov-insertion fn2-overlays fn2-overlay-index)
 (declare (xargs :stobjs (fn2-ov-insertion fn2-overlays fn2-overlay-index)
  :guard (and (fn2-ov-insertion-wfp fn2-ov-insertion) (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index))))
 (b* (((unless (and (natp budget) (< 0 budget))) (mv :yield fn2-ov-insertion fn2-overlays fn2-overlay-index))
      ((unless (and (< 0 (fn2-ov-insertion-rows fn2-ov-insertion))
                    (= (fn2-ov-insertion-phase 0 fn2-ov-insertion) *fn2-ov-insertion-phase-shift*)
                    (fn2-ov-insertion-current-p fn2-ov-insertion fn2-overlays fn2-overlay-index)))
       (mv :state fn2-ov-insertion fn2-overlays fn2-overlay-index))
      (n (fn2-ov-insertion-remaining 0 fn2-ov-insertion))
      (at (+ (fn2-ov-insertion-ibase 0 fn2-ov-insertion) (fn2-ov-insertion-pos 0 fn2-ov-insertion)))
      ((when (< 0 n))
       (let* ((j (+ at n -1))
              (fn2-overlay-index (fn2-overlay-index-set-off (+ 1 j) (fn2-overlay-index-off j fn2-overlay-index) fn2-overlay-index))
              (fn2-ov-insertion (fn2-ov-insertion-set-remaining 0 (- n 1) fn2-ov-insertion)))
        (mv :more fn2-ov-insertion fn2-overlays fn2-overlay-index)))
      (o (fn2-ov-insertion-overlay 0 fn2-ov-insertion))
      (fn2-overlay-index (fn2-overlay-index-set-off at (fn2-ov-insertion-off 0 fn2-ov-insertion) fn2-overlay-index))
      (fn2-overlays (fn2-overlays-put o
       (count (+ (fn2-ov-insertion-count 0 fn2-ov-insertion) (if (= (fn2-ov-insertion-replace 0 fn2-ov-insertion) 1) 0 1)))
       (fill (fn2-ov-insertion-end 0 fn2-ov-insertion))))
      (fn2-ov-insertion (fn2-ov-insertion-set-phase 0 *fn2-ov-insertion-phase-done* fn2-ov-insertion)))
  (mv :done fn2-ov-insertion fn2-overlays fn2-overlay-index)))
(fn2-ov-insertion-preserves fn2-ov-insertion-begin
 (o pos off end replace fn2-ov-insertion fn2-overlays fn2-overlay-index)
 :position 1 :raw-rows t)
(fn2-ov-insertion-preserves fn2-ov-insertion-step
 (budget fn2-ov-insertion fn2-overlays fn2-overlay-index)
 :position 1 :raw-rows t)
(fn2-overlays-preserves fn2-ov-insertion-step
 (budget fn2-ov-insertion fn2-overlays fn2-overlay-index)
 :position 2 :raw-rows t)
(fn2-overlay-index-preserves fn2-ov-insertion-step
 (budget fn2-ov-insertion fn2-overlays fn2-overlay-index)
 :position 3 :raw-rows t)

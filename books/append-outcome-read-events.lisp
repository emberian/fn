; Consumer and authority actors share the explicitly supplied operation namespace.
(in-package "ACL2")

(defmacro fn2-append-outcome-read-events ()
 '(progn
   ;; A read row may have survived a yield. Resume only the exact scalar
   ;; key it already holds; do not replace a foreign read or borrow.
   (defun fn2-outcome-read-mode (x principal op fn2-core)
     (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                     :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
     (stobj-let ((fn2-reads (fn2-core-reads fn2-core)) (fn2-fields (fn2-core-fields fn2-core))
                 (fn2-id-decides (fn2-core-id-decides fn2-core)) (fn2-fc (fn2-core-fc fn2-core)))
       (mode)
       (b* (((unless (and (fn2-reads-wfp fn2-reads) (fn2-fields-wfp fn2-fields)
                          (natp x) (< x (fn2-reads-rows fn2-reads))
                          (equal (fn2-reads-qset x fn2-reads) 0))) :state)
            ((when (equal (fn2-reads-op x fn2-reads) *fn2-read-op-idle*)) :start)
            ((unless (and (equal (fn2-reads-op x fn2-reads) *fn2-read-op-lookup*)
                          (equal (fn2-reads-sid x fn2-reads) *fn2-txn-outcome-sid*))) :state)
            ((mv code base) (fn2-read-stripe x (fn2-fc-rows fn2-fc) fn2-reads fn2-id-decides fn2-fields))
            (lo (+ base *fn2-read-lo*))
            ((unless (and (eq code :ok) (<= (+ lo 1 *fn2-outcome-entry-field-id-source*) (fn2-fields-rows fn2-fields)))) :state))
         (if (and (equal (fn2-fields-value (+ lo *fn2-outcome-entry-field-principal*) fn2-fields) principal)
                  (equal (fn2-fields-value (+ lo *fn2-outcome-entry-field-operation*) fn2-fields) op)
                  (equal (fn2-fields-value (+ lo *fn2-outcome-entry-field-id-source*) fn2-fields)
                         *fn2-outcome-id-source-supplied*))
             :resume :state))
       mode))
   (in-theory (disable fn2-outcome-read-mode))

   (defun fn2-outcome-lookup-step (x principal op budget fn2-core)
     (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
     (b* (((unless (and (posp principal) (unsigned-byte-p 60 principal) (posp op) (unsigned-byte-p 60 op)))
           (mv :state fn2-core))
          (mode (fn2-outcome-read-mode x principal op fn2-core))
          ((when (eq mode :state)) (mv :state fn2-core))
          ((mv code fn2-core)
           (if (eq mode :resume) (mv :ok fn2-core)
             (b* (((mv c fn2-core) (fn2-read-key x :lo *fn2-outcome-entry-field-principal* principal fn2-core))
                  ((unless (eq c :ok)) (mv :state fn2-core))
                  ((mv c fn2-core) (fn2-read-key x :lo *fn2-outcome-entry-field-operation* op fn2-core))
                  ((unless (eq c :ok)) (mv :state fn2-core)))
               (fn2-read-key x :lo *fn2-outcome-entry-field-id-source* *fn2-outcome-id-source-supplied* fn2-core))))
          ((unless (eq code :ok)) (mv :state fn2-core)))
       (mv-let (lc fn2-core) (fn2-read-lookup x *fn2-txn-outcome-sid* (min 3072 (nfix budget)) fn2-core)
         (if (member-eq lc '(:more :ok)) (mv lc fn2-core)
           (mv-let (rc fn2-core) (fn2-read-release x fn2-core)
             (mv (if (and (eq rc :ok) (eq lc :absent)) :absent :state) fn2-core))))))
   (fn2-core-preserves fn2-outcome-lookup-step (x principal op budget fn2-core) :position 1 :rows nil)
   (local
    (defthm fn2-outcome-lookup-step-preserves-cns-snapshot
      (equal (fn2-cns-snapshot-read-code cns
               (mv-nth 1 (fn2-outcome-lookup-step x principal op budget fn2-core)))
             (fn2-cns-snapshot-read-code cns fn2-core))
      :hints (("Goal" :in-theory (union-theories
                                  '(fn2-outcome-lookup-step fn2-read-key fn2-read-lookup fn2-read-release
                                    fn2-cns-snapshot-read-code fn2-machine-phase-read-code
                                    fn2-machine-idp fn2-machine-kind fn2-machine-kind-read
                                    fn2-machine-kind-read-code fn2-machine-slot fn2-machine-slot-read
                                    fn2-machine-slot-read-code fn2-core-child-meta-correct)
                                  (theory 'minimal-theory))))))
   (in-theory (disable fn2-outcome-lookup-step))

   (defun fn2-cns-append-read-contextp (cns gen request op fn2-core)
     (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
     (and (eq (fn2-cns-snapshot-read-code cns fn2-core) :ok)
          (equal (fn2-machine-generation cns fn2-core) gen)
          (equal (fn2-cns-row-request cns fn2-core) request)
          (equal (fn2-cns-row-phase cns fn2-core) *fn2-cns-state-append*)
          (equal (fn2-cns-row-op cns fn2-core) op)
          (mv-let (code x) (fn2-cns-read-row cns fn2-core)
            (and (eq code :ok) (equal x (fn2-cns-row-xrow cns fn2-core))))))
   (local
    (defthm fn2-cns-append-read-contextp-snapshot
      (implies (fn2-cns-append-read-contextp cns gen request op fn2-core)
               (and (equal (fn2-cns-snapshot-read-code cns fn2-core) :ok)
                    (fn2-machine-idp cns fn2-core)))
      :hints (("Goal" :in-theory (enable fn2-cns-append-read-contextp
                                         fn2-cns-snapshot-read-code
                                         fn2-machine-phase-read-code)))))
   (in-theory (disable fn2-cns-append-read-contextp))

   (defun fn2-cns-append-ctl-live-p (cns gen request fn2-core)
     (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
     (and (eq (fn2-cns-snapshot-read-code cns fn2-core) :ok)
          (equal (fn2-machine-generation cns fn2-core) gen)
          (let ((ctl (fn2-cns-row-ctl cns fn2-core)))
            (and (eq (fn2-ctl-snapshot-read-code ctl fn2-core) :ok)
                 (equal (fn2-machine-generation ctl fn2-core) (fn2-cns-row-ctl-gen cns fn2-core))
                 (equal (fn2-ctl-row-request ctl fn2-core) request)
                 (equal (fn2-ctl-row-cns ctl fn2-core) cns)
                 (equal (fn2-ctl-row-cns-gen ctl fn2-core) gen)
                 (member-equal (fn2-ctl-row-phase ctl fn2-core)
                               (list *fn2-ctl-state-stream* *fn2-ctl-state-waiting*))))))
   (in-theory (disable fn2-cns-append-ctl-live-p))

   (defun fn2-cns-release-append-outcome (cns gen request principal op fn2-core)
     (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
     (if (not (fn2-cns-append-read-contextp cns gen request op fn2-core)) (mv :state fn2-core)
       (let ((x (fn2-cns-row-xrow cns fn2-core)))
         (case (fn2-outcome-read-mode x principal op fn2-core)
           (:start (mv :ok fn2-core))
           (:resume (fn2-read-release x fn2-core))
           (otherwise (mv :state fn2-core))))))
   (fn2-core-preserves fn2-cns-release-append-outcome (cns gen request principal op fn2-core) :position 1 :rows nil)
   (in-theory (disable fn2-cns-release-append-outcome))

   ;; A found result owns its copied fields independently of the delivered
   ;; read entry. Digest in WS[0,32), original Message-ID followed by group pairs in NS.
   (defun fn2-cns-take-append-outcome (x cns gen ws wg ns ng fn2-core)
     (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
     (b* (((mv c1 event) (fn2-read-value x *fn2-outcome-entry-field-event* fn2-core))
          ((mv c2 outcome) (fn2-read-value x *fn2-outcome-entry-field-outcome* fn2-core))
          ((mv c3 verb) (fn2-read-value x *fn2-outcome-entry-field-verb* fn2-core))
          ((mv result n numbers-len fn2-core)
           (cond ((not (and (eq c1 :ok) (eq c2 :ok) (eq c3 :ok) (posp event) (unsigned-byte-p 60 event)))
                  (mv :state 0 0 fn2-core))
                 ((equal verb *fn2-outcome-verb-grant-set*) (mv :reused 0 0 fn2-core))
                 ((not (and (equal verb *fn2-outcome-verb-append*)
                            (member-equal outcome (list *fn2-txn-outcome-accepted* *fn2-txn-outcome-conflict*))))
                  (mv :state 0 0 fn2-core))
                 (t
                  (b* (((mv dc copied left fn2-core)
                        (fn2-read-octets x *fn2-outcome-entry-field-request* 0 32 ws wg 0 *fn2-cns-kind* cns gen fn2-core))
                       ((unless (and (eq dc :ok) (equal copied 32) (equal left 0))) (mv :state 0 0 fn2-core))
                       ((mv mc size rest fn2-core)
                        (fn2-read-octets x *fn2-outcome-entry-field-mid* 0 *fn2-format-message-id-max*
                                         ns ng 0 *fn2-cns-kind* cns gen fn2-core))
                       ((unless (and (eq mc :ok) (posp size) (<= size *fn2-format-message-id-max*) (equal rest 0)))
                        (mv :state 0 0 fn2-core))
                       ((unless (equal outcome *fn2-txn-outcome-accepted*))
                        (mv :found size 0 fn2-core))
                       ((mv nc numbers-len rest fn2-core)
                        (fn2-read-octets x *fn2-outcome-entry-field-numbers* 0 *fn2-overview-octets-max*
                                         ns ng size *fn2-cns-kind* cns gen fn2-core)))
                    (if (and (eq nc :ok) (posp numbers-len)
                             (<= numbers-len *fn2-overview-octets-max*) (equal rest 0))
                        (mv :found size numbers-len fn2-core) (mv :state 0 0 fn2-core))))))
          ((mv rc fn2-core) (fn2-read-release x fn2-core)))
       (if (eq rc :ok) (mv result (nfix event) (nfix outcome) (nfix n) (nfix numbers-len) fn2-core)
         (mv :state 0 0 0 0 fn2-core))))
   (fn2-core-preserves fn2-cns-take-append-outcome (x cns gen ws wg ns ng fn2-core) :position 5 :rows nil)
   (in-theory (disable fn2-cns-take-append-outcome))

   (defun fn2-cns-read-append-outcome (cns gen request principal op budget fn2-core)
     (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
     (b* (((unless (fn2-cns-append-read-contextp cns gen request op fn2-core)) (mv :dropped 0 0 0 0 fn2-core))
          ((unless (equal principal (fn2-cns-row-address-principal cns fn2-core))) (mv :dropped 0 0 0 0 fn2-core))
          ((mv pc current) (fn2-cns-principal cns gen fn2-core))
          ((unless (and (eq pc :ok) (equal principal current)
                        (fn2-cns-append-ctl-live-p cns gen request fn2-core)))
           (mv-let (rc fn2-core) (fn2-cns-release-append-outcome cns gen request principal op fn2-core)
             (mv (if (eq rc :ok) :dropped :state) 0 0 0 0 fn2-core)))
          (x (fn2-cns-row-xrow cns fn2-core))
          ((mv code fn2-core) (fn2-outcome-lookup-step x principal op budget fn2-core))
          ((unless (eq code :ok)) (mv code 0 0 0 0 fn2-core)))
       (fn2-cns-take-append-outcome x cns gen (fn2-cns-row-ws-slot cns fn2-core)
                                    (fn2-cns-row-ws-gen cns fn2-core) (fn2-cns-row-ns-slot cns fn2-core)
                                    (fn2-cns-row-ns-gen cns fn2-core) fn2-core)))
   (fn2-core-preserves fn2-cns-read-append-outcome (cns gen request principal op budget fn2-core) :position 5 :rows nil)
   (in-theory (disable fn2-cns-read-append-outcome))))

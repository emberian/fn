; I/O observation of the existing PGS root selector. The authoritative
; validity decisions are pgs-dir-verdict, pgs-entry-verdict and pgs-try.
; Checked column pages are data requests, not directory-path requests.
(in-package "ACL2")
(include-book "log-checkpoint-adoption")

(defun fn-lc-pgs-checked-requests (entries txid mode pages)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp entries)
  (let* ((e (car entries)) (address (fn-lc-head e))
         (checked (ec-call (pgs-entry-checked-p e txid mode)))
         (damaged (equal (ec-call (pgs-entry-verdict e txid mode
                                  (pgs-digest (pgs-lookup address pages)))) :damaged)))
   (if damaged (if checked (list address) nil)
    (fn-lc-join (if checked (list address) nil)
               (fn-lc-pgs-checked-requests (cdr entries) txid mode pages)))) nil))
(defun fn-lc-pgs-candidate-requests (rec pages mode)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((address (pgs-rec-dir-addr rec)) (txid (pgs-rec-txid rec))
        (dir (pgs-lookup address pages))
        (dir-request (list address))
        (dv (pgs-dir-verdict rec dir (pgs-digest dir))))
  (if dv (list dir-request nil)
   (let* ((table-requests (fn-lc-pgs-checked-requests dir txid mode pages))
          (structural (fn-lc-join dir-request table-requests))
          (tb (ec-call (pgs-check-pages dir txid mode pages 0 :table-damaged)))
          (cs (ec-call (pgs-contents dir pages)))
          (tv (ec-call (pgs-tables-verdict cs (pgs-rec-npages rec) txid 0))))
    (if (or tb tv) (list structural nil)
     (list structural (fn-lc-pgs-checked-requests (pgs-flatten cs) txid mode pages)))))))
(defun fn-lc-pgs-request-order (order slots pages mode)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp order)
  (let ((rec (pgs-slot (car order) slots)))
   (if (not (pgs-rec-shape-p rec))
       (fn-lc-pgs-request-order (cdr order) slots pages mode)
    (let* ((one (fn-lc-pgs-candidate-requests rec pages mode))
           (result (ec-call (pgs-try rec pages mode)))
           (rest (if (equal (fn-lc-head result) :ok) '(nil nil)
                   (fn-lc-pgs-request-order (cdr order) slots pages mode))))
      (list (fn-lc-join (fn-lc-at 0 one) (fn-lc-at 0 rest))
            (fn-lc-join (fn-lc-at 1 one) (fn-lc-at 1 rest)))))) '(nil nil)))
(defun fn-lc-pgs-open-requests (disk r mode)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((slots (pgs-root-slots r disk))
        (s0 (pgs-slot 0 slots)) (s1 (pgs-slot 1 slots))
        (order (pgs-open-order s0 (pgs-rec-valid s0) s1 (pgs-rec-valid s1))))
   (fn-lc-pgs-request-order order slots (pgs-pages disk) mode)))
(defun fn-lc-selected-page-table (disk r mode)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((opened (pgs-open disk r mode))
        (rec (pgs-slot (fn-lc-at 1 opened) (pgs-root-slots r disk)))
        (dir (pgs-lookup (pgs-rec-dir-addr rec) (pgs-pages disk))))
   (if (equal (fn-lc-head opened) :ok)
       (pgs-flatten (ec-call (pgs-contents dir (pgs-pages disk)))) nil)))
(defun fn-lc-logical-page-physes (indices table)
 (declare (xargs :guard t))
 (if (consp indices)
  (cons (fn-lc-head (fn-lc-at (nfix (car indices)) table))
        (fn-lc-logical-page-physes (cdr indices) table)) nil))
(defun fn-lc-path-table-physes (indices rec pages)
 (declare (xargs :guard t))
 (if (consp indices)
  (let* ((dir (pgs-lookup (pgs-rec-dir-addr rec) pages))
         (tp (floor (nfix (car indices)) *pgs-tab-entries*)))
    (cons (fn-lc-head (fn-lc-at tp dir))
          (fn-lc-path-table-physes (cdr indices) rec pages))) nil))
(defun fn-lc-memo-page-requests (pages)
 (declare (xargs :guard t :verify-guards nil))
 (ec-call (remove-duplicates-equal (true-list-fix pages))))

(verify-guards fn-lc-pgs-checked-requests)
(verify-guards fn-lc-pgs-candidate-requests)
(verify-guards fn-lc-pgs-request-order)
(verify-guards fn-lc-pgs-open-requests)
(verify-guards fn-lc-selected-page-table)
(verify-guards fn-lc-logical-page-physes)
(verify-guards fn-lc-path-table-physes)
(verify-guards fn-lc-memo-page-requests)

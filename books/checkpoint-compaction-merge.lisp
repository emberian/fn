; The rescan merge drives existing decoders/comparators/rehome operations.
; It holds one best entry, one immutable lower entry, and one source cursor.
(in-package "ACL2")
(include-book "checkpoint-compaction-workspaces")
(include-book "range-served")
(fn2-book-layer :c)

(defmacro fn2-checkpoint-compaction-merge-guard ()
 '(and (fn2-checkpoint-compaction-wfp fn2-checkpoint-compaction)
       (fn2-checkpoint-root1-wfp fn2-checkpoint-root1) (fn2-checkpoint-windows-wfp fn2-checkpoint-windows)
       (fn2-checkpoint-build-wfp fn2-checkpoint-build) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-checkpoints-wfp fn2-checkpoints)
       (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index) (fn2-run-installed-wfp fn2-run-installed)
       (fn2-run-cursors-wfp fn2-run-cursors) (fn2-run-paths-wfp fn2-run-paths) (fn2-run-cache-wfp fn2-run-cache)
       (fn2-fc-wfp fn2-fc) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)))
(defmacro fn2-checkpoint-compaction-merge-mv (code)
 `(mv ,code fn2-checkpoint-compaction fn2-run-cursors fn2-run-paths fn2-fields fn2-pool))

; A failure after decoding must not let a later retry advance past the
; rejected entry. The actual continuation becomes terminal before returning.
(defmacro fn2-checkpoint-compaction-merge-fail (code)
 `(let ((fn2-checkpoint-compaction (fn2-checkpoint-compaction-set-phase 0 *fn2-checkpoint-compaction-phase-uncertain* fn2-checkpoint-compaction)))
   (fn2-checkpoint-compaction-merge-mv ,code)))

; No decoder or hash readiness argument enters this operation. SEEK invokes
; the actual overlay lower-bound/entry or authenticated run cursor itself;
; only its successful result can enter COMPARE/COPY. COPY freezes that source.
(defun fn2-checkpoint-compaction-merge-step
 (budget fn2-checkpoint-compaction fn2-checkpoint-root1 fn2-checkpoint-windows fn2-checkpoint-build fn2-csnapshot fn2-checkpoints
 fn2-overlays fn2-overlay-index fn2-run-installed fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fc fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-compaction fn2-checkpoint-root1 fn2-checkpoint-windows fn2-checkpoint-build fn2-csnapshot fn2-checkpoints
 fn2-overlays fn2-overlay-index fn2-run-installed fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fc fn2-fields fn2-pool)
 :guard (fn2-checkpoint-compaction-merge-guard)))
 (b* (((unless (posp budget)) (fn2-checkpoint-compaction-merge-mv :yield))
      ((unless (and (fn2-checkpoint-compaction-current-source-p fn2-checkpoint-compaction fn2-checkpoint-build fn2-csnapshot fn2-checkpoints fn2-overlays fn2-run-installed)
                    (fn2-checkpoint-compaction-windowsp fn2-checkpoint-compaction fn2-checkpoint-root1 fn2-checkpoint-windows fn2-csnapshot fn2-pool)
                    (equal (fn2-checkpoint-compaction-configured 0 fn2-checkpoint-compaction) 1)
                    (equal (fn2-checkpoint-root1-phase 0 fn2-checkpoint-root1) *fn2-checkpoint-root1-phase-source*)))
       (fn2-checkpoint-compaction-merge-mv :source))
      (phase (fn2-checkpoint-compaction-phase 0 fn2-checkpoint-compaction))
      (sid (fn2-checkpoint-compaction-schema 0 fn2-checkpoint-compaction))
      (skind (fn2-checkpoint-compaction-source-kind 0 fn2-checkpoint-compaction))
      (r (fn2-checkpoint-compaction-source-row 0 fn2-checkpoint-compaction))
      (c (fn2-checkpoint-compaction-cursor 0 fn2-checkpoint-compaction))
      (rb (fn2-checkpoint-compaction-reader-base 0 fn2-checkpoint-compaction))
      (ib (fn2-checkpoint-compaction-input-base 0 fn2-checkpoint-compaction))
      (eb (fn2-checkpoint-compaction-entry-base 0 fn2-checkpoint-compaction))
      (lb (fn2-checkpoint-compaction-lower-base 0 fn2-checkpoint-compaction))
      (dk (fn2-checkpoint-compaction-owner-kind 0 fn2-checkpoint-compaction))
      (ds (fn2-checkpoint-compaction-owner-slot 0 fn2-checkpoint-compaction))
      (dg (fn2-checkpoint-compaction-owner-gen 0 fn2-checkpoint-compaction))
      ((unless (and (fn2-b-fixed-cursor-rows-p (fn2-run-cursors-rows fn2-run-cursors))
                    (equal c (fn2-b-checkpoint-source-cursor-from-rows (fn2-run-cursors-rows fn2-run-cursors)))
                    (equal eb (fn2-checkpoint-source-ebase (fn2-fc-rows fn2-fc)))
                    (equal lb (fn2-checkpoint-manifest-ebase (fn2-fc-rows fn2-fc)))
                    (equal rb (fn2-checkpoint-source-rbase (fn2-fc-rows fn2-fc)))
                    (natp c) (< c (fn2-run-cursors-rows fn2-run-cursors))
                    (fn2-run-readerp rb fn2-fields)
                    (equal ib (+ rb *fn2-run-reader-entry*))
                    (<= (+ eb *fn2-run-entry-rows*) lb)
                    (<= (+ lb *fn2-run-entry-rows*) rb)))
       (fn2-checkpoint-compaction-merge-mv :fields))
      ((when (equal phase *fn2-checkpoint-compaction-phase-copy*))
       (b* (((unless (<= 2 budget)) (fn2-checkpoint-compaction-merge-mv :yield))
            ((mv code field copied end fn2-fields fn2-pool)
             (fn2-run-entry-rehome-step sid eb
              (fn2-checkpoint-compaction-copy-field 0 fn2-checkpoint-compaction)
              (fn2-checkpoint-compaction-copy-offset 0 fn2-checkpoint-compaction)
              (fn2-checkpoint-compaction-copy-end 0 fn2-checkpoint-compaction)
              (fn2-checkpoint-compaction-best-slot 0 fn2-checkpoint-compaction)
              (fn2-checkpoint-compaction-best-gen 0 fn2-checkpoint-compaction)
              (fn2-checkpoint-compaction-source-okind 0 fn2-checkpoint-compaction)
              (fn2-checkpoint-compaction-source-oslot 0 fn2-checkpoint-compaction)
              (fn2-checkpoint-compaction-source-ogen 0 fn2-checkpoint-compaction)
              dk ds dg (floor budget 2) fn2-fields fn2-pool))
            ((unless (member-eq code '(:more :done))) (fn2-checkpoint-compaction-merge-mv code))
            (fn2-checkpoint-compaction (fn2-checkpoint-compaction-put 0
             (copy-field field) (copy-offset copied) (copy-end end)))
            (fn2-checkpoint-compaction
             (if (eq code :done)
              (fn2-checkpoint-compaction-put 0 (phase *fn2-checkpoint-compaction-phase-park*)
               (best 1) (best-kind skind) (best-row r)
               (best-order (fn2-checkpoint-compaction-source-order 0 fn2-checkpoint-compaction))) fn2-checkpoint-compaction)))
        (fn2-checkpoint-compaction-merge-mv :more)))
      ((unless (equal phase *fn2-checkpoint-compaction-phase-seek*))
       (fn2-checkpoint-compaction-merge-mv :phase))
      ((when (and (equal skind 1) (equal (fn2-checkpoint-compaction-source-started 0 fn2-checkpoint-compaction) 0)))
       (b* (((mv code fn2-run-cursors) (fn2-run-cursor-start-installed c r rb dk ds dg fn2-run-installed fn2-run-cursors))
            (fn2-checkpoint-compaction (if (eq code :ok)
             (fn2-checkpoint-compaction-set-source-started 0 1 fn2-checkpoint-compaction) fn2-checkpoint-compaction)))
        (fn2-checkpoint-compaction-merge-mv (if (eq code :ok) :more code))))
      (reading-header (and (equal skind 1)
                           (equal (fn2-run-cursors-phase c fn2-run-cursors) *fn2-run-cursor-phase-header*)))
      ((mv code fn2-checkpoint-compaction fn2-run-cursors fn2-run-paths fn2-fields)
       (if (equal skind 0)
        (b* (((mv code pos & fn2-fields)
              (if (equal (fn2-checkpoint-compaction-source-started 0 fn2-checkpoint-compaction) 0)
               (fn2-ov-locate r ib lb dk ds dg fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
               (mv :ok (+ 1 (fn2-checkpoint-compaction-source-position 0 fn2-checkpoint-compaction)) :gt fn2-fields)))
             ((unless (eq code :ok)) (mv code fn2-checkpoint-compaction fn2-run-cursors fn2-run-paths fn2-fields))
             ((unless (and (unsigned-byte-p 32 pos) (< pos (fn2-overlays-count r fn2-overlays))))
              (let ((fn2-checkpoint-compaction
                     (if (unsigned-byte-p 32 pos)
                      (fn2-checkpoint-compaction-put 0 (source-started 1) (source-position pos)) fn2-checkpoint-compaction)))
               (mv :end fn2-checkpoint-compaction fn2-run-cursors fn2-run-paths fn2-fields)))
             ((mv code & fn2-fields) (fn2-ov-entry r pos ib fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
             (fn2-checkpoint-compaction (if (eq code :ok)
              (fn2-checkpoint-compaction-put 0 (source-started 1) (source-position pos)) fn2-checkpoint-compaction)))
         (mv (if (eq code :ok) :entry code) fn2-checkpoint-compaction fn2-run-cursors fn2-run-paths fn2-fields))
        (mv-let (code fn2-run-cursors fn2-run-paths fn2-fields)
         (fn2-run-scan-step c budget lb dk ds dg fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool)
         (mv code fn2-checkpoint-compaction fn2-run-cursors fn2-run-paths fn2-fields))))
      ((unless (or (not reading-header) (not (eq code :more))
                   (fn2-checkpoint-source-run-headerp r rb
                    (fn2-checkpoint-build-history 0 fn2-checkpoint-build)
                    (fn2-checkpoint-build-history-incarnation 0 fn2-checkpoint-build) fn2-run-installed fn2-fields)))
       (fn2-checkpoint-compaction-merge-fail :source-identity))
      ((when (eq code :end))
       (let ((fn2-checkpoint-compaction (fn2-checkpoint-compaction-set-phase 0 *fn2-checkpoint-compaction-phase-source-end* fn2-checkpoint-compaction)))
        (fn2-checkpoint-compaction-merge-mv :source-end)))
      ((unless (eq code :entry))
       (if (member-eq code '(:more :miss :yield))
        (fn2-checkpoint-compaction-merge-mv (if (eq code :miss) :need-read code))
        (fn2-checkpoint-compaction-merge-fail code)))
      ((unless (or (equal skind 0)
                   (and (equal (fn2-run-cursors-phase c fn2-run-cursors) *fn2-run-cursor-phase-at*)
                        (fn2-checkpoint-source-run-headerp r rb
                         (fn2-checkpoint-build-history 0 fn2-checkpoint-build)
                         (fn2-checkpoint-build-history-incarnation 0 fn2-checkpoint-build) fn2-run-installed fn2-fields))))
       (fn2-checkpoint-compaction-merge-fail :source-identity))
      (sk (if (equal skind 0) (fn2-overlays-okind r fn2-overlays) (fn2-run-cursors-okind c fn2-run-cursors)))
      (ss (if (equal skind 0) (fn2-overlays-oslot r fn2-overlays) (fn2-run-cursors-oslot c fn2-run-cursors)))
      (sg (if (equal skind 0) (fn2-overlays-ogen r fn2-overlays) (fn2-run-cursors-ogen c fn2-run-cursors)))
      ((mv code lower-order)
       (if (equal (fn2-checkpoint-compaction-has-lower 0 fn2-checkpoint-compaction) 1)
        (fn2-run-layout-compare sid ib lb sk ss sg dk ds dg fn2-fields fn2-pool)
        (mv :ok :gt)))
      ((unless (eq code :ok)) (fn2-checkpoint-compaction-merge-fail code))
      ; Reseek is inclusive. Equal heads advance through the same source's
      ; actual NEXT operation; no integer/octet successor parser is invented.
      ((when (eq lower-order :eq))
       (let ((fn2-checkpoint-compaction (fn2-checkpoint-compaction-set-phase 0 *fn2-checkpoint-compaction-phase-equal-lower* fn2-checkpoint-compaction)))
        ; The original-source inventory must count this exact emitted key
        ; once before the cursor's next operation may run.
        (fn2-checkpoint-compaction-merge-mv :source-key)))
      ((unless (eq lower-order :gt)) (fn2-checkpoint-compaction-merge-fail :order))
      ((mv code best-order)
       (if (equal (fn2-checkpoint-compaction-best 0 fn2-checkpoint-compaction) 1)
        (fn2-run-layout-compare sid ib eb sk ss sg dk ds dg fn2-fields fn2-pool)
        (mv :ok :lt)))
      ((unless (eq code :ok)) (fn2-checkpoint-compaction-merge-fail code))
      (replace (or (eq best-order :lt)
                   (and (eq best-order :eq)
                    (fn2-checkpoint-source-beforep sid
                     (fn2-checkpoint-compaction-best-kind 0 fn2-checkpoint-compaction)
                     (fn2-checkpoint-compaction-best-order 0 fn2-checkpoint-compaction)
                     (fn2-checkpoint-compaction-best-row 0 fn2-checkpoint-compaction)
                     sid skind (fn2-checkpoint-compaction-source-order 0 fn2-checkpoint-compaction) r))))
      ((unless replace)
       (let ((fn2-checkpoint-compaction (fn2-checkpoint-compaction-set-phase 0 *fn2-checkpoint-compaction-phase-park* fn2-checkpoint-compaction)))
        (fn2-checkpoint-compaction-merge-mv :more)))
      ((mv code fn2-pool) (fn2-pool-reset
       (fn2-checkpoint-compaction-best-slot 0 fn2-checkpoint-compaction)
       (fn2-checkpoint-compaction-best-gen 0 fn2-checkpoint-compaction) dk ds dg fn2-pool))
      ((unless (eq code :ok)) (fn2-checkpoint-compaction-merge-fail code))
      ((mv code fn2-fields) (fn2-range-copy-rows *fn2-run-entry-rows* ib eb fn2-fields))
      ((unless (eq code :ok)) (fn2-checkpoint-compaction-merge-fail code))
      (fn2-checkpoint-compaction (fn2-checkpoint-compaction-put 0
       (phase *fn2-checkpoint-compaction-phase-copy*) (copy-field 0) (copy-offset 0) (copy-end 0)
       (source-okind sk) (source-oslot ss) (source-ogen sg))))
  (fn2-checkpoint-compaction-merge-mv :more)))

;; Rolling upload operations. Global source offsets retain their meaning
;; while the actual C1 workspace is reused only after its covering Fence.
(in-package "ACL2")
(include-book "upload-stream-stage")
(include-book "upload-stream-manifest")
(fn2-book-layer :d)

(defconst *fn2-upload-page-provisional*
  (+ *fn2-upload-page-manifest* *fn2-upload-raw-bytes*))
(defun fn2-upload-stream-page-bytes (total)
  (declare (xargs :guard t))
  (+ *fn2-upload-page-provisional*
     (* *fn2-commit-unit-bytes* (fn2-am-units total))))
(defcost fn2-am-entry-at :doc "Canonical no-straddle entry position.")
(defcost fn2-upload-word-now :doc "Actual parsed header verdict and injection decision.")
(defcost fn2-upload-chunk-fill :doc "Actual filled octets of a retained upload window.")
(defcost fn2-upload-stream-page-bytes :doc "Final manifest region plus profile-derived provisional entry region.")
(defcost fn2-upload-stream-progress :answers (:run :idle :window :gone :refused :fault)
 :faults (:fault) :bytes *fn2-upload-run-bytes*
 :tables (fn2-core-pool fn2-core-b3 fn2-core-digests fn2-core-machines fn2-core-machine-tables)
 :own-writes (hashed source-lines filled stream-end stream-eof word)
 :doc "Consume a bounded resident SOURCE span; capture an actual full body window or EOF.")
(defcost fn2-upload-stream-entry :answers (:ok :fault) :faults (:fault)
 :bytes *fn2-upload-entry-bytes* :tables (fn2-core-pool fn2-core-fields)
 :doc "Append one canonical provisional block entry to the disjoint retained region.")
(defcost fn2-upload-stream-header :answers (:ok :fault) :faults (:fault)
 :bytes *fn2-upload-head-bytes* :tables (fn2-core-pool fn2-core-fields)
 :doc "Encode the final manifest header from the retained original SOURCE digest.")
(defcost fn2-upload-stream-class :doc "Class of the rolling page derived from the actual configured article maximum.")
(defcost fn2-upload-stream-source-final :answers (:ok :fault) :faults (:fault)
 :bytes *fn2-upload-digest-octets* :tables (fn2-core-pool fn2-core-b3 fn2-core-digests)
 :doc "Finalize the original SOURCE context directly into the retained page.")

(defcost fn2-upload-location-tuple :answers (:ok :fault) :faults (:fault)
 :doc "The sealed upload's actual raw payload or promoted manifest-root identity.")
(defcost fn2-upload-stream-page-ready-p :doc "The actual upload page has returned from every borrow and query hold.")
(defmacro fn2-upload-stream-op-events ()
 '(progn
(defun fn2-upload-stream-page-ready-p (id gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (and (eq (fn2-upload-snapshot-read-code id fn2-core) :ok)
      (equal (fn2-machine-generation id fn2-core) gen)
      (let ((ls (fn2-upload-row-lslot id fn2-core)) (lg (fn2-upload-row-lgen id fn2-core)))
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (ok)
        (eq (fn2-pool-workspace-code ls lg *fn2-upload-kind* id gen fn2-pool) :ok) ok))))
(defun fn2-upload-location-tuple (id gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (if (not (and (eq (fn2-upload-snapshot-read-code id fn2-core) :ok)
               (equal (fn2-machine-generation id fn2-core) gen)
               (equal (fn2-upload-row-phase id fn2-core) *fn2-upload-state-sealed*)))
     (mv :fault 0 0 0)
   (let* ((manifest (fn2-am-manifestp (+ (fn2-upload-row-ilen id fn2-core) (fn2-upload-row-hashed id fn2-core))))
          (e (if manifest (fn2-upload-row-rootext id fn2-core) (fn2-upload-row-pext id fn2-core)))
          (ep (if manifest (fn2-upload-row-rootepoch id fn2-core) (fn2-upload-row-pepoch id fn2-core)))
          (al (if manifest (fn2-upload-row-rootalloc id fn2-core) (fn2-upload-row-palloc id fn2-core))))
     (if (equal e *fn2-none*) (mv :fault 0 0 0) (mv :ok e ep al)))))
(defun fn2-upload-stream-class (fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (let* ((bound (stobj-let ((fn2-input-config (fn2-core-input-config fn2-core))) (n)
                 (if (< 0 (fn2-input-config-rows fn2-input-config))
                     (fn2-input-config-article-max 0 fn2-input-config) 0) n))
        (bytes (fn2-upload-stream-page-bytes (+ bound *fn2-upload-mid-line-max*))))
   (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (class)
     (fn2-pool-class-for bytes fn2-pool) class)))
(defun fn2-upload-stream-progress (id gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (b* (((unless (and (eq (fn2-upload-snapshot-read-code id fn2-core) :ok)
                    (equal (fn2-machine-generation id fn2-core) gen)
                    (equal (fn2-upload-row-phase id fn2-core) *fn2-upload-state-stream-receiving*)))
       (mv :fault fn2-core))
      (owner (fn2-upload-row-conn id fn2-core)) (ogen (fn2-upload-row-conn-gen id fn2-core))
      (conn (and (eq (fn2-conn-snapshot-read-code owner fn2-core) :ok)
                 (equal (fn2-machine-generation owner fn2-core) ogen)
                 (equal (fn2-conn-row-upload owner fn2-core) id)
                 (equal (fn2-conn-row-upload-gen owner fn2-core) gen)))
      (cns (and (eq (fn2-cns-snapshot-read-code owner fn2-core) :ok)
                (equal (fn2-machine-generation owner fn2-core) ogen)
                (equal (fn2-cns-row-upload owner fn2-core) id)
                (equal (fn2-cns-row-upload-gen owner fn2-core) gen)))
      ((unless (or conn cns)) (mv :gone fn2-core))
      (fed (if conn (fn2-conn-row-fed owner fn2-core) (fn2-cns-row-fed owner fn2-core)))
      (mode (if conn (fn2-conn-row-feed-mode owner fn2-core) (fn2-cns-row-feed-mode owner fn2-core)))
      (discard (if conn (fn2-conn-row-feed-discard owner fn2-core) (fn2-cns-row-feed-discard owner fn2-core)))
      (eof (equal mode *fn2-conn-feed-done*))
      ((unless (equal discard 0))
       (if (not eof) (mv :idle fn2-core)
         (let* ((word (if (equal discard 4) (fn2-upload-row-word id fn2-core)
                       (fn2-upload-word-code (case discard (1 :framing) (2 :too-large) (otherwise :header-octets)))))
                (fn2-core (fn2-machine-write-word id word fn2-core)))
           (mv (if (equal word 0) :fault :refused) fn2-core))))
      (c0 (fn2-upload-row-c0-slot id fn2-core)) (g0 (fn2-upload-row-c0-gen id fn2-core))
      (c1 (fn2-upload-row-c1-slot id fn2-core)) (g1 (fn2-upload-row-c1-gen id fn2-core))
      (hashed (fn2-upload-row-hashed id fn2-core))
      ((unless (<= hashed fed)) (mv :fault fn2-core))
      ((mv code hashed fn2-core)
       (fn2-upload-hash-run id gen (fn2-upload-hasher id fn2-core) c0 g0 c1 g1 0 hashed fed fn2-core))
      ((unless (and (eq code :ok) (unsigned-byte-p 60 hashed))) (mv :fault fn2-core))
      (fn2-core (fn2-machine-write-hashed id hashed fn2-core))
      (fn2-core (fn2-machine-write-filled id fed fn2-core))
      ((when (< hashed fed)) (mv :run fn2-core))
      (body (fn2-upload-chunk-fill c1 fn2-core))
      ;; The NNTP framer can emit CR LF together. Leave no one-octet
      ;; deadlock at the logical window boundary; the next window resumes it.
      ((unless (or eof (<= (- *fn2-upload-body-window-bytes* 1) body))) (mv :idle fn2-core))
      (fn2-core (fn2-machine-write-stream-end id fed fn2-core))
      (fn2-core (fn2-machine-write-stream-eof id (if eof 1 0) fn2-core)))
   (mv :window fn2-core)))
(fn2-core-preserves fn2-upload-stream-progress (id gen fn2-core) :position 1 :rows nil)
(defun fn2-upload-stream-entry (row ls lg block blen unit epoch alloc mfill kind owner ogen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (let ((at (+ *fn2-upload-page-provisional* (fn2-am-entry-at mfill))))
  (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
   (code end fn2-fields fn2-pool)
   (fn2-am-put-entry (* 128 (nfix row)) block blen unit epoch alloc
      ls lg *fn2-upload-page-hash* ls lg at kind owner ogen fn2-fields fn2-pool)
   (mv (if (eq code :ok) :ok :fault) (nfix (- (nfix end) *fn2-upload-page-provisional*)) fn2-core))))
(fn2-core-preserves fn2-upload-stream-entry
 (row ls lg block blen unit epoch alloc mfill kind owner ogen fn2-core) :position 2 :rows nil)
(defun fn2-upload-stream-header (row ls lg total kind owner ogen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
  (code end fn2-fields fn2-pool)
  (fn2-am-put-header (* 128 (nfix row)) total ls lg *fn2-upload-page-source*
    ls lg *fn2-upload-page-manifest* kind owner ogen fn2-fields fn2-pool)
  (mv (if (eq code :ok) :ok :fault) (nfix (- (nfix end) *fn2-upload-page-manifest*)) fn2-core)))
(fn2-core-preserves fn2-upload-stream-header (row ls lg total kind owner ogen fn2-core) :position 2 :rows nil)
(defun fn2-upload-stream-source-final (id gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (b* (((unless (and (eq (fn2-upload-snapshot-read-code id fn2-core) :ok)
                    (equal (fn2-machine-generation id fn2-core) gen)
                    (equal (fn2-upload-row-stream-eof id fn2-core) 1)
                    (equal (fn2-upload-row-hashed id fn2-core) (fn2-upload-row-stream-end id fn2-core))))
       (mv :fault fn2-core))
      (row (fn2-upload-hasher id fn2-core))
      ((mv code fn2-core) (fn2-upload-digest row (fn2-upload-row-hashed id fn2-core) fn2-core))
      ((unless (eq code :ok)) (mv :fault fn2-core))
      ((mv code fn2-core) (fn2-upload-digest-store row (fn2-upload-row-lslot id fn2-core)
        (fn2-upload-row-lgen id fn2-core) *fn2-upload-page-source* id gen fn2-core)))
  (mv (if (eq code :ok) :ok :fault) fn2-core)))
(fn2-core-preserves fn2-upload-stream-source-final (id gen fn2-core) :position 1 :rows nil)
(in-theory (disable fn2-upload-stream-class fn2-upload-stream-progress fn2-upload-stream-entry
                    fn2-upload-stream-header fn2-upload-stream-source-final))))

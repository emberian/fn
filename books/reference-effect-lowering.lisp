; Generate reference callbacks from admitted implementation bodies. The FIFO
; carrier is opaque data, threaded at the exact shared effect call, never
; reconstructed from native scheduler links or diagnostic records.
(in-package "ACL2")
(include-book "core-product-lowering")

(defconst *fn2-effect-carrier* 'fn2-effect-fifo)
(defun fn2-effect-name (fn)
 (declare (xargs :verify-guards nil))
 (fn2-columns-sym fn "-REF-EFFECT"))
(defun fn2-effect-core-abi-p (fn world)
 (declare (xargs :verify-guards nil))
 (let ((ins (getpropc fn 'stobjs-in nil world)) (outs (getpropc fn 'stobjs-out nil world)))
  (and (equal (remove-eq nil ins) '(fn2-core)) (eq (car (last ins)) 'fn2-core)
       (equal (remove-eq nil outs) '(fn2-core)) (eq (car (last outs)) 'fn2-core))))
(defun fn2-reference-effect-domain (relation)
 (declare (xargs :verify-guards nil))
 `(and (fn2-corep fn2-core) (fn2-ref-corep fn2-ref-core)
       (fn2-core-wfp fn2-core) (fn2-core-wfp fn2-ref-core)
       (,relation fn2-core fn2-ref-core ,*fn2-effect-carrier*)))
(defun fn2-effect-core-lens (fn world)
 (declare (xargs :verify-guards nil))
 (let* ((registry (fn2-core-child-registry world)) (reader (assoc-eq fn registry))
        (writer (assoc-eq fn (fn2-product-writers registry))))
  (or (and reader (fn2-core-child-property reader :stobj)) (cdr writer))))
(mutual-recursion
 (defun fn2-effect-raw-core-use-p (term)
  (declare (xargs :verify-guards nil))
  (cond ((atom term) nil) ((eq (car term) 'quote) nil)
        ((consp (car term))
         (or (fn2-effect-raw-core-use-p (caddar term))
             (fn2-effect-raw-core-use-list-p (cdr term))))
        (t (or (and (member-eq (car term) '(nth update-nth car cdr consp atom len true-listp equal))
                    (member-eq 'fn2-core (cdr term)))
               (fn2-effect-raw-core-use-list-p (cdr term))))))
 (defun fn2-effect-raw-core-use-list-p (terms)
  (declare (xargs :verify-guards nil))
  (and (consp terms) (or (fn2-effect-raw-core-use-p (car terms))
                         (fn2-effect-raw-core-use-list-p (cdr terms))))))
(defun fn2-effect-queue-use-p (fn world)
 (declare (xargs :verify-guards nil))
 (or (member-eq 'fn2-sched (getpropc fn 'stobjs-in nil world))
     (member-eq 'fn2-trace (getpropc fn 'stobjs-in nil world))
     (member-eq 'fn2-trace (getpropc fn 'stobjs-out nil world))
     (member-eq 'fn2-sched (getpropc fn 'stobjs-out nil world))
     (member-eq fn '(fn2-core-sched fn2-core-trace))))
(defun fn2-effect-result-at (fn args index count)
 (declare (xargs :verify-guards nil))
 (if (equal count 1) (cons fn args) (list 'mv-nth index (cons fn args))))
(defun fn2-effect-scalars (fn args n count)
 (declare (xargs :verify-guards nil :measure (nfix n)))
 (if (zp n) nil
  (append (fn2-effect-scalars fn args (1- n) count)
          (list (fn2-effect-result-at fn args (1- n) count)))))
; A leaf is retained only under an exact, admitted whole-R contract.
; Mere existence of an unrelated theorem never authorizes an opaque call.
(defun fn2-effect-core-recognizer-p (fn world)
 (declare (xargs :verify-guards nil))
 ; Use the logical stobj record: ACL2's convenience recognizer lookup
 ; functions are PROGRAM-mode. A spelling match alone authorizes nothing.
 (let ((property (getpropc 'fn2-core 'stobj nil world)))
  (and (eq fn 'fn2-corep)
       (eq (getpropc fn 'stobj-function nil world) 'fn2-core)
       property (eq fn (access stobj-property property :recognizer))
       (equal (len (getpropc fn 'formals nil world)) 1)
       (equal (getpropc fn 'stobjs-in nil world) '(fn2-core))
       (equal (getpropc fn 'stobjs-out nil world) '(nil)))))
(defun fn2-reference-effect-leaf-formula (fn kind relation world)
 (declare (xargs :verify-guards nil))
 (let* ((recognizer (fn2-effect-core-recognizer-p fn world))
        (formals (getpropc fn 'formals nil world))
        (args (if recognizer '(fn2-core) formals))
        (refargs (subst 'fn2-ref-core 'fn2-core args))
        (guard (fn2-lower-source-form
                (fn2-lower-substitute (getpropc fn 'guard t world) (pairlis$ formals args) world)))
        (refguard (fn2-lower-source-form
                   (fn2-lower-substitute (getpropc fn 'guard t world) (pairlis$ formals refargs) world)))
        (count (len (getpropc fn 'stobjs-out nil world)))
        (hyp `(and ,(fn2-reference-effect-domain relation) ,guard ,refguard)))
  (case kind
   (:shape `(implies ,hyp (equal (,fn ,@args) (,fn ,@refargs))))
   (:frame `(implies ,hyp
      (fn2-ref-effect-whole-resultp
       (list ,@(fn2-effect-scalars fn args (1- count) count))
       (list ,@(fn2-effect-scalars fn refargs (1- count) count))
       ,(fn2-effect-result-at fn args (1- count) count)
       ,(fn2-effect-result-at fn refargs (1- count) count) ,*fn2-effect-carrier*)))
   (otherwise nil))))
(defun fn2-effect-leaf-bindings (rows kind relation)
 (declare (xargs :verify-guards nil))
 (if (atom rows) nil
  (acons (caar rows) (list :kind kind :lemma (cdar rows) :relation relation)
         (fn2-effect-leaf-bindings (cdr rows) kind relation))))
(defun fn2-effect-shape-leaf-p (fn leaves world)
 (declare (xargs :verify-guards nil))
 (let* ((row (cdr (assoc-eq fn leaves))) (lemma (fn2-decl-get :lemma row))
        (kind (fn2-decl-get :kind row)) (relation (fn2-decl-get :relation row))
        (outs (getpropc fn 'stobjs-out nil world)))
  (and lemma (getpropc lemma 'theorem nil world)
       (case kind
        (:shape (and (equal outs '(nil))
                     (or (equal (remove-eq nil (getpropc fn 'stobjs-in nil world)) '(fn2-core))
                         (fn2-effect-core-recognizer-p fn world))))
        (:frame (fn2-effect-core-abi-p fn world))
        (otherwise nil))
       (equal (getpropc lemma 'untranslated-theorem nil world)
              (fn2-reference-effect-leaf-formula fn kind relation world)))))

; Plan every core-carrying dependency. Native queue carriers are forbidden
; outside the declared boundary, even below an otherwise non-effectful call.
; An attachment is NOT a logical equation: callers select the implementation
; explicitly, and this planner refuses hidden attachment substitutions.
; Logical equivalent of ACL2's attachment lookup, including its one-level
; symbolic attachment alias and explicit disallowed marker.
(defun fn2-effect-attachment-pair (fn world)
 (declare (xargs :verify-guards nil))
 (let* ((property (getpropc fn 'attachment nil world))
        (pairs (if (symbolp property)
                   (getpropc property 'attachment nil world) property)))
  (and pairs (not (eq (car pairs) :attachment-disallowed))
       (assoc-eq fn pairs))))
(defun fn2-effect-any-p (fns rows)
 (declare (xargs :verify-guards nil))
 (and (consp fns) (or (fn2-decl-get :effect (cdr (assoc-eq (car fns) rows)))
                      (fn2-effect-any-p (cdr fns) rows))))
(mutual-recursion
 (defun fn2-effect-plan-one (fn boundary leaves world stack rows fuel)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (cond
   ((zp fuel) (mv :graph-budget rows))
   ((assoc-eq fn rows) (mv nil rows))
   ((eq fn boundary) (mv nil (acons fn '(:effect t :boundary t) rows)))
   ((fn2-effect-shape-leaf-p fn leaves world)
    (mv nil (acons fn (list :effect nil :leaf-contract (cdr (assoc-eq fn leaves))
                            :leaf-formula (getpropc (fn2-decl-get :lemma (cdr (assoc-eq fn leaves)))
                                                   'untranslated-theorem nil world)) rows)))
   ((assoc-eq fn leaves) (mv (list :invalid-leaf-contract fn) rows))
   ((fn2-effect-queue-use-p fn world) (mv (list :native-queue-outside-boundary fn) rows))
   ((fn2-effect-core-lens fn world)
    (if (member-eq (fn2-effect-core-lens fn world) '(fn2-sched fn2-trace))
        (mv (list :native-queue-outside-boundary fn) rows)
      (mv nil (acons fn (list :effect nil :generated-lens (fn2-effect-core-lens fn world)) rows))))
   ((not (member-eq 'fn2-core (getpropc fn 'stobjs-in nil world))) (mv nil rows))
   ((member-eq fn stack)
    (if (and (eq fn (car stack)) (fn2-lower-scalar-measure fn world)) (mv nil rows)
     (mv (list :unsupported-scc fn stack) rows)))
   ((fn2-effect-attachment-pair fn world) (mv (list :attachment-needs-operational-binding fn (fn2-effect-attachment-pair fn world)) rows))
   (t
    (let* ((body (getpropc fn 'unnormalized-body nil world))
           (calls (and body (fn2-lower-call-names body))))
     (cond ((not (and body (pseudo-termp body))) (mv (list :unknown-core-callee fn) rows))
           ((fn2-effect-raw-core-use-p body) (mv (list :raw-core-inspection fn) rows))
           (t (mv-let (err rows)
       (fn2-effect-plan-list calls boundary leaves world (cons fn stack) rows (1- fuel))
       (let* ((effect (or (member-eq boundary calls) (fn2-effect-any-p calls rows)))
              (problem (or err (and effect (not (fn2-effect-core-abi-p fn world)) (list :effectful-mv-abi fn))
                           (and effect (member-eq *fn2-effect-carrier*
                                          (union-eq (getpropc fn 'formals nil world) (fn2-lower-vars body)))
                                (list :carrier-capture fn)))))
        (mv problem
         (acons fn (list :effect effect :body body :calls calls
                        :formals (getpropc fn 'formals nil world)
                        :inputs (getpropc fn 'stobjs-in nil world)
                        :outputs (getpropc fn 'stobjs-out nil world)
                        :guard (getpropc fn 'guard t world)
                        :measure (fn2-lower-scalar-measure fn world)
                        :event (getpropc fn 'absolute-event-number nil world)) rows))))))))))
 (defun fn2-effect-plan-list (fns boundary leaves world stack rows fuel)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (cond ((atom fns) (mv nil rows)) ((zp fuel) (mv :graph-budget rows))
   (t (mv-let (err rows) (fn2-effect-plan-one (car fns) boundary leaves world stack rows (1- fuel))
       (if err (mv err rows)
        (fn2-effect-plan-list (cdr fns) boundary leaves world stack rows (1- fuel)))))))
)

; The compiler reuses product lowering's IR, literal tuple projections and
; staged MV bindings. Every effectful call returns all original carriers in
; their original positions, followed by the FIFO carrier. Non-effectful
; multi-carrier calls retain their original ABI without conversion.
(defun fn2-effect-env (formals ins)
 (declare (xargs :verify-guards nil))
 (if (atom formals) nil
  (acons (car formals) (if (car ins) (fn2-product-child (car formals))
                        (fn2-product-value (car formals)))
         (fn2-effect-env (cdr formals) (cdr ins)))))
(defun fn2-effect-stobj-tuple-p (ir)
 (declare (xargs :verify-guards nil))
 (and (eq (car ir) :tuple) (member-equal :child (strip-cars (cadr ir)))))
(defun fn2-effect-args-p (irs ins)
 (declare (xargs :verify-guards nil))
 (if (atom irs) (atom ins)
  (and (consp ins)
       (if (car ins) (and (eq (caar irs) :child) (eq (cadar irs) (car ins)))
         (and (not (eq (caar irs) :child)) (not (fn2-effect-stobj-tuple-p (car irs)))))
       (fn2-effect-args-p (cdr irs) (cdr ins)))))
; ACL2 recognizers are the sole legal child-to-ordinary argument case.
; Accept only the actual core recognizer under its exact admitted R leaf
; contract; no generic coercion or queue-reading helper is introduced.
(defun fn2-effect-call-args-p (fn irs ins rows world)
 (declare (xargs :verify-guards nil))
 (or (fn2-effect-args-p irs ins)
     (and (fn2-effect-core-recognizer-p fn world)
          (fn2-decl-get :leaf-contract (cdr (assoc-eq fn rows)))
          (equal irs '((:child fn2-core))))))
(defun fn2-effect-tail (ir)
 (declare (xargs :verify-guards nil))
 (mv-let (err xs) (fn2-product-exprs (fn2-product-flat ir nil))
  (mv err (cons 'mv (append xs (list *fn2-effect-carrier*))))))
(defun fn2-effect-out-ir (vals)
 (declare (xargs :verify-guards nil))
 (if (equal (len vals) 1) (car vals) (list :tuple vals)))

; Reconstitute nested-STOBJ-LET borrowing before emitting ordinary bindings.
; A borrowed child may be used only until the next whole-core operation.
; The matching generated writeback closes a mutable borrow; a read borrow
; exports scalar values and leaves the parent untouched. Escaping/overlapping
; borrows are refused rather than emitted as illegal child getter LETs.
(defun fn2-effect-borrow-prefix (stages)
 (declare (xargs :verify-guards nil))
 (if (or (atom stages)
         (member-eq 'fn2-core (fn2-lower-vars (cadar stages))))
     (mv nil stages)
  (mv-let (prefix rest) (fn2-effect-borrow-prefix (cdr stages))
   (mv (cons (car stages) prefix) rest))))
(defun fn2-effect-stage-vars (stages)
 (declare (xargs :verify-guards nil))
 (if (atom stages) nil
  (union-eq (caar stages) (fn2-effect-stage-vars (cdr stages)))))
(defun fn2-effect-stage-free-vars (stages tail)
 (declare (xargs :verify-guards nil))
 (if (atom stages) (fn2-lower-vars tail)
  (union-eq (fn2-lower-vars (cadar stages))
            (set-difference-eq (fn2-effect-stage-free-vars (cdr stages) tail)
                               (caar stages)))))
(defun fn2-effect-borrow-group (stages registry bindings children)
 (declare (xargs :verify-guards nil))
 (let* ((call (cadar stages))
        (reader (and (consp stages) (consp call) (assoc-eq (car call) registry)))
        (child (and reader (fn2-core-child-property reader :stobj))))
  (if (not reader) (mv nil (reverse bindings) (reverse children) stages)
   (if (or (member-eq child children)
           (not (equal (caar stages) (list child)))
           (not (equal (cdr call) '(fn2-core))))
       (mv :nested-getter-abi nil nil stages)
    (fn2-effect-borrow-group (cdr stages) registry
     (cons (list child call) bindings) (cons child children))))))
(defun fn2-effect-writeback-group (stages writers children updated)
 (declare (xargs :verify-guards nil))
 (let* ((call (cadar stages))
        (writer (and (consp stages) (consp call) (assoc-eq (car call) writers)))
        (child (cdr writer)))
  (if (not writer) (mv nil (reverse updated) stages)
   (if (or (not (member-eq child children)) (member-eq child updated)
           (not (equal (car stages) (list '(fn2-core) (list (car writer) child 'fn2-core)))))
       (mv :nested-writeback-abi nil stages)
    (fn2-effect-writeback-group (cdr stages) writers children (cons child updated))))))
(defun fn2-effect-block (stages tail world fuel)
 (declare (xargs :verify-guards nil :measure (nfix fuel)))
 (cond ((zp fuel) (mv :emission-budget nil))
       ((atom stages) (mv nil tail))
       (t
  (let* ((vars (caar stages)) (call (cadar stages))
         (registry (fn2-core-child-registry world))
         (writers (fn2-product-writers registry))
         (reader (and (consp call) (assoc-eq (car call) registry))))
   (if (not reader)
       (if (and (consp call) (assoc-eq (car call) writers))
           (mv :unpaired-nested-writeback nil)
        (mv-let (err rest) (fn2-effect-block (cdr stages) tail world (1- fuel))
         (mv err (if (equal (len vars) 1)
                     `(let ((,(car vars) ,call)) (declare (ignorable ,@vars)) ,rest)
                   `(mv-let ,vars ,call (declare (ignorable ,@vars)) ,rest)))))
    (mv-let (group-error bindings children body-stages)
     (fn2-effect-borrow-group stages registry nil nil)
     (mv-let (prefix rest) (fn2-effect-borrow-prefix body-stages)
      (mv-let (write-error updated after)
       (fn2-effect-writeback-group rest writers children nil)
       (let* ((live (fn2-effect-stage-free-vars after tail))
              (exports (intersection-eq
                         (set-difference-eq (fn2-effect-stage-vars prefix) children) live))
              (results (append exports updated)))
        (cond
         ((or group-error write-error) (mv (or group-error write-error) nil))
         ((intersectp-eq children live) (mv :escaping-nested-child nil))
         ((or (not results) (member-eq 'fn2-core exports))
          (mv :unsupported-nested-producer nil))
         (t
          (mv-let (err producer)
           (fn2-effect-block prefix (fn2-arms-mvx results) world (1- fuel))
           (mv-let (err2 consumer) (fn2-effect-block after tail world (1- fuel))
            (mv (or err err2)
                `(stobj-let ,bindings ,results ,producer ,consumer)))))))))))))))

(mutual-recursion
 (defun fn2-effect-compile (term env rows boundary replacement world counter fuel)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (cond
   ((zp fuel) (mv :compile-budget nil nil counter))
   ((atom term) (let ((row (assoc-eq term env)))
                 (if row (mv nil nil (cdr row) counter) (mv (list :unbound term) nil nil counter))))
   ((eq (car term) 'quote) (mv nil nil (fn2-product-value term) counter))
   ((consp (car term))
    (mv-let (err stages args next)
     (fn2-effect-compile-list (cdr term) env rows boundary replacement world counter (1- fuel))
     (if (or err (not (equal (len args) (len (cadar term)))))
         (mv (or err :lambda-arity) nil nil next)
      (mv-let (err rest ir final)
       (fn2-effect-compile (caddar term) (append (pairlis$ (cadar term) args) env)
                           rows boundary replacement world next (1- fuel))
       (mv err (append stages rest) ir final)))))
   ((eq (car term) 'if)
    (mv-let (err stages cond-ir next)
     (fn2-effect-compile (cadr term) env rows boundary replacement world counter (1- fuel))
     (mv-let (e1 left lir n1) (fn2-effect-compile (caddr term) env rows boundary replacement world next (1- fuel))
      (mv-let (e2 right rir n2) (fn2-effect-compile (cadddr term) env rows boundary replacement world n1 (1- fuel))
       (mv-let (e3 test) (fn2-product-expr cond-ir)
        (mv-let (e4 ltail) (fn2-effect-tail lir)
         (mv-let (e5 rtail) (fn2-effect-tail rir)
          (let* ((flat (fn2-product-flat lir nil))
                 (mismatch (not (equal (fn2-product-shapes flat) (fn2-product-shapes (fn2-product-flat rir nil))))))
           (mv-let (vars final) (fn2-product-bindings flat n2)
            (mv-let (ir rest) (fn2-product-rebind lir vars nil)
             (declare (ignore rest))
             (mv-let (e6 lbody) (fn2-effect-block left ltail world fuel)
              (mv-let (e7 rbody) (fn2-effect-block right rtail world fuel)
               (mv (or err e1 e2 e3 e4 e5 e6 e7 (and mismatch :branch-mv-shape))
                (append stages (list (list (append vars (list *fn2-effect-carrier*))
                  `(if ,test ,lbody ,rbody)))) ir final)))))))))))))
   ((member-eq (car term) '(return-last wormhole-eval apply$))
    (mv (list :unsupported-control (car term)) nil nil counter))
   (t
    (mv-let (err stages irs next)
     (fn2-effect-compile-list (cdr term) env rows boundary replacement world counter (1- fuel))
     (let ((fn (car term)))
      (cond
       (err (mv err nil nil next))
       ((eq fn 'cons)
        (let ((a (car irs)) (d (cadr irs)))
         (cond ((equal d '(:value (quote nil))) (mv nil stages (list :tuple (list a)) next))
               ((eq (car d) :tuple) (mv nil stages (list :tuple (cons a (cadr d))) next))
               (t (mv-let (bad xs) (fn2-product-exprs irs)
                   (mv bad stages (fn2-product-value (cons 'cons xs)) next))))))
       ((and (eq fn 'mv-nth) (eq (caadr irs) :tuple) (quotep (cadar irs)) (natp (cadr (cadar irs))))
        (let ((i (cadr (cadar irs))) (parts (cadadr irs)))
         (if (< i (len parts)) (mv nil stages (nth i parts) next) (mv :mv-index nil nil next))))
       (t
        (let* ((ins (getpropc fn 'stobjs-in nil world)) (outs (getpropc fn 'stobjs-out nil world))
               (effect (or (eq fn boundary) (fn2-decl-get :effect (cdr (assoc-eq fn rows)))))
               (callee (if (eq fn boundary) replacement (if effect (fn2-effect-name fn) fn))))
         (if (not (and (consp outs) (fn2-effect-call-args-p fn irs ins rows world))) (mv (list :call-mv-abi fn) nil nil next)
          (mv-let (bad args) (fn2-product-exprs irs)
           (mv-let (vars vals final) (fn2-product-outs outs next)
            (mv bad (append stages (list (list (if effect (append vars (list *fn2-effect-carrier*)) vars)
                  (cons callee (if effect (append args (list *fn2-effect-carrier*)) args)))))
                (fn2-effect-out-ir vals) final))))))))))))
 (defun fn2-effect-compile-list (terms env rows boundary replacement world counter fuel)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (cond ((atom terms) (mv nil nil nil counter)) ((zp fuel) (mv :compile-budget nil nil counter))
   (t (mv-let (err stages ir next)
       (fn2-effect-compile (car terms) env rows boundary replacement world counter (1- fuel))
       (if err (mv err nil nil next)
        (mv-let (err rest others final)
         (fn2-effect-compile-list (cdr terms) env rows boundary replacement world next (1- fuel))
         (mv err (append stages rest) (cons ir others) final))))))))

(defun fn2-effect-abi-congruent-p (a b world)
 (declare (xargs :verify-guards nil))
 (if (atom a) (atom b)
  (and (consp b)
       (if (or (car a) (car b))
           (and (car a) (car b) (eq (or (getpropc (car a) 'congruent-stobj-rep nil world) (car a))
               (or (getpropc (car b) 'congruent-stobj-rep nil world) (car b)))) t)
       (fn2-effect-abi-congruent-p (cdr a) (cdr b) world))))
(defun fn2-effect-boundary-abi-p (boundary replacement world)
 (declare (xargs :verify-guards nil))
 (and (fn2-effect-core-abi-p boundary world)
      (function-symbolp replacement world)
      (fn2-effect-abi-congruent-p
       (append (getpropc boundary 'stobjs-in nil world) '(nil))
       (getpropc replacement 'stobjs-in nil world) world)
      (fn2-effect-abi-congruent-p
       (append (getpropc boundary 'stobjs-out nil world) '(nil))
       (getpropc replacement 'stobjs-out nil world) world)))
(defun fn2-effect-generated-names (n)
 (declare (xargs :verify-guards nil :measure (nfix n)))
 (if (zp n) nil (cons (fn2-product-name (1- n)) (fn2-effect-generated-names (1- n)))))
(defun fn2-effect-output-shape-p (ir outs)
 (declare (xargs :verify-guards nil))
 (let ((flat (fn2-product-flat ir nil)))
  (and (equal (len flat) (len outs)) (fn2-effect-args-p flat outs))))



; The relation includes the entire original core, not just a changed field.
; All original scalar results are enumerated in order. The declaration is
; OWED, never a stub/attachment equality or an automatically proved square.
(defun fn2-effect-whole-event (fn lifted row relation world)
 (declare (xargs :verify-guards nil))
 (let* ((args (fn2-decl-get :formals row)) (count (len (fn2-decl-get :outputs row)))
        (refargs (subst 'fn2-ref-core 'fn2-core args))
        (modelargs (append refargs (list *fn2-effect-carrier*)))
        (guard (fn2-decl-get :guard row))
        (refguard (fn2-lower-substitute guard '((fn2-core . fn2-ref-core)) world))
        (theorem (fn2-columns-sym lifted "-WHOLE-RESULT")))
  `(defthm-owed ,theorem ,(append (remove-eq 'fn2-core args) (list 'fn2-core 'fn2-ref-core *fn2-effect-carrier*))
    (implies (and ,(fn2-reference-effect-domain relation) ,guard ,refguard)
     (fn2-ref-effect-whole-resultp
      (list ,@(fn2-effect-scalars fn args (1- count) count))
      (list ,@(fn2-effect-scalars lifted modelargs (1- count) (1+ count)))
      ,(fn2-effect-result-at fn args (1- count) count)
      ,(fn2-effect-result-at lifted modelargs (1- count) (1+ count))
      ,(fn2-effect-result-at lifted modelargs count (1+ count))))
    :schema :g1 :claim :compiler :shared ((:function ,fn))
    :boundary :reference-effect-lowering :sides (:concrete ,fn :reference ,lifted)
    :teeth (,(fn2-columns-sym theorem "-POSITIVE") ,(fn2-columns-sym theorem "-NEGATIVE"))
    :doc "The selected actual implementation and its generated reference callback preserve every original scalar result and the complete core/FIFO representation relation.")))

(mutual-recursion
 (defun fn2-effect-source-graph (fn rows seen fuel)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (cond ((zp fuel) (mv :reuse-graph-budget seen))
        ((or (assoc-eq fn seen) (not (assoc-eq fn rows))) (mv nil seen))
        (t (fn2-effect-source-graph-list
             (fn2-decl-get :calls (cdr (assoc-eq fn rows))) rows
             (acons fn (cdr (assoc-eq fn rows)) seen) (1- fuel)))))
 (defun fn2-effect-source-graph-list (fns rows seen fuel)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (cond ((atom fns) (mv nil seen)) ((zp fuel) (mv :reuse-graph-budget seen))
   (t (mv-let (err next) (fn2-effect-source-graph (car fns) rows seen (1- fuel))
        (if err (mv err next)
         (fn2-effect-source-graph-list (cdr fns) rows next (1- fuel))))))))
(defun fn2-effect-admitted-image (fn world)
 (declare (xargs :verify-guards nil))
 (list :body (getpropc fn 'unnormalized-body nil world)
       :formals (getpropc fn 'formals nil world)
       :inputs (getpropc fn 'stobjs-in nil world)
       :outputs (getpropc fn 'stobjs-out nil world)
       :guard (getpropc fn 'guard t world)
       :event (getpropc fn 'absolute-event-number nil world)))
(defun fn2-effect-reuse-p (stored expected lifted world)
 (declare (xargs :verify-guards nil))
 (and stored (equal (fn2-decl-get :source stored) expected)
      (equal (fn2-decl-get :admitted stored) (fn2-effect-admitted-image lifted world))
      (equal (fn2-decl-get :whole-row stored)
             (cdr (assoc-eq (fn2-columns-sym lifted "-WHOLE-RESULT")
                            (table-alist 'fn2-squares world))))))
(defun fn2-effect-definition-events (fn row rows boundary replacement relation world)
 (declare (xargs :verify-guards nil))
 (let* ((formals (fn2-decl-get :formals row)) (inputs (fn2-decl-get :inputs row))
        (outs (fn2-decl-get :outputs row)) (body (fn2-decl-get :body row))
        (lifted (fn2-effect-name fn)) (measure (fn2-decl-get :measure row)))
  (mv-let (err stages ir counter)
   (fn2-effect-compile body (fn2-effect-env formals inputs) rows boundary replacement world 0 100000)
   (mv-let (err2 tail) (fn2-effect-tail ir)
    (mv-let (emission-error emitted-body) (fn2-effect-block stages tail world 100000)
     (mv-let (graph-error graph) (fn2-effect-source-graph fn rows nil 100000)
      (let* ((problem
              (or err err2 emission-error graph-error
                  (and (not (fn2-effect-output-shape-p ir outs)) :result-mv-abi)
                  (and (intersection-eq (fn2-effect-generated-names counter)
                          (union-eq formals (fn2-lower-vars body))) :generated-variable-capture)))
             (definition
              `(defun ,lifted (,@formals ,*fn2-effect-carrier*)
                (declare (xargs :stobjs (fn2-core) :verify-guards nil
                          :guard ,(fn2-lower-source-form (fn2-decl-get :guard row))
                          ,@(and measure (list :measure (fn2-lower-source-form measure)))))
                ,emitted-body))
             (whole (fn2-effect-whole-event fn lifted row relation world))
             (source (list :definition definition :whole whole :graph graph
                           :boundary boundary :replacement replacement :relation relation
                           :boundary-image (fn2-effect-admitted-image boundary world)
                           :replacement-image (fn2-effect-admitted-image replacement world)))
             (stored (cdr (assoc-eq fn (table-alist 'fn2-reference-effect-lowered world)))))
       (cond (problem (mv (list fn problem) nil))
             ((function-symbolp lifted world)
              (if (fn2-effect-reuse-p stored source lifted world) (mv nil nil)
               (mv (list fn :stale-generated-function lifted) nil)))
             (t
              (mv nil
               (list definition whole
                `(make-event
                  (value
                   (list 'table 'fn2-reference-effect-lowered '(quote ,fn)
                    (list 'quote
                     (list :source ',source :generated ',lifted
                           :admitted (fn2-effect-admitted-image ',lifted (w state))
                           :whole-row (cdr (assoc-eq ',(fn2-columns-sym lifted "-WHOLE-RESULT")
                                                   (table-alist 'fn2-squares (w state))))))))))))))))))))
; Validate non-effectful core wrappers as well. They remain shared, but
; cannot conceal raw core aliases or native value-context reads behind a
; helper that the effectful root calls. Registered lenses/contracts are
; explicit leaves and have no body in this derived graph.
(defun fn2-effect-validate-bodies (rows all boundary replacement world)
 (declare (xargs :verify-guards nil))
 (if (atom rows) nil
  (let* ((fn (caar rows)) (row (cdar rows)) (body (fn2-decl-get :body row)))
   (if (not body) (fn2-effect-validate-bodies (cdr rows) all boundary replacement world)
    (mv-let (err stages ir counter)
     (fn2-effect-compile body
      (fn2-effect-env (fn2-decl-get :formals row) (fn2-decl-get :inputs row))
      all boundary replacement world 0 100000)
     (declare (ignore stages counter))
     (if (or err (not (fn2-effect-output-shape-p ir (fn2-decl-get :outputs row))))
         (list :unshared-callee-body fn (or err :result-mv-abi))
       (fn2-effect-validate-bodies (cdr rows) all boundary replacement world)))))))
(defun fn2-effect-definition-list (rows all boundary replacement relation world)
 (declare (xargs :verify-guards nil))
 (if (atom rows) (mv nil nil)
  (mv-let (err rest) (fn2-effect-definition-list (cdr rows) all boundary replacement relation world)
   (if err (mv err nil)
    (if (or (eq (caar rows) boundary) (not (fn2-decl-get :effect (cdar rows)))) (mv nil rest)
     (mv-let (err events)
      (fn2-effect-definition-events (caar rows) (cdar rows) all boundary replacement relation world)
      (mv err (append rest events))))))))

; Operational selections are keyed by the constrained symbol: distinct stubs
; may select the same implementation. Direct calls have a separate namespace
; and make no claim about a served dispatcher or a future attachment world.
(defun fn2-effect-selection-key (fn selected-from)
 (if selected-from selected-from (list :direct-call fn)))

(defun fn2-reference-effect-events (fn boundary replacement relation leaves selected-from world)
 (declare (xargs :verify-guards nil))
 (cond
  ((not (fn2-effect-boundary-abi-p boundary replacement world)) (mv :boundary-mv-abi nil))
  ((not (and (function-symbolp relation world)
             (function-symbolp 'fn2-ref-effect-whole-resultp world))) (mv :missing-full-result-relation nil))
  ((and selected-from (not (equal (fn2-effect-attachment-pair selected-from world) (cons selected-from fn))))
   (mv :selected-implementation-binding nil))
  (t
   (mv-let (err rows) (fn2-effect-plan-one fn boundary leaves world nil nil 100000)
    (cond (err (mv err nil))
          ((fn2-effect-validate-bodies rows rows boundary replacement world)
           (mv (fn2-effect-validate-bodies rows rows boundary replacement world) nil))
          ((not (fn2-decl-get :effect (cdr (assoc-eq fn rows)))) (mv :no-declared-effect-path nil))
          (t (mv-let (err events) (fn2-effect-definition-list rows rows boundary replacement relation world)
              (mv err (and (not err)
               (append events
                `((table fn2-reference-effect-selections ',(fn2-effect-selection-key fn selected-from)
                   '(:selected-from ,selected-from :implementation ,fn
                     :scope ,(if selected-from :selected-implementation :direct-call)
                     :attachment ,(and selected-from (fn2-effect-attachment-pair selected-from world))
                     :boundary ,boundary :replacement ,replacement :relation ,relation
                     :leaves ,leaves :graph ,rows
                     :logical-stub-equality nil :whole-subject ,fn)))))))))))))

(defmacro fn2-reference-effect-lower (fn &key
 (boundary 'fn2-core-scheduler-wake) (replacement 'fn2-ref-effect-scheduler-wake)
 (relation 'fn2-representation-relation) shape-leaves frame-leaves selected-from)
 `(make-event
   (mv-let (problem events)
    (fn2-reference-effect-events ',fn ',boundary ',replacement ',relation
     (append (fn2-effect-leaf-bindings ',shape-leaves :shape ',relation)
             (fn2-effect-leaf-bindings ',frame-leaves :frame ',relation)) ',selected-from (w state))
    (if problem
        (er soft 'fn2-reference-effect-lower "Refused reference effect lowering of ~x0: ~x1." ',fn problem)
      (value (cons 'progn events))))))

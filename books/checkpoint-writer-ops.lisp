      ((unless (fn2-checkpoint-future-no-loansp 1 5 fn2-checkpoint-future-windows))
       (mv :pending 0 0 0 0 0 0 fn2-pool fn2-control fn2-checkpoint-future-windows))
      ((mv code fn2-checkpoint-future-windows fn2-pool)
       (fn2-checkpoint-future-borrow-anchor token master-kind master-slot master-gen kind owner generation
        fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
      ((unless (eq code :ok)) (mv code 0 0 0 0 0 0 fn2-pool fn2-control fn2-checkpoint-future-windows))
      ((mv c0 s0 g0) (fn2-checkpoint-future-lease 5 token kind owner generation fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
      ((mv c1 s1 g1) (fn2-checkpoint-future-lease 6 token kind owner generation fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
      ((mv cs ss gs) (fn2-checkpoint-future-lease 7 token kind owner generation fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)))
  (mv (if (and (eq c0 :ok) (eq c1 :ok) (eq cs :ok)) :ok :partial)

 (b* (((unless (and (fn2-checkpoint-builder-claimp c token master-kind master-slot master-gen fn2-checkpoints)
                     (fn2-checkpoint-future-ownerp master-kind master-slot master-gen fn2-checkpoint-future)
                     (equal c (fn2-checkpoint-future-candidate 0 fn2-checkpoint-future))
                     (equal token (fn2-checkpoint-future-token 0 fn2-checkpoint-future))
                     (<= 8 (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows))))

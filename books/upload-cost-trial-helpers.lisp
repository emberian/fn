(in-package "ACL2")
(defun fn2-columns-simple-disablep (event)
 (declare (xargs :verify-guards nil))
 (and (true-listp event) (equal (len event) 2) (eq (car event) 'in-theory)
      (consp (cadr event)) (eq (caadr event) 'disable)
      (true-listp (cdadr event)) (symbol-listp (cdadr event))))
(defun fn2-columns-theory-barrierp (event)
 (declare (xargs :verify-guards nil :measure (acl2-count event)))
 (cond ((atom event) nil)
       ((member-eq (car event) '(in-theory in-theory! deftheory deftheory-static
                                 make-event encapsulate table)) t)
       ((eq (car event) 'local) (fn2-columns-theory-barrierp (cadr event)))
       ((member-eq (car event) '(progn progn!))
        (fn2-columns-theory-barrierp (cdr event)))
       ((consp (car event))
        (or (fn2-columns-theory-barrierp (car event))
            (fn2-columns-theory-barrierp (cdr event))))
       (t nil)))
(defun fn2-columns-disable-event (reversed-runes)
 (declare (xargs :verify-guards nil))
 (list 'in-theory (cons 'disable (reverse reversed-runes))))
(defun fn2-columns-batch-phase-aux (events disabled out)
 (declare (xargs :verify-guards nil :measure (acl2-count events)))
 (if (atom events)
     (reverse (if disabled (cons (fn2-columns-disable-event disabled) out) out))
  (let ((event (car events)))
   (cond ((and (fn2-columns-simple-disablep event) (cdadr event))
          (fn2-columns-batch-phase-aux (cdr events)
            (revappend (cdadr event) disabled) out))
         ((fn2-columns-theory-barrierp event)
          (fn2-columns-batch-phase-aux (cdr events) nil
            (cons event (if disabled (cons (fn2-columns-disable-event disabled) out) out))))
         (t (fn2-columns-batch-phase-aux (cdr events) disabled (cons event out)))))))
(defun fn2-columns-batch-phase (events)
 (declare (xargs :verify-guards nil))
 (fn2-columns-batch-phase-aux events nil nil))

(defun fn2-columns-accessor-events-trial (name cols index rows-index)
  (declare (xargs :guard t :verify-guards nil))
  (if (atom cols) nil
    (let* ((read (fn2-columns-col-name name (caar cols)))
           (write (fn2-columns-col-name name
                    (fn2-columns-pre "SET-" (caar cols))))
           (raw (fn2-columns-sym read "$AI"))
           (raw-write (fn2-columns-pre "UPDATE-" raw))
           (rows (fn2-columns-sym name "-ROWS"))
           (wfp (fn2-columns-sym name "-WFP"))
           (p (fn2-columns-sym name "P"))
           (width (fn2-columns-width (cadar cols)))
           (guard `(and (natp i) (,wfp ,name) (< i (,rows ,name))))
           (fit (fn2-columns-fit (cadar cols) 'v)))
      (append
       `((defun ,read (i ,name)
           (declare (xargs :stobjs ,name :guard ,guard
                           :guard-hints (("Goal" :in-theory (disable ,wfp)))))
           (,raw i ,name))
         (defun ,write (i v ,name)
           (declare (xargs :stobjs ,name
                           :guard (and ,guard ,fit)
                           :guard-hints (("Goal" :in-theory (disable ,wfp)))))
           (,raw-write i v ,name))
         (defthm ,(fn2-columns-sym read "-NATP")
           (implies (and (,p ,name) ,guard) (natp (,read i ,name)))
           :rule-classes :type-prescription
           :hints (("Goal" :in-theory (disable ,wfp)
                          :use ((:instance ,(fn2-columns-sym read "$AP-NTH-NATP")
                                           (xs ,(fn2-columns-field-term index name)))))))
         (defthm ,(fn2-columns-sym read "-BOUND")
           (implies (and (,p ,name) ,guard) (< (,read i ,name) ,(expt 2 width)))
           :rule-classes :linear
           :hints (("Goal" :in-theory (disable ,wfp)
                          :use ((:instance ,(fn2-columns-sym read "$AP-NTH-BOUND")
                                           (xs ,(fn2-columns-field-term index name)))))))
         ; Guards simplify accessors to NTH before type inference.  These
         ; matching rules need no rewriting to relieve their hypotheses.
         ; The public result already proves this domain and value. Only open
         ; its accessors to expose the raw term; do not repeat array/shape proof.
         (defthm ,(fn2-columns-sym read "-RAW-NTH-NATP")
           (implies (and (,p ,name) (,wfp ,name) (natp i)
                         (< i (nth ,rows-index ,name)))
                    (natp (nth i ,(fn2-columns-field-term index name))))
           :rule-classes :type-prescription
           :hints (("Goal"
                    :in-theory (union-theories '(,read ,raw ,rows nth zp)
                                               (theory 'minimal-theory))
                    :use ((:instance ,(fn2-columns-sym read "-NATP"))))))
         (defthm ,(fn2-columns-sym read "-RAW-NTH-BOUND")
           (implies (and (,p ,name) (,wfp ,name) (natp i)
                         (< i (nth ,rows-index ,name)))
                    (< (nth i ,(fn2-columns-field-term index name)) ,(expt 2 width)))
           :rule-classes :linear
           :hints (("Goal"
                    :in-theory (union-theories '(,read ,raw ,rows nth zp)
                                               (theory 'minimal-theory))
                    :use ((:instance ,(fn2-columns-sym read "-BOUND"))))))
         (defthm ,(fn2-columns-sym write "-PRESERVES-WFP")
           (implies ,guard (,wfp (,write i v ,name)))
           :hints (("Goal" :in-theory (disable ,wfp)
                          :use ((:instance ,(fn2-columns-sym raw-write "-PRESERVES-WFP"))))))
         (defthm ,(fn2-columns-sym write "-PRESERVES-TYPE")
           (implies (and (,p ,name) ,guard (unsigned-byte-p ,width v))
                    (,p (,write i v ,name)))
           :hints (("Goal" :in-theory (disable ,wfp)
                          :use ((:instance ,(fn2-columns-sym raw-write "-PRESERVES-TYPE"))))))
         (defthm ,(fn2-columns-sym write "-NTH")
           (equal (nth k (,write i v ,name))
                  (if (equal (nfix k) ,index)
                      (update-nth i v (nth ,index ,name)) (nth k ,name))))
         (defthm ,(fn2-columns-sym write "-ROWS")
           (equal (,rows (,write i v ,name)) (,rows ,name)))
         (in-theory (disable ,write)))
       (fn2-columns-accessor-events-trial name (cdr cols) (+ 1 (nfix index)) rows-index)))))


(defun fn2-upload-cost-raw-names (name cols)
 (declare (xargs :verify-guards nil))
 (if (atom cols) nil
  (let ((reader (fn2-columns-sym name (concatenate 'string "-" (symbol-name (caar cols))))))
   (append (list (fn2-columns-sym reader "-RAW-NTH-NATP") (fn2-columns-sym reader "-RAW-NTH-BOUND"))
           (fn2-upload-cost-raw-names name (cdr cols))))))
(defun fn2-upload-cost-drop-hints (xs)
 (declare (xargs :verify-guards nil))
 (cond ((atom xs) xs) ((eq (car xs) :hints) (cddr xs))
       (t (cons (car xs) (fn2-upload-cost-drop-hints (cdr xs))))))
(defun fn2-upload-cost-normalize (x allowed)
 (declare (xargs :verify-guards nil :measure (acl2-count x)))
 (cond ((atom x) x)
       ((fn2-columns-simple-disablep x) :cost-theory)
       ((member-eq (car x) '(defun defun-nx defmacro defconst)) x)
       ((eq (car x) 'defthm)
        (if (member-eq (cadr x) allowed)
         (append (list (car x) (cadr x) (caddr x)) (fn2-upload-cost-drop-hints (cdddr x))) x))
       ((and (consp (car x)) (fn2-columns-simple-disablep (car x)))
        (fn2-upload-cost-normalize (cdr x) allowed))
       (t (cons (fn2-upload-cost-normalize (car x) allowed)
                (fn2-upload-cost-normalize (cdr x) allowed)))))

(defun fn2-columns-events-trial-raw (name cols bound extras init-name put-policy)
  (declare (xargs :guard t :verify-guards nil))
  (let* ((rows (fn2-columns-sym name "-ROWS"))
         (p (fn2-columns-sym name "P"))
         (wfp (fn2-columns-sym name "-WFP"))
         (init (or init-name (fn2-columns-sym name "-INIT")))
         (create (fn2-columns-pre "CREATE-" name))
         (row-view (fn2-columns-sym name "-ROW-VIEW"))
         (view-aux (fn2-columns-sym name "-VIEW-AUX"))
         (fields (append (fn2-columns-fields name cols)
                         `((,rows :type (integer 0 ,(- bound 1)) :initially 0))
                         (fn2-columns-extra-specs extras))))
    (fn2-columns-declare (list :columns name)
      (list :columns (fn2-columns-specs cols)
            :column-reasons (fn2-columns-extra-reasons cols) :rows-bound bound
            :extra-fields (fn2-columns-extra-specs extras)
            :extra-field-reasons (fn2-columns-extra-reasons extras)
            :extra-field-resident (fn2-columns-extra-resident extras) :init-name init :put-policy put-policy)
      nil
      `(; Numeric arrays/scalars use the same library theory as ordinary columns.
       ; Raw/nested/custom extras retain their external constructor rules.
       ,@(if (fn2-columns-all-numeric-fieldsp (fn2-columns-extra-specs extras))
             '((local (in-theory (theory 'fn2-columns-proof-theory)))) nil)
       (local (in-theory (disable update-nth)))
       ,@(fn2-columns-enum-events cols)
       (defstobj ,name ,@fields :inline t)
       ,@(fn2-columns-local-facts (fn2-columns-batch-phase (fn2-columns-all-array-facts fields)))
       ,@(fn2-columns-record-events name fields)
       ,@(fn2-columns-local-facts (fn2-columns-batch-phase (fn2-columns-all-field-facts name (take (len cols) fields) 0 t)))
       ,@(fn2-columns-all-field-facts name (nthcdr (len cols) fields) (len cols) nil)
       (defthm ,(fn2-columns-sym create "-TYPE") (,p (,create))
         :hints (("Goal" :in-theory (enable ,p ,create))))
       (in-theory (disable ,p ,create))
       (defun ,wfp (,name)
         (declare (xargs :stobjs ,name))
         (and (natp (,rows ,name)) (< (,rows ,name) ,bound)
              ,@(fn2-columns-wfp-conjuncts name cols)))
       (defthm ,(fn2-columns-sym wfp "-FORWARD")
         (implies (,wfp ,name)
                  (and (natp (,rows ,name)) (< (,rows ,name) ,bound)))
         :rule-classes :forward-chaining
         :hints (("Goal" :in-theory (enable ,wfp))))
       ,@(fn2-columns-wfp-length-facts name cols 0)
       (defthm ,(fn2-columns-sym create "-WFP") (,wfp (,create))
         :hints (("Goal" :in-theory (enable ,create))))
       ,@(fn2-columns-shape-events name cols bound)
       (defun ,init (n ,name)
         (declare (xargs :stobjs ,name :guard (and (natp n) (< n ,bound))))
         (let* (,@(fn2-columns-resize-bindings name cols)
                ,@(fn2-columns-extra-clears name extras)
                (,name (,(fn2-columns-pre "UPDATE-" rows) n ,name)))
           ,name))
       (defthm ,(fn2-columns-sym init "-PRESERVES-TYPE")
         (implies (and (,p ,name) (natp n) (< n ,bound)) (,p (,init n ,name))))
       (defthm ,(fn2-columns-sym init "-WFP")
         (implies (and (natp n) (< n ,bound)) (,wfp (,init n ,name)))
         :hints (("Goal" :in-theory (enable ,wfp))))
       (defthm ,(fn2-columns-sym init "-NTH")
         (equal (nth k (,init n ,name))
                ,(fn2-columns-init-nth name cols 0 extras)))
       (defthm ,(fn2-columns-sym init "-ROWS")
         (equal (,rows (,init n ,name)) n))
       ,@(fn2-columns-wfp-write-facts name fields (fn2-columns-fields name cols))
       ,@(fn2-columns-batch-phase (fn2-columns-accessor-events-trial name cols 0 (len cols)))
       (defmacro ,(fn2-columns-sym name "-PUT") (slot &rest fields)
         (fn2-columns-put-expansion ',name ',cols ',put-policy slot fields))
       ,(fn2-columns-preserves-macro name)
       (defmacro ,(fn2-columns-sym name "-COPY") (source &optional target)
         (if target `(let* ,(fn2-columns-copy-bindings source target ',fields) ,target)
           (list ',(fn2-columns-sym name "-LOGICAL-SNAPSHOT") source)))
       (defmacro ,(fn2-columns-sym name "-DIFF") (source target &key skip)
         (cons 'or (fn2-columns-diff-terms source target ',fields skip)))
       (defun ,(fn2-columns-sym name "-ROW-SNAPSHOT") (i ,name)
         (declare (xargs :stobjs ,name :guard (and (,wfp ,name) (natp i) (< i (,rows ,name)))) (ignorable i ,name))
         (list ,@(strip-cars (strip-cdrs (strip-cdrs (fn2-columns-row-terms name cols))))))
       ,@(fn2-columns-record-readers name cols 0)
       (defun-nx ,row-view (i ,name)
         (declare (ignorable i ,name))
         (list ,@(fn2-columns-row-terms name cols)))
       (defun-nx ,view-aux (i n ,name)
         (declare (xargs :measure (nfix (- (nfix n) (nfix i)))))
         (if (or (not (natp i)) (not (natp n)) (>= i n)) nil
           (cons (,row-view i ,name) (,view-aux (+ 1 i) n ,name))))
       (defun-nx ,(fn2-columns-sym name "-VIEW") (,name)
         (,view-aux 0 (,rows ,name) ,name))
       (in-theory (disable ,wfp ,init))
       (assert-event (fn2-assert-compliant-p
                      '(,init ,@(fn2-columns-accessor-names name cols)) (w state)))))))

(defun fn2-columns-events-trial (name cols bound extras init-name put-policy)
 (declare (xargs :verify-guards nil))
 (let* ((old (fn2-columns-events name cols bound extras init-name put-policy))
        (new (fn2-columns-events-trial-raw name cols bound extras init-name put-policy))
        (allowed (fn2-upload-cost-raw-names name cols)))
  (if (equal (fn2-upload-cost-normalize old allowed) (fn2-upload-cost-normalize new allowed)) new
   (er hard 'fn2-columns-events-trial "Generated semantic identity control failed."))))


(defmacro fn2-defcolumns-trial (name columns &key (rows-bound '4294967296)
                          extra-fields init-name put-policy)
  (if (not (fn2-columns-extra-okp extra-fields))
      `(make-event (er soft 'defcolumns "Extra field ~x0 of ~x1 requires a nonempty :why."
                      ',(car (fn2-columns-unjustified-extra extra-fields)) ',name))
    (if (and (true-listp columns) (fn2-columns-declarationsp columns)
           (no-duplicatesp-equal (strip-cars columns))
           (integerp rows-bound) (< 0 rows-bound) (<= rows-bound (expt 2 60))
           (true-listp extra-fields)
           (no-duplicatesp-equal
            (fn2-columns-field-names (append (fn2-columns-fields name columns)
                               (list (list (fn2-columns-sym name "-ROWS")))
                               extra-fields)))
           (or (null init-name) (and (symbolp init-name) init-name)))
      `(make-event (value (fn2-columns-events-trial ',name ',columns ,rows-bound
        (fn2-columns-constants ',extra-fields (w state)) ',init-name ',put-policy)))
    (er hard 'defcolumns
        "Invalid defcolumns declaration for ~x0: use distinct column names, supported kinds, unique nonempty enums of at most 256 keywords, a positive rows bound at most 2^60, and a nonempty :why string for every :u64 column."
        name))))

(defun fn2-upload-trial-replace (x)
 (declare (xargs :verify-guards nil :measure (acl2-count x)))
 (cond ((atom x) x)
       ((and (eq (car x) 'defcolumns) (eq (cadr x) 'fn2-upload))
        (cons 'fn2-defcolumns-trial (cdr x)))
       (t (cons (fn2-upload-trial-replace (car x)) (fn2-upload-trial-replace (cdr x))))))
(defun fn2-machine-events-trial (name states fields budget continuations observes capacity initial holds admission taken arms)
 (declare (xargs :verify-guards nil))
 (fn2-upload-trial-replace (fn2-machine-events name states fields budget continuations observes capacity initial holds admission taken arms)))

(defmacro fn2-defmachine-trial (name &key states phases fields budget continuations observes (capacity '1) initial holds
                           admission taken arms subarms stops links sub genesis)
  (let* ((states (or states phases))
         (sub-problem (fn2-machine-sub-problem name sub fields))
         ;; (G3, C gap 5) :genesis (STEP ...): an arm the executor's init runs
         ;; once on each row of the kind, from the row's initial phase
         (genesis (if sub-problem genesis (fn2-machine-sub-nexts name sub genesis)))
         (fields (if sub-problem fields (append fields (fn2-machine-sub-fields name sub))))
         (subarms (if sub-problem subarms (fn2-machine-sub-nexts name sub (append subarms (fn2-machine-sub-subarms name sub)))))
         (arms (if sub-problem arms (fn2-machine-sub-nexts name sub arms)))
         (observes (if (and arms (not sub-problem)) (fn2-machine-sub-nexts name sub observes) observes))
         (phase-fields (fn2-machine-phase-fields fields))
         (phase-problem (fn2-machine-phase-fields-problem name phase-fields states initial admission taken
                                                          (and arms t)))
         (fields (fn2-machine-lower-phase-fields fields))
         (initial (fn2-machine-lower-phase-initial name phase-fields initial))
         (newp (and arms t))
         (holds-while (fn2-machine-holds-while holds))
         (while-problem (fn2-machine-holds-while-problem name holds fields newp))
         (rank-holds (fn2-machine-holds-base holds t))
         (holds (fn2-machine-holds-base holds nil))
         (observe-arms (and newp observes))
         (continuations (if newp (fn2-machine-arm-skeleton name arms "-RUN-") continuations))
         (observes (if newp (fn2-machine-arm-skeleton name observes "-ON-") observes)))
  (if (null (fn2-machine-declaration-problems name states fields stops newp arms observe-arms subarms links
                                               genesis continuations observes initial budget capacity))
      (let* ((own (remove-eq 'phase (strip-cars (append *fn2-machine-common-fields* fields))))
             (problem (or sub-problem (and sub (not newp) (msg "~x0: an inner machine needs the arm language (:arms)." name))
                          phase-problem while-problem
                          (and (not (fn2-arm-subsetp (strip-cars (fn2-arm-get :set taken)) (strip-cars fields)))
                               (msg ":taken :set may initialize only the kind's declared row fields."))
                          (and (doublet-listp (fn2-arm-get :set taken))
           (not (fn2-machine-initialp name (append `((phase (:enum state ,states))) *fn2-machine-common-fields* fields)
                                      states (fn2-arm-get :set taken)))
           (msg ":taken :set ~x0 names a field/value outside the kind's initializer domain." (fn2-arm-get :set taken)))
                          (and (not newp) (fn2-arm-retained-phases holds)
                               (msg "~x0: the retained phase(s) ~x1 need the arm language (:arms)."
                                    name (fn2-arm-retained-phases holds)))
                          (and (not newp) (fn2-arm-contracts-problem name continuations states own nil))
                          (and (not newp) (fn2-arm-contracts-problem name observes states own t))
                          (fn2-arm-holds-problem-syntax name rank-holds states)
                          (fn2-machine-admission-problem name admission states own)
                          (fn2-machine-taken-problem name taken admission states own))))
        (if problem `(make-event (er soft 'defmachine "~@0" ',problem))
          `(progn
             ;; fields of one name across kinds share one dispatcher (assembly-access)
             (make-event (let ((p (fn2-arm-nonnil (fn2-machine-shared-field-problems ',name ',fields (fn2-machine-names (w state)) (w state)))))
                           (if p (er soft 'defmachine "~@0" (fn2-arm-problems (msg "~x0 " ',name) p))
                             (value '(value-triple :shared-fields-ok)))))
             ,(fn2-machine-events-trial name states fields budget continuations observes capacity initial holds
                              admission taken (and newp (list* :arms arms :subarms subarms :observe-arms observe-arms :stops stops
                                                    (append (and phase-fields (list :phase-fields phase-fields))
                                                            (and holds-while (list :holds-while holds-while))
                                                            (and links (list :links links))
                                                            (and genesis (list :genesis genesis)))))))))
    (er hard 'defmachine "Invalid machine declaration ~x0: ~@1" name
        (fn2-arm-problems "" (fn2-machine-declaration-problems name states fields stops newp arms observe-arms subarms
                                                               links genesis continuations observes initial budget capacity))))))

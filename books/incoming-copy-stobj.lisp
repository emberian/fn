; Selected PRF-1143 fixed controller: current carrier/row/plan is the logical
; model; actual next/ack update fixed fields and return scalar multiple values.
; Pool funding/authority is paired by the owner adapter, not duplicated here.
(in-package "ACL2")
(include-book "incoming-setup-ranges")
(defstobj fn-input-copy$c
  (fn-icc-token :initially nil)
  (fn-icc-total :type (integer 0 *) :initially 0)
  (fn-icc-capacity :type (integer 0 *) :initially 0)
  (fn-icc-quantum :type (integer 0 *) :initially 0)
  (fn-icc-offset :type (integer 0 *) :initially 0)
  (fn-icc-pending :initially nil)
  (fn-icc-start :type (integer 0 *) :initially 0)
  (fn-icc-count :type (integer 0 *) :initially 0)
  (fn-icc-end :type (integer 0 *) :initially 0)
  (fn-icc-phase :initially :idle)
  :inline t)
(defun fn-icc$c-model (fn-input-copy$c)
  (declare (xargs :stobjs fn-input-copy$c))
  (if (equal (fn-icc-phase fn-input-copy$c) :idle) nil
    (fn-isr-plan (fn-icc-token fn-input-copy$c) (fn-icc-total fn-input-copy$c)
                 (fn-icc-capacity fn-input-copy$c) (fn-icc-quantum fn-input-copy$c)
                 (fn-icc-offset fn-input-copy$c)
                 (if (fn-icc-pending fn-input-copy$c)
                     (list :incoming-copy (fn-icc-token fn-input-copy$c)
                           (fn-icc-start fn-input-copy$c) (fn-icc-count fn-input-copy$c)) nil)
                 (fn-icc-phase fn-input-copy$c))))
(defun fn-icc$c-wfp (fn-input-copy$c)
  (declare (xargs :stobjs fn-input-copy$c))
  (and (fn-input-copy$cp fn-input-copy$c)
       (booleanp (fn-icc-pending fn-input-copy$c))
       (if (fn-icc-pending fn-input-copy$c)
           (and (equal (fn-icc-start fn-input-copy$c) (fn-icc-offset fn-input-copy$c))
                (equal (fn-icc-count fn-input-copy$c)
                       (min (fn-icc-quantum fn-input-copy$c)
                            (- (fn-icc-total fn-input-copy$c) (fn-icc-offset fn-input-copy$c))))
                (equal (fn-icc-end fn-input-copy$c)
                       (+ (fn-icc-start fn-input-copy$c) (fn-icc-count fn-input-copy$c))))
         (and (equal (fn-icc-start fn-input-copy$c) 0)
              (equal (fn-icc-count fn-input-copy$c) 0)
              (equal (fn-icc-end fn-input-copy$c) 0)))
       (or (equal (fn-icc-phase fn-input-copy$c) :idle)
           (and (fn-ioh-tokenp (fn-icc-token fn-input-copy$c))
                (<= (fn-icc-total fn-input-copy$c) (fn-icc-capacity fn-input-copy$c))
                (posp (fn-icc-quantum fn-input-copy$c))
                (<= (fn-icc-quantum fn-input-copy$c) *fn-cbud-read-quantum*)
                (<= (fn-icc-offset fn-input-copy$c) (fn-icc-total fn-input-copy$c))
                (member-eq (fn-icc-phase fn-input-copy$c) '(:copying :complete :cancelled))
                (if (equal (fn-icc-phase fn-input-copy$c) :complete)
                    (and (equal (fn-icc-offset fn-input-copy$c) (fn-icc-total fn-input-copy$c))
                         (not (fn-icc-pending fn-input-copy$c)))
                  (if (equal (fn-icc-phase fn-input-copy$c) :copying)
                      (< (fn-icc-offset fn-input-copy$c) (fn-icc-total fn-input-copy$c)) t))))))
(defun fn-icc$a-p (a)
  (declare (xargs :guard t))
  (or (null a) (fn-isr-planp a)))
(defun create-fn-icc$a () (declare (xargs :guard t)) nil)
(defun fn-input-copy$corr (fn-input-copy$c a)
  (declare (xargs :stobjs fn-input-copy$c))
  (and (fn-icc$c-wfp fn-input-copy$c)
       (equal (fn-icc$c-model fn-input-copy$c) a)))
(defun fn-icc$a-token (a) (declare (xargs :guard t)) (fn-prl-nth 0 a))
(defun fn-icc$c-token (fn-input-copy$c)
  (declare (xargs :stobjs fn-input-copy$c))
  (if (equal (fn-icc-phase fn-input-copy$c) :idle) nil (fn-icc-token fn-input-copy$c)))
(defun fn-icc$a-open (token total capacity quantum a)
  (declare (xargs :guard t))
  (cond (a (mv :setup-unavailable a))
        ((not (and (fn-ioh-tokenp token) (natp total) (natp capacity)
                   (<= total capacity) (posp quantum) (<= quantum *fn-cbud-read-quantum*)))
         (mv :setup-unavailable a))
        (t (mv :setup-started
               (fn-isr-plan token total capacity quantum 0 nil
                            (if (zp total) :complete :copying))))))
(defun fn-icc$c-open (token total capacity quantum fn-input-copy$c)
  (declare (xargs :stobjs fn-input-copy$c))
  (if (not (and (equal (fn-icc-phase fn-input-copy$c) :idle)
                (fn-ioh-tokenp token) (natp total) (natp capacity) (<= total capacity)
                (posp quantum) (<= quantum *fn-cbud-read-quantum*)))
      (mv :setup-unavailable fn-input-copy$c)
    (let* ((fn-input-copy$c (update-fn-icc-token token fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-total total fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-capacity capacity fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-quantum quantum fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-offset 0 fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-pending nil fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-start 0 fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-count 0 fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-end 0 fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-phase (if (zp total) :complete :copying) fn-input-copy$c)))
      (mv :setup-started fn-input-copy$c))))
(defun fn-icc$a-next (token a)
  (declare (xargs :guard t))
  (if (not (and (fn-ioh-tokenp token) (equal token (fn-prl-nth 0 a))))
      (mv :setup-unavailable 0 0 0 a)
    (mv-let (word grant next) (fn-isr-next a)
      (if (not (equal word :copy)) (mv word 0 0 0 next)
        (let ((start (nfix (fn-prl-nth 2 grant))) (count (nfix (fn-prl-nth 3 grant))))
          (mv word start count (+ start count) next))))))
(defun fn-icc$c-next (token fn-input-copy$c)
  (declare (xargs :stobjs fn-input-copy$c :guard (fn-icc$c-wfp fn-input-copy$c)
                  :guard-hints (("Goal" :in-theory (enable fn-icc$c-wfp)))))
  (cond ((not (and (fn-ioh-tokenp token) (equal token (fn-icc-token fn-input-copy$c))))
         (mv :setup-unavailable 0 0 0 fn-input-copy$c))
        ((equal (fn-icc-phase fn-input-copy$c) :complete) (mv :complete 0 0 0 fn-input-copy$c))
        ((not (equal (fn-icc-phase fn-input-copy$c) :copying))
         (mv :setup-unavailable 0 0 0 fn-input-copy$c))
        ((fn-icc-pending fn-input-copy$c)
         (mv :copy (fn-icc-start fn-input-copy$c) (fn-icc-count fn-input-copy$c)
             (fn-icc-end fn-input-copy$c) fn-input-copy$c))
        (t (let* ((start (fn-icc-offset fn-input-copy$c))
                  (count (min (fn-icc-quantum fn-input-copy$c)
                              (- (fn-icc-total fn-input-copy$c) start)))
                  (end (+ start count))
                  (fn-input-copy$c (update-fn-icc-start start fn-input-copy$c))
                  (fn-input-copy$c (update-fn-icc-count count fn-input-copy$c))
                  (fn-input-copy$c (update-fn-icc-end end fn-input-copy$c))
                  (fn-input-copy$c (update-fn-icc-pending t fn-input-copy$c)))
             (mv :copy start count end fn-input-copy$c)))))
(defun fn-icc$a-ack (token start count end outcome a)
  (declare (xargs :guard t))
  (if (not (and (fn-ioh-tokenp token) (equal token (fn-prl-nth 0 a))
                (natp start) (natp count) (natp end) (equal end (+ start count))))
      (mv :stale-copy a)
    (fn-isr-ack a (list :incoming-copy token start count) outcome)))
(defun fn-icc$c-ack (token start count end outcome fn-input-copy$c)
  (declare (xargs :stobjs fn-input-copy$c :guard (fn-icc$c-wfp fn-input-copy$c)
                  :guard-hints (("Goal" :in-theory (enable fn-icc$c-wfp)))))
  (cond ((not (and (equal (fn-icc-phase fn-input-copy$c) :copying)
                   (fn-icc-pending fn-input-copy$c)
                   (fn-ioh-tokenp token) (equal token (fn-icc-token fn-input-copy$c))
                   (natp start) (natp count) (natp end)
                   (equal start (fn-icc-start fn-input-copy$c))
                   (equal count (fn-icc-count fn-input-copy$c))
                   (equal end (fn-icc-end fn-input-copy$c))))
         (mv :stale-copy fn-input-copy$c))
        ((equal outcome :copied)
         (let* ((fn-input-copy$c (update-fn-icc-offset end fn-input-copy$c))
                (fn-input-copy$c (update-fn-icc-pending nil fn-input-copy$c))
                (fn-input-copy$c (update-fn-icc-start 0 fn-input-copy$c))
                (fn-input-copy$c (update-fn-icc-count 0 fn-input-copy$c))
                (fn-input-copy$c (update-fn-icc-end 0 fn-input-copy$c))
                (fn-input-copy$c (update-fn-icc-phase
                                  (if (equal end (fn-icc-total fn-input-copy$c))
                                      :complete :copying) fn-input-copy$c)))
           (mv :copy-recorded fn-input-copy$c)))
        ((member-eq outcome '(:uncertain :failed))
         (let ((fn-input-copy$c (update-fn-icc-phase :cancelled fn-input-copy$c)))
           (mv :copy-cancelled fn-input-copy$c)))
        (t (mv :invalid-copy-outcome fn-input-copy$c))))
(defun fn-icc$a-close (token joined aliases-clear a)
  (declare (xargs :guard t))
  (if (and (fn-ioh-tokenp token) (equal token (fn-prl-nth 0 a))
           (equal joined t) (equal aliases-clear t))
      (mv :controller-released nil) (mv :incoming-held a)))
(defun fn-icc$c-close (token joined aliases-clear fn-input-copy$c)
  (declare (xargs :stobjs fn-input-copy$c))
  (if (not (and (not (equal (fn-icc-phase fn-input-copy$c) :idle))
                (fn-ioh-tokenp token) (equal token (fn-icc-token fn-input-copy$c))
                (equal joined t) (equal aliases-clear t)))
      (mv :incoming-held fn-input-copy$c)
    (let* ((fn-input-copy$c (update-fn-icc-token nil fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-total 0 fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-capacity 0 fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-quantum 0 fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-offset 0 fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-pending nil fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-start 0 fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-count 0 fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-end 0 fn-input-copy$c))
           (fn-input-copy$c (update-fn-icc-phase :idle fn-input-copy$c)))
      (mv :controller-released fn-input-copy$c))))


; Actual sealer source admission and physical merge cursor ownership.
; Byte parsing, hashing, read pins and completion stay in the shared loader.
(in-package "ACL2")
(include-book "machines-c-sealer")
(include-book "run-physical-region")
(include-book "run-physical-range")
(include-book "run-physical-core-faces")
(fn2-book-layer :c)
(assert-event (<= *fn2-b-seal-source-cursors* *fn2-b-range-source-cursors*))
(defun fn2-sealer-load-status (fn2-seals fn2-overlays fn2-run-installed fn2-pool fn2-csnapshot)
 (declare (xargs :stobjs (fn2-seals fn2-overlays fn2-run-installed fn2-pool fn2-csnapshot)
 :guard (and (fn2-seals-wfp fn2-seals) (fn2-overlays-wfp fn2-overlays) (fn2-run-installed-wfp fn2-run-installed)
  (fn2-pool-wfp fn2-pool) (fn2-csnapshot-wfp fn2-csnapshot))))
 (b* (((unless (< 0 (fn2-seals-rows fn2-seals))) :source)
      (phase (fn2-seals-phase 0 fn2-seals))
      ((when (and (< 0 (fn2-csnapshot-rows fn2-csnapshot))
                   (equal (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-held*)))
       (if (member phase (list *fn2-seal-phase-idle* *fn2-seal-phase-release*)) :park :pause))
      ((when (equal phase *fn2-seal-phase-idle*))
       (if (or (fn2-seal-pending-p fn2-seals fn2-overlays)
               (fn2-seal-compact-pending-p fn2-seals fn2-run-installed fn2-pool))
        :admit :park))
      ((when (equal phase *fn2-seal-phase-release*))
       (let* ((rows (fn2-run-installed-rows fn2-run-installed))
              (r (fn2-seal-retired-row rows 0 fn2-run-installed)))
        (if (and (< r rows) (equal (fn2-run-installed-physical r fn2-run-installed) 1)) :park :run))))
  :run))
(defcost fn2-sealer-load-status-op :child fn2-sealer-load-status :answers (:admit :run :park :pause :source)
 :tables (fn2-core-seals fn2-core-overlays fn2-core-run-installed fn2-core-pool fn2-core-csnapshot)
 :doc "Do not start a source without all private pages; physical retired sources wait for the retained lifetime owner.")
(defun fn2-sealer-load-reserve (kind owner generation fn2-seals fn2-csnapshot
 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (declare (xargs :stobjs (fn2-seals fn2-csnapshot fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 :guard (and (fn2-seals-wfp fn2-seals) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-run-loads-wfp fn2-run-loads)
  (fn2-run-cursors-wfp fn2-run-cursors) (fn2-checkpoint-summary-wfp fn2-checkpoint-summary)
  (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases) (fn2-pool-wfp fn2-pool))))
 (if (not (and (< 0 (fn2-seals-rows fn2-seals))
               (equal (fn2-seals-phase 0 fn2-seals) *fn2-seal-phase-idle*)
               (equal kind *fn2-idc-owner-kind*) (equal generation (fn2-seals-ogen 0 fn2-seals))
               (fn2-pool-mrefp kind owner generation)
               (or (zp (fn2-csnapshot-rows fn2-csnapshot))
                   (not (equal (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-held*)))))
  (mv :source 0 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
  (fn2-run-load-region-reserve (fn2-seals-cbase 0 fn2-seals) *fn2-b-seal-source-cursors* 0 0 0 0 kind owner generation
   fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))
(defcost fn2-sealer-load-reserve-op :child fn2-sealer-load-reserve :answers t
 :tables (fn2-core-seals fn2-core-csnapshot fn2-core-run-loads fn2-core-run-cursors fn2-core-checkpoint-summary fn2-core-checkpoint-summary-leases fn2-core-pool)
 :effects ((:acquire (:storage-window)))
 :doc "Admit the actual sealer cursor region before source mutation; partial ownership is retained solely for cleanup.")
(defun fn2-sealer-load-owner (kind owner generation fn2-seals fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-loads fn2-checkpoint-summary-leases)
 (declare (xargs :stobjs (fn2-seals fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-loads fn2-checkpoint-summary-leases)
 :guard (and (fn2-seals-wfp fn2-seals) (fn2-ranges-wfp fn2-ranges) (fn2-range-sources-wfp fn2-range-sources)
  (fn2-run-cursors-wfp fn2-run-cursors) (fn2-run-loads-wfp fn2-run-loads) (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases))))
 (b* (((unless (and (< 0 (fn2-seals-rows fn2-seals)) (equal kind *fn2-idc-owner-kind*)
                    (equal generation (fn2-seals-ogen 0 fn2-seals)) (fn2-pool-mrefp kind owner generation)
                    (equal (fn2-seals-phase 0 fn2-seals) *fn2-seal-phase-build*)
                    (< 0 (fn2-seals-k 0 fn2-seals)))) (mv :source 0 0 fn2-run-cursors))
      (g (fn2-seals-rg 0 fn2-seals)) (sid (fn2-seals-sid 0 fn2-seals))
      ((unless (and (< g (fn2-ranges-rows fn2-ranges))
                    (equal (fn2-ranges-schema g fn2-ranges) sid)
                    (equal (fn2-ranges-cbase g fn2-ranges) (fn2-seals-cbase 0 fn2-seals))
                    (equal (fn2-ranges-sbase g fn2-ranges) (fn2-seals-sbase 0 fn2-seals))
                    (equal (fn2-ranges-rbase g fn2-ranges) (fn2-seals-rbase 0 fn2-seals))
                    (equal (fn2-ranges-smax g fn2-ranges) *fn2-b-seal-source-cursors*)
                    (<= (fn2-ranges-scount g fn2-ranges) *fn2-b-seal-source-cursors*))) (mv :source 0 0 fn2-run-cursors))
      ((mv code c) (fn2-run-load-range-miss 0 (fn2-ranges-scount g fn2-ranges) g sid fn2-ranges fn2-range-sources fn2-run-cursors))
      ((unless (and (eq code :ok) (< c (fn2-run-loads-rows fn2-run-loads))
                    (< c (fn2-checkpoint-summary-leases-rows fn2-checkpoint-summary-leases))
                    (fn2-run-load-ownerp c kind owner generation fn2-run-loads)
                    (or (equal (fn2-checkpoint-summary-leases-live c fn2-checkpoint-summary-leases) 0)
                        (and (equal kind (fn2-checkpoint-summary-leases-owner-kind c fn2-checkpoint-summary-leases))
                             (equal owner (fn2-checkpoint-summary-leases-owner-slot c fn2-checkpoint-summary-leases))
                             (equal generation (fn2-checkpoint-summary-leases-owner-gen c fn2-checkpoint-summary-leases))))))
       (mv :source 0 0 fn2-run-cursors))
      (phase (fn2-run-loads-phase c fn2-run-loads))
      (fn2-run-cursors (fn2-run-cursors-put c (okind kind) (oslot owner) (ogen generation))))
  (mv :ok c phase fn2-run-cursors)))
(defcost fn2-sealer-load-owner-op :child fn2-sealer-load-owner :answers (:ok :source)
 :tables (fn2-core-seals fn2-core-ranges fn2-core-range-sources fn2-core-run-cursors fn2-core-run-loads fn2-core-checkpoint-summary-leases)
 :doc "Select only the actual sealer range's physical MISS and bind its private page owner, preserving query-key ownership.")
(defun fn2-sealer-load-drain (i kind owner generation fn2-seals fn2-run-loads)
 (declare (xargs :stobjs (fn2-seals fn2-run-loads) :guard (and (fn2-seals-wfp fn2-seals) (fn2-run-loads-wfp fn2-run-loads))))
 (if (not (and (< 0 (fn2-seals-rows fn2-seals))
               (member (fn2-seals-phase 0 fn2-seals) (list *fn2-seal-phase-idle* *fn2-seal-phase-release*))
               (equal kind *fn2-idc-owner-kind*) (equal generation (fn2-seals-ogen 0 fn2-seals)))) (mv :owner 0)
  (fn2-run-load-region-drain i (fn2-seals-cbase 0 fn2-seals) *fn2-b-seal-source-cursors* 0 0 0 0 kind owner generation fn2-run-loads)))
(defcost fn2-sealer-load-drain-op :child fn2-sealer-load-drain :answers t
 :tables (fn2-core-seals fn2-core-run-loads)
 :doc "One exact sealer-owned cursor may drain only after source completion and actual physical pending zero.")
(defun fn2-sealer-load-member-release (i kind owner generation fn2-seals
 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (declare (xargs :stobjs (fn2-seals fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 :guard (and (fn2-seals-wfp fn2-seals) (fn2-run-loads-wfp fn2-run-loads) (fn2-run-cursors-wfp fn2-run-cursors)
  (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases) (fn2-pool-wfp fn2-pool))))
 (b* (((mv code &) (fn2-sealer-load-drain i kind owner generation fn2-seals fn2-run-loads))
      ((unless (eq code :member)) (mv :owner fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))
  (fn2-run-load-region-member-release i (fn2-seals-cbase 0 fn2-seals) *fn2-b-seal-source-cursors* 0 0 0 0 kind owner generation
   fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))
(defcost fn2-sealer-load-member-release-op :child fn2-sealer-load-member-release :answers t
 :tables (fn2-core-seals fn2-core-run-loads fn2-core-run-cursors fn2-core-checkpoint-summary fn2-core-checkpoint-summary-leases fn2-core-pool)
 :doc "Release a real page/catalog member while its exact owned suffix retains storage-window rank.")

(fn2-run-load-frames fn2-sealer-load-reserve
 (kind owner generation fn2-seals fn2-csnapshot fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (fn2-seals fn2-csnapshot fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 ((fn2-run-loads 2) (fn2-run-cursors 3) (fn2-checkpoint-summary 4) (fn2-checkpoint-summary-leases 5) (fn2-pool 6)))

(fn2-run-load-frames fn2-sealer-load-owner
 (kind owner generation fn2-seals fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-loads fn2-checkpoint-summary-leases)
 (fn2-seals fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-loads fn2-checkpoint-summary-leases)
 ((fn2-run-cursors 3)))

(fn2-run-load-frames fn2-sealer-load-member-release
 (i kind owner generation fn2-seals fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (fn2-seals fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 ((fn2-run-loads 1) (fn2-run-cursors 2) (fn2-checkpoint-summary 3) (fn2-checkpoint-summary-leases 4) (fn2-pool 5)))

(defconst *fn2-sealer-loader-operations*
 '(fn2-sealer-load-status-op fn2-sealer-load-reserve-op fn2-sealer-load-owner-op fn2-sealer-load-drain-op fn2-sealer-load-member-release-op))
(defmacro fn2-sealer-loader-core-faces ()
 '(make-event
   (mv-let (err events) (fn2-run-loader-core-face-events *fn2-sealer-loader-operations* (w state))
    (if err (er soft 'fn2-sealer-loader-core-faces "~@0" err) (value (cons 'progn events))))))

; Count actual completed construction, then derive the map/arena/journal
; reservation fixed point. No caller supplies a page or ticket count.
(in-package "ACL2")
(include-book "checkpoint-build-state")
(include-book "checkpoint-construction-owner")
(include-book "checkpoint-capacity")
(fn2-book-layer :c)
(defcolumns fn2-checkpoint-plan
 ((phase (:enum fn2-checkpoint-plan-phase (:idle :count :size :reserve :validate :closed :uncertain)))
  (token :u60) (owner-kind :u8) (owner-slot :u32) (owner-gen :u60) (candidate :u32)
  (scan :u32) (base-pages :u32) (descriptors :u32)
  (role1-bytes :u60) (role3-bytes :u60) (role4-bytes :u60)
  (map-pages :u32) (arena-pages :u32) (tickets :u32)
  (role :u8) (ordinal :u32) (seen-map :u32) (seen-arena :u32) (seen-tickets :u32)
  (validated-base :u32) (validated-descriptors :u32)))
(defcolumns fn2-checkpoint-plan-marks ((map :bool) (arena :bool) (ticket :bool)))

(defun fn2-checkpoint-plan-ownerp-at-phase (phase fn2-checkpoint-plan fn2-csnapshot)
 (declare (xargs :stobjs (fn2-checkpoint-plan fn2-csnapshot)
  :guard (and (fn2-checkpoint-plan-wfp fn2-checkpoint-plan) (fn2-csnapshot-wfp fn2-csnapshot))))
 (and (< 0 (fn2-checkpoint-plan-rows fn2-checkpoint-plan))
      (fn2-csnapshot-ownerp (fn2-checkpoint-plan-token 0 fn2-checkpoint-plan)
        (fn2-checkpoint-plan-owner-kind 0 fn2-checkpoint-plan)
        (fn2-checkpoint-plan-owner-slot 0 fn2-checkpoint-plan)
        (fn2-checkpoint-plan-owner-gen 0 fn2-checkpoint-plan) fn2-csnapshot)
      (equal (fn2-csnapshot-phase 0 fn2-csnapshot) phase)
      (equal (fn2-csnapshot-complete 0 fn2-csnapshot) 1)))
(defun fn2-checkpoint-plan-ownerp (fn2-checkpoint-plan fn2-csnapshot)
 (declare (xargs :stobjs (fn2-checkpoint-plan fn2-csnapshot)
  :guard (and (fn2-checkpoint-plan-wfp fn2-checkpoint-plan) (fn2-csnapshot-wfp fn2-csnapshot))))
 (fn2-checkpoint-plan-ownerp-at-phase *fn2-csnapshot-phase-held* fn2-checkpoint-plan fn2-csnapshot))

(defun fn2-checkpoint-plan-rootp (role c token fn2-checkpoint-refs fn2-checkpoint-construction fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-refs fn2-checkpoint-construction fn2-extents)
  :guard (and (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (and (member-equal role '(1 3 4)) (natp c)
                     (<= (* 6 (+ c 1)) (fn2-checkpoint-refs-rows fn2-checkpoint-refs)))) nil)
      (r (+ (* 6 c) role)) (pu (fn2-checkpoint-refs-physical-unit r fn2-checkpoint-refs))
      (e (floor pu *fn2-storage-extent-units*)))
  (and (equal (mod pu *fn2-storage-extent-units*) 0)
       (fn2-alloc-slotp e fn2-extents) (< e (fn2-checkpoint-construction-rows fn2-checkpoint-construction))
       (equal (fn2-checkpoint-refs-storage-domain r fn2-checkpoint-refs) 0)
       (equal (fn2-checkpoint-refs-root-build-token r fn2-checkpoint-refs) token)
       (equal (fn2-checkpoint-refs-root-source-complete r fn2-checkpoint-refs) 1)
       (posp (fn2-checkpoint-refs-encoded-length r fn2-checkpoint-refs))
       (<= (fn2-checkpoint-refs-encoded-length r fn2-checkpoint-refs)
           (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction))
       (equal (fn2-checkpoint-construction-live e fn2-checkpoint-construction) 1)
       (equal (fn2-checkpoint-construction-token e fn2-checkpoint-construction) token)
       (equal (fn2-checkpoint-construction-role e fn2-checkpoint-construction) role)
       (equal (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs) (fn2-checkpoint-construction-epoch e fn2-checkpoint-construction))
       (equal (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs) (fn2-checkpoint-construction-counter e fn2-checkpoint-construction))
       ; The Ref addresses one root page; its byte counters cover the entire
       ; role's completed construction, checked against actual sums at both EOFs.
       (equal (fn2-checkpoint-refs-root-intended-bytes r fn2-checkpoint-refs)
              (fn2-checkpoint-refs-root-completed-bytes r fn2-checkpoint-refs))
       (<= (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction)
           (fn2-checkpoint-refs-root-intended-bytes r fn2-checkpoint-refs))
       (equal (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction)
              (fn2-checkpoint-construction-completed-bytes e fn2-checkpoint-construction))
       (eq (fn2-alloc-handle-code e (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs)
                                    (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs) fn2-extents) :ok)
       (equal (fn2-extents-state e fn2-extents) *fn2-extent-state-reserved*))))

; Cached sums are populated only by the bounded actual-ledger count. This
; observation never accepts caller-supplied bytes or a generic readiness flag.
(defun fn2-checkpoint-plan-aggregatesp (fn2-checkpoint-plan fn2-checkpoint-refs)
 (declare (xargs :stobjs (fn2-checkpoint-plan fn2-checkpoint-refs)
  :guard (and (fn2-checkpoint-plan-wfp fn2-checkpoint-plan) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs))))
 (and (< 0 (fn2-checkpoint-plan-rows fn2-checkpoint-plan))
      (let ((c (fn2-checkpoint-plan-candidate 0 fn2-checkpoint-plan))
            (token (fn2-checkpoint-plan-token 0 fn2-checkpoint-plan)))
       (and (<= (* 6 (+ c 1)) (fn2-checkpoint-refs-rows fn2-checkpoint-refs))
            (posp (fn2-checkpoint-plan-role1-bytes 0 fn2-checkpoint-plan))
            (equal (fn2-checkpoint-refs-root-build-token (+ (* 6 c) 1) fn2-checkpoint-refs) token)
            (equal (fn2-checkpoint-refs-root-source-complete (+ (* 6 c) 1) fn2-checkpoint-refs) 1)
            (equal (fn2-checkpoint-refs-root-intended-bytes (+ (* 6 c) 1) fn2-checkpoint-refs)
                   (fn2-checkpoint-plan-role1-bytes 0 fn2-checkpoint-plan))
            (equal (fn2-checkpoint-refs-root-completed-bytes (+ (* 6 c) 1) fn2-checkpoint-refs)
                   (fn2-checkpoint-plan-role1-bytes 0 fn2-checkpoint-plan))
            (posp (fn2-checkpoint-plan-role3-bytes 0 fn2-checkpoint-plan))
            (equal (fn2-checkpoint-refs-root-build-token (+ (* 6 c) 3) fn2-checkpoint-refs) token)
            (equal (fn2-checkpoint-refs-root-source-complete (+ (* 6 c) 3) fn2-checkpoint-refs) 1)
            (equal (fn2-checkpoint-refs-root-intended-bytes (+ (* 6 c) 3) fn2-checkpoint-refs)
                   (fn2-checkpoint-plan-role3-bytes 0 fn2-checkpoint-plan))
            (equal (fn2-checkpoint-refs-root-completed-bytes (+ (* 6 c) 3) fn2-checkpoint-refs)
                   (fn2-checkpoint-plan-role3-bytes 0 fn2-checkpoint-plan))
            (posp (fn2-checkpoint-plan-role4-bytes 0 fn2-checkpoint-plan))
            (equal (fn2-checkpoint-refs-root-build-token (+ (* 6 c) 4) fn2-checkpoint-refs) token)
            (equal (fn2-checkpoint-refs-root-source-complete (+ (* 6 c) 4) fn2-checkpoint-refs) 1)
            (equal (fn2-checkpoint-refs-root-intended-bytes (+ (* 6 c) 4) fn2-checkpoint-refs)
                   (fn2-checkpoint-plan-role4-bytes 0 fn2-checkpoint-plan))
            (equal (fn2-checkpoint-refs-root-completed-bytes (+ (* 6 c) 4) fn2-checkpoint-refs)
                   (fn2-checkpoint-plan-role4-bytes 0 fn2-checkpoint-plan))
            ))))

(defun fn2-checkpoint-plan-begin (fn2-checkpoint-plan fn2-csnapshot fn2-checkpoint-build
                                 fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-construction fn2-extents fn2-checkpoint-plan-marks)
 (declare (xargs :stobjs (fn2-checkpoint-plan fn2-csnapshot fn2-checkpoint-build fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-construction fn2-extents fn2-checkpoint-plan-marks)
  :guard (and (fn2-checkpoint-plan-wfp fn2-checkpoint-plan) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-build-wfp fn2-checkpoint-build) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extents-wfp fn2-extents)
              (fn2-checkpoint-plan-marks-wfp fn2-checkpoint-plan-marks))))
 (b* (((unless (and (< 0 (fn2-checkpoint-plan-rows fn2-checkpoint-plan))
                     (equal (fn2-checkpoint-plan-phase 0 fn2-checkpoint-plan) *fn2-checkpoint-plan-phase-idle*)
                     (< 0 (fn2-checkpoint-build-rows fn2-checkpoint-build))
                     (equal (fn2-checkpoint-build-phase 0 fn2-checkpoint-build) *fn2-checkpoint-build-phase-await-roots*)
                     (equal (fn2-checkpoint-plan-marks-rows fn2-checkpoint-plan-marks) (fn2-extents-rows fn2-extents))
                     (equal (fn2-checkpoint-construction-rows fn2-checkpoint-construction) (fn2-extents-rows fn2-extents))
                     (not (fn2-alloc-frozenp fn2-extents))))
       (mv :state fn2-checkpoint-plan fn2-checkpoint-construction))
      (token (fn2-checkpoint-build-snapshot-token 0 fn2-checkpoint-build))
      (kind (fn2-checkpoint-build-owner-kind 0 fn2-checkpoint-build))
      (slot (fn2-checkpoint-build-owner-slot 0 fn2-checkpoint-build))
      (gen (fn2-checkpoint-build-owner-gen 0 fn2-checkpoint-build))
      (c (fn2-checkpoint-build-candidate 0 fn2-checkpoint-build))
      ((unless (and (fn2-checkpoint-build-ownerp token kind slot gen fn2-checkpoint-build fn2-csnapshot)
                     (fn2-checkpoint-builder-ownerp c token kind slot gen fn2-checkpoints)
                     (equal (fn2-csnapshot-complete 0 fn2-csnapshot) 1)
                     (fn2-checkpoint-plan-rootp 1 c token fn2-checkpoint-refs fn2-checkpoint-construction fn2-extents)
                     (fn2-checkpoint-plan-rootp 3 c token fn2-checkpoint-refs fn2-checkpoint-construction fn2-extents)
                     (fn2-checkpoint-plan-rootp 4 c token fn2-checkpoint-refs fn2-checkpoint-construction fn2-extents)))
       (mv :roots-pending fn2-checkpoint-plan fn2-checkpoint-construction))
      (fn2-checkpoint-construction (update-fn2-construction-ticket-scan 0 fn2-checkpoint-construction))
      (fn2-checkpoint-construction (update-fn2-construction-next-ticket 0 fn2-checkpoint-construction))
      (fn2-checkpoint-plan (fn2-checkpoint-plan-put 0 (phase *fn2-checkpoint-plan-phase-count*)
        (token token) (owner-kind kind) (owner-slot slot) (owner-gen gen) (candidate c)
        (scan 0) (base-pages 0) (descriptors 0) (role1-bytes 0) (role3-bytes 0) (role4-bytes 0) (map-pages 0) (arena-pages 0) (tickets 1)
        (role 2) (ordinal 0) (seen-map 0) (seen-arena 0) (seen-tickets 0) (validated-base 0) (validated-descriptors 0))))
  (mv :ok fn2-checkpoint-plan fn2-checkpoint-construction)))

(defun fn2-checkpoint-plan-count-step (fn2-checkpoint-plan fn2-csnapshot fn2-checkpoint-build fn2-checkpoint-refs
                                      fn2-checkpoint-construction fn2-extents fn2-checkpoint-plan-marks)
 (declare (xargs :stobjs (fn2-checkpoint-plan fn2-csnapshot fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-construction fn2-extents fn2-checkpoint-plan-marks)
  :guard (and (fn2-checkpoint-plan-wfp fn2-checkpoint-plan) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-checkpoint-build-wfp fn2-checkpoint-build) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-construction-wfp fn2-checkpoint-construction)
              (fn2-extents-wfp fn2-extents) (fn2-checkpoint-plan-marks-wfp fn2-checkpoint-plan-marks))))
 (b* (((unless (and (fn2-checkpoint-plan-ownerp fn2-checkpoint-plan fn2-csnapshot)
                     (equal (fn2-checkpoint-plan-phase 0 fn2-checkpoint-plan) *fn2-checkpoint-plan-phase-count*)
                     (< 0 (fn2-checkpoint-build-rows fn2-checkpoint-build))
                     (equal (fn2-checkpoint-construction-rows fn2-checkpoint-construction) (fn2-extents-rows fn2-extents))
                     (equal (fn2-checkpoint-plan-marks-rows fn2-checkpoint-plan-marks) (fn2-extents-rows fn2-extents))))
       (mv :state fn2-checkpoint-plan fn2-checkpoint-plan-marks))
      (e (fn2-checkpoint-plan-scan 0 fn2-checkpoint-plan))
      ((when (>= e (fn2-extents-rows fn2-extents)))
       (let* ((valid (and (equal (fn2-checkpoint-plan-descriptors 0 fn2-checkpoint-plan) 1)
                           (fn2-checkpoint-plan-aggregatesp fn2-checkpoint-plan fn2-checkpoint-refs)))
              (fn2-checkpoint-plan (fn2-checkpoint-plan-set-phase 0
               (if valid *fn2-checkpoint-plan-phase-size* *fn2-checkpoint-plan-phase-uncertain*) fn2-checkpoint-plan)))
        (mv (if valid :counted :conflict) fn2-checkpoint-plan fn2-checkpoint-plan-marks)))
      (token (fn2-checkpoint-plan-token 0 fn2-checkpoint-plan))
      (own (and (equal (fn2-checkpoint-construction-live e fn2-checkpoint-construction) 1)
                (equal (fn2-checkpoint-construction-token e fn2-checkpoint-construction) token)))
      (role (fn2-checkpoint-construction-role e fn2-checkpoint-construction))
      (intended (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction))
      (next-role1 (+ (fn2-checkpoint-plan-role1-bytes 0 fn2-checkpoint-plan) (if (and own (equal role 1)) intended 0)))
      (next-role3 (+ (fn2-checkpoint-plan-role3-bytes 0 fn2-checkpoint-plan) (if (and own (equal role 3)) intended 0)))
      (next-role4 (+ (fn2-checkpoint-plan-role4-bytes 0 fn2-checkpoint-plan) (if (and own (equal role 4)) intended 0)))
      (valid (or (not own)
       (and (unsigned-byte-p 60 next-role1) (unsigned-byte-p 60 next-role3) (unsigned-byte-p 60 next-role4)
            (< (fn2-checkpoint-plan-base-pages 0 fn2-checkpoint-plan) (fn2-extents-rows fn2-extents))
            (or (not (equal role 0)) (< (fn2-checkpoint-plan-descriptors 0 fn2-checkpoint-plan) 1)) (equal (fn2-checkpoint-construction-owner-kind e fn2-checkpoint-construction) (fn2-checkpoint-plan-owner-kind 0 fn2-checkpoint-plan))
            (equal (fn2-checkpoint-construction-owner-slot e fn2-checkpoint-construction) (fn2-checkpoint-plan-owner-slot 0 fn2-checkpoint-plan))
            (equal (fn2-checkpoint-construction-owner-gen e fn2-checkpoint-construction) (fn2-checkpoint-plan-owner-gen 0 fn2-checkpoint-plan))
            (eq (fn2-alloc-handle-code e (fn2-checkpoint-construction-epoch e fn2-checkpoint-construction)
                                       (fn2-checkpoint-construction-counter e fn2-checkpoint-construction) fn2-extents) :ok)
            (equal (fn2-extents-state e fn2-extents) *fn2-extent-state-reserved*)
            (if (equal role 0)
             (and (equal e (fn2-checkpoint-build-extent 0 fn2-checkpoint-build))
                  (equal (fn2-checkpoint-construction-epoch e fn2-checkpoint-construction) (fn2-checkpoint-build-epoch 0 fn2-checkpoint-build))
                  (equal (fn2-checkpoint-construction-counter e fn2-checkpoint-construction) (fn2-checkpoint-build-allocation 0 fn2-checkpoint-build))
                  (equal (fn2-checkpoint-construction-ordinal e fn2-checkpoint-construction) 0)
                  (equal (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction) 4096)
                  (equal (fn2-checkpoint-construction-completed-bytes e fn2-checkpoint-construction) 0))
             (and (member-equal role '(1 3 4))
                  (posp (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction))
                  (equal (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction)
                         (fn2-checkpoint-construction-completed-bytes e fn2-checkpoint-construction)))))))
      ((unless valid)
       (let ((fn2-checkpoint-plan (fn2-checkpoint-plan-set-phase 0 *fn2-checkpoint-plan-phase-uncertain* fn2-checkpoint-plan)))
        (mv :conflict fn2-checkpoint-plan fn2-checkpoint-plan-marks)))
      (fn2-checkpoint-plan-marks (fn2-checkpoint-plan-marks-put e (map 0) (arena 0) (ticket 0)))
      (fn2-checkpoint-plan (fn2-checkpoint-plan-put 0 (scan (+ 1 e))
        (role1-bytes next-role1) (role3-bytes next-role3) (role4-bytes next-role4)
        (base-pages (+ (if own 1 0) (fn2-checkpoint-plan-base-pages 0 fn2-checkpoint-plan)))
        (descriptors (+ (if (and own (equal role 0)) 1 0) (fn2-checkpoint-plan-descriptors 0 fn2-checkpoint-plan))))))
  (mv :more fn2-checkpoint-plan fn2-checkpoint-plan-marks)))

(defun fn2-checkpoint-plan-size-step (fn2-checkpoint-plan fn2-csnapshot fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-plan fn2-csnapshot fn2-extents)
  :guard (and (fn2-checkpoint-plan-wfp fn2-checkpoint-plan) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (and (fn2-checkpoint-plan-ownerp fn2-checkpoint-plan fn2-csnapshot)
                     (equal (fn2-checkpoint-plan-phase 0 fn2-checkpoint-plan) *fn2-checkpoint-plan-phase-size*)))
       (mv :state fn2-checkpoint-plan))
      (map-pages (fn2-checkpoint-map-page-count (fn2-extents-rows fn2-extents) *fn2-checkpoint-map-slots*))
      (tickets (fn2-checkpoint-plan-tickets 0 fn2-checkpoint-plan))
      (arena-pages (fn2-checkpoint-map-page-count tickets *fn2-checkpoint-arena-slots*))
      ; Journal tickets allocate themselves through the existing batch install.
      ; Only construction pages need allocation records; installation is last.
      (next (fn2-checkpoint-ticket-demand (fn2-checkpoint-plan-base-pages 0 fn2-checkpoint-plan) map-pages tickets))
      ((unless (and (<= tickets next) (<= next (fn2-extents-rows fn2-extents))
                     (<= (+ map-pages arena-pages next) (fn2-alloc-total-free fn2-extents))))
       (let ((fn2-checkpoint-plan (fn2-checkpoint-plan-set-phase 0 *fn2-checkpoint-plan-phase-uncertain* fn2-checkpoint-plan)))
        (mv :no-space fn2-checkpoint-plan)))
      (fixed (equal tickets next))
      (fn2-checkpoint-plan (fn2-checkpoint-plan-put 0 (map-pages map-pages) (arena-pages arena-pages) (tickets next)
        (phase (if fixed *fn2-checkpoint-plan-phase-reserve* *fn2-checkpoint-plan-phase-size*)))))
  (mv (if fixed :sized :more) fn2-checkpoint-plan)))

(defun fn2-checkpoint-plan-role-count (role fn2-checkpoint-plan)
 (declare (xargs :stobjs fn2-checkpoint-plan :guard (and (fn2-checkpoint-plan-wfp fn2-checkpoint-plan) (< 0 (fn2-checkpoint-plan-rows fn2-checkpoint-plan)))))
 (case role (2 (fn2-checkpoint-plan-map-pages 0 fn2-checkpoint-plan))
            (5 (fn2-checkpoint-plan-arena-pages 0 fn2-checkpoint-plan))
            (6 (fn2-checkpoint-plan-tickets 0 fn2-checkpoint-plan)) (otherwise 0)))

(defun fn2-checkpoint-plan-reserve-step (fn2-checkpoint-plan fn2-csnapshot fn2-checkpoint-construction fn2-extents fn2-control)
 (declare (xargs :stobjs (fn2-checkpoint-plan fn2-csnapshot fn2-checkpoint-construction fn2-extents fn2-control)
  :guard (and (fn2-checkpoint-plan-wfp fn2-checkpoint-plan) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extents-wfp fn2-extents) (fn2-control-wfp fn2-control))))
 (b* (((unless (and (fn2-checkpoint-plan-ownerp fn2-checkpoint-plan fn2-csnapshot)
                     (equal (fn2-checkpoint-plan-phase 0 fn2-checkpoint-plan) *fn2-checkpoint-plan-phase-reserve*)))
       (mv :state fn2-checkpoint-plan fn2-checkpoint-construction fn2-extents fn2-control))
      (role (fn2-checkpoint-plan-role 0 fn2-checkpoint-plan)) (ordinal (fn2-checkpoint-plan-ordinal 0 fn2-checkpoint-plan))
      (expected (fn2-checkpoint-plan-role-count role fn2-checkpoint-plan))
      ((unless (and (member-equal role '(2 5 6)) (<= expected (fn2-extents-rows fn2-extents)) (<= ordinal expected)))
       (mv :bounds fn2-checkpoint-plan fn2-checkpoint-construction fn2-extents fn2-control))
      ((when (equal ordinal expected))
       (let ((fn2-checkpoint-plan (if (equal role 6)
              (fn2-checkpoint-plan-put 0 (phase *fn2-checkpoint-plan-phase-validate*) (scan 0))
              (fn2-checkpoint-plan-put 0 (role (if (equal role 2) 5 6)) (ordinal 0)))))
        (mv :more fn2-checkpoint-plan fn2-checkpoint-construction fn2-extents fn2-control)))
      ((mv code & & & fn2-checkpoint-construction fn2-extents fn2-control)
       (fn2-checkpoint-construction-reserve (fn2-checkpoint-plan-token 0 fn2-checkpoint-plan)
        (fn2-checkpoint-plan-owner-kind 0 fn2-checkpoint-plan) (fn2-checkpoint-plan-owner-slot 0 fn2-checkpoint-plan)
        (fn2-checkpoint-plan-owner-gen 0 fn2-checkpoint-plan) role ordinal
        (if (equal role 6) (* *fn2-commit-unit-bytes* *fn2-commit-write-resources*) *fn2-format-page-size*)
        fn2-csnapshot fn2-checkpoint-construction fn2-extents fn2-control))
      ; The actual ledger retains every successful reservation, including a
      ; prefix on later exhaustion; no rollback or source-complete assertion.
      (fn2-checkpoint-plan (if (eq code :ok)
        (fn2-checkpoint-plan-set-ordinal 0 (+ ordinal 1) fn2-checkpoint-plan)
        (fn2-checkpoint-plan-set-phase 0 *fn2-checkpoint-plan-phase-uncertain* fn2-checkpoint-plan))))
  (mv (if (eq code :ok) :more code) fn2-checkpoint-plan fn2-checkpoint-construction fn2-extents fn2-control)))

(defun fn2-checkpoint-plan-mark (role ordinal fn2-checkpoint-plan-marks)
 (declare (xargs :stobjs fn2-checkpoint-plan-marks
  :guard (and (fn2-checkpoint-plan-marks-wfp fn2-checkpoint-plan-marks) (natp ordinal)
              (< ordinal (fn2-checkpoint-plan-marks-rows fn2-checkpoint-plan-marks)))))
 (case role
  (2 (if (equal (fn2-checkpoint-plan-marks-map ordinal fn2-checkpoint-plan-marks) 1) (mv :duplicate fn2-checkpoint-plan-marks)
       (let ((fn2-checkpoint-plan-marks (fn2-checkpoint-plan-marks-set-map ordinal 1 fn2-checkpoint-plan-marks))) (mv :ok fn2-checkpoint-plan-marks))))
  (5 (if (equal (fn2-checkpoint-plan-marks-arena ordinal fn2-checkpoint-plan-marks) 1) (mv :duplicate fn2-checkpoint-plan-marks)
       (let ((fn2-checkpoint-plan-marks (fn2-checkpoint-plan-marks-set-arena ordinal 1 fn2-checkpoint-plan-marks))) (mv :ok fn2-checkpoint-plan-marks))))
  (6 (if (equal (fn2-checkpoint-plan-marks-ticket ordinal fn2-checkpoint-plan-marks) 1) (mv :duplicate fn2-checkpoint-plan-marks)
       (let ((fn2-checkpoint-plan-marks (fn2-checkpoint-plan-marks-set-ticket ordinal 1 fn2-checkpoint-plan-marks))) (mv :ok fn2-checkpoint-plan-marks))))
  (otherwise (mv :role fn2-checkpoint-plan-marks))))

(defun fn2-checkpoint-plan-validate-step (fn2-checkpoint-plan fn2-csnapshot fn2-checkpoint-build fn2-checkpoint-refs
                                         fn2-checkpoint-construction fn2-extents fn2-checkpoint-plan-marks)
 (declare (xargs :stobjs (fn2-checkpoint-plan fn2-csnapshot fn2-checkpoint-build fn2-checkpoint-refs
                          fn2-checkpoint-construction fn2-extents fn2-checkpoint-plan-marks)
  :guard (and (fn2-checkpoint-plan-wfp fn2-checkpoint-plan) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-checkpoint-build-wfp fn2-checkpoint-build) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extents-wfp fn2-extents)
              (fn2-checkpoint-plan-marks-wfp fn2-checkpoint-plan-marks))))
 (b* (((unless (and (fn2-checkpoint-plan-ownerp fn2-checkpoint-plan fn2-csnapshot)

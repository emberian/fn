; Exact logical batch lookup. Metadata and seal digests share one resident row.
; PARENT=batch-1 is the stored batch tag; a modulo coincidence is insufficient.
; No function in this book advances the base or makes a row reusable.
(in-package "ACL2")
(include-book "machines-b")
(fn2-book-layer :b)
(defun fn2-commit-directory-lookup (batch fn2-commit-root)
 (declare (xargs :stobjs fn2-commit-root :guard (fn2-commit-root-wfp fn2-commit-root)))
 (if (not (and (unsigned-byte-p 60 batch) (posp (fn2-commit-root-rows fn2-commit-root))))
     (mv :state 0)
  (let* ((base (fn2-commit-root-base-batch 0 fn2-commit-root))
         (published (fn2-commit-root-published 0 fn2-commit-root))
         (installed (fn2-commit-root-installed 0 fn2-commit-root))
         (proposed (fn2-commit-root-proposed 0 fn2-commit-root))
         (capacity (- (fn2-commit-root-rows fn2-commit-root) 1)))
   (cond ((not (and (<= base published) (<= published installed) (<= installed proposed)
                    (or (= base 0) (= (fn2-commit-root-base-ready 0 fn2-commit-root) 1)))) (mv :state 0))
         ((= batch base) (mv :base 0))
         ((< batch base) (mv :archived 0))
         ((< installed batch) (mv :absent 0))
         ((not (posp capacity)) (mv :state 0))
         (t (let ((row (+ 1 (mod (- batch 1) capacity))))
             (if (and (= (fn2-commit-root-parent row fn2-commit-root) (- batch 1))
                      (= (fn2-commit-root-seal-ready row fn2-commit-root) 1))
                 (mv :ok row)
               (mv :stale 0))))))))
(defun fn2-commit-directory-seal-slot (batch format-rows fn2-commit-root)
 (declare (xargs :stobjs fn2-commit-root :guard (fn2-commit-root-wfp fn2-commit-root)))
 (if (not (and (unsigned-byte-p 32 format-rows)
               (unsigned-byte-p 32 (* *fn2-digest-stride* format-rows))))
     (mv :bounds 0)
  (mv-let (code row) (fn2-commit-directory-lookup batch fn2-commit-root)
   (if (and (member-eq code '(:ok :base))
            (unsigned-byte-p 32 (+ (* *fn2-digest-stride* format-rows) row)))
       (mv :ok (+ (* *fn2-digest-stride* format-rows) row))
     (mv (if (member-eq code '(:ok :base)) :bounds code) 0)))))
(defthm fn2-commit-directory-lookup-exact-resident
 (implies (and (fn2-commit-rootp fn2-commit-root) (fn2-commit-root-wfp fn2-commit-root)
               (eq (mv-nth 0 (fn2-commit-directory-lookup batch fn2-commit-root)) :ok))
  (let ((row (mv-nth 1 (fn2-commit-directory-lookup batch fn2-commit-root))))
   (and (posp row) (< row (fn2-commit-root-rows fn2-commit-root))
        (= (fn2-commit-root-parent row fn2-commit-root) (- batch 1))
        (= (fn2-commit-root-seal-ready row fn2-commit-root) 1))))
 :hints (("Goal" :in-theory (enable fn2-commit-directory-lookup))))

; Observed boundary metadata; never an authority to discard or reuse.
(defun fn2-commit-directory-base-state (fn2-commit-root)
 (declare (xargs :stobjs fn2-commit-root :guard (fn2-commit-root-wfp fn2-commit-root)))
 (if (not (< 0 (fn2-commit-root-rows fn2-commit-root))) (mv :state 0 0 0)
  (mv :ok (fn2-commit-root-base-batch 0 fn2-commit-root)
          (fn2-commit-root-base-event 0 fn2-commit-root) (fn2-commit-root-base-ready 0 fn2-commit-root))))

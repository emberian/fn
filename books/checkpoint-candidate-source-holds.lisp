; Candidate metadata must outlive every actual C catalog/authority subject.
; Inactive rows may retain bytes; those bytes alone are not an obligation.
(in-package "ACL2")
(include-book "checkpoint-summary-state")
(include-book "checkpoint-summary-authority-state")
(include-book "checkpoint-cbase-state")
(fn2-book-layer :b)
(defun fn2-checkpoint-catalog-source-held-p (c r fn2-checkpoint-summary)
 (declare (xargs :stobjs fn2-checkpoint-summary
 :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (natp c) (natp r))))
 (and (< r 2) (< r (fn2-checkpoint-summary-rows fn2-checkpoint-summary))
      (= c (fn2-checkpoint-summary-candidate r fn2-checkpoint-summary))
      (or (posp (fn2-checkpoint-summary-installed r fn2-checkpoint-summary))
          (posp (fn2-checkpoint-summary-lease-count r fn2-checkpoint-summary))
          (and (posp (fn2-checkpoint-summary-tag r fn2-checkpoint-summary))
               (not (member-equal (fn2-checkpoint-summary-phase r fn2-checkpoint-summary)
                 (list *fn2-checkpoint-summary-phase-idle* *fn2-checkpoint-summary-phase-retired*)))))))
(defun fn2-checkpoint-authority-source-held-p (c r fn2-checkpoint-summary-authority)
 (declare (xargs :stobjs fn2-checkpoint-summary-authority
 :guard (and (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority) (natp c) (natp r))))
 (and (< r 2) (< r (fn2-checkpoint-summary-authority-rows fn2-checkpoint-summary-authority))
      (posp (fn2-checkpoint-summary-authority-tag r fn2-checkpoint-summary-authority))
      (= c (fn2-checkpoint-summary-authority-candidate r fn2-checkpoint-summary-authority))
      (not (= (fn2-checkpoint-summary-authority-phase r fn2-checkpoint-summary-authority)
              *fn2-checkpoint-summary-authority-phase-idle*))))
(defun fn2-checkpoint-candidate-source-held-p (c fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds)
 :guard (and (natp c) (fn2-checkpoint-summary-wfp fn2-checkpoint-summary)
             (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority)
             (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds))))
 (or (fn2-checkpoint-catalog-source-held-p c 0 fn2-checkpoint-summary)
     (fn2-checkpoint-catalog-source-held-p c 1 fn2-checkpoint-summary)
     (fn2-checkpoint-authority-source-held-p c 0 fn2-checkpoint-summary-authority)
     (fn2-checkpoint-authority-source-held-p c 1 fn2-checkpoint-summary-authority)
     (and (< c (fn2-checkpoint-cbase-holds-rows fn2-checkpoint-cbase-holds))
          (not (fn2-checkpoint-cbase-catalog-available-p c
                 (fn2-checkpoint-cbase-holds-tag c fn2-checkpoint-cbase-holds) fn2-checkpoint-cbase-holds)))))

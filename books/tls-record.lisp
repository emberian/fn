; Actual bounded record controller. Native performs one selected physical action.
(in-package "ACL2")
(include-book "tls-transport-reservation")
(include-book "tls-record-state")
(include-book "tls-record-policy")
(fn2-book-layer :d)

(defun fn2-tls-record-start (cap nonce op gen extent parent-serial writep fn2-tls-record)
 (declare (xargs :stobjs fn2-tls-record :verify-guards nil :guard (fn2-tls-record-wfp fn2-tls-record)))
 (if (not (booleanp writep)) (mv :bounds fn2-tls-record)
  (let ((fresh (or (= (fn2-tls-record-rows fn2-tls-record) 0)
                   (not (equal parent-serial (fn2-tls-record-parent-serial 0 fn2-tls-record))))))
   (mv-let (code fn2-tls-record)
    (if (equal parent-serial 0)
        (fn2-tls-record-bind cap nonce op gen extent fn2-tls-record)
      (fn2-tls-record-bind-child cap nonce op gen extent parent-serial fn2-tls-record))
    (cond ((not (eq code :ok)) (mv code fn2-tls-record))
          (fresh (let ((fn2-tls-record (fn2-tls-record-put 0 (writep (if writep 1 0)) (kick 1))))
                   (mv :ok fn2-tls-record)))
          ((equal (fn2-tls-record-writep 0 fn2-tls-record) (if writep 1 0)) (mv :ok fn2-tls-record))
          (t (mv :state fn2-tls-record)))))))

(defun fn2-tls-record-wait (fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-tls-transport fn2-tls-record) :verify-guards nil
  :guard (and (fn2-tls-transport-wfp fn2-tls-transport) (fn2-tls-record-wfp fn2-tls-record))))
 (if (or (= (fn2-tls-record-rows fn2-tls-record) 0) (= (fn2-tls-transport-rows fn2-tls-transport) 0))
     (mv 1 t)
  (mv (fn2-tls-record-interest 0 fn2-tls-record)
      (or (not (= (fn2-tls-transport-terminal 0 fn2-tls-transport) 3))
          (= (fn2-tls-record-kick 0 fn2-tls-record) 1)
          (not (= (fn2-tls-record-seen-progress 0 fn2-tls-record)
                  (fn2-tls-transport-progress-serial 0 fn2-tls-transport)))))))

(defun fn2-tls-record-next (room pending fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-tls-transport fn2-tls-record) :verify-guards nil
  :guard (and (fn2-tls-transport-wfp fn2-tls-transport) (= (fn2-tls-transport-rows fn2-tls-transport) 1)
              (fn2-tls-record-wfp fn2-tls-record) (= (fn2-tls-record-rows fn2-tls-record) 1))))
 (cond
  ((not (and (= (fn2-tls-record-cap 0 fn2-tls-record) (fn2-tls-transport-cap 0 fn2-tls-transport))
              (= (fn2-tls-record-nonce 0 fn2-tls-record) (fn2-tls-transport-nonce 0 fn2-tls-transport))))
   (mv :stale 0 0 0 0 fn2-tls-transport fn2-tls-record))
  ((or (not (= (fn2-tls-record-pending-serial 0 fn2-tls-record) 0))
       (not (= (fn2-tls-transport-pending 0 fn2-tls-transport) 0)))
   (mv :pending 0 0 0 0 fn2-tls-transport fn2-tls-record))
  ((not (and (= (fn2-tls-transport-terminal 0 fn2-tls-transport) 3)
              (= (fn2-tls-transport-alive 0 fn2-tls-transport) 1)))
   (let ((completed (if (= (fn2-tls-record-writep 0 fn2-tls-record) 1)
                        (fn2-tls-record-source-progress 0 fn2-tls-record)
                      (fn2-tls-record-sink-progress 0 fn2-tls-record))))
    (mv-let (finished fn2-tls-record) (fn2-tls-record-finish fn2-tls-record)
     (declare (ignore finished))
     (let ((fn2-tls-record (fn2-tls-record-put 0 (kick 0))))
      (mv :failed 0 0 completed 0 fn2-tls-transport fn2-tls-record)))))
  ((<= #xffffffffffffffe (fn2-tls-transport-serial 0 fn2-tls-transport))
   ; Exhaustion closes while the final physical serial remains reserved for free.
   (let* ((completed (if (= (fn2-tls-record-writep 0 fn2-tls-record) 1)
                         (fn2-tls-record-source-progress 0 fn2-tls-record)
                       (fn2-tls-record-sink-progress 0 fn2-tls-record)))
          (fn2-tls-transport (fn2-tls-transport-put 0 (terminal 2)))
          (fn2-tls-record (fn2-tls-record-put 0 (status 5) (kick 0))))
    (mv :failed 0 0 completed 0 fn2-tls-transport fn2-tls-record)))
  (t
   (mv-let (status action offset count)
    (fn2-tls-record-plan
     (= (fn2-tls-record-writep 0 fn2-tls-record) 1)
     (fn2-tls-record-extent 0 fn2-tls-record)
     (fn2-tls-record-source-progress 0 fn2-tls-record) (fn2-tls-record-sink-progress 0 fn2-tls-record)
     (fn2-tls-record-status 0 fn2-tls-record) (fn2-tls-record-ssl-progress 0 fn2-tls-record)
     (fn2-tls-transport-progress-serial 0 fn2-tls-transport)
     (fn2-tls-transport-copied 0 fn2-tls-transport) (fn2-tls-transport-fed 0 fn2-tls-transport)
     (fn2-tls-transport-input-length 0 fn2-tls-transport) (fn2-tls-transport-input-offset 0 fn2-tls-transport)
     (fn2-tls-transport-output-length 0 fn2-tls-transport) (fn2-tls-transport-output-offset 0 fn2-tls-transport)
     room pending (fn2-tls-transport-quantum 0 fn2-tls-transport))
    (cond
     ((member-equal status '(:done :failed :eof))
      (mv-let (finished fn2-tls-record) (fn2-tls-record-finish fn2-tls-record)
       (declare (ignore finished))
       (let* ((fn2-tls-record (fn2-tls-record-put 0 (kick 0)))
              (fn2-tls-transport (if (eq status :done) fn2-tls-transport
                                   (fn2-tls-transport-put 0 (terminal 2)))))
        (mv status 0 0 count 0 fn2-tls-transport fn2-tls-record))))
     ((not (eq status :act)) (mv status 0 0 0 0 fn2-tls-transport fn2-tls-record))
     (t
      (let* ((source (case action (2 1) (3 2) (5 3) (13 4) (otherwise 0)))
             (sink (case action (4 3) (6 2) (12 5) (otherwise 0)))
             (source-extent (case action
                              (2 (fn2-tls-transport-copied 0 fn2-tls-transport))
                              (3 (fn2-tls-transport-input-length 0 fn2-tls-transport))
                              (5 (fn2-tls-transport-output-length 0 fn2-tls-transport))
                              (13 (fn2-tls-record-extent 0 fn2-tls-record)) (otherwise 0)))
             (sink-extent (case action
                            ((4 6) (fn2-tls-transport-quantum 0 fn2-tls-transport))
                            (12 (fn2-tls-record-extent 0 fn2-tls-record)) (otherwise 0))))
       (if (not (fn2-tls-record-requestable-p (+ 1 (fn2-tls-transport-serial 0 fn2-tls-transport)) action (if (= action 13) count 0) (if (= action 12) count 0) fn2-tls-record))
      (mv :state 0 0 0 0 fn2-tls-transport fn2-tls-record)
      (mv-let (selected serial fn2-tls-transport)
        (fn2-tls-transport-select (fn2-tls-record-cap 0 fn2-tls-record) (fn2-tls-record-nonce 0 fn2-tls-record)
         (fn2-tls-record-slot 0 fn2-tls-record) (fn2-tls-record-generation 0 fn2-tls-record) action
         source (if (= source 0) 0 offset) (if (= source 0) 0 count) source-extent
         sink (if (= sink 0) 0 offset) (if (= sink 0) 0 count) sink-extent fn2-tls-transport)
        (if (not (eq selected :ok)) (mv selected 0 0 0 0 fn2-tls-transport fn2-tls-record)
         (mv-let (reserved fn2-tls-record)
          (fn2-tls-record-request serial action (if (= action 13) count 0) (if (= action 12) count 0) fn2-tls-record)
          (mv (if (eq reserved :ok) :act :state) action offset count serial fn2-tls-transport fn2-tls-record))))))))))))

(defun fn2-tls-record-step-observe (serial raw count errno fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-tls-transport fn2-tls-record) :verify-guards nil
  :guard (and (fn2-tls-transport-wfp fn2-tls-transport) (= (fn2-tls-transport-rows fn2-tls-transport) 1)
              (fn2-tls-record-wfp fn2-tls-record) (= (fn2-tls-record-rows fn2-tls-record) 1))))
 (let ((action (fn2-tls-record-pending-action 0 fn2-tls-record)))
  (if (not (and (equal serial (fn2-tls-record-pending-serial 0 fn2-tls-record))
                (equal action (fn2-tls-transport-pending 0 fn2-tls-transport))
                (fn2-tls-transport-match-p (fn2-tls-record-cap 0 fn2-tls-record)
                 (fn2-tls-record-nonce 0 fn2-tls-record) (fn2-tls-record-slot 0 fn2-tls-record)
                 (fn2-tls-record-generation 0 fn2-tls-record) serial fn2-tls-transport)
                (integerp raw) (unsigned-byte-p 64 (abs raw))
                (unsigned-byte-p 32 count) (unsigned-byte-p 32 errno)
                (or (member-equal action '(12 13)) (= count 0))))
      (mv :stale fn2-tls-transport fn2-tls-record)
   (let* ((ssl (member-equal action '(12 13)))
          (moved (if ssl count (if (< raw 0) 0 raw)))
          (used (if (member-equal action '(2 3 5 13)) moved 0))
          (made (if (member-equal action '(4 6 12)) moved 0))
          (old-progress (if (= action 13) (fn2-tls-record-source-progress 0 fn2-tls-record)
                          (fn2-tls-record-sink-progress 0 fn2-tls-record)))
          (requested (if (= action 13) (fn2-tls-record-source-count 0 fn2-tls-record)
                       (fn2-tls-record-sink-count 0 fn2-tls-record))))
    (if (not (fn2-tls-record-observable-p serial (if (= action 13) used 0) (if (= action 12) made 0) fn2-tls-record))
      (mv :bounds fn2-tls-transport fn2-tls-record)
      (mv-let (observed fn2-tls-transport)
     (fn2-tls-transport-observe-spans (fn2-tls-record-cap 0 fn2-tls-record)
      (fn2-tls-record-nonce 0 fn2-tls-record) (fn2-tls-record-slot 0 fn2-tls-record)
      (fn2-tls-record-generation 0 fn2-tls-record) serial raw used made errno fn2-tls-transport)
     (if (not (eq observed :ok)) (mv observed fn2-tls-transport fn2-tls-record)
      (mv-let (applied fn2-tls-record)
       (fn2-tls-record-observe serial (if (= action 13) used 0) (if (= action 12) made 0) fn2-tls-record)
       (if (not (eq applied :ok)) (mv applied fn2-tls-transport fn2-tls-record)
        (cond
         (ssl
          (mv-let (verdict status next)
           (fn2-tls-record-result (= action 13) raw count requested old-progress (fn2-tls-record-extent 0 fn2-tls-record))
           (declare (ignore verdict next))
           (let* ((fn2-tls-transport (fn2-tls-transport-put 0 (progress-serial serial)))
                  (fn2-tls-record (fn2-tls-record-put 0 (status status) (seen-progress serial) (ssl-progress serial)
                                    (interest (if (= status 2) 4 1)) (kick 1))))
            (mv :ok fn2-tls-transport fn2-tls-record))))
         ((and (member-equal action '(5 6)) (< raw 0) (member-equal errno '(4 11 35)))
          (let ((fn2-tls-record (fn2-tls-record-put 0 (interest (if (= action 5) 4 1))
                              (seen-progress (fn2-tls-transport-progress-serial 0 fn2-tls-transport)) (kick 0))))
           (mv :blocked fn2-tls-transport fn2-tls-record)))
         ((< 0 moved)
          (let* ((fn2-tls-transport (fn2-tls-transport-put 0 (progress-serial serial)))
                 (fn2-tls-record (fn2-tls-record-put 0 (seen-progress serial) (kick 1))))
           (mv :ok fn2-tls-transport fn2-tls-record)))
         (t (let ((fn2-tls-record (fn2-tls-record-put 0 (status 5) (kick 1))))
              (mv :ok fn2-tls-transport fn2-tls-record))))))))))))
)

; Guard-qualified actual entry points; observer proof follows the shared frames.
(verify-guards fn2-tls-record-start
 :hints (("Goal" :in-theory (set-difference-theories (current-theory :here) (theory 'fn2-tls-record-readers)))))
(verify-guards fn2-tls-record-wait
 :hints (("Goal" :in-theory (set-difference-theories (current-theory :here) (union-theories (theory 'fn2-tls-record-readers) (theory 'fn2-tls-transport-readers))))))
(verify-guards fn2-tls-record-next
 :hints (("Goal" :in-theory (set-difference-theories (current-theory :here) (union-theories (theory 'fn2-tls-record-readers) (theory 'fn2-tls-transport-readers))))))

(verify-guards fn2-tls-record-step-observe
 :hints (("Goal" :in-theory
  (set-difference-theories (current-theory :here)
   (union-theories '(fn2-tls-transport-observe-spans fn2-tls-record-observe)
    (union-theories (theory 'fn2-tls-record-readers) (theory 'fn2-tls-transport-readers)))))))

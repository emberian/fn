; Publish one checked peer batch from a connection's private transmit range.
(in-package "ACL2")
(include-book "xfnc-batch-codec")
(include-book "xfnc-read-page")
(include-book "xfnc-reply")
(include-book "conn-answer-rows")
(fn2-book-layer :e)
(local (in-theory (disable fn2-fieldsp fn2-fields-wfp fn2-fields-rows fn2-fields-value
                           fn2-fields-ref-off fn2-fields-ref-len fn2-fields-ref-slot fn2-fields-ref-gen
                           fn2-poolp fn2-pool-wfp fn2-pool-rows)))

; Stream the RESULT field's octets in subsequent turns. The prefix is the
; kind 28 layout through RESULT's length word, with its ordinary class/reason.
(assert-event (equal (car (last *fn2-fnct-port-reply-layout*)) '(result (:octets32 4294967295))))
(deflayout fn2-xfnc-k28-prefix
 (append (butlast *fn2-fnct-port-reply-layout* 1) '((result-length :u32be))))
(fn2-fnct-def-result fn2-xfnc-put-k28-prefix fn2-xfnc-k28-prefix (size)
  ((class 0) (reason :ref 0 0) (result-length size)))
(fn2-fnct-def-result fn2-xfnc-put-envelope fn2-fnct-header (size)
  ((magic *fn2-fnct-magic*) (version *fn2-fnct-version*) (kind *fn2-fnct-port-reply-kind*) (length size)))

(local (in-theory (disable fn2-cns-put-query-cursor fn2-digest-store fn2-pool-copy-range
                           fn2-pool-fill-value fn2-pool-workspace-code fn2-xfnc-batch-items-fit-p
                           fn2-pool-slot-capacity fn2-digest-rowp)))

(defun fn2-xfnc-wire-begin (row items pid history incarnation stream consumer epoch version view revision
                            next end stop count mask slot gen conn cgen fn2-fields fn2-digests fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-digests fn2-pool)
                  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
  (b* ((kind *fn2-conn-kind*) (base (* 128 (nfix row)))
       (chain (fn2-digest-slot (nfix row) *fn2-xfnc-chain-region*))
       ((unless (and (natp row) (fn2-digest-rowp chain fn2-digests)
                     (unsigned-byte-p 32 items) (equal items (fn2-pool-fill-value slot fn2-pool))
                     (fn2-xfnc-batch-items-fit-p items (fn2-pool-slot-capacity slot fn2-pool))
                     (eq (fn2-pool-workspace-code slot gen kind conn cgen fn2-pool) :ok)))
        (mv :state 0 0 fn2-fields fn2-pool))
       ((mv rc fn2-pool) (fn2-digest-store 32 chain slot gen items kind conn cgen fn2-digests fn2-pool))
       ((unless (eq rc :ok)) (mv rc 0 0 fn2-fields fn2-pool))
       ((mv rc coff clen fn2-fields fn2-pool)
        (fn2-cns-put-query-cursor base consumer pid history incarnation stream version view epoch next
                                  slot gen kind conn cgen fn2-fields fn2-pool))
       ((unless (eq rc :ok)) (mv rc 0 0 fn2-fields fn2-pool))
       ((mv rc hoff hlen fn2-fields fn2-pool)
        (fn2-xfnc-put-batch-header base history incarnation revision items stream view next end stop count coff clen
                                   slot gen kind conn cgen fn2-fields fn2-pool))
       ((unless (and (eq rc :ok) (natp hlen) (<= hlen *fn2-xfnc-batch-header-max-size*)))
        (mv :state 0 0 fn2-fields fn2-pool))
       (result (+ hlen items)) (payload (+ 7 result))
       (start (fn2-pool-fill-value slot fn2-pool))
       ((mv rc fn2-pool)
        (fn2-answer-say *fn2-nntp-command-xfnc* *fn2-nntp-reply-xfnc-accepted* mask
                        (+ *fn2-fnct-overhead* payload) slot gen kind conn cgen fn2-pool))
       (frame (fn2-pool-fill-value slot fn2-pool))
       ((unless (and (eq rc :ok) (unsigned-byte-p 32 start) (unsigned-byte-p 32 frame)
                     (< start frame) (<= (- frame start) *fn2-xfnc-reply-line-room*)))
        (mv :state 0 0 fn2-fields fn2-pool))
       ((mv rc & & fn2-fields fn2-pool)
        (fn2-xfnc-put-envelope base payload slot gen kind conn cgen fn2-fields fn2-pool))
       ((unless (eq rc :ok)) (mv rc 0 0 fn2-fields fn2-pool))
       ((mv rc & prefix fn2-fields fn2-pool)
        (fn2-xfnc-put-k28-prefix base result slot gen kind conn cgen fn2-fields fn2-pool))
       ((unless (and (eq rc :ok) (equal prefix 7))) (mv :state 0 0 fn2-fields fn2-pool))
       ((mv rc fn2-pool) (fn2-pool-copy-range slot gen hoff slot gen (fn2-pool-fill-value slot fn2-pool)
                                               hlen kind conn cgen fn2-pool)))
    (mv rc start frame fn2-fields fn2-pool)))
(fn2-pool-block-shape fn2-xfnc-wire-begin-shape
 (fn2-xfnc-wire-begin row items pid history incarnation stream consumer epoch version view revision
                      next end stop count mask slot gen conn cgen fn2-fields fn2-digests fn2-pool)
 (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
      (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests))
 ((fn2-fields 3) (fn2-pool 4))
 (("Goal" :in-theory (e/d (fn2-xfnc-wire-begin)
                          (fn2-fieldsp fn2-fields-wfp fn2-fields-rows fn2-poolp fn2-pool-wfp fn2-pool-rows)))))
(in-theory (disable fn2-xfnc-wire-begin))

; At most 1024 source octets and 1024 destination octets per transfer.
(defun fn2-xfnc-wire-copy (source destination length done slot gen conn cgen fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (b* (((unless (and (unsigned-byte-p 32 source) (unsigned-byte-p 32 destination)
                    (unsigned-byte-p 32 length) (unsigned-byte-p 32 done) (<= done length)))
       (mv :state 0 fn2-pool))
      (n (min 1024 (- length done)))
      ((mv code fn2-pool)
       (fn2-pool-copy-range slot gen (+ source done) slot gen (+ destination done)
                            n *fn2-conn-kind* conn cgen fn2-pool)))
   (mv (if (eq code :ok) (if (= (+ done n) length) :done :more) code) (+ done n) fn2-pool)))
(fn2-pool-preserves fn2-xfnc-wire-copy (source destination length done slot gen conn cgen fn2-pool)
 :position 2 :rows nil)
(in-theory (disable fn2-xfnc-wire-copy))

(defmacro fn2-xfnc-render-page-events ()
 '(progn
 (fn2-csnapshot-op fn2-xfnc-wire-reject (cursor conn cgen reason) 1
  (b* (((mv reset fn2-core)
        (fn2-core-reset (fn2-conn-row-tx-slot conn fn2-core) (fn2-conn-row-tx-gen conn fn2-core)
                        *fn2-conn-kind* conn cgen fn2-core))
       (fn2-core (fn2-cursor-put-core cursor (peer-wire-phase *fn2-xfnc-wire-phase-failed*))))
   (mv (if (eq reset :ok) reason :cleanup) fn2-core)))
 (in-theory (disable fn2-xfnc-wire-reject))

 (fn2-csnapshot-op fn2-xfnc-wire-start (cursor conn cgen pid row) 1
  (b* (((mv history incarnation) (fn2-core-history-values fn2-core))
       (items (fn2-cursor-row-peer-page-bytes cursor fn2-core))
       (count (fn2-cursor-row-peer-page-count cursor fn2-core))
       (after (fn2-cursor-row-peer-position cursor fn2-core))
       (next (fn2-cursor-row-peer-page-next cursor fn2-core))
       (end (fn2-cursor-row-peer-page-end cursor fn2-core))
       (stop (fn2-cursor-row-peer-page-stop cursor fn2-core))
       ((unless (and (unsigned-byte-p 60 after) (unsigned-byte-p 60 next)
                     (unsigned-byte-p 32 count) (<= after next)
                     (<= count (- next after))
                     (if (zp count) (and (equal after next) (equal items 0)) (posp items))))
        (mv :state fn2-core))
       ((when (and (not (equal stop *fn2-xfnc-page-stop-none*)) (equal after next))) (mv :meter fn2-core))
       (stream (fn2-cursor-row-peer-stream cursor fn2-core))
       (consumer (fn2-cursor-row-peer-consumer cursor fn2-core))
       (epoch (fn2-cursor-row-peer-epoch cursor fn2-core))
       (version (fn2-cursor-row-peer-version cursor fn2-core))
       (view (fn2-cursor-row-peer-view cursor fn2-core))
       (revision (fn2-cursor-row-peer-page-revision cursor fn2-core))
       (slot (fn2-conn-row-tx-slot conn fn2-core)) (gen (fn2-conn-row-tx-gen conn fn2-core))
       (mask (fn2-conn-row-mask conn fn2-core))
       ((mv rc start frame fn2-core)
        (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-digests (fn2-core-digests fn2-core))
                    (fn2-pool (fn2-core-pool fn2-core)))
          (rc start frame fn2-fields fn2-pool)
          (fn2-xfnc-wire-begin row items pid history incarnation stream consumer epoch version view revision
                               next end stop count mask slot gen conn cgen fn2-fields fn2-digests fn2-pool)
          (mv rc start frame fn2-core)))
       ((unless (and (eq rc :ok) (unsigned-byte-p 32 start) (unsigned-byte-p 32 frame)))
        (mv :state fn2-core))
       (fn2-core (fn2-cursor-put-core cursor (peer-wire-start start) (peer-wire-frame frame) (peer-wire-done 0)
                    (peer-wire-phase (if (zp items) *fn2-xfnc-wire-phase-hash* *fn2-xfnc-wire-phase-pairs*)))))
    (mv :more fn2-core)))
 (in-theory (disable fn2-xfnc-wire-start))

 (fn2-csnapshot-op fn2-xfnc-wire-move (cursor conn cgen shift) 1
  (b* ((slot (fn2-conn-row-tx-slot conn fn2-core)) (gen (fn2-conn-row-tx-gen conn fn2-core))
       (done (fn2-cursor-row-peer-wire-done cursor fn2-core))
       (start (fn2-cursor-row-peer-wire-start cursor fn2-core))
       (filled (fn2-conn-fill slot fn2-core)) (items (fn2-cursor-row-peer-page-bytes cursor fn2-core))
       ((unless (and (natp filled) (natp start) (natp done) (<= start filled) (<= done filled)))
        (mv :state fn2-core))
       (length (if shift (- filled start) items))
       ((mv code moved fn2-core)
        (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code moved fn2-pool)
          (fn2-xfnc-wire-copy (if shift start 0) (if shift 0 (- filled done)) length done
                              slot gen conn cgen fn2-pool)
          (mv code moved fn2-core)))
       ((unless (and (member-eq code '(:done :more)) (unsigned-byte-p 32 moved))) (mv :state fn2-core))
       ((when (eq code :more))
        (let ((fn2-core (fn2-cursor-put-core cursor (peer-wire-done moved)))) (mv :more fn2-core)))
       ((mv rc fn2-core) (if shift (fn2-core-truncate slot gen length *fn2-conn-kind* conn cgen fn2-core)
                           (mv :ok fn2-core)))
       ((unless (eq rc :ok)) (mv :state fn2-core))
       (fn2-core (fn2-cursor-put-core cursor (peer-wire-done 0)
                   (peer-wire-phase (if shift *fn2-xfnc-wire-phase-confirm* *fn2-xfnc-wire-phase-hash*)))))
   (mv :more fn2-core)))
 (in-theory (disable fn2-xfnc-wire-move))

 (fn2-csnapshot-op fn2-xfnc-wire-hash (cursor conn cgen row) 1
  (b* ((slot (fn2-conn-row-tx-slot conn fn2-core)) (gen (fn2-conn-row-tx-gen conn fn2-core))
       (frame (fn2-cursor-row-peer-wire-frame cursor fn2-core))
       (filled (fn2-conn-fill slot fn2-core))
       ((unless (and (natp frame) (natp filled) (<= frame filled)
                     (<= (- filled frame) *fn2-pool-block-bytes*))) (mv :state fn2-core))
       ((mv code fn2-core)
        (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-b3 (fn2-core-b3 fn2-core))
                    (fn2-pool (fn2-core-pool fn2-core)))
          (rc fn2-digests fn2-b3)
          (fn2-pool-block-hash row slot gen frame (- filled frame) *fn2-conn-kind* conn cgen
                               fn2-digests fn2-b3 fn2-pool)
          (mv rc fn2-core)))
       ((unless (eq code :ok)) (mv :state fn2-core))
       (fn2-core (fn2-cursor-put-core cursor (peer-wire-phase *fn2-xfnc-wire-phase-seal*))))
    (mv :more fn2-core)))
 (in-theory (disable fn2-xfnc-wire-hash))

 (fn2-csnapshot-op fn2-xfnc-wire-seal (cursor conn cgen row) 1
  (b* ((slot (fn2-conn-row-tx-slot conn fn2-core)) (gen (fn2-conn-row-tx-gen conn fn2-core))
       (dst (fn2-digest-slot (nfix row) *fn2-b3-result*))
       ((mv code fn2-core)
        (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
          (rc fn2-pool)
          (if (fn2-digest-rowp dst fn2-digests)
              (fn2-digest-store 32 dst slot gen (nfix (fn2-pool-fill-value slot fn2-pool))
                                *fn2-conn-kind* conn cgen fn2-digests fn2-pool)
            (mv :bounds fn2-pool))
          (mv rc fn2-core)))
       ((unless (eq code :ok)) (mv :state fn2-core))
       (fn2-core (fn2-cursor-put-core cursor (peer-wire-phase *fn2-xfnc-wire-phase-shift*) (peer-wire-done 0))))
   (mv :more fn2-core)))
 (in-theory (disable fn2-xfnc-wire-seal))

 (fn2-csnapshot-op fn2-xfnc-render-page-turn (cursor generation) 1
  (b* (((unless (fn2-xfnc-linked-request-p cursor generation fn2-core)) (mv :owner fn2-core))
       (conn (fn2-cursor-row-conn cursor fn2-core)) (cgen (fn2-cursor-row-conn-gen cursor fn2-core))
       ((mv login pid & &) (fn2-xfnc-live-login cursor generation fn2-core))
       ((unless (and (eq login :ok) (equal pid (fn2-cursor-row-peer-principal cursor fn2-core))))
        (fn2-xfnc-wire-reject cursor conn cgen :access fn2-core))
       ((unless (equal (fn2-cursor-row-peer-page-phase cursor fn2-core) *fn2-xfnc-page-phase-ready*))
        (fn2-xfnc-wire-reject cursor conn cgen :state fn2-core))
       ((mv boot revision) (fn2-core-ready-history-revision fn2-core))
       ((unless (and (eq boot :ok) (equal revision (fn2-cursor-row-peer-page-revision cursor fn2-core))))
        (fn2-xfnc-wire-reject cursor conn cgen :scope fn2-core))
       ((mv workspace row) (fn2-xfnc-fc-row conn fn2-core))
       ((unless (eq workspace :ok)) (fn2-xfnc-wire-reject cursor conn cgen :state fn2-core))
       (phase (fn2-cursor-row-peer-wire-phase cursor fn2-core))
       ((when (equal phase *fn2-xfnc-wire-phase-confirm*))
        (b* (((mv status principal head fn2-core)
              (fn2-xfnc-read-rights cursor generation (fn2-cursor-row-peer-stream cursor fn2-core) 2048 fn2-core))
             ((when (eq status :more)) (mv :more fn2-core))
             ((unless (and (eq status :ok) (equal principal pid)
                           (equal head (fn2-cursor-row-peer-head cursor fn2-core))
                           (equal head (fn2-cursor-row-peer-view cursor fn2-core))))
              (fn2-xfnc-wire-reject cursor conn cgen
                (case status (:ok :scope) (:absent :absent) (:access :access) (otherwise :state)) fn2-core)))
          (mv :ready fn2-core)))
       ((mv code fn2-core)
        (cond ((equal phase *fn2-xfnc-wire-phase-start*) (fn2-xfnc-wire-start cursor conn cgen pid row fn2-core))
              ((equal phase *fn2-xfnc-wire-phase-pairs*) (fn2-xfnc-wire-move cursor conn cgen nil fn2-core))
              ((equal phase *fn2-xfnc-wire-phase-hash*) (fn2-xfnc-wire-hash cursor conn cgen row fn2-core))
              ((equal phase *fn2-xfnc-wire-phase-seal*) (fn2-xfnc-wire-seal cursor conn cgen row fn2-core))
              ((equal phase *fn2-xfnc-wire-phase-shift*) (fn2-xfnc-wire-move cursor conn cgen t fn2-core))
              (t (mv :state fn2-core)))))
    (if (eq code :more) (mv :more fn2-core)
      (fn2-xfnc-wire-reject cursor conn cgen code fn2-core))))
 (in-theory (disable fn2-xfnc-render-page-turn))))

(defcost fn2-xfnc-render-page-turn :answers t :bytes 4096
 :tables (fn2-core-reads fn2-core-ranges fn2-core-seeks fn2-core-run-cursors fn2-core-run-paths
          fn2-core-succ-txns fn2-core-fields fn2-core-digests fn2-core-b3 fn2-core-pool fn2-cursor-table)
 :doc "Assemble a bounded peer batch into its protected connection TX and confirm current scoped authority.")

; Reading the actual pool returned by build-add at the appended row's offset.
(in-package "ACL2")
(include-book "runs-overview-builder-proof")
(include-book "runs-overview-cursor-id-proof")

(defthm fn2-run-cursor-reads-appended-overview-id
 (let* ((w (fn2-run-builds-wbase 0 builds)) (base *fn2-run-run-entry*)
        (dst (fn2-run-writers-slot w writers)) (dg (fn2-run-writers-gen w writers))
        (off (fn2-run-writers-cursor w writers)) (line (nth 4 row)) (n (len line))
        (bytes (fn2-layout-octets *fn2-overview-entry* row)) (size (len bytes)) (end (+ off size))
        (source (+ at (fn2-pool-base src pool))) (target (+ off (fn2-pool-base dst pool)))
        (idx (fn2-run-writers-entries w writers)) (nr (fn2-run-writers-restarts w writers))
        (path (fn2-run-path-row c 0))
        (total (1+ (fn2-run-builds-entries 0 builds)))
        (load (fn2-run-load-values *fn2-overview-entry* row base src sg at 9 0 1 f pool))
        (sf (mv-nth 2 load)) (sp (mv-nth 3 load))
        (build (fn2-run-build-add 0 base builds writers restarts sf sp))
        (step (fn2-run-step-deliver c 3 idx off dst dg unit counter rb 9 0 1 curs paths rf (mv-nth 5 build)))
        (after (mv-nth 1 step)))
  (implies (and (fn2-run-values-layoutp *fn2-overview-entry* row)
                (natp j) (< j 4) (natp c) (< c (fn2-run-cursors-rows curs))
                (< path (fn2-run-paths-rows paths)) (natp idx) (< idx (fn2-run-paths-entries path paths))
                (natp rb) (<= (+ rb *fn2-run-reader-entry* (len *fn2-overview-entry*)) (fn2-fields-rows rf))
                (equal (fn2-run-directory rb rf) end) (posp off)
                (unsigned-byte-p 32 dst) (unsigned-byte-p 60 dg) (unsigned-byte-p 60 unit) (unsigned-byte-p 60 counter)
                (equal (fn2-run-builds-schema 0 builds) 3)
                (equal (fn2-run-builds-phase 0 builds) *fn2-run-build-phase-adding*)
                (posp (fn2-run-builds-height 0 builds))
                (equal (fn2-run-writers-level w writers) 0)
                (equal (fn2-run-writers-okind w writers) 9) (equal (fn2-run-writers-oslot w writers) 0)
                (equal (fn2-run-writers-ogen w writers) 1)
                (eq (fn2-run-add-ready w 3 base writers restarts sf sp) :ok)
                (natp nr) (< nr *fn2-run-restart-capacity*) (unsigned-byte-p 32 (1+ idx))
                (unsigned-byte-p 60 total) (fn2-poolp pool) (fn2-pool-wfp pool)
                (natp src) (natp dst) (not (equal src dst))
                (natp (fn2-pool-base src pool)) (natp (fn2-pool-base dst pool))
                (unsigned-byte-p 32 off) (unsigned-byte-p 32 at) (unsigned-byte-p 32 end)
                (or (<= (+ source n) target) (<= (+ target size) source))
                (equal (fn2-layout-range-code src sg at (+ at n) t 9 0 1 pool) :ok)
                (equal (fn2-layout-range-code dst dg off end t 9 0 1 pool) :ok))
           (and (equal (car load) :ok) (equal (car build) :ok)
                (equal (car step) :entry)
                (equal (fn2-run-cursors-idx c after) (1+ idx))
                (equal (fn2-run-cursors-off c after) end)
                (equal (fn2-fields-value (+ (+ rb *fn2-run-reader-entry*) j) (mv-nth 2 step)) (nth j row)))))
 :rule-classes nil
 :hints (("Goal" :do-not '(preprocess)
          :use (fn2-run-builder-appends-overview-source-row
                (:instance fn2-run-overview-cursor-supplies-source-id
                 (idx (fn2-run-writers-entries (fn2-run-builds-wbase 0 builds) writers))
                 (off (fn2-run-writers-cursor (fn2-run-builds-wbase 0 builds) writers))
                 (slot (fn2-run-writers-slot (fn2-run-builds-wbase 0 builds) writers))
                 (gen (fn2-run-writers-gen (fn2-run-builds-wbase 0 builds) writers))
                 (pk 9) (ps 0) (pg 1) (f rf)
                 (pool (let ((load (fn2-run-load-values *fn2-overview-entry* row *fn2-run-run-entry* src sg at 9 0 1 f pool)))
                         (mv-nth 5 (fn2-run-build-add 0 *fn2-run-run-entry* builds writers restarts
                                                   (mv-nth 2 load) (mv-nth 3 load)))))))
          :in-theory (union-theories (theory 'minimal-theory)
                     '(eq not (:e len) (:e natp) (:e equal) commutativity-of-+ associativity-of-+)))))

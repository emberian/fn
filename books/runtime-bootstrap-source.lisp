; Immutable bootstrap wire schema, not a qualification or installation issuer.
; Validate at image construction; no external caller can install from shape.
(in-package "ACL2")
(include-book "allocation-epoch")
(defun fn-rbs-profilep (x)
 (declare (xargs :guard t))
 (and (true-listp x) (equal (len x) 4)
      (eq (fn-aec-at 0 x) :runtime-profile)
      (fn-aec-at 1 x) (posp (fn-aec-at 2 x)) (fn-aec-at 3 x) t))
(defun fn-rbs-requestp (x domain)
 (declare (xargs :guard t))
 (and (true-listp x) (equal (len x) 5)
      (eq (fn-aec-at 0 x) :request)
      (symbolp (fn-aec-at 1 x)) (fn-aec-at 1 x)
      (fn-aec-at 2 x)
      (natp domain) (natp (fn-aec-at 3 x))
      (natp (fn-aec-at 4 x))
      (<= (fn-aec-at 3 x) domain) (<= (fn-aec-at 4 x) domain) t))
(defun fn-rbs-request-stream-p (xs domain)
 (declare (xargs :guard t))
 (if (consp xs)
     (and (fn-rbs-requestp (car xs) domain)
          (fn-rbs-request-stream-p (cdr xs) domain))
   (equal xs nil)))
(defun fn-rbs-common-sourcep (x)
 (declare (xargs :guard t))
 (let* ((profile (fn-aec-at 3 x))
        (domain (fn-aec-at 2 profile))
        (association (fn-aec-at 4 x)))
  (and (true-listp x) (equal (len x) 17)
       (fn-aec-at 1 x) (fn-aec-at 2 x) (fn-rbs-profilep profile)
       (fn-aec-runtime-associationp association domain)
       (equal (fn-aec-at 1 association) (fn-aec-at 1 x))
       (equal (fn-aec-at 2 association) (fn-aec-at 2 x))
       (equal (fn-aec-at 3 association) profile)
       (fn-aec-at 5 x) (fn-aec-at 6 x)
       ; This is pinned headroom POLICY, not successful GC-copy guarantee.
       (posp (fn-aec-at 8 x)) (<= (fn-aec-at 8 x) domain)
       (< (fn-aec-at 8 x) (fn-aec-at 5 association))
       (fn-rbs-request-stream-p (fn-aec-at 10 x) domain)
       (fn-rbs-request-stream-p (fn-aec-at 11 x) domain)
       (fn-rbs-request-stream-p (fn-aec-at 12 x) domain)
       (fn-rbs-request-stream-p (fn-aec-at 13 x) domain)
       (fn-rbs-request-stream-p (fn-aec-at 14 x) domain)
       (fn-aec-at 15 x) (fn-aec-at 16 x) t)))
(defun fn-rbs-physical-sourcep (x)
 (declare (xargs :guard t))
 (let ((affine (fn-aec-at 9 x)))
  (and (fn-rbs-common-sourcep x)
       (eq (fn-aec-at 0 x) :runtime-bootstrap-source)
       (posp (fn-aec-at 7 x))
       (true-listp affine) (equal (len affine) 6)
       (eq (fn-aec-at 0 affine) :footprint)
       (posp (fn-aec-at 1 affine))
       (natp (fn-aec-at 2 affine)) (natp (fn-aec-at 3 affine))
       (natp (fn-aec-at 4 affine)) (natp (fn-aec-at 5 affine)))))
(defun fn-rbs-request-budget-sourcep (x)
 (declare (xargs :guard t))
 (and (fn-rbs-common-sourcep x)
      (eq (fn-aec-at 0 x) :runtime-bootstrap-request-budget-source)
      (equal (fn-aec-at 7 x) nil) (equal (fn-aec-at 9 x) nil)))
(defun fn-rbs-sourcep (x)
 (declare (xargs :guard t))
 (or (fn-rbs-physical-sourcep x) (fn-rbs-request-budget-sourcep x)))

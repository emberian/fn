; Actual epoch-Fence join for previously bound cold obligations or fresh genesis.
(in-package "ACL2")
(include-book "checkpoint-bank-empty")
(include-book "checkpoint-bank-bind")
(include-book "checkpoint-bank-protection")
(fn2-book-layer :b)
(defcost fn2-boot-finish-bank-obligations :answers t
 :tables (fn2-core-machines fn2-core-boot-config fn2-core-checkpoint-publication)
 :doc "At the actual completed epoch Fence, recheck selected bank obligations or establish the actual all-empty/create source.")
(defcost fn2-boot-finalize-recovery :answers t
 :tables (fn2-core-checkpoints fn2-core-extents)
 :doc "Open only the actual post-Fence selected reconstruction with retained all-bank protections; fresh/full discovery retains ordinary epoch admission.")
(defmacro fn2-boot-bank-finish-events ()
 '(progn
  ; The outer boot finalizer has joined its actual epoch Fence. Recheck that
  ; exact actor here before ending the full-base recovery spawn's live index.
  (defun fn2-boot-finalize-fullbase-index (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (b* (((unless (and (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
                      (posp ogen) (unsigned-byte-p 60 ogen)
                      (= (fn2-machine-generation id fn2-core) ogen)
                      (= (fn2-machine-phase id fn2-core) *fn2-boot-state-epoch-result*)
                      (= (fn2-machine-stage id fn2-core) 3)
                      (= (fn2-machine-stopped id fn2-core) 0)
                      (= (fn2-machine-pending id fn2-core) 0)
                      (= (fn2-machine-root-gen id fn2-core) 0)
                      (= (fn2-machine-event-ready id fn2-core) 1)
                      (= (fn2-machine-outcome id fn2-core) *fn2-outcome-done*))) (mv :state fn2-core))
        (epoch (fn2-machine-next-epoch id fn2-core))
        (rid (fn2-machine-kind-base *fn2-recovery-machine-kind* fn2-core))
        (rgen (fn2-machine-generation rid fn2-core))
        (active (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (active)
                 (fn2-alloc-identity-active fn2-extents) active))
        (phase (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (phase)
                (fn2-alloc-freeze-phase fn2-extents) phase))
        ((unless (= phase 0)) (mv :state fn2-core))
        ((when (= active 0)) (fn2-boot-adopt-epoch epoch fn2-core))
        ((unless (and (eq (fn2-recovery-machine-snapshot-read-code rid fn2-core) :ok)
                      (= (fn2-machine-phase rid fn2-core) *fn2-recovery-machine-state-done*)
                      (= (fn2-machine-stopped rid fn2-core) 1)
                      (= (fn2-machine-pending rid fn2-core) 0)
                      (= (fn2-machine-rc-base rid fn2-core) 0)
                      (= (fn2-machine-rc-base-tag rid fn2-core) 0)
                      (= (fn2-machine-rc-found rid fn2-core) (fn2-machine-rc-high rid fn2-core))
                      (= (fn2-machine-rc-commit rid fn2-core) (fn2-machine-rc-chain rid fn2-core))
                      (or (= (fn2-machine-rc-chain rid fn2-core) 0)
                       (and (= (fn2-machine-rc-mode rid fn2-core) *fn2-rec-mode-replay*)
                            (= (fn2-machine-rc-stage rid fn2-core) 2)
                            (= (fn2-machine-rc-wlen rid fn2-core) 0)
                            (= (fn2-machine-rc-own-left rid fn2-core) 0)
                            (= (fn2-machine-rc-lifecycle-next rid fn2-core) 0)))
                      (member-equal (fn2-machine-rc-class rid fn2-core)
                       (list *fn2-rec-class-intact* *fn2-rec-class-torn-tail*))
                      (unsigned-byte-p 60 epoch) (> epoch (fn2-machine-rc-epoch rid fn2-core))))
         (mv :recovery fn2-core)))
    (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
     (b* (((unless (and (= (fn2-alloc-freeze-phase fn2-extents) 0)
                        (= (fn2-alloc-epoch-begun fn2-extents) 0)
                        (> epoch (fn2-alloc-current-epoch fn2-extents))
                        (fn2-alloc-identity-owner-p *fn2-recovery-machine-kind* rid rgen rgen fn2-extents)
                        (fn2-alloc-identity-geometry-p fn2-extents)
                        (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-idle*)
                        (= (fn2-alloc-identity-op fn2-extents) *fn2-alloc-identity-op-none*)))
           (mv :identity fn2-extents))
          ((mv code fn2-extents)
           (fn2-alloc-identity-end *fn2-recovery-machine-kind* rid rgen rgen fn2-extents))
          ((unless (eq code :ok)) (mv code fn2-extents)))
      (fn2-alloc-begin-epoch epoch fn2-extents))
     (mv code fn2-core))))
  (fn2-core-preserves fn2-boot-finalize-fullbase-index (id ogen fn2-core) :position 1 :rows nil)
  (defun fn2-boot-finish-bank-obligations (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (b* (((unless (and (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
                      (unsigned-byte-p 60 ogen) (posp ogen)
                      (= (fn2-machine-generation id fn2-core) ogen)
                      (= (fn2-machine-phase id fn2-core) *fn2-boot-state-epoch-result*)
                      (= (fn2-machine-stage id fn2-core) 3)
                      (= (fn2-machine-stopped id fn2-core) 0)
                      (= (fn2-machine-event-ready id fn2-core) 1)
                      (= (fn2-machine-outcome id fn2-core) *fn2-outcome-done*)))
          (mv :state fn2-core))
        (empty (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core))) (empty)
                (= (fn2-boot-config-anchor-checked-mask fn2-boot-config) 0) empty))
        ((when empty) (fn2-boot-bind-checkpoint-obligations id ogen fn2-core)))
    (stobj-let (
      (fn2-boot-config (fn2-core-boot-config fn2-core))
      (fn2-checkpoints (fn2-core-checkpoints fn2-core))
      (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core))
      (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core))
      (fn2-origin (fn2-core-origin fn2-core))
      (fn2-checkpoint-recovery-evidence (fn2-core-checkpoint-recovery-evidence fn2-core))
      (fn2-checkpoint-recovery-census (fn2-core-checkpoint-recovery-census fn2-core))
      (fn2-checkpoint-selected-source (fn2-core-checkpoint-selected-source fn2-core))
      (fn2-checkpoint-restore-map-control (fn2-core-checkpoint-restore-map-control fn2-core))
      (fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core)))
     (code fn2-checkpoint-publication)
     (fn2-checkpoint-bank-bind-step 1 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census fn2-checkpoint-selected-source fn2-checkpoint-restore-map-control fn2-checkpoint-publication)
     (mv (if (eq code :bound) :ok code) fn2-core))))
  (fn2-core-preserves fn2-boot-finish-bank-obligations (id ogen fn2-core) :position 1 :rows nil)
  ; The actual boot Fence has completed and the root workspace has been
  ; settled before this operation. No caller supplies an epoch or readiness bit.
  (defun fn2-boot-finalize-recovery (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (b* (((unless (and (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
                      (unsigned-byte-p 60 ogen) (posp ogen)
                      (= (fn2-machine-generation id fn2-core) ogen)
                      (= (fn2-machine-phase id fn2-core) *fn2-boot-state-epoch-result*)
                      (= (fn2-machine-stage id fn2-core) 3)
                      (= (fn2-machine-stopped id fn2-core) 0)
                      (= (fn2-machine-pending id fn2-core) 0)
                      (= (fn2-machine-root-gen id fn2-core) 0)
                      (= (fn2-machine-event-ready id fn2-core) 1)
                      (= (fn2-machine-outcome id fn2-core) *fn2-outcome-done*)))
          (mv :state fn2-core))
        (epoch (fn2-machine-next-epoch id fn2-core))
        (phase (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (phase)
                 (fn2-alloc-freeze-phase fn2-extents) phase))
        ((when (= phase 0)) (fn2-boot-finalize-fullbase-index id ogen fn2-core))
        (rid (fn2-machine-kind-base *fn2-recovery-machine-kind* fn2-core))
        ((unless (and (= phase 4) (eq (fn2-boot-recovered fn2-core) :ok)
                      (fn2-recovery-idp rid fn2-core)
                      (fn2-recovery-selected-current-p rid fn2-core)
                      (= (fn2-machine-pending rid fn2-core) 0)
                      (<= (fn2-machine-rc-high rid fn2-core) (fn2-machine-rc-found rid fn2-core))
                      (<= (fn2-machine-rc-chain rid fn2-core) (fn2-machine-rc-commit rid fn2-core))
                      (unsigned-byte-p 60 epoch)
                      (> epoch (fn2-machine-rc-epoch rid fn2-core))))
         (mv :reconstruction fn2-core))
        (rgen (fn2-machine-generation rid fn2-core)))
    (stobj-let (
     (fn2-checkpoint-selected-source (fn2-core-checkpoint-selected-source fn2-core))
     (fn2-boot-config (fn2-core-boot-config fn2-core))
     (fn2-checkpoints (fn2-core-checkpoints fn2-core))
     (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core))
     (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core))
     (fn2-origin (fn2-core-origin fn2-core))
     (fn2-checkpoint-recovery-evidence (fn2-core-checkpoint-recovery-evidence fn2-core))
     (fn2-checkpoint-recovery-census (fn2-core-checkpoint-recovery-census fn2-core))
     (fn2-checkpoint-restore-map (fn2-core-checkpoint-restore-map fn2-core))
     (fn2-checkpoint-restore-map-control (fn2-core-checkpoint-restore-map-control fn2-core))
     (fn2-checkpoint-restore-reach-control (fn2-core-checkpoint-restore-reach-control fn2-core))
     (fn2-checkpoint-projection (fn2-core-checkpoint-projection fn2-core))
     (fn2-ops (fn2-core-ops fn2-core))
     (fn2-extents (fn2-core-extents fn2-core))
     (fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core))
     (fn2-checkpoint-bank-closures (fn2-core-checkpoint-bank-closures fn2-core))
     (fn2-checkpoint-bank-protection (fn2-core-checkpoint-bank-protection fn2-core))
     (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
     (code fn2-checkpoints fn2-extents)
     (b* (((unless (and (= (fn2-alloc-epoch-begun fn2-extents) 0)
                        (> epoch (fn2-alloc-current-epoch fn2-extents))
                        (fn2-alloc-identity-owner-p *fn2-recovery-machine-kind* rid rgen
                         (fn2-checkpoint-selected-source-generation 0 fn2-checkpoint-selected-source) fn2-extents)
                        (fn2-alloc-identity-geometry-p fn2-extents)
                        (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-idle*)
                        (= (fn2-alloc-identity-op fn2-extents) *fn2-alloc-identity-op-none*)
                        (fn2-checkpoint-bank-protection-complete-p fn2-checkpoint-selected-source fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-reach-control fn2-checkpoint-projection fn2-ops fn2-extents fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-alloc-edges)))
            (mv :protection fn2-checkpoints fn2-extents))
          ((mv code fn2-checkpoints)
           (fn2-checkpoint-bank-promote-selected fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census fn2-checkpoint-selected-source fn2-checkpoint-restore-map-control fn2-checkpoint-publication))
          ((unless (eq code :installed)) (mv code fn2-checkpoints fn2-extents))
          ((mv code fn2-extents)
           (fn2-alloc-identity-end *fn2-recovery-machine-kind* rid rgen
            (fn2-checkpoint-selected-source-generation 0 fn2-checkpoint-selected-source) fn2-extents))
          ((unless (eq code :ok)) (mv code fn2-checkpoints fn2-extents))
          ; All fallible checks precede the opening. The ordinary epoch
          ; operation below shares the existing epoch/counter transition.
          (fn2-extents (update-fn2-alloc-freeze-token 0 fn2-extents))
          (fn2-extents (update-fn2-alloc-freeze-owner-kind 0 fn2-extents))
          (fn2-extents (update-fn2-alloc-freeze-owner-slot 0 fn2-extents))
          (fn2-extents (update-fn2-alloc-freeze-owner-gen 0 fn2-extents))
          (fn2-extents (update-fn2-alloc-freeze-phase 0 fn2-extents))
          ((mv code fn2-extents) (fn2-alloc-begin-epoch epoch fn2-extents)))
      (mv code fn2-checkpoints fn2-extents))
     (mv code fn2-core))))
  (fn2-core-preserves fn2-boot-finalize-recovery (id ogen fn2-core) :position 1 :rows nil)
))

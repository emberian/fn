; Root1 directory capture at the actual authenticated entry boundary.
; Capture is separate from C adoption and grants no prefix-discard authority.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-summary-state")
(include-book "checkpoint-summary-entry")
(include-book "checkpoint-cbase-state")
(include-book "checkpoint-restore-semantic-work")
(fn2-book-layer :c)

(defun fn2-checkpoint-summary-copy-descriptor (i fn2-checkpoint-restore-map-control fn2-checkpoint-summary)
 (declare (xargs :stobjs (fn2-checkpoint-restore-map-control fn2-checkpoint-summary)
  :measure (nfix (- 32 (nfix i)))
  :guard (and (fn2-checkpoint-restore-map-control-wfp fn2-checkpoint-restore-map-control)
              (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (natp i) (<= i 32))))
 (if (>= (nfix i) 32) fn2-checkpoint-summary
  (let ((fn2-checkpoint-summary (update-fn2-checkpoint-summary-descriptori i
         (fn2-checkpoint-restore-map-control-descriptori i fn2-checkpoint-restore-map-control) fn2-checkpoint-summary)))
   (fn2-checkpoint-summary-copy-descriptor (+ 1 (nfix i)) fn2-checkpoint-restore-map-control fn2-checkpoint-summary))))
(defun fn2-checkpoint-summary-descriptor-equal (i fn2-checkpoint-restore-map-control fn2-checkpoint-summary)
 (declare (xargs :stobjs (fn2-checkpoint-restore-map-control fn2-checkpoint-summary)
  :measure (nfix (- 32 (nfix i)))
  :guard (and (fn2-checkpoint-restore-map-control-wfp fn2-checkpoint-restore-map-control)
              (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (natp i) (<= i 32))))
 (or (>= (nfix i) 32)
  (and (equal (fn2-checkpoint-summary-descriptori i fn2-checkpoint-summary)
              (fn2-checkpoint-restore-map-control-descriptori i fn2-checkpoint-restore-map-control))
       (fn2-checkpoint-summary-descriptor-equal (+ 1 (nfix i)) fn2-checkpoint-restore-map-control fn2-checkpoint-summary))))

(defun fn2-checkpoint-summary-current-p (fn2-checkpoint-summary fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
 fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-semantic)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
 fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-semantic)
 :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoints-wfp fn2-checkpoints)
  (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
  (fn2-checkpoint-restore-map-wfp fn2-checkpoint-restore-map) (fn2-checkpoint-restore-map-control-wfp fn2-checkpoint-restore-map-control)
  (fn2-checkpoint-restore-semantic-wfp fn2-checkpoint-restore-semantic))))
 (and (< 0 (fn2-checkpoint-summary-rows fn2-checkpoint-summary))
      (posp (fn2-checkpoint-summary-tag 0 fn2-checkpoint-summary))
      (fn2-checkpoint-restore-semantic-current-p fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
       fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-semantic)
      (equal (fn2-checkpoint-summary-candidate 0 fn2-checkpoint-summary) (fn2-checkpoint-restore-semantic-candidate 0 fn2-checkpoint-restore-semantic))
      (equal (fn2-checkpoint-summary-semantic-tag 0 fn2-checkpoint-summary) (fn2-checkpoint-restore-semantic-tag 0 fn2-checkpoint-restore-semantic))
      (equal (fn2-checkpoint-summary-generation 0 fn2-checkpoint-summary) (fn2-checkpoint-restore-map-control-reach-generation 0 fn2-checkpoint-restore-map-control))
      (equal (fn2-checkpoint-summary-checkpoint 0 fn2-checkpoint-summary) (fn2-checkpoint-restore-map-control-source-checkpoint 0 fn2-checkpoint-restore-map-control))
      (equal (fn2-checkpoint-summary-cut-commit 0 fn2-checkpoint-summary) (fn2-checkpoint-restore-map-control-source-cut-commit 0 fn2-checkpoint-restore-map-control))
      (equal (fn2-checkpoint-summary-cut-event 0 fn2-checkpoint-summary) (fn2-checkpoint-restore-map-control-source-cut-event 0 fn2-checkpoint-restore-map-control))
      (equal (fn2-checkpoint-summary-history 0 fn2-checkpoint-summary) (fn2-checkpoint-restore-map-control-source-history 0 fn2-checkpoint-restore-map-control))
      (equal (fn2-checkpoint-summary-incarnation 0 fn2-checkpoint-summary) (fn2-checkpoint-restore-map-control-source-incarnation 0 fn2-checkpoint-restore-map-control))
      (equal (fn2-checkpoint-summary-owner-kind 0 fn2-checkpoint-summary) (fn2-checkpoint-restore-semantic-owner-kind 0 fn2-checkpoint-restore-semantic))
      (equal (fn2-checkpoint-summary-owner-slot 0 fn2-checkpoint-summary) (fn2-checkpoint-restore-semantic-owner-slot 0 fn2-checkpoint-restore-semantic))
      (equal (fn2-checkpoint-summary-owner-gen 0 fn2-checkpoint-summary) (fn2-checkpoint-restore-semantic-owner-gen 0 fn2-checkpoint-restore-semantic))
      (fn2-checkpoint-summary-descriptor-equal 0 fn2-checkpoint-restore-map-control fn2-checkpoint-summary)))

; Called just after the real cold semantic BEGIN, before any directory row.
(defun fn2-checkpoint-summary-begin (fn2-checkpoint-summary fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
 fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-semantic fn2-checkpoint-cbase-holds)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
 fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-semantic fn2-checkpoint-cbase-holds)
 :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoints-wfp fn2-checkpoints)
  (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
  (fn2-checkpoint-restore-map-wfp fn2-checkpoint-restore-map) (fn2-checkpoint-restore-map-control-wfp fn2-checkpoint-restore-map-control)
  (fn2-checkpoint-restore-semantic-wfp fn2-checkpoint-restore-semantic)
  (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds))))
 (b* (((unless (and (< 0 (fn2-checkpoint-summary-rows fn2-checkpoint-summary))
                    (< 0 (fn2-checkpoint-restore-semantic-rows fn2-checkpoint-restore-semantic))
                    (= (fn2-checkpoint-summary-lease-count 0 fn2-checkpoint-summary) 0)
                    (fn2-checkpoint-cbase-catalog-available-p
                     (fn2-checkpoint-summary-candidate 0 fn2-checkpoint-summary)
                     (fn2-checkpoint-summary-tag 0 fn2-checkpoint-summary) fn2-checkpoint-cbase-holds)
                    (member (fn2-checkpoint-summary-phase 0 fn2-checkpoint-summary)
                     (list *fn2-checkpoint-summary-phase-idle* *fn2-checkpoint-summary-phase-capture*
                           *fn2-checkpoint-summary-phase-captured* *fn2-checkpoint-summary-phase-retired*))
                    (= (fn2-checkpoint-summary-installed 0 fn2-checkpoint-summary) 0)
                    (= (fn2-checkpoint-restore-semantic-phase 0 fn2-checkpoint-restore-semantic) *fn2-checkpoint-restore-semantic-phase-read*)
                    (= (fn2-checkpoint-restore-semantic-directory 0 fn2-checkpoint-restore-semantic) 1)
                    (= (fn2-checkpoint-restore-semantic-depth 0 fn2-checkpoint-restore-semantic) 1)
                    (= (fn2-checkpoint-restore-semantic-cursor 0 fn2-checkpoint-restore-semantic) 0)
                    (fn2-checkpoint-restore-semantic-current-p fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                     fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-semantic)))
       (mv :source fn2-checkpoint-summary))
      (tag (fn2-checkpoint-summary-fresh-tag fn2-checkpoint-summary))
      ((unless (unsigned-byte-p 60 tag)) (mv :tag-exhausted fn2-checkpoint-summary))
      (fn2-checkpoint-summary (fn2-checkpoint-summary-copy-descriptor 0 fn2-checkpoint-restore-map-control fn2-checkpoint-summary))
      (fn2-checkpoint-summary (update-fn2-checkpoint-summary-next-tag tag fn2-checkpoint-summary))
      (fn2-checkpoint-summary (fn2-checkpoint-summary-put 0 (phase *fn2-checkpoint-summary-phase-capture*) (priority-base 0) (application-stage 0) (tag tag)
       (candidate (fn2-checkpoint-restore-semantic-candidate 0 fn2-checkpoint-restore-semantic))
       (checkpoint (fn2-checkpoint-restore-map-control-source-checkpoint 0 fn2-checkpoint-restore-map-control))
       (cut-commit (fn2-checkpoint-restore-map-control-source-cut-commit 0 fn2-checkpoint-restore-map-control))
       (cut-event (fn2-checkpoint-restore-map-control-source-cut-event 0 fn2-checkpoint-restore-map-control))
       (history (fn2-checkpoint-restore-map-control-source-history 0 fn2-checkpoint-restore-map-control))
       (incarnation (fn2-checkpoint-restore-map-control-source-incarnation 0 fn2-checkpoint-restore-map-control))
       (generation (fn2-checkpoint-restore-map-control-reach-generation 0 fn2-checkpoint-restore-map-control))
       (semantic-tag (fn2-checkpoint-restore-semantic-tag 0 fn2-checkpoint-restore-semantic))
       (owner-kind (fn2-checkpoint-restore-semantic-owner-kind 0 fn2-checkpoint-restore-semantic))
       (owner-slot (fn2-checkpoint-restore-semantic-owner-slot 0 fn2-checkpoint-restore-semantic))
       (owner-gen (fn2-checkpoint-restore-semantic-owner-gen 0 fn2-checkpoint-restore-semantic))
       (count 0) (cursor 0) (installed 0))))
  (mv :ok fn2-checkpoint-summary)))

; All digest bytes come from the held decoded manifest field under its owner.


(defun fn2-checkpoint-summary-capture (base fn2-checkpoint-summary fn2-checkpoint-summary-sources
 fn2-checkpoint-restore-semantic fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
 fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-restore-semantic
 fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool)
 :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary) (fn2-checkpoint-summary-sources-wfp fn2-checkpoint-summary-sources)
 (fn2-checkpoint-restore-semantic-wfp fn2-checkpoint-restore-semantic) (fn2-checkpoints-wfp fn2-checkpoints)
 (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
 (fn2-checkpoint-restore-map-wfp fn2-checkpoint-restore-map) (fn2-checkpoint-restore-map-control-wfp fn2-checkpoint-restore-map-control)
 (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (fn2-checkpoint-summary-current-p fn2-checkpoint-summary fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                     fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-semantic)
                    (= (fn2-checkpoint-summary-phase 0 fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-capture*)))
       (mv :source fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-fields))
      ((unless (and (= (fn2-checkpoint-restore-semantic-directory 0 fn2-checkpoint-restore-semantic) 1)
                    (= (fn2-checkpoint-restore-semantic-schema 0 fn2-checkpoint-restore-semantic) 10)
                    (= (fn2-checkpoint-restore-semantic-level 0 fn2-checkpoint-restore-semantic) 0)
                    (= (fn2-checkpoint-restore-semantic-entry-stage 0 fn2-checkpoint-restore-semantic) 0)
                    (< (fn2-checkpoint-restore-semantic-cursor 0 fn2-checkpoint-restore-semantic)
                       (fn2-checkpoint-restore-semantic-entries 0 fn2-checkpoint-restore-semantic))))
       (mv :skip fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-fields))
      ((mv code fn2-fields) (fn2-checkpoint-restore-semantic-entry base fn2-checkpoint-restore-semantic fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                              fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool))
      ((unless (eq code :entry)) (mv code fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-fields))
      (eb (+ base *fn2-run-reader-entry*))
      ((unless (and (natp eb) (<= (+ eb *fn2-manifest-entry-num-fields*) (fn2-fields-rows fn2-fields))))
       (mv :bounds fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-fields))
      (schema (fn2-fields-value (+ eb *fn2-manifest-entry-field-schema*) fn2-fields))
      (rank (fn2-fields-value (+ eb *fn2-manifest-entry-field-run*) fn2-fields))
      (height (fn2-fields-value (+ eb *fn2-manifest-entry-field-height*) fn2-fields))
      (entries (fn2-fields-value (+ eb *fn2-manifest-entry-field-entries*) fn2-fields))
      (unit (fn2-fields-value (+ eb *fn2-manifest-entry-field-root-unit*) fn2-fields))
      (epoch (fn2-fields-value (+ eb *fn2-manifest-entry-field-root-epoch*) fn2-fields))
      (allocation (fn2-fields-value (+ eb *fn2-manifest-entry-field-root-allocation*) fn2-fields))
      (e (if (natp unit) (floor unit *fn2-storage-extent-units*) 0))
      ((unless (and (posp (fn2-run-layout-fields schema 0)) (unsigned-byte-p 60 schema)
                    (posp rank) (unsigned-byte-p 60 rank) (posp height) (<= height *fn2-run-max-levels*)
                    (unsigned-byte-p 60 entries) (unsigned-byte-p 60 unit) (= (mod unit *fn2-storage-extent-units*) 0)
                    (unsigned-byte-p 60 epoch) (unsigned-byte-p 60 allocation)
                    (< e (fn2-checkpoint-summary-sources-rows fn2-checkpoint-summary-sources))
                    (< e (fn2-checkpoint-restore-map-rows fn2-checkpoint-restore-map))
                    (= (fn2-checkpoint-restore-map-present e fn2-checkpoint-restore-map) 1)
                    (= (fn2-checkpoint-restore-map-state e fn2-checkpoint-restore-map) *fn2-extent-state-reserved*)
                    (= (fn2-checkpoint-restore-map-epoch e fn2-checkpoint-restore-map) epoch)
                    (= (fn2-checkpoint-restore-map-allocation e fn2-checkpoint-restore-map) allocation)
                    (= (fn2-fields-value (+ eb *fn2-manifest-entry-field-filter-unit*) fn2-fields) 0)
                    (= (fn2-fields-value (+ eb *fn2-manifest-entry-field-filter-epoch*) fn2-fields) 0)
                    (= (fn2-fields-value (+ eb *fn2-manifest-entry-field-filter-allocation*) fn2-fields) 0)))
       (mv :reference fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-fields))
      ((mv code fn2-checkpoint-summary fn2-checkpoint-summary-sources)
       (fn2-checkpoint-summary-record-fields 0 eb
        (fn2-checkpoint-restore-semantic-owner-kind 0 fn2-checkpoint-restore-semantic)
        (fn2-checkpoint-restore-semantic-owner-slot 0 fn2-checkpoint-restore-semantic)
        (fn2-checkpoint-restore-semantic-owner-gen 0 fn2-checkpoint-restore-semantic)
        fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-fields fn2-pool)))
  (mv code fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-fields)))

(defun fn2-checkpoint-summary-close (fn2-checkpoint-summary fn2-checkpoint-summary-sources

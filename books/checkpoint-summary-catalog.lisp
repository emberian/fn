       (mv :source fn2-checkpoint-summary))
      (e (fn2-checkpoint-restore-semantic-active 0 fn2-checkpoint-restore-semantic))
      ((unless (and (< e (fn2-checkpoint-restore-semantic-work-rows fn2-checkpoint-restore-semantic-work))
                    (= (fn2-checkpoint-restore-semantic-work-tag e fn2-checkpoint-restore-semantic-work)
                       (fn2-checkpoint-summary-semantic-tag 0 fn2-checkpoint-summary))
                    (= (fn2-checkpoint-restore-semantic-work-state e fn2-checkpoint-restore-semantic-work) *fn2-checkpoint-restore-semantic-work-state-closed*)
                    (= (fn2-checkpoint-restore-semantic-work-directory e fn2-checkpoint-restore-semantic-work) 1)
                    (= (fn2-checkpoint-restore-semantic-work-source e fn2-checkpoint-restore-semantic-work) 0)
                    (= (fn2-checkpoint-restore-semantic-work-seen e fn2-checkpoint-restore-semantic-work)
                       (fn2-checkpoint-summary-count 0 fn2-checkpoint-summary))))
       (mv :coverage fn2-checkpoint-summary))
      (fn2-checkpoint-summary (fn2-checkpoint-summary-put 0 (phase *fn2-checkpoint-summary-phase-captured*) (cursor 0) (installed 0))))
  (mv :captured fn2-checkpoint-summary)))

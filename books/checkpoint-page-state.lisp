; Shared physical checkpoint page state. Source builders own body provenance.
; These carriers record checked bytes and physical completion, never durability.
(in-package "ACL2")
(include-book "checkpoint-construction")
(include-book "format-context")
(fn2-book-layer :b)
(defcolumns fn2-checkpoint-page
 ((phase (:enum fn2-checkpoint-page-phase (:idle :context :seal :verify :write :wait-write :complete :uncertain)))
  (token :u60) (owner-kind :u8) (owner-slot :u32) (owner-gen :u60)
  (io-owner-kind :u8) (io-owner-slot :u32) (io-owner-gen :u60) (transferred :bool)
  (handoff (:enum fn2-checkpoint-page-handoff (:source :to-worker :worker :to-source)))
  (role :u8) (ordinal :u60) (extent :u32) (epoch :u60) (allocation :u60)
  (slot :u32) (gen :u60) (page-kind :u60) (history :u60) (incarnation :u60)
  (encoded-length :u32) (intended-bytes :u32) (write-cursor :u32)
  (checker-row :u32) (field-base :u32) (started :bool)
  (checker-phase :u8) (checker-pos :u32) (checker-zero :u32)
  (checker-pad :u32) (checker-pad-end :u32) (checker-geom :u32) (checker-previous-seal-offset :u32)
  (op-slot :u32) (op-gen :u60) (pending :bool)))
; Indexed by the actual reserved extent. No caller-supplied digest is installed.
; Eight little-endian words retain the actual verified 32-byte page hash.
(defcolumns fn2-checkpoint-page-verified
 ((live :bool) (token :u60) (owner-kind :u8) (owner-slot :u32) (owner-gen :u60)
  (role :u8) (ordinal :u60) (epoch :u60) (allocation :u60)
  (page-kind :u60) (history :u60) (incarnation :u60)
  (encoded-length :u32) (intended-bytes :u32) (completed-bytes :u32)
  (hash-0 :u32)
  (hash-1 :u32)
  (hash-2 :u32)
  (hash-3 :u32)
  (hash-4 :u32)
  (hash-5 :u32)
  (hash-6 :u32)
  (hash-7 :u32)
))

(defun fn2-checkpoint-page-ledger-p (token okind oslot ogen role ordinal extent epoch allocation intended completed
                                    fn2-checkpoint-construction fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-construction fn2-extents)
  :guard (and (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extents-wfp fn2-extents))))
 (and (natp extent) (< extent (fn2-checkpoint-construction-rows fn2-checkpoint-construction))
      (fn2-alloc-slotp extent fn2-extents)
      (fn2-checkpoint-construction-native-p extent fn2-checkpoint-construction)
      (equal (fn2-checkpoint-construction-token extent fn2-checkpoint-construction) token)
      (equal (fn2-checkpoint-construction-owner-kind extent fn2-checkpoint-construction) okind)
      (equal (fn2-checkpoint-construction-owner-slot extent fn2-checkpoint-construction) oslot)
      (equal (fn2-checkpoint-construction-owner-gen extent fn2-checkpoint-construction) ogen)
      (equal (fn2-checkpoint-construction-role extent fn2-checkpoint-construction) role)
      (equal (fn2-checkpoint-construction-ordinal extent fn2-checkpoint-construction) ordinal)
      (equal (fn2-checkpoint-construction-epoch extent fn2-checkpoint-construction) epoch)
      (equal (fn2-checkpoint-construction-counter extent fn2-checkpoint-construction) allocation)
      (equal (fn2-checkpoint-construction-intended-bytes extent fn2-checkpoint-construction) intended)
      (equal (fn2-checkpoint-construction-completed-bytes extent fn2-checkpoint-construction) completed)
      (eq (fn2-alloc-handle-code extent epoch allocation fn2-extents) :ok)
      (equal (fn2-extents-state extent fn2-extents) *fn2-extent-state-reserved*)))

(defun fn2-checkpoint-page-verified-word (extent i fn2-checkpoint-page-verified)
 (declare (xargs :stobjs fn2-checkpoint-page-verified
  :guard (and (fn2-checkpoint-page-verified-wfp fn2-checkpoint-page-verified)
              (natp extent) (< extent (fn2-checkpoint-page-verified-rows fn2-checkpoint-page-verified))
              (natp i) (< i 8))))
 (case i
  (0 (fn2-checkpoint-page-verified-hash-0 extent fn2-checkpoint-page-verified))
  (1 (fn2-checkpoint-page-verified-hash-1 extent fn2-checkpoint-page-verified))
  (2 (fn2-checkpoint-page-verified-hash-2 extent fn2-checkpoint-page-verified))
  (3 (fn2-checkpoint-page-verified-hash-3 extent fn2-checkpoint-page-verified))
  (4 (fn2-checkpoint-page-verified-hash-4 extent fn2-checkpoint-page-verified))
  (5 (fn2-checkpoint-page-verified-hash-5 extent fn2-checkpoint-page-verified))
  (6 (fn2-checkpoint-page-verified-hash-6 extent fn2-checkpoint-page-verified))
  (otherwise (fn2-checkpoint-page-verified-hash-7 extent fn2-checkpoint-page-verified))))

; Retained page evidence can be consumed after the singleton moves to a later
; extent. This observes actual verified bytes and exact physical completion;
; it deliberately says nothing about the producer's semantic source closure.
(defun fn2-checkpoint-page-completed-extent-p (token okind oslot ogen role ordinal extent
                                            fn2-checkpoint-page-verified fn2-checkpoint-construction fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-page-verified fn2-checkpoint-construction fn2-extents)
  :guard (and (fn2-checkpoint-page-verified-wfp fn2-checkpoint-page-verified)
              (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extents-wfp fn2-extents))))
 (and (natp extent) (< extent (fn2-checkpoint-page-verified-rows fn2-checkpoint-page-verified))
      (equal (fn2-checkpoint-page-verified-live extent fn2-checkpoint-page-verified) 1)
      (equal (fn2-checkpoint-page-verified-token extent fn2-checkpoint-page-verified) token)
      (equal (fn2-checkpoint-page-verified-owner-kind extent fn2-checkpoint-page-verified) okind)
      (equal (fn2-checkpoint-page-verified-owner-slot extent fn2-checkpoint-page-verified) oslot)
      (equal (fn2-checkpoint-page-verified-owner-gen extent fn2-checkpoint-page-verified) ogen)
      (equal (fn2-checkpoint-page-verified-role extent fn2-checkpoint-page-verified) role)
      (equal (fn2-checkpoint-page-verified-ordinal extent fn2-checkpoint-page-verified) ordinal)
      (let ((intended (fn2-checkpoint-page-verified-intended-bytes extent fn2-checkpoint-page-verified)))
       (and (posp intended) (<= intended 65536) (equal (mod intended 4096) 0)
            (equal (fn2-checkpoint-page-verified-encoded-length extent fn2-checkpoint-page-verified) intended)
            (equal (fn2-checkpoint-page-verified-completed-bytes extent fn2-checkpoint-page-verified) intended)
            (fn2-checkpoint-page-ledger-p token okind oslot ogen role ordinal extent
             (fn2-checkpoint-page-verified-epoch extent fn2-checkpoint-page-verified)
             (fn2-checkpoint-page-verified-allocation extent fn2-checkpoint-page-verified)
             intended intended fn2-checkpoint-construction fn2-extents)))))

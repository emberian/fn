; Scoped history chain over the canonical byte sequence of exported pairs.
; The caller supplies the bound history and version, never the request.
(in-package "ACL2")
(include-book "fnct-stream")
(include-book "blake3-word-frames")
(fn2-book-layer :e)
(local (include-book "arithmetic-3/floor-mod/floor-mod" :dir :system))

(defconst *fn2-xfnc-chain-genesis-tag* "fn2-xfnc-chain-v1/genesis")
(defconst *fn2-xfnc-chain-item-tag* "fn2-xfnc-chain-v1/item")

; Chain storage is private to the peer connection's hash stripe and is
; outside BLAKE3's CV, key, stack and final-output slots.
(defconst *fn2-xfnc-chain-region* 129)
(defconst *fn2-xfnc-evidence-interpretation* 1)

(local (in-theory (disable floor mod fn2-digestsp fn2-digests-wfp fn2-digests-rows
                           fn2-b3p fn2-b3-wfp fn2-b3-rows)))

(defun fn2-xfnc-chain-feed-be (row value width fn2-digests fn2-b3)
 (declare (xargs :stobjs (fn2-digests fn2-b3) :measure (nfix width)
                 :guard (and (fn2-b3-ready row fn2-b3 fn2-digests) (natp value)
                             (natp width) (<= width 8))))
 (if (or (not (mbt (fn2-b3-ready row fn2-b3 fn2-digests))) (zp width) (> width 8)) (mv fn2-digests fn2-b3)
   (mv-let (fn2-digests fn2-b3)
    (fn2-b3-byte row (fn2-fc-word-byte (nfix value) (- width 1)) fn2-digests fn2-b3)
    (fn2-xfnc-chain-feed-be row value (- width 1) fn2-digests fn2-b3))))
(fn2-digests-preserves fn2-xfnc-chain-feed-be
 (row value width fn2-digests fn2-b3)
 :carriers ((fn2-digests 0 :prefix "-DIGESTS") (fn2-b3 1 :prefix "-HASHER")))
(fn2-hash-row-frames fn2-xfnc-chain-feed-be fn2-digests fn2-b3)
(fn2-b3-word-frame fn2-xfnc-chain-feed-be :stripe)
(in-theory (disable fn2-xfnc-chain-feed-be))

(defun fn2-xfnc-chain-feed-digest (row previous i fn2-digests fn2-b3)
 (declare (xargs :stobjs (fn2-digests fn2-b3) :measure (nfix (- 32 (nfix i)))
                 :guard (and (fn2-b3-ready row fn2-b3 fn2-digests)
                             (fn2-digest-rowp previous fn2-digests) (natp i) (<= i 32))))
 (if (or (not (mbt (and (fn2-b3-ready row fn2-b3 fn2-digests)
                        (fn2-digest-rowp previous fn2-digests))))
         (not (natp i)) (>= i 32)) (mv fn2-digests fn2-b3)
   (mv-let (fn2-digests fn2-b3)
    (fn2-b3-byte row (fn2-fc-word-byte (fn2-digest-word previous (floor i 4) fn2-digests) (mod i 4))
                fn2-digests fn2-b3)
    (fn2-xfnc-chain-feed-digest row previous (+ i 1) fn2-digests fn2-b3))))
(fn2-digests-preserves fn2-xfnc-chain-feed-digest
 (row previous i fn2-digests fn2-b3)
 :carriers ((fn2-digests 0 :prefix "-DIGESTS") (fn2-b3 1 :prefix "-HASHER")))
(fn2-hash-row-frames fn2-xfnc-chain-feed-digest fn2-digests fn2-b3)
(fn2-b3-word-frame fn2-xfnc-chain-feed-digest :stripe)
(in-theory (disable fn2-xfnc-chain-feed-digest))

(defun fn2-xfnc-chain-genesis (row history incarnation revision principal stream view interpretation fn2-digests fn2-b3)
 (declare (xargs :stobjs (fn2-digests fn2-b3)))
 (b* ((dst (fn2-digest-slot (nfix row) *fn2-xfnc-chain-region*))
      (key (fn2-digest-slot (nfix row) *fn2-b3-key*))
      ((unless (and (fn2-b3-ready row fn2-b3 fn2-digests) (fn2-digest-rowp key fn2-digests)
                    (fn2-digest-rowp dst fn2-digests)
                    (unsigned-byte-p 60 history) (posp history)
                    (unsigned-byte-p 60 incarnation) (posp incarnation)
                    (unsigned-byte-p 60 revision) (posp revision)
                    (unsigned-byte-p 60 principal) (posp principal)
                    (unsigned-byte-p 60 stream) (posp stream)
                    (unsigned-byte-p 60 view) (posp view)
                    (equal interpretation *fn2-xfnc-evidence-interpretation*)))
       (mv :state fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-b3-init row 0 key fn2-digests fn2-b3))
      ((mv rc used fn2-digests fn2-b3)
       (fn2-b3-update-const row *fn2-xfnc-chain-genesis-tag* 0
                            (length *fn2-xfnc-chain-genesis-tag*) fn2-digests fn2-b3))
      ((unless (and (eq rc :ok) (equal used (length *fn2-xfnc-chain-genesis-tag*))))
       (mv :state fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-xfnc-chain-feed-be row history 8 fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-xfnc-chain-feed-be row incarnation 8 fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-xfnc-chain-feed-be row revision 8 fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-xfnc-chain-feed-be row principal 8 fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-xfnc-chain-feed-be row stream 8 fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-xfnc-chain-feed-be row view 8 fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-xfnc-chain-feed-be row interpretation 2 fn2-digests fn2-b3))
      (fn2-digests (fn2-b3-finalize dst row fn2-digests fn2-b3)))
  (mv :ok fn2-digests fn2-b3)))

(defun fn2-xfnc-chain-item-begin (row event hlen elen fn2-digests fn2-b3)
 (declare (xargs :stobjs (fn2-digests fn2-b3)))
 (b* ((prior (fn2-digest-slot (nfix row) *fn2-xfnc-chain-region*))
      (key (fn2-digest-slot (nfix row) *fn2-b3-key*))
      ((unless (and (fn2-b3-ready row fn2-b3 fn2-digests)
                    (fn2-digest-rowp key fn2-digests) (fn2-digest-rowp prior fn2-digests)
                    (posp event) (unsigned-byte-p 60 event)
                    (posp hlen) (unsigned-byte-p 16 hlen) (posp elen) (unsigned-byte-p 16 elen)))
       (mv :state fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-b3-init row 0 key fn2-digests fn2-b3))
      ((mv rc used fn2-digests fn2-b3)
       (fn2-b3-update-const row *fn2-xfnc-chain-item-tag* 0
                            (length *fn2-xfnc-chain-item-tag*) fn2-digests fn2-b3))
      ((unless (and (eq rc :ok) (equal used (length *fn2-xfnc-chain-item-tag*))))
       (mv :state fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-xfnc-chain-feed-digest row prior 0 fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-xfnc-chain-feed-be row event 8 fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-xfnc-chain-feed-be row hlen 2 fn2-digests fn2-b3))
      ((mv fn2-digests fn2-b3) (fn2-xfnc-chain-feed-be row elen 2 fn2-digests fn2-b3)))
  (mv :ok fn2-digests fn2-b3)))

(defun fn2-xfnc-chain-item-finish (row fn2-digests fn2-b3)
 (declare (xargs :stobjs (fn2-digests fn2-b3)))
 (let ((dst (fn2-digest-slot (nfix row) *fn2-xfnc-chain-region*)))
  (if (and (fn2-b3-ready row fn2-b3 fn2-digests) (fn2-digest-rowp dst fn2-digests))
      (mv :ok (fn2-b3-finalize dst row fn2-digests fn2-b3))
    (mv :state fn2-digests))))

(fn2-digests-preserves fn2-xfnc-chain-genesis
 (row history incarnation revision principal stream view interpretation fn2-digests fn2-b3)
 :carriers ((fn2-digests 1 :prefix "-DIGESTS") (fn2-b3 2 :prefix "-HASHER")))
(fn2-digests-preserves fn2-xfnc-chain-item-begin
 (row event hlen elen fn2-digests fn2-b3)
 :carriers ((fn2-digests 1 :prefix "-DIGESTS") (fn2-b3 2 :prefix "-HASHER")))
(fn2-digests-preserves fn2-xfnc-chain-item-finish (row fn2-digests fn2-b3) :position 1)
(in-theory (disable fn2-xfnc-chain-genesis fn2-xfnc-chain-item-begin fn2-xfnc-chain-item-finish))

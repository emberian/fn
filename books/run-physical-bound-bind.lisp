; Shared physical MISS-to-READ transition. Callers retain source authority.
(in-package "ACL2")
(include-book "run-physical-bound")
(fn2-book-layer :c)
(defun fn2-run-bound-bind (c kind owner generation history incarnation fn2-run-loads fn2-run-cursors fn2-pool)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-cursors fn2-pool)
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-run-cursors-wfp fn2-run-cursors) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (fn2-run-load-ownerp c kind owner generation fn2-run-loads)
                    (member (fn2-run-loads-phase c fn2-run-loads) (list *fn2-run-load-phase-reserved* *fn2-run-load-phase-ready*))
                    (equal (fn2-run-loads-pending c fn2-run-loads) 0)
                    (natp c)
                    (< c (fn2-run-cursors-rows fn2-run-cursors))
                    (equal (fn2-run-cursors-physical c fn2-run-cursors) 1)
                    (equal (fn2-run-cursors-phase c fn2-run-cursors) *fn2-run-cursor-phase-miss*)
                    (equal kind (fn2-run-cursors-okind c fn2-run-cursors))
                    (equal owner (fn2-run-cursors-oslot c fn2-run-cursors))
                    (equal generation (fn2-run-cursors-ogen c fn2-run-cursors))
                    (eq (fn2-pool-workspace-code (fn2-run-loads-page c fn2-run-loads) (fn2-run-loads-page-gen c fn2-run-loads) kind owner generation fn2-pool) :ok)
                    (eq (fn2-pool-workspace-code (fn2-run-loads-scratch c fn2-run-loads) (fn2-run-loads-scratch-gen c fn2-run-loads) kind owner generation fn2-pool) :ok)
                    (unsigned-byte-p 60 history) (unsigned-byte-p 60 incarnation)))
       (mv :source fn2-run-loads fn2-pool))
      ((mv code fn2-pool) (fn2-pool-reset (fn2-run-loads-page c fn2-run-loads) (fn2-run-loads-page-gen c fn2-run-loads) kind owner generation fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-run-loads fn2-pool))
      (fn2-run-loads (fn2-run-loads-put c (phase *fn2-run-load-phase-read*)
       (source (fn2-run-cursors-source-row c fn2-run-cursors)) (tag (fn2-run-cursors-catalog-tag c fn2-run-cursors))
       (unit (fn2-run-cursors-unit c fn2-run-cursors)) (epoch (fn2-run-cursors-epoch c fn2-run-cursors))
       (allocation (fn2-run-cursors-counter c fn2-run-cursors)) (schema (fn2-run-cursors-schema c fn2-run-cursors))
       (run (fn2-run-cursors-run c fn2-run-cursors)) (level (fn2-run-cursors-level c fn2-run-cursors))
       (history history)
       (incarnation incarnation)
       (sector 0) (copied 0) (hash-0 (fn2-run-cursor-hash-word c 0 fn2-run-cursors)) (hash-1 (fn2-run-cursor-hash-word c 1 fn2-run-cursors)) (hash-2 (fn2-run-cursor-hash-word c 2 fn2-run-cursors)) (hash-3 (fn2-run-cursor-hash-word c 3 fn2-run-cursors)) (hash-4 (fn2-run-cursor-hash-word c 4 fn2-run-cursors)) (hash-5 (fn2-run-cursor-hash-word c 5 fn2-run-cursors)) (hash-6 (fn2-run-cursor-hash-word c 6 fn2-run-cursors)) (hash-7 (fn2-run-cursor-hash-word c 7 fn2-run-cursors)))))
  (mv :need-read fn2-run-loads fn2-pool)))
(fn2-run-load-frames fn2-run-bound-bind
 (c kind owner generation history incarnation fn2-run-loads fn2-run-cursors fn2-pool)
 (fn2-run-loads fn2-run-cursors fn2-pool) ((fn2-run-loads 1) (fn2-pool 2)))

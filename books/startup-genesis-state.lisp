; One trusted startup capture and one bounded NAME construction owner.
(in-package "ACL2")
(include-book "profile")
(include-book "core-children")
(include-book "name-directory-geometry")
(fn2-book-layer :c)
(defcolumns fn2-genesis-names
 ((phase (:enum fn2-genesis-name-phase (:uncaptured :captured :opening :inserting :closing :complete :uncertain)))
  (role (:enum fn2-genesis-name-role (:groups :principals)))
  (kind :u8) (owner :u32) (generation :u60)
  (expected :u32) (cursor :u32) (groups-done :u32) (principals-done :u32) (overlay :u32) (slot :u32) (gen :u60) (base :u32)
  (anonymous-id :u60) (owner-id :u60) (have-owner :bool))
 :extra-fields
 ((fn2-genesis-names-groups :type t :initially nil :why "Trusted image-profile group cursor, independent of boot's destructive immutable verification cursor."
   :resident (* (+ *fn2-groups-name-max* *fn2-name-value-bytes*) (fn2-genesis-names-group-count fn2-genesis-names)))
  (fn2-genesis-names-group-count :type (unsigned-byte 32) :initially 0 :why "Actual trusted profile group length retained at capture; never caller readiness.")
  (fn2-genesis-names-authority :type (unsigned-byte 1) :initially 0 :why "Actual trusted authority profile policy; no principal NAME overlay without a reader.")
  (fn2-genesis-names-owner-slot :type (unsigned-byte 32) :initially 0 :why "Configured actor account slot, normalized by the existing profile reader.")
  (fn2-genesis-names-principals :type t :initially nil :why "Only the anonymous/owner NAME pairs derived from already-bound actual accounts."
   :resident (* 2 (+ *fn2-principals-name-max* *fn2-name-value-bytes*)))))
(defun fn2-genesis-names-prepare (profile fn2-genesis-names)
 (declare (xargs :stobjs fn2-genesis-names :guard t))
 (let* ((fn2-genesis-names (fn2-genesis-names-init 1 fn2-genesis-names))
        (fn2-genesis-names (fn2-genesis-names-put 0 (overlay *fn2-none*) (slot *fn2-none*)))
        (groups (fn2-profile-get :groups profile)) (count (len groups))
        (owner (fn2-profile-owner-account profile)))
  (if (not (fn2-profile-get :image-boot profile)) fn2-genesis-names
   (if (not (and (unsigned-byte-p 32 count) (unsigned-byte-p 32 owner)))
       (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-uncertain* fn2-genesis-names)
    (let* ((fn2-genesis-names (update-fn2-genesis-names-groups groups fn2-genesis-names))
           (fn2-genesis-names (update-fn2-genesis-names-group-count count fn2-genesis-names))
           (fn2-genesis-names (update-fn2-genesis-names-authority (if (posp (nfix (fn2-profile-get :authority profile))) 1 0) fn2-genesis-names))
           (fn2-genesis-names (update-fn2-genesis-names-owner-slot owner fn2-genesis-names)))
     (fn2-genesis-names-set-phase 0 *fn2-genesis-name-phase-captured* fn2-genesis-names))))))
(fn2-genesis-names-preserves fn2-genesis-names-prepare (profile fn2-genesis-names) :position nil :rows nil)
(defcorechild fn2-core-genesis-names fn2-genesis-names
 :init (fn2-genesis-names-prepare profile fn2-genesis-names)
 :profilep (or (not (fn2-profile-get :image-boot profile))
               (and (unsigned-byte-p 32 (len (fn2-profile-get :groups profile)))
                    (unsigned-byte-p 32 (fn2-profile-owner-account profile))))
 :why "One trusted image genesis capture survives anchor investigation; fresh NAME construction owns exactly one active overlay at a time.")
(defun fn2-genesis-names-ownerp (kind owner generation fn2-genesis-names)
 (declare (xargs :stobjs fn2-genesis-names :guard t))
 (and (fn2-genesis-names-wfp fn2-genesis-names) (< 0 (fn2-genesis-names-rows fn2-genesis-names))
      (equal (fn2-genesis-names-kind 0 fn2-genesis-names) kind)
      (equal (fn2-genesis-names-owner 0 fn2-genesis-names) owner)
      (equal (fn2-genesis-names-generation 0 fn2-genesis-names) generation)))
(defun fn2-genesis-names-current (fn2-genesis-names)
 (declare (xargs :stobjs fn2-genesis-names :guard (fn2-genesis-names-wfp fn2-genesis-names)))
 (if (and (< 0 (fn2-genesis-names-rows fn2-genesis-names))
          (= (fn2-genesis-names-role 0 fn2-genesis-names) *fn2-genesis-name-role-groups*))
     (fn2-genesis-names-groups fn2-genesis-names)
   (fn2-genesis-names-principals fn2-genesis-names)))

(defun fn2-genesis-names-principal-count (fn2-genesis-names)
 (declare (xargs :stobjs fn2-genesis-names :guard (fn2-genesis-names-wfp fn2-genesis-names)))
 (if (and (< 0 (fn2-genesis-names-rows fn2-genesis-names))
          (= (fn2-genesis-names-authority fn2-genesis-names) 1))
     (+ 1 (fn2-genesis-names-have-owner 0 fn2-genesis-names)) 0))
(defun fn2-genesis-names-completep (fn2-genesis-names)
 (declare (xargs :stobjs fn2-genesis-names :guard (fn2-genesis-names-wfp fn2-genesis-names)))
 (and (< 0 (fn2-genesis-names-rows fn2-genesis-names))
      (= (fn2-genesis-names-phase 0 fn2-genesis-names) *fn2-genesis-name-phase-complete*)
      (= (fn2-genesis-names-role 0 fn2-genesis-names) *fn2-genesis-name-role-principals*)
      (= (fn2-genesis-names-groups-done 0 fn2-genesis-names) (fn2-genesis-names-group-count fn2-genesis-names))
      (= (fn2-genesis-names-principals-done 0 fn2-genesis-names) (fn2-genesis-names-principal-count fn2-genesis-names))
      (= (fn2-genesis-names-expected 0 fn2-genesis-names) (fn2-genesis-names-principal-count fn2-genesis-names))
      (= (fn2-genesis-names-cursor 0 fn2-genesis-names) (fn2-genesis-names-expected 0 fn2-genesis-names))
      (null (fn2-genesis-names-groups fn2-genesis-names)) (null (fn2-genesis-names-principals fn2-genesis-names))))

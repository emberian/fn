; Private windows are authorized by an outstanding upper codec action.
(in-package "ACL2")
(include-book "codec-transport")
(fn2-book-layer :a)

(defmacro defcodec-stack-bridge (name upper lower operation
 &key (input-quantum-field 'input-quantum) (output-quantum-field 'output-quantum))
 `(progn
(defun ,(fn2-columns-sym name "-PARENT") (cap nonce slot generation ,upper)
 (declare (xargs :stobjs ,upper :verify-guards nil
  :guard (and (,(fn2-columns-sym upper "-WFP") ,upper) (= (,(fn2-columns-sym upper "-ROWS") ,upper) 1))))
 (let* ((serial (,(fn2-columns-sym upper "-SERIAL") 0 ,upper))
        (writep (equal (,(fn2-columns-sym upper "-PENDING") 0 ,upper) 5))
        (channel (if writep (,(fn2-columns-sym upper "-REQUEST-IN-CHANNEL") 0 ,upper) (,(fn2-columns-sym upper "-REQUEST-OUT-CHANNEL") 0 ,upper)))
        (offset (if writep (,(fn2-columns-sym upper "-REQUEST-IN-OFFSET") 0 ,upper) (,(fn2-columns-sym upper "-REQUEST-OUT-OFFSET") 0 ,upper)))
        (count (if writep (,(fn2-columns-sym upper "-REQUEST-IN-COUNT") 0 ,upper) (,(fn2-columns-sym upper "-REQUEST-OUT-COUNT") 0 ,upper)))
        (extent (if writep (,(fn2-columns-sym upper "-REQUEST-IN-EXTENT") 0 ,upper) (,(fn2-columns-sym upper "-REQUEST-OUT-EXTENT") 0 ,upper))))
  (if (and (,(fn2-columns-sym upper "-MATCH-P") cap nonce slot generation serial ,upper)
           (< 0 serial) (= (,(fn2-columns-sym upper "-ALIVE") 0 ,upper) 1) (= (,(fn2-columns-sym upper "-TERMINAL") 0 ,upper) 3)
           (member-equal (,(fn2-columns-sym upper "-PENDING") 0 ,upper) '(5 6))
           (< 0 count) (<= (+ offset count) extent)
           (if writep
               (and (= channel 3) (= offset (,(fn2-columns-sym upper "-OUTPUT-OFFSET") 0 ,upper))
                    (= extent (,(fn2-columns-sym upper "-OUTPUT-LENGTH") 0 ,upper))
                    (<= extent (,(fn2-columns-sym upper (concatenate 'string "-" (symbol-name output-quantum-field))) 0 ,upper))
                    (= (,(fn2-columns-sym upper "-REQUEST-OUT-CHANNEL") 0 ,upper) 0)
                    (= (,(fn2-columns-sym upper "-REQUEST-OUT-COUNT") 0 ,upper) 0))
             (and (= channel 2) (= offset 0)
                  (= (,(fn2-columns-sym upper "-INPUT-OFFSET") 0 ,upper) (,(fn2-columns-sym upper "-INPUT-LENGTH") 0 ,upper))
                  (= extent (,(fn2-columns-sym upper (concatenate 'string "-" (symbol-name input-quantum-field))) 0 ,upper))
                  (= (,(fn2-columns-sym upper "-REQUEST-IN-CHANNEL") 0 ,upper) 0)
                  (= (,(fn2-columns-sym upper "-REQUEST-IN-COUNT") 0 ,upper) 0))))
      (mv :ok channel offset count serial)
    (mv :stale 0 0 0 0))))

(defun ,(fn2-columns-sym name "-SPAN")
 (cap nonce slot generation serial action offset count ,upper ,lower ,operation)
 (declare (xargs :stobjs (,upper ,lower ,operation) :verify-guards nil
  :guard (and (,(fn2-columns-sym upper "-WFP") ,upper) (= (,(fn2-columns-sym upper "-ROWS") ,upper) 1)
              (,(fn2-columns-sym lower "-WFP") ,lower) (= (,(fn2-columns-sym lower "-ROWS") ,lower) 1)
              (,(fn2-columns-sym operation "-WFP") ,operation) (= (,(fn2-columns-sym operation "-ROWS") ,operation) 1))))
 (mv-let (code channel base extent parent-serial)
  (,(fn2-columns-sym name "-PARENT") cap nonce slot generation ,upper)
  (if (and (eq code :ok) (member-equal action '(12 13))
           (equal action (if (= channel 3) 13 12))
           (,(fn2-columns-sym lower "-MATCH-P") cap nonce slot generation serial ,lower)
           (= (,(fn2-columns-sym lower "-ALIVE") 0 ,lower) 1) (= (,(fn2-columns-sym lower "-TERMINAL") 0 ,lower) 3)
           (= action (,(fn2-columns-sym lower "-PENDING") 0 ,lower))
           (= cap (,(fn2-columns-sym operation "-CAP") 0 ,operation)) (= nonce (,(fn2-columns-sym operation "-NONCE") 0 ,operation))
           (= slot (,(fn2-columns-sym operation "-SLOT") 0 ,operation)) (= generation (,(fn2-columns-sym operation "-GENERATION") 0 ,operation))
           (= parent-serial (,(fn2-columns-sym operation "-PARENT-SERIAL") 0 ,operation))
           (= extent (,(fn2-columns-sym operation "-EXTENT") 0 ,operation)) (= (,(fn2-columns-sym operation "-TERMINAL") 0 ,operation) 0)
           (= serial (,(fn2-columns-sym operation "-PENDING-SERIAL") 0 ,operation)) (= action (,(fn2-columns-sym operation "-PENDING-ACTION") 0 ,operation))
           (unsigned-byte-p 32 offset) (unsigned-byte-p 32 count) (< 0 count)
           (<= (+ offset count) extent)
           (if (= action 13)
               (and (= offset (,(fn2-columns-sym operation "-SOURCE-PROGRESS") 0 ,operation)) (= count (,(fn2-columns-sym operation "-SOURCE-COUNT") 0 ,operation))
                    (= (,(fn2-columns-sym lower "-REQUEST-IN-CHANNEL") 0 ,lower) 4)
                    (= offset (,(fn2-columns-sym lower "-REQUEST-IN-OFFSET") 0 ,lower)) (= count (,(fn2-columns-sym lower "-REQUEST-IN-COUNT") 0 ,lower))
                    (= extent (,(fn2-columns-sym lower "-REQUEST-IN-EXTENT") 0 ,lower)))
             (and (= offset (,(fn2-columns-sym operation "-SINK-PROGRESS") 0 ,operation)) (= count (,(fn2-columns-sym operation "-SINK-COUNT") 0 ,operation))
                  (= (,(fn2-columns-sym lower "-REQUEST-OUT-CHANNEL") 0 ,lower) 5)
                  (= offset (,(fn2-columns-sym lower "-REQUEST-OUT-OFFSET") 0 ,lower)) (= count (,(fn2-columns-sym lower "-REQUEST-OUT-COUNT") 0 ,lower))
                  (= extent (,(fn2-columns-sym lower "-REQUEST-OUT-EXTENT") 0 ,lower)))))
      (mv :ok channel (+ base offset) count)
    (mv :stale 0 0 0))))))

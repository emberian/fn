; Private selected-recovery RELEASE continuation. No archived source is invented.
; The original authenticated journal lease remains separate from evidence I/O.
; Driver/checker binding is pending: unreachable-in-composition until parent
; VERIFY routing and the authenticated verifier terminal are connected.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "recovery-payload")
(include-book "release-evidence")
(fn2-book-layer :d)

(defun fn2-release-read-hash (i src slot gen kind owner generation fn2-pool fn2-allocation-release)
 (declare (xargs :stobjs (fn2-pool fn2-allocation-release) :measure (nfix (- 32 (nfix i)))
  :guard (and (fn2-pool-wfp fn2-pool) (fn2-allocation-release-wfp fn2-allocation-release)
              (natp i) (<= i 32) (natp src))))
 (if (>= (nfix i) 32) (mv :ok fn2-allocation-release)
  (mv-let (code byte) (fn2-pool-read slot gen (+ src i) kind owner generation fn2-pool)
   (if (not (eq code :ok)) (mv code fn2-allocation-release)
    (let ((fn2-allocation-release (update-fn2-allocation-release-descriptori i byte fn2-allocation-release)))
     (fn2-release-read-hash (+ i 1) src slot gen kind owner generation fn2-pool fn2-allocation-release))))))
(fn2-allocation-release-preserves fn2-release-read-hash
 (i src slot gen kind owner generation fn2-pool fn2-allocation-release)
 :hyps ((fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
        (fn2-allocation-releasep fn2-allocation-release) (fn2-allocation-release-wfp fn2-allocation-release)
        (natp i) (<= i 32) (natp src))
 :specs (("-TYPE" fn2-allocation-releasep 1) ("-WFP" fn2-allocation-release-wfp 1)
         ("-ROWS" fn2-allocation-release-rows 1 :frame fn2-allocation-release)))

(defun fn2-rp-release-current-p (id ogen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (and (fn2-rp-current-unit-auth-p id ogen fn2-core)
      (fn2-recovery-selected-current-p id fn2-core)
      (= (fn2-machine-rc-mode id fn2-core) *fn2-rec-mode-replay*)
      (= (fn2-machine-rc-wlen id fn2-core) 0)
  (let ((actual-rc-base (fn2-machine-rc-base id fn2-core))
(actual-rc-base-tag (fn2-machine-rc-base-tag id fn2-core))
(actual-rc-commit (fn2-machine-rc-commit id fn2-core))
(actual-rc-pos (fn2-machine-rc-pos id fn2-core))
(actual-rc-roff (fn2-machine-rc-roff id fn2-core))
(actual-rc-rend (fn2-machine-rc-rend id fn2-core))
(actual-pool-slot (fn2-machine-pool-slot id fn2-core))
(actual-pool-gen (fn2-machine-pool-gen id fn2-core))
(actual-rc-wslot (fn2-machine-rc-wslot id fn2-core))
(actual-rc-wgen (fn2-machine-rc-wgen id fn2-core)))
(stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))) (current)
   (and (< 0 (fn2-allocation-release-rows fn2-allocation-release))
    (= (fn2-allocation-release-phase 0 fn2-allocation-release) *fn2-allocation-release-phase-replaying*)
    (= (fn2-allocation-release-owner-kind 0 fn2-allocation-release) *fn2-recovery-machine-kind*)
    (equal (fn2-allocation-release-owner-slot 0 fn2-allocation-release) id)
    (equal (fn2-allocation-release-owner-gen 0 fn2-allocation-release) ogen)
    (= (fn2-allocation-release-replay-base 0 fn2-allocation-release) actual-rc-base)
    (= (fn2-allocation-release-replay-tag 0 fn2-allocation-release) actual-rc-base-tag)
    (= (fn2-allocation-release-replay-commit 0 fn2-allocation-release) actual-rc-commit)
    (= (fn2-allocation-release-replay-position 0 fn2-allocation-release) actual-rc-pos)
    (= (fn2-allocation-release-replay-roff 0 fn2-allocation-release) actual-rc-roff)
    (= (fn2-allocation-release-replay-rend 0 fn2-allocation-release) actual-rc-rend)
    (= (fn2-allocation-release-replay-slot 0 fn2-allocation-release) actual-pool-slot)
    (= (fn2-allocation-release-replay-gen 0 fn2-allocation-release) actual-pool-gen)
    (= (fn2-allocation-release-read-slot 0 fn2-allocation-release) actual-rc-wslot)
    (= (fn2-allocation-release-read-gen 0 fn2-allocation-release) actual-rc-wgen)) current))))

; Called only at the actual authenticated record boundary. This reuses both
; shared journal decoders, so no caller supplies the RELEASE identity or cursor.
(defun fn2-recovery-release-begin (id ogen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (b* (((unless (and (fn2-rp-current-unit-auth-p id ogen fn2-core)
    (fn2-recovery-selected-current-p id fn2-core)
    (= (fn2-machine-rc-mode id fn2-core) *fn2-rec-mode-replay*)
    (= (fn2-machine-rc-stage id fn2-core) 0) (= (fn2-machine-rc-wlen id fn2-core) 0))) (mv :invalid fn2-core))
  (off (fn2-machine-rc-roff id fn2-core)) (end (fn2-machine-rc-rend id fn2-core))
  (slot (fn2-machine-pool-slot id fn2-core)) (gen (fn2-machine-pool-gen id fn2-core))
  ((mv code next kind event fn2-core) (fn2-rp-header off end slot gen id ogen fn2-core))
  ((unless (and (eq code :ok) (= kind *record-kind-release-allocation*) (< off next) (<= next end))) (mv :invalid fn2-core))
  ((mv code body-end fn2-core) (fn2-rp-body kind next end slot gen id ogen fn2-core))
  ((unless (and (eq code :ok) (< next body-end) (<= body-end end))) (mv :invalid fn2-core)))
  (let ((actual-rc-base (fn2-machine-rc-base id fn2-core))
(actual-rc-base-tag (fn2-machine-rc-base-tag id fn2-core))
(actual-rc-commit (fn2-machine-rc-commit id fn2-core))
(actual-rc-pos (fn2-machine-rc-pos id fn2-core))
(actual-rc-roff (fn2-machine-rc-roff id fn2-core))
(actual-rc-rend (fn2-machine-rc-rend id fn2-core))
(actual-pool-slot (fn2-machine-pool-slot id fn2-core))
(actual-pool-gen (fn2-machine-pool-gen id fn2-core))
(actual-rc-wslot (fn2-machine-rc-wslot id fn2-core))
(actual-rc-wgen (fn2-machine-rc-wgen id fn2-core)))
(stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))
   (fn2-commit-root (fn2-core-commit-root fn2-core)) (fn2-rec-cand (fn2-core-rec-cand fn2-core))
   (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
   (answer fn2-allocation-release)
   (b* (((unless (and (< 0 (fn2-allocation-release-rows fn2-allocation-release))
       (= (fn2-allocation-release-phase 0 fn2-allocation-release) *fn2-allocation-release-phase-idle*)
       (= (fn2-allocation-release-evidence-owned 0 fn2-allocation-release) 0)
       (= (fn2-allocation-release-read-pending 0 fn2-allocation-release) 0)
       (<= (+ *fn2-rec-field-base* *fn2-format-release-allocation-num-fields*) (fn2-fields-rows fn2-fields)))) (mv :state fn2-allocation-release))
     (f (+ *fn2-rec-field-base* *fn2-format-release-allocation-field-release-evidence-storage-domain*))
     (installation (fn2-fields-value (+ *fn2-rec-field-base* *fn2-format-release-allocation-field-installation-commit*) fn2-fields))
     (installation-event (fn2-fields-value (+ *fn2-rec-field-base* *fn2-format-release-allocation-field-installation-event*) fn2-fields))
     ((unless (and (posp installation) (< installation actual-rc-commit)
       (posp installation-event) (< installation-event event)
       (unsigned-byte-p 32 (fn2-fields-value (+ *fn2-rec-field-base* *fn2-format-release-allocation-field-extent*) fn2-fields))
       (posp (fn2-fields-value (+ *fn2-rec-field-base* *fn2-format-release-allocation-field-promoted-checkpoint*) fn2-fields))
       (posp (fn2-fields-value (+ *fn2-rec-field-base* *fn2-format-release-allocation-field-retirement-commit*) fn2-fields))
       (< (fn2-fields-value (+ *fn2-rec-field-base* *fn2-format-release-allocation-field-retirement-commit*) fn2-fields) actual-rc-commit)
       (= (fn2-fields-value f fn2-fields) 0)
       (= (mod (fn2-fields-value (+ f 1) fn2-fields) *fn2-storage-extent-units*) 0)
       (= (fn2-fields-value (+ f 4) fn2-fields) *page-kind-checkpoint-descriptor*)
       (= (fn2-fields-value (+ f 5) fn2-fields) 4096)
       (= (fn2-fields-value (+ f 6) fn2-fields) 1) (= (fn2-fields-ref-len (+ f 6) fn2-fields) 32))) (mv :invalid fn2-allocation-release))
     ((mv found row) (fn2-commit-directory-lookup installation fn2-commit-root))
     ((unless (eq found :ok)) (mv (if (member-eq found '(:base :archived)) :archive-required :invalid) fn2-allocation-release))
     (position (fn2-commit-root-extent row fn2-commit-root))
     ((unless (and (< position (fn2-rec-cand-rows fn2-rec-cand))
       (= (fn2-rec-cand-status position fn2-rec-cand) *fn2-rec-status-chained*)
       (= (fn2-rec-cand-commit position fn2-rec-cand) installation)
       (<= (fn2-rec-cand-first position fn2-rec-cand) installation-event)
       (<= installation-event (fn2-rec-cand-last position fn2-rec-cand)))) (mv :invalid fn2-allocation-release))
     ((mv copied fn2-allocation-release) (fn2-release-read-hash 0 (fn2-fields-ref-off (+ f 6) fn2-fields)
       slot gen *fn2-recovery-machine-kind* id ogen fn2-pool fn2-allocation-release))
     ((unless (eq copied :ok)) (mv :invalid fn2-allocation-release))
     (fn2-allocation-release (fn2-allocation-release-put 0
       (phase *fn2-allocation-release-phase-replaying*) (owner-kind *fn2-recovery-machine-kind*) (owner-slot id) (owner-gen ogen)
       (replay-base actual-rc-base) (replay-tag actual-rc-base-tag)
       (replay-commit actual-rc-commit) (replay-position actual-rc-pos)
       (batch actual-rc-commit) (event event)
       (replay-roff off) (replay-rend end) (replay-next body-end) (replay-slot slot) (replay-gen gen)
       (extent (fn2-fields-value (+ *fn2-rec-field-base* *fn2-format-release-allocation-field-extent*) fn2-fields))
       (epoch (fn2-fields-value (+ *fn2-rec-field-base* *fn2-format-release-allocation-field-writer-epoch*) fn2-fields))
       (allocation (fn2-fields-value (+ *fn2-rec-field-base* *fn2-format-release-allocation-field-allocation*) fn2-fields))
       (retirement (fn2-fields-value (+ *fn2-rec-field-base* *fn2-format-release-allocation-field-retirement-commit*) fn2-fields))
       (checkpoint (fn2-fields-value (+ *fn2-rec-field-base* *fn2-format-release-allocation-field-promoted-checkpoint*) fn2-fields))
       (installation-commit installation) (installation-event installation-event) (installation-position position)
       (storage-domain (fn2-fields-value (+ f 0) fn2-fields)) (physical-unit (fn2-fields-value (+ f 1) fn2-fields))
       (descriptor-epoch (fn2-fields-value (+ f 2) fn2-fields)) (descriptor-allocation (fn2-fields-value (+ f 3) fn2-fields))
       (page-kind (fn2-fields-value (+ f 4) fn2-fields)) (encoded-length (fn2-fields-value (+ f 5) fn2-fields))
       (read-phase *fn2-allocation-release-read-phase-need*) (read-purpose *fn2-allocation-release-read-purpose-descriptor*)
       (read-slot actual-rc-wslot) (read-gen actual-rc-wgen)
       (read-unit (fn2-fields-value (+ f 1) fn2-fields)) (read-epoch (fn2-fields-value (+ f 2) fn2-fields))
       (read-allocation (fn2-fields-value (+ f 3) fn2-fields)) (read-length 4096) (read-pending 0) (checker-stage 0))))
    (mv :need-read fn2-allocation-release))
   (mv answer fn2-core)))))
(fn2-core-preserves fn2-recovery-release-begin (id ogen fn2-core) :position 1 :rows nil)
(defcost fn2-recovery-release-begin :answers (:need-read :archive-required :invalid :state)
 :bytes 4096 :tables (fn2-core-allocation-release fn2-core-fields)
 :doc "Capture only the actual authenticated selected RELEASE body and exact resident installation source; archived source remains explicit refusal.")

(defun fn2-recovery-release-issue (id ogen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (if (not (and (fn2-rp-release-current-p id ogen fn2-core)
               (= (fn2-machine-rc-stage id fn2-core) 11)))
  (mv :invalid 0 0 fn2-core)
  (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))
    (fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))
    (fn2-pool (fn2-core-pool fn2-core)) (fn2-ops (fn2-core-ops fn2-core)) (fn2-control (fn2-core-control fn2-core)))
   (answer op opgen fn2-allocation-release fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges)
   (b* (((unless (and (= (fn2-allocation-release-read-phase 0 fn2-allocation-release) *fn2-allocation-release-read-phase-need*)
      (= (fn2-allocation-release-read-pending 0 fn2-allocation-release) 0)
      (= (fn2-allocation-release-read-purpose 0 fn2-allocation-release) *fn2-allocation-release-read-purpose-descriptor*)
      (= (fn2-allocation-release-read-unit 0 fn2-allocation-release) (fn2-allocation-release-physical-unit 0 fn2-allocation-release))
      (= (fn2-allocation-release-read-epoch 0 fn2-allocation-release) (fn2-allocation-release-descriptor-epoch 0 fn2-allocation-release))
      (= (fn2-allocation-release-read-allocation 0 fn2-allocation-release) (fn2-allocation-release-descriptor-allocation 0 fn2-allocation-release))
      (= (fn2-allocation-release-read-length 0 fn2-allocation-release) 4096)))
     (mv :invalid 0 0 fn2-allocation-release fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges))
    (slot (fn2-allocation-release-read-slot 0 fn2-allocation-release))
    (gen (fn2-allocation-release-read-gen 0 fn2-allocation-release))
    ((unless (and (not (= slot (fn2-allocation-release-replay-slot 0 fn2-allocation-release)))
      (< slot (fn2-pool-rows fn2-pool)) (<= 4096 (fn2-pool-cap slot fn2-pool))))
     (mv :invalid 0 0 fn2-allocation-release fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges))
    ((mv reset fn2-pool) (fn2-pool-reset slot gen *fn2-recovery-machine-kind* id ogen fn2-pool))
    ((unless (eq reset :ok)) (mv :invalid 0 0 fn2-allocation-release fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges))
    ((mv code op opgen fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges)
     (fn2-block-read-children (fn2-allocation-release-read-unit 0 fn2-allocation-release)
      (fn2-allocation-release-read-epoch 0 fn2-allocation-release) (fn2-allocation-release-read-allocation 0 fn2-allocation-release)
      0 4096 slot gen *fn2-recovery-machine-kind* id ogen 0 fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control))
    ((when (eq code :exhausted)) (mv :exhausted 0 0 fn2-allocation-release fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges))
    ((unless (and (eq code :ok) (unsigned-byte-p 32 op) (unsigned-byte-p 60 opgen)))
     (mv :invalid 0 0 (fn2-allocation-release-put 0 (read-phase *fn2-allocation-release-read-phase-uncertain*)
        (read-pending (if (= (fn2-control-stop fn2-control) 1) 1 0)))
      fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges))
    (fn2-allocation-release (fn2-allocation-release-put 0 (read-op-slot op) (read-op-gen opgen)
       (read-pending 1) (read-phase *fn2-allocation-release-read-phase-wait*))))
    (mv :issued op opgen fn2-allocation-release fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges))
   (mv answer op opgen fn2-core))))
(fn2-core-preserves fn2-recovery-release-issue (id ogen fn2-core) :position 3 :rows nil)
(defcost fn2-recovery-release-issue :answers (:issued :exhausted :invalid) :bytes 4096 :descriptors 1
 :tables (fn2-core-allocation-release fn2-core-extents fn2-core-alloc-edges fn2-core-pool fn2-core-ops fn2-core-control)
 :doc "Issue one exact pinned descriptor read beside the immutable authenticated journal; only the pre-finish exact-op hook loads it.")

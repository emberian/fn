  (mv-let (code byte) (fn2-pool-read slot gen (+ src i) kind owner generation fn2-pool)
   (if (not (eq code :ok)) (mv code fn2-allocation-release)
    (let ((fn2-allocation-release (update-fn2-allocation-release-descriptori i byte fn2-allocation-release)))
     (fn2-release-read-hash (+ i 1) src slot gen kind owner generation fn2-pool fn2-allocation-release))))))

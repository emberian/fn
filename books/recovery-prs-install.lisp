; Image baseline installation from the actual compiler source readout only.
(in-package "ACL2")
(include-book "page-read-counter-transaction")
(include-book "runtime-operation-source")
(defun fn-rpi-coordinate-matchesp (a b)
 (declare (xargs :guard t))
 (and (fn-prb-fixed-widthp 4 a) (fn-prb-fixed-widthp 4 b)
      (or (symbolp (fn-prl-nth 0 a)) (integerp (fn-prl-nth 0 a))) (or (symbolp (fn-prl-nth 1 a)) (integerp (fn-prl-nth 1 a)))
      (or (symbolp (fn-prl-nth 2 a)) (integerp (fn-prl-nth 2 a))) (or (symbolp (fn-prl-nth 3 a)) (integerp (fn-prl-nth 3 a)))
      (or (symbolp (fn-prl-nth 0 b)) (integerp (fn-prl-nth 0 b))) (or (symbolp (fn-prl-nth 1 b)) (integerp (fn-prl-nth 1 b)))
      (or (symbolp (fn-prl-nth 2 b)) (integerp (fn-prl-nth 2 b))) (or (symbolp (fn-prl-nth 3 b)) (integerp (fn-prl-nth 3 b)))
      (equal (fn-prl-nth 0 a) (fn-prl-nth 0 b))
      (equal (fn-prl-nth 1 a) (fn-prl-nth 1 b))
      (equal (fn-prl-nth 2 a) (fn-prl-nth 2 b))
      (equal (fn-prl-nth 3 a) (fn-prl-nth 3 b))))
(defun fn-rpi-association-matchesp (a b)
 (declare (xargs :guard t))
 (and (fn-prb-fixed-widthp 6 a) (fn-prb-fixed-widthp 6 b)
      (eq (fn-prl-nth 0 a) :allocation-epoch-association)
      (eq (fn-prl-nth 0 b) :allocation-epoch-association)
      (fn-rpi-coordinate-matchesp (fn-prl-nth 1 a) (fn-prl-nth 1 b))
      (fn-rpi-coordinate-matchesp (fn-prl-nth 2 a) (fn-prl-nth 2 b))
      (fn-rpi-coordinate-matchesp (fn-prl-nth 3 a) (fn-prl-nth 3 b))
      (natp (fn-prl-nth 4 a)) (natp (fn-prl-nth 5 a))
      (equal (fn-prl-nth 4 a) (fn-prl-nth 4 b))
      (equal (fn-prl-nth 5 a) (fn-prl-nth 5 b))))
(defun fn-owner-recovery-prs-install (fn-page-read-pool state)
 (declare (xargs :stobjs (fn-page-read-pool state) :guard t :verify-guards nil))
 (if (not (and (null (fn-prp-data fn-page-read-pool))
               (eq (fn-prp-mode fn-page-read-pool) :uninitialized)
               (member-eq (fn-prp-alloc-mode fn-page-read-pool) '(:active :draining))
               (equal (fn-prp-alloc-active-turns fn-page-read-pool) 0)))
  (mv :recovery-prs-install-unavailable fn-page-read-pool)
  (mv-let (word resources)
   (fn-owner-runtime-operation-resources :runtime-bootstrap fn-page-read-pool state)
   (let* ((baseline (fn-prl-nth 4 resources))
          (budget (fn-prl-nth 2 baseline))
          (owned (fn-prl-nth 3 baseline))
          (rescue (fn-prl-nth 4 baseline))
          (aux (fn-prl-nth 5 baseline))
          (limit (fn-prl-nth 6 baseline)))
    (if (not (and (eq word :runtime-operation-available)
                  (fn-prb-fixed-widthp 5 resources)
                  (eq (fn-prl-nth 0 resources) :runtime-bootstrap-resources)
                  (fn-prb-fixed-widthp 9 baseline)
                  (eq (fn-prl-nth 0 baseline) :recovery-prs-baseline)
                  (equal rescue '(0 0 0 0 0))
                  (fn-prs-vectorp budget) (fn-prs-vectorp owned)
                  (fn-prb-fixed-widthp 3 aux) (posp limit)
                  (equal limit (fn-prl-nth 4 budget))
                  (fn-rpi-association-matchesp (fn-prl-nth 1 baseline)
                         (fn-prl-nth 1 (fn-prp-alloc-installation fn-page-read-pool)))
                  (fn-rpi-association-matchesp (fn-prl-nth 1 baseline)
                         (fn-prl-nth 4 (fn-prl-nth 1 resources)))
                  (equal limit (fn-prl-nth 2 (fn-prp-alloc-installation fn-page-read-pool)))
                  (fn-prs-fundedp budget owned rescue '(0 0 0 0 0))))
     (mv :recovery-prs-source-unavailable fn-page-read-pool)
     (let* ((intent (list :recovery-prs-installing resources baseline))
            (fn-page-read-pool (update-fn-prp-mode intent fn-page-read-pool))
            (ledger (list budget '(0 0 0 0 0) 0 nil owned))
            (data (list ledger (fn-prl-nth 0 aux) (fn-prl-nth 1 aux)
                        (fn-prl-nth 2 aux) limit 0))
            (fn-page-read-pool (update-fn-prp-data data fn-page-read-pool))
            (fn-page-read-pool (update-fn-prp-mode :served fn-page-read-pool)))
      (mv :recovery-prs-installed fn-page-read-pool)))))))

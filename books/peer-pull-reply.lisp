; A status line and a verified kind-28 reply must describe the same outcome.
; One frame is outstanding on an authenticated pull. No unsolicited suffix
; is accepted as the reply to a subsequent request.
(in-package "ACL2")
(include-book "peer-pull-stage")
(include-book "xfnc-request")
(include-book "xfnc-ops")

(defun fn2-peer-pull-reply-count (start pos slot gen kind id generation fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (b* (((mv code next status) (fn2-peer-pull-line start pos slot gen kind id generation fn2-pool))
      ((unless (eq code :ok)) (mv code next 0 0))
      (first (+ 4 (nfix start)))
      ((unless (and (member-equal status '(290 490 491)) (< (+ first 2) next))) (mv :frame 0 0 0))
      ((mv digits & length &) (fn2-gram-arg-digits first (- next 2 first) slot gen kind id generation fn2-pool)))
   (if (and digits (unsigned-byte-p 32 length) (< *fn2-fnct-overhead* length)
            (<= length (fn2-fnct-cap slot fn2-pool)) (<= length (+ *fn2-pool-block-bytes* *fn2-fnct-trailer-octets*)))
       (mv :ok next status length)
     (mv :frame 0 0 0))))
(defthm fn2-peer-pull-reply-count-widths
 (let ((a (fn2-peer-pull-reply-count start pos slot gen kind id generation fn2-pool)))
   (and (unsigned-byte-p 32 (mv-nth 1 a)) (unsigned-byte-p 16 (mv-nth 2 a)) (unsigned-byte-p 32 (mv-nth 3 a)))))
(in-theory (disable fn2-peer-pull-reply-count))

; Prefix/length, hashing, and trailer verification are separate actor turns.
; Only the last turn calls the generated kind-28 layout decoder.
(fn2-csnapshot-op fn2-peer-pull-open-reply (id generation) 3
 (b* (((mv fc row) (fn2-peer-pull-fc-row id fn2-core))
      ((unless (and (eq fc :ok) (equal generation (fn2-machine-generation id fn2-core))
                    (equal 1 (fn2-peer-pull-row-protected id fn2-core))))
       (mv :access 0 0 fn2-core))
      (base (* 128 (nfix row))) (slot (fn2-peer-pull-row-rx-slot id fn2-core))
      (gen (fn2-peer-pull-row-rx-gen id fn2-core)) (len (fn2-peer-pull-row-frame-len id fn2-core))
      (phase (fn2-peer-pull-row-phase id fn2-core)) (status (fn2-peer-pull-row-reply-status id fn2-core))
      (kind *fn2-peer-pull-kind*))
   (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-b3 (fn2-core-b3 fn2-core))
               (fn2-digests (fn2-core-digests fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
     (code off end fn2-fields fn2-digests fn2-b3)
     (b* (((unless (and (natp len) (< *fn2-fnct-overhead* len) (equal len (fn2-pool-fill-value slot fn2-pool))
                       (<= len (+ *fn2-pool-block-bytes* *fn2-fnct-trailer-octets*))
                       (<= (+ base 128) (fn2-fields-rows fn2-fields))
                       (eq (fn2-pool-workspace-code slot gen kind id generation fn2-pool) :ok)))
            (mv :frame 0 0 fn2-fields fn2-digests fn2-b3))
          (tail (- len *fn2-fnct-trailer-octets*))
          ((when (equal phase *fn2-peer-pull-state-frame-header*))
           (mv-let (code tag & fn2-fields) (fn2-fnct-open-pool-header base slot gen 0 len kind id generation fn2-fields fn2-pool)
             (mv (if (and (eq code :ok) (equal tag *fn2-fnct-port-reply-kind*)) :ok :frame) 0 0 fn2-fields fn2-digests fn2-b3)))
          ((when (equal phase *fn2-peer-pull-state-frame-hash*))
           (mv-let (code fn2-digests fn2-b3) (fn2-pool-block-hash row slot gen 0 tail kind id generation fn2-digests fn2-b3 fn2-pool)
             (mv code 0 0 fn2-fields fn2-digests fn2-b3)))
          ((when (equal phase *fn2-peer-pull-state-frame-trailer*))
           (mv (fn2-fnct-open-pool-trailer row slot gen tail kind id generation fn2-digests fn2-pool)
               0 0 fn2-fields fn2-digests fn2-b3))
          ((unless (equal phase *fn2-peer-pull-state-frame-result*)) (mv :state 0 0 fn2-fields fn2-digests fn2-b3))
          ((mv code next fn2-fields)
           (fn2-fnct-k28-reply-decode base slot gen *fn2-fnct-header-octets* tail kind id generation fn2-fields fn2-pool))
          ((unless (and (eq code :ok) (equal next tail))) (mv :frame 0 0 fn2-fields fn2-digests fn2-b3))
          (class (fn2-fields-value (+ base *fn2-fnct-k28-reply-field-class*) fn2-fields))
          (rl (fn2-fields-ref-len (+ base *fn2-fnct-k28-reply-field-reason*) fn2-fields))
          (i (+ base *fn2-fnct-k28-reply-field-result*))
          (off (fn2-fields-ref-off i fn2-fields)) (n (fn2-fields-ref-len i fn2-fields)))
       (cond ((and (equal status 290) (equal class 0) (equal rl 0) (posp n) (unsigned-byte-p 32 off)
                   (unsigned-byte-p 32 (+ off n)) (equal (+ off n) tail))
              (mv :ok off (+ off n) fn2-fields fn2-digests fn2-b3))
             ((and (equal status 490) (equal class 1) (posp rl) (equal n 0))
              (mv :refused 0 0 fn2-fields fn2-digests fn2-b3))
             ((and (equal status 491) (equal class 2) (equal n 0))
              (mv :uncertain 0 0 fn2-fields fn2-digests fn2-b3))
             (t (mv :frame 0 0 fn2-fields fn2-digests fn2-b3))))
     (mv code off end fn2-core))))
(defthm fn2-peer-pull-open-reply-widths
 (let ((a (fn2-peer-pull-open-reply id generation fn2-core)))
   (and (unsigned-byte-p 32 (mv-nth 1 a)) (unsigned-byte-p 32 (mv-nth 2 a)))))
(in-theory (disable fn2-peer-pull-open-reply))
(defcost fn2-peer-pull-open-reply :answers t :bytes 4096 :tables (fn2-core-fields fn2-core-digests fn2-core-b3)
 :doc "Check the single pending response's exact envelope, checksum, class and result span.")

(fn2-csnapshot-op fn2-peer-pull-accept-registration (id generation off end) 1
 (b* (((mv fc row) (fn2-peer-pull-fc-row id fn2-core))
      ((unless (and (eq fc :ok) (equal generation (fn2-machine-generation id fn2-core))
                    (equal (fn2-peer-pull-row-phase id fn2-core) *fn2-peer-pull-state-frame-result*)
                    (equal 1 (fn2-peer-pull-row-protected id fn2-core)) (natp off) (natp end) (< off end)
                    (<= (- end off) 366))) (mv :frame fn2-core))
      (kind *fn2-peer-pull-kind*) (base (* 128 (nfix row))) (slot (fn2-peer-pull-row-rx-slot id fn2-core))
      (gen (fn2-peer-pull-row-rx-gen id fn2-core)) (history (fn2-peer-pull-row-remote-history id fn2-core))
      (incarnation (fn2-peer-pull-row-remote-incarnation id fn2-core))
      (expected (fn2-peer-pull-row-consumer id fn2-core)) (scope (fn2-peer-pull-row-remote-view id fn2-core))
      (dest (fn2-peer-pull-row-secret-slot id fn2-core)) (dg (fn2-peer-pull-row-secret-gen id fn2-core))
      (at (fn2-peer-pull-row-stream-len id fn2-core)) (n (- end off))
      ((mv code pid stream ep ver position fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
         (rc pid stream ep ver position fn2-fields fn2-pool)
         (b* (((unless (and (<= (+ base 128) (fn2-fields-rows fn2-fields))
                           (natp at) (equal at (fn2-pool-fill-value dest fn2-pool))))
               (mv :state 0 0 0 0 0 fn2-fields fn2-pool))
              ((mv rc pid stream consumer ep ver view position fn2-fields)
               (fn2-xfnc-unpack-cursor base off end nil history incarnation slot gen kind id generation fn2-fields fn2-pool))
              ((unless (and (eq rc :ok) (posp pid) (unsigned-byte-p 60 pid) (posp stream) (unsigned-byte-p 60 stream)
                            (equal consumer expected) (equal view scope) (posp ep) (unsigned-byte-p 32 ep)
                            (equal ver 1) (unsigned-byte-p 60 position)))
               (mv :scope 0 0 0 0 0 fn2-fields fn2-pool))
              ((mv rc fn2-pool) (fn2-rd-copy n slot gen off kind id generation dest dg at kind id generation fn2-pool)))
           (mv rc pid stream ep ver position fn2-fields fn2-pool))
         (mv rc pid stream ep ver position fn2-core))))
   (if (and (eq code :ok) (unsigned-byte-p 60 pid) (unsigned-byte-p 60 stream) (unsigned-byte-p 32 ep)
            (unsigned-byte-p 60 ver) (unsigned-byte-p 60 position) (unsigned-byte-p 32 at) (unsigned-byte-p 32 n))
       (mv :ok (fn2-peer-pull-put-core id (source-principal pid) (source-stream stream) (source-epoch ep)
                                      (source-version ver) (source-position position) (cursor-off at) (cursor-len n)))
     (mv (if (eq code :ok) :state code) fn2-core))))
(in-theory (disable fn2-peer-pull-accept-registration))
(defcost fn2-peer-pull-accept-registration :answers t :bytes 2048 :tables (fn2-core-fields fn2-core-pool fn2-peer-pull-table)
 :doc "Bind the received fncu's exact identity and retain its bytes in the original peer actor's range.")

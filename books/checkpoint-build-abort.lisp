; Abort only actual unissued construction whose bounded ledger cancellation
; has finished under the retained phase3 gate. No caller empty/reset flag.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-build")
(include-book "checkpoint-planning-cancel")
(include-book "checkpoint-publication")
(fn2-book-layer :c)

(defun fn2-checkpoint-build-abort-roots-p (role c token fn2-checkpoint-refs fn2-extents fn2-ops fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-checkpoint-refs fn2-extents fn2-ops fn2-alloc-edges) :measure (nfix (- 6 (nfix role)))
  :guard (and (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-extents-wfp fn2-extents)
              (fn2-ops-wfp fn2-ops) (fn2-alloc-edges-wfp fn2-alloc-edges) (natp role) (<= role 6) (natp c))))
 (if (or (not (natp role)) (>= role 6)) t
  (let ((r (+ (* 6 c) role)) (edge (fn2-checkpoint-edge c role fn2-extents fn2-ops)))
   (and (< r (fn2-checkpoint-refs-rows fn2-checkpoint-refs))
        (equal (fn2-checkpoint-refs-retained r fn2-checkpoint-refs) 0)
        (equal (fn2-checkpoint-refs-root-source-complete r fn2-checkpoint-refs) 0)
        (equal (fn2-checkpoint-refs-root-completed-bytes r fn2-checkpoint-refs) 0)
        (or (equal (fn2-checkpoint-refs-root-build-token r fn2-checkpoint-refs) 0)
            (equal (fn2-checkpoint-refs-root-build-token r fn2-checkpoint-refs) token))
        (fn2-alloc-edge-slotp edge fn2-alloc-edges)
        (equal (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-free*)
        (fn2-checkpoint-build-abort-roots-p (+ 1 role) c token fn2-checkpoint-refs fn2-extents fn2-ops fn2-alloc-edges)))))

(defun fn2-checkpoint-build-abort-ownerp (token kind owner gen fn2-checkpoint-build fn2-checkpoint-planning fn2-csnapshot fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-extents fn2-ops fn2-alloc-edges fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-build fn2-checkpoint-planning fn2-csnapshot fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-extents fn2-ops fn2-alloc-edges fn2-checkpoint-publication)
  :guard (and (fn2-checkpoint-build-wfp fn2-checkpoint-build) (fn2-checkpoint-planning-wfp fn2-checkpoint-planning)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-checkpoint-construction-wfp fn2-checkpoint-construction)
              (fn2-checkpoint-page-wfp fn2-checkpoint-page) (fn2-extents-wfp fn2-extents) (fn2-ops-wfp fn2-ops)
              (fn2-alloc-edges-wfp fn2-alloc-edges) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (and (fn2-checkpoint-build-ownerp token kind owner gen fn2-checkpoint-build fn2-csnapshot)
      (< 0 (fn2-checkpoint-planning-rows fn2-checkpoint-planning))
      (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication))
      (member (fn2-checkpoint-build-phase 0 fn2-checkpoint-build)
       (list *fn2-checkpoint-build-phase-await-roots* *fn2-checkpoint-build-phase-cancelling* *fn2-checkpoint-build-phase-cancelled*))
      (equal (fn2-checkpoint-build-completed-bytes 0 fn2-checkpoint-build) 0)
      (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-cancel-empty*)
      (equal (fn2-checkpoint-construction-rows fn2-checkpoint-construction) (fn2-extents-rows fn2-extents))
      (<= (fn2-checkpoint-construction-rows fn2-checkpoint-construction) (fn2-checkpoint-planning-abort-row 0 fn2-checkpoint-planning))
      (unsigned-byte-p 32 (+ (fn2-extents-rows fn2-extents) 6 192))
      (or (equal (fn2-checkpoint-page-rows fn2-checkpoint-page) 0)
          (not (equal token (fn2-checkpoint-page-token 0 fn2-checkpoint-page)))
          (and (equal (fn2-checkpoint-page-phase 0 fn2-checkpoint-page) *fn2-checkpoint-page-phase-idle*)
               (equal (fn2-checkpoint-page-pending 0 fn2-checkpoint-page) 0)
               (equal (fn2-checkpoint-page-transferred 0 fn2-checkpoint-page) 0)))
      (let ((c (fn2-checkpoint-build-candidate 0 fn2-checkpoint-build)))
       (and (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
            (fn2-checkpoint-builder-ownerp c token kind owner gen fn2-checkpoints)
            (equal (fn2-checkpoints-checkpoint c fn2-checkpoints) (fn2-checkpoint-build-checkpoint 0 fn2-checkpoint-build))
            (equal (fn2-checkpoints-cut-commit c fn2-checkpoints) (fn2-checkpoint-build-cut-commit 0 fn2-checkpoint-build))
            (equal (fn2-checkpoints-cut-event c fn2-checkpoints) (fn2-checkpoint-build-cut-event 0 fn2-checkpoint-build))
            (equal (fn2-checkpoints-history c fn2-checkpoints) (fn2-checkpoint-build-history 0 fn2-checkpoint-build))
            (equal (fn2-checkpoints-incarnation c fn2-checkpoints) (fn2-checkpoint-build-history-incarnation 0 fn2-checkpoint-build))
            (equal (fn2-checkpoints-installation-commit c fn2-checkpoints) 0)
            (equal (fn2-checkpoints-anchor-mask c fn2-checkpoints) 0)
            (fn2-checkpoint-planning-cancel-ownerp c token kind owner gen fn2-checkpoint-planning fn2-extents)
            (or (equal (fn2-checkpoint-publication-bank0-valid 0 fn2-checkpoint-publication) 0)
                (not (equal c (fn2-checkpoint-publication-bank0-candidate 0 fn2-checkpoint-publication))))
            (or (equal (fn2-checkpoint-publication-bank1-valid 0 fn2-checkpoint-publication) 0)
                (not (equal c (fn2-checkpoint-publication-bank1-candidate 0 fn2-checkpoint-publication))))
            (or (equal (fn2-checkpoint-publication-debt-valid 0 fn2-checkpoint-publication) 0)
                (not (equal c (fn2-checkpoint-publication-debt-candidate 0 fn2-checkpoint-publication))))
            (fn2-checkpoint-build-abort-roots-p 0 c token fn2-checkpoint-refs fn2-extents fn2-ops fn2-alloc-edges)))))

(defun fn2-checkpoint-build-abort-step (budget token kind owner gen fn2-checkpoint-build fn2-checkpoint-planning fn2-csnapshot fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-extents fn2-ops fn2-alloc-edges fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-build fn2-checkpoint-planning fn2-csnapshot fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-extents fn2-ops fn2-alloc-edges fn2-checkpoint-publication)
  :guard (and (fn2-checkpoint-build-wfp fn2-checkpoint-build) (fn2-checkpoint-planning-wfp fn2-checkpoint-planning)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-checkpoint-construction-wfp fn2-checkpoint-construction)
              (fn2-checkpoint-page-wfp fn2-checkpoint-page) (fn2-extents-wfp fn2-extents) (fn2-ops-wfp fn2-ops)
              (fn2-alloc-edges-wfp fn2-alloc-edges) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (b* (((unless (and (natp budget) (< 0 budget)))
       (mv :yield fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges))
      ((unless (fn2-checkpoint-build-abort-ownerp token kind owner gen fn2-checkpoint-build fn2-checkpoint-planning fn2-csnapshot fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-extents fn2-ops fn2-alloc-edges fn2-checkpoint-publication))
       (mv :recovery-required fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges))
      (phase (fn2-checkpoint-build-phase 0 fn2-checkpoint-build))
      ((when (equal phase *fn2-checkpoint-build-phase-await-roots*))
       (let ((fn2-checkpoint-build (fn2-checkpoint-build-put 0 (phase *fn2-checkpoint-build-phase-cancelling*) (abort-row 0))))
        (mv :more fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges)))
      ((when (equal phase *fn2-checkpoint-build-phase-cancelled*))
       (mv :clean fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges))
      (c (fn2-checkpoint-build-candidate 0 fn2-checkpoint-build))
      (i (fn2-checkpoint-build-abort-row 0 fn2-checkpoint-build))
      (n (fn2-extents-rows fn2-extents))
      ((when (< i n))
       (b* ((edge (fn2-checkpoint-source-edge c i fn2-extents fn2-ops fn2-checkpoints))
            ((unless (fn2-alloc-edge-slotp edge fn2-alloc-edges))
             (mv :recovery-required fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges))
            (free (equal (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-free*))
            ((unless (or free
                         (and (equal (fn2-alloc-edges-extent edge fn2-alloc-edges) i)
                              (fn2-alloc-edge-matchesp edge (fn2-checkpoints-checkpoint c fn2-checkpoints) i
                               (fn2-alloc-edges-epoch edge fn2-alloc-edges) (fn2-alloc-edges-counter edge fn2-alloc-edges)
                               :prepared-successor fn2-alloc-edges))))
             (mv :recovery-required fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges))
            ((mv code fn2-extents fn2-alloc-edges)
             (if free (mv :ok fn2-extents fn2-alloc-edges)
              (fn2-alloc-edge-drop edge (fn2-checkpoints-checkpoint c fn2-checkpoints) i
               (fn2-alloc-edges-epoch edge fn2-alloc-edges) (fn2-alloc-edges-counter edge fn2-alloc-edges)
               :prepared-successor fn2-extents fn2-alloc-edges)))
            ((unless (eq code :ok))
             (mv :recovery-required fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges))
            (fn2-checkpoint-build (fn2-checkpoint-build-set-abort-row 0 (+ 1 i) fn2-checkpoint-build)))
        (mv :more fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges)))
      ((when (< i (+ n 6)))
       (let* ((r (+ (* 6 c) (- i n)))
              (fn2-checkpoint-refs (fn2-checkpoint-refs-put r
                (storage-domain 0) (physical-unit 0) (writer-epoch 0) (allocation 0) (page-kind 0) (encoded-length 0)
                (edge 0) (retained 0) (root-build-token 0) (root-source-complete 0) (root-intended-bytes 0) (root-completed-bytes 0)))
              (fn2-checkpoint-build (fn2-checkpoint-build-set-abort-row 0 (+ 1 i) fn2-checkpoint-build)))
        (mv :more fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges)))
      ((when (< i (+ n 6 192)))
       (let* ((fn2-checkpoint-bytes (fn2-checkpoint-bytes-set-value (+ (* 192 c) (- i n 6)) 0 fn2-checkpoint-bytes))
              (fn2-checkpoint-build (fn2-checkpoint-build-set-abort-row 0 (+ 1 i) fn2-checkpoint-build)))
        (mv :more fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges)))
      ((unless (equal i (+ n 6 192)))
       (mv :recovery-required fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges))
      (fn2-checkpoint-build (fn2-checkpoint-build-set-phase 0 *fn2-checkpoint-build-phase-cancelled* fn2-checkpoint-build)))
  (mv :clean fn2-checkpoint-build fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges)))

(fn2-checkpoint-build-preserves fn2-checkpoint-build-abort-step
 (budget token kind owner gen fn2-checkpoint-build fn2-checkpoint-planning fn2-csnapshot fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-extents fn2-ops fn2-alloc-edges fn2-checkpoint-publication)
 :hyps ((fn2-checkpoint-buildp fn2-checkpoint-build) (fn2-checkpoint-build-wfp fn2-checkpoint-build)
        (fn2-checkpoint-refsp fn2-checkpoint-refs) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
        (fn2-checkpoint-bytesp fn2-checkpoint-bytes) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
        (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents)
        (fn2-alloc-edgesp fn2-alloc-edges) (fn2-alloc-edges-wfp fn2-alloc-edges))
 :specs (("-BUILD-TYPE" fn2-checkpoint-buildp 1) ("-BUILD-WFP" fn2-checkpoint-build-wfp 1)
         ("-BUILD-ROWS" fn2-checkpoint-build-rows 1 :frame fn2-checkpoint-build)
         ("-REFS-TYPE" fn2-checkpoint-refsp 2) ("-REFS-WFP" fn2-checkpoint-refs-wfp 2)
         ("-REFS-ROWS" fn2-checkpoint-refs-rows 2 :frame fn2-checkpoint-refs)
         ("-BYTES-TYPE" fn2-checkpoint-bytesp 3) ("-BYTES-WFP" fn2-checkpoint-bytes-wfp 3)
         ("-BYTES-ROWS" fn2-checkpoint-bytes-rows 3 :frame fn2-checkpoint-bytes)
         ("-EXTENTS-TYPE" fn2-extentsp 4) ("-EXTENTS-WFP" fn2-extents-wfp 4)
         ("-EXTENTS-ROWS" fn2-extents-rows 4 :frame fn2-extents)
         ("-EDGES-TYPE" fn2-alloc-edgesp 5) ("-EDGES-WFP" fn2-alloc-edges-wfp 5)
         ("-EDGES-ROWS" fn2-alloc-edges-rows 5 :frame fn2-alloc-edges)))
(defcost fn2-checkpoint-build-abort-step-op :child fn2-checkpoint-build-abort-step :answers t :bytes 1
 :tables (fn2-core-checkpoint-build fn2-core-checkpoint-planning fn2-core-csnapshot fn2-core-checkpoints
          fn2-core-checkpoint-refs fn2-core-checkpoint-bytes fn2-core-checkpoint-construction fn2-core-checkpoint-page
          fn2-core-extents fn2-core-ops fn2-core-alloc-edges fn2-core-checkpoint-publication)
 :doc "After actual ledger cancellation, remove one exact unpublished source edge/ref/hash byte while phase3 and candidate ownership remain closed.")

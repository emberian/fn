; Physical coordinates accompany the existing decoder's records. Validation
; is fn-lc-scan-bytes itself, one frame at a time, never a second grammar.
(in-package "ACL2")
(include-book "log-checkpoint-open-guards")

(defun fn-lc-position-records (records segment offset length)
 (declare (xargs :guard t))
 (if (consp records)
  (cons (list (car records) segment offset length)
        (fn-lc-position-records (cdr records) segment offset length)) nil))
(defun fn-lc-position-tail-bytes (bytes segment offset prev unit max fuel)
 (declare (xargs :guard t :measure (nfix fuel) :verify-guards nil))
 (if (or (atom bytes) (zp (nfix fuel))) (list :ok nil prev)
  (let* ((one (fn-lc-scan-bytes bytes prev unit max 1))
         (n (nfix (fn-lc-head (fn-lc-at 2 one))))
         (step (+ n (ec-call (fn-lg-pad-len n unit)))))
   (if (not (equal (fn-lc-head one) :ok)) (list (fn-lc-head one) nil prev)
    (let ((rest (fn-lc-position-tail-bytes (fn-lc-drop step bytes) segment
                   (+ (nfix offset) step) (fn-lc-at 3 one) unit max (1- (nfix fuel)))))
     (list (fn-lc-head rest)
      (fn-lc-join (fn-lc-position-records (fn-lc-at 1 one) segment (nfix offset) n)
                  (fn-lc-at 1 rest)) (fn-lc-at 2 rest)))))))
(defun fn-lc-position-tail-segments (segments segment offset prev unit max)
 (declare (xargs :guard t :measure (len segments) :verify-guards nil))
 (if (atom segments) (list :ok nil prev)
  (let* ((id (fn-lc-head (car segments)))
         (base (if (equal id segment) (nfix offset) 0))
         (bytes (fn-lc-drop base (fn-lc-at 1 (car segments)))))
   (if (< (nfix id) (nfix segment))
    (fn-lc-position-tail-segments (cdr segments) segment offset prev unit max)
    (let ((one (fn-lc-position-tail-bytes bytes id base prev unit max (len bytes))))
     (if (not (equal (fn-lc-head one) :ok)) one
      (let ((rest (fn-lc-position-tail-segments (cdr segments) segment 0
                                 (fn-lc-at 2 one) unit max)))
       (list (fn-lc-head rest) (fn-lc-join (fn-lc-at 1 one) (fn-lc-at 1 rest))
             (fn-lc-at 2 rest)))))))))
(defun fn-lc-positioned-tail (segs header)
 (declare (xargs :guard t :verify-guards nil))
 (let ((s (fn-lc-header-S header)))
  (fn-lc-at 1 (fn-lc-position-tail-segments (fn-lc-ordered-segments segs)
    (fn-lc-at 0 s) (fn-lc-at 1 s) (fn-lc-at 4 s)
    (fn-lc-tail-unit header) (fn-lc-tail-max header)))))
(defun fn-lc-acceptance-tail (tail)
 (declare (xargs :guard t))
 (if (consp tail)
  (if (equal (fn-lc-head (car tail)) :move)
      (fn-lc-acceptance-tail (cdr tail))
    (cons (car tail) (fn-lc-acceptance-tail (cdr tail)))) nil))

(verify-guards fn-lc-position-tail-bytes)
(verify-guards fn-lc-position-tail-segments)
(verify-guards fn-lc-positioned-tail)

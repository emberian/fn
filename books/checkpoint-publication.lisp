; Actual Write/Write/Fence publication protocol, below the core boundary.
; Completion consumes exact issued operation identities through defcorechild's
; harvest extension. No caller-provided durability flag is accepted.
(in-package "ACL2")
(include-book "checkpoint")
(include-book "checkpoint-geometry")
(include-book "arm-children")
(fn2-book-layer :b)
(defcolumns fn2-checkpoint-publication
 ((phase (:enum fn2-checkpoint-publication-phase
    (:idle :prepare :write-first :wait-first :write-second :wait-second :fence :wait-fence :complete :uncertain)))
  (candidate :u32) (bank :bool) (packet-mask :u8)
  (layout-ready :bool) (image-size :u60) (extents :u32) (groups :u32)
  (has-base :bool) (active-bank :bool)
  (owner-kind :u8) (owner-slot :u32) (owner-gen :u60)
  (slot0 :u32) (gen0 :u60) (slot1 :u32) (gen1 :u60)
  (len0 :u32) (len1 :u32) (stage0 :u8) (stage1 :u8)
  (checker-live :bool) (checker-row :u32) (checker-base :u32) (checker-packet :bool)
  (offset0 :u60) (offset1 :u60) (op-slot :u32) (op-gen :u60)))

; Begin only reserves publication state. Packet verification must still fill
; both mask bits. The geometry decision has no legacy two-slot fallback.
(defun fn2-checkpoint-publication-begin (c size extents groups owner-kind owner-slot owner-gen
                                       slot0 gen0 slot1 gen1 batch-hash previous-hash geometry-hash
                                       fn2-checkpoints fn2-checkpoint-publication fn2-checkpoint-bytes fn2-digests)
 (declare (xargs :stobjs (fn2-checkpoints fn2-checkpoint-publication fn2-checkpoint-bytes fn2-digests)
  :guard (and (fn2-checkpoints-wfp fn2-checkpoints)
              (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-digests-wfp fn2-digests))))
 (b* (((unless (and (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication))
                     (equal (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication)
                            *fn2-checkpoint-publication-phase-idle*)
                     (natp c) (< c (fn2-checkpoints-rows fn2-checkpoints))
                     (equal (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-installed*)
                     (equal (fn2-checkpoint-publication-layout-ready 0 fn2-checkpoint-publication) 1)
                     (equal size (fn2-checkpoint-publication-image-size 0 fn2-checkpoint-publication))
                     (equal extents (fn2-checkpoint-publication-extents 0 fn2-checkpoint-publication))
                     (equal groups (fn2-checkpoint-publication-groups 0 fn2-checkpoint-publication))
                     (unsigned-byte-p 8 owner-kind)
                     (unsigned-byte-p 32 owner-slot) (unsigned-byte-p 60 owner-gen)
                     (unsigned-byte-p 32 slot0) (unsigned-byte-p 60 gen0)
                     (unsigned-byte-p 32 slot1) (unsigned-byte-p 60 gen1)
                     (not (equal slot0 slot1))
                     (fn2-digest-rowp batch-hash fn2-digests)
                     (fn2-digest-rowp previous-hash fn2-digests)
                     (fn2-digest-rowp geometry-hash fn2-digests)
                     (<= (+ (* 192 (fn2-checkpoints-rows fn2-checkpoints)) 96)
                         (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes))))
       (mv :state fn2-checkpoint-publication fn2-checkpoint-bytes))
      (bank (if (equal (fn2-checkpoint-publication-has-base 0 fn2-checkpoint-publication) 1)
                 (- 1 (fn2-checkpoint-publication-active-bank 0 fn2-checkpoint-publication)) 0))
      ((mv code offset0) (fn2-checkpoint-anchor-offset (* 2 bank) size extents groups))
      ((mv other offset1) (fn2-checkpoint-anchor-offset (+ 1 (* 2 bank)) size extents groups))
      ((unless (and (eq code :ok) (eq other :ok))) (mv :geometry fn2-checkpoint-publication fn2-checkpoint-bytes))
      (evidence (* 192 (fn2-checkpoints-rows fn2-checkpoints)))
      (fn2-checkpoint-bytes (fn2-checkpoint-copy-expected 0 evidence batch-hash fn2-digests fn2-checkpoint-bytes))
      (fn2-checkpoint-bytes (fn2-checkpoint-copy-expected 0 (+ evidence 32) previous-hash fn2-digests fn2-checkpoint-bytes))
      (fn2-checkpoint-bytes (fn2-checkpoint-copy-expected 0 (+ evidence 64) geometry-hash fn2-digests fn2-checkpoint-bytes))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-put 0
        (phase *fn2-checkpoint-publication-phase-prepare*) (candidate c) (bank bank) (packet-mask 0)
        (owner-kind owner-kind) (owner-slot owner-slot) (owner-gen owner-gen)
        (slot0 slot0) (gen0 gen0) (slot1 slot1) (gen1 gen1)
        (offset0 offset0) (offset1 offset1))))
  (mv :ok fn2-checkpoint-publication fn2-checkpoint-bytes)))

; There is exactly one active publisher and at most one outstanding operation.
; The concrete table holds its issued slot AND generation across every yield.
; No root changes or cut advancement occur during these operations.
(defun fn2-checkpoint-publication-step (fn2-checkpoint-publication fn2-pool fn2-ops fn2-control)
 (declare (xargs :stobjs (fn2-checkpoint-publication fn2-pool fn2-ops fn2-control)
  :guard (and (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
              (fn2-pool-wfp fn2-pool) (fn2-ops-wfp fn2-ops) (fn2-control-wfp fn2-control))))
 (b* (((unless (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication)))
       (mv :bounds fn2-checkpoint-publication fn2-pool fn2-ops fn2-control))
      ((when (equal (fn2-control-stop fn2-control) 1))
       (let ((fn2-checkpoint-publication (fn2-checkpoint-publication-set-phase 0
                *fn2-checkpoint-publication-phase-uncertain* fn2-checkpoint-publication)))
        (mv :uncertain fn2-checkpoint-publication fn2-pool fn2-ops fn2-control)))
      (phase (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication))
      (first (equal phase *fn2-checkpoint-publication-phase-write-first*))
      (second (equal phase *fn2-checkpoint-publication-phase-write-second*))
      (fence (equal phase *fn2-checkpoint-publication-phase-fence*))
      ((unless (or first second fence))
       (mv (cond ((equal phase *fn2-checkpoint-publication-phase-complete*) :complete)
                 ((equal phase *fn2-checkpoint-publication-phase-uncertain*) :uncertain) (t :more))
           fn2-checkpoint-publication fn2-pool fn2-ops fn2-control))
      ((unless (equal (fn2-checkpoint-publication-packet-mask 0 fn2-checkpoint-publication) 3))
       (mv :packet fn2-checkpoint-publication fn2-pool fn2-ops fn2-control))
      (kind (fn2-checkpoint-publication-owner-kind 0 fn2-checkpoint-publication))
      (owner (fn2-checkpoint-publication-owner-slot 0 fn2-checkpoint-publication))
      (generation (fn2-checkpoint-publication-owner-gen 0 fn2-checkpoint-publication))
      ((mv code opslot opgen fn2-pool fn2-ops fn2-control)
       (if fence
        (fn2-issue-fence-children kind owner generation 0 fn2-pool fn2-ops fn2-control)
        (fn2-issue-write-children
          (if first (fn2-checkpoint-publication-offset0 0 fn2-checkpoint-publication)
                    (fn2-checkpoint-publication-offset1 0 fn2-checkpoint-publication))
          (if first (fn2-checkpoint-publication-slot0 0 fn2-checkpoint-publication)
                    (fn2-checkpoint-publication-slot1 0 fn2-checkpoint-publication))
          (if first (fn2-checkpoint-publication-gen0 0 fn2-checkpoint-publication)
                    (fn2-checkpoint-publication-gen1 0 fn2-checkpoint-publication))
          0 4096 0 kind owner generation 0 fn2-pool fn2-ops fn2-control)))
      ((unless (eq code :ok))
       (let ((fn2-checkpoint-publication
              (if (equal (fn2-control-stop fn2-control) 1)
               (fn2-checkpoint-publication-put 0 (op-slot opslot) (op-gen opgen)
                (phase *fn2-checkpoint-publication-phase-uncertain*)) fn2-checkpoint-publication)))
        (mv code fn2-checkpoint-publication fn2-pool fn2-ops fn2-control)))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-put 0
        (op-slot opslot) (op-gen opgen)
        (phase (cond (first *fn2-checkpoint-publication-phase-wait-first*)
                     (second *fn2-checkpoint-publication-phase-wait-second*)
                     (t *fn2-checkpoint-publication-phase-wait-fence*))))))
  (mv :issued fn2-checkpoint-publication fn2-pool fn2-ops fn2-control)))

; Invoked only after validated physical harvest and pool settlement, before
; operation recycle. Late/unrelated generations cannot advance publication.
(defun fn2-checkpoint-publication-harvest (opslot opgen cell evkind outcome reason count aux0 aux1
                                         fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication
  :guard (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))
          (ignore reason aux0 aux1))
 (b* (((unless (and (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication))
                     (equal cell 0)
                     (equal opslot (fn2-checkpoint-publication-op-slot 0 fn2-checkpoint-publication))
                     (equal opgen (fn2-checkpoint-publication-op-gen 0 fn2-checkpoint-publication))))
       (mv :ok fn2-checkpoint-publication))
      (phase (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication))
      (first (equal phase *fn2-checkpoint-publication-phase-wait-first*))
      (second (equal phase *fn2-checkpoint-publication-phase-wait-second*))
      (fence (equal phase *fn2-checkpoint-publication-phase-wait-fence*))
      ((unless (and (or first second fence)
                     (equal evkind (if fence *fn2-event-fence-result* *fn2-event-write-result*))))
       (mv :ok fn2-checkpoint-publication))
      (success (and (equal outcome *fn2-outcome-done*) (equal count (if fence 0 4096))))
      (fn2-checkpoint-publication (if (and fence success)
        (fn2-checkpoint-publication-put 0 (has-base 1)
         (active-bank (fn2-checkpoint-publication-bank 0 fn2-checkpoint-publication)))
        fn2-checkpoint-publication))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-set-phase 0
       (cond ((not success) *fn2-checkpoint-publication-phase-uncertain*)
             (first *fn2-checkpoint-publication-phase-write-second*)
             (second *fn2-checkpoint-publication-phase-fence*)
             (t *fn2-checkpoint-publication-phase-complete*)) fn2-checkpoint-publication)))
  (mv :ok fn2-checkpoint-publication)))

; A packet can become writable only in the same successful transition as the
; real anchor hash checker. The required checkpoint batch/previous/geometry
; digests were copied from the installer's evidence at BEGIN. Caller ownership
; must keep both packet leases immutable until the covering fence settles.
(defun fn2-checkpoint-publication-check-packet (which row base encoded-length budget
                                              fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                                              fn2-checkpoint-publication fn2-fc fn2-fc-context fn2-b3
                                              fn2-fields fn2-pool fn2-digests)
 (declare (xargs :stobjs (fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                          fn2-checkpoint-publication fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
  :guard (and (let ((off 0) (len encoded-length)) (fn2-fc-guard)) (fn2-checkpoints-wfp fn2-checkpoints)
              (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
              (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (b* (((unless (and (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication))
                     (natp which) (< which 2) (posp encoded-length)
                     (<= encoded-length *fn2-format-anchor-max-size*)
                     (equal encoded-length (if (equal which 0)
                        (fn2-checkpoint-publication-len0 0 fn2-checkpoint-publication)
                        (fn2-checkpoint-publication-len1 0 fn2-checkpoint-publication)))
                     (member-equal (if (equal which 0)
                        (fn2-checkpoint-publication-stage0 0 fn2-checkpoint-publication)
                        (fn2-checkpoint-publication-stage1 0 fn2-checkpoint-publication)) '(3 4))
                     (or (and (equal (fn2-checkpoint-publication-checker-live 0 fn2-checkpoint-publication) 0)
                              (equal (fn2-fc-phase row fn2-fc) *fn2-fc-phase-idle*))
                         (and (equal (fn2-checkpoint-publication-checker-live 0 fn2-checkpoint-publication) 1)
                              (equal base (fn2-checkpoint-publication-checker-base 0 fn2-checkpoint-publication))
                              (equal row (fn2-checkpoint-publication-checker-row 0 fn2-checkpoint-publication))
                              (equal which (fn2-checkpoint-publication-checker-packet 0 fn2-checkpoint-publication))))
                     (equal (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication)
                            *fn2-checkpoint-publication-phase-prepare*)))
       (mv :state fn2-checkpoint-publication fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests))
      (c (fn2-checkpoint-publication-candidate 0 fn2-checkpoint-publication))
      ((unless (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes))
       (mv :bounds fn2-checkpoint-publication fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests))
      (anchor (+ which (* 2 (fn2-checkpoint-publication-bank 0 fn2-checkpoint-publication))))
      (slot (if (equal which 0) (fn2-checkpoint-publication-slot0 0 fn2-checkpoint-publication)
                                (fn2-checkpoint-publication-slot1 0 fn2-checkpoint-publication)))
      (gen (if (equal which 0) (fn2-checkpoint-publication-gen0 0 fn2-checkpoint-publication)
                               (fn2-checkpoint-publication-gen1 0 fn2-checkpoint-publication)))
      (kind (fn2-checkpoint-publication-owner-kind 0 fn2-checkpoint-publication))
      (owner (fn2-checkpoint-publication-owner-slot 0 fn2-checkpoint-publication))
      (generation (fn2-checkpoint-publication-owner-gen 0 fn2-checkpoint-publication))
      (evidence (* 192 (fn2-checkpoints-rows fn2-checkpoints)))
      ((unless (and (<= (+ evidence 96) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes))
                     (equal (fn2-fc-context-location row fn2-fc-context) anchor)
                     (equal (fn2-fc-context-history row fn2-fc-context) (fn2-checkpoints-history c fn2-checkpoints))
                     (equal (fn2-fc-context-incarnation row fn2-fc-context) (fn2-checkpoints-incarnation c fn2-checkpoints))
                     (fn2-checkpoint-hash-matchesp 0 (+ evidence 64)
                       (fn2-fc-context-geometry row fn2-fc-context) fn2-digests fn2-checkpoint-bytes)))
       (mv :context fn2-checkpoint-publication fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-put 0
        (checker-live 1) (checker-row row) (checker-base base) (checker-packet which)))
      ((mv code fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
       (fn2-format-run :anchor nil row slot gen 0 encoded-length base kind owner generation budget
                       fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      (fn2-checkpoint-publication (if (equal which 0)
        (fn2-checkpoint-publication-set-stage0 0 (if (eq code :more) 4 3) fn2-checkpoint-publication)

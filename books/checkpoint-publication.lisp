        (equal (fn2-fields-value (+ f 2) fn2-fields) (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs))
        (equal (fn2-fields-value (+ f 3) fn2-fields) (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs))
        (equal (fn2-fields-value (+ f 4) fn2-fields) (fn2-checkpoint-refs-page-kind r fn2-checkpoint-refs))
        (equal (fn2-fields-value (+ f 5) fn2-fields) (fn2-checkpoint-refs-encoded-length r fn2-checkpoint-refs))
        (equal (fn2-fields-value (+ f 6) fn2-fields) 1)
        (equal (fn2-fields-value (+ base *fn2-format-anchor-field-checkpoint-batch*) fn2-fields) 1)
        (equal (fn2-fields-value (+ base *fn2-format-anchor-field-previous-checkpoint*) fn2-fields) 1)
        (equal (fn2-fields-value (+ base *fn2-format-anchor-field-geometry*) fn2-fields) 1)
        (equal (fn2-fields-value (+ base *fn2-format-anchor-field-anchor-hash*) fn2-fields) 1)
        (fn2-checkpoint-pool-hash-matchesp 32 (* 32 r) (fn2-fields-ref-off (+ f 6) fn2-fields)
                                         slot gen kind owner generation fn2-pool fn2-checkpoint-bytes)
        (fn2-checkpoint-pool-hash-matchesp 32 evidence
          (fn2-fields-ref-off (+ base *fn2-format-anchor-field-checkpoint-batch*) fn2-fields)
          slot gen kind owner generation fn2-pool fn2-checkpoint-bytes)
        (fn2-checkpoint-pool-hash-matchesp 32 (+ evidence 32)
          (fn2-fields-ref-off (+ base *fn2-format-anchor-field-previous-checkpoint*) fn2-fields)
          slot gen kind owner generation fn2-pool fn2-checkpoint-bytes)))
       (mv :evidence fn2-checkpoint-publication fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests))
      (fn2-checkpoint-publication (if (equal which 0)
        (fn2-checkpoint-publication-set-stage0 0 5 fn2-checkpoint-publication)

      (fn2-checkpoint-publication (fn2-checkpoint-publication-set-checker-live 0
                                  (if (eq code :more) 1 0) fn2-checkpoint-publication))
      ((unless (eq code :ok))
       (mv code fn2-checkpoint-publication fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests))
      (r (* 6 c))

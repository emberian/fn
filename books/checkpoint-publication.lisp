      ((mv code fn2-pool) (fn2-checkpoint-publication-buffer 160 0 nil c evidence scratch sgen kind owner generation fn2-checkpoint-bytes fn2-pool))
      ((unless (eq code :ok)) (mv code 0 fn2-checkpoint-publication fn2-fields fn2-pool))
      ((mv code fn2-pool) (fn2-pool-reset slot gen kind owner generation fn2-pool))
      ((unless (eq code :ok)) (mv code 0 fn2-checkpoint-publication fn2-fields fn2-pool))
      ((mv code fn2-pool) (fn2-checkpoint-publication-buffer 4096 0 t c evidence slot gen kind owner generation fn2-checkpoint-bytes fn2-pool))
      ((unless (eq code :ok)) (mv code 0 fn2-checkpoint-publication fn2-fields fn2-pool))

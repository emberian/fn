      (slot (if (equal which 0) (fn2-checkpoint-publication-slot0 0 fn2-checkpoint-publication)
                                (fn2-checkpoint-publication-slot1 0 fn2-checkpoint-publication)))
      (gen (if (equal which 0) (fn2-checkpoint-publication-gen0 0 fn2-checkpoint-publication)
                               (fn2-checkpoint-publication-gen1 0 fn2-checkpoint-publication)))

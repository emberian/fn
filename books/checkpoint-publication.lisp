; One bounded packet/scratch construction primitive. Scratch concatenates batch
; seal, descriptor hash, predecessor checkpoint hash, geometry hash and zero
; anchor-hash bytes. Output initialization uses the same operation in ZERO mode.
(defun fn2-checkpoint-publication-buffer (left at zero c evidence slot gen kind owner generation
                                        fn2-checkpoint-bytes fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-bytes fn2-pool) :measure (nfix left)
  :guard (and (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-pool-wfp fn2-pool)
              (natp left) (<= left 4096) (natp at) (natp c) (natp evidence)
              (<= (+ evidence 96) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes))
              (<= (+ (* 192 c) 32) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes)))))
 (if (zp left) (mv :ok fn2-pool)
  (let* ((source (cond ((< at 32) (+ evidence at))
                       ((< at 64) (+ (* 192 c) (- at 32)))
                       ((< at 128) (+ evidence (- at 32))) (t evidence)))
         (byte (if (or zero (>= at 128)) 0 (fn2-checkpoint-bytes-value source fn2-checkpoint-bytes))))
   (mv-let (code fn2-pool) (fn2-pool-write slot gen at byte kind owner generation fn2-pool)
    (if (not (eq code :ok)) (mv code fn2-pool)
     (fn2-checkpoint-publication-buffer (- left 1) (+ at 1) zero c evidence slot gen kind owner generation
                                        fn2-checkpoint-bytes fn2-pool))))))

; Generated codecs remain the sole anchor encoding. Output is a 4 KiB unit;
; the caller seals exactly ENCODED-LENGTH with fn2-format-run :anchor t before
; CHECK-PACKET can authorize the actual write. No staging result authorizes I/O.
(defun fn2-checkpoint-publication-pack (which base scratch sgen
                                      fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes

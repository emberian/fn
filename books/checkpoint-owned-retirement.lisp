(defun fn2-checkpoint-owned-retirement-scan (kind cursor fn2-checkpoint-construction fn2-checkpoint-build fn2-csnapshot fn2-extents fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-construction fn2-checkpoint-build fn2-csnapshot fn2-extents fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication)
 :guard (and (fn2-checkpoint-payload-proofsp fn2-checkpoint-payload-proofs) (fn2-checkpoint-payload-proofs-wfp fn2-checkpoint-payload-proofs) (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures) (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures) (fn2-checkpoint-publicationp fn2-checkpoint-publication) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication) (fn2-checkpoint-constructionp fn2-checkpoint-construction) (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-checkpoint-buildp fn2-checkpoint-build) (fn2-checkpoint-build-wfp fn2-checkpoint-build) (fn2-csnapshotp fn2-csnapshot) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents))))
 (cond ((not (and (unsigned-byte-p 32 cursor)
                  (= (fn2-checkpoint-construction-rows fn2-checkpoint-construction) (fn2-extents-rows fn2-extents))
                  (or (= (fn2-extents-rows fn2-extents) 0)
                      (fn2-checkpoint-payload-use-capacity-p fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication fn2-extents))
                  (fn2-checkpoint-owned-retirement-open-p fn2-checkpoint-build fn2-csnapshot fn2-extents))) (mv :state cursor 0 0))

(defcost fn2-checkpoint-owned-retirement-scan-op :child fn2-checkpoint-owned-retirement-scan
 :answers (:state :done :eligible :more :exhausted)
 :doc "Inspect exactly one actual lifetime-owned extent; no candidate metadata, journal append or allocator mutation.")

(defmacro fn2-checkpoint-owned-retirement-events ()
 '(progn
  (defun fn2-checkpoint-owned-retirement-actor-p (id ogen phase fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (and (fn2-machine-idp id fn2-core)
        (equal (fn2-machine-kind id fn2-core) *fn2-checkpoint-master-kind*)
        (equal (fn2-machine-generation id fn2-core) ogen)
        (equal (fn2-machine-phase id fn2-core) phase)
        (eq (fn2-checkpoint-master-snapshot-read-code id fn2-core) :ok)
        (not (fn2-core-stopped-p fn2-core))))
  (defun fn2-checkpoint-owned-retirement-payload-p (id fn2-core)
   (declare (xargs :stobjs fn2-core :verify-guards nil :guard (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core))))
   (and (eq (fn2-checkpoint-master-snapshot-read-code id fn2-core) :ok)
        (let ((e (fn2-checkpoint-master-row-teardown-extent id fn2-core)))
         (stobj-let ((fn2-checkpoint-payload-proofs (fn2-core-checkpoint-payload-proofs fn2-core))
                     (fn2-checkpoint-bank-closures (fn2-core-checkpoint-bank-closures fn2-core))
                     (fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core))
                     (fn2-extents (fn2-core-extents fn2-core))) (known)
          (fn2-checkpoint-known-payload-use-p e fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication fn2-extents) known))))
  (defun fn2-checkpoint-owned-retirement-begin-op (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (fn2-checkpoint-owned-retirement-actor-p id ogen *fn2-checkpoint-master-state-teardown-owned-begin* fn2-core))
    (mv :state fn2-core)
    (stobj-let ((fn2-checkpoint-build (fn2-core-checkpoint-build fn2-core))
                (fn2-csnapshot (fn2-core-csnapshot fn2-core)) (fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
     (cond ((not (fn2-checkpoint-owned-retirement-open-p fn2-checkpoint-build fn2-csnapshot fn2-extents)) (mv :state fn2-extents))
           ((= (fn2-alloc-orphan-dirty fn2-extents) 0) (mv :none fn2-extents))
           ; Only whole orphan-sweep BEGIN clears this. Later changes relatch
           ; a full following pass, including changes after the last row.
           (t (mv :more (update-fn2-alloc-orphan-dirty 0 fn2-extents))))
     (mv code fn2-core))))
  (fn2-core-preserves fn2-checkpoint-owned-retirement-begin-op (id ogen fn2-core) :position 1 :rows nil)
  (defun fn2-checkpoint-owned-retirement-submit-op (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (b* (((unless (fn2-checkpoint-owned-retirement-actor-p id ogen *fn2-checkpoint-master-state-teardown-owned-submit* fn2-core))
         (mv :state :state 0 0 fn2-core))
        (e (fn2-checkpoint-master-row-teardown-extent id fn2-core))
        (epoch (fn2-checkpoint-master-row-teardown-epoch id fn2-core))
        (allocation (fn2-checkpoint-master-row-teardown-allocation id fn2-core))
        ((unless (equal e (fn2-checkpoint-master-row-scan id fn2-core))) (mv :state :state 0 0 fn2-core))
        (eligible
         (stobj-let ((fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core))
                     (fn2-checkpoint-build (fn2-core-checkpoint-build fn2-core))
                     (fn2-csnapshot (fn2-core-csnapshot fn2-core)) (fn2-extents (fn2-core-extents fn2-core)) (fn2-checkpoint-payload-proofs (fn2-core-checkpoint-payload-proofs fn2-core)) (fn2-checkpoint-bank-closures (fn2-core-checkpoint-bank-closures fn2-core)) (fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core))) (eligible)
          (and (fn2-checkpoint-owned-retirement-eligible-p *fn2-checkpoint-master-kind* e fn2-checkpoint-construction fn2-checkpoint-build fn2-csnapshot fn2-extents fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication)
               (= epoch (fn2-extents-epoch e fn2-extents)) (= allocation (fn2-extents-counter e fn2-extents))) eligible))
        ((unless eligible) (mv :retained :retained 0 0 fn2-core))
        ((mv code batch event fn2-core) (fn2-retirement-submit e epoch allocation *fn2-checkpoint-master-kind* id ogen fn2-core)))
    (mv (if (member-eq code '(:ok :uncertain)) :ok code) code batch event fn2-core)))
  (fn2-core-preserves fn2-checkpoint-owned-retirement-submit-op (id ogen fn2-core) :position 4 :rows nil)
  (defthm fn2-checkpoint-owned-retirement-payload-submit-frame-by-definition
   (implies (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
                 (fn2-checkpoint-owned-retirement-actor-p id ogen *fn2-checkpoint-master-state-teardown-owned-submit* fn2-core)
                 (equal (fn2-checkpoint-master-row-teardown-extent id fn2-core) (fn2-checkpoint-master-row-scan id fn2-core))
                 (fn2-checkpoint-owned-retirement-payload-p id fn2-core))
    (equal (fn2-checkpoint-owned-retirement-submit-op id ogen fn2-core)
           (mv :retained :retained 0 0 fn2-core)))
   :hints (("Goal" :in-theory (enable fn2-checkpoint-owned-retirement-submit-op
                       fn2-checkpoint-owned-retirement-payload-p fn2-checkpoint-owned-retirement-eligible-p))))
  (defun fn2-checkpoint-owned-retirement-poll-op (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (b* (((unless (fn2-checkpoint-owned-retirement-actor-p id ogen *fn2-checkpoint-master-state-teardown-owned-wait* fn2-core))
         (mv :uncertain :uncertain 0 0 fn2-core))
        (e (fn2-checkpoint-master-row-teardown-extent id fn2-core))
        (epoch (fn2-checkpoint-master-row-teardown-epoch id fn2-core))
        (allocation (fn2-checkpoint-master-row-teardown-allocation id fn2-core))
        (batch (fn2-checkpoint-master-row-batch id fn2-core))
        (event (fn2-checkpoint-master-row-event id fn2-core))
        (exact
         (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))) (exact)
          (and (< 0 (fn2-retirement-control-rows fn2-retirement-control))
               (= (fn2-retirement-control-owner-kind 0 fn2-retirement-control) *fn2-checkpoint-master-kind*)
               (= (fn2-retirement-control-owner-slot 0 fn2-retirement-control) id)
               (= (fn2-retirement-control-owner-gen 0 fn2-retirement-control) ogen)
               (= (fn2-retirement-control-extent 0 fn2-retirement-control) e)
               (= (fn2-retirement-control-epoch 0 fn2-retirement-control) epoch)
               (= (fn2-retirement-control-allocation 0 fn2-retirement-control) allocation)
               (= (fn2-retirement-control-batch 0 fn2-retirement-control) batch)
               (= (fn2-retirement-control-event 0 fn2-retirement-control) event)) exact))
        ((unless exact) (mv :uncertain :uncertain batch event fn2-core))
        ((mv outcome batch event fn2-core) (fn2-retirement-poll *fn2-checkpoint-master-kind* id ogen fn2-core)))
    (mv (if (member-eq outcome '(:accepted :refused)) :ok outcome) outcome batch event fn2-core)))
  (fn2-core-preserves fn2-checkpoint-owned-retirement-poll-op (id ogen fn2-core) :position 4 :rows nil)))

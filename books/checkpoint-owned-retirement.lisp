(defthm fn2-checkpoint-owned-retirement-payload-veto-by-definition
 (implies (and (fn2-checkpoint-constructionp fn2-checkpoint-construction) (fn2-checkpoint-construction-wfp fn2-checkpoint-construction)
               (fn2-checkpoint-buildp fn2-checkpoint-build) (fn2-checkpoint-build-wfp fn2-checkpoint-build)
               (fn2-csnapshotp fn2-csnapshot) (fn2-csnapshot-wfp fn2-csnapshot)
               (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents)
               (fn2-checkpoint-payload-proofsp fn2-checkpoint-payload-proofs) (fn2-checkpoint-payload-proofs-wfp fn2-checkpoint-payload-proofs)
               (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures) (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures)
               (fn2-checkpoint-publicationp fn2-checkpoint-publication) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
               (fn2-checkpoint-known-payload-use-p e fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication fn2-extents))
  (not (fn2-checkpoint-owned-retirement-eligible-p kind e fn2-checkpoint-construction fn2-checkpoint-build fn2-csnapshot fn2-extents fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication)))

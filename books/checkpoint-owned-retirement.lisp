 :bytes (+ *fn2-format-txn-record-max-size* *fn2-format-retirement-max-size*)
 :tables (fn2-core-machines fn2-core-checkpoint-construction fn2-core-checkpoint-build fn2-core-csnapshot fn2-core-extents

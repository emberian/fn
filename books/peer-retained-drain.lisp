; The connection saves operation identities on successful issue. The
; canonical harvester alone retires the operation and settles its pool loan.
(in-package "ACL2")
(include-book "arm-children")
(include-book "arms")

(include-book "event-read-state")
(include-book "journal-retention-state")
(fn2-book-layer :c)

(defun fn2-peer-retained-operation-state (slot generation action kind owner ogen fn2-ops)
 (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
 (b* (((unless (and (fn2-op-slotp slot fn2-ops)
                     (unsigned-byte-p 60 generation)
                     (or (equal action *fn2-action-send*) (equal action *fn2-action-read*))))
       :owner)
      (current (fn2-op-gen slot fn2-ops))
      (phase (fn2-op-phase slot fn2-ops))
      ((when (> current generation)) :done)
      ((unless (equal current generation)) :owner)
      ((when (equal phase *fn2-op-phase-retired*)) :done)
      ((mv actual-kind actual-owner actual-gen) (fn2-op-owner slot fn2-ops))
      ((unless (and (equal action (fn2-op-kind slot fn2-ops))
                     (equal kind actual-kind) (equal owner actual-owner) (equal ogen actual-gen)))
       :owner)
      ((when (equal phase *fn2-op-phase-done*)) :done)
      ((when (and (or (equal phase *fn2-op-phase-queued*) (equal phase *fn2-op-phase-submitted*))
                  (equal (fn2-ops-c0-posted slot fn2-ops) 0)))
       :cancel))
   (if (or (equal phase *fn2-op-phase-submitted*) (equal phase *fn2-op-phase-release-pending*))
       :drain :owner)))

(defun fn2-peer-retained-send-state (op generation slot gen kind owner ogen fn2-ops fn2-pool)
 (declare (xargs :stobjs (fn2-ops fn2-pool)
  :guard (and (fn2-ops-wfp fn2-ops) (fn2-pool-wfp fn2-pool))))
 (let ((code (fn2-peer-retained-operation-state op generation *fn2-action-send* kind owner ogen fn2-ops)))
  (cond ((eq code :owner) :owner)
        ((not (eq code :done))
         (mv-let (actual-slot actual-gen & &) (fn2-op-range op fn2-ops)
          (if (and (equal slot actual-slot) (equal gen actual-gen)) code :owner)))
        (t (case (fn2-pool-workspace-code slot gen kind owner ogen fn2-pool)
             (:ok :done)
             ((:state :held) :drain)
             (otherwise :owner))))))

; Call after CLOSE enters draining. No read target comes from the wire.
; CANCEL is permission to issue once, and never grants buffer return.
(defun fn2-peer-retained-read-target (token kind owner ogen fn2-journal-lease fn2-event-read fn2-ops)
 (declare (xargs :stobjs (fn2-journal-lease fn2-event-read fn2-ops)
  :guard (and (fn2-journal-lease-wfp fn2-journal-lease)
              (fn2-event-read-wfp fn2-event-read) (fn2-ops-wfp fn2-ops))))
 (b* (((unless (and (< 0 (fn2-journal-lease-rows fn2-journal-lease))
                     (fn2-journal-lease-ownerp token kind owner ogen fn2-journal-lease)
                     (equal (fn2-journal-lease-phase 0 fn2-journal-lease) *fn2-journal-lease-phase-closing*)
                     (< 0 (fn2-event-read-rows fn2-event-read))))
       (mv :owner 0 0))
      ((when (equal (fn2-event-read-pending 0 fn2-event-read) 0)) (mv :done 0 0))
      ((unless (and (equal token (fn2-event-read-token 0 fn2-event-read))
                    (equal kind (fn2-event-read-owner-kind 0 fn2-event-read))
                    (equal owner (fn2-event-read-owner-slot 0 fn2-event-read))
                    (equal ogen (fn2-event-read-owner-gen 0 fn2-event-read))))
       (mv :owner 0 0))
      (slot (fn2-event-read-op-slot 0 fn2-event-read))
      (generation (fn2-event-read-op-gen 0 fn2-event-read))
      (code (fn2-peer-retained-operation-state slot generation *fn2-action-read* kind owner ogen fn2-ops)))
   (case code
    (:cancel (mv :cancel slot generation))
    (:drain (mv :drain 0 0))
    ; The READ harvest hook must clear PENDING before FINISH recycles it.
    (otherwise (mv :owner 0 0)))))

(defcost fn2-retained-send-state :answers (:cancel :drain :done :owner)
 :tables (fn2-core-ops fn2-core-pool)
 :doc "Check exact outstanding SEND and whether its workspace can be reused.")
(defcost fn2-retained-read-target :answers (:cancel :drain :done :owner)
 :tables (fn2-core-journal-lease fn2-core-event-read fn2-core-ops)
 :doc "Check whether closing has an exact physical read to cancel.")

(defmacro fn2-peer-retained-drain-events ()
 '(progn
  (defun fn2-retained-send-state (op generation slot gen kind owner ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (stobj-let ((fn2-ops (fn2-core-ops fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
    (code)
    (fn2-peer-retained-send-state op generation slot gen kind owner ogen fn2-ops fn2-pool)
    code))
  (defun fn2-retained-read-target (token kind owner ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (stobj-let ((fn2-journal-lease (fn2-core-journal-lease fn2-core))
               (fn2-event-read (fn2-core-event-read fn2-core)) (fn2-ops (fn2-core-ops fn2-core)))
    (code slot generation)
    (fn2-peer-retained-read-target token kind owner ogen fn2-journal-lease fn2-event-read fn2-ops)
    (mv code slot generation)))))

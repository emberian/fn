; Layer E: the served consumer's core pieces (docs/e-surface.md 7;
; lanes/e-continuation E.P1). The subscription-edge table (cns-edges.lisp,
; D8's rows) is a core child here, sized by the ledger's :subscription-edge
; capacity, its link and unlink are declared operations for the request
; kind's arms, and its ready/grant pair is the :wait-row wait kind's source:
; a parked wait is woken by the publish hook's bucket push, through the
; grant service, never by a scan.
(in-package "ACL2")
(include-book "cns-kind")
(include-book "machines-c-bind")
(fn2-book-layer :e)

;; The operations the request kind's arms call (child form).
(defcost fn2-cns-edge-link-core :child fn2-cns-edge-link :answers (:ok :behind :exhausted)
 :tables (fn2-core-cns-edges)
 :doc "Link a parked wait's edge on its stream from its first unread position: :behind (a publish since its read: read again), :exhausted (every row in use).")
(defcost fn2-cns-edge-unlink-core :child fn2-cns-edge-unlink :tables (fn2-core-cns-edges)
 :doc "Release a wait's edge (its bucket's cursor moved past it).")
(defcost fn2-cns-reclaim :child fn2-machines-reclaim :tables (fn2-core-machines)
 :effects ((:release (:wait-row)))
 :doc "Return a drained consumer request row to its partition's free chain.")

;; ---------------------------------------------------------------------------
;; Pure helpers for fn2-ctl (L carrier) and fn2-cns (request).
(defconst *fn2-ctl-io-bytes* 4096)

(defconst *fn2-ctl-cmd-none* 0)
(defconst *fn2-ctl-cmd-status* 1)
(defconst *fn2-ctl-cmd-pause* 2)
(defconst *fn2-ctl-cmd-resume* 3)
(defconst *fn2-ctl-cmd-drain* 4)
(defconst *fn2-ctl-cmd-stop* 5)

(defconst *fn2-ctl-posture-running* 0)
(defconst *fn2-ctl-posture-paused* 1)
(defconst *fn2-ctl-posture-draining* 2)
(defconst *fn2-ctl-posture-stopped* 3)

(defun fn2-ctl-owner-uid-p (peer-family peer-w0 owner-uid)
  (declare (xargs :guard t))
  (and (equal (nfix peer-family) 3)
       (equal (nfix peer-w0) (nfix owner-uid))))

(defun fn2-ctl-owner-p (peer-family peer-w0 fn2-control)
  (declare (xargs :stobjs fn2-control :guard (fn2-control-wfp fn2-control)))
  (fn2-ctl-owner-uid-p peer-family peer-w0 (fn2-control-owner-uid fn2-control)))

(defun fn2-ctl-step-posture (cmd posture)
  (declare (xargs :guard t))
  (let ((c (nfix cmd)) (p (nfix posture)))
    (cond ((equal c *fn2-ctl-cmd-pause*) *fn2-ctl-posture-paused*)
          ((equal c *fn2-ctl-cmd-resume*) *fn2-ctl-posture-running*)
          ((equal c *fn2-ctl-cmd-drain*) *fn2-ctl-posture-draining*)
          ((equal c *fn2-ctl-cmd-stop*) *fn2-ctl-posture-stopped*)
          (t p))))
(defcost fn2-ctl-owner-core-p :child fn2-ctl-owner-p :doc "Whether the local peer is the node owner.")
(defcost fn2-ctl-step-posture :child fn2-ctl-step-posture :doc "Next control posture for a command.")
(defthm fn2-ctl-step-posture-natp (natp (fn2-ctl-step-posture cmd posture)) :rule-classes :type-prescription)
(in-theory (disable fn2-ctl-owner-p fn2-ctl-step-posture))

(defun fn2-ctl-parse-frame-pool (pos flen cmd0 fkind0 slot gen okind oslot ogen fn2-pool)
  (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
  (if (or (< 0 (nfix cmd0)) (< 0 (nfix fkind0)))
      (mv (min 255 (nfix cmd0)) (min 255 (nfix fkind0)))
    (if (<= (nfix flen) 0)
        (mv *fn2-ctl-cmd-status* 0)
      (mv-let (c0 b0) (fn2-pool-read slot gen (nfix pos) okind oslot ogen fn2-pool)
        (mv-let (c1 b1) (if (< 1 (nfix flen))
                            (fn2-pool-read slot gen (+ 1 (nfix pos)) okind oslot ogen fn2-pool)
                          (mv :range 0))
          (let ((cmd (if (and (eq c0 :ok) (natp b0) (< 0 b0) (<= b0 5)) b0 *fn2-ctl-cmd-status*))
                (fkind (if (and (eq c1 :ok) (natp b1) (< b1 256)) b1 0)))
            (mv cmd fkind)))))))
(defthm fn2-ctl-parse-frame-pool-natp-0
  (natp (mv-nth 0 (fn2-ctl-parse-frame-pool pos flen cmd0 fkind0 slot gen okind oslot ogen fn2-pool)))
  :rule-classes (:rewrite :type-prescription))
(defthm fn2-ctl-parse-frame-pool-natp-1
  (natp (mv-nth 1 (fn2-ctl-parse-frame-pool pos flen cmd0 fkind0 slot gen okind oslot ogen fn2-pool)))
  :rule-classes (:rewrite :type-prescription))
(in-theory (disable fn2-ctl-parse-frame-pool))
(defcost fn2-ctl-parse-frame :child fn2-ctl-parse-frame-pool :bytes 64
 :doc "Decode control command and consumer frame kind from the received frame.")

(defcost fn2-ctl-dispatch-cns :answers (:ok :no-row :pool)
 :tables (fn2-core-machines fn2-core-pool fn2-cns-table fn2-core-machine-tables)
 :doc "Take a consumer request row for a control frame and hand the frame metadata.")

(defun fn2-cns-default-verb (verb fkind)
  (declare (xargs :guard t))
  (let ((v (nfix verb)) (k (nfix fkind)))
    (cond ((< 0 v) v)
          ((equal k 1) *fn2-cns-verb-status*)
          ((equal k 2) *fn2-cns-verb-read*)
          ((equal k 3) *fn2-cns-verb-wait*)
          ((equal k 4) *fn2-cns-verb-ack*)
          ((equal k 5) *fn2-cns-verb-position*)
          ((equal k 6) *fn2-cns-verb-register*)
          (t *fn2-cns-verb-status*))))
(defcost fn2-cns-default-verb :child fn2-cns-default-verb :doc "Resolve the consumer verb from row-verb or the frame kind.")
(defthm fn2-cns-default-verb-natp (natp (fn2-cns-default-verb verb fkind)) :rule-classes :type-prescription)
(in-theory (disable fn2-cns-default-verb))

(defcost fn2-cns-lookup-cursor :answers (:ok) :tables (fn2-core-id-engine)
 :doc "Read the published commit frontier for a consumer request.")

(defun fn2-cns-encode-reply-pool (slot gen okind oslot ogen outcome reason cpos pfront count more fn2-pool)
  (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)
                  :guard-hints (("Goal" :in-theory (disable fn2-pool-reset fn2-pool-write)))))
  (mv-let (rc fn2-pool) (fn2-pool-reset slot gen okind oslot ogen fn2-pool)
    (if (not (eq rc :ok))
        fn2-pool
      (mv-let (c0 fn2-pool) (fn2-pool-write slot gen 0 (min 255 (nfix outcome)) okind oslot ogen fn2-pool)
        (declare (ignore c0))
        (mv-let (c1 fn2-pool) (fn2-pool-write slot gen 1 (min 255 (nfix reason)) okind oslot ogen fn2-pool)
          (declare (ignore c1))
          (mv-let (c2 fn2-pool) (fn2-pool-write slot gen 2 (min 255 (nfix cpos)) okind oslot ogen fn2-pool)
            (declare (ignore c2))
            (mv-let (c3 fn2-pool) (fn2-pool-write slot gen 3 (min 255 (nfix pfront)) okind oslot ogen fn2-pool)
              (declare (ignore c3))
              (mv-let (c4 fn2-pool) (fn2-pool-write slot gen 4 (min 255 (nfix count)) okind oslot ogen fn2-pool)
                (declare (ignore c4))
                (mv-let (c5 fn2-pool) (fn2-pool-write slot gen 5 (min 255 (nfix more)) okind oslot ogen fn2-pool)
                  (declare (ignore c5))
                  fn2-pool)))))))))
(fn2-pool-preserves fn2-cns-encode-reply-pool
  (slot gen okind oslot ogen outcome reason cpos pfront count more fn2-pool)
  :position nil :rows nil :hints (("Goal" :in-theory (disable fn2-pool-reset fn2-pool-write))))
(in-theory (disable fn2-cns-encode-reply-pool))

(defcost fn2-cns-post-reply :answers (:ok :dropped)
 :tables (fn2-ctl-table fn2-core-machines fn2-core-pool)
 :doc "Encode the consumer reply into the control range and post its length to the waiting control connection.")

(defun fn2-cns-stream-wake-loop (k b i fn2-succ-txns fn2-succ-slots fn2-id-decides fn2-fields fn2-fc fn2-cns-edges)
  (declare (xargs :stobjs (fn2-succ-txns fn2-succ-slots fn2-id-decides fn2-fields fn2-fc fn2-cns-edges)
                  :measure (nfix k)
                  :guard (and (fn2-succ-txns-wfp fn2-succ-txns) (fn2-succ-slots-wfp fn2-succ-slots)
                              (fn2-id-decides-wfp fn2-id-decides) (fn2-fields-wfp fn2-fields)
                              (fn2-fc-wfp fn2-fc) (fn2-cns-edges-wfp fn2-cns-edges) (natp i))
                  :guard-hints (("Goal" :in-theory (disable fn2-succ-stream-member-children fn2-cns-wake-stream)))))
  (if (<= (nfix k) 0)
      (mv :ok fn2-cns-edges)
    (mv-let (code stream pos next)
      (fn2-succ-stream-member-children b i fn2-succ-txns fn2-succ-slots fn2-id-decides fn2-fields fn2-fc)
      (cond ((eq code :done) (mv :ok fn2-cns-edges))
            ((not (eq code :ok)) (mv code fn2-cns-edges))
            (t (let ((fn2-cns-edges (fn2-cns-wake-stream stream pos fn2-cns-edges)))
                 (fn2-cns-stream-wake-loop (- (nfix k) 1) b (nfix next) fn2-succ-txns fn2-succ-slots
                                           fn2-id-decides fn2-fields fn2-fc fn2-cns-edges)))))))
(fn2-cns-edges-preserves fn2-cns-stream-wake-loop
  (k b i fn2-succ-txns fn2-succ-slots fn2-id-decides fn2-fields fn2-fc fn2-cns-edges)
  :position 1 :raw-rows t
  :hints (("Goal" :in-theory (disable fn2-succ-stream-member-children fn2-cns-wake-stream))))
(in-theory (disable fn2-cns-stream-wake-loop))

(defun fn2-ctl-command-code (sym)
  (declare (xargs :guard t))
  (case sym
    (:status *fn2-ctl-cmd-status*)
    (:pause *fn2-ctl-cmd-pause*)
    (:resume *fn2-ctl-cmd-resume*)
    (:drain *fn2-ctl-cmd-drain*)
    (:stop *fn2-ctl-cmd-stop*)
    (otherwise *fn2-ctl-cmd-none*)))

(defun fn2-ctl-posture-name (posture)
  (declare (xargs :guard t))
  (let ((p (nfix posture)))
    (cond ((equal p *fn2-ctl-posture-paused*) :paused)
          ((equal p *fn2-ctl-posture-draining*) :draining)
          ((equal p *fn2-ctl-posture-stopped*) :stopped)
          (t :running))))

(defun fn2-ctl-eval-commands (cmds posture)
  (declare (xargs :guard t))
  (if (atom cmds) nil
    (let* ((code (fn2-ctl-command-code (car cmds)))
           (next (fn2-ctl-step-posture code posture))
           (reply (list :ok (car cmds) (fn2-ctl-posture-name next))))
      (if (equal next *fn2-ctl-posture-stopped*)
          (list reply)
        (cons reply (fn2-ctl-eval-commands (cdr cmds) next))))))

(defconst *fn2-cns-reason-none* 0)
(defconst *fn2-cns-reason-unavailable* 1)
(defconst *fn2-cns-reason-access* 2)
(defconst *fn2-cns-reason-meter* 3)
(defconst *fn2-cns-reason-scope* 4)
(defconst *fn2-cns-reason-equal* 5)
(defconst *fn2-cns-reason-behind* 6)
(defconst *fn2-cns-reason-beyond-frontier* 7)

;; ---------------------------------------------------------------------------
;; fn2-ctl: the L carrier on the :local listener (e-continuation E.P1).
(defmachine-arms fn2-ctl :declare
 :arms
 ((:free (:idle))
  (:greeting
   (:if (fn2-ctl-owner-core-p row-peer-family row-peer-w0)
        ((:set (owner 1) (fill 0) (pos 0)) (:next :frame) (:charge :steps *fn2-work-transition* :runnable t))
        ((:next :closing) (:charge :steps *fn2-work-transition* :runnable t))))
  (:frame
   (:cond ((not (equal row-pending 0)) (:charge :steps *fn2-work-empty*))
          ((< 0 row-flen)
           (:do (ncmd nfkind) (fn2-ctl-parse-frame row-pos row-flen row-cmd row-fkind row-rx-slot row-rx-gen))
           (:set (cmd ncmd) (fkind nfkind) (request (+ 1 row-request))
                 (posture (fn2-ctl-step-posture ncmd row-posture)))
           (:next :dispatch) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
          ((not (and (natp budget) (< 0 budget))) (:charge :steps *fn2-work-poll* :runnable t))
          ((not (eq (fn2-machine-pool-capacity-read-code row-rx-slot) :ok)) (:stop :machine-phase))
          (t (:let cap (min *fn2-ctl-io-bytes* (fn2-machine-pool-capacity row-rx-slot)))
             (:issue (fn2-issue-receive row-cap-index row-cap-nonce row-rx-slot row-rx-gen cap
                                        :principal row-principal-slot)
              :ok ((:wait :completion :bytes cap))))))
  (:dispatch
   (:cond ((equal row-posture *fn2-ctl-posture-stopped*)
           (:next :closing) (:charge :steps *fn2-work-transition* :runnable t))
          ((< 0 row-fkind)
           (:do (tcode cid cgen) (fn2-ctl-dispatch-cns id row-generation row-request row-pos row-flen
                                                       row-fkind row-rx-slot row-rx-gen)
            :case (((:ok) (:set (cns cid) (cns-gen cgen) (tx-off 0) (tx-len 0))
                          (:next :waiting) (:charge :steps *fn2-work-transition*))
                   (:otherwise (:set (tx-off 0) (tx-len row-flen))
                               (:next :waiting) (:charge :steps *fn2-work-transition* :runnable t)))))
          (t (:set (tx-off 0) (tx-len row-flen)) (:next :waiting)
             (:charge :steps *fn2-work-transition* :runnable t))))
  (:waiting
   (:if (< 0 row-tx-len)
        ((:set (cns *fn2-none*) (cns-gen 0)) (:next :reply)
         (:charge :steps *fn2-work-transition* :runnable t))
        ((:charge :steps *fn2-work-empty*))))
  (:reply
   (:cond ((not (equal row-pending 0)) (:charge :steps *fn2-work-empty*))
          ((not (equal row-borrows 0)) (:charge :steps *fn2-work-poll*))
          ((>= row-tx-off row-tx-len)
           (:do (code) (fn2-core-reset row-rx-slot row-rx-gen)
            :case (((:ok) (:set (pos 0) (fill 0) (flen 0) (cmd 0) (fkind 0) (tx-off 0) (tx-len 0))
                          (:next :frame) (:charge :steps *fn2-work-transition* :runnable t))
                   (:otherwise (:set (pos 0) (fill 0) (flen 0) (cmd 0) (fkind 0) (tx-off 0) (tx-len 0))
                               (:next :closing) (:charge :steps *fn2-work-transition* :runnable t)))))
          ((not (and (natp budget) (< 0 budget))) (:charge :steps *fn2-work-poll* :runnable t))
          (t (:let len (min *fn2-ctl-io-bytes* (nfix (- row-tx-len row-tx-off))))
             (:issue (fn2-issue-send row-cap-index row-cap-nonce row-rx-slot row-rx-gen row-tx-off len 1
                                     :principal row-principal-slot)
              :ok ((:set (borrows 1)) (:wait :completion :bytes len))))))
  (:closing
   (:cond ((not (equal row-pending 0)) (:charge :steps *fn2-work-empty*))
          ((not (and (natp budget) (< 0 budget))) (:charge :steps *fn2-work-poll* :runnable t))
          (t (:issue (fn2-issue-close row-cap-index row-cap-nonce :principal row-principal-slot)
              :ok ((:wait :completion :bytes 0))))))
  (:draining
   (:cond ((not (equal row-pending 0)) (:charge :steps *fn2-work-empty*))
          ((not (equal row-borrows 0)) (:charge :steps *fn2-work-poll*))
          (t (:do (rcode) (fn2-core-release row-rx-slot row-rx-gen) :effects ((:release (:rx-range)))
              :accept (:ok :retired) :why "a retired range is a completed release (the pool retires the slot)"
              :case ((:otherwise (:stop :pool-release :steps *fn2-work-state*))))
             (:let next (fn2-machine-free-head *fn2-ctl-admission-ordinal*))
             (:let retire (>= row-generation (fn2-machine-gen-limit)))
             (:set (generation (if retire row-generation (+ 1 row-generation)))
                   (rx-slot *fn2-none*) (rx-gen 0) (tx-slot *fn2-none*) (tx-gen 0)
                   (cap-index 0) (cap-nonce 0) (cns *fn2-none*) (cns-gen 0)
                   (next-free next) (wait-reason *fn2-wait-none*))
             (:next (:if retire :retired :free))
             (:do () (fn2-machine-reclaim id *fn2-ctl-admission-ordinal* retire))
             (:charge :steps *fn2-work-release*))))
  (:retired (:idle)))
 :observes
 ((:receive-result :from (:frame)
   (:if (and (or (equal outcome *fn2-outcome-done*) (equal outcome *fn2-outcome-short*))
             (unsigned-byte-p 32 count) (< 0 count))
        ((:set (fill count) (flen count) (pos 0)) (:wake))
        ((:next :closing) (:wake))))
  (:send-result :from (:reply)
   (:if (not (eq (fn2-machine-pool-borrows-read-code row-rx-slot) :ok))
        ((:stop :machine-observation))
        ((:let off row-tx-off) (:let len row-tx-len)
         (:set (borrows (fn2-machine-pool-borrows row-rx-slot)))
         (:if (and (or (equal outcome *fn2-outcome-done*) (equal outcome *fn2-outcome-short*))
                   (natp count) (<= (+ off count) len))
              ((:set (tx-off (+ off count))) (:wake))
              ((:next :closing) (:wake))))))
  (:borrow-released :from (:reply :closing :draining)
   (:if (not (eq (fn2-machine-pool-borrows-read-code row-rx-slot) :ok))
        ((:stop :machine-observation))
        ((:set (borrows (fn2-machine-pool-borrows row-rx-slot))) (:wake))))
  (:close-result :from (:closing) (:next :draining) (:wake))))

;; ---------------------------------------------------------------------------
;; fn2-cns: one consumer request; a parked wait is this row parked on its edge.
(defmachine-arms fn2-cns :declare
 :subarms
 ((hand :on-refusal ((:stop :machine-phase))
   (:do (pcode) (fn2-cns-post-reply row-ctl row-ctl-gen row-request row-outcome row-reason
                                    row-cpos row-pub-frontier row-count row-more
                                    row-tx-slot row-tx-gen row-tx-len)
    :accept (:ok :dropped) :why "the control connection may have closed while the consumer request ran")
   (:wake-row row-ctl)
   (:next :draining) (:charge :bytes 512 :steps *fn2-work-transition* :runnable t))
  (answer
   (:set (tx-len 6))
   (:goto hand))
  (refuse
   (:set (outcome *fn2-cns-outcome-refused*))
   (:goto answer))
  (cancel
   (:next :draining) (:charge :steps *fn2-work-transition* :runnable t)))
 :arms
 ((:free (:idle))
  (:decode :on-refusal ((:stop :machine-phase))
   (:cond ((equal row-ctl *fn2-none*) (:goto cancel))
          ((equal row-fkind 0) (:set (reason *fn2-cns-reason-unavailable*)) (:goto refuse))
          ((equal row-verb 0)
           (:set (verb (fn2-cns-default-verb row-verb row-fkind))
                 (epoch (if (equal row-epoch 0) 1 row-epoch))
                 (page-limit (if (equal row-page-limit 0) 8 row-page-limit))
                 (wait-ms (if (and (equal row-wait-ms 0) (equal row-fkind 3)) 30000 row-wait-ms)))
           (:next :check) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
          (t (:next :check) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))))
  (:check :on-refusal ((:stop :machine-phase))
   (:cond ((or (equal row-verb *fn2-cns-verb-append*)
               (equal row-verb *fn2-cns-verb-fetch*)
               (equal row-verb *fn2-cns-verb-rebase*)
               (equal row-verb *fn2-cns-verb-unregister*))
           (:set (reason *fn2-cns-reason-unavailable*)) (:goto refuse))
          ((equal row-verb *fn2-cns-verb-register*)
           (:next :commit) (:charge :steps *fn2-work-transition* :runnable t))
          (t (:next :lookup) (:charge :steps *fn2-work-transition* :runnable t))))
  (:lookup :on-refusal ((:stop :machine-phase))
   (:do (fcode pfront) (fn2-cns-lookup-cursor row-pub-frontier))
   (:cond ((equal row-epoch 0) (:set (reason *fn2-cns-reason-scope*)) (:goto refuse))
          ((equal row-verb *fn2-cns-verb-ack*)
           (:cond ((equal row-to row-cpos)
                   (:set (pub-frontier pfront) (outcome *fn2-cns-outcome-accepted*)) (:goto answer))
                  ((< row-to row-cpos)
                   (:set (pub-frontier pfront) (reason *fn2-cns-reason-behind*)) (:goto refuse))
                  ((> row-to pfront)
                   (:set (pub-frontier pfront) (reason *fn2-cns-reason-beyond-frontier*)) (:goto refuse))
                  (t (:set (pub-frontier pfront))
                     (:next :commit) (:charge :steps *fn2-work-transition* :runnable t))))
          ((or (equal row-verb *fn2-cns-verb-position*) (equal row-verb *fn2-cns-verb-status*))
           (:set (pub-frontier pfront) (outcome *fn2-cns-outcome-accepted*)) (:goto answer))
          (t (:set (pub-frontier pfront))
             (:next :read) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))))
  (:read :on-refusal ((:stop :machine-phase))
   (:do (fcode pfront) (fn2-cns-lookup-cursor row-pub-frontier))
   (:set (pub-frontier pfront) (count 0)) (:next :page)
   (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
  (:page :on-refusal ((:stop :machine-phase))
   (:cond ((equal row-ctl *fn2-none*) (:goto cancel))
          ((and (< row-cpos row-pub-frontier) (< 0 row-page-limit))
           (:let avail (- row-pub-frontier row-cpos))
           (:let take (min row-page-limit avail))
           (:set (count take) (more (if (< take avail) 1 0)) (outcome *fn2-cns-outcome-accepted*))
           (:goto answer))
          ((and (equal row-verb *fn2-cns-verb-wait*) (< 0 row-wait-ms) (equal row-deadline 0))
           (:set (deadline row-wait-ms)) (:next :park)
           (:charge :steps *fn2-work-transition* :runnable t))
          (t (:set (count 0) (more 0) (outcome *fn2-cns-outcome-accepted*)) (:goto answer))))
  (:park :on-refusal ((:stop :machine-phase))
   (:cond ((equal row-ctl *fn2-none*)
           (:if (equal row-edge *fn2-none*)
                ((:goto cancel))
                ((:do () (fn2-cns-edge-unlink-core row-edge))
                 (:set (edge *fn2-none*)) (:goto cancel))))
          ((equal row-edge *fn2-none*)
           (:do (code e) (fn2-cns-edge-link-core row-principal-slot id row-generation (+ 1 row-cpos))
            :case (((:behind) (:next :read) (:charge :steps *fn2-work-transition* :runnable t))
                   ((:exhausted) (:set (reason *fn2-cns-reason-meter*)) (:goto refuse))
                   ((:ok) (:set (edge e)) (:park :wait-row :steps *fn2-work-transition*)))))
          (t (:do () (fn2-cns-edge-unlink-core row-edge))
             (:set (edge *fn2-none*) (deadline 0)) (:next :read)
             (:charge :steps *fn2-work-transition* :runnable t))))
  (:commit :on-refusal ((:stop :machine-phase))
   (:case row-posted
    ((*fn2-cns-posted-accepted*) (:set (outcome *fn2-cns-outcome-accepted*) (cpos row-to)) (:goto answer))
    ((*fn2-cns-posted-unchanged*)
     (:if (equal row-to row-cpos)
          ((:set (outcome *fn2-cns-outcome-accepted*)) (:goto answer))
          ((:set (reason *fn2-cns-reason-behind*)) (:goto refuse))))
    ((*fn2-cns-posted-refused*) (:set (reason row-posted-word)) (:goto refuse))
    ((*fn2-cns-posted-uncertain*) (:set (outcome *fn2-cns-outcome-uncertain*)) (:goto answer))
    (:otherwise (:set (outcome *fn2-cns-outcome-accepted*) (cpos row-to)) (:goto answer))))
  (:draining
   (:let next (fn2-machine-free-head *fn2-cns-admission-ordinal*))
   (:let retire (>= row-generation (fn2-machine-gen-limit)))
   (:set (generation (if retire row-generation (+ 1 row-generation)))
         (ctl *fn2-none*) (ctl-gen 0) (edge *fn2-none*) (txn *fn2-none*) (txn-gen 0)
         (tx-slot *fn2-none*) (tx-gen 0) (next-free next) (wait-reason *fn2-wait-none*))
   (:next (:if retire :retired :free))
   (:do () (fn2-cns-reclaim id *fn2-cns-admission-ordinal* retire))
   (:charge :steps *fn2-work-release*))
  (:retired (:idle)))
 :observes ())

(defmacro fn2-cns-events ()
  '(progn
     (defun fn2-ctl-dispatch-cns (ctl ctl-gen request fpos flen fkind rx-slot rx-gen fn2-core)
       (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
       (if (and (unsigned-byte-p 32 ctl) (unsigned-byte-p 60 ctl-gen) (unsigned-byte-p 32 request)
                (unsigned-byte-p 32 fpos) (unsigned-byte-p 32 flen) (unsigned-byte-p 8 fkind)
                (unsigned-byte-p 32 rx-slot) (unsigned-byte-p 60 rx-gen))
           (fn2-machine-take-fn2-cns *fn2-none* ctl ctl-gen request fpos flen fkind rx-slot rx-gen fn2-core)
         (mv :no-row *fn2-none* 0 fn2-core)))
     (fn2-core-preserves fn2-ctl-dispatch-cns (ctl ctl-gen request fpos flen fkind rx-slot rx-gen fn2-core)
       :position 3 :rows nil)
     (in-theory (disable fn2-ctl-dispatch-cns))
     (defun fn2-cns-lookup-cursor (pfront0 fn2-core)
       (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
       (mv-let (code pfront) (fn2-successor-published fn2-core)
         (let ((pf (if (eq code :ok) (max (nfix pfront0) (nfix pfront)) (nfix pfront0))))
           (mv :ok (if (unsigned-byte-p 60 pf) pf 0)))))
     (defthm fn2-cns-lookup-cursor-natp
       (natp (mv-nth 1 (fn2-cns-lookup-cursor pfront0 fn2-core)))
       :rule-classes :type-prescription)
     (in-theory (disable fn2-cns-lookup-cursor))
     (defun fn2-cns-post-reply (ctl ctl-gen request outcome reason cpos pfront count more tx-slot tx-gen tx-len fn2-core)
       (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                       :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
       (if (not (and (eq (fn2-ctl-snapshot-read-code ctl fn2-core) :ok)
                     (equal (fn2-machine-generation ctl fn2-core) ctl-gen)
                     (equal (fn2-ctl-row-request ctl fn2-core) request)
                     (equal (fn2-ctl-row-phase ctl fn2-core) *fn2-ctl-state-waiting*)
                     (unsigned-byte-p 32 tx-len)))
           (mv :dropped fn2-core)
         (let* ((fn2-core (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
                            (fn2-pool)
                            (fn2-cns-encode-reply-pool tx-slot tx-gen *fn2-ctl-kind* ctl ctl-gen
                                                       outcome reason cpos pfront count more fn2-pool)
                            fn2-core))
                (fn2-core (fn2-machine-write-tx-off ctl 0 fn2-core))
                (fn2-core (fn2-machine-write-tx-len ctl tx-len fn2-core)))
           (mv :ok fn2-core))))
     (fn2-core-preserves fn2-cns-post-reply
       (ctl ctl-gen request outcome reason cpos pfront count more tx-slot tx-gen tx-len fn2-core)
       :position 1 :rows nil :hints (("Goal" :in-theory (enable fn2-core-wfp))))
     (in-theory (disable fn2-cns-post-reply))
     (defun fn2-cns-core-stream-wake (batch fn2-core)
       (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                       :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
       (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))
                   (fn2-succ-slots (fn2-core-succ-slots fn2-core))
                   (fn2-id-decides (fn2-core-id-decides fn2-core))
                   (fn2-fields (fn2-core-fields fn2-core))
                   (fn2-fc (fn2-core-fc fn2-core))
                   (fn2-cns-edges (fn2-core-cns-edges fn2-core)))
         (code fn2-cns-edges)
         (fn2-cns-stream-wake-loop (fn2-succ-slots-rows fn2-succ-slots) batch 0
                                   fn2-succ-txns fn2-succ-slots fn2-id-decides fn2-fields fn2-fc fn2-cns-edges)
         (mv code fn2-core)))
     (fn2-core-preserves fn2-cns-core-stream-wake (batch fn2-core)
       :position 1 :rows nil :hints (("Goal" :in-theory (enable fn2-core-wfp))))
     (defattach (fn2-commit-stream-wake fn2-cns-core-stream-wake)
       :hints (("Goal" :in-theory (enable fn2-cns-core-stream-wake))))
     (in-theory (disable fn2-cns-core-stream-wake))
     (defmachine-arms fn2-ctl)
     (defmachine-run fn2-ctl)
     (defmachine-arms fn2-cns)
     (defmachine-run fn2-cns)))


;; fn2-ctl: the L carrier on the :local listener (e-continuation E.P1).
(defmachine-arms fn2-ctl :declare
 :arms
 ((:free (:idle))
  (:greeting
   (:if (fn2-ctl-owner-core-p row-peer-family row-peer-w0)
        ;; an owner connection administers, as the persisted owner principal,
        ;; until it binds to a named one (AUTHORITY-20261105 section 1)
        ((:do (pcode pid) (fn2-ctl-owner-principal) :accept (:ok :absent)
          :why "a profile with no owner slot below the system row has no owner principal")
         (:set (owner 1) (principal pid) (admin 1) (worked 0) (fill 0) (pos 0)) (:next :frame)
         (:charge :steps *fn2-work-transition* :runnable t))
        ((:next :closing) (:charge :steps *fn2-work-transition* :runnable t))))
  ;; :frame opens the FNCT frame received so far (one frame per receive
  ;; window): a prefix receives more at the fill; a control command (kind
  ;; 1) steps the posture and answers it in kind 2 (stop closes); a request
  ;; (kind 4) is dispatched with its payload [10, 10+plen) and its code; any
  ;; other frame, or one that cannot fit, closes the connection.
  (:frame
   (:cond ((not (equal row-pending 0)) (:charge :steps *fn2-work-empty*))
          ((< 0 row-flen)
           (:do (ocode okind oplen oval) (fn2-ctl-open-frame id row-generation row-rx-slot row-rx-gen)
            :accept (:ok :need-more :size :frame :bounds) :why "a received frame is a prefix, or refused by closing")
           (:cond ((eq ocode :need-more) (:set (flen 0)) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
                  ((eq ocode :size)
                   (:do (sc op alen start remaining) (fn2-ctl-stream-begin id row-generation row-rx-slot row-rx-gen)
                    :accept (:ok :need-more :frame :bounds) :why "the following bounded stream dispatch waits or closes on refusal and never accepts a provisional frame as complete")
                   (:cond ((eq sc :need-more) (:set (flen 0))
                           (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
                          ((eq sc :ok)
                           (:set (sphase *fn2-ctl-stream-hash*) (swindow 0) (sremaining remaining) (shash 0)
                                 (sstart start) (send 0) (sack 0) (strailer 0) (sop op) (slength alen)
                                 (request (+ 1 row-request)) (cns *fn2-none*) (cns-gen 0) (tx-off 0) (tx-len 0))
                           (:next :stream) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
                          (t (:next :closing) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))))
                  ((not (eq ocode :ok)) (:next :closing) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
                  ((or (equal okind *fn2-fnct-request-kind*) (equal okind *fn2-authority-request-kind*))
                   ;; a kind 4 request's FKIND is its code (every code below 29); an
                   ;; authority request's (kind 29) is its kind
                   (:set (pos *fn2-fnct-header-octets*) (flen oplen)
                         (fkind (if (equal okind *fn2-fnct-request-kind*) oval *fn2-authority-request-kind*))
                         (request (+ 1 row-request)))
                   (:next :dispatch) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
                  ((not (equal okind *fn2-fnct-control-kind*))
                   (:next :closing) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
                  ((equal (fn2-ctl-step-posture oval row-posture) *fn2-ctl-posture-stopped*)
                   (:set (cmd oval) (posture *fn2-ctl-posture-stopped*) (flen 0))
                   (:next :closing) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
                  (t (:do (pcode pk ptotal) (fn2-ctl-post-posture id row-generation row-rx-slot row-rx-gen
                                                                 (fn2-ctl-step-posture oval row-posture))
                      :case (((:ok) (:set (cmd oval) (posture (fn2-ctl-step-posture oval row-posture)) (flen 0)
                                          (request (+ 1 row-request)) (tx-off pk) (tx-len (+ pk ptotal)))
                                    (:next :reply) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
                             (:otherwise (:next :closing) (:charge :steps *fn2-work-transition* :runnable t)))))))
          ((not (and (natp budget) (< 0 budget))) (:charge :steps *fn2-work-poll* :runnable t))
          ((not (eq (fn2-machine-pool-capacity-read-code row-rx-slot) :ok)) (:stop :machine-phase))
          ((<= (min *fn2-ctl-io-bytes* (fn2-machine-pool-capacity row-rx-slot)) row-fill)
           (:next :closing) (:charge :steps *fn2-work-transition* :runnable t))
          (t (:do (rcode cap) (fn2-ctl-receive-cap id row-generation row-rx-slot row-rx-gen row-fill)
              :accept (:ok :frame :bounds))
             (:if (and (eq rcode :ok) (natp cap) (< 0 cap) (<= cap *fn2-ctl-io-bytes*))
              ((:issue (fn2-issue-receive row-cap-index row-cap-nonce row-rx-slot row-rx-gen cap
                                        :principal row-principal-slot)
                :ok ((:wait :completion :bytes (+ 128 cap)))))
              ((:next :closing) (:charge :bytes 128 :steps *fn2-work-transition* :runnable t))))))
  ;; One current RX loan, shared sequentially by frame hashing and the
  ;; tentative upload consumer. No refill until both cursors relinquish it.
  (:stream :on-refusal ((:stop :machine-phase))
   (:cond
    ((not (equal row-pending 0)) (:charge :steps *fn2-work-empty*))
    ((equal row-sphase *fn2-ctl-stream-hash*)
     (:if (equal row-fill 0)
       ((:let cap (min *fn2-ctl-io-bytes* (+ row-sremaining 32)))
        (:issue (fn2-issue-receive row-cap-index row-cap-nonce row-rx-slot row-rx-gen cap
                                  :principal row-principal-slot)
         :ok ((:wait :completion :bytes cap))))
       ((:let n (min (min 4096 row-sremaining) (nfix (- row-fill row-shash))))
        (:do (hc copied) (fn2-ctl-stream-hash id row-generation row-rx-slot row-rx-gen row-shash n
                                                (equal n row-sremaining))
         :accept (:ok :more :bounds)
         :why "bounded physical pool hash; any invalid span closes")
        (:if (and (member-eq hc '(:ok :more)) (< 0 copied) (<= copied n))
          ((:let next-hash (+ row-shash copied)) (:let remaining (- row-sremaining copied))
           (:set (shash next-hash) (sremaining remaining))
           (:if (or (equal next-hash row-fill) (equal remaining 0))
            ((:set (send next-hash) (sack 0) (sphase *fn2-ctl-stream-feed*))
             (:wake-row row-cns)) ())
           (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
          ((:set (sphase *fn2-ctl-stream-bad*)) (:wake-row row-cns) (:next :closing)
           (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))))))
    ((equal row-sphase *fn2-ctl-stream-feed*)
     (:cond
      ((equal row-cns *fn2-none*)
       (:do (code child cgen) (fn2-ctl-dispatch-cns id row-generation row-request row-sstart row-slength
                                                  11 row-rx-slot row-rx-gen)
        :case (((:ok) (:set (cns child) (cns-gen cgen) (worked 1))
                      (:charge :steps *fn2-work-transition*))
               (:otherwise (:set (sphase *fn2-ctl-stream-bad*)) (:next :closing)
                           (:charge :steps *fn2-work-transition* :runnable t)))))
      ((equal row-sack 0) (:charge :steps *fn2-work-empty*))
      ((equal row-sremaining 0)
       (:set (sphase *fn2-ctl-stream-trailer*))
       (:charge :steps *fn2-work-transition* :runnable t))
      ((not (eq (fn2-machine-pool-borrows-read-code row-rx-slot) :ok)) (:stop :machine-phase))
      ((not (equal (fn2-machine-pool-borrows row-rx-slot) 0))
       (:charge :steps *fn2-work-poll*))
      (t (:do (code) (fn2-core-reset row-rx-slot row-rx-gen) :accept (:ok))
         (:set (fill 0) (flen 0) (shash 0) (sstart 0) (send 0) (sack 0)
               (swindow (+ 1 row-swindow)) (sphase *fn2-ctl-stream-hash*))
         (:charge :steps *fn2-work-transition* :runnable t))))
    ((equal row-sphase *fn2-ctl-stream-trailer*)
     (:cond
      ((equal row-fill 0)
       (:let cap (- 32 row-strailer))
       (:issue (fn2-issue-receive row-cap-index row-cap-nonce row-rx-slot row-rx-gen cap
                                 :principal row-principal-slot)
        :ok ((:wait :completion :bytes cap))))
      ((equal row-shash row-fill)
       (:if (and (eq (fn2-machine-pool-borrows-read-code row-rx-slot) :ok)
                 (equal (fn2-machine-pool-borrows row-rx-slot) 0))
        ((:do (code) (fn2-core-reset row-rx-slot row-rx-gen) :accept (:ok))
         (:set (fill 0) (flen 0) (shash 0))
         (:charge :steps *fn2-work-transition* :runnable t))
        ((:charge :steps *fn2-work-poll*))))
      (t (:do (tc copied) (fn2-ctl-stream-trailer id row-generation row-strailer row-rx-slot row-rx-gen
                                                 row-shash row-fill)
          :accept (:verified :more :frame :bounds) :why "the following bounded stream dispatch waits or closes on refusal and never accepts a provisional frame as complete")
         (:cond
          ((and (eq tc :verified)
                (equal (+ row-shash copied) row-fill)
                (eq (fn2-machine-pool-borrows-read-code row-rx-slot) :ok)
                (not (equal (fn2-machine-pool-borrows row-rx-slot) 0)))
           (:charge :bytes 32 :steps *fn2-work-poll*))
          ((eq tc :verified)
           (:if (and (equal (+ row-shash copied) row-fill)
                     (eq (fn2-machine-pool-borrows-read-code row-rx-slot) :ok)
                     (equal (fn2-machine-pool-borrows row-rx-slot) 0))
            ((:do (code) (fn2-core-reset row-rx-slot row-rx-gen) :accept (:ok))
             (:set (fill 0) (flen 0) (pos 0) (shash 0) (sstart 0) (send 0)
                   (strailer 32) (sphase *fn2-ctl-stream-verified*))
             (:next :waiting) (:wake-row row-cns)
             (:charge :bytes 32 :steps *fn2-work-transition*))
            ((:set (sphase *fn2-ctl-stream-bad*)) (:wake-row row-cns) (:next :closing)
             (:charge :bytes 32 :steps *fn2-work-transition* :runnable t))))
          ((and (eq tc :more) (< 0 copied))
           (:set (strailer (+ row-strailer copied)) (shash (+ row-shash copied)))
           (:charge :bytes 32 :steps *fn2-work-transition* :runnable t))
          (t (:set (sphase *fn2-ctl-stream-bad*)) (:wake-row row-cns) (:next :closing)
             (:charge :steps *fn2-work-transition* :runnable t))))))
    (t (:set (sphase *fn2-ctl-stream-bad*)) (:wake-row row-cns) (:next :closing)
       (:charge :steps *fn2-work-transition* :runnable t))))
  (:dispatch
   (:cond ((equal row-posture *fn2-ctl-posture-stopped*)
           (:next :closing) (:charge :steps *fn2-work-transition* :runnable t))
          ((equal row-fkind *fn2-authority-request-kind*)
           (:do (tcode aid agen) (fn2-ctl-dispatch-auth id row-generation row-request row-pos row-flen
                                                        row-rx-slot row-rx-gen row-admin row-worked row-principal)
            :case (((:ok) (:set (auth aid) (auth-gen agen) (tx-off 0) (tx-len 0))
                          (:next :waiting) (:charge :steps *fn2-work-transition*))
                   ((:none) (:next :closing) (:charge :steps *fn2-work-transition* :runnable t))
                   (:otherwise (:next :closing) (:charge :steps *fn2-work-transition* :runnable t)))))
          (t (:do (tcode cid cgen) (fn2-ctl-dispatch-cns id row-generation row-request row-pos row-flen
                                                         row-fkind row-rx-slot row-rx-gen)
              :case (((:ok) (:set (cns cid) (cns-gen cgen) (worked 1) (tx-off 0) (tx-len 0))
                            (:next :waiting) (:charge :steps *fn2-work-transition*))
                     ;; no consumer request rows in the profile: the frame is not served
                     ((:none) (:next :closing) (:charge :steps *fn2-work-transition* :runnable t))
                     (:otherwise (:next :closing) (:charge :steps *fn2-work-transition* :runnable t)))))))
  ;; SEND borrows only CTL staging. The source retains its checked lease until
  ;; the complete trailer has returned, even after every byte has been copied.
  (:stream-reply :on-refusal ((:stop :machine-phase))
   (:cond
    ((not (equal row-pending 0)) (:charge :steps *fn2-work-empty*))
    ((not (eq (fn2-machine-pool-borrows-read-code row-rx-slot) :ok)) (:stop :machine-phase))
    ((not (equal (fn2-machine-pool-borrows row-rx-slot) 0)) (:charge :steps *fn2-work-poll*))
    ((fn2-core-query-heldp row-rx-slot row-rx-gen) (:charge :steps *fn2-work-poll*))
    ((not (and (natp budget) (< 0 budget))) (:charge :steps *fn2-work-poll* :runnable t))
    ((equal row-ophase *fn2-ctl-output-prefix*)
     (:do (reset) (fn2-core-reset row-rx-slot row-rx-gen) :accept (:ok))
     (:do (code end) (fn2-ctl-stream-output-prefix id row-generation row-ototal row-rx-slot row-rx-gen)
      :accept (:ok :bounds :size) :why "the following bounded stream dispatch waits or closes on refusal and never accepts a provisional frame as complete")
     (:if (and (eq code :ok) (unsigned-byte-p 32 end) (<= end *fn2-ctl-io-bytes*))
      ((:set (fill end) (shash 0) (tx-off 0) (tx-len 0) (ophase *fn2-ctl-output-fill*))
       (:charge :bytes 128 :steps *fn2-work-transition* :runnable t))
      ((:next :closing) (:charge :bytes 128 :steps *fn2-work-transition* :runnable t))))
    ((equal row-ophase *fn2-ctl-output-fill*)
     (:if (<= *fn2-ctl-io-bytes* row-fill)
      ((:set (ophase *fn2-ctl-output-hash*)) (:charge :steps *fn2-work-transition* :runnable t))
      ((:let cap (min (min 1024 row-oleft) (- *fn2-ctl-io-bytes* row-fill)))
       (:do (code copied eof)
        (fn2-cns-stream-source-next row-cns row-cns-gen id row-generation row-request
                                   row-rx-slot row-rx-gen row-fill cap)
        :accept (:ok :wait :bad) :why "wait retains the source; bad closes the provisional frame; only checked EOF permits a trailer")
       (:cond
        ((eq code :wait) (:wake-row row-cns) (:charge :bytes *fn2-cns-source-next-cost* :steps *fn2-work-transition*))
        ((and (eq code :ok) (natp copied) (<= copied cap)
              (or (< 0 copied) eof) (or (not eof) (equal copied row-oleft)))
         (:let left (- row-oleft copied)) (:let fill (+ row-fill copied))
         (:set (oleft left) (fill fill) (ochecked (if eof 1 0)))
         (:if (or eof (equal fill *fn2-ctl-io-bytes*)) ((:set (ophase *fn2-ctl-output-hash*))) ())
         (:charge :bytes *fn2-cns-source-next-cost* :steps *fn2-work-transition* :runnable t))
        (t (:next :closing) (:charge :bytes *fn2-cns-source-next-cost* :steps *fn2-work-transition* :runnable t))))))
    ((equal row-ophase *fn2-ctl-output-hash*)
     (:do (code copied) (fn2-ctl-stream-hash id row-generation row-rx-slot row-rx-gen 0 row-fill
                                           (equal row-ochecked 1)) :accept (:ok :more :bounds) :why "the following bounded stream dispatch waits or closes on refusal and never accepts a provisional frame as complete")
     (:if (and (eq code :ok) (equal copied row-fill))
      ((:set (tx-off 0) (tx-len row-fill) (ophase *fn2-ctl-output-send*))
       (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
      ((:next :closing) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))))
    ((member-equal row-ophase (list *fn2-ctl-output-send* *fn2-ctl-output-last*))
     (:cond
      ((< row-tx-off row-tx-len)
       (:let count (min *fn2-ctl-io-bytes* (nfix (- row-tx-len row-tx-off))))
       (:issue (fn2-issue-send row-cap-index row-cap-nonce row-rx-slot row-rx-gen row-tx-off count 1
                               :principal row-principal-slot)
        :ok ((:set (borrows 1)) (:wait :completion :bytes count))))
      ((equal row-ophase *fn2-ctl-output-last*)
       (:set (ophase *fn2-ctl-output-done*)) (:charge :steps *fn2-work-transition* :runnable t))
      (t (:do (reset) (fn2-core-reset row-rx-slot row-rx-gen) :accept (:ok))
         (:set (fill 0) (tx-off 0) (tx-len 0)
               (ophase (if (equal row-ochecked 1) *fn2-ctl-output-trailer* *fn2-ctl-output-fill*)))
         (:charge :steps *fn2-work-transition* :runnable t))))
    ((equal row-ophase *fn2-ctl-output-trailer*)
     ;; This state is reachable only after checked EOF and final BLAKE3 update.
     (:do (code) (fn2-ctl-stream-output-trailer id row-generation row-rx-slot row-rx-gen) :accept (:ok :bounds) :why "the following bounded stream dispatch waits or closes on refusal and never accepts a provisional frame as complete")
     (:if (eq code :ok)
      ((:set (tx-off 0) (tx-len 32) (ophase *fn2-ctl-output-last*))
       (:charge :bytes 32 :steps *fn2-work-transition* :runnable t))
      ((:next :closing) (:charge :bytes 32 :steps *fn2-work-transition* :runnable t))))
    ((equal row-ophase *fn2-ctl-output-done*)
     (:do (code) (fn2-cns-stream-source-finish row-cns row-cns-gen id row-generation row-request)
      :accept (:ok :wait :stale) :why "wait retains ownership; the following dispatch handles checked handback or a stale transport tuple")
     (:cond ((eq code :wait) (:wake-row row-cns) (:charge :steps *fn2-work-transition*))
            ((eq code :ok)
             ;; The source marks handback; CNS releases its own lease through
             ;; its declared actor transition after this checked wake.
             (:wake-row row-cns)
             (:do (reset) (fn2-core-reset row-rx-slot row-rx-gen) :accept (:ok))
             (:set (fill 0) (pos 0) (flen 0) (cns *fn2-none*) (cns-gen 0)
                   (tx-off 0) (tx-len 0) (ophase *fn2-ctl-output-none*) (sphase *fn2-ctl-stream-none*))
             (:next :frame) (:charge :steps *fn2-work-transition* :runnable t))
            (t (:next :closing) (:charge :steps *fn2-work-transition* :runnable t))))
    (t (:next :closing) (:charge :steps *fn2-work-transition* :runnable t))))
  (:waiting
   (:if (< 0 row-tx-len)
        ((:set (cns *fn2-none*) (cns-gen 0) (auth *fn2-none*) (auth-gen 0)) (:next :reply)
         (:charge :steps *fn2-work-transition* :runnable t))
        ((:charge :steps *fn2-work-empty*))))
  (:reply
   (:cond ((not (equal row-pending 0)) (:charge :steps *fn2-work-empty*))
          ((not (equal row-borrows 0)) (:charge :steps *fn2-work-poll*))
          ((>= row-tx-off row-tx-len)
           (:do (code) (fn2-core-reset row-rx-slot row-rx-gen)
            :case (((:ok) (:set (pos 0) (fill 0) (flen 0) (cmd 0) (fkind 0) (sphase *fn2-ctl-stream-none*) (tx-off 0) (tx-len 0))
                          (:next :frame) (:charge :steps *fn2-work-transition* :runnable t))
                   (:otherwise (:set (pos 0) (fill 0) (flen 0) (cmd 0) (fkind 0) (sphase *fn2-ctl-stream-none*) (tx-off 0) (tx-len 0))
                               (:next :closing) (:charge :steps *fn2-work-transition* :runnable t)))))
          ((not (and (natp budget) (< 0 budget))) (:charge :steps *fn2-work-poll* :runnable t))
          (t (:let len (min *fn2-ctl-io-bytes* (nfix (- row-tx-len row-tx-off))))
             (:issue (fn2-issue-send row-cap-index row-cap-nonce row-rx-slot row-rx-gen row-tx-off len 1
                                     :principal row-principal-slot)
              :ok ((:set (borrows 1)) (:wait :completion :bytes len))))))
  (:closing
   (:cond ((or (not (member-equal row-sphase (list *fn2-ctl-stream-none* *fn2-ctl-stream-cancelled*)))
                     (not (member-equal row-ophase (list *fn2-ctl-output-none* *fn2-ctl-output-cancelled*))))
           (:set (sphase *fn2-ctl-stream-cancelled*) (ophase *fn2-ctl-output-cancelled*)) (:wake-row row-cns)
           (:charge :steps *fn2-work-transition* :runnable t))
          ((not (equal row-pending 0)) (:charge :steps *fn2-work-empty*))
          ((not (and (natp budget) (< 0 budget))) (:charge :steps *fn2-work-poll* :runnable t))
          (t (:issue (fn2-issue-close row-cap-index row-cap-nonce :principal row-principal-slot)
              :ok ((:wait :completion :bytes 0))))))
  (:draining
   (:cond ((not (equal row-pending 0)) (:charge :steps *fn2-work-empty*))
          ((not (equal row-borrows 0)) (:charge :steps *fn2-work-poll*))
          ((fn2-ctl-stream-child-live-p row-cns row-cns-gen)
           ;; A source can retain claims before either stream phase starts.
           ;; Its Read may return while Close is pending and observe :aborting.
           ;; Every terminal Close/loan wake must therefore notify the checked
           ;; live child, including pre-prefix sources with both phases NONE.
           (:wake-row row-cns)
           (:charge :steps *fn2-work-empty*))
          (t (:do (rcode) (fn2-core-release row-rx-slot row-rx-gen) :effects ((:release (:rx-range)))
              :accept (:ok :retired) :why "a retired range is a completed release (the pool retires the slot)"
              :case ((:otherwise (:stop :pool-release :steps *fn2-work-state*))))
             (:let next (fn2-machine-free-head *fn2-ctl-admission-ordinal*))
             (:let retire (>= row-generation (fn2-machine-gen-limit)))
             (:set (generation (if retire row-generation (+ 1 row-generation)))
                   (rx-slot *fn2-none*) (rx-gen 0) (tx-slot *fn2-none*) (tx-gen 0)
                   (cap-index 0) (cap-nonce 0) (cns *fn2-none*) (cns-gen 0) (auth *fn2-none*) (auth-gen 0)
                   (next-free next) (wait-reason *fn2-wait-none*))
             (:next (:if retire :retired :free))
             (:do () (fn2-machine-reclaim id *fn2-ctl-admission-ordinal* retire))
             (:charge :steps *fn2-work-release*))))
  (:retired (:idle)))
 :observes
 ((:receive-result :from (:frame :stream)
   (:if (and (or (equal outcome *fn2-outcome-done*) (equal outcome *fn2-outcome-short*))
             (unsigned-byte-p 32 count) (< 0 count) (unsigned-byte-p 32 (+ row-fill count)))
        ((:set (fill (+ row-fill count)) (flen count) (pos 0)) (:wake))
        ((:set (sphase *fn2-ctl-stream-bad*))
         (:next :closing) (:wake))))
  (:send-result :from (:reply :stream-reply)
   (:if (not (eq (fn2-machine-pool-borrows-read-code row-rx-slot) :ok))
        ((:stop :machine-observation))
        ((:let off row-tx-off) (:let len row-tx-len)
         (:set (borrows (fn2-machine-pool-borrows row-rx-slot)))
         (:if (and (or (equal outcome *fn2-outcome-done*) (equal outcome *fn2-outcome-short*))
                   (natp count) (< 0 count) (<= (+ off count) len))
              ((:set (tx-off (+ off count))) (:wake))
              ((:next :closing) (:wake))))))
  (:borrow-released :from (:stream :stream-reply :waiting :reply :closing :draining)
   (:if (not (eq (fn2-machine-pool-borrows-read-code row-rx-slot) :ok))
        ((:stop :machine-observation))
        ((:set (borrows (fn2-machine-pool-borrows row-rx-slot))) (:wake))))
  (:close-result :from (:closing) (:next :draining) (:wake))))

;; ---------------------------------------------------------------------------
;; fn2-cns: one consumer request; a parked wait is this row parked on its edge.
(defmachine-arms fn2-cns :declare
 :subarms
 (  (decode-request :on-refusal ((:stop :machine-phase))
   (:do (dcode dreason nverb ncid ncstart nto nlim nepoch nwait nop nfstart nnoff nnlen)
        (fn2-cns-decode-port row-fpos row-flen row-fkind row-address-principal
                             row-ctl row-ctl-gen row-tx-slot row-tx-gen row-xrow)
    :accept (:ok :refused) :why "a request that does not decode is answered refused")
   (:if (eq dcode :ok)
        ((:set (verb nverb) (consumer ncid) (cstart ncstart) (to nto) (page-limit nlim) (epoch nepoch)
               (wait-ms nwait) (op nop) (fstart nfstart) (name-off nnoff) (name-len nnlen))
         (:next :check) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
        ((:set (reason dreason)) (:goto refuse))))
  (replay-match :on-refusal ((:stop :machine-phase))
   (:cond ((equal row-posted-word *fn2-upload-word-accepted*)
           (:set (outcome *fn2-cns-outcome-accepted*)) (:goto answer))
          ((equal row-posted-word *fn2-upload-word-conflict*)
           (:set (posted *fn2-cns-posted-accepted*) (reason *fn2-upload-word-conflict*)) (:goto refuse))
          (t (:stop :machine-phase))))
  (replay-changed :on-refusal ((:stop :machine-phase))
   (:set (reason *fn2-upload-word-operation-reused*)) (:goto refuse))
  (append-refuse :on-refusal ((:stop :machine-phase))
   (:if (equal row-stream 1) ((:set (feed-discard 1)) (:goto stream-feed)) ((:goto refuse))))
  (replay-input :on-refusal ((:stop :machine-phase))
   (:do (code) (fn2-cns-replay-begin id row-generation row-ctl row-ctl-gen row-request)
    :accept (:ok :unavailable)
    :why "a failed hasher initialization still drains a streaming frame before refusing")
   (:set (fed 0) (feed-mode 0) (feed-discard (if (eq code :ok) 0 1)))
   (:if (eq code :ok) () ((:set (reason *fn2-upload-word-unavailable*))))
   (:next :replay) (:charge :steps *fn2-work-transition* :runnable t))
  (stream-feed :on-refusal ((:stop :machine-phase))
   (:do (status start mode why copied)
        (fn2-cns-feed-stream row-fstart row-feed-mode row-feed-discard row-fed row-flen
                             row-ctl row-ctl-gen row-request
                             (if (equal row-posted *fn2-cns-posted-none*) row-upload *fn2-none*) row-upload-gen)
    :accept (:budget :loan :wait :done :bad :bounds)
    :why "a bounded window, an acknowledged loan, a transport wait, an authenticated end, or transport cancellation")
   (:let nfed (+ row-fed (nfix copied)))
   (:if (not (and (unsigned-byte-p 32 start) (unsigned-byte-p 8 mode) (unsigned-byte-p 8 why)
                  (unsigned-byte-p 60 nfed) (<= nfed row-flen)))
        ((:stop :machine-phase))
        ((:set (fstart start) (fed nfed) (feed-mode mode) (feed-discard why))
         (:case status
          ((:bounds) (:stop :machine-phase))
          ((:wait) (:charge :bytes *fn2-conn-feed-cost* :steps *fn2-work-transition*))
          ((:done)
           (:if (equal row-upload *fn2-none*)
                ((:goto refuse))
                ((:set (feed-mode *fn2-conn-feed-done*))
                 (:if (fn2-cns-stream-upload-live-p row-upload row-upload-gen) ((:wake-row row-upload)) ())
                 (:charge :bytes *fn2-conn-feed-cost* :steps *fn2-work-transition*))))
          ((:bad)
           (:if (equal row-upload *fn2-none*)
                ((:goto cancel))
                ((:set (feed-mode *fn2-conn-feed-done*) (feed-discard 1))
                 (:if (fn2-cns-stream-upload-live-p row-upload row-upload-gen) ((:wake-row row-upload)) ())
                 (:charge :bytes *fn2-conn-feed-cost* :steps *fn2-work-transition*))))
          (:otherwise
           (:if (fn2-cns-stream-upload-live-p row-upload row-upload-gen) ((:wake-row row-upload)) ())
           (:charge :bytes *fn2-conn-feed-cost* :steps *fn2-work-transition* :runnable (eq status :budget)))))))
 (hand :on-refusal ((:stop :machine-phase))
   (:cond
    ((equal row-lease *fn2-cns-lease-held*)
             (:do (lc) (fn2-cns-lease-release row-lslot row-lgen) :effects ((:release (:storage-window))) :accept (:ok :retired)
              :why ":retired: the lease's slot reached its generation limit and leaves the pool")
             (:set (lease *fn2-cns-lease-none*) (lslot *fn2-none*) (lgen 0))
             (:charge :steps *fn2-work-transition* :runnable t))
    (t
   ;; WITHDRAWN exposes the state of the addressed article. A revocation
   ;; during article lookup must turn it into the same refusal as absence.
   (:let withdrawn (and (equal row-verb *fn2-cns-verb-fetch*)
                         (equal row-outcome *fn2-cns-outcome-refused*)
                         (equal row-reason *fn2-cns-reason-withdrawn*)))
   (:do (acode astep ahead agrant)
        (fn2-cns-authority-allows id row-generation *fn2-cns-right-read* *fn2-cns-scope-stream*
                                  row-istream row-xstep row-xhead row-xgrant 4096)
    :when withdrawn :else (:ok 0 0 0)
    :accept (:ok :access :state) :why "a denied or stale read check hides the withdrawal as unavailable"
    :case (((:more) (:set (xstep astep) (xhead ahead) (xgrant agrant))
            (:next :fetch-authorize)
            (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))))
   (:let reply-reason (if (eq acode :ok) row-reason *fn2-cns-reason-unavailable*))
   (:do (pcode) (fn2-cns-post-reply row-ctl row-ctl-gen row-request row-verb row-outcome reply-reason
                                    row-consumer row-epoch row-version row-stored-view row-cpos row-pub-frontier row-count row-more
                                    row-ioff row-ilen row-visible-ipos
                                    row-tx-slot row-tx-gen
                                    id row-generation row-ns-slot row-ns-gen row-name-len)
    :accept (:ok :dropped) :why "the control connection may have closed while the consumer request ran")
   (:wake-row row-ctl)
   (:next :draining)
   (:charge :bytes (+ 2048 (if withdrawn 4096 0)
                      (if (equal row-phase *fn2-cns-state-page-authorize*) 4096 0))
            :steps *fn2-work-transition* :runnable t))))
  (wait-timeout :on-refusal ((:stop :machine-phase))
   (:set (edge *fn2-none*) (count 0) (more 0) (outcome *fn2-cns-outcome-accepted*))
   (:goto answer))
  (answer :on-refusal ((:stop :machine-phase))
   (:if (and (equal row-outcome *fn2-cns-outcome-accepted*)
             (or (equal row-verb *fn2-cns-verb-read*) (equal row-verb *fn2-cns-verb-wait*)
                 (and (equal row-verb *fn2-cns-verb-ack*) (equal row-wstep 0))))
        ((:set (xstep 0)) (:next :page-authorize)
         (:charge :steps *fn2-work-transition* :runnable t))
        ((:goto finalize))))
  (finalize :on-refusal ((:stop :machine-phase))
   (:do (timer-clear) (fn2-cns-clear-wait-timer id) :accept (:ok))
   (:set (deadline 0) (wait-reason *fn2-wait-none*))
   (:goto hand))
  (refuse :on-refusal ((:stop :machine-phase))
   (:set (outcome *fn2-cns-outcome-refused*))
   (:goto answer))
  (cancel :on-refusal ((:stop :machine-phase))
   ;; APPEND owns its exact-read row until either lookup finishes or the
   ;; request generation leaves. A disconnected/reused CTL cannot strand it.
   (:if (and (equal row-phase *fn2-cns-state-append*) (posp row-op) (posp row-address-principal))
        ((:do (rc) (fn2-cns-release-append-outcome id row-generation row-request row-address-principal row-op)
          :accept (:ok))) ())
   (:cond
    ((fn2-cns-source-boundp id row-generation row-ctl row-ctl-gen row-request)
     (:do () (fn2-cns-stream-source-abort id row-generation row-ctl row-ctl-gen row-request))
     (:next :source) (:charge :steps *fn2-work-transition* :runnable t))
    ((equal row-lease *fn2-cns-lease-held*)
           (:do (lc) (fn2-cns-lease-release row-lslot row-lgen) :effects ((:release (:storage-window))) :accept (:ok :retired)
            :why ":retired: the lease's slot reached its generation limit and leaves the pool")
           (:set (lease *fn2-cns-lease-none*) (lslot *fn2-none*) (lgen 0))
           (:charge :steps *fn2-work-transition* :runnable t))
    (t (:next :draining) (:charge :steps *fn2-work-transition* :runnable t))))
  ;; Successful single-reply FETCH is unreachable-in-composition.
  ;; The legacy helper checks the request's Message-ID and puts octets after the
  ;; request (the reply's scratch); otherwise unavailable
  (put-article :on-refusal ((:stop :machine-phase))
   (:do (pc at nl) (fn2-cns-put-article row-npos row-art row-alen row-istream row-pub-frontier row-name-off row-name-len
                                        row-lslot row-lgen *fn2-cns-kind* id row-generation
                                        row-tx-slot row-tx-gen row-ctl row-ctl-gen row-xrow)
    :accept (:ok :absent :full :dropped :fault)
    :why ":absent: the occurrence's Message-ID is not the request's; :full: its octets do not fit the reply; :dropped: the control connection closed; :fault: the store contradicts its own rows")
   (:case pc
    ((:ok) (:set (ipos row-npos) (count 1) (ioff at) (ilen nl))
           (:next :page) (:charge :bytes 4096 :steps *fn2-work-transition* :runnable t))
    ((:dropped) (:set (ctl *fn2-none*)) (:next :page) (:charge :steps *fn2-work-transition* :runnable t))
    (:otherwise (:set (reason *fn2-cns-reason-unavailable*) (outcome *fn2-cns-outcome-refused*)) (:next :page)
                (:charge :steps *fn2-work-transition* :runnable t))))
  ;; the item's octets after the page's items in the control range; :full
  ;; when not even its reference fits: the page ends before it (MORE)
  (put :on-refusal ((:stop :machine-phase))
   (:cond
    ((equal row-verb *fn2-cns-verb-fetch*) (:goto put-article))
    (t
   (:do (pc at nl) (fn2-cns-put-item row-itype row-npos row-art row-alen row-istream row-pub-frontier row-ilen
                                     row-lslot row-lgen *fn2-cns-kind* id row-generation
                                     row-tx-slot row-tx-gen row-ctl row-ctl-gen row-xrow)
    :accept (:ok :full :dropped :fault)
    :why ":dropped: the control connection closed while the page was read; :fault: the store contradicts its own rows")
   (:case pc
    ((:ok) (:set (ipos row-npos) (visible-ipos row-npos) (count (+ 1 row-count)) (ilen (+ row-ilen nl))

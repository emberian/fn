   (:if (and (or (equal outcome *fn2-outcome-done*) (equal outcome *fn2-outcome-short*))
             (unsigned-byte-p 32 count) (< 0 count) (unsigned-byte-p 32 (+ row-fill count)))
        ((:set (fill (+ row-fill count)) (flen count) (pos 0)) (:wake))
        ((:next :closing) (:wake))))

; The registry projection is emitted only after the actual kind declarations.
; It uses their SAME class grammar/resolver and is not a caller readiness flag.
(in-package "ACL2")
(include-book "checkpoint-working-credit")
(include-book "machines")
(fn2-book-layer :c)
(defun fn2-checkpoint-service-range-forms (specs)
 (declare (xargs :verify-guards nil :measure (len specs)))
 (if (atom specs) nil
  (cons (fn2-machine-class-form (fn2-arm-get :class (cdar specs)) 'fn2-pool)
        (fn2-checkpoint-service-range-forms (cdr specs)))))
(defun fn2-checkpoint-service-kind-form (kind face world)
 (declare (xargs :verify-guards nil))
 (let* ((decl (fn2-machine-property kind face world))
        (specs (fn2-machine-range-specs (fn2-arm-get :ranges decl))))
  (if (not decl)
      (er hard 'fn2-checkpoint-service-kind-form "Missing actual resource declaration ~x0/~x1." kind face)
   `(list ,@(fn2-checkpoint-service-range-forms specs)))))
(defmacro fn2-checkpoint-working-credit-init-events ()
 '(make-event
  (let* ((world (w state))
         (conn (fn2-checkpoint-service-kind-form 'fn2-conn :admission world))
         (ctl (fn2-checkpoint-service-kind-form 'fn2-ctl :admission world))
         (cns (fn2-checkpoint-service-kind-form 'fn2-cns :taken world))
         (uploads (fn2-checkpoint-service-kind-form 'fn2-upload :taken world)))
   (value
    `(progn
      (defun fn2-checkpoint-service-protocol-classes (fn2-pool)
       (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
       (list ,conn (append ,ctl ,cns)))
      (defun fn2-checkpoint-service-upload-classes (fn2-pool)
       (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
       ,uploads)
      (defun fn2-checkpoint-working-credit-init (profile fn2-core)
       (declare (xargs :stobjs fn2-core :guard (and (fn2-profilep profile) (fn2-core-wfp fn2-core))))
       (stobj-let ((fn2-commit (fn2-commit-table fn2-core))
                   (fn2-commit-io (fn2-core-commit-io fn2-core))
                   (fn2-pool (fn2-core-pool fn2-core)))
        (code fn2-pool)
        (fn2-checkpoint-working-credit-configure
         profile (fn2-commit-rows fn2-commit) (fn2-commit-io-rows fn2-commit-io)
         (fn2-checkpoint-service-protocol-classes fn2-pool)
         (fn2-checkpoint-service-upload-classes fn2-pool) fn2-pool)
        (mv code fn2-core)))
      (fn2-core-preserves fn2-checkpoint-working-credit-init (profile fn2-core)
       :position 1 :rows nil :hyps ((fn2-profilep profile))))))))

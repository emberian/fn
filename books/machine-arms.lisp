                                                `((value-triple (cw "~x0: no arm reaches the phases ~x1.~%" ',kind ',unreached)))))))
                              ,@sub-events ,@run-events ,@obs-events ,@gen-events)))))))))))))
; ----------------------------------------------------------------------
; P2 / Fable A1: a defcost with :child auto-emits its :core stobj-let face

; Raw-worker specialization of the same shared fixed capacity authority.
(in-package "ACL2")
(include-book "fixed-buffer-capacity")
(defun fn-wbc-slot-heldp (slot rows)
  (declare (xargs :guard t))
  (fn-bca-slot-heldp :worker-capacity slot rows))
(defun fn-wbc-tokenp (token)
  (declare (xargs :guard t))
  (and (eq (fn-prl-nth 0 token) :worker-capacity) (fn-bca-tokenp token)))
(defun fn-wbc-admit (slot demand ledger)
  (declare (xargs :guard t))
  (fn-bca-admit :worker-capacity (list slot) demand ledger))
(defun fn-wbc-promote-installed (token ledger)
  (declare (xargs :guard t))
  (if (fn-wbc-tokenp token) (fn-bca-promote-installed token ledger)
    (mv :stale-capacity ledger)))
(verify-guards fn-wbc-slot-heldp)
(verify-guards fn-wbc-tokenp)
(verify-guards fn-wbc-admit)
(verify-guards fn-wbc-promote-installed)

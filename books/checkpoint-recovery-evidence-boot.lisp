   :guard (and (fn2-boot-config-wfp fn2-boot-config) (fn2-checkpoint-recovery-evidence-wfp fn2-checkpoint-recovery-evidence)
               (natp left) (<= left 96) (natp dst) (<= (+ dst left) 96) (natp src) (<= (+ src left) 384))))
  (if (zp left) fn2-checkpoint-recovery-evidence
   (let ((fn2-checkpoint-recovery-evidence (update-fn2-checkpoint-recovery-evidence-bytesi dst
          (fn2-boot-config-anchor-evidencei src fn2-boot-config) fn2-checkpoint-recovery-evidence)))
    (fn2-boot-checkpoint-evidence-anchor-copy (- left 1) (+ dst 1) (+ src 1) fn2-boot-config fn2-checkpoint-recovery-evidence))))
 (fn2-checkpoint-recovery-evidence-preserves fn2-boot-checkpoint-evidence-anchor-copy

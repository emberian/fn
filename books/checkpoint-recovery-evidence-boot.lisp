                       (= (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-checked*)
                       (= (fn2-checkpoints-builder-token c fn2-checkpoints) 0)
                       (posp (fn2-checkpoints-anchor-mask c fn2-checkpoints))

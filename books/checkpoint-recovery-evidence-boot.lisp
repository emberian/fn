          (descriptor-allocation (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs))
          (descriptor-kind (fn2-checkpoint-refs-page-kind r fn2-checkpoint-refs))
          (descriptor-length (fn2-checkpoint-refs-encoded-length r fn2-checkpoint-refs)))))
     (mv :ok fn2-checkpoint-recovery-evidence)) (mv code fn2-core))))
 (fn2-core-preserves fn2-boot-checkpoint-evidence-begin (id ogen fn2-core) :position 1 :rows nil)

 (defun fn2-boot-checkpoint-evidence-target (id ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (if (not (fn2-boot-checkpoint-evidence-bound-p id ogen *fn2-boot-state-checkpoint-evidence-target* fn2-core)) (mv :state fn2-core)
   (stobj-let ((fn2-checkpoint-restore-arena (fn2-core-checkpoint-restore-arena fn2-core))
               (fn2-checkpoint-restore-arena-control (fn2-core-checkpoint-restore-arena-control fn2-core))
               (fn2-checkpoint-restore-map (fn2-core-checkpoint-restore-map fn2-core))
               (fn2-checkpoint-restore-map-control (fn2-core-checkpoint-restore-map-control fn2-core))
               (fn2-checkpoint-recovery-evidence (fn2-core-checkpoint-recovery-evidence fn2-core))
               (fn2-pool (fn2-core-pool fn2-core))) (code fn2-checkpoint-recovery-evidence fn2-pool)
    (b* (((unless (and (= (fn2-cpe phase) *fn2-checkpoint-recovery-evidence-phase-target*)
                       (< 0 (fn2-checkpoint-restore-arena-control-rows fn2-checkpoint-restore-arena-control))
                       (= (fn2-cpe tag) (fn2-checkpoint-restore-arena-control-tag 0 fn2-checkpoint-restore-arena-control))
                       (= (fn2-cpe total) (fn2-checkpoint-restore-arena-control-total 0 fn2-checkpoint-restore-arena-control))))
          (mv :state fn2-checkpoint-recovery-evidence fn2-pool))
         ((mv code e ep al) (fn2-checkpoint-restore-arena-target (fn2-cpe candidate) (fn2-cpe ordinal)
          fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-control fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control))
         ((when (eq code :end))
          (let* ((fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-set-phase (+ 1 (fn2-cpe candidate))
                   *fn2-checkpoint-recovery-evidence-phase-complete* fn2-checkpoint-recovery-evidence))
                 (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-set-phase 0
                   *fn2-checkpoint-recovery-evidence-phase-complete* fn2-checkpoint-recovery-evidence)))
           (mv :done fn2-checkpoint-recovery-evidence fn2-pool)))

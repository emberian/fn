    (b* (((unless (and (< c 4) (<= 5 (fn2-checkpoint-recovery-evidence-rows fn2-checkpoint-recovery-evidence))
                       (< 0 (fn2-checkpoint-restore-arena-control-rows fn2-checkpoint-restore-arena-control))
                       (= (fn2-checkpoint-restore-arena-control-phase 0 fn2-checkpoint-restore-arena-control) *fn2-checkpoint-restore-arena-phase-complete*)
                       (= (fn2-checkpoint-restore-arena-control-candidate 0 fn2-checkpoint-restore-arena-control) c)
                       (logbitp c (fn2-boot-config-arena-mask fn2-boot-config))

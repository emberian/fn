         (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-descriptor-hash 32 224 (* 32 r) fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence))
         (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-put (+ 1 c) (ready 0) (phase *fn2-checkpoint-recovery-evidence-phase-idle*)))
         (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-put 0
          (phase *fn2-checkpoint-recovery-evidence-phase-target*) (candidate c)
          (tag (fn2-checkpoint-restore-arena-control-tag 0 fn2-checkpoint-restore-arena-control))

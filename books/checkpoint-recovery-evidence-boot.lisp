                       (eq (fn2-pool-workspace-code rs rg *fn2-boot-kind* id ogen fn2-pool) :ok)
                       (not (= slot rs)) (<= 12288 (fn2-pool-cap slot fn2-pool)))) (mv :state fn2-checkpoint-recovery-evidence))
         (r (* 6 c))

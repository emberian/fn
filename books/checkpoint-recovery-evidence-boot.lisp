                     (= (fn2-machine-generation id fn2-core) ogen))) (mv :state fn2-core))
       (c (fn2-machine-checkpoint-index id fn2-core)) (slot (fn2-machine-root-slot id fn2-core))
       (gen (fn2-machine-root-gen id fn2-core)) (rs (fn2-machine-rx-slot id fn2-core)) (rg (fn2-machine-rx-gen id fn2-core)))

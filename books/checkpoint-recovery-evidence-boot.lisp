   (stobj-let ((fn2-checkpoint-recovery-evidence (fn2-core-checkpoint-recovery-evidence fn2-core))) (code offset)
    (if (= (fn2-cpe phase) *fn2-checkpoint-recovery-evidence-phase-load*)
        (mv :read (+ (* (fn2-cpe extent) *fn2-commit-extent-bytes*) cursor)) (mv :state 0)) (mv code offset fn2-core))))

 :tables (fn2-core-boot-config fn2-core-checkpoints fn2-core-checkpoint-refs fn2-core-checkpoint-bytes fn2-core-checkpoint-restore-arena-control fn2-core-checkpoint-recovery-evidence fn2-core-pool)

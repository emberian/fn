             (rs (fn2-machine-rx-slot id fn2-core)) (rg (fn2-machine-rx-gen id fn2-core)))
        (stobj-let ((fn2-checkpoint-recovery-evidence (fn2-core-checkpoint-recovery-evidence fn2-core))) (bound)
         (and (<= 5 (fn2-checkpoint-recovery-evidence-rows fn2-checkpoint-recovery-evidence))
              (equal (fn2-cpe candidate) c) (equal (fn2-cpe owner-kind) *fn2-boot-kind*)
              (equal (fn2-cpe owner-slot) id) (equal (fn2-cpe owner-gen) ogen)

         ((mv reset fn2-pool) (fn2-pool-reset (fn2-cpe slot) (fn2-cpe gen) (fn2-cpe owner-kind) id ogen fn2-pool))
         ((unless (eq reset :ok)) (mv reset fn2-checkpoint-recovery-evidence fn2-pool))

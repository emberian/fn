; PRF-1099 actual based-source row join. Authenticated byte supply remains an
; outer reader/physical obligation; this cursor never opens or hydrates pages.
(in-package "ACL2")
(include-book "history-decode-stream")
(include-book "history-decode-size")
(include-book "snapshot-message-key")
(local (include-book "arithmetic/top" :dir :system))

(defun fn-obp-u64s (n xs)
  (declare (xargs :guard (natp n) :measure (nfix n)))
  (if (zp n) (null xs)
    (and (consp xs) (unsigned-byte-p 64 (car xs))
         (fn-obp-u64s (1- n) (cdr xs)))))
(defun fn-obp-columns-fitp (k n lens starts imagebytes)
  (declare (xargs :guard (natp k) :measure (nfix k)))
  (if (zp k) t
    (and (equal (fn-omk-at (1- k) lens) (* 8 (nfix n)))
         (<= (+ (* 16384 (nfix (fn-omk-at (1- k) starts))) (* 8 (nfix n)))
             (nfix imagebytes))
         (fn-obp-columns-fitp (1- k) n lens starts imagebytes))))
(defun fn-obp-headerp (h)
  (declare (xargs :guard t
                  :guard-hints (("Goal" :in-theory (enable fn-obp-u64s fn-omk-at)))))
  (and (fn-omk-widthp h 8) (eq (fn-omk-at 0 h) :hrs-handle)
       (unsigned-byte-p 32 (fn-omk-at 3 h))
       (unsigned-byte-p 61 (fn-omk-at 4 h))
       (fn-obp-u64s 5 (fn-omk-at 5 h))
       (fn-obp-u64s 5 (fn-omk-at 6 h))
       (natp (fn-omk-at 7 h))
       (unsigned-byte-p 64 (* 16384 (fn-omk-at 7 h)))
       (fn-obp-columns-fitp 4 (fn-omk-at 4 h) (fn-omk-at 5 h)
                            (fn-omk-at 6 h) (* 16384 (fn-omk-at 7 h)))
       (<= (+ (* 16384 (nfix (fn-omk-at 4 (fn-omk-at 6 h))))
              (nfix (fn-omk-at 4 (fn-omk-at 5 h))))
           (* 16384 (fn-omk-at 7 h)))))
; Fixed17cells: phase,source4,handle,column,digit,word,cells4,decoder,node,
; padding-position,keycursor,resource-lease,reason,supply-serial,
; parser-size-infos,NIL-prefix,usable-size. Temporary parser annotations are
; funded scratch, not installed per-record Store sidecars.
(defun fn-obp-state (phase token handle column digit word cells decoder node
                          position key resource reason serial infos nil-prefix usable)
  (declare (xargs :guard t))
  (list phase token handle column digit word cells decoder node position key
        resource reason serial infos nil-prefix usable))
(defun fn-obp-with (phase column digit word cells decoder node position key reason serial c)
  (declare (xargs :guard t))
  (fn-obp-state phase (fn-omk-at 1 c) (fn-omk-at 2 c) column digit word cells
                decoder node position key (fn-omk-at 11 c) reason serial
                (fn-omk-at 14 c) (fn-omk-at 15 c) (fn-omk-at 16 c)))
(defun fn-obp-begin (handle token resource)
  (declare (xargs :guard t
                  :guard-hints (("Goal" :in-theory (enable fn-obp-headerp fn-omk-tokenp)))))
  (fn-obp-state
   (if (and (fn-obp-headerp handle) (fn-omk-tokenp token)
            (< (nfix (fn-omk-at 3 token)) (nfix (fn-omk-at 4 handle)))) :cells :refused)
   token handle 0 0 0 '(0 0 0 0) nil nil 0 nil resource :source-header 0 nil nil nil))
(defun fn-obp-cursorp (c)
  (declare (xargs :guard t
                  :guard-hints (("Goal" :in-theory (enable fn-obp-headerp fn-omk-tokenp)))))
  (and (fn-omk-widthp c 17)
       (member-equal (fn-omk-at 0 c) '(:cells :check :decode :padding :key :done :refused))
       (fn-omk-tokenp (fn-omk-at 1 c)) (fn-obp-headerp (fn-omk-at 2 c))
       (< (nfix (fn-omk-at 3 (fn-omk-at 1 c))) (nfix (fn-omk-at 4 (fn-omk-at 2 c))))
       (natp (fn-omk-at 3 c)) (<= (nfix (fn-omk-at 3 c)) 4)
       (natp (fn-omk-at 4 c)) (< (nfix (fn-omk-at 4 c)) 8)
       (unsigned-byte-p 64 (fn-omk-at 5 c))
       (< (nfix (fn-omk-at 5 c)) (expt 256 (nfix (fn-omk-at 4 c))))
       (fn-obp-u64s 4 (fn-omk-at 6 c))
       (natp (fn-omk-at 9 c)) (natp (fn-omk-at 13 c))
       (implies (eq (fn-omk-at 0 c) :cells) (< (nfix (fn-omk-at 3 c)) 4))
       (implies (eq (fn-omk-at 0 c) :decode) (fn-hdc-statep (fn-omk-at 7 c)))
       (implies (eq (fn-omk-at 0 c) :key) (fn-omk-guardp (fn-omk-at 10 c)))))
(defun fn-obp-byte-position (c)
  (declare (xargs :guard t))
  (let* ((phase (fn-omk-at 0 c)) (h (fn-omk-at 2 c))
         (starts (fn-omk-at 6 h)))
    (cond ((eq phase :cells)
           (+ (* 16384 (nfix (fn-omk-at (nfix (fn-omk-at 3 c)) starts)))
              (* 8 (nfix (fn-omk-at 3 (fn-omk-at 1 c))))
              (nfix (fn-omk-at 4 c))))
          ((eq phase :decode)
           (+ (* 16384 (nfix (fn-omk-at 4 starts)))
              (nfix (fn-omk-at 7 (fn-omk-at 7 c)))))
          ((eq phase :padding)
           (+ (* 16384 (nfix (fn-omk-at 4 starts))) (nfix (fn-omk-at 9 c))))
          ((eq phase :key)
           (+ (* 16384 (nfix (fn-omk-at 4 starts)))
              (nfix (fn-omk-at 2 (fn-omk-at 10 c)))
              (nfix (fn-omk-at 3 (fn-omk-at 10 c)))))
          (t 0))))
(defun fn-obp-demand (c)
  (declare (xargs :guard t))
  (let ((p (fn-obp-byte-position c)))
    (list :need-byte (fn-omk-at 1 c) (fn-omk-at 0 c) (fn-omk-at 13 c)
          (floor p 16384) (mod p 16384))))
(defun fn-obp-byte-matchp (observation c)
  (declare (xargs :guard t))
  (let ((d (fn-obp-demand c)))
    (and (fn-omk-widthp observation 7) (eq (fn-omk-at 0 observation) :byte)
         (fn-omk-token-matchp (fn-omk-at 1 observation) (fn-omk-at 1 c))
         (equal (fn-omk-at 2 observation) (fn-omk-at 2 d))
         (equal (fn-omk-at 3 observation) (fn-omk-at 3 d))
         (equal (fn-omk-at 4 observation) (fn-omk-at 4 d))
         (equal (fn-omk-at 5 observation) (fn-omk-at 5 d))
         (unsigned-byte-p 8 (fn-omk-at 6 observation)))))
(defun fn-obp-refuse (reason c)
  (declare (xargs :guard t))
  (list :refused reason
        (fn-obp-with :refused (fn-omk-at 3 c) (fn-omk-at 4 c) (fn-omk-at 5 c)
                     (fn-omk-at 6 c) (fn-omk-at 7 c) (fn-omk-at 8 c)
                     (fn-omk-at 9 c) (fn-omk-at 10 c) reason (fn-omk-at 13 c) c)))
(defun fn-obp-size-with (infos nil-prefix usable c)
  (declare (xargs :guard t))
  (fn-obp-state (fn-omk-at 0 c) (fn-omk-at 1 c) (fn-omk-at 2 c)
                (fn-omk-at 3 c) (fn-omk-at 4 c) (fn-omk-at 5 c)
                (fn-omk-at 6 c) (fn-omk-at 7 c) (fn-omk-at 8 c)
                (fn-omk-at 9 c) (fn-omk-at 10 c) (fn-omk-at 11 c)
                (fn-omk-at 12 c) (fn-omk-at 13 c) infos nil-prefix usable))
(defun fn-obp-completion (c)
  (declare (xargs :guard t))
  (list :parser-completion (fn-omk-at 1 c) (fn-omk-at 7 c)
        (fn-omk-at 14 c) (fn-omk-at 15 c) (fn-omk-at 16 c)))
(defun fn-obp-cell-put (column word cells)
  (declare (xargs :guard t))
  (list (if (equal column 0) word (fn-omk-at 0 cells))
        (if (equal column 1) word (fn-omk-at 1 cells))
        (if (equal column 2) word (fn-omk-at 2 cells))
        (if (equal column 3) word (fn-omk-at 3 cells))))
(defun fn-obp-tick (c observation)
  (declare (xargs :guard (fn-obp-cursorp c) :verify-guards nil))
  (let* ((phase (fn-omk-at 0 c)) (token (fn-omk-at 1 c))
         (h (fn-omk-at 2 c)) (col (nfix (fn-omk-at 3 c)))
         (digit (nfix (fn-omk-at 4 c))) (word (nfix (fn-omk-at 5 c)))
         (cells (fn-omk-at 6 c)) (decoder (fn-omk-at 7 c))
         (node (fn-omk-at 8 c)) (position (nfix (fn-omk-at 9 c)))
         (key (fn-omk-at 10 c)) (serial (nfix (fn-omk-at 13 c))))
    (cond
     ((eq phase :refused) (list :refused (fn-omk-at 12 c) c))
     ((eq phase :done) (list :decoded token node (fn-obp-completion c) c))
     ((eq phase :check)
      (let ((tl (nfix (fn-omk-at 1 cells))) (off (nfix (fn-omk-at 2 cells))) (plen (nfix (fn-omk-at 3 cells))))
        (cond ((not (and (equal (mod off 8) 0) (equal (mod plen 8) 0)
                         (<= tl plen) (<= (+ off plen) (nfix (fn-omk-at 4 (fn-omk-at 5 h))))))
               (fn-obp-refuse :cells c))
              ((not (equal plen (+ tl (mod (- 8 (mod tl 8)) 8))))
               (fn-obp-refuse :padding c))
              (t (mv-let (parser infos nil-prefix usable)
                     (fn-hds-begin off tl (fn-omk-at 0 token) (fn-omk-at 1 token))
                   (list :yield
                         (fn-obp-size-with infos nil-prefix usable
                           (fn-obp-with :decode col digit word cells parser
                                        nil (+ off tl) nil nil serial c))))))))
     ((and (eq phase :decode) (not (eq (car (fn-hdc-result decoder)) :yield)))
      (let ((r (fn-hdc-result decoder)))
        (if (not (eq (car r) :ok)) (fn-obp-refuse :tree c)
          (list :yield (fn-obp-with :padding col digit word cells decoder
                                    (fn-omk-at 1 r) position nil nil serial c)))))
     ((and (eq phase :padding)
           (equal position (+ (nfix (fn-omk-at 2 cells)) (nfix (fn-omk-at 3 cells)))))
      (let ((r (fn-omk-begin (list :decoded node) (mod (nfix (fn-omk-at 3 h)) 4294967296) token (fn-omk-at 11 c))))
        (if (not (eq (car r) :begun)) (fn-obp-refuse :mkey-domain c)
          (list :yield (fn-obp-with :key col digit word cells decoder node position
                                    (fn-omk-at 1 r) nil serial c)))))
     ((eq phase :key)
      (let ((r (fn-omk-tick key nil)))
        (cond ((eq (car r) :done)
               (if (equal (fn-omk-at 1 r) (fn-omk-at 0 cells))
                   (list :yield (fn-obp-with :done col digit word cells decoder node position key nil serial c))
                 (fn-obp-refuse :mkey c)))
              ((eq (car r) :continue)
               (list :yield (fn-obp-with phase col digit word cells decoder node position
                                         (fn-omk-at 1 r) nil serial c)))
              ((eq (car r) :need-byte)
               (cond ((null observation) (append (fn-obp-demand c) (list c)))
                     ((not (fn-obp-byte-matchp observation c)) (list :stale c))
                     (t (let ((r (fn-omk-tick key
                                  (list :byte token (fn-omk-at 1 r) (fn-omk-at 6 observation)))))
                          (if (eq (car r) :continue)
                              (list :yield (fn-obp-with phase col digit word cells decoder node position
                                                        (fn-omk-at 1 r) nil (1+ serial) c))
                            (fn-obp-refuse :mkey-byte c))))))
              (t (fn-obp-refuse :mkey c)))))
     ((null observation) (append (fn-obp-demand c) (list c)))
     ((not (fn-obp-byte-matchp observation c)) (list :stale c))
     ((eq phase :cells)
      (let ((w (+ word (* (fn-omk-at 6 observation) (expt 256 digit)))))
        (if (< digit 7)
            (list :yield (fn-obp-with phase col (1+ digit) w cells decoder node position key nil (1+ serial) c))
          (list :yield (fn-obp-with (if (< col 3) :cells :check) (1+ col) 0 0
                                    (fn-obp-cell-put col w cells) decoder node position key nil (1+ serial) c)))))
     ((eq phase :decode)
      (mv-let (parser infos nil-prefix usable)
          (fn-hds-feed (fn-omk-at 6 observation) decoder (fn-omk-at 14 c)
                       (fn-omk-at 15 c) (fn-omk-at 16 c))
        (list :yield
              (fn-obp-size-with infos nil-prefix usable
                (fn-obp-with phase col digit word cells parser
                             node position key nil (1+ serial) c)))))
     ((eq phase :padding)
      (if (equal (fn-omk-at 6 observation) 0)
          (list :yield (fn-obp-with phase col digit word cells decoder node (1+ position) key nil (1+ serial) c))
        (fn-obp-refuse :padding c)))
     (t (fn-obp-refuse :phase c)))))

(verify-guards fn-obp-tick
  :hints (("Goal" :in-theory
           (e/d (fn-obp-cursorp fn-obp-byte-matchp)
                (fn-obp-headerp fn-omk-at fn-omk-tick fn-hdc-feed fn-hds-feed
                 fn-omk-guardp fn-obp-demand fn-obp-byte-position)))))

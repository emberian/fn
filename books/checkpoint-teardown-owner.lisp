; Immutable candidate debt binds later teardown after publication rearm.
(in-package "ACL2")
(include-book "checkpoint-teardown-state")
(include-book "checkpoint-publication-state")
(include-book "checkpoint-bank-obligations-state")
(fn2-book-layer :b)
(defun fn2-checkpoint-teardown-retained-hash-p (i c fn2-checkpoint-teardown-debt fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-bytes) :verify-guards nil :measure (nfix (- 8 (nfix i)))
  :guard (and (natp i) (<= i 8) (natp c) (<= (* 40 (+ 1 c)) (fn2-checkpoint-teardown-debt-words-length fn2-checkpoint-teardown-debt)) (<= (+ (* 192 c) 32) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes)) (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)))))
 (or (>= (nfix i) 8)
     (and (equal (fn2-checkpoint-teardown-debt-wordsi (+ (* 40 c) 32 i) fn2-checkpoint-teardown-debt)
                 (fn2-checkpoint-descriptor-identity-word c i fn2-checkpoint-bytes))
          (fn2-checkpoint-teardown-retained-hash-p (+ 1 i) c fn2-checkpoint-teardown-debt fn2-checkpoint-bytes))))
(defun fn2-checkpoint-teardown-retained-ownerp (c token kind slot gen fn2-checkpoint-teardown-debt fn2-checkpoints fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoints fn2-checkpoint-bytes) :verify-guards nil
  :guard (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes))))
 (and (fn2-checkpoint-teardown-debt-heldp c fn2-checkpoint-teardown-debt) (< c (fn2-checkpoints-rows fn2-checkpoints))
      (<= (* 40 (+ 1 c)) (fn2-checkpoint-teardown-debt-words-length fn2-checkpoint-teardown-debt))
      (<= (+ (* 192 c) 32) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes))
      (member-equal (fn2-checkpoint-teardown-debt-phase c fn2-checkpoint-teardown-debt)
       (list *fn2-checkpoint-teardown-debt-phase-held* *fn2-checkpoint-teardown-debt-phase-waiting* *fn2-checkpoint-teardown-debt-phase-drop*))
      (equal (fn2-checkpoint-teardown-debt-token c fn2-checkpoint-teardown-debt) token)
      (equal (fn2-checkpoint-teardown-debt-owner-kind c fn2-checkpoint-teardown-debt) kind)
      (equal (fn2-checkpoint-teardown-debt-owner-slot c fn2-checkpoint-teardown-debt) slot)
      (equal (fn2-checkpoint-teardown-debt-owner-gen c fn2-checkpoint-teardown-debt) gen)
      (equal (fn2-checkpoint-teardown-debt-checkpoint c fn2-checkpoint-teardown-debt) (fn2-checkpoints-checkpoint c fn2-checkpoints))
      (equal (fn2-checkpoint-teardown-debt-history c fn2-checkpoint-teardown-debt) (fn2-checkpoints-history c fn2-checkpoints))
      (equal (fn2-checkpoint-teardown-debt-incarnation c fn2-checkpoint-teardown-debt) (fn2-checkpoints-incarnation c fn2-checkpoints))
      (equal (fn2-checkpoint-teardown-debt-cut-commit c fn2-checkpoint-teardown-debt) (fn2-checkpoints-cut-commit c fn2-checkpoints))
      (equal (fn2-checkpoint-teardown-debt-cut-event c fn2-checkpoint-teardown-debt) (fn2-checkpoints-cut-event c fn2-checkpoints))
      (equal (fn2-checkpoint-teardown-debt-cold-copy c fn2-checkpoint-teardown-debt) 0)
      (let ((cold (and (equal (fn2-checkpoints-builder-token c fn2-checkpoints) 0)
                       (unsigned-byte-p 4 (fn2-checkpoint-teardown-debt-anchor-mask c fn2-checkpoint-teardown-debt))
                       (< 0 (fn2-checkpoint-teardown-debt-anchor-mask c fn2-checkpoint-teardown-debt)))))
       (and (or cold
                (and (equal (fn2-checkpoint-teardown-debt-installation-commit c fn2-checkpoint-teardown-debt) (fn2-checkpoints-installation-commit c fn2-checkpoints))
                     (equal (fn2-checkpoint-teardown-debt-installation-event c fn2-checkpoint-teardown-debt) (fn2-checkpoints-installation-event c fn2-checkpoints))))
            (or (member-equal (fn2-checkpoints-state c fn2-checkpoints) (list *fn2-checkpoint-state-installed* *fn2-checkpoint-state-promoting* *fn2-checkpoint-state-promoted* *fn2-checkpoint-state-disposing*))
                (and cold (equal (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-checked*)))))
      (equal (fn2-checkpoint-teardown-debt-word-cursor c fn2-checkpoint-teardown-debt) 40)
      (fn2-checkpoint-teardown-retained-hash-p 0 c fn2-checkpoint-teardown-debt fn2-checkpoint-bytes)))
(defun fn2-checkpoint-teardown-retained-bank-excludedp (c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil
  :guard (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (and (fn2-checkpoint-teardown-debt-heldp c fn2-checkpoint-teardown-debt)
      (fn2-checkpoint-bank-obligations-excludedp c
       (fn2-checkpoint-teardown-debt-checkpoint c fn2-checkpoint-teardown-debt)
       (fn2-checkpoint-teardown-debt-history c fn2-checkpoint-teardown-debt)
       (fn2-checkpoint-teardown-debt-incarnation c fn2-checkpoint-teardown-debt) fn2-checkpoint-publication)))

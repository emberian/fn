; One retained decoded semantic entry, produced only at actual source
; boundaries. Snapshot and authenticated-page constructors live with those
; producers. Payload closure never accepts a caller-described entry or flag.
(in-package "ACL2")
(include-book "checkpoint")
(include-book "c-snapshot")
(include-book "runs-served")
(fn2-book-layer :c)

(defcolumns fn2-checkpoint-retained-entry
 ((phase (:enum fn2-checkpoint-retained-entry-phase (:free :held :payload-complete :uncertain)))
  (serial :u60) (token :u60) (owner-kind :u8) (owner-slot :u32) (owner-gen :u60)
  (candidate :u32) (checkpoint :u60) (schema :u60) (field-base :u32)
  (origin (:enum fn2-checkpoint-retained-entry-origin (:snapshot :page)))
  (source-kind :u8) (source-row :u32) (source-rank :u60) (source-position :u60)
  (extent :u32) (epoch :u60) (allocation :u60) (page-kind :u8)
  (run :u60) (level :u8) (entry-index :u32)
  (hash-0 :u32) (hash-1 :u32) (hash-2 :u32) (hash-3 :u32) (hash-4 :u32) (hash-5 :u32) (hash-6 :u32) (hash-7 :u32)))

(defun fn2-checkpoint-retained-entry-ownerp (fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields)
 (declare (xargs :stobjs (fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields)
  :guard (and (fn2-checkpoint-retained-entry-wfp fn2-checkpoint-retained-entry) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-checkpoints-wfp fn2-checkpoints) (fn2-fields-wfp fn2-fields))))
 (and (< 0 (fn2-checkpoint-retained-entry-rows fn2-checkpoint-retained-entry))
      (member (fn2-checkpoint-retained-entry-phase 0 fn2-checkpoint-retained-entry)
       (list *fn2-checkpoint-retained-entry-phase-held* *fn2-checkpoint-retained-entry-phase-payload-complete*))
      (posp (fn2-checkpoint-retained-entry-serial 0 fn2-checkpoint-retained-entry))
      (fn2-csnapshot-ownerp (fn2-checkpoint-retained-entry-token 0 fn2-checkpoint-retained-entry)
       (fn2-checkpoint-retained-entry-owner-kind 0 fn2-checkpoint-retained-entry)
       (fn2-checkpoint-retained-entry-owner-slot 0 fn2-checkpoint-retained-entry)
       (fn2-checkpoint-retained-entry-owner-gen 0 fn2-checkpoint-retained-entry) fn2-csnapshot)
      (equal (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-held*)
      (fn2-checkpoint-builder-ownerp (fn2-checkpoint-retained-entry-candidate 0 fn2-checkpoint-retained-entry)
       (fn2-checkpoint-retained-entry-token 0 fn2-checkpoint-retained-entry)
       (fn2-checkpoint-retained-entry-owner-kind 0 fn2-checkpoint-retained-entry)
       (fn2-checkpoint-retained-entry-owner-slot 0 fn2-checkpoint-retained-entry)
       (fn2-checkpoint-retained-entry-owner-gen 0 fn2-checkpoint-retained-entry) fn2-checkpoints)
      (equal (fn2-checkpoint-retained-entry-checkpoint 0 fn2-checkpoint-retained-entry)
             (fn2-checkpoints-checkpoint (fn2-checkpoint-retained-entry-candidate 0 fn2-checkpoint-retained-entry) fn2-checkpoints))
      (posp (fn2-run-layout-fields (fn2-checkpoint-retained-entry-schema 0 fn2-checkpoint-retained-entry) 0))
      (<= (+ (fn2-checkpoint-retained-entry-field-base 0 fn2-checkpoint-retained-entry)
             (fn2-run-layout-fields (fn2-checkpoint-retained-entry-schema 0 fn2-checkpoint-retained-entry) 0))
          (fn2-fields-rows fn2-fields))))

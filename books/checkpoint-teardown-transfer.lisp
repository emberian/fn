; Transfer the publication's exact displaced evidence into candidate-owned
; retention. No bank/protection is dropped; copy refusal leaves scalar debt.
(in-package "ACL2")
(include-book "checkpoint-teardown")
(include-book "checkpoint-teardown-state")
(include-book "checkpoint-bank-evidence")
(fn2-book-layer :c)
(defun fn2-checkpoint-teardown-evidence-kind (i)
 (declare (xargs :guard (natp i)))
 (case (floor i 8) (0 :installation-seal) (1 :cut-seal) (2 :installation-predecessor) (3 :previous-descriptor) (otherwise :descriptor)))
(defun fn2-checkpoint-teardown-transfer-current-p (c token kind slot gen fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil
  :guard (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (mv-let (code candidate checkpoint history incarnation cut cutevent batch)
  (fn2-checkpoint-bank-evidence-snapshot 3 fn2-checkpoint-publication)
  (mv-let (eventcode event) (fn2-checkpoint-bank-evidence-event 3 fn2-checkpoint-publication)
   (and (eq code :ok) (eq eventcode :ok) (equal c candidate)
        (fn2-checkpoint-teardown-debt-heldp c fn2-checkpoint-teardown-debt)
        (<= (* 40 (+ 1 c)) (fn2-checkpoint-teardown-debt-words-length fn2-checkpoint-teardown-debt))
        (equal (fn2-checkpoint-teardown-debt-token c fn2-checkpoint-teardown-debt) token)
        (equal (fn2-checkpoint-teardown-debt-owner-kind c fn2-checkpoint-teardown-debt) kind)
        (equal (fn2-checkpoint-teardown-debt-owner-slot c fn2-checkpoint-teardown-debt) slot)
        (equal (fn2-checkpoint-teardown-debt-owner-gen c fn2-checkpoint-teardown-debt) gen)
        (equal (fn2-checkpoint-teardown-debt-checkpoint c fn2-checkpoint-teardown-debt) checkpoint)
        (equal (fn2-checkpoint-teardown-debt-history c fn2-checkpoint-teardown-debt) history)
        (equal (fn2-checkpoint-teardown-debt-incarnation c fn2-checkpoint-teardown-debt) incarnation)
        (equal (fn2-checkpoint-teardown-debt-cut-commit c fn2-checkpoint-teardown-debt) cut)
        (equal (fn2-checkpoint-teardown-debt-cut-event c fn2-checkpoint-teardown-debt) cutevent)
        (equal (fn2-checkpoint-teardown-debt-installation-commit c fn2-checkpoint-teardown-debt) batch)
        (equal (fn2-checkpoint-teardown-debt-installation-event c fn2-checkpoint-teardown-debt) event)))))
; Compare immutable subject without replacing the first retaining actor/token.
(defun fn2-checkpoint-teardown-transfer-subject-p (c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil))
 (and (fn2-checkpoint-teardown-debt-heldp c fn2-checkpoint-teardown-debt)
      (fn2-checkpoint-teardown-transfer-current-p c
       (fn2-checkpoint-teardown-debt-token c fn2-checkpoint-teardown-debt)
       (fn2-checkpoint-teardown-debt-owner-kind c fn2-checkpoint-teardown-debt)
       (fn2-checkpoint-teardown-debt-owner-slot c fn2-checkpoint-teardown-debt)
       (fn2-checkpoint-teardown-debt-owner-gen c fn2-checkpoint-teardown-debt) fn2-checkpoint-teardown-debt fn2-checkpoint-publication)))
(defun fn2-checkpoint-teardown-transfer-words-p (i c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil
  :measure (nfix (- 40 (nfix i)))
  :guard (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
              (natp i) (<= i 40) (natp c) (<= (* 40 (+ 1 c)) (fn2-checkpoint-teardown-debt-words-length fn2-checkpoint-teardown-debt)))))
 (if (>= (nfix i) 40) t
  (mv-let (code word) (fn2-checkpoint-bank-evidence-word 3 (fn2-checkpoint-teardown-evidence-kind i) (mod i 8) fn2-checkpoint-publication)
   (and (eq code :ok) (equal word (fn2-checkpoint-teardown-debt-wordsi (+ (* 40 c) i) fn2-checkpoint-teardown-debt))
        (fn2-checkpoint-teardown-transfer-words-p (+ 1 i) c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)))))
(defun fn2-checkpoint-teardown-transfer-begin (token kind slot gen fn2-checkpoint-teardown-debt fn2-checkpoint-lifecycle fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-lifecycle fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents) :verify-guards nil
  :guard (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-lifecycle-wfp fn2-checkpoint-lifecycle) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication))) (mv :state 0 fn2-checkpoint-teardown-debt))
      ((when (equal (fn2-checkpoint-publication-debt-valid 0 fn2-checkpoint-publication) 0)) (mv :none 0 fn2-checkpoint-teardown-debt))
      ((unless (fn2-checkpoint-teardown-release-ownerp token kind slot gen fn2-checkpoint-lifecycle fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents)) (mv :owner 0 fn2-checkpoint-teardown-debt))
      ((mv code c checkpoint history incarnation cut cutevent batch) (fn2-checkpoint-bank-evidence-snapshot 3 fn2-checkpoint-publication))
      ((mv eventcode event) (fn2-checkpoint-bank-evidence-event 3 fn2-checkpoint-publication))
      ((unless (and (eq code :ok) (eq eventcode :ok) (< c (fn2-checkpoint-teardown-debt-rows fn2-checkpoint-teardown-debt))
                     (<= (* 40 (+ 1 c)) (fn2-checkpoint-teardown-debt-words-length fn2-checkpoint-teardown-debt))
                     (equal (fn2-checkpoint-teardown-debt-rows fn2-checkpoint-teardown-debt) (fn2-checkpoints-rows fn2-checkpoints)))) (mv :evidence 0 fn2-checkpoint-teardown-debt))
      ((when (fn2-checkpoint-teardown-debt-heldp c fn2-checkpoint-teardown-debt))
       (mv (cond ((and (fn2-checkpoint-teardown-transfer-current-p c token kind slot gen fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
                       (equal (fn2-checkpoint-teardown-debt-phase c fn2-checkpoint-teardown-debt) *fn2-checkpoint-teardown-debt-phase-copying*)) :copy)
                 ((and (fn2-checkpoint-teardown-transfer-subject-p c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
                       (member-equal (fn2-checkpoint-teardown-debt-phase c fn2-checkpoint-teardown-debt)
                        (list *fn2-checkpoint-teardown-debt-phase-held* *fn2-checkpoint-teardown-debt-phase-drop*))
                       (equal (fn2-checkpoint-teardown-debt-word-cursor c fn2-checkpoint-teardown-debt) 40)
                       (fn2-checkpoint-teardown-transfer-words-p 0 c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)) :duplicate)
                 (t :retained)) c fn2-checkpoint-teardown-debt))
      (fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-put c
       (phase *fn2-checkpoint-teardown-debt-phase-copying*) (token token) (owner-kind kind) (owner-slot slot) (owner-gen gen)
       (checkpoint checkpoint) (history history) (incarnation incarnation) (cut-commit cut) (cut-event cutevent)
       (installation-commit batch) (installation-event event) (word-cursor 0))))
  (mv :copy c fn2-checkpoint-teardown-debt)))
(defun fn2-checkpoint-teardown-transfer-step (c token kind slot gen fn2-checkpoint-teardown-debt fn2-checkpoint-lifecycle fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-lifecycle fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents) :verify-guards nil
  :guard (and (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt) (fn2-checkpoint-lifecycle-wfp fn2-checkpoint-lifecycle) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (and (fn2-checkpoint-teardown-release-ownerp token kind slot gen fn2-checkpoint-lifecycle fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents)
                     (fn2-checkpoint-teardown-transfer-subject-p c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)))
       (mv :owner fn2-checkpoint-teardown-debt fn2-checkpoint-publication))
      ((when (and (member-equal (fn2-checkpoint-teardown-debt-phase c fn2-checkpoint-teardown-debt)
                       (list *fn2-checkpoint-teardown-debt-phase-held* *fn2-checkpoint-teardown-debt-phase-drop*))
                  (equal (fn2-checkpoint-teardown-debt-word-cursor c fn2-checkpoint-teardown-debt) 40)
                  (fn2-checkpoint-teardown-transfer-words-p 0 c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)))
       ; Replacing the other copy of the same bank subject coalesces evidence;
       ; an accepted DROP cursor and its original owner remain untouched.
       (let ((fn2-checkpoint-publication (fn2-checkpoint-publication-set-debt-valid 0 0 fn2-checkpoint-publication)))
        (mv :transferred fn2-checkpoint-teardown-debt fn2-checkpoint-publication)))
      ((unless (and (fn2-checkpoint-teardown-transfer-current-p c token kind slot gen fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
                    (equal (fn2-checkpoint-teardown-debt-phase c fn2-checkpoint-teardown-debt) *fn2-checkpoint-teardown-debt-phase-copying*)))
       (mv :owner fn2-checkpoint-teardown-debt fn2-checkpoint-publication))
      (i (fn2-checkpoint-teardown-debt-word-cursor c fn2-checkpoint-teardown-debt))
      ((when (< i 40))
       (mv-let (code word) (fn2-checkpoint-bank-evidence-word 3 (fn2-checkpoint-teardown-evidence-kind i) (mod i 8) fn2-checkpoint-publication)
        (if (not (eq code :ok)) (mv :evidence fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
         (let* ((fn2-checkpoint-teardown-debt (update-fn2-checkpoint-teardown-debt-wordsi (+ (* 40 c) i) word fn2-checkpoint-teardown-debt))
                (fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-set-word-cursor c (+ 1 i) fn2-checkpoint-teardown-debt)))
          (mv :more fn2-checkpoint-teardown-debt fn2-checkpoint-publication)))))
      ((unless (and (equal i 40) (fn2-checkpoint-teardown-transfer-words-p 0 c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
                     (< (fn2-checkpoint-teardown-debt-count fn2-checkpoint-teardown-debt) (fn2-checkpoint-teardown-debt-rows fn2-checkpoint-teardown-debt))))
       (mv :evidence fn2-checkpoint-teardown-debt fn2-checkpoint-publication))
      ; The only scalar-slot clear is atomic with complete immutable retention.
      (fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-set-phase c *fn2-checkpoint-teardown-debt-phase-held* fn2-checkpoint-teardown-debt))
      (fn2-checkpoint-teardown-debt (update-fn2-checkpoint-teardown-debt-count (+ 1 (fn2-checkpoint-teardown-debt-count fn2-checkpoint-teardown-debt)) fn2-checkpoint-teardown-debt))
      (fn2-checkpoint-teardown-debt (update-fn2-checkpoint-teardown-debt-notified 1 fn2-checkpoint-teardown-debt))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-set-debt-valid 0 0 fn2-checkpoint-publication)))
  (mv :transferred fn2-checkpoint-teardown-debt fn2-checkpoint-publication)))
(defcost fn2-checkpoint-teardown-transfer-begin-op :child fn2-checkpoint-teardown-transfer-begin :answers t
 :tables (fn2-core-checkpoint-teardown-debt) :bytes 160)
(defcost fn2-checkpoint-teardown-transfer-step-op :child fn2-checkpoint-teardown-transfer-step :answers t
 :tables (fn2-core-checkpoint-teardown-debt fn2-core-checkpoint-publication) :bytes 160)

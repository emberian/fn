; Boot-owned cold semantic read operations. The ordinary read/result path
; supplies exact sector completions; this code never accepts verified flags.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "boot-kind")
(include-book "checkpoint-restore-semantic-work")
(include-book "checkpoint-restore-semantic-reach")
(fn2-book-layer :c)
(defcost fn2-boot-checkpoint-semantic-begin :answers t :bytes 128
 :tables (fn2-core-checkpoint-restore-semantic fn2-core-fc fn2-core-pool))
(defcost fn2-boot-checkpoint-semantic-sector :answers t)
(defcost fn2-boot-checkpoint-semantic-check :child fn2-checkpoint-restore-semantic-page-reach :answers t :bytes 4096
 :tables (fn2-core-checkpoint-restore-semantic fn2-core-checkpoint-restore-reach fn2-core-fc fn2-core-fc-context fn2-core-b3 fn2-core-fields fn2-core-pool fn2-core-digests))

(defcost fn2-boot-checkpoint-semantic-consume :child fn2-checkpoint-restore-semantic-consume :answers t :bytes *fn2-checkpoint-restore-semantic-entry-bytes*
 :tables (fn2-core-checkpoint-restore-semantic fn2-core-checkpoint-restore-semantic-work fn2-core-fields fn2-core-digests))
(defcost fn2-boot-checkpoint-semantic-find :child fn2-checkpoint-restore-semantic-find :answers t
 :tables (fn2-core-checkpoint-restore-semantic fn2-core-checkpoint-restore-semantic-work fn2-core-fc fn2-core-pool))

(defmacro fn2-boot-checkpoint-semantic-operations ()
 '(progn
  (make-event (value (cons 'progn
   (append (fn2-arms-op-face-events 'fn2-boot-checkpoint-semantic-check 'fn2-checkpoint-restore-semantic-page-reach (w state))
           (fn2-arms-op-face-events 'fn2-boot-checkpoint-semantic-entry 'fn2-checkpoint-restore-semantic-entry (w state))
           (fn2-arms-op-face-events 'fn2-boot-checkpoint-semantic-consume 'fn2-checkpoint-restore-semantic-consume (w state))
           (fn2-arms-op-face-events 'fn2-boot-checkpoint-semantic-find 'fn2-checkpoint-restore-semantic-find (w state))))))
  (defun fn2-boot-checkpoint-semantic-begin (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (and (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
                  (equal (fn2-machine-phase id fn2-core) *fn2-boot-state-checkpoint-semantic-begin*)
                  (equal (fn2-machine-generation id fn2-core) ogen))) (mv :state fn2-core)
    (let ((slot (fn2-machine-root-slot id fn2-core)) (gen (fn2-machine-root-gen id fn2-core))
          (c (fn2-machine-checkpoint-index id fn2-core)))
     (stobj-let ((fn2-checkpoints (fn2-core-checkpoints fn2-core)) (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core))
       (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core)) (fn2-checkpoint-restore-map (fn2-core-checkpoint-restore-map fn2-core))
       (fn2-checkpoint-restore-map-control (fn2-core-checkpoint-restore-map-control fn2-core))
       (fn2-checkpoint-restore-semantic (fn2-core-checkpoint-restore-semantic fn2-core)) (fn2-fc (fn2-core-fc fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
      (code fn2-checkpoint-restore-semantic fn2-fc fn2-pool)
      (b* (((unless (and (< 2 (fn2-fc-rows fn2-fc))
                         (< 0 (fn2-checkpoint-restore-map-control-rows fn2-checkpoint-restore-map-control))
                         (equal c (fn2-checkpoint-restore-map-control-candidate 0 fn2-checkpoint-restore-map-control))))
            (mv :state fn2-checkpoint-restore-semantic fn2-fc fn2-pool))
           (fn2-checkpoint-restore-semantic (fn2-checkpoint-restore-semantic-set-phase 0 *fn2-checkpoint-restore-semantic-phase-idle* fn2-checkpoint-restore-semantic))
           (fn2-fc (fn2-fc-reset 2 fn2-fc))
           ((mv code fn2-pool) (fn2-pool-reset slot gen *fn2-boot-kind* id ogen fn2-pool))
           ((unless (eq code :ok)) (mv code fn2-checkpoint-restore-semantic fn2-fc fn2-pool))
           ((mv code fn2-checkpoint-restore-semantic)
            (fn2-checkpoint-restore-semantic-begin slot gen *fn2-boot-kind* id ogen fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
             fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-pool fn2-checkpoint-restore-semantic)))
       (mv code fn2-checkpoint-restore-semantic fn2-fc fn2-pool))
      (mv code fn2-core)))))
  (fn2-core-preserves fn2-boot-checkpoint-semantic-begin (id ogen fn2-core) :position 1 :rows nil)
  (defun fn2-boot-checkpoint-semantic-sector (cursor id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (and (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
                  (equal (fn2-machine-phase id fn2-core) *fn2-boot-state-checkpoint-semantic-load*)
                  (equal (fn2-machine-generation id fn2-core) ogen)
                  (natp cursor) (< cursor *fn2-format-page-size*) (equal (mod cursor 4096) 0))) (mv :state 0)
    (stobj-let ((fn2-checkpoint-restore-semantic (fn2-core-checkpoint-restore-semantic fn2-core))) (code offset)
     (if (not (and (< 0 (fn2-checkpoint-restore-semantic-rows fn2-checkpoint-restore-semantic))
                    (equal (fn2-checkpoint-restore-semantic-candidate 0 fn2-checkpoint-restore-semantic) (fn2-machine-checkpoint-index id fn2-core))
                    (equal (fn2-checkpoint-restore-semantic-slot 0 fn2-checkpoint-restore-semantic) (fn2-machine-root-slot id fn2-core))
                    (equal (fn2-checkpoint-restore-semantic-gen 0 fn2-checkpoint-restore-semantic) (fn2-machine-root-gen id fn2-core)))) (mv :state 0)
      (mv :read (+ (* 4096 (fn2-checkpoint-restore-semantic-unit 0 fn2-checkpoint-restore-semantic)) cursor)))
     (mv code offset))))))

(local (defun lci6-answer-tooth (mutant named disk r mode configs frontier max-conns segs outcome fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc)))
 (mv-let (answer fn-lbc nextdisk nextsegs trace owner)
  (if mutant (lct-id6-current-open disk r mode configs frontier max-conns segs outcome fn-lbc)
    (fn-lc-open disk r mode configs frontier max-conns segs outcome fn-lbc))
  (declare (ignore nextdisk nextsegs trace owner))
  (mv (if named (equal answer :lc-next-id-unverifiable) (equal answer :ok)) fn-lbc))))
(local (defun lci6-floor-tooth (mutant disk r mode segs fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((recs (fn-lc-examined-records disk r)) (pages (pgs-pages disk))
        (h (if mutant (lct-id6-current-replayed-header disk r mode segs)
             (fn-lc-replayed-header disk r mode segs)))
        (floor (fn-lc-records-max-next-id recs pages)) (next (fn-lc-header-next-id h)))
  (mv (and (fn-lc-records-next-ids-known-p recs pages)
           (mbe :logic (<= floor next) :exec (not (fn-ag-less next floor)))
           (implies (fn-lc-records-any-exhausted-p recs pages) (fn-lc-header-exhaustedp h))) fn-lbc))))
(local (verify-guards lci6-floor-tooth :hints (("Goal" :in-theory (enable fn-ag-less)))))
(local (defun lci6-refusal-hyp-tooth (kind disk r mode segs outcome fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc)))
 (mv (case kind
   (:cut (equal (fn-lc-outcome-ok-count outcome (len (fn-lc-open-program disk r mode segs)))
                (len (fn-lc-open-program disk r mode segs))))
   (:cold (equal (fn-lc-head (fn-lc-cold-select disk r mode)) :ok))
   (otherwise (not (fn-lc-records-next-ids-known-p (fn-lc-examined-records disk r) (pgs-pages disk))))) fn-lbc)))

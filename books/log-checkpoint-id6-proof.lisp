; ID-6 production identity floor and named refusal, with frozen statements.
(in-package "ACL2")
(include-book "log-checkpoint-open")
(include-book "defkeystone")

(defthm fn-lc-replayed-id6-fields-by-definition
 (and (equal (fn-lc-header-next-id (fn-lc-replayed-header disk r mode segs))
   (max (fn-lc-header-next-id (fn-lc-allocation-header (fn-lc-cold-adopted-header disk r mode) segs))
        (fn-lc-records-max-next-id (fn-lc-examined-records disk r) (pgs-pages disk))))
      (equal (fn-lc-header-exhaustedp (fn-lc-replayed-header disk r mode segs))
   (or (fn-lc-header-exhaustedp (fn-lc-allocation-header (fn-lc-cold-adopted-header disk r mode) segs))
       (fn-lc-records-any-exhausted-p (fn-lc-examined-records disk r) (pgs-pages disk)))))
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
  '(fn-lc-replayed-header fn-lc-header-next-id fn-lc-header-exhaustedp
    nth mv-nth car-cons cdr-cons fn-lc-at-is-nth
    (:executable-counterpart binary-+) (:executable-counterpart zp))))))

(local (defthm lci6-success-known
 (implies (equal (mv-nth 0 (fn-lc-open disk r mode configs frontier max-conns segs outcome fn-lbc)) :ok)
  (fn-lc-records-next-ids-known-p (fn-lc-examined-records disk r) (pgs-pages disk)))
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
  '(fn-lc-open fn-lc-adopt mv-nth nth car-cons cdr-cons
    (:executable-counterpart equal) (:executable-counterpart zp)))))))

(defthm fn-lc-cold-open-never-reissues-an-examined-id
 (let* ((out (fn-lc-open disk r mode configs frontier max-conns segs outcome fn-lbc))
        (recs (fn-lc-examined-records disk r))
        (pages (pgs-pages disk))
        (h (fn-lc-replayed-header disk r mode segs)))
  (implies (equal (mv-nth 0 out) :ok)
           (and (fn-lc-records-next-ids-known-p recs pages)
                (<= (fn-lc-records-max-next-id recs pages) (fn-lc-header-next-id h))
                (implies (fn-lc-records-any-exhausted-p recs pages)
                         (fn-lc-header-exhaustedp h)))))
 :rule-classes nil
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory) '(lci6-success-known fn-lc-replayed-id6-fields-by-definition max (:type-prescription fn-lc-records-max-next-id) (:type-prescription nfix))))))

(defthm fn-lc-cold-open-refuses-an-unverifiable-examined-header
 (let ((out (fn-lc-open disk r mode configs frontier max-conns segs outcome fn-lbc)))
  (implies (and (equal (fn-lc-outcome-ok-count outcome (len (fn-lc-open-program disk r mode segs)))
                       (len (fn-lc-open-program disk r mode segs)))
                (equal (fn-lc-head (fn-lc-cold-select disk r mode)) :ok)
                (not (fn-lc-records-next-ids-known-p (fn-lc-examined-records disk r)
                                                     (pgs-pages disk))))
           (equal (mv-nth 0 out) :lc-next-id-unverifiable)))
 :rule-classes nil
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory) '(fn-lc-open mv-nth nth car-cons cdr-cons (:executable-counterpart equal) (:executable-counterpart zp))))))


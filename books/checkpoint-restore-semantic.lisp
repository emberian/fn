; Cold root1 read admission from the actual checked descriptor and complete
; authenticated map. This retains a physical target, not a selected base.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-restore-provenance")
(include-book "checkpoint-semantic-page")
(fn2-book-layer :c)
(defcolumns fn2-checkpoint-restore-semantic
 ((phase (:enum fn2-checkpoint-restore-semantic-phase (:idle :read :verify :header :entries :uncertain)))
  (candidate :u32) (unit :u60) (epoch :u60) (allocation :u60)
  (cursor :u32) (checker-row :u32) (field-base :u32) (checker-phase :u8) (checker-pos :u32)
  (checker-zero :u32) (checker-pad :u32) (checker-pad-end :u32) (checker-geom :u32) (checker-previous-seal-offset :u32)
  (slot :u32) (gen :u60) (owner-kind :u8) (owner-slot :u32) (owner-gen :u60)
  (schema :u60) (run :u60) (level :u8) (entries :u32))
 :extra-fields
 ((fn2-checkpoint-restore-semantic-hash :type (array (unsigned-byte 8) (32)) :initially 0
   :why "Exact descriptor root1 expected hash retained before physical reads; no caller digest input.")))

(defun fn2-checkpoint-restore-semantic-root-hash (i src fn2-checkpoint-bytes fn2-checkpoint-restore-semantic)
 (declare (xargs :stobjs (fn2-checkpoint-bytes fn2-checkpoint-restore-semantic)
  :measure (nfix (- 32 (nfix i)))
  :guard (and (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-checkpoint-restore-semantic-wfp fn2-checkpoint-restore-semantic)
              (natp i) (<= i 32) (natp src) (<= (+ src 32) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes)))))
 (if (>= (nfix i) 32) fn2-checkpoint-restore-semantic
  (let ((fn2-checkpoint-restore-semantic (update-fn2-checkpoint-restore-semantic-hashi i
         (fn2-checkpoint-bytes-value (+ src i) fn2-checkpoint-bytes) fn2-checkpoint-restore-semantic)))
   (fn2-checkpoint-restore-semantic-root-hash (+ i 1) src fn2-checkpoint-bytes fn2-checkpoint-restore-semantic))))

(defun fn2-checkpoint-restore-semantic-begin (slot gen kind owner generation fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                                            fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-pool fn2-checkpoint-restore-semantic)
 (declare (xargs :stobjs (fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-pool fn2-checkpoint-restore-semantic)
  :guard (and (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
              (fn2-checkpoint-restore-map-wfp fn2-checkpoint-restore-map) (fn2-checkpoint-restore-map-control-wfp fn2-checkpoint-restore-map-control)
              (fn2-pool-wfp fn2-pool) (fn2-checkpoint-restore-semantic-wfp fn2-checkpoint-restore-semantic))))
 (b* (((unless (and (< 0 (fn2-checkpoint-restore-semantic-rows fn2-checkpoint-restore-semantic))
                     (equal (fn2-checkpoint-restore-semantic-phase 0 fn2-checkpoint-restore-semantic) *fn2-checkpoint-restore-semantic-phase-idle*)
                     (fn2-checkpoint-restore-map-current-p fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control)))
       (mv :source fn2-checkpoint-restore-semantic))
      (c (fn2-checkpoint-restore-map-control-candidate 0 fn2-checkpoint-restore-map-control))
      (r (+ (* 6 c) 1)) (unit (fn2-checkpoint-refs-physical-unit r fn2-checkpoint-refs))
      (e (floor unit *fn2-storage-extent-units*))
      ((unless (and (equal (mod unit *fn2-storage-extent-units*) 0)
                     (< e (fn2-checkpoint-restore-map-rows fn2-checkpoint-restore-map))
                     (equal (fn2-checkpoint-refs-storage-domain r fn2-checkpoint-refs) 0)
                     (equal (fn2-checkpoint-refs-page-kind r fn2-checkpoint-refs) *page-kind-manifest*)
                     (equal (fn2-checkpoint-refs-encoded-length r fn2-checkpoint-refs) *fn2-format-page-size*)
                     (equal (fn2-checkpoint-restore-map-present e fn2-checkpoint-restore-map) 1)
                     (equal (fn2-checkpoint-restore-map-state e fn2-checkpoint-restore-map) *fn2-extent-state-reserved*)
                     (equal (fn2-checkpoint-restore-map-epoch e fn2-checkpoint-restore-map) (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs))
                     (equal (fn2-checkpoint-restore-map-allocation e fn2-checkpoint-restore-map) (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs))))
       (mv :reference fn2-checkpoint-restore-semantic))
      ((unless (and (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen) (unsigned-byte-p 8 kind)
                     (unsigned-byte-p 32 owner) (unsigned-byte-p 60 generation)
                     (eq (fn2-pool-workspace-code slot gen kind owner generation fn2-pool) :ok)
                     (<= *fn2-format-page-size* (fn2-pool-cap slot fn2-pool))))
       (mv :window fn2-checkpoint-restore-semantic))
      (fn2-checkpoint-restore-semantic (fn2-checkpoint-restore-semantic-root-hash 0 (* 32 r) fn2-checkpoint-bytes fn2-checkpoint-restore-semantic))
      (fn2-checkpoint-restore-semantic (fn2-checkpoint-restore-semantic-put 0
       (phase *fn2-checkpoint-restore-semantic-phase-read*) (candidate c) (unit unit)
       (epoch (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs)) (allocation (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs))
       (cursor 0) (slot slot) (gen gen) (owner-kind kind) (owner-slot owner) (owner-gen generation))))
  (mv :read fn2-checkpoint-restore-semantic)))

(fn2-checkpoint-restore-semantic-preserves fn2-checkpoint-restore-semantic-root-hash
 (i src fn2-checkpoint-bytes fn2-checkpoint-restore-semantic))
(fn2-checkpoint-restore-semantic-preserves fn2-checkpoint-restore-semantic-begin
 (slot gen kind owner generation fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-pool fn2-checkpoint-restore-semantic)
 :position 1)

(defun fn2-checkpoint-restore-semantic-load-hash (i row fn2-checkpoint-restore-semantic fn2-digests)
 (declare (xargs :stobjs (fn2-checkpoint-restore-semantic fn2-digests) :measure (nfix (- 8 (nfix i)))
  :guard (and (fn2-checkpoint-restore-semantic-wfp fn2-checkpoint-restore-semantic) (fn2-digest-rowp row fn2-digests) (natp i) (<= i 8))))
 (if (>= (nfix i) 8) fn2-digests
  (let* ((at (* 4 i))
         (word (fn-b3-word (+ (fn2-checkpoint-restore-semantic-hashi at fn2-checkpoint-restore-semantic)
             (* 256 (fn2-checkpoint-restore-semantic-hashi (+ at 1) fn2-checkpoint-restore-semantic))
             (* 65536 (fn2-checkpoint-restore-semantic-hashi (+ at 2) fn2-checkpoint-restore-semantic))
             (* 16777216 (fn2-checkpoint-restore-semantic-hashi (+ at 3) fn2-checkpoint-restore-semantic)))))
         (fn2-digests (fn2-digest-set-word row i word fn2-digests)))
   (fn2-checkpoint-restore-semantic-load-hash (+ i 1) row fn2-checkpoint-restore-semantic fn2-digests))))

(defmacro fn2-checkpoint-restore-semantic-page-mv (code)
 `(mv ,code fn2-checkpoint-restore-semantic fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))

; The outer boot reader fills the retained lease in exact sector steps. This
; operation authenticates those actual bytes before invoking the SAME typed
; header decoder as live construction. No verified/ready argument exists.
(defun fn2-checkpoint-restore-semantic-page (budget row base fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
 fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-semantic
 fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
 (declare (xargs :stobjs (fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-semantic fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
  :guard (and (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
   (fn2-checkpoint-restore-map-wfp fn2-checkpoint-restore-map) (fn2-checkpoint-restore-map-control-wfp fn2-checkpoint-restore-map-control)
   (fn2-checkpoint-restore-semantic-wfp fn2-checkpoint-restore-semantic) (fn2-fc-wfp fn2-fc) (fn2-fc-context-wfp fn2-fc-context)
   (fn2-b3-wfp fn2-b3) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (fn2-digests-wfp fn2-digests))))
 (b* (((unless (and (< 0 (fn2-checkpoint-restore-semantic-rows fn2-checkpoint-restore-semantic))
                    (fn2-checkpoint-restore-map-current-p fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control)
                    (member (fn2-checkpoint-restore-semantic-phase 0 fn2-checkpoint-restore-semantic)
                     (list *fn2-checkpoint-restore-semantic-phase-read* *fn2-checkpoint-restore-semantic-phase-verify*))
                    (equal (fn2-checkpoint-restore-semantic-candidate 0 fn2-checkpoint-restore-semantic)
                           (fn2-checkpoint-restore-map-control-candidate 0 fn2-checkpoint-restore-map-control))
                    (natp row) (< row (fn2-fc-rows fn2-fc)) (< row (fn2-fc-context-rows fn2-fc-context))
                    (fn2-run-readerp base fn2-fields) (posp budget) (<= budget 4096)
                    (or (equal (fn2-checkpoint-restore-semantic-phase 0 fn2-checkpoint-restore-semantic) *fn2-checkpoint-restore-semantic-phase-read*)
                        (and (equal row (fn2-checkpoint-restore-semantic-checker-row 0 fn2-checkpoint-restore-semantic))
                             (equal base (fn2-checkpoint-restore-semantic-field-base 0 fn2-checkpoint-restore-semantic))
                             (equal (fn2-fc-phase row fn2-fc) (fn2-checkpoint-restore-semantic-checker-phase 0 fn2-checkpoint-restore-semantic))
                             (equal (fn2-fc-pos row fn2-fc) (fn2-checkpoint-restore-semantic-checker-pos 0 fn2-checkpoint-restore-semantic))
                             (equal (fn2-fc-zero row fn2-fc) (fn2-checkpoint-restore-semantic-checker-zero 0 fn2-checkpoint-restore-semantic))
                             (equal (fn2-fc-pad row fn2-fc) (fn2-checkpoint-restore-semantic-checker-pad 0 fn2-checkpoint-restore-semantic))
                             (equal (fn2-fc-pad-end row fn2-fc) (fn2-checkpoint-restore-semantic-checker-pad-end 0 fn2-checkpoint-restore-semantic))
                             (equal (fn2-fc-geom row fn2-fc) (fn2-checkpoint-restore-semantic-checker-geom 0 fn2-checkpoint-restore-semantic))
                             (equal (fn2-fc-previous-seal-offset row fn2-fc) (fn2-checkpoint-restore-semantic-checker-previous-seal-offset 0 fn2-checkpoint-restore-semantic))
                             ))))
       (fn2-checkpoint-restore-semantic-page-mv :source))
      (c (fn2-checkpoint-restore-semantic-candidate 0 fn2-checkpoint-restore-semantic))
      (slot (fn2-checkpoint-restore-semantic-slot 0 fn2-checkpoint-restore-semantic))
      (gen (fn2-checkpoint-restore-semantic-gen 0 fn2-checkpoint-restore-semantic))
      (kind (fn2-checkpoint-restore-semantic-owner-kind 0 fn2-checkpoint-restore-semantic))
      (owner (fn2-checkpoint-restore-semantic-owner-slot 0 fn2-checkpoint-restore-semantic))
      (generation (fn2-checkpoint-restore-semantic-owner-gen 0 fn2-checkpoint-restore-semantic))
      (hash (fn2-digest-slot row *fn2-fc-hash*))
      ((unless (and (fn2-b3-ready row fn2-b3 fn2-digests) (fn2-digest-rowp hash fn2-digests)
                    (fn2-digest-rowp (fn2-digest-slot row *fn2-fc-geometry*) fn2-digests)
                    (fn2-digest-rowp (fn2-digest-slot row *fn2-fc-previous-seal*) fn2-digests)
                    (eq (fn2-pool-workspace-code slot gen kind owner generation fn2-pool) :ok)
                    (equal (fn2-pool-fill slot fn2-pool) *fn2-format-page-size*)
                    (or (equal (fn2-checkpoint-restore-semantic-phase 0 fn2-checkpoint-restore-semantic) *fn2-checkpoint-restore-semantic-phase-verify*)
                        (equal (fn2-fc-phase row fn2-fc) *fn2-fc-phase-idle*))))
       (fn2-checkpoint-restore-semantic-page-mv :window))
      (fn2-digests (fn2-checkpoint-restore-semantic-load-hash 0 hash fn2-checkpoint-restore-semantic fn2-digests))
      (fn2-fc-context (fn2-fc-context-put row
       (location (fn2-checkpoint-restore-semantic-unit 0 fn2-checkpoint-restore-semantic))
       (writer-epoch (fn2-checkpoint-restore-semantic-epoch 0 fn2-checkpoint-restore-semantic))
       (allocation (fn2-checkpoint-restore-semantic-allocation 0 fn2-checkpoint-restore-semantic))
       (history (fn2-checkpoints-history c fn2-checkpoints)) (incarnation (fn2-checkpoints-incarnation c fn2-checkpoints))
       (page-kind *page-kind-manifest*) (encoded-length *fn2-format-page-size*) (hash hash)
       (geometry (fn2-digest-slot row *fn2-fc-geometry*)) (previous-seal (fn2-digest-slot row *fn2-fc-previous-seal*))))
      ((mv code fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
       (fn2-format-run :page nil row slot gen 0 *fn2-format-page-size* base kind owner generation budget fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      (fn2-checkpoint-restore-semantic (fn2-checkpoint-restore-semantic-put 0
       (phase (cond ((eq code :more) *fn2-checkpoint-restore-semantic-phase-verify*)
                    ((eq code :ok) *fn2-checkpoint-restore-semantic-phase-header*)
                    (t *fn2-checkpoint-restore-semantic-phase-uncertain*)))
       (checker-row row) (field-base base)
       (checker-phase (fn2-fc-phase row fn2-fc))
       (checker-pos (fn2-fc-pos row fn2-fc))
       (checker-zero (fn2-fc-zero row fn2-fc))
       (checker-pad (fn2-fc-pad row fn2-fc))
       (checker-pad-end (fn2-fc-pad-end row fn2-fc))
       (checker-geom (fn2-fc-geom row fn2-fc))
       (checker-previous-seal-offset (fn2-fc-previous-seal-offset row fn2-fc))
       ))
      ((unless (eq code :ok)) (fn2-checkpoint-restore-semantic-page-mv code))
      ; Run identity/height are authenticated page observations, not supplied
      ; admission facts. Schema10 is the declared root1 manifest format.
      ((mv code fn2-fields) (fn2-run-read-header slot gen base kind owner generation fn2-fields fn2-pool))
      ((unless (eq code :ok)) (fn2-checkpoint-restore-semantic-page-mv :source-header))
      (run (fn2-run-hdr base run)) (level (fn2-run-hdr base level))
      ((mv code fn2-fields) (fn2-checkpoint-semantic-page-read-header slot gen base 10 run level kind owner generation fn2-fields fn2-pool))
      ((unless (and (eq code :ok) (unsigned-byte-p 60 run) (unsigned-byte-p 8 level)
                    (unsigned-byte-p 32 (fn2-run-hdr base entries))))
       (fn2-checkpoint-restore-semantic-page-mv :source-header))
      (fn2-checkpoint-restore-semantic (fn2-checkpoint-restore-semantic-put 0
       (phase *fn2-checkpoint-restore-semantic-phase-entries*) (schema 10) (run run) (level level)
       (entries (fn2-run-hdr base entries)))))
  (fn2-checkpoint-restore-semantic-page-mv :entries)))

(fn2-fc-shape fn2-checkpoint-restore-semantic-page-shape
 (fn2-checkpoint-restore-semantic-page budget row base fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
 fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-semantic
 fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
 (and (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
   (fn2-checkpoint-restore-map-wfp fn2-checkpoint-restore-map) (fn2-checkpoint-restore-map-control-wfp fn2-checkpoint-restore-map-control)
   (fn2-checkpoint-restore-semantic-wfp fn2-checkpoint-restore-semantic) (fn2-fc-wfp fn2-fc) (fn2-fc-context-wfp fn2-fc-context)
   (fn2-b3-wfp fn2-b3) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (fn2-digests-wfp fn2-digests))
 ((fn2-checkpoint-restore-semantic 1) (fn2-fc 2) (fn2-fc-context 3) (fn2-b3 4) (fn2-fields 5) (fn2-pool 6) (fn2-digests 7)))

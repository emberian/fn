; Scoped identity projection for the protected NNTP carrier. The command
; actor supplies the requested stream and its linked cursor. The cursor's
; principal, grant continuation, membership and source bytes are read here.
(in-package "ACL2")
(include-book "peer-view-read")
(fn2-book-layer :e)

(defmacro fn2-xfnc-view-events ()
 '(progn
   (defun fn2-xfnc-linked-request-p (cursor generation fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (and (fn2-conn-cursor-live-p cursor generation fn2-core)
         (equal (fn2-cursor-row-tag cursor fn2-core) *fn2-nntp-command-xfnc*)
         (let ((conn (fn2-cursor-row-conn cursor fn2-core)))
           (and (fn2-xfnc-reader-live-p conn (fn2-cursor-row-conn-gen cursor fn2-core) fn2-core)
                (equal (fn2-conn-row-query conn fn2-core) cursor)
                (equal (fn2-conn-row-query-gen conn fn2-core) generation)))))
   (in-theory (disable fn2-xfnc-linked-request-p))
   (defun fn2-xfnc-live-login (cursor generation fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (b* (((unless (fn2-xfnc-linked-request-p cursor generation fn2-core)) (mv :state 0 0 0))
         (conn (fn2-cursor-row-conn cursor fn2-core)) (cgen (fn2-cursor-row-conn-gen cursor fn2-core))
         ((mv bound pid &) (fn2-conn-authenticated-peer conn cgen fn2-core)))
      (if (and (eq bound :ok) (posp pid) (unsigned-byte-p 60 pid)
               (or (equal pid (fn2-cursor-row-peer-principal cursor fn2-core))
                   (and (equal (fn2-cursor-row-peer-principal cursor fn2-core) 0)
                        (equal (fn2-cursor-row-peer-stage cursor fn2-core) *fn2-xfnc-request-stage-decode*)))
               (fn2-auth-served fn2-core)
               (equal (fn2-conn-row-phase conn fn2-core) *fn2-conn-state-query*)
               (equal (fn2-cursor-row-cancel cursor fn2-core) 0)
               (not (member-equal (fn2-cursor-row-phase cursor fn2-core)
                     (list *fn2-cursor-state-free* *fn2-cursor-state-draining* *fn2-cursor-state-retired*))))
          (mv :ok pid conn cgen)
        (mv :access 0 0 0))))
   (in-theory (disable fn2-xfnc-live-login))
   ; Use the query cursor's reserved primary C read row. No local control
   ; administrator defaults apply on this remote carrier.
   (fn2-csnapshot-op fn2-xfnc-read-rights (cursor generation stream budget) 3
    (b* (((mv bound pid conn &) (fn2-xfnc-live-login cursor generation fn2-core))
         ((unless (and (eq bound :ok) (posp pid) (unsigned-byte-p 60 pid)
                       (posp stream) (unsigned-byte-p 60 stream) (posp budget)))
          (mv :access 0 0 fn2-core))
         (x (* 2 (fn2-machine-slot cursor fn2-core)))
         (same (and (equal pid (fn2-cursor-row-view-principal cursor fn2-core))
                    (equal stream (fn2-cursor-row-view-stream cursor fn2-core))))
         (stage (if same (fn2-cursor-row-view-right cursor fn2-core) 0))
         ((unless (member-equal stage '(0 1 2 3))) (mv :state 0 0 fn2-core))
         (right (case stage (0 *fn2-authority-right-peer*) (1 *fn2-authority-right-consume*)
                            (2 *fn2-authority-right-peer-feed*) (otherwise *fn2-authority-right-read*)))
         (scope (case stage (0 *fn2-authority-scope-principal*) (1 *fn2-authority-scope-own-consumers*)
                            (otherwise *fn2-authority-scope-stream*)))
         (step (if same (fn2-cursor-row-view-step cursor fn2-core) 0))
         (head (if same (fn2-cursor-row-view-head cursor fn2-core) 0))
         (grant (if same (fn2-cursor-row-view-grant cursor fn2-core) 0))
         (anchor (if same (fn2-cursor-row-view-anchor cursor fn2-core) 0))
         ((mv code n h g fn2-core)
          (fn2-authority-principal-allows x pid right scope (if (< stage 2) 0 stream)
                                          step head grant budget fn2-core))
         ((unless (and (unsigned-byte-p 8 n) (unsigned-byte-p 60 h) (unsigned-byte-p 60 g)))
          (mv :state 0 0 fn2-core))
         (valid (and (eq code :ok) (posp h) (posp g)))
         (role-ok (or (not (equal stage 0)) (equal g (fn2-conn-row-peer-role-grant conn fn2-core))))
         (consistent (or (equal stage 0) (equal anchor h)))
         (accepted (and valid role-ok consistent))
         (more (eq code :more))
         (fn2-core (fn2-cursor-put-core cursor (view-principal pid) (view-stream stream)
          (view-anchor (cond ((and accepted (equal stage 0)) h)
                             ((or more (and accepted (< stage 3))) anchor) (t 0)))
          (view-right (cond (more stage) ((and accepted (< stage 3)) (+ 1 stage)) (t 0)))
          (view-step (if more n 0)) (view-head (if more h 0)) (view-grant (if more g 0)))))
      (cond ((and valid (not role-ok)) (mv :access 0 0 fn2-core))
            ((and accepted (equal stage 3)) (mv :ok pid h fn2-core))
            ((or valid more) (mv :more 0 0 fn2-core))
            ((eq code :access) (mv (if (< stage 2) :access :absent) 0 0 fn2-core))
            (t (mv :state 0 0 fn2-core)))))

   ; A published result requires the original peer role, consume, feed and read under the same
   ; current authority head. Between the initial and final check, scan one record
   ; per turn. Nothing from the private scan is offered to SEND.
   (fn2-csnapshot-op fn2-xfnc-read-projection (cursor generation token stream budget) 5
    (b* (((mv bound pid conn cgen) (fn2-xfnc-live-login cursor generation fn2-core))
         ((unless (and (eq bound :ok) (posp stream) (unsigned-byte-p 60 stream) (posp budget)))
          (mv :access 0 0 0 0 fn2-core))
         (same (and (equal pid (fn2-cursor-row-view-principal cursor fn2-core))
                    (equal stream (fn2-cursor-row-view-stream cursor fn2-core))))
         (saved (if same (fn2-cursor-row-view-version cursor fn2-core) 0))
         (publishing (and same (equal 1 (fn2-cursor-row-view-publish cursor fn2-core))))
         (fn2-core (if same fn2-core
                     (fn2-cursor-put-core cursor (view-version 0) (view-publish 0))))
         ((mv rights principal head fn2-core)
          (if (and (posp saved) (not publishing)) (mv :ok pid saved fn2-core)
            (fn2-xfnc-read-rights cursor generation stream budget fn2-core)))
         ((unless (eq rights :ok))
          (let ((fn2-core (if (eq rights :more) fn2-core
                            (fn2-cursor-put-core cursor (view-version 0) (view-publish 0)))))
           (mv rights 0 0 0 0 fn2-core)))
         ((unless (and (equal principal pid) (posp head) (unsigned-byte-p 60 head)))
          (mv :access 0 0 0 0 fn2-core))
         ((unless (equal head (fn2-cursor-row-peer-head cursor fn2-core)))
          (mv :rebase-required 0 0 0 0 fn2-core))
         ((mv source & &) (fn2-retained-journal-seals token *fn2-conn-kind* conn cgen fn2-core))
         ((unless (eq source :ok)) (mv :source 0 0 0 0 fn2-core))
         ((mv code hs he es ee fn2-core)
          (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))
                      (fn2-journal-lease (fn2-core-journal-lease fn2-core))
                      (fn2-journal-members (fn2-core-journal-members fn2-core))
                      (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
           (code hs he es ee fn2-event-read fn2-fields)
           (fn2-peer-view-read-step token principal stream head *fn2-conn-kind* conn cgen
            fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool)
           (mv code hs he es ee fn2-core)))
         (result (member-eq code '(:item :hidden :dependency :identity)))
         (deliver (and result publishing (equal saved head)))
         (fn2-core (fn2-cursor-put-core cursor (view-version head)
                    (view-publish (if (and result (not deliver)) 1 0)))))
     (cond (deliver (mv code hs he es ee fn2-core))
           (result (mv :more 0 0 0 0 fn2-core))
           (t (mv code 0 0 0 0 fn2-core)))))
   ; Terminal response follows the actual reader drain. Keep the reason in
   ; the cursor while a physical operation or promised-read edge remains.
   (fn2-csnapshot-op fn2-xfnc-close-view (cursor generation) 1
    (b* (((unless (fn2-xfnc-linked-request-p cursor generation fn2-core)) (mv :owner fn2-core))
         (conn (fn2-cursor-row-conn cursor fn2-core)) (cgen (fn2-cursor-row-conn-gen cursor fn2-core))
         (reason (fn2-cursor-row-view-end cursor fn2-core))
         ((mv closed fn2-core) (fn2-xfnc-reader-close conn cgen fn2-core))
         ((unless (eq closed :done)) (mv closed fn2-core))
         (fn2-core (fn2-cursor-put-core cursor (view-end *fn2-xfnc-end-none*) (view-version 0) (view-publish 0)
                    (view-step 0) (view-head 0) (view-grant 0) (view-right 0) (view-anchor 0))))
     (mv (cond ((equal reason *fn2-xfnc-end-empty*) :empty)
               ((equal reason *fn2-xfnc-end-complete*) :complete)
               ((equal reason *fn2-xfnc-end-access*) :access)
               ((equal reason *fn2-xfnc-end-rebase-required*) :rebase-required)
               ((equal reason *fn2-xfnc-end-absent*) :absent)
               ((equal reason *fn2-xfnc-end-dependency*) :dependency)
               ((equal reason *fn2-xfnc-end-uncertain*) :uncertain)
               ((equal reason *fn2-xfnc-end-invalid*) :invalid)
               (t :done)) fn2-core)))

   ; Resolve only the still-current verified leaf; the projected span
   ; coordinates from the preceding turn refer to this exact range.
   (defun fn2-xfnc-projected-window (token conn generation fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (if (not (and (posp token) (equal token (fn2-xfnc-reader-project-token conn generation fn2-core))))
        (mv :source 0 0 0 0 0 0 0)
      (stobj-let ((fn2-journal-members (fn2-core-journal-members fn2-core))
                  (fn2-event-read (fn2-core-event-read fn2-core))) (code slot gen event hs he es ee)
       (if (and (< 0 (fn2-journal-members-rows fn2-journal-members))
                (< 0 (fn2-event-read-rows fn2-event-read))
                (equal token (fn2-event-read-view-token 0 fn2-event-read))
                (equal (fn2-journal-members-event 0 fn2-journal-members) (fn2-event-read-view-event 0 fn2-event-read))
                (equal (fn2-event-read-view-off 0 fn2-event-read) (fn2-event-read-view-end 0 fn2-event-read))
                (equal (fn2-event-read-view-member 0 fn2-event-read) 1)
                (equal (fn2-event-read-view-other 0 fn2-event-read) 0)
                (equal (fn2-journal-members-slot 0 fn2-journal-members) (fn2-event-read-view-slot 0 fn2-event-read))
                (equal (fn2-journal-members-gen 0 fn2-journal-members) (fn2-event-read-view-gen 0 fn2-event-read)))
           (mv :ok (fn2-journal-members-slot 0 fn2-journal-members)
                   (fn2-journal-members-gen 0 fn2-journal-members)
                   (fn2-journal-members-event 0 fn2-journal-members)
                   (fn2-event-read-view-hs 0 fn2-event-read)
                   (fn2-event-read-view-he 0 fn2-event-read)
                   (fn2-event-read-view-es 0 fn2-event-read)
                   (fn2-event-read-view-ee 0 fn2-event-read))
         (mv :source 0 0 0 0 0 0 0))
       (mv code slot gen event hs he es ee))))
   (in-theory (disable fn2-xfnc-projected-window))

   ; One turn of a protected request. The caller retains :ITEM on pressure;
   ; the reader leaf stays current until the page sink consumes that item.
   ; A hidden event advances only after the same-head visibility check.
   ; Successful exhaustion leaves the cut held until the page sink captures
   ; its result and explicitly calls FN2-XFNC-CLOSE-VIEW.
   (fn2-csnapshot-op fn2-xfnc-peer-read-turn (cursor generation stream budget) 5
    (b* (((unless (fn2-xfnc-linked-request-p cursor generation fn2-core))
          (mv :state 0 0 0 0 fn2-core))
         ((when (not (equal (fn2-cursor-row-view-end cursor fn2-core) *fn2-xfnc-end-none*)))
          (mv-let (code fn2-core) (fn2-xfnc-close-view cursor generation fn2-core)
           (mv code 0 0 0 0 fn2-core)))
         ((mv login pid conn cgen) (fn2-xfnc-live-login cursor generation fn2-core))
         (head (fn2-cursor-row-peer-head cursor fn2-core))
         (from (fn2-cursor-row-peer-position cursor fn2-core))
         ((unless (and (eq login :ok) (posp stream) (unsigned-byte-p 60 stream) (posp budget)
                       (equal (fn2-cursor-row-peer-stage cursor fn2-core) *fn2-xfnc-request-stage-ready*)
                       (posp (fn2-cursor-row-peer-items cursor fn2-core))
                       (equal stream (fn2-cursor-row-peer-stream cursor fn2-core))
                       (posp head) (natp from)))
          (let ((fn2-core (fn2-cursor-put-core cursor (view-end *fn2-xfnc-end-access*))))
           (mv :more 0 0 0 0 fn2-core)))
         (ready (and (equal pid (fn2-cursor-row-view-principal cursor fn2-core))
                     (equal stream (fn2-cursor-row-view-stream cursor fn2-core))
                     (equal head (fn2-cursor-row-view-version cursor fn2-core))))
         ((unless ready)
          (b* ((fn2-core (fn2-cursor-put-core cursor (view-version 0) (view-publish 0)))
               ((mv rights principal current-head fn2-core) (fn2-xfnc-read-rights cursor generation stream budget fn2-core))
               (granted (and (eq rights :ok) (equal pid principal) (equal head current-head) (unsigned-byte-p 60 head)))
               (fn2-core (if granted (fn2-cursor-put-core cursor (view-version head))
                          (if (eq rights :more) fn2-core
                            (fn2-cursor-put-core cursor (view-end (cond ((eq rights :absent) *fn2-xfnc-end-absent*)
                                            ((and (eq rights :ok) (equal pid principal)) *fn2-xfnc-end-rebase-required*)
                                            ((member-eq rights '(:access :ok)) *fn2-xfnc-end-access*)
                                            (t *fn2-xfnc-end-uncertain*))))))))
           (mv :more 0 0 0 0 fn2-core)))
         ((mv state fn2-core) (fn2-xfnc-reader-step conn cgen budget fn2-core))
         ((when (member-eq state '(:wait :more :busy :exhausted :drain :stopped)))
          (mv state 0 0 0 0 fn2-core))
         ((when (member-eq state '(:empty :complete)))
          (b* (((mv rights principal head fn2-core) (fn2-xfnc-read-rights cursor generation stream budget fn2-core))
               ((when (eq rights :more)) (mv :more 0 0 0 0 fn2-core))
               ((when (and (eq rights :ok) (equal pid principal)
                           (equal head (fn2-cursor-row-view-version cursor fn2-core))))
                (mv state 0 0 0 0 fn2-core))
               (reason (cond ((eq rights :absent) *fn2-xfnc-end-absent*)
                             ((and (eq rights :ok) (equal pid principal)) *fn2-xfnc-end-rebase-required*)
                             ((member-eq rights '(:access :ok)) *fn2-xfnc-end-access*)
                             (t *fn2-xfnc-end-uncertain*)))
               (fn2-core (fn2-cursor-put-core cursor (view-end reason))))
           (mv :more 0 0 0 0 fn2-core)))
         ((unless (eq state :project))
          (let ((fn2-core (fn2-cursor-put-core cursor (view-end (if (eq state :uncertain)
                          *fn2-xfnc-end-uncertain* *fn2-xfnc-end-invalid*)))))
           (mv :more 0 0 0 0 fn2-core)))
         (token (fn2-xfnc-reader-project-token conn cgen fn2-core))
         ((mv code hs he es ee fn2-core)
          (fn2-xfnc-read-projection cursor generation token stream budget fn2-core))
         ((when (eq code :hidden))
          (mv-let (advance fn2-core) (fn2-xfnc-reader-advance conn cgen fn2-core)
           (mv (if (member-eq advance '(:ok :next :complete)) :more advance) 0 0 0 0 fn2-core)))
         ((when (member-eq code '(:item :more))) (mv code hs he es ee fn2-core))
         (fn2-core (fn2-cursor-put-core cursor
                    (view-end (cond ((eq code :absent) *fn2-xfnc-end-absent*)
                                    ((eq code :access) *fn2-xfnc-end-access*)
                                    ((eq code :rebase-required) *fn2-xfnc-end-rebase-required*)
                                    ((eq code :dependency) *fn2-xfnc-end-dependency*)
                                    (t *fn2-xfnc-end-invalid*))))))
      (mv :more 0 0 0 0 fn2-core)))))

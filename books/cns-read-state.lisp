; Four bounded continuations per actual consumer read row: cursor lookup,
; stream frontier, next-item selection and overview Message-ID selection.
(in-package "ACL2")
(include-book "machines-b")
(fn2-book-layer :e)
(defconst *fn2-cns-read-work-stride* 4)
(defconst *fn2-cns-read-work-done* 255)
(defcolumns fn2-cns-read-work
 ((owner :u32) (generation :u60) (phase :u8)
  (a :u60) (b :u60) (c :u60) (d :u60) (e :u60) (f :u60)
  (v0 :u60) (v1 :u60) (v2 :u60) (v3 :u60) (v4 :u60) (v5 :u60)))
(defcorechild fn2-core-cns-read-work fn2-cns-read-work
 :init (fn2-cns-read-work-init (* *fn2-cns-read-work-stride* (fn2-b-read-rows profile)) fn2-cns-read-work)
 :profilep (unsigned-byte-p 32 (* *fn2-cns-read-work-stride* (fn2-b-read-rows profile)))
 :why "Consumer reads retain actual request generation, inputs and selected rows across physical page misses.")

; OWNER/GEN come only from the core wrapper's actual admitted directory
; check. This leaf is also the concrete carrier projection used by controls.
(defun fn2-cns-read-work-open (x op owner gen a b c d e f fn2-cns-read-work)
 (declare (xargs :stobjs fn2-cns-read-work :guard (fn2-cns-read-work-wfp fn2-cns-read-work)))
 (b* (((unless (and (natp x) (natp op) (< op *fn2-cns-read-work-stride*)
                    (unsigned-byte-p 32 owner) (unsigned-byte-p 60 gen)
                    (unsigned-byte-p 60 a) (unsigned-byte-p 60 b) (unsigned-byte-p 60 c)
                    (unsigned-byte-p 60 d) (unsigned-byte-p 60 e) (unsigned-byte-p 60 f)))
       (mv :bounds 0 0 0 0 0 0 0 fn2-cns-read-work))
      (w (+ (* *fn2-cns-read-work-stride* x) op))
      ((unless (< w (fn2-cns-read-work-rows fn2-cns-read-work)))
       (mv :bounds 0 0 0 0 0 0 0 fn2-cns-read-work))
      (same (and (equal owner (fn2-cns-read-work-owner w fn2-cns-read-work))
                  (equal gen (fn2-cns-read-work-generation w fn2-cns-read-work))))
      (inputs (and (equal a (fn2-cns-read-work-a w fn2-cns-read-work))
                    (equal b (fn2-cns-read-work-b w fn2-cns-read-work))
                    (equal c (fn2-cns-read-work-c w fn2-cns-read-work))
                    (equal d (fn2-cns-read-work-d w fn2-cns-read-work))
                    (equal e (fn2-cns-read-work-e w fn2-cns-read-work))
                    (equal f (fn2-cns-read-work-f w fn2-cns-read-work))))
      (phase (fn2-cns-read-work-phase w fn2-cns-read-work))
      ((unless (or (not same) inputs (member phase (list 0 *fn2-cns-read-work-done*))))
       (mv :state 0 0 0 0 0 0 0 fn2-cns-read-work))
      (fresh (or (not same) (not inputs) (equal phase 0)))
      (fn2-cns-read-work (if fresh (fn2-cns-read-work-put w (owner owner) (generation gen)
        (phase 1) (a a) (b b) (c c) (d d) (e e) (f f)
        (v0 0) (v1 0) (v2 0) (v3 0) (v4 0) (v5 0)) fn2-cns-read-work)))
  (mv :ok (fn2-cns-read-work-phase w fn2-cns-read-work)
      (fn2-cns-read-work-v0 w fn2-cns-read-work) (fn2-cns-read-work-v1 w fn2-cns-read-work)
      (fn2-cns-read-work-v2 w fn2-cns-read-work) (fn2-cns-read-work-v3 w fn2-cns-read-work)
      (fn2-cns-read-work-v4 w fn2-cns-read-work) (fn2-cns-read-work-v5 w fn2-cns-read-work) fn2-cns-read-work)))
(defun fn2-cns-read-work-save (x op owner gen phase v0 v1 v2 v3 v4 v5 fn2-cns-read-work)
 (declare (xargs :stobjs fn2-cns-read-work :guard (fn2-cns-read-work-wfp fn2-cns-read-work)))
 (b* (((unless (and (natp x) (natp op) (< op *fn2-cns-read-work-stride*)
                    (unsigned-byte-p 32 owner) (unsigned-byte-p 60 gen) (unsigned-byte-p 8 phase)
                    (unsigned-byte-p 60 v0) (unsigned-byte-p 60 v1) (unsigned-byte-p 60 v2)
                    (unsigned-byte-p 60 v3) (unsigned-byte-p 60 v4) (unsigned-byte-p 60 v5)))
       (mv :bounds fn2-cns-read-work))
      (w (+ (* *fn2-cns-read-work-stride* x) op))
      ((unless (and (< w (fn2-cns-read-work-rows fn2-cns-read-work))
                    (equal owner (fn2-cns-read-work-owner w fn2-cns-read-work))
                    (equal gen (fn2-cns-read-work-generation w fn2-cns-read-work))))
       (mv :state fn2-cns-read-work))
      (fn2-cns-read-work (fn2-cns-read-work-put w (phase phase)
       (v0 v0) (v1 v1) (v2 v2) (v3 v3) (v4 v4) (v5 v5))))
  (mv :ok fn2-cns-read-work)))
(fn2-cns-read-work-preserves fn2-cns-read-work-open
 (x op owner gen a b c d e f fn2-cns-read-work) :position 8)
(fn2-cns-read-work-preserves fn2-cns-read-work-save
 (x op owner gen phase v0 v1 v2 v3 v4 v5 fn2-cns-read-work) :position 1)
(defthm fn2-cns-read-work-open-values-natural
 (implies (fn2-cns-read-work-wfp fn2-cns-read-work)
  (let ((r (fn2-cns-read-work-open x op owner gen a b c d e f fn2-cns-read-work)))
   (and (natp (mv-nth 1 r)) (natp (mv-nth 2 r)) (natp (mv-nth 3 r))
        (natp (mv-nth 4 r)) (natp (mv-nth 5 r)) (natp (mv-nth 6 r)) (natp (mv-nth 7 r)))))
 :hints (("Goal" :in-theory (enable fn2-cns-read-work-open))))

; Core-only registered continuation traversal. No native CURRENT export.
(in-package "ACL2")
(include-book "bp-controller-checkpoint-payload")
(defun fn-bpcc-segment-payload-action (controller token operation slot expected-revision expected-phase next-phase next-payload fn-bpc-segment)
  (declare (xargs :stobjs fn-bpc-segment :guard (and (natp slot) (< slot 64))))
  (cond ((eq operation :read)
         (mv-let (word current claim payload phase revision)
           (fn-bpcc-segment-payload-read token slot fn-bpc-segment)
           (mv word current claim payload phase revision fn-bpc-segment)))
        ((eq operation :replace)
         (mv-let (word fn-bpc-segment)
           (fn-bpcc-segment-payload-replace token slot expected-revision expected-phase next-phase next-payload fn-bpc-segment)
           (if (not (eq word :checkpoint-updated))
               (mv word nil nil nil nil nil fn-bpc-segment)
             (mv-let (read current claim payload phase revision)
               (fn-bpcc-segment-payload-read token slot fn-bpc-segment)
               (if (eq read :checkpoint-current)
                   (mv word current claim payload phase revision fn-bpc-segment)
                 (mv :checkpoint-fenced nil nil nil nil nil fn-bpc-segment))))))
        ((eq operation :fence-current)
         (let* ((row (fn-bpcs-rowsi slot fn-bpc-segment))
                (owned-token (fn-bpn-nth 0 (fn-bpn-nth 4 row))))
           (mv-let (word fn-bpc-segment)
             (fn-bpcc-segment-payload-cancel-current controller slot fn-bpc-segment)
             (if (not (eq word :checkpoint-retained))
                 (mv word nil nil nil nil nil fn-bpc-segment)
               (mv-let (read current claim payload phase revision)
                 (fn-bpcc-segment-payload-read owned-token slot fn-bpc-segment)
                 (declare (ignore read))
                 (mv word current claim payload phase revision fn-bpc-segment))))))
        (t (mv :checkpoint-operation-unavailable nil nil nil nil nil fn-bpc-segment))))
(defun fn-bpcc-node-payload (controller token operation slot physical-segment depth expected-revision expected-phase next-phase next-payload fuel fn-bpc-node)
  (declare (xargs :stobjs fn-bpc-node :measure (nfix depth)
                  :guard (and (natp slot) (< slot 64) (natp physical-segment) (natp depth) (natp fuel))))
  (cond ((<= fuel depth) (mv :yield nil nil nil nil nil fuel fn-bpc-node))
        ((zp depth)
         (if (not (fn-bpcn-children-boundp 'fn-bpc-segment fn-bpc-node))
             (mv :controller-unavailable nil nil nil nil nil (- fuel 1) fn-bpc-node)
           (stobj-let ((fn-bpc-segment (fn-bpcn-children-get 'fn-bpc-segment fn-bpc-node (create-fn-bpc-segment))))
             (word current claim payload phase revision fn-bpc-segment)
             (fn-bpcc-segment-payload-action controller token operation slot expected-revision expected-phase next-phase next-payload fn-bpc-segment)
             (mv word current claim payload phase revision (- fuel 1) fn-bpc-node))))
        ((equal (mod physical-segment 2) 0)
         (if (not (fn-bpcn-children-boundp 'fn-bpc-left fn-bpc-node))
             (mv :controller-unavailable nil nil nil nil nil (- fuel 1) fn-bpc-node)
           (stobj-let ((fn-bpc-left (fn-bpcn-children-get 'fn-bpc-left fn-bpc-node (create-fn-bpc-left))))
             (word current claim payload phase revision left fn-bpc-left)
             (fn-bpcc-node-payload controller token operation slot (floor physical-segment 2) (- depth 1)
                                  expected-revision expected-phase next-phase next-payload (- fuel 1) fn-bpc-left)
             (mv word current claim payload phase revision left fn-bpc-node))))
        (t
         (if (not (fn-bpcn-children-boundp 'fn-bpc-right fn-bpc-node))
             (mv :controller-unavailable nil nil nil nil nil (- fuel 1) fn-bpc-node)
           (stobj-let ((fn-bpc-right (fn-bpcn-children-get 'fn-bpc-right fn-bpc-node (create-fn-bpc-right))))
             (word current claim payload phase revision left fn-bpc-right)
             (fn-bpcc-node-payload controller token operation slot (floor physical-segment 2) (- depth 1)
                                  expected-revision expected-phase next-phase next-payload (- fuel 1) fn-bpc-right)
             (mv word current claim payload phase revision left fn-bpc-node))))))
(local (defthm fn-bpcc-payload-address-ranges
  (implies (natp address) (and (natp (mod address 64)) (< (mod address 64) 64) (natp (floor address 64))))
  :hints (("Goal" :in-theory (disable mod floor)))))
(defun fn-bpcc-directory-payload (controller token operation expected-revision expected-phase next-phase next-payload fuel fn-bp-controller-registry)
  (declare (xargs :stobjs fn-bp-controller-registry :guard (natp fuel)))
  (if (not (and (fn-bpc-tokenp controller)
                (< (caddr controller) (fn-bpcr-highwater fn-bp-controller-registry))
                (or (eq operation :fence-current)
                    (and (fn-bpcc-job-tokenp token) (equal (caddr token) controller)))))
      (mv :stale-controller nil nil nil nil nil fuel fn-bp-controller-registry)
    (let ((depth (fn-bpcr-depth fn-bp-controller-registry)))
    (stobj-let ((fn-bpc-node (fn-bpcr-root fn-bp-controller-registry)))
      (word current claim payload phase revision left fn-bpc-node)
      (fn-bpcc-node-payload controller token operation (mod (caddr controller) 64)
                           (floor (caddr controller) 64) depth
                           expected-revision expected-phase next-phase next-payload fuel fn-bpc-node)
      (mv word current claim payload phase revision left fn-bp-controller-registry)))))
(verify-guards fn-bpcc-segment-payload-action)
(verify-guards fn-bpcc-node-payload)
(verify-guards fn-bpcc-directory-payload
 :hints (("Goal" :in-theory (disable mod floor)
                 :use ((:instance fn-bpcc-payload-address-ranges (address (caddr controller)))))))

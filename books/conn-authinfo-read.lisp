;; Full envelope evidence can contain every application octet. The host
;; requests its capacity before I/O; the initialized authority partition
;; decides whether any byte capture can be admitted.
(defun fn2-conn-envelope-capture-admission (capacity fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (if (and (posp capacity) (fn2-auth-served fn2-core)) :protected :ok))

;; The connection's lookup row is outside the cursor, CNS and authority
;; blocks. Only the protected login continuation can use it.
(defun fn2-conn-authinfo-read-row (conn fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                 :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
 (let ((s (fn2-machine-slot conn fn2-core))
       (a (fn2-machine-connection-count *fn2-auth-admission-ordinal* fn2-core))
       (c (fn2-machine-connection-count *fn2-cns-admission-ordinal* fn2-core))
       (n (fn2-machine-connection-count *fn2-conn-admission-ordinal* fn2-core))
       (r (stobj-let ((fn2-reads (fn2-core-reads fn2-core))) (r) (fn2-reads-rows fn2-reads) r)))
   (if (and (eq (fn2-conn-snapshot-read-code conn fn2-core) :ok)
            (posp a) (natp c) (natp s) (natp n) (natp r) (< s n) (<= (+ a c n) r))
       (mv :ok (+ (- r (+ a c n)) s))
     (mv :bounds 0))))


(defun fn2-conn-peer-role-step (conn gen step head grant fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (b* (((unless (and (eq (fn2-conn-snapshot-read-code conn fn2-core) :ok)
                    (equal (fn2-machine-generation conn fn2-core) gen)
                    (equal (fn2-conn-row-phase conn fn2-core) *fn2-conn-state-peer-role*)))
       (mv :state 0 0 0 fn2-core))
      (at-login (equal (fn2-conn-row-peer-login conn fn2-core) 1))
      (mask (fn2-conn-row-mask conn fn2-core))
      (pid (if at-login (fn2-conn-row-login-candidate conn fn2-core)
             (fn2-conn-row-login-principal conn fn2-core)))
      ((unless (and (equal (fn2-conn-peering-p fn2-core) 1) (posp pid)
                    (unsigned-byte-p 60 pid) (integerp mask) (logtest mask *fn2-nntp-state-tls*)
                    (or at-login (and (logtest mask *fn2-nntp-state-authenticated*)
                                      (posp (fn2-conn-row-peer-role-grant conn fn2-core))))))
       (mv :access 0 0 0 fn2-core))
      ((mv rc x) (fn2-conn-authinfo-read-row conn fn2-core))
      ((unless (eq rc :ok)) (mv :state 0 0 0 fn2-core)))
   (fn2-authority-principal-allows x pid *fn2-authority-right-peer* *fn2-authority-scope-principal*
                                  0 step head grant 4096 fn2-core)))
(fn2-core-preserves fn2-conn-peer-role-step (conn gen step head grant fn2-core) :position 4 :rows nil)
(defthm fn2-conn-peer-role-step-widths
 (and (unsigned-byte-p 8 (mv-nth 1 (fn2-conn-peer-role-step conn gen step head grant fn2-core)))
      (unsigned-byte-p 60 (mv-nth 2 (fn2-conn-peer-role-step conn gen step head grant fn2-core)))
      (unsigned-byte-p 60 (mv-nth 3 (fn2-conn-peer-role-step conn gen step head grant fn2-core))))
 :hints (("Goal" :in-theory (enable fn2-conn-peer-role-step))))
(in-theory (disable fn2-conn-peer-role-step))
(defcost fn2-conn-peer-role-step :answers (:ok :access :more :state) :bytes 4096
 :tables (fn2-core-reads fn2-core-ranges fn2-core-seeks fn2-core-succ-txns fn2-core-run-cursors fn2-core-run-paths fn2-core-fields)
 :doc "One committed principal-scoped peer grant lookup on the connection's private read row.")

(defun fn2-conn-authinfo-user (x conn gen slot rgen off len fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (b* (((unless (and (posp len) (<= len *fn2-principals-name-max*)))
       (mv :absent 0 fn2-core))
      ((mv kc fn2-core)
       (if (fn2-auth-lookup-live x *fn2-principals-sid* fn2-core)
           (mv :ok fn2-core)
         (fn2-read-key-octets x *fn2-principals-entry-field-name*
           slot rgen off len *fn2-conn-kind* conn gen fn2-core)))
      ((unless (eq kc :ok)) (mv :state 0 fn2-core))
      ((mv code fn2-core) (fn2-auth-lookup-step x *fn2-principals-sid* 4096 fn2-core))
      ((unless (eq code :ok)) (mv code 0 fn2-core))
      ((mv tc pid & & fn2-core)
       (fn2-auth-take-values x *fn2-principals-entry-field-principal* nil nil fn2-core)))
   (if (and (eq tc :ok) (posp pid) (unsigned-byte-p 60 pid)
            (eq (fn2-auth-known pid fn2-core) :ok))
       (mv :ok pid fn2-core)
     (mv :absent 0 fn2-core))))
(fn2-core-preserves fn2-conn-authinfo-user (x conn gen slot rgen off len fn2-core) :position 2 :rows nil)
(defthm fn2-conn-authinfo-user-pid
 (unsigned-byte-p 60 (mv-nth 1 (fn2-conn-authinfo-user x conn gen slot rgen off len fn2-core))))

(defun fn2-conn-authinfo-load (x pid conn gen tx tgen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (b* (((unless (and (posp pid) (unsigned-byte-p 60 pid)))
       (mv :absent fn2-core))
      ((mv kc fn2-core)
       (if (fn2-auth-lookup-live x *fn2-authinfo-credential-sid* fn2-core)
           (mv :ok fn2-core)
         (fn2-read-key x :lo *fn2-authinfo-credential-entry-field-principal* pid fn2-core)))
      ((unless (eq kc :ok)) (mv :state fn2-core))
      ((mv code fn2-core) (fn2-auth-lookup-step x *fn2-authinfo-credential-sid* 4000 fn2-core))
      ((unless (eq code :ok)) (mv code fn2-core))
      ((mv pc stored) (fn2-read-value x *fn2-authinfo-credential-entry-field-principal* fn2-core))
      ((mv rc revision) (fn2-read-value x *fn2-authinfo-credential-entry-field-revision* fn2-core))
      ((mv s-code salt-size salt-left fn2-core)
       (if (and (eq pc :ok) (eq rc :ok) (equal stored pid) (posp revision))
           (fn2-read-octets x *fn2-authinfo-credential-entry-field-salt* 0 *fn2-authinfo-salt-octets*
             tx tgen 0 *fn2-conn-kind* conn gen fn2-core)
         (mv :state 0 0 fn2-core)))
      ((mv d-code digest-size digest-left fn2-core)
       (if (and (eq s-code :ok) (equal salt-size *fn2-authinfo-salt-octets*) (equal salt-left 0))
           (fn2-read-octets x *fn2-authinfo-credential-entry-field-verifier* 0 *fn2-authinfo-verifier-octets*
             tx tgen *fn2-authinfo-salt-octets* *fn2-conn-kind* conn gen fn2-core)
         (mv :state 0 0 fn2-core)))
      ((mv released fn2-core) (fn2-read-release x fn2-core)))
   (mv (if (and (eq d-code :ok) (equal digest-size *fn2-authinfo-verifier-octets*)
                (equal digest-left 0) (eq released :ok)) :ok :state) fn2-core)))
(fn2-core-preserves fn2-conn-authinfo-load (x pid conn gen tx tgen fn2-core) :position 1 :rows nil)

(defconst *fn2-conn-authinfo-capabilities* 3)
(defconst *fn2-conn-authinfo-capability-lines*
 (fn2-answer-crlf-lines '("AUTHINFO USER")))
(defconst *fn2-conn-authinfo-capabilities-text*
 (concatenate 'string *fn2-answer-capabilities-text* *fn2-conn-authinfo-capability-lines*))
(defconst *fn2-conn-authinfo-capabilities-posting-text*
 (concatenate 'string *fn2-answer-capabilities-posting-text* *fn2-conn-authinfo-capability-lines*))
(assert-event (and (<= (length *fn2-conn-authinfo-capabilities-text*) *fn2-answer-body-bytes*)
                   (<= (length *fn2-conn-authinfo-capabilities-posting-text*) *fn2-answer-body-bytes*)))

(defun fn2-conn-authinfo-form (s e mask pending rx rgen conn gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                 :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
 (if (not (and (integerp mask) (logtest mask *fn2-nntp-state-tls*)
               (logtest mask *fn2-nntp-state-anonymous*)
               (not (logtest mask *fn2-nntp-state-authenticated*))
               (fn2-auth-served fn2-core)))
     (mv 0 0 0)
   (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
     (mode offset len)
     (mv-let (code tag nargs f0 a0 b0 f1 a1 b1 f2 a2 b2 f3 a3 b3)
       (fn2-nntp-parse-line (nfix s) (nfix e) mask rx rgen *fn2-conn-kind* conn gen fn2-pool)
       (declare (ignore b0 f2 a2 b2 f3 a3 b3))
       (cond ((and (eq code :ok) (equal tag *fn2-nntp-command-capabilities*))
              (mv *fn2-conn-authinfo-capabilities* 0 0))
             ((and (eq code :ok) (equal tag *fn2-nntp-command-authinfo*) (equal nargs 2)
                   (eq f0 :keyword) (eq f1 :span) (unsigned-byte-p 32 a1)
                   (unsigned-byte-p 32 b1) (posp b1))
              (cond ((equal a0 0) (mv *fn2-conn-login-user* a1 b1))
                    ((and (equal a0 1) (equal pending *fn2-conn-auth-user*))
                     (mv *fn2-conn-login-pass* a1 b1))
                    (t (mv 0 0 0))))
             (t (mv 0 0 0))))
     (mv mode offset len))))
(defthm fn2-conn-authinfo-form-widths
 (and (unsigned-byte-p 32 (mv-nth 1 (fn2-conn-authinfo-form s e mask pending rx rgen conn gen fn2-core)))
      (unsigned-byte-p 32 (mv-nth 2 (fn2-conn-authinfo-form s e mask pending rx rgen conn gen fn2-core)))))

(defun fn2-conn-authinfo-capability-reply (posting mask tx tgen conn gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                 :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
   (code fn2-pool)
   (fn2-answer-say-body *fn2-nntp-command-capabilities* *fn2-nntp-reply-capabilities-list*
     mask (if (equal posting 1) *fn2-conn-authinfo-capabilities-posting-text*
            *fn2-conn-authinfo-capabilities-text*)
     tx tgen *fn2-conn-kind* conn gen fn2-pool)
   (mv code fn2-core)))
(fn2-core-preserves fn2-conn-authinfo-capability-reply (posting mask tx tgen conn gen fn2-core)
 :position 1 :rows nil)
(defcost fn2-conn-authinfo-capability-reply :answers (:ok :bounds) :bytes 1536
 :tables (fn2-core-pool)
 :doc "Render the typed CAPABILITIES body on a TLS connection accepting AUTHINFO USER.")

(defun fn2-conn-authinfo-clear-tx (conn gen tx tgen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                 :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
   (code fn2-pool)
   (fn2-pool-reset tx tgen *fn2-conn-kind* conn gen fn2-pool)
   (mv code fn2-core)))
(fn2-core-preserves fn2-conn-authinfo-clear-tx (conn gen tx tgen fn2-core) :position 1 :rows nil)

(defun fn2-conn-authinfo-check (conn gen rx rgen off len tx tgen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                 :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core)) (fn2-b3 (fn2-core-b3 fn2-core))
             (fn2-digests (fn2-core-digests fn2-core)))
   (answer fn2-pool fn2-digests fn2-b3)
   ;; The block-read hasher is used synchronously, from init to comparison.
   (b* ((k *fn2-conn-kind*)
        (row (fn2-b-block-read-row (fn2-b3-rows fn2-b3)))
        (start (+ *fn2-authinfo-salt-octets* *fn2-authinfo-verifier-octets*))
        ((mv staged n fn2-pool)
         (fn2-authinfo-stage-preimage tx tgen 0 k conn gen rx rgen off len k conn gen
                                     tx tgen start k conn gen fn2-pool))
        ((mv hashed fn2-digests fn2-b3)
         (if (eq staged :ok)
             (fn2-pool-block-hash row tx tgen start n k conn gen fn2-digests fn2-b3 fn2-pool)
           (mv :bounds fn2-digests fn2-b3)))
        (digest (fn2-digest-slot row *fn2-b3-result*))
        (same (and (eq hashed :ok) (fn2-digest-rowp digest fn2-digests)
                   (equal 0 (fn2-authinfo-verifier-mismatch
                             0 0 digest tx tgen *fn2-authinfo-salt-octets*
                             k conn gen fn2-digests fn2-pool))))
        ((mv cleared fn2-pool) (fn2-pool-reset tx tgen k conn gen fn2-pool)))
     (mv (cond ((not (eq cleared :ok)) :state) (same :ok) (t :absent))
         fn2-pool fn2-digests fn2-b3))
   (mv answer fn2-core)))
(fn2-core-preserves fn2-conn-authinfo-check (conn gen rx rgen off len tx tgen fn2-core) :position 1 :rows nil)

(defun fn2-conn-authinfo-step (mode pid conn gen rx rgen off len tx tgen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (b* (((mv row-code x) (fn2-conn-authinfo-read-row conn fn2-core))
      ((unless (eq row-code :ok)) (mv :state 0 fn2-core))
      ((when (equal mode *fn2-conn-login-user*))
       (fn2-conn-authinfo-user x conn gen rx rgen off len fn2-core))
      ((unless (and (equal mode *fn2-conn-login-pass*) (posp len) (<= len *fn2-authinfo-pass-max*)))
       (mv :absent 0 fn2-core))
      ((mv c fn2-core) (fn2-conn-authinfo-clear-tx conn gen tx tgen fn2-core))
      ((unless (eq c :ok)) (mv :state 0 fn2-core))
      ((mv c fn2-core) (fn2-conn-authinfo-load x pid conn gen tx tgen fn2-core))
      ((when (eq c :more)) (mv :more 0 fn2-core))
      ((unless (eq c :ok))
       (b* (((mv cleared fn2-core) (fn2-conn-authinfo-clear-tx conn gen tx tgen fn2-core)))
         (mv (if (eq cleared :ok) c :state) 0 fn2-core))))
   (mv :ok pid fn2-core)))
(fn2-core-preserves fn2-conn-authinfo-step
 (mode pid conn gen rx rgen off len tx tgen fn2-core) :position 2 :rows nil)

(defun fn2-conn-authinfo-transfer (source pid fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (let ((target (floor (nfix pid) 4294967296)))
   (if (and (unsigned-byte-p 16 target) (eq (fn2-auth-known pid fn2-core) :ok))
       (mv-let (code fn2-core)
         (fn2-account-with-ledger
           (fn2-account-attribute source target (fn2-account-holding :connection-row) 1
                                  (fn2-account-holding :connection-row) 0 fn2-accounts))
         (mv code target fn2-core))
     (mv :bounds 0 fn2-core))))
(fn2-core-preserves fn2-conn-authinfo-transfer (source pid fn2-core) :position 2 :rows nil)

(defun fn2-conn-authinfo-reply (reply close mask tx tgen conn gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                 :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
   (code fn2-pool)
   (mv-let (status fn2-pool)
       (fn2-answer-say *fn2-nntp-command-authinfo* reply mask 0 tx tgen *fn2-conn-kind* conn gen fn2-pool)
     (if (and (eq status :ok) (equal close 1))
         (fn2-answer-say *fn2-nntp-command-none* *fn2-nntp-reply-auth-failures*
                         mask 0 tx tgen *fn2-conn-kind* conn gen fn2-pool)
       (mv status fn2-pool)))
   (mv code fn2-core)))
(fn2-core-preserves fn2-conn-authinfo-reply (reply close mask tx tgen conn gen fn2-core) :position 1 :rows nil)
(defthm fn2-conn-authinfo-step-pid
 (unsigned-byte-p 60
   (mv-nth 1 (fn2-conn-authinfo-step mode pid conn gen rx rgen off len tx tgen fn2-core)))
 :hints (("Goal" :in-theory (enable fn2-conn-authinfo-step))))

(defthm fn2-conn-authinfo-transfer-slot
 (unsigned-byte-p 16 (mv-nth 1 (fn2-conn-authinfo-transfer source pid fn2-core))))

(defcost fn2-conn-authinfo-form :bytes 512
 :doc "Classify protected AUTHINFO and discovery on a held command span.")
(defcost fn2-conn-authinfo-step :answers (:ok :absent :more :state) :bytes 4096
 :tables (fn2-core-reads fn2-core-id-decides fn2-core-fields fn2-core-succ-txns
          fn2-core-ranges fn2-core-seeks fn2-core-run-cursors fn2-core-run-paths fn2-core-pool)
 :doc "One exact held USER or verifier lookup step.")
(defcost fn2-conn-authinfo-check :answers (:ok :absent :state) :bytes 2048
 :tables (fn2-core-pool fn2-core-digests fn2-core-b3)
 :doc "Hash the protected PASS span, compare and clear the TX scratch.")
(defcost fn2-conn-authinfo-transfer :answers (:ok :bounds :state :limit :shared)
 :tables (fn2-core-accounts)
 :doc "Move the connection reservation after exact principal and verifier checks.")
(defcost fn2-conn-authinfo-reply :answers (:ok :bounds :owner :stale :untyped) :bytes 1024
 :tables (fn2-core-pool)
 :doc "Render the selected AUTHINFO reply and, on the third failure, the typed 400.")

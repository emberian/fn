; Bounded FNCT transport operations. State/cursors belong to the CTL machine;
; no article-sized buffer is allocated and no incomplete trailer is accepted.
(in-package "ACL2")
(include-book "fnct-pool")
(fn2-book-layer :e)
; Keep decoder carrier preservation visible before representation expansion.
(local (in-theory (disable fn2-fields-rows fn2-fieldsp fn2-fields-wfp
                           fn2-poolp fn2-pool-wfp fn2-pool-rows)))

(defun fn2-fnct-stream-head (base slot gen okind oslot ogen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool)
  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (natp base)
                    (<= (+ base *fn2-fnct-header-num-fields*) (fn2-fields-rows fn2-fields))))
        (mv :bounds 0 0 fn2-fields))
      ((when (< (fn2-pool-fill-value slot fn2-pool) *fn2-fnct-header-octets*))
        (mv :need-more 0 0 fn2-fields))
      ((mv code & fn2-fields)
       (fn2-fnct-header-decode base slot gen 0 *fn2-fnct-header-octets*
                              okind oslot ogen fn2-fields fn2-pool))
      (kind (fn2-fields-value (+ base *fn2-fnct-header-field-kind*) fn2-fields))
      (plen (fn2-fields-value (+ base *fn2-fnct-header-field-length*) fn2-fields)))
  (if (and (eq code :ok)
           (equal (fn2-fields-value (+ base *fn2-fnct-header-field-magic*) fn2-fields) *fn2-fnct-magic*)
           (equal (fn2-fields-value (+ base *fn2-fnct-header-field-version*) fn2-fields) *fn2-fnct-version*)
           (unsigned-byte-p 8 kind) (unsigned-byte-p 32 plen))
      (mv :ok kind plen fn2-fields)
    (mv :frame 0 0 fn2-fields))))

(defun fn2-fnct-stream-start (row fn2-digests fn2-b3)
 (declare (xargs :stobjs (fn2-digests fn2-b3)
  :guard (and (fn2-digests-wfp fn2-digests) (fn2-b3-wfp fn2-b3))))
 (if (not (and (fn2-b3-ready row fn2-b3 fn2-digests)
               (fn2-digest-rowp (fn2-digest-slot (nfix row) *fn2-b3-key*) fn2-digests)))
     (mv :bounds fn2-digests fn2-b3)
  (mv-let (fn2-digests fn2-b3)
   (fn2-b3-init row 0 (fn2-digest-slot row *fn2-b3-key*) fn2-digests fn2-b3)
   (mv :ok fn2-digests fn2-b3))))

(defun fn2-fnct-stream-update (row slot gen off count okind oslot ogen fn2-digests fn2-b3 fn2-pool)
 (declare (xargs :stobjs (fn2-digests fn2-b3 fn2-pool)
  :guard (and (fn2-digests-wfp fn2-digests) (fn2-b3-wfp fn2-b3) (fn2-pool-wfp fn2-pool))))
 (if (not (and (fn2-b3-ready row fn2-b3 fn2-digests)
               (unsigned-byte-p 32 off) (unsigned-byte-p 32 count) (<= count 4096)))
     (mv :bounds 0 fn2-digests fn2-b3)
  (mv-let (code copied fn2-digests fn2-b3)
   (fn2-b3-update row slot gen off count okind oslot ogen fn2-digests fn2-b3 fn2-pool)
   (mv (if (member-eq code '(:ok :more)) code :bounds) copied fn2-digests fn2-b3))))

(defun fn2-fnct-stream-finish (row fn2-digests fn2-b3)
 (declare (xargs :stobjs (fn2-digests fn2-b3)
  :guard (and (fn2-digests-wfp fn2-digests) (fn2-b3-wfp fn2-b3))))
 (let ((dst (fn2-digest-slot (nfix row) *fn2-b3-result*)))
  (if (not (and (fn2-b3-ready row fn2-b3 fn2-digests) (fn2-digest-rowp dst fn2-digests)))
      (mv :bounds fn2-digests fn2-b3)
   (let ((fn2-digests (fn2-b3-finalize dst row fn2-digests fn2-b3)))
    (mv :ok fn2-digests fn2-b3)))))

(defun fn2-fnct-stream-trailer-part (index count dst slot gen off okind oslot ogen fn2-digests fn2-pool)
 (declare (xargs :stobjs (fn2-digests fn2-pool) :measure (nfix count)
  :guard (and (fn2-digest-rowp dst fn2-digests) (fn2-pool-wfp fn2-pool)
              (natp index) (natp count) (<= (+ index count) 32) (natp off))))
 (if (zp count) t
  (mv-let (code byte) (fn2-pool-read slot gen off okind oslot ogen fn2-pool)
   (and (eq code :ok)
        (equal byte (fn2-fc-word-byte (nfix (fn2-digest-word dst (floor index 4) fn2-digests)) (mod index 4)))
        (fn2-fnct-stream-trailer-part (+ 1 index) (- count 1) dst slot gen (+ 1 off)
                                     okind oslot ogen fn2-digests fn2-pool)))))

(defun fn2-fnct-stream-trailer (row index slot gen off end okind oslot ogen fn2-digests fn2-pool)
 (declare (xargs :stobjs (fn2-digests fn2-pool)
  :guard (and (fn2-digests-wfp fn2-digests) (fn2-pool-wfp fn2-pool))))
 (let ((dst (fn2-digest-slot (nfix row) *fn2-b3-result*)))
  (if (not (and (fn2-digest-rowp dst fn2-digests) (natp index) (<= index 32)
                (natp off) (natp end) (<= off end)))
      (mv :bounds 0)
   (let ((count (min (- 32 index) (- end off))))
    (if (fn2-fnct-stream-trailer-part index count dst slot gen off okind oslot ogen fn2-digests fn2-pool)
        (mv (if (= (+ index count) 32) :verified :more) count)
      (mv :frame 0))))))

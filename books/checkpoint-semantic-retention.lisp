                 (equal (fn2-checkpoint-semantic-work-hash-3 e fn2-checkpoint-semantic-work) (fn2-digest-word hash 3 fn2-digests))
                 (equal (fn2-checkpoint-semantic-work-hash-4 e fn2-checkpoint-semantic-work) (fn2-digest-word hash 4 fn2-digests))
                 (equal (fn2-checkpoint-semantic-work-hash-5 e fn2-checkpoint-semantic-work) (fn2-digest-word hash 5 fn2-digests))
                 (equal (fn2-checkpoint-semantic-work-hash-6 e fn2-checkpoint-semantic-work) (fn2-digest-word hash 6 fn2-digests))
                 (equal (fn2-checkpoint-semantic-work-hash-7 e fn2-checkpoint-semantic-work) (fn2-digest-word hash 7 fn2-digests))

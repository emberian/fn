      ((unless (equal (fn2-checkpoint-semantic-work-state e fn2-checkpoint-semantic-work) *fn2-checkpoint-semantic-work-state-empty*))
       (mv (if (and
                 (equal (fn2-checkpoint-semantic-work-unit e fn2-checkpoint-semantic-work) unit)
                 (equal (fn2-checkpoint-semantic-work-epoch e fn2-checkpoint-semantic-work) epoch)
                 (equal (fn2-checkpoint-semantic-work-allocation e fn2-checkpoint-semantic-work) allocation)
                 (equal (fn2-checkpoint-semantic-work-page-kind e fn2-checkpoint-semantic-work) page-kind)
                 (equal (fn2-checkpoint-semantic-work-length e fn2-checkpoint-semantic-work) length)
                 (equal (fn2-checkpoint-semantic-work-schema e fn2-checkpoint-semantic-work) schema)
                 (equal (fn2-checkpoint-semantic-work-run e fn2-checkpoint-semantic-work) run)
                 (equal (fn2-checkpoint-semantic-work-level e fn2-checkpoint-semantic-work) level)
                 (equal (fn2-checkpoint-semantic-work-root e fn2-checkpoint-semantic-work) root)
                 (equal (fn2-checkpoint-semantic-work-filter e fn2-checkpoint-semantic-work) filter)
                 (equal (fn2-checkpoint-semantic-work-expected-count e fn2-checkpoint-semantic-work) count)
                 ; Current writer pages form a tree. Repeated full roots and
                 ; filter identities may share completed retention, but a second
                 ; child edge is refused rather than counted as a second walk.
                 (or (equal filter 1) (equal root e))

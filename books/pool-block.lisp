; Shared bounded pool text and 4 KiB BLAKE3 operations for storage and framing.
(in-package "ACL2")
(include-book "format-check")
(fn2-book-layer :b)
(local (in-theory (disable fn2-fields-rows fn2-fieldsp fn2-fields-wfp fn2-poolp fn2-pool-wfp fn2-pool-rows fn2-pool-read fn2-pool-write)))

(defconst *fn2-pool-block-bytes* 4096)
(defun fn2-pool-fill-value (slot fn2-pool)
  (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
  (if (and (natp slot) (< slot (fn2-pool-rows fn2-pool))) (nfix (fn2-pool-slot-fill slot fn2-pool)) 0))
(defthm fn2-pool-fill-value-natp (natp (fn2-pool-fill-value slot fn2-pool)) :rule-classes :type-prescription)
(in-theory (disable fn2-pool-fill-value))
(defun fn2-pool-append-text (i str slot gen okind oslot ogen fn2-pool)
  (declare (xargs :stobjs fn2-pool :guard (and (fn2-pool-wfp fn2-pool) (natp i) (stringp str))
                  :measure (nfix (- (length str) (nfix i)))))
  (if (or (not (stringp str)) (>= (nfix i) (length str))) (mv :ok fn2-pool)
    (mv-let (code fn2-pool)
      (fn2-pool-write slot gen (fn2-pool-fill-value slot fn2-pool) (char-code (char str (nfix i)))
                      okind oslot ogen fn2-pool)
      (if (eq code :ok) (fn2-pool-append-text (+ 1 (nfix i)) str slot gen okind oslot ogen fn2-pool)
        (mv code fn2-pool)))))
(fn2-pool-preserves fn2-pool-append-text (i str slot gen okind oslot ogen fn2-pool) :position 1)
(in-theory (disable fn2-pool-append-text))


(defun fn2-pool-block-hash-loop (fuel row slot gen off len done okind oslot ogen fn2-digests fn2-b3 fn2-pool)
  (declare (xargs :stobjs (fn2-digests fn2-b3 fn2-pool) :measure (nfix fuel)
                  :guard (and (fn2-pool-wfp fn2-pool) (natp fuel) (natp off) (natp len) (natp done))))
  (cond ((>= (nfix done) (nfix len)) (mv :ok fn2-digests fn2-b3))
        ((or (zp fuel) (not (fn2-b3-ready row fn2-b3 fn2-digests))
             (not (unsigned-byte-p 32 (+ (nfix off) (nfix done)))) (not (unsigned-byte-p 32 (nfix len))))
         (mv :bounds fn2-digests fn2-b3))
        (t (mv-let (code consumed fn2-digests fn2-b3)
             (fn2-b3-update row slot gen (+ (nfix off) (nfix done)) (- (nfix len) (nfix done))
                            okind oslot ogen fn2-digests fn2-b3 fn2-pool)
             (if (and (member-eq code '(:ok :more)) (posp consumed))
                 (fn2-pool-block-hash-loop (- fuel 1) row slot gen off len (+ (nfix done) consumed)
                                     okind oslot ogen fn2-digests fn2-b3 fn2-pool)
               (mv :bounds fn2-digests fn2-b3))))))
(defmacro fn2-pool-block-shape (name call guard outputs hints)
  `(defthm ,name (implies ,guard (and ,@(fn2-fc-shape-claims outputs call))) :hints ,hints))
(fn2-pool-block-shape fn2-pool-block-hash-loop-shape
  (fn2-pool-block-hash-loop fuel row slot gen off len done okind oslot ogen fn2-digests fn2-b3 fn2-pool)
  (and (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests) (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3)
       (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
  ((fn2-digests 1) (fn2-b3 2))
  (("Goal" :induct (fn2-pool-block-hash-loop fuel row slot gen off len done okind oslot ogen fn2-digests fn2-b3 fn2-pool)
           :in-theory (e/d (fn2-pool-block-hash-loop) (fn2-digestsp fn2-digests-wfp fn2-b3p fn2-b3-wfp fn2-digests-rows fn2-b3-rows)))))
(defun fn2-pool-block-hash (row slot gen off len okind oslot ogen fn2-digests fn2-b3 fn2-pool)
  (declare (xargs :stobjs (fn2-digests fn2-b3 fn2-pool)
                  :guard (and (fn2-pool-wfp fn2-pool) (natp off) (natp len))))
  (let ((key (fn2-digest-slot (nfix row) *fn2-b3-key*)) (dst (fn2-digest-slot (nfix row) *fn2-b3-result*)))
    (if (not (and (natp row) (fn2-b3-ready row fn2-b3 fn2-digests) (fn2-digest-rowp key fn2-digests)
                  (<= (nfix len) *fn2-pool-block-bytes*)))
        (mv :bounds fn2-digests fn2-b3)
      (mv-let (fn2-digests fn2-b3) (fn2-b3-init row 0 key fn2-digests fn2-b3)
        (mv-let (code fn2-digests fn2-b3)
          (fn2-pool-block-hash-loop 4 row slot gen off len 0 okind oslot ogen fn2-digests fn2-b3 fn2-pool)
          (if (not (and (eq code :ok) (fn2-b3-ready row fn2-b3 fn2-digests) (fn2-digest-rowp dst fn2-digests)))
              (mv :bounds fn2-digests fn2-b3)
            (let ((fn2-digests (fn2-b3-finalize dst row fn2-digests fn2-b3))) (mv :ok fn2-digests fn2-b3))))))))
(fn2-pool-block-shape fn2-pool-block-hash-shape
  (fn2-pool-block-hash row slot gen off len okind oslot ogen fn2-digests fn2-b3 fn2-pool)
  (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests) (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)) ((fn2-digests 1) (fn2-b3 2))
  (("Goal" :in-theory (e/d (fn2-pool-block-hash) (fn2-fieldsp fn2-fields-wfp fn2-digestsp fn2-digests-wfp fn2-b3p fn2-b3-wfp fn2-poolp fn2-pool-wfp fn2-digests-rows fn2-b3-rows fn2-fields-rows fn2-pool-rows)))))
(in-theory (disable fn2-pool-block-hash-loop fn2-pool-block-hash))

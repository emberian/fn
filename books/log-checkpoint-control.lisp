; LC proof observation of the replay seed. The event directory contains
; non-catalogue events and references to rows, never article bodies. It is
; not an execution input to open; the concrete page producer is a restack seam.
(in-package "ACL2")
(include-book "store-checkpoint-open")
(include-book "log-checkpoint-total-accessors")

(defun fn-lc-history-at (configs events)
  (declare (xargs :guard (true-listp events)))
  (list configs events))
(defun fn-lc-history-rows (configs history)
  (declare (xargs :guard t) (ignore configs))
  (if (consp history)
      (cond ((fn-held-p (mbe :logic (car history) :exec (fn-lc-head history)))
             (cons (mbe :logic (car history) :exec (fn-lc-head history)) (fn-lc-history-rows nil (mbe :logic (cdr history) :exec (fn-lc-rest history)))))
            ((fn-hstxa-p (mbe :logic (car history) :exec (fn-lc-head history)))
             (cons (fn-replay-composite-held (mbe :logic (car history) :exec (fn-lc-head history)))
                   (fn-lc-history-rows nil (mbe :logic (cdr history) :exec (fn-lc-rest history)))))
            (t (fn-lc-history-rows nil (mbe :logic (cdr history) :exec (fn-lc-rest history)))))
    nil))
(defun fn-lc-event-directory (events)
  (declare (xargs :guard t))
  (if (consp events)
      (cons (cond ((fn-held-p (mbe :logic (car events) :exec (fn-lc-head events))) '(:article))
                  ((fn-hstxa-p (mbe :logic (car events) :exec (fn-lc-head events)))
                   (list :composite (fn-hstxa-stxa (mbe :logic (car events) :exec (fn-lc-head events)))))
                  (t (list :control (mbe :logic (car events) :exec (fn-lc-head events)))))
            (fn-lc-event-directory (mbe :logic (cdr events) :exec (fn-lc-rest events))))
    nil))
(defun fn-lc-cpr-control (cpr)
  (declare (xargs :guard t :verify-guards nil))
  (let* ((paused (fn-sco-pausedp cpr))
         (cn (if paused (fn-sco-at 1 cpr) (fn-replay-result-node cpr)))
         (node (fn-cnode-node cn))
         (a (fn-node-acceptance node)))
    (list (mbe :logic (car (true-list-fix cpr)) :exec (fn-lc-head (true-list-fix cpr)))
          (if paused (list (fn-sco-at 2 cpr) (fn-sco-at 3 cpr))
            (list (fn-replay-result-sequence cpr) (fn-replay-result-reason cpr)))
          (fn-cnode-config cn) (fn-state-groups a) (fn-state-nexts a)
          (fn-state-next-txid a) (fn-state-fenced a)
          (fn-node-retention node) (fn-node-stage node) (fn-node-bindings node))))
(defun fn-lc-control-of (history)
  (declare (xargs :guard (true-listp history) :verify-guards nil))
  (let* ((configs (mbe :logic (car history) :exec (fn-lc-head history))) (events (mbe :logic (cadr history) :exec (fn-lc-head (fn-lc-rest history))))
         (capture (fn-sco-capture configs events)))
    (list :lc-control (fn-lc-cpr-control (fn-sco-cpr capture))
          (fn-sco-identity capture) (fn-sco-consumer capture)
          (fn-sco-topic capture) (fn-lc-event-directory events))))

; A proof-only inverse for the lossless rows/control partition. Native open
; adopts the folded seed and replays its physical tail; it never calls this.
(defun fn-lc-recompose-history (directory rows)
  (declare (xargs :guard (true-listp rows) :verify-guards nil))
  (if (consp directory)
      (let ((entry (mbe :logic (car directory) :exec (fn-lc-head directory))))
        (cond ((equal (mbe :logic (car entry) :exec (fn-lc-head entry)) :article)
               (cons (mbe :logic (car rows) :exec (fn-lc-head rows)) (fn-lc-recompose-history (mbe :logic (cdr directory) :exec (fn-lc-rest directory)) (mbe :logic (cdr rows) :exec (fn-lc-rest rows)))))
              ((equal (mbe :logic (car entry) :exec (fn-lc-head entry)) :composite)
               (cons (fn-hstxa-make (mbe :logic (cadr entry) :exec (fn-lc-head (fn-lc-rest entry))) (mbe :logic (car rows) :exec (fn-lc-head rows)))
                     (fn-lc-recompose-history (mbe :logic (cdr directory) :exec (fn-lc-rest directory)) (mbe :logic (cdr rows) :exec (fn-lc-rest rows)))))
              (t (cons (mbe :logic (cadr entry) :exec (fn-lc-head (fn-lc-rest entry))) (fn-lc-recompose-history (mbe :logic (cdr directory) :exec (fn-lc-rest directory)) rows)))))
    nil))

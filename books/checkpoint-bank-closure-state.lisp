; Profile-sized retained typed closure for every physical anchor. These are
; copies of the actual common reach rows, never an independent reach algorithm.
(in-package "ACL2")
(include-book "columns")
(include-book "checkpoint-publication-state")
(fn2-book-layer :b)
(defcolumns fn2-checkpoint-bank-closures
 ((generation :u60) (evidence-tag :u60) (present :bool)
  (epoch :u60) (allocation :u60) (role-bits :u16))
 :init-name fn2-checkpoint-bank-closures-columns-init
 :extra-fields
 ((fn2-checkpoint-bank-closures-extents :type (unsigned-byte 32) :initially 0 :why "Actual supported physical extent profile; four distinct anchor regions.")
  (fn2-checkpoint-bank-closures-capture-phase :type (array (unsigned-byte 8) (4)) :initially 0 :why "Each anchor owns EMPTY/COPYING/READY retained capture.")
  (fn2-checkpoint-bank-closures-capture-cursor :type (array (unsigned-byte 32) (4)) :initially 0 :why "One actual extent row copied per bounded step.")
  (fn2-checkpoint-bank-closures-capture-generation :type (array (unsigned-byte 60) (4)) :initially 0 :why "Exact investigated common reach generation.")
  (fn2-checkpoint-bank-closures-capture-tag :type (array (unsigned-byte 60) (4)) :initially 0 :why "Exact retained installation investigation tag.")
  (fn2-checkpoint-bank-closures-capture-seen :type (array (unsigned-byte 32) (4)) :initially 0 :why "Actual mapped rows copied, never a caller completion count.")
  (fn2-checkpoint-bank-closures-identity :type (array (unsigned-byte 32) (64)) :initially 0 :why "Full descriptor and physical-anchor hashes per source, independent of shared scratch.")))

(defun fn2-checkpoint-bank-closures-reset-controls (i fn2-checkpoint-bank-closures)
 (declare (xargs :stobjs fn2-checkpoint-bank-closures :measure (nfix (- 4 (nfix i)))
 :guard (and (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures) (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures) (natp i) (<= i 4))))
 (if (>= (nfix i) 4) fn2-checkpoint-bank-closures
  (let* ((fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-capture-phasei i 0 fn2-checkpoint-bank-closures))
         (fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-capture-cursori i 0 fn2-checkpoint-bank-closures))
         (fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-capture-generationi i 0 fn2-checkpoint-bank-closures))
         (fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-capture-tagi i 0 fn2-checkpoint-bank-closures))
         (fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-capture-seeni i 0 fn2-checkpoint-bank-closures)))
   (fn2-checkpoint-bank-closures-reset-controls (+ i 1) fn2-checkpoint-bank-closures))))

(fn2-checkpoint-bank-closures-preserves fn2-checkpoint-bank-closures-reset-controls
 (i fn2-checkpoint-bank-closures) :hyps ((fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures)
  (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures) (natp i) (<= i 4)))

(defun fn2-checkpoint-bank-closures-init (extents fn2-checkpoint-bank-closures)
 (declare (xargs :stobjs fn2-checkpoint-bank-closures :verify-guards nil
  :guard (and (unsigned-byte-p 32 extents) (unsigned-byte-p 32 (* 4 extents)) (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures))))
 (let* ((fn2-checkpoint-bank-closures (fn2-checkpoint-bank-closures-columns-init (* 4 extents) fn2-checkpoint-bank-closures))
        (fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-extents extents fn2-checkpoint-bank-closures)))
  (fn2-checkpoint-bank-closures-reset-controls 0 fn2-checkpoint-bank-closures)))
(defthm fn2-checkpoint-bank-closures-init-preserves-type
 (implies (and (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures) (unsigned-byte-p 32 extents) (unsigned-byte-p 32 (* 4 extents)))
  (fn2-checkpoint-bank-closuresp (fn2-checkpoint-bank-closures-init extents fn2-checkpoint-bank-closures))))
(defthm fn2-checkpoint-bank-closures-init-wfp
 (implies (and (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures) (unsigned-byte-p 32 extents) (unsigned-byte-p 32 (* 4 extents)))
  (fn2-checkpoint-bank-closures-wfp (fn2-checkpoint-bank-closures-init extents fn2-checkpoint-bank-closures))))
(defthm fn2-checkpoint-bank-closures-init-rows
 (implies (and (fn2-checkpoint-bank-closuresp fn2-checkpoint-bank-closures) (unsigned-byte-p 32 extents) (unsigned-byte-p 32 (* 4 extents)))
  (equal (fn2-checkpoint-bank-closures-rows (fn2-checkpoint-bank-closures-init extents fn2-checkpoint-bank-closures)) (* 4 extents))))

(defun fn2-checkpoint-bank-closures-capacityp (fn2-checkpoint-bank-closures)
 (declare (xargs :stobjs fn2-checkpoint-bank-closures :guard (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures)))
 (and (posp (fn2-checkpoint-bank-closures-extents fn2-checkpoint-bank-closures))
      (equal (fn2-checkpoint-bank-closures-rows fn2-checkpoint-bank-closures) (* 4 (fn2-checkpoint-bank-closures-extents fn2-checkpoint-bank-closures)))))
(defun fn2-checkpoint-bank-closure-identity-p (i c fn2-checkpoint-bank-closures fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-bank-closures fn2-checkpoint-publication) :measure (nfix (- 16 (nfix i)))
 :guard (and (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
             (natp i) (<= i 16) (natp c) (< c 4) (<= 192 (fn2-checkpoint-publication-cold-words-length fn2-checkpoint-publication)))))
 (or (>= (nfix i) 16)
  (and (equal (fn2-checkpoint-bank-closures-identityi (+ (* 16 c) i) fn2-checkpoint-bank-closures)
              (fn2-checkpoint-publication-cold-wordsi (+ (* 48 c) 32 i) fn2-checkpoint-publication))
       (fn2-checkpoint-bank-closure-identity-p (+ i 1) c fn2-checkpoint-bank-closures fn2-checkpoint-publication))))
(defun fn2-checkpoint-bank-closure-current-p (c fn2-checkpoint-bank-closures fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-bank-closures fn2-checkpoint-publication)
 :guard (and (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (and (natp c) (< c 4) (fn2-checkpoint-bank-closures-capacityp fn2-checkpoint-bank-closures)
      (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication))
      (<= 48 (fn2-checkpoint-publication-cold-meta-length fn2-checkpoint-publication))
      (<= 192 (fn2-checkpoint-publication-cold-words-length fn2-checkpoint-publication))
      (member-equal (fn2-checkpoint-publication-cold-metai (* 12 c) fn2-checkpoint-publication) '(1 2))
      (equal (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 11) fn2-checkpoint-publication) 48)
      (posp (fn2-checkpoint-bank-closures-capture-generationi c fn2-checkpoint-bank-closures))
      (equal (fn2-checkpoint-bank-closures-capture-generationi c fn2-checkpoint-bank-closures)
             (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 9) fn2-checkpoint-publication))
      (equal (fn2-checkpoint-bank-closures-capture-tagi c fn2-checkpoint-bank-closures)
             (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 10) fn2-checkpoint-publication))
      (fn2-checkpoint-bank-closure-identity-p 0 c fn2-checkpoint-bank-closures fn2-checkpoint-publication)))
(defun fn2-checkpoint-bank-closure-ready-p (c fn2-checkpoint-bank-closures fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-bank-closures fn2-checkpoint-publication)
 :guard (and (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (and (fn2-checkpoint-bank-closure-current-p c fn2-checkpoint-bank-closures fn2-checkpoint-publication)
      (equal (fn2-checkpoint-bank-closures-capture-phasei c fn2-checkpoint-bank-closures) 2)
      (equal (fn2-checkpoint-bank-closures-capture-cursori c fn2-checkpoint-bank-closures) (fn2-checkpoint-bank-closures-extents fn2-checkpoint-bank-closures))
      (posp (fn2-checkpoint-bank-closures-capture-seeni c fn2-checkpoint-bank-closures))))
(defun fn2-checkpoint-bank-closure-row-p (slot e fn2-checkpoint-bank-closures fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-bank-closures fn2-checkpoint-publication)
 :guard (and (fn2-checkpoint-bank-closures-wfp fn2-checkpoint-bank-closures) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication))))
 (and (fn2-checkpoint-bank-closure-ready-p slot fn2-checkpoint-bank-closures fn2-checkpoint-publication)
      (natp e) (< e (fn2-checkpoint-bank-closures-extents fn2-checkpoint-bank-closures))
      (let ((r (+ (* slot (fn2-checkpoint-bank-closures-extents fn2-checkpoint-bank-closures)) e)))
       (and (equal (fn2-checkpoint-bank-closures-generation r fn2-checkpoint-bank-closures)
                    (fn2-checkpoint-bank-closures-capture-generationi slot fn2-checkpoint-bank-closures))
            (equal (fn2-checkpoint-bank-closures-evidence-tag r fn2-checkpoint-bank-closures)
                    (fn2-checkpoint-bank-closures-capture-tagi slot fn2-checkpoint-bank-closures))
            (if (equal (fn2-checkpoint-bank-closures-present r fn2-checkpoint-bank-closures) 1)
                (posp (fn2-checkpoint-bank-closures-role-bits r fn2-checkpoint-bank-closures))
              (and (equal (fn2-checkpoint-bank-closures-role-bits r fn2-checkpoint-bank-closures) 0)
                   (equal (fn2-checkpoint-bank-closures-epoch r fn2-checkpoint-bank-closures) 0)
                   (equal (fn2-checkpoint-bank-closures-allocation r fn2-checkpoint-bank-closures) 0)))))))

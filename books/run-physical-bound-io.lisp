(in-package "ACL2")
(include-book "run-physical-bound")
(fn2-book-layer :c)
(defmacro fn2-run-load-issue-mv (code op gen)
 `(mv ,code ,op ,gen fn2-run-loads fn2-run-load-ops fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges))
(defun fn2-run-bound-issue (c budget fn2-run-loads fn2-run-load-ops fn2-run-cursors
  fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-load-ops fn2-run-cursors fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control)
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-run-load-ops-wfp fn2-run-load-ops) (fn2-run-cursors-wfp fn2-run-cursors)
 (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges) (fn2-pool-wfp fn2-pool) (fn2-ops-wfp fn2-ops) (fn2-control-wfp fn2-control))))
 (b* (((unless (posp budget)) (fn2-run-load-issue-mv :yield 0 0))
      ((unless (and (fn2-run-load-boundp c fn2-run-loads fn2-run-cursors)
                    (equal (fn2-run-loads-phase c fn2-run-loads) *fn2-run-load-phase-read*)
                    (equal (fn2-run-loads-pending c fn2-run-loads) 0)
                    (< (fn2-run-loads-sector c fn2-run-loads) *fn2-storage-extent-units*)
                    (equal (fn2-run-load-ops-rows fn2-run-load-ops) (fn2-ops-rows fn2-ops))))
       (fn2-run-load-issue-mv :source 0 0))

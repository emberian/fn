      (generation (fn2-run-loads-generation c fn2-run-loads))
      (slot (fn2-run-loads-scratch c fn2-run-loads)) (gen (fn2-run-loads-scratch-gen c fn2-run-loads))
      ((mv code fn2-pool) (fn2-pool-reset slot gen kind owner generation fn2-pool))
      ((unless (eq code :ok)) (fn2-run-load-issue-mv code 0 0))
      ((mv code op opgen fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges)
       (fn2-block-read-children (+ (fn2-run-loads-unit c fn2-run-loads) (fn2-run-loads-sector c fn2-run-loads))
        (fn2-run-loads-epoch c fn2-run-loads) (fn2-run-loads-allocation c fn2-run-loads)
        0 *fn2-commit-unit-bytes* slot gen kind owner generation 0
        fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control))

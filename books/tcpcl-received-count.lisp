; Carry the actual producer's cumulative transfer count into the BP source
; callback, from the final ACK already held by fnn-tcl-act. No wire LEN scan.
(in-package "ACL2")
(include-book "tcpcl-octets")
(set-verify-guards-eagerness 2)
(defun fn-tcl-final-held-count (reverse-held xfer-id)
 (declare (xargs :guard t))
 (let* ((ack (fn-cbor-ag-car reverse-held))
        (flags (fn-tcl-xfer-ack-flags ack))
        (count (fn-tcl-xfer-ack-acked-len ack)))
  (if (and (fn-tcl-xfer-ack-shapep ack)
           (fn-cbor-octetp flags) (fn-tcl-flag-end flags)
           (integerp xfer-id) (<= 0 xfer-id) (<= xfer-id *fn-tcl-max-u64*)
           (equal (fn-tcl-xfer-ack-xfer-id ack) xfer-id)
           (integerp count) (<= 0 count) (<= count *fn-tcl-max-u64*))
   (list :counted xfer-id count)
   '(:refused :complete-count-unavailable))))
(defun fn-tcl-final-count-ready-p (answer)
 (declare (xargs :guard t))
 (eq (fn-cbor-ag-car answer) :counted))
(defun fn-tcl-final-count-value (answer)
 (declare (xargs :guard t))
 (fn-cbor-ag-car (fn-cbor-ag-cdr (fn-cbor-ag-cdr answer))))

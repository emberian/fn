; Release only the retained boot root window. This is resource closure after
; the actual completed epoch Fence, not selected-base or allocator authority.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "boot-kind")
(include-book "checkpoint-summary-state")
(include-book "checkpoint-summary-authority-state")
(include-book "checkpoint-cbase-identity")
(include-book "checkpoint-restore-events-state")
(fn2-book-layer :b)

(defcost fn2-boot-release-root-window :answers t :bytes 128
 :tables (fn2-boot-table fn2-core-pool fn2-core-control)
 :doc "After the actual epoch Fence and terminal root consumers, release the exact owned 64KiB boot window through the shared pool release; refusal retains its identity.")

; Materialize after the sole core and its B/C row readers, alongside the
; other boot operation macros. No include of operational boot/recovery here.
(defmacro fn2-boot-root-release-events ()
 '(progn
  (defun fn2-boot-root-consumers-settled-p (id ogen slot gen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (and (fn2-core-wfp fn2-core)
    (unsigned-byte-p 32 id) (unsigned-byte-p 60 ogen) (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen))))
   (stobj-let (
     (fn2-checkpoint-restore-reader (fn2-core-checkpoint-restore-reader fn2-core))
     (fn2-checkpoint-restore-semantic (fn2-core-checkpoint-restore-semantic fn2-core))
     (fn2-checkpoint-restore-events (fn2-core-checkpoint-restore-events fn2-core))
     (fn2-checkpoint-recovery-evidence (fn2-core-checkpoint-recovery-evidence fn2-core))
     (fn2-event-read (fn2-core-event-read fn2-core))
     (fn2-checkpoint-payload (fn2-core-checkpoint-payload fn2-core))
     (fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
     (fn2-checkpoint-summary-authority (fn2-core-checkpoint-summary-authority fn2-core))
     (fn2-checkpoint-cbase-holds (fn2-core-checkpoint-cbase-holds fn2-core))
     (fn2-checkpoints (fn2-core-checkpoints fn2-core))
     (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core))
     (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core))) (settled)
    (and (< 0 (fn2-checkpoint-restore-reader-rows fn2-checkpoint-restore-reader))
         (< 0 (fn2-checkpoint-restore-semantic-rows fn2-checkpoint-restore-semantic))
         (< 0 (fn2-checkpoint-restore-events-rows fn2-checkpoint-restore-events))
         (< 0 (fn2-checkpoint-recovery-evidence-rows fn2-checkpoint-recovery-evidence))
         (< 0 (fn2-event-read-rows fn2-event-read))
         (= (fn2-checkpoint-restore-reader-phase 0 fn2-checkpoint-restore-reader) *fn2-checkpoint-restore-reader-phase-done*)
         (= (fn2-checkpoint-restore-reader-slot 0 fn2-checkpoint-restore-reader) slot)
         (= (fn2-checkpoint-restore-reader-gen 0 fn2-checkpoint-restore-reader) gen)
         (= (fn2-checkpoint-restore-reader-owner-kind 0 fn2-checkpoint-restore-reader) *fn2-boot-kind*)
         (= (fn2-checkpoint-restore-reader-owner-slot 0 fn2-checkpoint-restore-reader) id)
         (= (fn2-checkpoint-restore-reader-owner-gen 0 fn2-checkpoint-restore-reader) ogen)
         (= (fn2-checkpoint-restore-semantic-phase 0 fn2-checkpoint-restore-semantic) *fn2-checkpoint-restore-semantic-phase-complete*)
         (= (fn2-checkpoint-restore-semantic-depth 0 fn2-checkpoint-restore-semantic) 0)
         (= (fn2-checkpoint-restore-semantic-slot 0 fn2-checkpoint-restore-semantic) slot)
         (= (fn2-checkpoint-restore-semantic-gen 0 fn2-checkpoint-restore-semantic) gen)
         (= (fn2-checkpoint-restore-semantic-owner-kind 0 fn2-checkpoint-restore-semantic) *fn2-boot-kind*)
         (= (fn2-checkpoint-restore-semantic-owner-slot 0 fn2-checkpoint-restore-semantic) id)
         (= (fn2-checkpoint-restore-semantic-owner-gen 0 fn2-checkpoint-restore-semantic) ogen)
         (= (fn2-checkpoint-restore-events-phase 0 fn2-checkpoint-restore-events) *fn2-checkpoint-restore-events-phase-complete*)
         (= (fn2-checkpoint-restore-events-slot 0 fn2-checkpoint-restore-events) slot)
         (= (fn2-checkpoint-restore-events-gen 0 fn2-checkpoint-restore-events) gen)
         (= (fn2-checkpoint-restore-events-owner-kind 0 fn2-checkpoint-restore-events) *fn2-boot-kind*)
         (= (fn2-checkpoint-restore-events-owner-slot 0 fn2-checkpoint-restore-events) id)
         (= (fn2-checkpoint-restore-events-owner-gen 0 fn2-checkpoint-restore-events) ogen)
         (= (fn2-checkpoint-recovery-evidence-phase 0 fn2-checkpoint-recovery-evidence) *fn2-checkpoint-recovery-evidence-phase-complete*)
         (= (fn2-checkpoint-recovery-evidence-slot 0 fn2-checkpoint-recovery-evidence) slot)
         (= (fn2-checkpoint-recovery-evidence-gen 0 fn2-checkpoint-recovery-evidence) gen)
         (= (fn2-checkpoint-recovery-evidence-owner-kind 0 fn2-checkpoint-recovery-evidence) *fn2-boot-kind*)
         (= (fn2-checkpoint-recovery-evidence-owner-slot 0 fn2-checkpoint-recovery-evidence) id)
         (= (fn2-checkpoint-recovery-evidence-owner-gen 0 fn2-checkpoint-recovery-evidence) ogen)
         (= (fn2-event-read-pending 0 fn2-event-read) 0)
         (member-equal (fn2-event-read-phase 0 fn2-event-read)
          (list *fn2-event-read-phase-idle* *fn2-event-read-phase-complete*))
         (fn2-checkpoint-payload-rebindablep fn2-checkpoint-payload)
         ; These retain scalars/hash words in private arrays, not pool refs.
         ; Do not revalidate the mutable current investigation after all-bank
         ; protection scans: the selected catalog has independent ownership.
         (< 0 (fn2-checkpoint-summary-rows fn2-checkpoint-summary))
         (= (fn2-checkpoint-summary-phase 0 fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-applied*)
         (= (fn2-checkpoint-summary-owner-kind 0 fn2-checkpoint-summary) *fn2-boot-kind*)
         (= (fn2-checkpoint-summary-owner-slot 0 fn2-checkpoint-summary) id)
         (= (fn2-checkpoint-summary-owner-gen 0 fn2-checkpoint-summary) ogen)
         (fn2-checkpoint-summary-authority-complete-p fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
         (= (fn2-checkpoint-summary-authority-origin 0 fn2-checkpoint-summary-authority) *fn2-checkpoint-summary-authority-origin-cold*)
         (= (fn2-checkpoint-summary-authority-owner-kind 0 fn2-checkpoint-summary-authority) *fn2-boot-kind*)
         (= (fn2-checkpoint-summary-authority-owner-slot 0 fn2-checkpoint-summary-authority) id)
         (= (fn2-checkpoint-summary-authority-owner-gen 0 fn2-checkpoint-summary-authority) ogen)
         (= (fn2-checkpoint-summary-authority-catalog-tag 0 fn2-checkpoint-summary-authority) (fn2-checkpoint-summary-tag 0 fn2-checkpoint-summary))
         (= (fn2-checkpoint-summary-authority-generation 0 fn2-checkpoint-summary-authority) (fn2-checkpoint-summary-generation 0 fn2-checkpoint-summary))
         (= (fn2-checkpoint-summary-authority-candidate 0 fn2-checkpoint-summary-authority) (fn2-checkpoint-summary-candidate 0 fn2-checkpoint-summary))
         (fn2-checkpoint-cbase-held-p fn2-checkpoint-summary fn2-checkpoint-cbase-holds)) settled))

  (defun fn2-boot-release-root-window (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (b* (((unless (and (unsigned-byte-p 32 id) (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
                      (posp ogen) (unsigned-byte-p 60 ogen)
                      (= (fn2-machine-generation id fn2-core) ogen)
                      (= (fn2-machine-phase id fn2-core) *fn2-boot-state-epoch-result*)
                      (= (fn2-machine-stage id fn2-core) 3) (= (fn2-machine-stopped id fn2-core) 0)
                      (= (fn2-machine-pending id fn2-core) 0)
                      (= (fn2-machine-event-ready id fn2-core) 1)
                      (= (fn2-machine-outcome id fn2-core) *fn2-outcome-done*))) (mv :state fn2-core))
        (slot (fn2-machine-root-slot id fn2-core)) (gen (fn2-machine-root-gen id fn2-core))
        (cursor (fn2-machine-root-cursor id fn2-core))
        (role (fn2-machine-root-role id fn2-core))
        ((when (= gen 0))
         (let ((create (fn2-machine-create id fn2-core)))
          (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core))) (code)
           (if (and (= slot 0) (= cursor 0) (= role 0)
                    (= (fn2-boot-config-anchor-checked-mask fn2-boot-config) 0)
                    (or (= create 1)
                     (and (= (fn2-boot-config-anchor-empty-mask fn2-boot-config) 15)
                          (= (fn2-boot-config-anchor-invalid-mask fn2-boot-config) 0)))) :ok :state)
           (mv code fn2-core))))
        ((unless (and (not (= slot (fn2-machine-pool-slot id fn2-core)))
                      (not (= slot (fn2-machine-rx-slot id fn2-core)))
                      (fn2-boot-root-consumers-settled-p id ogen slot gen fn2-core))) (mv :borrowed fn2-core))
        (recovery (fn2-machine-kind-base *fn2-recovery-machine-kind* fn2-core))
        ((unless (and (eq (fn2-recovery-machine-snapshot-read-code recovery fn2-core) :ok)
                      (= (fn2-machine-phase recovery fn2-core) *fn2-recovery-machine-state-done*)
                      (= (fn2-machine-stopped recovery fn2-core) 1)
                      (= (fn2-machine-pending recovery fn2-core) 0)
                      (member-equal (fn2-machine-rc-class recovery fn2-core)
                       (list *fn2-rec-class-intact* *fn2-rec-class-torn-tail*)))) (mv :recovery fn2-core))
        (rslot (fn2-machine-pool-slot recovery fn2-core)) (rgen (fn2-machine-pool-gen recovery fn2-core))
        (wslot (fn2-machine-rc-wslot recovery fn2-core)) (wgen (fn2-machine-rc-wgen recovery fn2-core))
        (preflight
         (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code)
          (b* ((root (fn2-pool-workspace-code slot gen *fn2-boot-kind* id ogen fn2-pool))
               ((unless (eq root :ok)) root)
               ((unless (fn2-pool-release-countp slot fn2-pool)) :corrupt)
               (r (fn2-pool-handle-code rslot rgen fn2-pool)) (w (fn2-pool-handle-code wslot wgen fn2-pool)))
           (if (and (posp rgen) (posp wgen) (not (= rslot slot)) (not (= wslot slot)) (not (= rslot wslot))
                    (or (eq r :stale) (and (eq r :ok) (= (fn2-pool-state rslot fn2-pool) *fn2-pool-state-retired*)))
                    (or (eq w :stale) (and (eq w :ok) (= (fn2-pool-state wslot fn2-pool) *fn2-pool-state-retired*)))) :ok :recovery)) code))
        ((unless (eq preflight :ok)) (mv preflight fn2-core))
        ((mv code fn2-core) (fn2-core-release slot gen *fn2-boot-kind* id ogen fn2-core))
        ((unless (member-eq code '(:ok :retired))) (mv code fn2-core))
        (fn2-core (fn2-boot-put-core id (root-slot 0) (root-gen 0) (root-cursor 0) (root-role 0))))
    (mv code fn2-core)))
  (fn2-core-preserves fn2-boot-release-root-window (id ogen fn2-core) :position 1 :rows nil)))

  (equal (mv-nth 1 (fn2-rec-fetch-bytes 4 (* 4 k) 0 dst slot gen off okind oslot ogen fn2-pool fn2-digests)) (mv-nth 1 (b* ((at (+ off (* 4 k)))
       ((mv c0 b0) (fn2-rec-byte-at slot gen at okind oslot ogen fn2-pool))

       ((unless (eq c3 :ok)) (mv c3 (+ (* 4 k) 3) (mv-nth 1 (fn2-layout-byte :u32 2 (mv-nth 1 (fn2-layout-byte :u32 1 (mv-nth 1 (fn2-layout-byte :u32 0 0 0 0 0 b0)) 0 0 0 b1)) 0 0 0 b2)) fn2-digests))

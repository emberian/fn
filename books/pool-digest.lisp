; Concrete leased bytes loaded into a digest row; shared by recovery and reads.
(in-package "ACL2")
(include-book "digests")
(include-book "pool")
(include-book "layout")
(local (include-book "arithmetic-3/floor-mod/floor-mod" :dir :system))
(include-book "std/util/bstar" :dir :system)
(fn2-book-layer :b)
(local (in-theory (disable fn2-digests-rows fn2-digestsp fn2-digests-wfp fn2-poolp fn2-pool-wfp)))
(defun fn2-rec-byte-at (slot gen off okind oslot ogen fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (fn2-pool-wfp fn2-pool) (natp off))))
 (mv-let (code byte) (fn2-pool-read slot gen off okind oslot ogen fn2-pool)
  (mv code (if (and (eq code :ok) (unsigned-byte-p 8 byte)) byte 0))))
(defthm fn2-rec-byte-at-natp
 (natp (mv-nth 1 (fn2-rec-byte-at slot gen off okind oslot ogen fn2-pool)))
 :rule-classes :type-prescription)
(defthm fn2-rec-byte-at-bound
 (< (mv-nth 1 (fn2-rec-byte-at slot gen off okind oslot ogen fn2-pool)) 256)
 :rule-classes :linear)
(in-theory (disable fn2-rec-byte-at))

; Load 32 little-endian bytes at off into digest row dst, word k first.
; A partial little-endian word is continuation state, not a digest receipt.
; Its width is exactly the number of bytes already consumed in this word.
(defun fn2-rec-fetch-state-p (next acc)
 (declare (xargs :guard t))
 (and (natp next) (<= next 32) (unsigned-byte-p 32 acc)
      (case (mod next 4)
       (0 (equal acc 0)) (1 (unsigned-byte-p 8 acc))
       (2 (unsigned-byte-p 16 acc)) (otherwise (unsigned-byte-p 24 acc)))))

; Termination depends only on LEFT. Keep source/codec predicates opaque
; while proving the worker's measure, rather than normalizing irrelevant data.
(local (defthm fn2-rec-fetch-left-measure
 (and (o-p (nfix left))
      (implies (not (zp left)) (o< (nfix (- left 1)) (nfix left))))
 :hints (("Goal" :in-theory (enable o-p o-finp o< nfix zp)))
 :rule-classes nil))

(defun fn2-rec-fetch-bytes (left next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)
 (declare (xargs :stobjs (fn2-pool fn2-digests) :verify-guards nil :measure (nfix left)
  :guard (and (fn2-pool-wfp fn2-pool) (fn2-digest-rowp dst fn2-digests)
              (natp left) (fn2-rec-fetch-state-p next acc) (natp off))
  :hints (("Goal" :use ((:instance fn2-rec-fetch-left-measure))
                 :in-theory (theory 'minimal-theory)))))
 (b* (((when (= next 32)) (mv :ok next acc fn2-digests))
      ((when (zp left)) (mv :more next acc fn2-digests))
      ((mv code byte) (fn2-rec-byte-at slot gen (+ off next) okind oslot ogen fn2-pool))
      ((unless (eq code :ok)) (mv code next acc fn2-digests))
      (pos (mod next 4))
      ; Use the existing canonical U32 byte transition, not another word codec.
      ((mv status word & & &) (fn2-layout-byte :u32 pos acc 0 0 0 byte))
      ((unless (and (member-eq status '(:part :done)) (unsigned-byte-p 32 word)))
       (mv :invariant next acc fn2-digests))
      (after (+ 1 next)) (complete (eq status :done))
      (partial (if complete 0 word))
      ((unless (fn2-rec-fetch-state-p after partial)) (mv :invariant next acc fn2-digests))
      ; No partially read word is written to the destination row.
      (fn2-digests (if complete (fn2-digest-set-word dst (floor next 4) word fn2-digests) fn2-digests)))
  (fn2-rec-fetch-bytes (- left 1) after partial dst slot gen off okind oslot ogen fn2-pool fn2-digests)))

; Local proof support: a backend pool read never uses the continuation
; status :MORE. Thus worker concatenation cannot mistake an error for yield.
(local (defthm fn2-rec-byte-at-not-more
 (not (equal (mv-nth 0 (fn2-rec-byte-at slot gen off okind oslot ogen fn2-pool)) :more))
 :hints (("Goal" :in-theory (enable fn2-rec-byte-at fn2-pool-read fn2-pool-readable-code fn2-pool-handle-code)))))
(local (defthm fn2-rec-byte-at-u8
 (unsigned-byte-p 8 (mv-nth 1 (fn2-rec-byte-at slot gen off okind oslot ogen fn2-pool)))
 :hints (("Goal" :in-theory (enable unsigned-byte-p)))))
(local (defthm fn2-rec-fetch-aligned-state
 (implies (and (natp k) (<= k 8)) (fn2-rec-fetch-state-p (* 4 k) 0))
 :hints (("Goal" :in-theory (enable fn2-rec-fetch-state-p)))))
(local (defthm fn2-rec-fetch-bytes-shape
 (implies (and (fn2-digestsp fn2-digests) (fn2-digest-rowp dst fn2-digests))
  (and (fn2-digestsp (mv-nth 3 (fn2-rec-fetch-bytes left next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)))
       (fn2-digests-wfp (mv-nth 3 (fn2-rec-fetch-bytes left next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)))
       (equal (fn2-digests-rows (mv-nth 3 (fn2-rec-fetch-bytes left next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests))) (fn2-digests-rows fn2-digests))))
 :hints (("Goal" :induct (fn2-rec-fetch-bytes left next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)
                 :in-theory (e/d (fn2-rec-fetch-bytes fn2-digest-rowp)
                                 (fn2-rec-fetch-state-p unsigned-byte-p))))))
(local (defthm fn2-rec-fetch-state-next-natp
 (implies (fn2-rec-fetch-state-p next acc) (natp next))
 :hints (("Goal" :in-theory (e/d (fn2-rec-fetch-state-p) (unsigned-byte-p))))))
(local (defthm fn2-rec-fetch-state-next-bound
 (implies (fn2-rec-fetch-state-p next acc) (<= next 32))
 :hints (("Goal" :in-theory (e/d (fn2-rec-fetch-state-p) (unsigned-byte-p))))
 :rule-classes :linear))
(local (defthm fn2-rec-fetch-bytes-bound
 (implies (and (natp left) (fn2-rec-fetch-state-p next acc))
  (and (fn2-rec-fetch-state-p
         (mv-nth 1 (fn2-rec-fetch-bytes left next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests))
         (mv-nth 2 (fn2-rec-fetch-bytes left next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)))
       (<= next (mv-nth 1 (fn2-rec-fetch-bytes left next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)))
       (<= (mv-nth 1 (fn2-rec-fetch-bytes left next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)) 32)
       (<= (- (mv-nth 1 (fn2-rec-fetch-bytes left next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)) next) left)))
 :hints (("Goal" :induct (fn2-rec-fetch-bytes left next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)
                 :in-theory (e/d (fn2-rec-fetch-bytes)
                                 (fn2-rec-fetch-state-p unsigned-byte-p fn2-layout-byte fn2-rec-byte-at))))))
(local (defthm fn2-rec-fetch-bytes-compose
 (implies (and (natp n) (natp m) (fn2-rec-fetch-state-p next acc)
               (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
               (fn2-digestsp fn2-digests) (fn2-digest-rowp dst fn2-digests) (natp off))
  (equal (mv-list 4 (fn2-rec-fetch-bytes (+ n m) next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests))
   (mv-list 4
    (mv-let (code after partial fn2-digests)
     (fn2-rec-fetch-bytes n next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)
     (if (eq code :more)
      (fn2-rec-fetch-bytes m after partial dst slot gen off okind oslot ogen fn2-pool fn2-digests)
      (mv code after partial fn2-digests))))))
 :hints (("Goal" :induct (fn2-rec-fetch-bytes n next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)
                 :in-theory (enable fn2-rec-fetch-bytes fn2-digest-rowp)))
 :rule-classes nil))

(defun fn2-rec-fetch-step (budget next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)
 (declare (xargs :stobjs (fn2-pool fn2-digests) :verify-guards nil
  :guard (and (fn2-pool-wfp fn2-pool) (fn2-digest-rowp dst fn2-digests))))
 (if (not (and (natp budget) (natp off) (fn2-rec-fetch-state-p next acc)))
     (mv :bounds next acc fn2-digests)
  (fn2-rec-fetch-bytes (min budget (- 32 next)) next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)))

(defthm fn2-rec-fetch-step-progress-bound
 (implies (and (natp budget) (natp off) (fn2-rec-fetch-state-p next acc))
  (and (<= next (mv-nth 1 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)))
       (<= (mv-nth 1 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)) 32)
       (<= (- (mv-nth 1 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)) next) budget)))
 :rule-classes nil
 :hints (("Goal" :use ((:instance fn2-rec-fetch-bytes-bound (left (min budget (- 32 next)))))
                        :in-theory (enable fn2-rec-fetch-step fn2-rec-fetch-state-p))))
(defthm fn2-rec-fetch-step-result-state
 (implies (and (natp budget) (natp off) (fn2-rec-fetch-state-p next acc))
  (fn2-rec-fetch-state-p
   (mv-nth 1 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests))
   (mv-nth 2 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests))))
 :rule-classes nil
 :hints (("Goal" :use ((:instance fn2-rec-fetch-bytes-bound (left (min budget (- 32 next)))))
                        :in-theory (enable fn2-rec-fetch-step))))
(defthm fn2-rec-fetch-step-zero
 (implies (and (natp off) (fn2-rec-fetch-state-p next acc))
  (equal (mv-list 4 (fn2-rec-fetch-step 0 next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests))
         (list (if (= next 32) :ok :more) next acc fn2-digests)))
 :rule-classes nil
 :hints (("Goal" :in-theory (enable fn2-rec-fetch-step fn2-rec-fetch-bytes fn2-rec-fetch-state-p))))
(defthm fn2-rec-fetch-step-shape
 (implies (and (fn2-digestsp fn2-digests) (fn2-digest-rowp dst fn2-digests))
  (and (fn2-digestsp (mv-nth 3 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)))
       (fn2-digests-wfp (mv-nth 3 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)))
       (equal (fn2-digests-rows (mv-nth 3 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)))
              (fn2-digests-rows fn2-digests))))
 :rule-classes nil
 :hints (("Goal" :in-theory (enable fn2-rec-fetch-step))))
(verify-guards fn2-rec-fetch-bytes)
(verify-guards fn2-rec-fetch-step)
(in-theory (disable fn2-rec-fetch-state-p fn2-rec-fetch-bytes fn2-rec-fetch-step))

(defun fn2-rec-fetch (k dst slot gen off okind oslot ogen fn2-pool fn2-digests)
 (declare (xargs :stobjs (fn2-pool fn2-digests) :measure (nfix (- 8 (nfix k)))
  :guard (and (fn2-pool-wfp fn2-pool) (fn2-digest-rowp dst fn2-digests)
              (natp k) (<= k 8) (natp off))))
 (if (or (not (natp k)) (>= k 8)) (mv :ok fn2-digests)
  (b* ((at (+ off (* 4 k)))
       ((mv c0 b0) (fn2-rec-byte-at slot gen at okind oslot ogen fn2-pool))
       ((mv c1 b1) (fn2-rec-byte-at slot gen (+ 1 at) okind oslot ogen fn2-pool))
       ((mv c2 b2) (fn2-rec-byte-at slot gen (+ 2 at) okind oslot ogen fn2-pool))
       ((mv c3 b3) (fn2-rec-byte-at slot gen (+ 3 at) okind oslot ogen fn2-pool))
       ((unless (and (eq c0 :ok) (eq c1 :ok) (eq c2 :ok) (eq c3 :ok)))
        (mv (if (eq c0 :ok) (if (eq c1 :ok) (if (eq c2 :ok) c3 c2) c1) c0) fn2-digests))
       (word (+ b0 (* 256 b1) (* 65536 b2) (* 16777216 b3)))
       (fn2-digests (fn2-digest-set-word dst k word fn2-digests)))
   (fn2-rec-fetch (+ 1 k) dst slot gen off okind oslot ogen fn2-pool fn2-digests))))
(defthm fn2-rec-fetch-shape
 (implies (and (fn2-digestsp fn2-digests) (fn2-digest-rowp dst fn2-digests))
  (and (fn2-digestsp (mv-nth 1 (fn2-rec-fetch k dst slot gen off okind oslot ogen fn2-pool fn2-digests)))
       (fn2-digests-wfp (mv-nth 1 (fn2-rec-fetch k dst slot gen off okind oslot ogen fn2-pool fn2-digests)))
       (equal (fn2-digests-rows (mv-nth 1 (fn2-rec-fetch k dst slot gen off okind oslot ogen fn2-pool fn2-digests)))
              (fn2-digests-rows fn2-digests))))
 :hints (("Goal" :in-theory (disable fn2-digestsp fn2-digests-wfp fn2-digests-rows))))
; Exact original API code and COMPLETE digest carrier effects.
; This local four-byte view is extracted from the unchanged original
; first-word reads/update. Partial accumulator terms use the SAME byte codec.
(local (defthm fn2-rec-fetch-four-result
 (implies (and (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
               (fn2-digestsp fn2-digests) (fn2-digest-rowp dst fn2-digests)
               (natp k) (< k 8) (natp off))
  (equal (mv-list 4 (fn2-rec-fetch-bytes 4 (* 4 k) 0 dst slot gen off okind oslot ogen fn2-pool fn2-digests)) (mv-list 4 (b* ((at (+ off (* 4 k)))
       ((mv c0 b0) (fn2-rec-byte-at slot gen at okind oslot ogen fn2-pool))
       ((mv c1 b1) (fn2-rec-byte-at slot gen (+ 1 at) okind oslot ogen fn2-pool))
       ((mv c2 b2) (fn2-rec-byte-at slot gen (+ 2 at) okind oslot ogen fn2-pool))
       ((mv c3 b3) (fn2-rec-byte-at slot gen (+ 3 at) okind oslot ogen fn2-pool))
       ((unless (eq c0 :ok)) (mv c0 (+ (* 4 k) 0) 0 fn2-digests))
       ((unless (eq c1 :ok)) (mv c1 (+ (* 4 k) 1) (mv-nth 1 (fn2-layout-byte :u32 0 0 0 0 0 b0)) fn2-digests))
       ((unless (eq c2 :ok)) (mv c2 (+ (* 4 k) 2) (mv-nth 1 (fn2-layout-byte :u32 1 (mv-nth 1 (fn2-layout-byte :u32 0 0 0 0 0 b0)) 0 0 0 b1)) fn2-digests))
       ((unless (eq c3 :ok)) (mv c3 (+ (* 4 k) 3) (mv-nth 1 (fn2-layout-byte :u32 2 (mv-nth 1 (fn2-layout-byte :u32 1 (mv-nth 1 (fn2-layout-byte :u32 0 0 0 0 0 b0)) 0 0 0 b1)) 0 0 0 b2)) fn2-digests))
       (word (+ b0 (* 256 b1) (* 65536 b2) (* 16777216 b3)))
       (fn2-digests (fn2-digest-set-word dst k word fn2-digests)))
  (mv (if (= k 7) :ok :more) (+ (* 4 k) 4) 0 fn2-digests)))))
 :hints (("Goal" :cases ((< k 1) (< k 2) (< k 3) (< k 4) (< k 5) (< k 6) (< k 7) (< k 8))
                 :in-theory (enable fn2-rec-fetch-bytes fn2-rec-fetch-state-p fn2-layout-byte fn2-layout-kind-code ash)))
 :rule-classes nil))
(local (defthm fn2-rec-fetch-four-code
 (implies (and (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
               (fn2-digestsp fn2-digests) (fn2-digest-rowp dst fn2-digests)
               (natp k) (< k 8) (natp off))
  (equal (mv-nth 0 (fn2-rec-fetch-bytes 4 (* 4 k) 0 dst slot gen off okind oslot ogen fn2-pool fn2-digests)) (mv-nth 0 (b* ((at (+ off (* 4 k)))
       ((mv c0 b0) (fn2-rec-byte-at slot gen at okind oslot ogen fn2-pool))
       ((mv c1 b1) (fn2-rec-byte-at slot gen (+ 1 at) okind oslot ogen fn2-pool))
       ((mv c2 b2) (fn2-rec-byte-at slot gen (+ 2 at) okind oslot ogen fn2-pool))
       ((mv c3 b3) (fn2-rec-byte-at slot gen (+ 3 at) okind oslot ogen fn2-pool))
       ((unless (eq c0 :ok)) (mv c0 (+ (* 4 k) 0) 0 fn2-digests))
       ((unless (eq c1 :ok)) (mv c1 (+ (* 4 k) 1) (mv-nth 1 (fn2-layout-byte :u32 0 0 0 0 0 b0)) fn2-digests))
       ((unless (eq c2 :ok)) (mv c2 (+ (* 4 k) 2) (mv-nth 1 (fn2-layout-byte :u32 1 (mv-nth 1 (fn2-layout-byte :u32 0 0 0 0 0 b0)) 0 0 0 b1)) fn2-digests))
       ((unless (eq c3 :ok)) (mv c3 (+ (* 4 k) 3) (mv-nth 1 (fn2-layout-byte :u32 2 (mv-nth 1 (fn2-layout-byte :u32 1 (mv-nth 1 (fn2-layout-byte :u32 0 0 0 0 0 b0)) 0 0 0 b1)) 0 0 0 b2)) fn2-digests))
       (word (+ b0 (* 256 b1) (* 65536 b2) (* 16777216 b3)))
       (fn2-digests (fn2-digest-set-word dst k word fn2-digests)))
  (mv (if (= k 7) :ok :more) (+ (* 4 k) 4) 0 fn2-digests)))))
 :hints (("Goal" :use ((:instance fn2-rec-fetch-four-result))
                 :in-theory (disable fn2-rec-fetch-bytes)))))
(local (defthm fn2-rec-fetch-four-next
 (implies (and (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)

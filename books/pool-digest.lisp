(local (defthm fn2-rec-fetch-bytes-done-code
 (equal (mv-nth 0 (fn2-rec-fetch-bytes left 32 acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)) :ok)
 :hints (("Goal" :in-theory (enable fn2-rec-fetch-bytes)))))
(local (defthm fn2-rec-fetch-bytes-done-digests
 (equal (mv-nth 3 (fn2-rec-fetch-bytes left 32 acc dst slot gen off okind oslot ogen fn2-pool fn2-digests)) fn2-digests)
 :hints (("Goal" :in-theory (enable fn2-rec-fetch-bytes)))))

(defthm fn2-rec-fetch-exec-refines
 (implies (and (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
               (fn2-digestsp fn2-digests) (fn2-digest-rowp dst fn2-digests)
               (natp k) (<= k 8) (natp off))
  (equal (mv-list 2 (fn2-rec-fetch k dst slot gen off okind oslot ogen fn2-pool fn2-digests))
         (mv-list 2 (if (or (not (natp k)) (>= k 8)) (mv :ok fn2-digests)
   (mv-let (code next acc fn2-digests)
    (fn2-rec-fetch-step (- 32 (* 4 k)) (* 4 k) 0 dst slot gen off okind oslot ogen fn2-pool fn2-digests)
    (declare (ignore next acc))
    (mv code fn2-digests))))))
 :rule-classes nil
 :hints (("Goal" :induct (fn2-rec-fetch k dst slot gen off okind oslot ogen fn2-pool fn2-digests)
                        :in-theory (e/d (fn2-rec-fetch fn2-rec-fetch-step fn2-digest-rowp)
                                        (fn2-rec-fetch-bytes fn2-rec-fetch-state-p)))))
(in-theory (disable fn2-rec-fetch))


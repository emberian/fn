; One shared catalog-to-installed transition for cold and live adoption.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-summary-leases")
(fn2-book-layer :c)
(defun fn2-checkpoint-summary-install-source (s e r fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-run-installed)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-run-installed)
  :guard (and (fn2-checkpoint-summary-wfp fn2-checkpoint-summary)
              (fn2-checkpoint-summary-sources-wfp fn2-checkpoint-summary-sources) (fn2-run-installed-wfp fn2-run-installed))))
 (b* (((unless (and (natp s) (< s 2) (< s (fn2-checkpoint-summary-rows fn2-checkpoint-summary))
                    (natp e) (< e (fn2-checkpoint-summary-sources-rows fn2-checkpoint-summary-sources))
                    (natp r) (< r (fn2-run-installed-rows fn2-run-installed))))
       (mv :bounds fn2-run-installed))
      (tag (fn2-checkpoint-summary-tag s fn2-checkpoint-summary))
      (rank (fn2-checkpoint-summary-sources-rank e fn2-checkpoint-summary-sources))
      ((unless (and (posp tag) (= tag (fn2-checkpoint-summary-sources-tag e fn2-checkpoint-summary-sources))
                    (posp rank) (<= rank (fn2-checkpoint-summary-count s fn2-checkpoint-summary))))
       (mv :source fn2-run-installed)))
  (fn2-run-install-physical r (fn2-checkpoint-summary-sources-schema e fn2-checkpoint-summary-sources)
       (+ (fn2-checkpoint-summary-priority-base s fn2-checkpoint-summary) rank) rank
       (fn2-checkpoint-summary-sources-top e fn2-checkpoint-summary-sources)
       (fn2-checkpoint-summary-sources-entries e fn2-checkpoint-summary-sources)
       (fn2-checkpoint-summary-sources-unit e fn2-checkpoint-summary-sources)
       (fn2-checkpoint-summary-sources-epoch e fn2-checkpoint-summary-sources)
       (fn2-checkpoint-summary-sources-allocation e fn2-checkpoint-summary-sources)
       tag
       (fn2-checkpoint-summary-sources-hash-0 e fn2-checkpoint-summary-sources)
       (fn2-checkpoint-summary-sources-hash-1 e fn2-checkpoint-summary-sources)
       (fn2-checkpoint-summary-sources-hash-2 e fn2-checkpoint-summary-sources)
       (fn2-checkpoint-summary-sources-hash-3 e fn2-checkpoint-summary-sources)
       (fn2-checkpoint-summary-sources-hash-4 e fn2-checkpoint-summary-sources)
       (fn2-checkpoint-summary-sources-hash-5 e fn2-checkpoint-summary-sources)
       (fn2-checkpoint-summary-sources-hash-6 e fn2-checkpoint-summary-sources)
       (fn2-checkpoint-summary-sources-hash-7 e fn2-checkpoint-summary-sources) fn2-run-installed)))

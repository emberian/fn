; Independent decisions around the opaque append-export seam.
(in-package "ACL2")
(include-book "log-checkpoint-commit")
(include-book "defkeystone")
(local (in-theory (disable fn-lc-tail-history fn-lc-tail-scan fn-lc-scan-bytes fn-lc-decode-tail-records)))
(defthm fn-lc-commit-prepared-retains-segments
 (equal (mv-nth 2 (fn-lc-commit-prepared records segs fn-lbc)) segs)
 :hints (("Goal" :induct (fn-lc-commit-prepared records segs fn-lbc)
          :in-theory (disable fn-lc-append-prepared-columns))))
(defun fn-lc-teeth-empty-columns (fn-lbc)
 (declare (xargs :stobjs fn-lbc)) fn-lbc)

(defthm fn-lc-commit-refuses-past-k
 (let ((out (fn-lc-commit records segs header k fn-lbc)))
    (implies (and (natp k)
                  (< k (+ (len (fn-lc-tail-history segs header)) (len records))))
             (and (equal (mv-nth 0 out) :publication-behind)
                  (equal (mv-nth 2 out) segs))))
 :rule-classes nil
 :hints (("Goal" :in-theory (e/d (fn-lc-commit) (fn-lc-tail-history fn-lc-segs-retain fn-lc-prepared-recordsp fn-lc-commit-prepared fn-lc-prepare-tail fn-lc-tail-scan)))))
(defun fn-lc-commit-refuses-past-k-tooth-0 (records segs header k fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (and (fn-lbc-p fn-lbc) (natp k)) :verify-guards nil))
 (mv-let (answer fn-lbc post-segs) (fn-lc-commit records segs header k fn-lbc)
  (declare (ignorable answer post-segs))
  (mv (natp k) fn-lbc)))
(defun fn-lc-commit-refuses-past-k-tooth-1 (records segs header k fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (and (fn-lbc-p fn-lbc) (natp k)) :verify-guards nil))
 (mv-let (answer fn-lbc post-segs) (fn-lc-commit records segs header k fn-lbc)
  (declare (ignorable answer post-segs))
  (mv (< k (+ (len (fn-lc-tail-history segs header)) (len records))) fn-lbc)))
(defun fn-lc-commit-refuses-past-k-tooth-2 (records segs header k fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (and (fn-lbc-p fn-lbc) (natp k)) :verify-guards nil))
 (mv-let (answer fn-lbc post-segs) (fn-lc-commit records segs header k fn-lbc)
  (declare (ignorable answer post-segs))
  (mv (and (equal answer :publication-behind)
                  (equal post-segs segs)) fn-lbc)))
(defun fn-lc-commit-refuses-past-k-tooth-3 (records segs header k fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (and (fn-lbc-p fn-lbc) (natp k)) :verify-guards nil))
 (mv-let (answer fn-lbc post-segs) (fn-lc-commit records segs header k fn-lbc)
  (declare (ignorable answer post-segs))
  (mv (and (equal answer :ok)
                  (equal post-segs segs)) fn-lbc)))
(defteeth fn-lc-commit-refuses-past-k
 :claim (let ((out (fn-lc-commit records segs header k fn-lbc)))  (((natural (natp k)) (past (< k (+ (len (fn-lc-tail-history segs header)) (len records))))) (and (equal (mv-nth 0 out) :publication-behind)
                  (equal (mv-nth 2 out) segs))))
 :subject fn-lc-commit :witness ((records '(bad)) (segs '((0 nil nil))) (header (list :lc-header (list 0 0 0 0 *fn-lg-genesis*) 1 nil nil nil)) (k 0))
 :stobjs ((fn-lbc (fn-lc-teeth-empty-columns fn-lbc)))
 :stobj-checks (((let ((out (fn-lc-commit records segs header k fn-lbc))) (declare (ignorable out)) (natp k)) (fn-lc-commit-refuses-past-k-tooth-0 records segs header k fn-lbc) :hints (("Goal" :in-theory (disable fn-lc-commit))))
((let ((out (fn-lc-commit records segs header k fn-lbc))) (declare (ignorable out)) (< k (+ (len (fn-lc-tail-history segs header)) (len records)))) (fn-lc-commit-refuses-past-k-tooth-1 records segs header k fn-lbc) :hints (("Goal" :in-theory (disable fn-lc-commit))))
((let ((out (fn-lc-commit records segs header k fn-lbc))) (declare (ignorable out)) (and (equal (mv-nth 0 out) :publication-behind)
                  (equal (mv-nth 2 out) segs))) (fn-lc-commit-refuses-past-k-tooth-2 records segs header k fn-lbc) :hints (("Goal" :in-theory (disable fn-lc-commit))))
((let ((out (fn-lc-commit records segs header k fn-lbc))) (declare (ignorable out)) (and (equal (mv-nth 0 out) :ok)
                  (equal (mv-nth 2 out) segs))) (fn-lc-commit-refuses-past-k-tooth-3 records segs header k fn-lbc) :hints (("Goal" :in-theory (disable fn-lc-commit)))))
 :breaks ((natural ((records nil) (k -1)) :logical "negative bound outside the omitted type guard returns invalid-tail-bound")
 (past ((records nil) (k 0)) :logical "at the bound, an empty commit is accepted"))
 :mutations ((decision (:conclusion (and (equal (mv-nth 0 out) :ok)
                  (equal (mv-nth 2 out) segs))) ((records '(bad)) (segs '((0 nil nil))) (header (list :lc-header (list 0 0 0 0 *fn-lg-genesis*) 1 nil nil nil)) (k 0))
  :fault "incorrect backpressure decision or strict accepted-tail bound")))

(defthm fn-lc-commit-keeps-the-tail-within-k
 (let ((out (fn-lc-commit records segs header k fn-lbc)))
    (implies (equal (mv-nth 0 out) :ok)
             (<= (len (fn-lc-tail-history (mv-nth 2 out) header)) k)))
 :rule-classes nil
 :hints (("Goal" :in-theory (e/d (fn-lc-commit) (fn-lc-tail-history fn-lc-segs-retain fn-lc-prepared-recordsp fn-lc-commit-prepared fn-lc-prepare-tail fn-lc-tail-scan)))))
(defun fn-lc-commit-keeps-the-tail-within-k-tooth-0 (records segs header k fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (and (fn-lbc-p fn-lbc) (natp k)) :verify-guards nil))
 (mv-let (answer fn-lbc post-segs) (fn-lc-commit records segs header k fn-lbc)
  (declare (ignorable answer post-segs))
  (mv (equal answer :ok) fn-lbc)))
(defun fn-lc-commit-keeps-the-tail-within-k-tooth-1 (records segs header k fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (and (fn-lbc-p fn-lbc) (natp k)) :verify-guards nil))
 (mv-let (answer fn-lbc post-segs) (fn-lc-commit records segs header k fn-lbc)
  (declare (ignorable answer post-segs))
  (mv (<= (len (fn-lc-tail-history post-segs header)) k) fn-lbc)))
(defun fn-lc-commit-keeps-the-tail-within-k-tooth-2 (records segs header k fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (and (fn-lbc-p fn-lbc) (natp k)) :verify-guards nil))
 (mv-let (answer fn-lbc post-segs) (fn-lc-commit records segs header k fn-lbc)
  (declare (ignorable answer post-segs))
  (mv (< (len (fn-lc-tail-history post-segs header)) k) fn-lbc)))
(defteeth fn-lc-commit-keeps-the-tail-within-k
 :claim (let ((out (fn-lc-commit records segs header k fn-lbc)))  (((accepted (equal (mv-nth 0 out) :ok))) (<= (len (fn-lc-tail-history (mv-nth 2 out) header)) k)))
 :subject fn-lc-commit :witness ((records nil) (segs '((0 nil nil))) (header (list :lc-header (list 0 0 0 0 *fn-lg-genesis*) 1 nil nil nil)) (k 0))
 :stobjs ((fn-lbc (fn-lc-teeth-empty-columns fn-lbc)))
 :stobj-checks (((let ((out (fn-lc-commit records segs header k fn-lbc))) (declare (ignorable out)) (equal (mv-nth 0 out) :ok)) (fn-lc-commit-keeps-the-tail-within-k-tooth-0 records segs header k fn-lbc) :hints (("Goal" :in-theory (disable fn-lc-commit))))
((let ((out (fn-lc-commit records segs header k fn-lbc))) (declare (ignorable out)) (<= (len (fn-lc-tail-history (mv-nth 2 out) header)) k)) (fn-lc-commit-keeps-the-tail-within-k-tooth-1 records segs header k fn-lbc) :hints (("Goal" :in-theory (disable fn-lc-commit))))
((let ((out (fn-lc-commit records segs header k fn-lbc))) (declare (ignorable out)) (< (len (fn-lc-tail-history (mv-nth 2 out) header)) k)) (fn-lc-commit-keeps-the-tail-within-k-tooth-2 records segs header k fn-lbc) :hints (("Goal" :in-theory (disable fn-lc-commit)))))
 :breaks ((accepted ((k -1)) :logical "invalid bound refusal leaves the nonnegative tail longer than -1"))
 :mutations ((decision (:conclusion (< (len (fn-lc-tail-history (mv-nth 2 out) header)) k)) ((records nil) (segs '((0 nil nil))) (header (list :lc-header (list 0 0 0 0 *fn-lg-genesis*) 1 nil nil nil)) (k 0))
  :fault "incorrect backpressure decision or strict accepted-tail bound")))
(defteeth-check (fn-lc-commit-refuses-past-k fn-lc-commit-keeps-the-tail-within-k))

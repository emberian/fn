; Layer C: one run page. B's page header, sealing and checking; C's payload.
; The payload is C's run-page header in a reserved region, the entries in key
; order, then the restart directory; B checks the zero padding after it.
(in-package "ACL2")
(include-book "runs-page-seal")
(fn2-book-layer :c)

(local (in-theory (disable fn2-digests-rows fn2-fc-rows fn2-fc-context-rows fn2-b3-rows fn2-fields-rows fn2-pool-rows)))

; Copy field row FROM to TO (value, reference, status).
(defun fn2-run-copy-row (from to fn2-fields)
 (declare (xargs :stobjs fn2-fields
  :guard (and (fn2-fields-wfp fn2-fields) (natp from) (natp to)
              (< from (fn2-fields-rows fn2-fields)) (< to (fn2-fields-rows fn2-fields)))))
 (let ((v (fn2-fields-value from fn2-fields)) (rs (fn2-fields-ref-slot from fn2-fields))
       (rg (fn2-fields-ref-gen from fn2-fields)) (ro (fn2-fields-ref-off from fn2-fields))
       (rl (fn2-fields-ref-len from fn2-fields)) (st (fn2-fields-status from fn2-fields)))
  (fn2-layout-store to v rs rg ro rl st fn2-fields)))
(fn2-fields-preserves fn2-run-copy-row (from to fn2-fields)
 :hyps ((fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (natp from) (natp to)
        (< from (fn2-fields-rows fn2-fields)) (< to (fn2-fields-rows fn2-fields)))
 :hints (("Goal" :in-theory (disable fn2-fields-rows))))

; Reader. A page is read only after B's checker accepted it under its
; parent-held hash; these checks name malformed internal structure anyway.
; Field rows: B header at BASE, C header after it, one restart row, then the
; decoded entry.
(defconst *fn2-run-reader-restart* (+ *fn2-run-c-header-fields* *fn2-run-page-header-num-fields*))
(defconst *fn2-run-reader-entry* (+ 1 *fn2-run-reader-restart*))
(defconst *fn2-run-reader-fields* (+ *fn2-run-reader-entry* *fn2-run-entry-rows*))
(defun fn2-run-readerp (base fn2-fields)
 (declare (xargs :stobjs fn2-fields :guard t))
 (and (fn2-fields-wfp fn2-fields) (natp base)
      (<= (+ base *fn2-run-reader-fields*) (fn2-fields-rows fn2-fields))))
(defun fn2-run-read-header (slot gen base okind oslot ogen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool)
  :guard (and (fn2-run-readerp base fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((mv code & fn2-fields) (fn2-format-page-header-decode base slot gen 0 *fn2-run-header-area* okind oslot ogen fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields))
      (c (+ base *fn2-run-c-header-fields*))
      ((mv code & fn2-fields) (fn2-run-page-header-decode c slot gen *fn2-run-header-area* *fn2-run-entries-base* okind oslot ogen fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields))
      (payload (nfix (fn2-fields-value (+ base *fn2-format-page-header-field-payload-length*) fn2-fields)))
      (restarts (nfix (fn2-fields-value (+ c *fn2-run-page-header-field-restarts*) fn2-fields)))
      (entries (nfix (fn2-fields-value (+ c *fn2-run-page-header-field-entries*) fn2-fields))))
  (cond ((not (equal (fn2-fields-value (+ base *fn2-format-page-header-field-magic*) fn2-fields) *fn2-format-page-magic*)) (mv :bad-magic fn2-fields))
        ((not (equal (fn2-fields-value (+ base *fn2-format-page-header-field-header-length*) fn2-fields) *fn2-run-header-area*)) (mv :format fn2-fields))
        ((not (equal (fn2-fields-value (+ c *fn2-run-page-header-field-restart-interval*) fn2-fields) *fn2-run-restart-interval*)) (mv :format fn2-fields))
        ((not (and (<= (+ *fn2-run-header-area* payload) *fn2-run-page-size*)
                   (<= (+ *fn2-run-entries-base* (* *fn2-run-restart-bytes* restarts)) (+ *fn2-run-header-area* payload))
                   (equal restarts (ceiling entries *fn2-run-restart-interval*))))
         (mv :format fn2-fields))
        (t (mv :ok fn2-fields)))))
(fn2-fields-preserves fn2-run-read-header (slot gen base okind oslot ogen fn2-fields fn2-pool) :position 1
 :hyps ((fn2-fieldsp fn2-fields) (fn2-run-readerp base fn2-fields))
 :hints (("Goal" :in-theory (disable fn2-fields-rows))))
(defun fn2-run-header-value (base field fn2-fields)
 (declare (xargs :stobjs fn2-fields :guard (and (fn2-run-readerp base fn2-fields) (natp field) (< field *fn2-run-reader-restart*))))
 (nfix (fn2-fields-value (+ base field) fn2-fields)))
; Field selectors over a read header, by name.
(defmacro fn2-run-hdr (base field)
 `(fn2-run-header-value ,base (+ *fn2-run-c-header-fields* ,(fn2-codec-constant 'fn2-run-page-header (concatenate 'string "-FIELD-" (symbol-name field)))) fn2-fields))
(defun fn2-run-directory (base fn2-fields)
 (declare (xargs :stobjs fn2-fields :guard (fn2-run-readerp base fn2-fields)))
 (nfix (- (+ *fn2-run-header-area* (nfix (fn2-fields-value (+ base *fn2-format-page-header-field-payload-length*) fn2-fields)))
          (* *fn2-run-restart-bytes* (fn2-run-hdr base restarts)))))
; Restart J's entry offset, validated against the entry region.
(defun fn2-run-restart-offset (j slot gen base okind oslot ogen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool)
  :guard (and (fn2-run-readerp base fn2-fields) (fn2-pool-wfp fn2-pool) (natp j))))
 (b* (((unless (< j (fn2-run-hdr base restarts))) (mv :bounds 0 fn2-fields))
      (dir (fn2-run-directory base fn2-fields))
      (at (+ dir (* *fn2-run-restart-bytes* j)))
      (r (+ base *fn2-run-reader-restart*))
      ((mv code & fn2-fields) (fn2-run-restart-decode r slot gen at (+ at *fn2-run-restart-bytes*) okind oslot ogen fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code 0 fn2-fields))
      (off (nfix (fn2-fields-value r fn2-fields))))
  (if (and (<= *fn2-run-entries-base* off) (< off dir)) (mv :ok off fn2-fields) (mv :format 0 fn2-fields))))
(fn2-fields-preserves fn2-run-restart-offset (j slot gen base okind oslot ogen fn2-fields fn2-pool) :position 2
 :hyps ((fn2-fieldsp fn2-fields) (fn2-run-readerp base fn2-fields))
 :hints (("Goal" :in-theory (disable fn2-fields-rows))))

; A key's octet fields are at most this long, so one key comparison stays
; inside a run's 4096-byte quantum.
(defconst *fn2-run-key-octets-max* 512)
; Lexicographic order of two pool ranges, each read under its own owner:
; A's fn2-pool-compare over the common prefix, then the shorter first.
(defun fn2-run-octets-compare (aslot agen aoff alen bslot bgen boff blen ak as ag bk bs bg fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (if (not (and (natp aoff) (natp boff) (natp alen) (natp blen)))
     (mv :bounds :eq)
  (mv-let (code result at)
    (fn2-pool-compare aslot agen aoff ak as ag bslot bgen boff bk bs bg (min alen blen) fn2-pool)
   (declare (ignore at))
   (cond ((not (eq code :ok)) (mv code :eq))
         ((eq result :less) (mv :ok :lt)) ((eq result :greater) (mv :ok :gt))
         ((< alen blen) (mv :ok :lt)) ((< blen alen) (mv :ok :gt)) (t (mv :ok :eq))))))
(defun fn2-run-octets-field-compare (a b ak as ag bk bs bg fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool)
  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (natp a) (natp b)
              (< a (fn2-fields-rows fn2-fields)) (< b (fn2-fields-rows fn2-fields)))))
 (fn2-run-octets-compare (fn2-fields-ref-slot a fn2-fields) (fn2-fields-ref-gen a fn2-fields)
                         (fn2-fields-ref-off a fn2-fields) (fn2-fields-ref-len a fn2-fields)
                         (fn2-fields-ref-slot b fn2-fields) (fn2-fields-ref-gen b fn2-fields)
                         (fn2-fields-ref-off b fn2-fields) (fn2-fields-ref-len b fn2-fields)
                         ak as ag bk bs bg fn2-pool))
(in-theory (disable fn2-run-octets-compare fn2-run-octets-field-compare))
(defun fn2-run-value-compare (a b fn2-fields)
 (declare (xargs :stobjs fn2-fields
  :guard (and (fn2-fields-wfp fn2-fields) (natp a) (natp b)
              (< a (fn2-fields-rows fn2-fields)) (< b (fn2-fields-rows fn2-fields)))))
 (let ((x (nfix (fn2-fields-value a fn2-fields))) (y (nfix (fn2-fields-value b fn2-fields))))
  (cond ((< x y) :lt) ((< y x) :gt) (t :eq))))

; Preconditions of one append, checked at run time so that the append adds
; no arithmetic of its own to prove. EBASE holds one decoded-entry region.
(defun fn2-run-add-check (w schema ebase fn2-run-writers fn2-run-restarts fn2-fields)
 (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts fn2-fields)
  :guard (and (fn2-run-writers-wfp fn2-run-writers) (fn2-run-restarts-wfp fn2-run-restarts)
              (fn2-fields-wfp fn2-fields))))
 (cond ((not (and (natp w) (< w (fn2-run-writers-rows fn2-run-writers))
                  (<= (* (+ 1 w) *fn2-run-restart-capacity*) (fn2-run-restarts-rows fn2-run-restarts))
                  (natp ebase) (<= (+ ebase *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields))
                  (<= (+ (fn2-run-writers-fields w fn2-run-writers) *fn2-run-writer-fields*)
                      (fn2-fields-rows fn2-fields))))
        :bounds)
       ((not (equal (fn2-run-writers-phase w fn2-run-writers) *fn2-run-writer-phase-open*)) :state)
       ((not (equal (fn2-run-writers-schema w fn2-run-writers) schema)) :schema)
       (t :ok)))
; After the encode and the decode of the previous key: advance, or fail the
; writer (its restart was already noted, so it cannot continue).
(defun fn2-run-add-commit (w code end fn2-run-writers)
 (declare (xargs :stobjs fn2-run-writers
  :guard (and (fn2-run-writers-wfp fn2-run-writers) (natp w) (< w (fn2-run-writers-rows fn2-run-writers)))))
 (let ((entries (+ 1 (fn2-run-writers-entries w fn2-run-writers))))
  (if (and (eq code :ok) (unsigned-byte-p 32 end) (unsigned-byte-p 32 entries))
      (let ((fn2-run-writers (fn2-run-writers-put w (cursor end) (entries entries) (prev 1))))
       (mv :ok fn2-run-writers))
   (let ((fn2-run-writers (fn2-run-writers-set-phase w *fn2-run-writer-phase-failed* fn2-run-writers)))
    (mv (if (eq code :ok) :bounds code) fn2-run-writers)))))
(fn2-run-writers-preserves fn2-run-add-commit (w code end fn2-run-writers) :position 1 :raw-rows t
 :hyps ((fn2-run-writersp fn2-run-writers) (fn2-run-writers-wfp fn2-run-writers) (natp w) (< w (fn2-run-writers-rows fn2-run-writers))))
(in-theory (disable fn2-run-roomp))
(defthm fn2-run-restart-offset-natp
 (natp (mv-nth 1 (fn2-run-restart-offset j slot gen base okind oslot ogen fn2-fields fn2-pool)))
 :hints (("Goal" :in-theory (enable fn2-run-restart-offset)))
 :rule-classes ((:type-prescription :typed-term (mv-nth 1 (fn2-run-restart-offset j slot gen base okind oslot ogen fn2-fields fn2-pool)))))

; ---------------------------------------------------------------------------
; Specification and logic adapters. Lists exist only here; no served path
; calls these. The keystones compare the real writer and seek against them.
; Page metadata, in order: page-kind history incarnation unit epoch counter
; schema version run level ordinal.
(fn2-cm-defreaders fn2-run-meta-page-kind fn2-run-meta-history fn2-run-meta-incarnation
 fn2-run-meta-unit fn2-run-meta-epoch fn2-run-meta-counter fn2-run-meta-schema
 fn2-run-meta-version fn2-run-meta-run fn2-run-meta-level fn2-run-meta-ordinal)
(defun fn2-run-pad (octets n)
 (declare (xargs :verify-guards nil))
 (append octets (make-list (nfix (- n (len octets))) :initial-element 0)))
(defun fn2-run-entries-octets (layout entries)
 (declare (xargs :verify-guards nil))
 (if (atom entries) nil
  (append (fn2-layout-octets layout (car entries)) (fn2-run-entries-octets layout (cdr entries)))))
(defun fn2-run-restart-offsets-spec (layout entries i off)
 (declare (xargs :verify-guards nil))
 (if (atom entries) nil
  (let ((rest (fn2-run-restart-offsets-spec layout (cdr entries) (+ 1 i)
                (+ off (len (fn2-layout-octets layout (car entries)))))))
   (if (equal (mod i *fn2-run-restart-interval*) 0) (cons off rest) rest))))
(defun fn2-run-directory-octets (offsets)
 (declare (xargs :verify-guards nil))
 (if (atom offsets) nil (append (fn2-layout-le 4 (car offsets)) (fn2-run-directory-octets (cdr offsets)))))
(defun fn2-run-page-spec (layout meta entries)
 (declare (xargs :verify-guards nil))
 (let* ((body (fn2-run-entries-octets layout entries))
        (offsets (fn2-run-restart-offsets-spec layout entries 0 *fn2-run-entries-base*))
        (payload (- (+ *fn2-run-entries-base* (len body) (* *fn2-run-restart-bytes* (len offsets))) *fn2-run-header-area*))
        (b (fn2-layout-octets *fn2-format-page-header*
             (list *fn2-format-page-magic* *fn2-format-version* (fn2-run-meta-page-kind meta)
                   (fn2-run-meta-history meta) (fn2-run-meta-incarnation meta) (fn2-run-meta-unit meta)
                   (fn2-run-meta-epoch meta) (fn2-run-meta-counter meta) *fn2-run-header-area* payload)))
        (c (fn2-layout-octets *fn2-run-page-header*
             (list (fn2-run-meta-schema meta) (fn2-run-meta-version meta) (fn2-run-meta-run meta)
                   (fn2-run-meta-level meta) (fn2-run-meta-ordinal meta) (len entries) (len offsets)
                   *fn2-run-restart-interval*))))
  (fn2-run-pad (append (fn2-run-pad b *fn2-run-header-area*)
                       (fn2-run-pad c *fn2-run-page-header-max-size*)
                       body (fn2-run-directory-octets offsets))
               *fn2-run-page-size*)))
; Key order on spec values: integers numerically; octets, and a digest's
; bytes, lexicographically with the shorter prefix first.
(defun fn2-run-octets-order-spec (a b)
 (declare (xargs :verify-guards nil))
 (cond ((and (atom a) (atom b)) :eq) ((atom a) :lt) ((atom b) :gt)
       ((< (nfix (car a)) (nfix (car b))) :lt) ((< (nfix (car b)) (nfix (car a))) :gt)
       (t (fn2-run-octets-order-spec (cdr a) (cdr b)))))
(defun fn2-run-key-order-spec (key a b)
 (declare (xargs :verify-guards nil))
 (if (atom key) :eq
  (let* ((k (cadar key))
         (o (cond ((eq k :digest) (fn2-run-octets-order-spec (cdr (car a)) (cdr (car b))))
                  ((and (consp k) (eq (car k) :octets)) (fn2-run-octets-order-spec (car a) (car b)))
                  ((< (nfix (car a)) (nfix (car b))) :lt) ((< (nfix (car b)) (nfix (car a))) :gt) (t :eq))))
   (if (eq o :eq) (fn2-run-key-order-spec (cdr key) (cdr a) (cdr b)) o))))
(defun fn2-run-sorted-spec (key entries)
 (declare (xargs :verify-guards nil))
 (or (atom entries) (atom (cdr entries))
     (and (eq (fn2-run-key-order-spec key (car entries) (cadr entries)) :lt)
          (fn2-run-sorted-spec key (cdr entries)))))
; (found-p index) of the first entry whose key is >= Q.
(defun fn2-run-lower-bound-spec (key entries q i)
 (declare (xargs :verify-guards nil))
 (if (atom entries) (list :absent i)
  (case (fn2-run-key-order-spec key (car entries) q)
   (:lt (fn2-run-lower-bound-spec key (cdr entries) q (+ 1 i)))
   (:eq (list :found i))
   (otherwise (list :absent i)))))
(defun fn2-run-values-layoutp (layout values)
 (declare (xargs :verify-guards nil))
 (let ((bytes (fn2-layout-octets layout values)))
   (and (fn-b3-octet-listp bytes)
        (mv-let (code parsed rest) (fn2-layout-parse layout bytes)
          (and (eq code :ok) (equal parsed values) (null rest))))))
(defun fn2-run-entries-layoutp (layout entries)
 (declare (xargs :verify-guards nil))
 (if (atom entries) (null entries)
  (and (fn2-run-values-layoutp layout (car entries)) (fn2-run-entries-layoutp layout (cdr entries)))))
; The inputs one page accepts: well-formed sorted entries that fit, and
; metadata within the resident widths.
(defun fn2-run-page-inputp (layout key meta entries)
 (declare (xargs :verify-guards nil))
 (and (fn2-layoutp layout) (true-listp meta) (equal (len meta) 11)
      (unsigned-byte-p 8 (fn2-run-meta-page-kind meta)) (unsigned-byte-p 8 (fn2-run-meta-version meta))
      (unsigned-byte-p 8 (fn2-run-meta-level meta))
      (unsigned-byte-p 60 (fn2-run-meta-history meta)) (unsigned-byte-p 60 (fn2-run-meta-incarnation meta))
      (unsigned-byte-p 60 (fn2-run-meta-unit meta)) (unsigned-byte-p 60 (fn2-run-meta-epoch meta))
      (unsigned-byte-p 60 (fn2-run-meta-counter meta)) (unsigned-byte-p 60 (fn2-run-meta-schema meta))
      (unsigned-byte-p 60 (fn2-run-meta-run meta)) (unsigned-byte-p 60 (fn2-run-meta-ordinal meta))
      (fn2-run-entries-layoutp layout entries) (fn2-run-sorted-spec key entries)
      (<= (len (fn2-run-page-spec layout meta entries)) *fn2-run-page-size*)
      (<= (+ *fn2-run-entries-base* (len (fn2-run-entries-octets layout entries))
             (* *fn2-run-restart-bytes* (len (fn2-run-restart-offsets-spec layout entries 0 0))))
          *fn2-run-page-size*)))

; Logic adapter: set one entry's field rows from spec VALUES, copying octet
; and digest bytes into the source slot at OFF. Returns (mv code off fields pool).
(defun fn2-run-load-bytes (bytes slot gen off okind oslot ogen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (if (atom bytes) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen off (car bytes) okind oslot ogen fn2-pool)
   (if (eq code :ok) (fn2-run-load-bytes (cdr bytes) slot gen (+ 1 (nfix off)) okind oslot ogen fn2-pool)
    (mv code fn2-pool)))))
(defun fn2-run-load-ref (row bytes slot gen off okind oslot ogen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* (((mv code fn2-pool) (fn2-run-load-bytes bytes slot gen off okind oslot ogen fn2-pool))
      (fn2-fields (fn2-fields-set-ref-slot row slot fn2-fields))
      (fn2-fields (fn2-fields-set-ref-gen row gen fn2-fields))
      (fn2-fields (fn2-fields-set-ref-off row off fn2-fields))
      (fn2-fields (fn2-fields-set-ref-len row (len bytes) fn2-fields)))
  (mv code (+ (nfix off) (len bytes)) fn2-fields fn2-pool)))
(defun fn2-run-load-values (layout values row slot gen off okind oslot ogen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (if (atom layout) (mv :ok off fn2-fields fn2-pool)
  (b* ((k (cadar layout)) (v (car values))
       ((mv code off fn2-fields fn2-pool)
        (cond ((eq k :digest)
               (b* ((fn2-fields (fn2-fields-set-value row (nfix (car v)) fn2-fields)))
                (fn2-run-load-ref row (cdr v) slot gen off okind oslot ogen fn2-fields fn2-pool)))
              ((and (consp k) (eq (car k) :octets))
               (fn2-run-load-ref row v slot gen off okind oslot ogen fn2-fields fn2-pool))
              (t (let ((fn2-fields (fn2-fields-set-value row (nfix v) fn2-fields)))
                  (mv :ok off fn2-fields fn2-pool)))))
       ((unless (eq code :ok)) (mv code off fn2-fields fn2-pool)))
   (fn2-run-load-values (cdr layout) (cdr values) (+ 1 row) slot gen off okind oslot ogen fn2-fields fn2-pool))))
(defun fn2-run-read-bytes (n slot gen off okind oslot ogen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix n)))
 (if (zp n) nil
  (mv-let (code byte) (fn2-pool-read slot gen off okind oslot ogen fn2-pool)
   (cons (if (eq code :ok) byte code) (fn2-run-read-bytes (- n 1) slot gen (+ 1 (nfix off)) okind oslot ogen fn2-pool)))))

; WITH-LOCAL-STOBJ over STOBJS around a body returning (mv answer s1 .. sn).
(defun fn2-run-nest (k stobjs e)
 (declare (xargs :verify-guards nil))
 (if (zp k) e
  (fn2-run-nest (- k 1) stobjs
   `(with-local-stobj ,(nth (- k 1) stobjs)
     (mv-let (answer ,@(take k stobjs)) ,e
      ,(if (= k 1) 'answer `(mv answer ,@(take (- k 1) stobjs))))))))
(defmacro fn2-run-with-local (stobjs body) (fn2-run-nest (len stobjs) stobjs body))
(defconst *fn2-run-adapter-stobjs*
 '(fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests))
; Fixture plan for the adapters: owner (9 0 1); query owner (10 0 1).
(defconst *fn2-run-adapter-entry* 200)
(defconst *fn2-run-adapter-reader* 300)
(defconst *fn2-run-adapter-query* 420)
(defconst *fn2-run-adapter-hash* 136)
(defun fn2-run-adapter-setup (fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
 (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests) :verify-guards nil))
 (b* ((fn2-run-writers (fn2-run-writers-init 1 fn2-run-writers))
      (fn2-run-restarts (fn2-run-restarts-init *fn2-run-restart-capacity* fn2-run-restarts))
      (fn2-fields (fn2-fields-init 512 fn2-fields))
      (fn2-pool (fn2-pool-init '((2 . 65536) (1 . 65536)) 1 100 fn2-pool))
      (fn2-fc (fn2-fc-init 1 fn2-fc))
      (fn2-fc-context (fn2-fc-context-init 1 fn2-fc-context))
      (fn2-b3 (fn2-b3-table-init 1 fn2-b3))
      (fn2-digests (fn2-digests-init 140 fn2-digests)))
  (mv fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)))
(defun fn2-run-adapter-drive (kind fuel fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
 (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
                 :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
  (b* (((mv code fn2-run-writers fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
        (if (eq kind :close)
            (mv-let (code fn2-run-writers fn2-fields fn2-pool)
              (fn2-run-close-step 0 4096 fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
              (mv code fn2-run-writers fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests))
          (fn2-run-seal-step 0 0 *fn2-run-adapter-hash* 4096 fn2-run-writers fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))))
   (if (eq code :more)
       (fn2-run-adapter-drive kind (- fuel 1) fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
     (mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)))))
; Spec values of the decoded entry at field row ROW (logic adapter).
(defun fn2-run-unload-values (layout row fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (if (atom layout) nil
  (let* ((k (cadar layout)) (v (fn2-fields-value row fn2-fields))
         (bytes (fn2-run-read-bytes (fn2-fields-ref-len row fn2-fields) (fn2-fields-ref-slot row fn2-fields)
                                    (fn2-fields-ref-gen row fn2-fields) (fn2-fields-ref-off row fn2-fields) 9 0 1 fn2-pool)))
   (cons (cond ((eq k :digest) (cons v bytes)) ((and (consp k) (eq (car k) :octets)) bytes) (t v))
         (fn2-run-unload-values (cdr layout) (+ 1 row) fn2-fields fn2-pool)))))
; The entry whose key equals Q's, or :absent.
(defun fn2-run-key-lookup-spec (key entries q)
 (declare (xargs :verify-guards nil))
 (cond ((atom entries) (list :absent nil))
       ((eq (fn2-run-key-order-spec key (car entries) q) :eq) (list :found (car entries)))
       (t (fn2-run-key-lookup-spec key (cdr entries) q))))

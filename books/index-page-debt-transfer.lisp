; Transfer the CURRENT sealed page reservation's custody to its registered
; page-owner row.  The shared pool charge remains C: this is not promotion,
; refund, constructor authorization, or permission to retire the owner row.
(in-package "ACL2")
(logic)
(include-book "index-backing-row-copy")
(local (include-book "arithmetic-5/top" :dir :system))

(defun fn-ipa-page-debt-matchp (pending stored)
 (declare (xargs :guard t))
 (and (fn-omk-widthp pending 13) (fn-omk-widthp stored 13)
      (eq (fn-omk-at 0 pending) :page-reservation)
      (eq (fn-omk-at 0 stored) :page-reservation)
      (equal (fn-omk-at 1 pending) (fn-omk-at 1 stored))
      (equal (fn-omk-at 2 pending) (fn-omk-at 2 stored))
      (equal (fn-omk-at 3 pending) (fn-omk-at 3 stored))
      (equal (fn-omk-at 6 pending) (fn-omk-at 6 stored))
      (equal (fn-omk-at 7 pending) (fn-omk-at 7 stored))
      (equal (fn-omk-at 8 pending) (fn-omk-at 8 stored))
      (fn-prs-vectorp (fn-omk-at 5 pending))
      (fn-prs-vectorp (fn-omk-at 5 stored))
      (equal (fn-prl-nth 0 (fn-omk-at 5 pending)) (fn-prl-nth 0 (fn-omk-at 5 stored)))
      (equal (fn-prl-nth 1 (fn-omk-at 5 pending)) (fn-prl-nth 1 (fn-omk-at 5 stored)))
      (equal (fn-prl-nth 2 (fn-omk-at 5 pending)) (fn-prl-nth 2 (fn-omk-at 5 stored)))
      (equal (fn-prl-nth 3 (fn-omk-at 5 pending)) (fn-prl-nth 3 (fn-omk-at 5 stored)))
      (equal (fn-prl-nth 4 (fn-omk-at 5 pending)) (fn-prl-nth 4 (fn-omk-at 5 stored)))
      (null (fn-omk-at 12 pending)) (null (fn-omk-at 12 stored))))

(defun fn-ipa-row-debt-transfer (fuel fn-index-backing)
 (declare (xargs :stobjs fn-index-backing :guard (natp fuel) :verify-guards nil))
 (let* ((pending (fn-ibp-page-pending fn-index-backing))
        (builder (fn-ibp-builder fn-index-backing))
        (nonce (fn-omk-at 2 pending)) (physical (fn-omk-at 3 pending))
        (depth (fn-ibp-slot-depth fn-index-backing)))
  (cond
   ((not (and (fn-omk-widthp pending 13) (posp nonce) (natp physical)
              (eq (fn-omk-at 10 pending) :sealed)
              (eq (fn-omk-at 6 pending) :rows)
              (eq (fn-omk-at 1 builder) :table-layout)
              (equal (fn-omk-at 7 pending) (fn-omk-at 2 builder))))
    (mv :stale fuel fn-index-backing))
   ((<= fuel depth) (mv :yield fuel fn-index-backing))
   (t
    (let ((token (list :index-page nonce (+ 1 (floor physical 64)) (mod physical 64))))
     (stobj-let ((fn-ibp-node (fn-ibp-registry fn-index-backing)))
      (word row delta left fn-ibp-node)
      (fn-ibp-node-page-owner-action token :read nil nil nil nil fuel
                                    (floor physical 64) depth fn-ibp-node)
      (if (not (and (eq word :present) (equal delta 0)
                    (eq (fn-omk-at 9 row) :sealed)
                    (equal (fn-omk-at 3 row) physical)
                    (equal (fn-omk-at 4 row) nonce) (equal (fn-omk-at 5 row) nonce)
                    (equal (fn-omk-at 6 row) 1)
                    (equal (fn-omk-at 12 row) (fn-omk-at 2 builder))
                    (fn-ipa-page-debt-matchp pending (fn-omk-at 11 row))))
          (mv :recovery-required left fn-index-backing)
        (let ((fn-index-backing (update-fn-ibp-page-pending nil fn-index-backing)))
         (mv :transferred left fn-index-backing)))))))))
(verify-guards fn-ipa-row-debt-transfer
 :hints (("Goal" :in-theory (disable fn-ibp-node-page-owner-action))))

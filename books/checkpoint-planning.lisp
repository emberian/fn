; One page per call: actual allocator identities, no extent mutation in preview.
(in-package "ACL2")
(include-book "checkpoint-planning-state")
(include-book "checkpoint-build-state")
(include-book "checkpoint-metadata-page")
(fn2-book-layer :c)

; Phase3 has already been entered by the owner-scoped B barrier. Bind only
; the actual construction candidate; no caller-selected snapshot cut is kept.
(defun fn2-checkpoint-planning-bind (c token kind owner gen fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-build fn2-csnapshot fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-build fn2-csnapshot fn2-extents)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-checkpoint-recipe-wfp fn2-checkpoint-recipe)
              (fn2-checkpoint-build-wfp fn2-checkpoint-build) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (and (< 0 (fn2-checkpoint-planning-rows fn2-checkpoint-planning))
                    (< 0 (fn2-checkpoint-build-rows fn2-checkpoint-build))
                    (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-idle*)
                    (equal (fn2-checkpoint-recipe-rows fn2-checkpoint-recipe) (fn2-extents-rows fn2-extents))
                    (unsigned-byte-p 32 c) (posp token)
                    (fn2-checkpoint-build-ownerp token kind owner gen fn2-checkpoint-build fn2-csnapshot)
                    (equal c (fn2-checkpoint-build-candidate 0 fn2-checkpoint-build))
                    (equal (fn2-alloc-freeze-phase fn2-extents) 3)
                    (equal token (fn2-alloc-freeze-token fn2-extents))
                    (equal kind (fn2-alloc-freeze-owner-kind fn2-extents))
                    (equal owner (fn2-alloc-freeze-owner-slot fn2-extents))
                    (equal gen (fn2-alloc-freeze-owner-gen fn2-extents))))
       (mv :owner fn2-checkpoint-planning))
      (fn2-checkpoint-planning (fn2-checkpoint-planning-put 0
       (phase *fn2-checkpoint-planning-phase-clear*) (candidate c) (token token)
       (owner-kind kind) (owner-slot owner) (owner-gen gen)
       (cut-commit (fn2-csnapshot-cut-commit 0 fn2-csnapshot)) (cut-event (fn2-csnapshot-cut-event 0 fn2-csnapshot))
       (first-free (fn2-alloc-free-head fn2-extents)) (next-free (fn2-alloc-free-head fn2-extents))
       (epoch (fn2-alloc-current-epoch fn2-extents)) (first-counter (fn2-alloc-next-counter fn2-extents))
       (clear-row 0) (count 0) (sealed 0) (position 0) (reserved 0))))
  (mv :ok fn2-checkpoint-planning)))

; Clear one recipe marker per charged caller turn. No old planning-token
; uniqueness assumption is needed; table dimensions are the actual extents.
(defun fn2-checkpoint-planning-clear-step (c token kind owner gen fn2-checkpoint-planning fn2-checkpoint-recipe fn2-csnapshot fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-checkpoint-recipe fn2-csnapshot fn2-extents)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-checkpoint-recipe-wfp fn2-checkpoint-recipe)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (and (fn2-checkpoint-planning-ownerp c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents)
                    (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-clear*)))
       (mv :owner fn2-checkpoint-planning fn2-checkpoint-recipe))
      (i (fn2-checkpoint-planning-clear-row 0 fn2-checkpoint-planning))
      ((when (>= i (fn2-checkpoint-recipe-rows fn2-checkpoint-recipe)))
       (let ((fn2-checkpoint-planning (fn2-checkpoint-planning-set-phase 0 *fn2-checkpoint-planning-phase-preview* fn2-checkpoint-planning)))
        (mv :done fn2-checkpoint-planning fn2-checkpoint-recipe)))
      ((unless (unsigned-byte-p 32 (+ i 1))) (mv :bounds fn2-checkpoint-planning fn2-checkpoint-recipe))
      (fn2-checkpoint-recipe (fn2-checkpoint-recipe-set-used i 0 fn2-checkpoint-recipe))
      (fn2-checkpoint-planning (fn2-checkpoint-planning-set-clear-row 0 (+ i 1) fn2-checkpoint-planning)))
  (mv :more fn2-checkpoint-planning fn2-checkpoint-recipe)))

(defun fn2-checkpoint-planning-preview (c token kind owner gen role ordinal intended page-kind level fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-checkpoint-recipe-wfp fn2-checkpoint-recipe) (fn2-checkpoint-recipe-order-wfp fn2-checkpoint-recipe-order)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (fn2-checkpoint-planning-ownerp c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents))
       (mv :owner 0 0 0 fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order))
      ((unless (and (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-preview*)
                    (natp role) (<= role 6) (unsigned-byte-p 60 ordinal)
                    (posp intended) (<= intended *fn2-storage-extent-bytes*)
                    (equal (mod intended *fn2-format-sector-size*) 0)
                    (unsigned-byte-p 8 page-kind) (natp level) (< level *fn2-run-max-levels*)
                    (equal (fn2-alloc-free-head fn2-extents) (fn2-checkpoint-planning-first-free 0 fn2-checkpoint-planning))
                    (equal (fn2-alloc-next-counter fn2-extents) (fn2-checkpoint-planning-first-counter 0 fn2-checkpoint-planning))))
       (mv :state 0 0 0 fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order))
      (n (fn2-checkpoint-planning-count 0 fn2-checkpoint-planning))
      (e (fn2-checkpoint-planning-next-free 0 fn2-checkpoint-planning))
      (epoch (fn2-checkpoint-planning-epoch 0 fn2-checkpoint-planning))
      (counter (+ (fn2-checkpoint-planning-first-counter 0 fn2-checkpoint-planning) n))
      ((unless (and (< n (fn2-checkpoint-recipe-order-rows fn2-checkpoint-recipe-order))
                    (< e (fn2-checkpoint-recipe-rows fn2-checkpoint-recipe))
                    (unsigned-byte-p 32 (+ n 1)) (fn2-alloc-slotp e fn2-extents)))
       (mv :no-space 0 0 0 fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order))
      ((unless (and (equal (fn2-alloc-epoch-begun fn2-extents) 1)
                    (unsigned-byte-p 60 (+ counter 1))))
       (mv :counter-exhausted 0 0 0 fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order))
      ((unless (and (equal (fn2-checkpoint-recipe-used e fn2-checkpoint-recipe) 0)
                    (equal (fn2-extents-state e fn2-extents) *fn2-extent-state-free*)
                    (fn2-alloc-link-statep (fn2-extents-next-free e fn2-extents) *fn2-extent-state-free* fn2-extents)))
       (mv :links 0 0 0 fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order))
      (next (fn2-extents-next-free e fn2-extents))
      (fn2-checkpoint-recipe (fn2-checkpoint-recipe-put e (used 1) (creation-index n) (extent e) (epoch epoch) (allocation counter) (next-free next)
       (role role) (ordinal ordinal) (intended intended) (kind page-kind) (level level) (sealed 0)))
      (fn2-checkpoint-recipe-order (fn2-checkpoint-recipe-order-set-extent n e fn2-checkpoint-recipe-order))
      (fn2-checkpoint-planning (fn2-checkpoint-planning-put 0 (next-free next) (count (+ n 1)))))
  (mv :ok e epoch counter fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order)))

; Record/check the actual sealed builder output. No physical-completed marker
; or B reservation is created by this sink. Parent promotion uses the same
; run-build-promote after this preview gate, retaining the actual seal hash.
(defun fn2-checkpoint-planning-seal (c token kind owner gen b level fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-metadata fn2-csnapshot fn2-extents fn2-run-builds fn2-run-writers fn2-digests)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-metadata fn2-csnapshot fn2-extents fn2-run-builds fn2-run-writers fn2-digests) :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-checkpoint-recipe-wfp fn2-checkpoint-recipe) (fn2-checkpoint-metadata-wfp fn2-checkpoint-metadata) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extents-wfp fn2-extents) (fn2-run-builds-wfp fn2-run-builds) (fn2-run-writers-wfp fn2-run-writers) (fn2-digests-wfp fn2-digests))))
 (b* (((unless (and (fn2-checkpoint-planning-ownerp c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents)
                    (fn2-checkpoint-metadata-writerp b level fn2-checkpoint-metadata fn2-csnapshot fn2-run-builds fn2-run-writers)))
       (mv :owner fn2-checkpoint-planning fn2-checkpoint-recipe))
      (phase (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning))
      (w (fn2-run-level-writer b level))
      (e (floor (fn2-run-writers-unit w fn2-run-writers) *fn2-storage-extent-units*))
      (h (+ (fn2-run-builds-hbase b fn2-run-builds) level))
      ((unless (and (member phase (list *fn2-checkpoint-planning-phase-preview* *fn2-checkpoint-planning-phase-materialize*))
                    (< e (fn2-checkpoint-recipe-rows fn2-checkpoint-recipe)) (fn2-digest-rowp h fn2-digests)
                    (equal (fn2-checkpoint-recipe-used e fn2-checkpoint-recipe) 1)
                    (equal (fn2-checkpoint-recipe-extent e fn2-checkpoint-recipe) e)
                    (equal (fn2-checkpoint-recipe-epoch e fn2-checkpoint-recipe) (fn2-run-writers-epoch w fn2-run-writers))
                    (equal (fn2-checkpoint-recipe-allocation e fn2-checkpoint-recipe) (fn2-run-writers-counter w fn2-run-writers))
                    (equal (fn2-checkpoint-recipe-kind e fn2-checkpoint-recipe) (fn2-run-writers-page-kind w fn2-run-writers))
                    (equal (fn2-checkpoint-recipe-level e fn2-checkpoint-recipe) level)))
       (mv :layout fn2-checkpoint-planning fn2-checkpoint-recipe))
      ((when (equal phase *fn2-checkpoint-planning-phase-materialize*))
       (mv (if (and (equal (fn2-checkpoint-recipe-sealed e fn2-checkpoint-recipe) 1)
                    (equal (fn2-checkpoint-recipe-cursor e fn2-checkpoint-recipe) (fn2-run-writers-cursor w fn2-run-writers))
                    (equal (fn2-checkpoint-recipe-entries e fn2-checkpoint-recipe) (fn2-run-writers-entries w fn2-run-writers))
                    (equal (fn2-checkpoint-recipe-restarts e fn2-checkpoint-recipe) (fn2-run-writers-restarts w fn2-run-writers))
                    (equal (fn2-checkpoint-recipe-word0 e fn2-checkpoint-recipe) (fn2-digest-word h 0 fn2-digests))
                    (equal (fn2-checkpoint-recipe-word1 e fn2-checkpoint-recipe) (fn2-digest-word h 1 fn2-digests))
                    (equal (fn2-checkpoint-recipe-word2 e fn2-checkpoint-recipe) (fn2-digest-word h 2 fn2-digests))
                    (equal (fn2-checkpoint-recipe-word3 e fn2-checkpoint-recipe) (fn2-digest-word h 3 fn2-digests))
                    (equal (fn2-checkpoint-recipe-word4 e fn2-checkpoint-recipe) (fn2-digest-word h 4 fn2-digests))
                    (equal (fn2-checkpoint-recipe-word5 e fn2-checkpoint-recipe) (fn2-digest-word h 5 fn2-digests))
                    (equal (fn2-checkpoint-recipe-word6 e fn2-checkpoint-recipe) (fn2-digest-word h 6 fn2-digests))
                    (equal (fn2-checkpoint-recipe-word7 e fn2-checkpoint-recipe) (fn2-digest-word h 7 fn2-digests))
                   ) :ok :layout) fn2-checkpoint-planning fn2-checkpoint-recipe))
      ((unless (and (equal (fn2-checkpoint-recipe-sealed e fn2-checkpoint-recipe) 0)
                    (< (fn2-checkpoint-planning-sealed 0 fn2-checkpoint-planning) (fn2-checkpoint-planning-count 0 fn2-checkpoint-planning))
                    (unsigned-byte-p 32 (+ 1 (fn2-checkpoint-planning-sealed 0 fn2-checkpoint-planning)))))
       (mv :state fn2-checkpoint-planning fn2-checkpoint-recipe))
      (fn2-checkpoint-recipe (fn2-checkpoint-recipe-put e (sealed 1)
       (cursor (fn2-run-writers-cursor w fn2-run-writers)) (entries (fn2-run-writers-entries w fn2-run-writers))
       (restarts (fn2-run-writers-restarts w fn2-run-writers))
       (word0 (fn2-digest-word h 0 fn2-digests))
       (word1 (fn2-digest-word h 1 fn2-digests))
       (word2 (fn2-digest-word h 2 fn2-digests))
       (word3 (fn2-digest-word h 3 fn2-digests))
       (word4 (fn2-digest-word h 4 fn2-digests))
       (word5 (fn2-digest-word h 5 fn2-digests))
       (word6 (fn2-digest-word h 6 fn2-digests))
       (word7 (fn2-digest-word h 7 fn2-digests))
      ))
      (fn2-checkpoint-planning (fn2-checkpoint-planning-set-sealed 0 (+ 1 (fn2-checkpoint-planning-sealed 0 fn2-checkpoint-planning)) fn2-checkpoint-planning)))
  (mv :ok fn2-checkpoint-planning fn2-checkpoint-recipe)))

; The second pass cannot start against a stale allocator frontier, and cannot
; run before every planned page was sealed by the actual builder.
(defun fn2-checkpoint-planning-materialize (c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-csnapshot fn2-extents)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (fn2-checkpoint-planning-ownerp c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents))
       (mv :owner fn2-checkpoint-planning))
      ((unless (and (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-preview*)
                    (equal (fn2-checkpoint-planning-sealed 0 fn2-checkpoint-planning) (fn2-checkpoint-planning-count 0 fn2-checkpoint-planning))
                    (equal (fn2-checkpoint-planning-reserved 0 fn2-checkpoint-planning) 0)
                    (equal (fn2-alloc-free-head fn2-extents) (fn2-checkpoint-planning-first-free 0 fn2-checkpoint-planning))
                    (equal (fn2-alloc-next-counter fn2-extents) (fn2-checkpoint-planning-first-counter 0 fn2-checkpoint-planning))))
       (mv :state fn2-checkpoint-planning))
      (fn2-checkpoint-planning (fn2-checkpoint-planning-put 0 (phase *fn2-checkpoint-planning-phase-materialize*) (position 0))))
  (mv :ok fn2-checkpoint-planning)))

; Read-only exact identity provider. The caller next invokes B's exact-owner
; shared reservation transition and retains that result in construction.
(defun fn2-checkpoint-planning-next (c token kind owner gen role ordinal intended page-kind level fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-checkpoint-recipe-wfp fn2-checkpoint-recipe)
              (fn2-checkpoint-recipe-order-wfp fn2-checkpoint-recipe-order) (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (and (fn2-checkpoint-planning-ownerp c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents)
                    (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-materialize*)))
       (mv :owner 0 0 0))
      (p (fn2-checkpoint-planning-position 0 fn2-checkpoint-planning))
      ((unless (and (< p (fn2-checkpoint-planning-count 0 fn2-checkpoint-planning))
                    (< p (fn2-checkpoint-recipe-order-rows fn2-checkpoint-recipe-order)))) (mv :layout 0 0 0))
      (e (fn2-checkpoint-recipe-order-extent p fn2-checkpoint-recipe-order))
      ((unless (and (< e (fn2-checkpoint-recipe-rows fn2-checkpoint-recipe)) (fn2-alloc-slotp e fn2-extents))) (mv :layout 0 0 0))
      (epoch (fn2-checkpoint-recipe-epoch e fn2-checkpoint-recipe))
      (allocation (fn2-checkpoint-recipe-allocation e fn2-checkpoint-recipe))
      ((unless (and (equal (fn2-checkpoint-recipe-used e fn2-checkpoint-recipe) 1)
                    (equal (fn2-checkpoint-recipe-creation-index e fn2-checkpoint-recipe) p)
                    (equal (fn2-checkpoint-recipe-sealed e fn2-checkpoint-recipe) 1)
                    (equal role (fn2-checkpoint-recipe-role e fn2-checkpoint-recipe))
                    (equal ordinal (fn2-checkpoint-recipe-ordinal e fn2-checkpoint-recipe))
                    (equal intended (fn2-checkpoint-recipe-intended e fn2-checkpoint-recipe))
                    (equal page-kind (fn2-checkpoint-recipe-kind e fn2-checkpoint-recipe))
                    (equal level (fn2-checkpoint-recipe-level e fn2-checkpoint-recipe))
                    (equal e (fn2-alloc-free-head fn2-extents))
                    (equal epoch (fn2-alloc-current-epoch fn2-extents))
                    (equal allocation (fn2-alloc-next-counter fn2-extents)))) (mv :layout 0 0 0)))
  (mv :ok e epoch allocation)))

; Advance only after the real exact identity is retained in the construction
; ledger. A failed/mismatched reserve never consumes the recipe cursor.
(defun fn2-checkpoint-planning-note-reserved (c token kind owner gen e epoch allocation fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-checkpoint-construction fn2-csnapshot fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-checkpoint-construction fn2-csnapshot fn2-extents)
  :guard (and (fn2-checkpoint-planning-wfp fn2-checkpoint-planning) (fn2-checkpoint-recipe-wfp fn2-checkpoint-recipe)
              (fn2-checkpoint-recipe-order-wfp fn2-checkpoint-recipe-order) (fn2-checkpoint-construction-wfp fn2-checkpoint-construction)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (and (fn2-checkpoint-planning-ownerp c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents)
                    (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-materialize*)))
       (mv :owner fn2-checkpoint-planning))
      (p (fn2-checkpoint-planning-position 0 fn2-checkpoint-planning))
      ((unless (and (natp e) (< e (fn2-checkpoint-recipe-rows fn2-checkpoint-recipe))
                    (< e (fn2-checkpoint-construction-rows fn2-checkpoint-construction)) (fn2-alloc-slotp e fn2-extents)
                    (< p (fn2-checkpoint-planning-count 0 fn2-checkpoint-planning))
                    (< p (fn2-checkpoint-recipe-order-rows fn2-checkpoint-recipe-order))
                    (equal e (fn2-checkpoint-recipe-order-extent p fn2-checkpoint-recipe-order))
                    (equal epoch (fn2-checkpoint-recipe-epoch e fn2-checkpoint-recipe))
                    (equal allocation (fn2-checkpoint-recipe-allocation e fn2-checkpoint-recipe))
                    (equal (fn2-checkpoint-construction-live e fn2-checkpoint-construction) 1)
                    (equal token (fn2-checkpoint-construction-token e fn2-checkpoint-construction))
                    (equal kind (fn2-checkpoint-construction-owner-kind e fn2-checkpoint-construction))
                    (equal owner (fn2-checkpoint-construction-owner-slot e fn2-checkpoint-construction))
                    (equal gen (fn2-checkpoint-construction-owner-gen e fn2-checkpoint-construction))
                    (equal epoch (fn2-checkpoint-construction-epoch e fn2-checkpoint-construction))
                    (equal allocation (fn2-checkpoint-construction-counter e fn2-checkpoint-construction))
                    (equal (fn2-extents-state e fn2-extents) *fn2-extent-state-reserved*)
                    (equal epoch (fn2-extents-epoch e fn2-extents)) (equal allocation (fn2-extents-counter e fn2-extents))
                    (equal (fn2-alloc-free-head fn2-extents) (fn2-checkpoint-recipe-next-free e fn2-checkpoint-recipe))
                    (equal (fn2-alloc-next-counter fn2-extents) (+ allocation 1))
                    (unsigned-byte-p 32 (+ p 1))
                    (unsigned-byte-p 32 (+ 1 (fn2-checkpoint-planning-reserved 0 fn2-checkpoint-planning)))))
       (mv :uncertain fn2-checkpoint-planning))
      (fn2-checkpoint-planning (fn2-checkpoint-planning-put 0 (position (+ p 1))
       (reserved (+ 1 (fn2-checkpoint-planning-reserved 0 fn2-checkpoint-planning))))))
  (mv :ok fn2-checkpoint-planning)))

(fn2-checkpoint-planning-preserves fn2-checkpoint-planning-bind
 (c token kind owner gen fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-build fn2-csnapshot fn2-extents) :position 1)
(fn2-checkpoint-planning-preserves fn2-checkpoint-planning-clear-step
 (c token kind owner gen fn2-checkpoint-planning fn2-checkpoint-recipe fn2-csnapshot fn2-extents)
 :carriers ((fn2-checkpoint-planning 1 :prefix "-PLANNING") (fn2-checkpoint-recipe 2 :prefix "-RECIPE")))
(fn2-checkpoint-planning-preserves fn2-checkpoint-planning-preview
 (c token kind owner gen role ordinal intended page-kind level fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents)
 :carriers ((fn2-checkpoint-planning 4 :prefix "-PLANNING") (fn2-checkpoint-recipe 5 :prefix "-RECIPE") (fn2-checkpoint-recipe-order 6 :prefix "-ORDER")))
(fn2-checkpoint-planning-preserves fn2-checkpoint-planning-seal
 (c token kind owner gen b level fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-metadata fn2-csnapshot fn2-extents fn2-run-builds fn2-run-writers fn2-digests)
 :carriers ((fn2-checkpoint-planning 1 :prefix "-PLANNING") (fn2-checkpoint-recipe 2 :prefix "-RECIPE")))
(fn2-checkpoint-planning-preserves fn2-checkpoint-planning-materialize
 (c token kind owner gen fn2-checkpoint-planning fn2-csnapshot fn2-extents) :position 1)
(fn2-checkpoint-planning-preserves fn2-checkpoint-planning-note-reserved
 (c token kind owner gen e epoch allocation fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-checkpoint-construction fn2-csnapshot fn2-extents) :position 1)

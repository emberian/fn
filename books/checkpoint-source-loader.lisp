  (and (equal (fn2-checkpoint-windows-live i fn2-checkpoint-windows) 1)
       (or (equal i *fn2-checkpoint-source-page-window*) (equal i *fn2-checkpoint-source-read-window*)
           (and (not (equal (fn2-checkpoint-windows-slot i fn2-checkpoint-windows)
                            (fn2-checkpoint-windows-slot *fn2-checkpoint-source-page-window* fn2-checkpoint-windows)))
                (not (equal (fn2-checkpoint-windows-slot i fn2-checkpoint-windows)
                            (fn2-checkpoint-windows-slot *fn2-checkpoint-source-read-window* fn2-checkpoint-windows)))))
       (fn2-checkpoint-source-reader-isolatedp (+ i 1) fn2-checkpoint-windows))))


; Bounded RFC9171 section4.3.1 primary framing over retained source.
; Structural framing only: spans are not endpoint validity, CRC verification,
; immutable backing authority, security evidence or application acceptance.
(in-package "ACL2")
(include-book "bpsec-head")
(set-verify-guards-eagerness 0)
; Fixed cursor:tag,phase,source,total,at,start,head,tasks,remaining,array,
; flags,crc,metadata. Task spine has bounded grammar depth, never body bytes.
(defun fn-bpwp-start (source total at)
 (declare (xargs :guard t))
 (list :bp-primary-framing
  (if (and (fn-bps-uintp total) (fn-bps-uintp at) (<= at total)) :head :refused)
  source total at at (fn-bps-head-start) '(:array) 0 0 0 0 nil))
(defun fn-bpwp-next (c phase at head tasks left array flags crc metadata)
 (declare (xargs :guard t))
 (list :bp-primary-framing phase (fn-bps-field 2 c) (fn-bps-field 3 c)
       at (fn-bps-field 5 c) head tasks left array flags crc metadata))
(defun fn-bpwp-finish-head (c at tasks array flags crc metadata)
 (declare (xargs :guard t))
 (let ((next (fn-bpwp-next c (if (consp tasks) :head :done) at
                         (fn-bps-head-start) tasks 0 array flags crc metadata)))
  (if (consp tasks) (mv :yield next nil)
   (mv :complete next
    (list :bp-primary-source (fn-bps-field 2 c) (fn-bps-field 5 c) at
          flags crc metadata)))))
(defun fn-bpwp-refused (c)
 (declare (xargs :guard t))
 (fn-bpwp-next c :refused (fn-bps-field 4 c) (fn-bps-field 6 c)
              (fn-bps-field 7 c) (fn-bps-field 8 c) (fn-bps-field 9 c)
              (fn-bps-field 10 c) (fn-bps-field 11 c) (fn-bps-field 12 c)))
(defun fn-bpwp-feed (c octet)
 (declare (xargs :guard t))
 (let* ((phase (fn-bps-field 1 c)) (at (fn-bps-field 4 c))
        (total (fn-bps-field 3 c)) (tasks (fn-bps-field 7 c))
        (left (fn-bps-field 8 c)) (array (fn-bps-field 9 c))
        (flags (fn-bps-field 10 c)) (crc (fn-bps-field 11 c))
        (metadata (fn-bps-field 12 c)))
  (cond
   ((eq phase :done) (mv :complete c nil))
   ((or (eq phase :refused) (not (fn-cbor-octetp octet))
        (not (fn-bps-uintp at)) (not (fn-bps-uintp total)) (<= total at))
    (mv :refused (fn-bpwp-next c :refused at (fn-bps-field 6 c)
                              tasks left array flags crc metadata) nil))
   ((eq phase :body)
    (if (not (and (natp left) (< 0 left))) (mv :refused (fn-bpwp-refused c) nil)
     (if (equal left 1)
      (fn-bpwp-finish-head c (1+ at) tasks array flags crc metadata)
      (mv :yield (fn-bpwp-next c :body (1+ at) (fn-bps-head-start)
                       tasks (1- left) array flags crc metadata) nil))))
   (t
    (let* ((answer (fn-bps-head-feed (fn-bps-field 6 c) octet))
           (word (car answer)) (pair (cadr answer)) (head (caddr answer))
           (major (fn-cbor-ag-car pair)) (value (fn-cbor-ag-car (fn-cbor-ag-cdr pair)))
           (task (fn-cbor-ag-car tasks)) (rest (fn-cbor-ag-cdr tasks))
           (next-at (1+ at)))
     (cond
      ((eq word :more)
       (mv :yield (fn-bpwp-next c :head next-at head tasks 0 array flags crc metadata) nil))
      ((not (eq word :ready))
       (mv :refused (fn-bpwp-next c :refused next-at head tasks 0 array flags crc metadata) nil))
      ((eq task :array)
       (if (and (equal major 4) (member-equal value '(8 9 10 11)))
        (fn-bpwp-finish-head c next-at
         '(:version :flags :crc :destination :source :report :stamp :lifetime)
         value flags crc metadata)
        (mv :refused (fn-bpwp-refused c) nil)))
      ((member-equal task '(:destination :source :report :stamp :ipn-array))
       (if (and (equal major 4) (equal value 2))
        (fn-bpwp-finish-head c next-at
         (append (cond ((eq task :stamp) '(:creation :sequence))
                       ((eq task :ipn-array) '(:node :service))
                       (t '(:scheme))) rest)
         array flags crc metadata)
        (mv :refused (fn-bpwp-refused c) nil)))
      ((eq task :scheme)
       (if (and (equal major 0) (member-equal value '(1 2)))
        (fn-bpwp-finish-head c next-at
         (cons (if (equal value 1) :dtn-ssp :ipn-array) rest)
         array flags crc (cons (list :scheme value) metadata))
        (mv :refused (fn-bpwp-refused c) nil)))
      ((or (eq task :dtn-ssp) (eq task :crc-bytes))
       (cond
        ((and (eq task :dtn-ssp) (equal major 0) (equal value 0))
         (fn-bpwp-finish-head c next-at rest array flags crc (cons '(:dtn-none) metadata)))
        ((and (equal major (if (eq task :dtn-ssp) 3 2))
              (natp value) (<= value (- total next-at))
              (or (eq task :dtn-ssp) (equal value (if (equal crc 1) 2 4))))
         (let ((m (cons (list task :bps-span (fn-bps-field 2 c) next-at value) metadata)))
          (if (equal value 0) (fn-bpwp-finish-head c next-at rest array flags crc m)
           (mv :yield (fn-bpwp-next c :body next-at (fn-bps-head-start)
                                     rest value array flags crc m) nil))))
        (t (mv :refused (fn-bpwp-refused c) nil))))
      ((not (equal major 0)) (mv :refused (fn-bpwp-refused c) nil))
      ((eq task :version)
       (if (equal value 7) (fn-bpwp-finish-head c next-at rest array flags crc metadata)
        (mv :refused (fn-bpwp-refused c) nil)))
      ((eq task :flags) (fn-bpwp-finish-head c next-at rest array value crc metadata))
      ((eq task :crc)
       (let ((fragment (equal (mod flags 2) 1)))
        (if (and (member-equal value '(0 1 2))
                 (equal array (+ 8 (if fragment 2 0) (if (equal value 0) 0 1))))
         (fn-bpwp-finish-head c next-at
          (append rest (if fragment '(:fragment-offset :total-adu) nil)
                       (if (equal value 0) nil '(:crc-bytes)))
          array flags value metadata)
         (mv :refused (fn-bpwp-refused c) nil))))
      ((member-equal task '(:creation :sequence :lifetime :node :service :fragment-offset :total-adu))
       (fn-bpwp-finish-head c next-at rest array flags crc (cons (list task value) metadata)))
      (t (mv :refused (fn-bpwp-refused c) nil))))))))
(defun fn-bpwp-window-loop (cursor bytes quantum used)
 (declare (xargs :guard (and (natp quantum) (<= quantum 64) (natp used))
                 :measure (nfix quantum) :verify-guards nil))
 (cond ((eq (fn-bps-field 1 cursor) :done) (mv :complete cursor used bytes nil))
       ((eq (fn-bps-field 1 cursor) :refused) (mv :refused cursor used bytes nil))
       ((or (zp quantum) (atom bytes)) (mv :yield cursor used bytes nil))
       (t (mv-let (word next event) (fn-bpwp-feed cursor (car bytes))
        (if (eq word :yield)
         (fn-bpwp-window-loop next (cdr bytes) (1- quantum) (1+ used))
         (mv word next (1+ used) (cdr bytes) event))))))

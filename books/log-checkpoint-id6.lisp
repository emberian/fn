; Frozen ID-6 candidate allocation observers, moved verbatim under the M1/M2 ruling.
(in-package "ACL2")
(include-book "log-checkpoint-cold-selector")

(defun fn-lc-candidate-next-id-view (rec pages)
 (declare (xargs :guard t :verify-guards nil))
 (if (not (pgs-rec-valid rec)) (list nil 0 nil)
  (let* ((txid (pgs-rec-txid rec))
         (directory (pgs-lookup (pgs-rec-dir-addr rec) pages)))
   (if (or (pgs-dir-verdict rec directory (pgs-digest directory))
           (ec-call (pgs-check-pages directory txid :eager pages 0 :table-damaged)))
       (list nil 0 nil)
    (let* ((cs (ec-call (pgs-contents directory pages)))
           (table (pgs-flatten cs)))
     (if (or (ec-call (pgs-tables-verdict cs (pgs-rec-npages rec) txid 0))
             (not (consp table)))
         (list nil 0 nil)
      (let* ((entry (fn-lc-head table))
             (header (pgs-lookup (fn-lc-head entry) pages)))
       (if (or (ec-call (pgs-check-pages (list entry) txid :eager pages 0 :page-damaged))
               (not (fn-lc-headerp header)))
           (list nil 0 nil)
        (list t (fn-lc-header-next-id header) (fn-lc-header-exhaustedp header))))))))))

(defun fn-lc-examined-records-order (order slots pages)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp order)
  (let ((rec (pgs-slot (car order) slots)))
   (if (equal (fn-lc-head (fn-lc-head (fn-lc-cold-candidate rec pages))) :ok)
       (list rec)
     (cons rec (fn-lc-examined-records-order (cdr order) slots pages))))
  nil))

(defun fn-lc-examined-records (disk r)
 (declare (xargs :guard t :verify-guards nil))
 (fn-lc-examined-records-order (fn-lc-cold-root-order disk r)
                               (pgs-root-slots r disk) (pgs-pages disk)))

(defun fn-lc-records-next-ids-known-p (recs pages)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp recs)
  (and (fn-lc-head (fn-lc-candidate-next-id-view (car recs) pages))
       (fn-lc-records-next-ids-known-p (cdr recs) pages))
  t))

(defun fn-lc-records-max-next-id (recs pages)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp recs)
  (max (nfix (fn-lc-at 1 (fn-lc-candidate-next-id-view (car recs) pages)))
       (fn-lc-records-max-next-id (cdr recs) pages))
  0))

(defun fn-lc-records-any-exhausted-p (recs pages)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp recs)
  (or (and (fn-lc-at 2 (fn-lc-candidate-next-id-view (car recs) pages)) t)
      (fn-lc-records-any-exhausted-p (cdr recs) pages))
  nil))

(verify-guards fn-lc-candidate-next-id-view)
(verify-guards fn-lc-examined-records-order)
(verify-guards fn-lc-examined-records)
(verify-guards fn-lc-records-next-ids-known-p)
(verify-guards fn-lc-records-max-next-id)
(verify-guards fn-lc-records-any-exhausted-p)

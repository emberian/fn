                      (rc-role (- role 1)) (rc-filled 0) (rc-stage 0))))
     (fn2-machine-result 4096 *fn2-work-stage* 0 t fn2-core)))
   ((and discover (or (eq code :empty) (eq code :invalid) (eq code :candidate)))
    (let ((ce (fn2-recovery-cand-epoch p fn2-core)))

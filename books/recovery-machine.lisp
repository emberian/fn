     (if (not (and (eq code :ok) (natp end) (<= next end))) (mv :invalid fn2-core)
      (b* (((mv ok first last & & & &) (fn2-recovery-seal-fields p commit epoch allocation fn2-core)))
       (if (not ok) (mv :invalid fn2-core)
        (b* (((mv b fn2-core) (fn2-recovery-cand-put p *fn2-rec-status-unread* commit epoch allocation
                                first last next (- end next) fn2-core)))

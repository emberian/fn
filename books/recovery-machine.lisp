 (stobj-let ((fn2-sched (fn2-core-sched fn2-core))) (code fn2-sched)
  (fn2-sched-make-runnable id 0 fn2-sched)
  (mv code fn2-core)))
(fn2-core-preserves fn2-recovery-ready (id fn2-core) :position 1 :rows nil)

; Start over a freshly initialized core: assumption bits and the presented
; witness commit (0: none). The genesis predecessor seal is the zero digest.
; Start is the host's call, outside the arms (as fn2-scribe-start): it takes
; the recovery bundle (ROUND2 §B.3: one window, held to :done).
(defun fn2-recovery-start (id assume witness fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (b* (((unless (fn2-recovery-idp id fn2-core)) (mv :admission fn2-core))
      ((mv arena base fits) (fn2-recovery-geometry fn2-core))
      ((unless (and fits (equal (fn2-machine-phase id fn2-core) *fn2-recovery-machine-state-free*)
                    (unsigned-byte-p 8 assume) (unsigned-byte-p 60 witness)))
       (mv :admission fn2-core))
      (gen (fn2-machine-generation id fn2-core))
      ((mv code slot sgen fn2-core)
       (fn2-core-reserve (fn2-scribe-window-class fn2-core) *fn2-recovery-machine-kind* id gen fn2-core))
      ((unless (and (eq code :ok) (unsigned-byte-p 32 slot) (unsigned-byte-p 60 sgen)))
       (mv (if (eq code :ok) :bounds code) fn2-core))
      ;; M7's replay rebuilds each member's workspace beside the window
      ((mv code wslot wgen fn2-core)
       (fn2-core-reserve (fn2-scribe-window-class fn2-core) *fn2-recovery-machine-kind* id gen fn2-core))
      ((unless (and (eq code :ok) (unsigned-byte-p 32 wslot) (unsigned-byte-p 60 wgen)))
       (let ((fn2-core (fn2-core-stop *fn2-stop-reason-recovery-bounds* fn2-core))) (mv :bounds fn2-core)))
      ((mv zcode fn2-core) (fn2-recovery-zero-row (fn2-rec-chain-row base arena) fn2-core))
      ((unless (eq zcode :ok))
       (let ((fn2-core (fn2-core-stop *fn2-stop-reason-recovery-bounds* fn2-core))) (mv :bounds fn2-core)))
      (fn2-core (fn2-recovery-machine-put-core id (phase *fn2-recovery-machine-state-read*)
        (pool-slot slot) (pool-gen sgen) (pending 0) (stopped 0)
        (rc-mode *fn2-rec-mode-discover*) (rc-pos 0) (rc-role 2) (rc-stage 0) (rc-filled 0)
        (rc-ready 0) (rc-outcome 0) (rc-count 0) (rc-chain 0) (rc-arena arena) (rc-high 0)
        (rc-dirty 0) (rc-ambiguous 0) (rc-class *fn2-rec-class-none*) (rc-witness witness)
        (rc-witness-outcome *fn2-rec-witness-none*) (rc-assume assume) (rc-epoch 0)
        (rc-found *fn2-alloc-none*) (rc-commit 0) (rc-roff 0) (rc-rend 0) (rc-mpos 0) (rc-munit 0)
        (rc-munits 0) (rc-mtotal 0) (rc-mevent 0) (principal-slot 0)
        (rc-wslot wslot) (rc-wgen wgen) (rc-wlen 0) (rc-wevent 0) (rc-wmembers 0) (rc-replayed 0)))
      ((mv rcode fn2-core) (fn2-recovery-ready id fn2-core))
      ((unless (member-eq rcode '(:ok :already)))
       (let ((fn2-core (fn2-core-stop *fn2-stop-reason-recovery-bounds* fn2-core))) (mv :bounds fn2-core))))
  (mv :ok fn2-core)))
(fn2-core-preserves fn2-recovery-start (id assume witness fn2-core) :position 1 :rows nil)
; The kind's id fact stays in its own sections (as commit's, D26).
(in-theory (disable fn2-recovery-idp-kind-value))
)))
(defun fn2-recovery-event-forms-3 ()
 (list 'progn (fn2-recovery-local-theory) '(progn
(local (in-theory (enable fn2-recovery-idp-kind-value)))
(defmachine-arms fn2-recovery-machine)
(defmachine-run fn2-recovery-machine)
)))
(defmacro fn2-recovery-events () (fn2-recovery-event-forms))
(defmacro fn2-recovery-events-3 () (fn2-recovery-event-forms-3))


; ----------------------------------------------------------------------
; The arms, in the arm language; their contracts are derived where the core
; exists (fn2-recovery-events-3, assembly-callbacks.lisp). A refused bound
; stops the core with :recovery-bounds (each arm's :on-refusal); a refused
; release of the recovery window with :recovery-release.
(defmachine-arms fn2-recovery-machine :declare
 :subarms
 (;; The payload pass (b-durability.md S9a), after the chain search: every
  ;; chained commit's records unit is read and its record stream walked one
  ;; record per step; an article row's location is claimed for the article
  ;; (its raw source's extent, or its source manifest's extent and then,
  ;; one manifest unit per step, the extent of each block at unit 0 of its
  ;; extent), so adoption allocates it with its recorded identity. A record
  ;; or manifest the pass cannot decode, or a claim on a position that is
  ;; not plain written data, is ambiguity.
  (payload-begin :on-refusal ((:stop :recovery-bounds))
   (:if (< 0 row-rc-chain)
        ((:do (pcode p) (fn2-recovery-commit-extent 1) :accept (:ok))
         (:set (rc-mode *fn2-rec-mode-payload*) (rc-commit 1) (rc-pos p) (rc-role 1) (rc-roff 0) (rc-rend 0)
               (rc-munits 0) (rc-filled 0) (rc-stage 0) (rc-ready 0))
         (:next :read) (:charge :steps *fn2-work-advance* :runnable t))
        ((:set (rc-stage 0) (rc-found 0) (rc-ready 0))
         (:next :install) (:charge :steps *fn2-work-advance* :runnable t))))
  (payload-ambiguous
   (:set (rc-ambiguous 1) (rc-stage 0) (rc-found 0) (rc-ready 0))
   (:next :install) (:charge :steps *fn2-work-advance* :runnable t))
  ;; the next chained commit's records, or the install
  (payload-next :on-refusal ((:stop :recovery-bounds))
   (:if (< row-rc-commit row-rc-chain)
        ((:do (pcode p) (fn2-recovery-commit-extent (+ 1 row-rc-commit)) :accept (:ok))
         (:set (rc-commit (+ 1 row-rc-commit)) (rc-pos p) (rc-role 1) (rc-roff 0) (rc-rend 0)
               (rc-filled 0) (rc-stage 0) (rc-ready 0))
         (:next :read) (:charge :steps *fn2-work-advance* :runnable t))
        ((:set (rc-stage 0) (rc-found 0) (rc-ready 0))
         (:next :install) (:charge :steps *fn2-work-advance* :runnable t))))
  (payload-open :on-refusal ((:stop :recovery-bounds))
   (:do (code roff rend) (fn2-recovery-records-open row-rc-pos row-rc-commit row-pool-slot row-pool-gen id row-generation)
    :accept ()
    :case (((:ok) (:set (rc-roff roff) (rc-rend rend)) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
           ((:invalid) (:goto payload-ambiguous)))))
  (payload-record :on-refusal ((:stop :recovery-bounds))
   (:do (code next unit epoch alloc bytes ev)
        (fn2-recovery-record-next row-rc-roff row-rc-rend row-pool-slot row-pool-gen id row-generation)
    :accept ()
    :case (((:end) (:goto payload-next))
           ((:other) (:set (rc-roff next)) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
           ((:raw :manifest)
            (:do (ccode hi) (fn2-recovery-claim-article unit epoch alloc ev row-rc-commit)
             :accept ()
             :case (((:ok)
                     (:if (eq code :manifest)
                          ;; follow the manifest from its unit 0; the records
                          ;; unit is read again after it
                          ((:set (rc-roff next) (rc-high (max row-rc-high hi)) (rc-epoch (max row-rc-epoch epoch))
                                 (rc-mpos (- hi 1)) (rc-munit 0) (rc-munits (fn2-am-units bytes)) (rc-mtotal bytes)
                                 (rc-mevent ev) (rc-pos (- hi 1)) (rc-role 0) (rc-filled 0) (rc-stage 0) (rc-ready 0))
                           (:next :read) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
                          ((:if (eq code :raw)
                                ((:set (rc-roff next) (rc-high (max row-rc-high hi)) (rc-epoch (max row-rc-epoch epoch)))
                                 (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
                                ((:goto payload-ambiguous))))))
                    ((:conflict :invalid) (:goto payload-ambiguous))
                    ((:bounds) (:stop :recovery-bounds)))))
           ((:invalid) (:goto payload-ambiguous))
           ((:bounds) (:stop :recovery-bounds)))))
  ;; one unit of the followed manifest's entries; then its next unit, or the
  ;; records unit again
  (payload-manifest :on-refusal ((:stop :recovery-bounds))
   (:do (code hi ep) (fn2-recovery-manifest-unit row-rc-munit row-rc-mtotal row-rc-mevent row-rc-commit
                                                  row-pool-slot row-pool-gen id row-generation)
    :accept ()
    :case (((:more)
            (:if (< (+ 1 row-rc-munit) row-rc-munits)
                 ((:set (rc-high (max row-rc-high hi)) (rc-epoch (max row-rc-epoch ep))
                        (rc-munit (+ 1 row-rc-munit)) (rc-role (+ 1 row-rc-munit)) (rc-filled 0) (rc-stage 0) (rc-ready 0))
                  (:next :read) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
                 ((:goto payload-ambiguous))))
           ((:done)
            (:do (pcode p) (fn2-recovery-commit-extent row-rc-commit) :accept (:ok))
            (:set (rc-high (max row-rc-high hi)) (rc-epoch (max row-rc-epoch ep))
                  (rc-munits 0) (rc-pos p) (rc-role 1) (rc-filled 0) (rc-stage 0) (rc-ready 0))
            (:next :read) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
           ((:conflict :invalid) (:goto payload-ambiguous))
           ((:bounds) (:stop :recovery-bounds)))))
  ;; :install stage 0: scan 32 candidate rows past the chain for anything dirty
  (install-scan
   (:do (next found) (fn2-recovery-dirty-scan row-rc-found row-rc-high (equal row-rc-dirty 1)))
   (:set (rc-found next) (rc-dirty (if found 1 0)) (rc-stage (if (< next row-rc-high) 0 1)))
   (:charge :steps *fn2-work-advance* :runnable t))
  ;; stage 1: the witness and the class; only :intact and :torn-tail adopt,
  ;; any other class releases the bundle and ends at :done
  (install-classify :on-refusal ((:stop :recovery-bounds))
   (:do (code matches) (fn2-recovery-witness-match row-rc-witness row-rc-chain row-rc-arena))
   (:let wout (fn2-rec-witness-outcome row-rc-assume row-rc-witness row-rc-chain matches))
   (:let rclass (fn2-rec-classify row-rc-assume (equal row-rc-dirty 1) (equal row-rc-ambiguous 1) wout))
   (:if (or (equal rclass *fn2-rec-class-intact*) (equal rclass *fn2-rec-class-torn-tail*))
        ((:set (rc-class rclass) (rc-witness-outcome wout) (rc-stage 2) (rc-found 0))
         (:charge :steps *fn2-work-advance* :runnable t))
        ((:do (wcode) (fn2-recovery-release-workspace row-rc-wslot row-rc-wgen id row-generation) :accept (:ok :retired)
          :why ":retired: the workspace's slot reached its generation limit and leaves the pool")
         (:do (rcode) (fn2-core-release row-pool-slot row-pool-gen)
          :effects ((:release (:storage-window :storage-job)))
          :accept ()
          :case (((:ok :retired)
                  (:set (rc-class rclass) (rc-witness-outcome wout) (stopped 1))
                  (:next :done) (:charge :steps *fn2-work-advance*))
                 (:otherwise (:stop :recovery-release)))))))
  ;; stage 2 below the high water: adopt one arena position
  (install-adopt :on-refusal ((:stop :recovery-bounds))
   (:do (code) (fn2-recovery-adopt row-rc-found))
   (:set (rc-found (+ 1 row-rc-found)))
   (:charge :steps *fn2-work-advance* :runnable t))
  ;; the recovery bundle released: the workspace, then the window
  (replay-release
   (:do (wcode) (fn2-recovery-release-workspace row-rc-wslot row-rc-wgen id row-generation) :accept ()
    :case (((:ok :retired)
            (:do (rcode) (fn2-core-release row-pool-slot row-pool-gen)
             :effects ((:release (:storage-window :storage-job)))
             :accept ()
             :case (((:ok :retired) (:set (stopped 1)) (:next :done) (:charge :steps *fn2-work-transition*))
                    (:otherwise (:stop :recovery-release)))))
           (:otherwise (:stop :recovery-release)))))
  ;; stage 2 at the high water: the frontier and the writer epoch, then the
  ;; replay of every chained commit's members (M7)
  (install-finish :on-refusal ((:stop :recovery-bounds))
   (:do (code) (fn2-recovery-finish row-rc-chain row-rc-epoch))
   (:if (< 0 row-rc-chain)
        ((:do (pcode p) (fn2-recovery-commit-extent 1) :accept (:ok))
         (:set (rc-mode *fn2-rec-mode-replay*) (rc-commit 1) (rc-pos p) (rc-role 1) (rc-roff 0) (rc-rend 0)
               (rc-wlen 0) (rc-wevent 0) (rc-wmembers 0) (rc-filled 0) (rc-stage 0) (rc-ready 0))
         (:next :read) (:charge :steps *fn2-work-advance* :runnable t))
        ((:goto replay-release))))
  ;; M7's replay (b-durability.md M7): classification is done and the
  ;; allocator installed; every chained commit's records unit is read again
  ;; and its stream walked one record per step, each transaction member's
  ;; records rebuilt into the workspace as admission took them and handed to
  ;; C's fn2-member-replay in member order, then the commit's batch
  ;; published (fn2-successor-publish). A hook's refusal stops the core
  ;; :recovery-replay after the replayed prefix; keyed members replay nothing.
  (replay-open :on-refusal ((:stop :recovery-bounds))
   (:do (code roff rend) (fn2-recovery-records-open row-rc-pos row-rc-commit row-pool-slot row-pool-gen id row-generation)
    :accept ()
    :case (((:ok) (:set (rc-roff roff) (rc-rend rend)) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
           ((:invalid) (:stop :recovery-replay)))))
  ;; stage 1: the workspace's member to C, in member order
  (replay-flush :on-refusal ((:stop :recovery-replay))
   (:do (code) (fn2-member-replay row-rc-commit row-rc-wevent row-rc-wslot row-rc-wgen row-rc-wlen) :accept (:ok))
   (:set (rc-wlen 0) (rc-wevent 0) (rc-wmembers (+ 1 row-rc-wmembers)) (rc-replayed 1) (rc-stage 0))
   (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
  ;; stage 2, the stream's end: its last member (one step), then the
  ;; batch's publish and the next chained commit's records, or the replay's
  ;; end (one call ending it, when anything was replayed)
  (replay-commit-end :on-refusal ((:stop :recovery-replay))
   (:if (< 0 row-rc-wlen)
        ((:do (code) (fn2-member-replay row-rc-commit row-rc-wevent row-rc-wslot row-rc-wgen row-rc-wlen) :accept (:ok))
         (:set (rc-wlen 0) (rc-wevent 0) (rc-wmembers (+ 1 row-rc-wmembers)) (rc-replayed 1))
         (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
        ((:do (pcode) (fn2-successor-publish row-rc-commit) :when (< 0 row-rc-wmembers) :else (:ok) :accept (:ok))
         (:if (< row-rc-commit row-rc-chain)
              ((:do (xcode p) (fn2-recovery-commit-extent (+ 1 row-rc-commit)) :accept (:ok))
               (:set (rc-commit (+ 1 row-rc-commit)) (rc-pos p) (rc-role 1) (rc-roff 0) (rc-rend 0)
                     (rc-wlen 0) (rc-wevent 0) (rc-wmembers 0) (rc-filled 0) (rc-stage 0) (rc-ready 0))
               (:next :read) (:charge :steps *fn2-work-advance* :runnable t))
              ((:do (ecode) (fn2-member-replay 0 0 row-rc-wslot row-rc-wgen 0)
                :when (equal row-rc-replayed 1) :else (:ok) :accept (:ok))
               (:goto replay-release))))))
  (replay-record :on-refusal ((:stop :recovery-bounds))
   (:do (code next wlen ev)
        (fn2-recovery-replay-record row-rc-roff row-rc-rend row-rc-wslot row-rc-wgen row-rc-wlen row-rc-wevent
                                    row-pool-slot row-pool-gen id row-generation)
    :accept ()
    :case (((:end) (:set (rc-stage 2)) (:charge :steps *fn2-work-stage* :runnable t))
           ((:appended) (:set (rc-roff next) (rc-wlen wlen) (rc-wevent ev)) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
           ((:skip) (:set (rc-roff next)) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
           ((:boundary) (:set (rc-stage 1)) (:charge :steps *fn2-work-stage* :runnable t))
           ((:invalid) (:stop :recovery-replay))
           ((:bounds) (:stop :recovery-bounds))))))
 :arms
 ((:free (:idle))
  ;; issue the next part of the current unit into the window, or, when
  ;; discovery has passed the arena, start the chain search
  (:read :on-refusal ((:stop :recovery-bounds))
   (:cond ((and (equal row-rc-mode *fn2-rec-mode-discover*) (>= row-rc-pos row-rc-arena))
           (:set (rc-chain 0) (rc-pos 0) (rc-found *fn2-alloc-none*) (rc-filled 0) (rc-stage 0))
           (:next :search) (:charge :steps *fn2-work-advance* :runnable t))
          ((not (and (natp budget) (< 0 budget) (< row-rc-filled *fn2-commit-unit-bytes*))) (:yield))
          (t (:do (code) (fn2-core-reset row-pool-slot row-pool-gen) :when (equal row-rc-filled 0) :else (:ok))
             (:do (icode op opgen)
                  (fn2-issue-read (+ (* row-rc-pos *fn2-commit-extent-bytes*) (* row-rc-role *fn2-commit-unit-bytes*) row-rc-filled)
                                  row-pool-slot row-pool-gen (- *fn2-commit-unit-bytes* row-rc-filled)
                                  :principal row-principal-slot)
              :accept ()
              :case (((:ok) (:set (pending (+ 1 row-pending)) (rc-ready 0)) (:next :read-result)
                            (:charge :bytes (- *fn2-commit-unit-bytes* row-rc-filled) :steps *fn2-work-small* :descriptors 1))
                     ((:exhausted) (:yield)))))))
  ;; the harvested completion. A failed or unreadable unit: discovery records
  ;; the position as unreadable (evidence, never corruption); chain
  ;; verification cannot establish its read, so the chain is unknown.
  (:read-result :on-refusal ((:stop :recovery-bounds))
   (:let filled (+ row-rc-filled row-rc-count))
   (:cond ((equal row-rc-ready 0) (:charge :steps *fn2-work-poll*))
          ((and (or (equal row-rc-outcome *fn2-outcome-done*) (equal row-rc-outcome *fn2-outcome-short*))
                (< 0 row-rc-count) (<= filled *fn2-commit-unit-bytes*))
           (:set (rc-filled filled) (rc-stage 0) (rc-ready 0))
           (:next (:if (equal filled *fn2-commit-unit-bytes*) :verify :read))
           (:charge :steps *fn2-work-mailbox* :runnable t))
          ((equal row-rc-mode *fn2-rec-mode-discover*)
           (:do (code) (fn2-recovery-cand-mark row-rc-pos *fn2-rec-status-unreadable*))
           (:set (rc-pos (+ 1 row-rc-pos)) (rc-high (+ 1 row-rc-pos)) (rc-role 2) (rc-filled 0) (rc-stage 0) (rc-ready 0))
           (:next :read) (:charge :steps *fn2-work-mailbox* :runnable t))
          ;; the replay's unit decoded at the payload pass: reading it again failed
          ((equal row-rc-mode *fn2-rec-mode-replay*) (:stop :recovery-replay))
          (t (:set (rc-ambiguous 1) (rc-stage 0) (rc-found 0) (rc-ready 0))
             (:next :install) (:charge :steps *fn2-work-mailbox* :runnable t))))
  ;; one stage over the filled unit (at most 4 KiB verified)
  (:verify :on-refusal ((:stop :recovery-bounds))
   (:cond ((and (equal row-rc-mode *fn2-rec-mode-payload*) (< 0 row-rc-munits)) (:goto payload-manifest))
          ((and (equal row-rc-mode *fn2-rec-mode-payload*) (equal row-rc-rend 0)) (:goto payload-open))
          ((equal row-rc-mode *fn2-rec-mode-payload*) (:goto payload-record))
          ((and (equal row-rc-mode *fn2-rec-mode-replay*) (equal row-rc-rend 0)) (:goto replay-open))
          ((and (equal row-rc-mode *fn2-rec-mode-replay*) (equal row-rc-stage 1)) (:goto replay-flush))
          ((and (equal row-rc-mode *fn2-rec-mode-replay*) (equal row-rc-stage 2)) (:goto replay-commit-end))
          ((equal row-rc-mode *fn2-rec-mode-replay*) (:goto replay-record))
          (t
   (:if (equal row-rc-mode *fn2-rec-mode-discover*)
        ((:do (code) (fn2-recovery-discover-unit row-rc-stage row-rc-pos row-rc-role row-pool-slot row-pool-gen id row-generation)
          :accept ()
          :case (((:again) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
                 ((:more) (:set (rc-stage (+ 1 row-rc-stage))) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
                 ((:empty :invalid :candidate)
                  (:if (and (eq code :empty) (< 0 row-rc-role))
                       ((:set (rc-role (- row-rc-role 1)) (rc-filled 0) (rc-stage 0))
                        (:next :read) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
                       ((:let ce (fn2-recovery-cand-epoch row-rc-pos))
                        (:do (mcode) (fn2-recovery-cand-mark row-rc-pos (cond ((eq code :empty) *fn2-rec-status-empty*)
                                                                             ((eq code :invalid) *fn2-rec-status-invalid*)
                                                                             (t *fn2-rec-status-candidate*))))
                        (:set (rc-pos (+ 1 row-rc-pos)) (rc-high (if (eq code :empty) row-rc-high (+ 1 row-rc-pos)))
                              (rc-epoch (if (eq code :candidate) (max row-rc-epoch ce) row-rc-epoch))
                              (rc-role 2) (rc-filled 0) (rc-stage 0) (rc-ready 0))
                        (:next :read) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t)))))))
        ((:do (code) (fn2-recovery-chain-unit row-rc-stage row-rc-pos row-rc-role row-pool-slot row-pool-gen id row-generation)
          :accept ()
          :case (((:again) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
                 ((:more) (:set (rc-stage (+ 1 row-rc-stage))) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
                 ((:next-role)
                  (:if (< 0 row-rc-role)
                       ((:set (rc-role (- row-rc-role 1)) (rc-filled 0) (rc-stage 0))
                        (:next :read) (:charge :steps *fn2-work-advance* :runnable t))
                       ((:stop :recovery-bounds))))
                 ((:chained)
                  (:do (lcode) (fn2-recovery-link row-rc-pos))
                  (:set (rc-chain (+ 1 row-rc-chain)) (rc-pos 0) (rc-found *fn2-alloc-none*) (rc-filled 0) (rc-stage 0))
                  (:next :search) (:charge :steps *fn2-work-advance* :runnable t))
                 ((:broken) (:goto payload-begin)))))))))
  ;; the unique successor of the chain; a second match is a branch, which
  ;; recovery never resolves by position
  (:search :on-refusal ((:stop :recovery-bounds))
   (:do (code next found twice) (fn2-recovery-scan row-rc-pos row-rc-arena row-rc-chain row-rc-found))
   (:cond (twice (:set (rc-ambiguous 1) (rc-stage 0) (rc-found 0) (rc-ready 0))
                 (:next :install) (:charge :steps *fn2-work-advance* :runnable t))
          ((< next row-rc-arena) (:set (rc-pos next) (rc-found found)) (:charge :steps *fn2-work-advance* :runnable t))
          ((equal found *fn2-alloc-none*) (:goto payload-begin))
          (t (:set (rc-mode *fn2-rec-mode-chain*) (rc-pos found) (rc-role 2) (rc-filled 0) (rc-stage 0))
             (:next :read) (:charge :steps *fn2-work-advance* :runnable t))))
  ;; stages: 0 dirty scan, 1 witness and classification, 2 allocator adoption
  ;; below the high water, then frontier and writer epoch. Only :intact and
  ;; :torn-tail install; :damaged and :unknown keep the allocator's epoch
  ;; unbegun, so every mutation stays fenced until repair. Reaching :done
  ;; releases the recovery bundle.
  (:install
   (:cond ((equal row-rc-stage 0) (:goto install-scan))
          ((equal row-rc-stage 1) (:goto install-classify))
          ((and (equal row-rc-stage 2) (< row-rc-found row-rc-high)) (:goto install-adopt))
          ((equal row-rc-stage 2) (:goto install-finish))
          (t (:stop :recovery-bounds))))
  (:done (:idle)))
 :observes
 ((:read-result :from (:read-result)
   (:set (rc-outcome outcome) (rc-count count) (rc-ready 1)) (:wake))))

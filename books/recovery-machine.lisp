; Table-level operations of the recovery row. Each takes the row's owner
; triple and window explicitly (the arm reads its own fields) and reports a
; refused bound as :bounds; the arm stops the core with a named reason.
; The unit buffer is the row's one 4 KiB workspace.
(defun fn2-recovery-nonzero (slot gen id ogen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code found)
  (fn2-rec-nonzero *fn2-commit-unit-bytes* slot gen 0 *fn2-recovery-machine-kind* id ogen fn2-pool)
  (mv code found)))
(defun fn2-recovery-decode (seal off end slot gen id ogen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
  (code next fn2-fields)
  (if (and (<= (+ *fn2-rec-field-base* *fn2-format-sealed-batch-num-fields*) (fn2-fields-rows fn2-fields))
           (unsigned-byte-p 32 off) (unsigned-byte-p 32 end))
   (if seal
    (fn2-format-sealed-batch-decode *fn2-rec-field-base* slot gen off end *fn2-recovery-machine-kind* id ogen fn2-fields fn2-pool)
    (fn2-format-frame-header-decode *fn2-rec-field-base* slot gen off end *fn2-recovery-machine-kind* id ogen fn2-fields fn2-pool))
   (mv :bounds 0 fn2-fields))
  (mv code next fn2-core)))
(fn2-core-preserves fn2-recovery-decode (seal off end slot gen id ogen fn2-core) :position 2 :rows nil)
(defun fn2-recovery-header (p fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-fields (fn2-core-fields fn2-core))) (ok commit epoch allocation payload)
  (if (and (<= (+ *fn2-rec-field-base* *fn2-format-sealed-batch-num-fields*) (fn2-fields-rows fn2-fields)) (natp p))
      (fn2-rec-header-check p fn2-fields) (mv nil 0 0 0 0))
  (mv ok commit epoch allocation payload)))
(defun fn2-recovery-seal-fields (p commit epoch allocation fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-fields (fn2-core-fields fn2-core)))
  (ok first last prev final records deps)
  (if (and (<= (+ *fn2-rec-field-base* *fn2-format-sealed-batch-num-fields*) (fn2-fields-rows fn2-fields)) (natp p))
   (mv-let (ok first last) (fn2-rec-seal-check p commit epoch allocation fn2-fields)
    (mv ok first last
        (fn2-rec-field-off *fn2-format-sealed-batch-field-previous-seal* fn2-fields)
        (fn2-rec-field-off *fn2-format-sealed-batch-field-final-seal* fn2-fields)
        (fn2-rec-field-off *fn2-format-sealed-batch-field-record-stream* fn2-fields)
        (fn2-rec-field-off *fn2-format-sealed-batch-field-dependencies-expected-hash* fn2-fields)))
   (mv nil 0 0 0 0 0 0))
  (mv ok first last prev final records deps)))
; Expected context of the recovery checker row for unit ROLE of position p.
(defun fn2-recovery-context (p role epoch allocation commit hash previous fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-fc-context (fn2-core-fc-context fn2-core))) (code fn2-fc-context)
  (let ((row *fn2-rec-checker-row*))
   (if (and (< row (fn2-fc-context-rows fn2-fc-context))
            (unsigned-byte-p 32 p) (natp role) (< role 3) (unsigned-byte-p 60 epoch)
            (unsigned-byte-p 60 allocation) (unsigned-byte-p 60 commit)
            (unsigned-byte-p 32 hash) (unsigned-byte-p 32 previous)
            (unsigned-byte-p 32 (fn2-digest-slot row *fn2-fc-geometry*)))
    (let ((fn2-fc-context (fn2-rec-context row p role epoch allocation commit hash previous
                            (fn2-digest-slot row *fn2-fc-geometry*) fn2-fc-context)))
     (mv :ok fn2-fc-context))
    (mv :bounds fn2-fc-context)))
  (mv code fn2-core)))
(fn2-core-preserves fn2-recovery-context (p role epoch allocation commit hash previous fn2-core) :position 1 :rows nil)
(defun fn2-recovery-format (kind off len slot gen id ogen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (let ((row *fn2-rec-checker-row*) (base *fn2-rec-field-base*))
 (stobj-let ((fn2-fc (fn2-core-fc fn2-core)) (fn2-fc-context (fn2-core-fc-context fn2-core))
             (fn2-b3 (fn2-core-b3 fn2-core)) (fn2-fields (fn2-core-fields fn2-core))
             (fn2-pool (fn2-core-pool fn2-core)) (fn2-digests (fn2-core-digests fn2-core)))
  (code fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
  (if (and (< row (fn2-fc-rows fn2-fc)) (< row (fn2-fc-context-rows fn2-fc-context))
           (fn2-b3-ready row fn2-b3 fn2-digests)
           (fn2-digest-rowp (fn2-fc-context-hash row fn2-fc-context) fn2-digests)
           (fn2-digest-rowp (fn2-fc-context-geometry row fn2-fc-context) fn2-digests)
           (fn2-digest-rowp (fn2-fc-context-previous-seal row fn2-fc-context) fn2-digests)
           (<= (+ base *fn2-format-sealed-batch-num-fields*) (fn2-fields-rows fn2-fields))
           (unsigned-byte-p 32 off) (unsigned-byte-p 32 len))
   (fn2-format-run kind nil row slot gen off len base *fn2-recovery-machine-kind* id ogen 4096
                    fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
   (mv :bounds fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)) (mv code fn2-core))))
(fn2-core-preserves fn2-recovery-format (kind off len slot gen id ogen fn2-core) :position 1 :rows nil)
(defun fn2-recovery-fetch (dst off slot gen id ogen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))

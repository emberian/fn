; One verification stage over the filled unit of position p (the arm's
; rc-stage, rc-pos, rc-role and window). Discovery (seal frames):
; 0 zero scan, 1 header decode and context, 2 frame hash, 3 seal decode,
; 4 digest fetch. Chain (found position): seal unit 0 context, 1 seal hash;
; records unit 0 context, 1 frame hash, 2 commitment; page unit 0 context,
; 1 page hash. Codes: :more :again :empty :invalid :candidate :next-role
; :chained :broken, and :bounds for a refused bound (the arm stops the core).
(defun fn2-recovery-discover-unit (stage p role slot gen id ogen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (b* (((mv arena base fits) (fn2-recovery-geometry fn2-core))
      (row *fn2-rec-checker-row*))
  (cond
   ((not (and fits (natp p) (< p arena))) (mv :bounds fn2-core))
   ; Every unit of the position is scanned for debris; only the seal unit
   ; (role 2, read first) is decoded. A nonzero record frame or page beside an
   ; empty seal unit is dirt, never an empty position.
   ((equal stage 0)
    (mv-let (code found) (fn2-recovery-nonzero slot gen id ogen fn2-core)
     (cond ((not (eq code :ok)) (mv :bounds fn2-core))
           ((and found (equal role 2)) (mv :more fn2-core))
           (found (mv :invalid fn2-core))
           (t (mv :empty fn2-core)))))
   ((not (equal role 2)) (mv :bounds fn2-core))
   ((equal stage 1)
    (b* (((mv code next fn2-core) (fn2-recovery-decode nil 0 *fn2-commit-unit-bytes* slot gen id ogen fn2-core)))
     (if (not (eq code :ok)) (mv :invalid fn2-core)
      (b* (((mv ok commit epoch allocation payload) (fn2-recovery-header p fn2-core)))
       (if (not (and ok (natp next) (<= (+ next payload) *fn2-commit-unit-bytes*)
                     (unsigned-byte-p 32 (+ next payload))))
           (mv :invalid fn2-core)
        (b* (((mv a fn2-core) (fn2-recovery-context p 2 epoch allocation commit
                                (fn2-digest-slot row *fn2-fc-hash*) (fn2-digest-slot row *fn2-fc-previous-seal*) fn2-core))
             ((mv b fn2-core) (fn2-recovery-cand-put p *fn2-rec-status-unread* commit epoch allocation 0 0 next payload fn2-core)))
         (mv (if (and (eq a :ok) (eq b :ok)) :more :bounds) fn2-core)))))))
   ((equal stage 2)
    (mv-let (code fn2-core) (fn2-recovery-format :frame 0 *fn2-commit-unit-bytes* slot gen id ogen fn2-core)
     (cond ((eq code :more) (mv :again fn2-core)) ((eq code :ok) (mv :more fn2-core))
           ((eq code :bounds) (mv :bounds fn2-core)) (t (mv :invalid fn2-core)))))
   ((equal stage 3)
    (b* ((commit (fn2-recovery-cand-commit p fn2-core)) (epoch (fn2-recovery-cand-epoch p fn2-core))
         (allocation (fn2-recovery-cand-allocation p fn2-core))
         (next (fn2-recovery-cand-seal-off p fn2-core)) (payload (fn2-recovery-cand-seal-len p fn2-core))
         ((mv code end fn2-core) (fn2-recovery-decode t next (+ next payload) slot gen id ogen fn2-core)))
     (if (not (and (eq code :ok) (natp end) (<= next end))) (mv :invalid fn2-core)
      (b* (((mv ok first last & & & &) (fn2-recovery-seal-fields p commit epoch allocation fn2-core)))
       (if (not ok) (mv :invalid fn2-core)
        (b* (((mv b fn2-core) (fn2-recovery-cand-put p *fn2-rec-status-unread* commit epoch allocation
                                first last next (- end next) fn2-core)))
         (mv (if (eq b :ok) :more :bounds) fn2-core)))))))
   ((equal stage 4)
    (b* ((commit (fn2-recovery-cand-commit p fn2-core)) (epoch (fn2-recovery-cand-epoch p fn2-core))
         (allocation (fn2-recovery-cand-allocation p fn2-core))
         ((mv ok & & prev final records deps) (fn2-recovery-seal-fields p commit epoch allocation fn2-core)))
     (if (not ok) (mv :invalid fn2-core)
      (b* (((mv a fn2-core) (fn2-recovery-fetch (fn2-rec-row base p *fn2-rec-previous*) prev slot gen id ogen fn2-core))
           ((mv b fn2-core) (fn2-recovery-fetch (fn2-rec-row base p *fn2-rec-final*) final slot gen id ogen fn2-core))
           ((mv c fn2-core) (fn2-recovery-fetch (fn2-rec-row base p *fn2-rec-records*) records slot gen id ogen fn2-core))
           ((mv d fn2-core) (fn2-recovery-fetch (fn2-rec-row base p *fn2-rec-dependency*) deps slot gen id ogen fn2-core)))
       (mv (if (and (eq a :ok) (eq b :ok) (eq c :ok) (eq d :ok)) :candidate :invalid) fn2-core)))))
   (t (mv :bounds fn2-core)))))
(fn2-core-preserves fn2-recovery-discover-unit (stage p role slot gen id ogen fn2-core) :position 1 :rows nil)

(defun fn2-recovery-chain-unit (stage p role slot gen id ogen fn2-core)

; Geometry: the arena is the allocator's extent table; the recovery digest
; region follows the commit directory. Every bound is checked, never assumed.
(defun fn2-recovery-geometry (fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-fc (fn2-core-fc fn2-core))
             (fn2-fc-context (fn2-core-fc-context fn2-core)) (fn2-digests (fn2-core-digests fn2-core))
             (fn2-fields (fn2-core-fields fn2-core)) (fn2-b3 (fn2-core-b3 fn2-core))
             (fn2-rec-cand (fn2-core-rec-cand fn2-core)) (fn2-commit-root (fn2-core-commit-root fn2-core)))
  (arena base fits)
  (let* ((arena (nfix (fn2-extents-rows fn2-extents)))
         (base (+ (* *fn2-digest-stride* (nfix (fn2-fc-rows fn2-fc))) arena 1)))
   (mv arena base
       (and (unsigned-byte-p 32 arena) (unsigned-byte-p 32 (+ base (fn2-rec-digest-rows arena)))
            (<= (+ base (fn2-rec-digest-rows arena)) (fn2-digests-rows fn2-digests))
            (< *fn2-rec-checker-row* (fn2-fc-rows fn2-fc))
            (< *fn2-rec-checker-row* (fn2-fc-context-rows fn2-fc-context))
            (fn2-b3-ready *fn2-rec-checker-row* fn2-b3 fn2-digests)
            (<= (+ *fn2-rec-field-base* *fn2-format-sealed-batch-num-fields*) (fn2-fields-rows fn2-fields))
            (<= arena (fn2-rec-cand-rows fn2-rec-cand))
            (< arena (fn2-commit-root-rows fn2-commit-root)))))
  (mv arena base fits)))
(defthm fn2-recovery-geometry-arena-natp (natp (mv-nth 0 (fn2-recovery-geometry fn2-core)))
 :rule-classes :type-prescription)
(defthm fn2-recovery-geometry-arena-car-natp (natp (car (fn2-recovery-geometry fn2-core)))
 :rule-classes :type-prescription)
(defthm fn2-recovery-geometry-base-natp (natp (mv-nth 1 (fn2-recovery-geometry fn2-core)))
 :rule-classes :type-prescription)
(in-theory (disable fn2-recovery-geometry))

; Candidate rows: one write per discovery, one read per check. A refused
; write is the caller's :bounds, never a silent no-op.
(defun fn2-recovery-cand-put (p status commit epoch allocation first last off len fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-rec-cand (fn2-core-rec-cand fn2-core))) (code fn2-rec-cand)
  (if (and (natp p) (< p (fn2-rec-cand-rows fn2-rec-cand)) (unsigned-byte-p 3 status)
           (< status 6)
           (unsigned-byte-p 60 commit) (unsigned-byte-p 60 epoch) (unsigned-byte-p 60 allocation)
           (unsigned-byte-p 60 first) (unsigned-byte-p 60 last)
           (unsigned-byte-p 32 off) (unsigned-byte-p 32 len))
   (let* ((fn2-rec-cand (fn2-rec-cand-set-status p status fn2-rec-cand))
          (fn2-rec-cand (fn2-rec-cand-set-commit p commit fn2-rec-cand))
          (fn2-rec-cand (fn2-rec-cand-set-epoch p epoch fn2-rec-cand))
          (fn2-rec-cand (fn2-rec-cand-set-allocation p allocation fn2-rec-cand))
          (fn2-rec-cand (fn2-rec-cand-set-first p first fn2-rec-cand))
          (fn2-rec-cand (fn2-rec-cand-set-last p last fn2-rec-cand))
          (fn2-rec-cand (fn2-rec-cand-set-seal-off p off fn2-rec-cand)))
    (let ((fn2-rec-cand (fn2-rec-cand-set-seal-len p len fn2-rec-cand))) (mv :ok fn2-rec-cand)))
   (mv :bounds fn2-rec-cand))
  (mv code fn2-core)))
(fn2-core-preserves fn2-recovery-cand-put (p status commit epoch allocation first last off len fn2-core) :position 1 :rows nil)

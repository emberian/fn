; Canonical linked checkpoint body header for actual registered page chains.
; This B leaf serializes evidence; C producers own their cut/entry coverage.
(in-package "ACL2")
(include-book "checkpoint-map-format")
(include-book "checkpoint-page-header")
(fn2-book-layer :b)

(defun fn2-checkpoint-linked-hash-buffer (left i extent slot gen okind oslot ogen zero-p fn2-checkpoint-page-verified fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-page-verified fn2-pool) :measure (nfix left)
  :guard (and (fn2-checkpoint-page-verified-wfp fn2-checkpoint-page-verified) (fn2-pool-wfp fn2-pool)
              (or zero-p (and (natp extent) (< extent (fn2-checkpoint-page-verified-rows fn2-checkpoint-page-verified))))
              (natp left) (natp i) (<= (+ i left) 32))))
 (if (zp left) (mv :ok fn2-pool)
  (b* ((word (if zero-p 0 (fn2-checkpoint-page-verified-word extent (floor i 4) fn2-checkpoint-page-verified)))
       (byte (logand 255 (ash word (- (* 8 (mod i 4))))))
       ((mv code fn2-pool) (fn2-pool-write slot gen i byte okind oslot ogen fn2-pool)))
   (if (eq code :ok)
    (fn2-checkpoint-linked-hash-buffer (- left 1) (+ i 1) extent slot gen okind oslot ogen zero-p fn2-checkpoint-page-verified fn2-pool)
    (mv code fn2-pool)))))

(defun fn2-checkpoint-linked-header-pack (token okind oslot ogen role ordinal extent epoch allocation history incarnation
                                         cut-commit cut-event total first count slots base slot gen scratch sgen child
                                         fn2-checkpoint-construction fn2-extents fn2-checkpoint-page-verified fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-construction fn2-extents fn2-checkpoint-page-verified fn2-fields fn2-pool)
  :guard (and (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extents-wfp fn2-extents)
              (fn2-checkpoint-page-verified-wfp fn2-checkpoint-page-verified) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (member-equal role '(2 3 4 5))
                     (or (not (equal role 4)) (posp ordinal)) (unsigned-byte-p 60 total) (unsigned-byte-p 60 ordinal)
                     (unsigned-byte-p 60 first) (unsigned-byte-p 60 count) (posp slots)
                     (unsigned-byte-p 60 history) (unsigned-byte-p 60 incarnation)
                     (unsigned-byte-p 60 cut-commit) (unsigned-byte-p 60 cut-event)
                     (natp base) (<= (+ base *fn2-checkpoint-map-header-num-fields*) (fn2-fields-rows fn2-fields))
                     (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen) (unsigned-byte-p 32 scratch) (unsigned-byte-p 60 sgen)
                     (not (equal slot scratch))
                     (fn2-checkpoint-page-ledger-p token okind oslot ogen role ordinal extent epoch allocation *fn2-format-page-size* 0 fn2-checkpoint-construction fn2-extents)
                     (eq (fn2-pool-workspace-code slot gen okind oslot ogen fn2-pool) :ok)
                     (eq (fn2-pool-workspace-code scratch sgen okind oslot ogen fn2-pool) :ok)
                     (<= *fn2-format-page-size* (fn2-pool-cap slot fn2-pool)) (<= 32 (fn2-pool-cap scratch fn2-pool))))
       (mv :identity fn2-fields fn2-pool))
      ; Role4 ordinal0 is the frontier root. Its inventory chain starts at
      ; construction ordinal1, with a zero-based local linked-page ordinal.
      (sequence-ordinal (if (equal role 4) (- ordinal 1) ordinal))
      (has-next (if (< (+ sequence-ordinal 1) (fn2-checkpoint-map-page-count total slots)) 1 0))
      (page-kind (case role (2 *page-kind-allocation-map*) (3 *page-kind-manifest*) (4 *page-kind-merkle-node*) (otherwise *page-kind-recovery-arena*)))
      ((unless (fn2-checkpoint-map-page-shapep total sequence-ordinal first count has-next slots)) (mv :coverage fn2-fields fn2-pool))
      ((unless (or (equal has-next 0)
        (and (fn2-checkpoint-page-completed-extent-p token okind oslot ogen role (+ ordinal 1) child fn2-checkpoint-page-verified fn2-checkpoint-construction fn2-extents)
             (equal (fn2-checkpoint-page-verified-page-kind child fn2-checkpoint-page-verified) page-kind)
             (equal (fn2-checkpoint-page-verified-history child fn2-checkpoint-page-verified) history)
             (equal (fn2-checkpoint-page-verified-incarnation child fn2-checkpoint-page-verified) incarnation)
             (equal (fn2-checkpoint-page-verified-encoded-length child fn2-checkpoint-page-verified) *fn2-format-page-size*))))
       (mv :child fn2-fields fn2-pool))
      ((mv code fn2-pool) (fn2-pool-reset scratch sgen okind oslot ogen fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields fn2-pool))
      ; Zero terminal digest uses the same bounded copier over a constant word.
      ((mv code fn2-pool) (fn2-checkpoint-linked-hash-buffer 32 0 child scratch sgen okind oslot ogen (equal has-next 0) fn2-checkpoint-page-verified fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-kind*) (case role (2 *checkpoint-map-body-kind-allocation-map*) (3 *checkpoint-map-body-kind-event-proof-directory*) (4 *checkpoint-map-body-kind-release-inventory*) (otherwise *checkpoint-map-body-kind-recovery-arena*)) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-version*) *fn2-format-version* fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-cut-commit*) cut-commit fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-cut-event*) cut-event fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-total-entries*) total fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-page-ordinal*) sequence-ordinal fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-first-ordinal*) first fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-entry-count*) count fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-has-next*) has-next fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-retired-head*)
        (if (equal role 2) (fn2-alloc-retired-head fn2-extents) *fn2-alloc-none*) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-retired-count*)
        (if (equal role 2) (fn2-alloc-total-retired fn2-extents) 0) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-next-storage-domain*) 0 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-next-physical-unit*) (if (equal has-next 0) 0 (* child *fn2-storage-extent-units*)) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-next-writer-epoch*) (if (equal has-next 0) 0 (fn2-checkpoint-page-verified-epoch child fn2-checkpoint-page-verified)) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-next-allocation*) (if (equal has-next 0) 0 (fn2-checkpoint-page-verified-allocation child fn2-checkpoint-page-verified)) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-next-page-kind*) (if (equal has-next 0) 0 page-kind) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-next-encoded-length*) (if (equal has-next 0) 0 *fn2-format-page-size*) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-checkpoint-map-header-field-next-expected-hash*) 1 fn2-fields))
      (fn2-fields (fn2-fields-set-ref-slot (+ base *fn2-checkpoint-map-header-field-next-expected-hash*) scratch fn2-fields))
      (fn2-fields (fn2-fields-set-ref-gen (+ base *fn2-checkpoint-map-header-field-next-expected-hash*) sgen fn2-fields))
      (fn2-fields (fn2-fields-set-ref-off (+ base *fn2-checkpoint-map-header-field-next-expected-hash*) 0 fn2-fields))
      (fn2-fields (fn2-fields-set-ref-len (+ base *fn2-checkpoint-map-header-field-next-expected-hash*) 32 fn2-fields))
      ((mv code next fn2-pool) (fn2-checkpoint-map-header-encode base slot gen *fn2-checkpoint-map-body-start* okind oslot ogen fn2-fields fn2-pool)))
  (mv (if (and (eq code :ok) (natp next) (<= *fn2-checkpoint-map-body-start* next) (<= next *fn2-checkpoint-map-entries-start*)) :ok :format) fn2-fields fn2-pool)))

(fn2-pool-preserves fn2-checkpoint-linked-hash-buffer
 (left i extent slot gen okind oslot ogen zero-p fn2-checkpoint-page-verified fn2-pool)
 :hyps ((fn2-checkpoint-page-verifiedp fn2-checkpoint-page-verified) (fn2-checkpoint-page-verified-wfp fn2-checkpoint-page-verified) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
 :specs (("-POOL-TYPE" fn2-poolp 1)
         ("-POOL-WFP" fn2-pool-wfp 1)
         ("-POOL-ROWS" fn2-pool-rows 1 :frame fn2-pool)))

(fn2-fields-preserves fn2-checkpoint-linked-header-pack
 (token okind oslot ogen role ordinal extent epoch allocation history incarnation cut-commit cut-event total first count slots base slot gen scratch sgen child fn2-checkpoint-construction fn2-extents fn2-checkpoint-page-verified fn2-fields fn2-pool)
 :hyps ((fn2-checkpoint-constructionp fn2-checkpoint-construction) (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents) (fn2-checkpoint-page-verifiedp fn2-checkpoint-page-verified) (fn2-checkpoint-page-verified-wfp fn2-checkpoint-page-verified) (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
 :specs (("-FIELDS-TYPE" fn2-fieldsp 1)
         ("-FIELDS-WFP" fn2-fields-wfp 1)
         ("-FIELDS-ROWS" fn2-fields-rows 1 :frame fn2-fields)
         ("-POOL-TYPE" fn2-poolp 2)
         ("-POOL-WFP" fn2-pool-wfp 2)
         ("-POOL-ROWS" fn2-pool-rows 2 :frame fn2-pool)))

; Individually stamped release-journal evidence ownership. Count aggregates
; are paired with these actual rows, not generic obligation-count authority.
(in-package "ACL2")
(include-book "alloc-edge-layout")
(fn2-book-layer :b)
(defcolumns fn2-release-evidence
 ((live :bool) (journal-epoch :u60) (journal-allocation :u60) (batch :u60)
  (candidate :u32) (checkpoint :u60) (history :u60) (incarnation :u60)
  (cut-commit :u60) (cut-event :u60) (installation-commit :u60)
  (storage-domain :u60) (physical-unit :u60) (descriptor-epoch :u60) (descriptor-allocation :u60)
  (page-kind :u60) (encoded-length :u60)
(h0 :u32)
(h1 :u32)
(h2 :u32)
(h3 :u32)
(h4 :u32)
(h5 :u32)
(h6 :u32)
(h7 :u32)))
(defcolumns fn2-release-evidence-candidates
 ((count :u32) (checkpoint :u60) (history :u60) (incarnation :u60)
(h0 :u32)
(h1 :u32)
(h2 :u32)
(h3 :u32)
(h4 :u32)
(h5 :u32)
(h6 :u32)
(h7 :u32)))
(defun fn2-release-evidence-candidate-state (c checkpoint history incarnation fn2-release-evidence-candidates)
 (declare (xargs :stobjs fn2-release-evidence-candidates :guard (fn2-release-evidence-candidates-wfp fn2-release-evidence-candidates)))
 (cond ((not (and (natp c) (< c (fn2-release-evidence-candidates-rows fn2-release-evidence-candidates)))) :bounds)
       ((= (fn2-release-evidence-candidates-count c fn2-release-evidence-candidates) 0) :clear)
       ((and (equal checkpoint (fn2-release-evidence-candidates-checkpoint c fn2-release-evidence-candidates))
             (equal history (fn2-release-evidence-candidates-history c fn2-release-evidence-candidates))
             (equal incarnation (fn2-release-evidence-candidates-incarnation c fn2-release-evidence-candidates))) :held)
       (t :identity)))

; Fixed-slot serialization from the actual frozen allocator sources. The
; composing page job still owns page initialization, headers and completion.
(in-package "ACL2")
(include-book "checkpoint-map-read")
(fn2-book-layer :b)
(defun fn2-checkpoint-map-zero (left at slot gen okind oslot ogen fn2-pool)
 (declare (xargs :stobjs fn2-pool :measure (nfix left)
  :guard (and (fn2-pool-wfp fn2-pool) (natp left) (<= left *fn2-format-sector-size*) (natp at))))
 (if (zp left) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen at 0 okind oslot ogen fn2-pool)
   (if (eq code :ok)
    (fn2-checkpoint-map-zero (- left 1) (+ at 1) slot gen okind oslot ogen fn2-pool)
    (mv code fn2-pool)))))
(fn2-pool-preserves fn2-checkpoint-map-zero
 (left at slot gen okind oslot ogen fn2-pool) :position 1)

(defun fn2-checkpoint-map-pack-entry (extent page-ordinal base slot gen token okind oslot ogen fn2-extents fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-extents fn2-fields fn2-pool)
  :guard (and (fn2-extents-wfp fn2-extents) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (natp extent) (natp page-ordinal) (natp base)
                     (<= (+ base *fn2-format-allocation-map-entry-num-fields*) (fn2-fields-rows fn2-fields))
                     (equal (floor extent *fn2-checkpoint-map-slots*) page-ordinal)))
       (mv :ordinal fn2-fields fn2-pool))
      ((mv code fn2-fields) (fn2-checkpoint-frozen-map-entry extent base token okind oslot ogen fn2-extents fn2-fields))
      ((unless (eq code :entry)) (mv code fn2-fields fn2-pool))
      (off (+ *fn2-checkpoint-map-entries-start* (* (mod extent *fn2-checkpoint-map-slots*) *fn2-checkpoint-map-entry-width*)))
      ((mv code end fn2-pool) (fn2-format-allocation-map-entry-encode base slot gen off okind oslot ogen fn2-fields fn2-pool))
      ((unless (and (eq code :ok) (natp end) (<= off end) (<= end (+ off *fn2-checkpoint-map-entry-width*))))
       (mv :format fn2-fields fn2-pool))
      ((mv code fn2-pool) (fn2-checkpoint-map-zero (- (+ off *fn2-checkpoint-map-entry-width*) end) end slot gen okind oslot ogen fn2-pool)))
  (mv code fn2-fields fn2-pool)))

(defun fn2-checkpoint-arena-pack-entry (extent ordinal page-ordinal base slot gen token okind oslot ogen
                                       fn2-checkpoint-construction fn2-extents fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-construction fn2-extents fn2-fields fn2-pool)
  :guard (and (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extents-wfp fn2-extents)
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (natp ordinal) (natp page-ordinal) (natp base)
                     (<= (+ base *fn2-format-recovery-arena-entry-num-fields*) (fn2-fields-rows fn2-fields))
                     (equal (floor ordinal *fn2-checkpoint-arena-slots*) page-ordinal)))
       (mv :ordinal fn2-fields fn2-pool))
      ((mv code fn2-fields) (fn2-checkpoint-frozen-arena-entry extent ordinal base token okind oslot ogen fn2-checkpoint-construction fn2-extents fn2-fields))
      ((unless (eq code :entry)) (mv code fn2-fields fn2-pool))
      (off (+ *fn2-checkpoint-map-entries-start* (* (mod ordinal *fn2-checkpoint-arena-slots*) *fn2-checkpoint-arena-entry-width*)))
      ((mv code end fn2-pool) (fn2-format-recovery-arena-entry-encode base slot gen off okind oslot ogen fn2-fields fn2-pool))
      ((unless (and (eq code :ok) (natp end) (<= off end) (<= end (+ off *fn2-checkpoint-arena-entry-width*))))
       (mv :format fn2-fields fn2-pool))
      ((mv code fn2-pool) (fn2-checkpoint-map-zero (- (+ off *fn2-checkpoint-arena-entry-width*) end) end slot gen okind oslot ogen fn2-pool)))
  (mv code fn2-fields fn2-pool)))

(fn2-fields-preserves fn2-checkpoint-map-pack-entry
 (extent page-ordinal base slot gen token okind oslot ogen fn2-extents fn2-fields fn2-pool)
 :hyps ((fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents) (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
 :specs (("-FIELDS-TYPE" fn2-fieldsp 1) ("-FIELDS-WFP" fn2-fields-wfp 1) ("-FIELDS-ROWS" fn2-fields-rows 1 :frame fn2-fields)
         ("-POOL-TYPE" fn2-poolp 2) ("-POOL-WFP" fn2-pool-wfp 2) ("-POOL-ROWS" fn2-pool-rows 2 :frame fn2-pool)))

(fn2-fields-preserves fn2-checkpoint-arena-pack-entry
 (extent ordinal page-ordinal base slot gen token okind oslot ogen fn2-checkpoint-construction fn2-extents fn2-fields fn2-pool)
 :hyps ((fn2-checkpoint-constructionp fn2-checkpoint-construction) (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents) (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
 :specs (("-FIELDS-TYPE" fn2-fieldsp 1) ("-FIELDS-WFP" fn2-fields-wfp 1) ("-FIELDS-ROWS" fn2-fields-rows 1 :frame fn2-fields)
         ("-POOL-TYPE" fn2-poolp 2) ("-POOL-WFP" fn2-pool-wfp 2) ("-POOL-ROWS" fn2-pool-rows 2 :frame fn2-pool)))

(in-package "ACL2")
(include-book "conn-schema")
(include-book "authority-kind")

(defcost fn2-conn-read-principal :child fn2-conn-read-principal-children
 :answers (:ok :public :access :state)
 :doc "Read the live connection's durable principal, or the authority-free public policy.")

(defun fn2-conn-read-principal-children (conn gen cursor cursor-gen fn2-machines fn2-conn fn2-accounts)
 (declare (xargs :stobjs (fn2-machines fn2-conn fn2-accounts)
                 :guard (and (fn2-machines-wfp fn2-machines) (fn2-conn-wfp fn2-conn)
                             (fn2-accounts-wfp fn2-accounts))))
 (b* (((unless (and (natp conn) (< conn (fn2-machines-rows fn2-machines))
                    (equal (fn2-machines-kind conn fn2-machines) *fn2-conn-kind*)))
       (mv :state 0))
      (slot (fn2-machines-slot conn fn2-machines))
      ((unless (and (natp slot) (< slot (fn2-conn-rows fn2-conn))
                    (equal (fn2-conn-generation slot fn2-conn) gen)
                    (posp gen) (unsigned-byte-p 32 cursor) (posp cursor-gen)
                    (equal (fn2-conn-query slot fn2-conn) cursor)
                    (equal (fn2-conn-query-gen slot fn2-conn) cursor-gen)))
       (mv :state 0))
      (phase (fn2-conn-phase slot fn2-conn))
      ((when (member-equal phase (list *fn2-conn-state-free* *fn2-conn-state-retired*
                                       *fn2-conn-state-closing* *fn2-conn-state-draining*)))
       (mv :state 0))
      (mask (fn2-conn-mask slot fn2-conn))
      (principal (fn2-conn-login-principal slot fn2-conn))
      (account (fn2-conn-principal-slot slot fn2-conn))
      (live-principal (if (and (natp account) (< account (fn2-accounts-rows fn2-accounts)))
                          (fn2-account-principal-id account fn2-accounts)
                        0)))
   (cond
    ((not (equal 0 (logand mask *fn2-nntp-state-authenticated*)))
     (if (and (not (equal 0 (logand mask *fn2-nntp-state-tls*)))
              (equal 0 (logand mask *fn2-nntp-state-anonymous*))
              (posp principal) (unsigned-byte-p 60 principal)
              (equal principal live-principal))
         (mv :ok principal)
       (mv :access 0)))
    ((or (equal 0 (logand mask *fn2-nntp-state-anonymous*)) (not (equal 0 principal)))
     (mv :access 0))
    ((zp (fn2-machines-connection-counti *fn2-auth-admission-ordinal* fn2-machines))
     (mv :public 0))
    ((and (posp live-principal) (unsigned-byte-p 60 live-principal)) (mv :ok live-principal))
    (t (mv :access 0)))))

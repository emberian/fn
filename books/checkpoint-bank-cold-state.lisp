; Canonical readonly cold evidence/receipt definitions, shared by boot
; and terminal disposal. No capture, selection, mutation or readiness input.
(in-package "ACL2")
(include-book "checkpoint-publication-state")
(fn2-book-layer :b)

(defun fn2-checkpoint-bank-cold-capacityp (fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :guard (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)))
 (and (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication))
      (<= 48 (fn2-checkpoint-publication-cold-meta-length fn2-checkpoint-publication))
      (<= 192 (fn2-checkpoint-publication-cold-words-length fn2-checkpoint-publication))))

(defun fn2-checkpoint-bank-cold-ready-p (c fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :guard (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)))
 (and (natp c) (< c 4) (fn2-checkpoint-bank-cold-capacityp fn2-checkpoint-publication)
      (equal (fn2-checkpoint-publication-cold-metai (* 12 c) fn2-checkpoint-publication) 2)
      (equal (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 11) fn2-checkpoint-publication) 48)
      (equal (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 1) fn2-checkpoint-publication) c)
      (posp (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 2) fn2-checkpoint-publication))
      (< (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 5) fn2-checkpoint-publication)
         (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 7) fn2-checkpoint-publication))
      (< (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 6) fn2-checkpoint-publication)
         (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 8) fn2-checkpoint-publication))
      (posp (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 9) fn2-checkpoint-publication))
      (posp (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 10) fn2-checkpoint-publication))))

(defun fn2-checkpoint-bank-cold-snapshot (c fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :guard (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)))
 (if (not (fn2-checkpoint-bank-cold-ready-p c fn2-checkpoint-publication))
     (mv :absent 0 0 0 0 0 0 0)
  (mv :ok c
   (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 2) fn2-checkpoint-publication)
   (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 3) fn2-checkpoint-publication)
   (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 4) fn2-checkpoint-publication)
   (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 5) fn2-checkpoint-publication)
   (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 6) fn2-checkpoint-publication)
   (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 7) fn2-checkpoint-publication))))

(defun fn2-checkpoint-bank-cold-event (c fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :guard (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)))
 (if (not (fn2-checkpoint-bank-cold-ready-p c fn2-checkpoint-publication)) (mv :absent 0)
  (mv :ok (fn2-checkpoint-publication-cold-metai (+ (* 12 c) 8) fn2-checkpoint-publication))))

(defun fn2-checkpoint-bank-cold-word (c kind i fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :guard (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)))
 (if (not (and (fn2-checkpoint-bank-cold-ready-p c fn2-checkpoint-publication) (natp i) (< i 8)
               (member-eq kind '(:installation-seal :cut-seal :installation-predecessor :previous-descriptor :descriptor :anchor-hash))))
     (mv :absent 0)
  (let ((which (case kind (:installation-seal 0) (:cut-seal 1) (:installation-predecessor 2)
                          (:previous-descriptor 3) (:descriptor 4) (otherwise 5))))
   (mv :ok (fn2-checkpoint-publication-cold-wordsi (+ (* 48 c) (* 8 which) i) fn2-checkpoint-publication)))))

; The actual frozen role6 path borrows four future packet/scratch leases.
; Foreground reservations never enter these helpers. The ordinary drain calls
; release-pool four times; maintenance retains all four until its last call.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-future-resources")
(fn2-book-layer :b)
(defun fn2-checkpoint-journal-borrower-seen-p (i kind id gen fn2-checkpoint-future-windows)
 (declare (xargs :stobjs fn2-checkpoint-future-windows :measure (nfix (- 5 (nfix i)))
  :guard (and (fn2-checkpoint-future-windows-wfp fn2-checkpoint-future-windows) (natp i) (<= i 5))))
 (and (natp i) (< i 5) (< i (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows))
  (or (and (= (fn2-checkpoint-future-windows-borrowed i fn2-checkpoint-future-windows) 1)
           (equal (fn2-checkpoint-future-windows-borrower-kind i fn2-checkpoint-future-windows) kind)
           (equal (fn2-checkpoint-future-windows-borrower-slot i fn2-checkpoint-future-windows) id)
           (equal (fn2-checkpoint-future-windows-borrower-gen i fn2-checkpoint-future-windows) gen))
      (fn2-checkpoint-journal-borrower-seen-p (+ 1 i) kind id gen fn2-checkpoint-future-windows))))

; Materialized after commit-resource/save-pool, before release-pool.
(defmacro fn2-checkpoint-commit-loan-events ()
 '(progn
 (defun fn2-checkpoint-commit-loan-state (id gen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-checkpoint-future (fn2-core-checkpoint-future fn2-core))
              (fn2-checkpoint-future-windows (fn2-core-checkpoint-future-windows fn2-core))
              (fn2-pool (fn2-core-pool fn2-core))) (code)
   (if (not (fn2-checkpoint-journal-borrower-seen-p 1 *fn2-commit-kind* id gen fn2-checkpoint-future-windows)) :none
    (if (and (< 0 (fn2-checkpoint-future-rows fn2-checkpoint-future))
             (fn2-checkpoint-future-ownerp (fn2-checkpoint-future-owner-kind 0 fn2-checkpoint-future)
              (fn2-checkpoint-future-owner-slot 0 fn2-checkpoint-future) (fn2-checkpoint-future-owner-gen 0 fn2-checkpoint-future) fn2-checkpoint-future)
             (fn2-checkpoint-future-transfer-readyp 1 5 t (fn2-checkpoint-future-token 0 fn2-checkpoint-future)
              (fn2-checkpoint-future-owner-kind 0 fn2-checkpoint-future) (fn2-checkpoint-future-owner-slot 0 fn2-checkpoint-future)
              (fn2-checkpoint-future-owner-gen 0 fn2-checkpoint-future) *fn2-commit-kind* id gen
              fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)) :borrowed :broken)) code))

 (defun fn2-checkpoint-commit-bindings-p (role id gen token fn2-core)
  (declare (xargs :stobjs fn2-core :measure (nfix (- 4 (nfix role)))
   :guard (and (fn2-core-wfp fn2-core) (natp role) (<= role 4))))
  (if (and (natp role) (<= role 4))
   (if (>= role 4) t
   (and (fn2-commit-idp id fn2-core)
    (b* (((mv code expected-slot expected-gen)
          (stobj-let ((fn2-checkpoint-future (fn2-core-checkpoint-future fn2-core))
                      (fn2-checkpoint-future-windows (fn2-core-checkpoint-future-windows fn2-core))
                      (fn2-pool (fn2-core-pool fn2-core))) (code slot generation)
           (fn2-checkpoint-future-lease (+ 1 role) token *fn2-commit-kind* id gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
           (mv code slot generation)))
         ((mv & & & slot generation) (fn2-commit-resource id (if (= role 3) 0 role) fn2-core)))
     (and (eq code :ok)
          (equal expected-slot (if (= role 3) (fn2-machine-pool-slot id fn2-core) slot))
          (equal expected-gen (if (= role 3) (fn2-machine-pool-gen id fn2-core) generation))
          (fn2-checkpoint-commit-bindings-p (+ 1 role) id gen token fn2-core)))))
   nil))

 (defun fn2-checkpoint-commit-clear-pools (left id fn2-core)
  (declare (xargs :stobjs fn2-core :measure (nfix left)
   :guard (and (fn2-core-wfp fn2-core) (natp left) (<= left 3))))
  (if (zp left) (fn2-commit-put-core id (pool-slot *fn2-none*) (pool-gen 0))
   (if (not (fn2-commit-idp id fn2-core)) (fn2-core-stop *fn2-stop-reason-commit-pool* fn2-core)
    (b* ((r (+ (* 3 (fn2-commit-row id fn2-core)) (- left 1)))
         ((mv fits fn2-core) (stobj-let ((fn2-commit-io (fn2-core-commit-io fn2-core))) (fits fn2-commit-io)
          (if (< r (fn2-commit-io-rows fn2-commit-io))
              (let* ((fn2-commit-io (fn2-commit-io-put r (ready 0) (pool-slot *fn2-none*) (pool-gen 0))))
               (mv t fn2-commit-io)) (mv nil fn2-commit-io))
          (mv fits fn2-core)))
         ((unless fits) (fn2-core-stop *fn2-stop-reason-commit-pool* fn2-core)))
     (fn2-checkpoint-commit-clear-pools (- left 1) id fn2-core)))))
 (fn2-core-preserves fn2-checkpoint-commit-clear-pools (left id fn2-core) :rows nil :prefix "")

 ; GEN is the exact pool borrower generation. During admission unwind the
 ; FREE machine deliberately still has its previous generation; commit-start
 ; assigns the new generation only after reserve-ticket succeeds.
 (defun fn2-checkpoint-commit-return-pools (id gen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((unless (and (fn2-commit-idp id fn2-core)
                     (member-equal (fn2-machine-phase id fn2-core) (list *fn2-commit-state-free* *fn2-commit-state-draining*))
                     (= (fn2-machine-pending id fn2-core) 0) (= (fn2-machine-cb-fence-live id fn2-core) 0)
                     (eq (fn2-checkpoint-commit-loan-state id gen fn2-core) :borrowed))) (mv :owner fn2-core))
       (token (stobj-let ((fn2-checkpoint-future (fn2-core-checkpoint-future fn2-core))) (token)
                (if (< 0 (fn2-checkpoint-future-rows fn2-checkpoint-future)) (fn2-checkpoint-future-token 0 fn2-checkpoint-future) 0) token))
       ((unless (fn2-checkpoint-commit-bindings-p 0 id gen token fn2-core)) (mv :owner fn2-core))
       ((mv code fn2-core)
        (stobj-let ((fn2-checkpoint-future (fn2-core-checkpoint-future fn2-core))
                    (fn2-checkpoint-future-windows (fn2-core-checkpoint-future-windows fn2-core))
                    (fn2-extents (fn2-core-extents fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
         (code fn2-checkpoint-future-windows fn2-pool)
         (if (and (< 0 (fn2-checkpoint-future-rows fn2-checkpoint-future))
                  (= (fn2-alloc-freeze-phase fn2-extents) 2)
                  (= (fn2-checkpoint-future-token 0 fn2-checkpoint-future) (fn2-alloc-freeze-token fn2-extents))
                  (= (fn2-checkpoint-future-owner-kind 0 fn2-checkpoint-future) (fn2-alloc-freeze-owner-kind fn2-extents))
                  (= (fn2-checkpoint-future-owner-slot 0 fn2-checkpoint-future) (fn2-alloc-freeze-owner-slot fn2-extents))
                  (= (fn2-checkpoint-future-owner-gen 0 fn2-checkpoint-future) (fn2-alloc-freeze-owner-gen fn2-extents)))
             (fn2-checkpoint-future-return-journal (fn2-checkpoint-future-token 0 fn2-checkpoint-future)
              (fn2-checkpoint-future-owner-kind 0 fn2-checkpoint-future) (fn2-checkpoint-future-owner-slot 0 fn2-checkpoint-future)
              (fn2-checkpoint-future-owner-gen 0 fn2-checkpoint-future) *fn2-commit-kind* id gen
              fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
           (mv :owner fn2-checkpoint-future-windows fn2-pool)) (mv code fn2-core)))
       ((unless (eq code :ok))
        (let ((fn2-core (fn2-core-stop *fn2-stop-reason-commit-pool* fn2-core))) (mv :uncertain fn2-core)))
       (fn2-core (fn2-checkpoint-commit-clear-pools 3 id fn2-core)))
   (mv (if (fn2-core-stopped-p fn2-core) :uncertain :ok) fn2-core)))
 (fn2-core-preserves fn2-checkpoint-commit-return-pools (id gen fn2-core) :position 1 :rows nil)
 ))

; Materialized after commit-keep-pool, before commit-start.
(defmacro fn2-checkpoint-commit-reserve-events ()
 '(progn
 (defun fn2-checkpoint-commit-bind-pools (role id gen token fn2-core)
  (declare (xargs :stobjs fn2-core :measure (nfix (- 4 (nfix role)))
   :guard (and (fn2-core-wfp fn2-core) (natp role) (<= role 4))))
  (if (and (natp role) (<= role 4))
   (if (>= role 4) (mv :ok fn2-core)
   (b* (((mv code slot generation)
         (stobj-let ((fn2-checkpoint-future (fn2-core-checkpoint-future fn2-core))
                     (fn2-checkpoint-future-windows (fn2-core-checkpoint-future-windows fn2-core))
                     (fn2-pool (fn2-core-pool fn2-core))) (code slot generation)
          (fn2-checkpoint-future-lease (+ 1 role) token *fn2-commit-kind* id gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
          (mv code slot generation)))
        ((unless (and (eq code :ok) (unsigned-byte-p 32 slot) (unsigned-byte-p 60 generation)))
         (let ((fn2-core (fn2-core-stop *fn2-stop-reason-commit-pool* fn2-core))) (mv :uncertain fn2-core)))
        (fn2-core (fn2-commit-keep-pool id role slot generation fn2-core))
        ((when (fn2-core-stopped-p fn2-core)) (mv :uncertain fn2-core)))
    (fn2-checkpoint-commit-bind-pools (+ 1 role) id gen token fn2-core)))
   (mv :bounds fn2-core)))
 (fn2-core-preserves fn2-checkpoint-commit-bind-pools (role id gen token fn2-core) :position 1 :rows nil)

 (defun fn2-checkpoint-commit-reserve-pools (id gen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((unless (and (fn2-commit-idp id fn2-core) (unsigned-byte-p 60 gen)
                     (= (fn2-machine-phase id fn2-core) *fn2-commit-state-free*)
                     (= (fn2-machine-pending id fn2-core) 0) (= (fn2-machine-cb-fence-live id fn2-core) 0))) (mv :bounds fn2-core))
       ((mv code token fn2-core)
        (stobj-let ((fn2-checkpoint-future (fn2-core-checkpoint-future fn2-core))
                    (fn2-checkpoint-future-windows (fn2-core-checkpoint-future-windows fn2-core))
                    (fn2-extents (fn2-core-extents fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
         (code token fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
         (b* (((unless (< 0 (fn2-checkpoint-future-rows fn2-checkpoint-future)))
               (mv :owner 0 fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
              (token (fn2-alloc-freeze-token fn2-extents))
              (kind (fn2-alloc-freeze-owner-kind fn2-extents)) (owner (fn2-alloc-freeze-owner-slot fn2-extents))
              (ogen (fn2-alloc-freeze-owner-gen fn2-extents))
              ((mv code fn2-checkpoint-future)
               (fn2-checkpoint-future-bind (fn2-checkpoint-future-candidate 0 fn2-checkpoint-future) token kind owner ogen fn2-checkpoint-future fn2-extents))
              ((unless (eq code :ok)) (mv code token fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
              ((mv code fn2-checkpoint-future-windows fn2-pool)
               (fn2-checkpoint-future-borrow-journal token kind owner ogen *fn2-commit-kind* id gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)))
          (mv code token fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)) (mv code token fn2-core)))
       ((when (eq code :partial))
        (let ((fn2-core (fn2-core-stop *fn2-stop-reason-commit-pool* fn2-core))) (mv :uncertain fn2-core)))
       ((unless (eq code :ok)) (mv :exhausted fn2-core)))
   (fn2-checkpoint-commit-bind-pools 0 id gen token fn2-core)))
 (fn2-core-preserves fn2-checkpoint-commit-reserve-pools (id gen fn2-core) :position 1 :rows nil)
 ))

; Three disjoint field regions and two owned byte windows. Window16 is never
; borrowed for a lower key: the actual page/semantic worker may overwrite it.
(in-package "ACL2")
(include-book "checkpoint-compaction-source")
(include-book "checkpoint-source-loader")
(fn2-book-layer :c)

(defun fn2-checkpoint-compaction-key-disjoint-p (i key fn2-checkpoint-windows)
 (declare (xargs :stobjs fn2-checkpoint-windows
 :guard (and (fn2-checkpoint-windows-wfp fn2-checkpoint-windows) (natp i) (natp key))
 :measure (nfix (- *fn2-checkpoint-window-count* (nfix i)))))
 (if (>= (nfix i) *fn2-checkpoint-window-count*) t
  (and (< i (fn2-checkpoint-windows-rows fn2-checkpoint-windows))
       (or (equal i *fn2-checkpoint-compaction-key-window*)
           (not (equal key (fn2-checkpoint-windows-slot i fn2-checkpoint-windows))))
       (fn2-checkpoint-compaction-key-disjoint-p (+ i 1) key fn2-checkpoint-windows))))

(defun fn2-checkpoint-compaction-windowsp
 (fn2-checkpoint-compaction fn2-checkpoint-root1 fn2-checkpoint-windows fn2-csnapshot fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-compaction fn2-checkpoint-root1 fn2-checkpoint-windows fn2-csnapshot fn2-pool)
 :guard (and (fn2-checkpoint-compaction-wfp fn2-checkpoint-compaction)
 (fn2-checkpoint-root1-wfp fn2-checkpoint-root1) (fn2-checkpoint-windows-wfp fn2-checkpoint-windows)
 (fn2-csnapshot-wfp fn2-csnapshot) (fn2-pool-wfp fn2-pool))))
 (and (< 0 (fn2-checkpoint-compaction-rows fn2-checkpoint-compaction))
      (fn2-checkpoint-root1-ownerp
       (fn2-checkpoint-compaction-token 0 fn2-checkpoint-compaction)
       (fn2-checkpoint-compaction-owner-kind 0 fn2-checkpoint-compaction)
       (fn2-checkpoint-compaction-owner-slot 0 fn2-checkpoint-compaction)
       (fn2-checkpoint-compaction-owner-gen 0 fn2-checkpoint-compaction)
       fn2-checkpoint-root1 fn2-checkpoint-windows fn2-csnapshot)
      (or (equal (fn2-checkpoint-compaction-configured 0 fn2-checkpoint-compaction) 0)
          (and (equal (fn2-checkpoint-compaction-best-slot 0 fn2-checkpoint-compaction) (fn2-checkpoint-windows-slot 14 fn2-checkpoint-windows))
               (equal (fn2-checkpoint-compaction-best-gen 0 fn2-checkpoint-compaction) (fn2-checkpoint-windows-generation 14 fn2-checkpoint-windows))
               (equal (fn2-checkpoint-compaction-lower-slot 0 fn2-checkpoint-compaction) (fn2-checkpoint-windows-slot *fn2-checkpoint-compaction-key-window* fn2-checkpoint-windows))
               (equal (fn2-checkpoint-compaction-lower-gen 0 fn2-checkpoint-compaction) (fn2-checkpoint-windows-generation *fn2-checkpoint-compaction-key-window* fn2-checkpoint-windows))))
      (equal (fn2-checkpoint-windows-live 14 fn2-checkpoint-windows) 1)
      (equal (fn2-checkpoint-windows-live *fn2-checkpoint-compaction-key-window* fn2-checkpoint-windows) 1)
      (let ((best (fn2-checkpoint-windows-slot 14 fn2-checkpoint-windows))
            (key (fn2-checkpoint-windows-slot *fn2-checkpoint-compaction-key-window* fn2-checkpoint-windows))
            (kind (fn2-checkpoint-compaction-owner-kind 0 fn2-checkpoint-compaction))
            (owner (fn2-checkpoint-compaction-owner-slot 0 fn2-checkpoint-compaction))
            (gen (fn2-checkpoint-compaction-owner-gen 0 fn2-checkpoint-compaction)))
       (and (fn2-checkpoint-compaction-key-disjoint-p 0 key fn2-checkpoint-windows)
            (eq (fn2-pool-workspace-code best (fn2-checkpoint-windows-generation 14 fn2-checkpoint-windows) kind owner gen fn2-pool) :ok)
            (eq (fn2-pool-workspace-code key (fn2-checkpoint-windows-generation *fn2-checkpoint-compaction-key-window* fn2-checkpoint-windows) kind owner gen fn2-pool) :ok)
            (<= *fn2-run-layout-max-entry-bytes* (fn2-pool-cap best fn2-pool))
            (<= *fn2-run-layout-max-entry-bytes* (fn2-pool-cap key fn2-pool))))))

(defun fn2-checkpoint-compaction-configure
 (fn2-checkpoint-compaction fn2-checkpoint-root1 fn2-checkpoint-windows fn2-checkpoint-build fn2-csnapshot fn2-checkpoints
  fn2-overlays fn2-run-installed fn2-run-cursors fn2-fc fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-compaction fn2-checkpoint-root1 fn2-checkpoint-windows fn2-checkpoint-build fn2-csnapshot fn2-checkpoints
 fn2-overlays fn2-run-installed fn2-run-cursors fn2-fc fn2-fields fn2-pool)
 :guard (and (fn2-checkpoint-compaction-wfp fn2-checkpoint-compaction) (fn2-checkpoint-root1-wfp fn2-checkpoint-root1)
 (fn2-checkpoint-windows-wfp fn2-checkpoint-windows) (fn2-checkpoint-build-wfp fn2-checkpoint-build) (fn2-csnapshot-wfp fn2-csnapshot)
 (fn2-checkpoints-wfp fn2-checkpoints) (fn2-overlays-wfp fn2-overlays) (fn2-run-installed-wfp fn2-run-installed)
 (fn2-run-cursors-wfp fn2-run-cursors) (fn2-fc-wfp fn2-fc) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (fn2-checkpoint-compaction-ownerp fn2-checkpoint-compaction fn2-checkpoint-build fn2-csnapshot fn2-checkpoints fn2-overlays fn2-run-installed)
                    (fn2-checkpoint-compaction-windowsp fn2-checkpoint-compaction fn2-checkpoint-root1 fn2-checkpoint-windows fn2-csnapshot fn2-pool)
                    (equal (fn2-checkpoint-compaction-phase 0 fn2-checkpoint-compaction) *fn2-checkpoint-compaction-phase-schema*)
                    (equal (fn2-checkpoint-root1-phase 0 fn2-checkpoint-root1) *fn2-checkpoint-root1-phase-select*)
                    (equal (fn2-checkpoint-compaction-configured 0 fn2-checkpoint-compaction) 0)
                    (equal (fn2-checkpoint-compaction-scan-kind 0 fn2-checkpoint-compaction) 0)
                    (equal (fn2-checkpoint-compaction-scan-row 0 fn2-checkpoint-compaction) 0)))
       (mv :source fn2-checkpoint-compaction))
      (fcrows (fn2-fc-rows fn2-fc))
      (eb (fn2-checkpoint-source-ebase fcrows))
      (lb (fn2-checkpoint-manifest-ebase fcrows))
      (rb (fn2-checkpoint-source-rbase fcrows))
      (ib (+ rb *fn2-run-reader-entry*))
      (c (fn2-b-checkpoint-source-cursor-from-rows (fn2-run-cursors-rows fn2-run-cursors)))
      ((unless (and (fn2-b-fixed-cursor-rows-p (fn2-run-cursors-rows fn2-run-cursors))
                    (< c (fn2-run-cursors-rows fn2-run-cursors))
                    (unsigned-byte-p 32 eb) (unsigned-byte-p 32 lb) (unsigned-byte-p 32 rb) (unsigned-byte-p 32 ib)
                    (<= (+ eb *fn2-run-entry-rows*) lb)
                    (<= (+ lb *fn2-run-entry-rows*) rb)
                    (<= (+ rb *fn2-run-reader-fields*) (fn2-fields-rows fn2-fields))))
       (mv :fields fn2-checkpoint-compaction))
      (fn2-checkpoint-compaction (fn2-checkpoint-compaction-put 0
       (configured 1) (cursor c) (reader-base rb) (entry-base eb) (lower-base lb) (input-base ib)
       (best-slot (fn2-checkpoint-windows-slot 14 fn2-checkpoint-windows))
       (best-gen (fn2-checkpoint-windows-generation 14 fn2-checkpoint-windows))
       (lower-slot (fn2-checkpoint-windows-slot *fn2-checkpoint-compaction-key-window* fn2-checkpoint-windows))
       (lower-gen (fn2-checkpoint-windows-generation *fn2-checkpoint-compaction-key-window* fn2-checkpoint-windows)))))
  (mv :ok fn2-checkpoint-compaction)))

; Additive accumulator execution; frozen profile codec subjects stay unchanged.
; Tail recursion is a source property, not a native stack/performance claim.
(in-package "ACL2")
(include-book "substrate-commit-profile-codec")
(defun fn-stcp-enc-drive-acc (p c fuel used)
 (declare (xargs :guard (and (natp fuel) (natp used)) :measure (nfix fuel)))
 (if (or (zp fuel) (fn-stcp-terminalp c)) (mv c used)
  (fn-stcp-enc-drive-acc p (fn-stcp-enc-tick p c) (1- fuel) (+ 1 used))))
(defun fn-stcp-dec-drive-acc (p c fuel used)
 (declare (xargs :guard (and (natp fuel) (natp used)) :measure (nfix fuel)))
 (if (or (zp fuel) (fn-stcp-terminalp c)) (mv c used)
  (fn-stcp-dec-drive-acc p (fn-stcp-dec-tick p c) (1- fuel) (+ 1 used))))
(local (include-book "arithmetic/top" :dir :system))
(local (defthm fn-stcp-enc-drive-count-is-natural
 (natp (mv-nth 1 (fn-stcp-enc-drive p c fuel)))
 :hints (("Goal" :induct (fn-stcp-enc-drive p c fuel)
  :in-theory (e/d (fn-stcp-enc-drive) (fn-stcp-enc-tick fn-stcp-terminalp))))))
(local (defthm fn-stcp-dec-drive-count-is-natural
 (natp (mv-nth 1 (fn-stcp-dec-drive p c fuel)))
 :hints (("Goal" :induct (fn-stcp-dec-drive p c fuel)
  :in-theory (e/d (fn-stcp-dec-drive) (fn-stcp-dec-tick fn-stcp-terminalp))))))
(defthm fn-stcp-enc-drive-acc-is-drive
 (and (equal (mv-nth 0 (fn-stcp-enc-drive-acc p c fuel used))
              (mv-nth 0 (fn-stcp-enc-drive p c fuel)))
      (implies (acl2-numberp used)
       (equal (mv-nth 1 (fn-stcp-enc-drive-acc p c fuel used))
               (+ used (mv-nth 1 (fn-stcp-enc-drive p c fuel))))))
 :hints (("Goal" :induct (fn-stcp-enc-drive-acc p c fuel used)
          :in-theory (e/d (fn-stcp-enc-drive-acc fn-stcp-enc-drive)
                          (fn-stcp-enc-tick fn-stcp-terminalp)))))
(defthm fn-stcp-dec-drive-acc-is-drive
 (and (equal (mv-nth 0 (fn-stcp-dec-drive-acc p c fuel used))
              (mv-nth 0 (fn-stcp-dec-drive p c fuel)))
      (implies (acl2-numberp used)
       (equal (mv-nth 1 (fn-stcp-dec-drive-acc p c fuel used))
               (+ used (mv-nth 1 (fn-stcp-dec-drive p c fuel))))))
 :hints (("Goal" :induct (fn-stcp-dec-drive-acc p c fuel used)
          :in-theory (e/d (fn-stcp-dec-drive-acc fn-stcp-dec-drive)
                          (fn-stcp-dec-tick fn-stcp-terminalp)))))
(defun fn-stcp-encode-resume-acc (p c)
 (declare (xargs :guard t))
 (fn-stcp-enc-drive-acc p c (if (fn-stcp-profilep p) (nfix (fn-stcp-at 3 p)) 1) 0))
(defun fn-stcp-decode-resume-acc (p c)
 (declare (xargs :guard t))
 (fn-stcp-dec-drive-acc p c (if (fn-stcp-profilep p) (nfix (fn-stcp-at 3 p)) 1) 0))
(defthm fn-stcp-encode-resume-acc-is-resume
 (and (equal (mv-nth 0 (fn-stcp-encode-resume-acc p c))
              (mv-nth 0 (fn-stcp-encode-resume p c)))
      (equal (mv-nth 1 (fn-stcp-encode-resume-acc p c))
              (mv-nth 1 (fn-stcp-encode-resume p c))))
 :hints (("Goal" :in-theory (e/d (fn-stcp-encode-resume-acc fn-stcp-encode-resume)
                          (fn-stcp-enc-drive-acc fn-stcp-enc-drive fn-stcp-profilep mv-nth nfix)))))
(defthm fn-stcp-decode-resume-acc-is-resume
 (and (equal (mv-nth 0 (fn-stcp-decode-resume-acc p c))
              (mv-nth 0 (fn-stcp-decode-resume p c)))
      (equal (mv-nth 1 (fn-stcp-decode-resume-acc p c))
              (mv-nth 1 (fn-stcp-decode-resume p c))))
 :hints (("Goal" :in-theory (e/d (fn-stcp-decode-resume-acc fn-stcp-decode-resume)
                          (fn-stcp-dec-drive-acc fn-stcp-dec-drive fn-stcp-profilep mv-nth nfix)))))

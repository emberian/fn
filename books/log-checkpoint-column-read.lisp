; Coordinator option A: validate on first column read; failures do not
; select another checkpoint and never masquerade as durable nonacceptance.
(in-package "ACL2")
(include-book "log-checkpoint-header")
(include-book "defkeystone")

(defun fn-lc-column-validation-key (txid column entry)
 (declare (xargs :guard t))
 (list txid column (fn-lc-head entry) (fn-lc-at 2 entry)))
(defun fn-lc-column-first-read (txid column entry pages checked)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((key (fn-lc-column-validation-key txid column entry))
        (page (pgs-lookup (fn-lc-head entry) pages))
        (actual (pgs-digest page))
        (expected (fn-lc-at 2 entry))
        (trace (list (list :pread :column (list column (fn-lc-head entry)) (fn-lc-page-octets)))))
  (if (or (ec-call (member-equal key checked))
          (not (equal (ec-call (pgs-entry-verdict entry txid :eager actual)) :damaged)))
      (list :ok page (if (ec-call (member-equal key checked)) checked (cons key checked))
            trace pages nil)
    (list :uncertain nil checked trace pages
          (list :lc-column-page-damaged txid column expected actual)))))


(local (include-book "log-checkpoint-selection-proof"))
(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
 ; Controls are evaluated before the universal theorem.
 (assert-event (let* ((txid 3) (column :overview) (entry (list 7 3 (pgs-digest '(9)))) (pages '((7 9) (8 10))) (checked nil) (other 8))
  (let* ((key (fn-lc-column-validation-key txid column entry))
        (page (pgs-lookup (fn-lc-head entry) pages))
        (actual (pgs-digest page))
        (expected (fn-lc-at 2 entry))
        (out (fn-lc-column-first-read txid column entry pages checked)))
  (and (equal (fn-lc-at 4 out) pages)
       (equal (pgs-lookup other (fn-lc-at 4 out)) (pgs-lookup other pages))
       (equal (fn-lc-at 3 out)
              (list (list :pread :column (list column (fn-lc-head entry)) (fn-lc-page-octets))))
       (if (or (member-equal key checked) (equal expected actual))
           (and (equal (fn-lc-head out) :ok)
                (equal (fn-lc-at 1 out) page)
                (equal (fn-lc-at 5 out) nil)
                (member-equal key (fn-lc-at 2 out)))
         (and (equal (fn-lc-head out) :uncertain)
              (equal (fn-lc-at 1 out) nil)
              (equal (fn-lc-at 2 out) checked)
              (equal (fn-lc-at 5 out)
                     (list :lc-column-page-damaged txid column expected actual))))))))
 (assert-event (let* ((txid 3) (column :overview) (entry (list 7 3 (+ 1 (pgs-digest '(9))))) (pages '((7 9) (8 10))) (checked nil) (other 8))
 (and  (let* ((key (fn-lc-column-validation-key txid column entry))
        (page (pgs-lookup (fn-lc-head entry) pages))
        (actual (pgs-digest page))
        (expected (fn-lc-at 2 entry))
        (out (fn-lc-column-first-read txid column entry pages checked)))
  (and (equal (fn-lc-at 4 out) pages)
       (equal (pgs-lookup other (fn-lc-at 4 out)) (pgs-lookup other pages))
       (equal (fn-lc-at 3 out)
              (list (list :pread :column (list column (fn-lc-head entry)) (fn-lc-page-octets))))
       (if (or (member-equal key checked) (equal expected actual))
           (and (equal (fn-lc-head out) :ok)
                (equal (fn-lc-at 1 out) page)
                (equal (fn-lc-at 5 out) nil)
                (member-equal key (fn-lc-at 2 out)))
         (and (equal (fn-lc-head out) :uncertain)
              (equal (fn-lc-at 1 out) nil)
              (equal (fn-lc-at 2 out) checked)
              (equal (fn-lc-at 5 out)
                     (list :lc-column-page-damaged txid column expected actual))))))
 (not  (let* ((key (fn-lc-column-validation-key txid column entry))
        (page (pgs-lookup (fn-lc-head entry) pages))
        (actual (pgs-digest page))
        (expected (fn-lc-at 2 entry))
        (out (fn-lc-column-first-read txid column entry pages checked)))
(and (equal (fn-lc-at 4 out) pages)
       (equal (pgs-lookup other (fn-lc-at 4 out)) (pgs-lookup other pages))
       (equal (fn-lc-at 3 out)
              (list (list :pread :column (list column (fn-lc-head entry)) (fn-lc-page-octets))))
       (if (or (member-equal key checked) (equal expected actual))
           (and (equal (fn-lc-head out) :ok)
                (equal (fn-lc-at 1 out) page)
                (equal (fn-lc-at 5 out) nil)
                (member-equal key (fn-lc-at 2 out)))
         (and (equal (fn-lc-head out) :refused)
              (equal (fn-lc-at 1 out) nil)
              (equal (fn-lc-at 2 out) checked)
              (equal (fn-lc-at 5 out)
                     (list :lc-column-page-damaged txid column expected actual))))))))))
)
(defthm fn-lc-column-first-read-validates
 (let* ((key (fn-lc-column-validation-key txid column entry))
        (page (pgs-lookup (fn-lc-head entry) pages))
        (actual (pgs-digest page))
        (expected (fn-lc-at 2 entry))
        (out (fn-lc-column-first-read txid column entry pages checked)))
  (and (equal (fn-lc-at 4 out) pages)
       (equal (pgs-lookup other (fn-lc-at 4 out)) (pgs-lookup other pages))
       (equal (fn-lc-at 3 out)
              (list (list :pread :column (list column (fn-lc-head entry)) (fn-lc-page-octets))))
       (if (or (member-equal key checked) (equal expected actual))
           (and (equal (fn-lc-head out) :ok)
                (equal (fn-lc-at 1 out) page)
                (equal (fn-lc-at 5 out) nil)
                (member-equal key (fn-lc-at 2 out)))
         (and (equal (fn-lc-head out) :uncertain)
              (equal (fn-lc-at 1 out) nil)
              (equal (fn-lc-at 2 out) checked)
              (equal (fn-lc-at 5 out)
                     (list :lc-column-page-damaged txid column expected actual))))))
 :rule-classes nil
 :hints (("Goal" :in-theory (enable fn-lc-column-first-read pgs-entry-verdict pgs-entry-checked-p))))
(verify-guards fn-lc-column-first-read)
(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
 (defteeth fn-lc-column-first-read-validates
 :claim  (let* ((key (fn-lc-column-validation-key txid column entry))
        (page (pgs-lookup (fn-lc-head entry) pages))
        (actual (pgs-digest page))
        (expected (fn-lc-at 2 entry))
        (out (fn-lc-column-first-read txid column entry pages checked)))
  (() (and (equal (fn-lc-at 4 out) pages)
       (equal (pgs-lookup other (fn-lc-at 4 out)) (pgs-lookup other pages))
       (equal (fn-lc-at 3 out)
              (list (list :pread :column (list column (fn-lc-head entry)) (fn-lc-page-octets))))
       (if (or (member-equal key checked) (equal expected actual))
           (and (equal (fn-lc-head out) :ok)
                (equal (fn-lc-at 1 out) page)
                (equal (fn-lc-at 5 out) nil)
                (member-equal key (fn-lc-at 2 out)))
         (and (equal (fn-lc-head out) :uncertain)
              (equal (fn-lc-at 1 out) nil)
              (equal (fn-lc-at 2 out) checked)
              (equal (fn-lc-at 5 out)
                     (list :lc-column-page-damaged txid column expected actual)))))))
 :subject fn-lc-column-first-read
 :witness ((txid 3) (column :overview) (entry (list 7 3 (pgs-digest '(9)))) (pages '((7 9) (8 10))) (checked nil) (other 8))
 :breaks nil
 :mutations ((wrong-answer-class (:conclusion (and (equal (fn-lc-at 4 out) pages)
       (equal (pgs-lookup other (fn-lc-at 4 out)) (pgs-lookup other pages))
       (equal (fn-lc-at 3 out)
              (list (list :pread :column (list column (fn-lc-head entry)) (fn-lc-page-octets))))
       (if (or (member-equal key checked) (equal expected actual))
           (and (equal (fn-lc-head out) :ok)
                (equal (fn-lc-at 1 out) page)
                (equal (fn-lc-at 5 out) nil)
                (member-equal key (fn-lc-at 2 out)))
         (and (equal (fn-lc-head out) :refused)
              (equal (fn-lc-at 1 out) nil)
              (equal (fn-lc-at 2 out) checked)
              (equal (fn-lc-at 5 out)
                     (list :lc-column-page-damaged txid column expected actual))))))
 ((txid 3) (column :overview) (entry (list 7 3 (+ 1 (pgs-digest '(9))))) (pages '((7 9) (8 10))) (checked nil) (other 8))
 :fault "media damage was called refused instead of uncertain"))))
(defteeth-check (fn-lc-column-first-read-validates))

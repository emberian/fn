; Private candidate investigation, before selected allocator projection.
; The descriptor and archive row retain authority across reusable IO scratch.
(in-package "ACL2")
(include-book "event-archive-cold-header")
(fn2-book-layer :c)
(defun fn2-event-archive-cold-descriptor-current-p (i c fn2-checkpoint-bytes fn2-event-archive)
 (declare (xargs :stobjs (fn2-checkpoint-bytes fn2-event-archive)
 :measure (nfix (- 32 (nfix i)))
 :guard (and (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-event-archive-wfp fn2-event-archive)
             (natp i) (<= i 32) (natp c) (<= (+ (* 192 c) 192) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes)))))
 (or (>= (nfix i) 32)
  (and (equal (fn2-event-archive-descriptori (+ 32 i) fn2-event-archive)
              (fn2-checkpoint-bytes-value (+ (* 192 c) i) fn2-checkpoint-bytes))
       (fn2-event-archive-cold-descriptor-current-p (+ 1 (nfix i)) c fn2-checkpoint-bytes fn2-event-archive))))

(defun fn2-event-archive-cold-source-p (fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 :guard (and (fn2-event-archive-wfp fn2-event-archive) (fn2-checkpoints-wfp fn2-checkpoints)
             (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes))))
 (and (< 1 (fn2-event-archive-rows fn2-event-archive))
      (equal (fn2-event-archive-origin 1 fn2-event-archive) *fn2-event-archive-origin-cold*)
      (member (fn2-event-archive-phase 1 fn2-event-archive)
       (list *fn2-event-archive-phase-cold-header* *fn2-event-archive-phase-cold-manifest* *fn2-event-archive-phase-cold-members*))
      (let* ((c (fn2-event-archive-candidate 1 fn2-event-archive)) (r (+ (* 6 c) 3)))
       (and (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
            (equal (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-checked*)
            (posp (fn2-checkpoints-anchor-mask c fn2-checkpoints))
            (equal (fn2-checkpoints-builder-token c fn2-checkpoints) 0)
            (fn2-event-archive-cold-descriptor-current-p 0 c fn2-checkpoint-bytes fn2-event-archive)
            (equal (fn2-checkpoints-checkpoint c fn2-checkpoints) (fn2-event-archive-checkpoint 1 fn2-event-archive))
            (equal (fn2-checkpoints-history c fn2-checkpoints) (fn2-event-archive-history 1 fn2-event-archive))
            (equal (fn2-checkpoints-incarnation c fn2-checkpoints) (fn2-event-archive-incarnation 1 fn2-event-archive))
            (equal (fn2-checkpoints-cut-commit c fn2-checkpoints) (fn2-event-archive-cut-commit 1 fn2-event-archive))
            (equal (fn2-checkpoints-cut-event c fn2-checkpoints) (fn2-event-archive-cut-event 1 fn2-event-archive))
            (equal (fn2-checkpoint-refs-storage-domain r fn2-checkpoint-refs) 0)
            (equal (fn2-checkpoint-refs-page-kind r fn2-checkpoint-refs) *page-kind-manifest*)
            (equal (fn2-checkpoint-refs-encoded-length r fn2-checkpoint-refs) *fn2-format-page-size*)
            (equal (fn2-checkpoint-refs-physical-unit r fn2-checkpoint-refs) (fn2-event-archive-header-unit 1 fn2-event-archive))
            (equal (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs) (fn2-event-archive-header-epoch 1 fn2-event-archive))
            (equal (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs) (fn2-event-archive-header-allocation 1 fn2-event-archive))))))

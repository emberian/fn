; Constant-time binding of the completed bootstrap producer to its live owner.
(in-package "ACL2")
(include-book "boot-config-state")
(include-book "origin")
(fn2-book-layer :b)

(defun fn2-boot-bootstrap-receipt-p (kind id ogen fn2-boot-config fn2-origin)
 (declare (xargs :stobjs (fn2-boot-config fn2-origin)
  :guard (and (fn2-boot-config-wfp fn2-boot-config) (fn2-origin-wfp fn2-origin))))
 (and (unsigned-byte-p 8 kind) (unsigned-byte-p 32 id)
      (posp ogen) (unsigned-byte-p 60 ogen)
      (equal kind (fn2-boot-config-bootstrap-owner-kind fn2-boot-config))
      (equal id (fn2-boot-config-bootstrap-owner-slot fn2-boot-config))
      (equal ogen (fn2-boot-config-bootstrap-owner-gen fn2-boot-config))
      (posp (fn2-boot-config-image-size fn2-boot-config))
      (fn2-origin-tuplep (fn2-origin-lineage fn2-origin) (fn2-origin-domain fn2-origin)
                        (fn2-origin-incarnation fn2-origin))
      (fn2-origin-physicalp (fn2-origin-history fn2-origin) (fn2-origin-history-incarnation fn2-origin))
      (equal (fn2-origin-domain fn2-origin) (fn2-boot-config-bootstrap-domain fn2-boot-config))
      (equal (fn2-origin-lineage fn2-origin) (fn2-boot-config-bootstrap-lineage fn2-boot-config))
      (equal (fn2-origin-incarnation fn2-origin) (fn2-boot-config-bootstrap-incarnation fn2-boot-config))
      (equal (fn2-origin-history fn2-origin) (fn2-boot-config-bootstrap-history fn2-boot-config))
      (equal (fn2-origin-history-incarnation fn2-origin)
             (fn2-boot-config-bootstrap-history-incarnation fn2-boot-config))))

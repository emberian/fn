        (fn2-checkpoint-metadata-role b fn2-checkpoint-metadata fn2-run-builds) (fn2-checkpoint-metadata-ordinal 0 fn2-checkpoint-metadata)
        *fn2-run-page-size* fn2-csnapshot fn2-checkpoint-construction fn2-extents fn2-control))

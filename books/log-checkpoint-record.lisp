; LC model record effect over LB's actual generated columns and indexes.
; The row producer assigns numbers from the carried group-next cells.  This
; operation does not revalidate the resident correspondence.
(in-package "ACL2")
(include-book "log-locator-resolves")
(include-book "catalog-columns-guards")
(include-book "log-checkpoint-total-accessors")

(defun fn-lc-fresh-recordp (h loc0 loc1 segs)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((entry (ec-call (fn-lb-log-model-row-entry h segs)))
        (segment (ec-call (fn-lb-log-model-row-segment h segs))))
  (and (fn-held-p h) (fn-locp loc0 loc1) (fn-lc-segsp segs)
       (fn-lb-log-model-entryp entry)
       (equal segment (fn-loc-segment loc0 loc1))
       (equal (fn-lc-at 3 entry) (fn-loc-offset loc0 loc1))
       (equal (fn-lc-at 4 entry) (fn-loc-len loc0 loc1))
       (equal (fn-lc-at 7 entry) (fn-lb-log-model-homes h))
       (ec-call (fn-arx-entry-ok
                  (ec-call (fn-lb-entry-octets segment (fn-lc-at 3 entry) segs))
                  (ec-call (fn-lb-entry-protected-len segment (fn-lc-at 3 entry) segs))))
       (equal (ec-call (fn-lc-read-range loc0 loc1 segs))
              (fn-lc-expected-range (fn-lc-at 6 entry)))
       (equal (ec-call (fn-lc-read-home-frame
                         (fn-lc-home-position loc0 loc1) segs))
              (ec-call (fn-lc-expected-home-frame h))))))

(defun fn-lc-assign-numbers (groups fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (if (consp groups)
     (cons (cons (car groups) (ec-call (fn-lbc-summary-word (car groups) 4 fn-lbc)))
           (fn-lc-assign-numbers (cdr groups) fn-lbc))
   nil))

(defun fn-lc-commit-group-cells (numbers seen livep fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (if (consp numbers)
     (let* ((g (fn-lc-head (car numbers)))
            (n (nfix (fn-lc-rest (car numbers))))
            (summary (ec-call (fn-lbc-live-summary g fn-lbc)))
            (live (and livep (posp n) (<= n *fn-nntp-max-article-number*)))
            (values (list (+ (nfix (fn-lc-at 0 summary)) (if live 1 0))
                          (if (and live (equal (fn-lc-at 1 summary) 0)) n
                            (fn-lc-at 1 summary))
                          (if live n (fn-lc-at 2 summary)) (+ 1 n)))
            (fn-lbc (if (member-equal g (true-list-fix seen)) fn-lbc
                       (ec-call (fn-lbc-summary-put g values 1 fn-lbc)))))
       (fn-lc-commit-group-cells (cdr numbers) (cons g seen) livep fn-lbc))
   fn-lbc))

(defun fn-lc-clear-slot-owners (keys fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (if (consp keys)
     (let* ((key (car keys))
            (cell (ec-call (fn-lbc-escape-store-get key fn-lbc)))
            (fn-lbc (ec-call (fn-lbc-escape-store-put key
                              (ec-call (remove-assoc-equal :msgid-slot cell)) fn-lbc))))
       (fn-lc-clear-slot-owners (cdr keys) fn-lbc))
   fn-lbc))

(defun fn-lc-reindex-slots (fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((n (fn-lbc-count fn-lbc))
        (fn-lbc (fn-lc-clear-slot-owners (fn-lbc-slot-escape-keys fn-lbc) fn-lbc))
        (fn-lbc (update-fn-lbc-slot-escape-keys nil fn-lbc))
        (fn-lbc (stobj-let ((fn-lbc-msgid-slots (fn-lbc-slot-store fn-lbc)))
                  (fn-lbc-msgid-slots)
                  (fn-lbc-msgid-slots-clear fn-lbc-msgid-slots) fn-lbc))
        (fn-lbc (ec-call (fn-lbc-reserve-slots (+ 1 (* 2 n)) fn-lbc))))
   (ec-call (fn-lbc-index-slots 0 n fn-lbc))))

(defun fn-lc-commit-record (h loc0 loc1 fn-lbc segs)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (if (not (fn-lc-fresh-recordp h loc0 loc1 segs))
     (mv :invalid-record fn-lbc segs)
   (let* ((i (fn-lbc-count fn-lbc))
          (numbers (fn-lc-assign-numbers (fn-record-groups h) fn-lbc))
          (row (fn-held-with-numbers h numbers))
          (groups (ec-call (fn-lbc-number-group-keys numbers)))
          (old-groups (fn-lbc-summary-groups fn-lbc))
          (fn-lbc (ec-call (fn-lbc-append-row row segs fn-lbc)))
          (fn-lbc (ec-call (fn-lbc-number-put-row numbers i fn-lbc)))
          (fn-lbc (fn-lc-commit-group-cells numbers nil
                     (fn-cat-live-candidatep h) fn-lbc))
          (fn-lbc (update-fn-lbc-summary-groups
                     (ec-call (union-equal old-groups groups)) fn-lbc))
          (fn-lbc (fn-lc-reindex-slots fn-lbc)))
     (mv :ok fn-lbc segs))))

(verify-guards fn-lc-fresh-recordp)
(verify-guards fn-lc-assign-numbers)
(verify-guards fn-lc-commit-group-cells)
(verify-guards fn-lc-clear-slot-owners)
(verify-guards fn-lc-reindex-slots)
(verify-guards fn-lc-commit-record)

 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-bytes fn2-checkpoint-publication fn2-checkpoint-payload-proofs fn2-csnapshot fn2-extents fn2-ops fn2-alloc-edges fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control fn2-event-archive fn2-release-evidence-candidates fn2-checkpoint-construction fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection) :verify-guards nil
 :guard (and (fn2-checkpoint-teardown-debtp fn2-checkpoint-teardown-debt) (fn2-checkpoint-teardown-debt-wfp fn2-checkpoint-teardown-debt)
             (fn2-checkpoint-bytesp fn2-checkpoint-bytes) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
             (fn2-checkpoint-publicationp fn2-checkpoint-publication) (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
             (fn2-checkpoint-payload-proofsp fn2-checkpoint-payload-proofs) (fn2-checkpoint-payload-proofs-wfp fn2-checkpoint-payload-proofs)
             (fn2-csnapshotp fn2-csnapshot) (fn2-csnapshot-wfp fn2-csnapshot)
             (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents)
             (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops)
             (fn2-alloc-edgesp fn2-alloc-edges) (fn2-alloc-edges-wfp fn2-alloc-edges)
             (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints)

 (b* (((unless (and (fn2-checkpoint-dispose-current-p c token kind slot gen generation fn2-checkpoint-teardown-debt fn2-checkpoints fn2-checkpoint-bytes)
                     (= (fn2-checkpoint-teardown-debt-dispose-phase c fn2-checkpoint-teardown-debt) *fn2-checkpoint-dispose-phase-sources*)))
       (mv :state fn2-checkpoint-teardown-debt fn2-extents fn2-alloc-edges))

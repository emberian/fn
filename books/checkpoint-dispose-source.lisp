      ((unless (eq code :ok)) (mv code fn2-checkpoint-teardown-debt fn2-extents fn2-alloc-edges))
      (e (fn2-checkpoint-teardown-debt-dispose-cursor c fn2-checkpoint-teardown-debt))
      (n (fn2-extents-rows fn2-extents))
      ((unless (<= e n)) (mv :state fn2-checkpoint-teardown-debt fn2-extents fn2-alloc-edges))
      ((when (= e n))
       (let ((fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-put c (dispose-phase *fn2-checkpoint-dispose-phase-cold*) (dispose-cursor 0))))
        (mv :more fn2-checkpoint-teardown-debt fn2-extents fn2-alloc-edges)))
      (edge (fn2-checkpoint-source-edge c e fn2-extents fn2-ops fn2-checkpoints))
      ((unless (fn2-alloc-edge-slotp edge fn2-alloc-edges)) (mv :edge fn2-checkpoint-teardown-debt fn2-extents fn2-alloc-edges))
      ((when (= (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-free*))
       (let ((fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-set-dispose-cursor c (+ e 1) fn2-checkpoint-teardown-debt)))
        (mv :more fn2-checkpoint-teardown-debt fn2-extents fn2-alloc-edges)))
      (epoch (fn2-extents-epoch e fn2-extents)) (allocation (fn2-extents-counter e fn2-extents))
      (checkpoint (fn2-checkpoint-teardown-debt-checkpoint c fn2-checkpoint-teardown-debt))
      ((unless (and (< 0 (fn2-extents-selectable-checkpoint e fn2-extents))
                    (fn2-alloc-edge-matchesp edge checkpoint e epoch allocation :selectable-checkpoint fn2-alloc-edges)))
       (mv :identity fn2-checkpoint-teardown-debt fn2-extents fn2-alloc-edges))
      ((unless (= (fn2-extents-obligation e fn2-extents) 0)) (mv :obligation fn2-checkpoint-teardown-debt fn2-extents fn2-alloc-edges))
      ((unless (or (fn2-checkpoint-owned-provenance-p kind e fn2-checkpoint-construction fn2-extents)
                   (fn2-checkpoint-dispose-journal-source-p commit-kind e fn2-extents fn2-alloc-edges)
                   (fn2-checkpoint-payload-proof-p (fn2-extents-owner-kind e fn2-extents) e epoch allocation fn2-checkpoint-payload-proofs fn2-extents)
                   (fn2-checkpoint-dispose-cold-payload-p 0 c e epoch allocation fn2-checkpoint-teardown-debt fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-extents fn2-ops fn2-checkpoints fn2-alloc-edges)))
       (mv :classification fn2-checkpoint-teardown-debt fn2-extents fn2-alloc-edges))
      ((mv code fn2-extents fn2-alloc-edges) (fn2-alloc-edge-drop edge checkpoint e epoch allocation :selectable-checkpoint fn2-extents fn2-alloc-edges))
      ((unless (eq code :ok)) (mv code fn2-checkpoint-teardown-debt fn2-extents fn2-alloc-edges))
      (fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-set-dispose-cursor c (+ e 1) fn2-checkpoint-teardown-debt)))
  (mv :more fn2-checkpoint-teardown-debt fn2-extents fn2-alloc-edges)))


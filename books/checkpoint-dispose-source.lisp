             (fn2-checkpoint-summary-authorityp fn2-checkpoint-summary-authority) (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority)
             (fn2-checkpoint-cbase-holdsp fn2-checkpoint-cbase-holds) (fn2-checkpoint-cbase-holds-wfp fn2-checkpoint-cbase-holds)
             (fn2-checkpoint-restore-eventsp fn2-checkpoint-restore-events) (fn2-checkpoint-restore-events-wfp fn2-checkpoint-restore-events)
             (fn2-directory-rebasep fn2-directory-rebase) (fn2-directory-rebase-wfp fn2-directory-rebase)

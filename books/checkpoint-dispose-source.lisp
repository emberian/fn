(defun fn2-checkpoint-dispose-journal-source-p (commit-kind e fn2-extents fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-extents fn2-alloc-edges) :verify-guards nil
 :guard (and (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents)
             (fn2-alloc-edgesp fn2-alloc-edges) (fn2-alloc-edges-wfp fn2-alloc-edges))))
 (and (unsigned-byte-p 8 commit-kind) (fn2-alloc-slotp e fn2-extents)
      (= (fn2-extents-owner-kind e fn2-extents) commit-kind)
      (posp (fn2-extents-owner-id e fn2-extents))
      (if (member-equal (fn2-extents-state e fn2-extents) (list *fn2-extent-state-allocated* *fn2-extent-state-retire-pending*)) t nil)
      (= (fn2-extents-release-pending e fn2-extents) 0)
      (< 0 (fn2-extents-installed-root e fn2-extents))
      (let ((edge (+ 7 (* 2 e))))
       (and (fn2-alloc-edge-slotp edge fn2-alloc-edges)
            (fn2-alloc-edge-matchesp edge (fn2-extents-owner-id e fn2-extents) e
             (fn2-extents-epoch e fn2-extents) (fn2-extents-counter e fn2-extents) :installed-root fn2-alloc-edges)))))

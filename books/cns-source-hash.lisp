;; Incremental stored-article hashing. The source actor retains ROW, lease
;; identity and stream offset; these primitives do not grant source authority.
;; A stream uses its dedicated CNS row, never the CTL frame or block verifier.
(in-package "ACL2")
(include-book "block-integrity")
(fn2-book-layer :b)
(defun fn2-cns-source-hash-begin (row fn2-b3 fn2-digests)
 (declare (xargs :stobjs (fn2-b3 fn2-digests) :guard t))
 (let ((key (fn2-digest-slot (nfix row) *fn2-b3-key*)))
  (if (not (and (natp row) (fn2-b3-ready row fn2-b3 fn2-digests)
                (fn2-digest-rowp key fn2-digests)))
      (mv :bounds fn2-b3 fn2-digests)
    (mv-let (fn2-digests fn2-b3) (fn2-b3-init row 0 key fn2-digests fn2-b3)
      (mv :ok fn2-b3 fn2-digests)))))
(defun fn2-cns-source-hash-update (row slot gen off len kind owner generation fn2-b3 fn2-digests fn2-pool)
 (declare (xargs :stobjs (fn2-b3 fn2-digests fn2-pool)
                 :guard (fn2-pool-wfp fn2-pool)))
 (if (not (and (natp row) (fn2-b3-ready row fn2-b3 fn2-digests)
               (unsigned-byte-p 32 off) (posp len) (<= len 1024)))
     (mv :bounds 0 fn2-b3 fn2-digests)
   (mv-let (code used fn2-digests fn2-b3)
     (fn2-b3-update row slot gen off len kind owner generation fn2-digests fn2-b3 fn2-pool)
     (mv code used fn2-b3 fn2-digests))))
(defun fn2-cns-source-hash-finish (row slot gen expected kind owner generation fn2-b3 fn2-digests fn2-pool)
 (declare (xargs :stobjs (fn2-b3 fn2-digests fn2-pool)
                 :guard (fn2-pool-wfp fn2-pool)))
 (let ((got (fn2-digest-slot (nfix row) *fn2-b3-result*))
       (scratch (fn2-digest-slot (nfix row) *fn2-fc-hash*)))
  (if (not (and (natp row) (fn2-b3-ready row fn2-b3 fn2-digests)
                (fn2-digest-rowp got fn2-digests) (fn2-digest-rowp scratch fn2-digests)
                (natp expected)))
      (mv :bounds fn2-b3 fn2-digests)
    (let ((fn2-digests (fn2-b3-finalize got row fn2-digests fn2-b3)))
     (mv-let (same fn2-digests)
       (fn2-block-digest-at got scratch slot gen expected kind owner generation fn2-digests fn2-pool)
       (mv (if same :ok :identity) fn2-b3 fn2-digests))))))

(defthm fn2-cns-source-hash-begin-shape
 (implies (and (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3) (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests))
  (let ((b (mv-nth 1 (fn2-cns-source-hash-begin row fn2-b3 fn2-digests))) (d (mv-nth 2 (fn2-cns-source-hash-begin row fn2-b3 fn2-digests))))
   (and (fn2-b3p b) (fn2-b3-wfp b) (equal (fn2-b3-rows b) (fn2-b3-rows fn2-b3))
        (equal (fn2-b3-words-length b) (fn2-b3-words-length fn2-b3))
        (fn2-digestsp d) (fn2-digests-wfp d) (equal (fn2-digests-rows d) (fn2-digests-rows fn2-digests)))))
 :hints (("Goal" :in-theory (disable fn2-b3p fn2-b3-wfp fn2-b3-rows fn2-digestsp fn2-digests-wfp fn2-digests-rows))))
(fn2-b3-preserves fn2-cns-source-hash-begin (row fn2-b3 fn2-digests)
 :hyps ((fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3) (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests))
 :specs (("-B3-TYPE" fn2-b3p 1) ("-B3-WFP" fn2-b3-wfp 1) ("-B3-ROWS" fn2-b3-rows 1 :frame fn2-b3)
         ("-B3-WORDS" fn2-b3-words-length 1 :frame fn2-b3)
         ("-DIGESTS-TYPE" fn2-digestsp 2) ("-DIGESTS-WFP" fn2-digests-wfp 2) ("-DIGESTS-ROWS" fn2-digests-rows 2 :frame fn2-digests))
 :hints (("Goal" :use fn2-cns-source-hash-begin-shape :in-theory (disable fn2-cns-source-hash-begin fn2-b3p fn2-b3-wfp fn2-b3-rows fn2-digestsp fn2-digests-wfp fn2-digests-rows))))
(in-theory (disable fn2-cns-source-hash-begin))

(defthm fn2-cns-source-hash-update-shape
 (implies (and (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3) (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
  (let ((b (mv-nth 2 (fn2-cns-source-hash-update row slot gen off len kind owner generation fn2-b3 fn2-digests fn2-pool))) (d (mv-nth 3 (fn2-cns-source-hash-update row slot gen off len kind owner generation fn2-b3 fn2-digests fn2-pool))))
   (and (fn2-b3p b) (fn2-b3-wfp b) (equal (fn2-b3-rows b) (fn2-b3-rows fn2-b3))
        (equal (fn2-b3-words-length b) (fn2-b3-words-length fn2-b3))
        (fn2-digestsp d) (fn2-digests-wfp d) (equal (fn2-digests-rows d) (fn2-digests-rows fn2-digests)))))
 :hints (("Goal" :in-theory (disable fn2-b3p fn2-b3-wfp fn2-b3-rows fn2-digestsp fn2-digests-wfp fn2-digests-rows))))
(fn2-b3-preserves fn2-cns-source-hash-update (row slot gen off len kind owner generation fn2-b3 fn2-digests fn2-pool)
 :hyps ((fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3) (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
 :specs (("-B3-TYPE" fn2-b3p 2) ("-B3-WFP" fn2-b3-wfp 2) ("-B3-ROWS" fn2-b3-rows 2 :frame fn2-b3)
         ("-B3-WORDS" fn2-b3-words-length 2 :frame fn2-b3)
         ("-DIGESTS-TYPE" fn2-digestsp 3) ("-DIGESTS-WFP" fn2-digests-wfp 3) ("-DIGESTS-ROWS" fn2-digests-rows 3 :frame fn2-digests))
 :hints (("Goal" :use fn2-cns-source-hash-update-shape :in-theory (disable fn2-cns-source-hash-update fn2-b3p fn2-b3-wfp fn2-b3-rows fn2-digestsp fn2-digests-wfp fn2-digests-rows))))
(in-theory (disable fn2-cns-source-hash-update))

(defthm fn2-cns-source-hash-finish-shape
 (implies (and (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3) (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
  (let ((b (mv-nth 1 (fn2-cns-source-hash-finish row slot gen expected kind owner generation fn2-b3 fn2-digests fn2-pool))) (d (mv-nth 2 (fn2-cns-source-hash-finish row slot gen expected kind owner generation fn2-b3 fn2-digests fn2-pool))))
   (and (fn2-b3p b) (fn2-b3-wfp b) (equal (fn2-b3-rows b) (fn2-b3-rows fn2-b3))
        (equal (fn2-b3-words-length b) (fn2-b3-words-length fn2-b3))
        (fn2-digestsp d) (fn2-digests-wfp d) (equal (fn2-digests-rows d) (fn2-digests-rows fn2-digests)))))
 :hints (("Goal" :in-theory (disable fn2-b3p fn2-b3-wfp fn2-b3-rows fn2-digestsp fn2-digests-wfp fn2-digests-rows))))
(fn2-b3-preserves fn2-cns-source-hash-finish (row slot gen expected kind owner generation fn2-b3 fn2-digests fn2-pool)
 :hyps ((fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3) (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
 :specs (("-B3-TYPE" fn2-b3p 1) ("-B3-WFP" fn2-b3-wfp 1) ("-B3-ROWS" fn2-b3-rows 1 :frame fn2-b3)
         ("-B3-WORDS" fn2-b3-words-length 1 :frame fn2-b3)
         ("-DIGESTS-TYPE" fn2-digestsp 2) ("-DIGESTS-WFP" fn2-digests-wfp 2) ("-DIGESTS-ROWS" fn2-digests-rows 2 :frame fn2-digests))
 :hints (("Goal" :use fn2-cns-source-hash-finish-shape :in-theory (disable fn2-cns-source-hash-finish fn2-b3p fn2-b3-wfp fn2-b3-rows fn2-digestsp fn2-digests-wfp fn2-digests-rows))))
(in-theory (disable fn2-cns-source-hash-finish))

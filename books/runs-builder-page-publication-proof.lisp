; Starting with the page written at this level, at most seventy builder
; steps publish its address. Further steps see the original pending rows.
(in-package "ACL2")
(include-book "runs-builder-seal-driver-proof")
(include-book "runs-page-seal-completion-proof")

(defthmd fn2-run-builder-publishes-written-page
  (let* ((w (+ l (fn2-run-builds-wbase 0 builds))) (hrow (+ l (fn2-run-builds-hbase 0 builds)))
         (base (fn2-run-writers-fields w writers)) (ctx (fn2-run-seal-context w 0 hrow writers previous-context))
         (drive (fn2-run-writer-page-drive 70 w writers fc ctx b3 f pool ds))
         (calls (fn2-run-page-check-calls 70 w writers fc ctx b3 f pool ds)))
    (implies (and (natp extra) (equal (fn2-run-builds-crow 0 builds) 0)
                  (fn2-run-build-sealing-at-p l builds writers restarts f fc ctx)
                  (fn2-run-seal-workspace-p w hrow writers fc ctx b3 f pool ds)
                  (fn2-run-written-page-ready-p w base writers f fc pool))
             (and (posp calls) (<= calls 70)
                  (equal (fn2-run-sealing-loop (+ calls extra) pages builds writers f fc b3 ds)
                         (fn2-run-sealing-loop extra (cons (fn2-run-sealed-address w writers) pages) (fn2-run-sealed-builds builds)
                               (fn2-run-writers-set-phase w *fn2-run-writer-phase-sealed* writers)
                               (mv-nth 3 drive) (mv-nth 1 drive) (mv-nth 2 drive) (mv-nth 5 drive))))))
  :hints (("Goal" :do-not '(preprocess)
           :use ((:instance fn2-run-format-driver-seals-written-page (w (+ l (fn2-run-builds-wbase 0 builds)))
                         (hrow (+ l (fn2-run-builds-hbase 0 builds))) (ctx previous-context)
                         (base (fn2-run-writers-fields (+ l (fn2-run-builds-wbase 0 builds)) writers)))
                 (:instance fn2-run-page-check-calls-fit-fuel (fuel 70) (w (+ l (fn2-run-builds-wbase 0 builds)))
                           (ctx (fn2-run-seal-context (+ l (fn2-run-builds-wbase 0 builds)) 0 (+ l (fn2-run-builds-hbase 0 builds)) writers previous-context)))
                 (:instance fn2-run-builder-continues-after-page-check (fuel 70) (w (+ l (fn2-run-builds-wbase 0 builds)))
                           (hrow (+ l (fn2-run-builds-hbase 0 builds)))
                           (ctx (fn2-run-seal-context (+ l (fn2-run-builds-wbase 0 builds)) 0 (+ l (fn2-run-builds-hbase 0 builds)) writers previous-context))))
           :in-theory (union-theories (theory 'minimal-theory) '((:e nfix) (:e posp) (:e equal))))))

; Actual typed source-manifest traversal and full stored-byte integrity.
; Every physical child is pinned before its read; only the existing B block
; proof checker and streaming BLAKE3 implementation decide hash agreement.
(in-package "ACL2")
(include-book "checkpoint-payload-io")
(include-book "checkpoint-payload-format")
(include-book "checkpoint-payload-physical-step")
(fn2-book-layer :c)

(defmacro fn2-checkpoint-payload-step-mv (code)
 `(mv ,code fn2-checkpoint-payload fn2-checkpoint-retained-entry fn2-fields fn2-extents fn2-alloc-edges fn2-b3 fn2-digests))

(defun fn2-checkpoint-payload-step (budget fn2-checkpoint-payload fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints
                                   fn2-fields fn2-extents fn2-alloc-edges fn2-ops fn2-pool fn2-b3 fn2-digests)
 (declare (xargs :stobjs (fn2-checkpoint-payload fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields fn2-extents
                          fn2-alloc-edges fn2-ops fn2-pool fn2-b3 fn2-digests)
  :guard (and (fn2-checkpoint-payload-wfp fn2-checkpoint-payload) (fn2-checkpoint-retained-entry-wfp fn2-checkpoint-retained-entry)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-checkpoints-wfp fn2-checkpoints) (fn2-fields-wfp fn2-fields)
              (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges) (fn2-ops-wfp fn2-ops) (fn2-pool-wfp fn2-pool)
              (fn2-b3-wfp fn2-b3) (fn2-digests-wfp fn2-digests))))
 (b* (((unless (and (natp budget) (< 0 budget))) (fn2-checkpoint-payload-step-mv :yield))
      ((unless (fn2-checkpoint-payload-sourcep fn2-checkpoint-payload fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields))
       (fn2-checkpoint-payload-step-mv :source))
      ((mv code next fn2-checkpoint-payload fn2-fields fn2-b3 fn2-digests)
       (fn2-checkpoint-payload-physical-step budget fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests))
      ((when (eq code :claim))
       (b* ((base (fn2-checkpoint-payload-field-base 0 fn2-checkpoint-payload))
            (unit (fn2-fields-value (+ base *fn2-format-source-manifest-entry-field-block-physical-unit*) fn2-fields))
            (epoch (fn2-fields-value (+ base *fn2-format-source-manifest-entry-field-block-writer-epoch*) fn2-fields))
            (allocation (fn2-fields-value (+ base *fn2-format-source-manifest-entry-field-block-allocation*) fn2-fields))
            ((mv claimed fn2-extents fn2-alloc-edges) (fn2-checkpoint-source-claim
             (fn2-checkpoint-payload-candidate 0 fn2-checkpoint-payload) (fn2-checkpoint-payload-checkpoint 0 fn2-checkpoint-payload)
             (floor unit *fn2-storage-extent-units*) epoch allocation fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints))
            ((unless (eq claimed :ok)) (fn2-checkpoint-payload-step-mv claimed))
            ((mv bound fn2-checkpoint-payload) (fn2-checkpoint-payload-physical-child-bind next fn2-checkpoint-payload fn2-fields)))
        (fn2-checkpoint-payload-step-mv bound)))
      (fn2-checkpoint-retained-entry (if (eq code :complete)
       (fn2-checkpoint-retained-entry-set-phase 0 *fn2-checkpoint-retained-entry-phase-payload-complete* fn2-checkpoint-retained-entry) fn2-checkpoint-retained-entry)))
  (fn2-checkpoint-payload-step-mv code)))

(fn2-checkpoint-payload-preserves fn2-checkpoint-payload-step
 (budget fn2-checkpoint-payload fn2-checkpoint-retained-entry fn2-csnapshot fn2-checkpoints fn2-fields fn2-extents fn2-alloc-edges fn2-ops fn2-pool fn2-b3 fn2-digests)
 :hyps ((fn2-checkpoint-payloadp fn2-checkpoint-payload) (fn2-checkpoint-payload-wfp fn2-checkpoint-payload)
        (fn2-checkpoint-retained-entryp fn2-checkpoint-retained-entry) (fn2-checkpoint-retained-entry-wfp fn2-checkpoint-retained-entry)
        (fn2-csnapshotp fn2-csnapshot) (fn2-csnapshot-wfp fn2-csnapshot)
        (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints)
        (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)
        (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents)
        (fn2-alloc-edgesp fn2-alloc-edges) (fn2-alloc-edges-wfp fn2-alloc-edges)
        (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops)
        (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
        (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3)
        (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests))
 :specs (("-CHECKPOINT-PAYLOAD-TYPE" fn2-checkpoint-payloadp 1)
         ("-CHECKPOINT-PAYLOAD-WFP" fn2-checkpoint-payload-wfp 1)
         ("-CHECKPOINT-PAYLOAD-ROWS" fn2-checkpoint-payload-rows 1 :frame fn2-checkpoint-payload)
         ("-CHECKPOINT-RETAINED-ENTRY-TYPE" fn2-checkpoint-retained-entryp 2)
         ("-CHECKPOINT-RETAINED-ENTRY-WFP" fn2-checkpoint-retained-entry-wfp 2)
         ("-CHECKPOINT-RETAINED-ENTRY-ROWS" fn2-checkpoint-retained-entry-rows 2 :frame fn2-checkpoint-retained-entry)
         ("-FIELDS-TYPE" fn2-fieldsp 3)
         ("-FIELDS-WFP" fn2-fields-wfp 3)
         ("-FIELDS-ROWS" fn2-fields-rows 3 :frame fn2-fields)
         ("-EXTENTS-TYPE" fn2-extentsp 4)
         ("-EXTENTS-WFP" fn2-extents-wfp 4)
         ("-EXTENTS-ROWS" fn2-extents-rows 4 :frame fn2-extents)
         ("-ALLOC-EDGES-TYPE" fn2-alloc-edgesp 5)
         ("-ALLOC-EDGES-WFP" fn2-alloc-edges-wfp 5)
         ("-ALLOC-EDGES-ROWS" fn2-alloc-edges-rows 5 :frame fn2-alloc-edges)
         ("-B3-TYPE" fn2-b3p 6)
         ("-B3-WFP" fn2-b3-wfp 6)
         ("-B3-ROWS" fn2-b3-rows 6 :frame fn2-b3)
         ("-B3-WORDS" fn2-b3-words-length 6 :frame fn2-b3)
         ("-DIGESTS-TYPE" fn2-digestsp 7)
         ("-DIGESTS-WFP" fn2-digests-wfp 7)
         ("-DIGESTS-ROWS" fn2-digests-rows 7 :frame fn2-digests)))

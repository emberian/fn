(local (defthm fn-lbrbool-nth-of-cons
 (equal (nth i (cons value xs)) (if (zp i) value (nth (- (nfix i) 1) xs)))
 :hints (("Goal" :in-theory (enable nth)))))

(local (defthm fn-lbrbool-alist-of-pair-cons
 (equal (alistp (cons (cons key value) rest)) (alistp rest))
 :hints (("Goal" :in-theory (enable alistp)))))

(local (defthm fn-lbrbool-assoc-nil
 (equal (assoc-eq key nil) nil)
 :hints (("Goal" :in-theory (enable assoc-eq)))))


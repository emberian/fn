; Descriptor continuation over the real anchor candidate and retained bootstrap.
; CORE admission below requires the actual persisted-bootstrap producer gate.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "boot-geometry-state")
(include-book "origin")
(include-book "boot-bootstrap-receipt")
(include-book "checkpoint-descriptor-read")
(include-book "checkpoint-descriptor-input")
(fn2-book-layer :b)

(defun fn2-boot-descriptor-source-p (c kind id ogen fn2-boot-config fn2-origin
                                    fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-boot-config fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
  :guard (and (fn2-boot-config-wfp fn2-boot-config) (fn2-origin-wfp fn2-origin)
              (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes))))
 (and (natp c) (< c 4)
      (fn2-boot-bootstrap-receipt-p kind id ogen fn2-boot-config fn2-origin)
      (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
      (equal (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-preparing*)
      (equal (fn2-checkpoints-bank c fn2-checkpoints) (floor c 2))
      (equal (fn2-checkpoints-anchor-mask c fn2-checkpoints) (ash 1 c))
      (not (equal (logand (ash 1 c) (fn2-boot-config-anchor-checked-mask fn2-boot-config)) 0))
      (equal (logand (ash 1 c) (fn2-boot-config-anchor-empty-mask fn2-boot-config)) 0)
      (equal (logand (ash 1 c) (fn2-boot-config-anchor-invalid-mask fn2-boot-config)) 0)
      (equal (fn2-checkpoints-history c fn2-checkpoints) (fn2-origin-history fn2-origin))
      (equal (fn2-checkpoints-incarnation c fn2-checkpoints) (fn2-origin-history-incarnation fn2-origin))
      (equal (fn2-checkpoint-refs-storage-domain (* 6 c) fn2-checkpoint-refs) *fn2-checkpoint-served-storage-domain*)
      (equal (fn2-checkpoint-refs-page-kind (* 6 c) fn2-checkpoint-refs) *page-kind-checkpoint-descriptor*)
      (equal (fn2-checkpoint-refs-encoded-length (* 6 c) fn2-checkpoint-refs) *fn2-format-sector-size*)))

(defun fn2-boot-descriptor-geometry-matches-p (i geometry fn2-boot-config fn2-digests)
 (declare (xargs :stobjs (fn2-boot-config fn2-digests) :measure (nfix (- 8 (nfix i)))
  :guard (and (fn2-boot-config-wfp fn2-boot-config) (fn2-digest-rowp geometry fn2-digests)
              (natp i) (<= i 8))))
 (if (or (not (natp i)) (>= i 8)) t
  (and (equal (fn2-digest-word geometry i fn2-digests)
              (fn2-checkpoint-boot-geometry-word i fn2-boot-config))
       (fn2-boot-descriptor-geometry-matches-p (+ 1 i) geometry fn2-boot-config fn2-digests))))

(defun fn2-boot-checkpoint-descriptor-target-pool (c kind id ogen fn2-boot-config fn2-origin
                                                 fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-boot-config fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
  :verify-guards nil
  :guard (and (fn2-boot-config-wfp fn2-boot-config) (fn2-origin-wfp fn2-origin)
              (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes))))
 (if (not (fn2-boot-descriptor-source-p c kind id ogen fn2-boot-config fn2-origin
             fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes))
     (mv :source 0 0)
  (mv-let (code offset bytes next)
   (fn2-checkpoint-restore-read-target c 0 0 (fn2-boot-config-extents fn2-boot-config)
    fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
   (if (and (eq code :read) (equal bytes *fn2-format-sector-size*) (equal next bytes)
             (<= (+ offset bytes) (fn2-boot-config-image-size fn2-boot-config)))
       (mv :read offset bytes)
     (mv :bounds 0 0)))))

; The caller obtains KIND/ID/OGEN and the source window from the real BOOT row.
; A zero parser grant performs no seeding, reading or candidate mutation.
(defun fn2-boot-checkpoint-descriptor-pool (c slot gen kind id ogen budget
                                         fn2-boot-config fn2-origin
                                         fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                                         fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
 (declare (xargs :stobjs (fn2-boot-config fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
                          fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
  :verify-guards nil
  :guard (and (fn2-boot-config-wfp fn2-boot-config) (fn2-origin-wfp fn2-origin)
              (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-fc-wfp fn2-fc)
              (fn2-fc-context-wfp fn2-fc-context) (fn2-b3-wfp fn2-b3)
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (fn2-digests-wfp fn2-digests))))
 (b* (((unless (natp budget))
       (mv :bounds fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      ((when (zp budget))
       (mv :more fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      ((unless (fn2-boot-descriptor-source-p c kind id ogen fn2-boot-config fn2-origin
                  fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes))
       (mv :source fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      (row 2) (base 256) (len *fn2-format-sector-size*) (r (* 6 c))
      (hash (fn2-digest-slot row *fn2-fc-hash*))
      (geometry (fn2-digest-slot row *fn2-fc-geometry*))
      (previous (fn2-digest-slot row *fn2-fc-previous-seal*))
      ((unless (and (< row (fn2-fc-rows fn2-fc)) (< row (fn2-fc-context-rows fn2-fc-context))
                     (fn2-b3-ready row fn2-b3 fn2-digests)
                     (fn2-digest-rowp hash fn2-digests) (fn2-digest-rowp geometry fn2-digests)
                     (fn2-digest-rowp previous fn2-digests)
                     (<= (+ base *fn2-format-sealed-batch-num-fields*) (fn2-fields-rows fn2-fields))))
       (mv :bounds fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      (readable (fn2-layout-range-code slot gen 0 len nil kind id ogen fn2-pool))
      ((unless (eq readable :ok))
       (mv readable fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      (first (equal (fn2-fc-phase row fn2-fc) *fn2-fc-phase-idle*))
      ((unless (or first
                  (and (equal (fn2-fc-context-hash row fn2-fc-context) hash)
                       (equal (fn2-fc-context-geometry row fn2-fc-context) geometry)
                       (equal (fn2-fc-context-previous-seal row fn2-fc-context) previous)
                       (fn2-boot-descriptor-geometry-matches-p 0 geometry fn2-boot-config fn2-digests))))
       (mv :context fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      (fn2-digests (if first (fn2-checkpoint-restore-load-hash 0 r hash fn2-checkpoint-bytes fn2-digests) fn2-digests))
      (fn2-digests (if first (fn2-checkpoint-boot-geometry-copy 0 geometry fn2-boot-config fn2-digests) fn2-digests))
      (fn2-fc-context (if first
       (fn2-fc-context-put row
        (location (fn2-checkpoint-refs-physical-unit r fn2-checkpoint-refs))
        (writer-epoch (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs))
        (allocation (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs))
        (history (fn2-checkpoints-history c fn2-checkpoints))
        (incarnation (fn2-checkpoints-incarnation c fn2-checkpoints))
        (page-kind *page-kind-checkpoint-descriptor*) (encoded-length len)
        (hash hash) (geometry geometry) (previous-seal previous)) fn2-fc-context))
      ((mv code fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
       (fn2-checkpoint-check-step c row slot gen 0 len base kind id ogen (min budget len)
         fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)))
  (mv code fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)))

; Materialize only with the actual BOOT kind, CORE and bootstrap producer.
; The actor's held rx lease survives every :more; no parsed Ref is borrowed
; past this callback, and no caller-supplied readiness bit is an input.
(defmacro fn2-boot-descriptor-operations ()
 '(progn
   (defun fn2-boot-checkpoint-descriptor-target (c id ogen fn2-core)
    (declare (xargs :stobjs fn2-core :verify-guards nil :guard (fn2-core-wfp fn2-core)))
    (if (not (and (fn2-boot-bootstrap-current-p id ogen fn2-core)
                   (equal (fn2-machine-phase id fn2-core) *fn2-boot-state-checkpoint-descriptor*)
                   (equal (fn2-machine-checkpoint-index id fn2-core) c)
                   (equal (fn2-machine-pending id fn2-core) 0)))
        (mv :state 0 0)
     (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core)) (fn2-origin (fn2-core-origin fn2-core))
                  (fn2-checkpoints (fn2-core-checkpoints fn2-core)) (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core))
                  (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core)))
      (code offset bytes)
      (fn2-boot-checkpoint-descriptor-target-pool c *fn2-boot-kind* id ogen
       fn2-boot-config fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
      (mv code offset bytes))))
   (defun fn2-boot-checkpoint-descriptor-check (c slot gen id ogen budget fn2-core)
    (declare (xargs :stobjs fn2-core :verify-guards nil :guard (fn2-core-wfp fn2-core)))
    (if (not (and (fn2-boot-bootstrap-current-p id ogen fn2-core)
                   (equal (fn2-machine-phase id fn2-core) *fn2-boot-state-checkpoint-descriptor-step*)
                   (equal (fn2-machine-checkpoint-index id fn2-core) c)
                   (equal (fn2-machine-rx-slot id fn2-core) slot)
                   (equal (fn2-machine-rx-gen id fn2-core) gen)
                   (equal (fn2-machine-pending id fn2-core) 0)))
        (mv :state fn2-core)
     (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core)) (fn2-origin (fn2-core-origin fn2-core))
                  (fn2-checkpoints (fn2-core-checkpoints fn2-core)) (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core))
                  (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core)) (fn2-fc (fn2-core-fc fn2-core))
                  (fn2-fc-context (fn2-core-fc-context fn2-core)) (fn2-b3 (fn2-core-b3 fn2-core))
                  (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core))
                  (fn2-digests (fn2-core-digests fn2-core)))
      (code fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
      (fn2-boot-checkpoint-descriptor-pool c slot gen *fn2-boot-kind* id ogen budget
       fn2-boot-config fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes
       fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
      (mv code fn2-core))))))

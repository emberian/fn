; B-owned future leases and exact pool handback; live registration is separate.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-member")
(include-book "commit-format")
(fn2-book-layer :b)

(defconst *fn2-checkpoint-future-window-count* 8)

(defcolumns fn2-checkpoint-future
 ((phase (:enum fn2-checkpoint-future-phase (:idle :reserved :uncertain)))
  (candidate :u32) (owner-kind :u8) (owner-slot :u32) (owner-gen :u60) (token :u60) (reserved :u8)))

(defcolumns fn2-checkpoint-future-windows
 ((live :bool) (slot :u32) (generation :u60) (borrowed :bool)
  (borrower-kind :u8) (borrower-slot :u32) (borrower-gen :u60)))

(defun fn2-checkpoint-future-window-length (i)
 (declare (xargs :guard t))
 (cond ((equal i 0)
        (max (* *fn2-checkpoint-allocation-records-per-ticket*
                 (+ *fn2-format-txn-record-max-size* *fn2-format-allocation-max-size*))
             (fn2-checkpoint-installation-member-capacity)))
       ((equal i 7) 160) (t *fn2-commit-unit-bytes*)))

(defun fn2-checkpoint-future-ownerp (kind owner gen fn2-checkpoint-future)
 (declare (xargs :stobjs fn2-checkpoint-future :guard (fn2-checkpoint-future-wfp fn2-checkpoint-future)))
 (and (< 0 (fn2-checkpoint-future-rows fn2-checkpoint-future))
      (equal (fn2-checkpoint-future-phase 0 fn2-checkpoint-future) *fn2-checkpoint-future-phase-reserved*)
      (equal (fn2-checkpoint-future-reserved 0 fn2-checkpoint-future) *fn2-checkpoint-future-window-count*)
      (equal kind (fn2-checkpoint-future-owner-kind 0 fn2-checkpoint-future))
      (equal owner (fn2-checkpoint-future-owner-slot 0 fn2-checkpoint-future))
      (equal gen (fn2-checkpoint-future-owner-gen 0 fn2-checkpoint-future))))

(defun fn2-checkpoint-future-class-demand (i class fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (natp i) (<= i 8)) :measure (nfix (- 8 i))))
 (if (>= i 8) 0
  (+ (if (equal class (fn2-pool-class-for (fn2-checkpoint-future-window-length i) fn2-pool)) 1 0)
     (fn2-checkpoint-future-class-demand (+ i 1) class fn2-pool))))

(defun fn2-checkpoint-future-roomp (i fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (natp i) (<= i 8)) :measure (nfix (- 8 i))))
 (if (>= i 8) t
  (let ((class (fn2-pool-class-for (fn2-checkpoint-future-window-length i) fn2-pool)))
   (and (natp class) (< class (fn2-pool-nclasses fn2-pool))
        (<= (fn2-checkpoint-future-class-demand 0 class fn2-pool) (fn2-pool-free-count class fn2-pool))
        (fn2-checkpoint-future-roomp (+ i 1) fn2-pool)))))

(defun fn2-checkpoint-future-reserve-loop (i kind owner gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
  :guard (and (fn2-checkpoint-future-wfp fn2-checkpoint-future) (< 0 (fn2-checkpoint-future-rows fn2-checkpoint-future))
              (fn2-checkpoint-future-windows-wfp fn2-checkpoint-future-windows) (<= 8 (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows))
              (fn2-pool-wfp fn2-pool) (natp i) (<= i 8)) :measure (nfix (- 8 i))))
 (if (>= i 8)
  (let* ((fn2-checkpoint-future (fn2-checkpoint-future-set-phase 0 *fn2-checkpoint-future-phase-reserved* fn2-checkpoint-future)))
   (mv :ok fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
  (b* ((class (fn2-pool-class-for (fn2-checkpoint-future-window-length i) fn2-pool))
       ((mv code slot generation fn2-pool) (fn2-pool-reserve class kind owner gen fn2-pool))
       ((unless (eq code :ok))
        (let* ((fn2-checkpoint-future (fn2-checkpoint-future-set-phase 0 *fn2-checkpoint-future-phase-uncertain* fn2-checkpoint-future)))
         (mv :partial fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)))
       (fn2-checkpoint-future-windows (fn2-checkpoint-future-windows-put i (live 1) (slot slot) (generation generation) (borrowed 0)))
       (fn2-checkpoint-future (fn2-checkpoint-future-set-reserved 0 (+ i 1) fn2-checkpoint-future)))
   (fn2-checkpoint-future-reserve-loop (+ i 1) kind owner gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))))

(defun fn2-checkpoint-future-reserve (c kind owner gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
  :guard (and (fn2-checkpoint-future-wfp fn2-checkpoint-future) (fn2-checkpoint-future-windows-wfp fn2-checkpoint-future-windows) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (< 0 (fn2-checkpoint-future-rows fn2-checkpoint-future))
                    (<= 8 (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows))
                    (equal (fn2-checkpoint-future-phase 0 fn2-checkpoint-future) *fn2-checkpoint-future-phase-idle*)
                    (equal (fn2-checkpoint-future-reserved 0 fn2-checkpoint-future) 0) (unsigned-byte-p 32 c) (fn2-pool-mrefp kind owner gen)))
       (mv :owner fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
      ((unless (fn2-checkpoint-future-roomp 0 fn2-pool)) (mv :exhausted fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
      (fn2-checkpoint-future (fn2-checkpoint-future-put 0 (candidate c) (owner-kind kind) (owner-slot owner) (owner-gen gen) (token 0))))
  (fn2-checkpoint-future-reserve-loop 0 kind owner gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)))

(defun fn2-checkpoint-future-bind (c token kind owner gen fn2-checkpoint-future fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-future fn2-extents)
  :guard (and (fn2-checkpoint-future-wfp fn2-checkpoint-future) (fn2-extents-wfp fn2-extents))))
 (if (and (fn2-checkpoint-future-ownerp kind owner gen fn2-checkpoint-future)
          (equal c (fn2-checkpoint-future-candidate 0 fn2-checkpoint-future))
          (posp token) (unsigned-byte-p 60 token)
          (equal (fn2-alloc-freeze-phase fn2-extents) 2)
          (equal token (fn2-alloc-freeze-token fn2-extents))
          (equal kind (fn2-alloc-freeze-owner-kind fn2-extents))
          (equal owner (fn2-alloc-freeze-owner-slot fn2-extents)) (equal gen (fn2-alloc-freeze-owner-gen fn2-extents))
          (or (equal (fn2-checkpoint-future-token 0 fn2-checkpoint-future) 0)
              (equal (fn2-checkpoint-future-token 0 fn2-checkpoint-future) token)))
  (let* ((fn2-checkpoint-future (fn2-checkpoint-future-set-token 0 token fn2-checkpoint-future)))
   (mv :ok fn2-checkpoint-future))
  (mv :owner fn2-checkpoint-future)))

(defun fn2-checkpoint-future-lease (i token kind owner gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
  :guard (and (fn2-checkpoint-future-wfp fn2-checkpoint-future) (fn2-checkpoint-future-windows-wfp fn2-checkpoint-future-windows) (fn2-pool-wfp fn2-pool))))
 (if (and (natp i) (< i 8) (< i (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows))
          (< 0 (fn2-checkpoint-future-rows fn2-checkpoint-future)) (posp token)
          (equal token (fn2-checkpoint-future-token 0 fn2-checkpoint-future))
          (equal (fn2-checkpoint-future-windows-live i fn2-checkpoint-future-windows) 1)
          (if (equal (fn2-checkpoint-future-windows-borrowed i fn2-checkpoint-future-windows) 1)
           (and (equal kind (fn2-checkpoint-future-windows-borrower-kind i fn2-checkpoint-future-windows))
                (equal owner (fn2-checkpoint-future-windows-borrower-slot i fn2-checkpoint-future-windows))
                (equal gen (fn2-checkpoint-future-windows-borrower-gen i fn2-checkpoint-future-windows)))
           (fn2-checkpoint-future-ownerp kind owner gen fn2-checkpoint-future))
          (eq (fn2-pool-workspace-code (fn2-checkpoint-future-windows-slot i fn2-checkpoint-future-windows)
                (fn2-checkpoint-future-windows-generation i fn2-checkpoint-future-windows) kind owner gen fn2-pool) :ok))
  (mv :ok (fn2-checkpoint-future-windows-slot i fn2-checkpoint-future-windows) (fn2-checkpoint-future-windows-generation i fn2-checkpoint-future-windows))
  (mv :owner 0 0)))

(defun fn2-checkpoint-future-transfer-readyp (i end returning token kind owner gen bkind borrower bgen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
  :guard (and (fn2-checkpoint-future-wfp fn2-checkpoint-future) (fn2-checkpoint-future-windows-wfp fn2-checkpoint-future-windows) (fn2-pool-wfp fn2-pool)
              (natp i) (natp end) (<= i end) (<= end 8)) :measure (nfix (- end i))))
 (if (>= i end) t
  (and (< i (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows))
       (equal (fn2-checkpoint-future-windows-borrowed i fn2-checkpoint-future-windows) (if returning 1 0))
       (mv-let (code slot generation)
        (fn2-checkpoint-future-lease i token (if returning bkind kind) (if returning borrower owner) (if returning bgen gen)
         fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
        (declare (ignore slot generation)) (eq code :ok))
       (fn2-checkpoint-future-transfer-readyp (+ i 1) end returning token kind owner gen bkind borrower bgen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))))

(defun fn2-checkpoint-future-transfer-loop (i end returning kind owner gen bkind borrower bgen fn2-checkpoint-future-windows fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-future-windows fn2-pool)
  :guard (and (fn2-checkpoint-future-windows-wfp fn2-checkpoint-future-windows) (fn2-pool-wfp fn2-pool)
              (natp i) (natp end) (<= i end) (<= end 8) (<= end (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows))
              (fn2-pool-mrefp kind owner gen) (fn2-pool-mrefp bkind borrower bgen))
  :measure (nfix (- end i))))
 (if (>= i end) (mv :ok fn2-checkpoint-future-windows fn2-pool)
  (b* ((slot (fn2-checkpoint-future-windows-slot i fn2-checkpoint-future-windows))
       (generation (fn2-checkpoint-future-windows-generation i fn2-checkpoint-future-windows))
       ((mv code fn2-pool)
        (fn2-pool-hand slot generation (if returning bkind kind) (if returning borrower owner) (if returning bgen gen)
         (if returning kind bkind) (if returning owner borrower) (if returning gen bgen) fn2-pool))
       ((unless (eq code :ok)) (mv :partial fn2-checkpoint-future-windows fn2-pool))
       ((mv code fn2-pool)
        (fn2-pool-accept-hand slot generation (if returning kind bkind) (if returning owner borrower) (if returning gen bgen) fn2-pool))
       ((unless (eq code :ok)) (mv :partial fn2-checkpoint-future-windows fn2-pool))
       (fn2-checkpoint-future-windows (fn2-checkpoint-future-windows-put i (borrowed (if returning 0 1))
        (borrower-kind (if returning 0 bkind)) (borrower-slot (if returning 0 borrower)) (borrower-gen (if returning 0 bgen)))))
   (fn2-checkpoint-future-transfer-loop (+ i 1) end returning kind owner gen bkind borrower bgen fn2-checkpoint-future-windows fn2-pool))))

(defmacro fn2-checkpoint-future-transfer-interface (name first end returning)
 `(defun ,name (token kind owner gen bkind borrower bgen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
   (declare (xargs :stobjs (fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
    :guard (and (fn2-checkpoint-future-wfp fn2-checkpoint-future) (fn2-checkpoint-future-windows-wfp fn2-checkpoint-future-windows) (fn2-pool-wfp fn2-pool))))
   (if (and (fn2-checkpoint-future-ownerp kind owner gen fn2-checkpoint-future)
            (fn2-pool-mrefp kind owner gen) (fn2-pool-mrefp bkind borrower bgen) (posp token)
            (equal token (fn2-checkpoint-future-token 0 fn2-checkpoint-future))
            (<= ,end (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows))
            (fn2-checkpoint-future-transfer-readyp ,first ,end ,returning token kind owner gen bkind borrower bgen
             fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
    (fn2-checkpoint-future-transfer-loop ,first ,end ,returning kind owner gen bkind borrower bgen fn2-checkpoint-future-windows fn2-pool)
    (mv :owner fn2-checkpoint-future-windows fn2-pool))))

(fn2-checkpoint-future-transfer-interface fn2-checkpoint-future-borrow-journal 1 5 nil)

(fn2-checkpoint-future-transfer-interface fn2-checkpoint-future-return-journal 1 5 t)

(fn2-checkpoint-future-transfer-interface fn2-checkpoint-future-borrow-anchor 5 8 nil)

(fn2-checkpoint-future-transfer-interface fn2-checkpoint-future-return-anchor 5 8 t)

(defun fn2-checkpoint-future-staging-return (c token kind owner gen slot generation fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
  :guard (and (fn2-checkpoint-future-wfp fn2-checkpoint-future) (fn2-checkpoint-future-windows-wfp fn2-checkpoint-future-windows) (fn2-pool-wfp fn2-pool))))
 (if (and (fn2-checkpoint-future-ownerp kind owner gen fn2-checkpoint-future)
          (equal c (fn2-checkpoint-future-candidate 0 fn2-checkpoint-future)))
  (mv-let (code actual-slot actual-generation)
   (fn2-checkpoint-future-lease 0 token kind owner gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
   (if (and (eq code :ok) (equal slot actual-slot) (equal generation actual-generation)) :ok :owner))
  :owner))

(defun fn2-checkpoint-future-no-loansp (i end fn2-checkpoint-future-windows)
 (declare (xargs :stobjs fn2-checkpoint-future-windows
  :guard (and (fn2-checkpoint-future-windows-wfp fn2-checkpoint-future-windows) (natp i) (natp end)
              (<= i end) (<= end (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows)))
  :measure (nfix (- end i))))
 (if (>= i end) t
  (and (equal (fn2-checkpoint-future-windows-borrowed i fn2-checkpoint-future-windows) 0)
       (fn2-checkpoint-future-no-loansp (+ i 1) end fn2-checkpoint-future-windows))))

(defun fn2-checkpoint-future-release-one (c token kind owner gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
  :guard (and (fn2-checkpoint-future-wfp fn2-checkpoint-future) (fn2-checkpoint-future-windows-wfp fn2-checkpoint-future-windows) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (< 0 (fn2-checkpoint-future-rows fn2-checkpoint-future))
                    (equal (fn2-checkpoint-future-phase 0 fn2-checkpoint-future) *fn2-checkpoint-future-phase-reserved*)
                    (equal c (fn2-checkpoint-future-candidate 0 fn2-checkpoint-future))
                    (equal token (fn2-checkpoint-future-token 0 fn2-checkpoint-future))
                    (equal kind (fn2-checkpoint-future-owner-kind 0 fn2-checkpoint-future))
                    (equal owner (fn2-checkpoint-future-owner-slot 0 fn2-checkpoint-future))
                    (equal gen (fn2-checkpoint-future-owner-gen 0 fn2-checkpoint-future))))
       (mv :owner fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
      (left (fn2-checkpoint-future-reserved 0 fn2-checkpoint-future))
      ((unless (and (posp left) (<= left 8) (<= left (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows))))
       (mv :bounds fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
      ((unless (fn2-checkpoint-future-no-loansp 0 left fn2-checkpoint-future-windows))
       (mv :busy fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
      (i (- left 1))
      (slot (fn2-checkpoint-future-windows-slot i fn2-checkpoint-future-windows))
      (generation (fn2-checkpoint-future-windows-generation i fn2-checkpoint-future-windows))
      ((unless (and (equal (fn2-checkpoint-future-windows-live i fn2-checkpoint-future-windows) 1)
                    (equal (fn2-checkpoint-future-windows-borrowed i fn2-checkpoint-future-windows) 0)
                    (eq (fn2-pool-workspace-code slot generation kind owner gen fn2-pool) :ok)))
       (mv :busy fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
      ((unless (fn2-pool-release-countp slot fn2-pool))
       (mv :partial fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
      ((mv code fn2-pool) (fn2-pool-release slot generation kind owner gen fn2-pool))
      ((unless (member-equal code '(:ok :retired)))
       (mv :partial fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
      (fn2-checkpoint-future-windows (fn2-checkpoint-future-windows-set-live i 0 fn2-checkpoint-future-windows))
      (fn2-checkpoint-future (fn2-checkpoint-future-put 0 (reserved i)
       (phase (if (zp i) *fn2-checkpoint-future-phase-idle* *fn2-checkpoint-future-phase-reserved*)))))
  (mv (if (zp i) :done :more) fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)))

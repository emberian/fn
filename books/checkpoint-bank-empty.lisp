; Empty binding is a consequence of the actual boot actor's completed startup
; write/scan and covering epoch Fence, never an input readiness boolean.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-bank-obligations-state")
(include-book "boot-kind")
(fn2-book-layer :b)
(defun fn2-checkpoint-bank-empty-sources-p (slot fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :measure (nfix (- 4 (nfix slot)))
 :guard (and (fn2-checkpoint-publication-wfp fn2-checkpoint-publication) (fn2-checkpoint-bank-obligations-capacityp fn2-checkpoint-publication)
             (natp slot) (<= slot 4))))
 (or (>= (nfix slot) 4)
  (and (equal (fn2-checkpoint-publication-cold-metai (* 12 slot) fn2-checkpoint-publication) 0)
       (fn2-checkpoint-bank-empty-sources-p (+ slot 1) fn2-checkpoint-publication))))
(defcost fn2-boot-bind-checkpoint-obligations :answers t
 :tables (fn2-core-machines fn2-core-boot fn2-core-boot-config fn2-core-checkpoint-publication)
 :doc "Bind no cold obligations only from the actual completed all-empty scan or create/write/epoch-Fence boot continuation.")
(defmacro fn2-checkpoint-bank-empty-core-events ()
 '(progn
  (defun fn2-boot-bind-checkpoint-obligations (id ogen fn2-core)
   (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
   (if (not (and (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
                  (unsigned-byte-p 60 ogen) (posp ogen)
                  (equal (fn2-machine-generation id fn2-core) ogen)
                  (equal (fn2-machine-phase id fn2-core) *fn2-boot-state-epoch-result*)
                  (equal (fn2-machine-stage id fn2-core) 3)
                  (equal (fn2-machine-stopped id fn2-core) 0)
                  (equal (fn2-machine-event-ready id fn2-core) 1)
                  (equal (fn2-machine-outcome id fn2-core) *fn2-outcome-done*)))
       (mv :state fn2-core)
    (let ((created (fn2-machine-create id fn2-core)) (size (fn2-machine-image-size id fn2-core)))
     (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core))
                 (fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core)))
      (code fn2-checkpoint-publication)
      (b* (((unless (and (fn2-checkpoint-bank-obligations-capacityp fn2-checkpoint-publication)
                         (equal (fn2-boot-config-checkpoint-layout-ready fn2-boot-config) 1)
                         (equal size (fn2-boot-config-image-size fn2-boot-config))
                         (fn2-checkpoint-image-sizep size (fn2-boot-config-extents fn2-boot-config) (fn2-boot-config-count fn2-boot-config))
                         (equal (fn2-boot-config-anchor-checked-mask fn2-boot-config) 0)
                         (equal (fn2-boot-config-anchor-invalid-mask fn2-boot-config) 0)
                         ; CREATE is read from the exact boot continuation after
                         ; all its writes and final Fence, not a supplied flag.
                         (or (equal created 1) (equal (fn2-boot-config-anchor-empty-mask fn2-boot-config) 15))))
             (mv :state fn2-checkpoint-publication))
           ((unless (and (equal (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication) *fn2-checkpoint-publication-phase-idle*)
                          (member-equal (fn2-checkpoint-publication-cold-bind-phase 0 fn2-checkpoint-publication)
                           (list *fn2-checkpoint-cold-bind-phase-idle* *fn2-checkpoint-cold-bind-phase-complete*))
                          (equal (fn2-checkpoint-publication-has-base 0 fn2-checkpoint-publication) 0)
                          (equal (fn2-checkpoint-publication-bank0-valid 0 fn2-checkpoint-publication) 0)
                          (equal (fn2-checkpoint-publication-bank1-valid 0 fn2-checkpoint-publication) 0)
                          (equal (fn2-checkpoint-publication-debt-valid 0 fn2-checkpoint-publication) 0)
                          (equal (fn2-checkpoint-publication-cold-bound-mask 0 fn2-checkpoint-publication) 0)
                          (equal (fn2-checkpoint-publication-cold-live-mask 0 fn2-checkpoint-publication) 0)
                          (equal (fn2-checkpoint-publication-cold-pending-mask 0 fn2-checkpoint-publication) 0)
                          (equal (fn2-checkpoint-publication-cold-retired-mask 0 fn2-checkpoint-publication) 0)
                          (fn2-checkpoint-bank-empty-sources-p 0 fn2-checkpoint-publication)))
             (mv :retained fn2-checkpoint-publication))
           ((unless (or (equal (fn2-checkpoint-publication-layout-ready 0 fn2-checkpoint-publication) 0)
                        (and (equal (fn2-checkpoint-publication-image-size 0 fn2-checkpoint-publication) size)
                             (equal (fn2-checkpoint-publication-extents 0 fn2-checkpoint-publication) (fn2-boot-config-extents fn2-boot-config))
                             (equal (fn2-checkpoint-publication-groups 0 fn2-checkpoint-publication) (fn2-boot-config-count fn2-boot-config)))))
             (mv :geometry fn2-checkpoint-publication))
           (fn2-checkpoint-publication (fn2-checkpoint-publication-put 0
            (cold-bind-phase *fn2-checkpoint-cold-bind-phase-complete*) (cold-bind-cursor 4) (cold-selected 4)
            (cold-checked-mask 0) (cold-empty-mask 15) (cold-invalid-mask 0)
            (layout-ready 1) (image-size size) (extents (fn2-boot-config-extents fn2-boot-config)) (groups (fn2-boot-config-count fn2-boot-config)))))
       (mv :ok fn2-checkpoint-publication))
      (mv code fn2-core)))))
  (fn2-core-preserves fn2-boot-bind-checkpoint-obligations (id ogen fn2-core) :position 1 :rows nil)))

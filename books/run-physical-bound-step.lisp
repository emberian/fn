; Shared bounded physical engine; callers establish their source authority each turn.
(in-package "ACL2")
(include-book "run-physical-bound-io")
(include-book "runs-served")
(include-book "boot-geometry-state")
(include-book "checkpoint-semantic-page")
(fn2-book-layer :c)
(defun fn2-run-load-digest (c i row fn2-run-loads fn2-digests)
 (declare (xargs :stobjs (fn2-run-loads fn2-digests) :measure (nfix (- 8 (nfix i)))
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-digests-wfp fn2-digests)
  (natp c) (< c (fn2-run-loads-rows fn2-run-loads)) (natp i) (<= i 8) (fn2-digest-rowp row fn2-digests))))
 (if (>= (nfix i) 8) fn2-digests
  (let ((fn2-digests (fn2-digest-set-word row i (fn2-run-load-word c i fn2-run-loads) fn2-digests)))
   (fn2-run-load-digest c (+ i 1) row fn2-run-loads fn2-digests))))
(defmacro fn2-run-load-step-mv (code)
 `(mv ,code fn2-run-loads fn2-run-cursors fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
(defun fn2-run-bound-step (c budget fn2-run-loads fn2-run-cursors
 fn2-boot-config
 fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-cursors fn2-boot-config fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
 :guard (and (fn2-run-loads-wfp fn2-run-loads) (fn2-run-cursors-wfp fn2-run-cursors)
  (fn2-boot-config-wfp fn2-boot-config) (fn2-fc-wfp fn2-fc) (fn2-fc-context-wfp fn2-fc-context)
  (fn2-b3-wfp fn2-b3) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (fn2-digests-wfp fn2-digests))))
 (b* (((unless (and (posp budget) (<= budget *fn2-commit-unit-bytes*))) (fn2-run-load-step-mv :yield))
      ((unless (fn2-run-load-boundp c fn2-run-loads fn2-run-cursors))
       (fn2-run-load-step-mv :source))
      (phase (fn2-run-loads-phase c fn2-run-loads))
      (kind (fn2-run-loads-kind c fn2-run-loads)) (owner (fn2-run-loads-owner c fn2-run-loads))
      (generation (fn2-run-loads-generation c fn2-run-loads))
      (page (fn2-run-loads-page c fn2-run-loads)) (pgen (fn2-run-loads-page-gen c fn2-run-loads))
      (scratch (fn2-run-loads-scratch c fn2-run-loads)) (sgen (fn2-run-loads-scratch-gen c fn2-run-loads))
      (row (fn2-run-loads-checker c fn2-run-loads)) (base (* 128 row))
      ((when (equal phase *fn2-run-load-phase-wait*)) (fn2-run-load-step-mv :wait))
      ((when (equal phase *fn2-run-load-phase-read*)) (fn2-run-load-step-mv :need-read))
      ((unless (and (equal (fn2-run-loads-pending c fn2-run-loads) 0)
                    (eq (fn2-pool-workspace-code page pgen kind owner generation fn2-pool) :ok)
                    (eq (fn2-pool-workspace-code scratch sgen kind owner generation fn2-pool) :ok)
                    (< row (fn2-fc-rows fn2-fc)) (< row (fn2-fc-context-rows fn2-fc-context))
                    (fn2-b3-ready row fn2-b3 fn2-digests) (fn2-run-readerp base fn2-fields)))
       (fn2-run-load-step-mv :window)))
  (cond
   ((equal phase *fn2-run-load-phase-copy*)
    (b* ((copied (fn2-run-loads-copied c fn2-run-loads)) (sector (fn2-run-loads-sector c fn2-run-loads))
         ((unless (and (< copied *fn2-commit-unit-bytes*) (< sector *fn2-storage-extent-units*)
                        (equal (fn2-pool-fill scratch fn2-pool) *fn2-commit-unit-bytes*)))
          (fn2-run-load-step-mv :window))
         (n (min budget (- *fn2-commit-unit-bytes* copied)))
         ((mv code fn2-pool) (fn2-pool-copy-range scratch sgen copied page pgen (+ (* sector *fn2-commit-unit-bytes*) copied) n kind owner generation fn2-pool))
         ((unless (eq code :ok)) (fn2-run-load-step-mv code))
         (copied (+ copied n))
         (full (equal copied *fn2-commit-unit-bytes*))
         (next (+ sector (if full 1 0)))
         (fn2-run-loads (fn2-run-loads-put c (copied (if full 0 copied)) (sector next)
          (phase (if full (if (equal next *fn2-storage-extent-units*) *fn2-run-load-phase-context* *fn2-run-load-phase-read*) phase)))))
     (fn2-run-load-step-mv :more)))
   ((and (equal phase *fn2-run-load-phase-context*) (< budget 64)) (fn2-run-load-step-mv :yield))
   ((equal phase *fn2-run-load-phase-context*)
    (b* ((hash (fn2-digest-slot row *fn2-fc-hash*)) (geometry (fn2-digest-slot row *fn2-fc-geometry*))
         (previous (fn2-digest-slot row *fn2-fc-previous-seal*))
         ((unless (and (fn2-digest-rowp hash fn2-digests) (fn2-digest-rowp geometry fn2-digests)
                        (fn2-digest-rowp previous fn2-digests) (equal (fn2-pool-fill page fn2-pool) *fn2-format-page-size*)))
          (fn2-run-load-step-mv :bounds))
         ((mv code fn2-digests) (fn2-checkpoint-boot-geometry-load geometry fn2-boot-config fn2-digests))
         ((unless (eq code :ok)) (fn2-run-load-step-mv code))
         (fn2-digests (fn2-run-load-digest c 0 hash fn2-run-loads fn2-digests))
         (fn2-fc-context (fn2-fc-context-put row
          (location (fn2-run-loads-unit c fn2-run-loads)) (writer-epoch (fn2-run-loads-epoch c fn2-run-loads))
          (allocation (fn2-run-loads-allocation c fn2-run-loads)) (history (fn2-run-loads-history c fn2-run-loads))
          (incarnation (fn2-run-loads-incarnation c fn2-run-loads))
          (page-kind (fn2-run-layout-page-kind (fn2-run-loads-schema c fn2-run-loads) (fn2-run-loads-level c fn2-run-loads)))
          (encoded-length *fn2-format-page-size*) (hash hash) (geometry geometry) (previous-seal previous)))
         (fn2-fc (fn2-fc-set-phase row *fn2-fc-phase-idle* fn2-fc))
         (fn2-run-loads (fn2-run-loads-set-phase c *fn2-run-load-phase-verify* fn2-run-loads)))
     (fn2-run-load-step-mv :more)))
   ((equal phase *fn2-run-load-phase-verify*)
    (b* (((unless (equal (fn2-pool-fill page fn2-pool) *fn2-format-page-size*)) (fn2-run-load-step-mv :window))
         ((mv code fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
          (fn2-format-run :page nil row page pgen 0 *fn2-format-page-size* base kind owner generation budget
           fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
         (fn2-run-loads (fn2-run-loads-set-phase c
          (cond ((eq code :ok) *fn2-run-load-phase-header*) ((eq code :more) phase) (t *fn2-run-load-phase-uncertain*)) fn2-run-loads)))
     (fn2-run-load-step-mv (if (eq code :ok) :more code))))
   ((and (equal phase *fn2-run-load-phase-header*) (< budget *fn2-run-entries-base*)) (fn2-run-load-step-mv :yield))
   ((equal phase *fn2-run-load-phase-header*)
    (b* (((mv code fn2-fields) (fn2-checkpoint-semantic-page-read-header page pgen base
          (fn2-run-loads-schema c fn2-run-loads) (fn2-run-loads-run c fn2-run-loads) (fn2-run-loads-level c fn2-run-loads)
          kind owner generation fn2-fields fn2-pool))
         ((unless (and (eq code :ok) (equal (fn2-run-cursors-phase c fn2-run-cursors) *fn2-run-cursor-phase-miss*)))
          (let ((fn2-run-loads (fn2-run-loads-set-phase c *fn2-run-load-phase-uncertain* fn2-run-loads)))
           (fn2-run-load-step-mv :source-header)))
         (fn2-run-cursors (fn2-run-cursors-put c (slot page) (gen pgen) (phase *fn2-run-cursor-phase-header*)))
         (fn2-run-loads (fn2-run-loads-set-phase c *fn2-run-load-phase-ready* fn2-run-loads)))
     (fn2-run-load-step-mv :ready)))
   ((equal phase *fn2-run-load-phase-ready*) (fn2-run-load-step-mv :ready))
   (t (fn2-run-load-step-mv :recovery-required)))))

(fn2-run-load-frames fn2-run-bound-step
 (c budget fn2-run-loads fn2-run-cursors fn2-boot-config fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
 (fn2-run-loads fn2-run-cursors fn2-boot-config fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
 ((fn2-run-loads 1) (fn2-run-cursors 2) (fn2-fc 3) (fn2-fc-context 4) (fn2-b3 5) (fn2-fields 6) (fn2-pool 7) (fn2-digests 8)))

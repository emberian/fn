; Completed checkpoint constructions become ordinary framed allocation members.
; The persisted live control must bind the containing commit, batch and workspace
; before calling INSTALL. This primitive alone makes no durable-acceptance claim.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-tickets")
(include-book "format-events")
(include-book "layout-size-bounds")
(fn2-book-layer :b)
(defcodec-size-bounds fn2-format-allocation)
(defun fn2-checkpoint-allocation-ready-p (e fn2-checkpoint-construction fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-construction fn2-extents)
  :guard (and (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extents-wfp fn2-extents))))
 (and (equal (fn2-alloc-freeze-phase fn2-extents) 2)
      (fn2-checkpoint-construction-ownerp e fn2-checkpoint-construction fn2-extents)
      (< (fn2-checkpoint-construction-role e fn2-checkpoint-construction) 6)
      (posp (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction))
      (equal (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction)
             (fn2-checkpoint-construction-completed-bytes e fn2-checkpoint-construction))
      (eq (fn2-alloc-handle-code e
            (fn2-checkpoint-construction-epoch e fn2-checkpoint-construction)
            (fn2-checkpoint-construction-counter e fn2-checkpoint-construction) fn2-extents) :ok)
      (= (fn2-extents-state e fn2-extents) *fn2-extent-state-reserved*)))

(defun fn2-checkpoint-allocation-pack-member (e base slot gen off okind oslot ogen
                                            fn2-checkpoint-construction fn2-extents fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-construction fn2-extents fn2-fields fn2-pool)
  :guard (and (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extents-wfp fn2-extents)
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (if (not (and (fn2-checkpoint-allocation-ready-p e fn2-checkpoint-construction fn2-extents)
               (natp base) (<= (+ base *fn2-format-txn-record-num-fields* *fn2-format-allocation-num-fields*) (fn2-fields-rows fn2-fields))
               (unsigned-byte-p 32 off)
               (equal okind (fn2-alloc-freeze-owner-kind fn2-extents))
               (equal oslot (fn2-alloc-freeze-owner-slot fn2-extents))
               (equal ogen (fn2-alloc-freeze-owner-gen fn2-extents))))
     (mv :frozen off fn2-fields fn2-pool)
  (let* ((body (+ base *fn2-format-txn-record-num-fields*))
         (fn2-fields (fn2-fields-set-value (+ body *fn2-format-allocation-field-extent*) e fn2-fields))
         (fn2-fields (fn2-fields-set-value (+ body *fn2-format-allocation-field-writer-epoch*) (fn2-checkpoint-construction-epoch e fn2-checkpoint-construction) fn2-fields))
         (fn2-fields (fn2-fields-set-value (+ body *fn2-format-allocation-field-allocation*) (fn2-checkpoint-construction-counter e fn2-checkpoint-construction) fn2-fields))
         (fn2-fields (fn2-fields-set-value (+ body *fn2-format-allocation-field-owner-kind*) (fn2-alloc-freeze-owner-kind fn2-extents) fn2-fields))
         (fn2-fields (fn2-fields-set-value (+ body *fn2-format-allocation-field-owner*) (fn2-alloc-freeze-token fn2-extents) fn2-fields))
         (bytes (fn2-format-allocation-size body fn2-fields))
         (fn2-fields (fn2-fields-set-value (+ base *fn2-format-txn-record-field-record-kind*) *record-kind-allocation* fn2-fields))
         (fn2-fields (fn2-fields-set-value (+ base *fn2-format-txn-record-field-length*) bytes fn2-fields)))
   (mv-let (code next fn2-pool)
    (fn2-format-txn-record-encode base slot gen off okind oslot ogen fn2-fields fn2-pool)
    (if (not (eq code :ok)) (mv code next fn2-fields fn2-pool)
     (mv-let (code end fn2-pool)
      (fn2-format-allocation-encode body slot gen next okind oslot ogen fn2-fields fn2-pool)
      (mv code end fn2-fields fn2-pool)))))))
(fn2-pool-preserves fn2-checkpoint-allocation-pack-member
 (e base slot gen off okind oslot ogen fn2-checkpoint-construction fn2-extents fn2-fields fn2-pool)
 :hyps ((fn2-checkpoint-constructionp fn2-checkpoint-construction) (fn2-checkpoint-construction-wfp fn2-checkpoint-construction)
        (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents)
        (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
 :specs (("-FIELDS-TYPE" fn2-fieldsp 2) ("-FIELDS-WFP" fn2-fields-wfp 2) ("-FIELDS-ROWS" fn2-fields-rows 2 :frame fn2-fields)
         ("-POOL-TYPE" fn2-poolp 3) ("-POOL-WFP" fn2-pool-wfp 3) ("-POOL-ROWS" fn2-pool-rows 3 :frame fn2-pool)))

(defun fn2-checkpoint-allocation-install (base fn2-checkpoint-construction fn2-fields fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-construction fn2-fields fn2-extents)
  :guard (and (fn2-checkpoint-construction-wfp fn2-checkpoint-construction)
              (fn2-fields-wfp fn2-fields) (fn2-extents-wfp fn2-extents))))
 (b* (((unless (and (natp base) (<= (+ base *fn2-format-allocation-num-fields*) (fn2-fields-rows fn2-fields))))
       (mv :bounds fn2-extents))
      (e (fn2-fields-value (+ base *fn2-format-allocation-field-extent*) fn2-fields))
      (epoch (fn2-fields-value (+ base *fn2-format-allocation-field-writer-epoch*) fn2-fields))
      (counter (fn2-fields-value (+ base *fn2-format-allocation-field-allocation*) fn2-fields))
      (owner-kind (fn2-fields-value (+ base *fn2-format-allocation-field-owner-kind*) fn2-fields))
      (owner (fn2-fields-value (+ base *fn2-format-allocation-field-owner*) fn2-fields))
      ((unless (and (fn2-checkpoint-allocation-ready-p e fn2-checkpoint-construction fn2-extents)
                     (equal epoch (fn2-checkpoint-construction-epoch e fn2-checkpoint-construction))
                     (equal counter (fn2-checkpoint-construction-counter e fn2-checkpoint-construction))
                     (equal owner-kind (fn2-alloc-freeze-owner-kind fn2-extents))
                     (equal owner (fn2-alloc-freeze-token fn2-extents))))
       (mv :frozen fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-phase 0 fn2-extents))
      ((mv code fn2-extents) (fn2-alloc-commit-allocation e epoch counter owner-kind owner fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-phase 2 fn2-extents)))
  (mv code fn2-extents)))
(fn2-extents-preserves fn2-checkpoint-allocation-install
 (base fn2-checkpoint-construction fn2-fields fn2-extents)
 :hyps ((fn2-checkpoint-constructionp fn2-checkpoint-construction) (fn2-checkpoint-construction-wfp fn2-checkpoint-construction)
        (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents))
 :specs (("-TYPE" fn2-extentsp 1) ("-WFP" fn2-extents-wfp 1) ("-ROWS" fn2-extents-rows 1 :frame fn2-extents)))

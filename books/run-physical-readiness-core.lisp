; Live readiness validates parked resources against actual machine generation
; and the same admitted job geometry as their constructor. No caller flag.
(in-package "ACL2")
(include-book "run-physical-readiness-live")
(include-book "run-physical-core-faces")
(include-book "c-actor-loader")
(include-book "cursor-kind")
(fn2-book-layer :d)
(defcost fn2-run-load-readiness-owned-step
 :answers (:yield :row :changed :more :bounds :operation :capacity :complete)
 :steps *fn2-work-stage* :bytes 0 :descriptors 0
 :tables (fn2-core-checkpoint-summary fn2-core-c-source-control fn2-core-machines fn2-txn-table fn2-auth-table fn2-cns-table fn2-cursor-table fn2-sealer-table
  fn2-core-run-load-readiness fn2-core-run-load-geometry fn2-core-id-decides fn2-core-reads
  fn2-core-run-loads fn2-core-run-cursors fn2-core-checkpoint-summary-leases fn2-core-run-load-ops
  fn2-core-ops fn2-core-fc fn2-core-fc-context fn2-core-b3 fn2-core-fields fn2-core-digests fn2-core-pool)
 :doc "Check one initialized or actual-generation-owned parked loader row through the shared readiness scan.")
(defun fn2-run-load-region-member-p (c b0 n0 b1 n1 b2 n2)
 (declare (xargs :guard t))
 (and (natp c)
      (or (and (<= (nfix b0) c) (< c (+ (nfix b0) (nfix n0))))
          (and (<= (nfix b1) c) (< c (+ (nfix b1) (nfix n1))))
          (and (<= (nfix b2) c) (< c (+ (nfix b2) (nfix n2)))))))

(defmacro fn2-run-load-readiness-core-events ()
 '(progn
   (make-event
    (mv-let (err events) (fn2-run-loader-core-face-events '(fn2-run-load-readiness-live-begin-op) (w state))
     (if err (er soft 'fn2-run-load-readiness-core-events "~@0" err) (value (cons 'progn events)))))
   (defun fn2-run-load-parked-machine-current-p (c fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (b* (((mv code kind owner generation transactions reads)
          (stobj-let ((fn2-run-loads (fn2-core-run-loads fn2-core))
                      (fn2-id-decides (fn2-core-id-decides fn2-core))
                      (fn2-reads (fn2-core-reads fn2-core)))
           (code kind owner generation transactions reads)
           (if (and (natp c) (< c (fn2-run-loads-rows fn2-run-loads)))
            (mv :ok (fn2-run-loads-kind c fn2-run-loads) (fn2-run-loads-owner c fn2-run-loads)
             (fn2-run-loads-generation c fn2-run-loads) (fn2-id-decides-rows fn2-id-decides) (fn2-reads-rows fn2-reads))
            (mv :bounds 0 0 0 0 0))
           (mv code kind owner generation transactions reads)))
         ((unless (and (eq code :ok) (fn2-machine-idp owner fn2-core)
                       (eq (fn2-machine-generation-read-code owner fn2-core) :ok)
                       (equal generation (fn2-machine-generation owner fn2-core))
                       (posp generation) (equal kind (fn2-machine-kind owner fn2-core)))) nil))
     (cond
      ((member kind (list *fn2-txn-kind* *fn2-auth-kind* *fn2-cns-kind*))
       (mv-let (planned actual-kind b0 n0 b1 n1 b2 n2)
        (fn2-c-actor-loader-plan owner generation fn2-core)
        (and (eq planned :ok) (equal actual-kind kind)
             (fn2-run-load-region-member-p c b0 n0 b1 n1 b2 n2))))
      ((equal kind *fn2-cursor-kind*)
       (and (eq (fn2-cursor-snapshot-read-code owner fn2-core) :ok)
            (not (member (fn2-machine-phase owner fn2-core) (list *fn2-cursor-state-free* *fn2-cursor-state-retired*)))
            (let ((read0 (* *fn2-b-query-read-rows* (fn2-machine-slot owner fn2-core))))
             (and (<= (+ read0 *fn2-b-query-read-rows*) reads)
                  (fn2-run-load-region-member-p c (+ transactions read0) *fn2-b-query-read-rows*
                   (+ transactions reads (* *fn2-b-range-source-cursors* read0))
                   (* *fn2-b-query-read-rows* *fn2-b-range-source-cursors*) 0 0)))))
      ((equal kind *fn2-sealer-kind*)
       (and (eq (fn2-sealer-snapshot-read-code owner fn2-core) :ok)
            (equal owner (fn2-machine-kind-base *fn2-sealer-kind* fn2-core))
            (equal (fn2-machine-stopped owner fn2-core) 0)
            (fn2-run-load-region-member-p c (+ transactions reads (* *fn2-b-range-source-cursors* reads))
             *fn2-idc-seal-cursors* 0 0 0 0)))
      ; Borrowed checkpoint/archive jobs must actually detach to IDLE; their
      ; descriptor authority is not a served actor's owned-window capability.
      (t nil))))
   (in-theory (disable fn2-run-load-parked-machine-current-p))

   (defun fn2-run-load-readiness-owned-step (budget fn2-core)
    (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
    (b* (((unless (posp budget)) (mv :yield fn2-core))
         (current (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
                             (fn2-c-source-control (fn2-core-c-source-control fn2-core))
                             (fn2-run-load-readiness (fn2-core-run-load-readiness fn2-core))) (current)
          (fn2-run-load-readiness-live-current-p fn2-checkpoint-summary fn2-c-source-control fn2-run-load-readiness) current))
         ((unless current) (mv :changed fn2-core))
         ((mv parked c kind owner generation)
          (stobj-let ((fn2-run-load-readiness (fn2-core-run-load-readiness fn2-core))
                      (fn2-run-loads (fn2-core-run-loads fn2-core)))
           (parked c kind owner generation)
           (let ((c (if (< 0 (fn2-run-load-readiness-rows fn2-run-load-readiness))
                     (fn2-run-load-readiness-row 0 fn2-run-load-readiness) 0)))
            (if (and (< 0 (fn2-run-load-readiness-rows fn2-run-load-readiness))
                     (equal (fn2-run-load-readiness-phase 0 fn2-run-load-readiness) *fn2-run-load-readiness-phase-cursors*)
                     (< c (fn2-run-loads-rows fn2-run-loads))
                     (equal (fn2-run-loads-phase c fn2-run-loads) *fn2-run-load-phase-reserved*))
             (mv t c (fn2-run-loads-kind c fn2-run-loads) (fn2-run-loads-owner c fn2-run-loads) (fn2-run-loads-generation c fn2-run-loads))
             (mv nil c 0 0 0)))
           (mv parked c kind owner generation)))
         ((unless (or (not parked) (fn2-run-load-parked-machine-current-p c fn2-core)))
          (mv :row fn2-core)))
     (stobj-let ((fn2-run-load-readiness (fn2-core-run-load-readiness fn2-core))
                 (fn2-run-load-geometry (fn2-core-run-load-geometry fn2-core))
                 (fn2-id-decides (fn2-core-id-decides fn2-core)) (fn2-reads (fn2-core-reads fn2-core))
                 (fn2-run-loads (fn2-core-run-loads fn2-core)) (fn2-run-cursors (fn2-core-run-cursors fn2-core))
                 (fn2-checkpoint-summary-leases (fn2-core-checkpoint-summary-leases fn2-core))
                 (fn2-run-load-ops (fn2-core-run-load-ops fn2-core)) (fn2-ops (fn2-core-ops fn2-core))
                 (fn2-fc (fn2-core-fc fn2-core)) (fn2-fc-context (fn2-core-fc-context fn2-core))
                 (fn2-b3 (fn2-core-b3 fn2-core)) (fn2-fields (fn2-core-fields fn2-core))
                 (fn2-digests (fn2-core-digests fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
      (code fn2-run-load-readiness)
      (fn2-run-load-readiness-step-with-owner budget kind owner generation fn2-run-load-readiness fn2-run-load-geometry
       fn2-id-decides fn2-reads fn2-run-loads fn2-run-cursors fn2-checkpoint-summary-leases fn2-run-load-ops fn2-ops
       fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-digests fn2-pool)
      (mv code fn2-core))))
   (fn2-core-preserves fn2-run-load-readiness-owned-step (budget fn2-core) :position 1 :rows nil)
   (in-theory (disable fn2-run-load-readiness-owned-step))))

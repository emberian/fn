; Root1 owns private bounded working resources, not a second resident store.
; Admission precedes the C cut: an actor must never hold the cut while waiting
; for windows retained by an earlier resident sealer continuation.
(in-package "ACL2")
(include-book "checkpoint-metadata-manifest")
(include-book "checkpoint-payload")
(include-book "checkpoint-semantic-retention")
(include-book "machines-c-sealer")
(fn2-book-layer :c)

(defconst *fn2-checkpoint-source-build* 1)
(defconst *fn2-checkpoint-manifest-build* 2)
(defconst *fn2-checkpoint-window-count* 19)
(defconst *fn2-checkpoint-work-field-rows*
 (+ (* 2 *fn2-run-build-fields*) (* 2 *fn2-run-entry-rows*) *fn2-run-reader-fields*))
(assert-event (<= *fn2-checkpoint-work-field-rows* *fn2-b-checkpoint-field-rows*))

(defun fn2-checkpoint-source-wbase () *fn2-seal-writer-rows*)
(defun fn2-checkpoint-manifest-wbase () (+ *fn2-seal-writer-rows* *fn2-run-max-levels*))
(defun fn2-checkpoint-source-cursor (trows rrows)
 (declare (xargs :guard t))
 (+ (nfix trows) (* 9 (nfix rrows)) *fn2-idc-seal-cursors*))
(defun fn2-checkpoint-work-fbase (fcrows)
 (declare (xargs :guard t)) (* 128 (nfix fcrows)))
(defun fn2-checkpoint-manifest-fbase (fcrows)
 (declare (xargs :guard t)) (+ (fn2-checkpoint-work-fbase fcrows) *fn2-run-build-fields*))
(defun fn2-checkpoint-source-ebase (fcrows)
 (declare (xargs :guard t)) (+ (fn2-checkpoint-manifest-fbase fcrows) *fn2-run-build-fields*))
(defun fn2-checkpoint-manifest-ebase (fcrows)
 (declare (xargs :guard t)) (+ (fn2-checkpoint-source-ebase fcrows) *fn2-run-entry-rows*))
(defun fn2-checkpoint-source-rbase (fcrows)
 (declare (xargs :guard t)) (+ (fn2-checkpoint-manifest-ebase fcrows) *fn2-run-entry-rows*))

; Windows 0..5 source levels; 6..11 directory levels; 12/13 hash arrays;
; 14 held decoded entry; 15 directory digest; 16 authenticated semantic page;
; 17 semantic read/payload manifest; 18 payload data. Sharing window17 is
; sequential: semantic holds its authenticated page while payload uses17/18.
(defun fn2-checkpoint-window-length (i)
 (declare (xargs :guard t))
 (cond ((or (< (nfix i) 12) (equal i 14) (equal i 16)) *fn2-run-page-size*)
       ((or (equal i 12) (equal i 13)) (* 32 *fn2-run-max-levels*))
       ((equal i 15) 64) (t 4096)))
(defcolumns fn2-checkpoint-windows ((live :bool) (slot :u32) (generation :u60)))
(defcolumns fn2-checkpoint-root1
 ((phase (:enum fn2-checkpoint-root1-phase (:idle :reserved :select :source :retention :semantic :payload :format :page :manifest :finish :scan :complete :uncertain)))
  (owner-kind :u8) (owner-slot :u32) (owner-gen :u60) (token :u60)
  (reserved :u8) (build :u32) (level :u8) (read-kind :u8)))

(defun fn2-checkpoint-window-class-demand (i class fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (natp i) (<= i *fn2-checkpoint-window-count*))
                 :measure (nfix (- *fn2-checkpoint-window-count* i))))
 (if (>= i *fn2-checkpoint-window-count*) 0
  (+ (if (equal class (fn2-pool-class-for (fn2-checkpoint-window-length i) fn2-pool)) 1 0)
     (fn2-checkpoint-window-class-demand (+ i 1) class fn2-pool))))
(defun fn2-checkpoint-window-roomp (i fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (and (natp i) (<= i *fn2-checkpoint-window-count*))
                 :measure (nfix (- *fn2-checkpoint-window-count* i))))
 (if (>= i *fn2-checkpoint-window-count*) t
  (let ((class (fn2-pool-class-for (fn2-checkpoint-window-length i) fn2-pool)))
   (and (natp class) (< class (fn2-pool-nclasses fn2-pool))
        (<= (fn2-checkpoint-window-class-demand 0 class fn2-pool) (fn2-pool-free-count class fn2-pool))
        (fn2-checkpoint-window-roomp (+ i 1) fn2-pool)))))

(defun fn2-checkpoint-windows-reserve-loop (i kind owner generation fn2-checkpoint-root1 fn2-checkpoint-windows fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-root1 fn2-checkpoint-windows fn2-pool)
  :guard (and (fn2-checkpoint-root1-wfp fn2-checkpoint-root1) (< 0 (fn2-checkpoint-root1-rows fn2-checkpoint-root1))
              (fn2-checkpoint-windows-wfp fn2-checkpoint-windows) (<= *fn2-checkpoint-window-count* (fn2-checkpoint-windows-rows fn2-checkpoint-windows))
              (fn2-pool-wfp fn2-pool) (natp i) (<= i *fn2-checkpoint-window-count*))
  :measure (nfix (- *fn2-checkpoint-window-count* i))))
 (if (>= i *fn2-checkpoint-window-count*)
  (let ((fn2-checkpoint-root1 (fn2-checkpoint-root1-set-phase 0 *fn2-checkpoint-root1-phase-reserved* fn2-checkpoint-root1)))
   (mv :ok fn2-checkpoint-root1 fn2-checkpoint-windows fn2-pool))
  (b* ((class (fn2-pool-class-for (fn2-checkpoint-window-length i) fn2-pool))
       ((mv code slot gen fn2-pool) (fn2-pool-reserve class kind owner generation fn2-pool))
       ((unless (eq code :ok))
        (let ((fn2-checkpoint-root1 (fn2-checkpoint-root1-set-phase 0 *fn2-checkpoint-root1-phase-uncertain* fn2-checkpoint-root1)))
         (mv code fn2-checkpoint-root1 fn2-checkpoint-windows fn2-pool)))
       (fn2-checkpoint-windows (fn2-checkpoint-windows-put i (live 1) (slot slot) (generation gen)))
       (fn2-checkpoint-root1 (fn2-checkpoint-root1-set-reserved 0 (+ i 1) fn2-checkpoint-root1)))
   (fn2-checkpoint-windows-reserve-loop (+ i 1) kind owner generation fn2-checkpoint-root1 fn2-checkpoint-windows fn2-pool))))

(defun fn2-checkpoint-root1-reserve (kind owner generation fn2-checkpoint-root1 fn2-checkpoint-windows fn2-csnapshot fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-root1 fn2-checkpoint-windows fn2-csnapshot fn2-pool)
  :guard (and (fn2-checkpoint-root1-wfp fn2-checkpoint-root1) (fn2-checkpoint-windows-wfp fn2-checkpoint-windows)
              (fn2-csnapshot-wfp fn2-csnapshot) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (< 0 (fn2-checkpoint-root1-rows fn2-checkpoint-root1))
                    (<= *fn2-checkpoint-window-count* (fn2-checkpoint-windows-rows fn2-checkpoint-windows))
                    (< 0 (fn2-csnapshot-rows fn2-csnapshot))
                    (equal (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-idle*)
                    (equal (fn2-checkpoint-root1-phase 0 fn2-checkpoint-root1) *fn2-checkpoint-root1-phase-idle*)
                    (equal (fn2-checkpoint-root1-reserved 0 fn2-checkpoint-root1) 0)
                    (fn2-pool-mrefp kind owner generation)))
       (mv :owner fn2-checkpoint-root1 fn2-checkpoint-windows fn2-pool))
      ((unless (fn2-checkpoint-window-roomp 0 fn2-pool)) (mv :exhausted fn2-checkpoint-root1 fn2-checkpoint-windows fn2-pool))
      (fn2-checkpoint-root1 (fn2-checkpoint-root1-put 0 (owner-kind kind) (owner-slot owner) (owner-gen generation))))
  (fn2-checkpoint-windows-reserve-loop 0 kind owner generation fn2-checkpoint-root1 fn2-checkpoint-windows fn2-pool)))

(defun fn2-checkpoint-root1-workspaces (kind owner generation fn2-checkpoint-root1 fn2-checkpoint-windows fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-root1 fn2-checkpoint-windows fn2-pool)
  :guard (and (fn2-checkpoint-root1-wfp fn2-checkpoint-root1) (fn2-checkpoint-windows-wfp fn2-checkpoint-windows)
              (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (< 0 (fn2-checkpoint-root1-rows fn2-checkpoint-root1))
                    (<= *fn2-checkpoint-window-count* (fn2-checkpoint-windows-rows fn2-checkpoint-windows))
                    (equal (fn2-checkpoint-root1-reserved 0 fn2-checkpoint-root1) *fn2-checkpoint-window-count*)
                    (not (equal (fn2-checkpoint-root1-phase 0 fn2-checkpoint-root1) *fn2-checkpoint-root1-phase-idle*))
                    (equal kind (fn2-checkpoint-root1-owner-kind 0 fn2-checkpoint-root1))
                    (equal owner (fn2-checkpoint-root1-owner-slot 0 fn2-checkpoint-root1))
                    (equal generation (fn2-checkpoint-root1-owner-gen 0 fn2-checkpoint-root1))))
       (mv :owner 0 0 0 0 0 0))
      (page (fn2-checkpoint-windows-slot 16 fn2-checkpoint-windows))
      (pgen (fn2-checkpoint-windows-generation 16 fn2-checkpoint-windows))
      (scratch (fn2-checkpoint-windows-slot 14 fn2-checkpoint-windows))
      (sgen (fn2-checkpoint-windows-generation 14 fn2-checkpoint-windows))
      (read (fn2-checkpoint-windows-slot 18 fn2-checkpoint-windows))
      (rgen (fn2-checkpoint-windows-generation 18 fn2-checkpoint-windows))
      ((unless (and (equal (fn2-checkpoint-windows-live 16 fn2-checkpoint-windows) 1)
                    (equal (fn2-checkpoint-windows-live 14 fn2-checkpoint-windows) 1)
                    (equal (fn2-checkpoint-windows-live 18 fn2-checkpoint-windows) 1)
                    (eq (fn2-pool-workspace-code page pgen kind owner generation fn2-pool) :ok)
                    (eq (fn2-pool-workspace-code scratch sgen kind owner generation fn2-pool) :ok)
                    (eq (fn2-pool-workspace-code read rgen kind owner generation fn2-pool) :ok)))
       (mv :busy 0 0 0 0 0 0)))
  (mv :ok page pgen scratch sgen read rgen)))

(fn2-checkpoint-root1-preserves fn2-checkpoint-root1-reserve
 (kind owner generation fn2-checkpoint-root1 fn2-checkpoint-windows fn2-csnapshot fn2-pool)
 :hyps ((fn2-checkpoint-root1p fn2-checkpoint-root1) (fn2-checkpoint-root1-wfp fn2-checkpoint-root1)
        (fn2-checkpoint-windowsp fn2-checkpoint-windows) (fn2-checkpoint-windows-wfp fn2-checkpoint-windows)
        (fn2-csnapshotp fn2-csnapshot) (fn2-csnapshot-wfp fn2-csnapshot)
        (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
 :specs (("-CHECKPOINT-ROOT1-TYPE" fn2-checkpoint-root1p 1)
         ("-CHECKPOINT-ROOT1-WFP" fn2-checkpoint-root1-wfp 1)
         ("-CHECKPOINT-ROOT1-ROWS" fn2-checkpoint-root1-rows 1 :frame fn2-checkpoint-root1)
         ("-CHECKPOINT-WINDOWS-TYPE" fn2-checkpoint-windowsp 2)
         ("-CHECKPOINT-WINDOWS-WFP" fn2-checkpoint-windows-wfp 2)
         ("-CHECKPOINT-WINDOWS-ROWS" fn2-checkpoint-windows-rows 2 :frame fn2-checkpoint-windows)
         ("-POOL-TYPE" fn2-poolp 3)
         ("-POOL-WFP" fn2-pool-wfp 3)
         ("-POOL-ROWS" fn2-pool-rows 3 :frame fn2-pool)
         ("-POOL-DATA" fn2-pool-data-length 3 :frame fn2-pool)))

(fn2-sealer-child fn2-core-checkpoint-root1 fn2-checkpoint-root1 (fn2-checkpoint-root1-init 1 fn2-checkpoint-root1)
 "The actual root1 source continuation and admitted window ownership survive yields.")
(fn2-sealer-child fn2-core-checkpoint-windows fn2-checkpoint-windows (fn2-checkpoint-windows-init *fn2-checkpoint-window-count* fn2-checkpoint-windows)
 "Fixed working windows are admitted before the held C cut; no stored-data ceiling.")
(fn2-sealer-child fn2-core-checkpoint-metadata fn2-checkpoint-metadata (fn2-checkpoint-metadata-init 1 fn2-checkpoint-metadata)
 "The held source's actual entry and run assembly continuation.")
(fn2-sealer-child fn2-core-checkpoint-source fn2-checkpoint-source (fn2-checkpoint-source-init 1 fn2-checkpoint-source)
 "Ordered selection exhausts the actual held overlays and resident runs.")
(fn2-sealer-child fn2-core-checkpoint-metadata-manifest fn2-checkpoint-metadata-manifest (fn2-checkpoint-metadata-manifest-init 1 fn2-checkpoint-metadata-manifest)
 "The directory's actual writer and full role1 completion scan.")
(fn2-sealer-child fn2-core-checkpoint-retained-entry fn2-checkpoint-retained-entry (fn2-checkpoint-retained-entry-init 1 fn2-checkpoint-retained-entry)
 "One protected authenticated entry passes between semantic and payload walkers.")
(fn2-sealer-child fn2-core-checkpoint-payload fn2-checkpoint-payload (fn2-checkpoint-payload-init 1 fn2-checkpoint-payload)
 "Actual raw/manifest payload reads and the persisted stored-source digest stream.")
(fn2-sealer-child fn2-core-checkpoint-semantic fn2-checkpoint-semantic (fn2-checkpoint-semantic-init 1 fn2-checkpoint-semantic)
 "Authenticated semantic tree traversal retains its actual page and entry origin.")
(fn2-sealer-child fn2-core-checkpoint-semantic-work fn2-checkpoint-semantic-work
 (fn2-checkpoint-semantic-work-init (fn2-b-capacity :extent-slots 16 profile) fn2-checkpoint-semantic-work)
 "One exact semantic traversal row per allocator extent, with no arbitrary data cap.")

; The pre-cut future reserve owns maintenance staging. The shared lifecycle
; control and future borrowed marker record its one-flight logical loan; no
; maintenance path frees this lease.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-future-resources")
(fn2-book-layer :b)
(defmacro fn2-checkpoint-maintenance-staging-events ()
 '(progn
 (local (in-theory (disable fn2-core-wfp
   fn2-checkpoint-future-rows fn2-checkpoint-future-windows-rows
   fn2-checkpoint-future-candidate fn2-checkpoint-future-bind
   fn2-checkpoint-future-lease fn2-checkpoint-future-staging-return
   fn2-checkpoint-future-windows-borrowed fn2-checkpoint-future-windows-borrower-kind
   fn2-checkpoint-future-windows-borrower-slot fn2-checkpoint-future-windows-borrower-gen
   fn2-retirement-control-rows fn2-retirement-control-state
   fn2-retirement-control-allocation-member fn2-retirement-control-installation-member
   fn2-retirement-control-slot fn2-retirement-control-gen fn2-retirement-control-owner-kind
   fn2-retirement-control-owner-slot fn2-retirement-control-owner-gen
   fn2-retirement-control-candidate fn2-retirement-control-token
   fn2-pool-reset fn2-pool-cap)))
 (defun fn2-checkpoint-staging-claim (expected-c okind oslot ogen need fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-checkpoint-future (fn2-core-checkpoint-future fn2-core))
              (fn2-checkpoint-future-windows (fn2-core-checkpoint-future-windows fn2-core))
              (fn2-extents (fn2-core-extents fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
   (code c token slot gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)
   (b* (((unless (and (< 0 (fn2-checkpoint-future-rows fn2-checkpoint-future))
                      (< 0 (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows))
                      (= (fn2-checkpoint-future-windows-borrowed 0 fn2-checkpoint-future-windows) 0)
                      (unsigned-byte-p 32 expected-c) (posp need) (posp okind) (unsigned-byte-p 8 okind)
                      (unsigned-byte-p 32 oslot) (unsigned-byte-p 60 ogen)))
         (mv :state 0 0 0 0 fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
        (c (fn2-checkpoint-future-candidate 0 fn2-checkpoint-future))
        (token (fn2-alloc-freeze-token fn2-extents))
        ((unless (equal c expected-c)) (mv :owner 0 0 0 0 fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
        ((mv bound fn2-checkpoint-future)
         (fn2-checkpoint-future-bind c token okind oslot ogen fn2-checkpoint-future fn2-extents))
        ((unless (eq bound :ok)) (mv bound 0 0 0 0 fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
        ((mv code slot gen) (fn2-checkpoint-future-lease 0 token okind oslot ogen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
        ((unless (and (eq code :ok) (natp slot) (< slot (fn2-pool-rows fn2-pool))
                       (<= need (fn2-pool-cap slot fn2-pool))))
         (mv :capacity 0 0 0 0 fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
        ((mv reset fn2-pool) (fn2-pool-reset slot gen okind oslot ogen fn2-pool))
        ((unless (eq reset :ok)) (mv reset 0 0 0 0 fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool))
        ; A same-owner logical loan needs no HAND-to-self. Its actual borrowed
        ; marker prevents central cleanup until exact lifecycle handback.
        (fn2-checkpoint-future-windows (fn2-checkpoint-future-windows-put 0
         (borrowed 1) (borrower-kind okind) (borrower-slot oslot) (borrower-gen ogen))))
    (mv :ok c token slot gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool)) (mv code c token slot gen fn2-core)))
 (fn2-core-preserves fn2-checkpoint-staging-claim (expected-c okind oslot ogen need fn2-core) :position 5 :rows nil)
 (defun fn2-checkpoint-staging-current (okind oslot ogen need fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (let ((c (stobj-let ((fn2-checkpoint-future (fn2-core-checkpoint-future fn2-core))) (c)
             (if (< 0 (fn2-checkpoint-future-rows fn2-checkpoint-future)) (fn2-checkpoint-future-candidate 0 fn2-checkpoint-future) 0) c)))
   (fn2-checkpoint-staging-claim c okind oslot ogen need fn2-core)))
 (fn2-core-preserves fn2-checkpoint-staging-current (okind oslot ogen need fn2-core) :position 5 :rows nil)

 (defun fn2-checkpoint-staging-match-p (slot gen okind oslot ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))
              (fn2-checkpoint-future (fn2-core-checkpoint-future fn2-core))
              (fn2-checkpoint-future-windows (fn2-core-checkpoint-future-windows fn2-core))
              (fn2-pool (fn2-core-pool fn2-core))) (bound)
   (and (< 0 (fn2-retirement-control-rows fn2-retirement-control))
        (< 0 (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows))
        (= (fn2-checkpoint-future-windows-borrowed 0 fn2-checkpoint-future-windows) 1)
        (equal okind (fn2-checkpoint-future-windows-borrower-kind 0 fn2-checkpoint-future-windows))
        (equal oslot (fn2-checkpoint-future-windows-borrower-slot 0 fn2-checkpoint-future-windows))
        (equal ogen (fn2-checkpoint-future-windows-borrower-gen 0 fn2-checkpoint-future-windows))
        (member-equal (fn2-retirement-control-state 0 fn2-retirement-control)
         (list *fn2-retirement-state-scanning* *fn2-retirement-state-staged* *fn2-retirement-state-waiting*))
        (or (= (fn2-retirement-control-allocation-member 0 fn2-retirement-control) 1)
            (= (fn2-retirement-control-installation-member 0 fn2-retirement-control) 1))
        (equal slot (fn2-retirement-control-slot 0 fn2-retirement-control))
        (equal gen (fn2-retirement-control-gen 0 fn2-retirement-control))
        (equal okind (fn2-retirement-control-owner-kind 0 fn2-retirement-control))
        (equal oslot (fn2-retirement-control-owner-slot 0 fn2-retirement-control))
        (equal ogen (fn2-retirement-control-owner-gen 0 fn2-retirement-control))
        (eq (fn2-checkpoint-future-staging-return (fn2-retirement-control-candidate 0 fn2-retirement-control)
             (fn2-retirement-control-token 0 fn2-retirement-control) okind oslot ogen slot gen
             fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool) :ok)) bound))
 (defun fn2-checkpoint-staging-active-p (fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((mv slot gen kind owner generation)
        (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))) (slot gen kind owner generation)
         (if (< 0 (fn2-retirement-control-rows fn2-retirement-control))
             (mv (fn2-retirement-control-slot 0 fn2-retirement-control) (fn2-retirement-control-gen 0 fn2-retirement-control)
                 (fn2-retirement-control-owner-kind 0 fn2-retirement-control) (fn2-retirement-control-owner-slot 0 fn2-retirement-control)
                 (fn2-retirement-control-owner-gen 0 fn2-retirement-control)) (mv 0 0 0 0 0))
         (mv slot gen kind owner generation))))
   (fn2-checkpoint-staging-match-p slot gen kind owner generation fn2-core)))

 (defun fn2-checkpoint-lifecycle-release (slot gen okind oslot ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((mv maintenance exact c token)
        (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))) (maintenance exact c token)
         (if (< 0 (fn2-retirement-control-rows fn2-retirement-control))
          (mv (or (= (fn2-retirement-control-allocation-member 0 fn2-retirement-control) 1)
                  (= (fn2-retirement-control-installation-member 0 fn2-retirement-control) 1))
              (and (equal slot (fn2-retirement-control-slot 0 fn2-retirement-control))
                   (equal gen (fn2-retirement-control-gen 0 fn2-retirement-control))
                   (equal okind (fn2-retirement-control-owner-kind 0 fn2-retirement-control))
                   (equal oslot (fn2-retirement-control-owner-slot 0 fn2-retirement-control))
                   (equal ogen (fn2-retirement-control-owner-gen 0 fn2-retirement-control)))
              (fn2-retirement-control-candidate 0 fn2-retirement-control)
              (fn2-retirement-control-token 0 fn2-retirement-control))
          (mv nil nil 0 0)) (mv maintenance exact c token)))
       ((unless maintenance) (fn2-core-release slot gen okind oslot ogen fn2-core))
       ((unless exact) (mv :owner fn2-core)))
   (stobj-let ((fn2-checkpoint-future (fn2-core-checkpoint-future fn2-core))
               (fn2-checkpoint-future-windows (fn2-core-checkpoint-future-windows fn2-core))
               (fn2-extents (fn2-core-extents fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (code fn2-checkpoint-future-windows)
    (if (not (and (= (fn2-alloc-freeze-phase fn2-extents) 2) (equal token (fn2-alloc-freeze-token fn2-extents))))
        (mv :frozen fn2-checkpoint-future-windows)
     (if (and (< 0 (fn2-checkpoint-future-windows-rows fn2-checkpoint-future-windows))
              (= (fn2-checkpoint-future-windows-borrowed 0 fn2-checkpoint-future-windows) 1)
              (equal okind (fn2-checkpoint-future-windows-borrower-kind 0 fn2-checkpoint-future-windows))
              (equal oslot (fn2-checkpoint-future-windows-borrower-slot 0 fn2-checkpoint-future-windows))
              (equal ogen (fn2-checkpoint-future-windows-borrower-gen 0 fn2-checkpoint-future-windows))
              (eq (fn2-checkpoint-future-staging-return c token okind oslot ogen slot gen fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool) :ok))
         (let* ((fn2-checkpoint-future-windows (fn2-checkpoint-future-windows-put 0 (borrowed 0) (borrower-kind 0) (borrower-slot 0) (borrower-gen 0))))
          (mv :ok fn2-checkpoint-future-windows))
       (mv :owner fn2-checkpoint-future-windows))) (mv code fn2-core))))
 (fn2-core-preserves fn2-checkpoint-lifecycle-release (slot gen okind oslot ogen fn2-core) :position 1 :rows nil)
 ))

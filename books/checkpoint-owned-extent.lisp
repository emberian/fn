; Physical ownership outlives an individual checkpoint candidate. This
; classifier grants no reservation, page completion, protector drop or FREE.
(in-package "ACL2")
(include-book "checkpoint-construction")
(fn2-book-layer :b)
(defun fn2-checkpoint-owned-extent-p (checkpoint-kind e fn2-checkpoint-construction fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-construction fn2-extents)
  :guard (and (fn2-checkpoint-construction-wfp fn2-checkpoint-construction) (fn2-extents-wfp fn2-extents))))
 (and (unsigned-byte-p 8 checkpoint-kind) (posp checkpoint-kind)
      (fn2-alloc-slotp e fn2-extents) (< e (fn2-checkpoint-construction-rows fn2-checkpoint-construction))
      (= (fn2-checkpoint-construction-live e fn2-checkpoint-construction) 1)
      (= (fn2-extents-state e fn2-extents) *fn2-extent-state-allocated*)
      (= (fn2-extents-owner-kind e fn2-extents) checkpoint-kind)
      (posp (fn2-extents-owner-id e fn2-extents))
      (eq (fn2-alloc-handle-code e (fn2-checkpoint-construction-epoch e fn2-checkpoint-construction)
                                  (fn2-checkpoint-construction-counter e fn2-checkpoint-construction) fn2-extents) :ok)
      (if (= (fn2-checkpoint-construction-role e fn2-checkpoint-construction) *fn2-checkpoint-owned-restored-role*)
       ; The selected-map cursor supplied only this exact physical identity.
       ; Unknown historical actor/completion is not minted after reboot.
       (and (= (fn2-checkpoint-construction-token e fn2-checkpoint-construction) 0)
            (= (fn2-checkpoint-construction-owner-kind e fn2-checkpoint-construction) 0)
            (= (fn2-checkpoint-construction-owner-slot e fn2-checkpoint-construction) 0)
            (= (fn2-checkpoint-construction-owner-gen e fn2-checkpoint-construction) 0)
            (= (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction) 0)
            (= (fn2-checkpoint-construction-completed-bytes e fn2-checkpoint-construction) 0)
            (= (fn2-checkpoint-construction-ticket-claimed e fn2-checkpoint-construction) 0)
            (= (fn2-checkpoint-construction-ticket-batch e fn2-checkpoint-construction) 0))
       (and (fn2-checkpoint-construction-native-p e fn2-checkpoint-construction)
            (< (fn2-checkpoint-construction-role e fn2-checkpoint-construction) 6)
            (= (fn2-checkpoint-construction-owner-kind e fn2-checkpoint-construction) checkpoint-kind)
            (= (fn2-checkpoint-construction-token e fn2-checkpoint-construction) (fn2-extents-owner-id e fn2-extents))
            (posp (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction))
            (= (fn2-checkpoint-construction-intended-bytes e fn2-checkpoint-construction)
               (fn2-checkpoint-construction-completed-bytes e fn2-checkpoint-construction))))))

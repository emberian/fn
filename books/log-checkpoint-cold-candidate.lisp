; One metadata-only checkpoint candidate. PGS owns every validity verdict;
; LC supplies only the metadata indices from its checkpoint layout.
(in-package "ACL2")
(include-book "log-checkpoint-open-read-trace")

(defun fn-lc-cold-range (count offset)
 (declare (xargs :guard t :measure (nfix count)))
 (if (zp (nfix count)) nil
  (cons (nfix offset) (fn-lc-cold-range (1- (nfix count)) (+ 1 (nfix offset))))))
(defun fn-lc-cold-entries (indices table)
 (declare (xargs :guard t))
 (if (consp indices)
  (cons (fn-lc-at (nfix (car indices)) table)
        (fn-lc-cold-entries (cdr indices) table)) nil))
(defun fn-lc-cold-physical (entries)
 (declare (xargs :guard t))
 (if (consp entries)
  (cons (fn-lc-head (car entries)) (fn-lc-cold-physical (cdr entries))) nil))
(defun fn-lc-cold-candidate-control (rec table header pages prefix)
 (declare (xargs :guard t :verify-guards nil))
 (let ((lengths (fn-lc-layout-lengths header)))
  (if (not (and (fn-lc-headerp header) (fn-lc-lengths-p lengths)
                (equal (len lengths) 8)
                (equal (len table)
                  (+ 1 (fn-lc-lengths-sum lengths)
                     (len (fn-lc-at 4 header)) (len (fn-lc-at 5 header))))))
      (list '(:refused :checkpoint-layout) table nil prefix)
   (let* ((indices (fn-lc-cold-range (+ (len (fn-lc-at 4 header))
                                       (len (fn-lc-at 5 header)))
                                     (+ 1 (fn-lc-lengths-sum lengths))))
          (entries (fn-lc-cold-entries indices table))
          (trace (fn-lc-join prefix
                  (fn-lc-pgs-checked-requests entries (pgs-rec-txid rec) :eager pages)))
          (bad (ec-call (pgs-check-pages entries (pgs-rec-txid rec) :eager pages 0 :page-damaged))))
    (cond (bad (list (cons :refused bad) table nil trace))
          ((not (equal (ec-call (pgs-contents entries pages))
                       (fn-lc-join (fn-lc-at 4 header) (fn-lc-at 5 header))))
           (list '(:refused :checkpoint-metadata) table nil trace))
          (t (list (list :ok (pgs-rec-txid rec)) table header trace)))))))
(defun fn-lc-cold-candidate-table (rec pages directory prefix)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((txid (pgs-rec-txid rec))
        (trace (fn-lc-join prefix (fn-lc-pgs-checked-requests directory txid :eager pages)))
        (bad (ec-call (pgs-check-pages directory txid :eager pages 0 :table-damaged))))
  (if bad (list (cons :refused bad) nil nil trace)
   (let* ((cs (ec-call (pgs-contents directory pages)))
          (tv (ec-call (pgs-tables-verdict cs (pgs-rec-npages rec) txid 0)))
          (table (pgs-flatten cs)))
    (cond (tv (list (cons :refused tv) nil nil trace))
          ((not (consp table)) (list '(:refused :checkpoint-header) nil nil trace))
          (t (let* ((entry (fn-lc-head table))
                    (header (pgs-lookup (fn-lc-head entry) pages))
                    (hb (ec-call (pgs-check-pages (list entry) txid :eager pages 0 :page-damaged)))
                    (trace (fn-lc-join trace (list (fn-lc-head entry)))))
               (if hb (list (cons :refused hb) table nil trace)
                (fn-lc-cold-candidate-control rec table header pages trace)))))))))
(defun fn-lc-cold-candidate (rec pages)
 (declare (xargs :guard t :verify-guards nil))
 (if (not (pgs-rec-valid rec)) (list '(:refused :commit-torn) nil nil nil)
  (let* ((address (pgs-rec-dir-addr rec))
         (directory (pgs-lookup address pages))
         (bad (pgs-dir-verdict rec directory (pgs-digest directory))))
   (if bad (list (cons :refused bad) nil nil (list address))
     (fn-lc-cold-candidate-table rec pages directory (list address))))))
(verify-guards fn-lc-cold-candidate-control)
(verify-guards fn-lc-cold-candidate-table)
(verify-guards fn-lc-cold-candidate)

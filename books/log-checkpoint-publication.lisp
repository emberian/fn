; LC publication model: actual PGS page writes, then data fence, one root
; write, then root fence. A failed request ends this step without rollback.
(in-package "ACL2")
(include-book "log-checkpoint-header")
(include-book "catalog-columns-guards")
(include-book "pagestore-keystones")
(include-book "def-representation-tree")

; Generated encoding for map/escape/summary observations, never a row twin.
(local (in-theory (enable (:executable-counterpart adt-schemap)
                          (:executable-counterpart adt-ncols))))
(def-representation fn-lc-map-observation (value :tree) :pages t)
(defun fn-lc-columns-value (value)
  (declare (xargs :guard t :verify-guards nil))
  (append (fn-lbc-rowwords-pages-of (nth *fn-lbc-row-store* value))
          (fn-lbc-msgid-octets-pages-of (nth *fn-lbc-msgid-store* value))
          (fn-lbc-overview-octets-pages-of (nth *fn-lbc-overview-store* value))
          (fn-lbc-msgid-slots-pages-of (nth *fn-lbc-slot-store* value))
          (fn-lbc-directory-pages-of (nth *fn-lbc-directory-store* value))
          (fn-lbc-memberships-pages-of (nth *fn-lbc-membership-store* value))
          (fn-lbc-nov-pages-of (nth *fn-lbc-nov-store* value))
          (fn-lc-map-observation-pages-of
           (list (fn-lc-map-observation-tree-enc
                  (list (list (nth *fn-lbc-number-store* value)
                              (nth *fn-lbc-summary-groups* value)
                              (nth *fn-lbc-escape-store-get* value))))))))
; The only column snapshot observation is logical, not a served copy.
; All independent publication algebra keeps this changing observation opaque.
(defun-nx fn-lc-columns (fn-lbc) (fn-lc-columns-value fn-lbc))

(defun fn-lc-max-address (pages)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp pages) (max (nfix (mbe :logic (caar pages) :exec (fn-lc-head (fn-lc-head pages)))) (fn-lc-max-address (mbe :logic (cdr pages) :exec (fn-lc-rest pages)))) 0))
(defun fn-lc-publication-alloc (disk)
  (declare (xargs :guard t :verify-guards nil))
  (list nil (+ 1 (fn-lc-max-address (pgs-pages disk)))))
(defun fn-lc-publication-valuep (old old-header columns header disk r mode)
  (declare (xargs :guard t :verify-guards nil))
  (and (fn-lc-snapshotp old old-header) (fn-lc-snapshotp columns header)
       (equal (mbe :logic (car (pgs-open disk r mode)) :exec (fn-lc-head (pgs-open disk r mode))) :ok)
       (equal (mbe :logic (nth 3 (pgs-open disk r mode)) :exec (fn-lc-at 3 (pgs-open disk r mode))) (fn-lc-pages old old-header))
       ; Publication retains the physical extent; shrinking controls clear
       ; pages inside that extent. A new concrete layout carries its extent.
       (<= (len (fn-lc-pages old old-header)) (len (fn-lc-pages columns header)))
       (mbe :logic (pgs-alloc-inv (fn-lc-publication-alloc disk) disk) :exec (ec-call (pgs-alloc-inv (fn-lc-publication-alloc disk) disk)))))
(defun fn-lc-publicationp (old old-header header disk r mode segs fn-lbc)
  (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil)
           (ignore segs))
  (fn-lc-publication-valuep old old-header (fn-lc-columns fn-lbc) header disk r mode))
(defun fn-lc-durable-image (disk r mode)
  (declare (xargs :guard t :verify-guards nil))
  (if (equal (mbe :logic (car (pgs-open disk r mode)) :exec (fn-lc-head (pgs-open disk r mode))) :ok) (mbe :logic (nth 3 (pgs-open disk r mode)) :exec (fn-lc-at 3 (pgs-open disk r mode))) :bad))
(defun fn-lc-page-write-program (writes)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp writes)
      (cons (list :pwrite :data (mbe :logic (caar writes) :exec (fn-lc-head (fn-lc-head writes))) (mbe :logic (cdar writes) :exec (fn-lc-rest (fn-lc-head writes)))
                  (* (if (consp (mbe :logic (cdr writes) :exec (fn-lc-rest writes))) 1
                       (pgs-ptab-run-pages (len (mbe :logic (cdar writes) :exec (fn-lc-rest (fn-lc-head writes)))))) (fn-lc-page-octets)))
            (fn-lc-page-write-program (mbe :logic (cdr writes) :exec (fn-lc-rest writes)))) nil))
(defun fn-lc-publication-program (plan)
  (declare (xargs :guard t :verify-guards nil))
  (mbe :logic (append (fn-lc-page-write-program (nth 1 plan))
          (list '(:data-fsync)
                (list :root-write (nth 2 plan) (nth 3 plan) (fn-lc-root-slot-octets))
                '(:root-fsync))) :exec (fn-lc-join (fn-lc-page-write-program (fn-lc-at 1 plan)) (list '(:data-fsync) (list :root-write (fn-lc-at 2 plan) (fn-lc-at 3 plan) (fn-lc-root-slot-octets)) '(:root-fsync)))))
(defun fn-lc-outcome-ok-count (outcome n)
  (declare (xargs :guard t :measure (nfix n) :verify-guards nil))
  (if (mbe :logic (zp n) :exec (not (posp n))) 0
    (if (equal (mbe :logic (car (true-list-fix outcome)) :exec (fn-lc-head (true-list-fix outcome))) :ok)
        (+ 1 (fn-lc-outcome-ok-count (mbe :logic (cdr (true-list-fix outcome)) :exec (fn-lc-rest (true-list-fix outcome))) (1- n))) 0)))
(defun fn-lc-write-octets (trace)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp trace)
      (+ (cond ((equal (mbe :logic (caar trace) :exec (fn-lc-head (fn-lc-head trace))) :pwrite) (nfix (mbe :logic (nth 4 (car trace)) :exec (fn-lc-at 4 (fn-lc-head trace)))))
               ((equal (mbe :logic (caar trace) :exec (fn-lc-head (fn-lc-head trace))) :root-write) (nfix (mbe :logic (nth 3 (car trace)) :exec (fn-lc-at 3 (fn-lc-head trace))))) (t 0))
         (fn-lc-write-octets (mbe :logic (cdr trace) :exec (fn-lc-rest trace)))) 0))
(defun fn-lc-fence-sequence (trace)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp trace)
      (if (member-equal (mbe :logic (caar trace) :exec (fn-lc-head (fn-lc-head trace))) '(:data-fsync :root-write :root-fsync))
          (cons (mbe :logic (caar trace) :exec (fn-lc-head (fn-lc-head trace))) (fn-lc-fence-sequence (mbe :logic (cdr trace) :exec (fn-lc-rest trace))))
        (fn-lc-fence-sequence (mbe :logic (cdr trace) :exec (fn-lc-rest trace)))) nil))
(defun fn-lc-list-prefixp (prefix xs)
  (declare (xargs :guard (true-listp prefix) :verify-guards nil))
  (if (consp prefix) (and (consp xs) (equal (mbe :logic (car prefix) :exec (fn-lc-head prefix)) (mbe :logic (car xs) :exec (fn-lc-head xs)))
                         (fn-lc-list-prefixp (mbe :logic (cdr prefix) :exec (fn-lc-rest prefix)) (mbe :logic (cdr xs) :exec (fn-lc-rest xs)))) t))
(defun fn-lc-root-write-after-data-fsync-aux (trace fenced)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp trace)
      (and (or (not (equal (mbe :logic (caar trace) :exec (fn-lc-head (fn-lc-head trace))) :root-write)) fenced)
           (fn-lc-root-write-after-data-fsync-aux
            (mbe :logic (cdr trace) :exec (fn-lc-rest trace)) (or fenced (equal (mbe :logic (caar trace) :exec (fn-lc-head (fn-lc-head trace))) :data-fsync)))) t))
(defun fn-lc-root-write-after-data-fsyncp (trace)
  (declare (xargs :guard t :verify-guards nil))
  (fn-lc-root-write-after-data-fsync-aux trace nil))
(defun fn-lc-stage-value (old old-header columns header disk r mode outcome)
  (declare (xargs :guard t :verify-guards nil))
  (if (not (fn-lc-publication-valuep old old-header columns header disk r mode))
      (list :refused disk nil)
    (let* ((dirty (fn-lc-dirty old old-header columns header))
           (alloc (fn-lc-publication-alloc disk))
           (plan (mbe :logic (pgs-plan-commit disk r mode dirty alloc) :exec (ec-call (pgs-plan-commit disk r mode dirty alloc)))))
      (if (not (equal (mbe :logic (car plan) :exec (fn-lc-head plan)) :plan)) (list :refused disk nil)
        (let* ((program (fn-lc-publication-program plan))
               (nw (len (mbe :logic (nth 1 plan) :exec (fn-lc-at 1 plan))))
               (cut (fn-lc-outcome-ok-count outcome (len program)))
               (trace (mbe :logic (take (min (+ 1 cut) (len program)) program) :exec (fn-lc-take (min (+ 1 cut) (len program)) program)))
               (root-result (mbe :logic (nth (+ nw 1) (true-list-fix outcome)) :exec (fn-lc-at (+ nw 1) (true-list-fix outcome))))
               (disk2
                (cond ((<= (+ nw 2) cut)
                       (pgs-crash disk r (mbe :logic (nth 1 plan) :exec (fn-lc-at 1 plan)) nil (mbe :logic (nth 2 plan) :exec (fn-lc-at 2 plan)) (mbe :logic (nth 3 plan) :exec (fn-lc-at 3 plan))))
                      ((equal cut (+ nw 1))
                       (pgs-crash disk r (mbe :logic (nth 1 plan) :exec (fn-lc-at 1 plan)) nil (mbe :logic (nth 2 plan) :exec (fn-lc-at 2 plan))
                                  (if (equal root-result :ok) (mbe :logic (nth 3 plan) :exec (fn-lc-at 3 plan)) :torn)))
                      ((< cut nw)
                       (cons (pgs-apply-pages
                              (mbe :logic (append (take cut (nth 1 plan))
                                      (list (cons (car (nth cut (nth 1 plan))) :torn))) :exec (fn-lc-join (fn-lc-take cut (fn-lc-at 1 plan)) (list (cons (fn-lc-head (fn-lc-at cut (fn-lc-at 1 plan))) :torn))))
                              nil (pgs-pages disk)) (pgs-roots disk)))
                      (t (cons (pgs-apply-pages (mbe :logic (nth 1 plan) :exec (fn-lc-at 1 plan)) nil (pgs-pages disk))
                               (pgs-roots disk))))))
          (list (if (equal cut (len program)) :ok :uncertain) disk2 trace))))))
(defun fn-lc-stage (old old-header header disk r mode segs outcome fn-lbc)
  (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
  (let ((out (fn-lc-stage-value old old-header (fn-lc-columns fn-lbc) header disk r mode outcome)))
    (mv (mbe :logic (car out) :exec (fn-lc-head out)) fn-lbc (mbe :logic (nth 1 out) :exec (fn-lc-at 1 out)) segs (mbe :logic (nth 2 out) :exec (fn-lc-at 2 out)))))

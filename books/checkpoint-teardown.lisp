; Runtime-only displaced candidate teardown. Cold occupants and ancestry must
; be reconstructed before catalog reuse; these leaves grant no reuse authority.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-master-state")
(include-book "checkpoint-lifecycle")
(include-book "checkpoint-publication")
(fn2-book-layer :c)

(defun fn2-checkpoint-teardown-debt-word (i fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication
  :guard (and (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
              (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication)) (natp i) (< i 8))))
 (case i
  (0 (fn2-checkpoint-publication-debt-hash-0 0 fn2-checkpoint-publication))
  (1 (fn2-checkpoint-publication-debt-hash-1 0 fn2-checkpoint-publication))
  (2 (fn2-checkpoint-publication-debt-hash-2 0 fn2-checkpoint-publication))
  (3 (fn2-checkpoint-publication-debt-hash-3 0 fn2-checkpoint-publication))
  (4 (fn2-checkpoint-publication-debt-hash-4 0 fn2-checkpoint-publication))
  (5 (fn2-checkpoint-publication-debt-hash-5 0 fn2-checkpoint-publication))
  (6 (fn2-checkpoint-publication-debt-hash-6 0 fn2-checkpoint-publication))
  (otherwise (fn2-checkpoint-publication-debt-hash-7 0 fn2-checkpoint-publication))))
(defun fn2-checkpoint-teardown-hash-p (debtp i c fn2-checkpoint-publication fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-checkpoint-publication fn2-checkpoint-bytes) :measure (nfix (- 8 (nfix i)))
  :guard (and (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
              (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes)
              (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication))
              (natp c) (<= (+ (* 192 c) 32) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes))
              (booleanp debtp) (natp i) (<= i 8))))
 (if (or (not (natp i)) (>= i 8)) t
  (and (equal (if debtp (fn2-checkpoint-teardown-debt-word i fn2-checkpoint-publication)
                     (fn2-checkpoint-publication-base-word i fn2-checkpoint-publication))
              (fn2-checkpoint-descriptor-identity-word c i fn2-checkpoint-bytes))
       (fn2-checkpoint-teardown-hash-p debtp (+ 1 i) c fn2-checkpoint-publication fn2-checkpoint-bytes))))

; Conservative alias exclusion: a matching row OR checkpoint namespace in
; either bank retains the candidate even if malformed hashes disagree.
(defun fn2-checkpoint-teardown-bank-excludedp (c fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication
  :guard (and (fn2-checkpoint-publication-wfp fn2-checkpoint-publication)
              (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication)))))
 (and
  (or (equal (fn2-checkpoint-publication-bank0-valid 0 fn2-checkpoint-publication) 0)
      (and (not (equal c (fn2-checkpoint-publication-bank0-candidate 0 fn2-checkpoint-publication)))
           (not (and (equal (fn2-checkpoint-publication-debt-checkpoint 0 fn2-checkpoint-publication) (fn2-checkpoint-publication-bank0-checkpoint 0 fn2-checkpoint-publication))
                     (equal (fn2-checkpoint-publication-debt-history 0 fn2-checkpoint-publication) (fn2-checkpoint-publication-bank0-history 0 fn2-checkpoint-publication))
                     (equal (fn2-checkpoint-publication-debt-incarnation 0 fn2-checkpoint-publication) (fn2-checkpoint-publication-bank0-incarnation 0 fn2-checkpoint-publication))))))
  (or (equal (fn2-checkpoint-publication-bank1-valid 0 fn2-checkpoint-publication) 0)
      (and (not (equal c (fn2-checkpoint-publication-bank1-candidate 0 fn2-checkpoint-publication)))
           (not (and (equal (fn2-checkpoint-publication-debt-checkpoint 0 fn2-checkpoint-publication) (fn2-checkpoint-publication-bank1-checkpoint 0 fn2-checkpoint-publication))
                     (equal (fn2-checkpoint-publication-debt-history 0 fn2-checkpoint-publication) (fn2-checkpoint-publication-bank1-history 0 fn2-checkpoint-publication))
                     (equal (fn2-checkpoint-publication-debt-incarnation 0 fn2-checkpoint-publication) (fn2-checkpoint-publication-bank1-incarnation 0 fn2-checkpoint-publication))))))))

(defun fn2-checkpoint-teardown-ownerp (token kind slot gen fn2-checkpoint-lifecycle fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-lifecycle fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents)
  :guard (and (fn2-checkpoint-lifecycle-wfp fn2-checkpoint-lifecycle) (fn2-csnapshot-wfp fn2-csnapshot)
              (fn2-checkpoint-publication-wfp fn2-checkpoint-publication) (fn2-checkpoints-wfp fn2-checkpoints)
              (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (fn2-extents-wfp fn2-extents))))
 (and (< 0 (fn2-checkpoint-lifecycle-rows fn2-checkpoint-lifecycle))
      (< 0 (fn2-csnapshot-rows fn2-csnapshot)) (< 0 (fn2-checkpoint-publication-rows fn2-checkpoint-publication))
      (fn2-checkpoint-lifecycle-ownerp (fn2-checkpoint-publication-candidate 0 fn2-checkpoint-publication) token kind slot gen fn2-checkpoint-lifecycle)
      (equal (fn2-checkpoint-lifecycle-phase 0 fn2-checkpoint-lifecycle) *fn2-checkpoint-lifecycle-phase-complete*)
      (equal (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-idle*)
      (equal (fn2-csnapshot-token 0 fn2-csnapshot) token)
      (equal (fn2-csnapshot-owner-kind 0 fn2-csnapshot) kind)
      (equal (fn2-csnapshot-owner-slot 0 fn2-csnapshot) slot)
      (equal (fn2-csnapshot-owner-gen 0 fn2-csnapshot) gen)
      (equal (fn2-alloc-freeze-phase fn2-extents) 0) (equal (fn2-alloc-freeze-token fn2-extents) 0)
      (equal (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication) *fn2-checkpoint-publication-phase-complete*)
      (equal (fn2-checkpoint-publication-bundle-released 0 fn2-checkpoint-publication) 1)
      (equal (fn2-checkpoint-publication-debt-valid 0 fn2-checkpoint-publication) 1)
      (let ((current (fn2-checkpoint-publication-candidate 0 fn2-checkpoint-publication)))
       (and (fn2-checkpoint-slotp current fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
            (fn2-checkpoint-builder-claimp current token kind slot gen fn2-checkpoints)
            (equal (fn2-checkpoints-state current fn2-checkpoints) *fn2-checkpoint-state-installed*)
            (posp (fn2-checkpoints-installation-commit current fn2-checkpoints))
            (equal (fn2-checkpoints-checkpoint current fn2-checkpoints) (fn2-checkpoint-publication-base-checkpoint 0 fn2-checkpoint-publication))
            (equal (fn2-checkpoints-history current fn2-checkpoints) (fn2-checkpoint-publication-base-history 0 fn2-checkpoint-publication))
            (equal (fn2-checkpoints-incarnation current fn2-checkpoints) (fn2-checkpoint-publication-base-incarnation 0 fn2-checkpoint-publication))
            (fn2-checkpoint-teardown-hash-p nil 0 current fn2-checkpoint-publication fn2-checkpoint-bytes)))
      (let ((c (fn2-checkpoint-publication-debt-candidate 0 fn2-checkpoint-publication)))
       (and (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
            (posp (fn2-checkpoints-builder-token c fn2-checkpoints))
            (equal (fn2-checkpoints-state c fn2-checkpoints) *fn2-checkpoint-state-installed*)
            (posp (fn2-checkpoints-installation-commit c fn2-checkpoints))
            (equal (fn2-checkpoints-checkpoint c fn2-checkpoints) (fn2-checkpoint-publication-debt-checkpoint 0 fn2-checkpoint-publication))
            (equal (fn2-checkpoints-history c fn2-checkpoints) (fn2-checkpoint-publication-debt-history 0 fn2-checkpoint-publication))
            (equal (fn2-checkpoints-incarnation c fn2-checkpoints) (fn2-checkpoint-publication-debt-incarnation 0 fn2-checkpoint-publication))
            (fn2-checkpoint-teardown-hash-p t 0 c fn2-checkpoint-publication fn2-checkpoint-bytes)
            (fn2-checkpoint-teardown-bank-excludedp c fn2-checkpoint-publication)))))

; Count only actual exact victim-owned dedicated root edges, not ref flags.
(defun fn2-checkpoint-teardown-root-count (role c e epoch counter checkpoint fn2-extents fn2-ops fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-extents fn2-ops fn2-alloc-edges) :measure (nfix (- 6 (nfix role)))
  :guard (and (fn2-extents-wfp fn2-extents) (fn2-ops-wfp fn2-ops) (fn2-alloc-edges-wfp fn2-alloc-edges)
              (natp role) (<= role 6) (natp c))))
 (if (or (not (natp role)) (>= role 6)) 0
  (let ((edge (fn2-checkpoint-edge c role fn2-extents fn2-ops)))
   (+ (if (and (fn2-alloc-edge-slotp edge fn2-alloc-edges)
               (fn2-alloc-edge-matchesp edge checkpoint e epoch counter :selectable-checkpoint fn2-alloc-edges)) 1 0)
      (fn2-checkpoint-teardown-root-count (+ 1 role) c e epoch counter checkpoint fn2-extents fn2-ops fn2-alloc-edges)))))

(defun fn2-checkpoint-teardown-ownedp (c e fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges)
  :guard (and (fn2-checkpoints-wfp fn2-checkpoints) (fn2-checkpoint-construction-wfp fn2-checkpoint-construction)
              (fn2-extents-wfp fn2-extents) (fn2-ops-wfp fn2-ops) (fn2-alloc-edges-wfp fn2-alloc-edges))))
 (and (natp c) (< c (fn2-checkpoints-rows fn2-checkpoints)) (fn2-alloc-slotp e fn2-extents)
      (< e (fn2-checkpoint-construction-rows fn2-checkpoint-construction))
      (equal (fn2-checkpoint-construction-live e fn2-checkpoint-construction) 1)
      (< (fn2-checkpoint-construction-role e fn2-checkpoint-construction) 6)
      (posp (fn2-checkpoints-builder-token c fn2-checkpoints))
      (equal (fn2-checkpoint-construction-token e fn2-checkpoint-construction) (fn2-checkpoints-builder-token c fn2-checkpoints))
      (equal (fn2-checkpoint-construction-owner-kind e fn2-checkpoint-construction) (fn2-checkpoints-builder-owner-kind c fn2-checkpoints))
      (equal (fn2-checkpoint-construction-owner-slot e fn2-checkpoint-construction) (fn2-checkpoints-builder-owner-slot c fn2-checkpoints))
      (equal (fn2-checkpoint-construction-owner-gen e fn2-checkpoint-construction) (fn2-checkpoints-builder-owner-gen c fn2-checkpoints))
      (equal (fn2-extents-owner-kind e fn2-extents) (fn2-checkpoints-builder-owner-kind c fn2-checkpoints))
      (equal (fn2-extents-owner-id e fn2-extents) (fn2-checkpoints-builder-token c fn2-checkpoints))
      (equal (fn2-extents-epoch e fn2-extents) (fn2-checkpoint-construction-epoch e fn2-checkpoint-construction))
      (equal (fn2-extents-counter e fn2-extents) (fn2-checkpoint-construction-counter e fn2-checkpoint-construction))))


; One item per turn. PREVIOUS is the proposal in the request or the prior
; item's sender-view position. ADVANCE is computed inside the codec. Both
; bodies are consumed by their own C layout; their origin IDs stay intact.
(defun fn2-xfnc-get-batch-item (base start result-end remaining previous batch-next
                                slot gen okind oslot ogen fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool)
                  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
  (b* (((unless (and (natp base) (unsigned-byte-p 32 remaining) (posp remaining)
                     (unsigned-byte-p 60 previous) (unsigned-byte-p 60 batch-next)
                     (unsigned-byte-p 32 start) (unsigned-byte-p 32 result-end)
                     (<= (+ base (max *fn2-xfnc-batch-pair-num-fields*
                                      (+ *fn2-identity-history-entry-num-fields*
                                         *fn2-identity-evidence-entry-num-fields*)))
                         (fn2-fields-rows fn2-fields))))
        (mv :bounds 0 0 0 0 0 0 0 fn2-fields))
       ((mv code hs fn2-fields)
        (fn2-xfnc-batch-pair-decode base slot gen start result-end okind oslot ogen fn2-fields fn2-pool))
       (position (fn2-fields-value (+ base *fn2-xfnc-batch-pair-field-position*) fn2-fields))
       (hlen (fn2-fields-value (+ base *fn2-xfnc-batch-pair-field-history-size*) fn2-fields))
       (elen (fn2-fields-value (+ base *fn2-xfnc-batch-pair-field-evidence-size*) fn2-fields))
       ((unless (and (eq code :ok) (unsigned-byte-p 32 hs)
                     (equal hs (+ start *fn2-xfnc-batch-pair-max-size*))
                     (unsigned-byte-p 60 position) (< previous position) (<= position batch-next)
                     (posp hlen) (<= hlen *fn2-identity-history-entry-max-size*)
                     (posp elen) (<= elen *fn2-identity-evidence-entry-max-size*)))
        (mv :frame 0 0 0 0 0 0 0 fn2-fields))
       (he (+ hs hlen))
       (ee (+ he elen))
       (left (- remaining 1))
       ((unless (and (<= ee result-end) (<= left (- batch-next position))
                     (if (zp left) (and (= ee result-end) (= position batch-next))
                       (<= (* left (+ 2 *fn2-xfnc-batch-pair-max-size*)) (- result-end ee)))))
        (mv :frame 0 0 0 0 0 0 0 fn2-fields))
       (h base)
       (e (+ h *fn2-identity-history-entry-num-fields*))
       ((mv hc hn fn2-fields)
        (fn2-identity-history-entry-decode h slot gen hs he okind oslot ogen fn2-fields fn2-pool))
       ((unless (and (eq hc :ok) (equal hn he)))
        (mv :history-format 0 0 0 0 0 0 0 fn2-fields))
       ((mv ec en fn2-fields)
        (fn2-identity-evidence-entry-decode e slot gen he ee okind oslot ogen fn2-fields fn2-pool))
       ((unless (and (eq ec :ok) (equal en ee)))
        (mv :evidence-format 0 0 0 0 0 0 0 fn2-fields))
       ((unless (fn2-peer-view-pair-identity-p h e slot gen okind oslot ogen fn2-fields fn2-pool))
        (mv :identity 0 0 0 0 0 0 0 fn2-fields)))
    (mv :ok ee left position hs he he ee fn2-fields)))

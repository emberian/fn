   (revision :u64be) (chain :digest) (view :u64be) (view-version :u64be)
   (interpretation :u16be) (next :u64be) (end :u64be)
   (stop (:enum fn2-xfnc-stop (:end :items :octets :work)))
   (count :u32be) (cursor (:octets16 366))))
(deflayout fn2-xfnc-batch-pair
 '((position :u64be) (history-size :u16be) (evidence-size :u16be)))

(defconst *fn2-xfnc-batch-item-max*
  (+ *fn2-xfnc-batch-pair-max-size*
     *fn2-identity-history-entry-max-size* *fn2-identity-evidence-entry-max-size*))
(assert-event
 (and (unsigned-byte-p 16 *fn2-identity-history-entry-max-size*)
      (unsigned-byte-p 16 *fn2-identity-evidence-entry-max-size*)
      (<= (* 2 *fn2-xfnc-batch-item-max*) *fn2-pool-block-bytes*)))

(defun fn2-xfnc-batch-pair-size (hs he es ee)
  (declare (xargs :guard t))
  (if (and (unsigned-byte-p 32 hs) (unsigned-byte-p 32 he) (< hs he)
           (unsigned-byte-p 32 es) (unsigned-byte-p 32 ee) (< es ee)
           (or (<= he es) (<= ee hs))
           (<= (- he hs) *fn2-identity-history-entry-max-size*)
           (<= (- ee es) *fn2-identity-evidence-entry-max-size*))
      (+ *fn2-xfnc-batch-pair-max-size* (- he hs) (- ee es))
    0))

; The producer supplies the exact typed body spans from the checked reader.
; Preflight the whole write, leaving the member current on capacity pressure.

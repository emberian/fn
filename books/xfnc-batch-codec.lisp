                     (<= (+ base *fn2-xfnc-batch-header-num-fields*) (fn2-fields-rows fn2-fields))
                     (<= (+ cursor-base 128) (fn2-fields-rows fn2-fields))
                     (or (<= (+ base *fn2-xfnc-batch-header-num-fields*) cursor-base)
                         (<= (+ cursor-base 128) base))
                     (unsigned-byte-p 60 after)))
        (mv :bounds 0 fn2-fields))
       ((mv code off fn2-fields)
        (fn2-xfnc-batch-header-decode base slot gen start result-end okind oslot ogen fn2-fields fn2-pool))
       ((unless (and (eq code :ok) (unsigned-byte-p 32 off)
                     (unsigned-byte-p 32 result-end) (<= off result-end)))
        (mv :frame 0 fn2-fields))
       ((unless (and (equal *fn2-xfnc-batch-version*
                           (fn2-fields-value (+ base *fn2-xfnc-batch-header-field-version*) fn2-fields))
                     (equal *fn2-xfnc-batch-interpretation*
                           (fn2-fields-value (+ base *fn2-xfnc-batch-header-field-interpretation*) fn2-fields))))
        (mv :version 0 fn2-fields))
       ((unless (and (equal history (fn2-fields-value (+ base *fn2-xfnc-batch-header-field-history-domain*) fn2-fields))
                     (equal incarnation (fn2-fields-value (+ base *fn2-xfnc-batch-header-field-incarnation*) fn2-fields))
                     (equal view (fn2-fields-value (+ base *fn2-xfnc-batch-header-field-view*) fn2-fields))
                     (equal view-version (fn2-fields-value (+ base *fn2-xfnc-batch-header-field-view-version*) fn2-fields))))
        (mv :scope 0 fn2-fields))
       (revision (fn2-fields-value (+ base *fn2-xfnc-batch-header-field-revision*) fn2-fields))
       (next (fn2-fields-value (+ base *fn2-xfnc-batch-header-field-next*) fn2-fields))
       (end (fn2-fields-value (+ base *fn2-xfnc-batch-header-field-end*) fn2-fields))
       (stop (fn2-fields-value (+ base *fn2-xfnc-batch-header-field-stop*) fn2-fields))
       (count (fn2-fields-value (+ base *fn2-xfnc-batch-header-field-count*) fn2-fields))
       ((unless (and (fn2-xfnc-batch-frontier-p revision view view-version next end stop count)
                     (unsigned-byte-p 60 next) (unsigned-byte-p 32 count)

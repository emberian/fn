       (ce (+ cs (nfix (fn2-fields-ref-len ci fn2-fields))))
       ((mv code query cid ep qv vv position fn2-fields)
        (fn2-xfnc-decode-cursor cursor-base cs ce principal history incarnation
                               slot gen okind oslot ogen fn2-fields fn2-pool))
       ((unless (and (eq code :ok) (equal query view) (equal cid consumer) (equal ep epoch)
                     (equal qv query-version) (equal vv view-version) (equal position next)))
        (mv :scope 0 fn2-fields)))

                  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
  (b* ((size (fn2-xfnc-batch-pair-size hs he es ee))
       ((unless (and (posp size) (posp position) (unsigned-byte-p 60 position) (natp base)
                     (<= (+ base *fn2-xfnc-batch-pair-num-fields*) (fn2-fields-rows fn2-fields))
                     (natp at) (equal at (fn2-pool-fill-value tx fn2-pool))
                     (not (equal source tx))))
        (mv :bounds 0 fn2-fields fn2-pool))
       ((unless (and (eq :ok (fn2-layout-range-code source source-gen hs he nil okind oslot ogen fn2-pool))
                     (eq :ok (fn2-layout-range-code source source-gen es ee nil okind oslot ogen fn2-pool))))
        (mv :source 0 fn2-fields fn2-pool))
       (target-end (+ at size))
       (code (fn2-layout-range-code tx tx-gen at target-end t okind oslot ogen fn2-pool))
       ((unless (eq code :ok))
        (mv (if (eq code :bounds) :full code) 0 fn2-fields fn2-pool))
       (hlen (nfix (- (nfix he) (nfix hs)))) (elen (nfix (- (nfix ee) (nfix es))))
       ((unless (and (unsigned-byte-p 16 hlen) (unsigned-byte-p 16 elen)))
        (mv :bounds 0 fn2-fields fn2-pool))
       (fn2-fields (fn2-fields-set-value (+ base *fn2-xfnc-batch-pair-field-position*) position fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ base *fn2-xfnc-batch-pair-field-history-size*) hlen fn2-fields))
       (fn2-fields (fn2-fields-set-value (+ base *fn2-xfnc-batch-pair-field-evidence-size*) elen fn2-fields))
       ((mv code next fn2-pool)
        (fn2-xfnc-batch-pair-encode base tx tx-gen at okind oslot ogen fn2-fields fn2-pool))
       ((unless (and (eq code :ok) (equal next (+ at *fn2-xfnc-batch-pair-max-size*))))
        (mv :state 0 fn2-fields fn2-pool))
       ((mv code fn2-pool)
        (fn2-pool-copy-range source source-gen hs tx tx-gen next hlen okind oslot ogen fn2-pool))
       ((unless (eq code :ok)) (mv :state 0 fn2-fields fn2-pool))
       ((mv code fn2-pool)
        (fn2-pool-copy-range source source-gen es tx tx-gen (+ next hlen) elen okind oslot ogen fn2-pool)))
    (mv (if (eq code :ok) :ok :state) (if (eq code :ok) target-end 0) fn2-fields fn2-pool)))

; This plan first gathers item bytes, stages the chain/cursor and result,
; then assembles the counted FNCT in the same range.
(defun fn2-xfnc-batch-items-fit-p (items capacity)
  (declare (xargs :guard t))
  (let ((result (+ *fn2-xfnc-batch-header-max-size* (nfix items)))
        (scratch (+ (nfix items) 32 366)))
    (and (natp items) (natp capacity)
         (<= (+ *fn2-fnct-header-octets* 7 result) *fn2-pool-block-bytes*)
         (<= (+ scratch result 7 result *fn2-fnct-overhead* 16) capacity))))


; One retained terminal owner. All scans use actual claims/captured evidence;
; no generic DONE, publication or absence-of-reader flag is accepted.
; UNQUALIFIED / unreachable-in-composition while checkpoint activation is nil:
; cold and prebase source withdrawal still owes the real authenticated prefix
; unfinished-RELEASE inventory join. Receipt/ACK is not that authority.
(in-package "ACL2")
(include-book "checkpoint-dispose-source")
(include-book "columns-row-reset")
(include-book "checkpoint-child-contracts")
(fn2-book-layer :c)
(make-event (fn2-columns-row-reset-event 'fn2-checkpoints (w state)))
(make-event (fn2-columns-row-reset-event 'fn2-checkpoint-refs (w state)))
(make-event (fn2-columns-row-reset-event 'fn2-checkpoint-teardown-debt (w state)))
(defconst *fn2-checkpoint-dispose-children*
 '(fn2-checkpoint-teardown-debt fn2-checkpoint-bytes fn2-checkpoint-publication fn2-checkpoint-payload-proofs fn2-csnapshot fn2-extents fn2-ops fn2-alloc-edges fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control fn2-event-archive fn2-release-evidence-candidates fn2-checkpoint-construction fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-checkpoint-refs))
(defconst *fn2-checkpoint-dispose-outputs*
 '(fn2-checkpoint-teardown-debt fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-extents fn2-alloc-edges))


(defmacro fn2-checkpoint-dispose-mv (code)
 `(mv ,code ,@*fn2-checkpoint-dispose-outputs*))
(defmacro fn2-checkpoint-dispose-operation (name phase args &rest body)
 (let* ((children *fn2-checkpoint-dispose-children*) (outputs *fn2-checkpoint-dispose-outputs*)
        (typed (fn2-checkpoint-root1-child-hyps children))
        (constant (intern-in-package-of-symbol
          (concatenate 'string "*FN2-CHECKPOINT-DISPOSE-PHASE-" (symbol-name phase) "*") 'fn2-core))
        (domain (if (eq phase :any) typed
          (append typed
           `((fn2-checkpoint-dispose-current-p c token kind slot gen generation fn2-checkpoint-teardown-debt fn2-checkpoints fn2-checkpoint-bytes)
             (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
             (equal (fn2-checkpoint-teardown-debt-dispose-phase c fn2-checkpoint-teardown-debt) ,constant))))))
  (if (or (not (member-eq phase '(:any :sources :cold :roots :refs :bytes :finish)))
          (and (eq phase :any) (not (eq name 'fn2-checkpoint-dispose-step))))
      (er hard 'fn2-checkpoint-dispose-operation "Invalid private terminal phase for ~x0." name)
   `(progn
     (defun ,name (,@args ,@children)
      (declare (xargs :stobjs ,children :verify-guards nil :guard (and ,@domain)))
      ,@body)
     (fn2-checkpoint-teardown-debt-preserves ,name (,@args ,@children)
      :hyps ,domain :specs ,(fn2-checkpoint-root1-child-specs outputs 1))))))

; Private helpers are called only after STEP rechecks exact owner/generation,
; current phase and every real holder. They never accept a readiness flag.
(fn2-checkpoint-dispose-operation fn2-checkpoint-dispose-cold-step :cold
 (c token kind slot gen generation commit-kind)
 (b* ((at (fn2-checkpoint-teardown-debt-dispose-cursor c fn2-checkpoint-teardown-debt))
      (n (fn2-extents-rows fn2-extents)) (total (* *fn2-checkpoint-anchor-slots* n))
      ((unless (and (unsigned-byte-p 32 total) (<= at total))) (fn2-checkpoint-dispose-mv :state))
      ((when (= at total))
       (let ((fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-put c (dispose-phase *fn2-checkpoint-dispose-phase-roots*) (dispose-cursor 0))))
        (fn2-checkpoint-dispose-mv :more)))
      (physical (floor at n)) (e (mod at n))
      (ours (and (fn2-checkpoint-bank-obligation-memberp physical (fn2-checkpoint-publication-cold-bound-mask 0 fn2-checkpoint-publication))
                 (= c (fn2-checkpoint-publication-cold-catalogi physical fn2-checkpoint-publication))
                 (= (fn2-checkpoint-teardown-debt-checkpoint c fn2-checkpoint-teardown-debt)
                    (fn2-checkpoint-publication-cold-metai (+ (* 12 physical) 2) fn2-checkpoint-publication))
                 (= (fn2-checkpoint-teardown-debt-history c fn2-checkpoint-teardown-debt)
                    (fn2-checkpoint-publication-cold-metai (+ (* 12 physical) 3) fn2-checkpoint-publication))
                 (= (fn2-checkpoint-teardown-debt-incarnation c fn2-checkpoint-teardown-debt)
                    (fn2-checkpoint-publication-cold-metai (+ (* 12 physical) 4) fn2-checkpoint-publication))))
      (copied (fn2-checkpoint-bank-obligation-memberp physical (fn2-checkpoint-teardown-debt-anchor-mask c fn2-checkpoint-teardown-debt)))
      ((when (not ours))
       (if copied (fn2-checkpoint-dispose-mv :identity)
        (let ((fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-set-dispose-cursor c (+ at 1) fn2-checkpoint-teardown-debt)))
         (fn2-checkpoint-dispose-mv :more))))
      ((unless (and copied
                     (fn2-checkpoint-dispose-cold-receipt-p fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-extents fn2-ops fn2-checkpoints fn2-alloc-edges)
                     (= (fn2-checkpoint-bank-obligation-state (+ 2 physical) fn2-checkpoint-publication) 3)
                     (fn2-checkpoint-dispose-cold-subject-p physical c fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
                     (fn2-checkpoint-bank-closure-row-p physical e fn2-checkpoint-bank-closures fn2-checkpoint-publication)))
       (fn2-checkpoint-dispose-mv :retained))
      (edge (fn2-checkpoint-bank-closure-edge physical e fn2-extents fn2-ops fn2-checkpoints))
      ((unless (fn2-alloc-edge-slotp edge fn2-alloc-edges)) (fn2-checkpoint-dispose-mv :edge))
      ((when (= (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-free*))
       (let ((fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-set-dispose-cursor c (+ at 1) fn2-checkpoint-teardown-debt)))
        (fn2-checkpoint-dispose-mv :more)))
      (row (+ (* physical n) e))
      ((unless (= (fn2-checkpoint-bank-closures-present row fn2-checkpoint-bank-closures) 1)) (fn2-checkpoint-dispose-mv :identity))
      (epoch (fn2-checkpoint-bank-closures-epoch row fn2-checkpoint-bank-closures))
      (allocation (fn2-checkpoint-bank-closures-allocation row fn2-checkpoint-bank-closures))
      (holder (fn2-checkpoint-teardown-debt-checkpoint c fn2-checkpoint-teardown-debt))
      ((unless (and (fn2-checkpoint-dispose-cold-row-p physical c e epoch allocation fn2-checkpoint-teardown-debt fn2-checkpoint-publication fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-extents fn2-ops fn2-checkpoints fn2-alloc-edges)
                     (< 0 (fn2-extents-recovery-base e fn2-extents))
                     (fn2-alloc-edge-matchesp edge holder e epoch allocation :recovery-base fn2-alloc-edges)))
       (fn2-checkpoint-dispose-mv :identity))
      ((unless (= (fn2-extents-obligation e fn2-extents) 0)) (fn2-checkpoint-dispose-mv :obligation))
      ((unless (or (fn2-checkpoint-owned-provenance-p kind e fn2-checkpoint-construction fn2-extents)
                   (fn2-checkpoint-dispose-journal-source-p commit-kind e fn2-extents fn2-alloc-edges)
                   (not (= (logand (fn2-checkpoint-bank-closures-role-bits row fn2-checkpoint-bank-closures) *fn2-checkpoint-payload-proof-roles*) 0))))
       (fn2-checkpoint-dispose-mv :classification))
      ((mv code fn2-extents fn2-alloc-edges) (fn2-alloc-edge-drop edge holder e epoch allocation :recovery-base fn2-extents fn2-alloc-edges))
      ((unless (eq code :ok)) (fn2-checkpoint-dispose-mv code))
      (fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-set-dispose-cursor c (+ at 1) fn2-checkpoint-teardown-debt)))
  (fn2-checkpoint-dispose-mv :more)))

(fn2-checkpoint-dispose-operation fn2-checkpoint-dispose-root-step :roots
 (c token kind slot gen generation commit-kind)
 (b* ((role (fn2-checkpoint-teardown-debt-dispose-cursor c fn2-checkpoint-teardown-debt))
      ((unless (<= role 6)) (fn2-checkpoint-dispose-mv :state))
      ((when (= role 6))
       (let ((fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-put c (dispose-phase *fn2-checkpoint-dispose-phase-refs*) (dispose-cursor 0))))
        (fn2-checkpoint-dispose-mv :more)))
      (r (+ (* 6 c) role)) (edge (fn2-checkpoint-edge c role fn2-extents fn2-ops))
      ((unless (fn2-alloc-edge-slotp edge fn2-alloc-edges)) (fn2-checkpoint-dispose-mv :edge))
      ((when (= (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-free*))
       (if (not (= (fn2-checkpoint-refs-retained r fn2-checkpoint-refs) 0)) (fn2-checkpoint-dispose-mv :identity)
        (let ((fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-set-dispose-cursor c (+ role 1) fn2-checkpoint-teardown-debt)))
         (fn2-checkpoint-dispose-mv :more))))
      (unit (fn2-checkpoint-refs-physical-unit r fn2-checkpoint-refs))
      (e (floor unit *fn2-storage-extent-units*))
      (epoch (fn2-checkpoint-refs-writer-epoch r fn2-checkpoint-refs))
      (allocation (fn2-checkpoint-refs-allocation r fn2-checkpoint-refs))
      (holder (fn2-checkpoint-teardown-debt-checkpoint c fn2-checkpoint-teardown-debt))
      ((unless (and (= (fn2-checkpoint-refs-storage-domain r fn2-checkpoint-refs) *fn2-checkpoint-served-storage-domain*)
                     (= (fn2-checkpoint-refs-retained r fn2-checkpoint-refs) 1)
                     (= (fn2-checkpoint-refs-edge r fn2-checkpoint-refs) edge)
                     (fn2-checkpoint-owned-provenance-p kind e fn2-checkpoint-construction fn2-extents)
                     (eq (fn2-alloc-handle-code e epoch allocation fn2-extents) :ok)
                     (< 0 (fn2-extents-selectable-checkpoint e fn2-extents))
                     (fn2-alloc-edge-matchesp edge holder e epoch allocation :selectable-checkpoint fn2-alloc-edges)))
       (fn2-checkpoint-dispose-mv :identity))
      ((unless (= (fn2-extents-obligation e fn2-extents) 0)) (fn2-checkpoint-dispose-mv :obligation))
      ((mv code fn2-extents fn2-alloc-edges) (fn2-alloc-edge-drop edge holder e epoch allocation :selectable-checkpoint fn2-extents fn2-alloc-edges))
      ((unless (eq code :ok)) (fn2-checkpoint-dispose-mv code))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-set-retained r 0 fn2-checkpoint-refs))
      (fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-set-dispose-cursor c (+ role 1) fn2-checkpoint-teardown-debt)))
  (fn2-checkpoint-dispose-mv :more)))

(fn2-checkpoint-dispose-operation fn2-checkpoint-dispose-step :any
 (budget c token kind slot gen generation commit-kind)
 (b* (((unless (and (natp budget) (< 0 budget))) (fn2-checkpoint-dispose-mv :yield))
      ((unless (and (fn2-checkpoint-dispose-current-p c token kind slot gen generation fn2-checkpoint-teardown-debt fn2-checkpoints fn2-checkpoint-bytes)
                     (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)))
       (fn2-checkpoint-dispose-mv :state))
      (code (fn2-checkpoint-dispose-environment-code c fn2-checkpoint-teardown-debt fn2-checkpoint-bytes fn2-checkpoint-publication fn2-csnapshot fn2-extents fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control fn2-event-archive fn2-release-evidence-candidates))
      ((unless (eq code :ok)) (fn2-checkpoint-dispose-mv code))
      (phase (fn2-checkpoint-teardown-debt-dispose-phase c fn2-checkpoint-teardown-debt))
      (at (fn2-checkpoint-teardown-debt-dispose-cursor c fn2-checkpoint-teardown-debt)))
  (cond
   ((= phase *fn2-checkpoint-dispose-phase-sources*)
    (b* (((mv code fn2-checkpoint-teardown-debt fn2-extents fn2-alloc-edges)
          (fn2-checkpoint-dispose-source-step c token kind slot gen generation commit-kind fn2-checkpoint-teardown-debt fn2-checkpoint-bytes fn2-checkpoint-publication fn2-checkpoint-payload-proofs fn2-csnapshot fn2-extents fn2-ops fn2-alloc-edges fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control fn2-event-archive fn2-release-evidence-candidates fn2-checkpoint-construction fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection)))
     (fn2-checkpoint-dispose-mv code)))
   ((= phase *fn2-checkpoint-dispose-phase-cold*) (fn2-checkpoint-dispose-cold-step c token kind slot gen generation commit-kind fn2-checkpoint-teardown-debt fn2-checkpoint-bytes fn2-checkpoint-publication fn2-checkpoint-payload-proofs fn2-csnapshot fn2-extents fn2-ops fn2-alloc-edges fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control fn2-event-archive fn2-release-evidence-candidates fn2-checkpoint-construction fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-checkpoint-refs))
   ((= phase *fn2-checkpoint-dispose-phase-roots*) (fn2-checkpoint-dispose-root-step c token kind slot gen generation commit-kind fn2-checkpoint-teardown-debt fn2-checkpoint-bytes fn2-checkpoint-publication fn2-checkpoint-payload-proofs fn2-csnapshot fn2-extents fn2-ops fn2-alloc-edges fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control fn2-event-archive fn2-release-evidence-candidates fn2-checkpoint-construction fn2-checkpoint-bank-closures fn2-checkpoint-bank-protection fn2-checkpoint-refs))
   ((= phase *fn2-checkpoint-dispose-phase-refs*)
    (cond ((> at 6) (fn2-checkpoint-dispose-mv :state))
          ((= at 6)
           (let ((fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-put c (dispose-phase *fn2-checkpoint-dispose-phase-bytes*) (dispose-cursor 0))))
            (fn2-checkpoint-dispose-mv :more)))
          (t (let* ((fn2-checkpoint-refs (fn2-checkpoint-refs-reset-row (+ (* 6 c) at) fn2-checkpoint-refs))
                    (fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-set-dispose-cursor c (+ at 1) fn2-checkpoint-teardown-debt)))
               (fn2-checkpoint-dispose-mv :more)))))
   ((= phase *fn2-checkpoint-dispose-phase-bytes*)
    (cond ((> at 192) (fn2-checkpoint-dispose-mv :state))
          ((= at 192)
           (let ((fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-put c (dispose-phase *fn2-checkpoint-dispose-phase-finish*) (dispose-cursor 0))))
            (fn2-checkpoint-dispose-mv :more)))
          (t (let* ((fn2-checkpoint-bytes (fn2-checkpoint-bytes-set-value (+ (* 192 c) at) 0 fn2-checkpoint-bytes))
                    (fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-set-dispose-cursor c (+ at 1) fn2-checkpoint-teardown-debt)))
               (fn2-checkpoint-dispose-mv :more)))))
   ((= phase *fn2-checkpoint-dispose-phase-finish*)
    (if (not (and (= at 0) (< 0 (fn2-checkpoint-teardown-debt-count fn2-checkpoint-teardown-debt))))
        (fn2-checkpoint-dispose-mv :state)
     (let* ((fn2-checkpoints (fn2-checkpoints-reset-row c fn2-checkpoints))
            (fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-reset-row c fn2-checkpoint-teardown-debt))
            (fn2-checkpoint-teardown-debt (update-fn2-checkpoint-teardown-debt-count (- (fn2-checkpoint-teardown-debt-count fn2-checkpoint-teardown-debt) 1) fn2-checkpoint-teardown-debt))
            ; Some terminal candidates had no last edge to mutate. Ownership
            ; nevertheless just became independently orphan-classifiable.
            (fn2-extents (update-fn2-alloc-orphan-dirty 1 fn2-extents)))
      (fn2-checkpoint-dispose-mv :done))))
   (t (fn2-checkpoint-dispose-mv :state)))))

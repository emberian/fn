; perf-ledger: sb-sprof (cpu, 1 ms) over fn-bpb-encode then fn-bpb-decode of a 262,144-octet bundle
(in-package "ACL2")
(require :sb-sprof)
(let* ((sender (cons :dtn '(47 47 98 112 45 115 101 110 100 101 114 47)))
       (dest (cons :dtn '(47 47 98 112 45 100 101 115 116 47)))
       (config (fn-bpn-config sender 3600000 2 32 1048576))
       (obs (fn-clock-observation 1000 0 0 nil))
       (bundle (fn-bpn-send-bundle config dest (make-list 262144 :initial-element 65) 7 obs))
       (wire nil))
  (sb-sprof:with-profiling (:max-samples 400000 :sample-interval 0.001 :mode :cpu)
    (setq wire (fn-bpb-encode bundle)))
  (with-open-file (s "/tank/fn/scratch/perf-ledger/results/bp-encode-256k-flat.txt" :direction :output :if-exists :supersede)
    (sb-sprof:report :type :flat :max 40 :stream s))
  (sb-sprof:reset)
  (sb-sprof:with-profiling (:max-samples 400000 :sample-interval 0.001 :mode :cpu)
    (fn-bpb-decode wire (+ 16 (len wire))))
  (with-open-file (s "/tank/fn/scratch/perf-ledger/results/bp-decode-256k-flat.txt" :direction :output :if-exists :supersede)
    (sb-sprof:report :type :flat :max 40 :stream s)))

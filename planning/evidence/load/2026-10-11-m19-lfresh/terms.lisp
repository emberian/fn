(in-package "ACL2")
(setq *print-pretty* nil)
(defparameter *m19-profile* (quote ((102 110 45 115 116 111 114 101 45 49 48) 16384 8388608 196608 32768 16 256 128 1048576 1048576 1048576 1048576 1048576 64 256 16384)))
(defun m19-try (name thunk) (handler-case (funcall thunk) (error (e) (format t "~&  ~a: ERROR ~a~%" name e) nil)))
(defmacro m19-v (form) `(m19-try (quote ,form) (lambda () ,form)))
(defun m19-base-terms (profile core observed)
  (let* ((tt (nfix (fn-bs-profile-max-transactions profile)))
         (r (nfix (fn-bs-profile-max-record-octets profile)))
         (hdr (nfix (fn-bs-profile-field *fn-bs-pf-max-header-octets* profile)))
         (ou (fn-heap-open-octets-bound profile observed))
         (on (fn-heap-open-records-bound profile observed)))
    (list (cons :image-dynamic (fn-heap-core-dynamic core))
          (cons :state-history (fn-heap-store-history-octets profile))
          (cons :state-handles (* *fn-heap-handle-octets* tt))
          (cons :state-records (* 2 tt *fn-heap-record-octets*))
          (cons :state-record-headers (* *fn-heap-charge-heap-octets* (nfix (fn-bs-profile-max-history-octets profile))))
          (cons :open-chunk-lists (* 2 *fn-heap-list-octets-per-octet* *fn-heap-open-list-copies* (fn-heap-open-chunk-bound profile ou)))
          (cons :open-suffix-vectors (* 2 ou))
          (cons :open-per-record (* 2 *fn-heap-open-record-octets* on))
          (cons :inflight-lists (* 2 *fn-heap-list-octets-per-octet* (+ r (* *fn-heap-inflight-header-copies* hdr))))
          (cons :taken-submission-lists (* 2 *fn-heap-list-octets-per-octet* (+ (nfix (fn-bs-profile-max-article-octets profile)) hdr *fn-heap-message-id-octets*)))
          (cons :octet-buffers (* 2 (fn-ock-capture-budget profile)))
          (cons :articles (fn-heap-articles-octets profile))
          (cons :history-roots (if (fboundp (quote fn-heap-hroot-reserve-octets)) (fn-heap-hroot-reserve-octets profile) 0)))))
(defun m19-sum (l) (loop for x in l sum (cdr x)))
(defun m19-run (core)
  (let* ((p *m19-profile*) (nursery 8388608) (obs (fn-heap-operation-observation :run nil))
         (terms (m19-base-terms p core obs))
         (base (fn-heap-store-base-octets p core obs))
         (fig (fn-heap-store-figure-octets p core nursery obs))
         (mb (fn-heap-mb-of fig))
         (threads (fn-heap-thread-count 32)) (stack (fn-heap-stack-kib p)))
    (format t "~&CORE ~s OBS ~s~%" core obs)
    (dolist (x terms) (format t "  BASE ~(~a~) ~d~%" (car x) (cdr x)))
    (format t "  BASE-SUM ~d BASE ~d UNATTRIBUTED ~d~%" (m19-sum terms) base (- base (m19-sum terms)))
    (format t "  COLLECTOR-ROOM ~d FIG ~d MB ~d ROUNDING ~d~%" (- fig base) fig mb (- (* *fn-heap-mib* mb) fig))
    (format t "  THREADS ~d = mux ~d + control-clients ~d + fixed ~d + cold ~d; STACK-KIB ~d RUNTIME ~d~%" threads *fn-heap-mux-loops* (fn-native-control-max-active-clients) *fn-heap-fixed-threads* *fn-heap-cold-workers* stack *fn-heap-thread-runtime-octets*)
    (format t "  CORE-FILE ~d BASE-RESERVATION ~d~%" (fn-heap-core-file core) (fn-heap-reservation-octets mb core stack threads))
    ;; the served run extension (page-read-startup), workers 4 cache-limit 8 as traced
    (let* ((workers 4) (cache-limit 8) (root "/x")
           (nur64 (* *fn-heap-mib* (fn-profile-limit :gc-nursery-mib)))
           (fcore (fn-prstartup-image-bound core))
           (fterms (m19-base-terms p fcore nil))
           (fbase (fn-heap-store-base-octets p fcore nil))
           (floor (fn-prstartup-launch-floor p core nil))
           (files (max 8 (+ 1 cache-limit)))
           (extra (fn-prstartup-launch-extra p workers cache-limit root))
           (d (max (* *fn-heap-mib* mb) floor))
           (grown (fn-heap-grow-runtime-dynamic d extra nur64))
           (gmb (fn-heap-mb-of grown))
           (total (fn-heap-reservation-octets gmb core stack threads)))
      (format t "  NURSERY-CAP ~d (gc-nursery-mib ~d)~%" nur64 (fn-profile-limit :gc-nursery-mib))
      (dolist (x fterms) (format t "  FLOOR-BASE ~(~a~) ~d~%" (car x) (cdr x)))
      (format t "  FLOOR-BASE-SUM ~d FLOOR-BASE ~d FLOOR ~d (collector-room ~d)~%" (m19-sum fterms) fbase floor (- floor fbase))
      (format t "  EXTRA ~d = baseline-heap ~d + registration ~d + read-reserve ~d (extent ~d demand ~d queue ~d)~%" extra
              (m19-v (fn-prstartup-baseline-heap files workers)) (m19-v (fn-prstartup-registration-reserve files root))
              (m19-v (fn-prstartup-read-reserve (fn-prstartup-read-extent p) workers))
              (m19-v (fn-prstartup-read-extent p)) (m19-v (fn-prstartup-read-demand (fn-prstartup-read-extent p))) (m19-v (fn-cwq-queue-octets)))
      (format t "  D ~d (heap ~d floor ~d) GROWN ~d = d+extra ~d / with-nursery(backing+extra) ~d; MB ~d~%" d (* *fn-heap-mib* mb) floor grown (+ d extra)
              (fn-heap-with-nursery (+ (nfix (- d (* 2 (fn-heap-nursery-trigger d nur64)))) extra) nur64) gmb)
      (format t "  TOTAL ~d = heap ~d + core-file ~d + threads ~d; MB ~d~%" total (* *fn-heap-mib* gmb) (fn-heap-core-file core)
              (* threads (+ (* 1024 stack) *fn-heap-thread-runtime-octets*)) (fn-heap-mb-of total))))
  (finish-output))

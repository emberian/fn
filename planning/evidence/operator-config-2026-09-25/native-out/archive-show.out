[store]
path="/tank/fn/scratch/operator-config/run/archive/store"
[listener]
host="127.0.0.1"
port=11963
tls_cert="/tank/fn/scratch/operator-config/run/archive/tls/cert.pem"
tls_key="/tank/fn/scratch/operator-config/run/archive/tls/key.pem"
[auth]
required=false
protected_only=false
path="/tank/fn/scratch/operator-config/run/archive/store/auth.toml"
[posting]
enabled=false
[anchor]
[acl2]
[log]
path="/tank/fn/scratch/operator-config/run/archive/log/fn.log"
[control]
path="/tank/fn/scratch/operator-config/run/archive/store/control.sock"
[alerts]
headroom_min_percent=25
refusal_rate_per_minute=30
cooldown_seconds=900
[ops]
mission="archive"
scope="user"
keep_releases=3
log_max_bytes=67108864
log_keep=7

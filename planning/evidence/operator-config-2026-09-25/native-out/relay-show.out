[store]
path="/tank/fn/scratch/operator-config/run/relay/store"
[listener]
host="127.0.0.1"
port=11962
tls_cert="/tank/fn/scratch/operator-config/run/relay/tls/cert.pem"
tls_key="/tank/fn/scratch/operator-config/run/relay/tls/key.pem"
[auth]
required=true
protected_only=true
path="/tank/fn/scratch/operator-config/run/relay/store/auth.toml"
[posting]
enabled=false
[anchor]
[acl2]
[log]
path="/tank/fn/scratch/operator-config/run/relay/log/fn.log"
[control]
path="/tank/fn/scratch/operator-config/run/relay/store/control.sock"
[alerts]
headroom_min_percent=20
refusal_rate_per_minute=120
cooldown_seconds=900
[ops]
mission="relay"
scope="user"
keep_releases=3
log_max_bytes=67108864
log_keep=7

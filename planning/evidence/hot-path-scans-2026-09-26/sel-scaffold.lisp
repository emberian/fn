(progn
(defconst *hp-local* (cons :dtn '(47 47 102 110 45 97 47)))
(defconst *hp-peer* (cons :dtn '(47 47 102 110 45 98 47)))
(defconst *hp-config* (fn-bpn-config *hp-local* 3600000 2 32 1048576))
(defconst *hp-obs* (fn-clock-observation 1000 0 0 nil))
(defconst *hp-node* '(100 116 110 58 47 47 102 110 45 97 47))
(defconst *hp-table* (list (fn-bprt-route 100 "dtn://fn-b/" "relay" "dtn://relay/" 4556)))
(defconst *hp-old-table* (list (fn-bprt-route 100 "dtn://fn-b/" "relay" "dtn://relay/" 4557)))
(defconst *hp-route* (fn-bprt-job-route "dtn://fn-b/" *hp-table* *hp-node* 10 1024 1048576))
(defconst *hp-old-route* (fn-bprt-job-route "dtn://fn-b/" *hp-old-table* *hp-node* 10 1024 1048576))
(defconst *hp-routing* (list :table *hp-table*))
(defun hp-codes (cs) (declare (xargs :mode :program)) (if (atom cs) nil (cons (char-code (car cs)) (hp-codes (cdr cs)))))
(defun hp-work (i) (declare (xargs :mode :program)) (cons 119 (hp-codes (explode-nonnegative-integer i 10 nil))))
(defun hp-jobs (b i n held)
  (declare (xargs :mode :program))
  (if (zp n) b
    (let* ((route (if (< i held) *hp-old-route* *hp-route*))
           (b1 (fn-bpn-answer-state
                (fn-bpn-step b (list :enqueue (hp-work i) '(97 49) 0 (+ 7 i) route *hp-peer* '(104 105) *hp-obs*))))
           (b2 (fn-bpn-answer-state (fn-bpn-step b1 (list :persist-result i :durable)))))
      (hp-jobs b2 (1+ i) (1- n) held))))
(defun hp-st (n held)
  (declare (xargs :mode :program))
  (fn-bpnf-with-base (fn-bpnf-initial-state *hp-config* 4096 (expt 2 30))
                     (hp-jobs (fn-bpn-initial-machine-state *hp-config* 4096 (expt 2 30)) 0 n held)))
(defun hp-find-visits (key jobs acc)
  (declare (xargs :mode :program))
  (if (atom jobs) acc
    (if (equal key (fn-bpn-job-key (car jobs))) (1+ acc) (hp-find-visits key (cdr jobs) (1+ acc)))))
; job-record visits of fn-bpnj-select: the traversal plus each fn-bpn-find-job
(defun hp-select-visits (rest jobs peer routing offered acc)
  (declare (xargs :mode :program))
  (if (atom rest) acc
    (let ((job (fn-bpn-find-job (fn-bpn-job-key (car rest)) jobs))
          (acc (hp-find-visits (fn-bpn-job-key (car rest)) jobs (1+ acc))))
      (if (fn-bpnj-readyp job peer routing offered) acc
        (hp-select-visits (cdr rest) jobs peer routing offered acc)))))
(defun hp-held-visits (rest jobs peer routing offered acc)
  (declare (xargs :mode :program))
  (if (atom rest) acc
    (let ((job (fn-bpn-find-job (fn-bpn-job-key (car rest)) jobs))
          (acc (hp-find-visits (fn-bpn-job-key (car rest)) jobs (1+ acc))))
      (if (and (fn-bpnj-candidatep job peer offered) (not (fn-bpnj-readyp job peer routing offered))) acc
        (hp-held-visits (cdr rest) jobs peer routing offered acc)))))
(defun hp-ask-visits (st routing offered)
  (declare (xargs :mode :program))
  (let ((jobs (fn-bpn-machine-state-jobs (fn-bpnf-base st))))
    (+ (hp-select-visits jobs jobs *hp-peer* routing offered 0)
       (hp-held-visits jobs jobs *hp-peer* routing offered 0))))
; a contact's whole drain: ask until not an offer, OFFERED growing
(defun hp-drain (st routing offered visits asks fuel)
  (declare (xargs :mode :program))
  (let ((d (fn-bpnj-contact-next st *hp-peer* routing offered))
        (v (+ visits (hp-ask-visits st routing offered))))
    (if (or (zp fuel) (not (equal (car d) :offer))) (list asks v (car d))
      (hp-drain st routing (caddr d) v (1+ asks) (1- fuel)))))
)
(progn
(defun hp-drain-only (st routing offered asks fuel)
  (declare (xargs :mode :program))
  (let ((d (fn-bpnj-contact-next st *hp-peer* routing offered)))
    (if (or (zp fuel) (not (equal (car d) :offer))) (list asks (car d))
      (hp-drain-only st routing (caddr d) (1+ asks) (1- fuel)))))
(defun hp-repeat (st k acc)
  (declare (xargs :mode :program))
  (if (zp k) acc (hp-repeat st (1- k) (car (fn-bpnj-contact-next st *hp-peer* *hp-routing* nil))))))
(progn
(defun hp-scan-visits (rest jobs peer routing offered held acc)
  (declare (xargs :mode :program))
  (if (atom rest) acc
    (let ((job (car rest)) (acc (1+ acc)))
      (cond ((fn-bpnj-readyp job peer routing offered)
             (let ((acc (hp-find-visits (fn-bpn-job-key job) jobs acc)))
               (if (fn-bpnj-own-entryp job jobs) acc
                 (hp-scan-visits (cdr rest) jobs peer routing offered held acc))))
            ((and (not held) (fn-bpnj-candidatep job peer offered))
             (let ((acc (hp-find-visits (fn-bpn-job-key job) jobs acc)))
               (hp-scan-visits (cdr rest) jobs peer routing offered (if (fn-bpnj-own-entryp job jobs) job held) acc)))
            (t (hp-scan-visits (cdr rest) jobs peer routing offered held acc))))))
(defun hp-ask-visits2 (st routing offered)
  (declare (xargs :mode :program))
  (let ((jobs (fn-bpn-machine-state-jobs (fn-bpnf-base st))))
    (hp-scan-visits jobs jobs *hp-peer* routing offered nil 0)))
(defun hp-drain2 (st routing offered visits asks fuel)
  (declare (xargs :mode :program))
  (let ((d (fn-bpnj-contact-next st *hp-peer* routing offered))
        (v (+ visits (hp-ask-visits2 st routing offered))))
    (if (or (zp fuel) (not (equal (car d) :offer))) (list asks v (car d))
      (hp-drain2 st routing (caddr d) v (1+ asks) (1- fuel))))))

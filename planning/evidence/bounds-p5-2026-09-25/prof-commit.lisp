(require :sb-sprof)
(in-package "ACL2")
(fnn-crypto-startup) (fnn-tls-reset) (fnn-hsig-reset) (fnn-hsig-initialize)
(defvar *root* (sb-ext:posix-getenv "PROF_ROOT"))
(defvar *n* (parse-integer (sb-ext:posix-getenv "PROF_N")))
;; The commit phase of fnn-command-probe only (the reopen is profiled apart).
(defun prof-commits (root count)
  (let* ((store (make-fnn-store root :writable t)) (payload nil))
    (fnn-initialize store) (fnn-acquire store) (fnn-bridge-reset) (fnn-recover store)
    (setq payload (make-array (fnn-config-max-payload store) :element-type '(unsigned-byte 8)
                              :initial-element (char-code #\x)))
    (let ((codes (fnn-group-codes-for store +fnn-default-groups+)) (t0 (get-internal-real-time)))
      (dotimes (sequence count)
        (when (zerop (mod sequence 250))
          (format t "~&at ~d ~,3f~%" sequence (/ (- (get-internal-real-time) t0) (float internal-time-units-per-second))))
        (let ((msgid (fnn-octets (fnn-ascii-octet-list (format nil "<capacity-~d@example.invalid>" sequence)))))
          (multiple-value-bind (obligation subject evidence) (fnn-metadata msgid payload)
            (fnn-advance-frontier store (fnn-bridge-next-txid))
            (unless (eq (fnn-bridge-prepare msgid payload codes obligation subject evidence (fnn-charge (length payload))) :prepared)
              (error "prepare refused"))
            (let ((pending (fnn-pending-sequence (fnn-core-state 'fn-store-sn-pending-sequence))))
              (unless (eq (fnn-publish store pending (fnn-bridge-pending-record)) :durable) (error "publish"))
              (fnn-mark-committed store pending))
            (unless (eq (fnn-finish store) :durable) (error "finish"))))))
    (fnn-store-close store)))
(sb-sprof:with-profiling (:max-samples 400000 :mode :cpu :sample-interval 0.01 :report nil)
  (prof-commits *root* *n*))
(sb-sprof:report :type :flat :max 110 :sort-by :cumulative-samples)
(sb-sprof:report :type :flat :max 30)
(sb-ext:exit :code 0 :abort t)

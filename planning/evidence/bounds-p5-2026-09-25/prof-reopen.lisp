(require :sb-sprof)
(in-package "ACL2")
(fnn-crypto-startup)
(fnn-tls-reset)
(fnn-hsig-reset)
(fnn-hsig-initialize)
(defvar *root* (sb-ext:posix-getenv "PROF_ROOT"))
(format t "~&root ~a~%" *root*)
(let ((t0 (get-internal-real-time)))
  (sb-sprof:with-profiling (:max-samples 200000 :mode :cpu :sample-interval 0.01 :report nil)
    (multiple-value-bind (s r) (fnn-open-live-store *root* nil)
      (format t "~&records ~d~%" (length r))
      (fnn-store-close s)))
  (format t "~&elapsed ~,3f~%" (/ (- (get-internal-real-time) t0) (float internal-time-units-per-second))))
(sb-sprof:report :type :flat :max 90 :sort-by :cumulative-samples)
(sb-sprof:report :type :graph :max 200)
(sb-ext:exit :code 0 :abort t)

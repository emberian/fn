# The public node's deploy parameters (lane public-node, 2026-09-26), read by
# build/coordinator/deploy-fresh.sh (lane deploy-fresh) as `. public-node.env`.
# Every value is the prepared default; the reasons are in
# planning/evidence/public-node-2026-09-26.md.

# Storage (PKT-579): rpool/fn-public mounted at /home/hbox/fn-public by
# fn-store-rpool.service; if ember has not run store-rpool-setup.sh, the same
# path is a plain directory on the NVMe ext4 root (the fallback). The deploy
# records which: `findmnt -no SOURCE,FSTYPE /home/hbox/fn-public`.
FN_PUBLIC_ROOT=/home/hbox/fn-public
FN_PUBLIC_EXPECT_FSTYPE=ext4         # the default (deploy_fresh.sh auto); "zfs" once ember ran store-rpool-setup.sh
FN_PUBLIC_DATASET=rpool/fn-public
FN_PUBLIC_PREFIX_PARENT=/home/hbox/fn-public/release   # the tarball unpacks to $FN_PUBLIC_PREFIX_PARENT/fn-REV12
FN_PUBLIC_NODE=/home/hbox/fn-public/node               # fn.toml, store, tls/, log/
FN_PUBLIC_KEYS=/home/hbox/fn-public/keys               # `peer keygen` target (must not exist before)
FN_PUBLIC_CONFIG=/home/hbox/fn-public/node/fn.toml

# Identity and mission.
FN_PUBLIC_NAME=fn.fg-goose.online
FN_PUBLIC_PATH_IDENTITY=fn.fg-goose.online
FN_PUBLIC_MISSION=small-community

# Listener: hbox's LAN address (wildcards are refused). The router forwards
# public TCP 119 -> 1119 and 563 -> 1563, so the node stays an unprivileged
# user unit (a user manager cannot grant CAP_NET_BIND_SERVICE).
FN_PUBLIC_LISTEN_HOST=192.168.50.39
FN_PUBLIC_PORT=1119          # plain, STARTTLS advertised; public 119
FN_PUBLIC_TLS_PORT=1563      # implicit TLS ([listener] tls_port); public 563

# Certificate: Let's Encrypt through lego (see acme/), installed by the renew
# hook into these two paths, which fn.toml's [listener] tls_cert/tls_key name.
FN_PUBLIC_TLS_CERT=/home/hbox/fn-public/node/tls/cert.pem   # full chain (SSL_CTX_use_certificate_chain_file)
FN_PUBLIC_TLS_KEY=/home/hbox/fn-public/node/tls/key.pem     # unencrypted EC P-256, 0600 (encrypted keys are refused)
FN_PUBLIC_ACME_DIR=/home/hbox/fn-public/acme

# The unit: a user unit of hbox (Linger=yes), under the name the live node's
# unit has, rewritten by deploy-fresh. MemoryMax: 1G until image-floor's gate
# lands (D35: under 256 MB reserved), then the profile's figure.
FN_PUBLIC_UNIT=fn-node.service
FN_PUBLIC_MEMORY_MAX=1G

# Applied after init, before the first start: one `policy set SLOT VALUE` per
# line of this file.
FN_PUBLIC_POLICY_FILE=exposure.policy

; Appended BOOT states. Every result ACK is consumed once before bounded work.
(:bootstrap :on-refusal ((:stop :geometry))
 (:do (code offset) (fn2-boot-bootstrap-offset id row-generation))
 (:set (offset offset))
 (:do (code) (fn2-boot-bootstrap-pack id row-generation))
 (:if (equal row-create 1)
  ((:next :bootstrap-write) (:charge :bytes 24576 :steps *fn2-work-stage* :runnable t))
  ((:do (code) (fn2-core-reset row-rx-slot row-rx-gen))
   (:next :bootstrap-read) (:charge :bytes 24576 :steps *fn2-work-stage* :runnable t))))
(:bootstrap-verify :on-refusal ((:stop :geometry))
 (:do (code) (fn2-boot-bootstrap-verify id row-generation 24576))
 (:set (checkpoint-index 0) (checkpoint-length 0) (checkpoint-seen 0) (checkpoint-invalid 0))
 (:next :checkpoint-anchor) (:charge :bytes 24576 :steps *fn2-work-stage* :runnable t))
(:checkpoint-anchor :on-refusal ((:stop :geometry))
 (:do (code offset) (fn2-boot-checkpoint-anchor-offset id row-generation))
 (:set (offset offset) (checkpoint-length 0))
 (:if (equal row-create 1)
  ((:do (code) (fn2-boot-checkpoint-anchor-zero id row-generation))
   (:next :checkpoint-anchor-write) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
  ((:do (code) (fn2-core-reset row-rx-slot row-rx-gen))
   (:next :checkpoint-anchor-read) (:charge :steps *fn2-work-stage* :runnable t))))
(:checkpoint-anchor-step :on-refusal ((:stop :anchor))
 (:do (code length) (fn2-boot-checkpoint-anchor-step id row-generation 4096) :accept ()
  :case (((:more) (:set (checkpoint-length length)) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
   ((:candidate :empty :invalid)
    (:set (checkpoint-length 0) (checkpoint-invalid (if (eq code :invalid) 1 row-checkpoint-invalid)))
    (:if (< row-checkpoint-index 3)
     ((:set (checkpoint-index (+ 1 row-checkpoint-index))
            (checkpoint-seen (if (eq code :candidate) 1 row-checkpoint-seen)))
      (:next :checkpoint-anchor) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
     ((:if (or (equal row-checkpoint-seen 1) (eq code :candidate))
       ((:set (checkpoint-index 0) (checkpoint-seen 1)) (:next :checkpoint-descriptor)
        (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
       ((:if (or (equal row-checkpoint-invalid 1) (eq code :invalid))
         ((:stop :anchor))
         ((:set (stage 1) (anchor-slot 0)) (:next :anchor)
          (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))))))))
   (:otherwise (:stop :anchor)))))
(:checkpoint-descriptor :on-refusal ((:stop :anchor))
 (:do (code offset bytes) (fn2-boot-checkpoint-descriptor-target row-checkpoint-index id row-generation) :accept ()
  :case (((:read)
    (:if (equal bytes 4096)
     ((:set (offset offset)) (:do (code) (fn2-core-reset row-rx-slot row-rx-gen))
      (:next :checkpoint-descriptor-read) (:charge :steps *fn2-work-stage* :runnable t))
     ((:stop :bounds))))
   ((:skip)
    (:if (< row-checkpoint-index 3)
     ((:set (checkpoint-index (+ 1 row-checkpoint-index))) (:charge :steps *fn2-work-stage* :runnable t))
     ((:next :checkpoint-restore) (:charge :steps *fn2-work-stage* :runnable t))))
   (:otherwise (:stop :anchor)))))
(:checkpoint-descriptor-step :on-refusal ((:stop :anchor))
 (:do (code) (fn2-boot-checkpoint-descriptor-check row-checkpoint-index row-rx-slot row-rx-gen id row-generation 4096) :accept ()
  :case (((:more) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
   ((:ok)
    (:if (< row-checkpoint-index 3)
     ((:set (checkpoint-index (+ 1 row-checkpoint-index))) (:next :checkpoint-descriptor)
      (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))
     ((:next :checkpoint-restore) (:charge :bytes 4096 :steps *fn2-work-stage* :runnable t))))
   (:otherwise (:stop :anchor)))))
; No candidate may reach recovery/serving until actual semantic restoration is
; connected. This explicit retained frontier replaces skipping selected roots.
(:checkpoint-restore (:idle))

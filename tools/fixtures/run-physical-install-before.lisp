       (hash-2 (fn2-checkpoint-summary-sources-hash-2 e fn2-checkpoint-summary-sources))
       (hash-3 (fn2-checkpoint-summary-sources-hash-3 e fn2-checkpoint-summary-sources))
       (hash-4 (fn2-checkpoint-summary-sources-hash-4 e fn2-checkpoint-summary-sources))
       (hash-5 (fn2-checkpoint-summary-sources-hash-5 e fn2-checkpoint-summary-sources))
       (hash-6 (fn2-checkpoint-summary-sources-hash-6 e fn2-checkpoint-summary-sources))
       (hash-7 (fn2-checkpoint-summary-sources-hash-7 e fn2-checkpoint-summary-sources))))

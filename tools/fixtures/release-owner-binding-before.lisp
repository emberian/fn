(actual-pool-gen (fn2-machine-pool-gen id fn2-core))
(actual-rc-wslot (fn2-machine-rc-wslot id fn2-core))
(actual-rc-wgen (fn2-machine-rc-wgen id fn2-core)))
(stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))
 (fn2-rec-cand (fn2-core-rec-cand fn2-core)) (fn2-checkpoint-selected-source (fn2-core-checkpoint-selected-source fn2-core))) (current)
   (and (< 0 (fn2-allocation-release-rows fn2-allocation-release))
    (< 0 (fn2-checkpoint-selected-source-rows fn2-checkpoint-selected-source))
    (= (fn2-allocation-release-replay-generation 0 fn2-allocation-release) (fn2-checkpoint-selected-source-generation 0 fn2-checkpoint-selected-source))
    (< actual-rc-pos (fn2-rec-cand-rows fn2-rec-cand))
    (= (fn2-allocation-release-journal 0 fn2-allocation-release) actual-rc-pos)
    (= (fn2-allocation-release-journal-epoch 0 fn2-allocation-release) (fn2-rec-cand-epoch actual-rc-pos fn2-rec-cand))
    (= (fn2-allocation-release-journal-allocation 0 fn2-allocation-release) (fn2-rec-cand-allocation actual-rc-pos fn2-rec-cand))
    (= (fn2-allocation-release-replay-history 0 fn2-allocation-release) (fn2-rec-cand-history actual-rc-pos fn2-rec-cand))
    (= (fn2-allocation-release-replay-incarnation 0 fn2-allocation-release) (fn2-rec-cand-history-incarnation actual-rc-pos fn2-rec-cand))
    (= (fn2-allocation-release-phase 0 fn2-allocation-release) *fn2-allocation-release-phase-replaying*)
    (= (fn2-allocation-release-owner-kind 0 fn2-allocation-release) *fn2-recovery-machine-kind*)

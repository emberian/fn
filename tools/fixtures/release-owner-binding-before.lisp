    (equal (fn2-allocation-release-owner-gen 0 fn2-allocation-release) ogen)
    (= (fn2-allocation-release-replay-base 0 fn2-allocation-release) actual-rc-base)
    (= (fn2-allocation-release-replay-tag 0 fn2-allocation-release) actual-rc-base-tag)
    (= (fn2-allocation-release-replay-commit 0 fn2-allocation-release) actual-rc-commit)
    (= (fn2-allocation-release-replay-position 0 fn2-allocation-release) actual-rc-pos)
    (= (fn2-allocation-release-replay-roff 0 fn2-allocation-release) actual-rc-roff)
    (= (fn2-allocation-release-replay-rend 0 fn2-allocation-release) actual-rc-rend)
    (= (fn2-allocation-release-replay-slot 0 fn2-allocation-release) actual-pool-slot)
    (= (fn2-allocation-release-replay-gen 0 fn2-allocation-release) actual-pool-gen)
    (= (fn2-allocation-release-read-slot 0 fn2-allocation-release) actual-rc-wslot)
    (= (fn2-allocation-release-read-gen 0 fn2-allocation-release) actual-rc-wgen)) current))))

(defun fn2-rp-release-current-p (id ogen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (and (fn2-rp-current-unit-auth-p id ogen fn2-core)
      (fn2-recovery-selected-current-p id fn2-core)
      (= (fn2-machine-rc-mode id fn2-core) *fn2-rec-mode-replay*)
      (= (fn2-machine-rc-wlen id fn2-core) 0)
  (let ((actual-rc-base (fn2-machine-rc-base id fn2-core))
(actual-rc-base-tag (fn2-machine-rc-base-tag id fn2-core))
(actual-rc-commit (fn2-machine-rc-commit id fn2-core))
(actual-rc-pos (fn2-machine-rc-pos id fn2-core))
(actual-rc-roff (fn2-machine-rc-roff id fn2-core))

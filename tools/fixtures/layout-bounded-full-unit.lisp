; Post-projection executable control: requires the three named layout hunks.
; The original malformed model boundary remains immutable in its earlier test.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../../tests/layout-payload-span-unit")

(defun fn2-full-case (fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* (((mv setup fn2-fields fn2-pool) (fn2-span-case 6144 4096 fn2-fields fn2-pool))
      (slot (fn2-fields-ref-slot 1 fn2-fields)) (gen (fn2-fields-ref-gen 1 fn2-fields))
      (end (+ 6144 8))
      (fn2-fields (fn2-fields-init 8 fn2-fields))
      ((mv gc gn fn2-fields) (fn2-span-fixture-decode 0 slot gen 0 end 1 0 1 fn2-fields fn2-pool))
      (generated (fn2-span-fields 0 fn2-fields))
      (frame (fn2-span-frame fn2-fields))
      ((mv owner-code owner-next fn2-fields)
       (fn2-span-fixture-decode 0 slot gen 0 end 1 0 2 fn2-fields fn2-pool))
      (readonly-refusal (and (eq owner-code :owner) (= owner-next 0)
                            (equal frame (fn2-span-frame fn2-fields))))
      (fn2-fields (fn2-fields-init 8 fn2-fields))
      ((mv mc mn fn2-fields)
       (fn2-layout-decode '((code :u8) (body (:octets32 6144)) (tail (:zero 3)))
        slot gen 0 end 1 0 1 fn2-fields fn2-pool))
      (full (and setup (eq gc :ok) (eq mc :ok) (= gn end) (= mn end)
        (equal generated (fn2-span-fields 0 fn2-fields))
        (= (fn2-fields-ref-slot 1 fn2-fields) slot)
        (= (fn2-fields-ref-gen 1 fn2-fields) gen)
        (= (fn2-fields-ref-off 1 fn2-fields) 5) (= (fn2-fields-ref-len 1 fn2-fields) 6144)))
      (fn2-fields (fn2-fields-init 8 fn2-fields))
      ((mv gt gtn fn2-fields) (fn2-span-fixture-decode 0 slot gen 0 (- end 1) 1 0 1 fn2-fields fn2-pool))
      (gtr (fn2-span-fields 0 fn2-fields))
      (fn2-fields (fn2-fields-init 8 fn2-fields))
      ((mv mt mtn fn2-fields)
       (fn2-layout-decode '((code :u8) (body (:octets32 6144)) (tail (:zero 3)))
        slot gen 0 (- end 1) 1 0 1 fn2-fields fn2-pool))
      (truncated (and (eq gt :truncated) (eq mt :truncated) (= gtn (- end 1)) (= mtn gtn)
                      (equal gtr (fn2-span-fields 0 fn2-fields))))
      ((mv written fn2-pool) (fn2-pool-write slot gen (- end 1) 9 1 0 1 fn2-pool))
      (fn2-fields (fn2-fields-init 8 fn2-fields))
      ((mv ge genext fn2-fields) (fn2-span-fixture-decode 0 slot gen 0 end 1 0 1 fn2-fields fn2-pool))
      (ger (fn2-span-fields 0 fn2-fields))
      (fn2-fields (fn2-fields-init 8 fn2-fields))
      ((mv me menext fn2-fields)
       (fn2-layout-decode '((code :u8) (body (:octets32 6144)) (tail (:zero 3)))
        slot gen 0 end 1 0 1 fn2-fields fn2-pool))
      (error (and (eq written :ok) (eq ge :nonzero-padding) (eq me :nonzero-padding)
                  (= genext end) (= menext genext) (equal ger (fn2-span-fields 0 fn2-fields)))))
  (mv (list full readonly-refusal truncated error) fn2-fields fn2-pool)))

(defun fn2-full-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (result fn2-fields)
   (with-local-stobj fn2-pool
    (mv-let (result fn2-fields fn2-pool) (fn2-full-case fn2-fields fn2-pool)
     (mv result fn2-fields))) result)))
(assert-event (equal (fn2-full-test) '(t t t t)))

(deflayout fn2-full-small '((number :u60)))
(defun fn2-full-prefix-fill (i n slot gen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- (nfix n) (nfix i)))))
 (if (>= (nfix i) (nfix n)) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen i 128 1 0 1 fn2-pool)
   (if (eq code :ok) (fn2-full-prefix-fill (+ 1 i) n slot gen fn2-pool) (mv code fn2-pool)))))
(defun fn2-full-prefix-case (n fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init 8 fn2-fields))
      (fn2-pool (fn2-pool-init '((1 . 65536)) 1 100 fn2-pool))
      ((mv r slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv w fn2-pool) (fn2-full-prefix-fill 0 n slot gen fn2-pool))
      (premise (and (eq r :ok) (eq w :ok) (fn2-pool-semanticp fn2-pool)
                   (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)
                   (eq (fn2-layout-range-code slot gen 0 n nil 1 0 1 fn2-pool) :ok)))
      ((mv gc gn fn2-fields) (fn2-full-small-decode 0 slot gen 0 n 1 0 1 fn2-fields fn2-pool))
      (generated (fn2-span-fields 0 fn2-fields))
      (fn2-fields (fn2-fields-init 8 fn2-fields))
      ((mv mc mn fn2-fields) (fn2-layout-decode '((number :u60)) slot gen 0 n 1 0 1 fn2-fields fn2-pool)))
  (mv (list premise gc gn mc mn (equal generated (fn2-span-fields 0 fn2-fields))) fn2-fields fn2-pool)))
(defun fn2-full-prefix-test (n)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (result fn2-fields)
   (with-local-stobj fn2-pool
    (mv-let (result fn2-fields fn2-pool) (fn2-full-prefix-case n fn2-fields fn2-pool)
     (mv result fn2-fields))) result)))
(assert-event (equal (fn2-full-prefix-test 9) '(t :truncated 9 :truncated 9 t)))
(assert-event (equal (fn2-full-prefix-test 65536) '(t :more 10 :more 10 t)))

; The sentinel is required when input ends exactly at the field-byte budget.
; A large enclosing page does not grant this tiny schema a whole-page scan.
(assert-event
 (and (= (fn2-layout-full-decode-fuel '((number :u60)) 0 65536)
         (+ 1 (fn2-layout-max-size '((number :u60)))))
      (= (fn2-layout-full-decode-fuel '((number :u60)) 0 1) 2)))

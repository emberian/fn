; Actual credit configuration and reserve-credit producer tag this slot. The
; ordinary release must return :credit while retaining the row and handle.
(defun fn2-srh-resident-credit-body (fn2-run-installed fn2-run-cache fn2-pool)
 (declare (xargs :stobjs (fn2-run-installed fn2-run-cache fn2-pool) :verify-guards nil))
 (b* ((fn2-run-installed (fn2-run-installed-init 1 fn2-run-installed))
      (fn2-run-cache (fn2-run-cache-init 8 fn2-run-cache))
      (fn2-pool (fn2-pool-init '((1 . 64)) 5 20 fn2-pool))
      ((mv configured fn2-pool) (fn2-pool-credit-configure '((1 1)) fn2-pool))
      ((mv begun fn2-pool) (fn2-pool-credit-begin 0 *fn2-pool-credit-working* 1 1 10 3 fn2-pool))
      ((mv reserved slot gen fn2-pool) (fn2-pool-reserve-credit 0 1 0 1 10 3 fn2-pool))
      ((mv cached fn2-run-cache) (fn2-run-cache-install 0 1 slot gen fn2-run-cache))
      ((mv installed fn2-run-installed)
       (fn2-run-install 0 1 1 0 slot gen 0 1 1 1 10 3 fn2-run-installed))
      ((mv interval fn2-run-installed)
       (fn2-run-install-units 0 0 0 fn2-run-installed))
      ((mv retired fn2-run-installed) (fn2-run-retire 0 fn2-run-installed))
      (before-row (fn2-srh-run-installed-rows 0 fn2-run-installed))
      (before-cache (fn2-srh-run-cache-rows 0 fn2-run-cache))
      (before-pool (fn2-srh-pool-snapshot fn2-pool))
      ((mv refused fn2-run-installed fn2-run-cache fn2-pool)
       (fn2-seal-release-row 0 fn2-run-installed fn2-run-cache fn2-pool)))
  (mv (and (eq configured :ok) (eq begun :ok) (eq reserved :ok) (eq cached :ok)
           (eq installed :ok) (eq interval :ok) (eq retired :ok)
           (eq refused :credit)
           (equal before-row (fn2-srh-run-installed-rows 0 fn2-run-installed))
           (equal before-cache (fn2-srh-run-cache-rows 0 fn2-run-cache))
           (equal before-pool (fn2-srh-pool-snapshot fn2-pool)))
      fn2-run-installed fn2-run-cache fn2-pool)))
(defun fn2-srh-resident-credit-test ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-run-installed fn2-run-cache fn2-pool)
  (fn2-srh-resident-credit-body fn2-run-installed fn2-run-cache fn2-pool)))
(assert-event (fn2-srh-resident-credit-test))

; Real query references can hold either arena after publication. INSTALL is
; called once; both the direct second call and phase dispatch refuse re-entry.
; The selected cleanup phase retries only the still-owned handle.
(defun fn2-srh-staged-cleanup-body (hold-hash fn2-seals fn2-overlays fn2-overlay-index
 fn2-run-installed fn2-pool)
 (declare (xargs :stobjs (fn2-seals fn2-overlays fn2-overlay-index fn2-run-installed fn2-pool)
                 :verify-guards nil))
 (b* ((fn2-seals (fn2-seals-init 1 fn2-seals))
      (fn2-overlays (fn2-overlays-init 1 fn2-overlays))
      (fn2-overlay-index (fn2-overlay-index-init 1 fn2-overlay-index))
      (fn2-run-installed (fn2-run-installed-init 1 fn2-run-installed))
      (fn2-pool (fn2-pool-init '((3 . 64)) 5 20 fn2-pool))
      ((mv reserve-o oslot ogen fn2-pool) (fn2-pool-reserve 0 1 10 3 fn2-pool))
      ((mv reserve-h hslot hgen fn2-pool) (fn2-pool-reserve 0 1 10 3 fn2-pool))
      ((mv reserve-r rslot rgen fn2-pool) (fn2-pool-reserve 0 1 10 3 fn2-pool))
      ((mv started fn2-overlays fn2-pool)
       (fn2-ov-start 0 1 oslot ogen 0 1 1 10 3 0
        fn2-overlays fn2-overlay-index fn2-pool))
      ((mv frozen fn2-overlays) (fn2-ov-freeze 0 fn2-overlays))
      ((mv write-o fn2-pool) (fn2-pool-write oslot ogen 0 165 1 10 3 fn2-pool))
      ((mv write-h fn2-pool) (fn2-pool-write hslot hgen 0 90 1 10 3 fn2-pool))
      (fn2-seals (fn2-seals-put 0
       (phase *fn2-seal-phase-install*) (sub *fn2-seal-sub-open*)
       (o 0) (sid 1) (run 1) (top 0) (rslot rslot) (rgen rgen)
       (runit 0) (rcounter 1) (entries 1) (ufirst 0) (units 0)
       (hslot hslot) (hgen hgen) (k 0) (rlo 0) (filter 0)
       (okind 1) (oslot 10) (ogen 3)))
      (held-slot (if hold-hash hslot oslot))
      (held-gen (if hold-hash hgen ogen))
      ((mv acquired fn2-pool)
       (fn2-pool-query-acquire held-slot held-gen 0 1 1 10 3 fn2-pool))
      ((mv installed fn2-seals fn2-overlays fn2-run-installed fn2-pool)
       (fn2-seal-install fn2-seals fn2-overlays fn2-run-installed fn2-pool))
      (published (fn2-srh-run-installed-rows 0 fn2-run-installed))
      (after-install-seals (fn2-srh-seals-rows 0 fn2-seals))
      (after-install-overlays (fn2-srh-overlays-rows 0 fn2-overlays))
      (after-install-pool (fn2-srh-pool-snapshot fn2-pool))
      ((mv duplicate fn2-seals fn2-overlays fn2-run-installed fn2-pool)
       (fn2-seal-install fn2-seals fn2-overlays fn2-run-installed fn2-pool))
      (duplicate-retains (and
       (equal published (fn2-srh-run-installed-rows 0 fn2-run-installed))
       (equal after-install-seals (fn2-srh-seals-rows 0 fn2-seals))
       (equal after-install-overlays (fn2-srh-overlays-rows 0 fn2-overlays))
       (equal after-install-pool (fn2-srh-pool-snapshot fn2-pool))))
      ((mv arena fn2-seals fn2-overlays fn2-pool)
       (fn2-seal-overlay-return fn2-seals fn2-overlays fn2-pool))
      (after-arena-seals (fn2-srh-seals-rows 0 fn2-seals))
      (after-arena-overlays (fn2-srh-overlays-rows 0 fn2-overlays))
      (after-arena-pool (fn2-srh-pool-snapshot fn2-pool))
      ((mv hash-first fn2-seals fn2-pool)
       (if hold-hash (fn2-seal-hash-return fn2-seals fn2-pool)
         (mv :skipped fn2-seals fn2-pool)))
      (held-retains (and
       (equal published (fn2-srh-run-installed-rows 0 fn2-run-installed))
       (equal (if hold-hash after-arena-seals after-install-seals)
              (fn2-srh-seals-rows 0 fn2-seals))
       (equal (if hold-hash after-arena-overlays after-install-overlays)
              (fn2-srh-overlays-rows 0 fn2-overlays))
       (equal (if hold-hash after-arena-pool after-install-pool)
              (fn2-srh-pool-snapshot fn2-pool))
       (if hold-hash
           (and (eq arena :more) (eq hash-first :held)
                (= (fn2-seals-phase 0 fn2-seals) *fn2-seal-phase-hash-return*)
                (= (fn2-overlays-phase 0 fn2-overlays) *fn2-overlay-phase-free*))
         (and (eq arena :held) (eq hash-first :skipped)
              (= (fn2-seals-phase 0 fn2-seals) *fn2-seal-phase-overlay-return*)
              (= (fn2-overlays-phase 0 fn2-overlays) *fn2-overlay-phase-frozen*)))))
      ((mv closed last fn2-pool)
       (fn2-pool-query-release held-slot held-gen fn2-pool))
      ((mv arena-retry fn2-seals fn2-overlays fn2-pool)
       (if hold-hash (mv :skipped fn2-seals fn2-overlays fn2-pool)
         (fn2-seal-overlay-return fn2-seals fn2-overlays fn2-pool)))
      ((mv completed fn2-seals fn2-pool)
       (fn2-seal-hash-return fn2-seals fn2-pool))
      ((mv again fn2-seals fn2-pool)
       (fn2-seal-hash-return fn2-seals fn2-pool)))
  (mv (and (eq reserve-o :ok) (eq reserve-h :ok) (eq reserve-r :ok)
           (eq started :ok) (eq frozen :ok) (eq write-o :ok) (eq write-h :ok)
           (eq acquired :ok) (eq installed :more) (eq duplicate :state)
           duplicate-retains
           held-retains (eq closed :ok) last
           (eq arena-retry (if hold-hash :skipped :more))
           (eq completed :done) (eq again :state)
           (= (fn2-seals-phase 0 fn2-seals) *fn2-seal-phase-idle*)
           (= (fn2-run-installed-state 0 fn2-run-installed)
              *fn2-run-installed-state-live*)
           (equal published (fn2-srh-run-installed-rows 0 fn2-run-installed))
           (= (fn2-pool-free-count 0 fn2-pool) 2)
           (eq (fn2-pool-slot-state rslot fn2-pool) :workspace))
      fn2-seals fn2-overlays fn2-overlay-index fn2-run-installed fn2-pool)))

(defun fn2-srh-staged-overlay-held-test ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-seals fn2-overlays fn2-overlay-index fn2-run-installed fn2-pool)
  (fn2-srh-staged-cleanup-body nil fn2-seals fn2-overlays fn2-overlay-index
   fn2-run-installed fn2-pool)))
(assert-event (fn2-srh-staged-overlay-held-test))
(defun fn2-srh-staged-hash-held-test ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-seals fn2-overlays fn2-overlay-index fn2-run-installed fn2-pool)
  (fn2-srh-staged-cleanup-body t fn2-seals fn2-overlays fn2-overlay-index
   fn2-run-installed fn2-pool)))
(assert-event (fn2-srh-staged-hash-held-test))

; A sufficient-summary result retains its subject and continuation bytes.
; Cold selection/projection provenance is a separate, earlier carrier.
(in-package "ACL2")
(include-book "checkpoint")
(fn2-book-layer :b)
(defcolumns fn2-checkpoint-summary-authority
 ((phase (:enum fn2-checkpoint-summary-authority-phase (:idle :copy :complete :uncertain)))
  (origin (:enum fn2-checkpoint-summary-authority-origin (:none :cold :live)))
  (tag :u60) (candidate :u32) (checkpoint :u60) (cut-commit :u60) (cut-event :u60)
  (history :u60) (incarnation :u60) (generation :u60)
  (catalog-tag :u60) (source-count :u60) (source-observation :u60) (cursor :u32)
  (owner-kind :u8) (owner-slot :u32) (owner-gen :u60))
 :extra-fields
 ((fn2-checkpoint-summary-authority-descriptor :type (array (unsigned-byte 8) (32)) :initially 0
   :why "Exact descriptor identity of the sufficient summary, not a slot number.")
  (fn2-checkpoint-summary-authority-frontier :type (array (unsigned-byte 32) (480)) :initially 0
   :why "Sixty authenticated semantic-member peaks, eight little-endian words per peak.")
  (fn2-checkpoint-summary-authority-cut-seal :type (array (unsigned-byte 32) (8)) :initially 0
   :why "Physical predecessor at cut C, distinct from descriptor and later installation J.")))

(defun fn2-checkpoint-summary-authority-descriptor-p (i c fn2-checkpoint-summary-authority fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-checkpoint-summary-authority fn2-checkpoint-bytes)
 :measure (nfix (- 32 (nfix i)))
 :guard (and (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority)
             (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes) (natp i) (<= i 32)
             (natp c) (<= (+ (* 192 c) 32) (fn2-checkpoint-bytes-rows fn2-checkpoint-bytes)))))
 (or (>= (nfix i) 32)
  (and (= (fn2-checkpoint-summary-authority-descriptori i fn2-checkpoint-summary-authority)
          (fn2-checkpoint-bytes-value (+ (* 192 c) i) fn2-checkpoint-bytes))
       (fn2-checkpoint-summary-authority-descriptor-p (+ 1 i) c fn2-checkpoint-summary-authority fn2-checkpoint-bytes))))
(defun fn2-checkpoint-summary-authority-current-p (fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 :guard (and (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority) (fn2-checkpoints-wfp fn2-checkpoints)
             (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes))))
 (and (< 0 (fn2-checkpoint-summary-authority-rows fn2-checkpoint-summary-authority))
      (posp (fn2-checkpoint-summary-authority-tag 0 fn2-checkpoint-summary-authority))
      (member (fn2-checkpoint-summary-authority-origin 0 fn2-checkpoint-summary-authority)
       (list *fn2-checkpoint-summary-authority-origin-cold* *fn2-checkpoint-summary-authority-origin-live*))
      (let ((c (fn2-checkpoint-summary-authority-candidate 0 fn2-checkpoint-summary-authority)))
       (and (fn2-checkpoint-slotp c fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
            (member (fn2-checkpoints-state c fn2-checkpoints)
             (list *fn2-checkpoint-state-checked* *fn2-checkpoint-state-installed* *fn2-checkpoint-state-promoting* *fn2-checkpoint-state-promoted*))
            (= (fn2-checkpoint-summary-authority-checkpoint 0 fn2-checkpoint-summary-authority) (fn2-checkpoints-checkpoint c fn2-checkpoints))
            (= (fn2-checkpoint-summary-authority-cut-commit 0 fn2-checkpoint-summary-authority) (fn2-checkpoints-cut-commit c fn2-checkpoints))
            (= (fn2-checkpoint-summary-authority-cut-event 0 fn2-checkpoint-summary-authority) (fn2-checkpoints-cut-event c fn2-checkpoints))
            (= (fn2-checkpoint-summary-authority-history 0 fn2-checkpoint-summary-authority) (fn2-checkpoints-history c fn2-checkpoints))
            (= (fn2-checkpoint-summary-authority-incarnation 0 fn2-checkpoint-summary-authority) (fn2-checkpoints-incarnation c fn2-checkpoints))
            (fn2-checkpoint-summary-authority-descriptor-p 0 c fn2-checkpoint-summary-authority fn2-checkpoint-bytes)))))
(defun fn2-checkpoint-summary-authority-complete-p (fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 :guard (and (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority) (fn2-checkpoints-wfp fn2-checkpoints)
             (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes))))
 (and (fn2-checkpoint-summary-authority-current-p fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
      (= (fn2-checkpoint-summary-authority-phase 0 fn2-checkpoint-summary-authority) *fn2-checkpoint-summary-authority-phase-complete*)
      (= (fn2-checkpoint-summary-authority-cursor 0 fn2-checkpoint-summary-authority) 488)))

(defun fn2-checkpoint-summary-authority-frontier-word (level i fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 :guard (and (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority) (fn2-checkpoints-wfp fn2-checkpoints)
             (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes))))
 (if (not (and (natp level) (< level 60) (natp i) (< i 8))) (mv :bounds 0)
  (if (not (fn2-checkpoint-summary-authority-complete-p fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes))
      (mv :source 0)
   (mv :ok (fn2-checkpoint-summary-authority-frontieri (+ (* 8 level) i) fn2-checkpoint-summary-authority)))))
(defun fn2-checkpoint-summary-authority-cut-seal-word (i fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 :guard (and (fn2-checkpoint-summary-authority-wfp fn2-checkpoint-summary-authority) (fn2-checkpoints-wfp fn2-checkpoints)
             (fn2-checkpoint-refs-wfp fn2-checkpoint-refs) (fn2-checkpoint-bytes-wfp fn2-checkpoint-bytes))))
 (if (not (and (natp i) (< i 8))) (mv :bounds 0)
  (if (not (fn2-checkpoint-summary-authority-complete-p fn2-checkpoint-summary-authority fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes))
      (mv :source 0)
   (mv :ok (fn2-checkpoint-summary-authority-cut-seali i fn2-checkpoint-summary-authority)))))

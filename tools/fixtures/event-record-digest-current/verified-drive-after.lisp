(defun fn2-epv-drive (fuel fault edited records fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (b* (((mv phase slot gen)
       (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))) (phase slot gen)
        (mv (fn2-event-read-phase 0 fn2-event-read) (fn2-event-read-slot 0 fn2-event-read) (fn2-event-read-gen 0 fn2-event-read))
        (mv phase slot gen)))
      ((when (or (zp fuel) (member-equal phase (list *fn2-event-read-phase-complete* *fn2-event-read-phase-uncertain*))))
       (mv phase (reverse records) fn2-core fn2-sim fn2-own))
      (corrupt (and (not edited) (or (and (eq fault :seal) (= phase *fn2-event-read-phase-frame-seal*))
                                                    (and (eq fault :records) (= phase *fn2-event-read-phase-frame-records*)))))
      ((mv & fn2-core)
       (if corrupt
           (b* (((mv & byte) (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code byte)
                              (fn2-pool-read slot gen 4095 7 0 1 fn2-pool) (mv code byte))))
            (fn2-core-write slot gen 4095 (logxor 1 byte) 7 0 1 fn2-core)) (mv :ok fn2-core)))
      (records
       (stobj-let ((fn2-journal-members (fn2-core-journal-members fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (new)
        (if (and (= phase *fn2-event-read-phase-members*)
                 (= (fn2-journal-members-phase 0 fn2-journal-members) *fn2-journal-members-phase-leaf*)
                 (= (fn2-journal-members-hash-phase 0 fn2-journal-members) 0))
            (cons (fn2-pool-logical-octets
                    (- (fn2-journal-members-leaf-end 0 fn2-journal-members) (fn2-journal-members-start 0 fn2-journal-members))
                    (+ (fn2-pool-base slot fn2-pool) (fn2-journal-members-start 0 fn2-journal-members)) fn2-pool) records)
          records) new))
      (fetch (equal phase *fn2-event-read-phase-record-digest*))
       (first-fetch (and fetch (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))) (first)
                                 (member-equal (fn2-event-read-record-fetch-next 0 fn2-event-read) '(0 1)) first)))
       ((mv controls fn2-core) (if first-fetch (fn2-epv-fetch-controls fn2-core) (mv t fn2-core)))
       ((unless controls) (mv *fn2-event-read-phase-uncertain* (reverse records) fn2-core fn2-sim fn2-own))
       (loan-error (and (eq fault :loan) fetch
                    (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))) (partial)
                     (= (fn2-event-read-record-fetch-next 0 fn2-event-read) 1) partial)))
       ((mv failed-closed fn2-core) (if loan-error (fn2-epv-fetch-loan-error fn2-core) (mv t fn2-core)))
       ((when loan-error) (mv (if failed-closed *fn2-event-read-phase-uncertain* *fn2-event-read-phase-idle*)
                            (reverse records) fn2-core fn2-sim fn2-own))
       ((mv fetched fn2-core) (if fetch (fn2-epv-fetch-one fn2-core) (mv t fn2-core)))
       ((unless fetched) (mv *fn2-event-read-phase-uncertain* (reverse records) fn2-core fn2-sim fn2-own))
       ((mv & fn2-core)
       (cond ((member-equal phase (list *fn2-event-read-phase-read-seal* *fn2-event-read-phase-read-records*)) (fn2-epv-issue fn2-core))
             ((and (not fetch) (fn2-event-read-format-phase-p phase))
              (fn2-epv-format 4096 fn2-core))
             ((= phase *fn2-event-read-phase-members*) (fn2-epv-members fn2-core)) (t (mv :wait fn2-core))))
      ((mv fn2-core fn2-sim fn2-own) (fn2-epv-physical fn2-core fn2-sim fn2-own)))
  (fn2-epv-drive (- fuel 1) fault (or edited corrupt) records fn2-core fn2-sim fn2-own)))

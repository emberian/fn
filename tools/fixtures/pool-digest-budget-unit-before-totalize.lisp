; Actual U32 encoder -> shared digest loader; all assertions UNRUN.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/pool-digest")
(deflayout fn2-rec-budget-words
 '((w0 :u32) (w1 :u32) (w2 :u32) (w3 :u32) (w4 :u32) (w5 :u32) (w6 :u32) (w7 :u32)))
(defconst *fn2-rdb-sentinel* 2863311530)
(defun fn2-rdb-seed (i fn2-fields fn2-digests)
 (declare (xargs :stobjs (fn2-fields fn2-digests) :verify-guards nil :measure (nfix (- 8 (nfix i)))))
 (if (>= (nfix i) 8) (mv fn2-fields fn2-digests)
  (let* ((fn2-fields (fn2-fields-set-value i (+ 12345 (* 101 i)) fn2-fields))
         (fn2-digests (fn2-digest-set-word 0 i *fn2-rdb-sentinel* fn2-digests))
         (fn2-digests (fn2-digest-set-word 1 i 1431655765 fn2-digests)))
   (fn2-rdb-seed (+ 1 i) fn2-fields fn2-digests))))
(defun fn2-rdb-words (i first count fn2-fields fn2-digests)
 (declare (xargs :stobjs (fn2-fields fn2-digests) :verify-guards nil :measure (nfix (- 8 (nfix i)))))
 (if (>= (nfix i) 8) t
  (and (= (fn2-digest-word 0 i fn2-digests)
          (if (and (<= first i) (< i (+ first count))) (fn2-fields-value i fn2-fields) *fn2-rdb-sentinel*))
       (= (fn2-digest-word 1 i fn2-digests) 1431655765)
       (fn2-rdb-words (+ 1 i) first count fn2-fields fn2-digests))))
(defun fn2-rdb-drive (left next acc slot gen fn2-fields fn2-pool fn2-digests)
 (declare (xargs :stobjs (fn2-fields fn2-pool fn2-digests) :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv nil fn2-digests)
  (b* (((mv code after partial fn2-digests)
        (fn2-rec-fetch-step 1 next acc 0 slot gen 0 1 0 1 fn2-pool fn2-digests))
       (visit (and (= after (+ 1 next)) (fn2-rec-fetch-state-p after partial)
                    (eq code (if (= after 32) :ok :more))
                    (fn2-rdb-words 0 0 (floor after 4) fn2-fields fn2-digests)))
       ((mv rest fn2-digests)
        (if (= after 32) (mv t fn2-digests)
          (fn2-rdb-drive (- left 1) after partial slot gen fn2-fields fn2-pool fn2-digests))))
   (mv (and visit rest) fn2-digests))))
(defun fn2-rdb-full (k slot gen fn2-fields fn2-pool fn2-digests)
 (declare (xargs :stobjs (fn2-fields fn2-pool fn2-digests) :verify-guards nil :measure (nfix (- 9 (nfix k)))))
 (if (>= (nfix k) 9) (mv t fn2-fields fn2-digests)
  (b* (((mv fn2-fields fn2-digests) (fn2-rdb-seed 0 fn2-fields fn2-digests))
       ((mv code fn2-digests) (fn2-rec-fetch k 0 slot gen 0 1 0 1 fn2-pool fn2-digests))
       (good (and (eq code :ok) (fn2-rdb-words 0 k (- 8 k) fn2-fields fn2-digests)))
       ((mv rest fn2-fields fn2-digests) (fn2-rdb-full (+ 1 k) slot gen fn2-fields fn2-pool fn2-digests)))
   (mv (and good rest) fn2-fields fn2-digests))))
(defun fn2-rdb-case (fn2-fields fn2-pool fn2-digests)
 (declare (xargs :stobjs (fn2-fields fn2-pool fn2-digests) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init 8 fn2-fields))
      (fn2-pool (fn2-pool-init '((1 . 64)) 1 100 fn2-pool))
      (fn2-digests (fn2-digests-init 2 fn2-digests))
      ((mv reserved slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv fn2-fields fn2-digests) (fn2-rdb-seed 0 fn2-fields fn2-digests))
      ((mv encoded end fn2-pool) (fn2-rec-budget-words-encode 0 slot gen 0 1 0 1 fn2-fields fn2-pool))
      (whole (and (eq reserved :ok) (eq encoded :ok) (= end 32)
                  (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)
                  (fn2-poolp fn2-pool) (fn2-pool-semanticp fn2-pool)
                  (fn2-digestsp fn2-digests) (fn2-digest-rowp 0 fn2-digests)
                  (fn2-rec-fetch-state-p 0 0)
                  (eq (fn2-layout-range-code slot gen 0 32 nil 1 0 1 fn2-pool) :ok)))
      (before (fn2-digests-copy fn2-digests)) (source (fn2-pool-copy fn2-pool))
      ((mv zero zn za fn2-digests) (fn2-rec-fetch-step 0 0 0 0 slot gen 0 1 0 1 fn2-pool fn2-digests))
      (zero-same (and (eq zero :more) (= zn 0) (= za 0) (equal before (fn2-digests-copy fn2-digests))))
      ((mv wrong wn wa fn2-digests) (fn2-rec-fetch-step 1 0 0 0 slot gen 0 1 0 2 fn2-pool fn2-digests))
      (wrong-same (and (eq wrong :owner) (= wn 0) (= wa 0) (equal before (fn2-digests-copy fn2-digests))))
      ((mv stale sn sa fn2-digests) (fn2-rec-fetch-step 1 0 0 0 slot (+ 1 gen) 0 1 0 2 fn2-pool fn2-digests))
      (stale-same (and (eq stale :stale) (= sn 0) (= sa 0) (equal before (fn2-digests-copy fn2-digests))))
      ((mv incremental fn2-digests) (fn2-rdb-drive 32 0 0 slot gen fn2-fields fn2-pool fn2-digests))
      ((mv full fn2-fields fn2-digests) (fn2-rdb-full 0 slot gen fn2-fields fn2-pool fn2-digests))
      ((mv fn2-fields fn2-digests) (fn2-rdb-seed 0 fn2-fields fn2-digests))
      (done-before (fn2-digests-copy fn2-digests))
      ((mv done fn2-digests) (fn2-rec-fetch 8 0 slot gen 0 1 0 2 fn2-pool fn2-digests))
      (done-same (and (eq done :ok) (equal done-before (fn2-digests-copy fn2-digests))))
      (source-same (equal source (fn2-pool-copy fn2-pool)))
      (fn2-pool (fn2-pool-set-fill slot 10 fn2-pool))
      ((mv short fn2-digests) (fn2-rec-fetch 0 0 slot gen 0 1 0 1 fn2-pool fn2-digests))
      (short-same (and (eq short :bounds) (fn2-rdb-words 0 0 2 fn2-fields fn2-digests))))
  (mv (list whole zero-same wrong-same stale-same incremental full done-same source-same short-same)
      fn2-fields fn2-pool fn2-digests)))
(defun fn2-rdb-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (answer fn2-fields)
   (with-local-stobj fn2-pool
    (mv-let (answer fn2-fields fn2-pool)
     (with-local-stobj fn2-digests
      (mv-let (answer fn2-fields fn2-pool fn2-digests) (fn2-rdb-case fn2-fields fn2-pool fn2-digests)
       (mv answer fn2-fields fn2-pool))) (mv answer fn2-fields))) answer)))
(assert-event (equal (fn2-rdb-test) '(t t t t t t t t t)))

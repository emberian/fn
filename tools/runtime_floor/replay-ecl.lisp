(defvar *fasl* (ext:getenv "RF_FASL"))
(defvar *trace* (ext:getenv "RF_TRACE"))
(defvar *here* (ext:getenv "RF_HERE"))
(load (concatenate 'string *here* "out/00-packages.lisp"))
(dolist (f '("shim" "01-globals" "01-stobjs-in" "01-ftypes" "01-inline")) (load (concatenate 'string *fasl* f ".fas")))
(dolist (p (sort (mapcar #'namestring (directory (concatenate 'string *fasl* "02-defs-*.fas"))) #'string<)) (load p))
(dolist (f '("03-stobjs" "shim-post")) (load (concatenate 'string *fasl* f ".fas")))
(load (compile-file (concatenate 'string *here* "serial.lisp") :output-file (concatenate 'string *fasl* "serial.fas")))
(load (compile-file (concatenate 'string *here* "replay.lisp") :output-file (concatenate 'string *fasl* "replay.fas")))
(load (compile-file (concatenate 'string *here* "host-port.lisp") :output-file (concatenate 'string *fasl* "host-port.fas")))
(si:gc t)
(format t "~&RP-LOADED rss-kib ~a~%" (acl2::rp-rss-kib))
(if (equal *trace* "BENCH") (load (concatenate (quote string) *here* "bench.lisp")) (acl2::rp-replay *trace*))
(si:gc t)
(format t "~&RP-END rss-kib ~a~%" (acl2::rp-rss-kib))
(ext:quit 0)

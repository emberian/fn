;;; Build the export on ECL (C code generation through the configured C
;;; compiler, clang here): compile every file to an object and a loadable
;;; .fas, load it.  RF_OUT: the export; RF_FASL: the output directory.
(setq *compile-verbose* nil *compile-print* nil)
;; ACL2's own policy (acl2.lisp *acl2-optimize-form*): what ACL2 compiles fn's raw code with
(proclaim '(optimize (compilation-speed 0) (speed 3) (space 1) (safety 0)))
(defvar *dir* (ext:getenv "RF_OUT"))
(defvar *out* (ext:getenv "RF_FASL"))
(ensure-directories-exist *out*)
(defun f (name) (concatenate 'string *dir* name))
(defvar *objects* nil)
(defun build (src)
  (let* ((name (pathname-name src))
         (fas (concatenate 'string *out* name ".fas"))
         (obj (concatenate 'string *out* name ".o")))
    (compile-file src :output-file fas :external-format :latin-1)
    (compile-file src :output-file obj :system-p t :external-format :latin-1)
    (push obj *objects*)
    (load fas)))
(load (f "00-packages.lisp"))
(with-compilation-unit ()
  (build (f "shim.lisp"))
  (build (f "01-globals.lisp"))
  (build (f "01-stobjs-in.lisp"))
  (build (f "01-ftypes.lisp"))
  (build (f "01-inline.lisp"))
  (dolist (p (sort (mapcar #'namestring (directory (f "02-defs-*.lisp"))) #'string<)) (build p))
  (build (f "03-stobjs.lisp"))
  (build (f "shim-post.lisp")))
(format t "~&RFE loaded ~d objects~%" (length *objects*))
(with-open-file (o (concatenate 'string *out* "objects.txt") :direction :output :if-exists :supersede)
  (dolist (x (reverse *objects*)) (write-line x o)))

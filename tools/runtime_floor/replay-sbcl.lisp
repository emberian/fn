;;; Load the export's fasls into bare SBCL and replay a trace.
(defvar *fasl* (sb-ext:posix-getenv "RF_FASL"))
(defvar *trace* (sb-ext:posix-getenv "RF_TRACE"))
(defvar *here* (sb-ext:posix-getenv "RF_HERE"))
(load (concatenate 'string *here* "out/00-packages.lisp"))
(dolist (f '("shim" "01-globals" "01-stobjs-in" "01-ftypes" "01-inline")) (load (concatenate 'string *fasl* f ".fasl")))
(dolist (p (sort (mapcar #'namestring (directory (concatenate 'string *fasl* "02-defs-*.fasl"))) #'string<)) (load p))
(dolist (f '("03-stobjs" "shim-post")) (load (concatenate 'string *fasl* f ".fasl")))
(load (concatenate 'string *here* "serial.lisp"))
(load (concatenate 'string *here* "replay.lisp"))
(load (concatenate 'string *here* "host-port.lisp"))
(sb-ext:gc :full t)
(format t "~&RP-LOADED rss-kib ~a dynamic-usage ~,1f MiB~%" (acl2::rp-rss-kib) (/ (sb-kernel:dynamic-usage) 1048576.0))
(if (equal *trace* "BENCH") (load (concatenate (quote string) *here* "bench.lisp")) (acl2::rp-replay *trace*))
(sb-ext:gc :full t)
(format t "~&RP-END rss-kib ~a dynamic-usage ~,1f MiB~%" (acl2::rp-rss-kib) (/ (sb-kernel:dynamic-usage) 1048576.0))

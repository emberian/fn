; REPL benchmark: load books/blake3 first; 20,000 compressions of bytes 0..63.
; The fixed input is passed as an argument so the compiler cannot fold it.
; 20000 * 64 / seconds / 2^20 gives MiB/s; allocated bytes / 20000 gives B/call.
(in-package "ACL2")
(defun fn-b3-bench (n cv words last)
  (declare (xargs :guard (natp n)))
  (if (zp n) last
    (fn-b3-bench (- n 1) cv words (fn-b3-compress cv words 0 64 0))))

(comp t)

; Warm the CPU before the five short samples.
(fn-b3-bench 2000000 (quote (1779033703 3144134277 1013904242 2773480762 1359893119 2600822924 528734635 1541459225)) (quote (50462976 117835012 185207048 252579084 319951120 387323156 454695192 522067228 589439264 656811300 724183336 791555372 858927408 926299444 993671480 1061043516)) nil)


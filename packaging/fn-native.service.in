# fn: the systemd unit a release carries (share/fn/systemd/fn.service.in).
# install.sh renders @PREFIX@ (the installation, /opt/fn: its releases under
# releases/, the running one reached through the `current` link), @NODE@
# (the node directory: fn.toml, store/, tls/, log/; /var/lib/fn) and @USER@
# (the service account, fn) and installs it as /etc/systemd/system/fn.service.
# ExecStart goes through @PREFIX@/current, so `install.sh --upgrade` and
# `--rollback` switch releases by moving that link, never by editing this
# unit (they render it again from the release that becomes current).
# `run` holds the store's exclusive writer lock for its lifetime; SIGTERM is
# the clean shutdown.
[Unit]
Description=fn native news node
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@NODE@
# ProtectHome=yes hides /home: a service account whose home is under /home
# made the image's ACL2 startup halt ("ACL2 Halted", nothing else; hbox-node
# finding H1, planning/evidence/hbox-node-2026-09-28.md).  HOME is the node
# directory, which the unit can read.
Environment=HOME=@NODE@
ExecStart=@PREFIX@/current/bin/fn operator @NODE@/fn.toml run
Restart=on-failure
RestartSec=5
# CONTAINMENT, not the fix (RL-01, 2026-10-04): exit 3 is the storage fence
# (an ambiguous Store or log barrier: the store needs recovery).  After a
# failed barrier Linux may keep the unwritten pages readable in its cache,
# and the open that a restart runs would read them as history; until the
# open's recovery is qualified for that case, systemd does not restart a
# fenced node.  The operator checks the disk (`health': last-stop exit=3),
# then starts it (docs/operator.md, "uncertain").
RestartPreventExitStatus=3
KillSignal=SIGTERM
TimeoutStopSec=120
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=@NODE@
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

[Unit]
Description=fn native news node
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=fn
Group=fn
ExecStart=@PREFIX@/bin/fn operator /etc/fn/fn.toml run
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=120
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/fn /var/log/fn /run/fn
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

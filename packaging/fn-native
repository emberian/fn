#!/bin/sh
# Direct entry to the production saved native host image.
#
# This intentionally does not parse configuration or command options.  The
# native image owns its positional protocol and outcome code; this wrapper
# only finds the image and replaces itself with it.  `bin/fn` remains the
# development CLI until the migration plan's full command matrix lands.
# The default image does not expose the raw owner/reader service diagnostics;
# tests that need those build the explicit `developer` image profile.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${FN_NATIVE_HOST:-}" ]; then
    image=$FN_NATIVE_HOST
elif [ -x "$here/../libexec/fn/fn-host" ]; then
    image=$here/../libexec/fn/fn-host
else
    root=$(CDPATH= cd -- "$here/.." && pwd)
    image=$root/build/fn-host
fi

if [ ! -x "$image" ]; then
    echo "fn-native: native host image missing: $image (run tools/build_native_host.sh)" >&2
    exit 4
fi
if [ ! -s "$image.core" ]; then
    echo "fn-native: native host core missing: $image.core" >&2
    exit 4
fi

# A saved ACL2 image must not inherit a user's customization/system-book
# selection.  This matches tools/build_native_host.sh and does not interpret
# any operator-supplied value.
ACL2_CUSTOMIZATION=NONE
export ACL2_CUSTOMIZATION
unset ACL2_SYSTEM_BOOKS
exec "$image" --fn "$@"

# fn configuration.  `fn init` writes this file; every subcommand reads it
# (default ./fn.toml, or --config <path>).  See docs/operator.md.

[store]
# The store root.  It holds the journal, the writer lock, the configuration
# records that name the served groups, and the freshness anchor.  The served
# groups are NOT listed here: they are durable configuration records that
# ACL2 replays, changed with `fn group create` and `fn group retire`.
path = "/var/lib/fn/store"

[listener]
# One numeric IPv4 address, or `localhost`/`::1`.  Names are never resolved
# and the wildcard 0.0.0.0 is refused (books/native-config.lisp,
# fn-native-config-listener-hostp), so the node binds exactly the address it
# is given.  Off loopback, set [auth] required and protected_only below and a
# TLS pair here: USER/PASS crosses in the clear otherwise.
host = "127.0.0.1"
port = 1119
# tls_cert = "/etc/fn/tls/cert.pem"
# tls_key = "/etc/fn/tls/key.pem"

[auth]
# RFC 4643 AUTHINFO.  Omit the whole table and the node requires no login,
# which is what `fn init` writes unless you pass --auth-required.
#
#   required        a connection must authenticate before a command that
#                   changes durable state or discloses article content
#                   (POST, GROUP, ARTICLE, LIST, OVER, HDR, IHAVE, ...).
#                   CAPABILITIES, HELP, QUIT, MODE, DATE, AUTHINFO and
#                   STARTTLS never need one, so a client can still discover
#                   the server and still log in.
#   protected_only  RFC 4643 section 2.3.2: AUTHINFO answers 483 until a TLS
#                   layer is active.  Set it whenever the node is reachable
#                   off the box, because USER/PASS crosses in the clear.
#   path            the credential file `fn principal set-password` writes.
#                   Default <store>/auth.toml, mode 0600.  It holds salted
#                   verifiers (books/auth-secret.lisp), never secrets.
#
# The policy reaches EVERY connection the owner opens, including one it
# resolved to a peer record by source address.
required = false
protected_only = false
# path = "/var/lib/fn/auth.toml"

[posting]
enabled = true
# The injecting agent this node names for locally accepted articles.  It is
# recorded in the operator log today; the durable injection record is the
# store's, not this file's.
agent = "fn-operator@localhost"

[anchor]
# A name from tools/roughtime_servers.json, used by `fn anchor` and by the
# freshness check inside `fn recover`.  Omit the table to skip live queries.
server = "int08h"

[acl2]
# The ACL2 executable (exported as FN_ACL2) and the machine-wide cap on
# concurrent ACL2 processes (FN_ACL2_SLOTS, tools/acl2_slots.py).
path = "acl2"
slots = 4

[log]
# One line per post and per accepted connection, outcome word first; the
# connection lines say the ROLE the owner gave the connection at accept,
# `reader` or `peer <name>`.  Remove
# this table to log to stderr, which under systemd is the journal.
path = "/var/log/fn/fn.log"

[control]
# The owner's Unix control socket.  Defaults to <store>/control.sock.
path = "/var/lib/fn/store/control.sock"

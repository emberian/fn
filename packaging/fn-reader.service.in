# fn-reader: the friends' web reader of an fn release, beside the node
# (clients/share/systemd/fn-reader.service.in).  `install.sh --reader'
# renders @PREFIX@ (the release, /opt/fn), @STATE@ (the reader's own folder,
# /var/lib/fn-reader), @NODE@ (the node folder, /var/lib/fn) and @RUSER@ (the
# reader's own account, fn-reader) into /etc/systemd/system/fn-reader.service.
#
# The reader is a client of the node, like a newsreader: it reaches the node
# over NNTP with each friend's own login, and nothing else.  It runs as its
# own account, and the node folder (the store, its control socket, the
# logins, the node's keys) is made inaccessible to it here as well as by the
# folder's owner and mode.  It listens on 127.0.0.1 only; Caddy (or another
# HTTPS proxy on this machine) faces the browsers (clients/share/caddy/).
[Unit]
Description=fn friends' web reader
After=network-online.target fn.service
Wants=network-online.target

[Service]
Type=simple
User=@RUSER@
Group=@RUSER@
WorkingDirectory=@STATE@
ExecStart=@PREFIX@/clients/bin/fn-reader --settings @STATE@/reader.conf
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=@STATE@
InaccessiblePaths=-@NODE@

[Install]
WantedBy=multi-user.target

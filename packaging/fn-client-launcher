#!/bin/sh
# A client program of an fn release (clients/bin/NAME), started with Python 3.
# Installed by packaging/install-clients.sh as clients/bin/fn-reader,
# fn-web, fn-client, fn-agent, fn-consumer and fn-verify; NAME picks
# clients/lib/NAME.py with `-' read as `_' (fn-reader -> fn_reader.py).
#
# These are clients of the node, like a newsreader: the node never runs
# them, and nothing on its path (bin/fn, libexec/fn/, its service) names
# this directory (tools/runpath_check.py's clients rule).  They need Python
# 3.9 or newer and nothing else (fn-verify's signature checks also want
# pyca/cryptography); clients/README.txt says so.
set -eu
self=$0
if [ -L "$self" ] && resolved=$(readlink -f -- "$self" 2>/dev/null); then self=$resolved; fi
here=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
lib=$(CDPATH= cd -- "$here/../lib" && pwd)
name=$(basename -- "$self")
tool=$(printf '%s' "$name" | tr '-' '_')
[ -r "$lib/$tool.py" ] || { echo "fn clients: no client named $name" >&2; exit 2; }
command -v python3 >/dev/null 2>&1 || {
  echo "$name needs Python 3.9 or newer: apt install python3 (Debian), pkg_add python3 (OpenBSD)" >&2
  exit 2; }
exec python3 "$lib/$tool.py" "$@"

# The friends' web reader's settings (`fn-reader --settings FILE`).
# One `name = value` per line; a line starting with # is a note.
# After a change: systemctl restart fn-reader (OpenBSD: rcctl restart fn_reader).

# Your node, as its certificate names it, and a port it listens on:
# its TLS port (563, or the tls_port in fn.toml) or its plain port
# (119, or the port in fn.toml; the reader then switches to TLS itself).
node = news.example.org:563

# How the reader checks that it is talking to your node.
# A certificate you made yourself: a copy of the node's tls/cert.pem here
# (the reader cannot read the node's folder).
tls-cert = @STATE@/node-cert.pem
# A public certificate (Let's Encrypt) instead: remove the tls-cert line
# above and remove the # below.
# system-ca = yes

# The name your friends see at the top of every page.
site = Our news

# The web side.  The reader listens here, on this machine only; Caddy
# answers the browsers over HTTPS and passes them on.
listen = 127.0.0.1:8920
proxied = yes

# Where the reader keeps what each friend has read and sent.
state = @STATE@

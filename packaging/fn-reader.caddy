# Caddy in front of the friends' web reader (clients/share/caddy/fn-reader.caddy).
# Put this block in /etc/caddy/Caddyfile, with the web name your friends
# will type instead of news.example.org, then: systemctl reload caddy.
# Caddy gets the HTTPS certificate for that name by itself (the name must
# point at this machine, and ports 80 and 443 must reach it).  Caddy keeps
# the Host header and sets X-Forwarded-For, which the reader (proxied = yes)
# reads as the browser's address.
news.example.org {
	reverse_proxy 127.0.0.1:8920
}

.DS_Store
__pycache__/
*.py[cod]
.venv/
.cache/
build/
var/
*.cert
*.port
*.fasl
# Certification run manifests are archived here by tools/evidence_manifests.py
# on every run; the ones a committed claim CITES are tracked with `git add -f`
# (`evidence_manifests.py add RUN-ID`, or `sync --add`).  Ignoring the rest keeps
# an exploratory run out of the history and keeps `git status` readable in a
# lane worktree: a manifest is up to 2.4 MB and every run files one (the
# reasoning is in tools/evidence_manifests.py's docstring).
planning/evidence/manifests/*.json

# Lane scratch (BRIEF-COMMON: never committed)
/LANEDUMP.md

# The evidence index writers' flock (tools/evidence_store.py index_lock_path)
/planning/evidence-index.tsv.lock
/planning/evidence/

; One raw-Lisp evidence entry point over the admitted SQ-SQUARES table.
; It invokes each declared adapter; it never promotes :PROOF after a check.
(in-package "ACL2")
(defvar *sq-runtime-rows* nil)
(defvar *sq-coverage* nil)
(defvar *sq-revision* nil)

(defun sq-row-for-case (owner case)
  (cdr (find-if (lambda (entry)
                 (and (equal (getf (cdr entry) :owner)
                             (list :correspondence owner))
                      (equal (getf (cdr entry) :case) case)))
               *sq-runtime-rows*)))

(defun sq-scope-record (row scope)
  (append
   (list :contract (list (getf row :owner) (getf row :template)
                         (getf row :statement) (getf row :contract))
         :revision (or (getf scope :revision) *sq-revision*)
         :profile (getf scope :profile) :domain (getf scope :domain)
         :horizon (getf scope :horizon) :unit (getf scope :unit)
         :location (getf scope :location)
         :reached 0 :exercised 0 :verdict :unexercised)
   (when (getf scope :campaign) (list :campaign (getf scope :campaign)))))

(defun sq-same-scope-p (a b)
  (every (lambda (key) (equal (getf a key) (getf b key)))
         '(:contract :revision :profile :domain :horizon :unit :location :campaign)))

(defun sq-record-for-scope (row scope)
  (let* ((entry (assoc (getf row :id) *sq-runtime-rows*))
         (record (sq-scope-record row scope))
         (old (find record (getf (cdr entry) :checks) :test #'sq-same-scope-p)))
    (unless entry (error "No admitted square row: ~S" (getf row :id)))
    (or old
        (progn
          (setf (getf (cdr entry) :checks)
                (append (getf (cdr entry) :checks) (list record)))
          record))))

(defun sq-begin-scope (owner scope)
  (dolist (entry *sq-runtime-rows*)
    (let ((row (cdr entry)))
      (when (and (equal (getf row :owner) (list :correspondence owner))
                 (getf row :checker))
        (sq-record-for-scope row scope)))))

(defun sq-check-row (row sample scope)
  (let* ((checker (getf (getf row :checker) :function))
         (before-proof (copy-tree (getf row :proof)))
         (record (sq-record-for-scope row scope)))
    (unless (and checker (fboundp checker))
      (error "Unimplemented checker ~S for ~S" checker (getf row :id)))
    (let* ((result (funcall checker row sample))
           (reached (getf result :reached))
           (exercised (getf result :exercised))
           (verdict (getf result :verdict)))
      (unless (and (integerp reached) (integerp exercised)
                   (<= 0 exercised reached)
                   (member verdict '(:pass :fail :unexercised))
                   (eq (zerop exercised) (eq verdict :unexercised)))
        (error "Invalid checker result ~S for ~S" result (getf row :id)))
      (incf (getf record :reached) reached)
      (incf (getf record :exercised) exercised)
      (setf (getf record :verdict)
            (cond ((or (eq (getf record :verdict) :fail) (eq verdict :fail)) :fail)
                  ((plusp (getf record :exercised)) :pass)
                  (t :unexercised)))
      (unless (equal before-proof (getf row :proof))
        (error "A checker changed proof status: ~S" (getf row :id)))
      result)))

(defun sq-run-declared-evidence ()
  (let ((providers nil))
    (dolist (entry *sq-runtime-rows*)
      (let ((row (cdr entry)))
        (dolist (sample (getf row :evidence))
          (if (getf sample :provider)
              (pushnew sample providers :test #'equal)
            (let ((scope (copy-tree (getf sample :scope))))
              (setf (getf scope :revision) *sq-revision*)
              (sq-check-row row sample scope))))))
    ; Streams arrange calls to the same sq-check-row entry point while their
    ; mutable input exists. A shared provider is run once, not once per row.
    (dolist (descriptor (reverse providers))
      (funcall (getf descriptor :provider) descriptor *sq-revision*))))

(defun sq-teeth-status (row)
  (loop for role in '(:positive :negative)
        for name = (getf (getf row :teeth) role)
        collect (list role name
                      (if (and name (fboundp name))
                          (if (eq (funcall name) t) :pass :fail)
                          :unimplemented))))

(defun sq-write-object (path value)
  (with-open-file (stream path :direction :output :if-exists :supersede)
    (let ((*print-readably* t) (*print-pretty* nil)
          (*print-length* nil) (*print-level* nil))
      (write value :stream stream) (terpri stream))))

(defun sq-write-evidence-events (path)
  (with-open-file (stream path :direction :output :if-exists :supersede)
    (let ((*print-readably* t) (*print-pretty* nil)
          (*print-length* nil) (*print-level* nil))
      (write '(in-package "ACL2") :stream stream) (terpri stream)
      (dolist (entry *sq-runtime-rows*)
        (when (getf (cdr entry) :checks)
          (write (list 'sq-append-evidence (car entry)
                       (getf (cdr entry) :checks)) :stream stream)
          (terpri stream))))))

(defun sq-report ()
  (let ((failed nil) (*print-pretty* nil))
    (dolist (entry *sq-coverage*)
      (format t "SQ COVERAGE owner=~S unmatched=~S unresolved-requires=~S~%"
              (car entry) (getf (cdr entry) :unmatched)
              (getf (cdr entry) :unresolved-requires)))
    (dolist (entry *sq-runtime-rows*)
      (let* ((row (cdr entry)) (checks (getf row :checks))
             (exercised (loop for check in checks sum (getf check :exercised)))
             (verdict (cond ((find :fail checks :key (lambda (x) (getf x :verdict))) :fail)
                            ((plusp exercised) :pass) (t :unexercised)))
             (teeth (sq-teeth-status row)))
        (when (or (eq verdict :fail) (find :fail teeth :key #'third))
          (setf failed t))
        (format t "SQ ROW ~S case=~S proof=~S exercised=~D verdict=~S teeth=~S~%"
                (car entry) (getf row :case) (getf row :proof) exercised verdict teeth)))
    (not failed)))

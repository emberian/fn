; E1 explicit environment seam. Test-side logic, not a served implementation.
(in-package "ACL2")
(include-book "../../sim/echo")

(defconst *fn2-e1-faults* '(26 0 1 2 3 14 25))
(defconst *fn2-e1-words* '(0 1))

; Identity includes the pending result cell and retained terminal payload.
; Word is the explicit physical transfer/accept payload selector, not a seed.
(defun fn2-e1-occurrence (slot fault word fn2-sim)
  (declare (xargs :stobjs fn2-sim :verify-guards nil))
  (list :land slot (fn2-sim-gen slot fn2-sim)
        (fn2-sim-active slot fn2-sim) (fn2-sim-kind slot fn2-sim)
        (fn2-sim-cap-index slot fn2-sim) (fn2-sim-cap-nonce slot fn2-sim)
        fault word
        (list (fn2-sim-range-slot slot fn2-sim) (fn2-sim-range-gen slot fn2-sim)
              (fn2-sim-range-off slot fn2-sim) (fn2-sim-range-len slot fn2-sim))
        (list (fn2-sim-terminal-outcome slot fn2-sim)
              (fn2-sim-terminal-reason slot fn2-sim)
              (fn2-sim-terminal-count slot fn2-sim)
              (fn2-sim-terminal-aux0 slot fn2-sim)
              (fn2-sim-terminal-aux1 slot fn2-sim))))

(defun fn2-e1-enabledp (choice fn2-sim)
  (declare (xargs :stobjs fn2-sim :verify-guards nil))
  (let ((slot (nth 1 choice)))
    (and (true-listp choice) (equal (len choice) 11)
         (natp slot) (< slot (fn2-sim-rows fn2-sim))
         (member-equal (fn2-sim-active slot fn2-sim) '(1 2 3))
         (member-equal (nth 7 choice) *fn2-e1-faults*)
         (member-equal (nth 8 choice) *fn2-e1-words*)
         (equal choice (fn2-e1-occurrence slot (nth 7 choice) (nth 8 choice) fn2-sim)))))

; This is echo.lisp's selected tail: no PRNG draws and no hidden client drain.
; Wake interception remains explicit in the returned boundary tag.
(defun fn2-e1-land (choice fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* (((unless (fn2-e1-enabledp choice fn2-sim))
        (mv :rejected fn2-core fn2-sim fn2-own))
       (slot (nth 1 choice)) (fault (nth 7 choice)) (word (nth 8 choice))
       (wake (fn2-sim-wake-first-p t slot fn2-sim))
       (target (if wake (fn2-sim-wake-deadline fn2-sim) (fn2-sim-due slot fn2-sim)))
       (fn2-sim (fn2-sim-clock target fault fn2-sim))
       (fn2-core (fn2-sim-post-clock (fn2-sim-now fn2-sim) (fn2-sim-real fn2-sim) fn2-core))
       ((when wake)
        (let ((fn2-sim (update-fn2-sim-wake-pending 0 fn2-sim)))
          (mv :wake fn2-core fn2-sim fn2-own)))
       (fn2-sim (fn2-sim-environment slot fault word fn2-sim))
       ((when (member-equal fault '(2 14)))
        (let ((fn2-sim (fn2-sim-delay-flight slot fault word fn2-sim)))
          (mv :delay fn2-core fn2-sim fn2-own)))
       ((mv & fn2-core fn2-sim fn2-own)
        (if (and (equal (fn2-sim-active slot fn2-sim) 1)
                 (equal (fn2-sim-kind slot fn2-sim) *fn2-action-accept*))
            (fn2-sim-echo-accept slot fault word t fn2-core fn2-sim fn2-own)
          (fn2-sim-complete slot fault word fn2-core fn2-sim fn2-own))))
    (mv :land fn2-core fn2-sim fn2-own)))
(in-theory (disable fn2-e1-occurrence fn2-e1-enabledp fn2-e1-land))

; Registration's only random effect besides PRNG state is initial due time.
; Replace that effect and restore all four PRNG words: handoff has an explicit
; 1/2-tick latency and consumes no random input. The operation stays A's.
(defun fn2-e1-take (word fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* ((s0 (fn2-sim-s0 fn2-sim)) (s1 (fn2-sim-s1 fn2-sim))
       (s2 (fn2-sim-s2 fn2-sim)) (s3 (fn2-sim-s3 fn2-sim))
       ((mv code slot gen)
        (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (code slot gen)
          (fn2-outbox-peek 0 fn2-ops) (mv code slot gen)))
       (- gen)
       ((mv found fn2-core fn2-sim fn2-own) (fn2-sim-take-one fn2-core fn2-sim fn2-own))
       (fn2-sim (update-fn2-sim-s0 s0 fn2-sim))
       (fn2-sim (update-fn2-sim-s1 s1 fn2-sim))
       (fn2-sim (update-fn2-sim-s2 s2 fn2-sim))
       (fn2-sim (update-fn2-sim-s3 s3 fn2-sim))
       (fn2-sim (if (and found (eq code :ok) (natp slot) (< slot (fn2-sim-rows fn2-sim)))
                    (fn2-sim-set-due slot (min #xfffffffffffffff (+ (fn2-sim-now fn2-sim) 1 (mod (nfix word) 2))) fn2-sim)
                  fn2-sim)))
    (mv found fn2-core fn2-sim fn2-own)))
(in-theory (disable fn2-e1-take))

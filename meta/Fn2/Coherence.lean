@[expose] public section

/-!
# Fn2.Coherence: the coherence theorem for a toy frame

COHERENCE §3: under its hypotheses, every diagram generated from G0, G1 and G2 preserves the
declared observations. This file states and proves that schema for a frame of partial
deterministic transitions, then instantiates it on COHERENCE's toy: **one domain, scalar
positions, and an independence relation declared through footprints** (COHERENCE §2.1 G2, UC
§1.2).

The statements, in order:

* `trace_run` (horizontal pasting, Godefroid's Theorem 3.10): if every declared-independent pair
  has equal two-step partial runs (`Diamonds`), trace-equivalent words have the same run.
* `coherence` (the generated-diagram theorem schema, COHERENCE §3.2, for one representation edge):
  from a G0-related pair, G1 squares for every label and implementation diamonds transport every
  successful implementation run along `w` to a successful reference run along the interpretation
  of any trace-equivalent `w'`, with equal observations. "If the generators commute then every
  route agrees", for routes connected by declared swaps; it does not assert that schedules complete.
* `footprint_diamonds`, `footprint_enabled`, `footprint_independent` (HI from declarations): in the
  toy, actions that respect their declared read and write footprints commute, and neither enables
  nor disables the other, whenever the footprints are disjoint (Godefroid's Definition 3.1 in full,
  `IndependentDiamonds`). The G2 instances are derived from the declaration.

Witnesses, statement-first (ATLAS §6 law 2):

* satisfiable: `twoRecv` (two echo connections each counting received bytes) and its correspondence
  to one running total (`sumCorr`); `twoRecv_coherence_witness` inhabits the whole premise package
  at one state with its conclusion; `twoRecv_coherent` instantiates `coherence`.
* teeth for G2: Astra's accept/close false diamond (COHERENCE §2.4). Declared independent because
  they belong to different machines, the diamond is false (`acceptClose_not_diamond`), and
  `acceptClose_without_g2` packages every other hypothesis of `coherence` (a correspondence with its
  G1 squares and edge, a related start, trace equivalence, a successful run) with the failure of its
  conclusion. The footprint declaration refuses the pair (`acceptClose_footprint_dependent`), both
  actions keeping their own footprints (`accept_respects`, `close_respects`).
* teeth for `Respects`: `liar` declares empty footprints and writes anyway; the footprints are
  independent (`liar_indep`), the frame condition fails (`liar_not_respects`), the diamond fails
  (`liar_not_diamond`).
* teeth for the catalogue form: a case missing from the catalogue is not covered
  (`uncovered_case_fails`).
* two-sided mixed-pasting schema HM (`mixed_pasting_hm`, `mixed_pasting_hm_obs`): when adjacent
  `I_A`-swaps map under `C.interp` to `TraceEq I_B`-equivalent reference words and `Diamonds B I_B`
  holds, implementation runs transport across both `TraceEq I_A` and `TraceEq I_B` with equal
  observations (`hm_witness_satisfiable`, and hypothesis-removal tooth
  `hm_without_ref_diamonds_fails`).
* Mazurkiewicz projections and toy completeness (`traceEq_perm`, `traceEq_count`,
  `traceEq_filter_dependent`, `traceEq_iff_filter_eq`, `twoRecv_traceEq_iff_projections`,
  `twoRecv_traceEq_iff_counts`, and negative teeth `dependent_swap_not_traceEq`,
  `acceptClose_not_traceEq`).
-/

namespace Fn2.Coherence

open Fn2.Square

universe u

/-- A frame: states, labels, and a partial deterministic step per label. -/
structure Frame where
  State : Type u
  Label : Type u
  step : Label → Loose State State

/-- Trace equivalence: the equivalence generated by adjacent swaps of declared-independent
labels (COHERENCE §3.1, `σ ~I τ`). -/
inductive TraceEq {L : Type u} (I : L → L → Prop) : List L → List L → Prop
  | refl (w : List L) : TraceEq I w w
  | swap (p q : List L) (t v : L) : I t v → TraceEq I (p ++ t :: v :: q) (p ++ v :: t :: q)
  | symm {w w' : List L} : TraceEq I w w' → TraceEq I w' w
  | trans {w₁ w₂ w₃ : List L} : TraceEq I w₁ w₂ → TraceEq I w₂ w₃ → TraceEq I w₁ w₃

/-- G2 as `trace_run` needs it: every declared pair has equal two-step partial runs from every
state, including agreement on failure of the composite run. This does **not** say that neither
enables nor disables the other (two labels that each disable the other satisfy it vacuously;
Astra, `lean-meta-astra-2.md` finding 2); `IndependentDiamonds` adds that. -/
def Diamonds (F : Frame.{u}) (I : F.Label → F.Label → Prop) : Prop :=
  ∀ t v, I t v → ∀ s, run F.step [t, v] s = run F.step [v, t] s

/-- A label is enabled at a state. -/
def Enabled (F : Frame.{u}) (t : F.Label) (s : F.State) : Prop :=
  ∃ s', F.step t s = some s'

/-- G2 with Godefroid's Definition 3.1 in full: the diamond, and each declared-independent label
neither enables nor disables the other. -/
def IndependentDiamonds (F : Frame.{u}) (I : F.Label → F.Label → Prop) : Prop :=
  Diamonds F I ∧
  ∀ t v, I t v → ∀ s s', F.step t s = some s' → (Enabled F v s ↔ Enabled F v s')

/-- Horizontal pasting: valid diamonds make trace-equivalent words run alike. -/
theorem trace_run {F : Frame.{u}} {I : F.Label → F.Label → Prop} (hD : Diamonds F I)
    {w w' : List F.Label} (h : TraceEq I w w') : run F.step w = run F.step w' := by
  induction h with
  | refl w => rfl
  | swap p q t v hI =>
    have e1 : p ++ t :: v :: q = p ++ ([t, v] ++ q) := rfl
    have e2 : p ++ v :: t :: q = p ++ ([v, t] ++ q) := rfl
    have hd : run F.step [t, v] = run F.step [v, t] := funext (hD t v hI)
    rw [e1, e2, run_append, run_append, run_append, run_append, hd]
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- A representation edge `A → B` with an observation contract: G1 per label (with a stuttering
label interpretation) and the observation edge. -/
structure Correspondence (A B : Frame.{u}) (O : Type u) where
  R : Tight A.State B.State
  interp : A.Label → List B.Label
  obsA : A.State → O
  obsB : B.State → O
  step : ∀ t, Sq R (A.step t) (run B.step (interp t)) R
  edge : ∀ a b, R a b → obsA a = obsB b

/-- **The generated-diagram theorem, for one representation edge.** From a G0-related pair, G1
squares and implementation diamonds transport every successful implementation run along `w` to a
successful reference run along `expand C.interp w'`, whenever `w` and `w'` are trace-equivalent; the
observations are equal. It does not assert that arbitrary schedules complete. -/
theorem coherence {A B : Frame.{u}} {O : Type u} (C : Correspondence A B O)
    {I : A.Label → A.Label → Prop} (hD : Diamonds A I)
    {a : A.State} {b : B.State} (h0 : C.R a b)
    {w w' : List A.Label} (hw : TraceEq I w w') {a' : A.State}
    (hrun : run A.step w a = some a') :
    ∃ b', run B.step (expand C.interp w') b = some b' ∧ C.obsA a' = C.obsB b' := by
  have hrun' : run A.step w' a = some a' := by rw [← trace_run hD hw]; exact hrun
  obtain ⟨b', hb, hR⟩ := Sq.paste C.interp C.R C.step w' a b a' h0 hrun'
  exact ⟨b', hb, C.edge a' b' hR⟩

/-- Two schedules of one representation: the observation is a function of the trace. -/
theorem coherence_self {F : Frame.{u}} {O : Type u} (obs : F.State → O)
    {I : F.Label → F.Label → Prop} (hD : Diamonds F I) {w w' : List F.Label}
    (hw : TraceEq I w w') {s s₁ s₂ : F.State}
    (h₁ : run F.step w s = some s₁) (h₂ : run F.step w' s = some s₂) : obs s₁ = obs s₂ := by
  rw [trace_run hD hw, h₂] at h₁
  rw [Option.some.inj h₁]

/-! ## The toy frame: one domain, scalar positions, declared footprints -/

/-- An action on a domain of positions `P` holding values `V`, with its declared footprint. -/
structure Action (P V : Type u) where
  reads : P → Prop
  writes : P → Prop
  guard : (P → V) → Bool
  upd : (P → V) → (P → V)

/-- The action keeps its declaration: its enabledness and the values it writes depend only on
what it reads, and it changes nothing outside what it writes. -/
structure Action.Respects {P V : Type u} (α : Action P V) : Prop where
  guard_reads : ∀ s s', (∀ p, α.reads p → s p = s' p) → α.guard s = α.guard s'
  upd_reads : ∀ s s', (∀ p, α.reads p → s p = s' p) → ∀ q, α.writes q → α.upd s q = α.upd s' q
  frame : ∀ s q, ¬ α.writes q → α.upd s q = s q

def Action.step {P V : Type u} (α : Action P V) : Loose (P → V) (P → V) :=
  fun s => if α.guard s then some (α.upd s) else none

/-- Independence declared through footprints: neither writes what the other reads or writes. -/
def footIndep {P V : Type u} (α β : Action P V) : Prop :=
  ∀ p, ¬ (α.writes p ∧ (β.reads p ∨ β.writes p)) ∧ ¬ (β.writes p ∧ (α.reads p ∨ α.writes p))

abbrev toyFrame (P V L : Type u) (act : L → Action P V) : Frame.{u} where
  State := P → V
  Label := L
  step l := (act l).step

/-- HI from the declaration: footprint-respecting actions with disjoint footprints commute. -/
theorem footprint_diamonds {P V L : Type u} (act : L → Action P V)
    (hR : ∀ l, (act l).Respects) :
    Diamonds (toyFrame P V L act) (fun t v => footIndep (act t) (act v)) := by
  intro t v hI s
  have key : ∀ α β : Action P V, α.Respects → β.Respects → footIndep α β →
      (α.step s).bind β.step = (β.step s).bind α.step := by
    intro α β hα hβ hI
    have agreeβ : ∀ p, β.reads p → α.upd s p = s p := fun p hp =>
      hα.frame s p (fun hw => (hI p).1 ⟨hw, Or.inl hp⟩)
    have agreeα : ∀ p, α.reads p → β.upd s p = s p := fun p hp =>
      hβ.frame s p (fun hw => (hI p).2 ⟨hw, Or.inl hp⟩)
    have gβ : β.guard (α.upd s) = β.guard s := hβ.guard_reads _ _ agreeβ
    have gα : α.guard (β.upd s) = α.guard s := hα.guard_reads _ _ agreeα
    have comm : β.upd (α.upd s) = α.upd (β.upd s) := by
      funext q
      by_cases hb : β.writes q
      · have hna : ¬ α.writes q := fun ha => (hI q).2 ⟨hb, Or.inr ha⟩
        rw [hβ.upd_reads _ _ agreeβ q hb, hα.frame _ q hna]
      · rw [hβ.frame _ q hb]
        by_cases ha : α.writes q
        · rw [hα.upd_reads _ _ agreeα q ha]
        · rw [hα.frame _ q ha, hα.frame _ q ha, hβ.frame _ q hb]
    unfold Action.step
    cases hga : α.guard s <;> cases hgb : β.guard s <;> simp [hga, hgb, gα, gβ, comm]
  rw [run_pair, run_pair]
  exact key (act t) (act v) (hR t) (hR v) hI

theorem Action.step_enabled_iff {P V : Type u} (α : Action P V) (s : P → V) :
    (∃ s', α.step s = some s') ↔ α.guard s = true := by
  show (∃ s', (if α.guard s = true then some (α.upd s) else none) = some s') ↔ α.guard s = true
  cases _h : α.guard s <;> simp

/-- The enabledness half of HI from the declaration: a footprint-respecting action never enables
or disables one whose footprint is disjoint from its own. -/
theorem footprint_enabled {P V L : Type u} (act : L → Action P V) (hR : ∀ l, (act l).Respects) :
    ∀ t v, footIndep (act t) (act v) → ∀ s s', (act t).step s = some s' →
      ((∃ x, (act v).step s = some x) ↔ (∃ x, (act v).step s' = some x)) := by
  intro t v hI s s' hs
  have hg : (act t).upd s = s' := by
    have hs' : (if (act t).guard s = true then some ((act t).upd s) else none) = some s' := hs
    cases h : (act t).guard s
    · simp [h] at hs'
    · simpa [h] using hs'
  subst hg
  have agree : ∀ p, (act v).reads p → (act t).upd s p = s p := fun p hp =>
    (hR t).frame s p (fun hw => (hI p).1 ⟨hw, Or.inl hp⟩)
  rw [Action.step_enabled_iff, Action.step_enabled_iff, (hR v).guard_reads _ _ agree]

/-- HI in full, derived from the declaration. -/
theorem footprint_independent {P V L : Type u} (act : L → Action P V)
    (hR : ∀ l, (act l).Respects) :
    IndependentDiamonds (toyFrame P V L act) (fun t v => footIndep (act t) (act v)) :=
  ⟨footprint_diamonds act hR, fun t v hI s s' hs => footprint_enabled act hR t v hI s s' hs⟩

/-- Teeth for `Respects`: two always-enabled actions that declare empty footprints but write a
position. The footprints are independent, the actions do not keep them, and the diamond fails. -/
def liar (b : Bool) : Action Unit Nat where
  reads _ := False
  writes _ := False
  guard _ := true
  upd _ _ := if b then 1 else 0

theorem liar_indep (t v : Bool) : footIndep (liar t) (liar v) :=
  fun _ => ⟨fun h => h.1, fun h => h.1⟩

theorem liar_not_respects : ¬ (liar true).Respects := by
  intro h
  have e := h.frame (fun _ => 0) () id
  revert e
  decide

theorem liar_not_diamond :
    ¬ Diamonds (toyFrame Unit Nat Bool liar) (fun t v => footIndep (liar t) (liar v)) := by
  intro h
  have e := h true false (liar_indep true false) (fun _ => 0)
  have e' := congrArg (fun o => o.map fun s => s ()) e
  revert e'
  decide

/-! ### Satisfiable: two echo connections, each counting its received bytes -/

/-- The action that increments one position. -/
def Action.incr {P : Type} [DecidableEq P] (p : P) : Action P Nat where
  reads q := q = p
  writes q := q = p
  guard _ := true
  upd s q := if q = p then s p + 1 else s q

theorem Action.incr_respects {P : Type} [DecidableEq P] (p : P) : (Action.incr p).Respects where
  guard_reads _ _ _ := rfl
  upd_reads s s' h q hq := by
    have hq' : q = p := hq
    have hp : s p = s' p := h p rfl
    show (if q = p then s p + 1 else s q) = (if q = p then s' p + 1 else s' q)
    simp [hq', hp]
  frame s q hq := by
    have hq' : ¬ q = p := hq
    show (if q = p then s p + 1 else s q) = s q
    simp [hq']

theorem incr_indep {P : Type} [DecidableEq P] {a b : P} (hab : a ≠ b) :
    footIndep (Action.incr a) (Action.incr b) := by
  intro p
  refine ⟨fun ⟨h1, h2⟩ => ?_, fun ⟨h1, h2⟩ => ?_⟩
  · have h1' : p = a := h1
    have h2' : p = b := by rcases h2 with h | h <;> exact h
    exact hab (h1'.symm.trans h2')
  · have h1' : p = b := h1
    have h2' : p = a := by rcases h2 with h | h <;> exact h
    exact hab (h2'.symm.trans h1')

inductive Conn
  | c0 | c1
  deriving DecidableEq, Repr

/-- Two connections' receive counters; receiving on one is an increment of its counter. -/
abbrev twoRecv : Frame.{0} := toyFrame Conn Nat Conn Action.incr

theorem twoRecv_diamonds :
    Diamonds twoRecv (fun (t v : Conn) => footIndep (Action.incr t) (Action.incr v)) :=
  footprint_diamonds (P := Conn) (V := Nat) (L := Conn) Action.incr Action.incr_respects

/-- Premise inhabited with a non-trivial swap: two distinct words, one run. -/
theorem twoRecv_routes_agree :
    [Conn.c0, Conn.c1] ≠ [Conn.c1, Conn.c0] ∧
    run twoRecv.step [Conn.c0, Conn.c1] = run twoRecv.step [Conn.c1, Conn.c0] :=
  ⟨by decide, trace_run twoRecv_diamonds (TraceEq.swap [] [] Conn.c0 Conn.c1 (incr_indep (by decide)))⟩

/-- The reference: one running total. -/
abbrev total : Frame.{0} where
  State := Nat
  Label := Unit
  step _ n := some (n + 1)

/-- G1 and the edge: the sum of the two counters is the total. -/
def sumCorr : Correspondence twoRecv total Nat where
  R s n := s Conn.c0 + s Conn.c1 = n
  interp _ := [()]
  obsA s := s Conn.c0 + s Conn.c1
  obsB n := n
  step t := by
    intro s n s' hR hs
    have hR' : s Conn.c0 + s Conn.c1 = n := hR
    refine ⟨n + 1, rfl, ?_⟩
    show s' Conn.c0 + s' Conn.c1 = n + 1
    cases t with
    | c0 =>
      have h : some ((Action.incr Conn.c0).upd s) = some s' := hs
      have e := (Option.some.inj h).symm
      subst e
      simp [Action.incr]; omega
    | c1 =>
      have h : some ((Action.incr Conn.c1).upd s) = some s' := hs
      have e := (Option.some.inj h).symm
      subst e
      simp [Action.incr]; omega
  edge _ _ h := h

/-- The coherence theorem, instantiated: any receive schedule and any trace-equivalent schedule
of the reference agree on the total. -/
theorem twoRecv_coherent {w w' : List Conn}
    (hw : TraceEq (fun (t v : Conn) => footIndep (Action.incr t) (Action.incr v)) w w')
    {s s' : Conn → Nat} (hrun : run twoRecv.step w s = some s') :
    ∃ n', run total.step (expand sumCorr.interp w') (s Conn.c0 + s Conn.c1) = some n' ∧
      s' Conn.c0 + s' Conn.c1 = n' :=
  coherence sumCorr twoRecv_diamonds (a := s) rfl hw hrun

/-- The premise package of `coherence` inhabited at one state, with its conclusion: G0 at zero
counters and total zero, G2 (`twoRecv_diamonds`), trace equivalence of the two receive orders, a
successful run, the reference run along the other order, and equal observations (G1 and the edge
are `sumCorr`'s fields). -/
theorem twoRecv_coherence_witness :
    sumCorr.R (fun _ => 0) 0 ∧
    Diamonds twoRecv (fun (t v : Conn) => footIndep (Action.incr t) (Action.incr v)) ∧
    TraceEq (fun (t v : Conn) => footIndep (Action.incr t) (Action.incr v))
      [Conn.c0, Conn.c1] [Conn.c1, Conn.c0] ∧
    ∃ s', run twoRecv.step [Conn.c0, Conn.c1] (fun _ => 0) = some s' ∧
      run total.step (expand sumCorr.interp [Conn.c1, Conn.c0]) 0 = some 2 ∧
      sumCorr.obsA s' = sumCorr.obsB 2 :=
  ⟨rfl, twoRecv_diamonds, TraceEq.swap [] [] Conn.c0 Conn.c1 (incr_indep (by decide)),
    ⟨_, rfl, rfl, rfl⟩⟩

/-! ### Teeth: Astra's accept/close false diamond (COHERENCE §2.4) -/

/-- The allocator's free-row count, one echo row with an outstanding close, and the number of
connections the listener admitted (what the client sees). -/
inductive ACPos
  | free | occupied | admitted
  deriving DecidableEq, Repr

/-- The listener admits a new connection when a row is free; otherwise it closes it. -/
def acceptAct : Action ACPos Nat where
  reads q := q = .free ∨ q = .admitted
  writes q := q = .free ∨ q = .admitted
  guard _ := true
  upd s q :=
    if 0 < s .free then
      (if q = .free then s .free - 1 else if q = .admitted then s .admitted + 1 else s q)
    else s q

/-- The echo row's close completes and releases its row to the allocator. -/
def closeAct : Action ACPos Nat where
  reads q := q = .occupied ∨ q = .free
  writes q := q = .occupied ∨ q = .free
  guard s := decide (0 < s .occupied)
  upd s q := if q = .occupied then s .occupied - 1 else if q = .free then s .free + 1 else s q

theorem accept_respects : acceptAct.Respects where
  guard_reads _ _ _ := rfl
  upd_reads s s' h q hq := by
    have hf : s .free = s' .free := h .free (Or.inl rfl)
    have ha : s .admitted = s' .admitted := h .admitted (Or.inr rfl)
    rcases hq with hq | hq <;> subst hq <;> simp [acceptAct, hf, ha]
  frame s q hq := by
    cases q with
    | free => exact (hq (Or.inl rfl)).elim
    | admitted => exact (hq (Or.inr rfl)).elim
    | occupied => simp [acceptAct]

theorem close_respects : closeAct.Respects where
  guard_reads s s' h := by
    have ho : s .occupied = s' .occupied := h .occupied (Or.inl rfl)
    show decide (0 < s .occupied) = decide (0 < s' .occupied)
    rw [ho]
  upd_reads s s' h q hq := by
    have ho : s .occupied = s' .occupied := h .occupied (Or.inl rfl)
    have hf : s .free = s' .free := h .free (Or.inr rfl)
    rcases hq with hq | hq <;> subst hq <;> simp [closeAct, ho, hf]
  frame s q hq := by
    cases q with
    | occupied => exact (hq (Or.inl rfl)).elim
    | free => exact (hq (Or.inr rfl)).elim
    | admitted => simp [closeAct]

inductive ACLab
  | accept | close
  deriving DecidableEq, Repr

inductive Machine
  | listener | echo
  deriving DecidableEq, Repr

def ACLab.machine : ACLab → Machine
  | .accept => .listener
  | .close => .echo

def ACLab.act : ACLab → Action ACPos Nat
  | .accept => acceptAct
  | .close => closeAct

abbrev acFrame : Frame.{0} := toyFrame ACPos Nat ACLab ACLab.act

/-- The false declaration: "different machines are independent". -/
def differentMachine (t v : ACLab) : Prop := t.machine ≠ v.machine

/-- No free row; one occupied row whose close is outstanding; nothing admitted yet. -/
def acStart : ACPos → Nat
  | .free => 0
  | .occupied => 1
  | .admitted => 0

/-- Both actions keep their own footprints: the failure below is the declaration's. -/
theorem acFrame_respects : ∀ l : ACLab, l.act.Respects
  | .accept => accept_respects
  | .close => close_respects

/-- The footprint declaration refuses the pair: `close` writes the free count `accept` reads. -/
theorem acceptClose_footprint_dependent : ¬ footIndep acceptAct closeAct := by
  intro h
  exact (h ACPos.free).2 ⟨Or.inr rfl, Or.inl (Or.inl rfl)⟩

/-- The diamond assumed by "different machines" is false. -/
theorem acceptClose_not_diamond : ¬ Diamonds acFrame differentMachine := by
  intro h
  have e := h ACLab.accept ACLab.close (show ACLab.accept.machine ≠ ACLab.close.machine by decide)
    acStart
  have e' := congrArg (fun o => o.map fun s => s ACPos.admitted) e
  revert e'
  decide

/-- The conclusion of `coherence` fails without G2: the two orders are trace-equivalent under the
false declaration, and the client sees a refused connection on one route and an admitted one on
the other. -/
theorem acceptClose_routes_disagree :
    TraceEq differentMachine [ACLab.accept, ACLab.close] [ACLab.close, ACLab.accept] ∧
    (run acFrame.step [ACLab.accept, ACLab.close] acStart).map (fun s => s ACPos.admitted) = some 0 ∧
    (run acFrame.step [ACLab.close, ACLab.accept] acStart).map (fun s => s ACPos.admitted) = some 1 :=
  ⟨TraceEq.swap [] [] ACLab.accept ACLab.close
      (show ACLab.accept.machine ≠ ACLab.close.machine by decide),
    by decide, by decide⟩

/-- The identity correspondence on the accept/close frame, observing admissions: G0 and G1 hold
trivially, so only G2 is missing below. -/
def acIdCorr : Correspondence acFrame acFrame Nat where
  R a b := a = b
  interp l := [l]
  obsA s := s ACPos.admitted
  obsB s := s ACPos.admitted
  step t := by
    intro a b a' hab ha
    have e : a = b := hab
    subst e
    refine ⟨a', ?_, rfl⟩
    show (acFrame.step t a).bind (Loose.ident _) = some a'
    rw [ha]; rfl
  edge a b h := by
    have e : a = b := h
    subst e
    rfl

/-- **The tooth, as one package**: every hypothesis of `coherence` except G2 holds (a correspondence
with its G1 squares and edge, a related start, trace equivalence under "different machines", a
successful run), and the conclusion fails. -/
theorem acceptClose_without_g2 :
    ∃ (a b a' : acFrame.State) (w w' : List ACLab),
      acIdCorr.R a b ∧ TraceEq differentMachine w w' ∧ run acFrame.step w a = some a' ∧
      ¬ ∃ b', run acFrame.step (expand acIdCorr.interp w') b = some b' ∧
        acIdCorr.obsA a' = acIdCorr.obsB b' := by
  obtain ⟨hT, h0, h1⟩ := acceptClose_routes_disagree
  cases ha : run acFrame.step [ACLab.accept, ACLab.close] acStart with
  | none => rw [ha] at h0; simp at h0
  | some a' =>
    refine ⟨acStart, acStart, a', _, _, rfl, hT, ha, ?_⟩
    rintro ⟨b', hb, ho⟩
    have hb' : run acFrame.step [ACLab.close, ACLab.accept] acStart = some b' := hb
    rw [ha] at h0
    rw [hb'] at h1
    simp at h0 h1
    have ho' : a' ACPos.admitted = b' ACPos.admitted := ho
    omega

/-! ### Teeth for the catalogue form: an uncovered case -/

def uA : Bool → Loose Unit Unit := fun _ _ => some ()
def uB : Bool → Loose Unit Unit := fun b _ => if b then none else some ()

/-- Every case of the catalogue `[false]` has its square. -/
theorem uncovered_catalogue_holds :
    ∀ t ∈ [false], Sq (fun _ _ => True) (uA t) (run uB [t]) (fun _ _ => True) := by
  intro t ht a b a' _ _
  have : t = false := by simpa using ht
  subst this
  exact ⟨(), rfl, trivial⟩

/-- A word using a case outside the catalogue is not covered: dropping `Sq.paste_cover`'s coverage
premise makes its conclusion false. -/
theorem uncovered_case_fails :
    ¬ Sq (fun _ _ => True) (run uA [true]) (run uB (expand (fun b => [b]) [true])) (fun _ _ => True) := by
  intro h
  obtain ⟨b', hb, _⟩ := h () () () trivial rfl
  have hnone : run uB (expand (fun b => [b]) [true]) () = none := rfl
  rw [hnone] at hb
  simp at hb

/-! ## Two-sided mixed-pasting schema (HM, COHERENCE §3.2) -/

theorem TraceEq.append_left {L : Type u} {I : L → L → Prop} (p : List L) {w₁ w₂ : List L}
    (h : TraceEq I w₁ w₂) : TraceEq I (p ++ w₁) (p ++ w₂) := by
  induction h with
  | refl w => exact TraceEq.refl (p ++ w)
  | swap l r t v hI =>
    have e1 : p ++ (l ++ t :: v :: r) = (p ++ l) ++ t :: v :: r := (List.append_assoc p l _).symm
    have e2 : p ++ (l ++ v :: t :: r) = (p ++ l) ++ v :: t :: r := (List.append_assoc p l _).symm
    rw [e1, e2]
    exact TraceEq.swap (p ++ l) r t v hI
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

theorem TraceEq.append_right {L : Type u} {I : L → L → Prop} (q : List L) {w₁ w₂ : List L}
    (h : TraceEq I w₁ w₂) : TraceEq I (w₁ ++ q) (w₂ ++ q) := by
  induction h with
  | refl w => exact TraceEq.refl (w ++ q)
  | swap l r t v hI =>
    have e1 : (l ++ t :: v :: r) ++ q = l ++ t :: v :: (r ++ q) := by simp [List.append_assoc]
    have e2 : (l ++ v :: t :: r) ++ q = l ++ v :: t :: (r ++ q) := by simp [List.append_assoc]
    rw [e1, e2]
    exact TraceEq.swap l (r ++ q) t v hI
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

theorem TraceEq.append {L : Type u} {I : L → L → Prop} {u₁ u₂ v₁ v₂ : List L}
    (h₁ : TraceEq I u₁ u₂) (h₂ : TraceEq I v₁ v₂) : TraceEq I (u₁ ++ v₁) (u₂ ++ v₂) :=
  (TraceEq.append_right v₁ h₁).trans (TraceEq.append_left u₂ h₂)

theorem expand_append {L M : Type u} (interp : L → List M) (w₁ w₂ : List L) :
    expand interp (w₁ ++ w₂) = expand interp w₁ ++ expand interp w₂ := by
  induction w₁ with
  | nil => rfl
  | cons t w₁ ih =>
    show interp t ++ expand interp (w₁ ++ w₂) = (interp t ++ expand interp w₁) ++ expand interp w₂
    rw [ih, List.append_assoc]

/-- Label-interpretation compatibility transports `TraceEq I_A` to `TraceEq I_B` through `expand`. -/
theorem expand_traceEq {L M : Type u} {I_A : L → L → Prop} {I_B : M → M → Prop}
    (interp : L → List M)
    (hSwap : ∀ t v, I_A t v → TraceEq I_B (interp t ++ interp v) (interp v ++ interp t))
    {w w' : List L} (hw : TraceEq I_A w w') :
    TraceEq I_B (expand interp w) (expand interp w') := by
  induction hw with
  | refl w => exact TraceEq.refl (expand interp w)
  | swap p q t v hI =>
    have e1 : expand interp (p ++ t :: v :: q) =
        expand interp p ++ ((interp t ++ interp v) ++ expand interp q) := by
      simp [expand_append, expand, List.append_assoc]
    have e2 : expand interp (p ++ v :: t :: q) =
        expand interp p ++ ((interp v ++ interp t) ++ expand interp q) := by
      simp [expand_append, expand, List.append_assoc]
    rw [e1, e2]
    exact TraceEq.append_left (expand interp p)
      (TraceEq.append_right (expand interp q) (hSwap t v hI))
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- **General two-sided mixed-pasting schema (HM, COHERENCE §3.2).** When adjacent `I_A`-swaps
map under `C.interp` to `TraceEq I_B`-equivalent reference words and `Diamonds B I_B` holds, any
successful implementation run along `w` and `TraceEq I_A w w'` yields a matching reference run
along `expand C.interp w'` with `C.R` and equal observations. -/
theorem mixed_pasting_hm {A B : Frame.{u}} {O : Type u} (C : Correspondence A B O)
    {I_A : A.Label → A.Label → Prop} {I_B : B.Label → B.Label → Prop}
    (hSwap : ∀ t v, I_A t v → TraceEq I_B (C.interp t ++ C.interp v) (C.interp v ++ C.interp t))
    (hDB : Diamonds B I_B)
    {a : A.State} {b : B.State} (h0 : C.R a b)
    {w w' : List A.Label} (hw : TraceEq I_A w w') {a' : A.State}
    (hrun : run A.step w a = some a') :
    ∃ b', run B.step (expand C.interp w') b = some b' ∧ C.R a' b' ∧ C.obsA a' = C.obsB b' := by
  obtain ⟨b', hb, hR⟩ := Sq.paste C.interp C.R C.step w a b a' h0 hrun
  have htr : TraceEq I_B (expand C.interp w) (expand C.interp w') :=
    expand_traceEq C.interp hSwap hw
  rw [trace_run hDB htr] at hb
  exact ⟨b', hb, hR, C.edge a' b' hR⟩

/-- Observation and two-sided schedule corollary of `mixed_pasting_hm`: under the HM hypotheses,
if `w` runs to `a'` and `TraceEq I_A w w'` and `TraceEq I_B (expand C.interp w') v'`, then both
`expand C.interp w` and `v'` run from `b` to reference states `bₙ` and `bₙ'` with equal
observations (`C.obsB bₙ = C.obsB bₙ' = C.obsA a'`). -/
theorem mixed_pasting_hm_obs {A B : Frame.{u}} {O : Type u} (C : Correspondence A B O)
    {I_A : A.Label → A.Label → Prop} {I_B : B.Label → B.Label → Prop}
    (hSwap : ∀ t v, I_A t v → TraceEq I_B (C.interp t ++ C.interp v) (C.interp v ++ C.interp t))
    (hDB : Diamonds B I_B)
    {a : A.State} {b : B.State} (h0 : C.R a b)
    {w w' : List A.Label} (hw : TraceEq I_A w w')
    {v' : List B.Label} (hv' : TraceEq I_B (expand C.interp w') v')
    {a' : A.State} (hrun : run A.step w a = some a') :
    ∃ bₙ bₙ',
      run B.step (expand C.interp w) b = some bₙ ∧
      run B.step v' b = some bₙ' ∧
      C.obsA a' = C.obsB bₙ ∧
      C.obsA a' = C.obsB bₙ' ∧
      C.obsB bₙ = C.obsB bₙ' := by
  obtain ⟨bₙ, hbₙ, hR⟩ := Sq.paste C.interp C.R C.step w a b a' h0 hrun
  have htr : TraceEq I_B (expand C.interp w) v' :=
    (expand_traceEq C.interp hSwap hw).trans hv'
  have hbₙ' : run B.step v' b = some bₙ := by
    rw [← trace_run hDB htr]; exact hbₙ
  have hobs : C.obsA a' = C.obsB bₙ := C.edge a' bₙ hR
  exact ⟨bₙ, bₙ, hbₙ, hbₙ', hobs, hobs, rfl⟩

/-- Non-identity reference frame for HM: a pair of connection counters `(n₀, n₁)` retaining label
identities `Conn` rather than collapsing them to `Unit`. -/
abbrev pairTotal : Frame.{0} where
  State := Nat × Nat
  Label := Conn
  step c p := match c with
    | .c0 => some (p.1 + 1, p.2)
    | .c1 => some (p.1, p.2 + 1)

def pairCorr : Correspondence twoRecv pairTotal Nat where
  R s p := s Conn.c0 = p.1 ∧ s Conn.c1 = p.2
  interp c := [c]
  obsA s := s Conn.c0 + s Conn.c1
  obsB p := p.1 + p.2
  step t := by
    intro s p s' hR hs
    obtain ⟨h0, h1⟩ : s Conn.c0 = p.1 ∧ s Conn.c1 = p.2 := hR
    cases t with
    | c0 =>
      have h : some ((Action.incr Conn.c0).upd s) = some s' := hs
      have e := (Option.some.inj h).symm
      subst e
      refine ⟨(p.1 + 1, p.2), rfl, ?_⟩
      show ((Action.incr Conn.c0).upd s) Conn.c0 = p.1 + 1 ∧
        ((Action.incr Conn.c0).upd s) Conn.c1 = p.2
      simp [Action.incr, h0, h1]
    | c1 =>
      have h : some ((Action.incr Conn.c1).upd s) = some s' := hs
      have e := (Option.some.inj h).symm
      subst e
      refine ⟨(p.1, p.2 + 1), rfl, ?_⟩
      show ((Action.incr Conn.c1).upd s) Conn.c0 = p.1 ∧
        ((Action.incr Conn.c1).upd s) Conn.c1 = p.2 + 1
      simp [Action.incr, h0, h1]
  edge s p h := by
    obtain ⟨h0, h1⟩ : s Conn.c0 = p.1 ∧ s Conn.c1 = p.2 := h
    show s Conn.c0 + s Conn.c1 = p.1 + p.2
    omega

theorem pairTotal_diamonds : Diamonds pairTotal (fun (t v : Conn) => t ≠ v) := by
  intro t v hne (n0, n1)
  cases t <;> cases v
  · exact (hne rfl).elim
  · rfl
  · rfl
  · exact (hne rfl).elim

theorem pairCorr_swap :
    ∀ t v : Conn, footIndep (Action.incr t) (Action.incr v) →
      TraceEq (fun (x y : Conn) => x ≠ y)
        (pairCorr.interp t ++ pairCorr.interp v)
        (pairCorr.interp v ++ pairCorr.interp t) := by
  intro t v hI
  have hne : t ≠ v := by
    intro heq
    subst heq
    exact (hI t).1 ⟨rfl, Or.inl rfl⟩
  exact TraceEq.swap [] [] t v hne

/-- Satisfiable non-identity witness for `mixed_pasting_hm`: `twoRecv` into `pairTotal` with
distinct mapped reference schedules `[c0, c1] ≠ [c1, c0]`. -/
theorem hm_witness_satisfiable :
    pairCorr.R (fun _ => 0) (0, 0) ∧
    (∀ t v, footIndep (Action.incr t) (Action.incr v) →
      TraceEq (fun (x y : Conn) => x ≠ y)
        (pairCorr.interp t ++ pairCorr.interp v)
        (pairCorr.interp v ++ pairCorr.interp t)) ∧
    Diamonds pairTotal (fun (x y : Conn) => x ≠ y) ∧
    TraceEq (fun (t v : Conn) => footIndep (Action.incr t) (Action.incr v))
      [Conn.c0, Conn.c1] [Conn.c1, Conn.c0] ∧
    expand pairCorr.interp [Conn.c0, Conn.c1] ≠ expand pairCorr.interp [Conn.c1, Conn.c0] ∧
    ∃ s' bₙ bₙ',
      run twoRecv.step [Conn.c0, Conn.c1] (fun _ => 0) = some s' ∧
      run pairTotal.step (expand pairCorr.interp [Conn.c0, Conn.c1]) (0, 0) = some bₙ ∧
      run pairTotal.step (expand pairCorr.interp [Conn.c1, Conn.c0]) (0, 0) = some bₙ' ∧
      pairCorr.R s' bₙ' ∧
      pairCorr.obsA s' = pairCorr.obsB bₙ' ∧
      pairCorr.obsB bₙ = pairCorr.obsB bₙ' :=
  ⟨And.intro rfl rfl, pairCorr_swap, pairTotal_diamonds,
    TraceEq.swap [] [] Conn.c0 Conn.c1 (incr_indep (by decide)),
    by decide,
    ⟨_, (1, 1), (1, 1), rfl, rfl, rfl, And.intro rfl rfl, rfl, rfl⟩⟩

/-- Hypothesis-removal tooth for `mixed_pasting_hm`: every premise of HM except `Diamonds B I_B`
holds (`acIdCorr`, `hSwap`, `TraceEq`, a successful implementation run), and the conclusion fails. -/
theorem hm_without_ref_diamonds_fails :
    (∀ t v, differentMachine t v →
      TraceEq differentMachine (acIdCorr.interp t ++ acIdCorr.interp v)
        (acIdCorr.interp v ++ acIdCorr.interp t)) ∧
    ¬ Diamonds acFrame differentMachine ∧
    ∃ (a b a' : acFrame.State) (w w' : List ACLab),
      acIdCorr.R a b ∧ TraceEq differentMachine w w' ∧ run acFrame.step w a = some a' ∧
      ¬ ∃ b', run acFrame.step (expand acIdCorr.interp w') b = some b' ∧
        acIdCorr.obsA a' = acIdCorr.obsB b' :=
  ⟨fun t v h => TraceEq.swap [] [] t v h, acceptClose_not_diamond, acceptClose_without_g2⟩

/-! ## Mazurkiewicz projections and toy completeness (COHERENCE §3.1, §3.2) -/

/-- `TraceEq` preserves label multiplicity (is a subrelation of `List.Perm`). -/
theorem traceEq_perm {L : Type u} {I : L → L → Prop} {w₁ w₂ : List L}
    (h : TraceEq I w₁ w₂) : List.Perm w₁ w₂ := by
  induction h with
  | refl w => exact List.Perm.refl w
  | swap p q t v _ => exact (List.Perm.swap v t q).append_left p
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- `TraceEq` preserves the count of every label. -/
theorem traceEq_count {L : Type u} [DecidableEq L] {I : L → L → Prop} {w₁ w₂ : List L}
    (h : TraceEq I w₁ w₂) (a : L) : w₁.count a = w₂.count a :=
  (traceEq_perm h).count_eq a

/-- Mazurkiewicz projection preservation on a dependence clique (`∀ x y, p x → p y → ¬ I x y`):
`TraceEq I` preserves the subword projection `List.filter p`. -/
theorem traceEq_filter_clique {L : Type u} {I : L → L → Prop} (p : L → Bool)
    (hDep : ∀ x y, p x = true → p y = true → ¬ I x y)
    {w₁ w₂ : List L} (h : TraceEq I w₁ w₂) :
    w₁.filter p = w₂.filter p := by
  induction h with
  | refl _ => rfl
  | swap l r t v hI =>
    simp only [List.filter_append, List.filter]
    cases ht : p t <;> cases hv : p v
    · rfl
    · rfl
    · rfl
    · exact (hDep t v ht hv hI).elim
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Mazurkiewicz projection preservation: if all distinct labels selected by `p` are mutually
dependent (`¬ I x y`), then `TraceEq I` preserves the subword projection `List.filter p`. -/
theorem traceEq_filter_dependent {L : Type u} [DecidableEq L] {I : L → L → Prop} (p : L → Bool)
    (hDep : ∀ x y, x ≠ y → p x = true → p y = true → ¬ I x y)
    {w₁ w₂ : List L} (h : TraceEq I w₁ w₂) :
    w₁.filter p = w₂.filter p := by
  induction h with
  | refl _ => rfl
  | swap l r t v hI =>
    by_cases htv : t = v
    · subst htv; rfl
    · simp only [List.filter_append, List.filter]
      cases ht : p t <;> cases hv : p v
      · rfl
      · rfl
      · rfl
      · exact (hDep t v htv ht hv hI).elim
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

theorem traceEq_bubble_right {L : Type u} {I : L → L → Prop} (p : L → Bool)
    (hIndep : ∀ x y, p x = true → p y = false → I x y ∧ I y x)
    (a : L) (ha : p a = false) :
    ∀ (u q : List L), (∀ x ∈ u, p x = true) →
      TraceEq I (a :: (u ++ q)) (u ++ a :: q) := by
  intro u
  induction u with
  | nil =>
    intro q _
    exact TraceEq.refl (a :: q)
  | cons x u ih =>
    intro q hu
    have hx : p x = true := hu x (by simp)
    have hIax : I a x := (hIndep x a hx ha).2
    have h1 : TraceEq I (a :: x :: (u ++ q)) (x :: a :: (u ++ q)) :=
      TraceEq.swap [] (u ++ q) a x hIax
    have h2 : TraceEq I (x :: a :: (u ++ q)) (x :: (u ++ a :: q)) :=
      TraceEq.append_left [x] (ih q (fun y hy => hu y (by simp [hy])))
    exact h1.trans h2

/-- Canonical form for a 2-class independent partition: every word is trace-equivalent to its
`p`-projection followed by its `¬p`-projection. -/
theorem traceEq_partition_normal {L : Type u} {I : L → L → Prop} (p : L → Bool)
    (hIndep : ∀ x y, p x = true → p y = false → I x y ∧ I y x) :
    ∀ (w : List L), TraceEq I w (w.filter p ++ w.filter (fun x => !p x)) := by
  intro w
  induction w with
  | nil => exact TraceEq.refl []
  | cons a v ih =>
    have hstep : TraceEq I (a :: v) (a :: (v.filter p ++ v.filter (fun x => !p x))) :=
      TraceEq.append_left [a] ih
    cases ha : p a
    · simp only [List.filter, ha, Bool.not_false]
      exact hstep.trans (traceEq_bubble_right p hIndep a ha (v.filter p)
        (v.filter (fun x => !p x)) (fun x hx => (List.mem_filter.mp hx).2))
    · simp only [List.filter, ha, Bool.not_true]
      exact hstep

/-- **Mazurkiewicz projection completeness for a 2-class independent partition**: when `p`
partitions `L` into two mutually independent classes, each internally dependent on distinct
labels, two words are trace-equivalent iff their projections onto the two classes are equal. -/
theorem traceEq_iff_filter_eq {L : Type u} [DecidableEq L] {I : L → L → Prop} (p : L → Bool)
    (hIndep : ∀ x y, p x = true → p y = false → I x y ∧ I y x)
    (hDepT : ∀ x y, x ≠ y → p x = true → p y = true → ¬ I x y)
    (hDepF : ∀ x y, x ≠ y → p x = false → p y = false → ¬ I x y)
    (w₁ w₂ : List L) :
    TraceEq I w₁ w₂ ↔
      w₁.filter p = w₂.filter p ∧
      w₁.filter (fun x => !p x) = w₂.filter (fun x => !p x) := by
  constructor
  · intro h
    refine ⟨traceEq_filter_dependent p hDepT h, ?_⟩
    exact traceEq_filter_dependent (fun x => !p x) (by
      intro x y hxy hx hy
      have hx' : p x = false := by cases hpx : p x <;> simp_all
      have hy' : p y = false := by cases hpy : p y <;> simp_all
      exact hDepF x y hxy hx' hy') h
  · rintro ⟨hT, hF⟩
    have hn₁ := traceEq_partition_normal p hIndep w₁
    have hn₂ := traceEq_partition_normal p hIndep w₂
    rw [hT, hF] at hn₁
    exact hn₁.trans hn₂.symm

theorem filter_beq_eq_replicate_count {L : Type u} [DecidableEq L] (c : L) :
    ∀ (w : List L), w.filter (· == c) = List.replicate (w.count c) c := by
  intro w
  induction w with
  | nil => rfl
  | cons x u ih =>
    by_cases hxc : x = c
    · subst hxc
      simp [List.filter, List.count_cons_self, List.replicate_succ, ih]
    · have hbeq : (x == c) = false := beq_false_of_ne hxc
      simp [List.filter, hbeq, List.count_cons_of_ne hxc, ih]

/-- **Toy completeness (projection form)**: on `twoRecv`, two words are `TraceEq` under footprint
independence iff their projections onto `c0` and `c1` are equal. -/
theorem twoRecv_traceEq_iff_projections (w₁ w₂ : List Conn) :
    TraceEq (fun (t v : Conn) => footIndep (Action.incr t) (Action.incr v)) w₁ w₂ ↔
      w₁.filter (· == Conn.c0) = w₂.filter (· == Conn.c0) ∧
      w₁.filter (· == Conn.c1) = w₂.filter (· == Conn.c1) := by
  have hiff := traceEq_iff_filter_eq
    (I := fun (t v : Conn) => footIndep (Action.incr t) (Action.incr v))
    (p := (· == Conn.c0))
    (by
      intro x y hx hy
      cases x <;> cases y
      · cases hy
      · exact ⟨incr_indep (by decide), incr_indep (by decide)⟩
      · cases hx
      · cases hx)
    (by
      intro x y hxy hx hy
      cases x <;> cases y
      · exact (hxy rfl).elim
      · cases hy
      · cases hx
      · cases hx)
    (by
      intro x y hxy hx hy
      cases x <;> cases y
      · cases hx
      · cases hx
      · cases hy
      · exact (hxy rfl).elim)
    w₁ w₂
  have hnot : (fun x : Conn => !(x == Conn.c0)) = (· == Conn.c1) := by
    funext x
    cases x <;> rfl
  rw [hnot] at hiff
  exact hiff

/-- **Toy completeness (count form)**: on `twoRecv`, two words are `TraceEq` under footprint
independence iff they have the same `c0` and `c1` counts. -/
theorem twoRecv_traceEq_iff_counts (w₁ w₂ : List Conn) :
    TraceEq (fun (t v : Conn) => footIndep (Action.incr t) (Action.incr v)) w₁ w₂ ↔
      w₁.count Conn.c0 = w₂.count Conn.c0 ∧ w₁.count Conn.c1 = w₂.count Conn.c1 := by
  rw [twoRecv_traceEq_iff_projections]
  constructor
  · rintro ⟨h0, h1⟩
    have hc0 := congrArg List.length h0
    have hc1 := congrArg List.length h1
    rw [filter_beq_eq_replicate_count, filter_beq_eq_replicate_count,
      List.length_replicate, List.length_replicate] at hc0 hc1
    exact ⟨hc0, hc1⟩
  · rintro ⟨hc0, hc1⟩
    rw [filter_beq_eq_replicate_count Conn.c0 w₁, filter_beq_eq_replicate_count Conn.c0 w₂,
      filter_beq_eq_replicate_count Conn.c1 w₁, filter_beq_eq_replicate_count Conn.c1 w₂,
      hc0, hc1]
    exact ⟨rfl, rfl⟩

/-- Negative tooth: distinct mutually dependent events (`t ≠ v`, `¬ I t v`, `¬ I v t`) are never
trace-equivalent in opposite orders. -/
theorem dependent_swap_not_traceEq {L : Type u} [DecidableEq L] {I : L → L → Prop}
    {t v : L} (hne : t ≠ v) (hntv : ¬ I t v) (hnvt : ¬ I v t) :
    ¬ TraceEq I [t, v] [v, t] := by
  intro h
  let p : L → Bool := fun x => decide (x = t ∨ x = v)
  have hDep : ∀ x y, x ≠ y → p x = true → p y = true → ¬ I x y := by
    intro x y hxy hx hy
    have hx' : x = t ∨ x = v := of_decide_eq_true hx
    have hy' : y = t ∨ y = v := of_decide_eq_true hy
    rcases hx' with rfl | rfl <;> rcases hy' with rfl | rfl
    · exact (hxy rfl).elim
    · exact hntv
    · exact hnvt
    · exact (hxy rfl).elim
  have hfilt := traceEq_filter_dependent p hDep h
  have ht : p t = true := decide_eq_true (Or.inl rfl)
  have hv : p v = true := decide_eq_true (Or.inr rfl)
  simp [List.filter, ht, hv] at hfilt
  exact hne hfilt.1

/-- Negative tooth on the accept/close toy: under footprint independence, `[accept, close]` and
`[close, accept]` are not trace-equivalent. -/
theorem acceptClose_not_traceEq :
    ¬ TraceEq (fun (t v : ACLab) => footIndep t.act v.act)
      [ACLab.accept, ACLab.close] [ACLab.close, ACLab.accept] := by
  refine dependent_swap_not_traceEq (L := ACLab) (by decide) acceptClose_footprint_dependent ?_
  intro h
  exact (h ACPos.free).1 ⟨Or.inr rfl, Or.inl (Or.inl rfl)⟩

end Fn2.Coherence


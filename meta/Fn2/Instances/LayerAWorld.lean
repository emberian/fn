/-- A function's guard on its arguments (`T` for a function with no stated guard). -/
def guardOf (f : String) (args : List Val) : Option Val := match guardTree.find (nameKey f) with
  | some g => g args
  | none => if (fnTree.find (nameKey f)).isSome && !guardOutside.contains f then some Val.t else none


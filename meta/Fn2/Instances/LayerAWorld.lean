def fns : Fns := fun f args => match fnTree.find (nameKey f) with
  | some g => g args
  | none => none

def guardOutside : List String := []

/-- A function's guard on its arguments (`T` for a function with no stated guard). -/
def guardOf (f : String) (args : List Val) : Option Val := match guardTree.find (nameKey f) with
  | some g => g args
  | none => if (fnTree.find (nameKey f)).isSome && !guardOutside.contains f then some Val.t else none

/-- `fns` at a name whose key is `k` searches the tree for `k`. -/
theorem fns_key {f : String} {k : Nat} (args : List Val) (h : nameKey f = k) :
    fns f args = (match fnTree.find k with | some g => g args | none => none) := by
  subst h; rfl

/-- `guardOf` at a name whose key is `k` searches the trees for `k`. -/
theorem guardOf_key {f : String} {k : Nat} (args : List Val) (h : nameKey f = k) :
    guardOf f args = (match guardTree.find k with
      | some g => g args
      | none => if (fnTree.find k).isSome && !guardOutside.contains f then some Val.t else none) := by
  subst h; rfl


(defthm FN2-POOL-COMPARE-LOOP-EXPORT-BODY
  (equal (FN2-LOOP-EXPORT-EVAL '(IF (IF (NOT (NATP I)) (NOT (NATP I)) (IF (NOT (NATP N)) (NOT (NATP N)) (NOT (< I N)))) (CONS ':EQUAL (CONS (NFIX N) 'NIL)) ((LAMBDA (X Y FN2-POOL N B A I) (IF (< X Y) (CONS ':LESS (CONS I 'NIL)) (IF (< Y X) (CONS ':GREATER (CONS I 'NIL)) (FN2-POOL-COMPARE-LOOP A B (BINARY-+ '1 I) N FN2-POOL)))) (FN2-POOL-DATAI (BINARY-+ A I) FN2-POOL) (FN2-POOL-DATAI (BINARY-+ B I) FN2-POOL) FN2-POOL N B A I)) (list (cons 'A A) (cons 'B B) (cons 'I I) (cons 'N N) (cons 'FN2-POOL FN2-POOL)))
         (FN2-POOL-COMPARE-LOOP A B I N FN2-POOL))
  :rule-classes nil
  :hints (("Goal" :in-theory (enable FN2-POOL-COMPARE-LOOP))))

(defun fn2-tv-pool-compare-fuel (fuel a b i n fn2-pool)
 (declare (xargs :stobjs fn2-pool :measure (nfix fuel) :verify-guards nil))
 (if (zp fuel) nil (IF (IF (NOT (NATP I)) (NOT (NATP I)) (IF (NOT (NATP N)) (NOT (NATP N)) (NOT (< I N)))) (CONS ':EQUAL (CONS (NFIX N) 'NIL)) ((LAMBDA (X Y FN2-POOL N B A I) (IF (< X Y) (CONS ':LESS (CONS I 'NIL)) (IF (< Y X) (CONS ':GREATER (CONS I 'NIL)) (FN2-TV-POOL-COMPARE-FUEL (BINARY-+ '-1 FUEL) A B (BINARY-+ '1 I) N FN2-POOL)))) (FN2-POOL-DATAI (BINARY-+ A I) FN2-POOL) (FN2-POOL-DATAI (BINARY-+ B I) FN2-POOL) FN2-POOL N B A I))))

(defthm fn2-tv-pool-compare-fuel-adequate
 (implies (< (nfix (- (nfix n) (nfix i))) (nfix fuel))
          (equal (fn2-tv-pool-compare-fuel fuel a b i n fn2-pool)
                 (fn2-pool-compare-loop a b i n fn2-pool)))
 :rule-classes nil
 :hints (("Goal" :induct (fn2-tv-pool-compare-fuel fuel a b i n fn2-pool)
                 :in-theory (enable fn2-tv-pool-compare-fuel fn2-pool-compare-loop))))

(defthm fn2-tv-pool-compare-fuel-teeth
 (and (equal (fn2-tv-pool-compare-fuel 2 a a 0 1 fn2-pool) '(:equal 1))
      (equal (fn2-pool-compare-loop a a 0 1 fn2-pool) '(:equal 1))
      (not (equal (fn2-tv-pool-compare-fuel 1 a a 0 1 fn2-pool)
                  (fn2-pool-compare-loop a a 0 1 fn2-pool))))
 :rule-classes nil
 :hints (("Goal" :in-theory (enable fn2-tv-pool-compare-fuel fn2-pool-compare-loop))))

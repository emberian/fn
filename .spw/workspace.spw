# Workspace
#
#>spw_workspace
#:workspace

^"roots"{
  @repo: ~".."
  @host: ~"../host"
  @books: ~"../books"
  @specs: ~"../specs"
  @planning: ~"../planning"
  @audits: ~"./audits"
  @index: ~"./index.spw"
  @mount: ~"./mount.spw"
  @spw: ~"."
}

^"settings"{
  ~#language: "spw"
  ~#dialect: "v0.3.0"
}

^"lsp"{
  ~#roots: [~"./", ~"./index.spw", ~"./mount.spw"]
}

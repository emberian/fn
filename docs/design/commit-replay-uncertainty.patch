+(defun fn2-commit-owner-callees (fns world seen fuel)
+ (declare (xargs :verify-guards nil :measure (make-ord 1 (+ 1 (nfix fuel)) (acl2-count fns))))
+ (if (or (atom fns) (zp fuel)) seen
+  (let* ((f (car fns)) (d (fn2-dc-entry f 'fn2-commit world))
+         (calls (fn2-arm-frame-body-callees f world))
+         (leaf (or (and d (not (member-equal 1 (car d))))
+                  (member-eq f '(fn2-issue-write fn2-issue-fence))
+                  (getpropc (fn2-columns-sym f "-OPS-CHILD-FRAME") 'theorem nil world))))
+    (if (assoc-eq f seen) (fn2-commit-owner-callees (cdr fns) world seen fuel)
+     (fn2-commit-owner-callees (cdr fns) world
+       (append (if leaf seen (fn2-commit-owner-callees calls world seen (- fuel 1)))
+         (list (list f (if leaf :frame :open) (car d) (and (not leaf) calls)))) fuel)))))

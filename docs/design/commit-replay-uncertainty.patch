+ :hints (("Goal" :induct (fn2-replay-check-owner-rows left kind ops)
+          :in-theory (e/d (fn2-replay-check-owner-rows) (fn2-op-owner-active-p)))))
+
+(defthm fn2-replay-checked-table-has-owners
+ (implies (and (natp (fn2-ops-rows ops)) (fn2-replay-check-owner-rows (fn2-ops-rows ops) kind ops))

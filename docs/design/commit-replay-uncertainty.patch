+        (e (fn2-arm-frame-known f 'fn2-commit world))
+        (cs (fn2-arm-frame-entry-j e)) (ch (fn2-arm-frame-entry-s e)))
+  `(defthm ,name
+    (equal (fn2-commit-rows (fn2-commit-table ,out)) (fn2-commit-rows (fn2-commit-table fn2-core)))
+    :hints (("Goal" ,@(if (and (not k) (recursivep f nil world)) (list :induct (cons f (formals f world))) '(:do-not-induct t))
+      ,@(cond ((and (eq k :table) (fn2-arm-frame-child-updater f world))
+                `(:in-theory (union-theories '(,f fn2-commit-table nth-update-nth (:e equal) (:e nfix)) (theory 'minimal-theory))))
+              ((eq k :table)
+               `(:in-theory (union-theories '(fn2-commit-table) (theory 'fn2-arm-frame-base))
+                 :use ((:instance ,(cdr d) (fn2-arm-free ',ks) (fn2-arm-c0 fn2-core))
+                       (:instance fn2-arm-kids-refl (i 0) (free ',ks) (a fn2-core))
+                       (:instance fn2-arm-kids-nth (i 0) (k 9) (free ',ks) (a fn2-core) (b ,out)))))
+              ((eq k :row)
+               `(:in-theory (union-theories '(fn2-commit-table fn2-commit-rows fn2-arm-row-frame-refl) (theory 'fn2-arm-frame-base))
+                 :use ((:instance ,(fn2-arm-frame-lemma f e "-ARM-ROW-FRAME" 'fn2-commit world)
+                                (fn2-arm-tb 9) (fn2-arm-row (fn2-machine-slot id fn2-core))
+                                (fn2-arm-cs ',cs) (fn2-arm-ch ',ch) (fn2-arm-c0 fn2-core))
+                      (:instance fn2-arm-row-frame-cols (table 9) (row (fn2-machine-slot id fn2-core)) (columns ',cs) (children ',ch) (a fn2-core) (b ,out))
+                      (:instance fn2-arm-cols-nth (row (fn2-machine-slot id fn2-core)) (k 0) (j *fn2-commit-rows*) (columns ',cs) (a (nth 9 fn2-core)) (b (nth 9 ,out))))))
+              (t `(:in-theory (union-theories '(,f fn2-replay-reads-replaced-commit-table ,@(fn2-replay-column-setter-rows (strip-cars (fn2-decl-get :columns (fn2-decl-row '(:columns fn2-commit) world)))) ,@(fn2-commit-replay-size-runes (fn2-arm-frame-body-callees f world))) (theory 'fn2-arm-frame-base))))))))))

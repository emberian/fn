+(defthm fn2-commit-supported-step-keeps-readiness-and-owners
+ (b* (((mv legal & next & &) (fn2-commit-proof-step command turn (list a b) profile fn2-core fn2-sim fn2-own)))
+  (implies (and legal (fn2-replay-commit-rows-ready-p a b fn2-core)

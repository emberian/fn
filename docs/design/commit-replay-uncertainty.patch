@@ -0,0 +1,223 @@
+; Completion routing preserves the observable phase of every uncertain row.
+(in-package "ACL2")
+(include-book "commit-uncertainty-completion-proof")
+(fn2-book-layer :b)
+
+(make-event
+ (let* ((world (w state))
+        (callees (fn2-arm-frame-body-callees 'fn2-harvest-one world))
+        (todo (fn2-dc-todo callees 'fn2-commit world nil 64)))
+   (value (cons 'progn (fn2-dc-forms todo 'fn2-commit)))))
+
+(make-event
+ (let* ((world (w state))
+        (fn 'fn2-harvest-one)
+        (generated (fn2-dc-form fn 'fn2-commit world)))
+   (if (not (eq (car generated) 'progn))
+       (value generated)
+     (mv-let (children rules missing)
+       (fn2-dc-callees (fn2-arm-frame-body-callees fn world)
+                       'fn2-commit world nil nil)
+       (declare (ignore children missing))
+       (let* ((theorem (cadr generated))
+              (hints `(("Goal" :do-not-induct t
+                        :in-theory
+                        (union-theories
+                         '(,fn fn2-ctf-mv-nth-of-if fn2-ctf-mv-nth-cons
+                           (:t fn2-core-harvest-hooks) (:t fn2-harvest-next)
+                           ,@rules)
+                         (set-difference-theories (theory 'fn2-arm-frame-base)
+                                                  '(mv-nth))))))
+              (proof (list 'defthm (cadr theorem) (caddr theorem) :hints hints)))
+         (value (list* 'progn proof (cddr generated))))))))
+
+(make-event

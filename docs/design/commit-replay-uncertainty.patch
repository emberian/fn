+; Keyed starts and generated machine visits preserve an uncertain commit row.
+(in-package "ACL2")
+(include-book "commit-proof")
+(fn2-book-layer :b)
+
+(defund fn2-commit-has-uncertain-row (fn2-core)
+ (declare (xargs :stobjs fn2-core :verify-guards nil))
+ (let ((a (fn2-machine-kind-base *fn2-commit-kind* fn2-core)))
+  (or (equal (fn2-machine-phase a fn2-core) *fn2-commit-state-uncertain*)
+      (equal (fn2-machine-phase (+ 1 a) fn2-core) *fn2-commit-state-uncertain*))))
+
+(defthm fn2-commit-uncertain-row-precludes-opening
+ (implies (fn2-commit-has-uncertain-row fn2-core)
+          (not (equal (mv-nth 0 (fn2-commit-pick fn2-core)) :open)))
+ :hints (("Goal" :in-theory
+          (union-theories '(fn2-commit-has-uncertain-row fn2-commit-pick
+              mv-nth car-cons cdr-cons (:e zp) (:e equal)) (theory 'minimal-theory)))))
+
+(defthm fn2-commit-uncertain-row-preserves-keyed-admission-core
+ (implies (fn2-commit-has-uncertain-row fn2-core)
+          (equal (mv-nth 4 (fn2-commit-admit-keyed members mode okind oslot ogen fn2-core))
+                 fn2-core))
+ :hints (("Goal" :use fn2-commit-uncertain-row-precludes-opening
+          :in-theory (union-theories '(fn2-commit-admit-keyed mv-nth car-cons cdr-cons
+                       (:e zp) (:e binary-+) (:e equal) (:t fn2-commit-pick))
+                                     (theory 'minimal-theory)))))
+
+(defthm fn2-commit-start-command-preserves-uncertain-core
+ (implies (fn2-commit-has-uncertain-row fn2-core)
+          (equal (mv-nth 3 (fn2-b-start id members first-key mode partner fn2-core))
+                 fn2-core))
+ :hints (("Goal" :use ((:instance fn2-commit-uncertain-row-preserves-keyed-admission-core
+                       (okind 0) (oslot 0) (ogen 0)))
+          :in-theory (union-theories '(fn2-b-start fn2-ctf-mv-nth-cons fn2-ctf-mv-nth-of-if
+                       car-cons cdr-cons (:e zp) (:e binary-+) (:e equal)
+                       (:t fn2-commit-admit-keyed) (:t fn2-commit-pick))
+                      (theory 'minimal-theory)))))
+
+(defthm fn2-uncertain-commit-snapshot
+ (implies (equal (fn2-commit-row-phase id fn2-core) *fn2-commit-state-uncertain*)
+          (equal (fn2-commit-snapshot-read-code id fn2-core) :ok))
+ :hints (("Goal" :in-theory '(fn2-commit-row-phase))))
+
+(defthm fn2-uncertain-arm-possible-phase
+ (implies (and (equal (fn2-commit-snapshot-read-code id fn2-core) :ok)
+               (equal (fn2-machine-phase id fn2-core) *fn2-commit-state-uncertain*)
+               (member-equal (fn2-machine-phase id fn2-core) fn2-arm-pset)
+               (subsetp-equal (list *fn2-commit-state-uncertain*) fn2-arm-pset))
+          (member-equal (fn2-machine-phase id (mv-nth 4 (fn2-commit-run-uncertain id budget fn2-core)))
+                        fn2-arm-pset))
+ :rule-classes nil
+ :hints (("Goal" :do-not-induct t
+          :in-theory (union-theories '(fn2-commit-run-uncertain
+                     fn2-arm-member-of-subsetp-free
+                     fn2-commit-arm-row-phase
+                     fn2-core-stop-arm-phase
+                     fn2-commit~fn2-commit-sub-drain-arm-phase
+                     fn2-commit-sub-drain
+                     fn2-commit-write+cb-stage-arm-phase
+                     fn2-commit~fn2-commit-release-pool-arm-phase
+                     fn2-commit-write+phase+stopped+cb-stage-arm-phase
+                     fn2-commit-write+stopped-arm-phase
+                     fn2-commit~fn2-commit-settle-member-arm-phase
+                     fn2-commit-write+cb-cursor-arm-phase
+                     fn2-commit-write+phase+stopped+cb-cursor+cb-failed+cb-reason-arm-phase
+                     fn2-core-stop-arm-phase) (theory 'fn2-arm-frame-base)))))
+
+(defthm fn2-uncertain-dispatch-possible-phase
+ (implies (equal (fn2-commit-row-phase id fn2-core) *fn2-commit-state-uncertain*)
+          (member-equal (fn2-machine-phase id (mv-nth 4 (fn2-commit-run id budget fn2-core)))
+                        (list *fn2-commit-state-uncertain*)))
+ :rule-classes nil
+ :hints (("Goal" :use ((:instance fn2-uncertain-arm-possible-phase
+                         (fn2-arm-pset (list *fn2-commit-state-uncertain*)))
+                       (:instance fn2-uncertain-commit-snapshot))
+          :in-theory (union-theories '(fn2-commit-run fn2-machine-contract-check
+                            fn2-arm-member-of-subsetp-free fn2-commit-arm-row-phase
+                            fn2-core-stop-arm-phase fn2-commit-idp)
+                         (theory 'fn2-arm-frame-base))
+          :do-not-induct t)))
+
+(defthm fn2-commit-dispatch-preserves-uncertain
+ (implies (equal (fn2-commit-row-phase id fn2-core) *fn2-commit-state-uncertain*)
+          (equal (fn2-machine-phase id (mv-nth 4 (fn2-commit-run id budget fn2-core)))
+                 *fn2-commit-state-uncertain*))
+ :hints (("Goal" :use fn2-uncertain-dispatch-possible-phase
+                  :in-theory '(member-equal car-cons cdr-cons (:e member-equal) (:e equal)))))
+
+(make-event
+ (value (cons 'progn (fn2-arm-frame-fns-forms
+       (fn2-arm-frame-todo '(fn2-machine-contract-check fn2-machine-refuse-phase fn2-machine-idle) 'fn2-commit (w state) nil 64)
+       'fn2-commit))))
+
+(make-event
+ (let* ((world (w state))
+        (runes (fn2-arm-frame-lemmas (fn2-arm-frame-body-callees 'fn2-commit-run world)
+               '("-ARM-ROW-FRAME") 'fn2-commit world))
+        (columns (loop$ for i from 0 to 32 collect i))
+        (children (remove-equal 9 (loop$ for i from 0 to 73 collect i))))
+  (value
+   `(defthm fn2-commit-dispatch-only-writes-visited-commit-row
+    (fn2-arm-row-frame 9 (fn2-machine-slot id fn2-core) ',columns ',children fn2-core
+                       (mv-nth 4 (fn2-commit-run id budget fn2-core)))
+    :rule-classes nil
+    :hints (("Goal" :in-theory
+             (union-theories '(fn2-commit-run fn2-arm-row-frame-refl (:e subsetp-equal) (:e member-equal)
+                              (:e natp) ,@runes) (theory 'fn2-arm-frame-base))
+             :do-not-induct t
+             :cases ,(loop$ for i from 0 to 12 collect `(equal (fn2-commit-row-phase id fn2-core) ,i))))))))
+
+(make-event
+ (value (cons 'progn (fn2-ctf-dir-forms
+     (fn2-ctf-postorder-new '(fn2-commit-run) (w state))
+     'fn2-commit))))
+
+(defthm fn2-commit-readable-after-visit-frame
+ (implies (and (fn2-arm-row-frame 9 row cs ch a b)
+               (not (member-equal 9 ch)) (not (member-equal *fn2-commit-rows* cs))
+               (fn2-ctf-dir b a))
+          (equal (fn2-commit-idp id b) (fn2-commit-idp id a)))
+ :rule-classes nil
+ :hints (("Goal" :in-theory (e/d (fn2-commit-idp fn2-commit-snapshot-read-code
+                      fn2-machine-phase-read-code fn2-commit-table fn2-commit-rows)
+                     (fn2-machine-idp fn2-machine-slot fn2-machine-kind nth update-nth fn2-ctf-dir fn2-arm-row-frame))
+          :use ((:instance fn2-ctf-dir-readers)
+                (:instance fn2-arm-row-frame-cols (table 9) (columns cs) (children ch))
+                (:instance fn2-arm-cols-nth (k 0) (j *fn2-commit-rows*) (columns cs) (a (nth 9 a)) (b (nth 9 b)))))))
+
+(defthm fn2-commit-other-phase-after-visit-frame
+ (implies (and (fn2-arm-row-frame 9 row cs ch a b)
+               (not (member-equal 9 ch)) (not (member-equal *fn2-commit-rows* cs))
+               (fn2-ctf-dir b a) (fn2-commit-idp id a)
+               (not (equal (nfix (fn2-machine-slot id a)) (nfix row))))
+          (equal (fn2-machine-phase id b) (fn2-machine-phase id a)))
+ :rule-classes nil
+ :hints (("Goal" :in-theory (e/d (fn2-machine-phase fn2-commit-idp fn2-commit-snapshot-read-code
+                      fn2-commit-phase fn2-commit-phase$ai fn2-commit-table fn2-view-at fn2-view-row-protected)
+                     (fn2-machine-idp fn2-machine-slot fn2-machine-kind nth update-nth
+                      fn2-ctf-dir fn2-arm-row-frame))
+          :use ((:instance fn2-ctf-dir-readers)
+                (:instance fn2-commit-readable-after-visit-frame)
+                (:instance fn2-row-frame-to-reader (table 9) (columns cs) (children ch)
+                      (path (list 9 0 (fn2-machine-slot id a))))))))
+
+(defthm fn2-uncertain-phase-of-readable-row
+ (implies (fn2-commit-idp id fn2-core)
+          (equal (fn2-commit-row-phase id fn2-core) (fn2-machine-phase id fn2-core)))
+ :rule-classes nil
+ :hints (("Goal" :in-theory (e/d (fn2-commit-idp fn2-commit-snapshot-read-code
+                             fn2-machine-phase-read-code fn2-commit-row-phase fn2-machine-phase)
+                            (fn2-machine-idp fn2-machine-kind fn2-machine-slot)))))
+
+(make-event
+ (let* ((b '(mv-nth 4 (fn2-commit-run id budget fn2-core)))
+        (columns (loop$ for i from 0 to 32 collect i))
+        (children (remove-equal 9 (loop$ for i from 0 to 73 collect i))))
+  (value
+   `(defthm fn2-commit-visit-preserves-readable-rows
+    (equal (fn2-commit-idp i ,b) (fn2-commit-idp i fn2-core))
+    :hints (("Goal" :in-theory '(fn2-ctf-dir-refl (:e member-equal))
+             :use ((:instance fn2-commit-dispatch-only-writes-visited-commit-row)
+                   (:instance fn2-commit-run-ctf-dir (fn2-ctf-c0 fn2-core))
+                   (:instance fn2-commit-readable-after-visit-frame
+                         (id i) (row (fn2-machine-slot id fn2-core))
+                         (cs ',columns) (ch ',children) (a fn2-core) (b ,b)))))))))
+
+(make-event
+ (let* ((b '(mv-nth 4 (fn2-commit-run id budget fn2-core)))
+        (columns (loop$ for i from 0 to 32 collect i))
+        (children (remove-equal 9 (loop$ for i from 0 to 73 collect i))))
+  (value
+   `(defthm fn2-commit-visit-preserves-other-phase
+    (implies (and (fn2-commit-idp i fn2-core)
+                  (not (equal (nfix (fn2-machine-slot i fn2-core)) (nfix (fn2-machine-slot id fn2-core)))))
+             (equal (fn2-machine-phase i ,b) (fn2-machine-phase i fn2-core)))
+    :hints (("Goal" :in-theory '(fn2-ctf-dir-refl (:e member-equal))
+             :use ((:instance fn2-commit-dispatch-only-writes-visited-commit-row)
+                   (:instance fn2-commit-run-ctf-dir (fn2-ctf-c0 fn2-core))
+                   (:instance fn2-commit-other-phase-after-visit-frame
+                         (id i) (row (fn2-machine-slot id fn2-core))
+                         (cs ',columns) (ch ',children) (a fn2-core) (b ,b)))))))))
+
+(defthm fn2-commit-visit-preserves-same-uncertain-phase
+ (implies (and (fn2-commit-idp id fn2-core)
+               (equal (fn2-machine-phase id fn2-core) *fn2-commit-state-uncertain*))
+          (equal (fn2-machine-phase id (mv-nth 4 (fn2-commit-run id budget fn2-core))) *fn2-commit-state-uncertain*))
+ :hints (("Goal" :in-theory nil
+          :use (fn2-uncertain-phase-of-readable-row fn2-commit-dispatch-preserves-uncertain))))
+
+(defthm fn2-commit-visit-keeps-directory-slot
+ (equal (fn2-machine-slot i (mv-nth 4 (fn2-commit-run id budget fn2-core)))
+        (fn2-machine-slot i fn2-core))
+ :hints (("Goal" :in-theory '(fn2-ctf-dir-refl)
+          :use ((:instance fn2-commit-run-ctf-dir (fn2-ctf-c0 fn2-core))
+                (:instance fn2-ctf-dir-readers (id i) (a fn2-core)
+                    (b (mv-nth 4 (fn2-commit-run id budget fn2-core))))))))
+
+(defthm fn2-commit-readable-slot-shares-phase
+ (implies (and (fn2-commit-idp i fn2-core) (fn2-commit-idp id fn2-core)
+               (equal (nfix (fn2-machine-slot i fn2-core)) (nfix (fn2-machine-slot id fn2-core))))
+          (equal (fn2-machine-phase i fn2-core) (fn2-machine-phase id fn2-core)))
+ :rule-classes nil
+ :hints (("Goal" :in-theory (e/d (fn2-commit-idp fn2-commit-snapshot-read-code fn2-machine-phase-read-code
+                                  fn2-machine-phase) (fn2-machine-kind fn2-machine-slot)))))
+
+(defthm fn2-commit-visit-keeps-any-uncertain-row
+ (implies (and (fn2-commit-idp i fn2-core) (fn2-commit-idp id fn2-core)
+               (equal (fn2-machine-phase i fn2-core) *fn2-commit-state-uncertain*))
+          (equal (fn2-machine-phase i (mv-nth 4 (fn2-commit-run id budget fn2-core)))
+                 *fn2-commit-state-uncertain*))
+ :hints (("Goal" :cases ((equal (nfix (fn2-machine-slot i fn2-core)) (nfix (fn2-machine-slot id fn2-core))))
+          :in-theory '(fn2-commit-visit-keeps-directory-slot fn2-commit-visit-preserves-readable-rows)
+          :use (fn2-commit-visit-preserves-same-uncertain-phase fn2-commit-visit-preserves-other-phase
+                fn2-commit-readable-slot-shares-phase
+                (:instance fn2-commit-readable-slot-shares-phase

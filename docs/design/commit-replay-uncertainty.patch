+ :hints (("Goal" :expand ((fn2-op-active-owners-p kind ops))
+          :cases ((and (natp (fn2-op-active-owners-p-witness kind ops)) (< (fn2-op-active-owners-p-witness kind ops) (fn2-ops-rows ops))))
+          :use ((:instance fn2-replay-checked-owner-row (i (fn2-op-active-owners-p-witness kind ops))
+                            (left (fn2-ops-rows ops)))
+                (:instance fn2-op-owner-outside-table (i (fn2-op-active-owners-p-witness kind ops))))
+          :in-theory nil)))

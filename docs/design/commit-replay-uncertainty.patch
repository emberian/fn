+; Generate row frames for the three completion paths that may touch a machine.
+(in-package "ACL2")
+(include-book "commit-uncertainty-visit-proof")
+(fn2-book-layer :b)
+
+(make-event
+ (value (cons 'progn
+              (fn2-arm-frame-fns-forms
+               (fn2-arm-frame-todo '(fn2-machine-observe-terminal fn2-machine-refuse-observation
+                                     fn2-machine-observe-contract-check)
+                                   'fn2-commit (w state) nil 64)

+(defun fn2-commit-run-owner-rules (fns world)
+ (declare (xargs :verify-guards nil))
+ (if (atom fns) nil
+  (let* ((f (car fns)) (same (fn2-columns-sym f "-OPS-CHILD-FRAME"))
+         (owner (fn2-columns-sym f "-KEEPS-ACTIVE-OWNERS")))
+   (append (cond ((getpropc same 'theorem nil world) (list same))
+                 ((getpropc owner 'theorem nil world) (list owner))
+                 (t nil))
+           (fn2-commit-run-owner-rules (cdr fns) world)))))

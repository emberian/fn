+(defun fn2-replay-initial-commit-check (mode)
+ (declare (xargs :verify-guards nil))
+ (with-local-stobj fn2-core
+  (mv-let (ok fn2-core)
+   (b* ((profile (fn2-b-test-profile *fn2-profile-tiny* mode))
+        (a (fn2-machine-global-id *fn2-commit-kind* 0 profile))
+        (b (fn2-machine-global-id *fn2-commit-kind* 1 profile))
+        (fn2-core (fn2-core-init profile fn2-core))
+        (owners
+         (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (ok)
+          (and (natp (fn2-ops-rows fn2-ops))
+               (fn2-replay-check-owner-rows (fn2-ops-rows fn2-ops) *fn2-commit-kind* fn2-ops)) ok)))
+     (mv (and (fn2-replay-commit-rows-ready-p a b fn2-core) owners) fn2-core))
+   ok)))

+    (and (implies (equal (fn2-machine-phase a fn2-core) *fn2-commit-state-uncertain*)
+                  (equal (fn2-machine-phase a next) *fn2-commit-state-uncertain*))
+         (implies (equal (fn2-machine-phase b fn2-core) *fn2-commit-state-uncertain*)
+                  (equal (fn2-machine-phase b next) *fn2-commit-state-uncertain*)))))
+ :rule-classes nil
+ :hints (("Goal" :in-theory nil
+          :use ((:instance fn2-commit-start-keeps-monitored-phase (i a))
+                (:instance fn2-commit-start-keeps-monitored-phase (i b))))))
+
+(defthm fn2-replay-start-monitors-either-row
+ (implies (and (fn2-replay-commit-rows-ready-p a b fn2-core)
+               (member-equal i (list a b))
+               (equal (fn2-machine-phase i fn2-core) *fn2-commit-state-uncertain*))
+          (equal (fn2-machine-phase i (mv-nth 3 (fn2-b-start id members key mode partner fn2-core)))
+                 *fn2-commit-state-uncertain*))
+ :hints (("Goal" :in-theory '(member-equal (:e member-equal) car-cons cdr-cons)
+          :use fn2-replay-start-keeps-both-uncertain-rows)))
+
+(defthm fn2-commit-replay-ready-first (implies (fn2-replay-commit-rows-ready-p a b c)
+             (fn2-commit-idp a c)) :hints (("Goal" :in-theory '(fn2-replay-commit-rows-ready-p))))

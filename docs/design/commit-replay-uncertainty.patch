+(defthm fn2-commit-replay-ready-second (implies (fn2-replay-commit-rows-ready-p a b c)
+             (fn2-commit-idp b c)) :hints (("Goal" :in-theory '(fn2-replay-commit-rows-ready-p))))
+
+(defthm fn2-commit-step-reads-two-visible-phases
+ (equal (fn2-commit-proof-preservedp (fn2-b-visibility (list a b) c)
+                                     (fn2-b-visibility (list a b) next))
+        (and (implies (equal (fn2-machine-phase a c) *fn2-commit-state-uncertain*)
+                      (equal (fn2-machine-phase a next) *fn2-commit-state-uncertain*))
+             (implies (equal (fn2-machine-phase b c) *fn2-commit-state-uncertain*)
+                      (equal (fn2-machine-phase b next) *fn2-commit-state-uncertain*))))
+ :hints (("Goal" :in-theory (union-theories '(fn2-b-visibility fn2-commit-proof-preservedp fn2-b-visible-phase
+            nth (:e nth) car-cons cdr-cons (:e zp) (:e binary-+) (:e unary--) (:e cdr) (:e car))
+           (theory 'minimal-theory)))))

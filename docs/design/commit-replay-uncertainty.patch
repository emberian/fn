+(defun fn2-commit-replay-size-work (fns world seen fuel)
+ (declare (xargs :verify-guards nil :measure (make-ord 1 (+ 1 (nfix fuel)) (acl2-count fns))))
+ (if (or (atom fns) (zp fuel)) seen
+  (let* ((f (car fns)) (d (fn2-dc-entry f 'fn2-commit world))
+         (e (fn2-arm-frame-known f 'fn2-commit world))
+         (direct (cond ((eq f 'update-fn2-commit-table) :setter) ((and d (not (member-equal 9 (car d)))) :table)
+                       ((equal (fn2-arm-frame-entry-tk e world) 9) :row))))
+    (if (assoc-eq f seen) (fn2-commit-replay-size-work (cdr fns) world seen fuel)
+     (fn2-commit-replay-size-work (cdr fns) world
+       (append (if direct seen (fn2-commit-replay-size-work (fn2-arm-frame-body-callees f world) world seen (- fuel 1)))
+         (list (cons f direct))) fuel)))))

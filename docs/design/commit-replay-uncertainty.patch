+; Induction over legal commands preserves uncertainty through the end of the epoch.
+(in-package "ACL2")
+(include-book "commit-uncertainty-step-proof")
+(include-book "owed-discharge")
+(fn2-book-layer :b)
+
+(defthm fn2-commit-replay-cannot-restore-admission
+ (implies (not admitted)
+          (not (mv-nth 0 (fn2-commit-proof-replay commands turn ids profile admitted fresh refused stable saw replies seen manifests events
+                                     fn2-core fn2-sim fn2-own))))
+ :hints (("Goal" :induct (fn2-commit-proof-replay commands turn ids profile admitted fresh refused stable saw replies seen manifests events
+                                     fn2-core fn2-sim fn2-own)
+                 :in-theory (union-theories '(fn2-commit-proof-replay fn2-ctf-mv-nth-cons fn2-ctf-mv-nth-of-if)
+                              (theory 'fn2-arm-frame-base)))))
+
+(defthm fn2-commit-admitted-replay-started-admitted
+ (implies (mv-nth 0 (fn2-commit-proof-replay commands turn ids profile admitted fresh refused stable saw replies seen manifests events fn2-core fn2-sim fn2-own)) admitted)
+ :rule-classes ((:forward-chaining :trigger-terms ((mv-nth 0 (fn2-commit-proof-replay commands turn ids profile admitted fresh refused stable saw replies seen manifests events fn2-core fn2-sim fn2-own)))))
+ :hints (("Goal" :use fn2-commit-replay-cannot-restore-admission :in-theory nil)))
+
+(defthm fn2-commit-admitted-replay-keeps-uncertainty
+ (let ((r (fn2-commit-proof-replay commands turn (list a b) profile admitted fresh refused stable saw replies seen manifests events
+                                     fn2-core fn2-sim fn2-own)))
+  (implies (and (mv-nth 0 r) stable
+                (fn2-replay-commit-rows-ready-p a b fn2-core)
+                (fn2-op-active-owners-p *fn2-commit-kind* (fn2-core-ops fn2-core)))
+           (mv-nth 2 r)))
+ :rule-classes nil
+ :hints (("Goal" :induct (fn2-commit-proof-replay commands turn (list a b) profile admitted fresh refused stable saw replies seen manifests events
+                                     fn2-core fn2-sim fn2-own)
+                 :in-theory (union-theories '(fn2-commit-proof-replay fn2-commit-admitted-replay-started-admitted fn2-commit-replay-cannot-restore-admission
+                      fn2-commit-supported-step-keeps-readiness-and-owners fn2-commit-supported-step-keeps-uncertain-rows
+                      (:t fn2-commit-proof-step) (:t fn2-b-project-issues) (:t fn2-commit-proof-replay)
+                      fn2-ctf-mv-nth-of-if fn2-ctf-mv-nth-cons (:e equal) (:e zp) (:e binary-+) (:e unary--) car-cons cdr-cons)
+                      (set-difference-theories (theory 'minimal-theory) '(mv-nth))))
+         ("Subgoal *1/2" :cases ((mv-nth 0 (fn2-commit-proof-step (car commands) turn (list a b) profile fn2-core fn2-sim fn2-own)))
+           :use ((:instance fn2-commit-supported-step-keeps-readiness-and-owners (command (car commands)))
+                 (:instance fn2-commit-supported-step-keeps-uncertain-rows (command (car commands)))))))
+
+(defthm fn2-commit-ready-replay-stable-result
+ (let ((r (fn2-commit-proof-replay commands turn (list a b) profile admitted fresh refused stable saw replies seen manifests events
+                                     fn2-core fn2-sim fn2-own)))
+  (implies (and (mv-nth 0 r) stable
+                (fn2-replay-commit-rows-ready-p a b fn2-core)
+                (fn2-op-active-owners-p *fn2-commit-kind* (fn2-core-ops fn2-core)))
+           (mv-nth 2 r)))
+ :hints (("Goal" :use fn2-commit-admitted-replay-keeps-uncertainty :in-theory nil)))
+
+(defthm fn2-commit-execution-from-created-core-preserves-uncertainty
+ (let ((r (mv-nth 0 (fn2-commit-proof-execute commands model-profile mode members seed faults
+                                  (create-fn2-core) fn2-sim fn2-own))))
+  (implies (fn2-commit-proof-admitted r) (fn2-commit-proof-stable r)))
+ :hints (("Goal" :do-not-induct t :use (fn2-replay-created-core-has-readable-owned-commit-rows)
+    :in-theory (union-theories '(fn2-commit-proof-execute fn2-commit-proof-admitted fn2-commit-proof-stable
+         fn2-replay-begin-epoch-keeps-ready fn2-replay-begin-epoch-keeps-readers
+         fn2-b-start-ops-child-frame fn2-b-start-keeps-replay-ready fn2-commit-ready-replay-stable-result
+         fn2-ctf-mv-nth-cons fn2-ctf-mv-nth-of-if car-cons cdr-cons nth (:e nth) (:e car) (:e cdr)
+         (:e zp) (:e binary-+) (:e unary--) (:e equal)
+         (:t fn2-commit-proof-replay) (:t fn2-b-start) (:t fn2-b-crash-recover) (:t fn2-alloc-begin-epoch))
+         (set-difference-theories (theory 'minimal-theory) '(mv-nth))))))
+
+(defthm fn2-commit-epoch-preserves-uncertainty
+ (let ((result (fn2-commit-proof-run commands profile mode members seed)))
+  (implies (fn2-commit-proof-admitted result) (fn2-commit-proof-stable result)))
+ :rule-classes nil
+ :hints (("Goal" :do-not-induct t :in-theory
+      (union-theories '(fn2-commit-proof-run fn2-commit-proof-run-faults fn2-ctf-mv-nth-cons
+        fn2-ctf-mv-nth-of-if car-cons cdr-cons (:e zp) (:e binary-+) (:e unary--) (:e equal)
+        fn2-commit-execution-from-created-core-preserves-uncertainty)
+        (set-difference-theories (theory 'minimal-theory) '(mv-nth))))))
+
+(fn2-owed-discharge fn2-commit-uncertain-persists fn2-commit-epoch-preserves-uncertainty)
+
+(make-event
+ (let* ((row (fn2-decl-row '(:square fn2-commit-uncertain-persists) (w state)))
+        (proof (fn2-decl-get :proof row)))
+  (value (list 'assert-event (list 'equal (list 'quote proof) ''(:proved fn2-commit-epoch-preserves-uncertainty))))))

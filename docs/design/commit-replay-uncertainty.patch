+(defun fn2-commit-readable-ids-p (ids fn2-core)
+ (declare (xargs :stobjs fn2-core :verify-guards nil))
+ (if (atom ids) t
+  (and (fn2-commit-idp (car ids) fn2-core)
+       (fn2-commit-readable-ids-p (cdr ids) fn2-core))))
+
+(defthm fn2-commit-run-keeps-readable-ids
+ (equal (fn2-commit-readable-ids-p ids (mv-nth 4 (fn2-commit-run id budget fn2-core)))
+        (fn2-commit-readable-ids-p ids fn2-core))
+ :hints (("Goal" :induct (fn2-commit-readable-ids-p ids fn2-core)
+          :in-theory '(fn2-commit-readable-ids-p fn2-commit-visit-preserves-readable-rows))))
+
+(defthm fn2-commit-run-preserves-uncertain-visibility
+ (implies (and (fn2-commit-readable-ids-p ids fn2-core) (fn2-commit-idp id fn2-core))
+          (fn2-commit-proof-preservedp (fn2-b-visibility ids fn2-core)
+                        (fn2-b-visibility ids (mv-nth 4 (fn2-commit-run id budget fn2-core)))))
+ :hints (("Goal" :induct (fn2-b-visibility ids fn2-core)
+          :in-theory (union-theories '(fn2-b-visibility fn2-commit-proof-preservedp
+                         fn2-b-visible-phase fn2-commit-readable-ids-p (:e nth) nth car-cons cdr-cons
+                         (:e zp) (:e binary-+) (:e car) (:e cdr)
+                         fn2-commit-visit-keeps-any-uncertain-row)
+                        (theory 'minimal-theory)))))

+    (implies (fn2-op-active-owners-p okind (fn2-core-ops fn2-core))
+             (fn2-op-active-owners-p okind (fn2-core-ops
+              (mv-nth 3 (,name ,@args okind oslot ogen principal fn2-core)))))
+    :hints (("Goal" :in-theory (union-theories
+                 '(,name ,preserves fn2-core-ops fn2-core-pool fn2-core-control
+                   update-fn2-core-ops update-fn2-core-pool update-fn2-core-control

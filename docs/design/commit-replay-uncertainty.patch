+(defmacro fn2-commit-replay-child-frame (f child)
+ `(make-event (let* ((f ',f) (child ',child) (world (w state))
+  (d (fn2-dc-entry f 'fn2-commit world)) (k (fn2-arm-frame-child-index child world))
+  (out (fn2-arm-frame-out-term f (cons f (formals f world)) world))
+  (name (fn2-columns-sym f (concatenate 'string "-PRESERVES-" (symbol-name child)))))
+  (value `(defthm ,name (equal (,child ,out) (,child fn2-core))
+      :hints (("Goal" :in-theory (union-theories '(,child) (theory 'fn2-arm-frame-base))
+               :use ((:instance ,(cdr d) (fn2-arm-free ',(car d)) (fn2-arm-c0 fn2-core))
+                     (:instance fn2-arm-kids-refl (i 0) (free ',(car d)) (a fn2-core))
+                     (:instance fn2-arm-kids-nth (i 0) (k ,k) (free ',(car d)) (a fn2-core) (b ,out))))))))))
+
+(fn2-commit-replay-child-frame fn2-b-start fn2-core-machines)

; Independent list interpreter. No allocator include or shared decision helper.
(in-package "ACL2")
(include-book "../books/tuple")
(fn2-cm-defreaders fn2-rc-event-op fn2-rc-event-extent fn2-rc-event-arg
                  fn2-rc-event-edge fn2-rc-event-holder)
(fn2-cm-defreaders fn2-rc-row-id fn2-rc-row-phase fn2-rc-row-retirement fn2-rc-row-edges)
(fn2-cm-defreaders fn2-rc-edge-holder fn2-rc-edge-kind)
(defun fn2-rc-find (key xs)
  (declare (xargs :guard t))
  (if (consp xs)
      (if (and (consp (car xs)) (equal key (caar xs))) (cdar xs)
        (fn2-rc-find key (cdr xs))) nil))
(defun fn2-rc-put (key value xs)
  (declare (xargs :guard t))
  (if (consp xs)
      (if (and (consp (car xs)) (equal key (caar xs))) (cons (cons key value) (cdr xs))
        (cons (car xs) (fn2-rc-put key value (cdr xs))))
    (list (cons key value))))
(defun fn2-rc-remove (key xs)
  (declare (xargs :guard t))
  (if (consp xs)
      (if (and (consp (car xs)) (equal key (caar xs))) (cdr xs)
        (cons (car xs) (fn2-rc-remove key (cdr xs)))) nil))
(defun fn2-rc-member (x xs)
  (declare (xargs :guard t))
  (and (consp xs) (or (equal x (car xs)) (fn2-rc-member x (cdr xs)))))
(defconst *fn2-rc-kinds* '(:installed-root :selectable-checkpoint :recovery-base
  :prepared-successor :reservation :obligation :promised-read :borrow
  :outstanding-io :recovery-candidate))
(defun fn2-rc-protected (edges exceptions)
  (declare (xargs :guard t))
  (and (consp edges)
       (or (and (consp (car edges))
                (not (fn2-rc-member (fn2-rc-edge-kind (cdar edges)) exceptions))
                (fn2-rc-edge-kind (cdar edges)))
           (fn2-rc-protected (cdr edges) exceptions))))
(defun fn2-rc-edge-livep (edge rows)
  (declare (xargs :guard t))
  (and (consp rows)
       (or (and (consp (car rows))
                (fn2-rc-find edge (fn2-rc-row-edges (cdar rows))))
           (fn2-rc-edge-livep edge (cdr rows)))))
; Rows = (id phase retirement owned-edges). Seen IDs survive cancellation/crash.
; Each edge maps its unique row handle to (holder kind), not an anonymous count.
(defun fn2-rc-step (event rows seen cut)
  (declare (xargs :guard t))
  (let* ((op (fn2-rc-event-op event)) (ext (fn2-rc-event-extent event))
         (arg (fn2-rc-event-arg event)) (row (fn2-rc-find ext rows))
         (edge (fn2-rc-event-edge event)) (holder (fn2-rc-event-holder event))
         (id (fn2-rc-row-id row)) (phase (fn2-rc-row-phase row))
         (retire (fn2-rc-row-retirement row)) (edges (fn2-rc-row-edges row)))
    (cond
      ((not (natp cut)) (mv :checkpoint-order rows seen cut))
      ((eq op :reserve)
       (cond ((and row (not (eq phase :free))) (mv :not-free rows seen cut))
             ((fn2-rc-member arg seen) (mv :repeated-id rows seen cut))
             (t (mv nil (fn2-rc-put ext (list arg :reserved 0 '((:reservation nil :reservation))) rows) (cons arg seen) cut))))
      ((eq op :checkpoint-installed)
       (if (or (not (natp ext)) (< ext cut)) (mv :checkpoint-order rows seen cut)
         (mv nil rows seen ext)))
      ((eq op :crash) (mv nil rows seen cut))
      ((or (eq op :edge-add) (eq op :edge-drop))
       (cond ((or (not row) (eq phase :free)) (mv :no-allocation rows seen cut))
             ((not (fn2-rc-member arg *fn2-rc-kinds*)) (mv :edge-kind rows seen cut))
             ((eq arg :reservation) (mv :reservation-owned rows seen cut))
             ((not (natp edge)) (mv :edge-bounds rows seen cut))
             ((not (unsigned-byte-p 60 holder)) (mv :edge-holder rows seen cut))
             ((and (eq op :edge-add) (fn2-rc-edge-livep edge rows)) (mv :edge-live rows seen cut))
             ((and (eq op :edge-drop) (not (equal (fn2-rc-find edge edges) (list holder arg))))
              (mv :edge-holder rows seen cut))
             (t (mv nil (fn2-rc-put ext (list id phase retire
                    (if (eq op :edge-add) (fn2-rc-put edge (list holder arg) edges)
                      (fn2-rc-remove edge edges))) rows) seen cut))))
      ((eq op :commit)
       (if (not (eq phase :reserved)) (mv :state rows seen cut)
         (mv nil (fn2-rc-put ext (list id :allocated retire (fn2-rc-remove :reservation edges)) rows) seen cut)))
      ((eq op :retire)
       (if (or (not (eq phase :allocated)) (not (natp arg))) (mv :state rows seen cut)
         (mv nil (fn2-rc-put ext (list id :retired arg edges) rows) seen cut)))
      ((eq op :cancel)
       (cond ((not (eq phase :reserved)) (mv :state rows seen cut))
             ((fn2-rc-protected edges '(:reservation)) (mv :protected rows seen cut))
             (t (mv nil (fn2-rc-put ext (list id :free 0 nil) rows) seen cut))))
      ((eq op :release)
       (cond ((not (eq phase :retired)) (mv :state rows seen cut))
             ((fn2-rc-protected edges nil) (mv :protected rows seen cut))
             ((or (not (natp retire)) (< cut retire)) (mv :checkpoint-blocked rows seen cut))
             (t (mv nil (fn2-rc-put ext (list id :free 0 nil) rows) seen cut))))
      ((eq op :write)
       (cond ((not (equal id arg)) (mv :stale-write rows seen cut))
             ((not (eq phase :reserved)) (mv :overwrite rows seen cut))
             ((fn2-rc-protected edges '(:reservation :outstanding-io)) (mv :protected-write rows seen cut))
             (t (mv nil rows seen cut))))
      ((eq op :relocate)
       (let* ((dst (fn2-rc-find arg rows)) (de (fn2-rc-row-edges dst))
              (owned (fn2-rc-find edge edges)) (kind (fn2-rc-edge-kind owned)))
         (cond ((or (equal ext arg) (not (eq phase :allocated)) (not (eq (fn2-rc-row-phase dst) :allocated)))
                (mv :state rows seen cut))
               ((not (fn2-rc-member kind '(:installed-root :prepared-successor))) (mv :physical-edge rows seen cut))
               ((not (equal holder (fn2-rc-edge-holder owned))) (mv :edge-holder rows seen cut))
               (t (mv nil (fn2-rc-put arg (list (fn2-rc-row-id dst) :allocated (fn2-rc-row-retirement dst)
                         (fn2-rc-put edge owned de))
                       (fn2-rc-put ext (list id phase retire (fn2-rc-remove edge edges)) rows)) seen cut)))))
      (t (mv :unknown-event rows seen cut)))))
(defun fn2-check-reclaim-aux (events index rows seen cut)
  (declare (xargs :guard (natp index)))
  (if (atom events) nil
    (mv-let (error rows seen cut) (fn2-rc-step (car events) rows seen cut)
      (if error (list index (car events) error)
        (fn2-check-reclaim-aux (cdr events) (+ 1 index) rows seen cut)))))
(defun fn2-check-reclaim (events)
  (declare (xargs :guard t))
  (fn2-check-reclaim-aux events 0 nil nil 0))
(assert-event (eq (symbol-class 'fn2-check-reclaim (w state)) :common-lisp-compliant))

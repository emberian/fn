; Independent list interpreter. No allocator include or shared decision helper.
(in-package "ACL2")
(defun fn2-rc-get (n x)
  (declare (xargs :guard (natp n)))
  (if (consp x) (if (zp n) (car x) (fn2-rc-get (- n 1) (cdr x))) nil))
(defun fn2-rc-find (key xs)
  (declare (xargs :guard t))
  (if (consp xs)
      (if (and (consp (car xs)) (equal key (caar xs))) (cdar xs)
        (fn2-rc-find key (cdr xs))) nil))
(defun fn2-rc-put (key value xs)
  (declare (xargs :guard t))
  (if (consp xs)
      (if (and (consp (car xs)) (equal key (caar xs))) (cons (cons key value) (cdr xs))
        (cons (car xs) (fn2-rc-put key value (cdr xs))))
    (list (cons key value))))
(defun fn2-rc-member (x xs)
  (declare (xargs :guard t))
  (and (consp xs) (or (equal x (car xs)) (fn2-rc-member x (cdr xs)))))
(defconst *fn2-rc-kinds* '(:installed-root :selectable-checkpoint :recovery-base
  :prepared-successor :reservation :obligation :promised-read :borrow
  :outstanding-io :recovery-candidate))
(defun fn2-rc-protected (edges exceptions)
  (declare (xargs :guard t))
  (and (consp edges)
       (or (and (consp (car edges)) (< 0 (nfix (cdar edges)))
                (not (fn2-rc-member (caar edges) exceptions)) (caar edges))
           (fn2-rc-protected (cdr edges) exceptions))))
; Rows = (id phase retirement edges). Seen IDs survive cancellation and crash.
(defun fn2-rc-step (event rows seen cut)
  (declare (xargs :guard t))
  (let* ((op (fn2-rc-get 0 event)) (ext (fn2-rc-get 1 event))
         (arg (fn2-rc-get 2 event)) (row (fn2-rc-find ext rows))
         (id (fn2-rc-get 0 row)) (phase (fn2-rc-get 1 row))
         (retire (fn2-rc-get 2 row)) (edges (fn2-rc-get 3 row)))
    (cond
      ((eq op :reserve)
       (cond ((and row (not (eq phase :free))) (mv :not-free rows seen cut))
             ((fn2-rc-member arg seen) (mv :repeated-id rows seen cut))
             (t (mv nil (fn2-rc-put ext (list arg :reserved 0 '((:reservation . 1))) rows) (cons arg seen) cut))))
      ((eq op :checkpoint-installed)
       (if (< (nfix ext) (nfix cut)) (mv :checkpoint-order rows seen cut)
         (mv nil rows seen ext)))
      ((eq op :crash) (mv nil rows seen cut))
      ((or (eq op :edge-add) (eq op :edge-drop))
       (let ((count (nfix (fn2-rc-find arg edges))))
         (cond ((or (not row) (eq phase :free)) (mv :no-allocation rows seen cut))
               ((not (fn2-rc-member arg *fn2-rc-kinds*)) (mv :edge-kind rows seen cut))
               ((and (eq op :edge-drop) (= count 0)) (mv :edge-underflow rows seen cut))
               (t (mv nil (fn2-rc-put ext (list id phase retire
                     (fn2-rc-put arg (if (eq op :edge-add) (+ count 1) (- count 1)) edges)) rows) seen cut)))))
      ((eq op :commit)
       (if (not (eq phase :reserved)) (mv :state rows seen cut)
         (mv nil (fn2-rc-put ext (list id :allocated retire (fn2-rc-put :reservation 0 edges)) rows) seen cut)))
      ((eq op :retire)
       (if (not (eq phase :allocated)) (mv :state rows seen cut)
         (mv nil (fn2-rc-put ext (list id :retired arg edges) rows) seen cut)))
      ((eq op :cancel)
       (cond ((not (eq phase :reserved)) (mv :state rows seen cut))
             ((fn2-rc-protected edges '(:reservation)) (mv :protected rows seen cut))
             (t (mv nil (fn2-rc-put ext (list id :free 0 nil) rows) seen cut))))
      ((eq op :release)
       (cond ((not (eq phase :retired)) (mv :state rows seen cut))
             ((fn2-rc-protected edges nil) (mv :protected rows seen cut))
             ((< (nfix cut) (nfix retire)) (mv :checkpoint-blocked rows seen cut))
             (t (mv nil (fn2-rc-put ext (list id :free 0 nil) rows) seen cut))))
      ((eq op :write)
       (cond ((not (equal id arg)) (mv :stale-write rows seen cut))
             ((not (eq phase :reserved)) (mv :overwrite rows seen cut))
             ((fn2-rc-protected edges '(:reservation :outstanding-io)) (mv :protected-write rows seen cut))
             (t (mv nil rows seen cut))))
      ((eq op :relocate)
       (let* ((dst (fn2-rc-find arg rows)) (de (fn2-rc-get 3 dst))
              (root (+ (nfix (fn2-rc-find :installed-root edges)) (nfix (fn2-rc-find :installed-root de))))
              (prep (+ (nfix (fn2-rc-find :prepared-successor edges)) (nfix (fn2-rc-find :prepared-successor de)))))
         (if (or (equal ext arg) (not (eq phase :allocated)) (not (eq (fn2-rc-get 1 dst) :allocated)))
             (mv :state rows seen cut)
           (mv nil (fn2-rc-put arg (list (fn2-rc-get 0 dst) :allocated (fn2-rc-get 2 dst)
                       (fn2-rc-put :installed-root root (fn2-rc-put :prepared-successor prep de)))
                     (fn2-rc-put ext (list id phase retire (fn2-rc-put :installed-root 0
                       (fn2-rc-put :prepared-successor 0 edges))) rows)) seen cut))))
      (t (mv :unknown-event rows seen cut)))))
(defun fn2-check-reclaim-aux (events index rows seen cut)
  (declare (xargs :guard (natp index)))
  (if (atom events) nil
    (mv-let (error rows seen cut) (fn2-rc-step (car events) rows seen cut)
      (if error (list index (car events) error)
        (fn2-check-reclaim-aux (cdr events) (+ 1 index) rows seen cut)))))
(defun fn2-check-reclaim (events)
  (declare (xargs :guard t))
  (fn2-check-reclaim-aux events 0 nil nil 0))
(assert-event (eq (symbol-class 'fn2-check-reclaim (w state)) :common-lisp-compliant))

; Controlled client environment for the real layer-A machines.  Unlike the
; A3 pool workload, accept does not invent client bytes and advance does not
; drain them invisibly: the independent client oracle supplies/checks both.
(in-package "ACL2")
(include-book "sim")

; Shape contracts already describe every adapter boundary; tau would repeat
; compound type propagation across every nested state in all six projections.
(local (in-theory (disable (tau-system))))

(defun fn2-sim-echo-accept (slot fault word allow fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own)
                  :guard (and (fn2-core-wfp fn2-core) (fn2-sim-ready fn2-sim)
                              (fn2-own-wfp fn2-own))
                  :guard-hints (("Goal" :in-theory (e/d (fn2-sim-ready)
                                                        (fn2-sim-network-rows))))))
  (if (not (and (natp slot) (< slot (fn2-sim-rows fn2-sim))
                (unsigned-byte-p 32 word)))
      (mv nil fn2-core fn2-sim fn2-own)
    (if (not allow)
        (let ((fn2-sim (fn2-sim-delay-flight slot 26 word fn2-sim)))
          (mv t fn2-core fn2-sim fn2-own))
    (b* ((gen (fn2-sim-gen slot fn2-sim))
         (now (fn2-sim-now fn2-sim))
         ((mv code cap nonce fn2-sim)
          (stobj-let ((fn2-sim-network (fn2-sim-net fn2-sim)))
            (code cap nonce fn2-sim-network)
            (let ((cap (if (< 0 (fn2-sim-network-rows fn2-sim-network))
                           (mod word (fn2-sim-network-rows fn2-sim-network)) 0)))
              (mv-let (code nonce fn2-sim-network)
                (fn2-network-accept cap fn2-sim-network)
                (mv code cap nonce fn2-sim-network)))
            (mv code cap nonce fn2-sim)))
         ((mv & fn2-core fn2-sim fn2-own)
          (fn2-sim-inject slot fault fn2-core fn2-sim fn2-own))
         ((when (eq code :would-block))
          (let ((fn2-sim (fn2-sim-set-due slot (min #xfffffffffffffff (+ 100 now)) fn2-sim)))
            (mv t fn2-core fn2-sim fn2-own))))
      (fn2-sim-complete-result slot gen *fn2-action-accept* *fn2-event-accept-result*
                               0 code cap nonce fault word now nil
                               fn2-core fn2-sim fn2-own)))))
(fn2-sim-adapter-shape fn2-sim-echo-accept (slot fault word allow) 1 2 3 nil nil)

; Only called after :idle. An ArmWake deadline can precede the next physical
; completion. Existing A3 fault selection, posting and physical-byte paths
; remain the source of adapter semantics.
(defun fn2-sim-echo-advance (allow-accept fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own)
                  :guard (and (fn2-core-wfp fn2-core) (fn2-sim-ready fn2-sim)
                              (fn2-own-wfp fn2-own))))
  (b* (((mv found slot) (fn2-sim-next-flight fn2-sim))
       ((mv fault fn2-sim) (if found (fn2-sim-choose-flight-fault slot fn2-sim) (mv 26 fn2-sim)))
       ((mv word fn2-sim) (fn2-sim-random fn2-sim))
       (fn2-sim (fn2-sim-record 0 0 0 257 0 0 word (fn2-sim-now fn2-sim) 0 fault fn2-sim))
       ((when (equal fault 15))
        (let ((profile (fn2-sim-profile fn2-sim)))
          (mv-let (fn2-core fn2-sim fn2-own)
            (fn2-sim-crash profile fn2-core fn2-sim fn2-own)
            (mv t fn2-core fn2-sim fn2-own))))
       (wake (fn2-sim-wake-first-p found slot fn2-sim))
       (target (if wake (fn2-sim-wake-deadline fn2-sim)
                 (if found (fn2-sim-due slot fn2-sim) (fn2-sim-now fn2-sim))))
       (fn2-sim (fn2-sim-clock target fault fn2-sim))
       (mono (fn2-sim-now fn2-sim))
       (real (fn2-sim-real fn2-sim))
       (fn2-sim (fn2-sim-record 0 0 0 256 0 0 mono real 1 fault fn2-sim))
       (fn2-core (fn2-sim-post-clock mono real fn2-core))
       ((when wake)
        (let* ((fn2-sim (fn2-sim-record 0 (fn2-sim-wake-observation-gen fn2-sim)
                          0 259 0 0 (fn2-sim-wake-deadline fn2-sim) mono 0 fault fn2-sim))
               (fn2-sim (update-fn2-sim-wake-pending 0 fn2-sim)))
          (mv t fn2-core fn2-sim fn2-own)))
       ((unless found) (mv nil fn2-core fn2-sim fn2-own))
       (fn2-sim (fn2-sim-environment slot fault word fn2-sim))
       ((when (or (equal fault 2) (equal fault 14)))
        (let ((fn2-sim (fn2-sim-delay-flight slot fault word fn2-sim)))
          (mv t fn2-core fn2-sim fn2-own))))
    (if (and (equal (fn2-sim-active slot fn2-sim) 1)
             (equal (fn2-sim-kind slot fn2-sim) *fn2-action-accept*))
        (fn2-sim-echo-accept slot fault word allow-accept fn2-core fn2-sim fn2-own)
      (fn2-sim-complete slot fault word fn2-core fn2-sim fn2-own))))
(fn2-sim-adapter-shape fn2-sim-echo-advance (allow-accept) 1 2 3 nil nil)

(defun fn2-sim-echo-network-reset (fn2-sim)
  (declare (xargs :stobjs fn2-sim :guard (fn2-sim-ready fn2-sim)))
  (stobj-let ((fn2-sim-network (fn2-sim-net fn2-sim)))
    (fn2-sim-network) (fn2-network-restart fn2-sim-network) fn2-sim))
(fn2-sim-shape fn2-sim-echo-network-reset (fn2-sim) nil)

(assert-event
 (fn2-profile-exports-compliant-p
  '(fn2-sim-echo-accept fn2-sim-echo-advance fn2-sim-echo-network-reset) (w state)))

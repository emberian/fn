; Eleven independent semantic checker names. A4 implements TRACE/WORK/OWN.
; Missing evidence and unimplemented checks are never passing results.
(in-package "ACL2")
(include-book "../books/core")
(include-book "check-own")
(include-book "check-trace")
(include-book "check-work")

(defconst *fn2-checker-names*
  '(:trace :work :own :account :fair :history :identity :wire :consumer :recovery :reclaim))
(defun fn2-checker-namep (name)
  (declare (xargs :guard t))
  (if (member-eq name *fn2-checker-names*) t nil))
(defun fn2-check-resultp (result)
  (declare (xargs :guard t))
  (or (eq result :pass) (eq result :not-yet)
      (and (consp result) (eq (car result) :fail) (consp (cdr result)))))

(defun fn2-own-observe-issue (opslot fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own)
                  :guard (and (fn2-core-wfp fn2-core) (fn2-own-wfp fn2-own))))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))
              (fn2-ops (fn2-core-ops fn2-core)))
             (fn2-own)
             (fn2-own-observe-issue-parts opslot fn2-pool fn2-ops fn2-own)
             fn2-own))
(defun fn2-own-observe-output (opslot fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own)
                  :guard (and (fn2-core-wfp fn2-core) (fn2-own-wfp fn2-own))))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))
              (fn2-ops (fn2-core-ops fn2-core)))
             (fn2-own)
             (fn2-own-observe-output-parts opslot fn2-pool fn2-ops fn2-own)
             fn2-own))
(defun fn2-own-record-input-byte (slot gen index byte fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own)
                  :guard (and (fn2-core-wfp fn2-core) (unsigned-byte-p 60 gen)
                              (natp index) (unsigned-byte-p 8 byte))))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
             (fn2-own)
             (fn2-own-record-input-byte-parts slot gen index byte fn2-pool fn2-own)
             fn2-own))
(defun fn2-own-observe-read (slot gen index code byte fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own) :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
             (fn2-own)
             (fn2-own-observe-read-parts slot gen index code byte fn2-pool fn2-own)
             fn2-own))

(defun fn2-own-observe-core-write (slot gen index code byte fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own) :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
             (fn2-own)
             (fn2-own-observe-core-write-parts slot gen index code byte fn2-pool fn2-own)
             fn2-own))

(defun fn2-check-own (fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own) :verify-guards nil))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))
              (fn2-ops (fn2-core-ops fn2-core)))
             (answer)
             (fn2-check-own-parts fn2-pool fn2-ops fn2-own)
             answer))
(defun fn2-check (name fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own) :verify-guards nil))
  (cond ((eq name :own) (fn2-check-own fn2-core fn2-own))
        ((member-eq name '(:trace :work)) '(:fail :checker-evidence-required))
        ((fn2-checker-namep name) :not-yet)
        (t '(:fail :unknown-checker))))

(assert-event (and (= (len *fn2-checker-names*) 11)
                   (no-duplicatesp-eq *fn2-checker-names*)
                   (fn2-check-resultp :pass) (fn2-check-resultp :not-yet)
                   (fn2-check-resultp '(:fail :example))
                   (not (fn2-check-resultp nil))))

(assert-event
 (fn2-profile-exports-compliant-p
  '(fn2-checker-namep fn2-check-resultp fn2-own-observe-issue
    fn2-own-observe-output fn2-own-record-input-byte fn2-own-observe-read
    fn2-own-observe-core-write)
  (w state)))

; Registration with the history/counter evidence required by TRACE and WORK.
; The legacy OWN entry point remains convenient for pool-only scenarios.
(defun fn2-check-evidence (name records lost profile nobs nvisits nactions
                                cursor queues actual-actions fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own) :verify-guards nil))
  (cond ((eq name :trace)
         (mv-let (answer next-cursor next-queues)
           (fn2-check-trace records lost (fn2-profile-p profile)
                            cursor queues actual-actions)
           (declare (ignore next-cursor next-queues))
           answer))
        ((eq name :work)
         (fn2-check-work records lost nobs nvisits nactions profile))
        (t (fn2-check name fn2-core fn2-own))))

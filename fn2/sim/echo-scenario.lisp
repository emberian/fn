; Read only the adapter's posted FIFO and outstanding-operation owners before
; the turn. This independent input cannot be repaired by an executor trace.
(defun fn2-echo-observed-wakes-aux (left cells fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)
                  :hints (("Goal" :use ((:instance fn2-test-countdown (x left))
                                        (:instance fn2-test-count-op (x left))) :in-theory nil))))
  (if (or (zp left) (atom cells)) nil
    (b* ((op (floor (nfix (car cells)) 2))
         ((mv owner generation principal kind)
          (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
            (owner generation principal kind)
            (mv (fn2-ops-owner-slot op fn2-ops) (fn2-ops-owner-gen op fn2-ops)
                (fn2-ops-principal op fn2-ops) (fn2-ops-owner-kind op fn2-ops))
            (mv owner generation principal kind)))
         (valid (and (equal generation (fn2-machine-generation owner fn2-core))
                     (equal kind (fn2-machine-kind owner fn2-core))
                     (not (equal (fn2-machine-phase owner fn2-core) 0))
                     (not (equal (fn2-machine-wait-reason owner fn2-core) 2))
                     (not (equal (fn2-machine-wait-reason owner fn2-core) 3))
                     (not (equal (fn2-machine-stopped owner fn2-core) 1)))))
      (cons (list (if valid owner 4294967295) principal)
            (fn2-echo-observed-wakes-aux (- left 1) (cdr cells) fn2-core)))))
(in-theory (disable fn2-echo-observed-wakes-aux))
(defun fn2-echo-observed-wakes (profile fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (let ((cells (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
                 (cells) (fn2-ops-posted-list fn2-ops) cells)))
    (fn2-echo-observed-wakes-aux (fn2-profile-h profile) cells fn2-core)))
(in-theory (disable fn2-echo-observed-wakes))

(defun fn2-echo-check-turn (profile cursor queues before observed nobs nvisits nactions fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own) :verify-guards nil))
  (b* (((mv actual fn2-own)
        (fn2-echo-outbox-refs nactions before fn2-core fn2-own))
       (own (fn2-check-own fn2-core fn2-own))
       (counted-bytes (fn2-exec-turn-bytes fn2-core))
       (counted-steps (fn2-exec-turn-steps fn2-core))
       (outbox-exact (equal (fn2-echo-outbox-count fn2-core) (+ (nfix before) (nfix nactions))))
       ((mv trace work certificate cursor queues fn2-core)
        (stobj-let ((fn2-trace (fn2-core-trace fn2-core)))
          (trace work certificate cursor queues fn2-trace)
          (b* ((records (fn2-trace-records fn2-trace))
               (lost (fn2-trace-lost fn2-trace))
               ((mv trace cursor queues)
                (fn2-check-trace records lost (fn2-profile-p profile) cursor queues actual))
               (observations (fn2-check-trace-observations records observed))
               (trace (if (eq observations :pass) trace observations))
               (work (fn2-check-work records lost nobs nvisits nactions profile))
               (certificate (fn2-work-certificate records))
               (fn2-trace (if (and (eq trace :pass) (eq work :pass) (eq own :pass)
                                   outbox-exact
                                   (equal (nth 3 certificate) counted-bytes)
                                   (equal (nth 4 certificate) counted-steps))
                              (fn2-trace-clear fn2-trace) fn2-trace)))
            (mv trace work certificate cursor queues fn2-trace))
          (mv trace work certificate cursor queues fn2-core))))
    (mv (cond ((not outbox-exact) '(:fail :turn-outbox-extent))
              ((not (and (equal (nth 3 certificate) (fn2-exec-turn-bytes fn2-core))
                         (equal (nth 4 certificate) (fn2-exec-turn-steps fn2-core))))
               '(:fail :turn-work-accumulator))
              ((not (eq trace :pass)) trace)
              ((not (eq work :pass)) work)
              (t own))
        certificate cursor queues fn2-core fn2-own)))
(in-theory (disable fn2-echo-check-turn))

(defun fn2-echo-failure-trace (fn2-core)

; The HISTORY projection of B3's commit fixture, and the harness's independent
; reader of what each submitted batch meant to write. Recovery itself is B5's
; machine (sim/check-recovery.lisp drives it); fn2-b-recover-images is the
; ground-truth reader RECOVERY compares the machine against, never a recovery.
; Lists and local checker stobjs are test adapters, never served operations.
; fn2-fc-acceptedp reaches fn2-format-run through the BH1 image adapter,
; which loads named context references into its local fn2-digests workspace.
; Recovery therefore needs no borrowed live-core digest row after a crash.
(in-package "ACL2")
(include-book "../books/assembly")
(include-book "sim-state-data")
(include-book "check-history")

(fn2-cm-defreaders fn2-b-manifest-id fn2-b-manifest-batch fn2-b-manifest-logs
 fn2-b-manifest-mode fn2-b-manifest-extent fn2-b-manifest-epoch
 fn2-b-manifest-allocation fn2-b-manifest-first fn2-b-manifest-members
 fn2-b-manifest-page-hash fn2-b-manifest-previous-seal fn2-b-manifest-record-bytes)
(local (defthm fn2-b-countdown
 (implies (not (zp left)) (o< (nfix (- left 1)) (nfix left))) :rule-classes nil))
(local (defthm fn2-b-count-op (o-p (nfix left)) :rule-classes nil))
(local (in-theory (disable fn2-layout-parse)))
(defconst *fn2-b-zero-digest* (cons 1 (make-list 32 :initial-element 0)))

(defun fn2-b-zeros-p (bytes)
 (declare (xargs :verify-guards nil))
 (if (consp bytes) (and (equal (car bytes) 0) (fn2-b-zeros-p (cdr bytes)))
  (null bytes)))

(defun fn2-b-frame-payload (bytes kind)
 (declare (xargs :verify-guards nil))
 (mv-let (code header rest) (fn2-layout-parse *fn2-format-frame-header* bytes)
  (let ((n (nth *fn2-format-frame-header-field-payload-length* header)))
   (if (and (eq code :ok) (equal (len bytes) 4096) (natp n)
            (<= (+ n 33) (len rest))
            (equal (nth *fn2-format-frame-header-field-frame-kind* header) kind)
            (equal (nth *fn2-format-frame-header-field-ordinal* header)
                   (cond ((equal kind *frame-kind-records*) 0)
                         ((equal kind *frame-kind-seal*) 1) (t -1)))
            (equal (nth *fn2-format-frame-header-field-fragment-offset* header) 0))
       (mv :ok (take n rest))
     (mv :frame nil)))))

(defun fn2-b-records (left bytes)
 (declare (xargs :verify-guards nil :measure (nfix left)
  :hints (("Goal" :use (fn2-b-countdown fn2-b-count-op) :in-theory nil))))
 (if (zp left) (mv (if (fn2-b-zeros-p bytes) :ok :record-tail) nil 0)
  (mv-let (code header rest) (fn2-layout-parse *fn2-format-record-header* bytes)
   (if (not (and (eq code :ok)
                 (equal (nth *fn2-format-record-header-field-record-kind* header) *record-kind-keyed-mutation*)
                 (equal (nth *fn2-format-record-header-field-schema-version* header) 1)))
       (mv :record-header nil 0)
    (mv-let (code values rest) (fn2-layout-parse *fn2-format-keyed-mutation* rest)
     (if (not (eq code :ok)) (mv code nil 0)
      (mv-let (code records consumed) (fn2-b-records (- left 1) rest)
       (mv code (cons (list header values) records)
           (+ (- (len bytes) (len rest)) consumed)))))))))

; Known requested test mutations, expressed independently of encoded buffers.
; Each record preserves event, operation, effect, allocation identity and hash.
(defun fn2-b-expected-members (left key extent epoch allocation hash)
 (declare (xargs :verify-guards nil :measure (nfix left)
  :hints (("Goal" :use (fn2-b-countdown fn2-b-count-op) :in-theory nil))))
 (if (zp left) nil
  (cons (list (list *record-kind-keyed-mutation* 1 key)
              (list 1 key 0 key *fn2-b-zero-digest* 0
                    0 (* 3 (nfix extent)) epoch allocation *page-kind-manifest* 4096 hash 0))
        (fn2-b-expected-members (- left 1) (+ 1 (nfix key)) extent epoch allocation hash))))

(defun fn2-b-manifest-images (id batch first members mode extent epoch allocation records-frame seal-frame)
 (declare (xargs :verify-guards nil))
 (b* (((unless (and (posp batch) (posp members) (<= members 16) (natp first))) nil)
      ((mv rc record-bytes) (fn2-b-frame-payload records-frame *frame-kind-records*))
      ((mv sc seal-bytes) (fn2-b-frame-payload seal-frame *frame-kind-seal*))
      ((mv bc seal rest) (fn2-layout-parse *fn2-format-sealed-batch* seal-bytes))
      ((mv code records consumed) (fn2-b-records members record-bytes))
      (hash (nth *fn2-format-sealed-batch-field-dependencies-expected-hash* seal))
      (previous (nth *fn2-format-sealed-batch-field-previous-seal* seal))
      (expected (fn2-b-expected-members members first extent epoch allocation hash))
      ((unless (and (eq rc :ok) (eq sc :ok) (eq bc :ok) (eq code :ok)
                    (fn2-b-zeros-p rest) (equal records expected)
                    (equal (nth *fn2-format-sealed-batch-field-event-first* seal) first)
                    (equal (nth *fn2-format-sealed-batch-field-event-last* seal) (+ first (- members 1))))) nil)
      (dependency (list extent epoch allocation 0)))
  (list id (fn2-lm-batch batch (- batch 1) expected (list dependency))
        (list (list extent epoch allocation 1) (list extent epoch allocation 2))
        (if (equal mode 1) :preflush-fua :baseline)
        extent epoch allocation first members hash previous consumed)))

(defun fn2-b-pool-bytes (left off slot gen id ogen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix left)
  :hints (("Goal" :use (fn2-b-countdown fn2-b-count-op) :in-theory nil))))
 (if (zp left) (mv :ok nil)
  (mv-let (code byte) (fn2-pool-read slot gen off *fn2-commit-kind* id ogen fn2-pool)
   (if (not (eq code :ok)) (mv code nil)
    (mv-let (code bytes) (fn2-b-pool-bytes (- left 1) (+ 1 (nfix off)) slot gen id ogen fn2-pool)
     (mv code (cons byte bytes)))))))

(defun fn2-b-pool-image (id role fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv & & & slot gen) (fn2-commit-resource id role fn2-core))
      (ogen (fn2-machine-generation id fn2-core)))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code bytes)
   (fn2-b-pool-bytes 4096 0 slot gen id ogen fn2-pool) (mv code bytes))))

(defun fn2-b-manifest (id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((phase (fn2-machine-phase id fn2-core))
      ((unless (or (and (equal phase *fn2-commit-state-seal*)
                         (<= 18 (fn2-machine-cb-stage id fn2-core)))
                   (member-equal phase
                  (list *fn2-commit-state-dependencies* *fn2-commit-state-log-write*
                        *fn2-commit-state-fence* *fn2-commit-state-durable*
                        *fn2-commit-state-install* *fn2-commit-state-publish*
                        *fn2-commit-state-notify* *fn2-commit-state-draining*)))) nil)
      ((mv e epoch allocation & &) (fn2-commit-resource id 0 fn2-core))
      ((mv rc records) (fn2-b-pool-image id 1 fn2-core))
      ((mv sc seal) (fn2-b-pool-image id 2 fn2-core))
      ((unless (and (eq rc :ok) (eq sc :ok))) nil))
  (fn2-b-manifest-images id (fn2-machine-batch-no id fn2-core)
   (fn2-machine-first-key id fn2-core) (fn2-machine-member-count id fn2-core)
   (fn2-machine-cb-mode id fn2-core) e epoch allocation records seal)))

(defun fn2-b-durable-bytes (left address fn2-sim-storage)
 (declare (xargs :stobjs fn2-sim-storage :verify-guards nil :measure (nfix left)
  :hints (("Goal" :use (fn2-b-countdown fn2-b-count-op) :in-theory nil))))
 (cond ((zp left) (mv :ok nil))
       ((or (equal (fn2-storage-dead fn2-sim-storage) 1) (not (natp address))
            (>= address (fn2-sim-storage-rows fn2-sim-storage))) (mv :io nil))
       (t (mv-let (code rest) (fn2-b-durable-bytes (- left 1) (+ 1 address) fn2-sim-storage)
           (mv code (cons (fn2-sim-storage-durable address fn2-sim-storage) rest))))))

(defun fn2-b-durable-image (extent role fn2-sim)
 (declare (xargs :stobjs fn2-sim :verify-guards nil))
 (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim))) (code bytes)
  (fn2-b-durable-bytes 4096 (+ (* 12288 (nfix extent)) (* 4096 (nfix role))) fn2-sim-storage)
  (mv code bytes)))

(defun fn2-b-context (manifest role previous)
 (declare (xargs :verify-guards nil))
 (let ((e (fn2-b-manifest-extent manifest)) (epoch (fn2-b-manifest-epoch manifest))
       (allocation (fn2-b-manifest-allocation manifest))
       (batch (fn2-lm-batch-number (fn2-b-manifest-batch manifest))))
  (append (list (+ (* 3 (nfix e)) (nfix role)) allocation 1 1 epoch batch *page-kind-manifest* 4096)
          (fn-b3-words 8 (cdr (fn2-b-manifest-page-hash manifest)))
          (make-list 8 :initial-element 0) (list epoch (- (nfix batch) 1))
          (fn-b3-words 8 (cdr previous)) (list e))))

(defun fn2-b-seal-refp (base seal manifest)
 (declare (xargs :verify-guards nil))
 (equal (take *fn2-format-ref-num-fields* (nthcdr base seal))
        (list 0 (* 3 (nfix (fn2-b-manifest-extent manifest)))
              (fn2-b-manifest-epoch manifest) (fn2-b-manifest-allocation manifest)
              *page-kind-manifest* 4096 (fn2-b-manifest-page-hash manifest))))

(defun fn2-b-zero-refp (base seal)
 (declare (xargs :verify-guards nil))
 (equal (take *fn2-format-ref-num-fields* (nthcdr base seal))
        (list 0 0 0 0 0 0 *fn2-b-zero-digest*)))
(defun fn2-b-nodep (node manifest previous)
 (declare (xargs :verify-guards nil))
 (equal node
  (list previous (- (fn2-lm-batch-number (fn2-b-manifest-batch manifest)) 1)
        (fn2-b-manifest-first manifest) (fn2-b-manifest-members manifest)
        (fn2-b-manifest-extent manifest) (fn2-b-manifest-epoch manifest)
        (fn2-b-manifest-allocation manifest))))
(defun fn2-b-seal-rootp (seal manifest records-frame previous)
 (declare (xargs :verify-guards nil))
 (and
  (equal (nth *fn2-format-sealed-batch-field-record-stream* seal) (nthcdr 4063 records-frame))
  (equal (nth *fn2-format-sealed-batch-field-input-root* seal) previous)
  (fn2-b-zero-refp *fn2-format-sealed-batch-field-output-checkpoint-base-storage-domain* seal)
  (fn2-b-zero-refp *fn2-format-sealed-batch-field-output-configuration-generations-storage-domain* seal)
  (equal (nth *fn2-format-sealed-batch-field-output-suffix-first* seal) 1)
  (equal (nth *fn2-format-sealed-batch-field-output-suffix-last* seal)
         (fn2-lm-batch-number (fn2-b-manifest-batch manifest)))
  (fn2-b-seal-refp *fn2-format-sealed-batch-field-dependencies-storage-domain* seal manifest)
  (fn2-b-seal-refp *fn2-format-sealed-batch-field-metadata-edits-storage-domain* seal manifest)
  (fn2-b-seal-refp *fn2-format-sealed-batch-field-output-physical-manifest-storage-domain* seal manifest)
  (fn2-b-seal-refp *fn2-format-sealed-batch-field-allocation-retirement-storage-domain* seal manifest)
  (fn2-b-seal-refp *fn2-format-sealed-batch-field-output-allocation-changes-storage-domain* seal manifest)
  (fn2-b-seal-refp *fn2-format-sealed-batch-field-event-frontier-storage-domain* seal manifest)
  (fn2-b-seal-refp *fn2-format-sealed-batch-field-output-event-frontier-storage-domain* seal manifest)))

(defun fn2-b-recover-images (manifest previous page records-frame seal-frame)
 (declare (xargs :verify-guards nil))
 (b* (((mv pc page-header &) (fn2-layout-parse *fn2-format-page-header* page))
      ((mv nc node rest) (fn2-layout-parse *fn2-commit-manifest-node*
                           (take 73 (nthcdr 96 page))))
      ((unless (and (eq pc :ok) (eq nc :ok) (null rest)
                    (equal (nth *fn2-format-page-header-field-header-length* page-header) 96)
                    (equal (nth *fn2-format-page-header-field-page-kind* page-header) *page-kind-manifest*)
                    (equal (nth *fn2-format-page-header-field-payload-length* page-header) 73)
                    (fn2-b-nodep node manifest previous)))
       (mv :incomplete nil nil))
      ((mv rc record-bytes) (fn2-b-frame-payload records-frame *frame-kind-records*))
      ((mv sc seal-bytes) (fn2-b-frame-payload seal-frame *frame-kind-seal*))
      ((unless (and (eq rc :ok) (eq sc :ok))) (mv :incomplete nil nil))
      ((mv code seal rest) (fn2-layout-parse *fn2-format-sealed-batch* seal-bytes))
      ((unless (and (eq code :ok) (fn2-b-zeros-p rest))) (mv :incomplete nil nil))
      (first (nth *fn2-format-sealed-batch-field-event-first* seal))
      (last (nth *fn2-format-sealed-batch-field-event-last* seal))
      ((unless (and (natp first) (natp last) (<= first last) (< (- last first) 16)
                    (equal first (fn2-b-manifest-first manifest))
                    (equal (+ 1 (- last first)) (fn2-b-manifest-members manifest)))) (mv :incomplete nil nil))
      ((mv code records &) (fn2-b-records (+ 1 (- last first)) record-bytes))
      ((unless (and (eq code :ok)
                    (equal records (fn2-lm-batch-records (fn2-b-manifest-batch manifest)))
                    (equal previous (fn2-b-manifest-previous-seal manifest))
                    (fn2-b-seal-rootp seal manifest records-frame previous)
                    (fn2-fc-acceptedp :frame records-frame (fn2-b-context manifest 1 previous))
                    (fn2-fc-acceptedp :frame seal-frame (fn2-b-context manifest 2 previous))
                    (fn2-fc-acceptedp :seal (take (- (len seal-bytes) (len rest)) seal-bytes)
                                       (fn2-b-context manifest 2 previous))
                    (fn2-fc-acceptedp :page page (fn2-b-context manifest 0 previous)))) (mv :incomplete nil nil))
      (batch (fn2-lm-batch (nth *fn2-format-sealed-batch-field-commit* seal)
                          (nth *fn2-format-sealed-batch-field-previous-commit* seal) records
                          (fn2-lm-batch-dependencies (fn2-b-manifest-batch manifest)))))
  (mv :ok batch (nth *fn2-format-sealed-batch-field-final-seal* seal))))

(fn2-cm-defreaders fn2-b-descriptor-token fn2-b-descriptor-kind
  fn2-b-descriptor-owner fn2-b-descriptor-offset fn2-b-descriptor-length
  fn2-b-descriptor-fua fn2-b-descriptor-owner-generation fn2-b-descriptor-owner-kind)

(defun fn2-b-descriptors (left index fn2-ops)
  (declare (xargs :stobjs fn2-ops :verify-guards nil :measure (nfix left)
  :hints (("Goal" :use (fn2-b-countdown fn2-b-count-op) :in-theory nil))))
  (if (zp left) nil
    (mv-let (code slot gen) (fn2-outbox-peek index fn2-ops)
      (if (not (eq code :ok)) nil
        (cons (list (list slot gen) (fn2-ops-kind slot fn2-ops)
                    (fn2-ops-owner-slot slot fn2-ops)
                    (fn2-ops-storage-offset slot fn2-ops)
                    (fn2-ops-range-len slot fn2-ops) (fn2-ops-fua slot fn2-ops)
                    (fn2-ops-owner-gen slot fn2-ops) (fn2-ops-owner-kind slot fn2-ops))
              (fn2-b-descriptors (- left 1) (+ 1 (nfix index)) fn2-ops))))))

(defun fn2-b-outbox (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
    (descriptors) (fn2-b-descriptors (fn2-outbox-queued fn2-ops) 0 fn2-ops) descriptors))

(defun fn2-b-manifest-for (batch manifests)
  (declare (xargs :verify-guards nil))
  (if (atom manifests) nil
    (if (equal batch (fn2-lm-batch-number (fn2-b-manifest-batch (car manifests)))) (car manifests)
      (fn2-b-manifest-for batch (cdr manifests)))))

(defun fn2-b-member-identities (left key)
 (declare (xargs :verify-guards nil :measure (nfix left)
  :hints (("Goal" :use (fn2-b-countdown fn2-b-count-op) :in-theory nil))))
 (if (zp left) nil
  (cons (list :operation 0 key) (fn2-b-member-identities (- left 1) (+ 1 (nfix key))))))
(defun fn2-b-refusal-events (members)
 (declare (xargs :verify-guards nil))
 (if (atom members) nil
  (cons (list :refuse (car members)) (fn2-b-refusal-events (cdr members)))))
(fn2-cm-defreaders fn2-b-request-batch fn2-b-request-first fn2-b-request-members fn2-b-request-mode)
(defun fn2-b-start (id members first-key mode partner fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv & frontier & &) (fn2-commit-frontier fn2-core))
      ((mv code fn2-core) (fn2-commit-start id members first-key mode partner fn2-core))
      (bounded (and (posp members) (<= members 16) (unsigned-byte-p 60 first-key)
                    (unsigned-byte-p 60 (+ first-key members))))
      (identities (and bounded (fn2-b-member-identities members first-key)))
      (batch (fn2-machine-batch-no id fn2-core))
      (tag (cond ((equal mode 0) :baseline) ((equal mode 1) :preflush-fua) (t :invalid-mode)))
      (events (cond ((eq code :ok) (list (list :request batch identities tag)))
                    ; A stale/replayed identity is not a newly refused operation.
                    ((and (eq code :admission) bounded (natp frontier) (<= frontier first-key))
                     (fn2-b-refusal-events identities))
                    (t nil)))
      (request (and (eq code :ok) (list batch first-key members mode))))
  (mv code events request fn2-core)))
(defun fn2-b-request-event-for (batch events)
 (declare (xargs :verify-guards nil))
 (if (atom events) nil
  (if (and (eq (fn2-lm-event-tag (car events)) :request)
           (equal (fn2-history-request-event-batch (car events)) batch)) (car events)
   (fn2-b-request-event-for batch (cdr events)))))
(defun fn2-b-request-matchp (manifest events)
 (declare (xargs :verify-guards nil))
 (let ((request (fn2-b-request-event-for (fn2-lm-batch-number (fn2-b-manifest-batch manifest)) events)))
  (and request
       (equal (fn2-history-request-event-mode request) (fn2-b-manifest-mode manifest))
       (equal (fn2-history-request-event-members request)
              (fn2-b-member-identities (fn2-b-manifest-members manifest) (fn2-b-manifest-first manifest))))))
(defun fn2-b-batch-event (manifest)
 (declare (xargs :verify-guards nil))
 (list :batch (fn2-b-manifest-batch manifest) (fn2-b-manifest-logs manifest)
       (fn2-b-manifest-mode manifest)
       (fn2-b-member-identities (fn2-b-manifest-members manifest) (fn2-b-manifest-first manifest))))

(defun fn2-b-project-issues (descriptors seen manifests events bytes fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (if (atom descriptors) (mv :ok seen manifests events bytes)
    (b* ((d (car descriptors)) (token (fn2-b-descriptor-token d))
         ((when (member-equal token seen))
          (fn2-b-project-issues (cdr descriptors) seen manifests events bytes fn2-core))
         (owner (fn2-b-descriptor-owner d))
         ; A reusable row is not the identity of a batch. Match the actual
         ; issuing incarnation before consulting its current immutable batch.
         ((unless (and (equal (fn2-b-descriptor-owner-kind d) *fn2-commit-kind*)
                       (equal (fn2-b-descriptor-owner-generation d)
                              (fn2-machine-generation owner fn2-core))))
          (mv :owner-generation seen manifests events bytes))
         (number (fn2-machine-batch-no owner fn2-core))
         (old (fn2-b-manifest-for number manifests))
         (m (or old (fn2-b-manifest owner fn2-core)))
         ((unless m) (mv :missing-manifest seen manifests events bytes))
         ((unless (fn2-b-request-matchp m events)) (mv :request-mismatch seen manifests events bytes))
         (batch (fn2-b-manifest-batch m)) (n (fn2-lm-batch-number batch))
         ; A follower can issue before its predecessor's first descriptor.
         ; Stage18 already has immutable payloads; only the outer trailer
         ; hash remains. Submit both immutable manifests in ancestry order.
         (peer (fn2-machine-partner (fn2-b-manifest-id m) fn2-core))
         (old-prior (fn2-b-manifest-for (- n 1) manifests))
         (prior (and (< 1 n) (not old-prior)
                     (equal (fn2-machine-batch-no peer fn2-core) (- n 1))
                     (fn2-b-manifest peer fn2-core)))
         ((unless (or (= n 1)
           (equal (fn2-lm-batch-number (fn2-b-manifest-batch (or old-prior prior))) (- n 1))))
          (mv :missing-predecessor seen manifests events bytes))
         ((unless (or (not prior) (fn2-b-request-matchp prior events)))
          (mv :request-mismatch seen manifests events bytes))
         (manifests (if prior (append manifests (list prior)) manifests))
         (events (if prior (cons (fn2-b-batch-event prior) events) events))
         (manifests (if old manifests (append manifests (list m))))
         (events (if old events
                   (cons (fn2-b-batch-event m) events)))
         (writep (= (fn2-b-descriptor-kind d) *fn2-action-write*))
         (role (floor (mod (fn2-b-descriptor-offset d) 12288) 4096))
         ((unless (or (not writep)
                      (and (equal (fn2-b-descriptor-length d) 4096)
                           (equal (fn2-b-descriptor-offset d)
                                  (+ (* 12288 (fn2-b-manifest-extent m)) (* 4096 role))))))
          (mv :write-geometry seen manifests events bytes))
         (identity (if (= role 0) (car (fn2-lm-batch-dependencies batch))
                     (nth (- role 1) (fn2-b-manifest-logs m))))
         (event (if writep
                    (list :write token n (if (= role 0) :dependency :log)
                          identity (fn2-b-descriptor-length d) (fn2-b-descriptor-fua d))
                  (list (if (eq (fn2-b-manifest-mode m) :baseline) :fence :preflush) token n))))
      (if (not (member-equal (fn2-b-descriptor-kind d) (list *fn2-action-write* *fn2-action-fence*)))
          (mv :unexpected-action seen manifests events bytes)
        (fn2-b-project-issues (cdr descriptors) (cons token seen) manifests (cons event events)
          (+ (nfix bytes) (if writep (fn2-b-descriptor-length d) 0)) fn2-core)))))

(defun fn2-b-result-outcome (outcome reason)
  (declare (xargs :verify-guards nil))
  (cond ((= outcome *fn2-outcome-done*) :done)
        ((= outcome *fn2-outcome-short*) :short)
        ((= outcome *fn2-outcome-cancelled*) :cancelled)
        ((= reason *fn2-reason-no-space*) :enospc)
        ((= reason *fn2-reason-io*) :eio)
        (t :failed)))

(defun fn2-b-next-result (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
    (event)
    (if (zp (fn2-ops-post-count fn2-ops)) nil
      (let* ((index (fn2-ops-posted-fifoi (fn2-ops-post-head fn2-ops) fn2-ops))
             (slot (floor index 2)) (cell (mod index 2))
             (token (list slot (fn2-ops-gen slot fn2-ops))))
        (b* (((mv & & event outcome reason count & &) (fn2-op-cell cell slot fn2-ops)))
          (cond ((= event *fn2-event-write-result*)
                 (list :write-result token (fn2-b-result-outcome outcome reason) count))
                ((= event *fn2-event-fence-result*)
                 (list :fence-result token (fn2-b-result-outcome outcome reason) count))
                (t (list :unexpected-completion token event))))))
    event))

(defun fn2-b-visibility (ids fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (if (atom ids) nil
    (cons (list (fn2-machine-batch-no (car ids) fn2-core)
                (fn2-machine-cb-published (car ids) fn2-core)
                (fn2-machine-cb-acks (car ids) fn2-core)
                (fn2-machine-phase (car ids) fn2-core)
                (fn2-machine-stopped (car ids) fn2-core)
                (fn2-machine-member-count (car ids) fn2-core))
          (fn2-b-visibility (cdr ids) fn2-core))))

(fn2-cm-defreaders fn2-b-visible-batch fn2-b-visible-published
                  fn2-b-visible-acks fn2-b-visible-phase fn2-b-visible-stopped fn2-b-visible-members)

(defun fn2-b-visible-for (batch rows)
  (declare (xargs :verify-guards nil))
  (if (atom rows) nil
    (if (equal batch (fn2-b-visible-batch (car rows))) (car rows)
      (fn2-b-visible-for batch (cdr rows)))))

(defun fn2-b-project-visible (old new events)
  (declare (xargs :verify-guards nil))
  (if (atom new) events
    (let* ((b (car new)) (a (fn2-b-visible-for (fn2-b-visible-batch b) old))
           (batch (fn2-b-visible-batch b))
           (request (fn2-b-request-event-for batch events))
           (limit (len (fn2-history-request-event-members request)))
           (invalid (and (posp batch)
                         (or (not request) (not (equal (fn2-b-visible-members b) limit))
                             (> (fn2-b-visible-acks b) limit)
                             (and a (< (fn2-b-visible-acks b) (fn2-b-visible-acks a))))))
           ; Re-arming the same slot starts a different batch at zero. Earlier
           ; batch notifications stay in EVENTS and cannot be rewritten by it.
           (events (if (and (= (nfix (fn2-b-visible-published a)) 0)
                            (= (fn2-b-visible-published b) 1))
                       (cons (list :publish (fn2-b-visible-batch b)) events) events))
           ; B1's ack is batch-level; its first individual reply is already
           ; enough to require the whole indivisible batch to survive.
           (events (if (and (= (nfix (fn2-b-visible-acks a)) 0) (< 0 (fn2-b-visible-acks b)))
                       (cons (list :ack (fn2-b-visible-batch b)) events) events))
           (events (if invalid (cons (list :projection-error :notification batch) events) events)))
      (fn2-b-project-visible old (cdr new) events))))
(defun fn2-b-four-k-classp (classes)
  (declare (xargs :verify-guards nil))
  (if (atom classes) nil
    (or (equal (cdar classes) 4096) (fn2-b-four-k-classp (cdr classes)))))
(defun fn2-b-test-profile (profile mode)
  (declare (xargs :verify-guards nil))
  (let* ((sectors (if (assoc-equal :sim-sectors profile)
                      (fn2-profile-get :sim-sectors profile) 16))
         (profile (put-assoc-equal :sim-sectors sectors profile))
         (profile (if (assoc-equal :extent-slots profile) profile
                    (put-assoc-equal :extent-slots (floor (nfix sectors) 3) profile))))
    (put-assoc-equal :commit-barrier-mode mode
      (if (fn2-b-four-k-classp (fn2-profile-pool-classes profile)) profile
        (put-assoc-equal :pool-classes
          (append (fn2-profile-pool-classes profile) '((8 . 4096))) profile)))))

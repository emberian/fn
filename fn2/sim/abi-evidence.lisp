; LD-only physical ABI evidence, shared by every broad public run wrapper.
(in-package "ACL2")

; ABI choice points use two simultaneously outstanding requests. Counters
; derive from the posted FIFO and harvested bytes, never from chosen order alone.
(defun fn2-abi-trial (socket old fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
       (fn2-sim (fn2-sim-init 0 :none *fn2-scenario-revision* *fn2-profile-tiny* fn2-sim))
       ((mv c1 s1 g1 fn2-core) (fn2-core-reserve 0 *fn2-echo-kind* 0 1 fn2-core))
       ((mv c2 s2 g2 fn2-core) (fn2-core-reserve 0 *fn2-echo-kind* 0 1 fn2-core))
       ((mv w1 fn2-core) (fn2-core-write s1 g1 0 65 *fn2-echo-kind* 0 1 fn2-core))
       (fn2-own (fn2-own-observe-core-write s1 g1 0 w1 65 fn2-core fn2-own))
       ((mv w2 fn2-core) (if socket (fn2-core-write s2 g2 0 66 *fn2-echo-kind* 0 1 fn2-core) (mv :ok fn2-core)))
       (fn2-own (if socket (fn2-own-observe-core-write s2 g2 0 w2 66 fn2-core fn2-own) fn2-own))
       ((mv i1 op1 & fn2-core)
        (if socket (fn2-issue-send 0 1 s1 g1 0 1 0 *fn2-echo-kind* 0 1 0 fn2-core)
          (fn2-issue-write 0 s1 g1 0 1 0 *fn2-echo-kind* 0 1 0 fn2-core)))
       (fn2-own (fn2-own-observe-issue op1 fn2-core fn2-own))
       ((mv i2 op2 & fn2-core)
        (if socket (fn2-issue-send 0 1 s2 g2 0 1 0 *fn2-echo-kind* 0 1 0 fn2-core)
          (fn2-issue-read 0 s2 g2 1 *fn2-echo-kind* 0 1 0 fn2-core)))
       (fn2-own (fn2-own-observe-issue op2 fn2-core fn2-own))
       ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 2 0 fn2-core fn2-sim fn2-own))
       (outstanding (and (= taken 2) (= (fn2-sim-active op1 fn2-sim) 1)
                         (= (fn2-sim-active op2 fn2-sim) 1)))
       (reverse (or socket old))
       ((mv d1 fn2-core fn2-sim fn2-own)
        (fn2-sim-complete (if reverse op2 op1) *fn2-fault-none* 0 fn2-core fn2-sim fn2-own))
       ((mv d2 fn2-core fn2-sim fn2-own)
        (fn2-sim-complete (if reverse op1 op2) *fn2-fault-none* 0 fn2-core fn2-sim fn2-own))
       (reordered (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (yes)
                    (and (= (fn2-ops-post-count fn2-ops) 2)
                         (= (fn2-ops-posted-fifoi 0 fn2-ops) (* 2 op2))
                         (= (fn2-ops-posted-fifoi 1 fn2-ops) (* 2 op1))) yes))
       ((mv status fn2-core fn2-own) (fn2-scenario-harvest 2 fn2-core fn2-own))
       ((mv read-code byte) (fn2-core-read s2 g2 0 *fn2-echo-kind* 0 1 fn2-core))
       (bytes-ok (if socket
                     (stobj-let ((fn2-sim-network (fn2-sim-net fn2-sim))) (yes)
                       (= (fn2-sim-network-tx-count 0 fn2-sim-network) 2) yes)
                   (and (eq read-code :ok) (= byte (if old 0 65))
                        (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim))) (yes)
                          (= (fn2-sim-storage-pending 0 fn2-sim-storage) 65) yes)))))
    (mv (and (eq c1 :ok) (eq c2 :ok) (eq w1 :ok) (eq w2 :ok)
             (eq i1 :ok) (eq i2 :ok) outstanding d1 d2
             (or (not reverse) reordered) bytes-ok (eq status :pass) (= (fn2-sim-lost fn2-sim) 0))
        fn2-core fn2-sim fn2-own)))
(in-theory (disable fn2-abi-trial))
(defun fn2-abi-landings (fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* (((mv socket fn2-core fn2-sim fn2-own) (fn2-abi-trial t nil fn2-core fn2-sim fn2-own))
       ((mv old fn2-core fn2-sim fn2-own) (fn2-abi-trial nil t fn2-core fn2-sim fn2-own))
       ((mv new fn2-core fn2-sim fn2-own) (fn2-abi-trial nil nil fn2-core fn2-sim fn2-own)))
    (mv (list (cons :e1-socket-reordered (if socket 1 0))
              (cons :e1-storage-reordered (if old 1 0))
              (cons :e2-read-old (if old 1 0)) (cons :e2-read-new (if new 1 0)))
        fn2-core fn2-sim fn2-own)))
(in-theory (disable fn2-abi-landings))

(defun fn2-abi-landedp (counts)
  (declare (xargs :verify-guards nil))
  (and (<= 1 (nfix (cdr (assoc-eq :e1-socket-reordered counts))))
       (<= 1 (nfix (cdr (assoc-eq :e1-storage-reordered counts))))
       (<= 1 (nfix (cdr (assoc-eq :e2-read-old counts))))
       (<= 1 (nfix (cdr (assoc-eq :e2-read-new counts))))))
(defun fn2-abi-check (fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* (((mv counts fn2-core fn2-sim fn2-own) (fn2-abi-landings fn2-core fn2-sim fn2-own))
       (- (cw "ABI LANDINGS ~x0~%" counts))
       (- (if (fn2-abi-landedp counts) nil
            (er hard? 'fn2-abi-check "Missing storage ABI landing: ~x0" counts))))
    (mv fn2-core fn2-sim fn2-own)))
(in-theory (disable fn2-abi-check))

; B1 block-device oracle. List images exist only in tests and checkers.
; Quarry: byte-store's outcome-per-operation, arbitrary tear-unit garbage,
; and fsyncgate; no inode, directory, FNLG or store-files representation.
; Fail-slow (papers row 19) is latency: this untimed safety model does not
; observe it. A delayed operation is simply still in flight.
(in-package "ACL2")
(include-book "owed")
(include-book "assumptions-integrity")

; Total, cheap, guard-verified list vocabulary, shared by all record readers.
(defun fn2-cm-at (n x)
  (declare (xargs :guard t :measure (nfix n)))
  (if (consp x) (if (posp n) (fn2-cm-at (- n 1) (cdr x)) (car x)) nil))
(defun fn2-cm-drop (n x)
  (declare (xargs :guard t :measure (nfix n)))
  (if (posp n) (if (consp x) (fn2-cm-drop (- n 1) (cdr x)) nil) x))
(defun fn2-cm-take (n x)
  (declare (xargs :guard t :measure (nfix n)))
  (if (and (posp n) (consp x))
      (cons (car x) (fn2-cm-take (- n 1) (cdr x))) nil))
(defun fn2-cm-repeat (n value)
  (declare (xargs :guard t :measure (nfix n)))
  (if (posp n) (cons value (fn2-cm-repeat (- n 1) value)) nil))
(defun fn2-cm-put (n value x)
  (declare (xargs :guard t :measure (nfix n)))
  (if (consp x)
      (if (posp n) (cons (car x) (fn2-cm-put (- n 1) value (cdr x)))
        (cons value (cdr x))) x))
(defun fn2-cm-octetsp (x)
  (declare (xargs :guard t))
  (if (consp x) (and (unsigned-byte-p 8 (car x)) (fn2-cm-octetsp (cdr x)))
    (null x)))
(defun fn2-cm-imagep (image unit)
  (declare (xargs :guard t))
  (if (consp image)
      (and (equal (len (car image)) unit) (fn2-cm-octetsp (car image))
           (fn2-cm-imagep (cdr image) unit))
    (null image)))

; One small record generator rather than hand-maintained accessor families.
(defun fn2-cm-readers (names index)
  (declare (xargs :mode :logic :guard (and (symbol-listp names) (natp index))))
  (if (endp names) nil
    (cons `(defun ,(car names) (x) (declare (xargs :guard t))
             (fn2-cm-at ,index x))
          (fn2-cm-readers (cdr names) (+ 1 index)))))
(defmacro fn2-cm-defreaders (&rest names)
  `(progn ,@(fn2-cm-readers names 0)))
(fn2-cm-defreaders fn2-cm-profile-kind fn2-cm-persistence-fence
  fn2-cm-integrity-evidence fn2-cm-independent-frontier fn2-cm-radius
  fn2-cm-corruption-budget)
(defun fn2-cm-profile (kind persistence-fence integrity-evidence independent-frontier radius corruption-budget)
  (declare (xargs :guard t))
  (list kind persistence-fence integrity-evidence independent-frontier radius corruption-budget))
(defun fn2-cm-profilep (p)
  (declare (xargs :guard t))
  (and (true-listp p) (equal (len p) 6)
       (member-eq (fn2-cm-profile-kind p) '(:crash-only :broad :lying))
       (booleanp (fn2-cm-persistence-fence p))
       (booleanp (fn2-cm-integrity-evidence p))
       (booleanp (fn2-cm-independent-frontier p))
       (natp (fn2-cm-radius p)) (natp (fn2-cm-corruption-budget p))
       (implies (eq (fn2-cm-profile-kind p) :crash-only)
                (and (fn2-cm-persistence-fence p)
                     (equal (fn2-cm-radius p) 0)
                     (equal (fn2-cm-corruption-budget p) 0)))))

; State = geometry, durable image, visible cache image, durable/visible
; completion stamps (per byte), completed-write log in completion order,
; in-flight writes, fence snapshots, sticky death, serial, faults spent,
; failed-barrier flag. Geometry = (sector-size tear-unit sectors radius).
(fn2-cm-defreaders fn2-cm-geometry fn2-cm-durable fn2-cm-visible
  fn2-cm-dstamps fn2-cm-vstamps fn2-cm-cache fn2-cm-inflight
  fn2-cm-fences fn2-cm-dead fn2-cm-serial fn2-cm-spent fn2-cm-failed)
(defun fn2-cm-unit (s) (declare (xargs :guard t))
  (let ((u (fn2-cm-at 1 (fn2-cm-geometry s)))) (if (posp u) u 512)))
(defun fn2-cm-size (s) (declare (xargs :guard t))
  (* (nfix (fn2-cm-at 0 (fn2-cm-geometry s)))
     (nfix (fn2-cm-at 2 (fn2-cm-geometry s)))))
(defun fn2-cm-init (sector-size tear-unit nsectors radius)
  (declare (xargs :guard t :verify-guards nil))
  (let* ((u (if (posp tear-unit) tear-unit 512))
         (image (fn2-cm-repeat (floor (* (nfix sector-size) (nfix nsectors)) u)
                               (fn2-cm-repeat u 0))))
    (list (list sector-size tear-unit nsectors radius) image image image image
          nil nil nil nil 0 0 nil)))
(defun fn2-cm-find (op rows)
  (declare (xargs :guard t))
  (if (consp rows)
      (if (equal op (fn2-cm-at 0 (car rows))) (car rows)
        (fn2-cm-find op (cdr rows))) nil))
(defun fn2-cm-remove (op rows)
  (declare (xargs :guard t))
  (if (consp rows)
      (if (equal op (fn2-cm-at 0 (car rows))) (cdr rows)
        (cons (car rows) (fn2-cm-remove op (cdr rows)))) nil))
(defun fn2-cm-range-p (s addr count)
  (declare (xargs :guard t))
  (and (natp addr) (natp count) (<= (+ addr count) (fn2-cm-size s))))

; Images are chunked for linear unit traversal, not repeated nth over a
; flat 256KiB list. These helpers work for bytes and for completion stamps.
(defun fn2-cm-splice-unit (old off bytes)
  (declare (xargs :guard t :verify-guards nil))
  (append (fn2-cm-take off old) bytes (fn2-cm-drop (+ (nfix off) (len bytes)) old)))
(defun fn2-cm-write-image (image addr bytes unit)
  (declare (xargs :guard t :verify-guards nil :measure (len image)))
  (if (or (atom image) (atom bytes) (not (posp unit))) image
    (if (>= (nfix addr) unit)
        (cons (car image) (fn2-cm-write-image (cdr image) (- (nfix addr) unit) bytes unit))
      (let* ((n (- unit (nfix addr))) (part (fn2-cm-take n bytes)))
        (cons (fn2-cm-splice-unit (car image) addr part)
              (fn2-cm-write-image (cdr image) 0 (fn2-cm-drop n bytes) unit))))))
(defun fn2-cm-read-image (image addr count unit)
  (declare (xargs :guard t :verify-guards nil :measure (len image)))
  (if (or (atom image) (not (posp count)) (not (posp unit))) nil
    (if (>= (nfix addr) unit)
        (fn2-cm-read-image (cdr image) (- (nfix addr) unit) count unit)
      (let* ((part (fn2-cm-take count (fn2-cm-drop addr (car image))))
             (n (len part)))
        (append part (fn2-cm-read-image (cdr image) 0 (- count n) unit))))))

; A fence is a frozen set, not the cache at completion. Per-byte versions
; prevent reversed fence completions from undoing a newer persisted write.
(defun fn2-cm-merge-unit (old ds new ns stamps-only)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp old)
      (cons (if (< (nfix (fn2-cm-at 0 ds)) (nfix (fn2-cm-at 0 ns)))
                (if stamps-only (fn2-cm-at 0 ns) (fn2-cm-at 0 new))
              (if stamps-only (fn2-cm-at 0 ds) (car old)))
            (fn2-cm-merge-unit (cdr old) (fn2-cm-drop 1 ds)
                               (fn2-cm-drop 1 new) (fn2-cm-drop 1 ns) stamps-only)) nil))
(defun fn2-cm-merge-image (old ds new ns stamps-only)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp old)
      (cons (fn2-cm-merge-unit (car old) (fn2-cm-at 0 ds)
                              (fn2-cm-at 0 new) (fn2-cm-at 0 ns) stamps-only)
            (fn2-cm-merge-image (cdr old) (fn2-cm-drop 1 ds)
                                (fn2-cm-drop 1 new) (fn2-cm-drop 1 ns) stamps-only)) nil))
(defun fn2-cm-persist-snapshot (s image stamps)
  (declare (xargs :guard t :verify-guards nil))
  (let ((new (fn2-cm-merge-image (fn2-cm-durable s) (fn2-cm-dstamps s) image stamps nil))
        (ns (fn2-cm-merge-image (fn2-cm-durable s) (fn2-cm-dstamps s) image stamps t)))
    (fn2-cm-put 3 ns (fn2-cm-put 1 new s))))

; In-flight row = (op intended-address bytes fua preflush-image preflush-stamps
;                  physical-address preflush-covered-writes).
; Completion replaces the final snapshot-set field with known-progress,
; completion-serial and outcome, producing a ten-field completed row.
(defun fn2-cm-submit-write (s op addr bytes fua)
  (declare (xargs :guard t :verify-guards nil))
  (if (or (not (fn2-cm-range-p s addr (len bytes)))
          (not (consp bytes)) (not (fn2-cm-octetsp bytes))
          (not (member-eq fua '(nil t :preflush-fua)))
          (fn2-cm-find op (fn2-cm-cache s))
          (fn2-cm-find op (fn2-cm-inflight s)) (fn2-cm-find op (fn2-cm-fences s))) s
    (fn2-cm-put 6
      (cons (list op addr bytes fua (fn2-cm-visible s) (fn2-cm-vstamps s) addr
                  (fn2-cm-cache s))
            (fn2-cm-inflight s)) s)))
(defun fn2-cm-write-outcome-p (s row outcome profile)
  (declare (xargs :guard t :verify-guards nil))
  (let* ((code (if (consp outcome) (car outcome) outcome))
         (addr (if (eq code :short) (fn2-cm-at 2 outcome)
                 (if (consp outcome) (fn2-cm-at 1 outcome) (fn2-cm-at 6 row))))
         (n (if (eq code :ok) (len (fn2-cm-at 2 row))
              (if (eq code :short) (fn2-cm-at 1 outcome) 0))))
    (and row (fn2-cm-profilep profile)
         (member-eq code '(:ok :io :no-space :short))
         (or (not (fn2-cm-dead s)) (eq code :io))
         (or (not (eq (fn2-cm-at 2 outcome) :lose-fua))
             (not (fn2-cm-persistence-fence profile)))
         (natp n) (<= n (len (fn2-cm-at 2 row)))
         (or (not (eq (fn2-cm-at 3 row) :preflush-fua))
             (eq code :ok) (equal n 0))
         (fn2-cm-range-p s addr (len (fn2-cm-at 2 row)))
         (or (equal addr (fn2-cm-at 1 row))
             (not (eq (fn2-cm-profile-kind profile) :crash-only)))
         (or (not (eq (fn2-cm-profile-kind profile) :crash-only)) (eq code :ok)))))
(defun fn2-cm-complete-write (s op outcome profile)
  (declare (xargs :guard t :verify-guards nil))
  (let* ((row (fn2-cm-find op (fn2-cm-inflight s)))
         (code (if (consp outcome) (car outcome) outcome))
         (addr (if (eq code :short) (fn2-cm-at 2 outcome)
                 (if (consp outcome) (fn2-cm-at 1 outcome) (fn2-cm-at 6 row))))
         (n (if (eq code :ok) (len (fn2-cm-at 2 row))
              (if (eq code :short) (nfix (fn2-cm-at 1 outcome)) 0)))
         (bytes (fn2-cm-take n (fn2-cm-at 2 row)))
         (stamp (+ 1 (nfix (fn2-cm-serial s)))) (unit (fn2-cm-unit s)))
    (if (or (not (fn2-cm-write-outcome-p s row outcome profile))
            (not (unsigned-byte-p 60 stamp))) s
      (let* ((s (if (and (eq (fn2-cm-at 3 row) :preflush-fua)
                         (eq code :ok) (fn2-cm-persistence-fence profile))
                    (fn2-cm-persist-snapshot s (fn2-cm-at 4 row) (fn2-cm-at 5 row)) s))
             (s (fn2-cm-put 2 (fn2-cm-write-image (fn2-cm-visible s) addr bytes unit) s))
             (s (fn2-cm-put 4 (fn2-cm-write-image (fn2-cm-vstamps s) addr
                                    (fn2-cm-repeat n stamp) unit) s))
             ; Known short progress of an FUA request can itself persist;
             ; the unreported suffix remains uncertain, not rolled back.
             (s (if (and (fn2-cm-at 3 row)
                         (not (eq (fn2-cm-at 2 outcome) :lose-fua)))
                    (fn2-cm-put 3 (fn2-cm-write-image (fn2-cm-dstamps s) addr
                                          (fn2-cm-repeat n stamp) unit)
                      (fn2-cm-put 1 (fn2-cm-write-image (fn2-cm-durable s) addr bytes unit) s)) s))
             (done (append (fn2-cm-take 6
                             (if (and (eq (fn2-cm-at 3 row) :preflush-fua)
                                      (eq code :ok))
                                 (fn2-cm-put 3 :fua-after-preflush row) row))
                           (list addr n stamp code)))
             (s (fn2-cm-put 5 (append (fn2-cm-cache s) (list done)) s))
             (s (fn2-cm-put 6 (fn2-cm-remove op (fn2-cm-inflight s)) s)))
        (fn2-cm-put 9 stamp s)))))

; Physical misdirection may happen before completion (including a crash
; that never delivers completion). Intended and physical addresses survive
; separately in the write row. The fault is an explicit environment choice.
(defun fn2-cm-replace-row (op row rows)
  (declare (xargs :guard t))
  (if (consp rows)
      (if (equal op (fn2-cm-at 0 (car rows))) (cons row (cdr rows))
        (cons (car rows) (fn2-cm-replace-row op row (cdr rows)))) nil))
(defun fn2-cm-redirect-write (s op physical profile)
  (declare (xargs :guard t :verify-guards nil))
  (let ((row (fn2-cm-find op (fn2-cm-inflight s))))
    (if (not (and row (fn2-cm-profilep profile)
                  (not (eq (fn2-cm-profile-kind profile) :crash-only))
                  (fn2-cm-range-p s physical (len (fn2-cm-at 2 row))))) s
      (fn2-cm-put 6 (fn2-cm-replace-row op (fn2-cm-put 6 physical row)
                                       (fn2-cm-inflight s)) s))))

(defun fn2-cm-submit-fence (s op)
  (declare (xargs :guard t :verify-guards nil))
  (if (or (fn2-cm-find op (fn2-cm-inflight s))
          (fn2-cm-find op (fn2-cm-fences s))) s
    (fn2-cm-put 7 (cons (list op (fn2-cm-visible s) (fn2-cm-vstamps s)
                                 (fn2-cm-cache s)) (fn2-cm-fences s)) s)))

; Since :garbage ranges over ALL octet strings, a tearable unit admits any
; unit-sized octet list. This is exact per-unit membership, not an enumeration
; of write subsets or permutations. Clean units must remain byte-identical.
(defun fn2-cm-touches-p (rows start end radius completed-only)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp rows)
      (let* ((r (car rows))
             (addr (nfix (fn2-cm-at 6 r)))
             (n (len (fn2-cm-at 2 r))))
        (or (and (< (- addr (nfix radius)) (nfix end))
                 (< (nfix start) (+ addr n (nfix radius)))
                 (not (eq (fn2-cm-at 3 r) :preflush-fua))
                 (or (not completed-only) (not (eq (fn2-cm-at 9 r) :ok))))
            (fn2-cm-touches-p (cdr rows) start end radius completed-only))) nil))
(defun fn2-cm-stamps-aheadp (vs ds)
  (declare (xargs :guard t))
  (if (consp vs)
      (or (> (nfix (car vs)) (nfix (fn2-cm-at 0 ds)))
          (fn2-cm-stamps-aheadp (cdr vs) (fn2-cm-drop 1 ds))) nil))
(defun fn2-cm-crash-units-allowedp (image durable vs ds flights cache i unit radius)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp durable)
      (and (consp image)
           (fn2-cm-octetsp (car image)) (equal (len (car image)) unit)
           (or (equal (car image) (car durable))
               (fn2-cm-stamps-aheadp (fn2-cm-at 0 vs) (fn2-cm-at 0 ds))
               (fn2-cm-touches-p flights (* (nfix i) (nfix unit))
                                 (* (+ 1 (nfix i)) (nfix unit)) radius nil)
               (fn2-cm-touches-p cache (* (nfix i) (nfix unit))
                                 (* (+ 1 (nfix i)) (nfix unit)) 0 t))
           (fn2-cm-crash-units-allowedp (cdr image) (cdr durable)
             (fn2-cm-drop 1 vs) (fn2-cm-drop 1 ds) flights cache
             (+ 1 (nfix i)) unit radius))
    (null image)))
(defun fn2-cm-crash-image-allowedp (s image profile)
  (declare (xargs :guard t :verify-guards nil))
  (and (fn2-cm-profilep profile)
       (fn2-cm-crash-units-allowedp image (fn2-cm-durable s)
         (fn2-cm-vstamps s) (fn2-cm-dstamps s)
         (fn2-cm-inflight s) (fn2-cm-cache s) 0 (fn2-cm-unit s)
         (if (eq (fn2-cm-profile-kind profile) :crash-only) 0
           (* (min (nfix (fn2-cm-radius profile))
                   (nfix (fn2-cm-at 3 (fn2-cm-geometry s))))
              (nfix (fn2-cm-at 0 (fn2-cm-geometry s))))))))

(defun fn2-cm-fence-image (s op)
  (declare (xargs :guard t :verify-guards nil))
  (let ((row (fn2-cm-find op (fn2-cm-fences s))))
    (fn2-cm-merge-image (fn2-cm-durable s) (fn2-cm-dstamps s)
                         (fn2-cm-at 1 row) (fn2-cm-at 2 row) nil)))
; A lying device may still execute an honest fence. The environment can
; distinguish (:ok :persist) from (:ok :lie) even when the observed bytes
; happen to agree. Plain :ok uses the profile's stated fence assumption.
(defun fn2-cm-fence-code (outcome)
  (declare (xargs :guard t))
  (if (consp outcome) (car outcome) outcome))
(defun fn2-cm-fence-persists-p (outcome profile)
  (declare (xargs :guard t))
  (and (eq (fn2-cm-fence-code outcome) :ok)
       (or (equal outcome '(:ok :persist))
           (and (eq outcome :ok) (fn2-cm-persistence-fence profile)))))
(defun fn2-cm-fence-allowedp (s op outcome image profile)
  (declare (xargs :guard t :verify-guards nil))
  (let ((row (fn2-cm-find op (fn2-cm-fences s))))
    (and row (fn2-cm-profilep profile)
         (member-equal outcome '(:ok :io (:ok :persist) (:ok :lie)))
         (or (not (equal outcome '(:ok :lie)))
             (not (fn2-cm-persistence-fence profile)))
         (or (not (fn2-cm-dead s)) (eq (fn2-cm-fence-code outcome) :io))
         (if (fn2-cm-fence-persists-p outcome profile)
             (equal image (fn2-cm-fence-image s op))
           (and (not (eq (fn2-cm-profile-kind profile) :crash-only))
                (fn2-cm-crash-units-allowedp image (fn2-cm-durable s)
                  (fn2-cm-at 2 row) (fn2-cm-dstamps s) nil
                  (fn2-cm-at 3 row) 0 (fn2-cm-unit s) 0))))))
(defun fn2-cm-complete-fence (s op outcome image profile)
  (declare (xargs :guard t :verify-guards nil))
  (if (not (fn2-cm-fence-allowedp s op outcome image profile)) s
    (let* ((row (fn2-cm-find op (fn2-cm-fences s)))
           (s (if (fn2-cm-fence-persists-p outcome profile)
                  (fn2-cm-persist-snapshot s (fn2-cm-at 1 row) (fn2-cm-at 2 row))
                (fn2-cm-put 1 image s)))
           (s (fn2-cm-put 7 (fn2-cm-remove op (fn2-cm-fences s)) s)))
      (if (eq outcome :io) (fn2-cm-put 11 t s) s))))

; The preflush phase precedes the sealing write. Making that phase explicit
; exposes the process-death cut and the successful-preflush/short-write case.
; A failed preflush aborts the request before its own bytes start; its covered
; writes remain uncertain. :ok final completion also supplies an atomic
; convenience path which performs both phases with no intervening observation.
(defun fn2-cm-complete-preflush (s op outcome image profile)
  (declare (xargs :guard t :verify-guards nil))
  (let* ((row (fn2-cm-find op (fn2-cm-inflight s)))
         (original (fn2-cm-fences s))
         (temporary (fn2-cm-put 7
                      (cons (list op (fn2-cm-at 4 row) (fn2-cm-at 5 row) (fn2-cm-at 7 row))
                            original) s)))
    (if (not (and row (eq (fn2-cm-at 3 row) :preflush-fua)
                  (fn2-cm-fence-allowedp temporary op outcome image profile))) s
      (let ((after (fn2-cm-put 7 original
                     (fn2-cm-complete-fence temporary op outcome image profile))))
        (if (eq (fn2-cm-fence-code outcome) :io)
            (fn2-cm-put 6 (fn2-cm-remove op (fn2-cm-inflight after)) after)
          (fn2-cm-put 6
            (fn2-cm-replace-row op (fn2-cm-put 3 :fua-after-preflush row)
                                (fn2-cm-inflight after)) after))))))

(defun fn2-cm-read-allowedp (s addr outcome bytes profile)
  (declare (xargs :guard t :verify-guards nil))
  (and (fn2-cm-profilep profile)
       (if (eq outcome :io)
           (and (not (eq (fn2-cm-profile-kind profile) :crash-only)) (null bytes))
         (let ((physical (if (eq outcome :ok) addr (fn2-cm-at 1 outcome))))
           (and (not (fn2-cm-dead s))
                (or (eq outcome :ok)
                    (and (true-listp outcome) (equal (len outcome) 2)
                         (eq (fn2-cm-at 0 outcome) :misdirect)
                         (not (eq (fn2-cm-profile-kind profile) :crash-only))))
                (fn2-cm-range-p s addr (len bytes))
                (fn2-cm-range-p s physical (len bytes))
                (equal bytes (fn2-cm-read-image (fn2-cm-visible s) physical
                                                (len bytes) (fn2-cm-unit s))))))))
(defun fn2-cm-reopen (s revert)
  (declare (xargs :guard t :verify-guards nil))
  (cond
   ; fsyncgate: pages may remain readable after the kernel marks them clean
   ; and forgets the failed writeback. A later successful fence fences no
   ; such bytes; cache visibility is explicitly NOT persistence evidence.
   ((and (eq revert :cached-lost) (fn2-cm-failed s))
    (fn2-cm-put 5 nil (fn2-cm-put 4 (fn2-cm-dstamps s) s)))
   (revert
    (fn2-cm-put 5 nil (fn2-cm-put 4 (fn2-cm-dstamps s)
                        (fn2-cm-put 2 (fn2-cm-durable s) s))))
   (t s)))
(defun fn2-cm-crash (s image profile)
  (declare (xargs :guard t :verify-guards nil))
  (if (not (fn2-cm-crash-image-allowedp s image profile)) s
    (let* ((s (fn2-cm-put 1 image (fn2-cm-put 2 image s)))
           (s (fn2-cm-put 3 (fn2-cm-vstamps s) s))
           (s (fn2-cm-put 5 nil (fn2-cm-put 6 nil (fn2-cm-put 7 nil s)))))
      (fn2-cm-put 11 nil s))))
(defun fn2-cm-kill-device (s)
  (declare (xargs :guard t)) (fn2-cm-put 8 t s))

; Explicit at-rest corruption consumes one budget unit per affected tear
; unit. It can occur between ANY operations. No hidden corruption allowance
; in a read/fence/crash membership test can excuse an invented clean byte.
(defun fn2-cm-corrupt-visible-unit (old new vs ds)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp old)
      (cons (if (equal (fn2-cm-at 0 vs) (fn2-cm-at 0 ds))
                (fn2-cm-at 0 new) (car old))
            (fn2-cm-corrupt-visible-unit (cdr old) (fn2-cm-drop 1 new)
              (fn2-cm-drop 1 vs) (fn2-cm-drop 1 ds))) nil))
(defun fn2-cm-corrupt (s unit bytes profile)
  (declare (xargs :guard t :verify-guards nil))
  (if (not (and (fn2-cm-profilep profile)
                (not (eq (fn2-cm-profile-kind profile) :crash-only))
                (< (nfix (fn2-cm-spent s)) (fn2-cm-corruption-budget profile))
                (natp unit) (< unit (len (fn2-cm-durable s)))
                (equal (len bytes) (fn2-cm-unit s)) (fn2-cm-octetsp bytes))) s
    (let* ((v (fn2-cm-corrupt-visible-unit (fn2-cm-at unit (fn2-cm-visible s)) bytes
                 (fn2-cm-at unit (fn2-cm-vstamps s)) (fn2-cm-at unit (fn2-cm-dstamps s))))
           (s (fn2-cm-put 1 (fn2-cm-put unit bytes (fn2-cm-durable s)) s))
           (s (fn2-cm-put 2 (fn2-cm-put unit v (fn2-cm-visible s)) s)))
      (fn2-cm-put 10 (+ 1 (nfix (fn2-cm-spent s))) s))))

; A tear can be injected before process death (A's fault 11). Landing alone
; establishes no persistence guarantee and does not advance fence stamps.
(defun fn2-cm-land-live (s image profile)
  (declare (xargs :guard t :verify-guards nil))
  (if (fn2-cm-crash-image-allowedp s image profile) (fn2-cm-put 1 image s) s))

(defun fn2-cm-stamp-unitp (xs serial)
  (declare (xargs :guard t))
  (if (consp xs)
      (and (unsigned-byte-p 60 (car xs)) (<= (car xs) (nfix serial))
           (fn2-cm-stamp-unitp (cdr xs) serial)) (null xs)))
(defun fn2-cm-stampsp (xs unit serial)
  (declare (xargs :guard t))
  (if (consp xs)
      (and (equal (len (car xs)) unit) (fn2-cm-stamp-unitp (car xs) serial)
           (fn2-cm-stampsp (cdr xs) unit serial)) (null xs)))
(defun fn2-cm-write-rows-p (rows s complete)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp rows)
      (let ((r (car rows)))
        (and (true-listp r) (equal (len r) (if complete 10 8))
             (fn2-cm-octetsp (fn2-cm-at 2 r)) (consp (fn2-cm-at 2 r))
             (fn2-cm-range-p s (fn2-cm-at 1 r) (len (fn2-cm-at 2 r)))
             (fn2-cm-range-p s (fn2-cm-at 6 r) (len (fn2-cm-at 2 r)))
             (member-eq (fn2-cm-at 3 r) '(nil t :preflush-fua :fua-after-preflush))
             (fn2-cm-imagep (fn2-cm-at 4 r) (fn2-cm-unit s))
             (equal (len (fn2-cm-at 4 r)) (len (fn2-cm-durable s)))
             (fn2-cm-stampsp (fn2-cm-at 5 r) (fn2-cm-unit s) (fn2-cm-serial s))
             (equal (len (fn2-cm-at 5 r)) (len (fn2-cm-durable s)))
             (or (not complete)
                 (and (fn2-cm-range-p s (fn2-cm-at 6 r) (len (fn2-cm-at 2 r)))
                      (natp (fn2-cm-at 7 r)) (<= (fn2-cm-at 7 r) (len (fn2-cm-at 2 r)))
                      (unsigned-byte-p 60 (fn2-cm-at 8 r))
                      (<= (fn2-cm-at 8 r) (nfix (fn2-cm-serial s)))
                      (member-eq (fn2-cm-at 9 r) '(:ok :io :no-space :short))))
             (not (fn2-cm-find (fn2-cm-at 0 r) (cdr rows)))
             (fn2-cm-write-rows-p (cdr rows) s complete))) (null rows)))
; Preflush coverage is frozen at submission, including ambiguous completed
; writes whose known byte progress was zero. Later completions are not covered.
(defun fn2-cm-preflush-snapshotsp (rows s)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp rows)
      (and (fn2-cm-write-rows-p (fn2-cm-at 7 (car rows)) s t)
           (fn2-cm-preflush-snapshotsp (cdr rows) s)) (null rows)))
(defun fn2-cm-fence-rows-p (rows s)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp rows)
      (let ((r (car rows)))
        (and (true-listp r) (equal (len r) 4)
             (fn2-cm-imagep (fn2-cm-at 1 r) (fn2-cm-unit s))
             (equal (len (fn2-cm-at 1 r)) (len (fn2-cm-durable s)))
             (fn2-cm-stampsp (fn2-cm-at 2 r) (fn2-cm-unit s) (fn2-cm-serial s))
             (equal (len (fn2-cm-at 2 r)) (len (fn2-cm-durable s)))
             (fn2-cm-write-rows-p (fn2-cm-at 3 r) s t)
             (not (fn2-cm-find (fn2-cm-at 0 r) (cdr rows)))
             (fn2-cm-fence-rows-p (cdr rows) s))) (null rows)))
(defun fn2-cm-row-ids-disjointp (rows others)
  (declare (xargs :guard t))
  (if (consp rows)
      (and (not (fn2-cm-find (fn2-cm-at 0 (car rows)) others))
           (fn2-cm-row-ids-disjointp (cdr rows) others)) t))
(defun fn2-cm-statep (s)
  (declare (xargs :guard t :verify-guards nil))
  (let* ((g (fn2-cm-geometry s)) (sector (fn2-cm-at 0 g))
         (unit (fn2-cm-at 1 g)) (sectors (fn2-cm-at 2 g)))
    (and (true-listp s) (equal (len s) 12)
         (true-listp g) (equal (len g) 4) (equal unit 512)
         (posp sector) (equal (mod sector 512) 0) (posp sectors)
         (unsigned-byte-p 60 (* sector sectors)) (natp (fn2-cm-at 3 g))
         (fn2-cm-imagep (fn2-cm-durable s) unit)
         (fn2-cm-imagep (fn2-cm-visible s) unit)
         (equal (len (fn2-cm-durable s)) (floor (* sector sectors) unit))
         (equal (len (fn2-cm-visible s)) (len (fn2-cm-durable s)))
         (unsigned-byte-p 60 (fn2-cm-serial s))
         (fn2-cm-stampsp (fn2-cm-dstamps s) unit (fn2-cm-serial s))
         (fn2-cm-stampsp (fn2-cm-vstamps s) unit (fn2-cm-serial s))
         (equal (len (fn2-cm-dstamps s)) (len (fn2-cm-durable s)))
         (equal (len (fn2-cm-vstamps s)) (len (fn2-cm-durable s)))
         (fn2-cm-write-rows-p (fn2-cm-cache s) s t)
         (fn2-cm-write-rows-p (fn2-cm-inflight s) s nil)
         (fn2-cm-preflush-snapshotsp (fn2-cm-inflight s) s)
         (fn2-cm-row-ids-disjointp (fn2-cm-inflight s) (fn2-cm-cache s))
         (fn2-cm-row-ids-disjointp (fn2-cm-inflight s) (fn2-cm-fences s))
         (fn2-cm-fence-rows-p (fn2-cm-fences s) s)
         (booleanp (fn2-cm-dead s)) (booleanp (fn2-cm-failed s))
         (natp (fn2-cm-spent s)))))

; Logical dispatcher names the actual exports, shared by teeth and statement.
(defun fn2-cm-step (s event profile)
  (declare (xargs :guard t :verify-guards nil))
  (case (fn2-cm-at 0 event)
    (:submit-write (fn2-cm-submit-write s (fn2-cm-at 1 event) (fn2-cm-at 2 event)
                                        (fn2-cm-at 3 event) (fn2-cm-at 4 event)))
    (:complete-write (fn2-cm-complete-write s (fn2-cm-at 1 event) (fn2-cm-at 2 event) profile))
    (:redirect-write (fn2-cm-redirect-write s (fn2-cm-at 1 event) (fn2-cm-at 2 event) profile))
    (:complete-preflush (fn2-cm-complete-preflush s (fn2-cm-at 1 event)
                         (fn2-cm-at 2 event) (fn2-cm-at 3 event) profile))
    (:submit-fence (fn2-cm-submit-fence s (fn2-cm-at 1 event)))
    (:complete-fence (fn2-cm-complete-fence s (fn2-cm-at 1 event) (fn2-cm-at 2 event)
                                            (fn2-cm-at 3 event) profile))
    (:crash (fn2-cm-crash s (fn2-cm-at 1 event) profile))
    (:land-live (fn2-cm-land-live s (fn2-cm-at 1 event) profile))
    (:reopen (fn2-cm-reopen s (fn2-cm-at 1 event)))
    (:dead (fn2-cm-kill-device s))
    (:corrupt (fn2-cm-corrupt s (fn2-cm-at 1 event) (fn2-cm-at 2 event) profile))
    (otherwise s)))
(defthm-owed fn2-cm-well-formedness (s event profile)
  (implies (fn2-cm-statep s) (fn2-cm-statep (fn2-cm-step s event profile)))
  :teeth "crash-model-unit: every dispatcher arm; malformed durable image retained by read falsifies pre/post."
  :doc "Preservation of geometry, image/stamp shapes, typed pending records and sticky state, every export.")

; The fence claim concerns the tear units touched by its successfully
; completed covered writes. Unrelated outstanding/volatile writes may still
; land, reorder or tear; they do not require global quiescence. B3 establishes
; isolation of covered units, including the declared collateral-damage radius.
(defun fn2-cm-covered-unit-p (rows start end)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp rows)
      (or (and (eq (fn2-cm-at 9 (car rows)) :ok)
               (fn2-cm-touches-p (list (car rows)) start end 0 nil))
          (fn2-cm-covered-unit-p (cdr rows) start end)) nil))

; A persisted newer version supersedes the snapshot. An equal persisted
; version must still contain its bytes: a fence does not rewrite a version
; whose stamp already says durable. This is a pre-operation version-coherence
; premise, not equality of the proposed fence/crash image to the conclusion.
(defun fn2-cm-covered-versions-p (durable ds snapshot ns)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp snapshot)
      (and (consp durable) (consp ds) (consp ns)
           (<= (nfix (car ds)) (nfix (car ns)))
           (or (< (nfix (car ds)) (nfix (car ns)))
               (equal (car durable) (car snapshot)))
           (fn2-cm-covered-versions-p (cdr durable) (cdr ds)
                                       (cdr snapshot) (cdr ns)))
    t))

(defun fn2-cm-fence-isolatedp (snapshot ns durable ds vs flights cache covered i unit radius)
  (declare (xargs :guard t :verify-guards nil))
  (if (consp snapshot)
      (let ((start (* (nfix i) (nfix unit)))
            (end (* (+ 1 (nfix i)) (nfix unit))))
        (and (or (not (fn2-cm-covered-unit-p covered start end))
                 (and (equal (fn2-cm-at 0 ns) (fn2-cm-at 0 vs))
                      (fn2-cm-covered-versions-p (fn2-cm-at 0 durable)
                        (fn2-cm-at 0 ds) (car snapshot) (fn2-cm-at 0 ns))
                      (not (fn2-cm-touches-p flights start end radius nil))
                      (not (fn2-cm-touches-p cache start end 0 t))))
             (fn2-cm-fence-isolatedp (cdr snapshot) (fn2-cm-drop 1 ns)
               (fn2-cm-drop 1 durable) (fn2-cm-drop 1 ds) (fn2-cm-drop 1 vs)
               flights cache covered (+ 1 (nfix i)) unit radius)))
    t))

(defun fn2-cm-covered-imagep (image snapshot covered i unit)
  (declare (xargs :guard t :verify-guards nil :measure (len snapshot)))
  (if (consp snapshot)
      (and (or (not (fn2-cm-covered-unit-p covered (* (nfix i) (nfix unit))
                                            (* (+ 1 (nfix i)) (nfix unit))))
               (equal (fn2-cm-at 0 image) (car snapshot)))
           (fn2-cm-covered-imagep (fn2-cm-drop 1 image) (cdr snapshot) covered
                                   (+ 1 (nfix i)) unit))
    t))

(defun fn2-cm-fence-durability-hyps (s op image profile)
  (declare (xargs :guard t :verify-guards nil))
  (let ((row (fn2-cm-find op (fn2-cm-fences s))))
    (and (fn2-cm-statep s) (fn2-cm-profilep profile)
         (fn2-cm-persistence-fence profile) (not (fn2-cm-dead s)) row
         (equal (fn2-cm-spent s) 0) (not (fn2-cm-failed s))
         (fn2-cm-fence-isolatedp (fn2-cm-at 1 row) (fn2-cm-at 2 row)
           (fn2-cm-durable s) (fn2-cm-dstamps s) (fn2-cm-vstamps s)
           (fn2-cm-inflight s) (fn2-cm-cache s) (fn2-cm-at 3 row) 0 (fn2-cm-unit s)
           (* (min (nfix (fn2-cm-radius profile))
                   (nfix (fn2-cm-at 3 (fn2-cm-geometry s))))
              (nfix (fn2-cm-at 0 (fn2-cm-geometry s)))))
         (fn2-cm-fence-allowedp s op :ok image profile))))
(defun fn2-cm-fence-durability-concl (s op image crash-image profile)
  (declare (xargs :guard t :verify-guards nil))
  (let ((after (fn2-cm-complete-fence s op :ok image profile))
        (row (fn2-cm-find op (fn2-cm-fences s))))
    (implies (fn2-cm-crash-image-allowedp after crash-image profile)
             (fn2-cm-covered-imagep crash-image (fn2-cm-at 1 row)
                                     (fn2-cm-at 3 row) 0 (fn2-cm-unit s)))))
(defthm-owed fn2-cm-honest-fence-durability (s op image crash-image profile)
  (implies (fn2-cm-fence-durability-hyps s op image profile)
           (fn2-cm-fence-durability-concl s op image crash-image profile))
  :teeth "crash-model-unit: covered write survives beside an unrelated torn in-flight write; overlapping in-flight write and lying fence each falsify the conclusion when their premise is removed; stale-version regressions reject destructive crash images."
  :doc "Successful honest fence preserves covered resolved tear units in every allowed crash image under unit isolation and version coherence; unrelated pending work is permitted.")

; FUA's immediate effect, NOT an assertion that a later crash cannot also
; land earlier unrelated volatile writes. The final-sector-only protocol is
; refuted by an allowed crash retaining the final sector and losing its deps.
(defun fn2-cm-fua-only-hyps (s op outcome profile addr count)
  (declare (xargs :guard t :verify-guards nil))
  (let* ((row (fn2-cm-find op (fn2-cm-inflight s)))
         (target (fn2-cm-at 1 outcome)) (n (len (fn2-cm-at 2 row))))
    (and (fn2-cm-statep s) (fn2-cm-write-outcome-p s row outcome profile)
         (eq (fn2-cm-at 0 outcome) :ok) (eq (fn2-cm-at 3 row) t)
         (fn2-cm-range-p s addr count) (natp target)
         (or (<= (+ addr count) target) (<= (+ target n) addr)))))
(defun fn2-cm-fua-only-concl (s op outcome profile addr count)
  (declare (xargs :guard t :verify-guards nil))
  (equal (fn2-cm-read-image
           (fn2-cm-durable (fn2-cm-complete-write s op outcome profile))
           addr count (fn2-cm-unit s))
         (fn2-cm-read-image (fn2-cm-durable s) addr count (fn2-cm-unit s))))
(defthm-owed fn2-cm-fua-alone (s op outcome profile addr count)
  (implies (fn2-cm-fua-only-hyps s op outcome profile addr count)
           (fn2-cm-fua-only-concl s op outcome profile addr count))
  :teeth "crash-model-unit: unrelated volatile dependency unchanged; preflush-FUA removes own-only hypothesis and persists it."
  :doc "Plain FUA only persists its request. Preflush+FUA is a distinct primitive contract.")

(in-theory (disable fn2-cm-statep fn2-cm-step fn2-cm-submit-write
 fn2-cm-complete-write fn2-cm-submit-fence fn2-cm-complete-fence
 fn2-cm-crash-image-allowedp fn2-cm-fence-allowedp fn2-cm-read-allowedp
 fn2-cm-crash fn2-cm-corrupt fn2-cm-reopen fn2-cm-land-live))

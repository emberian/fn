; Layer A continuations. Each run emits at most one descriptor; echo lends
; the exact RX bytes and waits for every borrow before resetting its window.
(in-package "ACL2")
(include-book "machines-a-access")
(include-book "machines-a-scribe")

(defun fn2-machine-dec (n)
  (declare (xargs :guard (natp n)))
  (if (zp n) 0 (- n 1)))

; Observation routing is direct state mutation. In particular a receive,
; send terminal, and separate release cannot overwrite one event mailbox.
; Scribe has one operation at a time, hence its one reserved result bit.
(defun fn2-machine-observe (okind id gen event outcome reason count aux0 aux1 fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core))
           (ignore reason))
  (if (not (and (unsigned-byte-p 32 id)
                (equal gen (fn2-machine-generation id fn2-core))
                (equal okind (fn2-machine-kind id fn2-core))
                (not (equal (fn2-machine-phase id fn2-core) *fn2-echo-state-free*))))
      (mv 4294967295 fn2-core)
    (let* ((kind (fn2-machine-kind id fn2-core))
           (pending (fn2-machine-pending id fn2-core))
           (borrows (fn2-machine-pool-borrows
                     (fn2-machine-pool-slot id fn2-core) fn2-core))
           (fn2-core (if (equal event *fn2-event-borrow-released*)
                         (fn2-machine-set-borrows id borrows fn2-core)
                       (fn2-machine-set-pending id (fn2-machine-dec pending) fn2-core)))
           (fn2-core
            (cond
             ((equal kind *fn2-scribe-kind*)
              (fn2-machine-put id (event event) (outcome outcome)
                (count count) (aux0 aux0) (aux1 aux1) (event-ready 1)))
             ((equal event *fn2-event-accept-result*)
              (if (equal outcome *fn2-outcome-done*)
                  (fn2-machine-put id (cap-index aux0) (cap-nonce aux1)
                    (event-ready 1))
                (fn2-machine-put id (event-ready 0))))
             ((equal event *fn2-event-receive-result*)
              (if (and (or (equal outcome *fn2-outcome-done*)
                           (equal outcome *fn2-outcome-short*))
                       (unsigned-byte-p 32 count) (< 0 count))
                  (fn2-machine-put id (length count) (off 0) (phase *fn2-echo-state-reply*))
                (fn2-machine-set-phase id *fn2-echo-state-closing* fn2-core)))
             ((equal event *fn2-event-send-result*)
              (let* ((off (fn2-machine-off id fn2-core))
                     (len (fn2-machine-length id fn2-core))
                     (fn2-core (fn2-machine-set-borrows id borrows fn2-core)))
                (if (and (or (equal outcome *fn2-outcome-done*)
                             (equal outcome *fn2-outcome-short*))
                         (natp count) (<= (+ off count) len))
                    (fn2-machine-set-off id (+ off count) fn2-core)
                  (fn2-machine-set-phase id *fn2-echo-state-closing* fn2-core))))
             ((equal event *fn2-event-close-result*)
              (if (equal kind *fn2-listener-kind*)
                  (fn2-machine-put id (phase *fn2-echo-state-accepting*) (event-ready 0))
                (fn2-machine-set-phase id *fn2-echo-state-draining* fn2-core)))
             (t fn2-core))))
      ; A release can arrive while Close is parked for descriptor credit.
      ; Keep the row exclusively on its indexed resource wait list until
      ; grant-one unlinks it; otherwise a runnable run could recycle a row
      ; while a stale resource link still names it.
      (mv (if (or (equal (fn2-machine-wait-reason id fn2-core) 2)
                  (equal (fn2-machine-wait-reason id fn2-core) 3)
                  (equal (fn2-machine-stopped id fn2-core) 1))
              4294967295 id)
          fn2-core))))
(fn2-core-shape-lemmas fn2-machine-observe
  (okind id gen event outcome reason count aux0 aux1) 1)

(defun fn2-machine-issue-result (id code bytes fn2-core)
  (declare (xargs :stobjs fn2-core :guard (and (fn2-core-wfp fn2-core) (natp bytes) (<= bytes 4096))))
  (if (eq code :ok)
      (let ((fn2-core (fn2-machine-put id (pending 1) (wait-reason 1))))
        (fn2-machine-result bytes 8 1 nil fn2-core))
    (if (eq code :exhausted)
        (let ((fn2-core (fn2-machine-park id fn2-core)))
          (fn2-machine-result 0 8 0 nil fn2-core))
      ; TODO R6-NONEXHAUSTION-REFUSAL: replace this retained stop with the
      ; named close/release or evidence posture chosen by R6.
      (let ((fn2-core (fn2-machine-put id (stopped 1) (wait-reason 0))))
        (fn2-machine-result 0 8 0 nil fn2-core)))))
(fn2-core-shape-lemmas fn2-machine-issue-result (id code bytes) 4)

(defun fn2-listener-admit (id fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (let* ((target (if (equal (fn2-machine-echo-mode fn2-core) 1)
                     (fn2-machine-free-head fn2-core) (fn2-machine-null-free-head fn2-core)))
         (gen (fn2-machine-generation target fn2-core))
         (kind (if (equal (fn2-machine-echo-mode fn2-core) 1) *fn2-echo-kind* *fn2-null-kind*)))
    (if (or (equal target 4294967295)
            (>= (fn2-machine-active-count fn2-core) (fn2-machine-connection-count fn2-core)))
        (let ((fn2-core (fn2-machine-set-phase id *fn2-echo-state-closing* fn2-core)))
          (fn2-machine-result 0 4 0 t fn2-core))
      (mv-let (code slot poolgen fn2-core)
        (fn2-core-reserve 0 kind target gen fn2-core)
        (if (not (eq code :ok))
            (let ((fn2-core (fn2-machine-set-phase id *fn2-echo-state-closing* fn2-core)))
              (fn2-machine-result 0 6 0 t fn2-core))
          (let* ((next (fn2-machine-next-free target fn2-core))
                 (index (fn2-machine-cap-index id fn2-core))
                 (nonce (fn2-machine-cap-nonce id fn2-core))
                 (fn2-core (if (equal kind *fn2-echo-kind*)
                               (fn2-machine-set-free-head next fn2-core)
                             (fn2-machine-set-null-free-head next fn2-core)))
                 (fn2-core (fn2-machine-set-active-count
                             (+ 1 (fn2-machine-active-count fn2-core)) fn2-core))
                 (fn2-core (fn2-machine-put target
                             (phase *fn2-echo-state-command*) (cap-index index) (cap-nonce nonce)
                             (pool-slot slot) (pool-gen poolgen) (off 0) (length 0)
                             (pending 0) (borrows 0) (wait-reason 0)))
                 (fn2-core (fn2-machine-put id (event-ready 0)))
                 (fn2-core (fn2-machine-set-wake-id target fn2-core)))
            (fn2-machine-result 0 24 0 t fn2-core)))))))
(fn2-core-shape-lemmas fn2-listener-admit (id) 4)

(defun fn2-listener-step (id accepting budget fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (cond ((not (equal (fn2-machine-pending id fn2-core) 0))
         (fn2-machine-result 0 1 0 nil fn2-core))
        ((and accepting (equal (fn2-machine-event-ready id fn2-core) 1))
         (fn2-listener-admit id fn2-core))
        ((not (and (natp budget) (< 0 budget))) (fn2-machine-result 0 1 0 t fn2-core))
        (t
         (mv-let (code op opgen fn2-core)
           (if accepting
               (fn2-issue-accept 0 0 *fn2-listener-kind* id (fn2-machine-generation id fn2-core) 0 fn2-core)
             (fn2-issue-close (fn2-machine-cap-index id fn2-core)
               (fn2-machine-cap-nonce id fn2-core) *fn2-listener-kind* id
               (fn2-machine-generation id fn2-core) 0 fn2-core))
           (declare (ignore op opgen))
           (fn2-machine-issue-result id code 0 fn2-core)))))
(fn2-core-shape-lemmas fn2-listener-step (id accepting budget) 4)

(defun fn2-connection-release (id fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (let* ((kind (fn2-machine-kind id fn2-core))
         (gen (fn2-machine-generation id fn2-core)))
    (mv-let (code fn2-core)
      (fn2-core-release (fn2-machine-pool-slot id fn2-core)
        (fn2-machine-pool-gen id fn2-core) kind id gen fn2-core)
      (if (not (or (eq code :ok) (eq code :retired)))
          (let ((fn2-core (fn2-machine-set-stopped id 1 fn2-core)))
            (fn2-machine-result 0 4 0 nil fn2-core))
        (let* ((next (if (equal kind *fn2-echo-kind*) (fn2-machine-free-head fn2-core)
                       (fn2-machine-null-free-head fn2-core)))
               (retire (>= gen (fn2-machine-gen-limit fn2-core)))
               (fn2-core (fn2-machine-put id
                           (phase (if retire *fn2-echo-state-retired* *fn2-echo-state-free*))
                           (generation (if retire gen (+ 1 gen)))
                           (pool-slot 4294967295) (pool-gen 0)
                           (cap-index 0) (cap-nonce 0) (off 0) (length 0)
                           (next-free next) (wait-reason 0)))
               (fn2-core (if retire fn2-core
                           (if (equal kind *fn2-echo-kind*) (fn2-machine-set-free-head id fn2-core)
                             (fn2-machine-set-null-free-head id fn2-core))))
               (fn2-core (fn2-machine-set-active-count
                           (fn2-machine-dec (fn2-machine-active-count fn2-core)) fn2-core)))
          (fn2-machine-result 0 20 0 nil fn2-core))))))
(fn2-core-shape-lemmas fn2-connection-release (id) 4)

(defun fn2-connection-reset (id fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (mv-let (code fn2-core)
    (fn2-core-reset (fn2-machine-pool-slot id fn2-core)
      (fn2-machine-pool-gen id fn2-core) (fn2-machine-kind id fn2-core) id
      (fn2-machine-generation id fn2-core) fn2-core)
    (let ((fn2-core (fn2-machine-put id
                      (phase (if (eq code :ok) *fn2-echo-state-command* *fn2-echo-state-closing*)) (off 0) (length 0))))
      (fn2-machine-result 0 8 0 t fn2-core))))
(fn2-core-shape-lemmas fn2-connection-reset (id) 4)

(defun fn2-connection-issue (id phase fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (let* ((kind (fn2-machine-kind id fn2-core))
         (gen (fn2-machine-generation id fn2-core))
         (principal (fn2-machine-principal-slot id fn2-core))
         (index (fn2-machine-cap-index id fn2-core))
         (nonce (fn2-machine-cap-nonce id fn2-core))
         (slot (fn2-machine-pool-slot id fn2-core))
         (poolgen (fn2-machine-pool-gen id fn2-core)))
    (mv-let (code op opgen fn2-core)
      (cond ((equal phase *fn2-echo-state-command*)
             (fn2-issue-receive index nonce slot poolgen
               (min 4096 (fn2-machine-pool-capacity slot fn2-core))
               kind id gen principal fn2-core))
            ((equal phase *fn2-echo-state-reply*)
             (let ((off (fn2-machine-off id fn2-core))
                   (len (fn2-machine-length id fn2-core)))
               (fn2-issue-send index nonce slot poolgen off (min 4096 (nfix (- len off))) 1
                 kind id gen principal fn2-core)))
            (t (fn2-issue-close index nonce kind id gen principal fn2-core)))
      (declare (ignore op opgen))
      (let ((fn2-core (if (and (eq code :ok) (equal phase *fn2-echo-state-reply*))
                          (fn2-machine-set-borrows id 1 fn2-core) fn2-core)))
        (fn2-machine-issue-result id code
          (cond ((equal phase *fn2-echo-state-command*)
                 (min 4096 (fn2-machine-pool-capacity slot fn2-core)))
                ((equal phase *fn2-echo-state-reply*)
                 (min 4096 (nfix (- (fn2-machine-length id fn2-core)
                                   (fn2-machine-off id fn2-core))))) (t 0)) fn2-core)))))
(fn2-core-shape-lemmas fn2-connection-issue (id phase) 4)

(defun fn2-connection-submit (id phase budget fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (cond ((not (equal (fn2-machine-pending id fn2-core) 0))
         (fn2-machine-result 0 1 0 nil fn2-core))
        ((not (and (natp budget) (< 0 budget))) (fn2-machine-result 0 2 0 t fn2-core))
        (t (fn2-connection-issue id phase fn2-core))))
(fn2-core-shape-lemmas fn2-connection-submit (id phase budget) 4)
(defun fn2-connection-reply (id budget fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (cond ((not (equal (fn2-machine-pending id fn2-core) 0))
         (fn2-machine-result 0 1 0 nil fn2-core))
        ((not (equal (fn2-machine-borrows id fn2-core) 0))
         (fn2-machine-result 0 2 0 nil fn2-core))
        ((or (equal (fn2-machine-kind id fn2-core) *fn2-null-kind*)
             (>= (fn2-machine-off id fn2-core) (fn2-machine-length id fn2-core)))
         (fn2-connection-reset id fn2-core))
        (t (fn2-connection-submit id *fn2-echo-state-reply* budget fn2-core))))
(fn2-core-shape-lemmas fn2-connection-reply (id budget) 4)
(defun fn2-connection-drain (id fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (cond ((not (equal (fn2-machine-pending id fn2-core) 0))
         (fn2-machine-result 0 1 0 nil fn2-core))
        ((equal (fn2-machine-borrows id fn2-core) 0) (fn2-connection-release id fn2-core))
        (t (fn2-machine-result 0 2 0 nil fn2-core))))
(fn2-core-shape-lemmas fn2-connection-drain (id) 4)

(defun fn2-listener-run (id budget fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (fn2-listener-dispatch (fn2-machine-phase id fn2-core)))
(fn2-core-shape-lemmas fn2-listener-run (id budget) 4)
(defun fn2-echo-run (id budget fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (fn2-echo-dispatch (fn2-machine-phase id fn2-core)))
(fn2-core-shape-lemmas fn2-echo-run (id budget) 4)
(defun fn2-null-run (id budget fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (fn2-null-dispatch (fn2-machine-phase id fn2-core)))
(fn2-core-shape-lemmas fn2-null-run (id budget) 4)
(make-event
 (value `(defun fn2-machine-run (id budget fn2-core)
           (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
           (if (or (not (fn2-machine-idp id fn2-core))
                   (equal (fn2-machine-stopped id fn2-core) 1))
               (fn2-machine-idle id fn2-core)
             (case (fn2-machine-kind id fn2-core)
               ,@(fn2-machine-run-arms (fn2-machine-names (w state)) 0)
               (otherwise (fn2-machine-refuse-phase id fn2-core)))))))
(fn2-core-shape-lemmas fn2-machine-run (id budget) 4)

(assert-event
 (fn2-profile-exports-compliant-p
  '(fn2-machine-observe fn2-machine-run fn2-machine-take-wake
    fn2-listener-step fn2-connection-submit fn2-connection-reply fn2-connection-drain fn2-machine-grant-one fn2-machine-park)
  (w state)))

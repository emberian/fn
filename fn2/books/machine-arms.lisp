; The machine form's generator (MACHINE-FORM-20261030 section 6). A kind's
; :arms are steps in the arm language; this book derives each arm's contract
; (cost, writes, tables, next, uses) by walking its paths and emits the arm's
; function, so no body exists beside the declaration to disagree with it.
; Expansion-time functions only; defmachine-arms runs in the kind's
; callbacks section, where its operations and the core exist.
(in-package "ACL2")
(include-book "core-children")
; defmachine-registry's code calls the directory's partition operations
(include-book "arm-children")

; ----------------------------------------------------------------------
; Environments and accumulators are plists. ENV: :kind :tag :observe
; :columns :subs (name . derived) :refusal :world :written :next :lets
; :budget. ACC: :charges ((b s d) ...) :nexts :writes :uses :tables :reads
; :stay :issues.
(defun fn2-arms-add (key items acc)
  (declare (xargs :verify-guards nil))
  (fn2-decl-set key (union-equal items (fn2-arm-get key acc)) acc))
(defun fn2-arms-sym (kind suffix)
  (declare (xargs :verify-guards nil))
  (fn2-columns-sym kind suffix))
(defun fn2-arms-phase-constant (kind phase)
  (declare (xargs :verify-guards nil))
  (fn2-columns-pre "*" (fn2-columns-sym (fn2-columns-col-name (fn2-columns-sym kind "-STATE") phase) "*")))
(defun fn2-arms-row-field (sym env)
  ; ROW-F for a column F of the kind, else nil
  (declare (xargs :verify-guards nil))
  (cdr (assoc-eq sym (fn2-machine-row-map (fn2-arm-get :columns env)))))
(defun fn2-arms-reserved-p (v)
  (declare (xargs :verify-guards nil))
  (or (member-eq v '(id budget fn2-core event outcome reason count aux0 aux1 slot kind ordinal
                       fn2-machines fn2-pool fn2-ops fn2-control))
      (and (symbolp v) (<= 4 (length (symbol-name v)))
           (equal (subseq (symbol-name v) 0 4) "ROW-"))))
(defun fn2-arms-vars-ok (vars)
  (declare (xargs :verify-guards nil))
  (if (atom vars) (null vars)
    (and (symbolp (car vars)) (car vars) (not (keywordp (car vars))) (not (eq (car vars) t))
         (not (fn2-arms-reserved-p (car vars)))
         (fn2-arms-vars-ok (cdr vars)))))
; An operation the arm language may call: a defcost row; the per-octet
; exports are not in the vocabulary (the range primitives by handle are).
(defconst *fn2-arms-octet-exports* '(fn2-core-read fn2-core-write fn2-pool-read fn2-pool-write))
(defun fn2-arms-op-row (op world)
  (declare (xargs :verify-guards nil))
  (and (symbolp op) (not (member-eq op *fn2-arms-octet-exports*))
       (fn2-decl-row (list :cost op) world)))
(defun fn2-arms-stobj-p (x) (declare (xargs :verify-guards nil)) (and x (symbolp x)))
(defun fn2-arms-no-stobj (xs)
  (declare (xargs :verify-guards nil))
  (if (atom xs) t (and (null (car xs)) (fn2-arms-no-stobj (cdr xs)))))

; Child form (MACHINE-FORM 6.5 P3): an arm over its kind's table and the
; core children its operations take, never fn2-core. ENV's :children is then
; the arm's stobj tuple (K-TABLE-STOBJ fn2-machines fn2-pool fn2-ops
; fn2-control . EXTRA), EXTRA below; each declared operation is called through its defcost
; :child; the index's constants *K-KIND* and *K-ADMISSION-ORDINAL* are the
; arm's formals KIND and ORDINAL (the assembly's wrapper passes them).
(defconst *fn2-arms-children* '(fn2-machines fn2-pool fn2-ops fn2-control))
(defun fn2-arms-tuple (env)
  (declare (xargs :verify-guards nil))
  (or (fn2-arm-get :children env) '(fn2-core)))
(defun fn2-arms-callee (op env world)
  ; the function an arm calls for the declared operation OP (nil: none in child form)
  (declare (xargs :verify-guards nil))
  (if (fn2-arm-get :children env) (fn2-decl-get :child (fn2-arms-op-row op world)) op))
(defun fn2-arms-stobjs-of (xs)
  (declare (xargs :verify-guards nil))
  (cond ((atom xs) nil) ((fn2-arms-stobj-p (car xs)) (cons (car xs) (fn2-arms-stobjs-of (cdr xs))))
        (t (fn2-arms-stobjs-of (cdr xs)))))
; The tuple's extra children: the stobjs the :child functions of every
; operation the kind's arms, sub-arms and handlers name take, beyond K and
; the four above, in the core's child order (fn2-core-children's registry).
; Every extra child must be a registered core child (the wrapper reaches it
; through the registry's field). A pre-pass over the declared entries: no
; defmachine key.
(defun fn2-arms-collect-children (x world fuel)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (if (or (zp fuel) (atom x)) nil
    (let* ((row (and (symbolp (car x)) (fn2-arms-op-row (car x) world)))
           (f (and row (fn2-decl-get :child row))))
      (union-eq (and f (fn2-arms-stobjs-of (getpropc f 'stobjs-in nil world)))
                (union-eq (fn2-arms-collect-children (car x) world (1- fuel))
                          (fn2-arms-collect-children (cdr x) world (1- fuel)))))))
(defun fn2-arms-registry-order (entries wanted)
  ; (FIELD . STOBJ) for each registered child in WANTED, in registry order
  (declare (xargs :verify-guards nil))
  (if (atom entries) nil
    (let ((stobj (fn2-core-child-property (car entries) :stobj)))
      (append (and (member-eq stobj wanted) (list (cons (caar entries) stobj)))
              (fn2-arms-registry-order (cdr entries) wanted)))))
(defun fn2-arms-extra-children (kind world)
  ; (mv err ((FIELD . STOBJ) ...))
  (declare (xargs :verify-guards nil))
  (let* ((wanted (set-difference-eq
                  (fn2-arms-collect-children
                   (list (fn2-machine-declared kind :subarms world) (fn2-machine-declared kind :arms world)
                         (fn2-machine-declared kind :observe-arms world))
                   world 1000000)
                  (cons kind *fn2-arms-children*)))
         (found (fn2-arms-registry-order (fn2-core-child-registry world) wanted))
         (missing (set-difference-eq wanted (strip-cdrs found))))
    (if missing
        (mv (msg "~x0's arms call operations over ~x1, which no defcorechild registers (an arm reaches a child through the core's registry)." kind missing) nil)
      (mv nil found))))
(defun fn2-arms-kind-tuple (kind world)
  (declare (xargs :verify-guards nil))
  (mv-let (err extras) (fn2-arms-extra-children kind world)
    (declare (ignore err))
    (cons kind (append *fn2-arms-children* (strip-cdrs extras)))))
(defun fn2-arms-rebind (stobjs call body)
  ; bind the stobjs a call returns (and nothing else) around BODY
  (declare (xargs :verify-guards nil))
  (if (and (consp stobjs) (null (cdr stobjs))) `(let ((,(car stobjs) ,call)) ,body)
    `(mv-let ,stobjs ,call ,body)))
(defun fn2-arms-index-constant (x env)
  ; child form: the formal standing for an index-time constant of the kind
  (declare (xargs :verify-guards nil))
  (let ((kind (fn2-arm-get :kind env)))
    (and (fn2-arm-get :children env)
         (cond ((eq x (fn2-columns-pre "*" (fn2-columns-sym kind "-KIND*"))) 'kind)
               ((eq x (fn2-columns-pre "*" (fn2-columns-sym kind "-ADMISSION-ORDINAL*"))) 'ordinal)
               (t nil)))))

; ----------------------------------------------------------------------
; Bounds of charge expressions, for the derived cost: nat, a constant, a
; :let variable by its expression, min/max/+/-/if/nfix. NIL is unbounded.
(defun fn2-arms-bound (x lets world fuel)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (cond ((zp fuel) nil)
        ((natp x) x)
        ((symbolp x)
         (let ((c (fn2-cost-constant x world)))
           (or c (let ((e (assoc-eq x lets))) (and e (fn2-arms-bound (cdr e) lets world (1- fuel)))))))
        ((atom x) nil)
        ((member-eq (car x) '(nfix))
         (fn2-arms-bound (cadr x) lets world (1- fuel)))
        ((eq (car x) '-) (fn2-arms-bound (cadr x) lets world (1- fuel)))
        ((eq (car x) 'if)
         (let ((a (fn2-arms-bound (caddr x) lets world (1- fuel)))
               (b (fn2-arms-bound (cadddr x) lets world (1- fuel))))
           (and a b (max a b))))
        ((member-eq (car x) '(min max +))
         (let ((a (fn2-arms-bound (cadr x) lets world (1- fuel)))
               (b (if (consp (cddr x))
                      (fn2-arms-bound (cons (car x) (cddr x)) lets world (1- fuel))
                    (if (eq (car x) '+) 0 nil))))
           (case (car x)
             (min (cond ((and a b) (min a b)) (t (or a b))))
             (max (if (consp (cddr x)) (and a b (max a b)) a))
             (otherwise (and a b (+ a b))))))
        (t nil)))

; ----------------------------------------------------------------------
; Expressions. Row values are ROW-F (the row at arm entry); a read of ROW-F
; after a write of F on the same path is refused. A call is an arm
; primitive or control form, or a declared pure operation (it takes the
; core, returns no stobj): the core is appended.
(mutual-recursion
 (defun fn2-arms-expr (x env acc fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (let ((world (fn2-arm-get :world env)))
     (cond
      ((zp fuel) (mv (msg "an expression is too deeply nested.") x acc))
      ((symbolp x)
       (let ((f (fn2-arms-row-field x env)))
         (cond ((fn2-arms-index-constant x env) (mv nil (fn2-arms-index-constant x env) acc))
               ;; the row's slot in its kind's table (D F7): the directory's, as the take or admission gave it
               ((eq x 'row-slot)
                (mv nil (if (fn2-arm-get :children env) 'slot '(fn2-machine-slot id fn2-core)) acc))
               ((null f) (mv nil x acc))
               ((member-eq f (fn2-arm-get :written env))
                (mv (msg "reads ~x0 after writing ~x1 on the same path; bind it with :let before the write." x f) x acc))
               (t (mv nil x (fn2-arms-add :reads (list x) acc))))))
      ((atom x) (mv nil x acc))
      ((eq (car x) 'quote) (mv nil x acc))
      ((not (and (symbolp (car x)) (true-listp x))) (mv (msg "malformed expression ~x0." x) x acc))
      ((eq (car x) 'cond)
       (mv-let (err clauses acc) (fn2-arms-clauses (cdr x) env acc (1- fuel))
         (mv err (cons 'cond clauses) acc)))
      ((eq (car x) 'case)
       (mv-let (err key acc) (fn2-arms-expr (cadr x) env acc (1- fuel))
         (mv-let (err2 arms acc) (fn2-arms-case-arms (cddr x) env acc (1- fuel))
           (mv (or err err2) (list* 'case key arms) acc))))
      ((or (member-eq (car x) *fn2-arm-primitives*) (member-eq (car x) *fn2-arm-control*)
           (member-eq (car x) '(member-eq member-equal)))
       (mv-let (err args acc) (fn2-arms-exprs (cdr x) env acc (1- fuel))
         (mv err (cons (car x) args) acc)))
      ((and (fn2-arms-op-row (car x) world) (fn2-arms-callee (car x) env world)
            (let* ((f (fn2-arms-callee (car x) env world)) (ins (getpropc f 'stobjs-in nil world)))
              (and (fn2-arms-no-stobj (getpropc f 'stobjs-out nil world))
                   (subsetp-eq (fn2-arms-stobjs-of ins) (fn2-arms-tuple env))
                   (equal (+ (len (fn2-arms-stobjs-of ins)) (len (cdr x))) (len (getpropc f 'formals nil world))))))
       (mv-let (err args acc) (fn2-arms-exprs (cdr x) env acc (1- fuel))
         (mv err (append (cons (fn2-arms-callee (car x) env world) args)
                         (fn2-arms-stobjs-of (getpropc (fn2-arms-callee (car x) env world) 'stobjs-in nil world)))
             (fn2-arms-add :uses (list (car x))
               (fn2-arms-add :tables (fn2-cost-tables (fn2-decl-get :tables (fn2-arms-op-row (car x) world)) world)
                             acc)))))
      (t (mv (msg "calls ~x0, which is neither an arm primitive nor a declared pure operation of the right arity." (car x))
             x acc)))))
 (defun fn2-arms-exprs (xs env acc fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (cond ((zp fuel) (mv (msg "too deeply nested.") xs acc))
         ((atom xs) (mv nil nil acc))
         (t (mv-let (err a acc) (fn2-arms-expr (car xs) env acc (1- fuel))
              (mv-let (err2 b acc) (fn2-arms-exprs (cdr xs) env acc (1- fuel))
                (mv (or err err2) (cons a b) acc))))))
 (defun fn2-arms-clauses (cs env acc fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (cond ((zp fuel) (mv (msg "too deeply nested.") cs acc))
         ((atom cs) (mv nil nil acc))
         (t (mv-let (err a acc) (fn2-arms-exprs (car cs) env acc (1- fuel))
              (mv-let (err2 b acc) (fn2-arms-clauses (cdr cs) env acc (1- fuel))
                (mv (or err err2) (cons a b) acc))))))
 (defun fn2-arms-case-arms (cs env acc fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (cond ((zp fuel) (mv (msg "too deeply nested.") cs acc))
         ((atom cs) (mv nil nil acc))
         (t (mv-let (err a acc) (fn2-arms-exprs (cdar cs) env acc (1- fuel))
              (mv-let (err2 b acc) (fn2-arms-case-arms (cdr cs) env acc (1- fuel))
                (mv (or err err2) (cons (cons (caar cs) a) b) acc)))))))

; ----------------------------------------------------------------------
; Calls of declared operations. Positional arguments fill the leading
; formals; the owner triple okind/oslot/ogen is filled from the row; any
; other formal is given as :FORMAL E; the core is the stobj argument.
(defun fn2-arms-split-call (args)
  ; (positional . keyword-plist)
  (declare (xargs :verify-guards nil))
  (if (or (atom args) (keywordp (car args))) (cons nil args)
    (let ((rest (fn2-arms-split-call (cdr args))))
      (cons (cons (car args) (car rest)) (cdr rest)))))
(defun fn2-arms-actuals (formals stobjs positional overrides kind tuple)
  ; (mv err actuals) with expressions untranslated
  (declare (xargs :verify-guards nil))
  (cond ((atom formals)
         (if positional (mv (msg "too many arguments ~x0." positional) nil) (mv nil nil)))
        ((fn2-arms-stobj-p (car stobjs))
         (if (member-eq (car stobjs) tuple)
             (mv-let (err rest) (fn2-arms-actuals (cdr formals) (cdr stobjs) positional overrides kind tuple)
               (mv err (cons (car stobjs) rest)))
           (mv (msg "takes the stobj ~x0; an arm calls operations over ~x1." (car stobjs) tuple) nil)))
        (positional
         (mv-let (err rest) (fn2-arms-actuals (cdr formals) (cdr stobjs) (cdr positional) overrides kind tuple)
           (mv err (cons (car positional) rest))))
        (t (let* ((key (intern-in-package-of-symbol (symbol-name (car formals)) :a))
                  (given (member-eq key overrides))
                  (value (cond (given (cadr given))
                               ((eq (car formals) 'okind)
                                (if (equal tuple '(fn2-core)) (fn2-columns-pre "*" (fn2-columns-sym kind "-KIND*")) 'kind))
                               ((eq (car formals) 'oslot) 'id)
                               ((eq (car formals) 'ogen) 'row-generation)
                               (t nil))))
             (if (not (or given (member-eq (car formals) '(okind oslot ogen))))
                 (mv (msg "gives no argument for the formal ~x0." (car formals)) nil)
               (mv-let (err rest) (fn2-arms-actuals (cdr formals) (cdr stobjs) nil overrides kind tuple)
                 (mv err (cons value rest))))))))
(defun fn2-arms-binders (outs vars)
  ; the mv binder list: stobj outputs by name, the rest from VARS
  (declare (xargs :verify-guards nil))
  (cond ((atom outs) nil)
        ((fn2-arms-stobj-p (car outs)) (cons (car outs) (fn2-arms-binders (cdr outs) vars)))
        (t (cons (car vars) (fn2-arms-binders (cdr outs) (cdr vars))))))
(defun fn2-arms-value-count (outs)
  (declare (xargs :verify-guards nil))
  (cond ((atom outs) 0) ((fn2-arms-stobj-p (car outs)) (fn2-arms-value-count (cdr outs)))
        (t (+ 1 (fn2-arms-value-count (cdr outs))))))
; (mv err call acc): the translated call, its use, tables and own writes.
(defun fn2-arms-call (call effects env acc fuel)
  (declare (xargs :verify-guards nil))
  (let* ((world (fn2-arm-get :world env)) (op (and (consp call) (car call)))
         (row (fn2-arms-op-row op world))
         (fn (and row (fn2-arms-callee op env world))))
    (cond
     ((not (and (consp call) (true-listp call) (symbolp op)))
      (mv (msg "malformed operation call ~x0." call) nil acc))
     ((not row)
      (mv (msg "calls ~x0, which has no defcost (or is a per-octet export; use a range primitive)." op) nil acc))
     ((and (eq (fn2-decl-get :effects row) :per-use) (not effects))
      (mv (msg "calls ~x0, a per-use operation, without :effects." op) nil acc))
     ((not fn) (mv (msg "calls ~x0, whose defcost names no :child (the arm cannot be in child form)." op) nil acc))
     (t
      (let ((split (fn2-arms-split-call (cdr call))))
        (mv-let (err actuals)
          (fn2-arms-actuals (getpropc fn 'formals nil world) (getpropc fn 'stobjs-in nil world)
                            (car split) (cdr split) (fn2-arm-get :kind env) (fn2-arms-tuple env))
          (if err (mv (msg "~x0 ~@1" op err) nil acc)
            (mv-let (err actuals acc) (fn2-arms-exprs actuals env acc fuel)
              (mv err (cons fn actuals)
                  (fn2-arms-add :uses (list (if effects (list op :effects effects) op))
                    (fn2-arms-add :tables (fn2-cost-tables (fn2-decl-get :tables row) world)
                      (fn2-arms-add :writes (fn2-decl-get :own-writes row)
                        (if (and (natp (fn2-decl-get :descriptors row)) (< 0 (fn2-decl-get :descriptors row)))
                            (fn2-decl-set :issues t acc)
                          acc)))))))))))))

; ----------------------------------------------------------------------
; Phase forms: P, (:if E N N), (:case V ((CODE ...) N) ... (:otherwise N)).
(mutual-recursion
 (defun fn2-arms-next-form (n env acc fuel)
  ; (mv err phase-form acc)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (let ((kind (fn2-arm-get :kind env)) (states (fn2-machine-property (fn2-arm-get :kind env) :states (fn2-arm-get :world env))))
    (cond ((zp fuel) (mv (msg "a :next form is too deep.") nil acc))
          ((keywordp n)
           (if (member-eq n states)
               (mv nil (fn2-arms-phase-constant kind n) (fn2-arms-add :nexts (list n) acc))
             (mv (msg ":next names ~x0, not a phase of ~x1." n kind) nil acc)))
          ((and (true-listp n) (eq (car n) :if) (equal (len n) 4))
           (mv-let (err test acc) (fn2-arms-expr (cadr n) env acc (1- fuel))
             (mv-let (err2 a acc) (fn2-arms-next-form (caddr n) env acc (1- fuel))
               (mv-let (err3 b acc) (fn2-arms-next-form (cadddr n) env acc (1- fuel))
                 (mv (or err err2 err3) (list 'if test a b) acc)))))
          ((and (true-listp n) (eq (car n) :case) (consp (cdr n)))
           (mv-let (err key acc) (fn2-arms-expr (cadr n) env acc (1- fuel))
             (fn2-arms-next-case key (cddr n) err env acc (1- fuel))))
          (t (mv (msg "malformed :next ~x0." n) nil acc)))))
 (defun fn2-arms-next-case (key arms err env acc fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (cond ((zp fuel) (mv (msg "a :next form is too deep.") nil acc))
         ((atom arms) (mv (or err (msg "a :next :case needs an :otherwise.")) nil acc))
         ((eq (caar arms) :otherwise)
          (mv-let (err2 n acc) (fn2-arms-next-form (cadar arms) env acc (1- fuel))
            (mv (or err err2) n acc)))
         (t (mv-let (err2 a acc) (fn2-arms-next-form (cadar arms) env acc (1- fuel))
              (mv-let (err3 b acc) (fn2-arms-next-case key (cdr arms) err env acc (1- fuel))
                (mv (or err2 err3) (list 'if (list 'member-eq key (list 'quote (caar arms))) a b) acc)))))))

; ----------------------------------------------------------------------
; The step walker. (mv err code acc). A branch step (:if :cond :case) or a
; terminal ends its step list; every path ends in exactly one terminal.
(defconst *fn2-arms-terminals* '(:charge :wait :park :stop :halt :goto :idle :yield :wake :nowake :repeat-next))
; Writes are batched: a path's :set fields (and the row-control fields its
; terminal writes) are written by one checked PUT before the next operation
; call or the terminal, with the phase at the terminal.
(defun fn2-arms-put (env pairs)
  (declare (xargs :verify-guards nil))
  `(,(fn2-arms-sym (fn2-arm-get :kind env) "-PUT-CORE") id ,@pairs))
(defun fn2-arms-pairs (alist)
  (declare (xargs :verify-guards nil))
  (if (atom alist) nil (cons (list (caar alist) (cdar alist)) (fn2-arms-pairs (cdr alist)))))
(defun fn2-arms-write-pairs (env)
  ; the pending field writes and, once declared, the path's phase
  (declare (xargs :verify-guards nil))
  (let ((n (fn2-arm-get :next env)))
    (append (fn2-arms-pairs (fn2-arm-get :pending env)) (and n `((phase ,n))))))
(defun fn2-arms-wrap-writes (env body)
  (declare (xargs :verify-guards nil))
  (let ((pairs (fn2-arms-write-pairs env)))
    (if (not pairs) body
      (if (fn2-arm-get :children env)
          `(mv-let (,(car (fn2-arm-get :children env)) fn2-machines fn2-control)
             (,(fn2-arms-sym (fn2-arm-get :kind env) "-PUT-CHILDREN") id slot ,@pairs) ,body)
        `(let ((fn2-core ,(fn2-arms-put env pairs))) ,body)))))
(defun fn2-arms-flush (env acc body)
  ; the pending writes and the path's :next, before its terminal BODY; a
  ; path that never declared :next stays in its phase
  (declare (xargs :verify-guards nil))
  (mv (fn2-arms-wrap-writes env body)
      (if (or (fn2-arm-get :next env) (fn2-arm-get :next-done env)) acc (fn2-decl-set :stay t acc))))
(defun fn2-arms-cleared (env)
  ; after the writes are flushed before an operation call
  (declare (xargs :verify-guards nil))
  (fn2-decl-set :pending nil
    (if (fn2-arm-get :next env) (fn2-decl-set :next nil (fn2-decl-set :next-done t env)) env)))
(defun fn2-arms-pend (pairs env)
  ; (mv err env): add translated (FIELD . E) pairs to the pending writes
  (declare (xargs :verify-guards nil))
  (if (atom pairs) (mv nil env)
    (if (assoc-eq (caar pairs) (fn2-arm-get :pending env))
        (mv (msg "~x0 is written twice before the next operation." (caar pairs)) env)
      (fn2-arms-pend (cdr pairs) (fn2-decl-set :pending (append (fn2-arm-get :pending env) (list (car pairs))) env)))))
(defun fn2-arms-charge-form (b s d r env acc fuel)
  ; (mv err (mv ...) acc): the run's report; its bounds join the derived cost
  (declare (xargs :verify-guards nil))
  (let* ((world (fn2-arm-get :world env)) (lets (fn2-arm-get :lets env))
         (vb (fn2-arms-bound b lets world 64)) (vs (fn2-arms-bound s lets world 64))
         (vd (fn2-arms-bound d lets world 64)))
    (if (not (and vb vs vd))
        (mv (msg "charges (~x0 ~x1 ~x2), which has no static bound." b s d) nil acc)
      (mv-let (err xs acc) (fn2-arms-exprs (list b s d r) env acc fuel)
        (mv err `(mv ,@xs ,@(fn2-arms-tuple env)) (fn2-arms-add :charges (list (list vb vs vd)) acc))))))
(defun fn2-arms-charge (b s d r env acc fuel)
  (declare (xargs :verify-guards nil))
  (mv-let (err form acc) (fn2-arms-charge-form b s d r env acc fuel)
    (if err (mv err nil acc)
      (mv-let (code acc) (fn2-arms-flush env acc form) (mv nil code acc)))))
(defun fn2-arms-kw (key plist default)
  (declare (xargs :verify-guards nil))
  (let ((e (member-eq key plist))) (if e (cadr e) default)))
(defun fn2-arms-stop-form (reason form env)
  (declare (xargs :verify-guards nil))
  (if (fn2-arm-get :children env)
      `(let ((fn2-control (fn2-control-record-stop ,reason fn2-control))) ,form)
    `(let ((fn2-core (fn2-core-stop ,reason fn2-core))) ,form)))
(defun fn2-arms-terminal (step env acc fuel)
  (declare (xargs :verify-guards nil))
  (let* ((kind (fn2-arm-get :kind env)) (observe (fn2-arm-get :observe env)) (args (cdr step)))
    (cond
     ((and (fn2-arm-get :helper env) (not (eq (car step) :repeat-next)))
      (mv (msg "~x0 ends a path inside a :repeat; its steps end in no terminal." step) nil acc))
     ((and observe (member-eq (car step) '(:charge :idle :yield :wait :park :halt :goto)))
      (mv (msg "a handler ends in :wake, :nowake or :stop, not ~x0." step) nil acc))
     ((and (not observe) (member-eq (car step) '(:wake :nowake)))
      (mv (msg "~x0 ends a handler, not a run." step) nil acc))
     ((eq (car step) :charge)
      (fn2-arms-charge (fn2-arms-kw :bytes args 0) (fn2-arms-kw :steps args 0)
                       (fn2-arms-kw :descriptors args 0) (fn2-arms-kw :runnable args nil) env acc fuel))
     ((eq (car step) :idle) (fn2-arms-charge 0 '*fn2-work-empty* 0 nil env acc fuel))
     ((eq (car step) :yield) (fn2-arms-charge 0 '*fn2-work-empty* 0 t env acc fuel))
     ((eq (car step) :wait)
      (if (not (and (eq (car args) :completion) (assoc-eq 'pending (fn2-arm-get :columns env))))
          (mv (msg "~x0: the waits are (:wait :completion :bytes E) for a kind with a pending field." step) nil acc)
        (mv-let (err env) (fn2-arms-pend '((pending . 1) (wait-reason . *fn2-wait-completion*)) env)
          (if err (mv err nil acc)
            (fn2-arms-charge (fn2-arms-kw :bytes (cdr args) 0) (fn2-arms-kw :steps (cdr args) '*fn2-work-mailbox*)
                             1 nil env (fn2-arms-add :writes '(pending wait-reason) acc) fuel)))))
     ((eq (car step) :halt)
      (mv-let (err env) (fn2-arms-pend '((stopped . 1) (wait-reason . *fn2-wait-none*)) env)
        (if err (mv err nil acc)
          (fn2-arms-charge 0 '*fn2-work-mailbox* 0 nil env (fn2-arms-add :writes '(stopped wait-reason) acc) fuel))))
     ((eq (car step) :park)
      (let* ((wait (car args)) (rest (cdr args))
             (op (case wait (:operation 'fn2-machine-park) (:admission 'fn2-machine-park-admission)
                   (:pool 'fn2-machine-park-pool) (otherwise nil)))
             (argp (member-eq wait '(:admission :pool)))
             (opts (if argp (cdr rest) rest)))
        (cond
         ;; (:park :taken K): park on taken kind K's ordinal FIFO (D F2)
         ((eq wait :taken)
          (let ((parker (fn2-columns-sym 'fn2-machine-park-taken- (symbol-name (car rest)))))
            (if (not (fn2-arms-op-row parker (fn2-arm-get :world env)))
                (mv (msg "~x0: ~x1 is not a taken kind (no ~x2)." step (car rest) parker) nil acc)
              (mv-let (err call acc) (fn2-arms-call (list parker 'id) nil env acc fuel)
                (mv-let (err2 form acc)
                  (fn2-arms-charge-form 0 (fn2-arms-kw :steps (cdr rest) '*fn2-work-mailbox*) 0 nil env acc fuel)
                  (mv-let (code acc)
                    (fn2-arms-flush env acc
                      (fn2-arms-rebind (fn2-arms-stobjs-of (getpropc (car call) 'stobjs-out nil (fn2-arm-get :world env)))
                                       call form))
                    (mv (or err err2) code acc)))))))
         ;; an owner-declared wait kind (defwait, D F4): its park operation, or
         ;; the wait reason alone (the owner's grant finds the row)
         ((and (null op) (fn2-decl-row (fn2-machine-wait-id wait) (fn2-arm-get :world env)))
          (let ((parker (fn2-decl-get :park (fn2-decl-row (fn2-machine-wait-id wait) (fn2-arm-get :world env))))
                (reason (fn2-columns-pre "*" (fn2-columns-sym 'fn2-wait- (concatenate 'string (symbol-name wait) "*")))))
            (if parker
                (mv-let (err call acc) (fn2-arms-call (list parker 'id) nil env acc fuel)
                  (mv-let (err2 form acc)
                    (fn2-arms-charge-form 0 (fn2-arms-kw :steps rest '*fn2-work-mailbox*) 0 nil env acc fuel)
                    (mv-let (code acc)
                      (fn2-arms-flush env acc
                        (fn2-arms-rebind (fn2-arms-stobjs-of (getpropc (car call) 'stobjs-out nil (fn2-arm-get :world env)))
                                         call form))
                      (mv (or err err2) code acc))))
              (mv-let (err env) (fn2-arms-pend (list (cons 'wait-reason reason)) env)
                (mv-let (err2 form acc)
                  (fn2-arms-charge-form 0 (fn2-arms-kw :steps rest '*fn2-work-mailbox*) 0 nil env
                                        (fn2-arms-add :writes '(wait-reason) acc) fuel)
                  (mv-let (code acc) (fn2-arms-flush env acc form)
                    (mv (or err err2) code acc)))))))
         ((null op) (mv (msg "~x0 parks on an undeclared wait kind ~x1 (built in: :operation :admission :pool; or a defwait)." step wait) nil acc))
         ((and (eq wait :pool) (fn2-arm-get :children env))
          ;; child form: the class goes to the row's own cursor with the batch;
          ;; the directory takes the wait (fn2-machines-park-pool)
          (mv-let (err class acc) (fn2-arms-expr (car rest) env acc fuel)
            (mv-let (err1 env) (if err (mv err env) (fn2-arms-pend (list (cons 'cursor class)) env))
              (mv-let (err2 form acc)
                (fn2-arms-charge-form 0 (fn2-arms-kw :steps opts '*fn2-work-mailbox*) 0 nil env acc fuel)
                (mv-let (code acc)
                  (fn2-arms-flush env (fn2-arms-add :uses '(fn2-machine-park-pool)
                                        (fn2-arms-add :writes '(cursor wait-reason) acc))
                    `(mv-let (fn2-machines fn2-control) (fn2-machines-park-pool id fn2-machines fn2-control) ,form))
                  (mv (or err1 err2) code acc))))))
         (t
          (mv-let (err call acc) (fn2-arms-call (if argp (list op 'id (car rest)) (list op 'id)) nil env acc fuel)
            (mv-let (err2 form acc)
              (fn2-arms-charge-form 0 (fn2-arms-kw :steps opts '*fn2-work-mailbox*) 0 nil env acc fuel)
              (mv-let (code acc)
                (fn2-arms-flush env acc
                  (fn2-arms-rebind (fn2-arms-stobjs-of (getpropc (car call) 'stobjs-out nil (fn2-arm-get :world env)))
                                   call form))
                (mv (or err err2) code acc))))))))
     ((and (eq (car step) :stop)
           (member-eq (car args) (fn2-machine-declared kind :stops (fn2-arm-get :world env))))
      ;; a kind's own reason: its index in the kind's :stops
      (let ((idx (position-eq (car args) (fn2-machine-declared kind :stops (fn2-arm-get :world env)))))
        (if (fn2-arm-get :next env) (mv (msg "~x0 follows a :next; a stop writes no phase." step) nil acc)
          (let* ((acc (fn2-arms-add :uses '(fn2-core-kind-stop) acc))
                 (wrap (if (fn2-arm-get :children env)
                           `(let ((fn2-control (fn2-control-record-kind-stop kind ,idx fn2-control))) :form)
                         `(let ((fn2-core (fn2-core-kind-stop ,(fn2-columns-pre "*" (fn2-columns-sym kind "-KIND*")) ,idx fn2-core))) :form))))
            (if observe
                (mv nil (fn2-arms-wrap-writes env (subst `(mv *fn2-none* ,@(fn2-arms-tuple env)) :form wrap)) acc)
              (mv-let (err form acc)
                (fn2-arms-charge-form 0 (fn2-arms-kw :steps (cdr args) '*fn2-work-empty*) 0 nil env acc fuel)
                (mv err (fn2-arms-wrap-writes env (subst form :form wrap)) (fn2-decl-set :stay t acc))))))))
     ((eq (car step) :stop)
      (let ((reason (fn2-columns-pre "*" (fn2-columns-sym 'fn2-stop-reason- (concatenate 'string (symbol-name (car args)) "*")))))
        (cond ((not (and (keywordp (car args)) (fn2-cost-constant reason (fn2-arm-get :world env))))
               (mv (msg "~x0 names no stop reason (~x1): a foundation reason, or one in the kind's :stops." step reason) nil acc))
              ((fn2-arm-get :next env) (mv (msg "~x0 follows a :next; a stop writes no phase." step) nil acc))
              (t (let ((acc (fn2-arms-add :uses '(fn2-core-stop) acc)))
                   (if observe
                       (mv nil (fn2-arms-wrap-writes env (fn2-arms-stop-form reason `(mv *fn2-none* ,@(fn2-arms-tuple env)) env)) acc)
                     (mv-let (err form acc)
                       (fn2-arms-charge-form 0 (fn2-arms-kw :steps (cdr args) '*fn2-work-empty*) 0 nil env acc fuel)
                       (mv err (fn2-arms-wrap-writes env (fn2-arms-stop-form reason form env))
                           (fn2-decl-set :stay t acc)))))))))
     ((eq (car step) :goto)
      (let ((sub (assoc-eq (car args) (fn2-arm-get :subs env))))
        (cond ((not sub) (mv (msg "~x0: no sub-arm ~x1." step (car args)) nil acc))
              ((fn2-arm-get :next env) (mv (msg "~x0 follows a :next; the sub-arm decides the phase." step) nil acc))
              (t (let ((d (cdr sub)))
                   (mv nil (fn2-arms-wrap-writes env
                             (if (fn2-arm-get :children env)
                                 `(,(fn2-arms-sym kind (concatenate 'string "-SUB-" (concatenate 'string (symbol-name (car args)) "-CHILDREN")))
                                   id slot kind ordinal budget ,@(fn2-arms-tuple env))
                               `(,(fn2-arms-sym kind (concatenate 'string "-SUB-" (symbol-name (car args)))) id budget fn2-core)))
                       (fn2-decl-set :stay (or (fn2-arm-get :stay acc) (fn2-arm-get :stay d))
                         (fn2-decl-set :issues (or (fn2-arm-get :issues acc) (fn2-arm-get :issues d))
                           (fn2-arms-add :charges (fn2-arm-get :charges d)
                             (fn2-arms-add :nexts (fn2-arm-get :nexts d)
                               (fn2-arms-add :writes (fn2-arm-get :writes d)
                                 (fn2-arms-add :uses (fn2-arm-get :uses d)
                                   (fn2-arms-add :tables (fn2-arm-get :tables d) acc)))))))))))))
     ((eq (car step) :repeat-next)
      (cond ((null (fn2-arm-get :helper env)) (mv (msg "~x0 is not a step." step) nil acc))
            ((or (fn2-arm-get :next env) (fn2-arm-get :next-done env))
             (mv (msg "a :repeat's steps declare no :next.") nil acc))
            (t (mv nil (fn2-arms-wrap-writes env
                         (if (fn2-arm-get :children env)
                             `(,(fn2-arm-get :helper env) (1- n) id slot kind ordinal budget ,@(fn2-arms-tuple env))
                           `(,(fn2-arm-get :helper env) (1- n) id budget fn2-core)))
                   acc))))
     ((and (eq (car step) :wake) (fn2-arm-get :woken env))
      (mv (msg "~x0: the path already woke a row (:wake-row); a path wakes at most one row." step) nil acc))
     ((eq (car step) :wake)
      (mv-let (code acc) (fn2-arms-flush env acc `(mv id ,@(fn2-arms-tuple env))) (mv nil code acc)))
     ((eq (car step) :nowake)
      (mv-let (code acc) (fn2-arms-flush env acc `(mv *fn2-none* ,@(fn2-arms-tuple env))) (mv nil code acc)))
     (t (mv (msg "unknown terminal ~x0." step) nil acc)))))

; Answer routing of a :do: every declared answer continues (:accept), takes
; a :case branch, or goes to the arm's :on-refusal.
(defun fn2-arms-case-codes (cases)
  (declare (xargs :verify-guards nil))
  (if (atom cases) nil
    (append (and (consp (caar cases)) (caar cases)) (fn2-arms-case-codes (cdr cases)))))
(defun fn2-arms-case-otherwise (cases)
  (declare (xargs :verify-guards nil))
  (cond ((atom cases) nil) ((eq (caar cases) :otherwise) (car cases))
        (t (fn2-arms-case-otherwise (cdr cases)))))

(defconst *fn2-arms-observe-args* '(id event outcome reason count aux0 aux1))
; Child form: the arm over (K fn2-machines fn2-pool fn2-ops fn2-control . EXTRA),
; its row read by SLOT in K's table and by ID in the directory.
(defun fn2-arms-child-name (name)
  (declare (xargs :verify-guards nil))
  (fn2-columns-sym name "-CHILDREN"))
(defun fn2-arms-child-formals (observe tuple)
  (declare (xargs :verify-guards nil))
  (append '(id slot kind ordinal) (if observe (cdr *fn2-arms-observe-args*) '(budget)) tuple))
(defun fn2-arms-child-bindings (kind reads columns)
  (declare (xargs :verify-guards nil))
  (if (atom reads) nil
    (let ((field (car (fn2-machine-var-column (car reads) columns))))
      (cons `(,(car reads) ,(if (fn2-machine-directory-fieldp field)
                                `(,(fn2-columns-col-name 'fn2-machines field) id fn2-machines)
                              `(,(fn2-columns-col-name kind field) slot ,kind)))
            (fn2-arms-child-bindings kind (cdr reads) columns)))))
(defun fn2-arms-child-carriers (tuple pos)
  (declare (xargs :verify-guards nil))
  (if (atom tuple) nil
    (cons (list (car tuple) pos :prefix (concatenate 'string "-" (symbol-name (car tuple))))
          (fn2-arms-child-carriers (cdr tuple) (+ 1 pos)))))
; One proof that the arm keeps every child well formed (one walk of its
; paths), stated per child as corollaries for the callers' rewriting.
(defun fn2-arms-child-shape-terms (tuple pos call)
  (declare (xargs :verify-guards nil))
  (if (atom tuple) nil
    (let ((r (if (eql pos 0) `(car ,call) `(mv-nth ,pos ,call))))
      (list* `(,(fn2-columns-sym (car tuple) "P") ,r) `(,(fn2-columns-sym (car tuple) "-WFP") ,r)
             (fn2-arms-child-shape-terms (cdr tuple) (+ 1 pos) call)))))
(defun fn2-arms-child-shape-hyps (tuple)
  (declare (xargs :verify-guards nil))
  (if (atom tuple) nil
    (list* `(,(fn2-columns-sym (car tuple) "P") ,(car tuple)) `(,(fn2-columns-sym (car tuple) "-WFP") ,(car tuple))
           (fn2-arms-child-shape-hyps (cdr tuple)))))
(defun fn2-arms-child-corollaries (hyps terms)
  (declare (xargs :verify-guards nil))
  (if (atom terms) nil
    (cons `(:rewrite :corollary (implies (and ,@hyps) ,(car terms)))
          (fn2-arms-child-corollaries hyps (cdr terms)))))
(defun fn2-arms-shape-fns (tuple)
  ; the children's recognizers and invariants, closed: the callees' rules are about them
  (declare (xargs :verify-guards nil))
  (if (atom tuple) nil
    (list* (fn2-columns-sym (car tuple) "P") (fn2-columns-sym (car tuple) "-WFP")
           (fn2-arms-shape-fns (cdr tuple)))))
(defun fn2-arms-child-callees (uses world)
  ; the child functions an arm calls, kept closed in its shape proof (their
  ; own shape rules carry it)
  (declare (xargs :verify-guards nil))
  (if (atom uses) nil
    (let* ((op (fn2-arm-use-name (car uses)))
           (fn (fn2-decl-get :child (fn2-decl-row (list :cost op) world))))
      (append (and fn (not (eq fn op)) (list fn)) (and fn (list fn))
              (fn2-arms-child-callees (cdr uses) world)))))
(defun fn2-arms-child-shape-thms (fn terms hyps hint n)
  (declare (xargs :verify-guards nil))
  (if (atom terms) nil
    (cons `(defthm ,(fn2-columns-sym fn (concatenate 'string "-SHAPE-" (coerce (explode-nonnegative-integer n 10 nil) 'string)))
             (implies (and ,@hyps) ,(car terms))
             :hints ,hint)
          (fn2-arms-child-shape-thms fn (cdr terms) hyps hint (+ 1 n)))))
(defun fn2-arms-column-readers (name cols)
  (declare (xargs :verify-guards nil))
  (if (atom cols) nil
    (cons (fn2-columns-col-name name (caar cols)) (fn2-arms-column-readers name (cdr cols)))))
(defun fn2-arms-child-preserves (fn formals tuple pos callees readers)
  ; one theorem per child's recognizer and invariant, each a walk of the arm
  ; with its callees, the row readers, the width tests and the children's
  ; predicates closed (the callees' rules are about them, and a row value
  ; never matters to a shape); FN is closed outside its own proofs
  (declare (xargs :verify-guards nil))
  (let* ((call (cons fn formals)) (hyps (fn2-arms-child-shape-hyps tuple))
         (terms (fn2-arms-child-shape-terms tuple pos call)))
    (cons `(in-theory (disable ,fn))
          (fn2-arms-child-shape-thms fn terms hyps
            `(("Goal" :in-theory (e/d (,fn) (unsigned-byte-p min nfix nth ,@(fn2-arms-shape-fns tuple) ,@readers
                                             ,@(remove-duplicates-eq callees)))
                      :do-not '(generalize fertilize eliminate-destructors)))
            0))))
(defun fn2-arms-extra-wfps (extras)
  (declare (xargs :verify-guards nil))
  (if (atom extras) nil
    (cons `(,(fn2-columns-sym (car extras) "-WFP") ,(car extras)) (fn2-arms-extra-wfps (cdr extras)))))
(defun fn2-arms-child-guard (kind tuple)
  ; TUPLE is (K fn2-machines fn2-pool fn2-ops fn2-control . EXTRA)
  (declare (xargs :verify-guards nil))
  `(and (,(fn2-arms-sym kind "-WFP") ,kind) (fn2-machines-wfp fn2-machines) (fn2-pool-wfp fn2-pool)
        (fn2-ops-wfp fn2-ops) (fn2-control-wfp fn2-control) ,@(fn2-arms-extra-wfps (nthcdr 5 tuple))
        (natp slot) (< slot (,(fn2-arms-sym kind "-ROWS") ,kind))
        (natp id) (< id (fn2-machines-rows fn2-machines))))
(defun fn2-arms-rows-facts (fn call kind)
  (declare (xargs :verify-guards nil))
  (let ((krows (fn2-arms-sym kind "-ROWS")) (kraw (fn2-columns-pre "*" (fn2-arms-sym kind "-ROWS*"))))
    `((defthm ,(fn2-columns-sym fn "-TABLE-ROWS")
        (equal (,krows (car ,call)) (,krows ,kind))
        :hints (("Goal" :in-theory (enable ,fn))))
      (defthm ,(fn2-columns-sym fn "-TABLE-RAW-ROWS")
        (equal (nth ,kraw (car ,call)) (nth ,kraw ,kind))
        :hints (("Goal" :in-theory (enable ,fn))))
      (defthm ,(fn2-columns-sym fn "-MACHINES-ROWS")
        (equal (fn2-machines-rows (mv-nth 1 ,call)) (fn2-machines-rows fn2-machines))
        :hints (("Goal" :in-theory (enable ,fn))))
      (defthm ,(fn2-columns-sym fn "-MACHINES-RAW-ROWS")
        (equal (nth *fn2-machines-rows* (mv-nth 1 ,call)) (nth *fn2-machines-rows* fn2-machines))
        :hints (("Goal" :in-theory (enable ,fn)))))))
; ----------------------------------------------------------------------
; Per-arm tuples (main's ruling 2026-10-31, from D's cursor). The walker
; generates every child-form function over the kind's whole tuple T; its
; emission (fn2-arms-child-emit, at event time) then narrows it: the
; function takes K, the directory and the children its paths read (an
; operation's stobj arguments, a callee's own tuple, a row read), and
; returns only the children its paths write (an operation's or callee's
; stobj results, a checked write, a stop). Shape theorems are proved only
; for what it returns; a child it only reads is unchanged by construction.
; Each function's (TAKES RETURNS RESULT-COUNT) is recorded in the table
; fn2-arms-child-sigs, so its callers, generated later, pass and bind
; exactly those.
(defun fn2-arms-sig (name world)
  (declare (xargs :verify-guards nil))
  (cdr (assoc-eq name (table-alist 'fn2-arms-child-sigs world))))
(defun fn2-arms-order (xs tuple)
  (declare (xargs :verify-guards nil))
  (cond ((atom tuple) nil)
        ((member-eq (car tuple) xs) (cons (car tuple) (fn2-arms-order xs (cdr tuple))))
        (t (fn2-arms-order xs (cdr tuple)))))
(defun fn2-arms-tuple-tail-p (args tuple)
  (declare (xargs :verify-guards nil))
  (and (true-listp args) (<= (len tuple) (len args))
       (equal (nthcdr (- (len args) (len tuple)) args) tuple)))
(defun fn2-arms-tuple-head (args tuple)
  (declare (xargs :verify-guards nil))
  (take (- (len args) (len tuple)) args))
(defun fn2-arms-mvx (vals)
  ; a function's result: one value, or several
  (declare (xargs :verify-guards nil))
  (cond ((atom vals) nil) ((atom (cdr vals)) (car vals)) (t (cons 'mv vals))))
(defun fn2-arms-bind (vars call body)
  (declare (xargs :verify-guards nil))
  (cond ((atom vars) body)
        ((atom (cdr vars)) `(let ((,(car vars) ,call)) ,body))
        (t `(mv-let ,vars ,call ,body))))
(defun fn2-arms-result-vars (k)
  (declare (xargs :verify-guards nil))
  (if (zp k) nil
    (append (fn2-arms-result-vars (- k 1)) (list (packn-pos (list 'fn2-arms-r (- k 1)) 'fn2-arms-r)))))
(defun fn2-arms-callee-sig (x tuple self selfsig world)
  ; X a call of a recorded child function (or SELF) passing the whole tuple
  (declare (xargs :verify-guards nil))
  (and (consp x) (symbolp (car x)) (fn2-arms-tuple-tail-p (cdr x) tuple)
       (if (eq (car x) self) (or selfsig '(nil nil 0)) (fn2-arms-sig (car x) world))))
(mutual-recursion
 (defun fn2-arms-scan (x tuple self world fuel)
   ; (mv reads writes): the children X reads and binds anew
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (cond ((zp fuel) (mv nil nil))
         ((atom x) (mv (and (symbolp x) (member-eq x tuple) (list x)) nil))
         ((member-eq (car x) '(quote declare)) (mv nil nil))
         ((and (eq (car x) 'mv) (fn2-arms-tuple-tail-p (cdr x) tuple))
          (fn2-arms-scan-list (fn2-arms-tuple-head (cdr x) tuple) tuple self world (1- fuel)))
         ((member-eq (car x) '(let let*))
          (mv-let (r1 w1) (fn2-arms-scan-list (strip-cadrs (cadr x)) tuple self world (1- fuel))
            (mv-let (r2 w2) (fn2-arms-scan-list (cddr x) tuple self world (1- fuel))
              (mv (union-eq r1 r2) (union-eq (intersection-eq (strip-cars (cadr x)) tuple) (union-eq w1 w2))))))
         ((eq (car x) 'mv-let)
          (let ((sig (fn2-arms-callee-sig (caddr x) tuple self nil world)))
            (mv-let (r1 w1) (fn2-arms-scan (caddr x) tuple self world (1- fuel))
              (mv-let (r2 w2) (fn2-arms-scan-list (cdddr x) tuple self world (1- fuel))
                (mv (union-eq r1 r2)
                    (union-eq (if sig nil (intersection-eq (cadr x) tuple)) (union-eq w1 w2)))))))
         ((fn2-arms-callee-sig x tuple self nil world)
          (let ((sig (fn2-arms-callee-sig x tuple self nil world)))
            (mv-let (r w) (fn2-arms-scan-list (fn2-arms-tuple-head (cdr x) tuple) tuple self world (1- fuel))
              (mv (union-eq (car sig) r) (union-eq (cadr sig) w)))))
         ((consp (car x)) (fn2-arms-scan-list x tuple self world (1- fuel)))
         (t (fn2-arms-scan-list (cdr x) tuple self world (1- fuel)))))
 (defun fn2-arms-scan-list (xs tuple self world fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (if (or (zp fuel) (atom xs)) (mv nil nil)
     (mv-let (r1 w1) (fn2-arms-scan (car xs) tuple self world (1- fuel))
       (mv-let (r2 w2) (fn2-arms-scan-list (cdr xs) tuple self world (1- fuel))
         (mv (union-eq r1 r2) (union-eq w1 w2)))))))
(mutual-recursion
 (defun fn2-arms-narrow (x tuple self selfsig out world fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (cond ((zp fuel) x)
         ((atom x) x)
         ((member-eq (car x) '(quote declare)) x)
         ((and (eq (car x) 'mv) (fn2-arms-tuple-tail-p (cdr x) tuple))
          (fn2-arms-mvx (append (fn2-arms-narrow-list (fn2-arms-tuple-head (cdr x) tuple) tuple self selfsig out world (1- fuel))
                                out)))
         ((member-eq (car x) '(let let*))
          (list* (car x)
                 (pairlis$ (strip-cars (cadr x))
                           (pairlis$ (fn2-arms-narrow-list (strip-cadrs (cadr x)) tuple self selfsig out world (1- fuel)) nil))
                 (fn2-arms-narrow-list (cddr x) tuple self selfsig out world (1- fuel))))
         ((and (eq (car x) 'mv-let) (fn2-arms-callee-sig (caddr x) tuple self selfsig world))
          ;; a producer call of a child function: bind its results and what it returns
          (let* ((call (caddr x)) (sig (fn2-arms-callee-sig call tuple self selfsig world))
                 (k (- (len (cadr x)) (len tuple)))
                 (ncall (append (cons (car call) (fn2-arms-narrow-list (fn2-arms-tuple-head (cdr call) tuple)
                                                                       tuple self selfsig out world (1- fuel)))
                                (car sig)))
                 (body (fn2-arms-narrow-list (cdddr x) tuple self selfsig out world (1- fuel)))
                 (vars (append (take k (cadr x)) (cadr sig))))
            (if (atom vars) (car (last body)) (fn2-arms-bind vars ncall (car (last body))))))
         ((eq (car x) 'mv-let)
          (list* 'mv-let (cadr x) (fn2-arms-narrow (caddr x) tuple self selfsig out world (1- fuel))
                 (fn2-arms-narrow-list (cdddr x) tuple self selfsig out world (1- fuel))))
         ((fn2-arms-callee-sig x tuple self selfsig world)
          ;; a tail call: its results and what it returns, as this function's
          (let* ((sig (fn2-arms-callee-sig x tuple self selfsig world))
                 (ncall (append (cons (car x) (fn2-arms-narrow-list (fn2-arms-tuple-head (cdr x) tuple)
                                                                    tuple self selfsig out world (1- fuel)))
                                (car sig))))
            (if (equal (cadr sig) out) ncall
              (let ((rs (fn2-arms-result-vars (caddr sig))))
                (fn2-arms-bind (append rs (cadr sig)) ncall (fn2-arms-mvx (append rs out)))))))
         ((consp (car x)) (fn2-arms-narrow-list x tuple self selfsig out world (1- fuel)))
         (t (cons (car x) (fn2-arms-narrow-list (cdr x) tuple self selfsig out world (1- fuel))))))
 (defun fn2-arms-narrow-list (xs tuple self selfsig out world fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (if (or (zp fuel) (atom xs)) xs
     (cons (fn2-arms-narrow (car xs) tuple self selfsig out world (1- fuel))
           (fn2-arms-narrow-list (cdr xs) tuple self selfsig out world (1- fuel))))))
(defun fn2-arms-narrow-shape-terms (outs pos total call)
  (declare (xargs :verify-guards nil))
  (if (atom outs) nil
    (let ((r (cond ((equal total 1) call) ((eql pos 0) `(car ,call)) (t `(mv-nth ,pos ,call)))))
      (list* `(,(fn2-columns-sym (car outs) "P") ,r) `(,(fn2-columns-sym (car outs) "-WFP") ,r)
             (fn2-arms-narrow-shape-terms (cdr outs) (+ 1 pos) total call)))))
(defun fn2-arms-narrow-rows-facts (fn call outs pos total kind)
  ; the sizes the callers' later writes are checked against: K's rows and the directory's
  (declare (xargs :verify-guards nil))
  (if (atom outs) nil
    (let ((r (cond ((equal total 1) call) ((eql pos 0) `(car ,call)) (t `(mv-nth ,pos ,call))))
          (rows (cond ((eq (car outs) kind) (fn2-arms-sym kind "-ROWS"))
                      ((eq (car outs) 'fn2-machines) 'fn2-machines-rows) (t nil)))
          (raw (cond ((eq (car outs) kind) (fn2-columns-pre "*" (fn2-arms-sym kind "-ROWS*")))
                     ((eq (car outs) 'fn2-machines) '*fn2-machines-rows*) (t nil))))
      (append (and rows
                   `((defthm ,(fn2-columns-sym fn (concatenate 'string "-" (symbol-name (car outs)) "-ROWS"))
                       (equal (,rows ,r) (,rows ,(car outs)))
                       :hints (("Goal" :in-theory (enable ,fn))))
                     (defthm ,(fn2-columns-sym fn (concatenate 'string "-" (symbol-name (car outs)) "-RAW-ROWS"))
                       (equal (nth ,raw ,r) (nth ,raw ,(car outs)))
                       :hints (("Goal" :in-theory (enable ,fn))))))
              (fn2-arms-narrow-rows-facts fn call (cdr outs) (+ 1 pos) total kind)))))
(defun fn2-arms-child-emit-events (name prefix k kind tuple body guard measure callees readers rowsp world)
  (declare (xargs :verify-guards nil))
  (mv-let (reads writes) (fn2-arms-scan body tuple name world 1000000)
    (let* ((outs (fn2-arms-order writes tuple))
           (ins (fn2-arms-order (list* kind 'fn2-machines (union-eq reads writes)) tuple))
           (sig (list ins outs k))
           (code (fn2-arms-narrow body tuple name sig outs world 1000000))
           (formals (append prefix ins))
           (call (cons name formals))
           (total (+ k (len outs))))
      `((defun ,name ,formals
          (declare (xargs :stobjs ,ins ,@(and measure `(:measure ,measure))
                          :guard (and ,@guard (,(fn2-arms-sym kind "-WFP") ,kind)
                                      ,@(fn2-arms-extra-wfps (cdr ins))
                                      (natp slot) (< slot (,(fn2-arms-sym kind "-ROWS") ,kind))
                                      (natp id) (< id (fn2-machines-rows fn2-machines))))
                   (ignorable ,@formals))
          ,code)
        (table fn2-arms-child-sigs ',name ',sig)
        (in-theory (disable ,name))
        ,@(fn2-arms-child-shape-thms name (fn2-arms-narrow-shape-terms outs k total call)
            (fn2-arms-child-shape-hyps ins)
            `(("Goal" :in-theory (e/d (,name) (unsigned-byte-p min nfix nth ,@(fn2-arms-shape-fns ins) ,@readers
                                                ,@(remove-duplicates-eq callees)))
                      :do-not '(generalize fertilize eliminate-destructors)))
            0)
        ,@(and rowsp (fn2-arms-narrow-rows-facts name call outs k total kind))))))
(defmacro fn2-arms-child-emit (name prefix k kind tuple body guard measure callees readers rowsp)
  `(make-event (value (cons 'progn (fn2-arms-child-emit-events ',name ',prefix ',k ',kind ',tuple ',body ',guard
                                                               ',measure ',callees ',readers ',rowsp (w state))))))
;; A :repeat's pass function (child form over the arm's children, or core form).
(defun fn2-arms-repeat-events (helper kind ucode bcode bacc env)
  (declare (xargs :verify-guards nil))
  (let* ((world (fn2-arm-get :world env)) (reads (fn2-arm-get :reads bacc))
         (cols (fn2-machine-property kind :columns world)))
    (if (fn2-arm-get :children env)
        (let* ((tuple (fn2-arms-tuple env))
               (bindings (fn2-arms-child-bindings kind reads cols))
               (inner `(if ,ucode (mv ,@tuple) ,bcode)))
          `((fn2-arms-child-emit ,helper (n id slot kind ordinal budget) 0 ,kind ,tuple
              (if (zp n) (mv ,@tuple)
                ,(if bindings `(let ,bindings (declare (ignorable ,@reads)) ,inner) inner))
              ((natp n)) (nfix n)
              ,(fn2-arms-child-callees (fn2-arm-get :uses bacc) world)
              ,(append (fn2-arms-column-readers kind (fn2-machine-property kind :table world))
                       (fn2-arms-column-readers 'fn2-machines *fn2-machine-directory-fields*))
              ;; the loop keeps the row's table and the directory their sizes (the
              ;; arm's later writes are checked against them)
              t)))
      (let* ((bindings (fn2-machine-read-bindings kind reads cols))
             (inner `(if ,ucode fn2-core ,bcode)))
        `((defun ,helper (n id budget fn2-core)
            (declare (xargs :stobjs fn2-core :measure (nfix n) :guard (and (natp n) (fn2-core-wfp fn2-core)))
                     (ignorable id budget))
            (if (or (zp n) (not (eq (,(fn2-arms-sym kind "-SNAPSHOT-READ-CODE") id fn2-core) :ok))) fn2-core
              ,(if bindings `(let ,bindings (declare (ignorable ,@reads)) ,inner) inner)))
          (fn2-core-preserves ,helper (n id budget fn2-core) :rows nil))))))
(mutual-recursion
 (defun fn2-arms-steps (steps env acc fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (cond
    ((zp fuel) (mv (msg "an arm is too deeply nested.") nil acc))
    ((atom steps) (mv (msg "a path ends without a terminal (:charge, :wait, :park, :stop, :halt, :goto, :wake ...).") nil acc))
    ((not (and (consp (car steps)) (keywordp (caar steps)) (true-listp (car steps))))
     (mv (msg "~x0 is not a step." (car steps)) nil acc))
    (t
     (let* ((step (car steps)) (rest (cdr steps)))
       (case (car step)
         (:let
          (if (not (and (equal (len step) 3) (fn2-arms-vars-ok (list (cadr step)))
                        (not (member-eq (cadr step) (fn2-arm-get :bound env)))))
              (mv (msg "~x0 is (:let VAR E) with VAR new on its path, not a row, payload or reserved name." step) nil acc)
            (mv-let (err e acc) (fn2-arms-expr (caddr step) env acc fuel)
              (mv-let (err2 body acc)
                (fn2-arms-steps rest (fn2-decl-set :bound (cons (cadr step) (fn2-arm-get :bound env))
                                       (fn2-decl-set :lets (acons (cadr step) (caddr step) (fn2-arm-get :lets env)) env))
                                acc (1- fuel))
                (mv (or err err2) `(let ((,(cadr step) ,e)) (declare (ignorable ,(cadr step))) ,body) acc)))))
         (:set
          (let ((pairs (cdr step)) (cols (strip-cars (fn2-arm-get :columns env))))
            (if (not (and (doublet-listp pairs) (consp pairs) (subsetp-eq (strip-cars pairs) cols)
                          (not (assoc-eq 'phase pairs)) (no-duplicatesp-eq (strip-cars pairs))))
                (mv (msg "~x0 writes ~x1: own fields, once each, never phase (use :next)." step (strip-cars pairs)) nil acc)
              (mv-let (err vals acc) (fn2-arms-exprs (strip-cadrs pairs) env acc fuel)
                (mv-let (err1 env2) (fn2-arms-pend (pairlis$ (strip-cars pairs) vals) env)
                  (mv-let (err2 body acc)
                    (fn2-arms-steps rest (fn2-decl-set :written (union-eq (strip-cars pairs) (fn2-arm-get :written env2)) env2)
                                    acc (1- fuel))
                    (mv (or err err1 err2) body (fn2-arms-add :writes (strip-cars pairs) acc))))))))
         (:next
          (if (or (fn2-arm-get :next env) (fn2-arm-get :next-done env)) (mv (msg "a path has two :next steps.") nil acc)
            (mv-let (err n acc) (fn2-arms-next-form (cadr step) env acc fuel)
              (mv-let (err2 body acc) (fn2-arms-steps rest (fn2-decl-set :next n env) acc (1- fuel))
                (mv (or err err2) body (fn2-arms-add :writes '(phase) acc))))))
         (:do
          (let* ((vars (cadr step)) (call (caddr step)) (opts (cdddr step))
                 (world (fn2-arm-get :world env))
                 (op (and (consp call) (car call)))
                 (row (fn2-arms-op-row op world))
                 (answers (fn2-decl-get :answers row))
                 (cases (fn2-arms-kw :case opts nil))
                 (outs (getpropc (or (and row (fn2-arms-callee op env world)) op) 'stobjs-out nil world))
                 (cond-form (fn2-arms-kw :when opts nil)))
            (cond
             ((not (and (true-listp vars) (fn2-arms-vars-ok vars) (true-listp opts)))
              (mv (msg "~x0 is (:do (VAR ...) (OP ARG ...) [:accept ..] [:case ..] [:effects ..] [:when E :else (V ...)])." step) nil acc))
             ((and row (not (equal (len vars) (fn2-arms-value-count outs))))
              (mv (msg "~x0 binds ~x1 values; ~x2 returns ~x3." step (len vars) op (fn2-arms-value-count outs)) nil acc))
             ((and (not answers) (or cases (member-eq :accept opts)))
              (mv (msg "~x0 routes answers of ~x1, whose defcost declares no :answers." step op) nil acc))
             (t
              (mv-let (err call2 acc) (fn2-arms-call call (fn2-arms-kw :effects opts nil) env acc fuel)
                (if err (mv err nil acc)
                  (mv-let (err0 cond2 acc) (if cond-form (fn2-arms-expr cond-form env acc fuel) (mv nil nil acc))
                    (let* ((call2 (if cond-form
                                      `(if ,cond2 ,call2
                                         ,(if (equal (len outs) 1) (if (fn2-arms-stobj-p (car outs)) (car outs)
                                                                     (car (fn2-arms-kw :else opts nil)))
                                            `(mv ,@(fn2-arms-binders outs (fn2-arms-kw :else opts nil)))))
                                    call2)))
                      (mv-let (err body acc)
                        (fn2-arms-do-body vars answers opts rest
                                          (fn2-decl-set :bound (append vars (fn2-arm-get :bound env)) (fn2-arms-cleared env))
                                          acc (1- fuel))
                        (mv (or err0 err (and cond-form (not (equal (len (fn2-arms-kw :else opts nil)) (len vars)))
                                         (msg "~x0: :else gives the ~x1 values of a skipped call." step (len vars)))
                                (and (intersection-eq vars (fn2-arm-get :bound env))
                                     (msg "~x0 rebinds ~x1 on its path." step (intersection-eq vars (fn2-arm-get :bound env)))))
                            (fn2-arms-wrap-writes env
                             (cond ((and (equal (len outs) 1) (fn2-arms-stobj-p (car outs)))
                                    `(let ((,(car outs) ,call2)) ,body))
                                   ((equal (len outs) 1)
                                    `(let ((,(car vars) ,call2)) (declare (ignorable ,(car vars))) ,body))
                                   (t `(mv-let ,(fn2-arms-binders outs vars) ,call2
                                         ,@(and vars `((declare (ignorable ,@vars)))) ,body))))
                            acc))))))))))
         ;; (:repeat N (STEP ...) :until E) (D F6): at most N passes of the
         ;; steps, each reading the row afresh and stopping once E holds at a
         ;; pass's start; the steps end in no terminal, route every answer by
         ;; :accept, and see only the row, id and budget (the pass is its own
         ;; function, K-REPEAT-SITE-I). After the loop no row field is read.
         (:repeat
          (let* ((world (fn2-arm-get :world env)) (n (cadr step)) (body (caddr step))
                 (until (fn2-arms-kw :until (cdddr step) nil))
                 (helper (fn2-arms-sym (fn2-arm-get :kind env)
                           (concatenate 'string "-REPEAT-" (fn2-arm-get :site env) "-"
                                        (coerce (explode-nonnegative-integer (len (fn2-arm-get :aux acc)) 10 nil) 'string))))
                 (benv (fn2-decl-set :helper helper (fn2-decl-set :refusal nil
                         (fn2-decl-set :pending nil (fn2-decl-set :next nil (fn2-decl-set :next-done nil
                           (fn2-decl-set :written nil (fn2-decl-set :bound nil (fn2-decl-set :lets nil env))))))))))
            (cond
             ((fn2-arm-get :observe env) (mv (msg "~x0: a handler does not loop." step) nil acc))
             ((fn2-arm-get :helper env) (mv (msg "~x0: a :repeat does not nest." step) nil acc))
             ((not (and (fn2-arms-bound n nil world 64) (true-listp body) (consp body) until)) 
              (mv (msg "~x0 is (:repeat N (STEP ...) :until E), N statically bounded." step) nil acc))
             (t
              (mv-let (err0 ucode bacc) (fn2-arms-expr until benv nil fuel)
                (mv-let (err1 bcode bacc) (fn2-arms-steps (append body '((:repeat-next))) benv bacc (1- fuel))
                  (if (or err0 err1) (mv (or err0 err1) nil acc)
                    (let* ((events (fn2-arms-repeat-events helper (fn2-arm-get :kind env) ucode bcode bacc env))
                           (acc (fn2-decl-set :aux (append (fn2-arm-get :aux acc) (fn2-arm-get :aux bacc) events)
                                  (fn2-arms-add :uses (fn2-arm-get :uses bacc)
                                    (fn2-arms-add :tables (fn2-arm-get :tables bacc)
                                      (fn2-arms-add :writes (fn2-arm-get :writes bacc)
                                        (fn2-decl-set :issues (or (fn2-arm-get :issues acc) (fn2-arm-get :issues bacc)) acc))))))
                           (call (if (fn2-arm-get :children env)
                                     `(,helper ,n id slot kind ordinal budget ,@(fn2-arms-tuple env))
                                   `(,helper ,n id budget fn2-core))))
                      (mv-let (err2 rest-code acc)
                        (fn2-arms-steps rest (fn2-decl-set :pending nil
                                               (fn2-decl-set :written (strip-cars (fn2-arm-get :columns env)) env))
                                        acc (1- fuel))
                        (mv err2
                            (fn2-arms-wrap-writes env (fn2-arms-rebind (fn2-arms-tuple env) call rest-code))
                            acc))))))))))
         (:issue
          (let* ((call (cadr step)) (opts (cddr step))
                 (code-var 'fn2-issue-code)
                 (ok (fn2-arms-kw :ok opts nil)) (refused (fn2-arms-kw :refused opts nil))
                 (budget (fn2-arm-get :budget env)))
            (cond
             (rest (mv (msg "~x0 ends its path; its :ok steps continue it." step) nil acc))
             ((not (and (consp ok) (true-listp refused)))
              (mv (msg "~x0 is (:issue (OP ARG ...) :ok (STEP ...) [:refused (STEP ...)])." step) nil acc))
             ((zp (fn2-arm-get :descriptors budget))
              (mv (msg "~x0 issues, but the kind declares :descriptors 0." step) nil acc))
             (t
              (mv-let (err call2 acc) (fn2-arms-call call nil env acc fuel)
                (if err (mv err nil acc)
                  (mv-let (err1 okc acc) (fn2-arms-steps ok (fn2-arms-cleared env) acc (1- fuel))
                    (mv-let (err2 exc acc) (fn2-arms-steps (append refused '((:park :operation))) (fn2-arms-cleared env) acc (1- fuel))
                      (mv-let (err3 otc acc)
                        (fn2-arms-steps (append refused (or (fn2-arm-get :refusal env) '((:halt)))) (fn2-arms-cleared env) acc (1- fuel))
                        (mv (or err1 err2 err3)
                            (fn2-arms-wrap-writes env
                             `(mv-let ,(fn2-arms-binders (getpropc (car call2) 'stobjs-out nil (fn2-arm-get :world env))
                                                         (list code-var 'fn2-issue-op 'fn2-issue-opgen)) ,call2
                                (declare (ignorable fn2-issue-op fn2-issue-opgen))
                                (cond ((eq ,code-var :ok) ,okc)
                                      ((eq ,code-var :exhausted) ,exc)
                                      (t ,otc))))
                            (fn2-decl-set :issues t acc)))))))))))
         ;; (:wake-row E): wake the row E (D F5). The wake slot is single: a
         ;; path wakes at most once, counting a handler's own :wake.
         (:wake-row
          (cond ((not (equal (len step) 2)) (mv (msg "~x0 is (:wake-row E)." step) nil acc))
                ((fn2-arm-get :woken env) (mv (msg "~x0: a path wakes at most one row." step) nil acc))
                (t (mv-let (err e acc) (fn2-arms-expr (cadr step) env acc fuel)
                     (mv-let (err2 body acc)
                       (fn2-arms-steps rest (fn2-decl-set :woken t env) acc (1- fuel))
                       (mv (or err err2)
                           (if (fn2-arm-get :children env)
                               `(mv-let (fn2-machines fn2-control) (fn2-machines-wake-row ,e fn2-machines fn2-control) ,body)
                             `(let ((fn2-core (fn2-machine-wake-row ,e fn2-core))) ,body))
                           (fn2-arms-add :uses '(fn2-machine-wake-row) acc)))))))
         (:if
          (if (or rest (not (equal (len step) 4)))
              (mv (msg "~x0 is (:if E (STEP ...) (STEP ...)) and ends its path." step) nil acc)
            (mv-let (err test acc) (fn2-arms-expr (cadr step) env acc fuel)
              (mv-let (err2 a acc) (fn2-arms-steps (caddr step) env acc (1- fuel))
                (mv-let (err3 b acc) (fn2-arms-steps (cadddr step) env acc (1- fuel))
                  (mv (or err err2 err3) `(if ,test ,a ,b) acc))))))
         (:cond
          (if rest (mv (msg "~x0 ends its path." step) nil acc)
            (fn2-arms-cond (cdr step) env acc (1- fuel))))
         (:case
          (if rest (mv (msg "~x0 ends its path." step) nil acc)
            (mv-let (err key acc) (fn2-arms-expr (cadr step) env acc fuel)
              (mv-let (err2 body acc) (fn2-arms-case key (cddr step) env acc (1- fuel))
                (mv (or err err2) body acc)))))
         (otherwise
          (if (member-eq (car step) *fn2-arms-terminals*)
              (if rest (mv (msg "steps follow the terminal ~x0." step) nil acc)
                (fn2-arms-terminal step env acc fuel))
            (mv (msg "unknown step ~x0." step) nil acc))))))))
 ; the continuation of a :do: accepted answers continue with REST; :case
 ; branches end their paths; the rest of the answers go to :on-refusal
 (defun fn2-arms-do-body (vars answers opts rest env acc fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (if (zp fuel) (mv (msg "too deep.") nil acc)
   (let* ((cases (fn2-arms-kw :case opts nil))
          (case-codes (fn2-arms-case-codes cases))
          (other (fn2-arms-case-otherwise cases))
          (accept (if (member-eq :accept opts) (fn2-arms-kw :accept opts nil)
                    ;; no default for an operation that never answers :ok (C's
                    ;; reads): every member is routed by :accept or :case
                    (if (or (null answers) (member-eq :ok case-codes)
                            (and (consp answers) (not (member-eq :ok answers)))) nil '(:ok))))
          (code (car vars))
          (refusal (fn2-arm-get :refusal env)))
     (cond
      ((null answers) (fn2-arms-steps rest env acc (1- fuel)))
      ((not (symbolp code)) (mv (msg "a :do of an operation with answers binds its code first.") nil acc))
      ;; accepting a failure beside :ok is an absorb and says why; an operation
      ;; that never answers :ok has no failure to absorb by accepting
      ((and accept (not (subsetp-eq accept '(:ok))) (not (and (consp answers) (not (member-eq :ok answers))))
            (not (stringp (fn2-arms-kw :why opts nil))))
       (mv (msg "accepting ~x0 (not only :ok) needs :why \"...\" in the step." accept) nil acc))
      ((and accept (atom rest)) (mv (msg "accepted answers ~x0 have no continuation." accept) nil acc))
      ((and (null accept) (consp rest)) (mv (msg "steps follow a :do whose answers all branch.") nil acc))
      ((and (consp answers)
            (not (or other refusal (subsetp-eq answers (append accept case-codes)))))
       (mv (msg "answers ~x0 are not routed and the arm has no :on-refusal."
                (set-difference-eq answers (append accept case-codes))) nil acc))
      ((and (not (consp answers)) (not (or other refusal)))
       (mv (msg "an operation with an open answer set needs a :case :otherwise or the arm's :on-refusal.") nil acc))
      (t
       (mv-let (err1 cont acc) (if accept (fn2-arms-steps rest env acc (1- fuel)) (mv nil nil acc))
         (mv-let (err2 branches acc) (fn2-arms-case-branches code cases env acc (1- fuel))
           (mv-let (err3 tail acc)
             (cond (other (fn2-arms-steps (cdr other) env acc (1- fuel)))
                   (refusal (fn2-arms-steps refusal env acc (1- fuel)))
                   (t (fn2-arms-steps '((:stop :machine-contract)) env acc (1- fuel))))
             (mv (or err1 err2 err3)
                 `(cond ,@(and accept `(((member-eq ,code ',accept) ,cont)))
                        ,@branches
                        (t ,tail))
                 acc)))))))))
 (defun fn2-arms-case-branches (code cases env acc fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (cond ((zp fuel) (mv (msg "too deep.") nil acc))
         ((atom cases) (mv nil nil acc))
         ((eq (caar cases) :otherwise) (fn2-arms-case-branches code (cdr cases) env acc (1- fuel)))
         (t (mv-let (err a acc) (fn2-arms-steps (cdar cases) env acc (1- fuel))
              (mv-let (err2 b acc) (fn2-arms-case-branches code (cdr cases) env acc (1- fuel))
                (mv (or err err2) (cons `((member-eq ,code ',(caar cases)) ,a) b) acc))))))
 (defun fn2-arms-cond (clauses env acc fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (cond ((zp fuel) (mv (msg "too deep.") nil acc))
         ((atom clauses) (mv (msg "a :cond ends with a (t STEP ...) clause.") nil acc))
         ((eq (caar clauses) t)
          (if (cdr clauses) (mv (msg "a :cond's t clause is its last.") nil acc)
            (fn2-arms-steps (cdar clauses) env acc (1- fuel))))
         (t (mv-let (err test acc) (fn2-arms-expr (caar clauses) env acc (1- fuel))
              (mv-let (err2 a acc) (fn2-arms-steps (cdar clauses) env acc (1- fuel))
                (mv-let (err3 b acc) (fn2-arms-cond (cdr clauses) env acc (1- fuel))
                  (mv (or err err2 err3) `(if ,test ,a ,b) acc)))))))
 (defun fn2-arms-case (key arms env acc fuel)
   (declare (xargs :verify-guards nil :measure (nfix fuel)))
   (cond ((zp fuel) (mv (msg "too deep.") nil acc))
         ((atom arms) (mv (msg "a :case ends with an :otherwise.") nil acc))
         ((eq (caar arms) :otherwise) (fn2-arms-steps (cdar arms) env acc (1- fuel)))
         (t (mv-let (err a acc) (fn2-arms-steps (cdar arms) env acc (1- fuel))
              (mv-let (err2 b acc) (fn2-arms-case key (cdr arms) env acc (1- fuel))
                (mv (or err err2) `(if (member-equal ,key ',(caar arms)) ,a ,b) acc)))))))

; ----------------------------------------------------------------------
; An arm entry: (TAG [:from (P ...)] [:on-refusal (STEP ...)] STEP ...).
(defun fn2-arms-options (entry)
  ; (mv from refusal steps)
  (declare (xargs :verify-guards nil :measure (acl2-count entry)))
  (if (and (consp entry) (member-eq (car entry) '(:from :on-refusal)) (consp (cdr entry)))
      (mv-let (from refusal steps) (fn2-arms-options (cddr entry))
        (if (eq (car entry) :from) (mv (cadr entry) refusal steps) (mv from (cadr entry) steps)))
    (mv nil nil entry)))
(defun fn2-arms-env (kind tag observe refusal subs children world)
  (declare (xargs :verify-guards nil))
  (list :kind kind :tag tag :observe observe :columns (fn2-machine-property kind :columns world)
        :children (and children (fn2-arms-kind-tuple kind world))
        :subs subs :refusal refusal :world world :written nil :next nil :lets nil
        :budget (fn2-machine-property kind :budget world)))
(defun fn2-arms-max-dim (charges i)
  (declare (xargs :verify-guards nil))
  (if (atom charges) 0 (max (nfix (nth i (car charges))) (fn2-arms-max-dim (cdr charges) i))))
(defun fn2-arms-fn-name (kind infix tag)
  (declare (xargs :verify-guards nil))
  (fn2-arms-sym kind (concatenate 'string infix (symbol-name tag))))
(defun fn2-arms-own-table (kind tables)
  (declare (xargs :verify-guards nil))
  (remove-eq (fn2-arms-sym kind "-TABLE") tables))
; The derived contract, in the registry's arm-entry shape (R7).
(defun fn2-arms-contract (kind tag observe from acc world)
  (declare (xargs :verify-guards nil) (ignorable world))
  (let* ((charges (fn2-arm-get :charges acc))
         (cost (if observe '(:steps *fn2-work-transition*)
                 (list :bytes (fn2-arms-max-dim charges 0) :steps (fn2-arms-max-dim charges 1)
                       :descriptors (fn2-arms-max-dim charges 2))))
         (next (if (and (not observe) (fn2-arm-get :stay acc))
                   (union-eq (list tag) (fn2-arm-get :nexts acc)) (fn2-arm-get :nexts acc))))
    (append (list :cost cost
                  :writes (remove-eq 'phase (fn2-arm-get :writes acc))
                  :tables (union-eq (fn2-arms-own-table kind (fn2-arm-get :tables acc))
                                    (fn2-machine-directory-child (fn2-arm-get :writes acc)))
                  :next next :uses (fn2-arm-get :uses acc))
            (and observe from (list :from from)))))
(defun fn2-arms-fn-events (name kind observe acc body contract world)
  (declare (xargs :verify-guards nil))
  (let* ((args (if observe *fn2-arms-observe-args* '(id budget)))
         (pos (if observe 1 4))
         (reads (fn2-arm-get :reads acc))
         (bindings (fn2-machine-read-bindings kind reads (fn2-machine-property kind :columns world)))
         (refused (if observe
                      '(let ((fn2-core (fn2-core-stop *fn2-stop-reason-machine-observation* fn2-core)))
                         (mv *fn2-none* fn2-core))
                    '(let ((fn2-core (fn2-core-stop *fn2-stop-reason-machine-phase* fn2-core)))
                       (mv 0 *fn2-work-empty* 0 nil fn2-core))))
         (wrapped `(if (eq (,(fn2-arms-sym kind "-SNAPSHOT-READ-CODE") id fn2-core) :ok)
                       ,(if bindings `(let ,bindings (declare (ignorable ,@reads)) ,body) body)
                     ,refused)))
    (list (fn2-operation-events (list :machine kind) name 'fn2-core args
            (append (make-list pos :initial-element :value) '(fn2-core)) nil :callbacks
            `(declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)) (ignorable ,@args))
            (list wrapped)
            `((fn2-core-preserves ,name (,@args fn2-core) :position ,pos :rows nil))
            (list :writes (fn2-arm-get :writes contract) :cost (fn2-arm-get :cost contract)
                  :refusal nil :contract contract
                  :cost-values (fn2-cost-values (fn2-arm-get :cost contract) world))))))

(defun fn2-arms-child-fn-events (name kind observe acc body world)
  (declare (xargs :verify-guards nil))
  (let* ((tuple (fn2-arms-kind-tuple kind world))
         (reads (fn2-arm-get :reads acc))
         (bindings (fn2-arms-child-bindings kind reads (fn2-machine-property kind :columns world))))
    `((fn2-arms-child-emit ,(fn2-arms-child-name name)
        (id slot kind ordinal ,@(if observe (cdr *fn2-arms-observe-args*) '(budget)))
        ,(if observe 1 4) ,kind ,tuple
        ,(if bindings `(let ,bindings (declare (ignorable ,@reads)) ,body) body)
        nil nil
        ,(fn2-arms-child-callees (fn2-arm-get :uses acc) world)
        ,(append (fn2-arms-column-readers kind (fn2-machine-property kind :table world))
                 (fn2-arms-column-readers 'fn2-machines *fn2-machine-directory-fields*))
        nil))))
(defun fn2-arms-extra-lets (extras)
  (declare (xargs :verify-guards nil))
  (if (atom extras) nil
    (cons `(,(cdar extras) (,(caar extras) fn2-core)) (fn2-arms-extra-lets (cdr extras)))))
; The core face of a child-form arm (in the kind's callbacks section): one
; stobj-let of the children, the row's slot read from the directory.
(defun fn2-arms-extras-in (extras tuple)
  (declare (xargs :verify-guards nil))
  (cond ((atom extras) nil)
        ((member-eq (cdar extras) tuple) (cons (car extras) (fn2-arms-extras-in (cdr extras) tuple)))
        (t (fn2-arms-extras-in (cdr extras) tuple))))
(defun fn2-arms-face-lets (kind tuple extras)
  ; the stobj-let bindings of a face: the children in TUPLE, each through its core field
  (declare (xargs :verify-guards nil))
  (append (and (member-eq kind tuple) `((,kind (,(fn2-arms-sym kind "-TABLE") fn2-core))))
          (and (member-eq 'fn2-machines tuple) '((fn2-machines (fn2-core-machines fn2-core))))
          (and (member-eq 'fn2-pool tuple) '((fn2-pool (fn2-core-pool fn2-core))))
          (and (member-eq 'fn2-ops tuple) '((fn2-ops (fn2-core-ops fn2-core))))
          (and (member-eq 'fn2-control tuple) '((fn2-control (fn2-core-control fn2-core))))
          (fn2-arms-extra-lets (fn2-arms-extras-in extras tuple))))
(defun fn2-arms-wrapper-events (name kind observe contract world)
  (declare (xargs :verify-guards nil))
  (let* ((args (if observe *fn2-arms-observe-args* '(id budget)))
         (pos (if observe 1 4))
         (extras (mv-let (err extras) (fn2-arms-extra-children kind world) (declare (ignore err)) extras))
         (full (fn2-arms-kind-tuple kind world))
         ;; the child function's own tuple (fn2-arms-child-sigs): it takes INS
         ;; and returns OUTS; the face binds INS and the control (a refused
         ;; row stops the core) and writes back what changed
         (sig (fn2-arms-sig (fn2-arms-child-name name) world))
         (ins (car sig)) (outs (cadr sig))
         (tuple (fn2-arms-order (cons 'fn2-control ins) full))
         (prods (fn2-arms-order (cons 'fn2-control outs) full))
         (results (if observe '(wake) '(bytes steps descriptors runnable)))
         (ordinal (fn2-columns-pre "*" (fn2-columns-sym kind "-ADMISSION-ORDINAL*")))
         (refused (if observe
                      '(let ((fn2-core (fn2-core-stop *fn2-stop-reason-machine-observation* fn2-core)))
                         (mv *fn2-none* fn2-core))
                    '(let ((fn2-core (fn2-core-stop *fn2-stop-reason-machine-phase* fn2-core)))
                       (mv 0 *fn2-work-empty* 0 nil fn2-core))))
         (inner-refused (if observe
                            `(let ((fn2-control (fn2-control-record-stop *fn2-stop-reason-machine-observation* fn2-control)))
                               (mv *fn2-none* ,@prods))
                          `(let ((fn2-control (fn2-control-record-stop *fn2-stop-reason-machine-phase* fn2-control)))
                             (mv 0 *fn2-work-empty* 0 nil ,@prods))))
         (call `(,(fn2-arms-child-name name) id slot ,(fn2-columns-pre "*" (fn2-columns-sym kind "-KIND*"))
                 ,(if (fn2-cost-constant ordinal world) ordinal 0)
                 ,@(cdr args) ,@ins))
         (body
          `(if (eq (,(fn2-arms-sym kind "-SNAPSHOT-READ-CODE") id fn2-core) :ok)
               (stobj-let ,(fn2-arms-face-lets kind tuple extras)
                 (,@results ,@prods)
                 (let ((slot (if (and (natp id) (< id (fn2-machines-rows fn2-machines)))
                                 (fn2-machines-slot id fn2-machines) *fn2-none*)))
                   (if (and (natp slot) (< slot (,(fn2-arms-sym kind "-ROWS") ,kind))
                            (natp id) (< id (fn2-machines-rows fn2-machines)))
                       ,(if (equal outs prods) call
                          (fn2-arms-bind (append results outs) call (fn2-arms-mvx (append results prods))))
                     ,inner-refused))
                 (mv ,@results fn2-core))
             ,refused)))
    (list (fn2-operation-events (list :machine kind) name 'fn2-core args
            (append (make-list pos :initial-element :value) '(fn2-core)) nil :callbacks
            `(declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)) (ignorable ,@args))
            (list body)
            `((fn2-core-preserves ,name (,@args fn2-core) :position ,pos :rows nil))
            (list :writes (fn2-arm-get :writes contract) :cost (fn2-arm-get :cost contract)
                  :refusal nil :contract contract
                  :cost-values (fn2-cost-values (fn2-arm-get :cost contract) world))))))
; MODE: :core (arms over fn2-core, in the kind's callbacks section),
; :children (the child-form arms, in the kind's own book) or :wrappers (their
; core faces and the derived contracts, in the callbacks section).
(defun fn2-arms-mode-events (mode name kind observe acc code contract world)
  (declare (xargs :verify-guards nil))
  (case mode
    (:core (fn2-arms-fn-events name kind observe acc code contract world))
    (:children (fn2-arms-child-fn-events name kind observe acc code world))
    (otherwise (fn2-arms-wrapper-events name kind observe contract world))))
; Sub-arms in declaration order; each sees the ones before it.
(defun fn2-arms-subs (kind entries subs events mode world)
  ; (mv err subs events)
  (declare (xargs :verify-guards nil))
  (if (atom entries) (mv nil subs events)
    (let ((name (caar entries)))
      (mv-let (from refusal steps) (fn2-arms-options (cdar entries))
      (declare (ignore from))
      (mv-let (err code acc)
        (fn2-arms-steps steps (fn2-decl-set :site (concatenate 'string "SUB-" (symbol-name name))
                                (fn2-arms-env kind nil nil refusal subs (not (eq mode :core)) world)) nil 100000)
        (if err (mv (msg "~x0 sub-arm ~x1: ~@2" kind name err) nil nil)
          (fn2-arms-subs kind (cdr entries) (append subs (list (cons name acc)))
            (append events
                    (and (not (eq mode :wrappers)) (fn2-arm-get :aux acc))
                    (case mode
                      (:core (fn2-arms-fn-events (fn2-arms-fn-name kind "-SUB-" name) kind nil acc code
                                                 (fn2-arms-contract kind nil nil nil acc world) world))
                      (:children (fn2-arms-child-fn-events (fn2-arms-fn-name kind "-SUB-" name) kind nil acc code world))
                      (otherwise nil)))
            mode world)))))))
(defun fn2-arms-arms (kind entries observe subs entries-out events mode world)
  ; (mv err contract-entries events)
  (declare (xargs :verify-guards nil))
  (if (atom entries) (mv nil entries-out events)
    (let ((tag (caar entries)))
      (mv-let (from refusal steps) (fn2-arms-options (cdar entries))
        (mv-let (err code acc)
          (fn2-arms-steps steps (fn2-decl-set :site (symbol-name tag)
                                  (fn2-arms-env kind tag observe refusal subs (not (eq mode :core)) world)) nil 100000)
          (if err (mv (msg "~x0 ~s1 ~x2: ~@3" kind (if observe "handler" "arm") tag err) nil nil)
            (let* ((name (fn2-arms-fn-name kind (if observe "-ON-" "-RUN-") tag))
                   (contract (fn2-arms-contract kind tag observe from acc world)))
              (fn2-arms-arms kind (cdr entries) observe subs
                             (append entries-out (list (list* tag name contract)))
                             (append events (and (not (eq mode :wrappers)) (fn2-arm-get :aux acc))
                                     (fn2-arms-mode-events mode name kind observe acc code contract world))
                             mode world))))))))
; Reachability (D F12): the phases no arm or handler's :next names, other
; than the entry phases (the first, :free, the admission's and the take's,
; and an :initial phase), reported when the contracts are registered.
(defun fn2-arms-nexts (entries)
  (declare (xargs :verify-guards nil))
  (if (atom entries) nil (union-eq (fn2-arm-get :next (cddar entries)) (fn2-arms-nexts (cdr entries)))))
(defun fn2-arms-initial-phase (kind states initial)
  (declare (xargs :verify-guards nil))
  (let ((v (cadr (assoc-eq 'phase initial))))
    (if (atom states) nil
      (if (eq v (fn2-arms-phase-constant kind (car states))) (list (car states))
        (fn2-arms-initial-phase kind (cdr states) initial)))))
(defun fn2-arms-unreached (kind conts obs world)
  (declare (xargs :verify-guards nil))
  (let* ((states (fn2-machine-property kind :states world))
         (entry (append (and (consp states) (list (car states))) '(:free)
                        (list (fn2-arm-get :phase (fn2-machine-property kind :admission world))
                              (fn2-arm-get :phase (fn2-machine-property kind :taken world)))
                        (fn2-arms-initial-phase kind states (fn2-machine-property kind :initial world)))))
    (set-difference-eq states (union-eq entry (union-eq (fn2-arms-nexts conts) (fn2-arms-nexts obs))))))
(defun fn2-arms-events (kind mode world)
  ; (mv err form)
  (declare (xargs :verify-guards nil))
  (mv-let (err extras) (if (eq mode :core) (mv nil nil) (fn2-arms-extra-children kind world))
  (declare (ignore extras))
  (if err (mv err nil)
  (mv-let (err subs sub-events)
    (fn2-arms-subs kind (fn2-machine-declared kind :subarms world) nil nil mode world)
    (if err (mv err nil)
      (mv-let (err conts run-events)
        (fn2-arms-arms kind (fn2-machine-declared kind :arms world) nil subs nil nil mode world)
        (if err (mv err nil)
          (mv-let (err obs obs-events)
            (fn2-arms-arms kind (fn2-machine-declared kind :observe-arms world) t subs nil nil mode world)
            (if err (mv err nil)
              (mv nil `(progn ,@(and (not (eq mode :children))
                                     (let ((unreached (fn2-arms-unreached kind conts obs world)))
                                       `((table fn2-machine-arm-contracts ',kind
                                                '(:continuations ,conts :observes ,obs :unreached ,unreached))
                                         ,@(and unreached
                                                `((value-triple (cw "~x0: no arm reaches the phases ~x1.~%" ',kind ',unreached)))))))
                              ,@sub-events ,@run-events ,@obs-events)))))))))))
; The kind's arms, generated in its callbacks section (before defmachine-run).
; (defmachine-arms K): arms over the core; (defmachine-arms K :children) in
; K's own book, then (defmachine-arms K :wrappers) in its callbacks section.
(defmacro defmachine-arms (kind &optional (mode ':core))
  `(make-event
    (mv-let (err form) (fn2-arms-events ',kind ',mode (w state))
      (if err (er soft 'defmachine-arms "~@0" err) (value form)))))

; ----------------------------------------------------------------------
; MACHINE-FORM 6.5 P4: a partitioned kind's registry operations in child
; form, in the kind's own book: (defmachine-registry K) emits
; fn2-machine-admit-K-children (an admitted kind) or fn2-machine-take-K-children
; (a taken kind) over (K fn2-machines fn2-pool fn2-control), with the kind's
; ordinal and kind code as formals. The admission section makes each core
; face one stobj-let (machines.lisp, fn2-machine-admission-events), so the
; assembly proves no partition's body.
(defconst *fn2-arms-registry-children* '(fn2-machines fn2-pool fn2-control))
(defconst *fn2-arms-registry-callees*
  '(fn2-machines-free-head-of fn2-machines-partition-install fn2-machines-park-taken
    fn2-pool-reserve fn2-core-release-children))
(defun fn2-arms-registry-releases (n body)
  ; release ranges n-1..0, then BODY
  (declare (xargs :verify-guards nil :measure (nfix n)))
  (if (zp n) body
    (let ((i (- n 1)))
      `(mv-let (rc fn2-pool fn2-control)
         (fn2-core-release-children ,(packn-pos (list 'slot i) 'fn2-core) ,(packn-pos (list 'pgen i) 'fn2-core)
                                    kind target gen fn2-pool fn2-control)
         (declare (ignore rc))
         ,(fn2-arms-registry-releases i body)))))
(defun fn2-arms-registry-reserves (specs n install fail)
  (declare (xargs :verify-guards nil))
  (if (atom specs) install
    (let ((code (packn-pos (list 'code n) 'fn2-core)))
      `(mv-let (,code ,(packn-pos (list 'slot n) 'fn2-core) ,(packn-pos (list 'pgen n) 'fn2-core) fn2-pool)
         (fn2-pool-reserve ,(fn2-arm-get :class (cdar specs)) kind target gen fn2-pool)
         (if (not (eq ,code :ok))
             ,(fn2-arms-registry-releases n fail)
           ,(fn2-arms-registry-reserves (cdr specs) (+ 1 (nfix n)) install fail))))))
(defun fn2-arms-registry-events (kind world)
  (declare (xargs :verify-guards nil))
  (let* ((adm (fn2-machine-property kind :admission world))
         (tk (fn2-machine-property kind :taken world))
         (spec (or adm tk))
         (specs (fn2-machine-range-specs (fn2-arm-get :ranges spec)))
         (copies (fn2-arm-get :copy spec))
         (phase (fn2-arms-phase-constant kind (fn2-arm-get :phase spec)))
         (tuple (cons kind *fn2-arms-registry-children*))
         (name (fn2-arms-child-name (fn2-columns-sym (if adm 'fn2-machine-admit- 'fn2-machine-take-) (symbol-name kind))))
         (formals (append (if adm '(index nonce) '(waiter)) copies '(ordinal kind) tuple))
         (rowkind (fn2-arm-get :rows tk))
         (reason (and tk (fn2-columns-pre "*" (fn2-columns-sym 'fn2-wait- (concatenate 'string (symbol-name rowkind) "*")))))
         (park `(fn2-machines-park-taken waiter ordinal ,reason fn2-machines fn2-control))
         (put `(,(fn2-arms-sym kind "-PUT-CHILDREN") target slot
                (phase ,phase) ,@(and adm '((cap-index index) (cap-nonce nonce)))
                ,@(fn2-machine-range-puts specs 0)
                ,@(fn2-machine-copy-puts copies)
                ,@(fn2-machine-zero-puts (fn2-arm-get :clear spec))
                (wait-reason *fn2-wait-none*)))
         (install
          `(mv-let (fn2-machines fn2-control)
             (fn2-machines-partition-install ordinal target next ,(if adm nil t) fn2-machines fn2-control)
             (mv-let (,kind fn2-machines fn2-control) ,put
               (mv :ok ,@(and tk '(target gen)) ,@tuple))))
         (fail (if adm `(mv :pool ,@tuple)
                 `(mv-let (fn2-machines fn2-control) ,park (mv :pool *fn2-none* 0 ,@tuple))))
         (no-row (if adm `(mv :no-row ,@tuple)
                   `(mv-let (fn2-machines fn2-control) ,park (mv :no-row *fn2-none* 0 ,@tuple))))
         (body
          `(let* ((target (fn2-machines-free-head-of ordinal fn2-machines))
                  (slot (if (fn2-machines-row-ok target) (fn2-machines-slot target fn2-machines) *fn2-none*)))
             (if (or (equal target *fn2-none*)
                     (not (fn2-machines-row-ok target))
                     (not (equal (fn2-machines-kind target fn2-machines) kind))
                     (not (and (natp slot) (< slot (,(fn2-arms-sym kind "-ROWS") ,kind))))
                     (not (and (natp ordinal) (< ordinal *fn2-machine-admitted-max*)))
                     ,@(and tk '((zp (fn2-machines-admission-creditsi ordinal fn2-machines))))
                     (>= (fn2-machines-active-counti ordinal fn2-machines)
                         (fn2-machines-connection-counti ordinal fn2-machines)))
                 ,no-row
               (let ((gen (,(fn2-columns-col-name kind 'generation) slot ,kind))
                     (next (,(fn2-columns-col-name kind 'next-free) slot ,kind)))
                 (declare (ignorable gen))
                 ,(fn2-arms-registry-reserves specs 0 install fail))))))
    (if (not spec) (er hard 'defmachine-registry "~x0 is neither admitted nor taken." kind)
      `((defun ,name ,formals
          (declare (xargs :stobjs ,tuple
                          :guard (and (,(fn2-arms-sym kind "-WFP") ,kind) (fn2-machines-wfp fn2-machines)
                                      (fn2-pool-wfp fn2-pool) (fn2-control-wfp fn2-control)
                                      ,@(and adm '((unsigned-byte-p 32 index) (unsigned-byte-p 32 nonce)))
                                      ,@(fn2-machine-copy-guards copies kind world))
                          :guard-hints (("Goal" :in-theory (disable ,@*fn2-arms-registry-callees*))))
                   (ignorable ,@formals))
          ,body)
        ;; as an arm's shape theorems, but with unsigned-byte-p open: an
        ;; enum copy's guard is (< v COUNT) and the setter's rule wants its width
        (in-theory (disable ,name))
        ,@(fn2-arms-child-shape-thms name (fn2-arms-child-shape-terms tuple (if adm 1 3) (cons name formals))
            (fn2-arms-child-shape-hyps tuple)
            `(("Goal" :in-theory (e/d (,name) (min nfix nth ,@(fn2-arms-shape-fns tuple)
                                               fn2-machines-slot fn2-machines-kind ,(fn2-arms-sym kind "-ROWS")
                                               ,@(fn2-arms-column-readers kind (fn2-machine-property kind :table world))
                                               ,@(fn2-arms-column-readers 'fn2-machines *fn2-machine-directory-fields*)
                                               ,@*fn2-arms-registry-callees*))
                      :do-not '(generalize fertilize eliminate-destructors)))
            0)))))
(defmacro defmachine-registry (kind)
  `(make-event (value (cons 'progn (fn2-arms-registry-events ',kind (w state))))))

; Scalar executor access, separate from scheduling policy.
(in-package "ACL2")
(include-book "assembly")

(in-theory (disable fn2-ops-post-count
                    fn2-ops-clock-posted fn2-ops-signals))
(defthm fn2-exec-core-child-shapes
  (implies (fn2-core-wfp fn2-core)
           (and (fn2-sched-wfp (fn2-core-sched fn2-core))
                (fn2-trace-wfp (fn2-core-trace fn2-core))
                (fn2-control-wfp (fn2-core-control fn2-core))))
  :hints (("Goal" :in-theory (enable fn2-core-wfp))))

(defmacro fn2-exec-access (field width)
  (let ((get (fn2-columns-col-name 'fn2-exec field))
        (put (fn2-columns-col-name 'fn2-exec (fn2-columns-pre "SET-" field)))
        (read (fn2-columns-col-name 'fn2-control field))
        (write (fn2-columns-pre "UPDATE-" (fn2-columns-col-name 'fn2-control field))))
    `(progn
       (in-theory (disable ,read))
       (fn2-defoperation (:columns fn2-control) :access :infer
       (defun ,get (fn2-core)
         (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
         (stobj-let ((fn2-control (fn2-core-control fn2-core)))
           (value) (,read fn2-control) value)))
       (defthm ,(fn2-columns-sym get "-NATP")
         (implies (fn2-corep fn2-core) (natp (,get fn2-core))) :rule-classes :type-prescription)
       (defthm ,(fn2-columns-sym get "-BOUND")
         (implies (fn2-corep fn2-core) (< (,get fn2-core) ,(expt 2 width))) :rule-classes :linear)
       (fn2-defoperation (:columns fn2-control) :access :infer
       (defun ,put (value fn2-core)
         (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
         (stobj-let ((fn2-control (fn2-core-control fn2-core)))
           (fn2-control)
           (if (unsigned-byte-p ,width value) (,write value fn2-control) fn2-control)
           fn2-core)))
       (fn2-core-preserves ,put (value fn2-core) :rows nil :prefix "" :hints (("Goal" :in-theory (enable fn2-core-wfp))))
       (in-theory (disable ,get)))))
(fn2-exec-access h 32)
(fn2-exec-access k 32)
(fn2-exec-access aturn 32)
(fn2-exec-access stop 1)
(fn2-exec-access idle-deadline 60)
(fn2-exec-access wake-generation 60)
(fn2-exec-access armed-deadline 60)
(fn2-exec-access now 60)
(fn2-exec-access timer-cursor 32)
(fn2-exec-access turn-bytes 60)
(fn2-exec-access turn-steps 60)

(defun fn2-core-idle-deadline (fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (fn2-exec-idle-deadline fn2-core))

(defun fn2-exec-wake (id fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                  :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
  (if (equal id *fn2-none*) fn2-core
    (if (not (eq (fn2-machine-principal-slot-read-code id fn2-core) :ok))
        (fn2-core-stop *fn2-stop-reason-wake-bounds* fn2-core)
  (let ((principal (fn2-machine-principal-slot id fn2-core)))
    (stobj-let ((fn2-sched (fn2-core-sched fn2-core)))
      (code fn2-sched) (fn2-sched-make-runnable id principal fn2-sched)
      (case code
        ((:ok :already) fn2-core)
        (:bounds (fn2-core-stop *fn2-stop-reason-wake-bounds* fn2-core))
        (otherwise (fn2-core-stop *fn2-stop-reason-wake-state* fn2-core))))))))
(fn2-core-preserves fn2-exec-wake (id fn2-core) :rows nil :prefix "" :hints (("Goal" :in-theory (enable fn2-core-wfp))))

(defun fn2-exec-queued (fn2-core)
  (declare (xargs :stobjs fn2-core))
  (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
    (n) (fn2-outbox-queued fn2-ops) n))
(defthm fn2-exec-queued-natp
  (implies (fn2-corep fn2-core) (natp (fn2-exec-queued fn2-core)))
  :rule-classes :type-prescription)
(in-theory (disable fn2-exec-queued))

(defun fn2-exec-credit-p (fn2-core)
  (declare (xargs :stobjs fn2-core))
  (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
    (yes) (and (< 0 (fn2-ops-free-count fn2-ops))
               (< 0 (fn2-ops-outbox-credits fn2-ops))) yes))

(defun fn2-exec-observation-p (fn2-core)
  (declare (xargs :stobjs fn2-core))
  (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
    (yes) (or (< 0 (fn2-ops-post-count fn2-ops))
              (= 1 (fn2-ops-clock-posted fn2-ops))
              (< 0 (fn2-ops-signals fn2-ops))) yes))

(defun fn2-exec-grant-p (fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (fn2-machine-grant-ready-p fn2-core))

(defun fn2-exec-runnable-p (fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (or (fn2-exec-grant-p fn2-core)
      (stobj-let ((fn2-sched (fn2-core-sched fn2-core)))
        (yes) (fn2-sched-eligiblep fn2-sched) yes)))

(defun fn2-exec-status (fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (cond ((= 1 (fn2-exec-stop fn2-core)) :stop)
        ((or (fn2-exec-observation-p fn2-core) (fn2-exec-runnable-p fn2-core)) :more)
        (t :idle)))

(defun fn2-exec-visit (fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-sched (fn2-core-sched fn2-core)))
    (kind principal position fn2-sched) (fn2-sched-visit fn2-sched)
    (mv kind principal position fn2-core)))
(fn2-core-preserves fn2-exec-visit (fn2-core) :position 3 :rows nil :prefix "" :hints (("Goal" :in-theory (enable fn2-core-wfp))))

(defun fn2-exec-pop (principal fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-sched (fn2-core-sched fn2-core)))
    (code id fn2-sched) (fn2-sched-pop-head principal fn2-sched)
    (mv code id fn2-core)))
(fn2-core-preserves fn2-exec-pop (principal fn2-core) :position 2 :rows nil :prefix "" :hints (("Goal" :in-theory (enable fn2-core-wfp))))

(defun fn2-exec-clear-service (service fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-sched (fn2-core-sched fn2-core)))
    (fn2-sched)
    (if (and (natp service) (< service 4))
        (fn2-sched-set-service service 0 fn2-sched) fn2-sched)
    fn2-core))
(fn2-core-preserves fn2-exec-clear-service (service fn2-core) :rows nil :prefix "" :hints (("Goal" :in-theory (enable fn2-core-wfp))))

(defun fn2-exec-trace-actions (left ordinal start fn2-core)
  (declare (xargs :stobjs fn2-core :measure (nfix left)
                  :guard (and (fn2-core-wfp fn2-core) (natp left)
                              (natp ordinal) (natp start))
                  :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
  (if (or (zp left) (>= ordinal 4)) fn2-core
    (let ((fn2-core
           (stobj-let ((fn2-ops (fn2-core-ops fn2-core))
                       (fn2-trace (fn2-core-trace fn2-core)))
             (fn2-trace)
             (mv-let (code slot gen) (fn2-outbox-peek (+ start ordinal) fn2-ops)
               (if (eq code :ok) (fn2-trace-action ordinal slot gen fn2-trace) fn2-trace))
             fn2-core)))
      (fn2-exec-trace-actions (- left 1) (+ ordinal 1) start fn2-core))))
(fn2-core-preserves fn2-exec-trace-actions (left ordinal start fn2-core) :rows nil :prefix "" :hints (("Goal" :in-theory (enable fn2-core-wfp))))

(defun fn2-exec-record (kind id principal position bytes steps actions runnable wake start fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                  :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
  (if (and (not (equal wake *fn2-none*))
           (not (eq (fn2-machine-principal-slot-read-code wake fn2-core) :ok)))
      (fn2-core-stop *fn2-stop-reason-wake-bounds* fn2-core)
  (let* ((wp (if (equal wake *fn2-none*) 0 (fn2-machine-principal-slot wake fn2-core)))
         (fn2-core
          (stobj-let ((fn2-trace (fn2-core-trace fn2-core)))
            (fn2-trace)
            (fn2-trace-append kind id principal position bytes steps actions
                              runnable wake wp start fn2-trace)
            fn2-core)))
    (if (and (natp actions) (natp start))
        (fn2-exec-trace-actions actions 0 start fn2-core) fn2-core))))
(fn2-core-preserves fn2-exec-record (kind id principal position bytes steps actions runnable wake start fn2-core) :rows nil :prefix "" :hints (("Goal" :in-theory (enable fn2-core-wfp))))

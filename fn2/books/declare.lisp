; Internal declaration protocol. Authors use the existing declaration forms.
(in-package "ACL2")

(defun fn2-decl-table (kind)
  (declare (xargs :guard t))
  (case kind (:columns 'fn2-columns) (:machine 'fn2-machine-kinds)
        (:operation-set 'fn2-operation-sets) (:core-child 'fn2-core-children) (:square 'fn2-squares)
        (:correspondence 'fn2-correspondences)
        (:command 'fn2-commands)))
(defun fn2-decl-row (id world)
  (declare (xargs :verify-guards nil))
  (cdr (assoc-eq (cadr id) (table-alist (fn2-decl-table (car id)) world))))
(defun fn2-decl-rows (kind world)
  (declare (xargs :guard (plist-worldp world)))
  (let ((rows (table-alist (fn2-decl-table kind) world)))
    (if (alistp rows) (reverse rows) nil)))
(defun fn2-decl-get (key row)
  (declare (xargs :verify-guards nil))
  (cadr (member-eq key row)))
(defun fn2-decl-set (key value row)
  (declare (xargs :verify-guards nil))
  (if (atom row) (list key value)
    (if (eq key (car row)) (list* key value (cddr row))
      (list* (car row) (cadr row) (fn2-decl-set key value (cddr row))))))
(defun fn2-decl-idp (id)
  (and (true-listp id) (equal (len id) 2) (fn2-decl-table (car id))
       (symbolp (cadr id)) (cadr id) (not (eq (cadr id) t))
       (not (keywordp (cadr id)))))

; Only traverse the suffix containing this admitted event. DEFSTOBJ introduces
; many names: its world entries, not a second naming recipe, are authoritative.
(defun fn2-decl-event-names (tail number)
  (declare (xargs :verify-guards nil))
  (cond ((atom tail) nil)
        ((and (eq (cadar tail) 'absolute-event-number)
              (< (cddar tail) number)) nil)
        ((and (eq (cadar tail) 'absolute-event-number)
              (equal (cddar tail) number))
         (cons (caar tail) (fn2-decl-event-names (cdr tail) number)))
        (t (fn2-decl-event-names (cdr tail) number))))
(defun fn2-decl-positions (n)
  (if (zp n) nil (append (fn2-decl-positions (1- n)) (list (1- n)))))
(defun fn2-decl-artifact (name event visibility world)
  (declare (xargs :verify-guards nil))
  (let* ((formals (getpropc name 'formals :missing world))
         (kind (cond ((getpropc name 'stobj nil world) :stobj)
                     ((getpropc name 'stobj-live-var nil world) :stobj-live-var)
                     ((getpropc name 'theorem nil world) :theorem)
                     ((not (eq formals :missing)) :function)
                     ((not (eq (getpropc name 'macro-args :missing world) :missing)) :macro)
                     (t :constant)))
         (out (and (eq kind :function) (getpropc name 'stobjs-out '(nil) world))))
    (list kind name :section :declaration
          :formals (if (eq kind :macro) (getpropc name 'macro-args nil world)
                     (if (eq formals :missing) nil formals))
          :stobjs-in (and (eq kind :function) (getpropc name 'stobjs-in nil world))
          :stobjs-out out :results (len out) :positions (fn2-decl-positions (len out))
          :visibility visibility :definition event)))
(defun fn2-decl-artifacts (names event visibility world)
  (declare (xargs :verify-guards nil))
  (if (atom names) nil
    (cons (fn2-decl-artifact (car names) event visibility world)
          (fn2-decl-artifacts (cdr names) event visibility world))))
; Walk only event containers, never theorem terms or function bodies. The
; trailing MAKE-EVENT runs inside the encapsulate while local facts still exist.
(mutual-recursion
 (defun fn2-decl-manifest (event visibility world)
   (declare (xargs :verify-guards nil))
   (case (car event)
     (local (fn2-decl-manifest (cadr event) :local world))
     (encapsulate (fn2-decl-manifests (cddr event) visibility world))
     (progn (fn2-decl-manifests (cdr event) visibility world))
     (defcolumns (list (list :columns (list :columns (cadr event))
                            :section :declaration :formals nil :stobjs-in nil
                            :stobjs-out nil :results 0 :positions nil :visibility nil)))
     (defstobj (fn2-decl-artifacts
                (reverse (fn2-decl-event-names world
                           (getpropc (cadr event) 'absolute-event-number -1 world)))
                event visibility world))
     ((defun defun-nx defmacro defconst defthm defthmd)
      (list (fn2-decl-artifact (cadr event) event visibility world)))
     (otherwise nil)))
 (defun fn2-decl-manifests (events visibility world)
   (declare (xargs :verify-guards nil))
   (if (atom events) nil
     (append (fn2-decl-manifest (car events) visibility world)
             (fn2-decl-manifests (cdr events) visibility world)))))

(defun fn2-decl-requiresp (requires world)
  (declare (xargs :verify-guards nil))
  (if (atom requires) (null requires)
    (and (case (caar requires)
           (:declaration (fn2-decl-row (cadar requires) world))
           (:function (and (symbolp (cadar requires)) (cadar requires)
                           (member-eq (fn2-decl-get :at (cddar requires))
                                      '(:index :core :access :callbacks :dispatch :reference :coverage))))
           (:owner (and (fn2-decl-idp (cadar requires))
                        (member-eq (fn2-decl-get :at (cddar requires)) '(:core :coverage)))))
         (fn2-decl-requiresp (cdr requires) world))))
(defun fn2-decl-find-artifact (name entries)
  (declare (xargs :verify-guards nil))
  (if (atom entries) nil
    (if (equal name (cadar entries)) (car entries)
      (fn2-decl-find-artifact name (cdr entries)))))
(defun fn2-decl-definition (name rows)
  (declare (xargs :verify-guards nil))
  (if (atom rows) nil
    (or (fn2-decl-find-artifact name (fn2-decl-get :generated (cdar rows)))
        (fn2-decl-definition name (cdr rows)))))
; Compare submitted definitions, including guards, rather than translated
; bodies (which erase constants). ACL2 itself checks names outside our tables.
(mutual-recursion
 (defun fn2-decl-conflict (event rows world)
   (declare (xargs :verify-guards nil))
   (case (car event)
     (local (fn2-decl-conflict (cadr event) rows world))
     (encapsulate (fn2-decl-conflicts (cddr event) rows world))
     (progn (fn2-decl-conflicts (cdr event) rows world))
     ((defun defun-nx defmacro defconst defthm defthmd defstobj)
      (let ((prior (and (getpropc (cadr event) 'absolute-event-number nil world)
                        (fn2-decl-definition (cadr event) rows))))
        (and prior (not (equal event (fn2-decl-get :definition (cddr prior))))
             (cadr event))))
     (otherwise nil)))
 (defun fn2-decl-conflicts (events rows world)
   (declare (xargs :verify-guards nil))
   (if (atom events) nil
     (or (fn2-decl-conflict (car events) rows world)
         (fn2-decl-conflicts (cdr events) rows world)))))
(defun fn2-decl-reuses (manifest rows)
  (declare (xargs :verify-guards nil))
  (if (atom manifest) nil
    (append (and (fn2-decl-definition (cadar manifest) rows)
                 (list (cadar manifest)))
            (fn2-decl-reuses (cdr manifest) rows))))
(defun fn2-decl-all-rows (world)
  (declare (xargs :verify-guards nil))
  (append (fn2-decl-rows :columns world) (fn2-decl-rows :machine world)
          (fn2-decl-rows :core-child world) (fn2-decl-rows :operation-set world) (fn2-decl-rows :square world)
          (fn2-decl-rows :correspondence world)))
; DEFUN-NX's outer RETURN-LAST only prevents execution; its last argument
; is the translated logical statement. Do not unfold arbitrary functions.
(defun fn2-decl-statement-body (statement world)
  (declare (xargs :verify-guards nil))
  (let ((body (getpropc statement 'unnormalized-body nil world)))
    (if (eq (car body) 'return-last) (cadddr body) body)))
(defun fn2-decl-layer (book explicit)
  (declare (xargs :verify-guards nil))
  (let ((book (concatenate 'string "/" (if (consp book) (cdr book) book))))
    (or explicit
      (cond ((or (search "/fn2/b/" book) (search "/fn2/sprint/b/" book)) :b)
            ((or (search "/fn2/c/" book) (search "/fn2/sprint/c/" book)) :c)
            ((or (search "/fn2/d/" book) (search "/fn2/sprint/d/" book)) :d)
            ((or (search "/fn2/books/" book) (search "/fn2/sim/" book)) :a)
            (t :test)))))
(defmacro fn2-decl-current-book ()
  '(or (car (global-val 'include-book-path (w state)))
       (and (@ certify-book-info)
            (access certify-book-info (@ certify-book-info) :full-book-name))
       (cbd)))
(defmacro fn2-book-layer (layer)
  `(make-event
    (let* ((book (fn2-decl-current-book))
           (old (cdr (assoc-equal book (table-alist 'fn2-book-layers (w state))))))
      (cond ((not (keywordp ',layer))
             (er soft 'fn2-book-layer "Layer must be a keyword: ~x0." ',layer))
            ((and old (not (eq old ',layer)))
             (er soft 'fn2-book-layer "Conflicting layer for ~x0: ~x1 versus ~x2."
                 book old ',layer))
            (t (value `(table fn2-book-layers ',book ',',layer)))))))
(defun fn2-decl-finish (id payload requires events book world)
  (declare (xargs :verify-guards nil))
  (let ((manifest (fn2-decl-manifests events :exported world)))
    `(table ,(fn2-decl-table (car id)) ',(cadr id)
       ',(append payload
           (append (and (eq (car id) :square)
                        (list :translated (fn2-decl-statement-body
                                            (fn2-decl-get :statement payload) world)))
           (list :decl-id id :layer (fn2-decl-layer book
                   (or (fn2-decl-get :layer payload)
                       (cdr (assoc-equal book (table-alist 'fn2-book-layers world)))))
                 :book book :requires requires
                 :generated manifest :signature events
                 :reuse (fn2-decl-reuses manifest (fn2-decl-all-rows world))))))))
(defun fn2-decl-new-events (id payload requires events book)
  (declare (xargs :verify-guards nil))
  `(encapsulate () ,@events
     (make-event
      (if (fn2-decl-requiresp ',requires (w state))
          (value (fn2-decl-finish ',id ',payload ',requires ',events ',book (w state)))
        (er soft 'fn2-declare "Unresolved declaration requirement ~x0." ',id)))))
(defun fn2-decl-reuse-event (id old book)
  (declare (xargs :verify-guards nil))
  `(table ,(fn2-decl-table (car id)) ',(cadr id)
     ',(fn2-decl-set :reuse
         (cons (list :declaration id :book book) (fn2-decl-get :reuse old)) old)))
(defun fn2-decl-input (kind)
  (case kind (:machine :machines) (:core-child :children) ((:square :correspondence) :evidence)))
(defun fn2-decl-sealed (id world)
  (declare (xargs :verify-guards nil))
  (cdr (assoc-eq (fn2-decl-input (car id)) (table-alist 'fn2-input-seals world))))
; Each section records exactly the rows it consumed, independently of other inputs.
(defmacro fn2-seal (input section kind)
  `(make-event
    (value (list 'table 'fn2-input-seals ,input
                 (list 'quote (list :section ,section :rows (fn2-decl-rows ,kind (w state))))))))
(defun fn2-decl-missing (requirements section world)
  (declare (xargs :verify-guards nil))
  (if (atom requirements) nil
    (let ((r (car requirements)))
      (if (and (eq (fn2-decl-get :at (cddr r)) section)
               (not (case (car r)
                      (:function (function-symbolp (cadr r) world))
                      (:owner (fn2-decl-row (cadr r) world))))) r
        (fn2-decl-missing (cdr requirements) section world)))))
(defun fn2-decl-unresolved (rows section world)
  (declare (xargs :verify-guards nil))
  (if (atom rows) nil
    (let* ((row (cdar rows))
           (missing (fn2-decl-missing (fn2-decl-get :requires row) section world)))
      (if missing (list (fn2-decl-get :decl-id row) missing)
        (fn2-decl-unresolved (cdr rows) section world)))))
(defmacro fn2-resolve (section)
  `(make-event
    (let ((missing (fn2-decl-unresolved (fn2-decl-all-rows (w state)) ,section (w state))))
      (if missing (er soft 'fn2-resolve "Section ~x0: unresolved ~x1." ,section missing)
        (value '(value-triple :resolved))))))
(defun fn2-declare (id payload requires events)
  (declare (xargs :verify-guards nil))
  `(make-event
    (let* ((world (w state)) (old (fn2-decl-row ',id world))
           (book (fn2-decl-current-book)))
      (cond
       ((not (fn2-decl-idp ',id)) (er soft 'fn2-declare "Malformed identity ~x0." ',id))
       ((fn2-decl-sealed ',id world)
        (er soft 'fn2-declare "~x0 is declared after section ~x1 consumed its inputs."
            ',id (fn2-decl-get :section (fn2-decl-sealed ',id world))))
       (old
        (if (and (equal (take ,(len payload)
                               ,(if (eq (car id) :square)
                                    '(fn2-decl-set :checks nil
                                       (fn2-decl-set :proof '(:owed) old))
                                  'old)) ',payload)
                 (equal (fn2-decl-get :requires old) ',requires)
                 (equal (fn2-decl-get :signature old) ',events))
            (value (fn2-decl-reuse-event ',id old book))
          (er soft 'fn2-declare "Conflicting declaration ~x0." ',id)))
       ((fn2-decl-conflicts ',events (fn2-decl-all-rows world) world)
        (er soft 'fn2-declare "Conflicting definition in ~x0." ',id))
       (t (value (fn2-decl-new-events ',id ',payload ',requires ',events book)))))))

; Independent ROUND2 C.1-C.3 scheduler and bounded reference transition system.
(in-package "ACL2")
(include-book "executor")

(defun fn2-ref-list-member (x xs)
  (declare (xargs :guard t))
  (and (consp xs)
       (or (equal x (car xs)) (fn2-ref-list-member x (cdr xs)))))
(defun fn2-ref-queue (principal queues)
  (declare (xargs :guard t))
  (if (atom queues) nil
    (if (and (consp (car queues)) (equal principal (caar queues)))
        (cdar queues)
      (fn2-ref-queue principal (cdr queues)))))
(defun fn2-ref-set-queue (principal queue queues)
  (declare (xargs :guard t))
  (if (atom queues) (list (cons principal queue))
    (if (and (consp (car queues)) (equal principal (caar queues)))
        (cons (cons principal queue) (cdr queues))
      (cons (car queues) (fn2-ref-set-queue principal queue (cdr queues))))))
(defun fn2-ref-queued-anywhere (machine queues)
  (declare (xargs :guard t))
  (and (consp queues)
       (or (and (consp (car queues))
                (fn2-ref-list-member machine (cdar queues)))
           (fn2-ref-queued-anywhere machine (cdr queues)))))
(defun fn2-ref-enqueue (machine principal queues)
  (declare (xargs :guard t))
  (if (or (equal machine *fn2-none*)
          (fn2-ref-queued-anywhere machine queues)) queues
    (fn2-ref-set-queue
     principal (append (true-list-fix (fn2-ref-queue principal queues))
                       (list machine)) queues)))

; Build the specification text literally: at most sixteen principal entries,
; then four distinct services, repeated until the principal list is exhausted.
(defun fn2-ref-calendar-build (left principal in-block)
  (declare (xargs :guard (and (natp left) (natp principal) (natp in-block))
                  :measure (nfix left)))
  (if (zp left) nil
    (cons (list :principal principal)
          (if (or (= left 1) (= in-block (1- *fn2-calendar-principals-per-group*)))
              (append '((:service 0) (:service 1) (:service 2) (:service 3))
                      (fn2-ref-calendar-build (1- left) (+ 1 principal) 0))
            (fn2-ref-calendar-build (1- left) (+ 1 principal) (+ 1 in-block))))))
(defun fn2-ref-calendar (principals)
  (declare (xargs :guard t))
  (fn2-ref-calendar-build (nfix principals) 0 0))

; Reference lists = (literal-calendar cursor principal-FIFOs service-flags).
(defun fn2-ref-lists (principals cursor queues)
  (declare (xargs :verify-guards nil))
  (list (fn2-ref-calendar principals) cursor queues '(0 0 0 0)))
(defun fn2-ref-queue-count (queues)
  (declare (xargs :verify-guards nil))
  (if (atom queues) 0 (+ (len (cdar queues)) (fn2-ref-queue-count (cdr queues)))))
(defun fn2-ref-wake (id lists fn2-ref-core)
  (declare (xargs :stobjs fn2-ref-core :verify-guards nil))
  (if (equal id *fn2-none*) (mv lists fn2-ref-core)
    (let* ((valid (eq (fn2-machine-principal-slot-read-code id fn2-ref-core) :ok))
           (principal (and valid (fn2-machine-principal-slot id fn2-ref-core)))
           (queues (nth 2 lists)) (queue (fn2-ref-queue principal queues)))
    (cond ((or (not valid)
               (not (fn2-ref-list-member (list :principal principal) (car lists))))
           (let ((fn2-ref-core (fn2-core-stop *fn2-stop-reason-wake-bounds* fn2-ref-core)))
             (mv lists fn2-ref-core)))
          ((fn2-ref-queued-anywhere id queues) (mv lists fn2-ref-core))
          ((or (>= (len queue) *fn2-none*)
               (>= (fn2-ref-queue-count queues) *fn2-none*)
               (and (consp queue) (not (fn2-machine-idp (car (last queue)) fn2-ref-core))))
           (let ((fn2-ref-core (fn2-core-stop *fn2-stop-reason-wake-state* fn2-ref-core)))
             (mv lists fn2-ref-core)))
          (t (mv (update-nth 2 (fn2-ref-enqueue id principal queues) lists) fn2-ref-core))))))
(defun fn2-ref-queued-p (queues)
  (declare (xargs :verify-guards nil))
  (and (consp queues) (or (consp (cdar queues)) (fn2-ref-queued-p (cdr queues)))))
(defun fn2-ref-eligible-p (lists fn2-ref-core)
  (declare (xargs :stobjs fn2-ref-core :verify-guards nil))
  (or (fn2-ref-queued-p (nth 2 lists)) (member-equal 1 (nth 3 lists))
      (fn2-machine-grant-ready-p fn2-ref-core) (fn2-exec-wake-p fn2-ref-core)))
(defun fn2-ref-observation-p (fn2-ref-core)
  (declare (xargs :stobjs fn2-ref-core :verify-guards nil))
  (stobj-let ((fn2-ops (fn2-core-ops-ref fn2-ref-core)))
    (yes) (or (< 0 (fn2-ops-post-count fn2-ops))
              (= 1 (fn2-ops-clock-posted fn2-ops)) (< 0 (fn2-ops-signals fn2-ops))) yes))
(defun fn2-ref-status (lists fn2-ref-core)
  (declare (xargs :stobjs fn2-ref-core :verify-guards nil))
  (cond ((= 1 (fn2-exec-stop fn2-ref-core)) :stop)
        ((or (fn2-ref-observation-p fn2-ref-core)
             (fn2-ref-eligible-p lists fn2-ref-core)) :more)
        (t :idle)))

; Selection and observation order are here, not in fn2-transition. Only the
; observation/machine semantics, clock state update and ArmWake issuance are
; shared. No fn2-exec-wake/pop/visit/record or sched mutation is called here.
(defun fn2-ref-transition (budget lists fn2-ref-core)
  (declare (xargs :stobjs fn2-ref-core :verify-guards nil))
  (b* (((mv ownerp kind id gen & ) (fn2-core-next-owner fn2-ref-core))
       ((when (fn2-core-posted-p fn2-ref-core))
        (b* ((bytes (if (and ownerp (fn2-machine-charge-kindp kind))
                          (fn2-machine-next-input-bytes fn2-ref-core) 0))
             ((unless (or (not ownerp) (not (fn2-machine-charge-kindp kind))
                          (fn2-machine-work-fits-p kind bytes *fn2-work-transition* 0)))
              (mv 0 0 0 0 0 lists fn2-ref-core))
             ((mv delivered & & & event outcome reason count aux0 aux1 fn2-ref-core)
              (fn2-harvest-one fn2-ref-core))
             ((unless delivered) (mv 1 0 0 0 *fn2-work-transition* lists fn2-ref-core))
             ((mv wake fn2-ref-core)
              (fn2-machine-observe kind id gen event outcome reason count aux0 aux1 fn2-ref-core)))
          (mv-let (lists fn2-ref-core) (fn2-ref-wake wake lists fn2-ref-core)
            (mv 1 0 0 bytes *fn2-work-transition* lists fn2-ref-core))))
       ((when (fn2-ref-observation-p fn2-ref-core))
        (stobj-let ((fn2-ops (fn2-core-ops-ref fn2-ref-core)))
          (clock mono bits fn2-ops)
          (if (= 1 (fn2-ops-clock-posted fn2-ops))
              (mv-let (posted mono real flags fn2-ops) (fn2-take-clock fn2-ops)
                (declare (ignore posted real flags)) (mv t mono 0 fn2-ops))
            (mv-let (bits fn2-ops) (fn2-take-signal fn2-ops) (mv nil 0 bits fn2-ops)))
          (let ((fn2-ref-core (if clock (fn2-exec-clock mono fn2-ref-core)
                               (if (< 0 bits) (fn2-core-stop *fn2-stop-reason-signal* fn2-ref-core) fn2-ref-core))))
            (mv 1 0 0 0 *fn2-work-mailbox* lists fn2-ref-core))))
       ((unless (fn2-ref-eligible-p lists fn2-ref-core))
        (mv 0 0 0 0 0 lists fn2-ref-core))
       (calendar (nth 0 lists)) (cursor (nfix (nth 1 lists)))
       (entry (nth cursor calendar))
       (lists (update-nth 1 (if (< (+ 1 cursor) (len calendar)) (+ 1 cursor) 0) lists))
       (principal (cadr entry))
       ((when (eq (car entry) :service))
        (b* ((lists (update-nth 3 (update-nth principal 0 (nth 3 lists)) lists))
             ((mv wake fn2-ref-core)
              (if (and (equal principal 1) (fn2-machine-grant-ready-p fn2-ref-core))
                  (fn2-machine-grant-one fn2-ref-core) (mv *fn2-none* fn2-ref-core)))
             ((mv actions fn2-ref-core)
              (if (and (equal principal 1) (< 0 (nfix budget)))
                  (fn2-exec-arm fn2-ref-core) (mv 0 fn2-ref-core))))
          (mv-let (lists fn2-ref-core) (fn2-ref-wake wake lists fn2-ref-core)
            (mv 0 1 actions 0 (if (and (equal wake *fn2-none*) (equal actions 0)) *fn2-work-empty* *fn2-work-transition*)
                lists fn2-ref-core))))
       (queue (fn2-ref-queue principal (nth 2 lists)))
       ((when (atom queue)) (mv 0 1 0 0 *fn2-work-empty* lists fn2-ref-core))
       (id (car queue))
       (lists (update-nth 2 (fn2-ref-set-queue principal (cdr queue) (nth 2 lists)) lists))
       ((mv bytes steps actions runnable fn2-ref-core) (fn2-machine-run id budget fn2-ref-core))
       ((mv wake fn2-ref-core) (fn2-machine-take-wake fn2-ref-core))
       ((mv lists fn2-ref-core) (fn2-ref-wake wake lists fn2-ref-core))
       ((mv lists fn2-ref-core)
        (if runnable (fn2-ref-wake id lists fn2-ref-core) (mv lists fn2-ref-core))))
    (mv 0 1 actions bytes steps lists fn2-ref-core)))
(in-theory (disable fn2-ref-transition fn2-ref-eligible-p fn2-ref-observation-p fn2-ref-status))

; Selection evidence is transient list data, independent of the concrete ring.
; Only machine/service selections have an id/principal/calendar position.
(defun fn2-ref-selection (lists fn2-ref-core)
  (declare (xargs :stobjs fn2-ref-core :verify-guards nil))
  (cond ((fn2-core-posted-p fn2-ref-core) (list *fn2-trace-kind-mailbox* nil nil nil))
        ((fn2-ref-observation-p fn2-ref-core)
         (stobj-let ((fn2-ops (fn2-core-ops-ref fn2-ref-core)))
           (selection) (list (if (= 1 (fn2-ops-clock-posted fn2-ops))
                                 *fn2-trace-kind-clock* *fn2-trace-kind-signal*) nil nil nil)
           selection))
        (t (let* ((cursor (nfix (nth 1 lists))) (entry (nth cursor (car lists)))
                  (principal (cadr entry)) (service (eq (car entry) :service)))
             (list (if service *fn2-trace-kind-service* *fn2-trace-kind-machine*)
                   (and (not service) (let ((queue (fn2-ref-queue principal (nth 2 lists))))
                                       (if (consp queue) (car queue) *fn2-none*)))
                   principal cursor)))))
(defun fn2-ref-selections (lists)
  (declare (xargs :verify-guards nil))
  (reverse (true-list-fix (nth 4 lists))))

(defun fn2-ref-loop (fuel h k a obs visits actions bytes steps lists fn2-ref-core)
  (declare (xargs :stobjs fn2-ref-core :verify-guards nil :measure (nfix fuel)))
  (if (or (zp fuel) (>= (nfix obs) (nfix h)) (>= (nfix visits) (nfix k))
          (>= (nfix actions) (nfix a))
          (not (fn2-turn-work-room-p h k visits bytes steps))
          (not (eq (fn2-ref-status lists fn2-ref-core) :more)))
      (let* ((fn2-ref-core (fn2-exec-set-turn-bytes bytes fn2-ref-core))
             (fn2-ref-core (fn2-exec-set-turn-steps steps fn2-ref-core)))
        (mv (fn2-ref-status lists fn2-ref-core) obs visits actions lists fn2-ref-core))
    (let ((selection (fn2-ref-selection lists fn2-ref-core)))
      (mv-let (o v d b s lists fn2-ref-core)
        (fn2-ref-transition (- (nfix a) (nfix actions)) lists fn2-ref-core)
        (let ((lists (if (or (< 0 o) (< 0 v))
                         (update-nth 4 (cons selection (nth 4 lists)) lists) lists)))
          (fn2-ref-loop (- fuel 1) h k a (+ (nfix obs) (nfix o))
                       (+ (nfix visits) (nfix v)) (+ (nfix actions) (nfix d))
                       (+ (nfix bytes) (nfix b)) (+ (nfix steps) (nfix s)) lists fn2-ref-core))))))
(in-theory (disable fn2-ref-loop))
(defun fn2-ref-turn (lists fn2-ref-core)
  (declare (xargs :stobjs fn2-ref-core :verify-guards nil))
  (let ((h (fn2-exec-h fn2-ref-core)) (k (fn2-exec-k fn2-ref-core))
        (a (fn2-exec-aturn fn2-ref-core)))
    (fn2-ref-loop (+ h k) h k a 0 0 0 0 0 (update-nth 4 nil lists) fn2-ref-core)))
(in-theory (disable fn2-ref-turn))

; Read intrusive links ONLY on the concrete side of the relation.
(defun fn2-ref-concrete-queue (fuel id fn2-sched)
  (declare (xargs :stobjs fn2-sched :verify-guards nil :measure (nfix fuel)))
  (cond ((equal id *fn2-none*) nil)
        ((or (zp fuel) (>= (nfix id) (fn2-sched-rows fn2-sched))) '(:bad-chain))
        (t (cons id (fn2-ref-concrete-queue (- fuel 1) (fn2-sched-next id fn2-sched) fn2-sched)))))
(defun fn2-ref-queues-difference (left queues fn2-sched)
  (declare (xargs :stobjs fn2-sched :verify-guards nil :measure (nfix left)))
  (if (zp left) nil
    (let* ((p (- left 1))
           (actual (fn2-ref-concrete-queue (fn2-sched-rows fn2-sched)
                                          (fn2-sched-headsi p fn2-sched) fn2-sched))
           (expected (fn2-ref-queue p queues)))
      (if (and (equal actual expected) (equal (len actual) (fn2-sched-countsi p fn2-sched))
               (equal (fn2-sched-tailsi p fn2-sched)
                      (if (consp actual) (car (last actual)) *fn2-none*)))
          (fn2-ref-queues-difference (- left 1) queues fn2-sched)
        (list :principal-fifo p actual expected)))))
(defun fn2-ref-calendar-difference (calendar i fn2-sched)
  (declare (xargs :stobjs fn2-sched :verify-guards nil))
  (if (atom calendar) nil
    (let* ((e (car calendar)) (p (fn2-sched-nprincipals fn2-sched))
           (code (if (eq (car e) :principal) (cadr e) (+ p (nfix (cadr e))))))
      (if (equal code (fn2-sched-calendari i fn2-sched))
          (fn2-ref-calendar-difference (cdr calendar) (+ 1 (nfix i)) fn2-sched)
        (list :calendar-entry i)))))
(defun fn2-ref-machine-links (id queue prev)
  (declare (xargs :verify-guards nil))
  (if (atom queue) nil
    (if (equal id (car queue))
        (list prev (if (consp (cdr queue)) (cadr queue) *fn2-none*))
      (fn2-ref-machine-links id (cdr queue) (car queue)))))
(defun fn2-ref-machine-queue (id queues)
  (declare (xargs :verify-guards nil))
  (if (atom queues) nil
    (let ((links (fn2-ref-machine-links id (cdar queues) *fn2-none*)))
      (if links (cons (caar queues) links)
        (fn2-ref-machine-queue id (cdr queues))))))
(defun fn2-ref-links-difference (left queues fn2-sched)
  (declare (xargs :stobjs fn2-sched :verify-guards nil :measure (nfix left)))
  (if (zp left) nil
    (let* ((id (- left 1)) (entry (fn2-ref-machine-queue id queues)))
      (if (and (equal (fn2-sched-in-queue id fn2-sched) (if entry 1 0))
               (or (not entry)
                   (and (equal (fn2-sched-principal id fn2-sched) (car entry))
                        (equal (fn2-sched-prev id fn2-sched) (cadr entry))
                        (equal (fn2-sched-next id fn2-sched) (caddr entry)))))
          (fn2-ref-links-difference (- left 1) queues fn2-sched)
        (list :runnable-links id)))))


(defun fn2-ref-scheduler-difference (lists fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-sched (fn2-core-sched fn2-core)))
    (difference)
    (cond ((not (equal (nth 0 lists) (fn2-ref-calendar (fn2-sched-nprincipals fn2-sched))))
           '(:literal-calendar))
          ((not (equal (fn2-sched-queued fn2-sched) (fn2-ref-queue-count (nth 2 lists))))
           '(:runnable-count))
          ((not (equal (fn2-sched-cursor fn2-sched) (nth 1 lists))) '(:calendar-position))
          ((not (equal (fn2-sched-calendar-length fn2-sched) (len (nth 0 lists)))) '(:calendar-length))
          ((not (equal (list (fn2-sched-servicesi 0 fn2-sched) (fn2-sched-servicesi 1 fn2-sched)
                            (fn2-sched-servicesi 2 fn2-sched) (fn2-sched-servicesi 3 fn2-sched))
                       (nth 3 lists))) '(:service-flags))
          (t (or (fn2-ref-calendar-difference (nth 0 lists) 0 fn2-sched)
                 (fn2-ref-queues-difference (fn2-sched-nprincipals fn2-sched) (nth 2 lists) fn2-sched)
                 (fn2-ref-links-difference (fn2-sched-rows fn2-sched) (nth 2 lists) fn2-sched))))
    difference))
(defun fn2-ref-difference (fn2-core fn2-ref-core lists)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (or (fn2-ref-scheduler-difference lists fn2-core)
      (fn2-ref-core-difference fn2-core fn2-ref-core)))
(defun fn2-representation-relation (fn2-core fn2-ref-core lists)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (not (fn2-ref-difference fn2-core fn2-ref-core lists)))
(in-theory (disable fn2-ref-difference fn2-representation-relation))
(defthm-owed fn2-turn-refinement (concrete reference-core reference-lists)
  (implies (and (fn2-corep concrete) (fn2-core-wfp concrete)
                (fn2-ref-corep reference-core) (fn2-core-wfp reference-core)
                (fn2-representation-relation concrete reference-core reference-lists))
    (mv-let (status obs visits actions after) (fn2-turn concrete)
      (mv-let (rstatus robs rvisits ractions lists rafter) (fn2-ref-turn reference-lists reference-core)
        (and (equal (list status obs visits actions) (list rstatus robs rvisits ractions))
             (fn2-core-wfp after) (fn2-core-wfp rafter)
             (fn2-representation-relation after rafter lists)
             (<= actions (fn2-exec-aturn concrete))
             (<= (+ visits (fn2-exec-turn-bytes after) (fn2-exec-turn-steps after) 1)
                 (+ (* (fn2-exec-h concrete) 24) (* (fn2-exec-k concrete) 4129) 1))))))
  :schema :g1 :from (:correspondence fn2-q1)
  :boundary :turn :case-source :composition :claim :representation
  :shared ((:machine fn2-listener) (:machine fn2-echo) (:machine fn2-scribe))
  :teeth (fn2-reference-teeth)
  :doc "Owed refinement to independent list selection, observation ordering and budget accounting; shared bounded machine semantics, no fusion.")

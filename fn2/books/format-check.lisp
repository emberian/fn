 (b* ((fn2-fc (fn2-fc-init 1 fn2-fc)) (fn2-b3 (fn2-b3-table-init 1 fn2-b3))
      (fn2-fc-context (fn2-fc-context-init 1 fn2-fc-context))
      (fn2-fc-context (fn2-fc-spec-context context 0 fn2-fc-context))
      (fn2-fields (fn2-fields-init *fn2-format-sealed-batch-num-fields* fn2-fields))
      (fn2-pool (fn2-pool-init (list (cons 1 (max 1 (len bytes)))) 1 100 fn2-pool))
      ((mv code slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((unless (and (eq code :ok) (equal slot 0) (equal gen 1)))
       (prog2$ (er hard 'fn2-fc-image-run "Fixture reservation failed: ~x0." code)
               (mv nil fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool)))
      (fn2-pool (fn2-fc-spec-load bytes 0 fn2-pool))
      ((mv code fn2-fc fn2-b3 fn2-fields fn2-pool)
       (fn2-format-drive (fn2-format-fuel (len bytes)) 0 kind sealp 0 1 0 (len bytes) 0 1 0 1 budget fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool)))
  (mv (list code (fn2-fc-spec-read (len bytes) 0 fn2-pool)) fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool)))
(defun fn2-fc-image (kind bytes context sealp budget)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fc
  (mv-let (result fn2-fc)
   (with-local-stobj fn2-fc-context
    (mv-let (result fn2-fc fn2-fc-context)
     (with-local-stobj fn2-b3
      (mv-let (result fn2-fc fn2-fc-context fn2-b3)
       (with-local-stobj fn2-fields
        (mv-let (result fn2-fc fn2-fc-context fn2-b3 fn2-fields)
         (with-local-stobj fn2-pool
          (mv-let (result fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool)
           (fn2-fc-image-run kind bytes context sealp budget fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool)
           (mv result fn2-fc fn2-fc-context fn2-b3 fn2-fields)))
         (mv result fn2-fc fn2-fc-context fn2-b3)))
       (mv result fn2-fc fn2-fc-context)))
     (mv result fn2-fc))) result)))
(defun fn2-fc-acceptedp (kind bytes context)
 (declare (xargs :verify-guards nil))
 (eq (car (fn2-fc-image kind bytes context nil 4096)) :ok))
(defun fn2-fc-frame-identity (context)

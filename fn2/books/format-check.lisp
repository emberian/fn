(defun fn2-fc-shape-claims (outputs call)
 (declare (xargs :verify-guards nil))
 (if (atom outputs) nil
  (let* ((obj (caar outputs)) (at (cadar outputs))
         (value (if at `(mv-nth ,at ,call) call))
         (p (fn2-columns-sym obj "P"))
         (wfp (fn2-columns-sym obj "-WFP"))
         (rows (fn2-columns-sym obj "-ROWS")))
   (append `((,p ,value) (,wfp ,value) (equal (,rows ,value) (,rows ,obj)))
           (fn2-fc-shape-claims (cdr outputs) call)))))

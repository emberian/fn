(defun fn2-fc-string-bytes (str n)
 (declare (xargs :verify-guards nil :measure (nfix (- (length str) (nfix n)))))
 (if (>= (nfix n) (length str)) nil
  (cons (char-code (char str n)) (fn2-fc-string-bytes str (+ 1 (nfix n))))))
(defun fn2-fc-covered (kind bytes context)
 (declare (xargs :verify-guards nil))
 (append (fn2-fc-string-bytes (fn2-fc-domain kind) 0)
  (case kind
   (:frame (append (fn2-layout-le 8 (fn2-fc-expected-location context))
                   (fn2-layout-le 8 (fn2-fc-expected-extent-writer-epoch context))
                   (fn2-layout-le 8 (fn2-fc-expected-allocation context))))
   (:seal (append (fn2-layout-le 8 (fn2-fc-expected-history context))
                  (fn2-layout-le 8 (fn2-fc-expected-incarnation context))
                  (fn2-layout-le 8 (fn2-fc-expected-extent context))
                  (fn2-layout-le 8 (fn2-fc-expected-extent-writer-epoch context))
                  (fn2-layout-le 8 (fn2-fc-expected-allocation context))))
   (otherwise nil))
  (if (eq kind :page) bytes
   (append (take (nfix (- (len bytes) 32)) bytes) (make-list 32 :initial-element 0)))))

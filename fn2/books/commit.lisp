 fn2-commit-io-extent fn2-commit-io-epoch fn2-commit-io-counter fn2-commit-io-pool-slot fn2-commit-io-pool-gen fn2-commit-io-op-slot fn2-commit-io-op-gen fn2-commit-io-ready fn2-commit-io-lent
 fn2-commit-rootp fn2-commit-root-wfp fn2-commit-root-rows
 fn2-commit-root-installed fn2-commit-root-published
 fn2-commit-root-proposed fn2-commit-root-parent fn2-commit-root-extent fn2-commit-root-first-key fn2-commit-root-members fn2-commit-root-seal-ready fn2-commit-root-barrier-mode
 fn2-digestsp fn2-digests-wfp fn2-digests-rows
 fn2-fc-context-hash fn2-fc-context-geometry fn2-fc-context-previous-seal)))
(make-event
 (value `(defconst *fn2-commit-proof-children*
           ',(fn2-commit-proof-children *fn2-core-children* (w state)))))
(make-event (value (cons 'progn (fn2-commit-child-events *fn2-commit-proof-children*))))
(defun fn2-commit-idp (id fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (eq (fn2-commit-snapshot-read-code id fn2-core) :ok))
(make-event (value (cons 'progn (fn2-commit-idp-lemmas
  (list* 'slot 'kind (strip-cars (fn2-machine-property 'fn2-commit :columns (w state))))))))
(defthm fn2-commit-idp-from-snapshot
 (implies (equal (fn2-commit-snapshot-read-code id fn2-core) :ok) (fn2-commit-idp id fn2-core)))
(defthm fn2-commit-idp-kind-value
 (implies (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core) (fn2-commit-idp id fn2-core))
          (equal (fn2-machine-kind id fn2-core) *fn2-commit-kind*))
 :hints (("Goal" :in-theory (enable fn2-commit-idp fn2-commit-snapshot-read-code))))
(in-theory (disable fn2-commit-idp))
(defun fn2-commit-invalid-row (fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (let ((fn2-core (fn2-core-stop *fn2-stop-reason-machine-phase* fn2-core)))
  (mv 0 *fn2-work-empty* 0 nil fn2-core)))
(fn2-core-preserves fn2-commit-invalid-row (fn2-core) :position 4 :rows nil)
(defun fn2-commit-row (id fn2-core)
 (declare (xargs :stobjs fn2-core :guard (and (fn2-core-wfp fn2-core) (fn2-commit-idp id fn2-core))))
 (fn2-machine-slot id fn2-core))
(defthm fn2-commit-row-natp
 (implies (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core))
          (natp (fn2-commit-row id fn2-core))) :rule-classes :type-prescription)
(defthm fn2-commit-row-bound
 (implies (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core))
          (< (fn2-commit-row id fn2-core) 4294967296)) :rule-classes :linear)
(in-theory (disable fn2-commit-row))
(defthm fn2-commit-resource-index-bound
 (implies (and (natp row) (< row 2) (natp role) (< role 3))
          (< (+ (* 3 row) role) 6)))
(defun fn2-commit-resource (id role fn2-core)
 (declare (xargs :stobjs fn2-core :guard (and (fn2-core-wfp fn2-core) (fn2-commit-idp id fn2-core))))
 (let ((r (+ (* 3 (fn2-commit-row id fn2-core)) (nfix role))))
 (stobj-let ((fn2-commit-io (fn2-core-commit-io fn2-core)))
  (e epoch counter slot gen)
  (if (and (natp role) (< role 3) (< r (fn2-commit-io-rows fn2-commit-io)))
   (mv (fn2-commit-io-extent r fn2-commit-io) (fn2-commit-io-epoch r fn2-commit-io)
       (fn2-commit-io-counter r fn2-commit-io) (fn2-commit-io-pool-slot r fn2-commit-io)
       (fn2-commit-io-pool-gen r fn2-commit-io))
   (assert$? nil (mv 0 0 0 0 0))) (mv e epoch counter slot gen))))
(in-theory (disable fn2-commit-resource))
(defun fn2-commit-uncertain (id reason fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (fn2-commit-checked id fn2-core
  (fn2-commit-put-core id (phase *fn2-commit-state-uncertain*)
   (cb-failed 1) (cb-reason (if (equal (fn2-machine-cb-failed id fn2-core) 0) reason
                            (fn2-machine-cb-reason id fn2-core))))))
(fn2-core-preserves fn2-commit-uncertain (id reason fn2-core) :rows nil :prefix "")
(defun fn2-commit-timeout (id fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (fn2-commit-checked id fn2-core
  (if (equal (fn2-machine-cb-fence-live id fn2-core) 1)
      (fn2-commit-uncertain id *fn2-commit-reason-timeout* fn2-core) fn2-core)))
(fn2-core-preserves fn2-commit-timeout (id fn2-core) :rows nil :prefix "")
; This fixture's barrier deadline is 1024 monotonic clock ticks. Waiting rows
; remain runnable, so a harvested clock observation is sufficient to expire it.
; A's fn2-exec-now is defined after assembly (executor-access includes it), so
; continuations read the scalar control field directly (seam note to A).
(defun fn2-commit-now (fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-control (fn2-core-control fn2-core))) (now) (fn2-control-now fn2-control) now))
(defthm fn2-commit-now-natp
 (implies (fn2-corep fn2-core) (natp (fn2-commit-now fn2-core)))
 :rule-classes :type-prescription)
(in-theory (disable fn2-commit-now))
; Reserve the extent before preparing any effects; all three writes share it.
(defun fn2-commit-reserve-extent (id fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (fn2-commit-checked id (mv :bounds fn2-core)
 (let ((r (* 3 (fn2-commit-row id fn2-core))))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
             (fn2-commit-io (fn2-core-commit-io fn2-core)))
  (code fn2-extents fn2-commit-io)
  (if (not (< (+ r 2) (fn2-commit-io-rows fn2-commit-io)))
      (assert$? nil (mv :bounds fn2-extents fn2-commit-io))
   (mv-let (code pressure e epoch counter fn2-extents) (fn2-alloc-reserve fn2-extents)
    (declare (ignore pressure))
    (if (not (and (eq code :ok) (unsigned-byte-p 32 e)
                  (unsigned-byte-p 60 epoch) (unsigned-byte-p 60 counter)))
        (mv code fn2-extents fn2-commit-io)
     (let* ((fn2-commit-io (fn2-commit-io-set-extent r e fn2-commit-io))
            (fn2-commit-io (fn2-commit-io-set-epoch r epoch fn2-commit-io))
            (fn2-commit-io (fn2-commit-io-set-counter r counter fn2-commit-io))
            (fn2-commit-io (fn2-commit-io-set-extent (+ r 1) e fn2-commit-io))
            (fn2-commit-io (fn2-commit-io-set-epoch (+ r 1) epoch fn2-commit-io))
            (fn2-commit-io (fn2-commit-io-set-counter (+ r 1) counter fn2-commit-io))
            (fn2-commit-io (fn2-commit-io-set-extent (+ r 2) e fn2-commit-io))
            (fn2-commit-io (fn2-commit-io-set-epoch (+ r 2) epoch fn2-commit-io))
            (fn2-commit-io (fn2-commit-io-set-counter (+ r 2) counter fn2-commit-io)))
       (mv :ok fn2-extents fn2-commit-io)))))
  (mv code fn2-core)))))
(fn2-core-preserves fn2-commit-reserve-extent (id fn2-core) :position 1 :rows nil)
(defun fn2-commit-save-pool (id role slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (fn2-commit-checked id fn2-core
 (let ((r (+ (* 3 (fn2-commit-row id fn2-core)) (nfix role))))
 (stobj-let ((fn2-commit-io (fn2-core-commit-io fn2-core))) (fn2-commit-io)
  (if (and (natp role) (< role 3) (< r (fn2-commit-io-rows fn2-commit-io))
           (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen))
      (let* ((fn2-commit-io (fn2-commit-io-set-pool-slot r slot fn2-commit-io))
             (fn2-commit-io (fn2-commit-io-set-pool-gen r gen fn2-commit-io)))
       (fn2-commit-io-set-ready r 1 fn2-commit-io)) (assert$? nil fn2-commit-io)) fn2-core))))
(fn2-core-preserves fn2-commit-save-pool (id role slot gen fn2-core) :rows nil :prefix "")
 ; Admission is bounded by four pool reservations. On refusal unwind only
; the newly acquired workspaces; no sequence/root or storage effect exists yet.
(defun fn2-commit-release-pool (id role owner-gen fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (fn2-commit-checked id (mv :bounds fn2-core)
 (b* ((scratch (equal role 3))
      ((mv & & & slot gen) (fn2-commit-resource id (if scratch 0 role) fn2-core))
      (r (+ (* 3 (fn2-commit-row id fn2-core)) (nfix role)))
      ((mv code fn2-core)
       (fn2-core-release (if scratch (fn2-machine-pool-slot id fn2-core) slot)
                         (if scratch (fn2-machine-pool-gen id fn2-core) gen)
                         *fn2-commit-kind* id owner-gen fn2-core))
      ((unless (member-eq code '(:ok :retired))) (mv code fn2-core))
      ((when scratch)
       (let ((fn2-core (fn2-commit-put-core id (pool-slot *fn2-none*) (pool-gen 0))))
        (mv code fn2-core))))
  (stobj-let ((fn2-commit-io (fn2-core-commit-io fn2-core))) (fn2-commit-io)
   (if (and (natp role) (< role 3) (< r (fn2-commit-io-rows fn2-commit-io)))
    (let* ((fn2-commit-io (fn2-commit-io-set-ready r 0 fn2-commit-io))
           (fn2-commit-io (fn2-commit-io-set-pool-slot r *fn2-none* fn2-commit-io)))
     (fn2-commit-io-set-pool-gen r 0 fn2-commit-io)) (assert$? nil fn2-commit-io))
   (mv code fn2-core)))))
(fn2-core-preserves fn2-commit-release-pool (id role owner-gen fn2-core) :position 1 :rows nil)
(defun fn2-commit-reserve-pools (left id owner-gen fn2-core)
 (declare (xargs :stobjs fn2-core :measure (nfix left) :verify-guards nil
  :guard (and (fn2-core-wfp fn2-core) (natp left) (<= left 4))))
 (if (zp left) (mv :ok fn2-core)
  (b* ((role (- 4 left))
       ((mv code slot gen fn2-core)
        (fn2-core-reserve (fn2-scribe-window-class fn2-core) *fn2-commit-kind* id
                          owner-gen fn2-core))
       ((unless (eq code :ok)) (mv code fn2-core))
       (fn2-core (if (< role 3) (fn2-commit-save-pool id role slot gen fn2-core)
                   (fn2-commit-put-core id (pool-slot slot) (pool-gen gen))))
       ((mv code fn2-core) (fn2-commit-reserve-pools (- left 1) id owner-gen fn2-core))
       ((when (eq code :ok)) (mv :ok fn2-core))
       ((mv released fn2-core) (fn2-commit-release-pool id role owner-gen fn2-core)))
   (let ((fn2-core (assert$? (member-eq released '(:ok :retired)) fn2-core)))
    (mv code fn2-core)))))
(defthm fn2-commit-reserve-pools-shape
 (implies (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core))
  (and (fn2-corep (mv-nth 1 (fn2-commit-reserve-pools left id owner-gen fn2-core)))
       (fn2-core-wfp (mv-nth 1 (fn2-commit-reserve-pools left id owner-gen fn2-core))))))
(in-theory (disable fn2-commit-reserve-pools))
(verify-guards fn2-commit-reserve-pools)
(defun fn2-commit-release-pools (left id owner-gen fn2-core)
 (declare (xargs :stobjs fn2-core :measure (nfix left)
  :guard (and (fn2-core-wfp fn2-core) (natp left) (<= left 4))))
 (if (zp left) fn2-core
  (mv-let (code fn2-core) (fn2-commit-release-pool id (- left 1) owner-gen fn2-core)
   (let ((fn2-core (assert$? (member-eq code '(:ok :retired)) fn2-core)))
    (fn2-commit-release-pools (- left 1) id owner-gen fn2-core)))))
(fn2-core-preserves fn2-commit-release-pools (left id owner-gen fn2-core) :rows nil :prefix "")
(defun fn2-commit-frontier (fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (batch key capacity mode)
  (if (< 0 (fn2-commit-root-rows fn2-commit-root))
      (mv (+ 1 (fn2-commit-root-proposed 0 fn2-commit-root))
          (fn2-commit-root-first-key 0 fn2-commit-root) (fn2-commit-root-rows fn2-commit-root)
          (fn2-commit-root-barrier-mode 0 fn2-commit-root))
    (assert$? nil (mv 0 0 0 0))) (mv batch key capacity mode)))
(in-theory (disable fn2-commit-frontier))
; Publish the fully reserved proposal before a follower can be admitted.
(defun fn2-commit-prepare-root (id fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (fn2-commit-checked id fn2-core
 (b* (((mv e & & & &) (fn2-commit-resource id 0 fn2-core))
      (batch (fn2-machine-batch-no id fn2-core))
      (first (fn2-machine-first-key id fn2-core)) (members (fn2-machine-member-count id fn2-core)))
 (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (fn2-commit-root)
  (if (and (< 0 batch) (< batch (fn2-commit-root-rows fn2-commit-root))
           (unsigned-byte-p 32 e) (unsigned-byte-p 60 (+ first members)))
   (let* ((fn2-commit-root (fn2-commit-root-set-parent batch (- batch 1) fn2-commit-root))
          (fn2-commit-root (fn2-commit-root-set-extent batch e fn2-commit-root))
          (fn2-commit-root (fn2-commit-root-set-first-key batch first fn2-commit-root))
          (fn2-commit-root (fn2-commit-root-set-members batch members fn2-commit-root))
          (fn2-commit-root (fn2-commit-root-set-first-key 0 (+ first members) fn2-commit-root)))
    (fn2-commit-root-set-proposed 0 batch fn2-commit-root)) (assert$? nil fn2-commit-root)) fn2-core))))
(fn2-core-preserves fn2-commit-prepare-root (id fn2-core) :rows nil :prefix "")
(defun fn2-commit-ready (id fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (stobj-let ((fn2-sched (fn2-core-sched fn2-core))) (code fn2-sched)
  (fn2-sched-make-runnable id 0 fn2-sched)
  (assert$? (member-eq code '(:ok :already)) fn2-core)))
(fn2-core-preserves fn2-commit-ready (id fn2-core) :rows nil :prefix "")
(defun fn2-commit-start (id members first-key mode partner fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (b* (((unless (and (fn2-commit-idp id fn2-core) (fn2-commit-idp partner fn2-core)))
       (mv :admission fn2-core))
      ((mv batch frontier capacity configured-mode) (fn2-commit-frontier fn2-core))
      ((unless (equal mode configured-mode)) (mv :profile fn2-core))
      (gen (fn2-machine-generation id fn2-core))
      (again (< 0 (fn2-machine-batch-no id fn2-core)))
      ((unless (and (equal (fn2-machine-kind id fn2-core) *fn2-commit-kind*)
              (< (fn2-commit-row id fn2-core) 2)
              (equal (fn2-machine-phase id fn2-core) *fn2-commit-state-free*)
              (posp members) (<= members 16) (unsigned-byte-p 60 first-key)
              (unsigned-byte-p 60 (+ first-key members)) (natp frontier) (natp capacity)
              (<= frontier first-key)
              (unsigned-byte-p 1 mode) (posp batch) (unsigned-byte-p 60 batch)
              (equal (fn2-machine-kind partner fn2-core) *fn2-commit-kind*)
              (not (equal id partner))
              (not (equal (fn2-machine-phase partner fn2-core) *fn2-commit-state-uncertain*))))
       (mv :admission fn2-core))
      ((unless (and (< batch capacity) (or (not again) (< gen (fn2-machine-gen-limit fn2-core)))))
       (mv :exhausted fn2-core))
      (owner-gen (if again (+ 1 gen) gen))
      ((mv code fn2-core) (fn2-commit-reserve-pools 4 id owner-gen fn2-core))
      ((unless (eq code :ok)) (mv code fn2-core))
      ((mv code fn2-core) (fn2-commit-reserve-extent id fn2-core))
      ((unless (eq code :ok))
       (let ((fn2-core (fn2-commit-release-pools 4 id owner-gen fn2-core))) (mv code fn2-core)))
      (fn2-core (fn2-commit-put-core id (phase *fn2-commit-state-collect*)
        (member-count members) (first-key first-key) (cb-mode mode)
        (batch-no batch) (partner partner) (principal-slot 0) (stopped 0) (generation owner-gen)
        (cb-stage *fn2-commit-seal-stage-zero-dependency*) (cb-cursor 0) (cb-issued 0) (cb-done 0) (cb-bytes 0)
        (cb-failed 0) (outcome 0) (cb-reason *fn2-commit-reason-none*) (cb-fence-live 0) (cb-fence-ok 0)
        (cb-deps-ok 0) (cb-log-ok 0) (cb-published 0) (cb-acks 0)
        (cb-seal-len 0) (deadline 0)))
      (fn2-core (fn2-commit-prepare-root id fn2-core))
      (fn2-core (fn2-commit-ready id fn2-core)))
  (mv :ok fn2-core)))
(fn2-core-preserves fn2-commit-start (id members first-key mode partner fn2-core) :position 1 :rows nil)
(defun fn2-commit-root-edge (id install fn2-core)
 (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
 (fn2-commit-checked id (mv :bounds fn2-core)
 (b* (((mv e epoch counter & &) (fn2-commit-resource id 0 fn2-core))
      (batch (fn2-machine-batch-no id fn2-core))
      ((unless (and (unsigned-byte-p 32 e) (unsigned-byte-p 60 epoch)
                    (unsigned-byte-p 60 counter))) (assert$? nil (mv :bounds fn2-core))))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
             (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (code fn2-extents fn2-alloc-edges)
  (mv-let (code fn2-extents fn2-alloc-edges)
   (fn2-alloc-edge-add (+ 6 (* 2 (nfix e)) (if install 1 0)) batch e epoch counter
     (if install :installed-root :prepared-successor) fn2-extents fn2-alloc-edges)
   (if (and (eq code :ok) install)
       (fn2-alloc-edge-drop (+ 6 (* 2 (nfix e))) batch e epoch counter
         :prepared-successor fn2-extents fn2-alloc-edges)
     (mv code fn2-extents fn2-alloc-edges)))
  (mv code fn2-core)))))
(fn2-core-preserves fn2-commit-root-edge (id install fn2-core) :position 1 :rows nil)
; Every continuation first reads its partner row: :invalid stops the core,
; :failed (an earlier partner batch is uncertain) stops this follower.
(defun fn2-commit-partner-state (batch partner fn2-core)
 (declare (xargs :stobjs fn2-core :guard (and (fn2-core-wfp fn2-core) (natp batch))))
 (cond ((not (fn2-commit-idp partner fn2-core)) :invalid)
       ((and (< (fn2-machine-batch-no partner fn2-core) batch)
             (= (fn2-machine-phase partner fn2-core) *fn2-commit-state-uncertain*)) :failed)
       (t :ok)))
(defthm fn2-commit-partner-state-idp

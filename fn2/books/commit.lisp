; Continuations are instantiated by assembly, after its core exists.
(in-package "ACL2")
(include-book "machines-a-access")
(include-book "commit-format")
(fn2-book-layer :b)
; DM1 supplies the layer; the registry supplies every child/type pair.
(defun fn2-commit-proof-children (children world)
 (declare (xargs :verify-guards nil))
 (if (atom children) nil
  (append (and (or (eq (fn2-decl-get :layer (fn2-decl-row (list :core-child (caar children)) world)) :b)
                   (member-eq (caar children) '(fn2-core-pool fn2-core-sched fn2-core-control)))
               (list (car children)))
          (fn2-commit-proof-children (cdr children) world))))
(defun fn2-commit-child-lemma-name (field suffix)
 (declare (xargs :verify-guards nil))
 (fn2-columns-sym 'fn2-commit (concatenate 'string "-" (subseq (symbol-name field) 9 nil) suffix)))
(defun fn2-commit-child-events (children)
 (declare (xargs :verify-guards nil))
 (if (atom children) nil
  (let* ((field (caar children)) (wfp (fn2-columns-sym (cadar children) "-WFP"))
         (update (fn2-columns-pre "UPDATE-" field)))
   (append
    `((defthm ,(fn2-commit-child-lemma-name field "-CHILD-TYPE")
       (implies (fn2-corep c) (,(fn2-columns-sym (cadar children) "P") (,field c)))
       :rule-classes :forward-chaining)
      (defthm ,(fn2-commit-child-lemma-name field "-CHILD-WFP")
       (implies (fn2-core-wfp c) (,wfp (,field c)))
       :rule-classes (:rewrite :forward-chaining)
       :hints (("Goal" :in-theory (enable fn2-core-wfp))))
      (defthm ,(fn2-commit-child-lemma-name field "-UPDATE-WFP")
       (implies (and (fn2-core-wfp c) (,wfp p))
                (fn2-core-wfp (,update p c)))
       :hints (("Goal" :in-theory (enable fn2-core-wfp)))))
    (fn2-commit-child-events (cdr children))))))
(defun fn2-commit-child-forward-runes (children)
 (declare (xargs :verify-guards nil))
 (if (atom children) nil
  (list* (list :forward-chaining (fn2-commit-child-lemma-name (caar children) "-CHILD-TYPE"))
         (list :forward-chaining (fn2-commit-child-lemma-name (caar children) "-CHILD-WFP"))
         (fn2-commit-child-forward-runes (cdr children)))))

; R5e2 (A9): a machine field read needs its read code :ok in the guard. A commit
; row id is valid exactly when the kind's generated snapshot check accepts it,
; and then every commit field read is in bounds: one lemma per declared column.
(defun fn2-commit-idp-lemmas (fields)
 (declare (xargs :verify-guards nil))
 (if (atom fields) nil
  (let ((code (fn2-columns-sym (fn2-columns-col-name 'fn2-machine (car fields)) "-READ-CODE")))
   (cons `(defthm ,(fn2-columns-sym 'fn2-commit-idp (concatenate 'string "-" (symbol-name (car fields))))
           (implies (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core) (fn2-commit-idp id fn2-core))
                    (equal (,code id fn2-core) :ok))
           :hints (("Goal" :in-theory (enable fn2-commit-idp fn2-commit-snapshot-read-code
                                              fn2-machine-phase-read-code ,code))))
         (fn2-commit-idp-lemmas (cdr fields))))))
; An internal helper given an invalid row stops the core (assert, never absorb).
(defmacro fn2-commit-checked (id refusal body)
 `(if (fn2-commit-idp ,id fn2-core) ,body
   (let ((fn2-core (fn2-core-stop *fn2-stop-reason-machine-phase* fn2-core))) ,refusal)))

(defun fn2-commit-event-forms ()
 '(progn
(local (in-theory (disable fn2-extentsp fn2-extents-wfp fn2-extents-rows
 fn2-alloc-edgesp fn2-alloc-edges-wfp fn2-alloc-edges-rows
 fn2-fcp fn2-fc-wfp fn2-fc-rows fn2-fc-contextp fn2-fc-context-wfp fn2-fc-context-rows
 fn2-b3p fn2-b3-wfp fn2-b3-rows fn2-fieldsp fn2-fields-wfp fn2-fields-rows

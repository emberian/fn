; Layer C: DEFRUNSCHEMA compiles one ordered-run schema. Its entry, index-entry
; and run-descriptor layouts go through B's DEFLAYOUT; its key order, append and
; page seek are generated per layout; the schema registers through fn2-declare.
(in-package "ACL2")
(include-book "runs-page")
(fn2-book-layer :c)

(defun fn2-rs-sym (name suffix) (declare (xargs :verify-guards nil)) (fn2-columns-sym name suffix))
(defun fn2-rs-octetsp (kind)
 (declare (xargs :verify-guards nil))
 (or (eq kind :digest)
     (and (consp kind) (eq (car kind) :octets) (natp (cadr kind)) (<= (cadr kind) *fn2-run-compare-max*))))
(defun fn2-rs-key-kindp (kind)
 (declare (xargs :verify-guards nil))
 (or (fn2-rs-octetsp kind)
     (member-eq kind '(:u8 :u16 :u32 :u60 :u64 :varint :bool))
     (and (consp kind) (member-eq (car kind) '(:id :enum)))))
(defun fn2-rs-keyp (key)
 (declare (xargs :verify-guards nil))
 (if (atom key) (null key)
  (and (consp (car key)) (fn2-rs-key-kindp (cadar key)) (fn2-rs-keyp (cdr key)))))
(defun fn2-rs-index-layout (key)
 (declare (xargs :verify-guards nil))
 (append key (fn2-format-prefix "CHILD-" *fn2-format-ref*) '((child-entries :varint))))
(defun fn2-rs-run-layout (key)
 (declare (xargs :verify-guards nil))
 (append '((run :varint) (height :u8) (pages :varint) (entries :varint))
         (fn2-format-prefix "MIN-" key) (fn2-format-prefix "MAX-" key)
         (fn2-format-prefix "ROOT-" *fn2-format-ref*) (fn2-format-prefix "FILTER-" *fn2-format-ref*)))

; Key order over two field ranges whose key fields start at ABASE and BBASE,
; read under owners A and B. The entry layout's field indexes are used for
; every layout of the schema, which all start with the key fields.
(defun fn2-rs-compare-body (layout key)
 (declare (xargs :verify-guards nil))
 (if (atom key) '(mv :ok :eq)
  (let ((c (fn2-codec-field layout (caar key))) (rest (fn2-rs-compare-body layout (cdr key))))
   (if (fn2-rs-octetsp (cadar key))
       `(mv-let (code order)
          (fn2-run-octets-field-compare (+ abase ,c) (+ bbase ,c) ak as ag bk bs bg fn2-fields fn2-pool)
          (if (or (not (eq code :ok)) (not (eq order :eq))) (mv code order) ,rest))
     `(let ((order (fn2-run-value-compare (+ abase ,c) (+ bbase ,c) fn2-fields)))
        (if (eq order :eq) ,rest (mv :ok order)))))))

; Append one entry (level 0) or index entry (level >= 1) to an open writer,
; in strict key order. Every precondition is fn2-run-add-check's.
(defun fn2-rs-add-events (name layout schema levelp)
 (declare (xargs :verify-guards nil))
 (let ((add (fn2-rs-sym layout "-ADD")) (cmp (fn2-rs-sym name "-COMPARE"))
       (n (fn2-codec-constant layout "-NUM-FIELDS"))
       (size (fn2-rs-sym layout "-SIZE")) (enc (fn2-rs-sym layout "-ENCODE")) (dec (fn2-rs-sym layout "-DECODE")))
 `((defun ,add (w ebase fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
     :guard (and (fn2-run-writers-wfp fn2-run-writers) (fn2-run-restarts-wfp fn2-run-restarts)
                 (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))
     :guard-hints (("Goal" :in-theory (disable ,enc ,dec ,size ,cmp fn2-run-note-restart fn2-run-add-commit
                                               fn2-run-writers-rows fn2-run-restarts-rows fn2-fields-rows)))))
    (b* ((code (fn2-run-add-check w ,schema ,levelp ,n ebase fn2-run-writers fn2-run-restarts fn2-fields))
         ((unless (eq code :ok)) (mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         (slot (fn2-run-writers-slot w fn2-run-writers)) (gen (fn2-run-writers-gen w fn2-run-writers))
         (okind (fn2-run-writers-okind w fn2-run-writers)) (oslot (fn2-run-writers-oslot w fn2-run-writers))
         (ogen (fn2-run-writers-ogen w fn2-run-writers))
         (cursor (fn2-run-writers-cursor w fn2-run-writers))
         (prev (+ (nfix (fn2-run-writers-fields w fn2-run-writers)) *fn2-run-prev-fields*))
         ((unless (<= (+ prev *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields)))
          (mv :bounds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         ((mv code order) (if (equal (fn2-run-writers-prev w fn2-run-writers) 1)
                              (,cmp ebase prev okind oslot ogen okind oslot ogen fn2-fields fn2-pool)
                            (mv :ok :gt)))
         ((unless (eq code :ok)) (mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         ((unless (eq order :gt)) (mv :order fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         ((unless (fn2-run-roomp w (,size ebase fn2-fields) fn2-run-writers))
          (mv :full fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         ((mv code fn2-run-writers fn2-run-restarts) (fn2-run-note-restart w fn2-run-writers fn2-run-restarts))
         ((mv code end fn2-pool)
          (if (eq code :ok) (,enc ebase slot gen cursor okind oslot ogen fn2-fields fn2-pool) (mv code cursor fn2-pool)))
         ((mv code & fn2-fields)
          (if (eq code :ok) (,dec prev slot gen cursor end okind oslot ogen fn2-fields fn2-pool) (mv code end fn2-fields)))
         ((mv code fn2-run-writers) (fn2-run-add-commit w code end fn2-run-writers)))
     (mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))))))

; Lower bound inside one read page: the first entry whose key is >= the query
; at QBASE. Binary search over restarts (LO, HI), then a linear decode inside
; one restart interval (IDX, OFF; OFF = 0 means not started). At most STEPS
; entry decodes per call; :more returns the continuation to resume with.
; Results: (:found idx off), (:absent idx off) with idx = entries past the end.
(defun fn2-rs-seek-events (name layout)
 (declare (xargs :verify-guards nil))
 (let ((seek (fn2-rs-sym layout "-SEEK")) (cmp (fn2-rs-sym name "-COMPARE"))
       (n (fn2-codec-constant layout "-NUM-FIELDS")) (dec (fn2-rs-sym layout "-DECODE")))
 `((defun ,seek (steps lo hi idx off qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-fields fn2-pool) :measure (nfix steps)
     :guard (and (fn2-run-readerp rb fn2-fields) (fn2-pool-wfp fn2-pool)
                 (natp steps) (natp lo) (natp hi) (natp idx) (natp off)
                 (natp qbase) (<= (+ qbase ,n) (fn2-fields-rows fn2-fields)))
     :guard-hints (("Goal" :in-theory (disable ,dec ,cmp fn2-run-restart-offset fn2-fields-rows)))))
    (b* (((when (zp steps)) (mv :more lo hi idx off fn2-fields))
         (entries (fn2-run-hdr rb entries))
         (dir (fn2-run-directory rb fn2-fields))
         (eb (+ rb *fn2-run-reader-entry*))
         ((when (zp entries)) (mv :absent lo hi 0 off fn2-fields))
         ((when (< lo hi))
          (b* ((mid (floor (+ lo hi) 2))
               ((mv code at fn2-fields) (fn2-run-restart-offset mid slot gen rb pk ps pg fn2-fields fn2-pool))
               ((unless (eq code :ok)) (mv code lo hi idx off fn2-fields))
               ((mv code & fn2-fields) (,dec eb slot gen at dir pk ps pg fn2-fields fn2-pool))
               ((unless (eq code :ok)) (mv code lo hi idx off fn2-fields))
               ((mv code order) (,cmp eb qbase pk ps pg qk qs qg fn2-fields fn2-pool))
               ((unless (eq code :ok)) (mv code lo hi idx off fn2-fields)))
           (if (eq order :lt)
               (,seek (- steps 1) (+ 1 mid) hi idx off qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool)
             (,seek (- steps 1) lo mid idx off qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool))))
         ((when (equal off 0))
          (b* ((j (if (zp lo) 0 (- lo 1)))
               ((mv code at fn2-fields) (fn2-run-restart-offset j slot gen rb pk ps pg fn2-fields fn2-pool))
               ((unless (eq code :ok)) (mv code lo hi idx off fn2-fields)))
           (,seek (- steps 1) lo hi (* j *fn2-run-restart-interval*) at qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool)))
         ((when (<= entries idx)) (mv :absent lo hi idx off fn2-fields))
         ((unless (< off dir)) (mv :format lo hi idx off fn2-fields))
         ((mv code next fn2-fields) (,dec eb slot gen off dir pk ps pg fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv code lo hi idx off fn2-fields))
         ((mv code order) (,cmp eb qbase pk ps pg qk qs qg fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv code lo hi idx off fn2-fields)))
     (case order
      (:eq (mv :found lo hi idx off fn2-fields))
      (:gt (mv :absent lo hi idx off fn2-fields))
      (otherwise (if (and (natp next) (< off next))
                     (,seek (- steps 1) lo hi (+ 1 idx) next qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool)
                   (mv :format lo hi idx off fn2-fields)))))))))

(defun fn2-rs-compare-event (name layout key)
 (declare (xargs :verify-guards nil))
 (let ((n (len key)))
 `(defun ,(fn2-rs-sym name "-COMPARE") (abase bbase ak as ag bk bs bg fn2-fields fn2-pool)
   (declare (ignorable ak as ag bk bs bg fn2-pool))
   (declare (xargs :stobjs (fn2-fields fn2-pool)
    :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (natp abase) (natp bbase)
                (<= (+ abase ,n) (fn2-fields-rows fn2-fields)) (<= (+ bbase ,n) (fn2-fields-rows fn2-fields)))))
   ,(fn2-rs-compare-body layout key))))

; Logic adapters (lists in, lists out; never served) and the keystones that
; compare the real writer, sealer, checker and seek against the specification.
(defun fn2-rs-adapter-events (name entry key layout)
 (declare (xargs :verify-guards nil))
 (let* ((add-all (fn2-rs-sym name "-ADD-ALL")) (run (fn2-rs-sym name "-PAGE-RUN"))
        (image (fn2-rs-sym name "-PAGE-IMAGE")) (seek-image (fn2-rs-sym name "-SEEK-IMAGE"))
        (add (fn2-rs-sym entry "-ADD")) (seek (fn2-rs-sym entry "-SEEK"))
        (st *fn2-run-adapter-stobjs*))
 `((defun ,add-all (entries src sgen off ,@st)
    (declare (xargs :stobjs ,st :verify-guards nil))
    (if (atom entries) (mv :ok ,@st)
     (b* (((mv code off fn2-fields fn2-pool)
           (fn2-run-load-values ',layout (car entries) *fn2-run-adapter-entry* src sgen off 9 0 1 fn2-fields fn2-pool))
          ((unless (eq code :ok)) (mv (list :load code) ,@st))
          ((mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
           (,add 0 *fn2-run-adapter-entry* fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)))
      (if (eq code :ok) (,add-all (cdr entries) src sgen off ,@st) (mv code ,@st)))))
   (defun ,run (meta entries q ,@st)
    (declare (xargs :stobjs ,st :verify-guards nil))
    (b* (((mv ,@st) (fn2-run-adapter-setup ,@st))
         ((mv & slot gen fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
         ((mv & qslot qgen fn2-pool) (fn2-pool-reserve 0 10 0 1 fn2-pool))
         ((mv & src sgen fn2-pool) (fn2-pool-reserve 1 9 0 1 fn2-pool))
         ((mv code fn2-run-writers fn2-pool)
          (fn2-run-open 0 slot gen (fn2-run-meta-schema meta) (fn2-run-meta-version meta) (fn2-run-meta-level meta)
                        (fn2-run-meta-run meta) (fn2-run-meta-ordinal meta) (fn2-run-meta-page-kind meta)
                        (fn2-run-meta-unit meta) (fn2-run-meta-epoch meta) (fn2-run-meta-counter meta)
                        (fn2-run-meta-history meta) (fn2-run-meta-incarnation meta) 9 0 1 0 fn2-run-writers fn2-pool))
         ((unless (eq code :ok)) (mv (list (list :open code)) ,@st))
         ((mv add ,@st) (,add-all entries src sgen 0 ,@st))
         ((mv & fn2-run-writers) (fn2-run-close 0 fn2-run-writers))
         ((mv close ,@st) (fn2-run-adapter-drive :close 64 ,@st))
         ((mv head fn2-run-writers fn2-fields fn2-pool) (fn2-run-head 0 fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         (fn2-fc-context (fn2-run-seal-context 0 0 *fn2-run-adapter-hash* fn2-run-writers fn2-fc-context))
         ((mv seal ,@st) (fn2-run-adapter-drive :seal 64 ,@st))
         (seal (if (and (eq close :ok) (eq head :ok)) seal (list :close close head seal)))
         ((mv check fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
          (fn2-format-drive (fn2-format-fuel *fn2-run-page-size*) 0 :page nil slot gen 0 *fn2-run-page-size*
                            0 9 0 1 4096 fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
         (bytes (fn2-run-read-bytes *fn2-run-page-size* slot gen 0 9 0 1 fn2-pool))
         ((mv & & fn2-fields fn2-pool)
          (fn2-run-load-values ',layout q *fn2-run-adapter-query* qslot qgen 0 10 0 1 fn2-fields fn2-pool))
         ((mv code fn2-fields) (fn2-run-read-header slot gen *fn2-run-adapter-reader* 9 0 1 fn2-fields fn2-pool))
         ((mv code & & idx & fn2-fields)
          (if (eq code :ok)
              (,seek 4096 0 (fn2-run-header-value *fn2-run-adapter-reader*
                              (+ *fn2-run-c-header-fields* *fn2-run-page-header-field-restarts*) fn2-fields)
                     0 0 *fn2-run-adapter-query* *fn2-run-adapter-reader* slot gen 9 0 1 10 0 1 fn2-fields fn2-pool)
            (mv code 0 0 0 0 fn2-fields))))
     (mv (list add seal check bytes (list code idx)) ,@st)))
   (defun ,image (meta entries)
    (declare (xargs :verify-guards nil))
    (let ((r (fn2-run-with-local ,st (,run meta entries nil ,@st))))
     (list (nth 0 r) (nth 1 r) (nth 2 r) (nth 3 r))))
   (defun ,seek-image (meta entries q)
    (declare (xargs :verify-guards nil))
    (nth 4 (fn2-run-with-local ,st (,run meta entries q ,@st))))
   (defthm-owed ,(fn2-rs-sym name "-PAGE-ROUNDTRIP") (meta entries)
    (implies (fn2-run-page-inputp ',layout ',key meta entries)
             (equal (,image meta entries) (list :ok :ok :ok (fn2-run-page-spec ',layout meta entries))))
    :teeth (,(fn2-rs-sym name "-PAGE-ROUNDTRIP-POSITIVE") ,(fn2-rs-sym name "-PAGE-ROUNDTRIP-NEGATIVE"))
    :doc "The real writer, sealer and B's checker produce and accept exactly the specified page octets.")
   (defthm-owed ,(fn2-rs-sym name "-SEEK-LOWER-BOUND") (meta entries q)
    (implies (and (fn2-run-page-inputp ',layout ',key meta entries) (fn2-run-values-layoutp ',layout q))
             (equal (,seek-image meta entries q) (fn2-run-lower-bound-spec ',key entries q 0)))
    :teeth (,(fn2-rs-sym name "-SEEK-LOWER-BOUND-POSITIVE") ,(fn2-rs-sym name "-SEEK-LOWER-BOUND-NEGATIVE"))
    :doc "The real page seek returns the first entry whose key is at least the query, and whether it is equal."))))

(defun fn2-defrunschema (name id key value merge page-kind)
 (declare (xargs :verify-guards nil))
 (let* ((entry (fn2-rs-sym name "-ENTRY")) (index (fn2-rs-sym name "-INDEX")) (run (fn2-rs-sym name "-RUN"))
        (layout (append key value)))
  (cond ((not (and (symbolp name) (natp id) (consp key) (fn2-rs-keyp key) (fn2-layoutp layout)
                   (<= (len layout) *fn2-run-key-fields-max*)
                   (member-eq merge '(:union :latest :unique))
                   (member-eq page-kind '(:run-data :manifest))))
         `(make-event (er soft 'defrunschema "Malformed run schema ~x0." ',name)))
        (t
         `(progn
           (deflayout ,entry ',layout)
           (deflayout ,index ',(fn2-rs-index-layout key))
           (deflayout ,run ',(fn2-rs-run-layout key))
           ,(fn2-declare (list :schema name)
              (list :id id :key key :value value :merge merge :page-kind page-kind
                    :layouts (list entry index run))
              nil
              (append (list (fn2-rs-compare-event name entry key))
                      (fn2-rs-add-events name entry id nil)
                      (fn2-rs-add-events name index id t)
                      (fn2-rs-seek-events name entry)
                      (fn2-rs-seek-events name index)))
           ,@(fn2-rs-adapter-events name entry key layout))))))
(defmacro defrunschema (name &key id key value merge (page-kind ':run-data))
 (fn2-defrunschema name id key value merge page-kind))

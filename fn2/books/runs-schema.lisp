; Layer C: DEFRUNSCHEMA compiles one ordered-run schema: its entry, index-entry
; and run-descriptor layouts through B's DEFLAYOUT and its key order. The
; schema registers through fn2-declare. Nothing else is per schema: the run
; assembly (runs-assemble.lisp) dispatches over every registered schema's
; codecs, and the append, seek, build and lookup are written once over it.
(in-package "ACL2")
(include-book "runs-page")
(fn2-book-layer :c)

(defun fn2-rs-sym (name suffix) (declare (xargs :verify-guards nil)) (fn2-columns-sym name suffix))
(defun fn2-rs-octetsp (kind)
 (declare (xargs :verify-guards nil))
 (or (eq kind :digest)
     (and (consp kind) (eq (car kind) :octets) (natp (cadr kind)) (<= (cadr kind) *fn2-run-key-octets-max*))))
(defun fn2-rs-key-kindp (kind)
 (declare (xargs :verify-guards nil))
 (or (fn2-rs-octetsp kind)
     (member-eq kind '(:u8 :u16 :u32 :u60 :u64 :varint :bool))
     (and (consp kind) (member-eq (car kind) '(:id :enum)))))
(defun fn2-rs-keyp (key)
 (declare (xargs :verify-guards nil))
 (if (atom key) (null key)
  (and (consp (car key)) (fn2-rs-key-kindp (cadar key)) (fn2-rs-keyp (cdr key)))))
(defun fn2-rs-index-layout (key)
 (declare (xargs :verify-guards nil))
 (append key (fn2-format-prefix "CHILD-" *fn2-format-ref*) '((child-entries :varint))))
(defun fn2-rs-run-layout (key)
 (declare (xargs :verify-guards nil))
 (append '((run :varint) (height :u8) (pages :varint) (entries :varint))
         (fn2-format-prefix "MIN-" key) (fn2-format-prefix "MAX-" key)
         (fn2-format-prefix "ROOT-" *fn2-format-ref*) (fn2-format-prefix "FILTER-" *fn2-format-ref*)))

; Key order over two field ranges whose key fields start at ABASE and BBASE,
; read under owners A and B. The entry layout's field indexes are used for
; every layout of the schema, which all start with the key fields.
(defun fn2-rs-compare-body (layout key)
 (declare (xargs :verify-guards nil))
 (if (atom key) '(mv :ok :eq)
  (let ((c (fn2-codec-field layout (caar key))) (rest (fn2-rs-compare-body layout (cdr key))))
   (if (fn2-rs-octetsp (cadar key))
       `(mv-let (code order)
          (fn2-run-octets-field-compare (+ abase ,c) (+ bbase ,c) ak as ag bk bs bg fn2-fields fn2-pool)
          (if (or (not (eq code :ok)) (not (eq order :eq))) (mv code order) ,rest))
     `(let ((order (fn2-run-value-compare (+ abase ,c) (+ bbase ,c) fn2-fields)))
        (if (eq order :eq) ,rest (mv :ok order)))))))

(defun fn2-rs-compare-event (name layout key)
 (declare (xargs :verify-guards nil))
 (let ((n (len key)))
 `(defun ,(fn2-rs-sym name "-COMPARE") (abase bbase ak as ag bk bs bg fn2-fields fn2-pool)
   (declare (ignorable ak as ag bk bs bg fn2-pool))
   (declare (xargs :stobjs (fn2-fields fn2-pool)
    :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (natp abase) (natp bbase)
                (<= (+ abase ,n) (fn2-fields-rows fn2-fields)) (<= (+ bbase ,n) (fn2-fields-rows fn2-fields)))))
   ,(fn2-rs-compare-body layout key))))

;; The CHILD- fields of an index layout sit right after the key fields, in the
;; ref layout's order, and child-entries follows them; the generic promotion
;; and lookup address them from the key count. Asserted per schema.
(defun fn2-rs-child (index field)
 (declare (xargs :verify-guards nil))
 (fn2-codec-field index (intern-in-package-of-symbol (concatenate 'string "CHILD-" field) 'fn2-rs-child)))
(defun fn2-rs-child-equalities (index nkeys fields)
 (declare (xargs :verify-guards nil))
 (if (atom fields) nil
  (cons `(equal ,(fn2-rs-child index (symbol-name (car fields)))
                (+ ,nkeys ,(fn2-codec-field 'fn2-format-ref (car fields))))
        (fn2-rs-child-equalities index nkeys (cdr fields)))))
(defun fn2-rs-shape-assertion (name nkeys)
 (declare (xargs :verify-guards nil))
 (let ((entry (fn2-rs-sym name "-ENTRY")) (index (fn2-rs-sym name "-INDEX")))
 `(assert-event
   (and ,@(fn2-rs-child-equalities index nkeys
            '(storage-domain physical-unit writer-epoch allocation page-kind encoded-length expected-hash))
        (equal ,(fn2-codec-field index 'child-entries) (+ ,nkeys *fn2-format-ref-num-fields*))
        (<= ,(fn2-codec-constant entry "-NUM-FIELDS") *fn2-run-entry-rows*)
        (<= ,(fn2-codec-constant index "-NUM-FIELDS") *fn2-run-entry-rows*)))))

; ---------------------------------------------------------------------------
; Folds (C4; STORAGE-DESIGN §4 decision 1, scholar ch. 1). A fold is a run
; schema with :merge :latest whose declaration row also carries the fold's
; properties (no new declaration kind):
;   :fold (:events ((KIND (ARG ...) [:assign ((ARG EXPR) ...)] [:when TEST]
;                    :set ((FIELD EXPR) ...)) ...)
;          :init :empty  :coverage :history-start  :observe (FIELD ...))
; An event is the list (KIND ARG-VALUE ...); its key is the args named by the
; key fields. A row's value is its value fields (an absent row reads as
; zeros). An :assign arg (never a key arg) is computed by the engine from the
; key's newest row when the event is staged (group counts' accept number is
; high + 1), so a writer never supplies it and the logged event carries the
; value assigned: the list fold reads it as any other arg. Its EXPR ranges
; over the value fields and the args not assigned. EXPR is a natural constant, a value field or arg name, or
; (+ a b) (- a b) (min a b) (max a b) (if TEST a b); TEST is (= a b) (< a b)
; (<= a b) (and s t) (or s t) (not s). Each set field is computed from the
; old row; an event whose TEST fails is :refused and one whose result leaves
; its field's width is :range, and neither changes the row. From the one
; declaration the schema generates the step twice: NAME-FOLD-STEP over list
; values (the interpretation, logic only) and NAME-FOLD-APPLY over decoded
; field rows (served), and the list fold NAME-FOLD-SPEC with its observation.
; :init :empty folds from no rows at history start; :coverage :history-start
; is the range the fold answers for. A bootstrap (:init (:from FN)) or a later
; coverage start ((:from POSITION), the earlier range declared unavailable)
; is refused until a fold needs one.
(defun fn2-rf-value-kindp (kind)
 (declare (xargs :verify-guards nil))
 (or (member-eq kind '(:u8 :u16 :u32 :u60 :bool :varint))
     (and (consp kind) (eq (car kind) :id))))
(defun fn2-rf-bits (kind)
 (declare (xargs :verify-guards nil))
 (case kind (:u8 8) (:u16 16) (:u32 32) (:bool 1) (otherwise 60)))
(defun fn2-rf-valuesp (value)
 (declare (xargs :verify-guards nil))
 (if (atom value) (null value)
  (and (consp (car value)) (fn2-rf-value-kindp (cadar value)) (fn2-rf-valuesp (cdr value)))))
(defun fn2-rf-var (name) (declare (xargs :verify-guards nil)) (fn2-columns-sym 'fold- (symbol-name name)))
(defun fn2-rf-new (name) (declare (xargs :verify-guards nil)) (fn2-columns-sym 'fold-new- (symbol-name name)))
(defun fn2-rf-vars (names) (declare (xargs :verify-guards nil)) (if (atom names) nil (cons (fn2-rf-var (car names)) (fn2-rf-vars (cdr names)))))
(mutual-recursion
 (defun fn2-rf-exprp (x names)
  (declare (xargs :verify-guards nil))
  (cond ((natp x) t)
        ((symbolp x) (and (member-eq x names) t))
        ((atom x) nil)
        ((and (member-eq (car x) '(+ - min max)) (true-listp x) (equal (len x) 3))
         (and (fn2-rf-exprp (cadr x) names) (fn2-rf-exprp (caddr x) names)))
        ((and (eq (car x) 'if) (true-listp x) (equal (len x) 4))
         (and (fn2-rf-testp (cadr x) names) (fn2-rf-exprp (caddr x) names) (fn2-rf-exprp (cadddr x) names)))
        (t nil)))
 (defun fn2-rf-testp (x names)
  (declare (xargs :verify-guards nil))
  (cond ((atom x) nil)
        ((and (member-eq (car x) '(= < <=)) (true-listp x) (equal (len x) 3))
         (and (fn2-rf-exprp (cadr x) names) (fn2-rf-exprp (caddr x) names)))
        ((and (member-eq (car x) '(and or)) (true-listp x) (equal (len x) 3))
         (and (fn2-rf-testp (cadr x) names) (fn2-rf-testp (caddr x) names)))
        ((and (eq (car x) 'not) (true-listp x) (equal (len x) 2)) (fn2-rf-testp (cadr x) names))
        (t nil))))
(mutual-recursion
 (defun fn2-rf-expr (x)
  (declare (xargs :verify-guards nil))
  (cond ((atom x) (if (symbolp x) (fn2-rf-var x) x))
        ((eq (car x) '+) `(+ ,(fn2-rf-expr (cadr x)) ,(fn2-rf-expr (caddr x))))
        ((eq (car x) '-) `(- ,(fn2-rf-expr (cadr x)) ,(fn2-rf-expr (caddr x))))
        ((eq (car x) 'min) `(min ,(fn2-rf-expr (cadr x)) ,(fn2-rf-expr (caddr x))))
        ((eq (car x) 'max) `(max ,(fn2-rf-expr (cadr x)) ,(fn2-rf-expr (caddr x))))
        (t `(if ,(fn2-rf-test (cadr x)) ,(fn2-rf-expr (caddr x)) ,(fn2-rf-expr (cadddr x))))))
 (defun fn2-rf-test (x)
  (declare (xargs :verify-guards nil))
  (if (atom x) nil
  (case (car x)
   (= `(equal ,(fn2-rf-expr (cadr x)) ,(fn2-rf-expr (caddr x))))
   (< `(< ,(fn2-rf-expr (cadr x)) ,(fn2-rf-expr (caddr x))))
   (<= `(<= ,(fn2-rf-expr (cadr x)) ,(fn2-rf-expr (caddr x))))
   (and `(and ,(fn2-rf-test (cadr x)) ,(fn2-rf-test (caddr x))))
   (or `(or ,(fn2-rf-test (cadr x)) ,(fn2-rf-test (caddr x))))
   (otherwise `(not ,(fn2-rf-test (cadr x))))))))

;; Declaration accessors. An event declaration is (KIND ARGS . OPTIONS).
(defun fn2-rf-opt (key ev) (declare (xargs :verify-guards nil)) (cadr (member-eq key (cddr ev))))
(defun fn2-rf-sets-okp (sets vnames names)
 (declare (xargs :verify-guards nil))
 (if (atom sets) (null sets)
  (and (true-listp (car sets)) (equal (len (car sets)) 2) (member-eq (caar sets) vnames)
       (fn2-rf-exprp (cadar sets) names) (fn2-rf-sets-okp (cdr sets) vnames names))))
(defun fn2-rf-assigns-okp (assigns args knames names)
 (declare (xargs :verify-guards nil))
 (if (atom assigns) (null assigns)
  (and (true-listp (car assigns)) (equal (len (car assigns)) 2) (member-eq (caar assigns) args)
       (not (member-eq (caar assigns) knames)) (fn2-rf-exprp (cadar assigns) names)
       (fn2-rf-assigns-okp (cdr assigns) args knames names))))
(defun fn2-rf-event-okp (ev knames vnames)
 (declare (xargs :verify-guards nil))
 (and (true-listp ev) (keywordp (car ev)) (symbol-listp (cadr ev)) (no-duplicatesp-eq (cadr ev))
      (subsetp-eq knames (cadr ev)) (not (intersectp-eq (cadr ev) vnames))
      (let* ((names (append vnames (cadr ev))) (when (fn2-rf-opt :when ev)) (sets (fn2-rf-opt :set ev))
             (assigns (fn2-rf-opt :assign ev))
             (anames (append vnames (set-difference-eq (cadr ev) (strip-cars assigns)))))
       (and (or (null when) (fn2-rf-testp when names))
            (consp sets) (fn2-rf-sets-okp sets vnames names)
            (no-duplicatesp-eq (strip-cars sets))
            (true-listp assigns) (fn2-rf-assigns-okp assigns (cadr ev) knames anames)
            (no-duplicatesp-eq (strip-cars assigns))))))
(defun fn2-rf-events-okp (evs knames vnames)
 (declare (xargs :verify-guards nil))
 (if (atom evs) (null evs)
  (and (fn2-rf-event-okp (car evs) knames vnames) (fn2-rf-events-okp (cdr evs) knames vnames))))
(defun fn2-rf-okp (fold key value merge)
 (declare (xargs :verify-guards nil))
 (let ((evs (cadr (member-eq :events fold))) (knames (strip-cars key)) (vnames (strip-cars value)))
  (and (eq merge :latest) (keyword-value-listp fold) (consp value) (fn2-rf-valuesp value) (fn2-rf-valuesp key)
       (consp evs) (fn2-rf-events-okp evs knames vnames) (no-duplicatesp-eq (strip-cars evs))
       (eq (cadr (member-eq :init fold)) :empty)
       (eq (cadr (member-eq :coverage fold)) :history-start)
       (let ((obs (cadr (member-eq :observe fold)))) (and (consp obs) (symbol-listp obs) (subsetp-eq obs vnames))))))

;; Generators. Field I of a value is (nth I value) in the logic and the row
;; at VBASE + (number of key fields) + I in the served step.
(defun fn2-rf-index (name names) (declare (xargs :verify-guards nil)) (- (len names) (len (member-eq name names))))
(defun fn2-rf-list-binds (names i src)
 (declare (xargs :verify-guards nil))
 (if (atom names) nil (cons `(,(fn2-rf-var (car names)) (nfix (nth ,i ,src))) (fn2-rf-list-binds (cdr names) (+ 1 i) src))))
(defun fn2-rf-row-binds (names i base)
 (declare (xargs :verify-guards nil))
 (if (atom names) nil
  (cons `(,(fn2-rf-var (car names)) (fn2-fields-value (+ ,base ,i) fn2-fields)) (fn2-rf-row-binds (cdr names) (+ 1 i) base))))
(defun fn2-rf-set-expr (name sets)
 (declare (xargs :verify-guards nil))
 (let ((s (assoc-eq name sets))) (if s (fn2-rf-expr (cadr s)) (fn2-rf-var name))))
(defun fn2-rf-new-binds (value sets)
 (declare (xargs :verify-guards nil))
 (if (atom value) nil (cons `(,(fn2-rf-new (caar value)) ,(fn2-rf-set-expr (caar value) sets)) (fn2-rf-new-binds (cdr value) sets))))
(defun fn2-rf-fits (value)
 (declare (xargs :verify-guards nil))
 (if (atom value) nil (cons `(unsigned-byte-p ,(fn2-rf-bits (cadar value)) ,(fn2-rf-new (caar value))) (fn2-rf-fits (cdr value)))))
(defun fn2-rf-news (value) (declare (xargs :verify-guards nil)) (if (atom value) nil (cons (fn2-rf-new (caar value)) (fn2-rf-news (cdr value)))))
(defun fn2-rf-row-writes (value i base)
 (declare (xargs :verify-guards nil))
 (if (atom value) nil
  (cons `(fn2-fields (fn2-fields-set-value (+ ,base ,i) ,(fn2-rf-new (caar value)) fn2-fields))
        (fn2-rf-row-writes (cdr value) (+ 1 i) base))))
(defun fn2-rf-widths (fields)
 (declare (xargs :verify-guards nil))
 (if (atom fields) nil (cons (fn2-rf-bits (cadar fields)) (fn2-rf-widths (cdr fields)))))
(defun fn2-rf-arg-widths (args key)
 (declare (xargs :verify-guards nil))
 (if (atom args) nil
  (cons (let ((k (assoc-eq (car args) key))) (if k (fn2-rf-bits (cadr k)) 60)) (fn2-rf-arg-widths (cdr args) key))))
(defun fn2-rf-fitsp (vals widths)
 (declare (xargs :guard t))
 (if (atom widths) (null vals)
  (and (consp vals) (unsigned-byte-p (nfix (car widths)) (car vals)) (fn2-rf-fitsp (cdr vals) (cdr widths)))))
;; Logic arms: eventp, key, step.
(defun fn2-rf-eventp-arms (evs key)
 (declare (xargs :verify-guards nil))
 (if (atom evs) nil
  (cons `(,(caar evs) (fn2-rf-fitsp (cdr e) ',(fn2-rf-arg-widths (cadar evs) key))) (fn2-rf-eventp-arms (cdr evs) key))))
(defun fn2-rf-key-list (key args)
 (declare (xargs :verify-guards nil))
 (if (atom key) nil (cons `(nth ,(fn2-rf-index (caar key) args) (cdr e)) (fn2-rf-key-list (cdr key) args))))
(defun fn2-rf-key-arms (evs key)
 (declare (xargs :verify-guards nil))
 (if (atom evs) nil (cons `(,(caar evs) (list ,@(fn2-rf-key-list key (cadar evs)))) (fn2-rf-key-arms (cdr evs) key))))
(defun fn2-rf-step-arms (evs value)
 (declare (xargs :verify-guards nil))
 (if (atom evs) nil
  (cons `(,(caar evs)
          (let ,(fn2-rf-list-binds (cadar evs) 0 '(cdr e))
           (declare (ignorable ,@(fn2-rf-vars (cadar evs))))
           (let ,(fn2-rf-new-binds value (fn2-rf-opt :set (car evs)))
            (cond ,@(let ((when (fn2-rf-opt :when (car evs)))) (and when `(((not ,(fn2-rf-test when)) (mv :refused vals)))))
                  ((not (and ,@(fn2-rf-fits value))) (mv :range vals))
                  (t (mv :ok (list ,@(fn2-rf-news value))))))))
        (fn2-rf-step-arms (cdr evs) value))))
;; Served arms over the decoded entry at VBASE (its value fields from VBASE +
;; the key count) and the event's args at ABASE.
(defun fn2-rf-apply-arms (evs value nk)
 (declare (xargs :verify-guards nil))
 (if (atom evs) nil
  (cons `(,(caar evs)
          (let ,(fn2-rf-row-binds (cadar evs) 0 'abase)
           (declare (ignorable ,@(fn2-rf-vars (cadar evs))))
           (let ,(fn2-rf-new-binds value (fn2-rf-opt :set (car evs)))
            (cond ,@(let ((when (fn2-rf-opt :when (car evs)))) (and when `(((not ,(fn2-rf-test when)) (mv :refused fn2-fields)))))
                  ((not (and ,@(fn2-rf-fits value))) (mv :range fn2-fields))
                  (t (let* ,(fn2-rf-row-writes value nk 'vbase) (mv :ok fn2-fields)))))))
        (fn2-rf-apply-arms (cdr evs) value nk))))
;; Assigned args: the served arm writes each into its arg row from the row's
;; old values (all computed before any is written); the list arm puts it in
;; the event. An assigned arg is an ordinary arg, so 60 bits wide.
(defun fn2-rf-assign-fits (assigns)
 (declare (xargs :verify-guards nil))
 (if (atom assigns) nil (cons `(unsigned-byte-p 60 ,(fn2-rf-new (caar assigns))) (fn2-rf-assign-fits (cdr assigns)))))
(defun fn2-rf-assign-binds (assigns)
 (declare (xargs :verify-guards nil))
 (if (atom assigns) nil (cons `(,(fn2-rf-new (caar assigns)) ,(fn2-rf-expr (cadar assigns))) (fn2-rf-assign-binds (cdr assigns)))))
(defun fn2-rf-assign-row-writes (assigns args)
 (declare (xargs :verify-guards nil))
 (if (atom assigns) nil
  (cons `(fn2-fields (fn2-fields-set-value (+ abase ,(fn2-rf-index (caar assigns) args)) ,(fn2-rf-new (caar assigns)) fn2-fields))
        (fn2-rf-assign-row-writes (cdr assigns) args))))
(defun fn2-rf-assign-list-puts (assigns args form)
 (declare (xargs :verify-guards nil))
 (if (atom assigns) form
  (fn2-rf-assign-list-puts (cdr assigns) args `(update-nth ,(fn2-rf-index (caar assigns) args) ,(fn2-rf-new (caar assigns)) ,form))))
(defun fn2-rf-assign-apply-arms (evs)
 (declare (xargs :verify-guards nil))
 (cond ((atom evs) nil)
       ((null (fn2-rf-opt :assign (car evs))) (fn2-rf-assign-apply-arms (cdr evs)))
       (t (let ((args (cadar evs)) (assigns (fn2-rf-opt :assign (car evs))))
           (cons `(,(caar evs)
                   (let ,(fn2-rf-row-binds args 0 'abase)
                    (declare (ignorable ,@(fn2-rf-vars args)))
                    (let ,(fn2-rf-assign-binds assigns)
                     (if (not (and ,@(fn2-rf-assign-fits assigns))) (mv :range fn2-fields)
                      (let* ,(fn2-rf-assign-row-writes assigns args) (mv :ok fn2-fields))))))
                 (fn2-rf-assign-apply-arms (cdr evs)))))))
(defun fn2-rf-assign-list-arms (evs)
 (declare (xargs :verify-guards nil))
 (cond ((atom evs) nil)
       ((null (fn2-rf-opt :assign (car evs))) (fn2-rf-assign-list-arms (cdr evs)))
       (t (let ((args (cadar evs)) (assigns (fn2-rf-opt :assign (car evs))))
           (cons `(,(caar evs)
                   (let ,(fn2-rf-list-binds args 0 '(cdr e))
                    (declare (ignorable ,@(fn2-rf-vars args)))
                    (let ,(fn2-rf-assign-binds assigns)
                     (if (not (and ,@(fn2-rf-assign-fits assigns))) (list :range e)
                      (list :ok (cons (car e) ,(fn2-rf-assign-list-puts assigns args '(cdr e))))))))
                 (fn2-rf-assign-list-arms (cdr evs)))))))
(defun fn2-rf-plain-kinds (evs)
 (declare (xargs :verify-guards nil))
 (cond ((atom evs) nil)
       ((fn2-rf-opt :assign (car evs)) (fn2-rf-plain-kinds (cdr evs)))
       (t (cons (caar evs) (fn2-rf-plain-kinds (cdr evs))))))
(defun fn2-rf-obs-list (obs vnames)
 (declare (xargs :verify-guards nil))
 (if (atom obs) nil (cons `(nth ,(fn2-rf-index (car obs) vnames) vals) (fn2-rf-obs-list (cdr obs) vnames))))
(defun fn2-rf-max-args (evs) (declare (xargs :verify-guards nil)) (if (atom evs) 0 (max (len (cadar evs)) (fn2-rf-max-args (cdr evs)))))
(defun fn2-rf-events (name key value fold)
 (declare (xargs :verify-guards nil))
 (let* ((evs (cadr (member-eq :events fold))) (vnames (strip-cars value)) (nv (len value)) (nk (len key)))
  `((defun ,(fn2-rs-sym name "-FOLD-EVENTP") (e)
     (declare (xargs :guard t))
     (and (consp e) (true-listp e) (case (car e) ,@(fn2-rf-eventp-arms evs key) (otherwise nil))))
    (defun ,(fn2-rs-sym name "-FOLD-APPLY") (kind vbase abase fn2-fields)
     (declare (xargs :stobjs fn2-fields :guard (and (fn2-fields-wfp fn2-fields) (natp vbase) (natp abase))))
     (if (not (and (natp vbase) (natp abase)
                   (<= (+ vbase ,(+ nk nv)) (fn2-fields-rows fn2-fields)) (<= (+ abase ,(fn2-rf-max-args evs)) (fn2-fields-rows fn2-fields))))
         (mv :bounds fn2-fields)
      (let ,(fn2-rf-row-binds vnames nk 'vbase)
       (declare (ignorable ,@(fn2-rf-vars vnames)))
       (case kind ,@(fn2-rf-apply-arms evs value nk) (otherwise (mv :event fn2-fields))))))
    ;; The assigned args of event KIND from the decoded row at VBASE into
    ;; the arg rows at ABASE: :ok (a kind without assigns writes nothing),
    ;; :range, :event (not an event of the fold), :bounds.
    (defun ,(fn2-rs-sym name "-FOLD-ASSIGN") (kind vbase abase fn2-fields)
     (declare (xargs :stobjs fn2-fields :guard (and (fn2-fields-wfp fn2-fields) (natp vbase) (natp abase))))
     (if (not (and (natp vbase) (natp abase)
                   (<= (+ vbase ,(+ nk nv)) (fn2-fields-rows fn2-fields)) (<= (+ abase ,(fn2-rf-max-args evs)) (fn2-fields-rows fn2-fields))))
         (mv :bounds fn2-fields)
      (let ,(fn2-rf-row-binds vnames nk 'vbase)
       (declare (ignorable ,@(fn2-rf-vars vnames)))
       (case kind ,@(fn2-rf-assign-apply-arms evs)
        ,@(let ((plain (fn2-rf-plain-kinds evs))) (and plain `((,plain (mv :ok fn2-fields)))))
        (otherwise (mv :event fn2-fields))))))
    )))
;; The interpretation in the logic (never executed on a served path) and the
;; served step's shape, emitted beside the declaration.
(defun fn2-rf-logic-events (name key value fold)
 (declare (xargs :verify-guards nil))
 (let* ((evs (cadr (member-eq :events fold))) (vnames (strip-cars value)) (nv (len value))
        (obs (cadr (member-eq :observe fold))))
  `((fn2-fields-preserves ,(fn2-rs-sym name "-FOLD-APPLY") (kind vbase abase fn2-fields) :position 1)
    (fn2-fields-preserves ,(fn2-rs-sym name "-FOLD-ASSIGN") (kind vbase abase fn2-fields) :position 1)
    ;; The list side of the assignment: event E with its assigned args
    ;; computed from the key's value VALS, as (code event).
    (defun ,(fn2-rs-sym name "-FOLD-ASSIGN-SPEC") (vals e)
     (declare (xargs :verify-guards nil) (ignorable vals))
     (let ,(fn2-rf-list-binds vnames 0 'vals)
      (declare (ignorable ,@(fn2-rf-vars vnames)))
      (case (car e) ,@(fn2-rf-assign-list-arms evs)
       ,@(let ((plain (fn2-rf-plain-kinds evs))) (and plain `((,plain (list :ok e)))))
       (otherwise (list :event e)))))
    (defun ,(fn2-rs-sym name "-FOLD-KEY") (e)
     (declare (xargs :verify-guards nil))
     (case (car e) ,@(fn2-rf-key-arms evs key) (otherwise nil)))
    (defun ,(fn2-rs-sym name "-FOLD-STEP") (vals e)
     (declare (xargs :verify-guards nil))
     (let ,(fn2-rf-list-binds vnames 0 'vals)
      (declare (ignorable ,@(fn2-rf-vars vnames)))
      (case (car e) ,@(fn2-rf-step-arms evs value) (otherwise (mv :event vals)))))
    (defun ,(fn2-rs-sym name "-FOLD-KEYP") (q)
     (declare (xargs :verify-guards nil))
     (fn2-rf-fitsp q ',(fn2-rf-widths key)))
    (defun ,(fn2-rs-sym name "-FOLD-KEYSP") (qs)
     (declare (xargs :verify-guards nil))
     (if (atom qs) (null qs) (and (,(fn2-rs-sym name "-FOLD-KEYP") (car qs)) (,(fn2-rs-sym name "-FOLD-KEYSP") (cdr qs)))))
    (defun ,(fn2-rs-sym name "-FOLD-ROWSP") (st)
     (declare (xargs :verify-guards nil))
     (if (atom st) (null st)
      (and (consp (car st)) (,(fn2-rs-sym name "-FOLD-KEYP") (caar st)) (fn2-rf-fitsp (cdar st) ',(fn2-rf-widths value))
           (,(fn2-rs-sym name "-FOLD-ROWSP") (cdr st)))))
    (defun ,(fn2-rs-sym name "-FOLD-STATEP") (st)
     (declare (xargs :verify-guards nil))
     (and (,(fn2-rs-sym name "-FOLD-ROWSP") st) (no-duplicatesp-equal (strip-cars st))))
    (defun ,(fn2-rs-sym name "-FOLD-EVENTSP") (es)
     (declare (xargs :verify-guards nil))
     (if (atom es) (null es) (and (,(fn2-rs-sym name "-FOLD-EVENTP") (car es)) (,(fn2-rs-sym name "-FOLD-EVENTSP") (cdr es)))))
    ;; The list fold: ST is an alist key -> value; an absent key reads as
    ;; zeros, so a row of zeros and no row observe alike.
    (defun ,(fn2-rs-sym name "-FOLD-VALUE") (st key)
     (declare (xargs :verify-guards nil))
     (let ((r (assoc-equal key st))) (if r (cdr r) (make-list ,nv :initial-element 0))))
    (defun ,(fn2-rs-sym name "-FOLD-APPLY-SPEC") (st e)
     (declare (xargs :verify-guards nil))
     (if (not (,(fn2-rs-sym name "-FOLD-EVENTP") e)) st
      (b* ((key (,(fn2-rs-sym name "-FOLD-KEY") e))
           ((mv code vals) (,(fn2-rs-sym name "-FOLD-STEP") (,(fn2-rs-sym name "-FOLD-VALUE") st key) e)))
       (if (eq code :ok) (put-assoc-equal key vals st) st))))
    (defun ,(fn2-rs-sym name "-FOLD-RUN") (st events)
     (declare (xargs :verify-guards nil))
     (if (atom events) st (,(fn2-rs-sym name "-FOLD-RUN") (,(fn2-rs-sym name "-FOLD-APPLY-SPEC") st (car events)) (cdr events))))
    (defun ,(fn2-rs-sym name "-FOLD-SPEC") (events)
     (declare (xargs :verify-guards nil))
     (,(fn2-rs-sym name "-FOLD-RUN") nil events))
    (defun ,(fn2-rs-sym name "-FOLD-OBSERVE") (st q)
     (declare (xargs :verify-guards nil))
     (let ((vals (,(fn2-rs-sym name "-FOLD-VALUE") st q)))
      (list ,@(fn2-rf-obs-list obs vnames))))
    (defun ,(fn2-rs-sym name "-FOLD-OBSERVE-ALL") (st qs)
     (declare (xargs :verify-guards nil))
     (if (atom qs) nil (cons (,(fn2-rs-sym name "-FOLD-OBSERVE") st (car qs)) (,(fn2-rs-sym name "-FOLD-OBSERVE-ALL") st (cdr qs))))))))

(defun fn2-defrunschema (name id key value merge page-kind fold)
 (declare (xargs :verify-guards nil))
 (let* ((entry (fn2-rs-sym name "-ENTRY")) (index (fn2-rs-sym name "-INDEX")) (run (fn2-rs-sym name "-RUN"))
        (cmp (fn2-rs-sym name "-COMPARE")) (layout (append key value)))
  (cond ((not (and (symbolp name) (natp id) (consp key) (fn2-rs-keyp key) (fn2-layoutp layout)
                   (<= (len layout) *fn2-run-key-fields-max*)
                   (member-eq merge '(:union :latest :unique))
                   (member-eq page-kind '(:run-data :manifest))
                   (or (null fold) (fn2-rf-okp fold key value merge))))
         `(make-event (er soft 'defrunschema "Malformed run schema ~x0." ',name)))
        (t
         `(progn
           (deflayout ,entry ',layout)
           (deflayout ,index ',(fn2-rs-index-layout key))
           (deflayout ,run ',(fn2-rs-run-layout key))
           ,(fn2-rs-shape-assertion name (len key))
           ,(fn2-declare (list :schema name)
              (list :id id :key key :value value :merge merge :page-kind page-kind
                    :layouts (list entry index run) :compare cmp :fold fold)
              nil
              (cons (fn2-rs-compare-event name entry key) (and fold (fn2-rf-events name key value fold))))
           ,@(and fold (fn2-rf-logic-events name key value fold)))))))

;; A schema declared after the run assembly would never be dispatched: refused.
(defun fn2-rs-assembled (world)
 (declare (xargs :verify-guards nil))
 (cdr (assoc-eq :schemas (table-alist 'fn2-run-assembly world))))
(defmacro defrunschema (name &key id key value merge (page-kind ':run-data) fold)
 `(progn
   (make-event
    (if (fn2-rs-assembled (w state))
        (er soft 'defrunschema "Schema ~x0 is declared after the run assembly." ',name)
      (value '(value-triple :unassembled))))
   ,(fn2-defrunschema name id key value merge page-kind fold)))

         (= (fn2-alloc-ready fn2-extents) (fn2-alloc-count-reason n *fn2-alloc-reason-code-ready* (fn2-alloc-cut fn2-extents) fn2-extents))
         (= (fn2-alloc-blocked fn2-extents) (fn2-alloc-count-reason n *fn2-alloc-reason-code-checkpoint-blocked* (fn2-alloc-cut fn2-extents) fn2-extents))
         (= (fn2-alloc-quarantined fn2-extents) (fn2-alloc-count-reason n *fn2-alloc-reason-code-quarantine* (fn2-alloc-cut fn2-extents) fn2-extents))
         (<= (fn2-alloc-coverage fn2-extents) (fn2-alloc-last-retirement fn2-extents)))))
; Logical/test invariant: cached extent counts equal owned row cardinalities.
; These scans are never called by a served allocator operation.
(defun fn2-alloc-owned-count (n i kind fn2-alloc-edges)
  (declare (xargs :stobjs fn2-alloc-edges :verify-guards nil :measure (nfix n)))
  (if (zp n) 0
    (+ (if (and (equal (fn2-alloc-edges-state (- n 1) fn2-alloc-edges) *fn2-alloc-edge-state-live*)
                (equal (fn2-alloc-edges-extent (- n 1) fn2-alloc-edges) i)
                (equal (fn2-alloc-edges-kind (- n 1) fn2-alloc-edges)
                       (fn2-alloc-edge-kind-keyword->code kind))) 1 0)
       (fn2-alloc-owned-count (- n 1) i kind fn2-alloc-edges))))
(defun fn2-alloc-owned-counts-ok (i kinds fn2-extents fn2-alloc-edges)
  (declare (xargs :stobjs (fn2-extents fn2-alloc-edges) :verify-guards nil))
  (if (atom kinds) t
    (and (or (eq (car kinds) :reservation)
             (equal (fn2-alloc-edge-count i (car kinds) fn2-extents)
                    (fn2-alloc-owned-count (fn2-alloc-edges-rows fn2-alloc-edges) i (car kinds) fn2-alloc-edges)))
         (fn2-alloc-owned-counts-ok i (cdr kinds) fn2-extents fn2-alloc-edges))))
(defun fn2-alloc-owned-extents-ok (n fn2-extents fn2-alloc-edges)
  (declare (xargs :stobjs (fn2-extents fn2-alloc-edges) :verify-guards nil :measure (nfix n)))
  (if (zp n) t
    (and (fn2-alloc-owned-counts-ok (- n 1) *fn2-alloc-edges* fn2-extents fn2-alloc-edges)
         (fn2-alloc-owned-extents-ok (- n 1) fn2-extents fn2-alloc-edges))))
(defun fn2-alloc-owned-rows-ok (n fn2-extents fn2-alloc-edges)
  (declare (xargs :stobjs (fn2-extents fn2-alloc-edges) :verify-guards nil :measure (nfix n)))
  (if (zp n) t
    (let* ((edge (- n 1)) (i (fn2-alloc-edges-extent edge fn2-alloc-edges))
           (kind (fn2-alloc-edge-kind-code->keyword (fn2-alloc-edges-kind edge fn2-alloc-edges))))
      (and (if (equal (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-free*) t
             (and (equal (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-live*)
                  (member-eq kind *fn2-alloc-edges*) (not (eq kind :reservation))
                  (equal (fn2-alloc-handle-code i (fn2-alloc-edges-epoch edge fn2-alloc-edges)
                              (fn2-alloc-edges-counter edge fn2-alloc-edges) fn2-extents) :ok)))
           (fn2-alloc-owned-rows-ok edge fn2-extents fn2-alloc-edges)))))
(defun fn2-alloc-ownership-invp (fn2-extents fn2-alloc-edges)
  (declare (xargs :stobjs (fn2-extents fn2-alloc-edges) :verify-guards nil))
  (and (fn2-alloc-invp fn2-extents) (fn2-alloc-edgesp fn2-alloc-edges)
       (fn2-alloc-edges-wfp fn2-alloc-edges)
       (fn2-alloc-owned-extents-ok (fn2-extents-rows fn2-extents) fn2-extents fn2-alloc-edges)
       (fn2-alloc-owned-rows-ok (fn2-alloc-edges-rows fn2-alloc-edges) fn2-extents fn2-alloc-edges)))
(defthm-owed fn2-alloc-release-safe (i epoch counter p)
  (implies (and (fn2-alloc-invp p)
                (equal (mv-nth 0 (fn2-alloc-release i epoch counter p)) :ok))
           (and (fn2-alloc-releasablep i p)
                (equal (fn2-extents-state i (mv-nth 1 (fn2-alloc-release i epoch counter p))) *fn2-extent-state-free*)))
  :teeth (fn2-alloc-keystone-teeth fn2-alloc-release-protection-teeth)
  :doc "Successful release checks every typed edge and checkpoint coverage at the actual export.")
(defun-nx fn2-alloc-id-step (op i epoch counter arg p edges)
  (case op
    (:reserve (mv-nth 5 (fn2-alloc-reserve p)))
    (:cancel (mv-nth 1 (fn2-alloc-cancel-reservation i epoch counter p)))
    (:release (mv-nth 1 (fn2-alloc-release i epoch counter p)))
    (:begin-epoch (mv-nth 1 (fn2-alloc-begin-epoch arg p)))
    (:commit (mv-nth 1 (fn2-alloc-commit-allocation i epoch counter 1 1 p)))
    (:retire (mv-nth 1 (fn2-alloc-retire i epoch counter arg p)))
    (:edge-add (mv-nth 1 (fn2-alloc-edge-add (fn2-alloc-edge-request-slot arg) (fn2-alloc-edge-request-holder arg)
                      i epoch counter (fn2-alloc-edge-request-kind arg) p edges)))
    (:edge-drop (mv-nth 1 (fn2-alloc-edge-drop (fn2-alloc-edge-request-slot arg) (fn2-alloc-edge-request-holder arg)
                      i epoch counter (fn2-alloc-edge-request-kind arg) p edges)))
    (:checkpoint-advance (mv-nth 1 (fn2-alloc-checkpoint-advance arg i p)))
    (otherwise p)))
(defun fn2-alloc-id-progressp (op code issued-epoch issued-counter old-epoch old-counter new-epoch new-counter ids)
  (declare (xargs :verify-guards nil))
  (and (<= old-epoch new-epoch)
       (implies (= old-epoch new-epoch) (<= old-counter new-counter))
       (implies (and (eq op :reserve) (eq code :ok))
         (and (not (member-equal (list issued-epoch issued-counter) ids))
              (= issued-epoch old-epoch) (= issued-counter old-counter)
              (= new-counter (+ 1 old-counter)) (= new-epoch old-epoch)))))
(defun-nx fn2-alloc-id-progress (op i epoch counter arg p edges)
  (let ((q (fn2-alloc-id-step op i epoch counter arg p edges)))
    (fn2-alloc-id-progressp op (mv-nth 0 (fn2-alloc-reserve p))
      (mv-nth 3 (fn2-alloc-reserve p)) (mv-nth 4 (fn2-alloc-reserve p))
      (fn2-alloc-current-epoch p) (fn2-alloc-next-counter p)
      (fn2-alloc-current-epoch q) (fn2-alloc-next-counter q)
      (fn2-alloc-live-ids (fn2-alloc-view p)))))
(defthm-owed fn2-alloc-ids-never-repeat (op i epoch counter arg p edges)
  (implies (fn2-alloc-invp p) (fn2-alloc-id-progress op i epoch counter arg p edges))
  :teeth (fn2-alloc-keystone-teeth)
  :doc "All issuing/lifetime transitions monotonically advance the epoch/counter watermark; each successful issue consumes its old watermark strictly. Init is construction, never a restart transition; relocation only changes edge columns.")

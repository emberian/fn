; Typed extent ownership. Identity references deliberately are not payload edges.
(in-package "ACL2")
(include-book "columns")
(include-book "owed")
(include-book "tuple")
(fn2-book-layer :b)
(fn2-cm-defreaders fn2-alloc-edge-request-slot fn2-alloc-edge-request-holder
                  fn2-alloc-edge-request-kind)
(fn2-cm-defreaders fn2-alloc-view-row-slot fn2-alloc-view-row-state
                  fn2-alloc-view-row-identity fn2-alloc-view-row-retirement
                  fn2-alloc-view-row-counts)
(make-event (cons 'progn (fn2-columns-enum-events
  '((reason (:enum fn2-alloc-reason-code (:live :checkpoint-blocked :quarantine :ready)))))))
(defconst *fn2-alloc-none* 4294967295)
(defconst *fn2-alloc-edge-count-max* 4294967295)
; Construction zero-fills; fn2-alloc-init installs the named absent links.
(defcolumns fn2-extents
  ((state (:enum fn2-extent-state (:free :reserved :allocated :retire-pending)))
   (owner-kind :u8) (owner-id :u60) (epoch :u60) (counter :u60)
   (retirement :u60) (next-free :u32) (next-retired :u32) (prev-retired :u32) (covered :bool)
   (installed-root :u32) (selectable-checkpoint :u32) (recovery-base :u32) (prepared-successor :u32) (reservation :u32) (obligation :u32) (promised-read :u32) (borrow :u32) (outstanding-io :u32) (recovery-candidate :u32))
  :init-name fn2-alloc-columns-init
  :extra-fields
  ((fn2-alloc-current-epoch :type (unsigned-byte 60) :initially 0 :why "Allocator-wide writer epoch, one per incarnation, not per extent row.")
   (fn2-alloc-next-counter :type (unsigned-byte 60) :initially 0 :why "Allocator-wide allocation counter within the current epoch.")
   (fn2-alloc-epoch-begun :type (unsigned-byte 1) :initially 0 :why "Whether the current writer epoch has begun; allocator-wide.")
   (fn2-alloc-free-head :type (unsigned-byte 32) :initially 0 :why "Head of the free-extent list threaded through next-free.")
   (fn2-alloc-total-free :type (unsigned-byte 60) :initially 0 :why "Allocator-wide count of free extents (conservation totals).")
   (fn2-alloc-total-reserved :type (unsigned-byte 60) :initially 0 :why "Allocator-wide count of reserved extents (conservation totals).")
   (fn2-alloc-total-allocated :type (unsigned-byte 60) :initially 0 :why "Allocator-wide count of allocated extents (conservation totals).")
   (fn2-alloc-total-retired :type (unsigned-byte 60) :initially 0 :why "Allocator-wide count of retire-pending extents (conservation totals).")
   (fn2-alloc-ready :type (unsigned-byte 60) :initially 0 :why "Retirement FIFO entries whose release predicate holds; allocator-wide.")
   (fn2-alloc-blocked :type (unsigned-byte 60) :initially 0 :why "Retirement FIFO entries still protected by an edge; allocator-wide.")
   (fn2-alloc-quarantined :type (unsigned-byte 60) :initially 0 :why "Extents quarantined by uncertainty; allocator-wide.")
   (fn2-alloc-cut :type (unsigned-byte 60) :initially 0 :why "Checkpoint-publication cut of the retirement FIFO; allocator-wide.")
   (fn2-alloc-coverage :type (unsigned-byte 60) :initially 0 :why "Retirement sequence covered by the last published checkpoint.")
   (fn2-alloc-last-retirement :type (unsigned-byte 60) :initially 0 :why "Last retirement sequence number issued; allocator-wide.")
   (fn2-alloc-retired-head :type (unsigned-byte 32) :initially 0 :why "Head of the retirement FIFO threaded through next/prev-retired.")
   (fn2-alloc-retired-tail :type (unsigned-byte 32) :initially 0 :why "Tail of the retirement FIFO threaded through next/prev-retired.")
   (fn2-alloc-pending :type (unsigned-byte 32) :initially 0 :why "Count of retirement FIFO entries; allocator-wide.")))
(defconst *fn2-alloc-edges* '(:installed-root :selectable-checkpoint :recovery-base
  :prepared-successor :reservation :obligation :promised-read :borrow
  :outstanding-io :recovery-candidate))
(defun fn2-alloc-slotp (i fn2-extents)
  (declare (xargs :stobjs fn2-extents :guard t))
  (and (natp i) (< i (fn2-extents-rows fn2-extents))))

; Internal links have one absent sentinel; an invalid pointer is corruption,
; never an empty list or resource-pressure result.
(defun fn2-alloc-link-statep (i expected-state fn2-extents)
  (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
  (or (equal i *fn2-alloc-none*)
      (and (fn2-alloc-slotp i fn2-extents)
           (equal (fn2-extents-state i fn2-extents) expected-state))))

(defun fn2-alloc-edge-count (i kind fn2-extents)
  (declare (xargs :stobjs fn2-extents :guard (and (fn2-extents-wfp fn2-extents) (fn2-alloc-slotp i fn2-extents) (member-eq kind *fn2-alloc-edges*))))
  (case kind
    (:installed-root (fn2-extents-installed-root i fn2-extents))
    (:selectable-checkpoint (fn2-extents-selectable-checkpoint i fn2-extents))
    (:recovery-base (fn2-extents-recovery-base i fn2-extents))
    (:prepared-successor (fn2-extents-prepared-successor i fn2-extents))
    (:reservation (fn2-extents-reservation i fn2-extents))
    (:obligation (fn2-extents-obligation i fn2-extents))
    (:promised-read (fn2-extents-promised-read i fn2-extents))
    (:borrow (fn2-extents-borrow i fn2-extents))
    (:outstanding-io (fn2-extents-outstanding-io i fn2-extents))
    (:recovery-candidate (fn2-extents-recovery-candidate i fn2-extents))
    (otherwise (fn2-extents-recovery-candidate i fn2-extents))))
(defun fn2-alloc-set-edge (i kind value fn2-extents)
  (declare (xargs :stobjs fn2-extents :guard (and (and (fn2-extents-wfp fn2-extents) (fn2-alloc-slotp i fn2-extents)) (unsigned-byte-p 32 value) (member-eq kind *fn2-alloc-edges*))))
  (case kind
    (:installed-root (fn2-extents-set-installed-root i value fn2-extents))
    (:selectable-checkpoint (fn2-extents-set-selectable-checkpoint i value fn2-extents))
    (:recovery-base (fn2-extents-set-recovery-base i value fn2-extents))
    (:prepared-successor (fn2-extents-set-prepared-successor i value fn2-extents))
    (:reservation (fn2-extents-set-reservation i value fn2-extents))
    (:obligation (fn2-extents-set-obligation i value fn2-extents))
    (:promised-read (fn2-extents-set-promised-read i value fn2-extents))
    (:borrow (fn2-extents-set-borrow i value fn2-extents))
    (:outstanding-io (fn2-extents-set-outstanding-io i value fn2-extents))
    (:recovery-candidate (fn2-extents-set-recovery-candidate i value fn2-extents))
    (otherwise (fn2-extents-set-recovery-candidate i value fn2-extents))))
(defthm fn2-alloc-set-edge-wfp
  (implies (and (fn2-extentsp fn2-extents) (and (fn2-extents-wfp fn2-extents) (fn2-alloc-slotp i fn2-extents)) (unsigned-byte-p 32 value)) (fn2-extents-wfp (fn2-alloc-set-edge i kind value fn2-extents))))
(defthm fn2-alloc-set-edge-type
  (implies (and (fn2-extentsp fn2-extents) (and (fn2-extents-wfp fn2-extents) (fn2-alloc-slotp i fn2-extents)) (unsigned-byte-p 32 value)) (fn2-extentsp (fn2-alloc-set-edge i kind value fn2-extents))))
(defthm fn2-alloc-set-edge-rows
  (equal (fn2-extents-rows (fn2-alloc-set-edge i kind value fn2-extents))
         (fn2-extents-rows fn2-extents)))
(in-theory (disable fn2-alloc-set-edge))
(defun fn2-alloc-protector-list (i kinds except fn2-extents)
  (declare (xargs :stobjs fn2-extents
    :guard (and (fn2-extents-wfp fn2-extents) (fn2-alloc-slotp i fn2-extents)
                (true-listp kinds) (subsetp-eq kinds *fn2-alloc-edges*))))
  (if (atom kinds) nil
    (if (and (not (eq (car kinds) except))
             (< 0 (fn2-alloc-edge-count i (car kinds) fn2-extents)))
        (car kinds)
      (fn2-alloc-protector-list i (cdr kinds) except fn2-extents))))
(defun fn2-alloc-protector (i except fn2-extents)
  (declare (xargs :stobjs fn2-extents
    :guard (and (fn2-extents-wfp fn2-extents) (fn2-alloc-slotp i fn2-extents))))
  (fn2-alloc-protector-list i *fn2-alloc-edges* except fn2-extents))
(defun fn2-alloc-reason (i cut fn2-extents)
  (declare (xargs :stobjs fn2-extents :guard (and (and (fn2-extents-wfp fn2-extents) (fn2-alloc-slotp i fn2-extents)) (unsigned-byte-p 60 cut))))
  (cond ((< 0 (fn2-extents-recovery-candidate i fn2-extents)) *fn2-alloc-reason-code-quarantine*)
        ((and (equal (fn2-extents-state i fn2-extents) *fn2-extent-state-retire-pending*)
              (not (fn2-alloc-protector i nil fn2-extents))
              (< cut (fn2-extents-retirement i fn2-extents))
              (= (fn2-extents-covered i fn2-extents) 0)) *fn2-alloc-reason-code-checkpoint-blocked*)
        ((and (equal (fn2-extents-state i fn2-extents) *fn2-extent-state-retire-pending*)
              (not (fn2-alloc-protector i nil fn2-extents))) *fn2-alloc-reason-code-ready*)
        (t *fn2-alloc-reason-code-live*)))
(in-theory (disable fn2-alloc-reason fn2-alloc-protector))
; Exact arithmetic; callers assert the local accounting invariant before use.
(defun fn2-alloc-adjust-okp (n old new)
  (declare (xargs :guard (unsigned-byte-p 60 n)))
  (unsigned-byte-p 60 (+ n (if new 1 0) (- (if old 1 0)))))
(defun fn2-alloc-adjust (n old new)
  (declare (xargs :guard (and (unsigned-byte-p 60 n) (fn2-alloc-adjust-okp n old new))))
  (+ n (if new 1 0) (- (if old 1 0))))
(defthm fn2-alloc-adjust-range
  (implies (fn2-alloc-adjust-okp n old new)
           (unsigned-byte-p 60 (fn2-alloc-adjust n old new))))
(in-theory (disable fn2-alloc-adjust fn2-alloc-adjust-okp))
(defun fn2-alloc-account (i old-state old-reason fn2-extents)
  (declare (xargs :stobjs fn2-extents :guard (and (fn2-extents-wfp fn2-extents) (fn2-alloc-slotp i fn2-extents))))
  (let* ((s (fn2-extents-state i fn2-extents))
         (r (fn2-alloc-reason i (fn2-alloc-cut fn2-extents) fn2-extents))
         (account-ok (and
           (fn2-alloc-adjust-okp (fn2-alloc-total-free fn2-extents)
                  (equal old-state *fn2-extent-state-free*)
                  (equal s *fn2-extent-state-free*))
           (fn2-alloc-adjust-okp (fn2-alloc-total-reserved fn2-extents)
                  (equal old-state *fn2-extent-state-reserved*)
                  (equal s *fn2-extent-state-reserved*))
           (fn2-alloc-adjust-okp (fn2-alloc-total-allocated fn2-extents)
                  (equal old-state *fn2-extent-state-allocated*)
                  (equal s *fn2-extent-state-allocated*))
           (fn2-alloc-adjust-okp (fn2-alloc-total-retired fn2-extents)
                  (equal old-state *fn2-extent-state-retire-pending*)
                  (equal s *fn2-extent-state-retire-pending*))
           (fn2-alloc-adjust-okp (fn2-alloc-ready fn2-extents)
                  (equal old-reason *fn2-alloc-reason-code-ready*)
                  (equal r *fn2-alloc-reason-code-ready*))
           (fn2-alloc-adjust-okp (fn2-alloc-blocked fn2-extents)
                  (equal old-reason *fn2-alloc-reason-code-checkpoint-blocked*)
                  (equal r *fn2-alloc-reason-code-checkpoint-blocked*))
           (fn2-alloc-adjust-okp (fn2-alloc-quarantined fn2-extents)
                  (equal old-reason *fn2-alloc-reason-code-quarantine*)
                  (equal r *fn2-alloc-reason-code-quarantine*)))))
    (if (not account-ok)
        (prog2$ (er hard? 'fn2-alloc-account "Broken extent accounting invariant." nil) fn2-extents)
      (let* (
         (fn2-extents (update-fn2-alloc-total-free
           (fn2-alloc-adjust (fn2-alloc-total-free fn2-extents) (equal old-state *fn2-extent-state-free*) (equal s *fn2-extent-state-free*)) fn2-extents))
         (fn2-extents (update-fn2-alloc-total-reserved
           (fn2-alloc-adjust (fn2-alloc-total-reserved fn2-extents) (equal old-state *fn2-extent-state-reserved*) (equal s *fn2-extent-state-reserved*)) fn2-extents))
         (fn2-extents (update-fn2-alloc-total-allocated
           (fn2-alloc-adjust (fn2-alloc-total-allocated fn2-extents) (equal old-state *fn2-extent-state-allocated*) (equal s *fn2-extent-state-allocated*)) fn2-extents))
         (fn2-extents (update-fn2-alloc-total-retired
           (fn2-alloc-adjust (fn2-alloc-total-retired fn2-extents) (equal old-state *fn2-extent-state-retire-pending*) (equal s *fn2-extent-state-retire-pending*)) fn2-extents))
         (fn2-extents (update-fn2-alloc-ready
           (fn2-alloc-adjust (fn2-alloc-ready fn2-extents) (equal old-reason *fn2-alloc-reason-code-ready*) (equal r *fn2-alloc-reason-code-ready*)) fn2-extents))
         (fn2-extents (update-fn2-alloc-blocked
           (fn2-alloc-adjust (fn2-alloc-blocked fn2-extents) (equal old-reason *fn2-alloc-reason-code-checkpoint-blocked*) (equal r *fn2-alloc-reason-code-checkpoint-blocked*)) fn2-extents))
         (fn2-extents (update-fn2-alloc-quarantined
           (fn2-alloc-adjust (fn2-alloc-quarantined fn2-extents) (equal old-reason *fn2-alloc-reason-code-quarantine*) (equal r *fn2-alloc-reason-code-quarantine*)) fn2-extents)))
    fn2-extents))))
(defun fn2-alloc-pressure (fn2-extents)
  (declare (xargs :stobjs fn2-extents :guard t))
  (cond ((< 0 (fn2-alloc-total-free fn2-extents)) :ok)
        ((< 0 (fn2-alloc-ready fn2-extents)) :ok)
        ((< 0 (fn2-alloc-blocked fn2-extents)) :checkpoint-blocked)
        ((< 0 (fn2-alloc-quarantined fn2-extents)) :quarantine)
        (t :all-live)))
(defun fn2-alloc-handle-code (i epoch counter fn2-extents)
  (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
  (cond ((not (fn2-alloc-slotp i fn2-extents)) :bounds)
        ((or (not (equal epoch (fn2-extents-epoch i fn2-extents)))
             (not (equal counter (fn2-extents-counter i fn2-extents)))) :stale)
        ((equal (fn2-extents-state i fn2-extents) *fn2-extent-state-free*) :state)
        (t :ok)))
(defun fn2-alloc-init-links (n fn2-extents)
  (declare (xargs :stobjs fn2-extents :measure (nfix n)
    :guard (and (fn2-extents-wfp fn2-extents) (natp n) (<= n (fn2-extents-rows fn2-extents)))))
  (if (zp n) fn2-extents
    (let* ((i (- n 1))
           (fn2-extents (fn2-extents-set-state i *fn2-extent-state-free* fn2-extents))
           (fn2-extents (fn2-extents-set-owner-kind i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-owner-id i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-epoch i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-counter i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-retirement i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-installed-root i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-selectable-checkpoint i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-recovery-base i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-prepared-successor i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-reservation i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-obligation i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-promised-read i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-borrow i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-outstanding-io i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-recovery-candidate i 0 fn2-extents))
           (fn2-extents (fn2-extents-set-next-free i (if (= n (fn2-extents-rows fn2-extents)) *fn2-alloc-none* n) fn2-extents)))
      (fn2-alloc-init-links i fn2-extents))))
(defthm fn2-alloc-init-links-wfp
  (implies (and (fn2-extents-wfp fn2-extents) (natp n) (<= n (fn2-extents-rows fn2-extents)))
    (fn2-extents-wfp (fn2-alloc-init-links n fn2-extents))))
(defthm fn2-alloc-init-links-type
  (implies (and (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents) (natp n) (<= n (fn2-extents-rows fn2-extents)))
    (fn2-extentsp (fn2-alloc-init-links n fn2-extents))))
(in-theory (disable fn2-alloc-init-links))
(defun fn2-alloc-init (n fn2-extents)
  (declare (xargs :stobjs fn2-extents :guard (unsigned-byte-p 32 n)))
  (let* ((fn2-extents (fn2-alloc-columns-init n fn2-extents))
         (fn2-extents (fn2-alloc-init-links n fn2-extents))
         (fn2-extents (update-fn2-alloc-total-free n fn2-extents))
         (fn2-extents (update-fn2-alloc-total-reserved 0 fn2-extents))
         (fn2-extents (update-fn2-alloc-total-allocated 0 fn2-extents))
         (fn2-extents (update-fn2-alloc-total-retired 0 fn2-extents))
         (fn2-extents (update-fn2-alloc-current-epoch 0 fn2-extents))
         (fn2-extents (update-fn2-alloc-next-counter 0 fn2-extents))
         (fn2-extents (update-fn2-alloc-epoch-begun 0 fn2-extents))
         (fn2-extents (update-fn2-alloc-ready 0 fn2-extents))
         (fn2-extents (update-fn2-alloc-blocked 0 fn2-extents))
         (fn2-extents (update-fn2-alloc-quarantined 0 fn2-extents))
         (fn2-extents (update-fn2-alloc-cut 0 fn2-extents))
         (fn2-extents (update-fn2-alloc-coverage 0 fn2-extents))
         (fn2-extents (update-fn2-alloc-last-retirement 0 fn2-extents))
         (fn2-extents (update-fn2-alloc-retired-head *fn2-alloc-none* fn2-extents))
         (fn2-extents (update-fn2-alloc-retired-tail *fn2-alloc-none* fn2-extents))
         (fn2-extents (update-fn2-alloc-pending *fn2-alloc-none* fn2-extents))
         (fn2-extents (update-fn2-alloc-free-head (if (zp n) *fn2-alloc-none* 0) fn2-extents)))
    fn2-extents))
; Called only on completion of the BEGIN_WRITER_EPOCH fence. Does not end I/O.
(defun fn2-alloc-begin-epoch (epoch fn2-extents)
  (declare (xargs :stobjs fn2-extents :guard (unsigned-byte-p 60 epoch)))
  (cond ((<= epoch (fn2-alloc-current-epoch fn2-extents)) (mv :epoch-order fn2-extents))
        (t (let* ((fn2-extents (update-fn2-alloc-current-epoch epoch fn2-extents))
                  (fn2-extents (update-fn2-alloc-next-counter 0 fn2-extents))
                  (fn2-extents (update-fn2-alloc-epoch-begun 1 fn2-extents)))
             (mv :ok fn2-extents)))))
(defun fn2-alloc-reserve (fn2-extents)
  (declare (xargs :stobjs fn2-extents :guard (fn2-extents-wfp fn2-extents)))
  (assert$? (and (fn2-alloc-link-statep (fn2-alloc-free-head fn2-extents)
                                      *fn2-extent-state-free* fn2-extents)
       (or (equal (fn2-alloc-free-head fn2-extents) *fn2-alloc-none*)
           (fn2-alloc-link-statep
             (fn2-extents-next-free (fn2-alloc-free-head fn2-extents) fn2-extents)
             *fn2-extent-state-free* fn2-extents)))
    (let ((i (fn2-alloc-free-head fn2-extents))
        (epoch (fn2-alloc-current-epoch fn2-extents))
        (counter (fn2-alloc-next-counter fn2-extents)))
    (cond ((equal (fn2-alloc-epoch-begun fn2-extents) 0) (mv :epoch-not-begun nil 0 0 0 fn2-extents))
          ((= counter 1152921504606846975) (mv :counter-exhausted nil 0 0 0 fn2-extents))
          ((not (fn2-alloc-slotp i fn2-extents)) (mv :no-space (fn2-alloc-pressure fn2-extents) 0 0 0 fn2-extents))
          (t (let* ((fn2-extents (update-fn2-alloc-free-head (fn2-extents-next-free i fn2-extents) fn2-extents))
                    (fn2-extents (fn2-extents-set-state i *fn2-extent-state-reserved* fn2-extents))
                    (fn2-extents (fn2-extents-set-epoch i epoch fn2-extents))
                    (fn2-extents (fn2-extents-set-counter i counter fn2-extents))
                    (fn2-extents (fn2-extents-set-reservation i 1 fn2-extents))
                    (fn2-extents (update-fn2-alloc-next-counter (+ 1 counter) fn2-extents))
                    (fn2-extents (fn2-alloc-account i *fn2-extent-state-free* *fn2-alloc-reason-code-live* fn2-extents)))
               (mv :ok nil i epoch counter fn2-extents)))))))

; Edges are individually owned rows. Capacity is a supported-profile resource;
; exhaustion is admission pressure, never permission to drop another holder.
(defcolumns fn2-alloc-edges
  ((state (:enum fn2-alloc-edge-state (:free :live)))
   (kind (:enum fn2-alloc-edge-kind (:installed-root :selectable-checkpoint
      :recovery-base :prepared-successor :reservation :obligation
      :promised-read :borrow :outstanding-io :recovery-candidate)))
   (holder :u60) (extent :u32) (epoch :u60) (counter :u60)))
(defun fn2-alloc-edge-slotp (edge fn2-alloc-edges)
  (declare (xargs :stobjs fn2-alloc-edges :guard t))
  (and (natp edge) (< edge (fn2-alloc-edges-rows fn2-alloc-edges))))
(defun fn2-alloc-edge-matchesp (edge holder i epoch counter kind fn2-alloc-edges)
  (declare (xargs :stobjs fn2-alloc-edges
    :guard (and (fn2-alloc-edges-wfp fn2-alloc-edges)
                (fn2-alloc-edge-slotp edge fn2-alloc-edges))))
  (and (equal (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-live*)
       (equal holder (fn2-alloc-edges-holder edge fn2-alloc-edges))
       (equal i (fn2-alloc-edges-extent edge fn2-alloc-edges))
       (equal epoch (fn2-alloc-edges-epoch edge fn2-alloc-edges))
       (equal counter (fn2-alloc-edges-counter edge fn2-alloc-edges))
       (equal (fn2-alloc-edge-kind-keyword->code kind)
              (fn2-alloc-edges-kind edge fn2-alloc-edges))))
(defun fn2-alloc-edge-add (edge holder i epoch counter kind fn2-extents fn2-alloc-edges)
  (declare (xargs :stobjs (fn2-extents fn2-alloc-edges)
    :guard (and (fn2-extents-wfp fn2-extents) (fn2-alloc-edges-wfp fn2-alloc-edges)
                (unsigned-byte-p 60 holder) (unsigned-byte-p 60 epoch)
                (unsigned-byte-p 60 counter))))
  (let ((code (fn2-alloc-handle-code i epoch counter fn2-extents)))
    (cond ((not (eq code :ok)) (mv code fn2-extents fn2-alloc-edges))
          ((not (member-eq kind *fn2-alloc-edges*)) (mv :edge-kind fn2-extents fn2-alloc-edges))
          ((eq kind :reservation) (mv :reservation-owned fn2-extents fn2-alloc-edges))
          ((not (fn2-alloc-edge-slotp edge fn2-alloc-edges)) (mv :edge-bounds fn2-extents fn2-alloc-edges))

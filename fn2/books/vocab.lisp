; Payload validation is constant work and precedes any reservation mutation.
; A malformed event cannot occupy a genuine completion's reserved cell.
; Insert before fn2-post-payloadp.  ENVELOPE 2.3 closes failure reasons
; per primitive, not merely over the union of all reasons.  ROUND2 D.2 adds
; write uncertainty and CancelResult's cancelled/not-cancellable statuses.
(defun fn2-event-failure-reasonp (evkind reason)
  (declare (xargs :guard t))
  (cond
   ((equal evkind *fn2-event-accept-result*)
    (or (equal reason *fn2-reason-exhausted*)
        (equal reason *fn2-reason-aborted*)))
   ((equal evkind *fn2-event-connect-result*)
    (or (equal reason *fn2-reason-refused*)
        (equal reason *fn2-reason-unreachable*)
        (equal reason *fn2-reason-timed-out*)
        (equal reason *fn2-reason-reset*)))
   ((equal evkind *fn2-event-receive-result*)
    (or (equal reason *fn2-reason-reset*)
        (equal reason *fn2-reason-closed*)))
   ((equal evkind *fn2-event-send-result*)
    (or (equal reason *fn2-reason-reset*)
        (equal reason *fn2-reason-closed*)
        (equal reason *fn2-reason-pipe*)))
   ((equal evkind *fn2-event-tls-result*)
    (or (equal reason *fn2-reason-handshake*)
        (equal reason *fn2-reason-reset*)
        (equal reason *fn2-reason-timed-out*)))
   ((equal evkind *fn2-event-read-result*)
    (equal reason *fn2-reason-io*))
   ((equal evkind *fn2-event-write-result*)
    (or (equal reason *fn2-reason-io*)
        (equal reason *fn2-reason-no-space*)
        (equal reason *fn2-reason-uncertain*)))
   ((equal evkind *fn2-event-fence-result*)
    (equal reason *fn2-reason-io*))
   ; Close always completes. Cancel/release have no failure reasons.
   ; Entropy has no specified failure reason; do not invent one here.
   (t nil)))

(defun fn2-event-nonfailure-outcomep (evkind outcome)
  (declare (xargs :guard t))
  (cond
   ((or (equal evkind *fn2-event-close-result*)
        (equal evkind *fn2-event-borrow-released*))
    (equal outcome *fn2-outcome-done*))
   ((equal evkind *fn2-event-cancel-result*)
    (or (equal outcome *fn2-outcome-done*)
        (equal outcome *fn2-outcome-cancelled*)
        (equal outcome *fn2-outcome-not-found*)
        (equal outcome *fn2-outcome-not-cancellable*)))
   ((or (equal evkind *fn2-event-send-result*)
        (equal evkind *fn2-event-read-result*))
    (or (equal outcome *fn2-outcome-done*)
        (equal outcome *fn2-outcome-short*)
        (equal outcome *fn2-outcome-cancelled*)))
   ((or (equal evkind *fn2-event-accept-result*)
        (equal evkind *fn2-event-connect-result*)
        (equal evkind *fn2-event-receive-result*)
        (equal evkind *fn2-event-write-result*)
        (equal evkind *fn2-event-fence-result*)
        (equal evkind *fn2-event-tls-result*)
        (equal evkind *fn2-event-entropy-result*))
    (or (equal outcome *fn2-outcome-done*)
        (equal outcome *fn2-outcome-cancelled*)))
   (t nil)))

(defun fn2-event-statusp (evkind outcome reason)
  (declare (xargs :guard t))
  (if (equal outcome *fn2-outcome-failed*)
      (fn2-event-failure-reasonp evkind reason)
    (and (equal reason *fn2-reason-none*)
         (fn2-event-nonfailure-outcomep evkind outcome))))

; Short storage writes are failed/uncertain (ENVELOPE 2.5, row 22).
; This predicate validates observation shape; it does not infer persistence
; from a known progress count, nor turn a failed write into a rollback.
(assert-event
 (and
  (fn2-event-statusp *fn2-event-write-result* *fn2-outcome-failed*
                    *fn2-reason-uncertain*)
  (fn2-event-statusp *fn2-event-read-result* *fn2-outcome-short*
                    *fn2-reason-none*)
  (fn2-event-statusp *fn2-event-send-result* *fn2-outcome-short*
                    *fn2-reason-none*)
  (fn2-event-statusp *fn2-event-cancel-result* *fn2-outcome-cancelled*
                    *fn2-reason-none*)
  (fn2-event-statusp *fn2-event-borrow-released* *fn2-outcome-done*
                    *fn2-reason-none*)
  (not (fn2-event-statusp *fn2-event-close-result* *fn2-outcome-failed*
                         *fn2-reason-handshake*))
  (not (fn2-event-statusp *fn2-event-receive-result* *fn2-outcome-failed*
                         *fn2-reason-no-space*))
  (not (fn2-event-statusp *fn2-event-write-result* *fn2-outcome-short*
                         *fn2-reason-none*))
  (not (fn2-event-statusp *fn2-event-read-result* *fn2-outcome-failed*
                         *fn2-reason-uncertain*))
  (not (fn2-event-statusp *fn2-event-entropy-result* *fn2-outcome-failed*
                         *fn2-reason-io*))
  (not (fn2-event-statusp 255 *fn2-outcome-done* *fn2-reason-none*))))

(assert-event (eq (symbol-class 'fn2-event-failure-reasonp (w state))
                  :common-lisp-compliant))
(assert-event (eq (symbol-class 'fn2-event-nonfailure-outcomep (w state))
                  :common-lisp-compliant))
(assert-event (eq (symbol-class 'fn2-event-statusp (w state))
                  :common-lisp-compliant))


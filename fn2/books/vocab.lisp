                      (and (equal p0 0) (equal h0 0) (equal p1 0) (equal h1 0))))
           (implies (equal phase *fn2-op-phase-retired*)
                    (and (equal (fn2-ops-gen slot fn2-ops) (fn2-ops-gen-limit fn2-ops))
                         (equal p0 h0) (equal p1 h1)))
           t))))

(defun fn2-ops-semanticp (fn2-ops)
  (declare (xargs :stobjs fn2-ops :verify-guards nil))
  (let* ((rows (fn2-ops-rows fn2-ops))
         (qa (fn2-ops-out-slot-length fn2-ops))
         (free (fn2-ops-phase-slots rows *fn2-op-phase-free* fn2-ops))
         (reserved (fn2-ops-phase-slots rows *fn2-op-phase-reserved* fn2-ops))
         (queued (fn2-ops-phase-slots rows *fn2-op-phase-queued* fn2-ops))
         (submitted (fn2-ops-phase-slots rows *fn2-op-phase-submitted* fn2-ops))
         (release (fn2-ops-phase-slots rows *fn2-op-phase-release-pending* fn2-ops))
         (done (fn2-ops-phase-slots rows *fn2-op-phase-done* fn2-ops))
         (retired (fn2-ops-phase-slots rows *fn2-op-phase-retired* fn2-ops))
         (chain (fn2-ops-free-chain rows (fn2-ops-free-head fn2-ops) fn2-ops))
         (out (fn2-ops-outbox-list fn2-ops))
         (posted (fn2-ops-posted-list fn2-ops)))
    (and (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops)
         (unsigned-byte-p 32 qa)
         (equal (fn2-ops-out-gen-length fn2-ops) qa)
         (equal (fn2-ops-posted-fifo-length fn2-ops) (* 2 rows))
         (fn2-ops-ring-shapep qa (fn2-ops-out-head fn2-ops)
                             (fn2-ops-out-tail fn2-ops) (fn2-ops-queued fn2-ops))
         (fn2-ops-ring-shapep (* 2 rows) (fn2-ops-post-head fn2-ops)
                             (fn2-ops-post-tail fn2-ops) (fn2-ops-post-count fn2-ops))
         (fn2-ops-row-semanticp rows fn2-ops)
         (equal (+ (len free) (len reserved) (len queued) (len submitted)
                   (len release) (len done) (len retired)) rows)
         (not (member-equal :bad-chain chain))
         (fn2-ops-same-membersp chain free)
         (equal (fn2-ops-free-count fn2-ops) (len free))
         (equal (fn2-ops-retired-count fn2-ops) (len retired))
         (equal (fn2-ops-reserved-credits fn2-ops) (len reserved))
         (equal (fn2-ops-queued fn2-ops) (len queued))
         (<= (+ (len reserved) (len queued)) qa)
         (equal (fn2-ops-outbox-credits fn2-ops) (- qa (+ (len reserved) (len queued))))
         (fn2-ops-queued-refsp out fn2-ops)
         (fn2-ops-same-membersp (fn2-ops-ref-slots out) queued)
         (fn2-ops-same-membersp posted (fn2-ops-pending-cells rows fn2-ops)))))


(defconst *fn2-ops-operations*
  '(:init :reserve :set-range :set-capability :set-storage :set-cancel-target :set-wake
    :unreserve :enqueue :ack :post-result :harvest :finish :request-cancel
    :post-clock :take-clock :post-signal :take-signal :peek))

; This logical dispatcher invokes the actual runtime exports, never a twin.
; A two-element result retains the response code and the complete logical table.
(defun-nx fn2-ops-operation (op a p)
  (case op
    (:init (list :ok (fn2-ops-init (nth 0 a) p)))
    (:reserve (mv-let (code slot gen q)
                (fn2-op-reserve (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a)
                                (nth 4 a) (nth 5 a) p)
                (declare (ignore slot gen)) (list code q)))
    (:set-range (mv-let (code q)
                  (fn2-op-set-range (nth 0 a) (nth 1 a) (nth 2 a)
                                    (nth 3 a) (nth 4 a) (nth 5 a) p)
                  (list code q)))
    (:set-capability (mv-let (code q)
                       (fn2-op-set-capability (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) p)
                       (list code q)))
    (:set-storage (mv-let (code q)
                    (fn2-op-set-storage (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) p)
                    (list code q)))
    (:set-cancel-target (mv-let (code q)
                          (fn2-op-set-cancel-target (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) p)
                          (list code q)))
    (:set-wake (mv-let (code q)
                 (fn2-op-set-wake (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) p)
                 (list code q)))
    (:unreserve (mv-let (code q) (fn2-op-unreserve (nth 0 a) (nth 1 a) p) (list code q)))
    (:enqueue (mv-let (code q) (fn2-op-enqueue (nth 0 a) (nth 1 a) p) (list code q)))
    (:ack (mv-let (code q) (fn2-outbox-ack (nth 0 a) p) (list code q)))
    (:post-result (list :posted
                    (fn2-post-result (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a)
                                     (nth 4 a) (nth 5 a) (nth 6 a) (nth 7 a) (nth 8 a) p)))
    (:harvest (mv-let (found slot gen cell q) (fn2-harvest-next p)
                (declare (ignore slot gen cell)) (list found q)))
    (:finish (mv-let (code q) (fn2-op-finish (nth 0 a) (nth 1 a) p) (list code q)))
    (:request-cancel (mv-let (code q) (fn2-op-request-cancel (nth 0 a) (nth 1 a) p) (list code q)))
    (:post-clock (list :posted (fn2-post-clock (nth 0 a) (nth 1 a) (nth 2 a) p)))
    (:take-clock (mv-let (posted mono real flags q) (fn2-take-clock p)
                   (declare (ignore mono real flags)) (list posted q)))
    (:post-signal (list :posted (fn2-post-signal (nth 0 a) p)))
    (:take-signal (mv-let (bits q) (fn2-take-signal p) (list bits q)))
    (:peek (mv-let (code slot gen) (fn2-outbox-peek (nth 0 a) p)
             (declare (ignore slot gen)) (list code p)))
    (otherwise (list :unknown p))))

(defun fn2-ops-conservation-hyps (op a fn2-ops)
  (declare (xargs :stobjs fn2-ops :verify-guards nil))
  (and (member-eq op *fn2-ops-operations*)
       (if (eq op :init)
           (and (fn2-opsp fn2-ops) (fn2-profilep (nth 0 a)))
         (fn2-ops-semanticp fn2-ops))))
(defun-nx fn2-ops-conservation-conclusion (op a p)
  (fn2-ops-semanticp (cadr (fn2-ops-operation op a p))))
(defthm-owed fn2-ops-credit-conservation (op a p)
  (implies (fn2-ops-conservation-hyps op a p)
           (fn2-ops-conservation-conclusion op a p))
  :teeth (fn2-vocab-conservation-teeth)
  :doc "Init establishes and every operation preserves exact row partition including retired rows, acyclic free chain/count, reserved+queued outbox credit, ordered queued references, and a bijection between posted FIFO entries and posted unharvested cells.")

(defun fn2-ops-stray-hyps (cell slot gen fn2-ops)
  (declare (xargs :stobjs fn2-ops :verify-guards nil))
  (and (fn2-ops-semanticp fn2-ops)
       (or (not (fn2-op-slotp slot fn2-ops))
           (not (equal gen (fn2-ops-gen slot fn2-ops)))
           (if (equal cell 0)
               (or (not (equal (fn2-ops-phase slot fn2-ops) *fn2-op-phase-submitted*))
                   (equal (fn2-ops-c0-posted slot fn2-ops) 1))
             (if (equal cell 1)
                 (or (not (equal (fn2-ops-may-release slot fn2-ops) 1))
                     (not (member-equal (fn2-ops-phase slot fn2-ops)
                                       (list *fn2-op-phase-submitted* *fn2-op-phase-release-pending*)))
                     (equal (fn2-ops-c1-posted slot fn2-ops) 1))
               t)))))
(defun fn2-ops-stray-resultp (old-stray new-stray old-nonstray new-nonstray)
  (and (equal new-stray (min 1152921504606846975 (+ 1 old-stray)))
       (equal old-nonstray new-nonstray)))
(defun-nx fn2-ops-stray-conclusion (cell slot gen evkind outcome reason count aux0 aux1 p)
  (let ((q (fn2-post-result cell slot gen evkind outcome reason count aux0 aux1 p)))
    (fn2-ops-stray-resultp (fn2-ops-stray p) (fn2-ops-stray q)
                         (fn2-ops-nonstray-snapshot p) (fn2-ops-nonstray-snapshot q))))
(defthm-owed fn2-ops-stale-or-duplicate-post (cell slot gen evkind outcome reason count aux0 aux1 p)
  (implies (fn2-ops-stray-hyps cell slot gen p)
           (fn2-ops-stray-conclusion cell slot gen evkind outcome reason count aux0 aux1 p))
  :teeth (fn2-vocab-stray-teeth)
  :doc "A stale, duplicate, unreserved, or phase-ineligible result changes exactly the saturating stray counter, including preservation of unused ring storage and every row field.")

(defun fn2-ops-order-hyps (n fn2-ops)
  (declare (xargs :stobjs fn2-ops :verify-guards nil))
  (and (fn2-ops-semanticp fn2-ops) (natp n) (<= n (fn2-ops-queued fn2-ops))))
(defun fn2-ops-order-rows-resultp (slot prefix before after)
  (declare (xargs :measure (acl2-count before) :verify-guards nil))
  (if (atom before) (equal before after)
    (and (consp after)
         (equal (car after)
                (if (member-equal (list slot (caar before)) prefix)
                    (update-nth 1 (fn2-op-ack-phase (nth 2 (car before))) (car before))
                  (car before)))
         (fn2-ops-order-rows-resultp (+ 1 (nfix slot)) prefix (cdr before) (cdr after)))))
(defun fn2-ops-order-resultp (code n old-outbox new-outbox old-rows new-rows)
  (and (eq code :ok)
       (equal new-outbox (nthcdr n old-outbox))
       (fn2-ops-order-rows-resultp 0 (take n old-outbox) old-rows new-rows)))
(defun-nx fn2-ops-order-conclusion (n p)
  (mv-let (code q) (fn2-outbox-ack n p)
    (fn2-ops-order-resultp code n (fn2-ops-outbox-list p) (fn2-ops-outbox-list q)
                          (fn2-ops-rows-snapshot (fn2-ops-rows p) p)
                          (fn2-ops-rows-snapshot (fn2-ops-rows q) q))))
(defthm-owed fn2-ops-outbox-order (n p)
  (implies (fn2-ops-order-hyps n p) (fn2-ops-order-conclusion n p))
  :teeth (fn2-vocab-order-teeth)
  :doc "Acknowledgment consumes exactly the oldest n queued descriptors in enqueue order, moves completion-bearing actions to submitted and arm-wake/trace/service-posture to done, preserves every other row and field, and leaves the exact unacknowledged suffix in order.")

(defun fn2-ops-reservation-hyps (slot gen evkind outcome reason count aux0 aux1 fn2-ops)
  (declare (xargs :stobjs fn2-ops :verify-guards nil))
  (and (fn2-ops-semanticp fn2-ops)
       (fn2-op-slotp slot fn2-ops)
       (equal gen (fn2-ops-gen slot fn2-ops))
       (equal (fn2-ops-phase slot fn2-ops) *fn2-op-phase-reserved*)
       (fn2-post-payloadp 0 slot evkind outcome reason count aux0 aux1 fn2-ops)))
(defun fn2-ops-reservation-resultp
  (enqueue-code ack-code old-stray new-stray old-fifo new-fifo cell-value
   slot evkind outcome reason count aux0 aux1)
  (and (eq enqueue-code :ok) (eq ack-code :ok)
       (equal old-stray new-stray)
       (equal new-fifo (append old-fifo (list (* 2 slot))))
       (equal cell-value (list 1 0 evkind outcome reason count aux0 aux1))))
(defun-nx fn2-ops-reservation-conclusion (slot gen evkind outcome reason count aux0 aux1 p)
  (mv-let (enqueue-code q) (fn2-op-enqueue slot gen p)
    (mv-let (ack-code r) (fn2-outbox-ack (fn2-outbox-queued q) q)
      (let ((s (fn2-post-result 0 slot gen evkind outcome reason count aux0 aux1 r)))
        (fn2-ops-reservation-resultp enqueue-code ack-code (fn2-ops-stray p) (fn2-ops-stray s)
          (fn2-ops-posted-list p) (fn2-ops-posted-list s) (fn2-ops-cell-snapshot 0 slot s)
          slot evkind outcome reason count aux0 aux1)))))
(defthm-owed fn2-ops-result-reservation (slot gen evkind outcome reason count aux0 aux1 p)
  (implies (fn2-ops-reservation-hyps slot gen evkind outcome reason count aux0 aux1 p)
           (fn2-ops-reservation-conclusion slot gen evkind outcome reason count aux0 aux1 p))
  :teeth (fn2-vocab-reservation-teeth)
  :doc "A reserved operation already owns its descriptor and two result cells: enqueue and acknowledgment succeed and its genuine terminal result is accepted with exact payload and FIFO append, even with all other available cells occupied.")

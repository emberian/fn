  (declare (xargs :stobjs fn2-ops :measure (nfix n)
                  :guard (and (fn2-ops-wfp fn2-ops) (natp n) (natp index))))
  (if (zp n) t
    (and (< index (fn2-ops-out-slot-length fn2-ops))
         (< index (fn2-ops-out-gen-length fn2-ops))
         (eq (fn2-op-phase-code (fn2-ops-out-sloti index fn2-ops)
                                 (fn2-ops-out-geni index fn2-ops)
                                 *fn2-op-phase-queued* fn2-ops) :ok)
         (fn2-outbox-prefixp (- n 1) (fn2-ring-next index (fn2-ops-out-slot-length fn2-ops)) fn2-ops))))

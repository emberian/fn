(defun fn2-outbox-peek (k fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (let ((capacity (fn2-ops-out-slot-length fn2-ops)))
    (if (not (and (natp k) (< k (fn2-ops-queued fn2-ops))
                  (<= (fn2-ops-queued fn2-ops) capacity)
                  (< (fn2-ops-out-head fn2-ops) capacity) (< 0 capacity)))
        (mv :bounds 0 0)
      (let* ((sum (+ (fn2-ops-out-head fn2-ops) k))
             (index (if (< sum capacity) sum (- sum capacity))))
        (if (>= index (fn2-ops-out-gen-length fn2-ops)) (mv :bounds 0 0)
          (mv :ok (fn2-ops-out-sloti index fn2-ops) (fn2-ops-out-geni index fn2-ops)))))))

; Preflight ensures even malformed internal ring state cannot cause a partial

; Clock flag bits: 0 realtime-valid, 1 realtime-negative, 2 backward,
; 3 malformed. Monotonic high-water survives take; error bits survive coalescing.
; The separate rejected counter counts even a bad first observation.
(defun fn2-post-clock (mono real flags fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)
                  :guard-hints (("Goal" :in-theory (disable binary-logior binary-logand)))))
  (let* ((valid (and (unsigned-byte-p 60 mono) (unsigned-byte-p 60 real) (unsigned-byte-p 2 flags)))
         (backward (and valid (= (fn2-ops-clock-seen fn2-ops) 1) (< mono (fn2-ops-clock-mono fn2-ops)))))
    (let* ((fn2-ops
            (if (= (fn2-ops-clock-posted fn2-ops) 1)
                (update-fn2-ops-clock-coalesced (fn2-saturating-inc60 (fn2-ops-clock-coalesced fn2-ops)) fn2-ops)
              fn2-ops))
           (fn2-ops (update-fn2-ops-clock-posted 1 fn2-ops)))
      (if (or (not valid) backward)
          (let* ((fn2-ops (update-fn2-ops-clock-rejected (fn2-saturating-inc60 (fn2-ops-clock-rejected fn2-ops)) fn2-ops))
                 (fn2-ops (update-fn2-ops-clock-flags (logior (fn2-ops-clock-flags fn2-ops) (if backward 4 8)) fn2-ops)))
            fn2-ops)
        (let* ((fn2-ops (update-fn2-ops-clock-mono mono fn2-ops))
               (fn2-ops (update-fn2-ops-clock-real real fn2-ops))
               (fn2-ops (update-fn2-ops-clock-seen 1 fn2-ops))
               (fn2-ops (update-fn2-ops-clock-flags (logior (logand 12 (fn2-ops-clock-flags fn2-ops)) flags) fn2-ops)))
          fn2-ops)))))

; Outstanding operations own action credit and two result cells before issue.
; Runtime APIs touch bounded scalar fields; only init resizes storage.
(in-package "ACL2")
(include-book "columns")
(include-book "owed")
(include-book "profile")

(defcolumns fn2-ops
  ((gen :u60)
   (phase (:enum fn2-op-phase (:free :reserved :queued :submitted :release-pending :done :retired)))
   (kind (:enum fn2-action (:accept :connect :receive :send :close :read :write :fence :cancel :tls-start :entropy :arm-wake :trace :service-posture)))
   (owner-kind :u8)
   (owner-slot :u32)
   (owner-gen :u60)
   (principal :u16)
   (range-slot :u32)
   (range-gen :u60)
   (range-off :u32)
   (range-len :u32)
   (cap-index :u32)
   (cap-nonce :u32)
   (storage-offset :u60)
   (fua :bool)
   (may-release :bool)
   (cancel-slot :u32)
   (cancel-gen :u60)
   (cancel-requested :bool)
   (c0-posted :bool)
   (c0-harvested :bool)
   (c0-event (:enum fn2-event (:accept-result :connect-result :receive-result :send-result :borrow-released :read-result :write-result :fence-result :cancel-result :close-result :tls-result :entropy-result)))
   (c0-outcome (:enum fn2-outcome (:done :short :failed :cancelled :not-found :not-cancellable)))
   (c0-reason (:enum fn2-reason (:none :exhausted :aborted :refused :unreachable :timed-out :reset :closed :pipe :io :no-space :handshake :uncertain)))
   (c0-count :u32)
   (c0-aux0 :u32)
   (c0-aux1 :u32)
   (c1-posted :bool)
   (c1-harvested :bool)
   (c1-event :u8)
   (c1-outcome :u8)
   (c1-reason :u8)
   (c1-count :u32)
   (c1-aux0 :u32)
   (c1-aux1 :u32)
   (next-free :u32)
   (wake-deadline :u60)
   (wake-observation-gen :u60))
  :rows-bound 4294967296
  :init-name fn2-ops-columns-init
  :extra-fields
  ((fn2-ops-out-slot :type (array (unsigned-byte 32) (0)) :initially 0 :resizable t)
   (fn2-ops-out-gen :type (array (unsigned-byte 60) (0)) :initially 0 :resizable t)
   (fn2-ops-posted-fifo :type (array (unsigned-byte 60) (0)) :initially 0 :resizable t)
   (fn2-ops-out-head :type (unsigned-byte 32) :initially 0)
   (fn2-ops-out-tail :type (unsigned-byte 32) :initially 0)
   (fn2-ops-queued :type (unsigned-byte 32) :initially 0)
   (fn2-ops-reserved-credits :type (unsigned-byte 32) :initially 0)
   (fn2-ops-post-head :type (unsigned-byte 60) :initially 0)
   (fn2-ops-post-tail :type (unsigned-byte 60) :initially 0)
   (fn2-ops-post-count :type (unsigned-byte 60) :initially 0)
   (fn2-ops-clock-posted :type (unsigned-byte 1) :initially 0)
   (fn2-ops-clock-seen :type (unsigned-byte 1) :initially 0)
   (fn2-ops-clock-mono :type (unsigned-byte 60) :initially 0)
   (fn2-ops-clock-real :type (unsigned-byte 60) :initially 0)
   (fn2-ops-clock-flags :type (unsigned-byte 8) :initially 0)
   (fn2-ops-clock-coalesced :type (unsigned-byte 60) :initially 0)
   (fn2-ops-clock-rejected :type (unsigned-byte 60) :initially 0)
   (fn2-ops-signals :type (unsigned-byte 8) :initially 0)
   (fn2-ops-stray :type (unsigned-byte 60) :initially 0)
   (fn2-ops-free-head :type (unsigned-byte 32) :initially 0)
   (fn2-ops-free-count :type (unsigned-byte 32) :initially 0)
   (fn2-ops-gen-limit :type (unsigned-byte 60) :initially 0)
   (fn2-ops-retired-count :type (unsigned-byte 32) :initially 0)))

(in-theory (disable fn2-profile-o fn2-profile-qa
                    fn2-profile-generation-start fn2-profile-generation-limit))

; Like fn2-pool-put: expansion-time lists, scalar writes at runtime.
(defun fn2-ops-put-bindings (fields)
  (if (consp fields)
      (cons `(fn2-ops
              (,(intern-in-package-of-symbol
                  (concatenate 'string "FN2-OPS-SET-" (symbol-name (caar fields)))
                  'fn2-ops)
               slot ,(cadar fields) fn2-ops))
            (fn2-ops-put-bindings (cdr fields)))
    nil))
(defmacro fn2-ops-put (&rest fields)
  `(let* ,(fn2-ops-put-bindings fields) fn2-ops))

; Shape facts only. Semantic invariants and lifecycle claims remain owed.
(defmacro fn2-ops-shape-lemmas (name args position)
  (let* ((call `(,name ,@args fn2-ops))
         (result (if position `(mv-nth ,position ,call) call)))
    `(progn
       (defthm ,(fn2-columns-sym name "-PRESERVES-TYPE")
         (implies (and (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops))
                  (fn2-opsp ,result)))
       (defthm ,(fn2-columns-sym name "-PRESERVES-WFP")
         (implies (and (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops))
                  (fn2-ops-wfp ,result)))
       (defthm ,(fn2-columns-sym name "-PRESERVES-ROWS")
         (equal (fn2-ops-rows ,result) (fn2-ops-rows fn2-ops)))
       (defthm ,(fn2-columns-sym name "-PRESERVES-RAW-ROWS")
         (equal (nth *fn2-ops-rows* ,result) (nth *fn2-ops-rows* fn2-ops))
         :hints (("Goal" :use ,(fn2-columns-sym name "-PRESERVES-ROWS")))))))

(defun fn2-op-slotp (slot fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (and (natp slot) (< slot (fn2-ops-rows fn2-ops))))
(defun fn2-op-handle-code (slot gen fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (cond ((not (fn2-op-slotp slot fn2-ops)) :bounds)
        ((not (equal gen (fn2-ops-gen slot fn2-ops))) :stale)
        (t :ok)))
(defun fn2-op-phase-code (slot gen phase fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (let ((code (fn2-op-handle-code slot gen fn2-ops)))
    (cond ((not (eq code :ok)) code)
          ((not (equal phase (fn2-ops-phase slot fn2-ops))) :state)
          (t :ok))))

(defun fn2-ops-clear-row (slot gen next fn2-ops)
  (declare (xargs :stobjs fn2-ops
                  :guard (and (fn2-ops-wfp fn2-ops) (natp slot)
                              (< slot (fn2-ops-rows fn2-ops))
                              (unsigned-byte-p 60 gen) (unsigned-byte-p 32 next))))
  (fn2-ops-put
    (gen gen)
    (phase 0)
    (kind 0)
    (owner-kind 0)
    (owner-slot 0)
    (owner-gen 0)
    (principal 0)
    (range-slot 0)
    (range-gen 0)
    (range-off 0)
    (range-len 0)
    (cap-index 0)
    (cap-nonce 0)
    (storage-offset 0)
    (fua 0)
    (may-release 0)
    (cancel-slot 0)
    (cancel-gen 0)
    (cancel-requested 0)
    (c0-posted 0)
    (c0-harvested 0)
    (c0-event 0)
    (c0-outcome 0)
    (c0-reason 0)
    (c0-count 0)
    (c0-aux0 0)
    (c0-aux1 0)
    (c1-posted 0)
    (c1-harvested 0)
    (c1-event 0)
    (c1-outcome 0)
    (c1-reason 0)
    (c1-count 0)
    (c1-aux0 0)
    (c1-aux1 0)
    (next-free next)
    (wake-deadline 0)
    (wake-observation-gen 0)))
(defthm fn2-ops-clear-row-type
  (implies (and (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops) (natp slot)
                (< slot (fn2-ops-rows fn2-ops))
                (unsigned-byte-p 60 gen) (unsigned-byte-p 32 next))
           (fn2-opsp (fn2-ops-clear-row slot gen next fn2-ops))))
(defthm fn2-ops-clear-row-wfp
  (implies (and (fn2-ops-wfp fn2-ops) (natp slot) (< slot (fn2-ops-rows fn2-ops)))
           (fn2-ops-wfp (fn2-ops-clear-row slot gen next fn2-ops))))
(defthm fn2-ops-clear-row-rows
  (equal (fn2-ops-rows (fn2-ops-clear-row slot gen next fn2-ops)) (fn2-ops-rows fn2-ops)))
(defthm fn2-ops-clear-row-raw-rows
  (equal (nth *fn2-ops-rows* (fn2-ops-clear-row slot gen next fn2-ops))
         (nth *fn2-ops-rows* fn2-ops))
  :hints (("Goal" :use fn2-ops-clear-row-rows)))
(in-theory (disable fn2-ops-clear-row))

(defun fn2-ops-init-rows (slot gen fn2-ops)
  (declare (xargs :stobjs fn2-ops
                  :measure (nfix (- (nfix (fn2-ops-rows fn2-ops)) (nfix slot)))
                  :guard (and (fn2-ops-wfp fn2-ops) (natp slot) (unsigned-byte-p 60 gen))))
  (if (or (not (natp slot)) (not (natp (fn2-ops-rows fn2-ops)))
          (>= slot (fn2-ops-rows fn2-ops))) fn2-ops
    (let ((fn2-ops (fn2-ops-clear-row slot gen
                    (if (< (+ 1 slot) (fn2-ops-rows fn2-ops)) (+ 1 slot) 4294967295)
                    fn2-ops)))
      (fn2-ops-init-rows (+ 1 slot) gen fn2-ops))))
(defthm fn2-ops-init-rows-type
  (implies (and (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops) (natp slot)
                (unsigned-byte-p 60 gen))
           (fn2-opsp (fn2-ops-init-rows slot gen fn2-ops))))
(defthm fn2-ops-init-rows-wfp
  (implies (fn2-ops-wfp fn2-ops) (fn2-ops-wfp (fn2-ops-init-rows slot gen fn2-ops))))
(defthm fn2-ops-init-rows-rows
  (equal (fn2-ops-rows (fn2-ops-init-rows slot gen fn2-ops)) (fn2-ops-rows fn2-ops)))
(defthm fn2-ops-init-rows-raw-rows
  (equal (nth *fn2-ops-rows* (fn2-ops-init-rows slot gen fn2-ops))
         (nth *fn2-ops-rows* fn2-ops))
  :hints (("Goal" :use fn2-ops-init-rows-rows)))
(in-theory (disable fn2-ops-init-rows))

(defthm fn2-profile-o-numeric-bound
  (implies (fn2-profilep profile) (< (fn2-profile-o profile) 4294967296))
  :rule-classes :linear
  :hints (("Goal" :use fn2-profile-o-bounds
           :in-theory (disable fn2-profile-o-bounds))))

(defun fn2-ops-init (profile fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-profilep profile)))
  (let* ((n (fn2-profile-o profile)) (qa (fn2-profile-qa profile))
         (start (fn2-profile-generation-start profile))
         (limit (fn2-profile-generation-limit profile))
         (fn2-ops (fn2-ops-columns-init n fn2-ops))
         (fn2-ops (resize-fn2-ops-out-slot qa fn2-ops))
         (fn2-ops (resize-fn2-ops-out-gen qa fn2-ops))
         (fn2-ops (resize-fn2-ops-posted-fifo (* 2 n) fn2-ops))
         (fn2-ops (update-fn2-ops-out-head 0 fn2-ops))
         (fn2-ops (update-fn2-ops-out-tail 0 fn2-ops))
         (fn2-ops (update-fn2-ops-queued 0 fn2-ops))
         (fn2-ops (update-fn2-ops-reserved-credits 0 fn2-ops))
         (fn2-ops (update-fn2-ops-post-head 0 fn2-ops))
         (fn2-ops (update-fn2-ops-post-tail 0 fn2-ops))
         (fn2-ops (update-fn2-ops-post-count 0 fn2-ops))
         (fn2-ops (update-fn2-ops-clock-posted 0 fn2-ops))
         (fn2-ops (update-fn2-ops-clock-seen 0 fn2-ops))
         (fn2-ops (update-fn2-ops-clock-mono 0 fn2-ops))
         (fn2-ops (update-fn2-ops-clock-real 0 fn2-ops))
         (fn2-ops (update-fn2-ops-clock-flags 0 fn2-ops))
         (fn2-ops (update-fn2-ops-clock-coalesced 0 fn2-ops))
         (fn2-ops (update-fn2-ops-clock-rejected 0 fn2-ops))
         (fn2-ops (update-fn2-ops-signals 0 fn2-ops))
         (fn2-ops (update-fn2-ops-stray 0 fn2-ops))
         (fn2-ops (update-fn2-ops-free-head (if (zp n) 4294967295 0) fn2-ops))
         (fn2-ops (update-fn2-ops-free-count n fn2-ops))
         (fn2-ops (update-fn2-ops-gen-limit limit fn2-ops))
         (fn2-ops (update-fn2-ops-retired-count 0 fn2-ops))
         (fn2-ops (fn2-ops-init-rows 0 start fn2-ops)))
    fn2-ops))
(defthm fn2-ops-init-type
  (implies (and (fn2-opsp fn2-ops) (fn2-profilep profile))
           (fn2-opsp (fn2-ops-init profile fn2-ops))))
(defthm fn2-ops-init-wfp
  (implies (fn2-profilep profile) (fn2-ops-wfp (fn2-ops-init profile fn2-ops))))
(in-theory (disable fn2-ops-init))

(defun fn2-op-reserve (kind okind oslot ogen principal may-release fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (let ((slot (fn2-ops-free-head fn2-ops))
        (free (fn2-ops-free-count fn2-ops))
        (reserved (fn2-ops-reserved-credits fn2-ops)))
    (cond ((not (and (natp kind) (< kind 14) (unsigned-byte-p 8 okind)
                     (unsigned-byte-p 32 oslot) (unsigned-byte-p 60 ogen)
                     (unsigned-byte-p 16 principal) (unsigned-byte-p 1 may-release)
                     (or (= may-release 0) (= kind *fn2-action-send*))))
           (mv :bounds 0 0 fn2-ops))
          ((or (zp free) (= slot 4294967295)
               (>= (+ reserved (fn2-ops-queued fn2-ops)) (fn2-ops-out-slot-length fn2-ops))
               (= reserved 4294967295))
           (mv :exhausted 0 0 fn2-ops))
          ((not (fn2-op-slotp slot fn2-ops)) (mv :bounds 0 0 fn2-ops))
          ((not (= (fn2-ops-phase slot fn2-ops) *fn2-op-phase-free*))
           (mv :state 0 0 fn2-ops))
          (t (let* ((gen (fn2-ops-gen slot fn2-ops))
                    (next (fn2-ops-next-free slot fn2-ops))
                    (fn2-ops (fn2-ops-clear-row slot gen 4294967295 fn2-ops))
                    (fn2-ops (fn2-ops-put (phase *fn2-op-phase-reserved*) (kind kind)
                                (owner-kind okind) (owner-slot oslot) (owner-gen ogen)
                                (principal principal) (may-release may-release)))
                    (fn2-ops (update-fn2-ops-free-head next fn2-ops))
                    (fn2-ops (update-fn2-ops-free-count (- free 1) fn2-ops))
                    (fn2-ops (update-fn2-ops-reserved-credits (+ reserved 1) fn2-ops)))
               (mv :ok slot gen fn2-ops))))))
(fn2-ops-shape-lemmas fn2-op-reserve (kind okind oslot ogen principal may-release) 3)
(in-theory (disable fn2-op-reserve))

(defun fn2-op-set-range (slot gen rslot rgen off len fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (let ((code (fn2-op-phase-code slot gen *fn2-op-phase-reserved* fn2-ops)))
    (cond ((not (eq code :ok)) (mv code fn2-ops))
          ((not (and (unsigned-byte-p 32 rslot) (unsigned-byte-p 60 rgen)
                     (unsigned-byte-p 32 off) (unsigned-byte-p 32 len))) (mv :bounds fn2-ops))
          (t (let ((fn2-ops (fn2-ops-put (range-slot rslot) (range-gen rgen)
                                         (range-off off) (range-len len))))
               (mv :ok fn2-ops))))))
(fn2-ops-shape-lemmas fn2-op-set-range (slot gen rslot rgen off len) 1)
(in-theory (disable fn2-op-set-range))
(defun fn2-op-set-capability (slot gen index nonce fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (let ((code (fn2-op-phase-code slot gen *fn2-op-phase-reserved* fn2-ops)))
    (cond ((not (eq code :ok)) (mv code fn2-ops))
          ((not (and (unsigned-byte-p 32 index) (unsigned-byte-p 32 nonce))) (mv :bounds fn2-ops))
          (t (let ((fn2-ops (fn2-ops-put (cap-index index) (cap-nonce nonce))))
               (mv :ok fn2-ops))))))
(fn2-ops-shape-lemmas fn2-op-set-capability (slot gen index nonce) 1)
(in-theory (disable fn2-op-set-capability))
(defun fn2-op-set-storage (slot gen offset fua fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (let ((code (fn2-op-phase-code slot gen *fn2-op-phase-reserved* fn2-ops)))
    (cond ((not (eq code :ok)) (mv code fn2-ops))
          ((not (and (unsigned-byte-p 60 offset) (unsigned-byte-p 1 fua))) (mv :bounds fn2-ops))
          (t (let ((fn2-ops (fn2-ops-put (storage-offset offset) (fua fua))))
               (mv :ok fn2-ops))))))
(fn2-ops-shape-lemmas fn2-op-set-storage (slot gen offset fua) 1)
(in-theory (disable fn2-op-set-storage))
(defun fn2-op-set-cancel-target (slot gen tslot tgen fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (let ((code (fn2-op-phase-code slot gen *fn2-op-phase-reserved* fn2-ops)))
    (cond ((not (eq code :ok)) (mv code fn2-ops))
          ((not (and (unsigned-byte-p 32 tslot) (unsigned-byte-p 60 tgen))) (mv :bounds fn2-ops))
          (t (let ((fn2-ops (fn2-ops-put (cancel-slot tslot) (cancel-gen tgen))))
               (mv :ok fn2-ops))))))
(fn2-ops-shape-lemmas fn2-op-set-cancel-target (slot gen tslot tgen) 1)
(in-theory (disable fn2-op-set-cancel-target))

 ; ArmWake payloads are independent of the op handle's reuse generation.
; The observation token identifies the clock view whose earliest deadline is
; being armed. Only reserved ArmWake descriptors may receive this payload.
(defun fn2-op-set-wake (slot gen deadline observation-gen fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (let ((code (fn2-op-phase-code slot gen *fn2-op-phase-reserved* fn2-ops)))
    (cond ((not (eq code :ok)) (mv code fn2-ops))
          ((not (= (fn2-ops-kind slot fn2-ops) *fn2-action-arm-wake*))
           (mv :state fn2-ops))
          ((not (and (unsigned-byte-p 60 deadline)
                     (unsigned-byte-p 60 observation-gen))) (mv :bounds fn2-ops))
          (t (let ((fn2-ops (fn2-ops-put (wake-deadline deadline)
                                         (wake-observation-gen observation-gen))))
               (mv :ok fn2-ops))))))
(fn2-ops-shape-lemmas fn2-op-set-wake (slot gen deadline observation-gen) 1)
(in-theory (disable fn2-op-set-wake))

; The caller checks phase. Both recycling paths erase old descriptor/result
; payloads; no posted, unharvested cell can be recycled by a valid lifecycle.
(defun fn2-op-recycle (slot fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (if (not (fn2-op-slotp slot fn2-ops)) (mv :bounds fn2-ops)
    (let ((gen (fn2-ops-gen slot fn2-ops))
          (limit (fn2-ops-gen-limit fn2-ops))
          (free (fn2-ops-free-count fn2-ops))
          (retired (fn2-ops-retired-count fn2-ops)))
      (cond ((>= gen limit)
             (if (= retired 4294967295) (mv :exhausted fn2-ops)
               (let* ((fn2-ops (fn2-ops-clear-row slot gen 4294967295 fn2-ops))
                      (fn2-ops (fn2-ops-put (phase *fn2-op-phase-retired*)))
                      (fn2-ops (update-fn2-ops-retired-count (+ 1 retired) fn2-ops)))
                 (mv :retired fn2-ops))))
            ((= free 4294967295) (mv :exhausted fn2-ops))
            (t (let* ((next (fn2-ops-free-head fn2-ops))
                      (fn2-ops (fn2-ops-clear-row slot (+ 1 gen) next fn2-ops))
                      (fn2-ops (update-fn2-ops-free-head slot fn2-ops))
                      (fn2-ops (update-fn2-ops-free-count (+ 1 free) fn2-ops)))
                 (mv :ok fn2-ops)))))))
(fn2-ops-shape-lemmas fn2-op-recycle (slot) 1)
(in-theory (disable fn2-op-recycle))

 ; A reservation has never escaped to the adapter. Undoing it restores its
; original generation and canonical free row; retirement belongs to finish.
(defun fn2-op-unreserve (slot gen fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (let ((code (fn2-op-phase-code slot gen *fn2-op-phase-reserved* fn2-ops))
        (reserved (fn2-ops-reserved-credits fn2-ops))
        (free (fn2-ops-free-count fn2-ops)))
    (cond ((not (eq code :ok)) (mv code fn2-ops))
          ((or (zp reserved) (= free 4294967295)) (mv :state fn2-ops))
          (t (let* ((next (fn2-ops-free-head fn2-ops))
                    (fn2-ops (fn2-ops-clear-row slot (fn2-ops-gen slot fn2-ops) next fn2-ops))
                    (fn2-ops (update-fn2-ops-free-head slot fn2-ops))
                    (fn2-ops (update-fn2-ops-free-count (+ 1 free) fn2-ops))
                    (fn2-ops (update-fn2-ops-reserved-credits (- reserved 1) fn2-ops)))
               (mv :ok fn2-ops))))))
(fn2-ops-shape-lemmas fn2-op-unreserve (slot gen) 1)
(in-theory (disable fn2-op-unreserve))

(defun fn2-ring-next (i capacity)
  (declare (xargs :guard (and (natp i) (natp capacity))))
  (if (< (+ i 1) capacity) (+ i 1) 0))
(defun fn2-op-enqueue (slot gen fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)))
  (let ((code (fn2-op-phase-code slot gen *fn2-op-phase-reserved* fn2-ops))
        (tail (fn2-ops-out-tail fn2-ops)) (reserved (fn2-ops-reserved-credits fn2-ops))
        (queued (fn2-ops-queued fn2-ops)) (capacity (fn2-ops-out-slot-length fn2-ops)))
    (cond ((not (eq code :ok)) (mv code fn2-ops))
          ((not (and (< tail capacity) (< tail (fn2-ops-out-gen-length fn2-ops))
                     (< queued capacity) (< queued 4294967295) (< 0 reserved)
                     (< capacity 4294967296))) (mv :state fn2-ops))
          (t (let* ((fn2-ops (update-fn2-ops-out-sloti tail slot fn2-ops))
                    (fn2-ops (update-fn2-ops-out-geni tail (fn2-ops-gen slot fn2-ops) fn2-ops))
                    (fn2-ops (update-fn2-ops-out-tail (fn2-ring-next tail capacity) fn2-ops))
                    (fn2-ops (update-fn2-ops-queued (+ 1 queued) fn2-ops))
                    (fn2-ops (update-fn2-ops-reserved-credits (- reserved 1) fn2-ops))
                    (fn2-ops (fn2-ops-put (phase *fn2-op-phase-queued*))))
               (mv :ok fn2-ops))))))
(fn2-ops-shape-lemmas fn2-op-enqueue (slot gen) 1)
(in-theory (disable fn2-op-enqueue))

(defun fn2-outbox-queued (fn2-ops)
  (declare (xargs :stobjs fn2-ops)) (fn2-ops-queued fn2-ops))
(defun fn2-ops-outbox-credits (fn2-ops)
  (declare (xargs :stobjs fn2-ops))

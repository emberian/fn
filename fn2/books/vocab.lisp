(defun fn2-outbox-submit-prefix (n fn2-ops)
  (declare (xargs :stobjs fn2-ops :measure (nfix n) :guard (and (natp n) (fn2-ops-wfp fn2-ops))))
  (let ((head (fn2-ops-out-head fn2-ops)) (queued (fn2-ops-queued fn2-ops))
        (capacity (fn2-ops-out-slot-length fn2-ops)))

(defun fn2-take-clock (fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (fn2-ops-wfp fn2-ops)
                  :guard-hints (("Goal" :in-theory (disable binary-logior binary-logand)))))
  (let* ((posted (= (fn2-ops-clock-posted fn2-ops) 1))
         (mono (fn2-ops-clock-mono fn2-ops)) (real (fn2-ops-clock-real fn2-ops))
         (flags (fn2-ops-clock-flags fn2-ops))
         (fn2-ops (update-fn2-ops-clock-posted 0 fn2-ops))

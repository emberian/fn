   ;; One bounded step of decision D: :more, :miss, or the answer :stored,
   ;; :duplicate (the accepted content), :evidence (the content is held only
   ;; as conflict evidence) or :conflict.
   (defun fn2-id-decide-step (d budget fn2-id-decides fn2-overlays fn2-overlay-index fn2-run-installed
                               fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-id-decides fn2-overlays fn2-overlay-index fn2-run-installed
                             fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool)
     :guard (and (fn2-ia-guard) (natp budget))))
    (b* (((unless (and (natp d) (< d (fn2-id-decides-rows fn2-id-decides))))
          (mv :bounds fn2-id-decides fn2-run-cursors fn2-run-paths fn2-fields))
         (phase (fn2-id-decides-phase d fn2-id-decides)))
     (cond
      ((equal phase *fn2-id-decide-phase-overlay*)
       (mv-let (code fn2-id-decides fn2-fields) (fn2-id-step-overlay d fn2-id-decides fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
        (mv (if (eq code :ok) :more code) fn2-id-decides fn2-run-cursors fn2-run-paths fn2-fields)))
      ((equal phase *fn2-id-decide-phase-run-start*)
       (mv-let (code fn2-id-decides fn2-run-cursors fn2-fields)
         (fn2-id-step-run-start d fn2-id-decides fn2-run-installed fn2-run-cursors fn2-run-cache fn2-fields fn2-pool)
        (mv (if (eq code :ok) :more code) fn2-id-decides fn2-run-cursors fn2-run-paths fn2-fields)))
      ((equal phase *fn2-id-decide-phase-run-scan*)
       (fn2-id-step-run-scan d budget fn2-id-decides fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool))
      ((equal phase *fn2-id-decide-phase-done*)
       (mv (cond ((equal (fn2-id-decides-exact d fn2-id-decides) 1) :duplicate)
                 ((equal (fn2-id-decides-exact d fn2-id-decides) 2) :evidence)
                 ((< 0 (fn2-id-decides-others d fn2-id-decides)) :conflict)
                 (t :stored))
           fn2-id-decides fn2-run-cursors fn2-run-paths fn2-fields))
      (t (mv :state fn2-id-decides fn2-run-cursors fn2-run-paths fn2-fields)))))

   ;; Record a finished decision's offer in overlay O: a stored offer as the
   ;; accepted content, a conflicting one as evidence while the Message-ID
   ;; holds fewer than the bound; :duplicate records nothing. A decision
   ;; whose bucket's stamp or the identity version moved since it started is
   ;; :stale before anything else (its verdict, refusals included, may be
   ;; wrong: decide again); :evidence records nothing either. EBASE is
   ;; scratch for the entry. The offer's octets are the rows at SBASE
   ;; (Message-ID, content), readable under the overlay's owner (they are
   ;; copied into its arena): the decision's own offer rows (fn2-id-record),
   ;; or the successor's copies of them (C-S3's bind).
   (defun fn2-id-record-insert (d o ebase sbase article binding principal fn2-id-decides fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-id-decides fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
     :guard (and (fn2-id-decides-wfp fn2-id-decides) (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index)
                 (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))
     :guard-hints (("Goal" :in-theory (disable fn2-run-copy-row fn2-ov-insert fn2-fields-rows)))))
    (b* (((unless (and (natp d) (< d (fn2-id-decides-rows fn2-id-decides)) (natp o) (< o (fn2-overlays-rows fn2-overlays))
                       (natp ebase) (<= (+ ebase *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields))
                       (natp sbase) (< (+ sbase 1) (fn2-fields-rows fn2-fields))
                       (unsigned-byte-p 60 article) (unsigned-byte-p 60 binding) (unsigned-byte-p 60 principal)))
          (mv :bounds fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         (others (fn2-id-decides-others d fn2-id-decides))
         (fn2-fields (fn2-run-copy-row (+ sbase *fn2-id-mid*) (+ ebase *fn2-id-mid*) fn2-fields))
         (fn2-fields (fn2-run-copy-row (+ sbase *fn2-id-con*) (+ ebase *fn2-id-con*) fn2-fields))
         (fn2-fields (fn2-fields-set-value (+ ebase *fn2-identity-entry-field-state*)
                                           (if (zp others) *fn2-identity-state-accepted* *fn2-identity-state-conflict*) fn2-fields))
         (fn2-fields (fn2-fields-set-value (+ ebase *fn2-identity-entry-field-article*) article fn2-fields))
         (fn2-fields (fn2-fields-set-value (+ ebase *fn2-identity-entry-field-binding*) binding fn2-fields))
         (fn2-fields (fn2-fields-set-value (+ ebase *fn2-identity-entry-field-principal*) principal fn2-fields)))
     (fn2-ov-insert o ebase (fn2-id-decides-eb d fn2-id-decides) fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
   (in-theory (disable fn2-id-record-insert))
   (defun fn2-id-record (d o ebase article binding principal fn2-id-decides fn2-id-stamps fn2-run-installed fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-id-decides fn2-id-stamps fn2-run-installed fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
     :guard (and (fn2-id-decides-wfp fn2-id-decides) (fn2-id-stamps-wfp fn2-id-stamps) (fn2-run-installed-wfp fn2-run-installed) (fn2-overlays-wfp fn2-overlays)
                 (fn2-overlay-index-wfp fn2-overlay-index) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
    (b* (((unless (and (natp d) (< d (fn2-id-decides-rows fn2-id-decides))))
          (mv :bounds fn2-id-stamps fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((unless (equal (fn2-id-decides-phase d fn2-id-decides) *fn2-id-decide-phase-done*))
          (mv :state fn2-id-stamps fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         (bucket (fn2-id-decides-bucket d fn2-id-decides))
         ((unless (and (natp bucket) (< bucket (fn2-id-stamps-rows fn2-id-stamps)))) (mv :bounds fn2-id-stamps fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         (stamp (fn2-id-stamps-gen bucket fn2-id-stamps))
         ((unless (and (equal stamp (fn2-id-decides-stamp d fn2-id-decides))
                       (equal (fn2-run-version 1 (fn2-run-installed-rows fn2-run-installed) fn2-run-installed)
                              (fn2-id-decides-vrun d fn2-id-decides))))
          (mv :stale fn2-id-stamps fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((when (equal (fn2-id-decides-exact d fn2-id-decides) 1)) (mv :duplicate fn2-id-stamps fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((when (equal (fn2-id-decides-exact d fn2-id-decides) 2)) (mv :evidence fn2-id-stamps fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((unless (< (fn2-id-decides-others d fn2-id-decides) *fn2-identity-contents-max*))
          (mv :identity-conflict-bound fn2-id-stamps fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((unless (unsigned-byte-p 60 (+ 1 (nfix stamp)))) (mv :bounds fn2-id-stamps fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((unless (and (natp o) (< o (fn2-overlays-rows fn2-overlays))
                       (equal (fn2-id-decides-qk d fn2-id-decides) (fn2-overlays-okind o fn2-overlays))
                       (equal (fn2-id-decides-qs d fn2-id-decides) (fn2-overlays-oslot o fn2-overlays))
                       (equal (fn2-id-decides-qg d fn2-id-decides) (fn2-overlays-ogen o fn2-overlays))))
          (mv :owner fn2-id-stamps fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((mv code fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
          (fn2-id-record-insert d o ebase (fn2-id-decides-qbase d fn2-id-decides) article binding principal
                                fn2-id-decides fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv code fn2-id-stamps fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         (fn2-id-stamps (fn2-id-stamps-set-gen bucket (+ 1 (nfix stamp)) fn2-id-stamps)))
     (mv :ok fn2-id-stamps fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
   (in-theory (disable fn2-id-decide-step fn2-id-record))
   (assert-event (fn2-assert-compliant-p '(fn2-id-decide-start fn2-id-decide-step fn2-id-record) (w state)))
   (fn2-identity-adapters)))

; ---------------------------------------------------------------------------
; Logic adapters (lists in, lists out; never served) and the keystones.
; One node: offers are staged in a workspace of the engine's owner, decided
; and recorded in order through the real decision and recording; every
; SPLIT offers the overlay is sealed into a run through the real build and
; installed. Then the staging workspace is released (the bodies are gone)
; and the queries are decided against overlays and runs alone. FORGET makes
; a node that refuses a conflicting offer and records nothing.
(defconst *fn2-ida-stobjs*
 '(fn2-id-decides fn2-overlays fn2-overlay-index fn2-run-installed fn2-run-builds fn2-run-cursors fn2-run-paths
   fn2-run-cache fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests
   fn2-ribbon-builds fn2-ribbon-band fn2-id-stamps))
(defconst *fn2-ida-offer-layout* '((message-id (:octets 250)) (content :digest)))
; Field plan: the offer at 1400, its lower bound at 1500, overlay scratch at
; 1600, the entry being recorded at 1700, the filter writer's rows from 1800;
; the run adapter's rows below 1400. Writer row 6 writes filter pages (the
; build's six levels use 0-5); digest row 142 takes a filter's hash.
(defconst *fn2-ida-q* 1400)
(defconst *fn2-ida-lbq* 1500)
(defconst *fn2-ida-eb* 1600)
(defconst *fn2-ida-e* 1700)
(defconst *fn2-ida-fw* 1800)
(defmacro fn2-ida-defun (name args &rest r)
 (let* ((measure (and (eq (car r) :measure) (cadr r))) (body (if measure (caddr r) (car r))))
  `(defun ,name ,(append args *fn2-ida-stobjs*)
    (declare (xargs :stobjs ,*fn2-ida-stobjs* :verify-guards nil ,@(and measure `(:measure ,measure))))
    ,body)))
(defmacro fn2-ida-mv (&rest values) `(mv ,@values ,@*fn2-ida-stobjs*))
(defmacro fn2-ida-call (name &rest args) `(,name ,@args ,@*fn2-ida-stobjs*))
(defmacro fn2-ida-local (name &rest args) `(fn2-run-with-local ,*fn2-ida-stobjs* (,name ,@args ,@*fn2-ida-stobjs*)))

(defmacro fn2-identity-adapters ()
 '(progn
   (fn2-ida-defun fn2-ida-setup ()
    (b* ((fn2-id-decides (fn2-id-decides-init 1 fn2-id-decides))
         (fn2-overlays (fn2-overlays-init 1 fn2-overlays))
         (fn2-overlay-index (fn2-overlay-index-init 256 fn2-overlay-index))
         (fn2-run-installed (fn2-run-installed-init 16 fn2-run-installed))
         (fn2-run-builds (fn2-run-builds-init 1 fn2-run-builds))
         (fn2-run-cursors (fn2-run-cursors-init 1 fn2-run-cursors))
         (fn2-run-paths (fn2-run-paths-init *fn2-run-max-levels* fn2-run-paths))
         (fn2-run-cache (fn2-run-cache-init 1024 fn2-run-cache))
         (fn2-run-writers (fn2-run-writers-init (+ 1 *fn2-run-max-levels*) fn2-run-writers))
         (fn2-run-restarts (fn2-run-restarts-init (* (+ 1 *fn2-run-max-levels*) *fn2-run-restart-capacity*) fn2-run-restarts))
         (fn2-fields (fn2-fields-init 2000 fn2-fields))
         (fn2-ribbon-builds (fn2-ribbon-builds-init 1 fn2-ribbon-builds))
         (fn2-ribbon-band (fn2-ribbon-band-init (fn2-ribbon-slots 256) fn2-ribbon-band))
         (fn2-id-stamps (fn2-id-stamps-init 64 fn2-id-stamps))
         (fn2-pool (fn2-pool-init '((600 . 65536)) 1 100 fn2-pool))
         (fn2-fc (fn2-fc-init 1 fn2-fc))
         (fn2-fc-context (fn2-fc-context-init 1 fn2-fc-context))
         (fn2-b3 (fn2-b3-table-init 1 fn2-b3))

               ((unless (unsigned-byte-p 32 skips)) (mv :bounds fn2-id-decides fn2-run-cursors fn2-fields))
               (fn2-id-decides (fn2-id-decides-set-skips d skips fn2-id-decides))
               ((mv code fn2-id-decides) (fn2-id-decide-fold d *fn2-id-decide-phase-run-start* (+ 1 r) nil 0 fn2-id-decides)))
           (mv code fn2-id-decides fn2-run-cursors fn2-fields)))

; Layer C: exact Message-ID identity (C2). Identity is a Binding (UC §4.3,
; decision 3): Message-ID -> finite set of content identities, merged by
; union. The key holds the exact Message-ID octets and the content identity,
; so one Message-ID's facts are adjacent; state says whether a fact is the
; accepted content or recorded conflict evidence. Exact octets are kept
; permanently (STORAGE §4 decision 6); a filter may reject, never decide:
; a run whose Ribbon filter answers :absent for the Message-ID is skipped.
; This book declares the schema and the specification; the decision and the
; recording, which read entries through the run assembly's dispatcher, are
; generated by FN2-IDENTITY-ASSEMBLE after it.
(in-package "ACL2")
(include-book "runs-assemble")
(include-book "ribbon")
(fn2-book-layer :c)

(defrunschema fn2-identity :id 1
 :key ((message-id (:octets 250)) (content :digest))
 :value ((state (:enum fn2-identity-state (:accepted :conflict)))
         (article (:id article)) (binding (:id event)) (principal (:id principal)))
 :merge :union)

; At most this many distinct contents are retained per Message-ID (the
; accepted one and its conflict evidence); a further conflicting offer is
; refused :identity-conflict-bound and recorded nowhere. A profile parameter.
(defconst *fn2-identity-contents-max* 4)

; ---------------------------------------------------------------------------
; Specification. An offer is (message-id-octets content-digest-octets); a
; fact is an offer that was recorded, with its state.
(defun fn2-id-mid (x) (declare (xargs :verify-guards nil)) (car x))
(defun fn2-id-content (x) (declare (xargs :verify-guards nil)) (cadr x))
(defun fn2-id-state (x) (declare (xargs :verify-guards nil)) (caddr x))
; (exact others): the state of (mid, c) when it is recorded (:accepted or
; :conflict, the latter evidence only), else nil; and how many other
; contents of mid are recorded.
(defun fn2-id-block-spec (facts mid c)
 (declare (xargs :verify-guards nil))
 (if (atom facts) (list nil 0)
  (let ((rest (fn2-id-block-spec (cdr facts) mid c)))
   (cond ((not (equal (fn2-id-mid (car facts)) mid)) rest)
         ((equal (fn2-id-content (car facts)) c) (list (or (fn2-id-state (car facts)) :accepted) (cadr rest)))
         (t (list (car rest) (+ 1 (cadr rest))))))))
(defun fn2-id-decide-spec (facts mid c)
 (declare (xargs :verify-guards nil))
 (let ((b (fn2-id-block-spec facts mid c)))
  (cond ((eq (car b) :conflict) :evidence) ((car b) :duplicate) ((< 0 (cadr b)) :conflict) (t :stored))))
; Offers processed in order: a stored content is recorded as the accepted
; one, a conflicting content as evidence while the Message-ID holds fewer
; than the bound. Re-offering accepted content is :duplicate; re-offering
; content held only as evidence is :evidence (never "already stored").
(defun fn2-id-record-spec (offers facts)
 (declare (xargs :verify-guards nil))
 (if (atom offers) facts
  (let* ((o (car offers)) (mid (fn2-id-mid o)) (c (fn2-id-content o))
         (d (fn2-id-decide-spec facts mid c))
         (facts (if (or (eq d :stored)
                        (and (eq d :conflict) (< (cadr (fn2-id-block-spec facts mid c)) *fn2-identity-contents-max*)))
                    (cons (list mid c (if (eq d :stored) :accepted :conflict)) facts) facts)))
   (fn2-id-record-spec (cdr offers) facts))))
(defun fn2-id-answers-over (facts queries)
 (declare (xargs :verify-guards nil))
 (if (atom queries) nil
  (cons (fn2-id-decide-spec facts (fn2-id-mid (car queries)) (fn2-id-content (car queries)))
        (fn2-id-answers-over facts (cdr queries)))))
(defun fn2-id-answers-spec (offers queries)
 (declare (xargs :verify-guards nil))
 (let ((facts (fn2-id-record-spec offers nil)))
  (fn2-id-answers-over facts queries)))
; Well-formed offers: Message-ID octets of at most 250 bytes, 32-byte
; content identities.
(defun fn2-id-bytesp (x)
 (declare (xargs :verify-guards nil))
 (if (atom x) (null x) (and (unsigned-byte-p 8 (car x)) (fn2-id-bytesp (cdr x)))))
(defun fn2-id-octetsp (x n)
 (declare (xargs :verify-guards nil))
 (and (fn2-id-bytesp x) (<= (len x) n)))
(defun fn2-id-offersp (offers)
 (declare (xargs :verify-guards nil))
 (if (atom offers) (null offers)
  (and (true-listp (car offers)) (equal (len (car offers)) 2)
       (fn2-id-octetsp (fn2-id-mid (car offers)) 250)
       (fn2-id-octetsp (fn2-id-content (car offers)) 32) (equal (len (fn2-id-content (car offers))) 32)
       (fn2-id-offersp (cdr offers)))))
; The Binding as a value: its facts' keys, sorted and without repeats.
(defun fn2-id-key< (a b)
 (declare (xargs :verify-guards nil))
 (eq (fn2-run-key-order-spec '((message-id (:octets 250)) (content (:octets 32)))
                             (list (fn2-id-mid a) (fn2-id-content a)) (list (fn2-id-mid b) (fn2-id-content b)))
     :lt))
(defun fn2-id-insert-key (k ks)
 (declare (xargs :verify-guards nil))
 (cond ((atom ks) (list k))
       ((equal k (car ks)) ks)
       ((fn2-id-key< (car ks) k) (cons (car ks) (fn2-id-insert-key k (cdr ks))))
       (t (cons k ks))))
(defun fn2-id-binding-spec (facts)
 (declare (xargs :verify-guards nil))
 (if (atom facts) nil
  (fn2-id-insert-key (list (fn2-id-mid (car facts)) (fn2-id-content (car facts))) (fn2-id-binding-spec (cdr facts)))))
(defun fn2-id-mid-count (mid keys)
 (declare (xargs :verify-guards nil))
 (cond ((atom keys) 0) ((equal (fn2-id-mid (car keys)) mid) (+ 1 (fn2-id-mid-count mid (cdr keys))))
       (t (fn2-id-mid-count mid (cdr keys)))))
(defun fn2-id-within-bound-over (ks keys)
 (declare (xargs :verify-guards nil))
 (or (atom ks)
     (and (<= (fn2-id-mid-count (fn2-id-mid (car ks)) keys) *fn2-identity-contents-max*)
          (fn2-id-within-bound-over (cdr ks) keys))))
; Within the bound: no Message-ID is offered with more distinct contents
; than the bound retains.
(defun fn2-id-within-bound (offers)
 (declare (xargs :verify-guards nil))
 (fn2-id-within-bound-over (fn2-id-binding-spec offers) (fn2-id-binding-spec offers)))

; ---------------------------------------------------------------------------
; The decision and the recording (generated after the run assembly).
; A decision row D holds one in-flight decision for the offer whose
; Message-ID and content are field rows QBASE (+0, +1), readable under the
; owner QK QS QG. It visits every readable identity overlay (active or
; frozen; a batch's private successor is invisible), then every installed
; identity run, positioned at the lower bound LBQ = (Message-ID, empty
; content), and reads that Message-ID's block: EXACT is 1 when (mid, c) is
; recorded as the accepted content, 2 when only as evidence, else 0; OTHERS
; the number of other contents. A run with a filter is
; probed first and skipped when the filter answers :absent (SKIPS counts
; those, READS the runs read). Each step is bounded; :more resumes; :miss
; asks the caller to load the page the cursor names, :filter-miss the
; filter page of the installed run SRC names. A done decision whose fact a
; transaction bound into its batch's private successor (C-S3) is :held until
; the transaction is released: no offer restarts it.
(defcolumns fn2-id-decides
 ((phase (:enum fn2-id-decide-phase (:idle :overlay :run-start :run-scan :done :held)))
  (src :u32) (qbase :u32) (lbq :u32) (eb :u32) (cursor :u32) (rb :u32)
  (qk :u8) (qs :u32) (qg :u60) (exact :u8) (others :u32) (rexact :u8) (rothers :u32) (seen :u32)
  (reads :u32) (skips :u32) (bucket :u32) (stamp :u60) (vrun :u60)))


(defconst *fn2-id-mid* *fn2-identity-entry-field-message-id*)
(defconst *fn2-id-con* *fn2-identity-entry-field-content*)
; Entries read per block before the block is cut short: the bound retains at
; most *fn2-identity-contents-max* contents, so more is corruption or a
; peer's surplus, and the count saturates.
(defconst *fn2-id-block-max* (+ 2 *fn2-identity-contents-max*))

; Identity stamps. A Message-ID's bucket (its octets' hash modulo the rows)
; counts the facts recorded for the Message-IDs in it. A decision takes its
; bucket's stamp at start; a record refuses :stale when the stamp moved, so
; no fact is recorded around one recorded for its Message-ID after the
; decision passed the overlay that took it. A fact that moves from a frozen
; overlay into a run cannot be missed: overlays are visited before runs and
; an overlay is retired only after its run is installed. A bucket shared
; with a busy Message-ID costs a retry, never a wrong answer.
(defcolumns fn2-id-stamps ((gen :u60)))
; The identity version is fn2-run-version of schema 1 (runs.lisp): it moves
; whenever facts move from an overlay into a new run; a record refuses
; :stale when it moved since its decision started.
(defun fn2-id-bucket (qbase qk qs qg fn2-id-stamps fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-id-stamps fn2-fields fn2-pool)
  :guard (and (fn2-id-stamps-wfp fn2-id-stamps) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* ((rows (fn2-id-stamps-rows fn2-id-stamps))
      ((unless (and (natp qbase) (< (+ qbase *fn2-id-mid*) (fn2-fields-rows fn2-fields)) (posp rows)))
       (mv :bounds 0))
      (row (+ qbase *fn2-id-mid*))
      (len (fn2-fields-ref-len row fn2-fields)) (off (fn2-fields-ref-off row fn2-fields))
      ((unless (and (natp len) (<= len *fn2-run-key-octets-max*) (natp off))) (mv :bounds 0))
      ((mv code h1 &) (fn2-ribbon-hash len (fn2-fields-ref-slot row fn2-fields) (fn2-fields-ref-gen row fn2-fields) off 0 qk qs qg fn2-pool)))
  (mv code (mod h1 rows))))

; LBQ := (Message-ID of QBASE, the empty content): every key of that
; Message-ID is at or above it.
(defun fn2-id-lower-query (qbase lbq fn2-fields)
 (declare (xargs :stobjs fn2-fields :guard (fn2-fields-wfp fn2-fields)
  :guard-hints (("Goal" :in-theory (disable fn2-run-copy-row)))))
 (b* (((unless (and (natp qbase) (natp lbq) (< (+ qbase 1) (fn2-fields-rows fn2-fields))
                    (< (+ lbq 1) (fn2-fields-rows fn2-fields))))
       (mv :bounds fn2-fields))
      (fn2-fields (fn2-run-copy-row (+ qbase *fn2-id-mid*) (+ lbq *fn2-id-mid*) fn2-fields))
      (fn2-fields (fn2-run-copy-row (+ qbase *fn2-id-mid*) (+ lbq *fn2-id-con*) fn2-fields))
      (fn2-fields (fn2-fields-set-ref-len (+ lbq *fn2-id-con*) 0 fn2-fields)))
  (mv :ok fn2-fields)))
(fn2-fields-preserves fn2-id-lower-query (qbase lbq fn2-fields) :position 1)

; How a decoded entry at EB (read under EK ES EG) stands to the offer at
; QBASE: :other-mid (outside the block), :exact (the accepted content),
; :evidence (the same content held as conflict evidence), or :other.
(defun fn2-id-classify (eb ek es eg qbase qk qs qg fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool)
  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (natp eb) (natp qbase) (< (+ eb 1) (fn2-fields-rows fn2-fields))
                    (< (+ qbase 1) (fn2-fields-rows fn2-fields))))
       (mv :bounds :other-mid))
      ((mv code order) (fn2-run-octets-field-compare (+ eb *fn2-id-mid*) (+ qbase *fn2-id-mid*) ek es eg qk qs qg fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code :other-mid))
      ((unless (eq order :eq)) (mv :ok :other-mid))
      ((mv code order) (fn2-run-octets-field-compare (+ eb *fn2-id-con*) (+ qbase *fn2-id-con*) ek es eg qk qs qg fn2-fields fn2-pool)))
  (cond ((not (eq order :eq)) (mv code :other))
        ((not (< (+ eb *fn2-identity-entry-field-state*) (fn2-fields-rows fn2-fields))) (mv :bounds :other-mid))
        ((equal (fn2-fields-value (+ eb *fn2-identity-entry-field-state*) fn2-fields) *fn2-identity-state-conflict*)
         (mv code :evidence))
        (t (mv code :exact)))))

;; The next source a decision reads, skipping in one step the rows that are
;; not its: the first readable identity overlay at or after O (active or
;; frozen; free rows and private successors are not), and the first live
;; identity run at or after R; past the last, the table's row count. K bounds
;; the rows looked at (the caller passes the row count).
(defun fn2-id-next-overlay (k o fn2-overlays)
 (declare (xargs :stobjs fn2-overlays :measure (nfix k) :guard (and (fn2-overlays-wfp fn2-overlays) (natp k))))
 (cond ((not (and (natp o) (< o (fn2-overlays-rows fn2-overlays)) (posp k))) (nfix (fn2-overlays-rows fn2-overlays)))
       ((and (equal (fn2-overlays-schema o fn2-overlays) 1)
             (member (fn2-overlays-phase o fn2-overlays) (list *fn2-overlay-phase-active* *fn2-overlay-phase-frozen*)))
        o)
       (t (fn2-id-next-overlay (- k 1) (+ 1 o) fn2-overlays))))
(defthm fn2-id-next-overlay-natp (natp (fn2-id-next-overlay k o fn2-overlays)) :rule-classes :type-prescription)
(defun fn2-id-next-run (k r fn2-run-installed)
 (declare (xargs :stobjs fn2-run-installed :measure (nfix k) :guard (and (fn2-run-installed-wfp fn2-run-installed) (natp k))))
 (cond ((not (and (natp r) (< r (fn2-run-installed-rows fn2-run-installed)) (posp k))) (nfix (fn2-run-installed-rows fn2-run-installed)))
       ((and (equal (fn2-run-installed-state r fn2-run-installed) *fn2-run-installed-state-live*)
             (equal (fn2-run-installed-schema r fn2-run-installed) 1))
        r)
       (t (fn2-id-next-run (- k 1) (+ 1 r) fn2-run-installed))))
(defthm fn2-id-next-run-natp (natp (fn2-id-next-run k r fn2-run-installed)) :rule-classes :type-prescription)

; Fold inside a function that returns (mv code fn2-id-decides fn2-fields).
(defmacro fn2-id-decide-fold* (d phase src exact others)
 `(mv-let (code fn2-id-decides) (fn2-id-decide-fold ,d ,phase ,src ,exact ,others fn2-id-decides)
   (mv code fn2-id-decides fn2-fields)))
(defmacro fn2-ia-guard ()
 '(and (fn2-id-decides-wfp fn2-id-decides) (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index)
       (fn2-run-installed-wfp fn2-run-installed) (fn2-run-cursors-wfp fn2-run-cursors) (fn2-run-paths-wfp fn2-run-paths)
       (fn2-run-cache-wfp fn2-run-cache) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)))

(defmacro fn2-identity-assemble ()
 '(encapsulate ()
   (fn2-run-assembly-theory)
   ;; Walk an overlay's block from position I: at most N entries.
   (defun fn2-id-overlay-walk (n o i eb qbase qk qs qg exact others fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-overlays fn2-overlay-index fn2-fields fn2-pool) :measure (nfix n)
     :guard (and (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index)
                 (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (natp n) (natp i) (natp others))
     :guard-hints (("Goal" :in-theory (disable fn2-id-classify fn2-fields-rows)))))
    (b* (((when (zp n)) (mv :ok exact others fn2-fields))
         ((unless (and (natp o) (< o (fn2-overlays-rows fn2-overlays)))) (mv :bounds exact others fn2-fields))
         ((unless (< i (fn2-overlays-count o fn2-overlays))) (mv :ok exact others fn2-fields))
         ((mv code & fn2-fields) (fn2-ov-entry o i eb fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv code exact others fn2-fields))
         ((mv code class) (fn2-id-classify eb (fn2-overlays-okind o fn2-overlays) (fn2-overlays-oslot o fn2-overlays)
                                           (fn2-overlays-ogen o fn2-overlays) qbase qk qs qg fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv code exact others fn2-fields)))
     (case class
      (:other-mid (mv :ok exact others fn2-fields))
      (:exact (fn2-id-overlay-walk (- n 1) o (+ 1 i) eb qbase qk qs qg 1 others fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (:evidence (fn2-id-overlay-walk (- n 1) o (+ 1 i) eb qbase qk qs qg 2 others fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (otherwise (fn2-id-overlay-walk (- n 1) o (+ 1 i) eb qbase qk qs qg exact (+ 1 others) fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))))
   (fn2-fc-shape fn2-id-overlay-walk-shape
    (fn2-id-overlay-walk n o i eb qbase qk qs qg exact others fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
    (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)) ((fn2-fields 3)))
   (defthm fn2-id-overlay-walk-natp
    (implies (natp others) (natp (mv-nth 2 (fn2-id-overlay-walk n o i eb qbase qk qs qg exact others fn2-overlays fn2-overlay-index fn2-fields fn2-pool))))
    :rule-classes :type-prescription)
   (in-theory (disable fn2-id-overlay-walk))
   (defun fn2-id-overlay-block (o eb lbq qbase qk qs qg fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
     :guard (and (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index)
                 (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
    (b* (((mv code pos & fn2-fields) (fn2-ov-locate o eb lbq qk qs qg fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv code nil 0 fn2-fields)))
     (fn2-id-overlay-walk *fn2-id-block-max* o pos eb qbase qk qs qg nil 0 fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
   (fn2-fc-shape fn2-id-overlay-block-shape (fn2-id-overlay-block o eb lbq qbase qk qs qg fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
    (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)) ((fn2-fields 3)))
   (defthm fn2-id-overlay-block-natp
    (natp (mv-nth 2 (fn2-id-overlay-block o eb lbq qbase qk qs qg fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
    :rule-classes :type-prescription)
   (in-theory (disable fn2-id-overlay-block))

   ;; Start a decision.
   (defun fn2-id-decide-start (d qbase lbq eb cursor rb qk qs qg fn2-id-decides fn2-id-stamps fn2-run-installed fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-id-decides fn2-id-stamps fn2-run-installed fn2-fields fn2-pool)
     :guard (and (fn2-id-decides-wfp fn2-id-decides) (fn2-id-stamps-wfp fn2-id-stamps) (fn2-run-installed-wfp fn2-run-installed)
                 (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))
     :guard-hints (("Goal" :in-theory (disable fn2-id-lower-query fn2-id-bucket)))))
    (b* (((unless (and (natp d) (< d (fn2-id-decides-rows fn2-id-decides))
                       (unsigned-byte-p 32 qbase) (unsigned-byte-p 32 lbq) (unsigned-byte-p 32 eb)
                       (unsigned-byte-p 32 cursor) (unsigned-byte-p 32 rb)
                       (unsigned-byte-p 8 qk) (unsigned-byte-p 32 qs) (unsigned-byte-p 60 qg)))
          (mv :bounds fn2-id-decides fn2-fields))
         ((mv code bucket) (fn2-id-bucket qbase qk qs qg fn2-id-stamps fn2-fields fn2-pool))
         ((unless (and (eq code :ok) (natp bucket) (< bucket (fn2-id-stamps-rows fn2-id-stamps)) (unsigned-byte-p 32 bucket)))
          (mv (if (eq code :ok) :bounds code) fn2-id-decides fn2-fields))
         (stamp (fn2-id-stamps-gen bucket fn2-id-stamps))
         ((unless (unsigned-byte-p 60 stamp)) (mv :bounds fn2-id-decides fn2-fields))
         (vrun (fn2-run-version 1 (fn2-run-installed-rows fn2-run-installed) fn2-run-installed))
         ((unless (unsigned-byte-p 60 vrun)) (mv :bounds fn2-id-decides fn2-fields))
         ((mv code fn2-fields) (fn2-id-lower-query qbase lbq fn2-fields))
         ((unless (eq code :ok)) (mv code fn2-id-decides fn2-fields))
         (fn2-id-decides (fn2-id-decides-put d (phase *fn2-id-decide-phase-overlay*) (src 0) (qbase qbase) (lbq lbq) (eb eb)
                           (cursor cursor) (rb rb) (qk qk) (qs qs) (qg qg) (exact 0) (others 0) (rexact 0) (rothers 0) (seen 0)
                           (reads 0) (skips 0) (bucket bucket) (stamp stamp) (vrun vrun))))
     (mv :ok fn2-id-decides fn2-fields)))

   ;; Fold a block's counts into the decision and move to source SRC.
   (defun fn2-id-decide-fold (d phase src exact others fn2-id-decides)
    (declare (xargs :stobjs fn2-id-decides :guard (fn2-id-decides-wfp fn2-id-decides)))
    (b* (((unless (and (natp d) (< d (fn2-id-decides-rows fn2-id-decides)))) (mv :bounds fn2-id-decides))
         (e (cond ((equal exact 1) 1) ((equal exact 2) 2) (t (fn2-id-decides-exact d fn2-id-decides))))
         (o (min 4294967295 (+ (nfix others) (fn2-id-decides-others d fn2-id-decides))))
         ((unless (and (natp phase) (< phase *fn2-id-decide-phase-count*) (unsigned-byte-p 32 src))) (mv :bounds fn2-id-decides))
         (fn2-id-decides (fn2-id-decides-put d (phase phase) (src src) (exact e) (others o) (rexact 0) (rothers 0) (seen 0))))
     (mv :ok fn2-id-decides)))

   (defun fn2-id-step-overlay (d fn2-id-decides fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-id-decides fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
     :guard (and (fn2-id-decides-wfp fn2-id-decides) (fn2-overlays-wfp fn2-overlays) (fn2-overlay-index-wfp fn2-overlay-index)
                 (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (natp d) (< d (fn2-id-decides-rows fn2-id-decides)))
     :guard-hints (("Goal" :in-theory (disable fn2-id-decide-fold)))))
    (b* ((o (fn2-id-next-overlay (fn2-overlays-rows fn2-overlays) (fn2-id-decides-src d fn2-id-decides) fn2-overlays))
         ((unless (< o (fn2-overlays-rows fn2-overlays)))
          (fn2-id-decide-fold* d *fn2-id-decide-phase-run-start* 0 nil 0))
         ((mv code exact others fn2-fields)
          (fn2-id-overlay-block o (fn2-id-decides-eb d fn2-id-decides) (fn2-id-decides-lbq d fn2-id-decides)
                                (fn2-id-decides-qbase d fn2-id-decides) (fn2-id-decides-qk d fn2-id-decides)
                                (fn2-id-decides-qs d fn2-id-decides) (fn2-id-decides-qg d fn2-id-decides)
                                fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv code fn2-id-decides fn2-fields)))
     (fn2-id-decide-fold* d *fn2-id-decide-phase-overlay* (+ 1 o) exact others)))

   ;; Probe installed run R's filter for the offer's Message-ID: :absent,
   ;; :maybe, :none (no filter), :filter-miss (its page is not cached).
   (defun fn2-id-filter (r eb qbase qk qs qg fn2-run-installed fn2-run-cache fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-run-installed fn2-run-cache fn2-fields fn2-pool)
     :guard (and (fn2-run-installed-wfp fn2-run-installed) (fn2-run-cache-wfp fn2-run-cache) (fn2-fields-wfp fn2-fields)
                 (fn2-pool-wfp fn2-pool) (natp r) (< r (fn2-run-installed-rows fn2-run-installed)))))
    (b* (((unless (equal (fn2-run-installed-filter r fn2-run-installed) 1)) (mv :none fn2-fields))
         ((mv code pslot pgen) (fn2-run-cache-lookup (fn2-run-installed-funit r fn2-run-installed)
                                                     (fn2-run-installed-fcounter r fn2-run-installed) fn2-run-cache))
         ((unless (eq code :ok)) (mv :filter-miss fn2-fields)))
     (fn2-ribbon-probe pslot pgen eb (+ (nfix qbase) *fn2-id-mid*) qk qs qg (fn2-run-installed-okind r fn2-run-installed)
                       (fn2-run-installed-oslot r fn2-run-installed) (fn2-run-installed-ogen r fn2-run-installed) fn2-fields fn2-pool)))
   (fn2-fc-shape fn2-id-filter-shape (fn2-id-filter r eb qbase qk qs qg fn2-run-installed fn2-run-cache fn2-fields fn2-pool)
    (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)) ((fn2-fields 1)))
   (in-theory (disable fn2-id-filter))
   (defun fn2-id-step-run-start (d fn2-id-decides fn2-run-installed fn2-run-cursors fn2-run-cache fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-id-decides fn2-run-installed fn2-run-cursors fn2-run-cache fn2-fields fn2-pool)
     :guard (and (fn2-id-decides-wfp fn2-id-decides) (fn2-run-installed-wfp fn2-run-installed) (fn2-run-cursors-wfp fn2-run-cursors)
                 (fn2-run-cache-wfp fn2-run-cache) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)
                 (natp d) (< d (fn2-id-decides-rows fn2-id-decides)))
     :guard-hints (("Goal" :in-theory (disable fn2-id-decide-fold fn2-run-cursor-start)))))
    (b* ((r (fn2-id-next-run (fn2-run-installed-rows fn2-run-installed) (fn2-id-decides-src d fn2-id-decides) fn2-run-installed))
         ((unless (< r (fn2-run-installed-rows fn2-run-installed)))
          (mv-let (code fn2-id-decides) (fn2-id-decide-fold d *fn2-id-decide-phase-done* 0 nil 0 fn2-id-decides)
           (mv code fn2-id-decides fn2-run-cursors fn2-fields)))

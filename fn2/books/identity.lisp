         (reads (+ 1 (fn2-id-decides-reads d fn2-id-decides)))
         ((unless (unsigned-byte-p 32 reads)) (mv :bounds fn2-id-decides fn2-run-cursors fn2-fields))
         ((mv code fn2-run-cursors)
          (fn2-run-cursor-start (fn2-id-decides-cursor d fn2-id-decides) 1 (fn2-run-installed-top r fn2-run-installed)
                                (fn2-run-installed-slot r fn2-run-installed) (fn2-run-installed-gen r fn2-run-installed)
                                (fn2-run-installed-unit r fn2-run-installed) (fn2-run-installed-counter r fn2-run-installed)
                                (fn2-id-decides-rb d fn2-id-decides) (fn2-run-installed-okind r fn2-run-installed)
                                (fn2-run-installed-oslot r fn2-run-installed) (fn2-run-installed-ogen r fn2-run-installed)
                                fn2-run-cursors))

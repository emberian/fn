; Layer C: one run page. B's page header, sealing and checking; C's payload.
; The payload is C's run-page header in a reserved region, the entries in key
; order, then the restart directory; B checks the zero padding after it.
(in-package "ACL2")
(include-book "format-check")
(include-book "pool-ranges")
(fn2-book-layer :c)

(defconst *fn2-run-page-size* *fn2-format-page-size*)
; B's header area, rounded to 32 bytes as the commit pages round it.
(defconst *fn2-run-header-area* (* 32 (ceiling *fn2-format-page-header-max-size* 32)))
(deflayout fn2-run-page-header
 '((schema (:id schema)) (schema-version :u8) (run (:id run)) (level :u8) (ordinal :varint)
   (entries :varint) (restarts :varint) (restart-interval :u8)))
(defconst *fn2-run-entries-base* (+ *fn2-run-header-area* *fn2-run-page-header-max-size*))
(deflayout fn2-run-restart '((offset :u32)))
(defconst *fn2-run-restart-bytes* *fn2-run-restart-max-size*)
; Every entry is at least one byte, so a 64 KiB page has at most this many
; restarts at interval 16; the interval is a page field, never below 16.
(defconst *fn2-run-restart-interval* 16)
(defconst *fn2-run-restart-capacity* 4096)
; A writer's fill limit (bytes of entries plus directory, from the page start)
; is a page-fill parameter like a block size; the encoded page stays 64 KiB.
(defconst *fn2-run-min-fill* 256)
(assert-event (<= (floor *fn2-run-page-size* *fn2-run-restart-interval*) *fn2-run-restart-capacity*))
; Per-writer field rows: the checker's decode range, the previous key, scratch.
(defconst *fn2-run-check-fields* *fn2-format-sealed-batch-num-fields*)
; An entry layout has at most 64 fields; its index layout adds the 8 fields of
; a child reference, so a decoded-entry region holds 80 rows.
(defconst *fn2-run-key-fields-max* 64)
(defconst *fn2-run-entry-rows* 80)
(defconst *fn2-run-prev-fields* *fn2-run-check-fields*)
(defconst *fn2-run-scratch-fields* (+ *fn2-run-prev-fields* *fn2-run-entry-rows*))
(defconst *fn2-run-writer-fields* (+ *fn2-run-scratch-fields* 2))

(defcolumns fn2-run-writers
 ((phase (:enum fn2-run-writer-phase (:idle :open :closing :heading :sealing :sealed :failed)))
  (schema :u60) (schema-version :u8) (level :u8) (run :u60) (ordinal :u60)
  (page-kind :u8) (slot :u32) (gen :u60) (cursor :u32) (entries :u32) (restarts :u32)
  (pos :u32) (prev :bool) (fields :u32) (limit :u32)
  (unit :u60) (epoch :u60) (counter :u60) (history :u60) (incarnation :u60)
  (okind :u8) (oslot :u32) (ogen :u60)))
(defcolumns fn2-run-restarts ((offset :u32)))

(defun fn2-run-writerp (w fn2-run-writers fn2-run-restarts fn2-fields)
 (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts fn2-fields) :guard t))
 (and (fn2-run-writers-wfp fn2-run-writers) (fn2-run-restarts-wfp fn2-run-restarts)
      (fn2-fields-wfp fn2-fields)
      (natp w) (< w (fn2-run-writers-rows fn2-run-writers))
      (<= (* (+ 1 w) *fn2-run-restart-capacity*) (fn2-run-restarts-rows fn2-run-restarts))
      (<= (+ (fn2-run-writers-fields w fn2-run-writers) *fn2-run-writer-fields*)
          (fn2-fields-rows fn2-fields))))

; Zero bytes [pos, end) of the writer's page, at most BUDGET of them. The
; pool's append discipline (write at or below fill) holds because the page
; is filled in order from zero.
(defun fn2-run-zero (n slot gen pos okind oslot ogen fn2-pool)
 (declare (xargs :stobjs fn2-pool :measure (nfix n)
  :guard (and (fn2-pool-wfp fn2-pool) (natp n) (natp pos))))
 (if (zp n) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen pos 0 okind oslot ogen fn2-pool)
   (if (eq code :ok) (fn2-run-zero (- n 1) slot gen (+ 1 pos) okind oslot ogen fn2-pool)
    (mv code fn2-pool)))))
(fn2-pool-preserves fn2-run-zero (n slot gen pos okind oslot ogen fn2-pool) :position 1)

; Open a page in a fresh C-owned workspace: reset it, zero the header area and
; the reserved C header region. Entries start at *fn2-run-entries-base*.
(defun fn2-run-open (w slot gen schema version level run ordinal page-kind
                       unit epoch counter history incarnation okind oslot ogen fields limit
                       fn2-run-writers fn2-pool)
 (declare (xargs :stobjs (fn2-run-writers fn2-pool)
  :guard (and (fn2-run-writers-wfp fn2-run-writers) (natp w) (< w (fn2-run-writers-rows fn2-run-writers))
              (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen) (unsigned-byte-p 60 schema)
                    (unsigned-byte-p 8 version) (unsigned-byte-p 8 level) (unsigned-byte-p 60 run)
                    (unsigned-byte-p 60 ordinal) (unsigned-byte-p 8 page-kind)
                    (unsigned-byte-p 60 unit) (unsigned-byte-p 60 epoch) (unsigned-byte-p 60 counter)
                    (unsigned-byte-p 60 history) (unsigned-byte-p 60 incarnation)
                    (unsigned-byte-p 8 okind) (unsigned-byte-p 32 oslot) (unsigned-byte-p 60 ogen)
                    (unsigned-byte-p 32 fields) (unsigned-byte-p 32 limit)
                    (<= (+ *fn2-run-entries-base* *fn2-run-min-fill*) limit) (<= limit *fn2-run-page-size*)))
       (mv :bounds fn2-run-writers fn2-pool))
      ((unless (equal (fn2-run-writers-phase w fn2-run-writers) *fn2-run-writer-phase-idle*))
       (mv :state fn2-run-writers fn2-pool))
      ((unless (and (< slot (fn2-pool-rows fn2-pool))
                    (let ((cap (fn2-pool-slot-cap slot fn2-pool)))
                      (and (natp cap) (<= *fn2-run-page-size* cap)))))
       (mv :capacity fn2-run-writers fn2-pool))
      ((mv code fn2-pool) (fn2-pool-reset slot gen okind oslot ogen fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-run-writers fn2-pool))
      ((mv code fn2-pool) (fn2-run-zero *fn2-run-entries-base* slot gen 0 okind oslot ogen fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-run-writers fn2-pool))
      (fn2-run-writers (fn2-run-writers-put w
        (phase *fn2-run-writer-phase-open*) (schema schema) (schema-version version) (level level)
        (run run) (ordinal ordinal) (page-kind page-kind) (slot slot) (gen gen)
        (cursor *fn2-run-entries-base*) (entries 0) (restarts 0) (pos 0) (prev 0) (fields fields) (limit limit)
        (unit unit) (epoch epoch) (counter counter) (history history) (incarnation incarnation)
        (okind okind) (oslot oslot) (ogen ogen))))
  (mv :ok fn2-run-writers fn2-pool)))

; One restart is recorded when entry number ENTRIES starts an interval. The
; buffer row is w * capacity + j; the writer owns that range.
(defun fn2-run-note-restart (w fn2-run-writers fn2-run-restarts)
 (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts)
  :guard (and (fn2-run-writers-wfp fn2-run-writers) (fn2-run-restarts-wfp fn2-run-restarts)
              (natp w) (< w (fn2-run-writers-rows fn2-run-writers))
              (<= (* (+ 1 w) *fn2-run-restart-capacity*) (fn2-run-restarts-rows fn2-run-restarts)))))
 (b* ((entries (fn2-run-writers-entries w fn2-run-writers))
      ((unless (equal (mod entries *fn2-run-restart-interval*) 0))
       (mv :ok fn2-run-writers fn2-run-restarts))
      (j (fn2-run-writers-restarts w fn2-run-writers))
      ((unless (< j *fn2-run-restart-capacity*)) (mv :capacity fn2-run-writers fn2-run-restarts))
      (row (+ (* w *fn2-run-restart-capacity*) j))
      ((unless (< row (fn2-run-restarts-rows fn2-run-restarts))) (mv :bounds fn2-run-writers fn2-run-restarts))
      (fn2-run-restarts (fn2-run-restarts-set-offset row
                          (fn2-run-writers-cursor w fn2-run-writers) fn2-run-restarts))
      (fn2-run-writers (fn2-run-writers-set-restarts w (+ 1 j) fn2-run-writers)))
  (mv :ok fn2-run-writers fn2-run-restarts)))

; Room for an entry of SIZE bytes, counting the restart it may add.
(defun fn2-run-roomp (w size fn2-run-writers)
 (declare (xargs :stobjs fn2-run-writers
  :guard (and (fn2-run-writers-wfp fn2-run-writers) (natp w) (< w (fn2-run-writers-rows fn2-run-writers))
              (natp size))))
 (let* ((entries (fn2-run-writers-entries w fn2-run-writers))
        (restarts (+ (fn2-run-writers-restarts w fn2-run-writers)
                     (if (equal (mod entries *fn2-run-restart-interval*) 0) 1 0))))
  (<= (+ (fn2-run-writers-cursor w fn2-run-writers) size (* *fn2-run-restart-bytes* restarts))
      (min (fn2-run-writers-limit w fn2-run-writers) *fn2-run-page-size*))))

; Restarts J .. J+K-1 of writer W, encoded at CURSOR + 4j through the
; generated restart codec (one scratch field row).
(defun fn2-run-write-restarts (k j w cursor scratch slot gen okind oslot ogen fn2-run-restarts fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-run-restarts fn2-fields fn2-pool) :measure (nfix k)
  :guard (and (fn2-run-restarts-wfp fn2-run-restarts) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)
              (natp k) (natp j) (natp w) (natp cursor) (natp scratch) (< scratch (fn2-fields-rows fn2-fields)))))
 (if (zp k) (mv :ok fn2-fields fn2-pool)
  (b* ((row (+ (* w *fn2-run-restart-capacity*) j))
       ((unless (and (< j *fn2-run-restart-capacity*) (< row (fn2-run-restarts-rows fn2-run-restarts))))
        (mv :bounds fn2-fields fn2-pool))
       (off (fn2-run-restarts-offset row fn2-run-restarts))
       ((unless (unsigned-byte-p 32 off)) (mv :bounds fn2-fields fn2-pool))
       (fn2-fields (fn2-fields-set-value scratch off fn2-fields))
       ((mv code & fn2-pool) (fn2-run-restart-encode scratch slot gen (+ cursor (* *fn2-run-restart-bytes* j))
                                                    okind oslot ogen fn2-fields fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-fields fn2-pool)))
   (fn2-run-write-restarts (- k 1) (+ 1 j) w cursor scratch slot gen okind oslot ogen fn2-run-restarts fn2-fields fn2-pool))))
(fn2-fields-preserves fn2-run-write-restarts (k j w cursor scratch slot gen okind oslot ogen fn2-run-restarts fn2-fields fn2-pool)
 :position 1 :disable nil :hyps ((fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-run-restartsp fn2-run-restarts) (fn2-run-restarts-wfp fn2-run-restarts) (natp scratch) (< scratch (fn2-fields-rows fn2-fields))))
(fn2-pool-preserves fn2-run-write-restarts (k j w cursor scratch slot gen okind oslot ogen fn2-run-restarts fn2-fields fn2-pool)
 :position 2 :prefix "-POOL-PRESERVES")

; Closing: the restart directory, then zeros to the page end, at most BUDGET
; bytes per call. POS counts bytes written after the last entry.
(defun fn2-run-close-step (w budget fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
  :guard (and (fn2-run-writerp w fn2-run-writers fn2-run-restarts fn2-fields) (fn2-pool-wfp fn2-pool)
              (natp budget))))
 (b* ((slot (fn2-run-writers-slot w fn2-run-writers)) (gen (fn2-run-writers-gen w fn2-run-writers))
      (okind (fn2-run-writers-okind w fn2-run-writers)) (oslot (fn2-run-writers-oslot w fn2-run-writers))
      (ogen (fn2-run-writers-ogen w fn2-run-writers))
      (cursor (fn2-run-writers-cursor w fn2-run-writers))
      (restarts (fn2-run-writers-restarts w fn2-run-writers))
      (dir (* *fn2-run-restart-bytes* restarts))
      (pos (fn2-run-writers-pos w fn2-run-writers))
      (scratch (+ (fn2-run-writers-fields w fn2-run-writers) *fn2-run-scratch-fields*))
      ((unless (equal (fn2-run-writers-phase w fn2-run-writers) *fn2-run-writer-phase-closing*))
       (mv :state fn2-run-writers fn2-fields fn2-pool))
      ((when (< pos dir))
       (b* ((j (floor pos *fn2-run-restart-bytes*))
            ((unless (equal pos (* j *fn2-run-restart-bytes*))) (mv :state fn2-run-writers fn2-fields fn2-pool))
            (k (min (max 1 (floor (nfix budget) *fn2-run-restart-bytes*)) (- restarts j)))
            ((mv code fn2-fields fn2-pool)
             (fn2-run-write-restarts k j w cursor scratch slot gen okind oslot ogen fn2-run-restarts fn2-fields fn2-pool))
            ((unless (eq code :ok)) (mv code fn2-run-writers fn2-fields fn2-pool))
            ((unless (unsigned-byte-p 32 (+ pos (* *fn2-run-restart-bytes* k)))) (mv :bounds fn2-run-writers fn2-fields fn2-pool))
            (fn2-run-writers (fn2-run-writers-set-pos w (+ pos (* *fn2-run-restart-bytes* k)) fn2-run-writers)))
        (mv :more fn2-run-writers fn2-fields fn2-pool)))
      (end (+ cursor pos))
      ((when (<= *fn2-run-page-size* end))
       (let ((fn2-run-writers (fn2-run-writers-set-phase w *fn2-run-writer-phase-heading* fn2-run-writers)))
        (mv :ok fn2-run-writers fn2-fields fn2-pool)))
      (n (min (max 1 (nfix budget)) (- *fn2-run-page-size* end)))
      ((mv code fn2-pool) (fn2-run-zero n slot gen end okind oslot ogen fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-run-writers fn2-fields fn2-pool))
      ((unless (unsigned-byte-p 32 (+ pos n))) (mv :bounds fn2-run-writers fn2-fields fn2-pool)))
  (let ((fn2-run-writers (fn2-run-writers-set-pos w (+ pos n) fn2-run-writers)))
   (mv :more fn2-run-writers fn2-fields fn2-pool))))
; Begin closing an open writer.
(defun fn2-run-close (w fn2-run-writers)
 (declare (xargs :stobjs fn2-run-writers
  :guard (and (fn2-run-writers-wfp fn2-run-writers) (natp w) (< w (fn2-run-writers-rows fn2-run-writers)))))
 (if (equal (fn2-run-writers-phase w fn2-run-writers) *fn2-run-writer-phase-open*)
     (let* ((fn2-run-writers (fn2-run-writers-set-pos w 0 fn2-run-writers))
            (fn2-run-writers (fn2-run-writers-set-phase w *fn2-run-writer-phase-closing* fn2-run-writers)))
      (mv :ok fn2-run-writers))
  (mv :state fn2-run-writers)))
(fn2-run-writers-preserves fn2-run-close (w fn2-run-writers) :position 1 :raw-rows t
 :hyps ((fn2-run-writersp fn2-run-writers) (fn2-run-writers-wfp fn2-run-writers) (natp w) (< w (fn2-run-writers-rows fn2-run-writers))))
(fn2-run-writers-preserves fn2-run-open (w slot gen schema version level run ordinal page-kind unit epoch counter history incarnation okind oslot ogen fields limit fn2-run-writers fn2-pool) :position 1 :raw-rows t :disable nil
 :hyps ((fn2-run-writersp fn2-run-writers) (fn2-run-writers-wfp fn2-run-writers) (natp w) (< w (fn2-run-writers-rows fn2-run-writers))))
(fn2-pool-preserves fn2-run-open (w slot gen schema version level run ordinal page-kind unit epoch counter history incarnation okind oslot ogen fields limit fn2-run-writers fn2-pool) :position 2 :prefix "-POOL-PRESERVES")
(fn2-run-writers-preserves fn2-run-note-restart (w fn2-run-writers fn2-run-restarts) :position 1 :raw-rows t :disable nil
 :hyps ((fn2-run-writersp fn2-run-writers) (fn2-run-writers-wfp fn2-run-writers) (natp w) (< w (fn2-run-writers-rows fn2-run-writers))))
(fn2-run-restarts-preserves fn2-run-note-restart (w fn2-run-writers fn2-run-restarts) :position 2 :prefix "-RESTARTS-PRESERVES" :raw-rows t
 :hyps ((fn2-run-restartsp fn2-run-restarts) (fn2-run-restarts-wfp fn2-run-restarts) (fn2-run-writersp fn2-run-writers) (fn2-run-writers-wfp fn2-run-writers) (natp w) (< w (fn2-run-writers-rows fn2-run-writers))
        (<= (* (+ 1 w) *fn2-run-restart-capacity*) (fn2-run-restarts-rows fn2-run-restarts))))
(fn2-run-writers-preserves fn2-run-close-step (w budget fn2-run-writers fn2-run-restarts fn2-fields fn2-pool) :position 1 :raw-rows t :disable nil
 :hyps ((fn2-run-writersp fn2-run-writers) (fn2-run-restartsp fn2-run-restarts) (fn2-run-writerp w fn2-run-writers fn2-run-restarts fn2-fields)))
(fn2-fields-preserves fn2-run-close-step (w budget fn2-run-writers fn2-run-restarts fn2-fields fn2-pool) :position 2 :prefix "-FIELDS-PRESERVES" :disable nil
 :hyps ((fn2-fieldsp fn2-fields) (fn2-run-writersp fn2-run-writers) (fn2-run-restartsp fn2-run-restarts) (fn2-run-writerp w fn2-run-writers fn2-run-restarts fn2-fields)))
(fn2-pool-preserves fn2-run-close-step (w budget fn2-run-writers fn2-run-restarts fn2-fields fn2-pool) :position 3 :prefix "-POOL-PRESERVES")

; Heading: B's page header at 0 and C's run-page header at the header area,
; both through the generated encoders. Field rows: B's at BASE, C's after.
(defconst *fn2-run-c-header-fields* *fn2-format-page-header-num-fields*)
(defun fn2-run-payload-length (w fn2-run-writers)
 (declare (xargs :stobjs fn2-run-writers
  :guard (and (fn2-run-writers-wfp fn2-run-writers) (natp w) (< w (fn2-run-writers-rows fn2-run-writers)))))
 (nfix (- (+ (fn2-run-writers-cursor w fn2-run-writers)
             (* *fn2-run-restart-bytes* (fn2-run-writers-restarts w fn2-run-writers)))
          *fn2-run-header-area*)))
; B's page header of writer W's page, encoded at offset 0 from field rows
; B: every field from the writer row, the payload what its cursor and
; restarts cover. Shared by run pages and filter pages (ribbon.lisp).
(defun fn2-run-head-b (w b fn2-run-writers fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-run-writers fn2-fields fn2-pool)
  :guard (and (fn2-run-writers-wfp fn2-run-writers) (natp w) (< w (fn2-run-writers-rows fn2-run-writers))
              (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (and (natp b) (<= (+ b *fn2-run-c-header-fields*) (fn2-fields-rows fn2-fields))))
       (mv :bounds fn2-fields fn2-pool))
      (slot (fn2-run-writers-slot w fn2-run-writers)) (gen (fn2-run-writers-gen w fn2-run-writers))
      (okind (fn2-run-writers-okind w fn2-run-writers)) (oslot (fn2-run-writers-oslot w fn2-run-writers))
      (ogen (fn2-run-writers-ogen w fn2-run-writers))
      (payload (fn2-run-payload-length w fn2-run-writers))
      ((unless (unsigned-byte-p 60 payload)) (mv :bounds fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-set-value (+ b *fn2-format-page-header-field-magic*) *fn2-format-page-magic* fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ b *fn2-format-page-header-field-version*) *fn2-format-version* fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ b *fn2-format-page-header-field-page-kind*) (fn2-run-writers-page-kind w fn2-run-writers) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ b *fn2-format-page-header-field-history*) (fn2-run-writers-history w fn2-run-writers) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ b *fn2-format-page-header-field-incarnation*) (fn2-run-writers-incarnation w fn2-run-writers) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ b *fn2-format-page-header-field-physical-unit*) (fn2-run-writers-unit w fn2-run-writers) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ b *fn2-format-page-header-field-writer-epoch*) (fn2-run-writers-epoch w fn2-run-writers) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ b *fn2-format-page-header-field-allocation*) (fn2-run-writers-counter w fn2-run-writers) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ b *fn2-format-page-header-field-header-length*) *fn2-run-header-area* fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ b *fn2-format-page-header-field-payload-length*) payload fn2-fields))
      ((mv code & fn2-pool) (fn2-format-page-header-encode b slot gen 0 okind oslot ogen fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields fn2-pool)))
  (mv :ok fn2-fields fn2-pool)))
(fn2-fields-preserves fn2-run-head-b (w b fn2-run-writers fn2-fields fn2-pool) :position 1 :disable nil
 :hyps ((fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-run-writersp fn2-run-writers) (fn2-run-writers-wfp fn2-run-writers)
        (natp w) (< w (fn2-run-writers-rows fn2-run-writers))))
(fn2-pool-preserves fn2-run-head-b (w b fn2-run-writers fn2-fields fn2-pool) :position 2 :prefix "-POOL-PRESERVES")
(in-theory (disable fn2-run-head-b))
(defun fn2-run-head (w fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
 (declare (ignore fn2-run-restarts))
 (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
  :guard (and (fn2-run-writerp w fn2-run-writers fn2-run-restarts fn2-fields) (fn2-pool-wfp fn2-pool))))
 (b* (((unless (equal (fn2-run-writers-phase w fn2-run-writers) *fn2-run-writer-phase-heading*))
       (mv :state fn2-run-writers fn2-fields fn2-pool))
      (slot (fn2-run-writers-slot w fn2-run-writers)) (gen (fn2-run-writers-gen w fn2-run-writers))
      (okind (fn2-run-writers-okind w fn2-run-writers)) (oslot (fn2-run-writers-oslot w fn2-run-writers))
      (ogen (fn2-run-writers-ogen w fn2-run-writers))
      (b (fn2-run-writers-fields w fn2-run-writers))
      (c (+ b *fn2-run-c-header-fields*))
      ((mv code fn2-fields fn2-pool) (fn2-run-head-b w b fn2-run-writers fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-run-writers fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-set-value (+ c *fn2-run-page-header-field-schema*) (fn2-run-writers-schema w fn2-run-writers) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ c *fn2-run-page-header-field-schema-version*) (fn2-run-writers-schema-version w fn2-run-writers) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ c *fn2-run-page-header-field-run*) (fn2-run-writers-run w fn2-run-writers) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ c *fn2-run-page-header-field-level*) (fn2-run-writers-level w fn2-run-writers) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ c *fn2-run-page-header-field-ordinal*) (fn2-run-writers-ordinal w fn2-run-writers) fn2-fields))

  (case (fn2-run-key-order-spec key (car entries) q)
   (:lt (fn2-run-lower-bound-spec key (cdr entries) q (+ 1 i)))
   (:eq (list :found i))
   (otherwise (list :absent i)))))
(defun fn2-run-values-layoutp (layout values)
 (declare (xargs :verify-guards nil))
 (mv-let (code parsed rest) (fn2-layout-parse layout (fn2-layout-octets layout values))
  (and (eq code :ok) (equal parsed values) (null rest))))
(defun fn2-run-entries-layoutp (layout entries)
 (declare (xargs :verify-guards nil))
 (if (atom entries) (null entries)
  (and (fn2-run-values-layoutp layout (car entries)) (fn2-run-entries-layoutp layout (cdr entries)))))
; The inputs one page accepts: well-formed sorted entries that fit, and
; metadata within the resident widths.
(defun fn2-run-page-inputp (layout key meta entries)
 (declare (xargs :verify-guards nil))
 (and (fn2-layoutp layout) (true-listp meta) (equal (len meta) 11)
      (unsigned-byte-p 8 (fn2-run-meta-page-kind meta)) (unsigned-byte-p 8 (fn2-run-meta-version meta))
      (unsigned-byte-p 8 (fn2-run-meta-level meta))
      (unsigned-byte-p 60 (fn2-run-meta-history meta)) (unsigned-byte-p 60 (fn2-run-meta-incarnation meta))
      (unsigned-byte-p 60 (fn2-run-meta-unit meta)) (unsigned-byte-p 60 (fn2-run-meta-epoch meta))
      (unsigned-byte-p 60 (fn2-run-meta-counter meta)) (unsigned-byte-p 60 (fn2-run-meta-schema meta))
      (unsigned-byte-p 60 (fn2-run-meta-run meta)) (unsigned-byte-p 60 (fn2-run-meta-ordinal meta))
      (fn2-run-entries-layoutp layout entries) (fn2-run-sorted-spec key entries)
      (<= (len (fn2-run-page-spec layout meta entries)) *fn2-run-page-size*)
      (<= (+ *fn2-run-entries-base* (len (fn2-run-entries-octets layout entries))
             (* *fn2-run-restart-bytes* (len (fn2-run-restart-offsets-spec layout entries 0 0))))
          *fn2-run-page-size*)))

; Logic adapter: set one entry's field rows from spec VALUES, copying octet
; and digest bytes into the source slot at OFF. Returns (mv code off fields pool).
(defun fn2-run-load-bytes (bytes slot gen off okind oslot ogen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (if (atom bytes) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen off (car bytes) okind oslot ogen fn2-pool)
   (if (eq code :ok) (fn2-run-load-bytes (cdr bytes) slot gen (+ 1 (nfix off)) okind oslot ogen fn2-pool)
    (mv code fn2-pool)))))
(defun fn2-run-load-ref (row bytes slot gen off okind oslot ogen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* (((mv code fn2-pool) (fn2-run-load-bytes bytes slot gen off okind oslot ogen fn2-pool))
      (fn2-fields (fn2-fields-set-ref-slot row slot fn2-fields))
      (fn2-fields (fn2-fields-set-ref-gen row gen fn2-fields))
      (fn2-fields (fn2-fields-set-ref-off row off fn2-fields))
      (fn2-fields (fn2-fields-set-ref-len row (len bytes) fn2-fields)))
  (mv code (+ (nfix off) (len bytes)) fn2-fields fn2-pool)))
(defun fn2-run-load-values (layout values row slot gen off okind oslot ogen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (if (atom layout) (mv :ok off fn2-fields fn2-pool)
  (b* ((k (cadar layout)) (v (car values))
       ((mv code off fn2-fields fn2-pool)
        (cond ((eq k :digest)
               (b* ((fn2-fields (fn2-fields-set-value row (nfix (car v)) fn2-fields)))
                (fn2-run-load-ref row (cdr v) slot gen off okind oslot ogen fn2-fields fn2-pool)))
              ((and (consp k) (eq (car k) :octets))
               (fn2-run-load-ref row v slot gen off okind oslot ogen fn2-fields fn2-pool))
              (t (let ((fn2-fields (fn2-fields-set-value row (nfix v) fn2-fields)))
                  (mv :ok off fn2-fields fn2-pool)))))
       ((unless (eq code :ok)) (mv code off fn2-fields fn2-pool)))
   (fn2-run-load-values (cdr layout) (cdr values) (+ 1 row) slot gen off okind oslot ogen fn2-fields fn2-pool))))
(defun fn2-run-read-bytes (n slot gen off okind oslot ogen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix n)))
 (if (zp n) nil
  (mv-let (code byte) (fn2-pool-read slot gen off okind oslot ogen fn2-pool)
   (cons (if (eq code :ok) byte code) (fn2-run-read-bytes (- n 1) slot gen (+ 1 (nfix off)) okind oslot ogen fn2-pool)))))

; WITH-LOCAL-STOBJ over STOBJS around a body returning (mv answer s1 .. sn).
(defun fn2-run-nest (k stobjs e)
 (declare (xargs :verify-guards nil))
 (if (zp k) e
  (fn2-run-nest (- k 1) stobjs
   `(with-local-stobj ,(nth (- k 1) stobjs)
     (mv-let (answer ,@(take k stobjs)) ,e
      ,(if (= k 1) 'answer `(mv answer ,@(take (- k 1) stobjs))))))))
(defmacro fn2-run-with-local (stobjs body) (fn2-run-nest (len stobjs) stobjs body))
(defconst *fn2-run-adapter-stobjs*
 '(fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests))
; Fixture plan for the adapters: owner (9 0 1); query owner (10 0 1).
(defconst *fn2-run-adapter-entry* 200)
(defconst *fn2-run-adapter-reader* 300)
(defconst *fn2-run-adapter-query* 420)
(defconst *fn2-run-adapter-hash* 136)
(defun fn2-run-adapter-setup (fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
 (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests) :verify-guards nil))
 (b* ((fn2-run-writers (fn2-run-writers-init 1 fn2-run-writers))
      (fn2-run-restarts (fn2-run-restarts-init *fn2-run-restart-capacity* fn2-run-restarts))
      (fn2-fields (fn2-fields-init 512 fn2-fields))
      (fn2-pool (fn2-pool-init '((2 . 65536) (1 . 65536)) 1 100 fn2-pool))
      (fn2-fc (fn2-fc-init 1 fn2-fc))
      (fn2-fc-context (fn2-fc-context-init 1 fn2-fc-context))
      (fn2-b3 (fn2-b3-table-init 1 fn2-b3))
      (fn2-digests (fn2-digests-init 140 fn2-digests)))
  (mv fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)))
(defun fn2-run-adapter-drive (kind fuel fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
 (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
                 :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
  (b* (((mv code fn2-run-writers fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
        (if (eq kind :close)
            (mv-let (code fn2-run-writers fn2-fields fn2-pool)
              (fn2-run-close-step 0 4096 fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
              (mv code fn2-run-writers fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests))
          (fn2-run-seal-step 0 0 *fn2-run-adapter-hash* 4096 fn2-run-writers fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))))
   (if (eq code :more)
       (fn2-run-adapter-drive kind (- fuel 1) fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
     (mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)))))
; Spec values of the decoded entry at field row ROW (logic adapter).
(defun fn2-run-unload-values (layout row fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (if (atom layout) nil
  (let* ((k (cadar layout)) (v (fn2-fields-value row fn2-fields))
         (bytes (fn2-run-read-bytes (fn2-fields-ref-len row fn2-fields) (fn2-fields-ref-slot row fn2-fields)
                                    (fn2-fields-ref-gen row fn2-fields) (fn2-fields-ref-off row fn2-fields) 9 0 1 fn2-pool)))
   (cons (cond ((eq k :digest) (cons v bytes)) ((and (consp k) (eq (car k) :octets)) bytes) (t v))
         (fn2-run-unload-values (cdr layout) (+ 1 row) fn2-fields fn2-pool)))))
; The entry whose key equals Q's, or :absent.
(defun fn2-run-key-lookup-spec (key entries q)
 (declare (xargs :verify-guards nil))
 (cond ((atom entries) (list :absent nil))
       ((eq (fn2-run-key-order-spec key (car entries) q) :eq) (list :found (car entries)))
       (t (fn2-run-key-lookup-spec key (cdr entries) q))))

    (declare (xargs :stobjs (fn2-run-cursors fn2-fields fn2-pool)
     :guard (and (fn2-ra-step-guard) (natp budget) (natp qbase) (<= (+ qbase *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields)))
     :guard-hints (("Goal" :in-theory (disable fn2-run-cursor-save fn2-fields-rows)))))

  (cons (cons (car names) (getpropc (car names) 'symbol-class nil world)) (fn2-ra-classes (cdr names) world))))
; The first function of PAIRS that is not guard-verified, or nil.
(defun fn2-run-glue-unverified (pairs)
 (declare (xargs :guard t))
 (cond ((atom pairs) nil)
       ((and (consp (car pairs)) (eq (cdar pairs) :common-lisp-compliant)) (fn2-run-glue-unverified (cdr pairs)))
       (t (if (consp (car pairs)) (caar pairs) (car pairs)))))
(defun fn2-run-glue-check (snapshot)
 (declare (xargs :guard t))
 (cond ((atom snapshot) :ok)
       ((not (consp (car snapshot))) (list :unverified nil nil))
       ((fn2-run-glue-unverified (cdar snapshot)) (list :unverified (caar snapshot) (fn2-run-glue-unverified (cdar snapshot))))
       (t (fn2-run-glue-check (cdr snapshot)))))
(defun fn2-ra-glue-names (name row world)
 (declare (xargs :verify-guards nil))
 (let ((layouts (fn2-decl-get :layouts row)))
  (append *fn2-run-glue-generic*
          (list (fn2-columns-sym (car layouts) "-ENCODE") (fn2-columns-sym (car layouts) "-DECODE")
                (fn2-columns-sym (car layouts) "-SIZE") (fn2-columns-sym (cadr layouts) "-ENCODE")
                (fn2-columns-sym (cadr layouts) "-DECODE") (fn2-columns-sym (cadr layouts) "-SIZE")
                (fn2-decl-get :compare row))
          (fn2-ra-generated-functions (fn2-decl-get :generated row))
          (fn2-ra-existing-old (fn2-ra-sym-list name *fn2-run-glue-old-suffixes*) world))))
(defun fn2-ra-glue-snapshot (rows world)
 (declare (xargs :verify-guards nil))
 (if (atom rows) nil
  (cons (cons (caar rows) (fn2-ra-classes (fn2-ra-glue-names (caar rows) (cdar rows) world) world))
        (fn2-ra-glue-snapshot (cdr rows) world))))
;; One assembly per world, after its last schema. The owed row records the
;; certify-time check; its teeth: the assembled schemas pass, and a schema
;; carrying per-schema glue admitted without guard verification is refused
;; by name.
;; The generated proofs run in one theory, whatever the including world's.
;; deflayout disables the fields and pool accessors locally in each codec's
;; book; a world that includes a schema's certified book has them enabled
;; again, and the assembly's proofs there took ten times as long (159 s
;; against 17 s). The assembly folds the same accessors, and the rows
;; accessors of the digest and checker tables, as runs.lisp does.
(defmacro fn2-run-assembly-theory ()
 '(local (in-theory (disable fn2-fieldsp fn2-poolp fn2-fields-rows fn2-fields-value fn2-fields-ref-slot
                             fn2-fields-ref-gen fn2-fields-ref-off fn2-fields-ref-len fn2-fields-status fn2-pool-rows
                             fn2-pool-read fn2-pool-write fn2-fields-decode-phase fn2-fields-decode-pos fn2-fields-decode-acc
                             fn2-fields-decode-high fn2-fields-decode-size fn2-fields-decode-ref fn2-fields-decode-payload
                             fn2-fields-decode-next fn2-digests-rows fn2-fc-rows fn2-fc-context-rows fn2-b3-rows))))
(defmacro fn2-run-assemble ()
 '(encapsulate ()
   (fn2-run-assembly-theory)
   (make-event
    (if (fn2-rs-assembled (w state))
        (er soft 'fn2-run-assemble "The runs are already assembled: ~x0." (fn2-rs-assembled (w state)))
      (value `(table fn2-run-assembly :schemas ',(strip-cars (fn2-decl-rows :schema (w state))))))
    :check-expansion t)
   (make-event (value (cons 'progn (fn2-ra-dispatch-events (fn2-decl-rows :schema (w state))))))
   (fn2-ra-shape-events)
   (fn2-ra-page-events)
   (fn2-ra-build-events)
   (fn2-ra-lookup-events)
   (fn2-ra-overlay-events)
   (fn2-ra-adapter-events)
   (fn2-ra-overlay-adapter-events)
   (make-event (value (cons 'progn (fn2-ra-keystone-events (fn2-decl-rows :schema (w state))))))
   (make-event
    (value `(defun fn2-run-glue-assembled ()
              (declare (xargs :guard t))
              ',(fn2-ra-glue-snapshot (fn2-decl-rows :schema (w state)) (w state)))))
   (defthm-owed fn2-run-glue-verified ()
    (equal (fn2-run-glue-check (fn2-run-glue-assembled)) :ok)
    :teeth (fn2-run-glue-verified-positive fn2-run-glue-verified-negative)
    :schema :invariant
    :doc "Every assembled schema's build and lookup path (generic entry points, dispatcher, codecs, key order, generated functions, any per-schema glue) is guard-verified; the assembly refuses otherwise, by name.")
   (make-event
    (let ((r (fn2-run-glue-check (fn2-run-glue-assembled))))
     (if (eq r :ok) (value '(value-triple :glue-verified))
       (er soft 'fn2-run-assemble "Run schema ~x0: ~x1 is not guard-verified." (cadr r) (caddr r)))))))

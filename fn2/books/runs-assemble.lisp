    (declare (xargs :stobjs (fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool)
     :guard (and (fn2-ra-step-guard) (fn2-run-paths-wfp fn2-run-paths) (fn2-run-cache-wfp fn2-run-cache) (natp nkeys))
     :guard-hints (("Goal" :in-theory (disable fn2-run-cursor-save fn2-run-path-take fn2-run-cache-lookup fn2-fields-rows)))))
    (b* (((mv code & fn2-fields)
          (if childp (fn2-run-nth sid level idx slot gen rb ok os og fn2-fields fn2-pool) (mv :ok 0 fn2-fields)))
         ((mv code fn2-run-paths)

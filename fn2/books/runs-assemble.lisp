         ((unless (eq code :ok)) (mv code fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-digests))
         ((mv code fn2-fields fn2-pool)
          (fn2-run-child-ref w l (+ ib nkeys) (+ ib nkeys *fn2-format-ref-num-fields*)
                             hrow hslot hgen okind oslot ogen fn2-run-writers fn2-fields fn2-pool fn2-digests))
         ((unless (eq code :ok)) (mv code fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-digests))
         ((mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)

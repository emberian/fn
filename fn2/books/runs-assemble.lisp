; Layer C: the run assembly. FN2-RUN-ASSEMBLE runs once, after every
; DEFRUNSCHEMA of a world (a top-level assembly book; a unit after its test
; schemas). It generates the layout dispatcher over the registered schemas'
; codecs and key orders, with its shape lemmas proved by cases, then the
; append, page seek, build and lookup written once over the dispatcher and
; guard-verified there, the logic adapters and per-schema keystones, and a
; certify-time check that refuses any assembled schema whose build or lookup
; path reaches a function that is not guard-verified.
(in-package "ACL2")
(include-book "runs")
(fn2-book-layer :c)

; Dispatch arms over schema rows (NAME . ROW): one case arm per schema id.
; Level 0 selects the entry layout, a positive level the index layout.
(defun fn2-ra-layout-arms (rows suffix args)
 (declare (xargs :verify-guards nil))
 (if (atom rows) nil
  (let* ((row (cdar rows)) (layouts (fn2-decl-get :layouts row)))
   (cons `(,(fn2-decl-get :id row)
           (if (and (integerp lv) (< 0 lv)) (,(fn2-columns-sym (cadr layouts) suffix) ,@args)
             (,(fn2-columns-sym (car layouts) suffix) ,@args)))
         (fn2-ra-layout-arms (cdr rows) suffix args)))))
(defun fn2-ra-count-arms (rows)
 (declare (xargs :verify-guards nil))
 (if (atom rows) nil
  (let* ((row (cdar rows)) (layouts (fn2-decl-get :layouts row)))
   (cons `(,(fn2-decl-get :id row)
           (if (and (integerp lv) (< 0 lv)) ,(fn2-codec-constant (cadr layouts) "-NUM-FIELDS")
             ,(fn2-codec-constant (car layouts) "-NUM-FIELDS")))
         (fn2-ra-count-arms (cdr rows))))))
(defun fn2-ra-key-arms (rows)
 (declare (xargs :verify-guards nil))
 (if (atom rows) nil
  (cons `(,(fn2-decl-get :id (cdar rows)) ,(len (fn2-decl-get :key (cdar rows))))
        (fn2-ra-key-arms (cdr rows)))))
(defun fn2-ra-compare-arms (rows)
 (declare (xargs :verify-guards nil))
 (if (atom rows) nil
  (cons `(,(fn2-decl-get :id (cdar rows))
          (,(fn2-decl-get :compare (cdar rows)) abase bbase ak as ag bk bs bg fn2-fields fn2-pool))
        (fn2-ra-compare-arms (cdr rows)))))
(defun fn2-ra-ids (rows)
 (declare (xargs :verify-guards nil))
 (if (atom rows) nil (cons (fn2-decl-get :id (cdar rows)) (fn2-ra-ids (cdr rows)))))

; The dispatcher. Every function is total over schema ids: an id no schema
; registered is refused :schema by the codec dispatch and has no fields.
(defun fn2-ra-dispatch-events (rows)
 (declare (xargs :verify-guards nil))
 (let ((room '(and (fn2-fields-wfp fn2-fields) (natp base)
                   (<= (+ base *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields)))))
 `((defun fn2-run-layout-fields (sid lv)
    (declare (xargs :guard t) (ignorable lv))
    (case sid ,@(fn2-ra-count-arms rows) (otherwise 0)))
   (defun fn2-run-layout-keys (sid)
    (declare (xargs :guard t))
    (case sid ,@(fn2-ra-key-arms rows) (otherwise 0)))
   (defun fn2-run-layout-decode (sid lv base slot gen off end okind oslot ogen fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-fields fn2-pool) :guard (and ,room (fn2-pool-wfp fn2-pool)))
             (ignorable lv base slot gen end okind oslot ogen fn2-pool))
    (case sid ,@(fn2-ra-layout-arms rows "-DECODE" '(base slot gen off end okind oslot ogen fn2-fields fn2-pool))
     (otherwise (mv :schema off fn2-fields))))
   (defun fn2-run-layout-encode (sid lv base slot gen off okind oslot ogen fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-fields fn2-pool) :guard (and ,room (fn2-pool-wfp fn2-pool)))
             (ignorable lv base slot gen okind oslot ogen fn2-fields))
    (case sid ,@(fn2-ra-layout-arms rows "-ENCODE" '(base slot gen off okind oslot ogen fn2-fields fn2-pool))
     (otherwise (mv :schema off fn2-pool))))
   (defun fn2-run-layout-size (sid lv base fn2-fields)
    (declare (xargs :stobjs fn2-fields :guard ,room) (ignorable lv base fn2-fields))
    (case sid ,@(fn2-ra-layout-arms rows "-SIZE" '(base fn2-fields)) (otherwise 0)))
   (defun fn2-run-layout-compare (sid abase bbase ak as ag bk bs bg fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-fields fn2-pool)
     :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (natp abase) (natp bbase)
                 (<= (+ abase *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields))
                 (<= (+ bbase *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields))))
             (ignorable abase bbase ak as ag bk bs bg fn2-fields fn2-pool))
    (case sid ,@(fn2-ra-compare-arms rows) (otherwise (mv :schema :eq))))
   (defconst *fn2-run-assembled-ids* ',(fn2-ra-ids rows)))))

; A shape lemma (recognizer, invariant, rows) for each named output, proved
; with the recognizers and the named rows accessors folded.
(defmacro fn2-ra-shape (name call guard outputs disables)
 `(defthm ,name
   (implies ,guard (and ,@(fn2-fc-shape-claims outputs call)))
   :hints (("Goal" :in-theory (disable fn2-run-writersp fn2-run-writers-wfp fn2-run-restartsp fn2-run-restarts-wfp
                                       fn2-fieldsp fn2-fields-wfp fn2-poolp fn2-pool-wfp ,@disables)))))

; Shape lemmas, by cases over the arms, from each codec's own lemmas.
(defmacro fn2-ra-shape-events ()
 '(progn
   (defthm fn2-run-layout-decode-shape
    (implies (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields))
             (and (fn2-fieldsp (mv-nth 2 (fn2-run-layout-decode sid lv base slot gen off end okind oslot ogen fn2-fields fn2-pool)))
                  (fn2-fields-wfp (mv-nth 2 (fn2-run-layout-decode sid lv base slot gen off end okind oslot ogen fn2-fields fn2-pool)))
                  (equal (fn2-fields-rows (mv-nth 2 (fn2-run-layout-decode sid lv base slot gen off end okind oslot ogen fn2-fields fn2-pool)))
                         (fn2-fields-rows fn2-fields))))
    :hints (("Goal" :in-theory (disable fn2-fieldsp fn2-fields-wfp fn2-fields-rows))))
   (defthm fn2-run-layout-encode-shape
    (implies (and (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
             (and (fn2-poolp (mv-nth 2 (fn2-run-layout-encode sid lv base slot gen off okind oslot ogen fn2-fields fn2-pool)))
                  (fn2-pool-wfp (mv-nth 2 (fn2-run-layout-encode sid lv base slot gen off okind oslot ogen fn2-fields fn2-pool)))
                  (equal (fn2-pool-rows (mv-nth 2 (fn2-run-layout-encode sid lv base slot gen off okind oslot ogen fn2-fields fn2-pool)))
                         (fn2-pool-rows fn2-pool))))
    :hints (("Goal" :in-theory (disable fn2-poolp fn2-pool-wfp fn2-pool-rows))))
   (defthm fn2-run-layout-size-natp
    (implies (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (natp base)
                  (<= (+ base *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields)))
             (natp (fn2-run-layout-size sid lv base fn2-fields)))
    :rule-classes :type-prescription)
   (in-theory (disable fn2-run-layout-decode fn2-run-layout-encode fn2-run-layout-size fn2-run-layout-compare))))

; ---------------------------------------------------------------------------
; Written once over the dispatcher.

; The append (ready, then write) and the page seek.
(defmacro fn2-ra-page-events ()
 '(progn
   ; Whether entry EBASE can be appended now: :ok, or the refusal; nothing changes.
   (defun fn2-run-add-ready (w sid ebase fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
     :guard (and (fn2-run-writers-wfp fn2-run-writers) (fn2-run-restarts-wfp fn2-run-restarts)
                 (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
    (b* ((code (fn2-run-add-check w sid ebase fn2-run-writers fn2-run-restarts fn2-fields))
         ((unless (eq code :ok)) code)
         (lv (fn2-run-writers-level w fn2-run-writers))
         ((when (zp (fn2-run-layout-fields sid lv))) :schema)
         (prev (+ (nfix (fn2-run-writers-fields w fn2-run-writers)) *fn2-run-prev-fields*))
         ((unless (<= (+ prev *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields))) :bounds)
         (okind (fn2-run-writers-okind w fn2-run-writers)) (oslot (fn2-run-writers-oslot w fn2-run-writers))
         (ogen (fn2-run-writers-ogen w fn2-run-writers))
         ((mv code order) (if (equal (fn2-run-writers-prev w fn2-run-writers) 1)
                              (fn2-run-layout-compare sid ebase prev okind oslot ogen okind oslot ogen fn2-fields fn2-pool)
                            (mv :ok :gt)))
         ((unless (eq code :ok)) code)
         ((unless (eq order :gt)) :order)
         ((unless (fn2-run-roomp w (fn2-run-layout-size sid lv ebase fn2-fields) fn2-run-writers)) :full))
     :ok))
   ; Note the restart, encode at the cursor, decode it back as the previous
   ; key, and commit; a failure past the restart fails the writer.
   (defun fn2-run-add-write (w sid ebase fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
     :guard (and (fn2-run-writers-wfp fn2-run-writers) (fn2-run-restarts-wfp fn2-run-restarts)
                 (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))
     :guard-hints (("Goal" :in-theory (disable fn2-run-note-restart fn2-run-add-commit
                                               fn2-run-writers-rows fn2-run-restarts-rows fn2-fields-rows)))))
    (b* ((code (fn2-run-add-check w sid ebase fn2-run-writers fn2-run-restarts fn2-fields))
         ((unless (eq code :ok)) (mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         (lv (fn2-run-writers-level w fn2-run-writers))
         (slot (fn2-run-writers-slot w fn2-run-writers)) (gen (fn2-run-writers-gen w fn2-run-writers))
         (okind (fn2-run-writers-okind w fn2-run-writers)) (oslot (fn2-run-writers-oslot w fn2-run-writers))
         (ogen (fn2-run-writers-ogen w fn2-run-writers))
         (cursor (fn2-run-writers-cursor w fn2-run-writers))
         (prev (+ (nfix (fn2-run-writers-fields w fn2-run-writers)) *fn2-run-prev-fields*))
         ((unless (<= (+ prev *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields)))
          (mv :bounds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         ((mv code fn2-run-writers fn2-run-restarts) (fn2-run-note-restart w fn2-run-writers fn2-run-restarts))
         ((mv code end fn2-pool)
          (if (eq code :ok) (fn2-run-layout-encode sid lv ebase slot gen cursor okind oslot ogen fn2-fields fn2-pool)
            (mv code cursor fn2-pool)))
         ((mv code & fn2-fields)
          (if (eq code :ok) (fn2-run-layout-decode sid lv prev slot gen cursor end okind oslot ogen fn2-fields fn2-pool)
            (mv code end fn2-fields)))
         ((mv code fn2-run-writers) (fn2-run-add-commit w code end fn2-run-writers)))
     (mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)))
   (fn2-fc-shape fn2-run-add-write-shape (fn2-run-add-write w sid ebase fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
    (and (fn2-run-writersp fn2-run-writers) (fn2-run-restartsp fn2-run-restarts) (fn2-fieldsp fn2-fields) (fn2-poolp fn2-pool)
         (fn2-run-writers-wfp fn2-run-writers) (fn2-run-restarts-wfp fn2-run-restarts)
         (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))
    ((fn2-run-writers 1) (fn2-run-restarts 2) (fn2-fields 3) (fn2-pool 4)))
   (in-theory (disable fn2-run-add-ready fn2-run-add-write))
   ; Append one entry (writer level 0) or index entry (level >= 1) of schema
   ; SID to an open writer, in strict key order: :ok, :full (no room; nothing
   ; changed), :order (not above the previous key), or a refusal by name.
   (defun fn2-run-add (w sid ebase fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
     :guard (and (fn2-run-writers-wfp fn2-run-writers) (fn2-run-restarts-wfp fn2-run-restarts)
                 (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
    (let ((code (fn2-run-add-ready w sid ebase fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)))
     (if (eq code :ok) (fn2-run-add-write w sid ebase fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
       (mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))))
   (fn2-ra-shape fn2-run-add-shape (fn2-run-add w sid ebase fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
    (and (fn2-run-writersp fn2-run-writers) (fn2-run-restartsp fn2-run-restarts) (fn2-fieldsp fn2-fields) (fn2-poolp fn2-pool)
         (fn2-run-writers-wfp fn2-run-writers) (fn2-run-restarts-wfp fn2-run-restarts)
         (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))
    ((fn2-run-writers 1) (fn2-run-restarts 2) (fn2-fields 3) (fn2-pool 4))
    (fn2-run-writers-rows fn2-run-restarts-rows fn2-fields-rows fn2-pool-rows))
   (in-theory (disable fn2-run-add))

   ; Lower bound inside one read page of schema SID at level LV: the first
   ; entry whose key is >= the query at QBASE. Binary search over restarts
   ; (LO, HI), then a linear decode inside one restart interval (IDX, OFF;
   ; OFF = 0 means not started). At most STEPS entry decodes per call; :more
   ; returns the continuation. (:found idx), (:absent idx), idx = entries
   ; past the end.
   (defun fn2-run-seek (sid lv steps lo hi idx off qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-fields fn2-pool) :measure (nfix steps)
     :guard (and (fn2-run-readerp rb fn2-fields) (fn2-pool-wfp fn2-pool)
                 (natp steps) (natp lo) (natp hi) (natp idx) (natp off)
                 (natp qbase) (<= (+ qbase *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields)))
     :guard-hints (("Goal" :in-theory (disable fn2-run-restart-offset fn2-fields-rows)))))
    (b* (((when (zp steps)) (mv :more lo hi idx off fn2-fields))
         (entries (fn2-run-hdr rb entries))
         (dir (fn2-run-directory rb fn2-fields))
         (eb (+ rb *fn2-run-reader-entry*))
         ((when (zp entries)) (mv :absent lo hi 0 off fn2-fields))
         ((when (< lo hi))
          (b* ((mid (floor (+ lo hi) 2))
               ((mv code at fn2-fields) (fn2-run-restart-offset mid slot gen rb pk ps pg fn2-fields fn2-pool))
               ((unless (eq code :ok)) (mv code lo hi idx off fn2-fields))
               ((mv code & fn2-fields) (fn2-run-layout-decode sid lv eb slot gen at dir pk ps pg fn2-fields fn2-pool))
               ((unless (eq code :ok)) (mv code lo hi idx off fn2-fields))
               ((mv code order) (fn2-run-layout-compare sid eb qbase pk ps pg qk qs qg fn2-fields fn2-pool))
               ((unless (eq code :ok)) (mv code lo hi idx off fn2-fields)))
           (if (eq order :lt)
               (fn2-run-seek sid lv (- steps 1) (+ 1 mid) hi idx off qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool)
             (fn2-run-seek sid lv (- steps 1) lo mid idx off qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool))))
         ((when (equal off 0))
          (b* ((j (if (zp lo) 0 (- lo 1)))
               ((mv code at fn2-fields) (fn2-run-restart-offset j slot gen rb pk ps pg fn2-fields fn2-pool))
               ((unless (eq code :ok)) (mv code lo hi idx off fn2-fields)))
           (fn2-run-seek sid lv (- steps 1) lo hi (* j *fn2-run-restart-interval*) at qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool)))
         ((when (<= entries idx)) (mv :absent lo hi idx off fn2-fields))
         ((unless (< off dir)) (mv :format lo hi idx off fn2-fields))
         ((mv code next fn2-fields) (fn2-run-layout-decode sid lv eb slot gen off dir pk ps pg fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv code lo hi idx off fn2-fields))
         ((mv code order) (fn2-run-layout-compare sid eb qbase pk ps pg qk qs qg fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv code lo hi idx off fn2-fields)))
     (case order
      (:eq (mv :found lo hi idx off fn2-fields))
      (:gt (mv :absent lo hi idx off fn2-fields))
      (otherwise (if (and (natp next) (< off next))
                     (fn2-run-seek sid lv (- steps 1) lo hi (+ 1 idx) next qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool)
                   (mv :format lo hi idx off fn2-fields))))))
   (defthm fn2-run-seek-shape
    (implies (and (fn2-fieldsp fn2-fields) (fn2-run-readerp rb fn2-fields))
             (and (fn2-fieldsp (mv-nth 5 (fn2-run-seek sid lv steps lo hi idx off qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool)))
                  (fn2-fields-wfp (mv-nth 5 (fn2-run-seek sid lv steps lo hi idx off qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool)))
                  (equal (fn2-fields-rows (mv-nth 5 (fn2-run-seek sid lv steps lo hi idx off qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool)))
                         (fn2-fields-rows fn2-fields))))
    :hints (("Goal" :induct (fn2-run-seek sid lv steps lo hi idx off qbase rb slot gen pk ps pg qk qs qg fn2-fields fn2-pool)
             :in-theory (disable fn2-run-restart-offset fn2-run-directory fn2-run-header-value fn2-run-layout-compare
                                 fn2-fieldsp fn2-fields-wfp fn2-fields-rows))))
   (in-theory (disable fn2-run-seek))))

; Build: NAME-free entry points over a build row whose schema names the
; layouts. FN2-RUN-BUILD-ADD appends one entry at level 0: :ok,
; :need-page, :busy while page work is pending, or :more after a full page
; started closing (the entry is not taken; keep its rows and retry after the
; work). FN2-RUN-BUILD-PROMOTE turns sealed level L's first key and
; parent-held reference into one entry of level L+1.
(defmacro fn2-ra-build-events ()
 '(progn
   (defun fn2-run-build-add (b ebase fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
     :guard (and (fn2-run-buildp b fn2-run-builds fn2-run-writers) (fn2-run-restarts-wfp fn2-run-restarts)
                 (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))
     :guard-hints (("Goal" :in-theory (disable fn2-run-close fn2-run-writers-rows)))))
    (b* (((unless (equal (fn2-run-builds-phase b fn2-run-builds) *fn2-run-build-phase-adding*))
          (mv :state fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         ((when (zp (fn2-run-builds-height b fn2-run-builds)))
          (let ((fn2-run-builds (fn2-run-builds-set-height b 1 fn2-run-builds)))
           (mv :need-page fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)))
         (w (fn2-run-builds-wbase b fn2-run-builds))
         (phase (fn2-run-writers-phase w fn2-run-writers))
         ((when (equal phase *fn2-run-writer-phase-idle*))
          (mv :need-page fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         ((unless (equal phase *fn2-run-writer-phase-open*))
          (mv :busy fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         ((mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
          (fn2-run-add w (fn2-run-builds-schema b fn2-run-builds) ebase fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         ((when (eq code :full))
          (mv-let (code fn2-run-writers) (fn2-run-close w fn2-run-writers)
           (mv (if (eq code :ok) :more code) fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)))
         ((unless (eq code :ok)) (mv code fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         (entries (+ 1 (fn2-run-builds-entries b fn2-run-builds)))
         ((unless (unsigned-byte-p 60 entries)) (mv :bounds fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
         (fn2-run-builds (fn2-run-builds-set-entries b entries fn2-run-builds)))
     (mv :ok fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)))
   (defun fn2-run-build-promote (b l fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-digests)
    (declare (xargs :stobjs (fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-digests)
     :guard (and (fn2-run-buildp b fn2-run-builds fn2-run-writers) (fn2-run-restarts-wfp fn2-run-restarts)
                 (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (fn2-digests-wfp fn2-digests) (natp l))
     :guard-hints (("Goal" :in-theory (disable fn2-run-writers-rows fn2-fields-rows fn2-run-promote-check)))))
    (b* ((sid (fn2-run-builds-schema b fn2-run-builds))
         (w (+ (nfix (fn2-run-builds-wbase b fn2-run-builds)) (nfix l)))
         (ib (+ (nfix (fn2-run-builds-fields b fn2-run-builds)) *fn2-run-build-index*))
         (nkeys (fn2-run-layout-keys sid))
         ((unless (and (< (+ 1 w) (fn2-run-writers-rows fn2-run-writers))
                       (<= (+ ib *fn2-run-entry-rows*) (fn2-fields-rows fn2-fields))
                       (natp nkeys)))
          (mv :bounds fn2-run-builds fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-digests))
         (slot (fn2-run-writers-slot w fn2-run-writers)) (gen (fn2-run-writers-gen w fn2-run-writers))
         (okind (fn2-run-builds-okind b fn2-run-builds)) (oslot (fn2-run-builds-oslot b fn2-run-builds))
         (ogen (fn2-run-builds-ogen b fn2-run-builds))
         (end (fn2-run-writers-cursor w fn2-run-writers))
         (hrow (+ (nfix (fn2-run-builds-hbase b fn2-run-builds)) (nfix l)))
         (hslot (fn2-run-builds-hslot b fn2-run-builds)) (hgen (fn2-run-builds-hgen b fn2-run-builds))
         ((mv code fn2-run-builds) (fn2-run-promote-check b l fn2-run-builds fn2-run-writers))

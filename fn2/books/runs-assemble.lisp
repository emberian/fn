; Per-schema keystones over the generic adapters; names and statements are
; the schema's own, so a schema's obligations are its rows in fn2-squares.
(defun fn2-ra-keystone-events (rows)
 (declare (xargs :verify-guards nil))
 (if (atom rows) nil
  (let* ((name (caar rows)) (row (cdar rows)) (id (fn2-decl-get :id row)) (key (fn2-decl-get :key row))
         (layout (fn2-codec-constant (car (fn2-decl-get :layouts row)) "")))
   (list*
    `(defthm-owed ,(fn2-columns-sym name "-PAGE-ROUNDTRIP") (meta entries)
      (implies (fn2-run-page-inputp ,layout ',key meta entries)
               (equal (fn2-run-page-image ,id ,layout meta entries) (list :ok :ok :ok (fn2-run-page-spec ,layout meta entries))))
      :teeth (,(fn2-columns-sym name "-PAGE-ROUNDTRIP-POSITIVE") ,(fn2-columns-sym name "-PAGE-ROUNDTRIP-NEGATIVE"))
      :doc "The real writer, sealer and B's checker produce and accept exactly the specified page octets.")
    `(defthm-owed ,(fn2-columns-sym name "-SEEK-LOWER-BOUND") (meta entries q)
      (implies (and (fn2-run-page-inputp ,layout ',key meta entries) (fn2-run-values-layoutp ,layout q))
               (equal (fn2-run-seek-image ,id ,layout meta entries q) (fn2-run-lower-bound-spec ',key entries q 0)))
      :teeth (,(fn2-columns-sym name "-SEEK-LOWER-BOUND-POSITIVE") ,(fn2-columns-sym name "-SEEK-LOWER-BOUND-NEGATIVE"))
      :doc "The real page seek returns the first entry whose key is at least the query, and whether it is equal.")
    `(defthm-owed ,(fn2-columns-sym name "-RUN-LOOKUP-EXACT") (entries limit q)
      (implies (and (fn2-run-run-inputp ,layout ',key entries limit) (fn2-run-values-layoutp ,layout q))
               (equal (fn2-run-lookup-image ,id ,layout entries limit q) (fn2-run-key-lookup-spec ',key entries q)))
      :teeth (,(fn2-columns-sym name "-RUN-LOOKUP-EXACT-POSITIVE") ,(fn2-columns-sym name "-RUN-LOOKUP-EXACT-NEGATIVE"))
      :doc "A run built through the real build entry points and searched through the real cursor steps finds the entry whose key equals the query, and only that; otherwise it answers :absent.")
    (fn2-ra-keystone-events (cdr rows))))))

; ---------------------------------------------------------------------------
; The glue check. A schema's build and lookup path is the generic entry
; points, the dispatcher, its codecs and key order, every function its
; declaration generated, and any per-schema glue by the old names that
; exists. Each must be :common-lisp-compliant, or the schema is refused by
; name: (:unverified schema function). The snapshot pairs each schema with
; (function . symbol-class) for its path, taken from the world.
(defconst *fn2-run-glue-generic*
 '(fn2-run-layout-fields fn2-run-layout-keys fn2-run-layout-decode fn2-run-layout-encode
   fn2-run-layout-size fn2-run-layout-compare fn2-run-add-ready fn2-run-add-write fn2-run-add fn2-run-seek fn2-run-build-add
   fn2-run-build-promote fn2-run-build-work fn2-run-build-start fn2-run-build-page fn2-run-build-finish
   fn2-run-index-skip fn2-run-index-nth fn2-run-step-header fn2-run-step-seek fn2-run-step-child fn2-run-lookup-step fn2-run-cursor-start fn2-run-cache-install))
(defconst *fn2-run-glue-old-suffixes*
 '("-ENTRY-ADD" "-INDEX-ADD" "-ENTRY-SEEK" "-INDEX-SEEK" "-BUILD-ADD" "-BUILD-PROMOTE"
   "-INDEX-SKIP" "-INDEX-NTH" "-LOOKUP-STEP"))
(defun fn2-ra-sym-list (name suffixes)
 (declare (xargs :verify-guards nil))
 (if (atom suffixes) nil (cons (fn2-columns-sym name (car suffixes)) (fn2-ra-sym-list name (cdr suffixes)))))
(defun fn2-ra-existing-old (names world)
 (declare (xargs :verify-guards nil))
 (if (atom names) nil
  (if (function-symbolp (car names) world) (cons (car names) (fn2-ra-existing-old (cdr names) world))
    (fn2-ra-existing-old (cdr names) world))))
(defun fn2-ra-generated-functions (manifest)
 (declare (xargs :verify-guards nil))
 (if (atom manifest) nil
  (if (eq (caar manifest) :function) (cons (cadar manifest) (fn2-ra-generated-functions (cdr manifest)))
    (fn2-ra-generated-functions (cdr manifest)))))
(defun fn2-ra-classes (names world)
 (declare (xargs :verify-guards nil))
 (if (atom names) nil
  (cons (cons (car names) (getpropc (car names) 'symbol-class nil world)) (fn2-ra-classes (cdr names) world))))
; The first function of PAIRS that is not guard-verified, or nil.
(defun fn2-run-glue-unverified (pairs)
 (declare (xargs :guard t))
 (cond ((atom pairs) nil)
       ((and (consp (car pairs)) (eq (cdar pairs) :common-lisp-compliant)) (fn2-run-glue-unverified (cdr pairs)))
       (t (if (consp (car pairs)) (caar pairs) (car pairs)))))
(defun fn2-run-glue-check (snapshot)
 (declare (xargs :guard t))
 (cond ((atom snapshot) :ok)
       ((not (consp (car snapshot))) (list :unverified nil nil))
       ((fn2-run-glue-unverified (cdar snapshot)) (list :unverified (caar snapshot) (fn2-run-glue-unverified (cdar snapshot))))
       (t (fn2-run-glue-check (cdr snapshot)))))
(defun fn2-ra-glue-names (name row world)
 (declare (xargs :verify-guards nil))
 (let ((layouts (fn2-decl-get :layouts row)))
  (append *fn2-run-glue-generic*
          (list (fn2-columns-sym (car layouts) "-ENCODE") (fn2-columns-sym (car layouts) "-DECODE")
                (fn2-columns-sym (car layouts) "-SIZE") (fn2-columns-sym (cadr layouts) "-ENCODE")
                (fn2-columns-sym (cadr layouts) "-DECODE") (fn2-columns-sym (cadr layouts) "-SIZE")
                (fn2-decl-get :compare row))
          (fn2-ra-generated-functions (fn2-decl-get :generated row))
          (fn2-ra-existing-old (fn2-ra-sym-list name *fn2-run-glue-old-suffixes*) world))))
(defun fn2-ra-glue-snapshot (rows world)
 (declare (xargs :verify-guards nil))
 (if (atom rows) nil
  (cons (cons (caar rows) (fn2-ra-classes (fn2-ra-glue-names (caar rows) (cdar rows) world) world))
        (fn2-ra-glue-snapshot (cdr rows) world))))
;; One assembly per world, after its last schema. The owed row records the
;; certify-time check; its teeth: the assembled schemas pass, and a schema
;; carrying per-schema glue admitted without guard verification is refused
;; by name.
(defmacro fn2-run-assemble ()
 '(progn
   (make-event
    (if (fn2-rs-assembled (w state))
        (er soft 'fn2-run-assemble "The runs are already assembled: ~x0." (fn2-rs-assembled (w state)))
      (value `(table fn2-run-assembly :schemas ',(strip-cars (fn2-decl-rows :schema (w state))))))
    :check-expansion t)
   (make-event (value (cons 'progn (fn2-ra-dispatch-events (fn2-decl-rows :schema (w state))))))
   (fn2-ra-shape-events)
   (fn2-ra-page-events)
   (fn2-ra-build-events)
   (fn2-ra-lookup-events)
   (fn2-ra-adapter-events)
   (make-event (value (cons 'progn (fn2-ra-keystone-events (fn2-decl-rows :schema (w state))))))
   (make-event
    (value `(defun fn2-run-glue-assembled ()
              (declare (xargs :guard t))
              ',(fn2-ra-glue-snapshot (fn2-decl-rows :schema (w state)) (w state)))))
   (defthm-owed fn2-run-glue-verified ()
    (equal (fn2-run-glue-check (fn2-run-glue-assembled)) :ok)
    :teeth (fn2-run-glue-verified-positive fn2-run-glue-verified-negative)
    :doc "Every assembled schema's build and lookup path (generic entry points, dispatcher, codecs, key order, generated functions, any per-schema glue) is guard-verified; the assembly refuses otherwise, by name.")
   (make-event
    (let ((r (fn2-run-glue-check (fn2-run-glue-assembled))))
     (if (eq r :ok) (value '(value-triple :glue-verified))
       (er soft 'fn2-run-assemble "Run schema ~x0: ~x1 is not guard-verified." (cadr r) (caddr r)))))))

   (in-theory (disable fn2-run-build-add fn2-run-build-promote))))

;; Lookup and scan. FN2-RUN-NTH decodes entry K of a read page at level LV
;; into the reader's entry rows (restart, then at most 15 skips) and returns
;; the offset after it. FN2-RUN-LOOKUP-STEP advances cursor C by at most BUDGET
;; decodes: :more, :miss (load the page whose reference the cursor names,
;; verify it under its parent-held hash, put it in the cache, and step again),
;; or the final :found / :absent with the level-0 entry decoded in the reader
;; rows. Every page the descent visits is noted in the cursor's path.
;; FN2-RUN-SCAN-STEP continues from a lower bound: :entry (the next entry in
;; key order is in the reader rows), :more, :miss, :end (no entry is left), or
;; :lost (a page of the path left the cache: re-seek strictly after the last
;; delivered key).
(defmacro fn2-ra-lookup-events ()
 '(progn
   (defun fn2-run-skip (sid lv m off slot gen rb okind oslot ogen fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-fields fn2-pool) :measure (nfix m)
     :guard (and (fn2-run-readerp rb fn2-fields) (fn2-pool-wfp fn2-pool) (natp m) (natp off))
     :guard-hints (("Goal" :in-theory (disable fn2-fields-rows)))))
    (if (zp m) (mv :ok off fn2-fields)
     (b* ((eb (+ rb *fn2-run-reader-entry*))
          ((mv code next fn2-fields)
           (fn2-run-layout-decode sid lv eb slot gen off (fn2-run-directory rb fn2-fields) okind oslot ogen fn2-fields fn2-pool))
          ((unless (and (eq code :ok) (natp next) (< off next))) (mv (if (eq code :ok) :format code) off fn2-fields)))
      (fn2-run-skip sid lv (- m 1) next slot gen rb okind oslot ogen fn2-fields fn2-pool))))
   (fn2-fc-shape fn2-run-skip-shape (fn2-run-skip sid lv m off slot gen rb okind oslot ogen fn2-fields fn2-pool)
    (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)) ((fn2-fields 2)))
   (defthm fn2-run-skip-natp
    (implies (natp off) (natp (mv-nth 1 (fn2-run-skip sid lv m off slot gen rb okind oslot ogen fn2-fields fn2-pool))))
    :rule-classes :type-prescription)
   (in-theory (disable fn2-run-skip))
   (defun fn2-run-nth (sid lv k slot gen rb okind oslot ogen fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-fields fn2-pool)
     :guard (and (fn2-run-readerp rb fn2-fields) (fn2-pool-wfp fn2-pool) (natp k))
     :guard-hints (("Goal" :in-theory (disable fn2-fields-rows fn2-run-restart-offset)))))
    (b* ((j (floor k *fn2-run-restart-interval*))
         ((mv code at fn2-fields) (fn2-run-restart-offset j slot gen rb okind oslot ogen fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv code 0 fn2-fields))
         ((mv code at fn2-fields)
          (fn2-run-skip sid lv (nfix (mod k *fn2-run-restart-interval*)) at slot gen rb okind oslot ogen fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv code 0 fn2-fields)))
     (fn2-run-layout-decode sid lv (+ rb *fn2-run-reader-entry*) slot gen at (fn2-run-directory rb fn2-fields)
                            okind oslot ogen fn2-fields fn2-pool)))
   (fn2-fc-shape fn2-run-nth-shape (fn2-run-nth sid lv k slot gen rb okind oslot ogen fn2-fields fn2-pool)
    (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-run-readerp rb fn2-fields)) ((fn2-fields 2)))
   (in-theory (disable fn2-run-nth))
   ;; The phases of a cursor step, each guard-verified on its own; the steps
   ;; dispatch on the cursor's phase.
   (defmacro fn2-ra-step-guard ()
    '(and (fn2-run-cursors-wfp fn2-run-cursors) (natp c) (< c (fn2-run-cursors-rows fn2-run-cursors))

     (b* (((mv code & fn2-fields) (fn2-ov-entry 0 i *fn2-run-adapter-reader* fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
          (e (if (eq code :ok) (fn2-run-unload-values layout *fn2-run-adapter-reader* fn2-fields fn2-pool) (list code)))
          ((mv rest fn2-fields) (fn2-ov-adapter-read (- k 1) (+ 1 (nfix i)) layout fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
      (mv (cons e rest) fn2-fields))))

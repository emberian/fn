; Per-schema keystones over the generic adapters; names and statements are
; the schema's own, so a schema's obligations are its rows in fn2-squares.
(defun fn2-ra-keystone-events (rows)
 (declare (xargs :verify-guards nil))
 (if (atom rows) nil
  (let* ((name (caar rows)) (row (cdar rows)) (id (fn2-decl-get :id row)) (key (fn2-decl-get :key row))
         (layout (fn2-codec-constant (car (fn2-decl-get :layouts row)) "")))
   (list*
    `(defthm-owed ,(fn2-columns-sym name "-PAGE-ROUNDTRIP") (meta entries)
      (implies (fn2-run-page-inputp ,layout ',key meta entries)
               (equal (fn2-run-page-image ,id ,layout meta entries) (list :ok :ok :ok (fn2-run-page-spec ,layout meta entries))))
      :teeth (,(fn2-columns-sym name "-PAGE-ROUNDTRIP-POSITIVE") ,(fn2-columns-sym name "-PAGE-ROUNDTRIP-NEGATIVE"))
      :schema :g1 :claim :representation :shared ((:schema ,name))
      :doc "The real writer, sealer and B's checker produce and accept exactly the specified page octets.")
    `(defthm-owed ,(fn2-columns-sym name "-SEEK-LOWER-BOUND") (meta entries q)
      (implies (and (fn2-run-page-inputp ,layout ',key meta entries) (fn2-run-values-layoutp ,layout q))
               (equal (fn2-run-seek-image ,id ,layout meta entries q) (fn2-run-lower-bound-spec ',key entries q 0)))
      :teeth (,(fn2-columns-sym name "-SEEK-LOWER-BOUND-POSITIVE") ,(fn2-columns-sym name "-SEEK-LOWER-BOUND-NEGATIVE"))
      :schema :g1 :claim :representation :shared ((:schema ,name))
      :doc "The real page seek returns the first entry whose key is at least the query, and whether it is equal.")
    `(defthm-owed ,(fn2-columns-sym name "-RUN-LOOKUP-EXACT") (entries limit q)
      (implies (and (fn2-run-run-inputp ,layout ',key entries limit) (fn2-run-values-layoutp ,layout q))
               (equal (fn2-run-lookup-image ,id ,layout entries limit q) (fn2-run-key-lookup-spec ',key entries q)))
      :teeth (,(fn2-columns-sym name "-RUN-LOOKUP-EXACT-POSITIVE") ,(fn2-columns-sym name "-RUN-LOOKUP-EXACT-NEGATIVE"))
      :schema :g1 :claim :representation :shared ((:schema ,name))
      :doc "A run built through the real build entry points and searched through the real cursor steps finds the entry whose key equals the query, and only that; otherwise it answers :absent.")
    `(defthm-owed ,(fn2-columns-sym name "-RUN-SCAN") (entries limit q n)
      (implies (and (fn2-run-run-inputp ,layout ',key entries limit) (fn2-run-values-layoutp ,layout q) (natp n))
               (equal (fn2-run-scan-image ,id ,layout entries limit q n) (fn2-run-scan-spec ',key entries q n)))
      :teeth (,(fn2-columns-sym name "-RUN-SCAN-POSITIVE") ,(fn2-columns-sym name "-RUN-SCAN-NEGATIVE"))
      :schema :g1 :claim :representation :shared ((:schema ,name))
      :doc "A scan positioned at the lower bound of the query through the real cursor steps delivers the run's entries in key order, across pages and levels, and ends exactly when they do.")
    `(defthm-owed ,(fn2-columns-sym name "-OVERLAY-SORTED") (entries)
      (implies (fn2-ov-inputp ,layout ',key entries)
               (equal (fn2-ov-image ,id ,layout entries) (fn2-ov-image-spec ',key entries)))
      :teeth (,(fn2-columns-sym name "-OVERLAY-SORTED-POSITIVE") ,(fn2-columns-sym name "-OVERLAY-SORTED-NEGATIVE"))
      :schema :g1 :claim :representation :shared ((:schema ,name))
      :doc "Entries inserted into the active overlay in any order through the real insert all succeed when their keys are distinct, and read back in key order.")
    (fn2-ra-keystone-events (cdr rows))))))

; ---------------------------------------------------------------------------

          ((mv code fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
           (if (eq code :ok) (fn2-ov-insert 0 *fn2-run-adapter-entry* *fn2-run-adapter-reader* fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
             (mv (list :load code) fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
          ((mv rest fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
           (fn2-ov-adapter-load sid layout (cdr entries) src sgen off fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
      (mv (cons code rest) fn2-overlays fn2-overlay-index fn2-fields fn2-pool))))

         ((unless (and (eq code :ok) (< 0 level)))
          (mv-let (c2 fn2-run-cursors) (fn2-run-cursor-save c *fn2-run-cursor-phase-failed* level slot gen lo hi idx off unit counter fn2-run-cursors)
           (declare (ignore c2)) (mv (if (eq code :ok) :state code) fn2-run-cursors fn2-run-paths fn2-fields)))

   ;; zero), or move up when the leaf is exhausted.
   (defun fn2-run-step-deliver (c sid idx off slot gen unit counter rb ok os og fn2-run-cursors fn2-run-paths fn2-fields fn2-pool)
    (declare (xargs :stobjs (fn2-run-cursors fn2-run-paths fn2-fields fn2-pool)
     :guard (and (fn2-run-cursors-wfp fn2-run-cursors) (natp c) (< c (fn2-run-cursors-rows fn2-run-cursors))
                 (fn2-run-paths-wfp fn2-run-paths) (fn2-run-readerp rb fn2-fields) (fn2-pool-wfp fn2-pool)
                 (natp idx) (natp off))
     :guard-hints (("Goal" :in-theory (disable fn2-run-cursor-save fn2-fields-rows)))))

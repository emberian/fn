            (fn2-run-cursor-save c *fn2-run-cursor-phase-miss* level slot gen lo hi idx off unit counter fn2-run-cursors))))
     (mv (cond ((not (eq c2 :ok)) c2) ((eq hit :ok) :more) (t :miss)) fn2-run-cursors fn2-run-paths fn2-fields)))

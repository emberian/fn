          (mv :bounds fn2-run-cursors fn2-run-paths fn2-fields))
         (unit (if childp (fn2-fields-value (+ cb *fn2-format-ref-field-physical-unit*) fn2-fields) unit))
         (counter (if childp (fn2-fields-value (+ cb *fn2-format-ref-field-allocation*) fn2-fields) counter))

 (declare (xargs :stobjs fn2-digests :verify-guards nil))
 (let* ((fn2-digests (fn2-digests-set-w0 dst (nth 0 words) fn2-digests))(fn2-digests (fn2-digests-set-w1 dst (nth 1 words) fn2-digests))(fn2-digests (fn2-digests-set-w2 dst (nth 2 words) fn2-digests))(fn2-digests (fn2-digests-set-w3 dst (nth 3 words) fn2-digests))(fn2-digests (fn2-digests-set-w4 dst (nth 4 words) fn2-digests))(fn2-digests (fn2-digests-set-w5 dst (nth 5 words) fn2-digests))(fn2-digests (fn2-digests-set-w6 dst (nth 6 words) fn2-digests))(fn2-digests (fn2-digests-set-w7 dst (nth 7 words) fn2-digests))) fn2-digests))

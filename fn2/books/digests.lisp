; B-owned digest rows. Capacity is chosen by the profile at initialization.
(in-package "ACL2")
(include-book "columns")
(defcolumns fn2-digests ((w0 :u32) (w1 :u32) (w2 :u32) (w3 :u32) (w4 :u32) (w5 :u32) (w6 :u32) (w7 :u32)))

(defconst *fn2-b3-iv* '(1779033703 3144134277 1013904242 2773480762
 1359893119 2600822924 528734635 1541459225))
(defconst *fn2-b3-empty-root* '(3108574127 2795633141 3930931360 1237965878
 3374697371 3071459757 3398671052 1647452132))
(defun fn2-digest-rowp (row fn2-digests)
 (declare (xargs :stobjs fn2-digests :guard t))
 (and (fn2-digests-wfp fn2-digests) (natp row) (< row (fn2-digests-rows fn2-digests))))
(defun fn2-digest-word (row i fn2-digests)
 (declare (xargs :stobjs fn2-digests :guard (and (fn2-digest-rowp row fn2-digests) (natp i) (< i 8))))
 (case i
  (0 (fn2-digests-w0 row fn2-digests))
  (1 (fn2-digests-w1 row fn2-digests))
  (2 (fn2-digests-w2 row fn2-digests))
  (3 (fn2-digests-w3 row fn2-digests))
  (4 (fn2-digests-w4 row fn2-digests))
  (5 (fn2-digests-w5 row fn2-digests))
  (6 (fn2-digests-w6 row fn2-digests))
  (otherwise (fn2-digests-w7 row fn2-digests))))
(defthm fn2-digest-word-type
 (implies (and (fn2-digestsp fn2-digests) (fn2-digest-rowp row fn2-digests))
  (unsigned-byte-p 32 (fn2-digest-word row i fn2-digests))))
(defthm fn2-digest-word-natp
 (implies (and (fn2-digestsp fn2-digests) (fn2-digest-rowp row fn2-digests))
  (natp (fn2-digest-word row i fn2-digests))) :rule-classes :type-prescription)
(defthm fn2-digest-word-bound
 (implies (and (fn2-digestsp fn2-digests) (fn2-digest-rowp row fn2-digests))
  (< (fn2-digest-word row i fn2-digests) 4294967296)) :rule-classes :linear)
(in-theory (disable fn2-digest-word))
(defun fn2-digest-set-word (row i word fn2-digests)
 (declare (xargs :stobjs fn2-digests :guard (and (fn2-digest-rowp row fn2-digests) (natp i) (< i 8) (unsigned-byte-p 32 word))))
 (case i
  (0 (fn2-digests-set-w0 row word fn2-digests))
  (1 (fn2-digests-set-w1 row word fn2-digests))
  (2 (fn2-digests-set-w2 row word fn2-digests))
  (3 (fn2-digests-set-w3 row word fn2-digests))
  (4 (fn2-digests-set-w4 row word fn2-digests))
  (5 (fn2-digests-set-w5 row word fn2-digests))
  (6 (fn2-digests-set-w6 row word fn2-digests))
  (otherwise (fn2-digests-set-w7 row word fn2-digests))))
(defthm fn2-digest-set-word-shape
 (implies (and (fn2-digest-rowp row fn2-digests) (fn2-digestsp fn2-digests) (unsigned-byte-p 32 word))
  (and (fn2-digestsp (fn2-digest-set-word row i word fn2-digests))
       (fn2-digests-wfp (fn2-digest-set-word row i word fn2-digests))
       (equal (fn2-digests-rows (fn2-digest-set-word row i word fn2-digests)) (fn2-digests-rows fn2-digests)))))
(in-theory (disable fn2-digest-set-word))
(defun fn2-digest-copy (dst src fn2-digests)
 (declare (xargs :stobjs fn2-digests :guard (and (fn2-digest-rowp dst fn2-digests) (fn2-digest-rowp src fn2-digests))))
 (let* (
  (fn2-digests (fn2-digests-set-w0 dst (fn2-digests-w0 src fn2-digests) fn2-digests))
  (fn2-digests (fn2-digests-set-w1 dst (fn2-digests-w1 src fn2-digests) fn2-digests))
  (fn2-digests (fn2-digests-set-w2 dst (fn2-digests-w2 src fn2-digests) fn2-digests))
  (fn2-digests (fn2-digests-set-w3 dst (fn2-digests-w3 src fn2-digests) fn2-digests))
  (fn2-digests (fn2-digests-set-w4 dst (fn2-digests-w4 src fn2-digests) fn2-digests))
  (fn2-digests (fn2-digests-set-w5 dst (fn2-digests-w5 src fn2-digests) fn2-digests))
  (fn2-digests (fn2-digests-set-w6 dst (fn2-digests-w6 src fn2-digests) fn2-digests))
  (fn2-digests (fn2-digests-set-w7 dst (fn2-digests-w7 src fn2-digests) fn2-digests))
) fn2-digests))
(defthm fn2-digest-copy-shape
 (implies (and (fn2-digest-rowp dst fn2-digests) (fn2-digest-rowp src fn2-digests) (fn2-digestsp fn2-digests))
  (and (fn2-digestsp (fn2-digest-copy dst src fn2-digests))
       (fn2-digests-wfp (fn2-digest-copy dst src fn2-digests))
       (equal (fn2-digests-rows (fn2-digest-copy dst src fn2-digests)) (fn2-digests-rows fn2-digests)))))
(in-theory (disable fn2-digest-copy))
(defun fn2-digest-equal (left right fn2-digests)
 (declare (xargs :stobjs fn2-digests :guard (and (fn2-digest-rowp left fn2-digests) (fn2-digest-rowp right fn2-digests))))
 (and
  (equal (fn2-digests-w0 left fn2-digests) (fn2-digests-w0 right fn2-digests))
  (equal (fn2-digests-w1 left fn2-digests) (fn2-digests-w1 right fn2-digests))
  (equal (fn2-digests-w2 left fn2-digests) (fn2-digests-w2 right fn2-digests))
  (equal (fn2-digests-w3 left fn2-digests) (fn2-digests-w3 right fn2-digests))
  (equal (fn2-digests-w4 left fn2-digests) (fn2-digests-w4 right fn2-digests))
  (equal (fn2-digests-w5 left fn2-digests) (fn2-digests-w5 right fn2-digests))
  (equal (fn2-digests-w6 left fn2-digests) (fn2-digests-w6 right fn2-digests))
  (equal (fn2-digests-w7 left fn2-digests) (fn2-digests-w7 right fn2-digests))
))
(in-theory (disable fn2-digest-equal))
; Named workspace regions. Each B continuation owns its part of one stripe.
; The profile allocates stripes plus caller-owned input/proof/result rows.
(defconst *fn2-digest-stride* 136)
(defconst *fn2-b3-cv* 0)
(defconst *fn2-b3-key* 1)
(defconst *fn2-b3-frontier* 2)
(defconst *fn2-b3-scratch* 56)
(defconst *fn2-b3-result* 57)
(defconst *fn2-mk-frontier* 58)
(defconst *fn2-mk-scratch* 118)
(defconst *fn2-mk-proof-new* 120)
(defconst *fn2-mk-proof-old* 121)
(defconst *fn2-mk-frozen-old* 122)
(defconst *fn2-mk-frozen-new* 123)
(defconst *fn2-mk-frozen-leaf* 124)
(defconst *fn2-fc-result* 125)
(defconst *fn2-fc-hash* 126)
(defconst *fn2-fc-geometry* 127)
(defconst *fn2-fc-previous-seal* 128)
(defun fn2-digest-slot (row region)
 (declare (xargs :guard (and (natp row) (natp region) (< region *fn2-digest-stride*))))
 (+ (* *fn2-digest-stride* row) region))
(defun fn2-digest-workspacep (row fn2-digests)
 (declare (xargs :stobjs fn2-digests :guard t))
 (and (fn2-digests-wfp fn2-digests) (natp row)
      (<= (* *fn2-digest-stride* (+ 1 row)) (fn2-digests-rows fn2-digests))))
(defun fn2-digest-iv (dst fn2-digests)
 (declare (xargs :stobjs fn2-digests :guard (fn2-digest-rowp dst fn2-digests)))
 (let* ((fn2-digests (fn2-digests-set-w0 dst (nth 0 *fn2-b3-iv*) fn2-digests)) (fn2-digests (fn2-digests-set-w1 dst (nth 1 *fn2-b3-iv*) fn2-digests)) (fn2-digests (fn2-digests-set-w2 dst (nth 2 *fn2-b3-iv*) fn2-digests)) (fn2-digests (fn2-digests-set-w3 dst (nth 3 *fn2-b3-iv*) fn2-digests)) (fn2-digests (fn2-digests-set-w4 dst (nth 4 *fn2-b3-iv*) fn2-digests)) (fn2-digests (fn2-digests-set-w5 dst (nth 5 *fn2-b3-iv*) fn2-digests)) (fn2-digests (fn2-digests-set-w6 dst (nth 6 *fn2-b3-iv*) fn2-digests)) (fn2-digests (fn2-digests-set-w7 dst (nth 7 *fn2-b3-iv*) fn2-digests))) fn2-digests))
(defthm fn2-digest-iv-shape
 (implies (and (fn2-digest-rowp dst fn2-digests) (fn2-digestsp fn2-digests))
  (and (fn2-digestsp (fn2-digest-iv dst fn2-digests))
       (fn2-digests-wfp (fn2-digest-iv dst fn2-digests))
       (equal (fn2-digests-rows (fn2-digest-iv dst fn2-digests)) (fn2-digests-rows fn2-digests)))))
(in-theory (disable fn2-digest-iv))
(defun fn2-digest-empty (dst fn2-digests)
 (declare (xargs :stobjs fn2-digests :guard (fn2-digest-rowp dst fn2-digests)))
 (let* ((fn2-digests (fn2-digests-set-w0 dst (nth 0 *fn2-b3-empty-root*) fn2-digests)) (fn2-digests (fn2-digests-set-w1 dst (nth 1 *fn2-b3-empty-root*) fn2-digests)) (fn2-digests (fn2-digests-set-w2 dst (nth 2 *fn2-b3-empty-root*) fn2-digests)) (fn2-digests (fn2-digests-set-w3 dst (nth 3 *fn2-b3-empty-root*) fn2-digests)) (fn2-digests (fn2-digests-set-w4 dst (nth 4 *fn2-b3-empty-root*) fn2-digests)) (fn2-digests (fn2-digests-set-w5 dst (nth 5 *fn2-b3-empty-root*) fn2-digests)) (fn2-digests (fn2-digests-set-w6 dst (nth 6 *fn2-b3-empty-root*) fn2-digests)) (fn2-digests (fn2-digests-set-w7 dst (nth 7 *fn2-b3-empty-root*) fn2-digests))) fn2-digests))
(defthm fn2-digest-empty-shape
 (implies (and (fn2-digest-rowp dst fn2-digests) (fn2-digestsp fn2-digests))
  (and (fn2-digestsp (fn2-digest-empty dst fn2-digests))
       (fn2-digests-wfp (fn2-digest-empty dst fn2-digests))
       (equal (fn2-digests-rows (fn2-digest-empty dst fn2-digests)) (fn2-digests-rows fn2-digests)))))
(in-theory (disable fn2-digest-empty))

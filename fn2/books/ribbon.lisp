         (mv-let (code fn2-ribbon-builds fn2-run-writers fn2-fields fn2-pool fn2-fc-context)
          (fn2-ribbon-head f fn2-ribbon-builds fn2-run-writers fn2-fields fn2-pool fn2-fc-context)
          (mv code fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)))
        ((equal phase *fn2-ribbon-phase-sealing*)
         (mv-let (code fn2-ribbon-builds fn2-run-writers fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
          (fn2-ribbon-seal f budget fn2-ribbon-builds fn2-run-writers fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
          (mv code fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)))
        (t (mv :state fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)))))

; ---------------------------------------------------------------------------
; Probe. The filter page is in the pool at PSLOT/PGEN, read under the run's
; owner PK PS PG, after B's checker accepted it under its parent-held hash;
; the header checks name malformed structure anyway. HB is a field region
; for the two headers; QROW the query's octet field, read under QK QS QG.
; :absent means the key is in no equation of this filter, so not in the run;
; :maybe means read the run.
(defun fn2-ribbon-probe-dot (k j s lo hi acc pslot pgen pk ps pg fn2-pool)
 (declare (xargs :stobjs fn2-pool :measure (nfix k)
  :guard (and (fn2-pool-wfp fn2-pool) (natp k) (natp j) (natp s)
              (unsigned-byte-p 32 lo) (unsigned-byte-p 32 hi) (unsigned-byte-p 8 acc))))
 (b* (((when (zp k)) (mv :ok acc))
      (bit (if (< j 32) (logbitp j lo) (logbitp (- j 32) hi)))
      ((unless bit) (fn2-ribbon-probe-dot (- k 1) (+ 1 j) s lo hi acc pslot pgen pk ps pg fn2-pool))
      ((mv code byte) (fn2-pool-read pslot pgen (+ *fn2-ribbon-base* s j) pk ps pg fn2-pool))
      ((unless (and (eq code :ok) (unsigned-byte-p 8 byte))) (mv (if (eq code :ok) :bounds code) acc)))
  (fn2-ribbon-probe-dot (- k 1) (+ 1 j) s lo hi (fn2-ribbon-xor8 acc byte) pslot pgen pk ps pg fn2-pool)))
(fn2-ribbon-ub fn2-ribbon-probe-dot-type 8 (unsigned-byte-p 8 acc)
 (mv-nth 1 (fn2-ribbon-probe-dot k j s lo hi acc pslot pgen pk ps pg fn2-pool)))
(in-theory (disable fn2-ribbon-probe-dot))
(defconst *fn2-ribbon-probe-fields* (+ *fn2-run-c-header-fields* *fn2-ribbon-header-num-fields*))
(defun fn2-ribbon-read-header (pslot pgen hb pk ps pg fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool)
  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool) (natp hb)
              (<= (+ hb *fn2-ribbon-probe-fields*) (fn2-fields-rows fn2-fields)))))
 (b* (((mv code & fn2-fields) (fn2-format-page-header-decode hb pslot pgen 0 *fn2-run-header-area* pk ps pg fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields))
      (c (+ hb *fn2-run-c-header-fields*))
      ((mv code & fn2-fields) (fn2-ribbon-header-decode c pslot pgen *fn2-run-header-area* *fn2-ribbon-base* pk ps pg fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields))
      (slots (fn2-fields-value (+ c *fn2-ribbon-header-field-slots*) fn2-fields)))
  (cond ((not (equal (fn2-fields-value (+ hb *fn2-format-page-header-field-magic*) fn2-fields) *fn2-format-page-magic*)) (mv :bad-magic fn2-fields))
        ((not (and (equal (fn2-fields-value (+ hb *fn2-format-page-header-field-page-kind*) fn2-fields) *page-kind-partitioned-filter*)
                   (equal (fn2-fields-value (+ hb *fn2-format-page-header-field-header-length*) fn2-fields) *fn2-run-header-area*)
                   (equal (fn2-fields-value (+ c *fn2-ribbon-header-field-width*) fn2-fields) *fn2-ribbon-width*)
                   (equal (fn2-fields-value (+ c *fn2-ribbon-header-field-bits*) fn2-fields) *fn2-ribbon-bits*)
                   (natp slots) (<= *fn2-ribbon-width* slots) (<= slots *fn2-ribbon-slots-max*)
                   (equal (fn2-fields-value (+ hb *fn2-format-page-header-field-payload-length*) fn2-fields)
                          (+ (- *fn2-ribbon-base* *fn2-run-header-area*) slots))
                   (unsigned-byte-p 32 (fn2-fields-value (+ c *fn2-ribbon-header-field-seed*) fn2-fields))))
         (mv :format fn2-fields))
        (t (mv :ok fn2-fields)))))
(fn2-fields-preserves fn2-ribbon-read-header (pslot pgen hb pk ps pg fn2-fields fn2-pool) :position 1
 :hyps ((fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (natp hb) (<= (+ hb *fn2-ribbon-probe-fields*) (fn2-fields-rows fn2-fields))))
(defun fn2-ribbon-probe (pslot pgen hb qrow qk qs qg pk ps pg fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool)
  :guard (and (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))
  :guard-hints (("Goal" :in-theory (disable fn2-ribbon-read-header)))))
 (b* (((unless (and (natp hb) (<= (+ hb *fn2-ribbon-probe-fields*) (fn2-fields-rows fn2-fields))
                    (natp qrow) (< qrow (fn2-fields-rows fn2-fields))))
       (mv :bounds fn2-fields))
      (len (fn2-fields-ref-len qrow fn2-fields)) (qslot (fn2-fields-ref-slot qrow fn2-fields))
      (qgen (fn2-fields-ref-gen qrow fn2-fields)) (qoff (fn2-fields-ref-off qrow fn2-fields))
      ((unless (and (natp len) (<= len *fn2-run-key-octets-max*) (natp qoff))) (mv :bounds fn2-fields))
      ((mv code fn2-fields) (fn2-ribbon-read-header pslot pgen hb pk ps pg fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields))
      (c (+ hb *fn2-run-c-header-fields*))
      (slots (nfix (fn2-fields-value (+ c *fn2-ribbon-header-field-slots*) fn2-fields)))
      (seed (fn2-fields-value (+ c *fn2-ribbon-header-field-seed*) fn2-fields))
      ((unless (unsigned-byte-p 32 seed)) (mv :format fn2-fields))
      ((mv code h1 h2) (fn2-ribbon-hash len qslot qgen qoff seed qk qs qg fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields))
      ((mv s lo hi) (fn2-ribbon-place h1 h2 slots))
      ((mv code acc) (fn2-ribbon-probe-dot 64 0 s lo hi 0 pslot pgen pk ps pg fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields)))
  (mv (if (equal acc 0) :maybe :absent) fn2-fields)))
(fn2-fields-preserves fn2-ribbon-probe (pslot pgen hb qrow qk qs qg pk ps pg fn2-fields fn2-pool) :position 1)
(in-theory (disable fn2-ribbon-probe))
(assert-event (fn2-assert-compliant-p '(fn2-ribbon-start fn2-ribbon-add fn2-ribbon-finish fn2-ribbon-work fn2-ribbon-probe) (w state)))

; ---------------------------------------------------------------------------
; Logic adapter (lists in, lists out; never served) and the keystones. One
; filter page is built through the real start, adds, finish and work from
; KEYS (octet lists) less the DROP-th, checked by B's checker against its
; parent-held hash, optionally mutated (MUTATE = (offset . xor-byte)) and
; checked again, then each query is probed through the real probe.
; Field plan: the writer's rows from 0, the probe's headers at 200, the key
; at 300, the query at 301; owner (9 0 1); digest row 136 takes the hash.
(defconst *fn2-rba-stobjs*
 '(fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests))
(defmacro fn2-rba-defun (name args &rest r)
 (let* ((measure (and (eq (car r) :measure) (cadr r))) (body (if measure (caddr r) (car r))))
  `(defun ,name ,(append args *fn2-rba-stobjs*)
    (declare (xargs :stobjs ,*fn2-rba-stobjs* :verify-guards nil ,@(and measure `(:measure ,measure))))
    ,body)))
(defmacro fn2-rba-mv (&rest values) `(mv ,@values ,@*fn2-rba-stobjs*))
(defmacro fn2-rba-call (name &rest args) `(,name ,@args ,@*fn2-rba-stobjs*))
(defconst *fn2-rba-key-layout* '((key (:octets 512))))

(defun fn2-ribbon-bytesp (x)
 (declare (xargs :verify-guards nil))
 (if (atom x) (null x) (and (unsigned-byte-p 8 (car x)) (fn2-ribbon-bytesp (cdr x)))))
(defun fn2-ribbon-keysp (x)
 (declare (xargs :verify-guards nil))
 (if (atom x) (null x)
  (and (fn2-ribbon-bytesp (car x)) (<= (len (car x)) 250) (fn2-ribbon-keysp (cdr x)))))
(defun fn2-ribbon-drop (keys drop)
 (declare (xargs :verify-guards nil))
 (if (and (natp drop) (< drop (len keys))) (append (take drop keys) (nthcdr (+ 1 drop) keys)) keys))
; Sound answers: one per query, each :maybe or :absent, and :absent only for
; a query that is not a key.
(defun fn2-ribbon-answers-sound (keys queries answers)
 (declare (xargs :verify-guards nil))
 (if (atom queries) (null answers)
  (and (consp answers)
       (or (eq (car answers) :maybe) (and (eq (car answers) :absent) (not (member-equal (car queries) keys))))
       (fn2-ribbon-answers-sound keys (cdr queries) (cdr answers)))))

(fn2-rba-defun fn2-rba-setup (n)
 (b* ((fn2-ribbon-builds (fn2-ribbon-builds-init 1 fn2-ribbon-builds))
      (fn2-ribbon-band (fn2-ribbon-band-init (fn2-ribbon-slots n) fn2-ribbon-band))
      (fn2-run-writers (fn2-run-writers-init 1 fn2-run-writers))
      (fn2-run-restarts (fn2-run-restarts-init *fn2-run-restart-capacity* fn2-run-restarts))
      (fn2-fields (fn2-fields-init 400 fn2-fields))
      (fn2-pool (fn2-pool-init '((3 . 65536)) 1 100 fn2-pool))
      (fn2-fc (fn2-fc-init 1 fn2-fc))
      (fn2-fc-context (fn2-fc-context-init 1 fn2-fc-context))
      (fn2-b3 (fn2-b3-table-init 1 fn2-b3))
      (fn2-digests (fn2-digests-init 140 fn2-digests)))
  (fn2-rba-mv :ok)))
(fn2-rba-defun fn2-rba-drive (fuel)
 (if (zp fuel) (fn2-rba-mv :fuel)
  (b* (((mv code fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
        (fn2-ribbon-work 0 4096 fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool
                         fn2-fc fn2-fc-context fn2-b3 fn2-digests)))
   (if (eq code :more) (fn2-rba-call fn2-rba-drive (- fuel 1)) (fn2-rba-mv code)))))
(fn2-rba-defun fn2-rba-adds (keys slot gen off)
 (if (atom keys) (fn2-rba-mv :ok)
  (b* (((mv code off fn2-fields fn2-pool) (fn2-run-load-values *fn2-rba-key-layout* (list (car keys)) 300 slot gen off 9 0 1 fn2-fields fn2-pool))
       ((unless (eq code :ok)) (fn2-rba-mv (list :load code)))
       ((mv code fn2-ribbon-builds fn2-ribbon-band) (fn2-ribbon-add 0 300 9 0 1 fn2-ribbon-builds fn2-ribbon-band fn2-fields fn2-pool))
       ((mv code fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
        (if (eq code :more) (fn2-rba-call fn2-rba-drive 100000) (fn2-rba-mv code)))
       ((unless (member-eq code '(:ok :idle))) (fn2-rba-mv (list :add code))))
   ;; the key arena is reused once it is half full (each key is hashed when added)
   (fn2-rba-call fn2-rba-adds (cdr keys) slot gen (if (< 32768 off) 0 off)))))
(fn2-rba-defun fn2-rba-probes (queries slot gen off pslot pgen)
 (if (atom queries) (fn2-rba-mv nil)
  (b* (((mv code off fn2-fields fn2-pool) (fn2-run-load-values *fn2-rba-key-layout* (list (car queries)) 301 slot gen off 9 0 1 fn2-fields fn2-pool))
       ((mv answer fn2-fields)
        (if (eq code :ok) (fn2-ribbon-probe pslot pgen 200 301 9 0 1 9 0 1 fn2-fields fn2-pool) (mv (list :load code) fn2-fields)))
       ;; the query arena is reused once it is half full
       (off (if (< 32768 off) 0 off))
       ((mv rest fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
        (fn2-rba-call fn2-rba-probes (cdr queries) slot gen off pslot pgen)))
   (fn2-rba-mv (cons answer rest)))))
(fn2-rba-defun fn2-rba-check (pslot pgen)
 (b* (((mv code fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
       (fn2-format-drive (fn2-format-fuel *fn2-run-page-size*) 0 :page nil pslot pgen 0 *fn2-run-page-size*
                         0 9 0 1 4096 fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)))
  (fn2-rba-mv code)))
(fn2-rba-defun fn2-rba-run (keys drop queries mutate)
 (b* ((kept (fn2-ribbon-drop keys drop))
      ((mv & fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
       (fn2-rba-call fn2-rba-setup (len kept)))
      ((mv & pslot pgen fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv code fn2-run-writers fn2-pool)
       (fn2-run-open 0 pslot pgen 1 1 0 7 0 *page-kind-partitioned-filter* 5 2 3 1 1 9 0 1 0 *fn2-run-page-size* fn2-run-writers fn2-pool))
      ((unless (eq code :ok)) (fn2-rba-mv (list :open code)))
      ((mv code fn2-ribbon-builds) (fn2-ribbon-start 0 0 0 136 0 (len kept) fn2-ribbon-builds fn2-ribbon-band fn2-run-writers))
      ((unless (eq code :ok)) (fn2-rba-mv (list :start code)))
      ((mv code fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
       (fn2-rba-call fn2-rba-drive 100000))
      ((unless (eq code :ready)) (fn2-rba-mv (list :clear code)))
      ((mv & kslot kgen fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv code fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
       (fn2-rba-call fn2-rba-adds kept kslot kgen 0))
      ((unless (eq code :ok)) (fn2-rba-mv code))
      ((mv code fn2-ribbon-builds) (fn2-ribbon-finish 0 fn2-ribbon-builds))
      ((unless (eq code :ok)) (fn2-rba-mv (list :finish code)))
      ((mv sealed fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
       (fn2-rba-call fn2-rba-drive 100000))
      ((mv check fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
       (fn2-rba-call fn2-rba-check pslot pgen))
      ((mv check fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
       (if (consp mutate)
           (b* (((mv & byte) (fn2-pool-read pslot pgen (car mutate) 9 0 1 fn2-pool))
                ((mv & fn2-pool) (fn2-pool-write pslot pgen (car mutate) (logxor (nfix (cdr mutate)) (nfix byte)) 9 0 1 fn2-pool)))
            (fn2-rba-call fn2-rba-check pslot pgen))
         (fn2-rba-mv check)))
      ((mv & qslot qgen fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv answers fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
       (fn2-rba-call fn2-rba-probes queries qslot qgen 0 pslot pgen)))
  (fn2-rba-mv (list sealed check answers))))
(defun fn2-ribbon-image (keys drop queries mutate)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests)
  (fn2-rba-run keys drop queries mutate fn2-ribbon-builds fn2-ribbon-band fn2-run-writers fn2-run-restarts fn2-fields fn2-pool
               fn2-fc fn2-fc-context fn2-b3 fn2-digests)))

;; Keystones (FILTERS-2026 item 2; the layer doc's section 9).
(defthm-owed fn2-ribbon-no-false-negative (keys queries)
 (implies (and (fn2-ribbon-keysp keys) (consp keys) (<= (len keys) 256) (fn2-ribbon-keysp queries) (<= (len queries) 256))
          (let ((r (fn2-ribbon-image keys nil queries nil)))
           (and (equal (car r) :sealed) (equal (cadr r) :ok) (fn2-ribbon-answers-sound keys queries (caddr r)))))
 :teeth (fn2-ribbon-no-false-negative-positive fn2-ribbon-no-false-negative-negative)
 :doc "A filter built through the real build from a run's keys seals, passes B's checker under its parent-held hash, and its probe answers :absent only for a query that is no key of the run: a filter may skip a run, never hide a key.")
(defthm-owed fn2-ribbon-mutation-refused (keys off x)
 (implies (and (fn2-ribbon-keysp keys) (consp keys) (<= (len keys) 256)
               (natp off) (< off *fn2-run-page-size*) (unsigned-byte-p 8 x) (not (equal x 0)))
          (let ((check (cadr (fn2-ribbon-image keys nil nil (cons off x)))))
           (and (keywordp check) (not (equal check :ok)))))
 :teeth (fn2-ribbon-mutation-refused-positive fn2-ribbon-mutation-refused-negative)
 :doc "Any one-byte change anywhere in a sealed filter page (header, filter header, solution bytes or padding) is refused by name by B's checker before a probe can read it.")

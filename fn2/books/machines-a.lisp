; Layer A machine declarations. The directory carries only (kind, slot);
; every machine field lives in its kind's own struct of arrays.
(in-package "ACL2")
(include-book "machines")
(include-book "profile")

(in-theory (disable fn2-profile-generation-start fn2-profile-generation-limit
                    fn2-profile-accept-credits fn2-profile-c))

(defun fn2-machine-initial-generation (slot base n gen)
  (declare (xargs :guard t) (ignore slot base n)) gen)
(defun fn2-machine-initial-next-free (slot base n gen)
  (declare (xargs :guard t) (ignore gen))
  (if (< (+ (nfix slot) 1) (nfix n)) (+ (nfix base) (nfix slot) 1) *fn2-none*))

;; Arm contracts (R7): every continuation and handler declares its cost
;; (constants and declared calls), the row fields it writes, the core children
;; it changes, the phases it may move to and the operations it uses; :holds
;; gives each phase's resources in D0's order (fn2/books/resources.lisp).
(defmachine fn2-listener
 :states (:accepting :admitting :closing)
 :fields ((cap-index :u32) (cap-nonce :u32) (pending :u32) (stopped :bool) (event-ready :bool) (mode :bool)
          ; the admitted kind's ordinal (D 4.5): echo unless :listener-targets names another
          (target :u8))
 :holds ((:accepting :accept-credit) (:admitting :accept-credit :connection-row) (:closing :accept-credit))
 :budget (:bytes 4096 :steps 32 :descriptors 4)
 :capacity (fn2-profile-accept-credits profile)
 :initial ((generation fn2-machine-initial-generation) (ready-prev *fn2-none*) (ready-next *fn2-none*)
           (phase *fn2-listener-state-accepting*) (mode 1))
 :observes ((:accept-result fn2-listener-observe-accept
             :cost (:steps *fn2-work-transition*) :writes (cap-index cap-nonce event-ready)
             :tables (fn2-core-machines) :from (:admitting) :next (:accepting)
             :uses (fn2-listener-return-credit))
            (:close-result fn2-listener-observe-close
             :cost (:steps *fn2-work-transition*) :writes (event-ready)
             :from (:closing) :next (:accepting) :uses ()))
 :continuations
 ((:accepting fn2-listener-accept
   :cost (:steps *fn2-work-transition* :descriptors 1)
   :writes (pending stopped wait-reason ready-prev ready-next)
   :tables (fn2-core-ops fn2-core-machines fn2-core-machine-tables)
   :next (:accepting :admitting)
   :uses (fn2-machine-admission-credits fn2-machine-park-admission fn2-issue-accept
          fn2-listener-take-credit fn2-machine-issue-result fn2-machine-refuse-phase))
  (:admitting fn2-listener-admitting
   :cost (:steps (:cost fn2-listener-admit :steps))
   :writes (event-ready)
   :tables (fn2-core-machines fn2-core-pool fn2-core-machine-tables)
   :next (:admitting :accepting :closing)
   :uses (fn2-listener-admit fn2-machine-refuse-phase)
   :on-refusal (:close-and-release :to :closing :releases (:connection-row)))
  (:closing fn2-listener-close
   :cost (:steps *fn2-work-transition* :descriptors 1)
   :writes (pending stopped wait-reason ready-prev ready-next)
   :tables (fn2-core-ops fn2-core-machines fn2-core-machine-tables)
   :next (:closing)
   :uses (fn2-issue-close fn2-machine-issue-result))))

(defmachine fn2-echo
 :states (:free :command :reply :closing :draining :retired)
 :fields ((cap-index :u32) (cap-nonce :u32) (pool-slot :link) (pool-gen :u60)
          (off :u32) (length :u32) (pending :u32) (borrows :u32)
          (next-free :link) (stopped :bool) (mode :bool))
 :holds ((:command :connection-row :rx-range) (:reply :connection-row :rx-range)
         (:closing :connection-row :rx-range) (:draining :connection-row :rx-range))
 :budget (:bytes 4096 :steps 32 :descriptors 4)
 :capacity (fn2-profile-c profile)
 :initial ((generation fn2-machine-initial-generation) (ready-prev *fn2-none*) (ready-next *fn2-none*)
           (pool-slot *fn2-none*) (next-free fn2-machine-initial-next-free))
 :admission (:phase :command :ranges ((:rx-range :slot pool-slot :gen pool-gen :class 0))
             :copy (mode) :clear (off length pending borrows))
 :observes ((:receive-result fn2-echo-observe-receive
             :cost (:steps *fn2-work-transition*) :writes (length off) :next (:reply :closing) :uses ())
            (:send-result fn2-echo-observe-send
             :cost (:steps *fn2-work-transition*) :writes (borrows off) :next (:closing)
             :uses (fn2-machine-pool-borrows-read-code fn2-machine-pool-borrows fn2-core-stop))
            (:borrow-released fn2-echo-observe-release
             :cost (:steps *fn2-work-transition*) :writes (borrows) :next ()
             :uses (fn2-machine-pool-borrows-read-code fn2-machine-pool-borrows
                    fn2-machine-refuse-observation))
            (:close-result fn2-echo-observe-close
             :cost (:steps *fn2-work-transition*) :writes () :next (:draining) :uses ()))
 :continuations
 ((:free fn2-connection-idle :cost (:steps (:cost fn2-machine-idle :steps)) :writes () :next (:free)
   :uses (fn2-machine-idle))
  (:command fn2-connection-submit :cost (:bytes (:cost fn2-connection-issue :bytes)
                                         :steps (:cost fn2-connection-issue :steps)
                                         :descriptors (:cost fn2-connection-issue :descriptors))
   :writes (borrows pending stopped wait-reason ready-prev ready-next)
   :tables (fn2-core-ops fn2-core-pool fn2-core-machines fn2-core-machine-tables)
   :next (:command) :uses (fn2-connection-issue))
  (:reply fn2-connection-reply :cost (:bytes (:cost fn2-connection-submit :bytes)
                                      :steps (max (:cost fn2-connection-submit :steps)
                                                  (:cost fn2-connection-reset :steps))
                                      :descriptors (:cost fn2-connection-submit :descriptors))
   :writes (off length borrows pending stopped wait-reason ready-prev ready-next)
   :tables (fn2-core-ops fn2-core-pool fn2-core-machines fn2-core-machine-tables)
   :next (:reply :command :closing) :uses (fn2-connection-submit fn2-connection-reset))
  (:closing fn2-connection-submit :cost (:bytes (:cost fn2-connection-issue :bytes)
                                         :steps (:cost fn2-connection-issue :steps)
                                         :descriptors (:cost fn2-connection-issue :descriptors))
   :writes (borrows pending stopped wait-reason ready-prev ready-next)
   :tables (fn2-core-ops fn2-core-pool fn2-core-machines fn2-core-machine-tables)
   :next (:closing) :uses (fn2-connection-issue))
  (:draining fn2-connection-drain :cost (:steps (:cost fn2-connection-release :steps))
   :writes (generation pool-slot pool-gen cap-index cap-nonce off length next-free wait-reason)
   :tables (fn2-core-pool fn2-core-machines)
   :next (:draining :free :retired) :uses (fn2-connection-release))
  (:retired fn2-connection-idle :cost (:steps (:cost fn2-machine-idle :steps)) :writes () :next (:retired)
   :uses (fn2-machine-idle))))

(defmachine fn2-scribe
 :states (:free :reserve :fill :patch :write :write-result :fence :fence-result :reset :read :read-result :verify :next :stopped)
 :fields ((pool-slot :link) (pool-gen :u60) (pending :u32) (borrows :u32)
          (sequence :u32) (cursor :u32) (checksum :u32) (completed :u32)
          (verified :u32) (stopped :bool) (event :u8) (outcome :u8)
          (count :u32) (aux0 :u32) (aux1 :u32) (event-ready :bool))
 :holds ((:reserve :storage-job) (:fill :storage-job :storage-window) (:patch :storage-job :storage-window)
         (:write :storage-job :storage-window) (:write-result :storage-job :storage-window)
         (:fence :storage-job :storage-window) (:fence-result :storage-job :storage-window)
         (:reset :storage-job :storage-window) (:read :storage-job :storage-window)
         (:read-result :storage-job :storage-window) (:verify :storage-job :storage-window)
         (:next :storage-job :storage-window) (:stopped :storage-job :storage-window))
 :budget (:bytes 4096 :steps 32 :descriptors 4)
 :capacity 1
 :initial ((generation fn2-machine-initial-generation) (ready-prev *fn2-none*) (ready-next *fn2-none*)
           (pool-slot *fn2-none*) (sequence 1))
 :observes ((:write-result fn2-scribe-observe :cost (:steps *fn2-work-transition*)
             :writes (event outcome count aux0 aux1 event-ready) :next () :uses ())
            (:fence-result fn2-scribe-observe :cost (:steps *fn2-work-transition*)
             :writes (event outcome count aux0 aux1 event-ready) :next () :uses ())
            (:read-result fn2-scribe-observe :cost (:steps *fn2-work-transition*)
             :writes (event outcome count aux0 aux1 event-ready) :next () :uses ()))
 :continuations
 ((:free fn2-scribe-idle :cost (:steps (:cost fn2-machine-idle :steps)) :writes () :next (:free)
   :uses (fn2-machine-idle))
  (:reserve fn2-scribe-reserve :cost (:steps *fn2-work-transition*)
   :writes (stopped pool-slot pool-gen cursor checksum wait-reason event-ready)
   :tables (fn2-core-pool fn2-core-machines)
   :next (:reserve :fill :stopped)
   :uses (fn2-scribe-window-class (fn2-core-reserve :effects ((:acquire (:storage-window))))
          fn2-machine-park-pool fn2-scribe-stop))
  (:fill fn2-scribe-fill-run :cost (:bytes *fn2-scribe-chunk-bytes* :steps *fn2-work-transition*)
   :writes (cursor checksum stopped) :tables (fn2-core-pool) :next (:fill :patch :stopped)
   :uses (fn2-scribe-fill))
  (:patch fn2-scribe-patch :cost (:bytes *fn2-format-word-bytes* :steps *fn2-work-small*)
   :writes (stopped) :tables (fn2-core-pool) :next (:write :stopped) :uses (fn2-scribe-patch-loop))
  (:write fn2-scribe-write :cost (:bytes *fn2-format-sector-bytes* :steps *fn2-work-small* :descriptors 1)
   :writes (pending event-ready stopped wait-reason ready-prev ready-next)
   :tables (fn2-core-ops fn2-core-pool fn2-core-machines fn2-core-machine-tables)
   :next (:write :write-result :stopped) :uses (fn2-machine-yield fn2-issue-write fn2-scribe-refused))
  (:write-result fn2-scribe-result :cost (:steps *fn2-work-refusal*)
   :writes (completed cursor event-ready stopped) :next (:write-result :fence :stopped)
   :uses (fn2-scribe-stop))
  (:fence fn2-scribe-fence :cost (:steps *fn2-work-small* :descriptors 1)
   :writes (pending event-ready stopped wait-reason ready-prev ready-next)
   :tables (fn2-core-ops fn2-core-machines fn2-core-machine-tables)
   :next (:fence :fence-result :stopped) :uses (fn2-machine-yield fn2-issue-fence fn2-scribe-refused))
  (:fence-result fn2-scribe-result :cost (:steps *fn2-work-mailbox*)
   :writes (completed cursor event-ready stopped) :next (:fence-result :reset :stopped)
   :uses (fn2-scribe-stop))
  (:reset fn2-scribe-reset :cost (:steps *fn2-work-mailbox*) :writes (cursor stopped)
   :tables (fn2-core-pool) :next (:read :stopped) :uses (fn2-core-reset))
  (:read fn2-scribe-read :cost (:bytes *fn2-format-sector-bytes* :steps *fn2-work-small* :descriptors 1)
   :writes (pending event-ready stopped wait-reason ready-prev ready-next)
   :tables (fn2-core-ops fn2-core-pool fn2-core-machines fn2-core-machine-tables)
   :next (:read :read-result :stopped)
   :uses (fn2-machine-yield fn2-issue-read fn2-scribe-stop fn2-scribe-refused))
  (:read-result fn2-scribe-result :cost (:steps *fn2-work-mailbox*)
   :writes (completed cursor event-ready stopped) :next (:read-result :read :verify :stopped)
   :uses (fn2-scribe-stop))
  (:verify fn2-scribe-verify-run :cost (:bytes *fn2-scribe-chunk-bytes* :steps *fn2-work-transition*)
   :writes (cursor stopped) :next (:verify :next :stopped) :uses (fn2-scribe-verify))
  (:next fn2-scribe-next :cost (:steps *fn2-work-small*)
   :writes (verified sequence cursor checksum stopped event-ready) :tables (fn2-core-pool)
   :next (:fill :stopped) :uses (fn2-core-reset fn2-scribe-stop))
  (:stopped fn2-scribe-idle :cost (:steps (:cost fn2-machine-idle :steps)) :writes () :next (:stopped)
   :uses (fn2-machine-idle))))

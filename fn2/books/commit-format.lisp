(defconst *fn2-commit-scratch-parent* (* 3 *fn2-commit-digest-bytes*))
; Test keyed mutations install this immutable append-only manifest node. Its
; predecessor is a seal identity; the root recipe retains suffix 1..batch.
(deflayout fn2-commit-manifest-node
 '((parent :digest) (parent-batch :u64) (first-key :u64) (members :u32)
   (extent :u32) (writer-epoch :u64) (allocation :u64)))
(assert-event (equal *fn2-commit-manifest-node-max-size* 73))
(defun fn2-commit-clear-fields (n base scratch sg fn2-fields)
 (declare (xargs :stobjs fn2-fields :measure (nfix n)
  :guard (and (fn2-fields-wfp fn2-fields) (natp n) (natp base)
              (<= (+ base n) (fn2-fields-rows fn2-fields))
              (unsigned-byte-p 32 scratch) (unsigned-byte-p 60 sg))))
 (if (zp n) fn2-fields
  (let* ((r (+ base (- n 1)))
         (fn2-fields (fn2-fields-set-value r 0 fn2-fields))
         (fn2-fields (fn2-fields-set-ref-slot r scratch fn2-fields))
         (fn2-fields (fn2-fields-set-ref-gen r sg fn2-fields))
         (fn2-fields (fn2-fields-set-ref-off r 0 fn2-fields))
         (fn2-fields (fn2-fields-set-ref-len r *fn2-commit-digest-bytes* fn2-fields)))
   (fn2-commit-clear-fields (- n 1) base scratch sg fn2-fields))))
(fn2-fc-shape fn2-commit-clear-fields-shape
 (fn2-commit-clear-fields n base scratch sg fn2-fields)
 (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (natp n) (natp base)
      (<= (+ base n) (fn2-fields-rows fn2-fields))
      (unsigned-byte-p 32 scratch) (unsigned-byte-p 60 sg)) ((fn2-fields nil)))
(in-theory (disable fn2-commit-clear-fields))
(local (in-theory (disable fn2-fields-rows fn2-fieldsp fn2-fields-wfp fn2-poolp fn2-pool-wfp fn2-pool-rows)))

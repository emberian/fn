; The list codec is the specification. DEFLAYOUT below compiles served codecs.
(in-package "ACL2")
(include-book "pool")
(include-book "std/util/bstar" :dir :system)
(fn2-book-layer :b)
; Profile chooses row count at init; only resident ranges have u32 bounds.
(defcolumns fn2-fields
  ((value :u60) (ref-slot :u32) (ref-gen :u60)
   (ref-off :u32) (ref-len :u32) (status :u8)
   (decode-phase :u32) (decode-pos :u32) (decode-acc :u60)
   (decode-high :u32) (decode-size :u32) (decode-ref :u32)
   (decode-payload :u8) (decode-next :u32))
  :extra-fields
  ((fn2-fields-cursor :type (unsigned-byte 32) :initially 0 :why "Streaming codec resume state: one cursor for the active layout run.")
   (fn2-fields-pos :type (unsigned-byte 32) :initially 0 :why "Streaming codec resume state: byte position inside the current field.")
   (fn2-fields-acc :type (unsigned-byte 60) :initially 0 :why "Streaming codec resume state: partially decoded field value.")
   ; Sticky wide-varint flag; never a high limb of a resident value.
   (fn2-fields-high :type (unsigned-byte 32) :initially 0 :why "Streaming codec resume state: sticky wide-varint flag.")
   (fn2-fields-size :type (unsigned-byte 32) :initially 0 :why "Streaming codec resume state: size of the current field.")
   (fn2-fields-resume-ref :type (unsigned-byte 32) :initially 0 :why "Streaming codec resume state: saved reference cursor.")
   (fn2-fields-phase :type (unsigned-byte 8) :initially 0 :why "Streaming codec resume state: phase of the active layout.")
   (fn2-fields-next :type (unsigned-byte 32) :initially 0 :why "Streaming codec resume state: next input offset to resume at.")))

(local (include-book "arithmetic-3/floor-mod/floor-mod" :dir :system))
(local (in-theory (disable fn2-pool-write fn2-pool-read)))

(defun fn2-layout-keywordsp (xs)
  (declare (xargs :guard t))
  (if (atom xs) (null xs)
    (and (keywordp (car xs)) (fn2-layout-keywordsp (cdr xs)))))
(defun fn2-layout-kindp (k)
  (declare (xargs :guard t))
  (or (member-eq k '(:u8 :u16 :u32 :u64 :u60 :bool :varint :digest))
      (and (true-listp k)
           (or (and (equal (len k) 2)
                    (case (car k)
                      (:id (member-eq (cadr k) '(history incarnation writer-epoch commit event article group-number checkpoint allocation storage-domain physical-unit anchor-slot principal operation table object extent group obligation registration configuration schema key owner)))
                      ((:octets :zero) (unsigned-byte-p 32 (cadr k)))
                      (otherwise nil)))
               (and (equal (len k) 3) (eq (car k) :enum)
                    (symbolp (cadr k)) (cadr k)
                    (consp (caddr k)) (fn2-layout-keywordsp (caddr k))
                    (<= (len (caddr k)) 256) (no-duplicatesp-equal (caddr k)))))))
(defun fn2-layout-name-freep (name layout)
  (declare (xargs :guard t))
  (if (atom layout) t
    (and (not (equal name (if (consp (car layout)) (caar layout) nil)))
         (fn2-layout-name-freep name (cdr layout)))))
(defun fn2-layoutp (layout)
  (declare (xargs :guard t))
  (if (atom layout) (null layout)
    (and (true-listp (car layout)) (equal (len (car layout)) 2)
         (symbolp (caar layout)) (caar layout)
         (fn2-layout-kindp (cadar layout))
         (fn2-layout-name-freep (caar layout) (cdr layout))
         (fn2-layoutp (cdr layout)))))
(defthm fn2-layoutp-list (implies (fn2-layoutp layout) (true-listp layout)))
(defthm fn2-layoutp-head
  (implies (and (fn2-layoutp layout) (consp layout))
           (and (consp (car layout)) (consp (cdar layout))
                (fn2-layout-kindp (cadar layout)))))
(defthm fn2-layoutp-cdr (implies (fn2-layoutp layout) (fn2-layoutp (cdr layout))))
(defun fn2-layout-kind-code (k)
  (declare (xargs :guard (fn2-layout-kindp k)))
  (cond ((eq k :u8) 1) ((eq k :u16) 2) ((eq k :u32) 3)
        ((eq k :u64) 4) ((member-eq k '(:varint :u60)) 5)
        ((eq k :bool) 6) ((eq k :digest) 7)
        ((eq (car k) :id) 8) ((eq (car k) :enum) 9)
        ((eq (car k) :octets) 10) (t 11)))
(defun fn2-layout-width (k)
  (declare (xargs :guard (fn2-layout-kindp k)))
  (case (fn2-layout-kind-code k)
    ((1 6 9) 1) (2 2) (3 4) (4 8) (7 33)
    (11 (cadr k)) (otherwise nil)))
(defun fn2-layout-varsize (v)
  (declare (xargs :guard (natp v) :measure (nfix v)))
  (if (< (nfix v) 128) 1 (+ 1 (fn2-layout-varsize (floor v 128)))))
(defun fn2-layout-max-size (layout)
  (declare (xargs :guard (fn2-layoutp layout)))
  (if (atom layout) 0
    (+ (or (fn2-layout-width (cadar layout))
           (if (and (consp (cadar layout)) (eq (car (cadar layout)) :octets)) (+ (fn2-layout-varsize (cadr (cadar layout))) (cadr (cadar layout))) 9))
       (fn2-layout-max-size (cdr layout)))))
(defun fn2-layout-offsets (layout off)
  (declare (xargs :guard (and (fn2-layoutp layout) (or (null off) (natp off)))))
  (if (atom layout) nil
    (let ((width (fn2-layout-width (cadar layout))))
      (cons (list (caar layout) (fn2-layout-kind-code (cadar layout)) off (cadar layout))
            (fn2-layout-offsets (cdr layout) (and off width (+ off width)))))))
(defun fn2-layout-fixed-offsets (layout)
  (declare (xargs :guard (fn2-layoutp layout)))
  (fn2-layout-offsets layout 0))

(defun fn2-layout-start (fn2-fields)
  (declare (xargs :stobjs fn2-fields))
  (let* ((fn2-fields (update-fn2-fields-cursor 0 fn2-fields))
         (fn2-fields (update-fn2-fields-pos 0 fn2-fields))
         (fn2-fields (update-fn2-fields-acc 0 fn2-fields))
         (fn2-fields (update-fn2-fields-high 0 fn2-fields))
         (fn2-fields (update-fn2-fields-size 0 fn2-fields))
         (fn2-fields (update-fn2-fields-resume-ref 0 fn2-fields))
         (fn2-fields (update-fn2-fields-phase 0 fn2-fields))
         (fn2-fields (update-fn2-fields-next 0 fn2-fields))) fn2-fields))

(defun fn2-layout-range-code (slot gen off end writep okind oslot ogen fn2-pool)
  (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
  (let ((code (if writep (fn2-pool-workspace-code slot gen okind oslot ogen fn2-pool)
                (fn2-pool-readable-code slot gen okind oslot ogen fn2-pool))))
    (cond ((not (eq code :ok)) code)
          ((not (and (unsigned-byte-p 32 off) (unsigned-byte-p 32 end) (<= off end)
                     (<= off (fn2-pool-slot-fill slot fn2-pool))
                     (<= end (if writep (fn2-pool-slot-cap slot fn2-pool)
                               (fn2-pool-slot-fill slot fn2-pool)))
                     (<= (+ (fn2-pool-slot-base slot fn2-pool) end)
                         (fn2-pool-capacity-bytes fn2-pool)))) :bounds)
          (t :ok))))

(defun fn2-layout-copy-loop (src-slot src-gen src-off dst-slot dst-gen dst-off len okind oslot ogen fn2-pool)
  (declare (xargs :stobjs fn2-pool :measure (nfix len)
                  :guard (and (fn2-pool-wfp fn2-pool) (natp len) (natp src-off) (natp dst-off))))
  (if (zp len) (mv :ok fn2-pool)
    (b* (((mv code byte) (fn2-pool-read src-slot src-gen src-off okind oslot ogen fn2-pool))
         ((unless (eq code :ok)) (mv code fn2-pool))
         ((mv code fn2-pool) (fn2-pool-write dst-slot dst-gen dst-off byte okind oslot ogen fn2-pool))
         ((unless (eq code :ok)) (mv code fn2-pool)))
      (fn2-layout-copy-loop src-slot src-gen (+ 1 src-off) dst-slot dst-gen (+ 1 dst-off)
                            (- len 1) okind oslot ogen fn2-pool))))
(encapsulate ()
  (local (in-theory (disable fn2-pool-rows)))
  (fn2-pool-preserves fn2-layout-copy-loop (src-slot src-gen src-off dst-slot dst-gen dst-off len okind oslot ogen fn2-pool) :position 1 :disable nil))
(in-theory (disable fn2-layout-copy-loop))
; Layer A is adding measured range primitives (copy, compare, scan over a
; handle's range); this shim is replaced by them when they merge.
; Overlap is refused, including exact alias: immutable references survive encode.
(defun fn2-layout-copy (src-slot src-gen src-off dst-slot dst-gen dst-off len okind oslot ogen fn2-pool)
  (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
  (if (not (and (unsigned-byte-p 32 len) (unsigned-byte-p 32 src-off) (unsigned-byte-p 32 dst-off)))
      (mv :bounds fn2-pool)
    (let ((a (fn2-layout-range-code src-slot src-gen src-off (+ src-off len) nil okind oslot ogen fn2-pool))
          (b (fn2-layout-range-code dst-slot dst-gen dst-off (+ dst-off len) t okind oslot ogen fn2-pool)))
      (cond ((not (eq a :ok)) (mv a fn2-pool)) ((not (eq b :ok)) (mv b fn2-pool))
            ((and (equal src-slot dst-slot) (< src-off (+ dst-off len)) (< dst-off (+ src-off len)))
             (mv :overlap fn2-pool))
            (t (fn2-layout-copy-loop src-slot src-gen src-off dst-slot dst-gen dst-off len okind oslot ogen fn2-pool))))))
(encapsulate ()
  (local (in-theory (disable fn2-pool-rows)))
  (fn2-pool-preserves fn2-layout-copy (src-slot src-gen src-off dst-slot dst-gen dst-off len okind oslot ogen fn2-pool) :position 1 :disable nil))
(in-theory (disable fn2-layout-copy fn2-layout-range-code))

; One byte transition, bounded shifts only. :payload starts a reference range.
; Wide varints retain no high limbs: scan to the terminal group, then :wide.
(defun fn2-layout-byte (k pos v hi size phase byte)
  (declare (xargs :guard (and (fn2-layout-kindp k) (natp pos) (natp v) (natp hi)
                              (natp size) (natp phase) (unsigned-byte-p 8 byte))))
  (let* ((tag (fn2-layout-kind-code k)) (low (mod byte 128)))
    (cond
     ((equal phase 1) (mv (if (>= (+ pos 1) size) :done :part) v hi size phase))
     ((equal tag 11) (mv (if (not (= byte 0)) :nonzero-padding
                          (if (>= (+ pos 1) (nfix (cadr k))) :done :part)) 0 0 0 0))
     ((equal tag 7) (mv (if (= byte 1) :payload :unknown-tag) byte 0 32 1))
     ((member-equal tag '(5 8 10))
      (let* ((wide (or (not (= hi 0)) (> pos 8) (and (= pos 8) (>= low 16))))
             (v (if wide v (+ v (ash low (* 7 (min 8 pos)))))))
        (cond ((>= byte 128) (mv :part v (if wide 1 0) 0 0))
              ((and (> pos 0) (= low 0)) (mv :noncanonical v 0 0 0))
              (wide (mv (if (= tag 10) :length :wide) v 0 0 0))
              ((= tag 10) (mv (if (> v (nfix (cadr k))) :length
                                (if (= v 0) :done :payload)) 0 0 v 1))
              (t (mv :done v 0 0 0)))))
     ((= tag 9) (mv (if (< byte (len (caddr k))) :done :unknown-tag) byte 0 0 0))
     ((= tag 6) (mv (if (< byte 2) :done :unknown-tag) byte 0 0 0))
     ; A-WORD-U60: refuse before shifting any forbidden high bit.
     ((and (= tag 4) (= pos 7) (>= byte 16)) (mv :wide v hi 0 0))
     (t (let* ((word (+ v (ash byte (* 8 (min pos 7)))))
               (width (case tag (1 1) (2 2) (3 4) (otherwise 8))))
          (mv (if (>= (+ pos 1) width) :done :part) word hi 0 0))))))

(defun fn2-layout-store (i v slot gen off size status fn2-fields)
  (declare (xargs :stobjs fn2-fields :guard (fn2-fields-wfp fn2-fields)))
  (if (not (and (natp i) (< i (fn2-fields-rows fn2-fields))
                (unsigned-byte-p 60 v)
                (unsigned-byte-p 32 slot) (unsigned-byte-p 60 gen)
                (unsigned-byte-p 32 off) (unsigned-byte-p 32 size) (unsigned-byte-p 8 status)))
      (prog2$ (er hard? 'fn2-layout-store "Invalid field write.") fn2-fields)
    (let* ((fn2-fields (fn2-fields-set-value i v fn2-fields))
           (fn2-fields (fn2-fields-set-ref-slot i slot fn2-fields))
           (fn2-fields (fn2-fields-set-ref-gen i gen fn2-fields))
           (fn2-fields (fn2-fields-set-ref-off i off fn2-fields))
           (fn2-fields (fn2-fields-set-ref-len i size fn2-fields))
           (fn2-fields (fn2-fields-set-status i status fn2-fields))) fn2-fields)))
(defthm fn2-layout-store-wfp
  (implies (fn2-fields-wfp fn2-fields) (fn2-fields-wfp (fn2-layout-store i v slot gen off size status fn2-fields))))
(defthm fn2-layout-store-type
  (implies (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields))
           (fn2-fieldsp (fn2-layout-store i v slot gen off size status fn2-fields))))
(defthm fn2-layout-store-rows
  (equal (fn2-fields-rows (fn2-layout-store i v slot gen off size status fn2-fields)) (fn2-fields-rows fn2-fields)))
(in-theory (disable fn2-layout-store fn2-layout-byte))

; One pass, one read per byte. Completed-row frames retain old scalar values;
; refusal unwinds those writes. Incomplete-field recursion remains tail-recursive.
(defun fn2-layout-scan (layout fuel i pos v hi size ref phase next slot gen end okind oslot ogen  fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil :measure (+ (nfix fuel) (len layout))
                  :guard (and (fn2-layoutp layout) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool)
                              (natp fuel) (natp i) (natp pos) (natp v) (natp hi) (natp size)
                              (natp ref) (natp phase) (natp next) (natp end))))
  (b* (((when (atom layout)) (mv :ok i pos v hi size ref phase next fn2-fields))
       (k (cadar layout)) (empty (equal k '(:zero 0)))
       ((when (and (not empty) (zp fuel))) (mv :more i pos v hi size ref phase next fn2-fields))
       ((when (or (not (natp i)) (>= i (fn2-fields-rows fn2-fields)))) (mv :bounds i pos v hi size ref phase next fn2-fields))
       ((when (and (not empty) (>= next end))) (mv :truncated i pos v hi size ref phase next fn2-fields))
       ((mv code byte) (if empty (mv :ok 0) (fn2-pool-read slot gen next okind oslot ogen fn2-pool)))
       ((unless (eq code :ok)) (mv code i pos v hi size ref phase next fn2-fields))
       ((mv code v hi size phase) (if empty (mv :done 0 0 0 0)
                                  (fn2-layout-byte k pos v hi size phase (mod (nfix byte) 256))))
       (v (nfix v)) (hi (nfix hi)) (size (nfix size)) (phase (nfix phase))
       (next (if empty next (+ next 1)))
       (ref (if (or (eq code :payload) (and (= phase 1) (= size 0))) next ref))
       ((unless (member-eq code '(:done :part :payload))) (mv code i pos v hi size ref phase next fn2-fields))
       (fuel (if empty fuel (- fuel 1)))
       ((unless (eq code :done))
        (fn2-layout-scan layout fuel i (if (eq code :payload) 0 (+ pos 1)) v hi size ref phase next
                         slot gen end okind oslot ogen  fn2-fields fn2-pool))
       (old-v (fn2-fields-value i fn2-fields))
       (old-slot (fn2-fields-ref-slot i fn2-fields)) (old-gen (fn2-fields-ref-gen i fn2-fields))
       (old-off (fn2-fields-ref-off i fn2-fields)) (old-len (fn2-fields-ref-len i fn2-fields))
       (old-status (fn2-fields-status i fn2-fields))
       (fn2-fields (fn2-layout-store i v slot gen ref size 0 fn2-fields))
       ((mv code j p a h n r ph nx fn2-fields)
        (fn2-layout-scan (cdr layout) fuel (+ i 1) 0 0 0 0 0 0 next slot gen end okind oslot ogen  fn2-fields fn2-pool))
       (fn2-fields (if (not (member-eq code '(:ok :more)))
                       (fn2-layout-store i old-v old-slot old-gen old-off old-len old-status fn2-fields) fn2-fields)))
    (mv code j p a h n r ph nx fn2-fields)))

(defthm fn2-layout-scan-rows
  (equal (fn2-fields-rows (mv-nth 9 (fn2-layout-scan layout fuel i pos v hi size ref phase next slot gen end okind oslot ogen  fn2-fields fn2-pool)))
         (fn2-fields-rows fn2-fields))
  :hints (("Goal" :in-theory (disable fn2-fields-rows nfix member-equal fn2-fields-value fn2-fields-ref-slot fn2-fields-ref-gen fn2-fields-ref-off fn2-fields-ref-len fn2-fields-status))))
(defthm fn2-layout-scan-wfp
  (implies (fn2-fields-wfp fn2-fields)
           (fn2-fields-wfp (mv-nth 9 (fn2-layout-scan layout fuel i pos v hi size ref phase next slot gen end okind oslot ogen  fn2-fields fn2-pool))))
  :hints (("Goal" :in-theory (disable fn2-fields-rows nfix member-equal fn2-fields-value fn2-fields-ref-slot fn2-fields-ref-gen fn2-fields-ref-off fn2-fields-ref-len fn2-fields-status))))
(defthm fn2-layout-scan-type
  (implies (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields))
           (fn2-fieldsp (mv-nth 9 (fn2-layout-scan layout fuel i pos v hi size ref phase next slot gen end okind oslot ogen  fn2-fields fn2-pool))))
  :hints (("Goal" :in-theory (disable fn2-fields-rows nfix member-equal fn2-fields-value fn2-fields-ref-slot fn2-fields-ref-gen fn2-fields-ref-off fn2-fields-ref-len fn2-fields-status))))
(verify-guards fn2-layout-scan
  :hints (("Goal" :in-theory (disable fn2-layoutp fn2-layout-kindp member-equal nfix fn2-fields-rows fn2-fields-value fn2-fields-ref-slot fn2-fields-ref-gen fn2-fields-ref-off fn2-fields-ref-len fn2-fields-status))))
(in-theory (disable fn2-layout-scan))

(defun fn2-layout-save (i pos v hi size ref phase next fn2-fields)
  (declare (xargs :stobjs fn2-fields))
  (if (not (and (unsigned-byte-p 32 i) (unsigned-byte-p 32 pos) (unsigned-byte-p 60 v)
                (unsigned-byte-p 32 hi) (unsigned-byte-p 32 size) (unsigned-byte-p 32 ref)
                (unsigned-byte-p 8 phase) (unsigned-byte-p 32 next)))
      (prog2$ (er hard? 'fn2-layout-save "Invalid specification continuation.") fn2-fields)
    (let* ((fn2-fields (update-fn2-fields-cursor i fn2-fields))
           (fn2-fields (update-fn2-fields-pos pos fn2-fields))
           (fn2-fields (update-fn2-fields-acc v fn2-fields))
           (fn2-fields (update-fn2-fields-high hi fn2-fields))
           (fn2-fields (update-fn2-fields-size size fn2-fields))
           (fn2-fields (update-fn2-fields-resume-ref ref fn2-fields))
           (fn2-fields (update-fn2-fields-phase phase fn2-fields))
           (fn2-fields (update-fn2-fields-next next fn2-fields))) fn2-fields)))
(defthm fn2-layout-save-wfp
  (implies (fn2-fields-wfp fn2-fields) (fn2-fields-wfp (fn2-layout-save i pos v hi size ref phase next fn2-fields))))
(defthm fn2-layout-save-type
  (implies (fn2-fieldsp fn2-fields) (fn2-fieldsp (fn2-layout-save i pos v hi size ref phase next fn2-fields))))
(defthm fn2-layout-start-wfp
  (implies (fn2-fields-wfp fn2-fields) (fn2-fields-wfp (fn2-layout-start fn2-fields))))
(defthm fn2-layout-start-type
  (implies (fn2-fieldsp fn2-fields) (fn2-fieldsp (fn2-layout-start fn2-fields))))
(in-theory (disable fn2-layout-save fn2-layout-start))

(defthm fn2-layoutp-tail
  (implies (fn2-layoutp layout) (fn2-layoutp (nthcdr n layout)))
  :hints (("Goal" :in-theory (disable fn2-layoutp))))
(defun fn2-layout-decode-run (layout slot gen off end okind oslot ogen budget resume fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool)
                  :guard (and (fn2-layoutp layout) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
  (b* ((code (fn2-layout-range-code slot gen off end nil okind oslot ogen fn2-pool))
       ((unless (eq code :ok)) (mv code off fn2-fields))
       ((unless (and (unsigned-byte-p 32 off) (unsigned-byte-p 32 end)
                     (posp budget) (<= budget 4096) (<= (len layout) (fn2-fields-rows fn2-fields))))
        (mv :bounds off fn2-fields))
       (i (if resume (fn2-fields-cursor fn2-fields) 0))
       (pos (if resume (fn2-fields-pos fn2-fields) 0))
       (v (if resume (fn2-fields-acc fn2-fields) 0))
       (hi (if resume (fn2-fields-high fn2-fields) 0))
       (size (if resume (fn2-fields-size fn2-fields) 0))
       (ref (if resume (fn2-fields-resume-ref fn2-fields) 0))
       (phase (if resume (fn2-fields-phase fn2-fields) 0))
       (next (if (and resume (not (equal (fn2-fields-next fn2-fields) 0))) (fn2-fields-next fn2-fields) off))
       ((unless (and (<= i (len layout)) (<= off next) (<= next end))) (mv :bounds off fn2-fields))
       (tail (nthcdr i layout))
       ((mv code j p a h s r ph n fn2-fields)
        (fn2-layout-scan tail budget i pos v hi size ref phase next slot gen end okind oslot ogen  fn2-fields fn2-pool))
       ((unless (member-eq code '(:ok :more))) (mv code off fn2-fields))
       (fn2-fields (fn2-layout-save j p a h s r ph n fn2-fields)))
    (mv code n fn2-fields)))
(defthm fn2-layout-decode-run-wfp
  (implies (fn2-fields-wfp fn2-fields)
           (fn2-fields-wfp (mv-nth 2 (fn2-layout-decode-run layout slot gen off end okind oslot ogen budget resume fn2-fields fn2-pool)))))
(defthm fn2-layout-decode-run-type
  (implies (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields))
           (fn2-fieldsp (mv-nth 2 (fn2-layout-decode-run layout slot gen off end okind oslot ogen budget resume fn2-fields fn2-pool)))))
(in-theory (disable fn2-layout-decode-run))
(defun fn2-layout-decode-step (layout slot gen off end okind oslot ogen budget fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool)
                  :guard (and (fn2-layoutp layout) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
  (fn2-layout-decode-run layout slot gen off end okind oslot ogen budget t fn2-fields fn2-pool))
(defun fn2-layout-decode (layout slot gen off end okind oslot ogen fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool)
                  :guard (and (fn2-layoutp layout) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
  (if (> (fn2-layout-max-size layout) 4096) (mv :budget off fn2-fields)
    (fn2-layout-decode-run layout slot gen off end okind oslot ogen 4096 nil fn2-fields fn2-pool)))
(defthm fn2-layout-decode-wfp
  (implies (fn2-fields-wfp fn2-fields)
           (fn2-fields-wfp (mv-nth 2 (fn2-layout-decode layout slot gen off end okind oslot ogen fn2-fields fn2-pool)))))
(defthm fn2-layout-decode-type
  (implies (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields))
           (fn2-fieldsp (mv-nth 2 (fn2-layout-decode layout slot gen off end okind oslot ogen fn2-fields fn2-pool)))))
(in-theory (disable fn2-layout-decode fn2-layout-decode-step))

(defun fn2-layout-field-size (k i fn2-fields)
  (declare (xargs :stobjs fn2-fields :guard (and (fn2-layout-kindp k) (fn2-fields-wfp fn2-fields)
                                               (natp i) (< i (fn2-fields-rows fn2-fields)))))
  (let ((tag (fn2-layout-kind-code k)))
    (cond ((= tag 10) (+ (fn2-layout-varsize (fn2-fields-ref-len i fn2-fields)) (fn2-fields-ref-len i fn2-fields)))
          ((member-equal tag '(5 8)) (fn2-layout-varsize (fn2-fields-value i fn2-fields)))

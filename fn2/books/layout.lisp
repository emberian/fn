    (assert-event (eq (symbol-class ',step (w state)) :common-lisp-compliant))
    ,@(fn2-codec-spec-events name layout count)
    (table fn2-layouts ',name
      '(:layout ,layout :value-width ,value-width :phase (:enum ,(fn2-codec-symbol name "-PHASE") ,(fn2-codec-phase-keywords layout)) :fields ,count :max-size ,(fn2-layout-max-size layout)
        :encode ,encode :decode ,decode :decode-step ,step :start ,start :size ,sizefn
        :roundtrip-hyps ,(fn2-codec-symbol name "-ROUNDTRIP-HYPS"))))))

(defmacro deflayout (name expression)
  `(make-event
    (let* ((layout ,expression)
           (row (cdr (assoc-eq 'fn2-fields
                              (table-alist 'fn2-columns (w state)))))
           (columns (cadr (member-eq :columns row)))
           (value-width (fn2-columns-width (cadr (assoc-eq 'value columns)))))
      (if (and (fn2-layoutp layout) (consp layout)
               (no-duplicatesp-eq (fn2-codec-phase-keywords layout)))
          (value (fn2-codec-events ',name layout value-width))
        (er soft 'deflayout "Invalid or empty layout ~x0." ',name)))))

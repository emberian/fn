; The query cursor's arms (D6, fn2/books/cursor.lisp): the core faces of its
; own operations (each one stobj-let around the child the arms call), the
; arms' core faces and derived contracts over the child-form arms generated
; in its own book, then its run entry, after the transaction kind's section.
(in-package "ACL2")
(include-book "assembly-callbacks-d-txn")

(defun fn2-cursor-parse (s e mask slot gen okind oslot ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (and (fn2-core-wfp fn2-core) (natp s) (natp e))
                  :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
    (code tag k0 a0 b0 k1 a1 b1)
    (fn2-cursor-parse-line s e mask slot gen okind oslot ogen fn2-pool)
    (mv code tag k0 a0 b0 k1 a1 b1)))
(defun fn2-cursor-tx-fill (slot fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                  :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (n) (fn2-cursor-pool-fill slot fn2-pool) n))
(defun fn2-cursor-tx-cap (slot fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                  :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (n) (fn2-pool-slot-capacity slot fn2-pool) n))
(defun fn2-cursor-mid (slot gen from to okind oslot ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (and (fn2-core-wfp fn2-core) (natp from) (natp to))
                  :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
    (code a b) (fn2-cursor-mid-span slot gen from to okind oslot ogen fn2-pool) (mv code a b)))
(defun fn2-cursor-say (cmd reply mask n0 n1 n2 sslot sgen soff slen slot gen okind oslot ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (and (fn2-core-wfp fn2-core) (natp n0) (natp n1) (natp n2) (natp soff) (natp slen))
                  :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
    (code fn2-pool) (fn2-cursor-render cmd reply mask n0 n1 n2 sslot sgen soff slen slot gen okind oslot ogen fn2-pool)
    (mv code fn2-core)))
(fn2-core-preserves fn2-cursor-say (cmd reply mask n0 n1 n2 sslot sgen soff slen slot gen okind oslot ogen fn2-core)
  :position 1 :rows nil :hints (("Goal" :in-theory (enable fn2-core-wfp))))
(defun fn2-cursor-put-line (what n slot gen okind oslot ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (and (fn2-core-wfp fn2-core) (natp n))
                  :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
    (code fn2-pool) (fn2-cursor-pool-put what n slot gen okind oslot ogen fn2-pool) (mv code fn2-core)))
(fn2-core-preserves fn2-cursor-put-line (what n slot gen okind oslot ogen fn2-core)
  :position 1 :rows nil :hints (("Goal" :in-theory (enable fn2-core-wfp))))
(defun fn2-cursor-reset (slot gen okind oslot ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)
                  :guard-hints (("Goal" :in-theory (enable fn2-core-wfp)))))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
    (code fn2-pool) (fn2-pool-reset slot gen okind oslot ogen fn2-pool) (mv code fn2-core)))
(fn2-core-preserves fn2-cursor-reset (slot gen okind oslot ogen fn2-core)
  :position 1 :rows nil :hints (("Goal" :in-theory (enable fn2-core-wfp))))
(defun fn2-cursor-free-head (ord fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (if (and (natp ord) (< ord *fn2-machine-admitted-max*)) (fn2-machine-free-head ord fn2-core) *fn2-none*))
(defun fn2-cursor-gen-limit (fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (fn2-machine-gen-limit fn2-core))
(defun fn2-cursor-reclaim (id ord retire fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (fn2-machine-reclaim id ord retire fn2-core))
(fn2-core-preserves fn2-cursor-reclaim (id ord retire fn2-core) :rows nil)
(in-theory (disable fn2-cursor-parse fn2-cursor-tx-fill fn2-cursor-tx-cap fn2-cursor-mid fn2-cursor-say
                    fn2-cursor-put-line fn2-cursor-reset fn2-cursor-free-head fn2-cursor-gen-limit fn2-cursor-reclaim))

(defmachine-arms fn2-cursor :wrappers)
(defmachine-run fn2-cursor)

; The commit kind's member table and settled outcomes (B5-4,
; fn2/docs/b-durability.md §11 B5-4 M1, M6). One member row per member of
; each batch row, 16 per batch row at 16 r + m; kinds, never flags on the
; batch row. A settled row is reserved at admission for each owned member,
; filled at settlement and freed when its owner takes it, so a batch row is
; reused without waiting for a client.
(in-package "ACL2")
(include-book "columns")
(include-book "std/util/bstar" :dir :system)
(fn2-book-layer :b)
(defconst *fn2-commit-members-per-batch* 16)
(defconst *fn2-commit-member-count* (* 2 *fn2-commit-members-per-batch*))
(defconst *fn2-commit-settled-count* 64)
(defcolumns fn2-commit-member
 ((kind (:enum fn2-commit-member-kind (:none :keyed-mutation :run-replacement :txn)))
  (slot :u32) (gen :u60) (len :u32)
  (okind :u8) (oslot :u32) (ogen :u60)
  (entries :u32) (entry-bytes :u32) (schema :u32) (event :u60)
  (settled :u32)))
(defcolumns fn2-commit-settled
 ((state (:enum fn2-commit-settled-state (:free :reserved :settled)))
  (okind :u8) (oslot :u32) (ogen :u60) (batch :u60) (event :u60)
  (outcome (:enum fn2-commit-outcome (:pending :accepted :uncertain :refused)))
  (phase :u8) (published :u60)))
;
(defun fn2-cs-rowp (r fn2-commit-settled)
 (declare (xargs :stobjs fn2-commit-settled :guard (fn2-commit-settled-wfp fn2-commit-settled)))
 (and (natp r) (< r (fn2-commit-settled-rows fn2-commit-settled)) (unsigned-byte-p 32 r)))
(defun fn2-cs-ownerp (r okind oslot ogen fn2-commit-settled)
 (declare (xargs :stobjs fn2-commit-settled
  :guard (and (fn2-commit-settled-wfp fn2-commit-settled) (fn2-cs-rowp r fn2-commit-settled))))
 (and (equal (fn2-commit-settled-okind r fn2-commit-settled) okind)
      (equal (fn2-commit-settled-oslot r fn2-commit-settled) oslot)
      (equal (fn2-commit-settled-ogen r fn2-commit-settled) ogen)))
; The first free row at or after I, or nil.
(defun fn2-cs-find-free (i fn2-commit-settled)
 (declare (xargs :stobjs fn2-commit-settled :guard (and (fn2-commit-settled-wfp fn2-commit-settled) (natp i))
  :measure (nfix (- (nfix (fn2-commit-settled-rows fn2-commit-settled)) (nfix i)))))
 (cond ((not (and (natp i) (natp (fn2-commit-settled-rows fn2-commit-settled))
                  (< i (fn2-commit-settled-rows fn2-commit-settled)))) nil)
       ((equal (fn2-commit-settled-state i fn2-commit-settled) *fn2-commit-settled-state-free*) i)
       (t (fn2-cs-find-free (+ 1 i) fn2-commit-settled))))
; Reserve a row for an owned member: (mv :ok row) or (mv :exhausted 0).
(defun fn2-cs-reserve (okind oslot ogen fn2-commit-settled)
 (declare (xargs :stobjs fn2-commit-settled :guard (fn2-commit-settled-wfp fn2-commit-settled)))
 (b* ((r (fn2-cs-find-free 0 fn2-commit-settled))
      ((unless (fn2-cs-rowp r fn2-commit-settled)) (mv :exhausted 0 fn2-commit-settled))
      ((unless (and (unsigned-byte-p 8 okind) (unsigned-byte-p 32 oslot) (unsigned-byte-p 60 ogen)))
       (mv :bounds 0 fn2-commit-settled))
      (fn2-commit-settled (fn2-commit-settled-put r (state *fn2-commit-settled-state-reserved*)
                           (okind okind) (oslot oslot) (ogen ogen) (batch 0) (event 0)
                           (outcome *fn2-commit-outcome-pending*) (phase 0) (published 0))))
  (mv :ok r fn2-commit-settled)))
(fn2-commit-settled-preserves fn2-cs-reserve (okind oslot ogen fn2-commit-settled) :position 2 :raw-rows t)
; Settle a reserved row; anything else is :state (the caller stops the core).
(defun fn2-cs-settle (r batch event outcome phase published fn2-commit-settled)
 (declare (xargs :stobjs fn2-commit-settled :guard (fn2-commit-settled-wfp fn2-commit-settled)))
 (b* (((unless (fn2-cs-rowp r fn2-commit-settled)) (mv :state fn2-commit-settled))
      ((unless (and (equal (fn2-commit-settled-state r fn2-commit-settled) *fn2-commit-settled-state-reserved*)
                    (unsigned-byte-p 60 batch) (unsigned-byte-p 60 event) (unsigned-byte-p 2 outcome)
                    (unsigned-byte-p 8 phase) (unsigned-byte-p 60 published)))
       (mv :state fn2-commit-settled))
      (fn2-commit-settled (fn2-commit-settled-put r (state *fn2-commit-settled-state-settled*)
                           (batch batch) (event event) (outcome outcome) (phase phase) (published published))))
  (mv :ok fn2-commit-settled)))
(fn2-commit-settled-preserves fn2-cs-settle (r batch event outcome phase published fn2-commit-settled) :position 1 :raw-rows t)
(defun fn2-cs-free (r fn2-commit-settled)
 (declare (xargs :stobjs fn2-commit-settled :guard (fn2-commit-settled-wfp fn2-commit-settled)))
 (if (fn2-cs-rowp r fn2-commit-settled)
     (fn2-commit-settled-put r (state *fn2-commit-settled-state-free*) (okind 0) (oslot 0) (ogen 0))
   fn2-commit-settled))
(fn2-commit-settled-preserves fn2-cs-free (r fn2-commit-settled) :raw-rows t)
; The owner's first settled row from I: (mv :ok row), (mv :pending 0) when
; it only has reserved rows, (mv :none 0).
(defun fn2-cs-find-owner (i okind oslot ogen pending fn2-commit-settled)
 (declare (xargs :stobjs fn2-commit-settled :guard (and (fn2-commit-settled-wfp fn2-commit-settled) (natp i))
  :measure (nfix (- (nfix (fn2-commit-settled-rows fn2-commit-settled)) (nfix i)))))
 (cond ((not (and (natp i) (natp (fn2-commit-settled-rows fn2-commit-settled))
                  (< i (fn2-commit-settled-rows fn2-commit-settled))))
        (mv (if pending :pending :none) 0))
       ((not (fn2-cs-ownerp i okind oslot ogen fn2-commit-settled))
        (fn2-cs-find-owner (+ 1 i) okind oslot ogen pending fn2-commit-settled))
       ((equal (fn2-commit-settled-state i fn2-commit-settled) *fn2-commit-settled-state-settled*) (mv :ok i))
       (t (fn2-cs-find-owner (+ 1 i) okind oslot ogen
           (or pending (equal (fn2-commit-settled-state i fn2-commit-settled) *fn2-commit-settled-state-reserved*))
           fn2-commit-settled))))
; Take the owner's settled outcome: (mv code batch event outcome).
(defun fn2-cs-take (okind oslot ogen fn2-commit-settled)
 (declare (xargs :stobjs fn2-commit-settled :guard (fn2-commit-settled-wfp fn2-commit-settled)))
 (b* (((mv code r) (fn2-cs-find-owner 0 okind oslot ogen nil fn2-commit-settled))
      ((unless (and (eq code :ok) (fn2-cs-rowp r fn2-commit-settled))) (mv code 0 0 0 fn2-commit-settled))
      (batch (fn2-commit-settled-batch r fn2-commit-settled))
      (event (fn2-commit-settled-event r fn2-commit-settled))
      (outcome (fn2-commit-settled-outcome r fn2-commit-settled)))
  (let ((fn2-commit-settled (fn2-cs-free r fn2-commit-settled))) (mv :ok batch event outcome fn2-commit-settled))))
(fn2-commit-settled-preserves fn2-cs-take (okind oslot ogen fn2-commit-settled) :position 4 :raw-rows t)
(defun fn2-cs-free-count (i k fn2-commit-settled)
 (declare (xargs :stobjs fn2-commit-settled :guard (and (fn2-commit-settled-wfp fn2-commit-settled) (natp i) (natp k))
  :measure (nfix (- (nfix (fn2-commit-settled-rows fn2-commit-settled)) (nfix i)))))
 (cond ((not (and (natp i) (natp k) (natp (fn2-commit-settled-rows fn2-commit-settled))
                  (< i (fn2-commit-settled-rows fn2-commit-settled)))) (nfix k))
       (t (fn2-cs-free-count (+ 1 i) (if (equal (fn2-commit-settled-state i fn2-commit-settled)
                                             *fn2-commit-settled-state-free*) (+ 1 k) k)
                             fn2-commit-settled))))

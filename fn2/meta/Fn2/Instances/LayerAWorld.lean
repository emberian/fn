that each native agrees with its definition. A definition that leaves the subset (through the
reciprocal, `NUMERATOR`, `REALPART` ...) is named in `nativeOutside`. -/

def «BINARY-LOGIOR».acl2 («I» : Val) («J» : Val) : Val :=
  (Native.lognot (Native.logand (Native.lognot «I») (Native.lognot «J»)))

def «BINARY-LOGXOR».acl2 («I» : Val) («J» : Val) : Val :=
  (Native.lognot (Native.logeqv «I» «J»))

def «BINARY-LOGEQV».acl2 («I» : Val) («J» : Val) : Val :=
  (Native.logand (Native.logorc1 «I» «J») (Native.logorc1 «J» «I»))

def «LOGNOT».acl2 («I» : Val) : Val :=
  (Prim.plus (Prim.neg («IFIX» «I»)) (Val.int (-1)))

def «LOGORC1».acl2 («I» : Val) («J» : Val) : Val :=
  (Native.logior (Native.lognot «I») «J»)

def «MOD».acl2 («X» : Val) («Y» : Val) : Val :=
  (Prim.plus «X» (Prim.neg (Prim.times (Native.floor «X» «Y») «Y»)))

def «NONNEGATIVE-INTEGER-QUOTIENT».acl2 («I» : Val) («J» : Val) : Val :=
  (if ((if ((«=» («NFIX» «J») (Val.int 0))).truthy then («=» («NFIX» «J») (Val.int 0)) else (Prim.lt («IFIX» «I») «J»))).truthy then (Val.int 0) else (Prim.plus (Val.int 1) (Native.niq (Prim.plus «I» (Prim.neg «J»)) «J»)))

def «LEN».acl2 («X» : Val) : Val :=
  (if ((Prim.consp «X»)).truthy then (Prim.plus (Val.int 1) (Native.len (Val.cdr «X»))) else (Val.int 0))

def «NTH».acl2 («N» : Val) («L» : Val) : Val :=
  (if ((«ENDP» «L»)).truthy then Val.nil else (if ((«ZP» «N»)).truthy then (Val.car «L») else (Native.nth (Prim.plus (Val.int (-1)) «N») (Val.cdr «L»))))

def «MV-NTH».acl2 («N» : Val) («L» : Val) : Val :=
  (if ((«ATOM» «L»)).truthy then Val.nil else (if ((«ZP» «N»)).truthy then (Val.car «L») else (Native.nth (Prim.plus (Val.int (-1)) «N») (Val.cdr «L»))))

def «UPDATE-NTH».acl2 («KEY» : Val) («VAL» : Val) («L» : Val) : Val :=

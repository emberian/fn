(in-package "ACL2")
(include-book "../books/format-check")
; This local executable witness satisfies A's exact soundness constraint. It is
; only a concrete test interpretation, never evidence about disks or hashes.
(local (defun fn2-fc-test-integrity (x y) (declare (xargs :guard t)) (equal x y)))
(local (defattach fn2-a-integrity-evidence fn2-fc-test-integrity))
(defun fn2-fc-test-values (layout seed)
 (declare (xargs :verify-guards nil))
 (if (atom layout) nil
  (cons (let ((k (cadar layout)))
          (cond ((eq k :digest) (cons 1 (make-list 32 :initial-element 0)))
                ((and (consp k) (eq (car k) :enum)) 0) (t seed)))
        (fn2-fc-test-values (cdr layout) seed))))
(defconst *fn2-fc-test-context*
 (append '(17 9 1 2 3 4 0 4096) (make-list 16 :initial-element 0) '(8)))
(defun fn2-fc-test-frame (seed)
 (declare (xargs :verify-guards nil))
 (let ((header (fn2-layout-octets *fn2-format-frame-header*
                (list *fn2-format-frame-magic* 0 1 2 3 4 7 8 9 0 0 3))))
  (append header (list seed 72 19) (make-list (- 4060 (len header)) :initial-element 0)
          '(1) (make-list 32 :initial-element 0))))
(defconst *fn2-fc-test-frame* (cadr (fn2-fc-image 0 (fn2-fc-test-frame 3) *fn2-fc-test-context* t 4096)))
(assert-event (fn2-fc-acceptedp 0 *fn2-fc-test-frame* *fn2-fc-test-context*))
(assert-event
 (let* ((a *fn2-fc-test-context*) (b (update-nth 0 18 a)) (bytes *fn2-fc-test-frame*))
  (and (fn2-fc-contextp a) (fn2-fc-contextp b) (fn2-fc-acceptedp 0 bytes a)
       (not (equal (fn2-fc-frame-identity a) (fn2-fc-frame-identity b)))
       (implies (equal (fn-blake3 (fn2-fc-covered 0 bytes a)) (fn-blake3 (fn2-fc-covered 0 bytes b)))
                (fn2-a-integrity-evidence (fn2-fc-covered 0 bytes a) (fn2-fc-covered 0 bytes b)))
       (not (fn2-fc-acceptedp 0 bytes b)))))
(assert-event
 (let ((a *fn2-fc-test-context*) (bytes *fn2-fc-test-frame*))
  (and (fn2-fc-contextp a) (fn2-fc-acceptedp 0 bytes a)
       (equal (fn2-fc-frame-identity a) (fn2-fc-frame-identity a))
       (fn2-a-integrity-evidence (fn2-fc-covered 0 bytes a) (fn2-fc-covered 0 bytes a))
       (not (not (fn2-fc-acceptedp 0 bytes a))))))
(defun fn2-fc-test-page (seed)
 (declare (xargs :verify-guards nil))
 (let ((header (fn2-layout-octets *fn2-format-page-header*
                (list *fn2-format-page-magic* 1 0 1 2 17 3 9 32 3))))
  (append header (make-list (- 32 (len header)) :initial-element 0)
          (list seed 72 19) (make-list 93 :initial-element 0))))
(defun fn2-fc-test-page-context (bytes)
 (declare (xargs :verify-guards nil))
 (append '(17 9 1 2 3 4 0 128)
  (fn-b3-words 8 (fn-blake3 (fn2-fc-covered 1 bytes nil))) (make-list 8 :initial-element 0) '(8)))
(defconst *fn2-fc-test-page* (fn2-fc-test-page 3))
(defconst *fn2-fc-test-page-context* (fn2-fc-test-page-context *fn2-fc-test-page*))
(assert-event
 (let* ((bytes *fn2-fc-test-page*) (a *fn2-fc-test-page-context*) (b (update-nth 6 1 a)))
  (and (fn2-fc-contextp a) (fn2-fc-contextp b) (fn2-fc-acceptedp 1 bytes a)
       (not (equal (fn2-fc-parent-identity a) (fn2-fc-parent-identity b)))
       (not (fn2-fc-acceptedp 1 bytes b)))))
(assert-event
 (let ((bytes *fn2-fc-test-page*) (a *fn2-fc-test-page-context*))
  (and (fn2-fc-contextp a) (fn2-fc-acceptedp 1 bytes a) (equal (fn2-fc-parent-identity a) (fn2-fc-parent-identity a))
       (not (not (fn2-fc-acceptedp 1 bytes a))))))
(defun fn2-fc-test-anchor (seed)
 (declare (xargs :verify-guards nil))
 (fn2-layout-octets *fn2-format-anchor*
  (update-nth 0 1 (update-nth 1 1 (update-nth 2 2 (fn2-fc-test-values *fn2-format-anchor* seed))))))
(defconst *fn2-fc-test-anchor-context* (update-nth 0 1 *fn2-fc-test-context*))
(defconst *fn2-fc-test-anchor* (cadr (fn2-fc-image 2 (fn2-fc-test-anchor 16384) *fn2-fc-test-anchor-context* t 7)))
(assert-event (fn2-fc-acceptedp 2 *fn2-fc-test-anchor* *fn2-fc-test-anchor-context*))
(defun fn2-fc-test-seal (seed)
 (declare (xargs :verify-guards nil))
 (cadr (fn2-fc-image 3 (fn2-layout-octets *fn2-format-sealed-batch*
                       (fn2-fc-test-values *fn2-format-sealed-batch* seed)) *fn2-fc-test-context* t 7)))
(defconst *fn2-fc-test-seal* (fn2-fc-test-seal 3))
(assert-event
 (let* ((a *fn2-fc-test-seal*) (c *fn2-fc-test-context*) (covered (fn2-fc-covered 3 a c)))
  (and (fn2-fc-acceptedp 3 a c) (equal (nthcdr (- (len a) 32) a) (nthcdr (- (len a) 32) a))
       (implies (equal (fn-blake3 covered) (fn-blake3 covered))
                (fn2-a-integrity-evidence covered covered)) (equal covered covered))))
(assert-event
 (let ((a *fn2-fc-test-seal*) (b (fn2-fc-test-seal 4)) (c *fn2-fc-test-context*))
  (and (fn2-fc-acceptedp 3 a c) (fn2-fc-acceptedp 3 b c)
       (not (equal (nthcdr (- (len a) 32) a) (nthcdr (- (len b) 32) b)))
       (implies (equal (fn-blake3 (fn2-fc-covered 3 a c)) (fn-blake3 (fn2-fc-covered 3 b c)))
                (fn2-a-integrity-evidence (fn2-fc-covered 3 a c) (fn2-fc-covered 3 b c)))
       (not (equal (fn2-fc-covered 3 a c) (fn2-fc-covered 3 b c))))))
(assert-event (equal (car (fn2-fc-image 0 *fn2-fc-test-frame* *fn2-fc-test-context* nil 1)) :ok))
(assert-event (equal (car (fn2-fc-image 0 *fn2-fc-test-frame* *fn2-fc-test-context* nil 7)) :ok))
; Independent list BLAKE3 oracle controls the hashing subject, including zeroing.
(assert-event
 (and (equal (nthcdr 4064 *fn2-fc-test-frame*)
             (fn-blake3 (fn2-fc-covered 0 *fn2-fc-test-frame* *fn2-fc-test-context*)))
      (equal (nthcdr (- (len *fn2-fc-test-anchor*) 32) *fn2-fc-test-anchor*)
             (fn-blake3 (fn2-fc-covered 2 *fn2-fc-test-anchor* *fn2-fc-test-context*)))
      (equal (nthcdr (- (len *fn2-fc-test-seal*) 32) *fn2-fc-test-seal*)
             (fn-blake3 (fn2-fc-covered 3 *fn2-fc-test-seal* *fn2-fc-test-context*)))))

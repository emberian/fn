; Loaded after sim-layer-a.lisp. Fingerprints are regression evidence, not
; collision-free equivalence or a cryptographic integrity claim.
(in-package "ACL2")
(defun fn2-replay-disk-hash-aux (left hash fn2-sim-storage)
  (declare (xargs :stobjs fn2-sim-storage :verify-guards nil :measure (nfix left)
                  :hints (("Goal" :in-theory nil
                           :use ((:instance fn2-test-countdown (x left))
                                 (:instance fn2-test-count-op (x left)))))))
  (if (zp left) hash
    (let* ((i (- left 1))
           (hash (fn2-sim-fold hash (fn2-sim-storage-durable i fn2-sim-storage)))
           (hash (fn2-sim-fold hash (fn2-sim-storage-pending i fn2-sim-storage)))
           (hash (fn2-sim-fold hash (fn2-sim-storage-stamp i fn2-sim-storage)))
           (hash (fn2-sim-fold hash (fn2-sim-storage-durable-stamp i fn2-sim-storage))))
      (fn2-replay-disk-hash-aux i hash fn2-sim-storage))))
(in-theory (disable fn2-replay-disk-hash-aux))
(defun fn2-replay-disk-hash (fn2-sim)
  (declare (xargs :stobjs fn2-sim :verify-guards nil))
  (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim)))
    (hash)
    (fn2-replay-disk-hash-aux (fn2-sim-storage-rows fn2-sim-storage)
       (fn2-sim-fold 2166136261 (fn2-storage-dead fn2-sim-storage)) fn2-sim-storage)
    hash))
(in-theory (disable fn2-replay-disk-hash))

(defun fn2-sim-replay-control-run (fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
       (fn2-sim (fn2-sim-init 73 :broad *fn2-scenario-revision* *fn2-profile-tiny* fn2-sim))
       ((mv status mask fn2-core fn2-sim fn2-own)
        (fn2-scenario-one-run *fn2-profile-tiny* fn2-core fn2-sim fn2-own))
       (digest (fn2-sim-digest fn2-sim)) (observations (fn2-sim-observations fn2-sim))
       (s0 (fn2-sim-s0 fn2-sim)) (s1 (fn2-sim-s1 fn2-sim))
       (s2 (fn2-sim-s2 fn2-sim)) (s3 (fn2-sim-s3 fn2-sim))
       (disk (fn2-replay-disk-hash fn2-sim))
       (fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
       (fn2-sim (fn2-sim-init 73 :broad *fn2-scenario-revision* *fn2-profile-tiny* fn2-sim))
       ((mv again again-mask fn2-core fn2-sim fn2-own)
        (fn2-scenario-one-run *fn2-profile-tiny* fn2-core fn2-sim fn2-own))
       (ok (and (eq status :pass) (eq again status) (equal mask again-mask)
                (equal digest (fn2-sim-digest fn2-sim))
                (equal observations (fn2-sim-observations fn2-sim))
                (equal s0 (fn2-sim-s0 fn2-sim)) (equal s1 (fn2-sim-s1 fn2-sim))
                (equal s2 (fn2-sim-s2 fn2-sim)) (equal s3 (fn2-sim-s3 fn2-sim))
                (equal disk (fn2-replay-disk-hash fn2-sim)))))
    (progn$ (cw "REPLAY CONTROL seed=73 same-object-reset=~x0 digest=~x1 storage-fingerprint=~x2~%"
                (if ok :pass :fail) digest disk)
            (mv ok fn2-core fn2-sim fn2-own))))
(in-theory (disable fn2-sim-replay-control-run))
(defun fn2-sim-replay-control ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (ok fn2-core)
      (with-local-stobj fn2-sim
        (mv-let (ok fn2-core fn2-sim)
          (with-local-stobj fn2-own
            (mv-let (ok fn2-core fn2-sim fn2-own)
              (fn2-sim-replay-control-run fn2-core fn2-sim fn2-own)
              (mv ok fn2-core fn2-sim)))
          (mv ok fn2-core)))
      ok)))
(in-theory (disable fn2-sim-replay-control))

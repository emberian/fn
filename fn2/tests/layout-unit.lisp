(in-package "ACL2")
(include-book "../books/layout")
(include-book "std/util/bstar" :dir :system)

; These are test layouts, not the storage format declarations of quest B2c.
(deflayout fn2-layout-test-header
  '((magic :u32) (version :u8) (type (:enum frame (:data :commit :checkpoint)))
    (history (:id history)) (incarnation (:id incarnation))
    (epoch (:id writer-epoch)) (commit (:id commit)) (event (:id event))
    (payload (:octets 17)) (integrity :digest) (padding (:zero 3))))
(deflayout fn2-layout-test-anchor
  '((magic :u32) (version :u16) (address :u64) (checkpoint (:id checkpoint))
    (allocation (:id allocation)) (article (:id article))
    (number (:id group-number)) (count :varint) (counter :u60)
    (valid :bool) (integrity :digest) (padding (:zero 7))))
(assert-event
 (and (equal *fn2-layout-test-anchor-phase-count* 13)
      (equal *fn2-layout-test-anchor-phase-field-count* 7)
      (equal (fn2-layout-test-anchor-phase-keyword->code :field-count) 7)
      (equal (fn2-layout-test-anchor-phase-code->keyword 7) :field-count)
      (not (no-duplicatesp-eq (fn2-codec-phase-keywords '((done :u8)))))
      (not (no-duplicatesp-eq (fn2-codec-phase-keywords '((:done :u8)))))))
(assert-event (and (fn2-layoutp *fn2-layout-test-header*)
                   (fn2-layoutp *fn2-layout-test-anchor*)
                   (not (fn2-layoutp '((x (:id typo)))))
                   (not (fn2-layoutp '((x (:enum bad (:a :a))))))))
(assert-event (equal (fn2-layout-octets '((x :u16) (y :u32) (z :u64))
                                      '(4660 305419896 81985529216486895))
                     '(52 18 120 86 52 18 239 205 171 137 103 69 35 1)))
(assert-event (equal (fn2-layout-octets '((a :varint) (b :varint) (c :varint))
                                      '(0 128 1152921504606846975))
                     '(0 128 1 255 255 255 255 255 255 255 255 15)))
(assert-event (equal (fn2-layout-max-size '((payload (:octets 4094)))) 4096))
(assert-event (equal (fn2-layout-fixed-offsets '((a :u16) (b :varint) (c :u8)))
                     '((a 2 0 :u16) (b 5 2 :varint) (c 1 nil :u8))))
(assert-event (not (equal (fn2-layout-fixed-offsets '((id (:id history))))
                          (fn2-layout-fixed-offsets '((id (:id article)))))))

; Test-only list adapters. Runtime code never invokes any of these helpers.
(defun fn2-layout-test-write (xs slot off fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (if (atom xs) fn2-pool
    (mv-let (code fn2-pool) (fn2-pool-write slot 1 off (car xs) 1 0 1 fn2-pool)
      (if (not (eq code :ok))
          (prog2$ (er hard 'fn2-layout-test-write "Pool write refused: ~x0." code) fn2-pool)
        (fn2-layout-test-write (cdr xs) slot (+ 1 (nfix off)) fn2-pool)))))
(defun fn2-layout-test-read (n slot off fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix n)))
  (if (zp n) nil
    (mv-let (code byte) (fn2-pool-read slot 1 off 1 0 1 fn2-pool)
      (if (not (eq code :ok))
          (prog2$ (er hard 'fn2-layout-test-read "Pool read refused: ~x0." code) nil)
        (cons byte (fn2-layout-test-read (- n 1) slot (+ 1 (nfix off)) fn2-pool))))))
(defun fn2-layout-test-put (layout values i off fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (if (atom layout) (mv fn2-fields fn2-pool)
    (b* ((kind (cadar layout)) (v (car values))
         (refp (or (eq kind :digest) (and (consp kind) (eq (car kind) :octets))))
         (bytes (if (eq kind :digest) (cdr v) v))
         (stored (cond ((eq kind :digest) (car v)) (refp 0)
                       ((and (consp kind) (eq (car kind) :zero)) 0) (t v)))
         ((unless (natp stored))
          (prog2$ (er hard 'fn2-layout-test-put "Malformed scalar fixture: ~x0." v)
                  (mv fn2-fields fn2-pool)))
         (fn2-fields (fn2-fields-set-value i stored fn2-fields))
         (fn2-fields (fn2-fields-set-ref-slot i 2 fn2-fields))
         (fn2-fields (fn2-fields-set-ref-gen i 1 fn2-fields))
         (fn2-fields (fn2-fields-set-ref-off i off fn2-fields))
         (fn2-fields (fn2-fields-set-ref-len i (if refp (len bytes) 0) fn2-fields))
         (fn2-pool (if refp (fn2-layout-test-write bytes 2 off fn2-pool) fn2-pool)))
      (fn2-layout-test-put (cdr layout) (cdr values) (+ 1 (nfix i))
        (+ (nfix off) (if refp (len bytes) 0)) fn2-fields fn2-pool))))
(defun fn2-layout-test-values (layout i fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (if (atom layout) nil
    (let* ((kind (cadar layout)) (v (fn2-fields-value i fn2-fields))
           (refp (or (eq kind :digest) (and (consp kind) (eq (car kind) :octets))))
           (bytes (and refp (fn2-layout-test-read (fn2-fields-ref-len i fn2-fields)
                    (fn2-fields-ref-slot i fn2-fields) (fn2-fields-ref-off i fn2-fields) fn2-pool))))
      (cons (cond ((eq kind :digest) (cons v bytes)) (refp bytes)
                  ((and (consp kind) (eq (car kind) :zero)) nil) (t v))
            (fn2-layout-test-values (cdr layout) (+ 1 (nfix i)) fn2-fields fn2-pool)))))

(defun fn2-layout-test-init (fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (b* ((fn2-fields (fn2-fields-init 32 fn2-fields))
       (fn2-fields (fn2-fields-set-status 0 17 fn2-fields))
       (fn2-fields (fn2-layout-save 1 2 3 4 5 6 7 8 fn2-fields))
       (fn2-pool (fn2-pool-init '((3 . 65536)) 1 100 fn2-pool))
       ((mv c0 s0 g0 fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
       ((mv c1 s1 g1 fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
       ((mv c2 s2 g2 fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
       ((unless (and (eq c0 :ok) (equal s0 0) (equal g0 1)
                     (eq c1 :ok) (equal s1 1) (equal g1 1)
                     (eq c2 :ok) (equal s2 2) (equal g2 1)))
        (prog2$ (er hard 'fn2-layout-test-init "Unexpected pool reservations.")
                (mv fn2-fields fn2-pool))))
    (mv fn2-fields fn2-pool)))
(defun fn2-layout-test-row (i fn2-fields)
  (declare (xargs :stobjs fn2-fields :verify-guards nil))
  (list (fn2-fields-value i fn2-fields)
        (fn2-fields-ref-slot i fn2-fields) (fn2-fields-ref-gen i fn2-fields)
        (fn2-fields-ref-off i fn2-fields) (fn2-fields-ref-len i fn2-fields) (fn2-fields-status i fn2-fields)))
(defun fn2-layout-test-snapshot (fn2-fields)
  (declare (xargs :stobjs fn2-fields :verify-guards nil))
  (list (fn2-layout-test-row 0 fn2-fields) (fn2-layout-test-row 1 fn2-fields)
        (fn2-fields-cursor fn2-fields) (fn2-fields-pos fn2-fields) (fn2-fields-acc fn2-fields)
        (fn2-fields-high fn2-fields) (fn2-fields-size fn2-fields) (fn2-fields-ref fn2-fields)
        (fn2-fields-phase fn2-fields) (fn2-fields-next fn2-fields)))
(defconst *fn2-layout-test-malformed*
  '((((v :varint)) (128 0) :noncanonical)
    (((v :varint)) (129 128 128 128 128 128 128 128 128 0) :noncanonical)
    (((v :varint)) (128 128 128 128 128 128 128 128 16) :wide)
    (((v :varint)) (128 128 128 128 128 128 128 128 128 1) :wide)
    (((v :varint)) (128 128 128) :truncated)
    (((v :u64)) (255 255 255 255 255 255 255 16) :wide)
    (((v :u64)) (255 255 255 255 255 255 255 255) :wide)
    (((a :u8) (v :u64)) (7 255 255 255 255 255 255 255 16) :wide)
    (((v (:enum tag (:a :b)))) (2) :unknown-tag)
    (((v (:zero 3))) (0 1 0) :nonzero-padding)
    (((a :u8) (v (:zero 3))) (7 0 1 0) :nonzero-padding)
    (((v (:octets 2))) (3 0 0 0) :length)))
(defun fn2-layout-test-malformed (cases fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (if (atom cases) (mv t fn2-fields fn2-pool)
    (b* ((layout (caar cases)) (bytes (cadar cases)) (expected (caddar cases))
         (before (fn2-layout-test-snapshot fn2-fields))
         (fn2-pool (fn2-layout-test-write bytes 0 0 fn2-pool))
         ((mv code next fn2-fields)
          (fn2-layout-decode layout 0 1 0 (len bytes) 1 0 1 fn2-fields fn2-pool))
         ((mv model-code values rest) (fn2-layout-parse layout bytes))
         (- values rest)
         ((unless (and (eq code expected) (eq model-code expected) (equal next 0)
                  (equal bytes (fn2-layout-test-read (len bytes) 0 0 fn2-pool))
                  (equal before (fn2-layout-test-snapshot fn2-fields))))
          (mv (list :malformed code expected bytes) fn2-fields fn2-pool)))
      (fn2-layout-test-malformed (cdr cases) fn2-fields fn2-pool))))
; The invalid resident value can only exist in the logical stobj: its typed
; runtime column rejects it before encode. Exercise encode's :value branch
; in logic, including destination preservation, without an invalid raw write.
(defun-nx fn2-layout-test-u64-value-refusal ()
  (let* ((f (fn2-fields-init 1 (create-fn2-fields)))
         (f (fn2-fields-set-value 0 1152921504606846976 f))
         (p (fn2-pool-init '((1 . 8)) 1 100 (create-fn2-pool))))
    (mv-let (code slot gen p) (fn2-pool-reserve 0 1 0 1 p)
      (if (not (eq code :ok)) nil
      (mv-let (code next after) (fn2-layout-encode '((v :u64)) slot gen 0 1 0 1 f p)
        (and (eq code :value) (equal next 0) (equal after p)))))))
(defthm fn2-layout-test-u64-value-refusal-holds
  (fn2-layout-test-u64-value-refusal)
  :rule-classes nil
  :hints (("Goal" :in-theory (union-theories (current-theory :here)
                                            (function-theory :here)))))
(defun fn2-layout-test-u64 (fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (b* ((bytes '(255 255 255 255 255 255 255 15))
       (fn2-pool (fn2-layout-test-write bytes 0 0 fn2-pool))
       ((mv code next fn2-fields)
        (fn2-layout-decode '((v :u64)) 0 1 0 8 1 0 1 fn2-fields fn2-pool))
       ((mv mc values rest) (fn2-layout-parse '((v :u64)) bytes))
       ((unless (and (eq code :ok) (equal next 8)
                     (equal (fn2-fields-value 0 fn2-fields) 1152921504606846975)
                     (eq mc :ok) (equal values '(1152921504606846975)) (null rest)))
        (mv :u64-decode fn2-fields fn2-pool))
       ((mv code end fn2-pool)
        (fn2-layout-encode '((v :u64)) 1 1 0 1 0 1 fn2-fields fn2-pool)))
    (mv (and (eq code :ok) (equal end 8)
             (equal bytes (fn2-layout-test-read 8 1 0 fn2-pool))) fn2-fields fn2-pool)))
; Suspend immediately before the forbidden byte, then retain the saved
; continuation and every row on refusal. The source octets remain readable.
(defun fn2-layout-test-u64-resume (fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (b* ((bytes '(255 255 255 255 255 255 255 16))
       (fn2-pool (fn2-layout-test-write bytes 0 0 fn2-pool))
       (fn2-fields (fn2-layout-start fn2-fields))
       ((mv code next fn2-fields)
        (fn2-layout-decode-step '((v :u64)) 0 1 0 8 1 0 1 7 fn2-fields fn2-pool))
       ((unless (and (eq code :more) (equal next 7)
                     (equal (fn2-fields-acc fn2-fields) 72057594037927935)))
        (mv :u64-suspend fn2-fields fn2-pool))
       (before (fn2-layout-test-snapshot fn2-fields))
       ((mv code next fn2-fields)
        (fn2-layout-decode-step '((v :u64)) 0 1 0 8 1 0 1 1 fn2-fields fn2-pool)))
    (mv (and (eq code :wide) (equal next 0)
             (equal before (fn2-layout-test-snapshot fn2-fields))
             (equal bytes (fn2-layout-test-read 8 0 0 fn2-pool))) fn2-fields fn2-pool)))
(defun fn2-layout-test-boundary (fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (b* (((mv code end fn2-pool)
        (fn2-layout-encode '((padding (:zero 4096))) 0 1 0 1 0 1 fn2-fields fn2-pool))
       ((unless (and (eq code :ok) (equal end 4096)))
        (mv (list :boundary-encode code end) fn2-fields fn2-pool))
       ((mv code next fn2-fields)
        (fn2-layout-decode '((padding (:zero 4096))) 0 1 0 4096 1 0 1 fn2-fields fn2-pool))
       ((unless (and (eq code :ok) (equal next 4096)))
        (mv (list :boundary-decode code next) fn2-fields fn2-pool))
       ; Empty source [1,1) does not overlap destination [0,2).
       (fn2-fields (fn2-fields-set-ref-off 0 1 fn2-fields))
       ((mv code end fn2-pool)
        (fn2-layout-encode '((payload (:octets 0)) (v :u8) (pad (:zero 0))) 0 1 0 1 0 1 fn2-fields fn2-pool)))
    (mv (if (and (eq code :ok) (equal end 2)) t (list :empty-alias code end)) fn2-fields fn2-pool)))
(defun fn2-layout-test-refusals (cases fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (if (atom cases) (mv t fn2-fields fn2-pool)
    (b* ((before (fn2-layout-test-snapshot fn2-fields))
         (filled (fn2-pool-slot-fill 0 fn2-pool))
         (bytes (fn2-layout-test-read filled 0 0 fn2-pool))
         ((mv code next fn2-pool)
          (fn2-layout-encode '((v :u16)) 0 (caar cases) (caddar cases)
             (cadar cases) 0 1 fn2-fields fn2-pool))
         (- next)
         ((mv dc dn fn2-fields)
          (fn2-layout-decode '((v :u16)) 0 (caar cases) (caddar cases) 2
             (cadar cases) 0 1 fn2-fields fn2-pool))
         (- dn)
         ((unless (and (eq code (cadddr (car cases))) (eq dc code)
                   (equal before (fn2-layout-test-snapshot fn2-fields))
                   (equal filled (fn2-pool-slot-fill 0 fn2-pool))
                   (equal bytes (fn2-layout-test-read filled 0 0 fn2-pool))))
          (mv (list :refusal (car cases) code) fn2-fields fn2-pool)))
      (fn2-layout-test-refusals (cdr cases) fn2-fields fn2-pool))))
(deflayout fn2-layout-test-u8 '((v :u8)))
(deflayout fn2-layout-test-varint '((v :varint)))
(defun fn2-layout-test-roundtrip-tooth (value expected fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (b* ((layout *fn2-layout-test-u8*) (fn2-fields (fn2-fields-set-value 0 value fn2-fields))
       (hyp (fn2-layout-test-u8-roundtrip-hyps 0 0 1 0 1 0 1 fn2-fields fn2-pool))
       ((mv ec end fn2-pool) (fn2-layout-test-u8-encode 0 0 1 0 1 0 1 fn2-fields fn2-pool))
       ((mv code next fn2-fields) (fn2-layout-test-u8-decode 0 0 1 0 end 1 0 1 fn2-fields fn2-pool))
       (conclusion (fn2-layout-roundtrip-resultp layout (list value) code next end
                     (fn2-layout-test-values layout 0 fn2-fields fn2-pool)
                     (fn2-layout-test-read end 0 0 fn2-pool))))
    (mv (and (equal hyp expected) (equal conclusion expected)
             (eq ec (if expected :ok :value))
             (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-pool-semanticp fn2-pool)
             (eq (fn2-layout-range-code 0 1 0 1 t 1 0 1 fn2-pool) :ok)) fn2-fields fn2-pool)))
(defun fn2-layout-test-canonical-tooth (bytes expected fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (b* ((layout *fn2-layout-test-varint*) (fn2-fields (fn2-fields-set-value 0 42 fn2-fields))
       (fn2-pool (fn2-layout-test-write bytes 0 0 fn2-pool))
       ((mv code next fn2-fields) (fn2-layout-test-varint-decode 0 0 1 0 (len bytes) 1 0 1 fn2-fields fn2-pool)))
    (mv (and (equal (and (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)
                     (fn2-pool-semanticp fn2-pool)
                     (<= *fn2-layout-test-varint-num-fields* (fn2-fields-rows fn2-fields))
                     (eq code :ok)) expected)
             (equal (fn2-layout-canonical-resultp layout
                       (fn2-layout-test-values layout 0 fn2-fields fn2-pool)
                       (fn2-layout-test-read next 0 0 fn2-pool)) expected)
             (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-pool-semanticp fn2-pool)
             (eq code (if expected :ok :noncanonical))) fn2-fields fn2-pool)))
(defun fn2-layout-test-unit ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-fields
    (mv-let (ok fn2-fields)
      (with-local-stobj fn2-pool
        (mv-let (ok fn2-fields fn2-pool)
          (b* (((mv fn2-fields fn2-pool) (fn2-layout-test-init fn2-fields fn2-pool))
               ((mv ok fn2-fields fn2-pool)
                (fn2-layout-test-malformed *fn2-layout-test-malformed* fn2-fields fn2-pool))
               ((unless (eq ok t)) (mv ok fn2-fields fn2-pool))
               ((mv ok fn2-fields fn2-pool) (fn2-layout-test-u64 fn2-fields fn2-pool))
               ((unless (eq ok t)) (mv ok fn2-fields fn2-pool))
               ((mv ok fn2-fields fn2-pool) (fn2-layout-test-u64-resume fn2-fields fn2-pool))
               ((unless (eq ok t)) (mv ok fn2-fields fn2-pool))
               ((mv ok fn2-fields fn2-pool) (fn2-layout-test-boundary fn2-fields fn2-pool))
               ((unless (eq ok t)) (mv ok fn2-fields fn2-pool))
               ((mv ok fn2-fields fn2-pool) (fn2-layout-test-roundtrip-tooth 42 t fn2-fields fn2-pool))
               ((unless ok) (mv :roundtrip-positive fn2-fields fn2-pool))
               ((mv ok fn2-fields fn2-pool) (fn2-layout-test-roundtrip-tooth 256 nil fn2-fields fn2-pool))
               ((unless ok) (mv :roundtrip-negative fn2-fields fn2-pool))
               ((mv ok fn2-fields fn2-pool) (fn2-layout-test-canonical-tooth '(42) t fn2-fields fn2-pool))
               ((unless ok) (mv :canonical-positive fn2-fields fn2-pool))
               ((mv ok fn2-fields fn2-pool) (fn2-layout-test-canonical-tooth '(170 0) nil fn2-fields fn2-pool))
               ((unless (eq ok t)) (mv ok fn2-fields fn2-pool)))
            (fn2-layout-test-refusals '((2 1 0 :stale) (1 2 0 :owner) (1 1 65536 :bounds)) fn2-fields fn2-pool))
          (mv ok fn2-fields)))
      ok)))
(assert-event (equal (fn2-layout-test-unit) t))

; The controls above exercise the list interpreter. These tests exercise the
; generated codec, including independent continuation ownership and u60 columns.
(deflayout fn2-layout-test-u64 '((v :u64)))
(deflayout fn2-layout-test-large '((payload (:octets 5000))))
(deflayout fn2-layout-test-empty '((payload (:octets 0)) (v :u8) (padding (:zero 0))))

; A test-only dispatch is compiled from the registry. Nothing on a served path
; chooses a codec by comparing layout lists, and no test hand-maintains 37 arms.
(defun fn2-layout-test-dispatch-arms (entries mode)
  (declare (xargs :verify-guards nil))
  (if (atom entries) nil
    (let* ((row (cdar entries))
           (layout (cadr (member-eq :layout row)))
           (callee (cadr (member-eq mode row)))
           (args (case mode
                   ((:encode :roundtrip-hyps) '(base slot gen off okind oslot ogen fn2-fields fn2-pool))
                   (:decode '(base slot gen off end okind oslot ogen fn2-fields fn2-pool))
                   (:decode-step '(base slot gen off end okind oslot ogen budget fn2-fields fn2-pool))
                   (otherwise '(base fn2-fields)))))
      (cons `((equal layout ',layout) (,callee ,@args))
            (fn2-layout-test-dispatch-arms (cdr entries) mode)))))
(defun fn2-layout-test-dispatch-events (prefix entries modes)
  (declare (xargs :verify-guards nil))
  (if (atom modes) nil
    (let* ((mode (car modes))
           (name (fn2-codec-symbol prefix (concatenate 'string "-" (symbol-name mode))))
           (args (case mode
                   ((:encode :roundtrip-hyps) '(layout base slot gen off okind oslot ogen fn2-fields fn2-pool))
                   (:decode '(layout base slot gen off end okind oslot ogen fn2-fields fn2-pool))
                   (:decode-step '(layout base slot gen off end okind oslot ogen budget fn2-fields fn2-pool))
                   (otherwise '(layout base fn2-fields))))
           (stobjs (if (eq mode :start) '(fn2-fields) '(fn2-fields fn2-pool)))
           (failure (case mode
                      (:encode '(mv :unknown-layout off fn2-pool))
                      (:roundtrip-hyps nil)
                      (:start 'fn2-fields)
                      (otherwise '(mv :unknown-layout off fn2-fields)))))
      (cons `(defund ,name ,args
               (declare (xargs :stobjs ,stobjs :verify-guards nil))
               (cond ,@(fn2-layout-test-dispatch-arms entries mode)
                     (t (prog2$ (er hard ',name "Undeclared test layout.") ,failure))))
            (fn2-layout-test-dispatch-events prefix entries (cdr modes))))))
(make-event
 (value `(progn ,@(fn2-layout-test-dispatch-events
                  'fn2-layout-test-codec (table-alist 'fn2-layouts (w state))
                  '(:encode :decode :decode-step :start)))))

(defun fn2-layout-test-continuation (base fn2-fields)
  (declare (xargs :stobjs fn2-fields :verify-guards nil))
  (list (fn2-fields-decode-phase base fn2-fields)
        (fn2-fields-decode-pos base fn2-fields)
        (fn2-fields-decode-acc base fn2-fields)
        (fn2-fields-decode-high base fn2-fields)
        (fn2-fields-decode-size base fn2-fields)
        (fn2-fields-decode-ref base fn2-fields)
        (fn2-fields-decode-payload base fn2-fields)
        (fn2-fields-decode-next base fn2-fields)))
(defun fn2-layout-test-concurrent (fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (b* ((maximum '(255 255 255 255 255 255 255 15))
       (other '(42 0 0 0 0 0 0 0))
       (fn2-pool (fn2-layout-test-write maximum 0 0 fn2-pool))
       (fn2-pool (fn2-layout-test-write (append (make-list 11 :initial-element 0) other) 1 0 fn2-pool))
       (fn2-fields (fn2-layout-test-u64-start 0 fn2-fields))
       (fn2-fields (fn2-layout-test-u64-start 16 fn2-fields))
       ((mv c0 n0 fn2-fields)
        (fn2-layout-test-u64-decode-step 0 0 1 0 8 1 0 1 3 fn2-fields fn2-pool))
       (saved (fn2-layout-test-continuation 0 fn2-fields))
       ((mv c1 n1 fn2-fields)
        (fn2-layout-test-u64-decode-step 16 1 1 11 19 1 0 1 4 fn2-fields fn2-pool))
       ((unless (and (eq c0 :more) (equal n0 3) (eq c1 :more) (equal n1 15)
                     (equal saved (fn2-layout-test-continuation 0 fn2-fields))))
        (mv :concurrent-suspend fn2-fields fn2-pool))
       (saved (fn2-layout-test-continuation 16 fn2-fields))
       ((mv c0 n0 fn2-fields)

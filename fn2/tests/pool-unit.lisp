; Statement-first teeth.  Both the complete hypothesis and the shared scalar
; conclusion are evaluated.  The negative cases falsify both, not merely an
; implication whose antecedent happened to be false.
(defun fn2-pool-test-loan-fixture (fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (b* ((fn2-pool (fn2-pool-init '((2 . 64)) 5 20 fn2-pool))
       ((mv ?code ?slot ?gen fn2-pool) (fn2-pool-reserve 0 1 10 3 fn2-pool))
       ((mv ?code fn2-pool) (fn2-pool-write 0 5 0 10 1 10 3 fn2-pool))
       ((mv ?code fn2-pool) (fn2-pool-write 0 5 1 11 1 10 3 fn2-pool))
       ((mv ?code ?off fn2-pool) (fn2-pool-lease-in 0 5 3 7 9 1 10 3 fn2-pool))
       ((mv ?code fn2-pool) (fn2-pool-adapter-write 0 5 7 9 2 70 fn2-pool))
       ((mv ?code fn2-pool) (fn2-pool-adapter-write 0 5 7 9 3 71 fn2-pool))
       ((mv ?code fn2-pool) (fn2-pool-adapter-write 0 5 7 9 4 72 fn2-pool)))
    fn2-pool))

(defun fn2-pool-test-byte-teeth-run (op n positivep fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (b* ((fn2-pool (fn2-pool-test-loan-fixture fn2-pool))
       (a (if (eq op :complete-in) (list 0 5 7 9 n) (list 0 5 7 9 n 99)))
       (hyp (fn2-pool-byte-fill-hyps op a fn2-pool))
       (before (fn2-pool-test-snapshot fn2-pool))
       (old-prefix (fn2-pool-logical-octets 2 0 fn2-pool))

(in-package "ACL2")

(include-book "../books/pool")
(include-book "std/util/bstar" :dir :system)

; Test-only snapshots may allocate: no function in this book is on a served path.
; Every refusal compares all slot columns, the backing bytes, and pool metadata.
(defun fn2-pool-test-slots (i fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil
                  :measure (nfix (- (nfix (fn2-pool-nslots fn2-pool)) (nfix i)))))
  (if (or (not (natp i)) (>= i (nfix (fn2-pool-nslots fn2-pool)))) nil
    (cons (list
            (fn2-pool-gen i fn2-pool)
            (fn2-pool-base i fn2-pool)
            (fn2-pool-cap i fn2-pool)
            (fn2-pool-state i fn2-pool)
            (fn2-pool-owner-kind i fn2-pool)
            (fn2-pool-owner-slot i fn2-pool)
            (fn2-pool-owner-gen i fn2-pool)
            (fn2-pool-lease-op-slot i fn2-pool)
            (fn2-pool-lease-op-gen i fn2-pool)
            (fn2-pool-lease-off i fn2-pool)
            (fn2-pool-lease-len i fn2-pool)
            (fn2-pool-out-count i fn2-pool)
            (fn2-pool-fill i fn2-pool)
            (fn2-pool-hand-to-kind i fn2-pool)
            (fn2-pool-hand-to-slot i fn2-pool)
            (fn2-pool-hand-to-gen i fn2-pool)
            (fn2-pool-next-free i fn2-pool)
            (fn2-pool-class i fn2-pool)
           )
          (fn2-pool-test-slots (+ i 1) fn2-pool))))

(defun fn2-pool-test-bytes (i fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil
                  :measure (nfix (- (fn2-pool-data-length fn2-pool) (nfix i)))))
  (if (or (not (natp i)) (>= i (fn2-pool-data-length fn2-pool))) nil
    (cons (fn2-pool-datai i fn2-pool)
          (fn2-pool-test-bytes (+ i 1) fn2-pool))))

(defun fn2-pool-test-class-metadata (i fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil
                  :measure (nfix (- 16 (nfix i)))))
  (if (or (not (natp i)) (>= i 16)) nil
    (cons (list (fn2-pool-class-headsi i fn2-pool)
                (fn2-pool-class-countsi i fn2-pool)
                (fn2-pool-class-sizesi i fn2-pool))
          (fn2-pool-test-class-metadata (+ i 1) fn2-pool))))

(defun fn2-pool-test-snapshot (fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (list (fn2-pool-test-slots 0 fn2-pool)
        (fn2-pool-test-bytes 0 fn2-pool)
        (fn2-pool-test-class-metadata 0 fn2-pool)
        (fn2-pool-nslots fn2-pool)
        (fn2-pool-capacity-bytes fn2-pool)
        (fn2-pool-nclasses fn2-pool)
        (fn2-pool-gen-limit fn2-pool)
        (fn2-pool-retired-count fn2-pool)))


       ((mv code fn2-pool)
        (if (eq op :complete-in)
            (fn2-pool-complete-in 0 5 7 9 n fn2-pool)
          (fn2-pool-adapter-write 0 5 7 9 n 99 fn2-pool)))
       (conclusion
        (fn2-pool-byte-fill-resultp
         op code (equal before (fn2-pool-test-snapshot fn2-pool))
         (fn2-pool-state 0 fn2-pool) (fn2-pool-fill 0 fn2-pool) 2 n
         old-prefix
         (fn2-pool-logical-octets (fn2-pool-fill 0 fn2-pool) 0 fn2-pool)
         loan-prefix)))
    (mv (and (equal (if hyp t nil) positivep)
             (equal (if conclusion t nil) positivep)) fn2-pool)))

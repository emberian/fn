; B-S2 controls (b-durability.md §11b): a transaction member's workspace is
; admitted whole or not at all, a second member joins the open collector at
; the next event, and the seal writes each record verbatim after a record
; header at its member's event.
(in-package "ACL2")
(include-book "../sim/commit-history")
(local (defthm fn2-ctu-countdown
 (implies (not (zp left)) (o< (nfix (- left 1)) (nfix left))) :rule-classes nil))
(local (defthm fn2-ctu-count-op (o-p (nfix left)) :rule-classes nil))
(defun fn2-ctu-values (layout)
 (declare (xargs :verify-guards nil :measure (len layout)))
 (if (atom layout) nil
  (let ((k (cadar layout)))
   (cons (cond ((eq k :digest) (cons 1 (make-list 32 :initial-element 7)))
               ((and (consp k) (eq (car k) :octets)) '(60 97 64 98 62))
               ((and (consp k) (eq (car k) :enum)) 0)
               (t 1))
         (fn2-ctu-values (cdr layout))))))
(defconst *fn2-ctu-body*
 (fn2-layout-octets *fn2-format-article-acceptance* (fn2-ctu-values *fn2-format-article-acceptance*)))
(defconst *fn2-ctu-record*
 (append (fn2-layout-octets *fn2-format-txn-record* (list *record-kind-article-acceptance* (len *fn2-ctu-body*)))
         *fn2-ctu-body*))
(defconst *fn2-ctu-owner* '(9 3 5))
(defun fn2-ctu-fill (bytes slot gen at fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (len bytes)))
 (if (atom bytes) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen at (car bytes) 9 3 5 fn2-core)
   (if (not (eq code :ok)) (mv code fn2-core)
    (fn2-ctu-fill (cdr bytes) slot gen (+ 1 at) fn2-core)))))
(defun fn2-ctu-loop (left turn a b fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)
  :hints (("Goal" :use (fn2-ctu-countdown fn2-ctu-count-op) :in-theory nil))))
 (if (zp left) fn2-core
  (b* ((pa (fn2-machine-phase a fn2-core))
       ((when (>= pa *fn2-commit-state-dependencies*)) fn2-core)
       ((mv & & & & fn2-core) (fn2-commit-run (if (equal (mod (nfix turn) 2) 0) a b) 4 fn2-core)))
   (fn2-ctu-loop (- left 1) (+ 1 (nfix turn)) a b fn2-core))))
; Records frame payload -> (list (header body) ...) for N records of body length L.
(defun fn2-ctu-records (left l bytes)
 (declare (xargs :verify-guards nil :measure (nfix left)
  :hints (("Goal" :use (fn2-ctu-countdown fn2-ctu-count-op) :in-theory nil))))
 (if (zp left) nil
  (mv-let (code header rest) (fn2-layout-parse *fn2-format-record-header* bytes)
   (if (not (eq code :ok)) (list :bad code)
    (cons (list header (take l rest)) (fn2-ctu-records (- left 1) l (nthcdr l rest)))))))
; BAD: plant a malformed workspace (its length one octet short).
(defun fn2-ctu-execute (bad fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (fn2-b-test-profile *fn2-profile-tiny* 0))
      (fn2-core (fn2-core-init profile fn2-core))
      ((mv & fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      (a (fn2-machine-global-id *fn2-commit-kind* 0 profile))
      (b (fn2-machine-global-id *fn2-commit-kind* 1 profile))
      ((mv rc slot gen fn2-core) (fn2-core-reserve (fn2-scribe-window-class fn2-core) 9 3 5 fn2-core))
      (ws (append *fn2-ctu-record* *fn2-ctu-record*))
      ((mv fc fn2-core) (fn2-ctu-fill ws slot gen 0 fn2-core))
      (len (if bad (- (len ws) 1) (len ws)))
      ((mv c1 b1 e1 fn2-core) (fn2-commit-admit-txn slot gen len 9 3 5 fn2-core))
      ((when bad)
       (mv (list rc fc c1 (fn2-machine-phase a fn2-core) (fn2-machine-phase b fn2-core)
                 (fn2-stop-reason-code->keyword (fn2-core-stop-reason fn2-core))) fn2-core))
      ((mv c2 b2 e2 fn2-core) (fn2-commit-admit-txn slot gen len 9 3 5 fn2-core))
      (fn2-core (fn2-ctu-loop 600 0 a b fn2-core))
      ((mv ic image) (fn2-b-pool-image a 1 fn2-core))
      ((mv pc payload) (fn2-b-frame-payload image *frame-kind-records*))
      (records (fn2-ctu-records 4 (len *fn2-ctu-body*) payload))
      (want (list (list (list *record-kind-article-acceptance* 1 e1 0 e1 0 0 1 0 0 0) *fn2-ctu-body*)
                  (list (list *record-kind-article-acceptance* 1 e1 0 e1 0 0 1 0 0 0) *fn2-ctu-body*)
                  (list (list *record-kind-article-acceptance* 1 e2 0 e2 0 0 1 0 0 0) *fn2-ctu-body*)
                  (list (list *record-kind-article-acceptance* 1 e2 0 e2 0 0 1 0 0 0) *fn2-ctu-body*))))
  (mv (list rc fc c1 c2 (equal b1 b2) (equal e2 (+ 1 e1)) (fn2-machine-member-count a fn2-core)
            (fn2-machine-phase a fn2-core) ic pc (equal records want)
            (fn2-stop-reason-code->keyword (fn2-core-stop-reason fn2-core)))
      fn2-core)))
(defun fn2-ctu-case (bad)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (result fn2-core) (fn2-ctu-execute bad fn2-core) result)))
(make-event `(defconst *fn2-ctu-results* ',(list (fn2-ctu-case nil) (fn2-ctu-case t))))
; Two members, one batch, consecutive events; four records verbatim.
(assert-event (equal (car *fn2-ctu-results*)
 (list :ok :ok :ok :ok t t 2 *fn2-commit-state-dependencies* :ok :ok t :none)))
; Teeth: a workspace one octet short is refused whole; no batch opens.
(assert-event (equal (cadr *fn2-ctu-results*)
 (list :ok :ok :admission *fn2-commit-state-free* *fn2-commit-state-free* :none)))

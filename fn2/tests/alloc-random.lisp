(in-package "ACL2")
(include-book "alloc-unit")
(include-book "../sim/prng")
(defund fn2-alloc-random-steps (left s0 s1 s2 s3 rows seen cut counts fn2-extents)
  (declare (xargs :stobjs fn2-extents :verify-guards nil :measure (nfix left)))
  (if (zp left) (mv t counts fn2-extents)
    (mv-let (word s0 s1 s2 s3) (fn2-prng-next s0 s1 s2 s3)
      (let* ((i (mod word (max 1 (min 64 (fn2-alloc-next-counter fn2-extents)))))
             (choice (mod (floor word 64) 12))
             (op (if (< choice 10)
                       (nth choice '(:reserve :commit :retire :release :cancel :edge-add :edge-drop :checkpoint-advance :begin-epoch :relocate))
                     (nth (fn2-extents-state i fn2-extents) '(:reserve :commit :retire :release))))
             (kind (if (eq op :checkpoint-advance) (+ 1 (mod (floor word 576) 32))
                     (nth (mod (floor word 576) 10) *fn2-alloc-edges*)))
             (arg (cond ((eq op :begin-epoch) (+ 1 (fn2-alloc-current-epoch fn2-extents)))
                        ((eq op :checkpoint-advance) (+ (fn2-alloc-cut fn2-extents) (mod word 4)))
                        (t (mod (floor word 5760) 8)))))
        (mv-let (code event fn2-extents) (fn2-alloc-test-op op i kind arg fn2-extents)
          (let* ((key (if (member-eq code '(:ok :more)) (list :success op code) code))
                 (counts (fn2-rc-put key (+ 1 (nfix (fn2-rc-find key counts))) counts)))
            (mv-let (error rows seen cut)
              (if event (fn2-rc-step event rows seen cut) (mv nil rows seen cut))
              (if (or error (not (fn2-alloc-invp fn2-extents)))
                  (mv (list :random-failure left op i kind arg code event error) counts fn2-extents)
                (fn2-alloc-random-steps (- left 1) s0 s1 s2 s3 rows seen cut counts fn2-extents)))))))))
(defund fn2-alloc-random-sequences (n counts fn2-extents)
  (declare (xargs :stobjs fn2-extents :verify-guards nil :measure (nfix n)))
  (if (zp n) (mv t counts fn2-extents)
    (let ((fn2-extents (fn2-alloc-init 64 fn2-extents)))
      (mv-let (code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents)
        (declare (ignore code))
        (mv-let (s0 s1 s2 s3) (fn2-prng-seed n)
          (mv-let (ok counts fn2-extents) (fn2-alloc-random-steps 200 s0 s1 s2 s3 nil nil 0 counts fn2-extents)
            (if (eq ok t) (fn2-alloc-random-sequences (- n 1) counts fn2-extents)
              (mv (list :seed n ok) counts fn2-extents))))))))
; No checker snapshots inside allocation measurement. Actual reserve/cancel
; transitions, with every return checked; 50000 pairs = 100000 transitions.
(defund fn2-alloc-burn (n fn2-extents)
  (declare (xargs :stobjs fn2-extents :verify-guards nil :measure (nfix n)))
  (if (zp n) (mv t fn2-extents)
    (mv-let (code reason i epoch counter fn2-extents) (fn2-alloc-reserve fn2-extents)
      (declare (ignore reason))
      (if (not (eq code :ok)) (mv nil fn2-extents)
        (mv-let (code fn2-extents) (fn2-alloc-cancel-reservation i epoch counter fn2-extents)
          (if (not (eq code :ok)) (mv nil fn2-extents)
            (fn2-alloc-burn (- n 1) fn2-extents)))))))
(defund fn2-alloc-scale-retire (n fn2-extents)
  (declare (xargs :stobjs fn2-extents :verify-guards nil :measure (nfix n)))
  (if (zp n) (mv t fn2-extents)
    (b* (((mv code & i e c fn2-extents) (fn2-alloc-reserve fn2-extents))
         ((unless (eq code :ok)) (mv nil fn2-extents))
         ((mv code fn2-extents) (fn2-alloc-commit-allocation i e c 1 1 fn2-extents))
         ((unless (eq code :ok)) (mv nil fn2-extents))
         ((mv code fn2-extents) (fn2-alloc-retire i e c 1 fn2-extents))
         ((unless (eq code :ok)) (mv nil fn2-extents)))
      (fn2-alloc-scale-retire (- n 1) fn2-extents))))
(defund fn2-alloc-scale-publish (left calls interleaved fn2-extents)
  (declare (xargs :stobjs fn2-extents :verify-guards nil :measure (nfix left)))
  (if (zp left) (mv nil fn2-extents)
    (b* (((mv code fn2-extents) (fn2-alloc-checkpoint-advance 1 32 fn2-extents))
         ((when (eq code :ok))
          (let ((ok (and (= (+ calls 1) 15625) (= interleaved 1000) (= (fn2-alloc-cut fn2-extents) 1)
                   (= (fn2-alloc-ready fn2-extents) 500000) (= (fn2-alloc-blocked fn2-extents) 0)
                   (= (fn2-alloc-total-free fn2-extents) 500000)
                   (= (fn2-alloc-pending fn2-extents) 4294967295))))
            (prog2$ (if ok (cw "ALLOC SCALE: 1000000 extents, 500000 retired; budget=32 calls=~x0 interleaved=~x1 reserve/edge operations PASS~%"
                       (+ calls 1) interleaved) nil) (mv ok fn2-extents))))
         ((unless (and (eq code :more) (= (fn2-alloc-cut fn2-extents) 0))) (mv nil fn2-extents))
         ((mv ok fn2-extents) (if (< interleaved 1000)
           (b* (((mv ok fn2-extents) (fn2-alloc-burn 1 fn2-extents))
                ((mv a fn2-extents) (fn2-alloc-edge-add 0 1 0 :borrow fn2-extents))
                ((mv b fn2-extents) (fn2-alloc-edge-drop 0 1 0 :borrow fn2-extents))
                ((mv c fn2-extents) (fn2-alloc-edge-add 1 1 1 :borrow fn2-extents))
                ((mv d fn2-extents) (fn2-alloc-edge-drop 1 1 1 :borrow fn2-extents)))
             (mv (and ok (eq a :ok) (eq b :ok) (eq c :ok) (eq d :ok)) fn2-extents)) (mv t fn2-extents)))
         ((unless ok) (mv nil fn2-extents)))
      (fn2-alloc-scale-publish (- left 1) (+ calls 1) (min 1000 (+ interleaved 5)) fn2-extents))))
(defund fn2-alloc-scale (fn2-extents)
  (declare (xargs :stobjs fn2-extents :verify-guards nil))
  (b* ((fn2-extents (fn2-alloc-init 1000000 fn2-extents))
       ((mv & fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
       ((mv ok fn2-extents) (fn2-alloc-scale-retire 500000 fn2-extents))
       ((unless ok) (mv nil fn2-extents)))
    (fn2-alloc-scale-publish 15625 0 0 fn2-extents)))
(defund fn2-alloc-random-run (fn2-extents)
  (declare (xargs :stobjs fn2-extents :verify-guards nil))
  (b* (((mv ok counts fn2-extents) (fn2-alloc-random-sequences 10000 nil fn2-extents))
       ((unless (eq ok t)) (mv ok fn2-extents))
       (- (cw "ALLOC COUNTS: ~x0~%" counts))
       (- (cw "ALLOC RANDOM: 10000 sequences, 2000000 steps; races=4 teeth=10 PASS~%"))
       (fn2-extents (fn2-alloc-init 64 fn2-extents))
       ((mv & fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
       ((mv ok fn2-extents) (fn2-alloc-burn 1000 fn2-extents))
       ((unless ok) (mv :warmup fn2-extents))
       ((mv ok fn2-extents) (time$ (fn2-alloc-burn 50000 fn2-extents)
         :msg "ALLOC HOT LOOP: transitions=100000 bytes=~sa seconds=~st~%")))
    (if ok (fn2-alloc-scale fn2-extents) (mv nil fn2-extents))))
(defund fn2-alloc-random-all ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-extents
    (mv-let (ok fn2-extents) (fn2-alloc-random-run fn2-extents) ok)))

(in-package "ACL2")
(include-book "../books/sched")
(include-book "std/util/bstar" :dir :system)

(defun fn2-sched-test-fifo-run (fn2-sched)
  (declare (xargs :stobjs fn2-sched :verify-guards nil))
  (b* ((fn2-sched (fn2-sched-init *fn2-profile-tiny* fn2-sched))
       ((mv c0 fn2-sched) (fn2-sched-make-runnable 2 0 fn2-sched))
       ((mv c1 fn2-sched) (fn2-sched-make-runnable 3 0 fn2-sched))
       ((mv c2 fn2-sched) (fn2-sched-make-runnable 4 0 fn2-sched))
       ((mv wake fn2-sched) (fn2-sched-make-runnable 3 1 fn2-sched))
       (queued (fn2-sched-queued fn2-sched))
       (p3 (fn2-sched-principal 3 fn2-sched))
       (prev3 (fn2-sched-prev 3 fn2-sched))
       (next3 (fn2-sched-next 3 fn2-sched))
       ((mv p0 m0 fn2-sched) (fn2-sched-pop-head 0 fn2-sched))
       ((mv requeue fn2-sched) (fn2-sched-make-runnable m0 0 fn2-sched))
       ((mv p1 m1 fn2-sched) (fn2-sched-pop-head 0 fn2-sched))
       ((mv p2 m2 fn2-sched) (fn2-sched-pop-head 0 fn2-sched))
       ((mv p3code m3 fn2-sched) (fn2-sched-pop-head 0 fn2-sched))
       ((mv empty none fn2-sched) (fn2-sched-pop-head 0 fn2-sched))
       (idle (not (fn2-sched-eligiblep fn2-sched)))
       (fn2-sched (fn2-sched-set-service 3 1 fn2-sched))
       (ready (fn2-sched-eligiblep fn2-sched))
       (fn2-sched (fn2-sched-set-service 3 0 fn2-sched)))
    (mv (and (equal (list c0 c1 c2 wake p0 requeue p1 p2 p3code empty)
                    '(:ok :ok :ok :already :ok :ok :ok :ok :ok :empty))
             (= queued 3) (= p3 0) (= prev3 2) (= next3 4)
             (equal (list m0 m1 m2 m3) '(2 3 4 2))
             (= none *fn2-sched-none*) idle ready
             (not (fn2-sched-eligiblep fn2-sched))
             (= (fn2-sched-headsi 0 fn2-sched) *fn2-sched-none*)
             (= (fn2-sched-tailsi 0 fn2-sched) *fn2-sched-none*)) fn2-sched)))
(defun fn2-sched-test-fifo ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-sched
    (mv-let (result fn2-sched) (fn2-sched-test-fifo-run fn2-sched) result)))
(assert-event (fn2-sched-test-fifo))

(defun fn2-sched-test-calendar-run (left fn2-sched)
  (declare (xargs :stobjs fn2-sched :verify-guards nil :measure (nfix left)))
  (if (zp left) (mv nil fn2-sched)
    (mv-let (kind slot position fn2-sched) (fn2-sched-visit fn2-sched)
      (mv-let (tail fn2-sched) (fn2-sched-test-calendar-run (- left 1) fn2-sched)
        (mv (cons (list kind slot position) tail) fn2-sched)))))
(defun fn2-sched-test-calendar (profile n)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-sched
    (mv-let (result fn2-sched)
      (let ((fn2-sched (fn2-sched-init profile fn2-sched)))
        (fn2-sched-test-calendar-run n fn2-sched)) result)))
(assert-event
 (equal (fn2-sched-test-calendar *fn2-profile-tiny* 9)
        '((0 0 0) (0 1 1) (0 2 2) (0 3 3) (1 0 4) (2 0 5) (3 0 6) (4 0 7) (0 0 0))))
(assert-event
 (let ((entries (fn2-sched-test-calendar *fn2-profile-concrete* 81)))
   (and (equal (nth 15 entries) '(0 15 15))
        (equal (nth 16 entries) '(1 0 16))
        (equal (nth 19 entries) '(4 0 19))
        (equal (nth 20 entries) '(0 16 20))
        (equal (nth 75 entries) '(0 63 75))
        (equal (nth 79 entries) '(4 0 79))
        (equal (nth 80 entries) '(0 0 0)))))

; Every concrete principal, every starting calendar position: executable
; whole-hypothesis and actual-visit conclusion, including cursor wraparound.
(defun fn2-sched-test-starvation-cursors (cursor principal fn2-sched)
  (declare (xargs :stobjs fn2-sched :verify-guards nil
                  :measure (nfix (- 80 (nfix cursor)))))
  (if (or (not (natp cursor)) (>= cursor 80)) (mv t fn2-sched)
    (b* ((fn2-sched (update-fn2-sched-cursor cursor fn2-sched))
         (hyp (fn2-sched-starvation-hyps principal fn2-sched))
         ((mv conclusion fn2-sched) (fn2-sched-visits-principal 80 principal fn2-sched)))
      (if (and hyp conclusion)
          (fn2-sched-test-starvation-cursors (+ cursor 1) principal fn2-sched)
        (mv nil fn2-sched)))))
(defun fn2-sched-test-starvation-principals (principal fn2-sched)
  (declare (xargs :stobjs fn2-sched :verify-guards nil
                  :measure (nfix (- 64 (nfix principal)))))
  (if (or (not (natp principal)) (>= principal 64)) (mv t fn2-sched)
    (b* (((mv code fn2-sched) (fn2-sched-make-runnable principal principal fn2-sched))
         ((mv result fn2-sched) (fn2-sched-test-starvation-cursors 0 principal fn2-sched)))
      (if (and (eq code :ok) result)
          (fn2-sched-test-starvation-principals (+ principal 1) fn2-sched)
        (mv nil fn2-sched)))))
(defun fn2-sched-test-starvation ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-sched
    (mv-let (result fn2-sched)
      (let ((fn2-sched (fn2-sched-init *fn2-profile-concrete* fn2-sched)))
        (fn2-sched-test-starvation-principals 0 fn2-sched)) result)))
(assert-event (fn2-sched-test-starvation))

(defun fn2-sched-test-starvation-negative-run (fn2-sched)
  (declare (xargs :stobjs fn2-sched :verify-guards nil))
  (b* ((fn2-sched (fn2-sched-init *fn2-profile-tiny* fn2-sched))
       ((mv code fn2-sched) (fn2-sched-make-runnable 0 0 fn2-sched))
       (fn2-sched (update-fn2-sched-calendari 0 1 fn2-sched))
       (hyp (fn2-sched-starvation-hyps 0 fn2-sched))
       ((mv conclusion fn2-sched) (fn2-sched-visits-principal 8 0 fn2-sched)))
    (mv (and (eq code :ok) (not hyp) (not conclusion)) fn2-sched)))
(defun fn2-sched-test-starvation-negative ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-sched
    (mv-let (result fn2-sched) (fn2-sched-test-starvation-negative-run fn2-sched) result)))
(assert-event (fn2-sched-test-starvation-negative))

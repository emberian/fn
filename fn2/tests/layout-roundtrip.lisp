; Run the corresponding .lsp from the worktree root, detached with a timeout and PID file.
(in-package "ACL2")
(include-book "layout-unit")
(include-book "../sim/prng")
(in-theory (disable fn2-fields-rows fn2-layout-test-read fn2-layout-test-values fn2-layout-test-put
                    fn2-layout-test-init fn2-layout-test-snapshot fn2-layout-test-row))

(defund fn2-layout-test-random (layout s0 s1 s2 s3)
  (declare (xargs :verify-guards nil))
  (if (atom layout) nil
    (mv-let (word s0 s1 s2 s3) (fn2-prng-next s0 s1 s2 s3)
      (let* ((k (cadar layout)) (bytes (make-list (mod word 18) :initial-element (mod s0 256)))
             (v (cond ((eq k :u8) (mod word 256)) ((eq k :u16) (mod word 65536))
                      ((eq k :u32) word)
                      ((eq k :bool) (mod word 2)) ((and (consp k) (eq (car k) :enum)) (mod word (len (caddr k))))
                      ((and (consp k) (eq (car k) :zero)) nil) ((and (consp k) (eq (car k) :octets)) bytes)
                      ((eq k :digest) (cons 1 (make-list 32 :initial-element (mod word 256))))
                      (t (+ word (* (mod s0 268435456) 4294967296))))))
        (cons v (fn2-layout-test-random (cdr layout) s0 s1 s2 s3))))))
(defund fn2-layout-test-step (fuel budget layout end fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil :measure (nfix fuel)))
  (if (zp fuel) (mv :fuel 0 fn2-fields)
    (mv-let (code next fn2-fields)
      (fn2-layout-test-codec-decode-step layout 0 0 1 0 end 1 0 1 budget fn2-fields fn2-pool)
      (if (eq code :more)
          (fn2-layout-test-step (- fuel 1) budget layout end fn2-fields fn2-pool)
        (mv code next fn2-fields)))))
(defund fn2-layout-test-budgets (budgets layout values end fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (if (atom budgets) (mv t fn2-fields)
    (b* ((fn2-fields (fn2-layout-test-codec-start layout 0 fn2-fields))
         ((mv code next fn2-fields)
          (fn2-layout-test-step (+ 2 end) (car budgets) layout end fn2-fields fn2-pool))
         ((unless (and (eq code :ok) (equal next end)
                  (equal values (fn2-layout-test-values layout 0 fn2-fields fn2-pool))))
          (mv (list :budget (car budgets) code next end) fn2-fields)))
      (fn2-layout-test-budgets (cdr budgets) layout values end fn2-fields fn2-pool))))
(defund fn2-layout-test-truncate (n layout fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil :measure (nfix n)))
  (if (zp n) (mv t fn2-fields)
    (mv-let (code next fn2-fields) (fn2-layout-test-codec-decode layout 0 0 1 0 (- n 1) 1 0 1 fn2-fields fn2-pool)
      (declare (ignore next))
      (if (eq code :truncated) (fn2-layout-test-truncate (- n 1) layout fn2-fields fn2-pool)
        (mv (list :truncation (- n 1) code) fn2-fields)))))
(defund fn2-layout-test-count (code counts)
  (declare (xargs :verify-guards nil))
  (let ((entry (assoc-eq code counts)))
    (if (and (consp entry) (natp (cdr entry)))
        (put-assoc-eq code (+ 1 (cdr entry)) counts)
      (prog2$ (er hard 'fn2-layout-test-count "Missing or malformed status counter: ~x0." code)
              counts))))
(defthm fn2-layout-test-natural-count-decreases
  (and (o-p (nfix n))
       (implies (not (zp n)) (o< (nfix (- n 1)) (nfix n))))
  :rule-classes nil)
(defund fn2-layout-test-mutate (left pos end layout values original counts fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil :measure (nfix left)
                  :hints (("Goal" :in-theory nil
                           :use ((:instance fn2-layout-test-natural-count-decreases (n left)))))))
  (if (zp left) (mv t counts fn2-fields fn2-pool)
    (b* ((byte (mod left 256))
         ((when (equal byte (nth pos original)))
          (fn2-layout-test-mutate (- left 1) pos end layout values original counts fn2-fields fn2-pool))
         ((mv wc fn2-pool) (fn2-pool-write 0 1 pos byte 1 0 1 fn2-pool))
         ((unless (eq wc :ok)) (mv (list :mutation-write wc) counts fn2-fields fn2-pool))
         ((mv model-code model-values rest)
          (fn2-layout-parse layout (update-nth pos byte original)))
         ((mv code next fn2-fields) (fn2-layout-test-codec-decode layout 0 0 1 0 end 1 0 1 fn2-fields fn2-pool))
         ((unless (and (eq code model-code)
                          (or (not (eq code :ok))
                              (and (equal model-values (fn2-layout-test-values layout 0 fn2-fields fn2-pool))
                                   (equal next (- end (len rest)))))))
          (mv (list :mutation-model pos byte code model-code) counts fn2-fields fn2-pool))
         ((unless (and (eq wc :ok)
             (if (eq code :ok) (not (equal values (fn2-layout-test-values layout 0 fn2-fields fn2-pool)))
               (member-eq code '(:truncated :wide :noncanonical :unknown-tag :length :nonzero-padding)))))
          (mv (list :mutation pos byte code) counts fn2-fields fn2-pool)))
      (fn2-layout-test-mutate (- left 1) pos end layout values original
        (fn2-layout-test-count code counts) fn2-fields fn2-pool))))
(defund fn2-layout-test-positions (n end layout values bytes counts fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil :measure (nfix n)))
  (if (zp n) (mv t counts fn2-fields fn2-pool)
    (b* (((mv ok counts fn2-fields fn2-pool)
          (fn2-layout-test-mutate 256 (- n 1) end layout values bytes counts fn2-fields fn2-pool))
         ((unless (eq ok t)) (mv ok counts fn2-fields fn2-pool))
         ((mv code fn2-pool) (fn2-pool-write 0 1 (- n 1) (nth (- n 1) bytes) 1 0 1 fn2-pool))
         ((unless (eq code :ok))
          (mv (list :mutation-restore code) counts fn2-fields fn2-pool)))
      (fn2-layout-test-positions (- n 1) end layout values bytes counts fn2-fields fn2-pool))))
(defund fn2-layout-test-case (n counts fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (b* ((layout (if (evenp n) *fn2-layout-test-header* *fn2-layout-test-anchor*))
         ((mv s0 s1 s2 s3) (fn2-prng-seed (+ 20261028 n)))
         (values (fn2-layout-test-random layout s0 s1 s2 s3))
         ; Include the largest resident u64 value in the assignment campaign.
         (values (if (= n 1) (update-nth *fn2-layout-test-anchor-field-address* 1152921504606846975 values) values))
         ((mv model-code model-values rest) (fn2-layout-parse layout (fn2-layout-octets layout values)))
         ((unless (and (eq model-code :ok) (equal model-values values) (null rest)))
          (mv (list :model n model-code) counts fn2-fields fn2-pool))
         ((mv fn2-fields fn2-pool) (fn2-layout-test-put layout values 0 0 fn2-fields fn2-pool))
         ((mv code end fn2-pool) (fn2-layout-test-codec-encode layout 0 0 1 0 1 0 1 fn2-fields fn2-pool))
         (bytes (fn2-layout-test-read end 0 0 fn2-pool))
         ((unless (and (eq code :ok) (equal bytes (fn2-layout-octets layout values))))
          (mv (list :encode n code) counts fn2-fields fn2-pool))
         ((mv code next fn2-fields) (fn2-layout-test-codec-decode layout 0 0 1 0 end 1 0 1 fn2-fields fn2-pool))
         ((unless (and (eq code :ok) (equal end next)
                  (equal values (fn2-layout-test-values layout 0 fn2-fields fn2-pool))))
          (mv (list :decode n code next end) counts fn2-fields fn2-pool))
         ((mv ok fn2-fields) (fn2-layout-test-budgets '(1 7 4096) layout values end fn2-fields fn2-pool))
         ((unless (eq ok t)) (mv ok counts fn2-fields fn2-pool))
         ((mv ok fn2-fields) (fn2-layout-test-truncate end layout fn2-fields fn2-pool))
         ((unless (eq ok t)) (mv ok counts fn2-fields fn2-pool))
         ((mv ok counts fn2-fields fn2-pool)
          (if (<= n 200) (fn2-layout-test-positions end end layout values bytes counts fn2-fields fn2-pool)
            (mv t counts fn2-fields fn2-pool)))
         ((unless (eq ok t)) (mv ok counts fn2-fields fn2-pool)))
    (mv t counts fn2-fields fn2-pool)))

(defund fn2-layout-test-cases (n counts fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil :measure (nfix n)))
  (if (zp n) (mv t counts fn2-fields fn2-pool)
    (mv-let (ok counts fn2-fields fn2-pool) (fn2-layout-test-case n counts fn2-fields fn2-pool)
      (if (eq ok t) (fn2-layout-test-cases (- n 1) counts fn2-fields fn2-pool)
        (mv ok counts fn2-fields fn2-pool)))))


; A generated encoder copies the field once. The decoder resumes inside it.
(defund fn2-layout-test-large (budgets fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (if (atom budgets) (mv t fn2-fields fn2-pool)
    (b* ((layout *fn2-layout-test-large*)
         (values (list (make-list 5000 :initial-element 165)))
         (bytes (fn2-layout-octets layout values))
         ((mv fn2-fields fn2-pool) (fn2-layout-test-put layout values 0 0 fn2-fields fn2-pool))
         ((mv ec end fn2-pool)
          (fn2-layout-test-large-encode 0 0 1 0 1 0 1 fn2-fields fn2-pool))
         ((unless (and (eq ec :ok) (equal end (len bytes))
                       (equal bytes (fn2-layout-test-read end 0 0 fn2-pool))))
          (mv (list :large-encode ec end) fn2-fields fn2-pool))
         ((mv dc next fn2-fields)
          (fn2-layout-test-large-decode 0 0 1 0 end 1 0 1 fn2-fields fn2-pool))
         ((unless (and (eq dc :more) (equal next 4096)))
          (mv (list :large-one-shot dc next) fn2-fields fn2-pool))
         ((mv ok fn2-fields)
          (fn2-layout-test-budgets (list (car budgets)) layout values end fn2-fields fn2-pool))
         ((unless (eq ok t)) (mv ok fn2-fields fn2-pool)))
      (fn2-layout-test-large (cdr budgets) fn2-fields fn2-pool))))
(defund fn2-layout-test-wide (budgets fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (if (atom budgets) (mv t fn2-fields fn2-pool)
    (b* ((layout *fn2-layout-test-varint*)
         (bytes (append (make-list 5000 :initial-element 128) '(1)))
         (fn2-pool (fn2-layout-test-write bytes 0 0 fn2-pool))
         (fn2-fields (fn2-layout-test-codec-start layout 0 fn2-fields))
         ((mv code next fn2-fields)
          (fn2-layout-test-step 5003 (car budgets) '((v :varint)) 5001 fn2-fields fn2-pool))
         (- next)
         ((unless (and (eq code :wide) (equal bytes (fn2-layout-test-read 5001 0 0 fn2-pool))))
          (mv (list :long-wide (car budgets) code) fn2-fields fn2-pool)))
      (fn2-layout-test-wide (cdr budgets) fn2-fields fn2-pool))))

(deflayout fn2-layout-test-audit
  (append *fn2-layout-test-anchor* '((byte :u8) (payload (:octets 17)))))
(defund fn2-layout-audit-loop (n fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :measure (nfix n)
                  :guard (and (natp n) (fn2-fields-wfp fn2-fields)
                              (<= *fn2-layout-test-audit-num-fields* (fn2-fields-rows fn2-fields))
                              (fn2-pool-wfp fn2-pool))))
  (if (zp n) (mv t fn2-fields fn2-pool)
    (b* ((slot (mod n 2))
         ((mv code end fn2-pool)
          (fn2-layout-test-audit-encode 0 slot 1 0 1 0 1 fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv nil fn2-fields fn2-pool))
         ((mv code next fn2-fields)
          (fn2-layout-test-audit-decode 0 slot 1 0 end 1 0 1 fn2-fields fn2-pool))
         ((unless (and (eq code :ok) (equal next end))) (mv nil fn2-fields fn2-pool)))
      (fn2-layout-audit-loop (- n 1) fn2-fields fn2-pool))))
(defund fn2-layout-test-run (fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (b* (((mv fn2-fields fn2-pool) (fn2-layout-test-init fn2-fields fn2-pool))
       ((mv concurrent fn2-fields fn2-pool) (fn2-layout-test-concurrent fn2-fields fn2-pool))
       ((unless (eq concurrent t)) (mv concurrent fn2-fields fn2-pool))
       ((mv empty fn2-fields fn2-pool) (fn2-layout-test-empty-codec fn2-fields fn2-pool))
       ((unless (eq empty t)) (mv empty fn2-fields fn2-pool))
       (- (cw "LAYOUT GENERATED: disjoint decode rows; empty octets and zero-width padding; u64 accepts u60-max and refuses u60-max+1; PASS~%"))
       ((mv ok counts fn2-fields fn2-pool) (fn2-layout-test-cases 10000 '((:ok . 0) (:truncated . 0) (:wide . 0) (:noncanonical . 0) (:unknown-tag . 0) (:length . 0) (:nonzero-padding . 0)) fn2-fields fn2-pool))
       ((unless (eq ok t)) (mv ok fn2-fields fn2-pool))
       (- (cw "LAYOUT MUTATIONS: ~x0~%" counts))
       ((mv ok fn2-fields fn2-pool) (fn2-layout-test-large '(1 7 4096) fn2-fields fn2-pool))
       ((unless (eq ok t)) (mv ok fn2-fields fn2-pool))
       ((mv ok fn2-fields fn2-pool) (fn2-layout-test-wide '(1 7 4096) fn2-fields fn2-pool))
       ((unless (eq ok t)) (mv ok fn2-fields fn2-pool))
       (values (update-nth *fn2-layout-test-audit-field-address* 1152921504606846975
                 (fn2-layout-test-random *fn2-layout-test-audit* 1 2 3 4)))
       ((mv fn2-fields fn2-pool)
        (fn2-layout-test-put *fn2-layout-test-audit* values 0 0 fn2-fields fn2-pool))
       ((mv ok fn2-fields fn2-pool) (fn2-layout-audit-loop 100 fn2-fields fn2-pool))
       ((unless ok) (mv :warmup fn2-fields fn2-pool))
       ((mv ok fn2-fields fn2-pool)
        (time$ (fn2-layout-audit-loop 100000 fn2-fields fn2-pool)
          :mintime 0 :msg "LAYOUT HOT LOOP: 100000 cycles, ~sa bytes, ~st seconds~%"))
       (- (and ok (cw "LAYOUT ROUNDTRIP: 10000 assignments; 200 exhaustive single-byte mutation samples; all truncations; budgets 1,7,4096; PASS~%"))))
    (mv ok fn2-fields fn2-pool)))
(defund fn2-layout-test-all ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-fields
    (mv-let (ok fn2-fields)
      (with-local-stobj fn2-pool
        (mv-let (ok fn2-fields fn2-pool) (fn2-layout-test-run fn2-fields fn2-pool)
          (mv ok fn2-fields)))
      ok)))
(assert-event (eq (symbol-class 'fn2-layout-audit-loop (w state)) :common-lisp-compliant))

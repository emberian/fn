; Raw differential and matched-session measurements. Lists are fixtures only.
(in-package "ACL2")
(defun fn2-bh1-boundary-differential ()
 (let* ((pool (fn2-pool-init '((1 . 66560)) 1 100 (create-fn2-pool)))
        (bytes (svref pool *fn2-pool-datai*))
        (dg (fn2-digests-init 144 (create-fn2-digests)))
        (rng (sb-ext:seed-random-state 20261028)) (seed 37))
  (dotimes (trial 10000)
   (let* ((n (* 1024 (ash 1 (random 7 rng)))) (off (random 1024 rng))
          (counter (random (- (expt 2 54) (floor n 1024)) rng)))
    (dotimes (i n)
     (setf seed (logand #xffffffff (+ (* seed 1664525) 1013904223))
           (aref bytes (+ off i)) (ldb (byte 8 24) seed)))
    (funcall (fn2-b3-native-reference 'fn2-b3-subtree-cv-into) 136 off n counter dg pool)
    (fn2-b3-subtree-cv-into 137 off n counter dg pool)
    (assert (fn2-digest-equal 136 137 dg) () "boundary case ~D counter ~D length ~D offset ~D" trial counter n off)))
  (format t "BH1 BOUNDARY: 10000/10000 random counter/length/offset/contents equal~%")))
(defun fn2-bh1-refusals ()
 (assert (handler-case (progn (fn2-b3-native-startup "build/lib/BH1-missing-library") nil)
           (fn2-b3-native-refused () t)))
 (assert (eq *fn2-b3-native-state* :reference))
 (dolist (name '(fn2-b3-native-subtree fn2-b3-native-zero-prefix fn2-b3-native-fragment))
  (let ((original (symbol-function name)))
   (unwind-protect
    (progn
     (setf (symbol-function name)
      (case name
       (fn2-b3-native-subtree
        (lambda (dst off n counter dg pool)
         (funcall original dst off n counter dg pool)
         (fn2-digests-set-w0 dst (logxor 1 (fn2-digests-w0 dst dg)) dg)))
       (fn2-b3-native-zero-prefix
        (lambda (off n pool) (+ 1 (funcall original off n pool))))
       (otherwise
        (lambda (row off n dg b3 pool)
         (funcall original row off n dg b3 pool)
         (fn2-b3-set-pos row (logxor 1 (fn2-b3-pos row b3)) b3)
         (values dg b3)))))
     (assert (handler-case (progn (fn2-b3-native-startup) nil) (fn2-b3-native-refused () t)))
     (assert (eq *fn2-b3-native-state* :reference))
     (dolist (pair *fn2-b3-native-references*)
      (assert (eq (symbol-function (car pair)) (cdr pair)))))
    (setf (symbol-function name) original))))
 (fn2-b3-native-startup)
 (format t "BH1 STARTUP: missing library and corrupt subtree/zero-prefix/fragment refused; references retained; reattach PASS~%"))
(defun fn2-bh1-meter (mode name size reps thunk)
 (dotimes (i 8) (funcall thunk))
 (sb-ext:gc :full t)
 (let* ((before (sb-ext:get-bytes-consed)) (start (get-internal-real-time))
        (cpu (get-internal-run-time)))
  (dotimes (i reps) (funcall thunk))
  (let ((allocation (- (sb-ext:get-bytes-consed) before))
        (elapsed (/ (- (get-internal-real-time) start) (float internal-time-units-per-second 1d0)))
        (cpu-time (/ (- (get-internal-run-time) cpu) (float internal-time-units-per-second 1d0))))
   (format t "BH1 MEASURE ~A ~A: ~,3F MiB/s; ~,3F us/op; ~,3F bytes/op; ~D ops; ~,6F wall s; ~,6F CPU s~%"
    mode name (/ (* size reps) 1048576d0 (max elapsed 1d-9))
    (/ (* elapsed 1000000d0) reps) (/ allocation (float reps 1d0)) reps elapsed cpu-time)
   (assert (zerop allocation)))))
(defun fn2-bh1-cpu ()
 (or (sb-ext:posix-getenv "FN2_BH1_CPU")
  (handler-case
   (with-open-stream (stream (sb-ext:process-output
      (sb-ext:run-program "/usr/sbin/system_profiler" '("SPHardwareDataType") :output :stream)))
    (loop for line = (read-line stream nil) while line
     for at = (search "Chip:" line)
     when at return (string-trim " " (subseq line (+ at 5)))))
   (error () nil))
  (machine-version)))
(defun fn2-bh1-measure ()
 (let* ((*fn2-b3-test-dg* (fn2-digests-init 160 (create-fn2-digests)))
        (*fn2-fc-test-dg* (fn2-digests-init 144 (create-fn2-digests)))
        (b3 (fn2-b3-table-init 1 (create-fn2-b3))) (pool (fn2-b3-test-fixture))
        (fc (fn2-fc-init 1 (create-fn2-fc))) (ctx (fn2-fc-context-init 1 (create-fn2-fc-context)))
        (fb3 (fn2-b3-table-init 1 (create-fn2-b3))) (fields (fn2-fields-init 80 (create-fn2-fields)))
        (fp (fn2-pool-init '((1 . 65536)) 1 100 (create-fn2-pool)))
        (bytes (append *fn2-fc-test-page* (make-list (- 65536 128) :initial-element 0)))
        (context (append '(17 9 1 2 3 4 0 65536) (make-list 8 :initial-element 0)
                          (make-list 8 :initial-element 0) '(8 6) (make-list 8 :initial-element 0) '(7))))
  (fn2-pool-reserve 0 1 0 1 fp)
  (fn2-fc-t-load bytes context 0 0 ctx fp)
  (fn2-b3-test-init 0 '(0 0 0 0 0 0 0 0) b3)
  (fn2-b3-test-feed 0 196608 b3 pool)
  (fn2-b3-finalize 136 0 *fn2-b3-test-dg* b3)
  (dotimes (block 3)
   (fn2-b3-init 0 0 137 *fn2-b3-test-dg* b3)
   (fn2-b3-start-subtree 0 (* 64 block) b3)
   (fn2-b3-test-feed (* 65536 block) 65536 b3 pool)
   (fn2-b3-subtree-cv (+ 138 block) 0 *fn2-b3-test-dg* b3))
  (format t "BH1 PROFILE: B continuation quantum=4096 bytes; payload block=65536; B3 rows=1; digest rows=160/144; checker rows=1; fields=80; pool=300000/65536 bytes; range source=196608 bytes/3 CV rows~%")
  (format t "BH1 MACHINE: uname-m=~A CPU=~A Lisp=~A ~A~%" (string-downcase (machine-type)) (fn2-bh1-cpu) (lisp-implementation-type) (lisp-implementation-version))
  (dolist (mode '(:acl2 :native))
   (if (eq mode :acl2) (fn2-b3-native-reset) (fn2-b3-native-startup))
   (fn2-fc-t-load bytes context 0 0 ctx fp)
   (fn2-bh1-meter mode :incremental 65536 256 (lambda () (fn2-b3-test-hot 1 65536 b3 pool)))
   (fn2-bh1-meter mode :page-seal 65536 256
    (lambda ()
     (fn2-fc-reset 0 fc)
     (loop for code = (fn2-format-seal-page 0 0 1 0 65536 0 1 0 1 4096 fc ctx fb3 fields fp *fn2-fc-test-dg*)
      unless (eq code :more) do (assert (eq code :ok)) (return))))
   (fn2-bh1-meter mode :seal+check 65536 256
    (lambda ()
     (assert (eq :ok (fn2-fc-t-run :page t 0 0 65536 0 4096 fc ctx fb3 fields fp)))
     (assert (eq :ok (fn2-fc-t-run :page nil 0 0 65536 0 4096 fc ctx fb3 fields fp)))))
   (fn2-bh1-meter mode :range-64k-of192k 65536 256
    (lambda ()
     (fn2-b3-init 0 0 137 *fn2-b3-test-dg* b3)
     (fn2-b3-start-subtree 0 64 b3)
     (fn2-b3-test-feed 65536 65536 b3 pool)
     (loop for code = (fn2-b3-verify-range 0 138 196608 1 65536 136 *fn2-b3-test-dg* b3)
      unless (eq code :more) do (assert (eq code :ok)) (return))))
   (fn2-bh1-meter mode :merkle-node 65 10000
    (lambda () (fn2-mk-node 141 136 137 *fn2-b3-test-dg*)))
   (fn2-bh1-meter mode :subtree-quantum 4096 1024
    (lambda () (fn2-b3-subtree-cv-into 137 0 4096 0 *fn2-b3-test-dg* pool)))
   (fn2-fc-t-load *fn2-fc-test-frame* *fn2-fc-test-context* 0 0 ctx fp)
   (fn2-bh1-meter mode :frame-seal+check 4096 1024
    (lambda () (assert (fn2-fc-t-hot 1 fc ctx fb3 fields fp)))))))
(defun fn2-bh1-zero-differential ()
 (let* ((pool (fn2-pool-init '((1 . 8192)) 1 100 (create-fn2-pool)))
        (bytes (svref pool *fn2-pool-datai*)) (rng (sb-ext:seed-random-state 29061028)))
  (dotimes (trial 10000)
   (let* ((n (random 4097 rng)) (off (random 4096 rng)) (bad (random (+ n 1) rng)))
    (fill bytes 173) (fill bytes 0 :start off :end (+ off n))
    (when (< bad n) (setf (aref bytes (+ off bad)) (+ 1 (random 255 rng))))
    (let ((saved (copy-seq bytes)))
     (assert (= bad (funcall (fn2-b3-native-reference 'fn2-fc-zero-prefix) off n pool)
                   (fn2-fc-zero-prefix off n pool)))
     (assert (equalp bytes saved)))))
  (format t "BH1 ZERO PREFIX: 10000/10000 random offset/length/first-bad cases equal; pool unchanged~%")))
(defun fn2-bh1-fragment-differential ()
 (let* ((pool (fn2-pool-init '((1 . 2048)) 1 100 (create-fn2-pool)))
        (bytes (svref pool *fn2-pool-datai*)) (rng (sb-ext:seed-random-state 29061029))
        (dg (fn2-digests-init 144 (create-fn2-digests))) (b3 (fn2-b3-table-init 1 (create-fn2-b3)))
        (output (symbol-function 'fn2-b3-output))
        (fragment (symbol-function 'fn2-b3-fragment-into)))
  ; The saved fragment calls fn2-b3-byte; keep its entire oracle path ACL2.
  (unwind-protect
   (progn
    (setf (symbol-function 'fn2-b3-output) (fn2-b3-native-reference 'fn2-b3-output)
          (symbol-function 'fn2-b3-fragment-into) (fn2-b3-native-reference 'fn2-b3-fragment-into))
    (dotimes (trial 10000)
     (let* ((used (random 1025 rng)) (n (random (+ 1 (- 1024 used)) rng))
            (off (random 1024 rng)) (counter (random (expt 2 54) rng)))
      (dotimes (i 2048) (setf (aref bytes i) (random 256 rng)))
      (fn2-b3-init 0 0 136 dg b3) (fn2-b3-set-counter 0 counter b3)
      (dotimes (i 16) (fn2-b3-store 0 i (random (expt 2 32) rng) b3))
      (dotimes (i used) (fn2-b3-byte 0 (aref bytes i) dg b3))
      (let ((dc (map 'vector (lambda (a) (if (vectorp a) (copy-seq a) a)) dg))
            (bc (map 'vector (lambda (a) (if (vectorp a) (copy-seq a) a)) b3)))
       (funcall (fn2-b3-native-reference 'fn2-b3-fragment-into) 0 off n dg b3 pool)
       (fn2-b3-native-fragment 0 off n dc bc pool)
       (assert (and (equalp dg dc) (equalp b3 bc)) ()
               "fragment case ~D used ~D length ~D counter ~D" trial used n counter)))))
   (setf (symbol-function 'fn2-b3-output) output
         (symbol-function 'fn2-b3-fragment-into) fragment))
  (format t "BH1 FRAGMENT: 10000/10000 random counter/offset/length/partial-state cases equal; all digest and hasher columns equal~%")))
(defun fn2-bh1-prefix-case (kind bad stop budget)
 (let* ((*fn2-fc-test-dg* (fn2-digests-init 144 (create-fn2-digests)))
        (fc (fn2-fc-init 1 (create-fn2-fc))) (ctx (fn2-fc-context-init 1 (create-fn2-fc-context)))
        (b3 (fn2-b3-table-init 1 (create-fn2-b3))) (fields (fn2-fields-init 80 (create-fn2-fields)))
        (pool (fn2-pool-init '((1 . 65536)) 1 100 (create-fn2-pool)))
        (bytes (case kind (:frame *fn2-fc-test-frame*) (:anchor *fn2-fc-test-anchor*) (:seal *fn2-fc-test-seal*)
                 (t (append *fn2-fc-test-page* (make-list (- 65536 128) :initial-element 0)))))
        (len (length bytes))
        (context (case kind (:frame *fn2-fc-test-context*) (:anchor *fn2-fc-test-anchor-context*) (:seal *fn2-fc-test-context*)
                   (t (append '(17 9 1 2 3 4 0 65536)
                    (fn-b3-words 8 (fn-blake3 (fn2-fc-covered :page bytes nil)))
                    (make-list 8 :initial-element 0) '(8 6) (make-list 8 :initial-element 0) '(7))))))
  (fn2-pool-reserve 0 1 0 1 pool) (fn2-fc-t-load bytes context 0 0 ctx pool)
  (loop until (= (fn2-fc-phase 0 fc) *fn2-fc-phase-hash*) do
   (assert (eq :more (fn2-fc-step 0 kind nil 0 1 0 len 0 1 0 1 1 fc ctx b3 fields pool *fn2-fc-test-dg*))))
  (when bad
   (let ((at (case bad (:geometry (fn2-fc-geom 0 fc)) (:previous (fn2-fc-previous-seal-offset 0 fc))
                        (:digest (fn2-fc-zero 0 fc)) (otherwise bad))))
    (fn2-pool-write 0 1 at (logxor 1 (aref (svref pool *fn2-pool-datai*) at)) 1 0 1 pool)))
  (when stop (fn2-pool-set-fill 0 stop pool))
  (let ((code (loop for c = (fn2-fc-step 0 kind nil 0 1 0 len 0 1 0 1 budget fc ctx b3 fields pool *fn2-fc-test-dg*)
               unless (eq c :more) return c)))
   (fn2-b3-finalize 137 0 *fn2-fc-test-dg* b3)
   (list code (fn2-fc-pos 0 fc) (fn2-digest-list 137 *fn2-fc-test-dg*)))))
(defun fn2-bh1-prefix-check ()
 (let ((span (symbol-function 'fn2-fc-page-span)) (count 0))
  (dolist (case '((:page 128 nil) (:page 4095 nil) (:page 4096 nil) (:page 65535 nil)
                 (:page 2048 2049) (:page nil 2049) (:page nil nil)
                 (:frame 128 nil) (:frame 1023 nil) (:frame 1024 nil) (:frame 4062 nil)
                 (:frame 4063 nil) (:frame :digest nil) (:frame 2048 2049) (:frame nil 2049) (:frame nil nil)
                 (:anchor :geometry nil) (:anchor :digest nil) (:anchor nil nil)
                 (:seal :previous nil) (:seal :digest nil) (:seal nil nil)))
   (dolist (budget '(1 7 4096))
    (let ((bulk (fn2-bh1-prefix-case (first case) (second case) (third case) budget)))
     (unwind-protect
      (progn
       (setf (symbol-function 'fn2-fc-page-span)
        (lambda (&rest args) (values :byte 0 (nth 10 args) (nth 12 args) (nth 15 args))))
       (assert (equal bulk (fn2-bh1-prefix-case (first case) (second case) (third case) budget)))
       (incf count))
      (setf (symbol-function 'fn2-fc-page-span) span)))))
  (format t "BH1 FORMAT PREFIX: ~D bulk/byte status, position and hash agreements; frame/page/anchor/seal; budgets 1,7,4096~%" count)))
(defun fn2-bh1-all ()
 (fn2-bh1-refusals)
 (fn2-bh1-prefix-check)
 (fn2-b3-test-all)
 (fn2-bh1-boundary-differential)
 (fn2-bh1-zero-differential)
 (fn2-bh1-fragment-differential)
 (fn2-bh1-measure)
 (format t "BH1 PASS: native attachment, differential and matched measurements~%"))

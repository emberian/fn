(in-package "ACL2")
(include-book "../books/alloc")
(include-book "../sim/check-reclaim")
(include-book "std/util/bstar" :dir :system)
; Test dispatcher calls the public runtime exports; emitted events contain only
; successful effects, and the independent checker has its own count model.
(defun fn2-alloc-test-op (op i kind arg fn2-extents)
  (declare (xargs :stobjs fn2-extents :verify-guards nil))
  (let ((epoch (if (fn2-alloc-slotp i fn2-extents) (fn2-extents-epoch i fn2-extents) 0))
        (counter (if (fn2-alloc-slotp i fn2-extents) (fn2-extents-counter i fn2-extents) 0)))
    (case op
      (:reserve (mv-let (code reason j e c fn2-extents) (fn2-alloc-reserve fn2-extents)
        (declare (ignore reason)) (mv code (and (eq code :ok) (list :reserve j (list e c))) fn2-extents)))
      (:commit (mv-let (code fn2-extents) (fn2-alloc-commit-allocation i epoch counter 1 1 fn2-extents)
        (mv code (and (eq code :ok) (list :commit i)) fn2-extents)))
      (:retire (mv-let (code fn2-extents) (fn2-alloc-retire i epoch counter arg fn2-extents)
        (mv code (and (eq code :ok) (list :retire i arg)) fn2-extents)))
      (:release (mv-let (code fn2-extents) (fn2-alloc-release i epoch counter fn2-extents)
        (mv code (and (eq code :ok) (list :release i)) fn2-extents)))
      (:cancel (mv-let (code fn2-extents) (fn2-alloc-cancel-reservation i epoch counter fn2-extents)
        (mv code (and (eq code :ok) (list :cancel i)) fn2-extents)))
      (:edge-add (mv-let (code fn2-extents) (fn2-alloc-edge-add i epoch counter kind fn2-extents)
        (mv code (and (eq code :ok) (list :edge-add i kind)) fn2-extents)))
      (:edge-drop (mv-let (code fn2-extents) (fn2-alloc-edge-drop i epoch counter kind fn2-extents)
        (mv code (and (eq code :ok) (list :edge-drop i kind)) fn2-extents)))
      (:checkpoint-advance (mv-let (code fn2-extents) (fn2-alloc-checkpoint-advance arg kind fn2-extents)
        (mv code (and (eq code :ok) (list :checkpoint-installed (fn2-alloc-cut fn2-extents))) fn2-extents)))
      (:begin-epoch (mv-let (code fn2-extents) (fn2-alloc-begin-epoch arg fn2-extents)
        (mv code nil fn2-extents)))
      (:relocate (let ((j (mod (+ i 1) (max 1 (fn2-extents-rows fn2-extents)))))
        (mv-let (code fn2-extents) (fn2-alloc-relocate i epoch counter j
          (fn2-extents-epoch j fn2-extents) (fn2-extents-counter j fn2-extents) t fn2-extents)
          (mv code (and (eq code :ok) (list :relocate i j)) fn2-extents))))
      (otherwise (mv :unknown nil fn2-extents)))))
(defun fn2-alloc-test-sequence (steps events fn2-extents)
  (declare (xargs :stobjs fn2-extents :verify-guards nil))
  (if (atom steps) (mv (and (fn2-alloc-invp fn2-extents) (not (fn2-check-reclaim (reverse events)))) fn2-extents)
    (mv-let (code event fn2-extents)
      (fn2-alloc-test-op (caar steps) (cadar steps) (caddar steps) (cadddr (car steps)) fn2-extents)
      (if (or (not (equal code (nth 4 (car steps)))) (not (fn2-alloc-invp fn2-extents)))
          (mv (list :bad-step (car steps) code) fn2-extents)
        (fn2-alloc-test-sequence (cdr steps) (if event (cons event events) events) fn2-extents)))))
(defun fn2-alloc-test-run (steps)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-extents
    (mv-let (answer fn2-extents)
      (let ((fn2-extents (fn2-alloc-init 2 fn2-extents)))
        (mv-let (code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents)
          (declare (ignore code)) (fn2-alloc-test-sequence steps nil fn2-extents)))
      answer)))
; Four race witnesses name the rejected transition.
(defconst *fn2-alloc-race-obligation* '((:reserve 0 nil 0 :ok) (:commit 0 nil 0 :ok)
  (:retire 0 nil 0 :ok) (:edge-add 0 :obligation 0 :ok) (:release 0 nil 0 :obligation)))
(assert-event (equal (fn2-alloc-test-run *fn2-alloc-race-obligation*) t))
(assert-event (equal (fn2-alloc-test-run
  '((:reserve 0 nil 0 :ok) (:commit 0 nil 0 :ok)
    (:edge-add 0 :promised-read 0 :ok) (:retire 0 nil 0 :ok)
    (:release 0 nil 0 :promised-read))) t))
(defconst *fn2-alloc-race-anchor-crash* '((:reserve 0 nil 0 :ok) (:commit 0 nil 0 :ok)
  (:retire 0 nil 7 :ok) (:release 0 nil 0 :checkpoint-blocked)))
(assert-event (equal (fn2-alloc-test-run *fn2-alloc-race-anchor-crash*) t))
(assert-event (equal (fn2-alloc-test-run
  '((:reserve 0 nil 0 :ok) (:edge-add 0 :outstanding-io 0 :ok)
    (:cancel 0 nil 0 :outstanding-io))) t))
(assert-event (equal (fn2-alloc-test-run
  '((:reserve 0 nil 0 :ok) (:edge-drop 0 :borrow 0 :edge-underflow)
    (:edge-add 0 :identity 0 :edge-kind) (:edge-add 0 :reservation 0 :reservation-owned)
    (:reserve 0 nil 0 :ok) (:reserve 0 nil 0 :no-space)
    (:release 0 nil 0 :state) (:cancel 0 nil 0 :ok) (:reserve 0 nil 0 :ok)
    (:commit 0 nil 0 :ok) (:retire 0 nil 2 :ok)
    (:checkpoint-advance 0 1 2 :ok) (:release 0 nil 0 :ok)
    (:checkpoint-advance 0 1 1 :checkpoint-order))) t))
; Equal retirement commits span budgets; accounting changes, release cannot.
(assert-event (equal (fn2-alloc-test-run
  '((:reserve 0 nil 0 :ok) (:commit 0 nil 0 :ok) (:retire 0 nil 2 :ok)
    (:reserve 0 nil 0 :ok) (:commit 1 nil 0 :ok) (:retire 1 nil 1 :retirement-order)
    (:retire 1 nil 2 :ok) (:checkpoint-advance 0 0 2 :budget) (:checkpoint-advance 0 33 2 :budget)
    (:checkpoint-advance 0 1 2 :more) (:release 0 nil 0 :checkpoint-blocked)
    (:checkpoint-advance 0 1 1 :checkpoint-order)
    (:edge-add 0 :borrow 0 :ok) (:edge-drop 0 :borrow 0 :ok)
    (:edge-add 1 :recovery-candidate 0 :ok) (:checkpoint-advance 0 1 2 :ok)
    (:edge-drop 1 :recovery-candidate 0 :ok) (:release 1 nil 0 :ok) (:release 0 nil 0 :ok)
    (:reserve 0 nil 0 :ok) (:commit 0 nil 0 :ok) (:retire 0 nil 1 :retirement-order)
    (:retire 0 nil 2 :ok) (:release 0 nil 0 :ok) (:checkpoint-advance 0 32 3 :ok))) t))
(defun fn2-alloc-interleaved-retire ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-extents
    (mv-let (ok fn2-extents)
      (let ((fn2-extents (fn2-alloc-init 3 fn2-extents)))
        (fn2-alloc-test-sequence
          '((:begin-epoch 0 nil 1 :ok) (:reserve 0 nil 0 :ok) (:commit 0 nil 0 :ok)
            (:retire 0 nil 1 :ok) (:reserve 0 nil 0 :ok) (:commit 1 nil 0 :ok) (:retire 1 nil 2 :ok)
            (:checkpoint-advance 0 1 2 :more) (:reserve 0 nil 0 :ok) (:commit 2 nil 0 :ok)
            (:retire 2 nil 2 :ok) (:checkpoint-advance 0 1 2 :more)
            (:edge-add 0 :borrow 0 :ok) (:edge-add 2 :obligation 0 :ok)
            (:checkpoint-advance 0 1 2 :ok) (:release 1 nil 0 :ok)
            (:edge-drop 2 :obligation 0 :ok) (:release 2 nil 0 :ok)
            (:edge-drop 0 :borrow 0 :ok) (:release 0 nil 0 :ok)) nil fn2-extents)) ok)))
(assert-event (fn2-alloc-interleaved-retire))
; Predicate copy with one omitted conjunct, evaluated on a fully protected row.
(defun fn2-alloc-test-no-edges-except (i kinds omitted fn2-extents)
  (declare (xargs :stobjs fn2-extents :verify-guards nil))
  (if (atom kinds) t
    (and (or (eq (car kinds) omitted) (= (fn2-alloc-edge-count i (car kinds) fn2-extents) 0))
         (fn2-alloc-test-no-edges-except i (cdr kinds) omitted fn2-extents))))
(defun fn2-alloc-test-mutant (i omitted fn2-extents)
  (declare (xargs :stobjs fn2-extents :verify-guards nil))
  (and (= (fn2-extents-state i fn2-extents) 3)
       (fn2-alloc-test-no-edges-except i *fn2-alloc-edges* omitted fn2-extents)
       (or (eq omitted :checkpoint) (<= (fn2-extents-retirement i fn2-extents) (fn2-alloc-cut fn2-extents)))))
(defun fn2-alloc-test-tooth (kind)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-extents
    (mv-let (ok fn2-extents)
      (b* ((fn2-extents (fn2-alloc-init 1 fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
           ((mv & & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-commit-allocation 0 1 0 1 1 fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-retire 0 1 0 (if (eq kind :checkpoint) 1 0) fn2-extents))
           ((mv & fn2-extents) (if (eq kind :checkpoint) (mv :ok fn2-extents)
                                (fn2-alloc-edge-add 0 1 0 kind fn2-extents)))
           (events (append '((:reserve 0 (1 0)) (:commit 0))
                     (list (list :retire 0 (if (eq kind :checkpoint) 1 0)))
                     (if (eq kind :checkpoint) nil (list (list :edge-add 0 kind)))
                     '((:release 0)))))
        (mv (and (fn2-alloc-invp fn2-extents) (not (fn2-alloc-releasablep 0 fn2-extents))
                 (fn2-alloc-test-mutant 0 kind fn2-extents) (consp (fn2-check-reclaim events))) fn2-extents))
      ok)))
(assert-event (fn2-alloc-test-tooth :installed-root))
(assert-event (fn2-alloc-test-tooth :selectable-checkpoint))
(assert-event (fn2-alloc-test-tooth :recovery-base))
(assert-event (fn2-alloc-test-tooth :prepared-successor))
(assert-event (fn2-alloc-test-tooth :obligation))
(assert-event (fn2-alloc-test-tooth :promised-read))
(assert-event (fn2-alloc-test-tooth :borrow))
(assert-event (fn2-alloc-test-tooth :outstanding-io))
(assert-event (fn2-alloc-test-tooth :recovery-candidate))
(assert-event (fn2-alloc-test-tooth :checkpoint))
; Reservation protects RESERVED and is discharged by commit/cancel, so a
; reservation-only RETIRE_PENDING tooth is unreachable-in-composition.
(assert-event (equal (fn2-check-reclaim '((:reserve 0 (1 0)) (:write 0 (1 0)) (:cancel 0) (:reserve 0 (1 0))))
                     '(3 (:reserve 0 (1 0)) :repeated-id)))
(assert-event (equal (fn2-check-reclaim '((:reserve 0 (1 0)) (:cancel 0) (:reserve 0 (1 1)) (:write 0 (1 0))))
                     '(3 (:write 0 (1 0)) :stale-write)))
(defun fn2-alloc-race-relocation-and-restart ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-extents
    (mv-let (ok fn2-extents)
      (b* ((fn2-extents (fn2-alloc-init 2 fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
           ((mv & & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-commit-allocation 0 1 0 1 1 fn2-extents))
           ((mv & & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-commit-allocation 1 1 1 1 1 fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-edge-add 0 1 0 :promised-read fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-edge-add 0 1 0 :installed-root fn2-extents))
           ((mv code fn2-extents) (fn2-alloc-relocate 0 1 0 1 1 1 t fn2-extents))
           (moved (and (eq code :ok) (= (fn2-extents-installed-root 1 fn2-extents) 1)
                       (= (fn2-extents-installed-root 0 fn2-extents) 0)
                       (= (fn2-extents-promised-read 0 fn2-extents) 1)))
           ((mv & fn2-extents) (fn2-alloc-retire 0 1 0 0 fn2-extents))
           ((mv code fn2-extents) (fn2-alloc-release 0 1 0 fn2-extents))
           (lease-refused (eq code :promised-read))
           ((mv & fn2-extents) (fn2-alloc-edge-drop 0 1 0 :promised-read fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-edge-add 0 1 0 :outstanding-io fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-begin-epoch 2 fn2-extents))
           ((mv code fn2-extents) (fn2-alloc-release 0 1 0 fn2-extents)))
        (mv (and moved lease-refused (eq code :outstanding-io) (fn2-alloc-invp fn2-extents)
          (not (fn2-check-reclaim '((:reserve 0 (1 0)) (:commit 0) (:reserve 1 (1 1)) (:commit 1)
            (:edge-add 0 :installed-root) (:edge-add 0 :promised-read) (:relocate 0 1)
            (:retire 0 0) (:edge-drop 0 :promised-read) (:edge-add 0 :outstanding-io) (:crash))))) fn2-extents))
      ok)))
(assert-event (fn2-alloc-race-relocation-and-restart))
 ; Full antecedent and shared result predicate, using actual runtime calls.
(defun fn2-alloc-keystone-teeth ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-extents
    (mv-let (ok fn2-extents)
      (b* ((fn2-extents (fn2-alloc-init 2 fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
           (pre (fn2-alloc-invp fn2-extents))
           ((mv code & & e c fn2-extents) (fn2-alloc-reserve fn2-extents))
           (issue (and pre (eq code :ok) (fn2-alloc-id-progressp :reserve code e c 1 0
                    (fn2-alloc-current-epoch fn2-extents) (fn2-alloc-next-counter fn2-extents) nil)))
           ((mv & fn2-extents) (fn2-alloc-cancel-reservation 0 1 0 fn2-extents))
           (cancel (fn2-alloc-id-progressp :cancel :ok 0 0 1 1
                    (fn2-alloc-current-epoch fn2-extents) (fn2-alloc-next-counter fn2-extents) nil))
           ((mv & & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-commit-allocation 0 1 1 1 1 fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-retire 0 1 1 0 fn2-extents))
           (pre (fn2-alloc-invp fn2-extents))
           (release-p (fn2-alloc-releasablep 0 fn2-extents))
           ((mv code fn2-extents) (fn2-alloc-release 0 1 1 fn2-extents))
           (release (and pre (eq code :ok) release-p (= (fn2-extents-state 0 fn2-extents) 0)))
           ((mv & & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
           (ids (fn2-alloc-live-ids (fn2-alloc-view fn2-extents)))
           (fn2-extents (update-fn2-alloc-next-counter 2 fn2-extents))
           (invalid (not (fn2-alloc-invp fn2-extents)))
           ((mv code & & e c fn2-extents) (fn2-alloc-reserve fn2-extents)))
        (mv (and issue cancel release invalid (eq code :ok)
                 (not (fn2-alloc-id-progressp :reserve code e c 1 2
                   (fn2-alloc-current-epoch fn2-extents) (fn2-alloc-next-counter fn2-extents) ids))) fn2-extents))
      ok)))
(assert-event (fn2-alloc-keystone-teeth))
(defun fn2-alloc-refusal-teeth ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-extents
    (mv-let (ok fn2-extents)
      (b* ((fn2-extents (fn2-alloc-init 2 fn2-extents))
           ((mv a & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
           ((mv b fn2-extents) (fn2-alloc-checkpoint-advance 0 0 fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
           ((mv c fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
           ((mv & & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
           ((mv d fn2-extents) (fn2-alloc-release 9 1 0 fn2-extents))
           ((mv e fn2-extents) (fn2-alloc-release 0 1 9 fn2-extents))
           (fn2-extents (fn2-extents-set-borrow 0 4294967295 fn2-extents))
           ((mv f fn2-extents) (fn2-alloc-edge-add 0 1 0 :borrow fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-commit-allocation 0 1 0 1 1 fn2-extents))
           ((mv & & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-commit-allocation 1 1 1 2 2 fn2-extents))
           ((mv g fn2-extents) (fn2-alloc-relocate 0 1 0 1 1 1 nil fn2-extents))
           ((mv h fn2-extents) (fn2-alloc-relocate 0 1 0 1 1 1 t fn2-extents))
           (fn2-extents (update-fn2-alloc-next-counter 1152921504606846975 fn2-extents))
           ((mv k & & & & fn2-extents) (fn2-alloc-reserve fn2-extents)))
        (mv (and (eq a :epoch-not-begun) (eq b :budget) (eq c :epoch-order)
                 (eq d :bounds) (eq e :stale) (eq f :edge-overflow)
                 (eq g :replacement-not-durable) (eq h :owner)
                 (eq k :counter-exhausted) (fn2-alloc-invp fn2-extents)) fn2-extents))
      ok)))
(assert-event (fn2-alloc-refusal-teeth))

(assert-event (and
  (eq (symbol-class 'fn2-alloc-reserve (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-commit-allocation (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-edge-add (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-edge-drop (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-retire (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-release (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-cancel-reservation (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-relocate (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-pressure (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-releasablep (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-begin-epoch (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-checkpoint-advance (w state)) :common-lisp-compliant)
))
(defun fn2-alloc-pressure-teeth ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-extents
    (mv-let (ok fn2-extents)
      (b* ((fn2-extents (fn2-alloc-init 1 fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
           ((mv & & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
           ((mv code reason & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
           (live (and (eq code :no-space) (eq reason :all-live)))
           ((mv & fn2-extents) (fn2-alloc-commit-allocation 0 1 0 1 1 fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-retire 0 1 0 1 fn2-extents))
           (blocked (eq (fn2-alloc-pressure fn2-extents) :checkpoint-blocked))
           ((mv & fn2-extents) (fn2-alloc-edge-add 0 1 0 :recovery-candidate fn2-extents))
           (quarantine (eq (fn2-alloc-pressure fn2-extents) :quarantine))
           ((mv & fn2-extents) (fn2-alloc-edge-drop 0 1 0 :recovery-candidate fn2-extents))
           ((mv & fn2-extents) (fn2-alloc-checkpoint-advance 1 1 fn2-extents)))
        (mv (and live blocked quarantine (eq (fn2-alloc-pressure fn2-extents) :ok)
                 (fn2-alloc-invp fn2-extents)) fn2-extents))
      ok)))
(assert-event (fn2-alloc-pressure-teeth))

    (mv-let (ok fn2-ops)
      (let ((fn2-ops (fn2-ops-init *fn2-profile-tiny* fn2-ops)))
        (time$ (fn2-vocab-audit-loop 100000 fn2-ops)
               :msg "VOCAB HOT LOOP: ~sa bytes, ~st seconds~%"))
      ok)))

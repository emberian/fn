; This driver is guard-verified as a composed client of the exported API.
; Init is outside time$: the measured loop allocates no snapshots or lists.
(defun fn2-vocab-audit-loop (n fn2-ops)
  (declare (xargs :stobjs fn2-ops :guard (and (natp n) (fn2-ops-wfp fn2-ops))
                  :measure (nfix n)))
  (if (zp n) (mv t fn2-ops)
    (b* (((mv code slot gen fn2-ops)
          (fn2-op-reserve *fn2-action-receive* 1 0 0 0 0 fn2-ops))
         ((unless (eq code :ok)) (mv nil fn2-ops))
         ((mv code fn2-ops) (fn2-op-enqueue slot gen fn2-ops))
         ((unless (eq code :ok)) (mv nil fn2-ops))
         ((mv code fn2-ops) (fn2-outbox-ack 1 fn2-ops))
         ((unless (eq code :ok)) (mv nil fn2-ops))
         (fn2-ops (fn2-post-result 0 slot gen *fn2-event-receive-result*
                                   *fn2-outcome-done* *fn2-reason-none*
                                   0 0 0 fn2-ops))
         ((mv found hslot hgen cell fn2-ops) (fn2-harvest-next fn2-ops))
         ((unless (and found (equal hslot slot) (equal hgen gen) (equal cell 0)))
          (mv nil fn2-ops))
         ((mv code fn2-ops) (fn2-op-finish slot gen fn2-ops))
         ((unless (eq code :ok)) (mv nil fn2-ops)))
      (fn2-vocab-audit-loop (- n 1) fn2-ops))))

; Snapshots and semantic scans are test-only. The allocation probe below calls
; only the bounded executable exports after initialization.

(defun fn2-vocab-test-receive-run (fn2-ops)
  (declare (xargs :stobjs fn2-ops :verify-guards nil))
  (b* ((fn2-ops (fn2-ops-init *fn2-profile-tiny* fn2-ops))
       ((unless (fn2-ops-semanticp fn2-ops)) (mv :conservation fn2-ops))
       ((mv code slot gen fn2-ops) (fn2-op-reserve *fn2-action-receive* 1 2 3 1 0 fn2-ops))
       ((unless (eq code :ok)) (mv :reserve fn2-ops))
       ((mv code fn2-ops) (fn2-op-set-range slot gen 4 5 6 7 fn2-ops))
       ((unless (eq code :ok)) (mv :mutation fn2-ops))
       ((mv code fn2-ops) (fn2-op-set-capability slot gen 8 9 fn2-ops))
       ((unless (eq code :ok)) (mv :mutation fn2-ops))
       ((mv code fn2-ops) (fn2-op-set-storage slot gen 10 1 fn2-ops))
       ((unless (eq code :ok)) (mv :mutation fn2-ops))
       ((mv code fn2-ops) (fn2-op-set-cancel-target slot gen 11 12 fn2-ops))
       ((unless (eq code :ok)) (mv :mutation fn2-ops))
       ((mv okind oslot ogen) (fn2-op-owner slot fn2-ops))
       ((mv rslot rgen off len) (fn2-op-range slot fn2-ops))
       ((mv cap nonce) (fn2-op-capability slot fn2-ops))
       ((mv offset fua) (fn2-op-storage slot fn2-ops))
       ((mv tslot tgen) (fn2-op-cancel-target slot fn2-ops))
       ((unless (and (equal okind 1) (equal oslot 2) (equal ogen 3)
                     (equal rslot 4) (equal rgen 5) (equal off 6) (equal len 7)
                     (equal cap 8) (equal nonce 9) (equal offset 10) (equal fua 1)
                     (equal tslot 11) (equal tgen 12)
                     (equal (fn2-op-principal slot fn2-ops) 1)
                     (equal (fn2-op-may-release slot fn2-ops) 0)
                     (equal (fn2-op-cancel-requested slot fn2-ops) 0)
                     (equal (fn2-op-gen slot fn2-ops) gen)
                     (equal (fn2-op-kind slot fn2-ops) *fn2-action-receive*))) (mv :readers fn2-ops))
       ((mv code fn2-ops) (fn2-op-enqueue slot gen fn2-ops))
       ((unless (eq code :ok)) (mv :mutation fn2-ops))
       ((unless (fn2-ops-semanticp fn2-ops)) (mv :conservation fn2-ops))
       ((mv code pslot pgen) (fn2-outbox-peek 0 fn2-ops))
       ((unless (and (eq code :ok) (equal pslot slot) (equal pgen gen) (equal (fn2-outbox-queued fn2-ops) 1))) (mv :peek fn2-ops))
       (before (fn2-ops-snapshot fn2-ops))
       ((mv code fn2-ops) (fn2-op-set-range slot gen 0 0 0 0 fn2-ops))
       ((unless (and (eq code :state) (equal before (fn2-ops-snapshot fn2-ops)))) (mv :setter-state fn2-ops))
       ((mv code fn2-ops) (fn2-outbox-ack 1 fn2-ops))
       ((unless (eq code :ok)) (mv :mutation fn2-ops))
       ((unless (fn2-ops-semanticp fn2-ops)) (mv :conservation fn2-ops))
       ((unless (equal (fn2-op-phase slot fn2-ops) *fn2-op-phase-submitted*)) (mv :submitted fn2-ops))
       (fn2-ops (fn2-post-result 0 slot gen *fn2-event-receive-result* *fn2-outcome-done* *fn2-reason-none* 7 0 0 fn2-ops))
       ((unless (fn2-ops-semanticp fn2-ops)) (mv :conservation fn2-ops))
       ((mv posted harvested ev outcome reason count aux0 aux1) (fn2-op-cell 0 slot fn2-ops))
       ((unless (and (equal posted 1) (equal harvested 0)
                     (equal ev *fn2-event-receive-result*) (equal outcome *fn2-outcome-done*)
                     (equal reason *fn2-reason-none*) (equal count 7)
                     (equal aux0 0) (equal aux1 0)
                     (equal (fn2-op-phase slot fn2-ops) *fn2-op-phase-submitted*))) (mv :posted fn2-ops))
       ((mv found hslot hgen cell fn2-ops) (fn2-harvest-next fn2-ops))
       ((unless (and found (equal hslot slot) (equal hgen gen) (equal cell 0) (equal (fn2-op-phase slot fn2-ops) *fn2-op-phase-done*))) (mv :harvest fn2-ops))
       ((unless (fn2-ops-semanticp fn2-ops)) (mv :conservation fn2-ops))
       ((mv code fn2-ops) (fn2-op-finish slot gen fn2-ops))
       ((unless (eq code :ok)) (mv :mutation fn2-ops))
       ((unless (fn2-ops-semanticp fn2-ops)) (mv :conservation fn2-ops))
       ((unless (and (equal (fn2-op-phase slot fn2-ops) *fn2-op-phase-free*) (equal (fn2-ops-gen slot fn2-ops) (+ 1 gen)) (equal (fn2-ops-free-count fn2-ops) 8))) (mv :finish fn2-ops))
       ((mv found ?hslot ?hgen ?cell fn2-ops) (fn2-harvest-next fn2-ops))
       ((unless (not found)) (mv :empty-harvest fn2-ops)))
    (mv t fn2-ops)))
(defun fn2-vocab-test-receive ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-ops
    (mv-let (result fn2-ops)
      (fn2-vocab-test-receive-run fn2-ops)
      result)))

(assert-event (equal (fn2-vocab-test-receive) t))


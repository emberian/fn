; Raw Lisp acceptance: only fixtures, mutation accounting and reporting allocate.
(in-package "ACL2")
(defun fn2-fc-t-load (bytes context slot base fields pool)
 (loop for byte in bytes for i from 0 do
  (assert (eq :ok (fn2-pool-write slot 1 i byte 1 0 1 pool))))
 (loop for x in context for i from base do (fn2-fields-set-value i x fields)))
(defun fn2-fc-t-run (kind sealp row slot len base budget fc b3 fields pool)
 (fn2-fc-reset row fc)
 (loop for code = (fn2-format-step row kind sealp slot 1 0 len base 1 0 1 budget fc b3 fields pool)
       unless (eq code :more) return code))
(defun fn2-fc-t-fixture (kind seed)
 (case kind
  (0 (values (cadr (fn2-fc-image 0 (fn2-fc-test-frame seed) *fn2-fc-test-context* t 4096)) *fn2-fc-test-context*))
  (1 (let ((bytes (fn2-fc-test-page seed))) (values bytes (fn2-fc-test-page-context bytes))))
  (2 (values (cadr (fn2-fc-image 2 (fn2-fc-test-anchor seed) *fn2-fc-test-anchor-context* t 4096)) *fn2-fc-test-anchor-context*))
  (t (values (fn2-fc-test-seal seed) *fn2-fc-test-context*))))
(defun fn2-fc-t-hot (n fc b3 fields pool)
 (declare (type fixnum n) (optimize (speed 3) (safety 1)))
 (dotimes (i n t)
  (unless (eq :ok (fn2-fc-t-run 0 t 0 0 4096 96 4096 fc b3 fields pool)) (return nil))
  (unless (eq :ok (fn2-fc-t-run 0 nil 0 0 4096 96 4096 fc b3 fields pool)) (return nil))))
(defun fn2-fc-test-all ()
 (let ((*print-pretty* nil) (fc (create-fn2-fc)) (b3 (create-fn2-b3)) (fields (create-fn2-fields)) (pool (create-fn2-pool))
       (counts (make-hash-table :test 'eq)) (mutants 0) (misplacements 0) (budgets 0))
  (fn2-fc-init 2 fc) (fn2-b3-table-init 2 b3) (fn2-fields-init 160 fields)
  (fn2-pool-init '((2 . 65536)) 1 100 pool)
  (dotimes (i 2) (assert (eq :ok (fn2-pool-reserve 0 1 0 1 pool))))
  (loop for kind from 0 below 4 for specimens in '(50 50 20 20) do
   (dotimes (seed specimens)
    (multiple-value-bind (bytes context) (fn2-fc-t-fixture kind seed)
     (let ((len (length bytes)))
      (fn2-fc-t-load bytes context 0 96 fields pool)
      (assert (eq :ok (fn2-fc-t-run kind nil 0 0 len 96 4096 fc b3 fields pool)))
      (dolist (budget '(1 7 4096))
       (assert (eq :ok (fn2-fc-t-run kind nil 0 0 len 96 budget fc b3 fields pool))) (incf budgets))
      ; Exhaust every byte position, XOR 1. This is not all 255 substitutions.
      (loop for old in bytes for offset from 0 do
       (assert (eq :ok (fn2-pool-write 0 1 offset (logxor old 1) 1 0 1 pool)))
       (let ((code (fn2-fc-t-run kind nil 0 0 len 96 4096 fc b3 fields pool)))
        (incf (gethash code counts 0)) (incf mutants)
        (assert (not (eq code :ok)))
        (when (= seed 0)
         (dolist (budget '(1 7))
          (assert (eq code (fn2-fc-t-run kind nil 0 0 len 96 budget fc b3 fields pool)))
          (incf budgets))))
       (assert (eq :ok (fn2-pool-write 0 1 offset old 1 0 1 pool)))))))
   (format t "FORMAT CHECK kind=~D specimens=~D PASS~%" kind specimens))
  (fn2-fc-t-load *fn2-fc-test-frame* *fn2-fc-test-context* 0 96 fields pool)
  (dolist (entry '((0 :bad-hash) (1 :wrong-allocation) (4 :wrong-epoch) (3 :wrong-incarnation) (24 :wrong-allocation) (2 :wrong-history) (5 :wrong-commit)))
   (let* ((i (first entry)) (old (nth i *fn2-fc-test-context*)))
    (fn2-fields-set-value (+ 96 i) (+ 1 old) fields)
    (assert (eq (second entry) (fn2-fc-t-run 0 nil 0 0 4096 96 4096 fc b3 fields pool)))
    (incf misplacements) (fn2-fields-set-value (+ 96 i) old fields)))
  (fn2-fc-t-load *fn2-fc-test-page* *fn2-fc-test-page-context* 0 96 fields pool)
  (dolist (entry '((6 :wrong-kind) (7 :wrong-length) (8 :bad-hash) (0 :wrong-location) (1 :wrong-allocation)))
   (let* ((i (first entry)) (old (nth i *fn2-fc-test-page-context*)))
    (fn2-fields-set-value (+ 96 i) (+ 1 old) fields)
    (assert (eq (second entry) (fn2-fc-t-run 1 nil 0 0 128 96 4096 fc b3 fields pool)))
    (incf misplacements) (fn2-fields-set-value (+ 96 i) old fields)))
  ; Geometry-sized page exercises sixteen incremental hash windows.
  (let* ((bytes (append *fn2-fc-test-page* (make-list (- 65536 128) :initial-element 0)))
         (context (append '(17 9 1 2 3 4 0 65536)
                     (fn-b3-words 8 (fn-blake3 (fn2-fc-covered 1 bytes nil)))
                     (make-list 8 :initial-element 0) '(8))))
   (fn2-fc-t-load bytes context 0 96 fields pool)
   (dolist (budget '(1 7 4096))
    (assert (eq :ok (fn2-fc-t-run 1 nil 0 0 65536 96 budget fc b3 fields pool))))
   (dolist (at '(4097 65535))
    (assert (eq :ok (fn2-pool-write 0 1 at 1 1 0 1 pool)))
    (assert (eq :nonzero-padding (fn2-fc-t-run 1 nil 0 0 65536 96 7 fc b3 fields pool)))
    (assert (eq :ok (fn2-pool-write 0 1 at 0 1 0 1 pool)))))
  ; Two rows alternate every byte, including partially decoded varints/fields.
  (fn2-fc-t-load *fn2-fc-test-frame* *fn2-fc-test-context* 0 96 fields pool)
  (fn2-fc-t-load *fn2-fc-test-anchor* *fn2-fc-test-anchor-context* 1 128 fields pool)
  (fn2-fc-reset 0 fc) (fn2-fc-reset 1 fc)
  (let ((a :more) (b :more))
   (loop while (or (eq a :more) (eq b :more)) do
    (when (eq a :more) (setf a (fn2-format-check-frame 0 0 1 0 4096 96 1 0 1 1 fc b3 fields pool)))
    (when (eq b :more) (setf b (fn2-format-check-anchor 1 1 1 0 (length *fn2-fc-test-anchor*) 128 1 0 1 1 fc b3 fields pool))))
   (assert (and (eq a :ok) (eq b :ok))))
  (fn2-fc-t-load *fn2-fc-test-frame* *fn2-fc-test-context* 0 96 fields pool)
  (assert (fn2-fc-t-hot 100 fc b3 fields pool))
  (sb-ext:gc :full t)
  (let* ((before (sb-ext:get-bytes-consed)) (start (get-internal-real-time))
         (ok (fn2-fc-t-hot 10000 fc b3 fields pool))
         (allocation (- (sb-ext:get-bytes-consed) before))
         (elapsed (/ (- (get-internal-real-time) start) (float internal-time-units-per-second 1d0))))
   (assert ok)
   (format t "FORMAT HOT LOOP: 10000 seal/check cycles, ~D bytes allocated, ~,6F seconds, ~,3F checked MiB/s~%"
           allocation elapsed (/ (* 10000 4096) 1048576d0 elapsed))
   (assert (= allocation 0)))
  (format t "FORMAT CHECK: 50 frames, 50 pages, 20 anchors, 20 seals; ~D XOR1 byte mutants; statuses ~S; :ok=~D; ~D misplacement refusals; ~D budget agreements (1,7,4096); interleaved slots PASS; full65536-byte page PASS~%"
          mutants (sort (loop for k being the hash-keys of counts using (hash-value v) collect (list k v)) #'string< :key (lambda (x) (symbol-name (car x))))
          (gethash :ok counts 0) misplacements budgets)))

; Actual scribe machine, with death after individual submitted descriptors.
; This test profile retains tiny scheduling but admits its required 4 KiB RX
; window. The durable image is the same one the simulated adapter mutated.
(in-package "ACL2")
(defconst *fn2-scribe-profile*
  (put-assoc-equal :pool-classes `((8 . ,*fn2-format-sector-bytes*) (4 . 65536)) *fn2-profile-tiny*))

(defun fn2-scribe-action-total (fn2-sim)
  (declare (xargs :stobjs fn2-sim :verify-guards nil))
  (+ (fn2-sim-action-countsi *fn2-action-write* fn2-sim)
     (fn2-sim-action-countsi *fn2-action-fence* fn2-sim)
     (fn2-sim-action-countsi *fn2-action-read* fn2-sim)))
(in-theory (disable fn2-scribe-action-total))

(defun fn2-scribe-test-fault (scenario fn2-sim)
  (declare (xargs :stobjs fn2-sim :verify-guards nil))
  (mv-let (found slot) (fn2-sim-next-flight fn2-sim)
    (if (not found) fn2-sim
      (let ((kind (fn2-sim-kind slot fn2-sim)))
        (cond ((and (eq scenario :short-write) (equal kind *fn2-action-write*))
               (fn2-sim-force-fault *fn2-fault-short-write* fn2-sim))
              ((and (eq scenario :fence-failure) (equal kind *fn2-action-fence*))
               (fn2-sim-force-fault *fn2-fault-flush-io* fn2-sim))
              ((and (eq scenario :misdirected-write) (equal kind *fn2-action-write*))
               (fn2-sim-force-fault *fn2-fault-miswrite* fn2-sim))
              ((and (eq scenario :read-failure) (equal kind *fn2-action-read*))
               (fn2-sim-force-fault *fn2-fault-read-io* fn2-sim))
              ((and (eq scenario :misread) (equal kind *fn2-action-read*))
               (fn2-sim-force-fault *fn2-fault-misread* fn2-sim))
              ((and (eq scenario :bitrot) (equal kind *fn2-action-read*))
               (fn2-sim-force-fault *fn2-fault-bitrot* fn2-sim))
              ((and (eq scenario :no-space) (equal kind *fn2-action-write*))
               (fn2-sim-force-fault *fn2-fault-no-space* fn2-sim))
              ((and (eq scenario :dead) (equal kind *fn2-action-write*))
               (fn2-sim-force-fault *fn2-fault-dead* fn2-sim))
              ((and (eq scenario :lying-fence) (equal kind *fn2-action-fence*))
               (fn2-sim-force-fault *fn2-fault-lying-flush* fn2-sim))
              (t fn2-sim))))))
(in-theory (disable fn2-scribe-test-fault))

(defun fn2-scribe-test-rounds (fuel cut scenario cursor queues certificate fn2-core fn2-sim fn2-own fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own fn2-ref-core) :verify-guards nil :measure (nfix fuel)
                  :hints (("Goal" :use ((:instance fn2-test-countdown (x fuel))
                                        (:instance fn2-test-count-op (x fuel))) :in-theory nil))))
  (b* ((id (fn2-machine-scribe-id fn2-core))
       ((when (zp fuel)) (mv '(:fail :scribe-fuel) certificate fn2-core fn2-sim fn2-own fn2-ref-core))
       ; A one-descriptor take admits every handoff boundary as a death cut.
       ((mv & fn2-core fn2-sim fn2-own)
        (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
       ((when (<= (nfix cut) (fn2-scribe-action-total fn2-sim)))
        (mv :cut certificate fn2-core fn2-sim fn2-own fn2-ref-core))
       (before (fn2-work-visible-before fn2-core))
       ((mv trace status nobs nvisits nactions cursor queues fn2-core fn2-own fn2-ref-core)
        (fn2-own-check-trace-turn *fn2-scribe-profile* cursor queues fn2-core fn2-own fn2-ref-core))
       ((mv verdict cert fn2-core fn2-own)
        (fn2-echo-check-turn *fn2-scribe-profile* before trace nobs nvisits nactions
                              fn2-core fn2-own))
       ((mv verdict fn2-sim) (fn2-scenario-check-observations verdict fn2-sim))
       (certificate (fn2-echo-sum-certificate certificate cert))
       ((unless (eq verdict :pass)) (mv verdict certificate fn2-core fn2-sim fn2-own fn2-ref-core))
       ((when (= (fn2-machine-stopped id fn2-core) 1))
        (mv :stopped certificate fn2-core fn2-sim fn2-own fn2-ref-core))
       ((when (eq status :stop))
        (mv '(:fail :scribe-core-stopped) certificate fn2-core fn2-sim fn2-own fn2-ref-core))
       ((mv & fn2-core fn2-sim fn2-own)
        (if (eq status :idle)
            (fn2-sim-take-prefix (fn2-echo-outbox-count fn2-core) 0 fn2-core fn2-sim fn2-own)
          (mv 0 fn2-core fn2-sim fn2-own)))
       (status (fn2-turn-status fn2-core))
       ((when (<= (nfix cut) (fn2-scribe-action-total fn2-sim)))
        (mv :cut certificate fn2-core fn2-sim fn2-own fn2-ref-core))
       (fn2-sim (fn2-scribe-test-fault scenario fn2-sim))
       ((mv & fn2-core fn2-sim fn2-own)
        (if (eq status :idle) (fn2-sim-advance-with-clients nil nil fn2-core fn2-sim fn2-own)
          (mv nil fn2-core fn2-sim fn2-own))))
    (fn2-scribe-test-rounds (- fuel 1) cut scenario cursor queues certificate
                            fn2-core fn2-sim fn2-own fn2-ref-core)))
(in-theory (disable fn2-scribe-test-rounds))

(defun fn2-scribe-copy-image (left fn2-sim fn2-recovery-image)
  (declare (xargs :stobjs (fn2-sim fn2-recovery-image) :verify-guards nil :measure (nfix left)
                  :hints (("Goal" :use ((:instance fn2-test-countdown (x left))
                                        (:instance fn2-test-count-op (x left))) :in-theory nil))))
  (if (zp left) (mv :ok fn2-recovery-image)
    (mv-let (code fn2-recovery-image)
      (fn2-sim-recovery-copy-sector (- left 1) fn2-sim fn2-recovery-image)
      (if (eq code :ok) (fn2-scribe-copy-image (- left 1) fn2-sim fn2-recovery-image)
        (mv code fn2-recovery-image)))))
(in-theory (disable fn2-scribe-copy-image))

(defun fn2-scribe-one (seed cut scenario fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core) :verify-guards nil))
  (b* ((profile *fn2-scribe-profile*)
       (fn2-core (fn2-init-executor profile :null t fn2-core))
       (fn2-ref-core (fn2-ref-reset profile fn2-core fn2-ref-core))
       (fn2-sim (fn2-sim-init seed :none *fn2-scenario-revision* profile fn2-sim))
       ; The declared broad model alone permits a lying fence; keep the
       ; per-class probabilities at zero and force only this named fault.
       (fn2-sim (if (eq scenario :lying-fence)
                    (update-fn2-sim-profile-name :broad fn2-sim) fn2-sim))
       (fn2-sim (fn2-sim-echo-network-reset fn2-sim))
       (fn2-own (fn2-own-init profile fn2-own))
       (fn2-recovery-image (fn2-recovery-init (fn2-sim-sectors profile) fn2-recovery-image))
       (id (fn2-machine-global-id *fn2-scribe-kind* 0 profile))
       (queues (list (cons 0 (append (fn2-echo-initial-ids (fn2-profile-accept-credits profile) 0)
                                     (list id)))))
       ((mv result certificate fn2-core fn2-sim fn2-own fn2-ref-core)
        (fn2-scribe-test-rounds 30000 cut scenario 0 queues nil fn2-core fn2-sim fn2-own fn2-ref-core))
       (stop (fn2-core-stop-reason fn2-core))
       (- (cw "SCRIBE STOP scenario=~x0 cut=~x1 reason=~x2~%"
              scenario cut (fn2-stop-reason-code->keyword stop)))
       ((unless (member-eq result '(:cut :stopped)))
        (mv result nil certificate fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core))
       (ack (fn2-machine-completed id fn2-core))
       (verified (fn2-machine-verified id fn2-core))
       (writes (fn2-sim-action-countsi *fn2-action-write* fn2-sim))
       (fences (fn2-sim-action-countsi *fn2-action-fence* fn2-sim))
       (fault-id (cdr (assoc-eq scenario `((:short-write . ,*fn2-fault-short-write*)
                       (:fence-failure . ,*fn2-fault-flush-io*) (:misdirected-write . ,*fn2-fault-miswrite*)
                       (:read-failure . ,*fn2-fault-read-io*) (:misread . ,*fn2-fault-misread*)
                       (:bitrot . ,*fn2-fault-bitrot*) (:no-space . ,*fn2-fault-no-space*)
                       (:dead . ,*fn2-fault-dead*) (:lying-fence . ,*fn2-fault-lying-flush*)))))
       (fault-hit (or (eq scenario :none)
                      (and (natp fault-id) (< 0 (fn2-sim-hitsi fault-id fn2-sim)))))
       ; The ack is captured externally before death. Core restart cannot
       ; manufacture it from a checksum or retain stale volatile machine bits.
       ((mv fn2-core fn2-sim fn2-own)
        (fn2-sim-crash profile fn2-core fn2-sim fn2-own))
       ((mv copy-code fn2-recovery-image)
        (fn2-scribe-copy-image (fn2-sim-sectors profile) fn2-sim fn2-recovery-image))
       ((mv class valid never bad misplaced)
        (if (eq copy-code :ok) (fn2-recover-stub ack (eq scenario :none) fn2-recovery-image)
          (mv :unknown 0 0 0 0)))
       (correct (and (= stop *fn2-stop-reason-none*) fault-hit (<= verified ack) (<= ack fences)
                     ; With no storage faults, each cycle submits exactly
                     ; Write/Fence/Read. These cut frontiers distinguish
                     ; completed fences from merely submitted fences.
                     (or (not (eq scenario :none))
                         (and (eq result :cut)
                              (= ack (floor (nfix cut) 3))
                              (= verified (floor (nfix (- (nfix cut) 1)) 3))))
                     (or (equal (+ bad misplaced) 0) (not (eq class :intact)))
                     (or (not (< valid ack)) (member-eq class '(:damaged :unknown)))
                     (or (not (member-eq scenario '(:short-write :fence-failure :no-space :dead)))
                         (and (eq result :stopped) (= writes 1) (<= fences 1)))))
       (fn2-core (fn2-init-executor profile :null nil fn2-core)))
    (mv (if correct :pass (list :fail :scribe-evidence result class ack verified writes fences))
        (list scenario cut class ack verified valid never bad misplaced)
        certificate fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core)))
(in-theory (disable fn2-scribe-one))

(defun fn2-scribe-cases (cases seed results certificate fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core) :verify-guards nil))
  (if (atom cases) (mv :pass (reverse results) certificate fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core)
    (b* (((mv verdict result cert fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core)
          (fn2-scribe-one seed (cadar cases) (caar cases)
                          fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core))
         ((unless (eq verdict :pass))
          (mv verdict (reverse (cons result results)) certificate
              fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core)))
      (fn2-scribe-cases (cdr cases) (+ 1 (nfix seed)) (cons result results)
                        (fn2-echo-sum-certificate certificate cert)
                        fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core))))
(in-theory (disable fn2-scribe-cases))

(defun fn2-sim-run-scribe ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-ref-core
    (mv-let (answer fn2-ref-core)
      (with-local-stobj fn2-core
    (mv-let (answer fn2-core fn2-ref-core)
      (with-local-stobj fn2-sim
        (mv-let (answer fn2-core fn2-sim fn2-ref-core)
          (with-local-stobj fn2-own
            (mv-let (answer fn2-core fn2-sim fn2-own fn2-ref-core)
              (with-local-stobj fn2-recovery-image
                (mv-let (status results certificate fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core)
                  (b* (((mv fn2-core fn2-sim fn2-own) (fn2-abi-check fn2-core fn2-sim fn2-own)))
                   (fn2-scribe-cases
                   '((:none 0) (:none 1) (:none 2) (:none 3) (:none 4) (:none 5)
                     (:none 6) (:none 7) (:none 8) (:none 9)
                     (:short-write 20) (:fence-failure 20) (:misdirected-write 20) (:read-failure 20)
                     (:misread 20) (:no-space 20) (:dead 20) (:lying-fence 20) (:bitrot 20))
                   1000 nil nil fn2-core fn2-sim fn2-own fn2-recovery-image fn2-ref-core))
                  (progn$
                   (if (eq status :pass) nil (fn2-echo-failure-trace fn2-core))
                   (cw "WORK BYTES SCRIBE charged=~x0 outbox=~x1 harvested=~x2~%"
                       (nth 3 certificate) (nth 5 certificate) (nth 6 certificate))
                   (cw "SCRIBE SCENARIO profile=TINY-4K cases=~x0 WORK/TRACE/OWN=~x1 certificate=~x2 classifications=~x3~%"
                       (len results) status certificate results)
                   (mv (list status results certificate) fn2-core fn2-sim fn2-own fn2-ref-core))))
              (mv answer fn2-core fn2-sim fn2-ref-core)))
          (mv answer fn2-core fn2-ref-core)))
      (mv answer fn2-ref-core)))
      answer)))
(in-theory (disable fn2-sim-run-scribe))

; Run: (nohup env FN_ACL2_SLOT_DIR=/tmp/fn2-a3-acl2-slots FN_ACL2_SLOTS=4 timeout -k 5 900 tools/acl2 < fn2/tests/core-allocation-driver.lsp > build/a3-core-allocation.log 2>&1 & echo $! > build/a3-core-allocation.pid)
; ACL2 ld script, not a certified book. The measured loop includes all nine
; issue helpers, input writes, acknowledgements, results and harvests.
(in-package "ACL2")
(include-book "../books/core")

(defun fn2-audit-post (slot gen kind count fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
    (code fn2-ops)
    (mv-let (code fn2-ops) (fn2-outbox-ack 1 fn2-ops)
      (let ((fn2-ops (fn2-post-result 0 slot gen (fn2-terminal-event kind)
                       *fn2-outcome-done* *fn2-reason-none* count 0 0 fn2-ops)))
        (mv code fn2-ops)))
    (mv code fn2-core)))
(fn2-core-shape-lemmas fn2-audit-post (slot gen kind count) 1)

(defun fn2-audit-input-byte (slot gen op ogen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
    (code fn2-pool)
    (fn2-pool-adapter-write slot gen op ogen 0 65 fn2-pool)
    (mv code fn2-core)))
(fn2-core-shape-lemmas fn2-audit-input-byte (slot gen op ogen) 1)

(in-theory (disable fn2-core-wfp fn2-terminal-event))

(defun fn2-audit-complete (slot gen kind count fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((mv code fn2-core) (fn2-audit-post slot gen kind count fn2-core))
       ((unless (eq code :ok)) (mv nil fn2-core))
       ((mv found hslot hgen cell ev outcome reason n a b fn2-core)
        (fn2-harvest-one fn2-core))
       (- ev outcome reason n a b))
    (mv (and found (equal hslot slot) (equal hgen gen) (equal cell 0)) fn2-core)))
(fn2-core-shape-lemmas fn2-audit-complete (slot gen kind count) 1)

(defun fn2-audit-call (kind slot gen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (case kind
    (2 (fn2-issue-receive 0 1 slot gen 1 1 0 1 0 fn2-core))
    (3 (fn2-issue-send 0 1 slot gen 0 1 0 1 0 1 0 fn2-core))
    (6 (fn2-issue-write 0 slot gen 0 1 0 1 0 1 0 fn2-core))
    (5 (fn2-issue-read 0 slot gen 1 1 0 1 0 fn2-core))
    (10 (fn2-issue-entropy slot gen 1 1 0 1 0 fn2-core))
    (7 (fn2-issue-fence 1 0 1 0 fn2-core))
    (0 (fn2-issue-accept 0 1 1 0 1 0 fn2-core))
    (4 (fn2-issue-close 0 1 1 0 1 0 fn2-core))
    (otherwise (fn2-issue-cancel 0 0 1 0 1 0 fn2-core))))
(fn2-core-shape-lemmas fn2-audit-call (kind slot gen) 3)

(defun fn2-audit-one (kind slot gen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* ((input (or (equal kind 2) (equal kind 5) (equal kind 10)))
       ((mv code fn2-core)
        (if input (fn2-core-reset slot gen 1 0 1 fn2-core) (mv :ok fn2-core)))
       ((unless (eq code :ok)) (mv nil fn2-core))
       ((mv code op ogen fn2-core) (fn2-audit-call kind slot gen fn2-core))
       ((unless (eq code :ok)) (mv nil fn2-core))
       ((mv code fn2-core)
        (if input (fn2-audit-input-byte slot gen op ogen fn2-core) (mv :ok fn2-core)))
       ((unless (eq code :ok)) (mv nil fn2-core)))
    (fn2-audit-complete op ogen kind
      (if (or input (equal kind 3) (equal kind 6)) 1 0) fn2-core)))
(fn2-core-shape-lemmas fn2-audit-one (kind slot gen) 1)

; Each operation has a closed shape boundary. An unsuccessful call marks the
; cycle false; the remaining calls still execute, so no proof has nine nested
; early-refusal continuations. The measured valid state succeeds at every call.
(defun fn2-core-audit-cycle (slot gen fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (b* (((mv a fn2-core) (fn2-audit-one 2 slot gen fn2-core))
       ((mv b fn2-core) (fn2-audit-one 3 slot gen fn2-core))
       ((mv c fn2-core) (fn2-audit-one 6 slot gen fn2-core))
       ((mv d fn2-core) (fn2-audit-one 5 slot gen fn2-core))
       ((mv e fn2-core) (fn2-audit-one 7 slot gen fn2-core))
       ((mv f fn2-core) (fn2-audit-one 0 slot gen fn2-core))
       ((mv g fn2-core) (fn2-audit-one 4 slot gen fn2-core))
       ((mv h fn2-core) (fn2-audit-one 8 slot gen fn2-core))
       ((mv i fn2-core) (fn2-audit-one 10 slot gen fn2-core)))
    (mv (and a b c d e f g h i) fn2-core)))
(fn2-core-shape-lemmas fn2-core-audit-cycle (slot gen) 1)

(defun fn2-core-audit-loop (n slot gen fn2-core)
  (declare (xargs :stobjs fn2-core :measure (nfix n)
                  :guard (and (natp n) (fn2-core-wfp fn2-core))))
  (if (zp n) (mv t fn2-core)
    (mv-let (ok fn2-core) (fn2-core-audit-cycle slot gen fn2-core)
      (if ok (fn2-core-audit-loop (- n 1) slot gen fn2-core)
        (mv nil fn2-core)))))

(fn2-core-shape-lemmas fn2-core-audit-loop (n slot gen) 1)

(defun fn2-core-allocation-audit ()
  (declare (xargs :guard t
                  :guard-hints (("Goal" :in-theory (enable fn2-corep)))))
  (with-local-stobj fn2-core
    (mv-let (ok fn2-core)
      (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
           ((mv code slot gen fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
           ((unless (eq code :ok)) (mv nil fn2-core))
           ((mv ok fn2-core) (fn2-core-audit-loop 100 slot gen fn2-core))
           ((unless ok) (mv nil fn2-core)))
        (time$ (fn2-core-audit-loop 100000 slot gen fn2-core)
               :msg "CORE HOT LOOP: 100000 cycles, ~sa bytes, ~st seconds~%"))
      ok)))
(assert-event (eq (symbol-class 'fn2-core-audit-loop (w state)) :common-lisp-compliant))
(assert-event (eq (symbol-class 'fn2-core-allocation-audit (w state)) :common-lisp-compliant))
(assert-event (fn2-core-allocation-audit))

; Raw Lisp differential driver; all lists/allocations here are test-only.
; Run through tools/acl2 < fn2/tests/merkle-random.lsp with timeout and PID file.
(in-package "ACL2")
(defvar *mk-dg* nil)
(defun mk-result (row log)
 (fn2-mk-root 136 row *mk-dg* log) (fn2-digest-list 136 *mk-dg*))
(defun mk-append-digest (words log)
 (fn2-digest-load 137 words *mk-dg*) (fn2-mk-append 0 137 *mk-dg* log))
(defvar *mk-records*)
(defvar *mk-cache*)
(defun mk-oracle (lo n)
 (or (gethash (cons lo n) *mk-cache*)
  (setf (gethash (cons lo n) *mk-cache*)
   (cond ((zerop n) (fn-blake3 nil))
         ((= n 1) (fn-blake3 (cons 0 (aref *mk-records* lo))))
         (t (let ((k (ash 1 (1- (integer-length (1- n))))))
          (fn-blake3 (cons 1 (append (mk-oracle lo k) (mk-oracle (+ lo k) (- n k)))))))))))
(defun mk-inclusion-proof (index lo n)
 (if (= n 1) nil
  (let ((k (ash 1 (1- (integer-length (1- n))))))
   (if (< index k)
    (append (mk-inclusion-proof index lo k) (list (mk-oracle (+ lo k) (- n k))))
    (append (mk-inclusion-proof (- index k) (+ lo k) (- n k)) (list (mk-oracle lo k)))))))
(defun mk-consistency-proof (m lo n complete)
 (if (= m n) (if complete nil (list (mk-oracle lo n)))
  (let ((k (ash 1 (1- (integer-length (1- n))))))
   (if (<= m k)
    (append (mk-consistency-proof m lo k complete) (list (mk-oracle (+ lo k) (- n k))))
    (append (mk-consistency-proof (- m k) (+ lo k) (- n k) nil) (list (mk-oracle lo k)))))))
(defun mk-fields (proof fields)
 (declare (ignore fields))
 (loop for digest in proof for i from 140 do (fn2-digest-load i (fn-b3-words 8 digest) *mk-dg*)))
(defun mk-include (index n leaf proof root log fields)
 (fn2-mk-proof-reset 0 log) (mk-fields proof fields)
 (fn2-digest-load 136 (fn-b3-words 8 leaf) *mk-dg*) (fn2-digest-load 137 (fn-b3-words 8 root) *mk-dg*)
 (loop for steps from 0 below 64 for code = (fn2-mk-verify-inclusion 0 index n 136 140 (length proof) 137 *mk-dg* log)
  when (not (eq code :more)) return (values code steps)
  finally (error "inclusion continuation did not finish")))
(defun mk-consistent (m n proof old new log fields)
 (fn2-mk-proof-reset 0 log) (mk-fields proof fields)
 (fn2-digest-load 136 (fn-b3-words 8 old) *mk-dg*) (fn2-digest-load 137 (fn-b3-words 8 new) *mk-dg*)
 (loop for steps from 0 below 65 for code = (fn2-mk-verify-consistency 0 m n 140 (length proof) 136 137 *mk-dg* log)
  when (not (eq code :more)) return (values code steps)
  finally (error "consistency continuation did not finish")))
(defun mk-flip-proof (proof)
 (let ((out (copy-tree proof))) (setf (caar out) (logxor 1 (caar out))) out))
(defun mk-append-loop (n log)
 (declare (type fixnum n) (optimize (speed 3) (safety 1)))
 (dotimes (i n) (unless (eq (fn2-mk-append 0 137 *mk-dg* log) :ok) (error "append refused"))))
(defun mk-leaf-test ()
 (let* ((pool (fn2-pool-init '((1 . 8200)) 1 100 (create-fn2-pool)))
        (b3 (fn2-b3-table-init 1 (create-fn2-b3)))
        (bytes (loop for i below 8200 collect (mod i 251))))
  (fn2-pool-reserve 0 1 0 1 pool)
  (loop for b in bytes for i from 0 do (fn2-pool-write 0 1 i b 1 0 1 pool))
  (dolist (n '(0 1 4095 4096 4097 8200))
   (fn2-mk-leaf-start 0 *mk-dg* b3)
   (let ((steps 0))
    (loop for code = (fn2-mk-leaf 0 1 0 n 1 0 1 0 *mk-dg* b3 pool) do (incf steps)
     while (eq code :more) finally (assert (eq code :ok)))
    (assert (= steps (max 1 (ceiling n 4096))))
    (assert (equal (progn (fn2-b3-finalize 136 0 *mk-dg* b3) (fn2-digest-list 136 *mk-dg*))
                   (fn-b3-words 8 (fn-blake3 (cons 0 (subseq bytes 0 n))))))))))
(defun mk-continuation-test (log fields)
 ; 40 proof nodes force >32 work steps; no enormous tree needs allocation.
 (let* ((leaf (fn-blake3 '(0 42))) (node (fn-blake3 '(0 43)))
        (proof (make-list 40 :initial-element node)) (root leaf))
  (dotimes (i 40) (setf root (fn-blake3 (cons 1 (append root node)))))
  (multiple-value-bind (code steps) (mk-include 0 (ash 1 40) leaf proof root log fields)
   (assert (and (eq code :ok) (> steps 32))))
  (multiple-value-bind (code steps) (mk-consistent 1 (ash 1 40) proof leaf root log fields)
   (assert (and (eq code :ok) (> steps 32))))
  ; Changed arguments, including trivial empty extension, cannot bypass a
  ; running proof. Reset cancels a proof without clearing the event frontier.
  (fn2-mk-proof-reset 0 log) (mk-fields proof fields)
  (fn2-digest-load 136 (fn-b3-words 8 leaf) *mk-dg*) (fn2-digest-load 137 (fn-b3-words 8 root) *mk-dg*)
  (let ((args (list 0 1 (ash 1 40) 140 40 136 137 *mk-dg* log)))
   (assert (eq (apply #'fn2-mk-verify-consistency args) :more))
   (setf (second args) 0)
   (assert (eq (apply #'fn2-mk-verify-consistency args) :state)))))
(defun fn2-mk-test-all ()
 (let* ((*mk-dg* (fn2-digests-init 208 (create-fn2-digests)))
        (*mk-records* (make-array 5000)) (*mk-cache* (make-hash-table :test 'equal))
        (log (fn2-mk-table-init 1 (create-fn2-mk)))
        (verify-log (fn2-mk-table-init 1 (create-fn2-mk)))
        (fields (fn2-fields-init 488 (create-fn2-fields)))
        (roots (make-array 5001)) (seed 20261028)
        (roots-ok 0) (inclusions 0) (tampered 0) (shifted 0) (resized 0)
        (consistencies 0) (bad-consistencies 0) (aliases 0))
  (labels ((rng (n) (setf seed (mod (+ (* seed 1664525) 1013904223) 4294967296)) (mod seed n)))
   (dotimes (i 5000)
    (setf (aref *mk-records* i) (list (logand i 255) (ash i -8) (rng 256))))
   (setf (aref roots 0) (fn-b3-words-octets (mk-result 0 log)))
   (dotimes (i 5000)
    (assert (eq (mk-append-digest (fn-b3-words 8 (mk-oracle i 1)) log) :ok))
    (setf (aref roots (1+ i)) (fn-b3-words-octets (mk-result 0 log))))
   (dotimes (trial 2000)
    (let* ((n (+ 2 (rng 4999))) (root (mk-oracle 0 n)))
     (assert (equal root (aref roots n))) (incf roots-ok)
     (dotimes (j 20)
      (let* ((index (rng n)) (leaf (mk-oracle index 1)) (proof (mk-inclusion-proof index 0 n)))
       (assert (eq (mk-include index n leaf proof root verify-log fields) :ok)) (incf inclusions)
       (assert (not (eq (mk-include index n leaf (mk-flip-proof proof) root verify-log fields) :ok))) (incf tampered)
       (assert (not (eq (mk-include (mod (1+ index) n) n leaf proof root verify-log fields) :ok))) (incf shifted)
       ; Changing size across a tree-height boundary must alter the path.
       (assert (not (eq (mk-include index (* n 2) leaf proof root verify-log fields) :ok))) (incf resized)))
     (let* ((m (1+ (rng (1- n)))) (proof (mk-consistency-proof m 0 n t)))
      (assert (eq (mk-consistent m n proof (mk-oracle 0 m) root verify-log fields) :ok)) (incf consistencies)
      (assert (not (eq (mk-consistent m n (mk-flip-proof proof) (mk-oracle 0 m) root verify-log fields) :ok)))
      (incf bad-consistencies))))
   ; RFC inclusion does not authenticate tree size independently of root.
   (assert (eq (mk-include 0 4 (mk-oracle 0 1) (mk-inclusion-proof 0 0 3)
                           (mk-oracle 0 3) verify-log fields) :ok)) (incf aliases)
   (assert (eq (mk-consistent 0 0 nil (mk-oracle 0 0) (mk-oracle 0 0) verify-log fields) :ok))
   (assert (eq (mk-consistent 0 2 nil (mk-oracle 0 1) (mk-oracle 0 2) verify-log fields) :root-mismatch))
   (mk-leaf-test) (mk-continuation-test verify-log fields)
   (fn2-digest-load 137 '(0 1 2 3 4 5 6 7) *mk-dg*)
   (fn2-mk-init 0 log) (mk-append-loop 1000 log) ; compile/allocator warmup
   (fn2-mk-init 0 log) (sb-ext:gc :full t)
   (let ((before (sb-ext:get-bytes-consed)) (start (get-internal-real-time)))
    (mk-append-loop 100000 log)
    (let* ((allocated (- (sb-ext:get-bytes-consed) before))
           (elapsed (/ (- (get-internal-real-time) start) (float internal-time-units-per-second))))
     (format t "B2E roots=~D inclusion=~D tampered=~D shifted=~D resized-height=~D consistency=~D consistency-tampered=~D size-aliases=~D continuation40=ok leaf-splits=ok allocated=~D appends/sec=~,2F~%"
      roots-ok inclusions tampered shifted resized consistencies bad-consistencies aliases allocated (/ 100000 elapsed))
     (assert (zerop allocated)))))))

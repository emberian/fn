(defun fn2-fault-control-issue (kind slot gen fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own) :verify-guards nil))
  (b* (((mv code fn2-core)
        (if (or (equal kind *fn2-action-receive*) (equal kind *fn2-action-read*))
            (fn2-core-reset slot gen 1 0 1 fn2-core) (mv :ok fn2-core)))
       ((unless (and (eq code :ok) (eq (fn2-check-own fn2-core fn2-own) :pass)))
        (mv nil 0 fn2-core fn2-own))
       ((mv code op ogen fn2-core)
        (cond ((equal kind *fn2-action-send*)
               (fn2-issue-send 0 1 slot gen 0 32 1 1 0 1 0 fn2-core))
              ((equal kind *fn2-action-read*)
               (fn2-issue-read 0 slot gen 32 1 0 1 0 fn2-core))
              ((equal kind *fn2-action-write*)
               (fn2-issue-write 0 slot gen 0 32 0 1 0 1 0 fn2-core))
              ((equal kind *fn2-action-fence*) (fn2-issue-fence 1 0 1 0 fn2-core))
              (t (fn2-issue-receive 0 1 slot gen 32 1 0 1 0 fn2-core))))
       (- ogen)
       (fn2-own (if (eq code :ok) (fn2-own-observe-issue op fn2-core fn2-own) fn2-own)))
    (mv (and (eq code :ok) (eq (fn2-check-own fn2-core fn2-own) :pass)) op fn2-core fn2-own)))
(in-theory (disable fn2-fault-control-issue))

(defun fn2-fault-control-step (fault fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* ((fn2-sim (fn2-sim-force-fault fault fn2-sim))
       ((mv completed fn2-core fn2-sim fn2-own)
        (fn2-sim-advance fn2-core fn2-sim fn2-own))
       (- completed)
       (status (fn2-check-own fn2-core fn2-own))
       ((unless (eq status :pass)) (mv status fn2-core fn2-sim fn2-own))
       ((mv status fn2-core fn2-own) (fn2-scenario-harvest 2 fn2-core fn2-own)))
    (mv status fn2-core fn2-sim fn2-own)))
(in-theory (disable fn2-fault-control-step))

; The composed adapter must leave the second fence queued on exhaustion.
(defun fn2-storage-adapter-control-run (fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
       (fn2-sim (fn2-sim-init 0 :none *fn2-scenario-revision* *fn2-profile-tiny* fn2-sim))
       ((mv ok1 op1 fn2-core fn2-own)
        (fn2-fault-control-issue *fn2-action-fence* 0 0 fn2-core fn2-own))
       ((mv ok2 op2 fn2-core fn2-own)
        (fn2-fault-control-issue *fn2-action-fence* 0 0 fn2-core fn2-own))
       ((mv first fn2-core fn2-sim fn2-own) (fn2-sim-take-one fn2-core fn2-sim fn2-own))
       (admission (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim)))
                    (code) (fn2-storage-fence-admission op2 fn2-sim-storage) code))
       ((mv second fn2-core fn2-sim fn2-own) (fn2-sim-take-one fn2-core fn2-sim fn2-own))
       (retained (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
                   (ok)
                   (mv-let (code slot gen) (fn2-outbox-peek 0 fn2-ops)
                     (declare (ignore gen)) (and (eq code :ok) (equal slot op2))) ok))
       (blocked (and ok1 ok2 first (not second) retained (eq admission :exhausted)
                     (= (fn2-sim-active op1 fn2-sim) 1)
                     (= (fn2-sim-active op2 fn2-sim) 0)))
       ((mv status1 fn2-core fn2-sim fn2-own) (fn2-fault-control-step 26 fn2-core fn2-sim fn2-own))
       ((mv retry fn2-core fn2-sim fn2-own) (fn2-sim-take-one fn2-core fn2-sim fn2-own))
       ((mv status2 fn2-core fn2-sim fn2-own) (fn2-fault-control-step 26 fn2-core fn2-sim fn2-own)))
    (mv (and blocked retry (eq status1 :pass) (eq status2 :pass)
             (eq (fn2-check-own fn2-core fn2-own) :pass)) fn2-core fn2-sim fn2-own)))
(in-theory (disable fn2-storage-adapter-control-run))

(defun fn2-storage-cancel-control-run (fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
       (fn2-sim (fn2-sim-init 0 :none *fn2-scenario-revision* *fn2-profile-tiny* fn2-sim))
       ((mv ok1 op fn2-core fn2-own)
        (fn2-fault-control-issue *fn2-action-fence* 0 0 fn2-core fn2-own))
       ((mv take1 fn2-core fn2-sim fn2-own) (fn2-sim-take-one fn2-core fn2-sim fn2-own))
       ((mv code cancel-op cancel-gen fn2-core)
        (fn2-issue-cancel op (fn2-sim-gen op fn2-sim) 1 0 1 0 fn2-core))
       (- cancel-gen)
       ((mv take2 fn2-core fn2-sim fn2-own) (fn2-sim-take-one fn2-core fn2-sim fn2-own))
       ((mv done1 fn2-core fn2-sim fn2-own) (fn2-sim-complete cancel-op 26 0 fn2-core fn2-sim fn2-own))
       ((mv done2 fn2-core fn2-sim fn2-own) (fn2-sim-complete op 26 0 fn2-core fn2-sim fn2-own))
       (cancelled (= (fn2-sim-terminal-outcome op fn2-sim) *fn2-outcome-cancelled*))
       ((mv status fn2-core fn2-own) (fn2-scenario-harvest 2 fn2-core fn2-own))
       ((mv ok2 next fn2-core fn2-own)
        (fn2-fault-control-issue *fn2-action-fence* 0 0 fn2-core fn2-own))
       (- next)
       ((mv retry fn2-core fn2-sim fn2-own) (fn2-sim-take-one fn2-core fn2-sim fn2-own)))
    (mv (and ok1 ok2 (eq code :ok) take1 take2 done1 done2 cancelled
             (eq status :pass) retry (eq (fn2-check-own fn2-core fn2-own) :pass))
        fn2-core fn2-sim fn2-own)))
(in-theory (disable fn2-storage-cancel-control-run))

(defun fn2-storage-adapter-control (cancel)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (ok fn2-core)
      (with-local-stobj fn2-sim
        (mv-let (ok fn2-core fn2-sim)
          (with-local-stobj fn2-own
            (mv-let (ok fn2-core fn2-sim fn2-own)
              (if cancel (fn2-storage-cancel-control-run fn2-core fn2-sim fn2-own)
                (fn2-storage-adapter-control-run fn2-core fn2-sim fn2-own))
              (mv ok fn2-core fn2-sim)))
          (mv ok fn2-core)))
      ok)))
(assert-event (and (fn2-storage-adapter-control nil)
                   (fn2-storage-adapter-control t)
                   (prog2$ (cw "S1 FENCE ADAPTER: exhaustion/retry and cancellation release, OWN=:PASS~%") t)))

(defun fn2-fault-control-reuse (slot gen fn2-core fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-own) :verify-guards nil))
  (b* (((mv code fn2-core) (fn2-core-release slot gen 1 0 1 fn2-core))
       ((unless (and (eq code :ok) (eq (fn2-check-own fn2-core fn2-own) :pass)))
        (mv nil fn2-core fn2-own))
       ((mv code newslot newgen fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
       ((unless (and (eq code :ok) (equal slot newslot) (equal newgen (+ 1 (nfix gen)))
                      (eq (fn2-check-own fn2-core fn2-own) :pass)))
        (mv nil fn2-core fn2-own))
       ((mv code fn2-core) (fn2-core-write newslot newgen 0 255 1 0 1 fn2-core))
       (fn2-own (fn2-own-observe-core-write newslot newgen 0 code 255 fn2-core fn2-own)))
    (mv (and (eq code :ok) (eq (fn2-check-own fn2-core fn2-own) :pass)) fn2-core fn2-own)))
(in-theory (disable fn2-fault-control-reuse))

(defun fn2-fault-control-late-terminal (op expected fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* (((mv completed fn2-core fn2-sim fn2-own) (fn2-sim-advance fn2-core fn2-sim fn2-own))
       ((unless (and completed (eq (fn2-check-own fn2-core fn2-own) :pass)))
        (mv '(:fail :late-terminal-adapter) fn2-core fn2-sim fn2-own))
       ((mv found hslot gen cell ev outcome reason count a b fn2-core) (fn2-harvest-one fn2-core))
       (- gen outcome reason a b))
    (mv (if (and found (equal hslot op) (equal cell 0)

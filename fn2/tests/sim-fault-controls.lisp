(assert-event
 (and (fn2-storage-live-tear-control)
      (fn2-storage-stale-cache-control 1 nil)
      (fn2-storage-stale-cache-control 2 nil)
      (fn2-storage-stale-cache-control 3 nil)
      (fn2-storage-stale-cache-control 1 t)
      (fn2-storage-stale-cache-control 2 t)
      (fn2-storage-stale-cache-control 3 t)
      (fn2-storage-fence-slots-control)
      (fn2-storage-reverse-fences-control)
      (prog2$ (cw "S1 STORAGE CONTROLS: live-tear, stale-cache (3 landings, clean/mixed), fence-slots/reverse PASS~%") t)))


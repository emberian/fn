        (fn2-recovery-control-cuts 2 fn2-core fn2-sim fn2-own fn2-recovery-image))
       ((unless (eq status :pass)) (mv status fn2-core fn2-sim fn2-own fn2-recovery-image))
       ((mv status fn2-core fn2-sim fn2-own fn2-recovery-image)

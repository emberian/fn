    (let* ((fn2-sim-storage
            (if (equal fault 11)
                (fn2-fault-control-dirty (fn2-sim-storage-rows fn2-sim-storage) fn2-sim-storage)
              fn2-sim-storage))
           (fn2-sim-network
            (cond ((equal fault 4) (fn2-sim-network-set-rx-count 0 0 fn2-sim-network))
                  ((equal fault 5)
                   (fn2-sim-network-set-tx-count 0 (fn2-sim-network-cap 0 fn2-sim-network) fn2-sim-network))
                  (t fn2-sim-network))))
      (mv fn2-sim-storage fn2-sim-network))
    fn2-sim))
(in-theory (disable fn2-fault-control-prepare))
(defun fn2-fault-control-disk-effects (left fault fn2-sim-storage)
  (declare (xargs :stobjs fn2-sim-storage :verify-guards nil :measure (nfix left)
                  :hints (("Goal" :in-theory nil

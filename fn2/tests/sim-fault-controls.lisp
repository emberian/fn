            :pass '(:fail :late-terminal-after-reuse)) fn2-core fn2-sim fn2-own)))
(in-theory (disable fn2-fault-control-late-terminal))

; These observers assert physical effects separately from the choice counters.
; Test setup makes every tear unit dirty and makes blocked pipes genuinely full
; or empty; selecting an inapplicable fault cannot satisfy the control.
(defun fn2-fault-control-dirty (left fn2-sim-storage)
  (declare (xargs :stobjs fn2-sim-storage :verify-guards nil :measure (nfix left)
                  :hints (("Goal" :in-theory nil
                           :use ((:instance fn2-test-countdown (x left))
                                 (:instance fn2-test-count-op (x left)))))))
  (if (zp left) fn2-sim-storage
    (let* ((i (- left 1))
           (fn2-sim-storage (fn2-sim-storage-set-pending i 65 fn2-sim-storage))
           (fn2-sim-storage (fn2-sim-storage-set-durable i 153 fn2-sim-storage))
           (fn2-sim-storage (fn2-sim-storage-set-stamp i 1 fn2-sim-storage)))
      (fn2-fault-control-dirty i fn2-sim-storage))))
(in-theory (disable fn2-fault-control-dirty))

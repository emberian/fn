(defun fn2-fault-control-one (fault fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
       (fn2-sim (fn2-sim-init (+ 100000 (nfix fault)) :broad *fn2-scenario-revision* *fn2-profile-tiny* fn2-sim))
       (fn2-sim (fn2-fault-control-quiet 26 fn2-sim))
       ((mv code slot gen fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
       ((unless (and (eq code :ok) (eq (fn2-check-own fn2-core fn2-own) :pass)))
        (mv '(:fail :control-reserve) fn2-core fn2-sim fn2-own))
       ((mv status fn2-core fn2-own) (fn2-fault-control-fill 0 32 slot gen fn2-core fn2-own))
       ((unless (eq status :pass)) (mv status fn2-core fn2-sim fn2-own))
       ; A completed pending write gives fence/tear/lost-flush faults real
       ; bytes to affect. It also provides a nonzero read window.
       ((mv ok op fn2-core fn2-own)
        (fn2-fault-control-issue *fn2-action-write* slot gen fn2-core fn2-own))
       (- op)
       ((unless ok) (mv '(:fail :control-baseline-issue) fn2-core fn2-sim fn2-own))
       ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
       ((unless (and (equal taken 1) (eq (fn2-check-own fn2-core fn2-own) :pass)))
        (mv '(:fail :control-baseline-take) fn2-core fn2-sim fn2-own))
       ((mv status fn2-core fn2-sim fn2-own) (fn2-fault-control-step 26 fn2-core fn2-sim fn2-own))
       ((unless (eq status :pass)) (mv status fn2-core fn2-sim fn2-own))
       (fn2-sim (fn2-fault-control-prepare fault fn2-sim))
       ((mv ok op fn2-core fn2-own)
        (fn2-fault-control-issue (fn2-fault-control-kind fault) slot gen fn2-core fn2-own))
       ((unless ok) (mv '(:fail :control-target-issue) fn2-core fn2-sim fn2-own))
       ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
       ((unless (and (equal taken 1) (eq (fn2-check-own fn2-core fn2-own) :pass)))
        (mv '(:fail :control-target-take) fn2-core fn2-sim fn2-own))
       (before-now (fn2-sim-now fn2-sim))
       (before-real (fn2-sim-real fn2-sim))
       ((mv status fn2-core fn2-sim fn2-own) (fn2-fault-control-step fault fn2-core fn2-sim fn2-own))
       ((unless (and (eq status :pass) (equal (fn2-sim-hitsi fault fn2-sim) 1)))
        (mv (if (eq status :pass) '(:fail :control-fault-not-selected) status) fn2-core fn2-sim fn2-own))
       ((unless (fn2-fault-control-effect fault op slot gen before-now before-real fn2-core fn2-sim))
        (progn$ (cw "PHYSICAL CONTROL class=~x0 count=~x1 outcome=~x2 reason=~x3 active=~x4~%"
                    fault (fn2-sim-terminal-count op fn2-sim) (fn2-sim-terminal-outcome op fn2-sim)
                    (fn2-sim-terminal-reason op fn2-sim) (fn2-sim-active op fn2-sim))
                (mv '(:fail :control-no-physical-effect) fn2-core fn2-sim fn2-own)))
       (saved-count (fn2-sim-terminal-count op fn2-sim))
       ((mv reused fn2-core fn2-own)
        (if (equal fault 25) (fn2-fault-control-reuse slot gen fn2-core fn2-own)
          (mv t fn2-core fn2-own)))
       ((unless reused) (mv '(:fail :release-reuse) fn2-core fn2-sim fn2-own))
       ; The late terminal must use its saved payload after range reuse;
       ; reading the old range now would violate both generation and bytes.
       ((mv status fn2-core fn2-sim fn2-own)
        (if (equal fault 25)
            (fn2-fault-control-late-terminal op saved-count fn2-core fn2-sim fn2-own)
          (fn2-fault-control-step 26 fn2-core fn2-sim fn2-own))))
    (mv status fn2-core fn2-sim fn2-own)))
(in-theory (disable fn2-fault-control-one))

(defun fn2-fault-control-loop (left fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix left)
                  :hints (("Goal" :in-theory nil
                           :use ((:instance fn2-test-countdown (x left))
                                 (:instance fn2-test-count-op (x left)))))))
  (if (zp left) (mv :pass fn2-core fn2-sim fn2-own)
    (mv-let (status fn2-core fn2-sim fn2-own)
      (fn2-fault-control-one (- left 1) fn2-core fn2-sim fn2-own)
      (if (eq status :pass) (fn2-fault-control-loop (- left 1) fn2-core fn2-sim fn2-own)
        (progn$ (cw "FAULT CONTROL FAILURE class=~x0 status=~x1 digest=~x2~%"
                    (- left 1) status (fn2-sim-digest fn2-sim))
                (mv status fn2-core fn2-sim fn2-own))))))
(in-theory (disable fn2-fault-control-loop))
(defun fn2-sim-fault-controls ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (status fn2-core)
      (with-local-stobj fn2-sim
        (mv-let (status fn2-core fn2-sim)
          (with-local-stobj fn2-own
            (mv-let (status fn2-core fn2-sim fn2-own)
              (fn2-fault-control-loop 26 fn2-core fn2-sim fn2-own)
              (mv status fn2-core fn2-sim)))
          (mv status fn2-core)))
      (progn$ (cw "FAULT CONTROLS: 26 matched-operation physical-effect checks, OWN=~x0~%" status) status))))
(in-theory (disable fn2-sim-fault-controls))

(defun fn2-recovery-control-cuts (left fn2-core fn2-sim fn2-own fn2-recovery-image)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own fn2-recovery-image)
                  :verify-guards nil :measure (nfix left)
                  :hints (("Goal" :in-theory nil
                           :use ((:instance fn2-test-countdown (x left))
                                 (:instance fn2-test-count-op (x left)))))))
  (if (zp left) (mv :pass fn2-core fn2-sim fn2-own fn2-recovery-image)
    (b* (((mv code next bad damaged never fn2-core fn2-sim fn2-own fn2-recovery-image)
          (fn2-sim-recovery-step 0 4 0 nil nil 0 *fn2-profile-tiny*
                                 fn2-core fn2-sim fn2-own fn2-recovery-image))
         ((unless (and (eq code :ok) (equal next 1)
                        (eq (fn2-check-own fn2-core fn2-own) :pass)))
          (mv '(:fail :recovery-first-sector) fn2-core fn2-sim fn2-own fn2-recovery-image))
         (before (fn2-sim-deaths fn2-sim))
         (fn2-sim (fn2-sim-force-fault 15 fn2-sim))
         ((mv code next bad damaged never fn2-core fn2-sim fn2-own fn2-recovery-image)
          (fn2-sim-recovery-step next 4 0 bad damaged never *fn2-profile-tiny*
                                 fn2-core fn2-sim fn2-own fn2-recovery-image))
         (- bad damaged never)
         ((unless (and (eq code :dead) (equal next 0)
                        (equal (fn2-sim-deaths fn2-sim) (+ 1 before))
                        (eq (fn2-check-own fn2-core fn2-own) :pass)))
          (mv '(:fail :recovery-death-restart) fn2-core fn2-sim fn2-own fn2-recovery-image)))
      (fn2-recovery-control-cuts (- left 1) fn2-core fn2-sim fn2-own fn2-recovery-image))))
(in-theory (disable fn2-recovery-control-cuts))

(defun fn2-recovery-control-run (fn2-core fn2-sim fn2-own fn2-recovery-image)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own fn2-recovery-image) :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
       (fn2-sim (fn2-sim-init 0 :broad *fn2-scenario-revision* *fn2-profile-tiny* fn2-sim))

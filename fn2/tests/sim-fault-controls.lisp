(defun fn2-fault-control-effect (fault op slot gen before-now before-real fn2-core fn2-sim)
  (declare (xargs :stobjs (fn2-core fn2-sim) :verify-guards nil))
  (b* ((active (fn2-sim-active op fn2-sim))
       (due (fn2-sim-due op fn2-sim))
       (now (fn2-sim-now fn2-sim))
       (real (fn2-sim-real fn2-sim))
       (deaths (fn2-sim-deaths fn2-sim))
       (count (fn2-sim-terminal-count op fn2-sim))
       (outcome (fn2-sim-terminal-outcome op fn2-sim))
       (reason (fn2-sim-terminal-reason op fn2-sim))
       ((mv read-code byte) (fn2-core-read slot gen 0 1 0 1 fn2-core))
       (stray (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
                (n) (fn2-ops-stray fn2-ops) n)))
    (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim))
                (fn2-sim-network (fn2-sim-net fn2-sim)))
      (ok)
      (case fault
        (0 (and (< 0 count) (< count 32)))
        (1 (and (< count 32) (equal (fn2-sim-network-tx-count 0 fn2-sim-network) count)))
        (2 (and (= active 1)
                (= due (+ 100 now))))
        (3 (and (= (fn2-sim-network-reset-armed 0 fn2-sim-network) 1)
                (= (fn2-sim-network-phase 0 fn2-sim-network) *fn2-network-phase-reset*)
                (= (fn2-sim-network-reset-left 0 fn2-sim-network) 0)
                (< count 32)))
        (4 (and (= (fn2-sim-network-half-open 0 fn2-sim-network) 1)
                (= active 1) (not (eq read-code :ok))
                (= (fn2-sim-network-rx-count 0 fn2-sim-network) 0)))
        (5 (and (= (fn2-sim-network-nonreading 0 fn2-sim-network) 1)
                (= active 1)
                (= (fn2-sim-network-tx-count 0 fn2-sim-network)
                   (fn2-sim-network-cap 0 fn2-sim-network))))
        ((6 23) (and (= outcome *fn2-outcome-failed*) (= reason *fn2-reason-io*) (= count 0)))
        ((7 11) (fn2-fault-control-disk-effects (fn2-sim-storage-rows fn2-sim-storage) fault fn2-sim-storage))
        (8 (and (eq read-code :ok) (= byte 0) (= count 32)))

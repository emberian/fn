                 (member-equal (- due now) '(1000 10000 100000))))
        (15 (and (= deaths 1) (= active 0)))
        (16 (>= now (+ 1000000 before-now)))
        (17 (and (< real before-real) (>= now before-now)))
        ((18 19 20 21 22) (= stray 1))

; Loaded after sim-layer-a.lisp. Each named fault is forced with a matching
; operation, so a swarm's aggregate choices are not mistaken for effects.
(in-package "ACL2")

; S1 regressions use B1's repro steps, with expected repaired outcomes.
(defun fn2-storage-live-tear-control ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-sim-storage
    (mv-let (ok fn2-sim-storage)
      (b* ((fn2-sim-storage (fn2-storage-init 1 1 fn2-sim-storage))
           ((mv c1 fn2-sim-storage) (fn2-storage-write-byte 0 0 17 1 nil nil fn2-sim-storage))
           ((mv c2 fn2-sim-storage) (fn2-storage-fence-capture 0 fn2-sim-storage))
           (fn2-sim-storage (fn2-storage-crash-unit 0 3 93 fn2-sim-storage))
           (torn (and (= (fn2-sim-storage-durable 0 fn2-sim-storage) 93)
                      (= (fn2-sim-storage-durable-stamp 0 fn2-sim-storage) 0)
                      (fn2-storage-unit-pendingp 0 fn2-sim-storage)))
           ((mv c3 fn2-sim-storage) (fn2-storage-fence-complete 0 nil nil fn2-sim-storage)))
        (mv (and (eq c1 :ok) (eq c2 :ok) torn (eq c3 :ok)
                 (= (fn2-sim-storage-durable 0 fn2-sim-storage) 17)
                 (= (fn2-sim-storage-durable-stamp 0 fn2-sim-storage) 1)
                 (not (fn2-storage-unit-pendingp 0 fn2-sim-storage))) fn2-sim-storage))
      ok)))

(defun fn2-storage-stale-cache-control (choice mixed)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-sim-storage
    (mv-let (ok fn2-sim-storage)
      (b* ((fn2-sim-storage (fn2-storage-init 1 2 fn2-sim-storage))
           ((mv c1 fn2-sim-storage) (fn2-storage-write-byte 0 0 17 1 nil nil fn2-sim-storage))
           ((mv c2 fn2-sim-storage) (fn2-storage-fence-capture 0 fn2-sim-storage))
           ((mv c3 fn2-sim-storage) (fn2-storage-fence-capture 1 fn2-sim-storage))
           ((mv c4 fn2-sim-storage) (fn2-storage-fence-complete 1 t nil fn2-sim-storage))
           (fn2-sim-storage (fn2-storage-reopen t fn2-sim-storage))
           ((mv c5 fn2-sim-storage) (fn2-storage-fence-complete 0 nil nil fn2-sim-storage))
           (stale (and (= (fn2-sim-storage-pending 0 fn2-sim-storage) 0)
                       (= (fn2-sim-storage-stamp 0 fn2-sim-storage) 0)
                       (= (fn2-sim-storage-durable 0 fn2-sim-storage) 17)
                       (= (fn2-sim-storage-durable-stamp 0 fn2-sim-storage) 1)
                       (not (fn2-storage-unit-pendingp 0 fn2-sim-storage))))
           ; A genuinely dirty neighbour must not let stale byte 0 roll back.
           ((mv c6 fn2-sim-storage)
            (if mixed (fn2-storage-write-byte 1 1 29 2 nil nil fn2-sim-storage)
              (mv :ok fn2-sim-storage)))
           (fn2-sim-storage (fn2-storage-crash-unit 0 choice 93 fn2-sim-storage))
           (fn2-sim-storage (fn2-storage-crash-reset fn2-sim-storage)))
        (mv (and stale (eq c1 :ok) (eq c2 :ok) (eq c3 :ok)
                 (eq c4 :io) (eq c5 :ok) (eq c6 :ok)
                 (= (fn2-sim-storage-durable 0 fn2-sim-storage) 17)
                 (= (fn2-sim-storage-pending 0 fn2-sim-storage) 17)
                 (= (fn2-sim-storage-durable-stamp 0 fn2-sim-storage) 1)
                 (or (not mixed)
                     (= (fn2-sim-storage-durable 1 fn2-sim-storage)
                        (case choice (1 29) (2 0) (otherwise 93))))) fn2-sim-storage))
      ok)))

(defun fn2-storage-fence-slots-control ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-sim-storage
    (mv-let (ok fn2-sim-storage)
      (b* ((slots (fn2-profile-fence-slots *fn2-profile-tiny*))
           (fn2-sim-storage (fn2-storage-init 1 slots fn2-sim-storage))
           (sized (and (= slots 1) (< slots (fn2-profile-o *fn2-profile-tiny*))
                       (= (fn2-storage-snapshot-length fn2-sim-storage) 4096)
                       (= (fn2-storage-snapshot-stamp-length fn2-sim-storage) 4096)))
           ((mv w1 fn2-sim-storage) (fn2-storage-write-byte 0 0 17 1 nil nil fn2-sim-storage))
           ((mv c1 fn2-sim-storage) (fn2-storage-fence-capture 7 fn2-sim-storage))
           ((mv w2 fn2-sim-storage) (fn2-storage-write-byte 0 0 29 2 nil nil fn2-sim-storage))
           ((mv c2 fn2-sim-storage) (fn2-storage-fence-capture 6 fn2-sim-storage))
           ((mv c3 fn2-sim-storage) (fn2-storage-fence-complete 7 nil nil fn2-sim-storage))
           (preserved (= (fn2-sim-storage-durable 0 fn2-sim-storage) 17))
           ((mv c4 fn2-sim-storage) (fn2-storage-fence-capture 6 fn2-sim-storage))
           ((mv c5 fn2-sim-storage) (fn2-storage-fence-complete 6 t nil fn2-sim-storage))
           ((mv c6 fn2-sim-storage) (fn2-storage-fence-capture 5 fn2-sim-storage))
           ((mv c7 fn2-sim-storage) (fn2-storage-fence-complete 5 nil t fn2-sim-storage))
           ((mv c8 fn2-sim-storage) (fn2-storage-fence-capture 4 fn2-sim-storage))
           (fn2-sim-storage (fn2-storage-crash-reset fn2-sim-storage))
           ((mv c9 fn2-sim-storage) (fn2-storage-fence-complete 4 nil nil fn2-sim-storage))
           ((mv c10 fn2-sim-storage) (fn2-storage-fence-capture 3 fn2-sim-storage))
           (fn2-sim-storage (fn2-storage-init 1 slots fn2-sim-storage))
           ((mv c11 fn2-sim-storage) (fn2-storage-fence-capture 2 fn2-sim-storage)))
        (mv (and sized preserved (eq w1 :ok) (eq w2 :ok)
                 (eq c1 :ok) (eq c2 :exhausted) (eq c3 :ok) (eq c4 :ok)
                 (eq c5 :io) (eq c6 :ok) (eq c7 :ok) (eq c8 :ok)
                 (eq c9 :bounds) (eq c10 :ok) (eq c11 :ok)) fn2-sim-storage))
      ok)))

(defun fn2-storage-reverse-fences-control ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-sim-storage
    (mv-let (ok fn2-sim-storage)
      (b* ((fn2-sim-storage (fn2-storage-init 1 2 fn2-sim-storage))
           ((mv w1 fn2-sim-storage) (fn2-storage-write-byte 0 0 17 1 nil nil fn2-sim-storage))
           ((mv c1 fn2-sim-storage) (fn2-storage-fence-capture 7 fn2-sim-storage))
           ((mv w2 fn2-sim-storage) (fn2-storage-write-byte 0 0 29 2 nil nil fn2-sim-storage))
           ((mv c2 fn2-sim-storage) (fn2-storage-fence-capture 6 fn2-sim-storage))
           ((mv c3 fn2-sim-storage) (fn2-storage-fence-complete 6 nil nil fn2-sim-storage))
           ((mv c4 fn2-sim-storage) (fn2-storage-fence-complete 7 nil nil fn2-sim-storage)))
        (mv (and (eq w1 :ok) (eq w2 :ok) (eq c1 :ok) (eq c2 :ok) (eq c3 :ok) (eq c4 :ok)
                 (= (fn2-sim-storage-durable 0 fn2-sim-storage) 29)
                 (= (fn2-sim-storage-durable-stamp 0 fn2-sim-storage) 2)) fn2-sim-storage))

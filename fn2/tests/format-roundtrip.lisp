; Run from root: FN_ACL2_SLOT_DIR="$PWD/build/fn2-b-acl2-slots" FN_ACL2_SLOTS=4 timeout -k 5 1800 tools/acl2 < fn2/tests/format-roundtrip.lsp > build/b2c-roundtrip.log 2>&1 & echo $! > build/b2c-roundtrip.pid
(in-package "ACL2")
(include-book "format-unit")
(include-book "layout-unit")
(include-book "../sim/prng")
(in-theory (disable fn2-layout-test-read fn2-layout-test-values fn2-layout-test-put
                    fn2-layout-test-init))
; List values are test oracles only; the measured path uses the pool/fields.
(defund fn2-format-test-bytes (n seed)
  (declare (xargs :verify-guards nil :measure (nfix n)))
  (if (zp n) nil
    (cons (mod (+ seed (* n 73)) 256) (fn2-format-test-bytes (- n 1) seed))))
(defund fn2-format-test-values (layout mode s0 s1 s2 s3)
  (declare (xargs :verify-guards nil))
  (if (atom layout) nil
    (mv-let (word s0 s1 s2 s3) (fn2-prng-next s0 s1 s2 s3)
      (let* ((k (cadar layout))
             (limit (cond ((eq k :u8) 255) ((eq k :u32) 4294967295)
                          ((and (consp k) (eq (car k) :enum)) (- (len (caddr k)) 1))
                          (t 1152921504606846975)))
             (number (cond ((eq mode :min) 0) ((eq mode :max) limit)
                           ((= (mod word 8) 0) 0) ((= (mod word 8) 1) (min 127 limit))
                           ((= (mod word 8) 2) (min 128 limit))
                           ((= (mod word 8) 3) limit)
                           (t (mod (+ word (* (mod s0 268435456) 4294967296)) (+ 1 limit)))))
             (value (cond ((eq k :digest) (cons 1 (fn2-format-test-bytes 32 word)))
                          ((and (consp k) (eq (car k) :octets))
                           (fn2-format-test-bytes
                            (cond ((eq mode :min) 0) ((eq mode :max) (cadr k))
                                  (t (mod word (+ 1 (cadr k))))) s0))
                          (t number))))
        (cons value (fn2-format-test-values (cdr layout) mode s0 s1 s2 s3))))))
(defund fn2-format-test-one (layout values fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (b* (((mv fn2-fields fn2-pool) (fn2-layout-test-put layout values 0 0 fn2-fields fn2-pool))
       ((mv code end fn2-pool) (fn2-layout-encode layout 0 1 0 1 0 1 fn2-fields fn2-pool))
       ((unless (and (eq code :ok)
                     (equal (fn2-layout-test-read end 0 0 fn2-pool)
                            (fn2-layout-octets layout values))))
        (mv (list :encode code end) end fn2-fields fn2-pool))
       ((mv code next fn2-fields) (fn2-layout-decode layout 0 1 0 end 1 0 1 fn2-fields fn2-pool))
       ((unless (and (eq code :ok) (= next end)
                     (equal values (fn2-layout-test-values layout 0 fn2-fields fn2-pool))))
        (mv (list :decode code next end) end fn2-fields fn2-pool)))
    (mv t end fn2-fields fn2-pool)))
(defund fn2-format-test-cases (n layout total fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil :measure (nfix n)))
  (if (zp n) (mv t total fn2-fields fn2-pool)
    (b* (((mv s0 s1 s2 s3) (fn2-prng-seed (+ 20261028 n)))
         (values (fn2-format-test-values layout :random s0 s1 s2 s3))
         ((mv ok size fn2-fields fn2-pool) (fn2-format-test-one layout values fn2-fields fn2-pool))
         ((unless (eq ok t)) (mv (list n ok) total fn2-fields fn2-pool)))
      (fn2-format-test-cases (- n 1) layout (+ size total) fn2-fields fn2-pool))))
(defund fn2-format-test-layouts (entries fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (if (atom entries) (mv t fn2-fields fn2-pool)
    (b* ((name (caar entries)) (layout (cadar entries))
         ((mv lo-ok lo fn2-fields fn2-pool)
          (fn2-format-test-one layout (fn2-format-test-values layout :min 1 2 3 4) fn2-fields fn2-pool))
         ((mv hi-ok hi fn2-fields fn2-pool)
          (fn2-format-test-one layout (fn2-format-test-values layout :max 1 2 3 4) fn2-fields fn2-pool))
         ((unless (and (eq lo-ok t) (eq hi-ok t) (= hi (fn2-layout-max-size layout))))
          (mv (list name :extremes lo-ok hi-ok hi) fn2-fields fn2-pool))
         ((mv ok total fn2-fields fn2-pool) (fn2-format-test-cases 1000 layout 0 fn2-fields fn2-pool))
         ((unless (eq ok t)) (mv (list name ok) fn2-fields fn2-pool))
         (- (cw "FORMAT SIZE ~x0: min=~x1 typical-mean-floor=~x2 max=~x3~%"
                name lo (floor total 1000) hi)))
      (fn2-format-test-layouts (cdr entries) fn2-fields fn2-pool))))
(defund fn2-format-test-message-ids (lengths fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (if (atom lengths) (mv t fn2-fields fn2-pool)
    (b* ((layout *fn2-format-article-acceptance*)
         (values (update-nth 1 (fn2-format-test-bytes (car lengths) 37)
                            (fn2-format-test-values layout :random 1 2 3 4)))
         ((mv ok size fn2-fields fn2-pool) (fn2-format-test-one layout values fn2-fields fn2-pool))
         (- size)
         ((unless (eq ok t)) (mv (list :message-id (car lengths) ok) fn2-fields fn2-pool)))
      (fn2-format-test-message-ids (cdr lengths) fn2-fields fn2-pool))))
; Alternating output slots keeps decoded digest/octet references non-overlapping.
(defund fn2-format-audit-loop (n fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :measure (nfix n)
                  :guard (and (natp n) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))))
  (if (zp n) (mv t fn2-fields fn2-pool)
    (b* ((slot (mod n 2))
         ((mv code end fn2-pool)
          (fn2-layout-encode *fn2-format-article-acceptance* slot 1 0 1 0 1 fn2-fields fn2-pool))
         ((unless (eq code :ok)) (mv nil fn2-fields fn2-pool))
         ((mv code next fn2-fields)
          (fn2-layout-decode *fn2-format-article-acceptance* slot 1 0 end 1 0 1 fn2-fields fn2-pool))
         ((unless (and (eq code :ok) (equal next end))) (mv nil fn2-fields fn2-pool)))
      (fn2-format-audit-loop (- n 1) fn2-fields fn2-pool))))
(defund fn2-format-test-run (fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (b* (((mv fn2-fields fn2-pool) (fn2-layout-test-init fn2-fields fn2-pool))
       (fn2-fields (fn2-fields-init 128 fn2-fields))
       ((mv ok fn2-fields fn2-pool) (fn2-format-test-layouts *fn2-format-layouts* fn2-fields fn2-pool))
       ((unless (eq ok t)) (mv ok fn2-fields fn2-pool))
       ((mv ok fn2-fields fn2-pool)
        (fn2-format-test-message-ids (list 1 250 *fn2-format-message-id-max*) fn2-fields fn2-pool))
       ((unless (eq ok t)) (mv ok fn2-fields fn2-pool))
       (layout *fn2-format-article-acceptance*)
       (values (update-nth 1 (fn2-format-test-bytes (+ 1 *fn2-format-message-id-max*) 37)
                          (fn2-format-test-values layout :max 1 2 3 4)))
       ((mv fn2-fields fn2-pool) (fn2-layout-test-put layout values 0 0 fn2-fields fn2-pool))
       ((mv code end fn2-pool) (fn2-layout-encode layout 0 1 0 1 0 1 fn2-fields fn2-pool))
       (- end)
       ((unless (eq code :length)) (mv (list :message-id-overflow code) fn2-fields fn2-pool))
       ; Decoder refusal as well as encoder refusal: oracle emits the oversized length.
       (bytes (fn2-layout-octets layout values))
       (fn2-pool (fn2-layout-test-write bytes 0 0 fn2-pool))
       ((mv code next fn2-fields) (fn2-layout-decode layout 0 1 0 (len bytes) 1 0 1 fn2-fields fn2-pool))
       (- next)
       ((unless (eq code :length)) (mv (list :message-id-decode-overflow code) fn2-fields fn2-pool))
       ((mv fn2-fields fn2-pool)
        (fn2-layout-test-put layout (fn2-format-test-values layout :max 1 2 3 4) 0 0 fn2-fields fn2-pool))
       ((mv ok fn2-fields fn2-pool) (fn2-format-audit-loop 100 fn2-fields fn2-pool))
       ((unless ok) (mv :warmup fn2-fields fn2-pool))
       ((mv ok fn2-fields fn2-pool)
        (time$ (fn2-format-audit-loop 10000 fn2-fields fn2-pool)
               :msg "FORMAT HOT LOOP: 10000 article-acceptance cycles, ~sa bytes, ~st seconds~%"))
       (- (and ok (cw "FORMAT ROUNDTRIP: 37 layouts x 1000 assignments; min/max endpoints; Message-ID 1,250,250 exact; 251 encode/decode :length; PASS~%"))))
    (mv ok fn2-fields fn2-pool)))
(defund fn2-format-test-all ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-fields
    (mv-let (ok fn2-fields)
      (with-local-stobj fn2-pool
        (mv-let (ok fn2-fields fn2-pool) (fn2-format-test-run fn2-fields fn2-pool)
          (mv ok fn2-fields)))
      ok)))
(assert-event (eq (symbol-class 'fn2-format-audit-loop (w state)) :common-lisp-compliant))

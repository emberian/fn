(in-package "ACL2")
(set-prover-step-limit 300000)
(set-cbd "fn2/tests/")
(ld "sim-layer-a.lisp" :ld-error-action :continue)
(ld "sim-fault-controls.lisp" :ld-error-action :continue)
(ld "sim-replay-controls.lisp" :ld-error-action :continue)
(set-guard-checking nil)
(assert-event (eq (fn2-scenario-controls) :pass))
(assert-event (eq (fn2-sim-fault-controls) :pass))
(assert-event (eq (fn2-sim-recovery-controls) :pass))
(assert-event (fn2-sim-replay-control))
(assert-event
 (mv-let (passes failure)
   (time$ (fn2-sim-run-pool-scenarios 0 10000 *fn2-profile-tiny*)
          :msg "POOL TIMING tiny: 10000 runs, ~st seconds wall, ~sa bytes~%")
   (and (equal passes 10000) (null failure))))
(assert-event
 (mv-let (passes failure)
   (time$ (fn2-sim-run-pool-scenarios 0 1000 *fn2-profile-tiny-near-limit*)
          :msg "POOL TIMING tiny-near-limit: 1000 runs, ~st seconds wall, ~sa bytes~%")
   (and (equal passes 1000) (null failure))))
(good-bye)

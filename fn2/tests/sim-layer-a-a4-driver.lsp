(in-package "ACL2")
:q
(handler-case
    (progn
      (defparameter *fn2-swarm-seed*
        (when (or (sb-ext:posix-getenv "FN2_SWARM") (sb-ext:posix-getenv "FN2_SWARM_SEED"))
          (mod (if (sb-ext:posix-getenv "FN2_SWARM_SEED")
                   (parse-integer (sb-ext:posix-getenv "FN2_SWARM_SEED") :junk-allowed nil)
                 (logxor (get-universal-time) (get-internal-real-time))) (expt 2 32))))
      (format t "A4 MODE=~A SEED=~D~%" (if *fn2-swarm-seed* :swarm :fixed) (or *fn2-swarm-seed* 20261028))
      (finish-output)
      ; Generate this run's revision before any scenario is loaded.
      (let ((process (sb-ext:run-program "python3" '("fn2/tests/scenario-revision.py")
                       :search t :output "build/scenario-revision.lsp"
                       :if-output-exists :supersede :error *error-output*)))
        (assert (eql (sb-ext:process-exit-code process) 0)))
      ; LD needs LP's loading context; ACL2 errors are returned as values.
      (multiple-value-bind (erp value state)
          (let ((*features* (adjoin :acl2-loop-only *features*)))
            (with-suppression
              (ld '((set-prover-step-limit 300000)
                    (set-cbd "fn2/tests/")
                    (ld "sim-layer-a.lisp" :ld-error-action :error)
                    (ld "sim-fault-controls.lisp" :ld-error-action :error)
                    (ld "sim-replay-controls.lisp" :ld-error-action :error)
                    (ld "sim-device-broad.lisp" :ld-error-action :error)
                    (set-guard-checking nil)) :ld-error-action :error)))
        (declare (ignore state))
        (assert (and (not erp) (eq value :eof))))
      (load "fn2/tests/turn-meter.lsp")
      (load "fn2/tests/own-read-hook.lsp")
      (load "fn2/tests/liveness-controls.lsp")
      (load "fn2/tests/q1-case-hook.lsp")
      (fn2-own-hook-install)
      (fn2-q1-hook-install)
      (unwind-protect
        (progn
      (fn2-own-hook-control)
      (assert (fn2-client-oracle-control))
      (dolist (case '(:process-death :reset :half-open-deadline :nonreading-deadline
                      :client-disconnect :admission-refused :unattributed :at-bound :over-bound))
        (assert (fn2-echo-evidence-control case)))
      (format t "ECHO EVIDENCE CONTROLS: seven drop causes and both turn-bound edges PASS~%")
      (fn2-l1-controls)
      ; Row capacity is reserved by the listener before issuing Accept.
      ; Capacity premises for the C.3 service bound: no resource parking,
      ; and at most three observations per turn in the liveness environment.
      (assert (> (fn2-profile-h *fn2-echo-profile*) 3))
      (assert (>= (min (fn2-profile-o *fn2-echo-profile*) (fn2-profile-qa *fn2-echo-profile*))
                  (+ (* 2 (fn2-profile-c *fn2-echo-profile*))
                     (fn2-profile-accept-credits *fn2-echo-profile*) 1)))
      (let* ((profile (put-assoc-equal :c 1 (put-assoc-equal :accept-credits 1 *fn2-profile-tiny*)))
             (result (fn2-sim-run-echo 20261028 1 profile)) (live (nth 9 result)))
        (assert (fn2-core-profilep profile))
        (assert (> (fn2-profile-h profile) 3))
        (assert (>= (min (fn2-profile-o profile) (fn2-profile-qa profile))
                    (+ (* 2 (fn2-profile-c profile)) (fn2-profile-accept-credits profile) 1)))
        (assert (eq (first result) :pass))
        (assert (eq (first live) :pass))
        (assert (= (second live) (third live) 200))
        (assert (zerop (fourth live)))
        (format t "L1 REGRESSION seed=20261028 C=1 accept-credits=1 QA=4 safety=~S live=~S PASS~%"
                (subseq result 0 6) (subseq live 0 6)))
      (assert (eq (fn2-scenario-controls) :pass))
      (assert (eq (fn2-sim-fault-controls) :pass))
      (assert (eq (fn2-sim-recovery-controls) :pass))
      (assert (fn2-sim-replay-control))
      (if *fn2-swarm-seed*
          (progn
            (multiple-value-bind (passes failure)
                (fn2-sim-run-pool-scenarios *fn2-swarm-seed* 100 *fn2-profile-tiny*)
              (assert (and (= passes 100) (null failure))))
            (multiple-value-bind (passes failure)
                (fn2-sim-run-pool-scenarios *fn2-swarm-seed* 20 *fn2-profile-tiny-near-limit*)
              (assert (and (= passes 20) (null failure))))
            (let ((result (fn2-sim-run-echo *fn2-swarm-seed* 20 *fn2-echo-profile*)))
              (assert (eq (car result) :pass))
              (assert (= (+ (third result) (fourth result)) 20))
              (format t "SWARM seed=~D pools=120 echo=~S PASS~%" *fn2-swarm-seed* (subseq result 0 6))))
        (progn
      (multiple-value-bind (passes failure)
          (fn2-sim-run-pool-scenarios 0 10000 *fn2-profile-tiny*)
        (assert (and (= passes 10000) (null failure))))
      (multiple-value-bind (passes failure)
          (fn2-sim-run-pool-scenarios 0 1000 *fn2-profile-tiny-near-limit*)
        (assert (and (= passes 1000) (null failure))))
      (fn2-own-hook-reset)
      (assert (eq (car (fn2-sim-run-scribe)) :pass))
      (fn2-own-hook-report "SCRIBE" t)
      (fn2-own-hook-reset)
      (defparameter *fn2-device-landings* (fn2-sim-run-device-broad 20261028 16384))
      (assert (eq (car *fn2-device-landings*) :pass))
      (fn2-q1-hook-restore)
      (fn2-q1-hook-write "fn2/tests/evidence/q1-a4-tally.lisp" "fn2/tests/sim-layer-a-a4-driver.lsp"
                         "A4 fixed gate, every TRACE turn before the metered echo run: echo evidence controls, L1 controls and regression, scenario, fault, recovery and replay controls, scribe scenario, device broad"
                         '(:echo-concrete :tiny :scribe-tiny-4k))
      (fn2-meter-install)
      (unwind-protect
          (progn
            (fn2-meter-control)
            (let ((result (fn2-sim-run-echo 20261028 1000 *fn2-echo-profile*)))
              (assert (eq (car result) :pass))
              (assert (= (length (nth 8 result)) *fn2-fault-count*))
              (let ((landings (fn2-echo-merge-stats (second *fn2-device-landings*) (nth 8 result))))
                (format t "BROAD APPLIED echo+device=~S~%" landings)
                (assert (= (length landings) *fn2-fault-count*))
                (assert (every (lambda (entry) (>= (cdr entry) 1)) landings)))
              (assert (= (second result) 1000))
              (assert (= *fn2-meter-calls* (+ (sixth result) (sixth (nth 9 result)))))
              (assert (= (+ (third result) (fourth result)) 1000))
              (assert (= (second result) (+ (third result) (fourth result))))
              (let ((causes (fn2-echo-histogram *fn2-echo-drop-causes* (nth 7 result)))
                    (live (nth 9 result)))
                (assert (zerop (cdr (assoc :unattributed causes))))
                (assert (= (reduce #'+ causes :key #'cdr) (fourth result)))
                (assert (eq (first live) :pass))
                (assert (= (second live) (third live) 200))
                (assert (zerop (fourth live)))
                (assert (<= (fn2-echo-stat :max-age (nth 6 live))
                            (fn2-echo-stat :max-bound (nth 6 live))))))
            (fn2-meter-report "ECHO TURN CPU profile=CONCRETE-TRACE adapter-faults=BROAD own-hook=ON"))
        (fn2-meter-restore))))
      (fn2-own-hook-report "ECHO+LIVENESS" t))
        (fn2-q1-hook-restore)
        (fn2-own-hook-restore))
      (sb-ext:exit :code 0))
  (cl:error (condition)
    (format *error-output* "ECHO MEASUREMENT FAILED: ~A~%" condition)
    (sb-ext:exit :code 1)))

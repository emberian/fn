(in-package "ACL2")
(include-book "../sim/check-own")
(include-book "std/util/bstar" :dir :system)

; Deliberate mutations are controls: each monitor must reject the defect it
; claims to observe, while the unmodified state must pass the same predicate.
(defun fn2-own-unit-run (fn2-pool fn2-ops fn2-own)
  (declare (xargs :stobjs (fn2-pool fn2-ops fn2-own) :verify-guards nil))
  (b* ((fn2-pool (fn2-pool-init '((2 . 64)) 1 100 fn2-pool))
       (fn2-ops (fn2-ops-init *fn2-profile-tiny* fn2-ops))
       (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
       ((mv code slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
       ((unless (eq code :ok)) (mv :reserve fn2-pool fn2-ops fn2-own))
       ((mv code fn2-pool) (fn2-pool-write slot gen 0 65 1 0 1 fn2-pool))
       ((unless (eq code :ok)) (mv :write fn2-pool fn2-ops fn2-own))
       ((mv code op og fn2-ops) (fn2-op-reserve *fn2-action-send* 1 0 1 0 1 fn2-ops))
       ((unless (eq code :ok)) (mv :op fn2-pool fn2-ops fn2-own))
       ((mv code fn2-ops) (fn2-op-set-range op og slot gen 0 1 fn2-ops))
       ((unless (eq code :ok)) (mv :range fn2-pool fn2-ops fn2-own))
       ((mv code fn2-pool) (fn2-pool-lease-out slot gen 0 1 1 0 1 fn2-pool))
       ((unless (eq code :ok)) (mv :lease fn2-pool fn2-ops fn2-own))
       ((mv code fn2-ops) (fn2-op-enqueue op og fn2-ops))
       ((unless (eq code :ok)) (mv :enqueue fn2-pool fn2-ops fn2-own))
       (fn2-own (fn2-own-observe-issue-parts op fn2-pool fn2-ops fn2-own))
       ((unless (eq (fn2-check-own-parts fn2-pool fn2-ops fn2-own) :pass))
        (mv :initial-own fn2-pool fn2-ops fn2-own))
       (fn2-own (fn2-own-observe-output-range-parts
                 op og slot gen 0 1 fn2-pool fn2-ops fn2-own))
       ((unless (eq (fn2-own-status fn2-own) :pass))
        (mv :saved-range-positive fn2-pool fn2-ops fn2-own))
       ; The current outstanding row is unchanged, but a broken adapter's
       ; saved descriptor now names another slot: checking only ops misses it.
       (fn2-own (fn2-own-observe-output-range-parts
                 op og (+ 1 slot) gen 0 1 fn2-pool fn2-ops fn2-own))
       ((unless (equal (fn2-own-status fn2-own) '(:fail :range-identity)))
        (mv :missed-saved-range fn2-pool fn2-ops fn2-own))
       (fn2-own (update-fn2-own-error 0 fn2-own))
       ; Two simultaneous queued outputs need two borrows, even though both
       ; ranges fit and each row alone appears plausible.
       ((mv code op2 og2 fn2-ops) (fn2-op-reserve *fn2-action-send* 1 0 1 0 0 fn2-ops))
       ((unless (eq code :ok)) (mv :second-op fn2-pool fn2-ops fn2-own))
       ((mv code fn2-ops) (fn2-op-set-range op2 og2 slot gen 0 1 fn2-ops))
       ((unless (eq code :ok)) (mv :second-range fn2-pool fn2-ops fn2-own))
       ((mv code fn2-pool) (fn2-pool-lease-out slot gen 0 1 1 0 1 fn2-pool))
       ((unless (eq code :ok)) (mv :second-lease fn2-pool fn2-ops fn2-own))
       ((mv code fn2-ops) (fn2-op-enqueue op2 og2 fn2-ops))
       ((unless (eq code :ok)) (mv :second-enqueue fn2-pool fn2-ops fn2-own))
       (fn2-own (fn2-own-observe-issue-parts op2 fn2-pool fn2-ops fn2-own))
       (fn2-pool (fn2-pool-set-out-count slot 1 fn2-pool))
       ((unless (and (fn2-pool-semanticp fn2-pool)
                     (equal (fn2-check-own-parts fn2-pool fn2-ops fn2-own)
                            '(:fail :op-range-ownership))))
        (mv :missed-borrow-undercount fn2-pool fn2-ops fn2-own))
       (fn2-pool (fn2-pool-set-out-count slot 2 fn2-pool))
       (fn2-pool (fn2-pool-set-owner-slot slot 99 fn2-pool))
       ((unless (equal (fn2-check-own-parts fn2-pool fn2-ops fn2-own)
                       '(:fail :op-range-ownership)))
        (mv :missed-wrong-owner fn2-pool fn2-ops fn2-own))
       (fn2-pool (fn2-pool-set-owner-slot slot 0 fn2-pool))
       ; A queued descriptor's generation is checked before adapter take.
       (fn2-ops (fn2-ops-set-range-gen op (+ gen 1) fn2-ops))
       ((unless (equal (fn2-check-own-parts fn2-pool fn2-ops fn2-own) '(:fail :op-range-ownership)))
        (mv :missed-generation fn2-pool fn2-ops fn2-own))
       (fn2-ops (fn2-ops-set-range-gen op gen fn2-ops))
       ; Mutate after enqueue, before take; idempotent issue observation must
       ; retain the original digest rather than silently blessing the mutation.
       (fn2-pool (update-fn2-pool-datai (fn2-pool-base slot fn2-pool) 66 fn2-pool))
       (fn2-own (fn2-own-observe-issue-parts op fn2-pool fn2-ops fn2-own))
       (fn2-own (fn2-own-observe-output-parts op fn2-pool fn2-ops fn2-own))
       ((unless (equal (fn2-own-status fn2-own) '(:fail :output-mutated)))
        (mv :missed-mutation fn2-pool fn2-ops fn2-own))
       (fn2-pool (update-fn2-pool-datai (fn2-pool-base slot fn2-pool) 65 fn2-pool))
       (fn2-own (update-fn2-own-error 0 fn2-own))
       ((mv code fn2-ops fn2-own)
        (fn2-own-post-result 0 op og *fn2-event-send-result* *fn2-outcome-done* 0 1 0 0 t fn2-ops fn2-own))
       ((unless (and (eq code :ok) (= (fn2-ops-stray fn2-ops) 1)
                     (eq (fn2-own-status fn2-own) :pass)))
        (mv :queued-stray fn2-pool fn2-ops fn2-own))
       ; Flat snapshot detects a non-row mutation in unused ring storage.
       (words (fn2-own-ops-word-count fn2-ops))
       (fn2-own (fn2-own-copy-ops words fn2-ops fn2-own))
       (fn2-ops (update-fn2-ops-out-geni 3 19 fn2-ops))
       ((when (fn2-own-same-ops-p words fn2-ops fn2-own))
        (mv :missed-ring-mutation fn2-pool fn2-ops fn2-own))
       (fn2-ops (update-fn2-ops-out-geni 3 0 fn2-ops))
       ((mv code fn2-ops) (fn2-outbox-ack 1 fn2-ops))
       ((unless (eq code :ok)) (mv :ack fn2-pool fn2-ops fn2-own))
       ; Release-before-terminal no longer holds bytes, but the op remains
       ; submitted. OWN must accept that legitimate intermediate state.
       (fn2-ops (fn2-post-result 1 op og *fn2-event-borrow-released* 0 0 0 0 0 fn2-ops))
       ((mv found hops hgen cell fn2-ops) (fn2-harvest-next fn2-ops))
       ((unless (and found (= hops op) (= hgen og) (= cell 1)))
        (mv :release-event fn2-pool fn2-ops fn2-own))
       ((mv code fn2-pool) (fn2-pool-release-out slot gen fn2-pool))
       ((unless (and (eq code :ok)
                     (eq (fn2-check-own-parts fn2-pool fn2-ops fn2-own) :pass)))
        (mv :early-release-own fn2-pool fn2-ops fn2-own))
       ; Input checker starts with independent source byte 99, while a broken
       ; adapter writes 98. Exposing/reading it must fail after completion.
       ((mv code rx rg fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
       ((unless (eq code :ok)) (mv :rx-reserve fn2-pool fn2-ops fn2-own))
       ((mv code rop rog fn2-ops) (fn2-op-reserve *fn2-action-receive* 1 0 1 0 0 fn2-ops))
       ((unless (eq code :ok)) (mv :rx-op fn2-pool fn2-ops fn2-own))
       ((mv code off fn2-pool) (fn2-pool-lease-in rx rg 1 rop rog 1 0 1 fn2-pool))
       ((unless (eq code :ok)) (mv :rx-lease fn2-pool fn2-ops fn2-own))
       ((mv code fn2-ops) (fn2-op-set-range rop rog rx rg off 1 fn2-ops))
       ((unless (eq code :ok)) (mv :rx-range fn2-pool fn2-ops fn2-own))
       ((mv code fn2-ops) (fn2-op-enqueue rop rog fn2-ops))
       ((unless (eq code :ok)) (mv :rx-enqueue fn2-pool fn2-ops fn2-own))
       (fn2-own (fn2-own-observe-issue-parts rop fn2-pool fn2-ops fn2-own))
       (fn2-own (fn2-own-observe-read-parts rx rg off :ok 99 fn2-pool fn2-own))
       ((unless (equal (fn2-own-status fn2-own) '(:fail :unreadable-input)))
        (mv :missed-lent-read fn2-pool fn2-ops fn2-own))
       (fn2-own (update-fn2-own-error 0 fn2-own))
       (fn2-own (fn2-own-record-input-byte-parts rx rg off 99 fn2-pool fn2-own))
       ((mv code fn2-pool) (fn2-pool-adapter-write rx rg rop rog off 98 fn2-pool))
       ((unless (eq code :ok)) (mv :adapter-write fn2-pool fn2-ops fn2-own))
       ((mv code fn2-pool) (fn2-pool-complete-in rx rg rop rog 1 fn2-pool))
       ((unless (eq code :ok)) (mv :complete fn2-pool fn2-ops fn2-own))
       ((mv code byte) (fn2-pool-read rx rg off 1 0 1 fn2-pool))
       (fn2-own (fn2-own-observe-read-parts rx rg off code byte fn2-pool fn2-own))
       ((unless (equal (fn2-own-status fn2-own) '(:fail :input-byte-mismatch)))
        (mv :missed-input-byte fn2-pool fn2-ops fn2-own))
       ; A deliberate legal core overwrite supersedes input provenance.
       (fn2-own (update-fn2-own-error 0 fn2-own))
       ((mv code fn2-pool) (fn2-pool-write rx rg off 100 1 0 1 fn2-pool))
       (fn2-own (fn2-own-observe-core-write-parts rx rg off code 100 fn2-pool fn2-own))
       ((mv code byte) (fn2-pool-read rx rg off 1 0 1 fn2-pool))
       (fn2-own (fn2-own-observe-read-parts rx rg off code byte fn2-pool fn2-own))
       ((unless (and (equal byte 100) (eq (fn2-own-status fn2-own) :pass)))
        (mv :legal-overwrite fn2-pool fn2-ops fn2-own)))
    (mv :pass fn2-pool fn2-ops fn2-own)))
(defun fn2-own-unit ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-pool
    (mv-let (answer fn2-pool)
      (with-local-stobj fn2-ops
        (mv-let (answer fn2-pool fn2-ops)
          (with-local-stobj fn2-own
            (mv-let (answer fn2-pool fn2-ops fn2-own)
              (fn2-own-unit-run fn2-pool fn2-ops fn2-own)
              (mv answer fn2-pool fn2-ops)))
          (mv answer fn2-pool)))
      answer)))
(assert-event (equal (fn2-own-unit) :pass))

(in-package "ACL2")
(include-book "core-child-assembly")
(include-book "std/testing/must-fail" :dir :system)
(must-fail (defcorechild fn2-core-test-child fn2-test-child
            :init (fn2-test-child-init 1 fn2-test-child) :profilep t :why "duplicate"))
(must-fail (defcorechild bad fn2-test-child :init fn2-test-child :profilep t
            :reference :environment) :expected :hard)
(in-theory (enable fn2-core-wfp))
(defun fn2-test-child-step (id fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-test-child (fn2-core-test-child fn2-core)))
    (fn2-test-child)
    (if (and (natp id) (< id (fn2-test-child-rows fn2-test-child)))
        (fn2-test-child-set-value id 42 fn2-test-child) fn2-test-child)
    fn2-core))
(fn2-machine-core-shape fn2-test-child-step (id))
(in-theory (disable fn2-core-wfp))
(defun fn2-test-child-check (fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-test-child-profile* fn2-core))
       (initial (and (fn2-core-wfp fn2-core)
                  (stobj-let ((fn2-test-child (fn2-core-test-child fn2-core)))
                    (ok) (and (= (fn2-test-child-rows fn2-test-child)
                                  (fn2-profile-get :test-child-rows *fn2-test-child-profile*))
                              (= (fn2-test-child-value 0 fn2-test-child) 0)) ok)))
       (fn2-ref-core (fn2-ref-reset *fn2-test-child-profile* fn2-core fn2-ref-core))
       (same (not (fn2-ref-core-difference fn2-core fn2-ref-core)))
       ((mv bytes steps descriptors runnable fn2-core)
        (fn2-machine-run (fn2-machine-global-id *fn2-test-machine-kind* 0 *fn2-test-child-profile*)
                         4 fn2-core))
       (difference (fn2-ref-core-difference fn2-core fn2-ref-core)))
    (mv (and initial same (= bytes 0) (= steps 1) (= descriptors 0) (not runnable)
             (fn2-core-wfp fn2-core)
             (equal difference '(fn2-test-child-value$a 0 42 0))) fn2-core fn2-ref-core)))
(defun fn2-test-child-unit ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (ok fn2-core)
      (with-local-stobj fn2-ref-core
        (mv-let (ok fn2-core fn2-ref-core) (fn2-test-child-check fn2-core fn2-ref-core)
          (mv ok fn2-core))) ok)))
(assert-event (fn2-test-child-unit))

(assert-event (not (fn2-core-profilep *fn2-profile-tiny*)))
(assert-event (fn2-core-profilep *fn2-test-child-profile*))
(assert-event
 (not (fn2-core-profilep (put-assoc-equal :test-child-rows 4294967296 *fn2-test-child-profile*))))

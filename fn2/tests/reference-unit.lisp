; Executed teeth of the full refinement antecedent and conclusion.
(in-package "ACL2")
(include-book "../books/reference")
(include-book "core-unit")

(defun fn2-ref-test-turn (lists fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (b* ((hyps (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
                  (fn2-ref-corep fn2-ref-core) (fn2-core-wfp fn2-ref-core)
                  (fn2-representation-relation fn2-core fn2-ref-core lists)))
       (h (fn2-exec-h fn2-core)) (k (fn2-exec-k fn2-core)) (a (fn2-exec-aturn fn2-core))
       ((mv s o v d fn2-core) (fn2-turn fn2-core))
       ((mv rs ro rv rd lists fn2-ref-core) (fn2-ref-turn lists fn2-ref-core)))
    (mv hyps
        (and (equal (list s o v d) (list rs ro rv rd))
             (fn2-core-wfp fn2-core) (fn2-core-wfp fn2-ref-core)
             (fn2-representation-relation fn2-core fn2-ref-core lists)
             (<= d a)
             (<= (+ v (fn2-exec-turn-bytes fn2-core) (fn2-exec-turn-steps fn2-core) 1)
                 (+ (* h 24) (* k 4129) 1)))
        lists fn2-core fn2-ref-core)))
(in-theory (disable fn2-ref-test-turn))

(defun fn2-ref-test-run (mutate fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (b* ((profile (put-assoc-equal :pool-classes '((8 . 4096) (4 . 65536)) *fn2-profile-tiny*))
       (fn2-core (fn2-init-executor profile :echo t fn2-core))
       (fn2-ref-core (fn2-init-executor profile :echo t fn2-ref-core))
       (scribe (fn2-machine-global-id *fn2-scribe-kind* 0 profile))
       (lists (fn2-ref-lists '(1 1 1 1) 0 (list (list 0 0 1 scribe))))
       ((mv h0 c0 lists fn2-core fn2-ref-core) (fn2-ref-test-turn lists fn2-core fn2-ref-core))
       ; Two remaining runnable machines have different continuations.
       (queue (fn2-ref-queue 0 (nth 2 lists)))
       (lists (if mutate (update-nth 2 (fn2-ref-set-queue 0
                         (cons (cadr queue) (cons (car queue) (cddr queue))) (nth 2 lists)) lists) lists))
       (relation (fn2-representation-relation fn2-core fn2-ref-core lists))
       ((mv h1 c1 & fn2-core fn2-ref-core) (fn2-ref-test-turn lists fn2-core fn2-ref-core)))
    (mv (and h0 c0 (= (len queue) 2)
             (equal relation (not mutate))
             (equal h1 (not mutate)) (equal c1 (not mutate))) fn2-core fn2-ref-core)))
(defun fn2-ref-test (mutate)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (answer fn2-core)
      (with-local-stobj fn2-ref-core
        (mv-let (answer fn2-core fn2-ref-core) (fn2-ref-test-run mutate fn2-core fn2-ref-core)
          (mv answer fn2-core))) answer)))
(assert-event (fn2-ref-test nil))
(assert-event (fn2-ref-test t))
(assert-event (and (= (len (fn2-ref-calendar (make-list 64 :initial-element 1))) 80)
                   (= (len (fn2-ref-calendar '(1 1 1 1))) 8)
                   (equal (nth 16 (fn2-ref-calendar (make-list 64 :initial-element 1))) '(:service 0))
                   (equal (nth 79 (fn2-ref-calendar (make-list 64 :initial-element 1))) '(:service 3))
                   (equal (fn2-ref-calendar '(3 1 2 1))
                          '((:principal 0) (:principal 1) (:principal 2) (:principal 3)
                            (:principal 0) (:principal 2) (:principal 0)
                            (:service 0) (:service 1) (:service 2) (:service 3)))
                   (equal (fn2-ref-enqueue 2 0 '((0 1 2 3))) '((0 1 2 3)))))

;; S3: the weighted calendar in lockstep.  Slot 0 of weight 3 and slot 2 of weight 2 give the
;; eleven-entry calendar (0 1 2 3 0 2 0, the four services); concrete and reference take two turns
;; from it under the full relation.  Negative: reference lists built from the unweighted calendar
;; fail the relation on the first entry that differs; a permuted literal calendar (the right counts,
;; not the specified order) fails as :literal-calendar.
(defconst *fn2-ref-test-weighted-profile*
  (put-assoc-equal :accounts '((0 :state :anonymous :weight 3) (2 :state :configured :weight 2))
                   (put-assoc-equal :pool-classes '((8 . 4096) (4 . 65536)) *fn2-profile-tiny*)))
(defun fn2-ref-weighted-run (lists-weights permute fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (b* ((profile *fn2-ref-test-weighted-profile*)
       (fn2-core (fn2-init-executor profile :echo t fn2-core))
       (fn2-ref-core (fn2-init-executor profile :echo t fn2-ref-core))
       (scribe (fn2-machine-global-id *fn2-scribe-kind* 0 profile))
       (lists (fn2-ref-lists lists-weights 0 (list (list 0 0 1 scribe))))
       (lists (if permute
                  (update-nth 0 (cons (cadr (nth 0 lists)) (cons (car (nth 0 lists)) (cddr (nth 0 lists)))) lists)
                lists))
       (difference (fn2-ref-difference fn2-core fn2-ref-core lists))
       (calendar (stobj-let ((fn2-sched (fn2-core-sched fn2-core))) (codes)
                   (list (fn2-sched-calendar-length fn2-sched)
                         (fn2-sched-calendar-validp '(3 1 2 1) fn2-sched)
                         (fn2-sched-calendar-validp '(1 1 1 1) fn2-sched))
                   codes))
       ((mv h0 c0 lists fn2-core fn2-ref-core) (fn2-ref-test-turn lists fn2-core fn2-ref-core))
       ((mv h1 c1 & fn2-core fn2-ref-core) (fn2-ref-test-turn lists fn2-core fn2-ref-core)))
    (mv (list difference calendar (and h0 c0 h1 c1)) fn2-core fn2-ref-core)))
(defun fn2-ref-weighted (lists-weights permute)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (answer fn2-core)
      (with-local-stobj fn2-ref-core
        (mv-let (answer fn2-core fn2-ref-core) (fn2-ref-weighted-run lists-weights permute fn2-core fn2-ref-core)
          (mv answer fn2-core))) answer)))
(assert-event
 (and (equal (fn2-profile-weights *fn2-ref-test-weighted-profile*) '(3 1 2 1))
      (equal (fn2-profile-calendar-length *fn2-ref-test-weighted-profile*) 11)
      (equal (fn2-ref-weighted '(3 1 2 1) nil) '(nil (11 t nil) t))
      (equal (car (fn2-ref-weighted '(1 1 1 1) nil)) '(:calendar-length))
      (equal (car (fn2-ref-weighted '(3 1 2 1) t)) '(:literal-calendar))))

; A mutation in each kind's table must break the full-field relation. This
; accompanies, and does not replace, the swapped-FIFO scheduling negative.
(defun fn2-ref-kind-control (kind fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (let* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
         (fn2-ref-core (fn2-ref-reset *fn2-profile-tiny* fn2-core fn2-ref-core))
         (before (fn2-ref-core-difference fn2-core fn2-ref-core))
         (id (fn2-machine-global-id kind 0 *fn2-profile-tiny*))
         (fn2-core (fn2-machine-set-generation id 2 fn2-core)))
    (mv (and (not before) (consp (fn2-ref-core-difference fn2-core fn2-ref-core)))
        fn2-core fn2-ref-core)))
(defun fn2-ref-kind-controls ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (answer fn2-core)
      (with-local-stobj fn2-ref-core
        (mv-let (answer fn2-core fn2-ref-core)
          (b* (((mv a fn2-core fn2-ref-core) (fn2-ref-kind-control *fn2-listener-kind* fn2-core fn2-ref-core))
               ((mv b fn2-core fn2-ref-core) (fn2-ref-kind-control *fn2-echo-kind* fn2-core fn2-ref-core))
               ((mv d fn2-core fn2-ref-core) (fn2-ref-kind-control *fn2-scribe-kind* fn2-core fn2-ref-core)))
            (mv (and a b d) fn2-core fn2-ref-core))
          (mv answer fn2-core))) answer)))
(assert-event (fn2-ref-kind-controls))
(value-triple (cw "REFERENCE UNIT: positive turn, swapped-FIFO negative, every-kind mutation negative PASS~%"))

; Registry teeth run the existing full positive and negative fixtures.
(defun fn2-reference-teeth ()
  (declare (xargs :verify-guards nil))
  (and (fn2-ref-test nil) (fn2-ref-test t) (fn2-ref-kind-controls)))

(fn2-assert-owed-teeth fn2-turn-refinement)

; Every byte-boundary corruption goes through the actual executor and the
; independent reference selection loop. Neither may deliver the observation.
(defun fn2-ref-corruption-run (which fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (b* (((mv ready fn2-core) (fn2-core-corruption-setup which t fn2-core))
       (fn2-core (fn2-machine-write-pending 0 2 fn2-core))
       (fn2-ref-core (fn2-ref-reset *fn2-profile-tiny* fn2-core fn2-ref-core))
       (lists (fn2-ref-lists '(1 1 1 1) 0 nil))
       (before (fn2-machine-phase 0 fn2-core))
       ((mv status obs visits actions fn2-core) (fn2-turn fn2-core))
       ((mv rstatus robs rvisits ractions lists fn2-ref-core) (fn2-ref-turn lists fn2-ref-core)))
    (mv (and ready (equal (list status obs visits actions) '(:stop 1 0 0))
             (equal (list status obs visits actions) (list rstatus robs rvisits ractions))
             (= (fn2-exec-turn-steps fn2-core) 24)
             (= (fn2-exec-turn-steps fn2-ref-core) 24)
             (= (fn2-core-stop-reason fn2-core) (fn2-core-corruption-reason which))
             (= (fn2-core-stop-reason fn2-ref-core) (fn2-core-corruption-reason which))
             (= before (fn2-machine-phase 0 fn2-core)) (= (fn2-machine-pending 0 fn2-core) 2)
             (fn2-representation-relation fn2-core fn2-ref-core lists)) fn2-core fn2-ref-core)))
(defun fn2-ref-corruption-control (which)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (answer fn2-core)
      (with-local-stobj fn2-ref-core
        (mv-let (answer fn2-core fn2-ref-core) (fn2-ref-corruption-run which fn2-core fn2-ref-core)
          (mv answer fn2-core))) answer)))
(assert-event (and (fn2-ref-corruption-control :input) (fn2-ref-corruption-control :output)
                   (fn2-ref-corruption-control :finish) (fn2-ref-corruption-control :fifo)))
(value-triple (cw "R5d TRACE CORRUPTION: :harvest-input :harvest-output :harvest-finish :harvest-fifo identical STOP, 24 steps, no observation delivery PASS~%"))

(defun fn2-ref-wake-control-run (which fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       (fn2-ref-core (fn2-ref-reset *fn2-profile-tiny* fn2-core fn2-ref-core))
       (id (if (eq which :bounds) 999 (if (eq which :none) *fn2-none* 0)))
       (lists (fn2-ref-lists '(1 1 1 1) 0 (if (eq which :state) '((0 999)) nil)))
       (fn2-core (if (eq which :state)
                     (stobj-let ((fn2-sched (fn2-core-sched fn2-core))) (fn2-sched)
                       (let* ((fn2-sched (update-fn2-sched-countsi 0 1 fn2-sched))
                              (fn2-sched (update-fn2-sched-tailsi 0 999 fn2-sched))) fn2-sched) fn2-core)
                   fn2-core))
       (fn2-core (fn2-exec-wake id fn2-core))
       ((mv lists fn2-ref-core) (fn2-ref-wake id lists fn2-ref-core))
       ; Repeating a successful wake is :already, preserving a clear stop.
       (fn2-core (fn2-exec-wake id fn2-core))
       ((mv & fn2-ref-core) (fn2-ref-wake id lists fn2-ref-core))
       (expected (case which (:bounds *fn2-stop-reason-wake-bounds*)
                   (:state *fn2-stop-reason-wake-state*) (otherwise *fn2-stop-reason-none*))))
    (mv (and (= (fn2-core-stop-reason fn2-core) expected)
             (= (fn2-core-stop-reason fn2-ref-core) expected)) fn2-core fn2-ref-core)))
(defun fn2-ref-wake-control (which)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (answer fn2-core)
      (with-local-stobj fn2-ref-core
        (mv-let (answer fn2-core fn2-ref-core) (fn2-ref-wake-control-run which fn2-core fn2-ref-core)
          (mv answer fn2-core))) answer)))
(assert-event (and (fn2-ref-wake-control :bounds) (fn2-ref-wake-control :state)
                   (fn2-ref-wake-control :already) (fn2-ref-wake-control :none)))
(value-triple (cw "R5d WAKE: :wake-bounds and :wake-state identical STOP; :already and no-wake remain clear PASS~%"))

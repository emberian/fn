; From repo root, under tools/acl2 with the B3b slot directory and a PID file.
(in-package "ACL2")
:q
(handler-case
 (progn
  (setf *print-pretty* nil)
  (multiple-value-bind (erp value state)
    (let ((*features* (adjoin :acl2-loop-only *features*)))
      (with-suppression
        (ld '((set-prover-step-limit 300000)
              (set-cbd "fn2/tests/")
              (include-book "commit-resource-unit")
              (ld "sim-layer-b.lisp" :ld-error-action :error)
              (set-guard-checking nil)) :ld-error-action :error)))
    (declare (ignore state))
    (assert (and (not erp) (eq value :eof))))
  (dolist (entry (list (cons :tiny *fn2-profile-tiny*) (cons :concrete *fn2-profile-concrete*)))
   (dolist (mode '(0 1))
    (let ((r (fn2-commit-deadlock-check (fn2-b-test-profile (cdr entry) mode) mode)))
     (format t "B3C DEADLOCK profile=~A mode=~D threads=~D rectangles=~D candidates=~D deadlocks=~D witnesses=~S~%"
      (car entry) mode (cdr (assoc :threads r)) (cdr (assoc :rectangles r))
      (cdr (assoc :candidates r)) (cdr (assoc :deadlocks r)) (cdr (assoc :witnesses r)))
     (assert (and (eq (cdr (assoc :status r)) :ok) (eql (cdr (assoc :deadlocks r)) 0))))))
  (dolist (entry (list (cons :mutex-order (fn2-commit-wrong-mutex-order))
                        (cons :held-notification (fn2-commit-held-notification))))
   (let ((r (cdr entry)))
    (format t "B3C DEADLOCK CONTROL=~A threads=~D rectangles=~D deadlocks=~D witnesses=~S~%"
     (car entry) (cdr (assoc :threads r)) (cdr (assoc :rectangles r))
     (cdr (assoc :deadlocks r)) (cdr (assoc :witnesses r)))
    (assert (and (eq (cdr (assoc :status r)) :ok) (plusp (cdr (assoc :deadlocks r)))))))
  (format t "B3C CONSERVATION actual-phase-write-audit=PASS injected-notify-free=REFUSED leak-cycle=~S~%"
   (fn2-cru-cycle :baseline-missing-vpool
    (fn2-cru-drop-release (fn2-cr-commit-word 0) :pool) *fn2-commit-resource-retained*))
  (let ((d (fn2-b-death-control (fn2-b-test-profile *fn2-profile-tiny* 0))))
    (format t "B5 DEATH CONTROL fresh-after-init=~S planted-survivor-reported=~S~%" (car d) (and (cadr d) t))
    (assert (and (car d) (cadr d))))
  (assert (fn2-b-fence-control))
  (format t "B3 FENCE CONTROL: second queued fence detected before adapter admission PASS~%")
  (dolist (mode '(0 1))
    (let ((r (fn2-b-mode-refusal mode)))
      (format t "B3 PROFILE MODE mode=~D mismatch-refused/matching-admitted=~S~%" mode r)
      (assert (fn2-b-control-pass r)))
    (let ((r (fn2-b-reuse-control mode)))
      (format t "B3 REUSE mode=~D four-batches/released-parent/stale-generation/fence-control/notification-debt=~S~%" mode r)
      (assert (fn2-b-control-pass r))))
  (dolist (short '(t nil))
    (let ((r (fn2-b-resource-refusal short)))
      (format t "B3 ADMISSION resource=~A rollback/proposal-control=~S~%" (if short :pool :allocator) r)
      (assert (fn2-b-control-pass r))))
;; B5 scenarios 15 (damage vs tail) and 16 (independent witness), tiny profile,
  ;; both barrier modes; every case runs the real recovery and RECOVERY.
  (labels ((post (kind frontier budget faults) (list (fn2-cm-profile kind t t frontier 0 budget) faults 16))
           (run15 (mode cut faults)
             (let ((r (fn2-b-one *fn2-profile-tiny* 20261028 cut :none mode 2 (post :broad nil 1 faults))))
               (unless (eq (fn2-b-result-status r) :pass)
                 (format t "B5 CASE RED scenario=15 mode=~D cut=~D faults=~S result=~S~%" mode cut faults
                         (fn2-b-result-status r))
                 (error "B5 RECOVERY failure"))
               r)))
    (let ((hist nil) (cases 0) (started (get-internal-real-time)))
      (flet ((note (class r) (incf cases)
               (let* ((key (list class (fn2-b-result-recovery-class r))) (cell (assoc key hist :test #'equal)))
                 (if cell (incf (cdr cell)) (push (cons key 1) hist)))))
        (dotimes (mode 2)
          (let ((steps (fn2-b-result-steps (run15 mode 1000000 nil))))
            (dolist (unit '(0 1 2))
              (dolist (off '(100 3000))
                (note :corrupt-middle (run15 mode 1000000 (list (list :corrupt 1 unit off))))))
            (dotimes (cut (+ steps 1))
              (note :corrupt-tail (run15 mode cut '((:corrupt-last 2 100)))))
            (note :misdirect-write (run15 mode 1000000 '((:misdirect 2 2 3))))
            (note :misdirect-write (run15 mode 1000000 '((:misdirect 1 1 4))))
            (note :older-image (run15 mode 1000000 '((:rollback 1))))
            (note :older-image (run15 mode 1000000 '((:rollback 0)))))))
      (format t "B5 SCENARIO 15 profile=TINY-4K modes=baseline,preflush-fua cases=~D classes=~S RECOVERY=PASS elapsed-seconds=~,3F~%"
              cases (reverse hist) (/ (- (get-internal-real-time) started) internal-time-units-per-second))
      (assert (every (lambda (c) (assoc c (mapcar #'car hist) :test #'eq))
                     '(:corrupt-middle :corrupt-tail :misdirect-write :older-image))))
    (let ((outcomes nil) (started (get-internal-real-time)))
      (dotimes (mode 2)
        (dolist (c '((t ((:witness 2) (:rollback 1)) :rollback-detected :damaged)
                     (t ((:rollback 1)) :none :intact)
                     (nil ((:witness 2) (:rollback 1)) :uncredited :intact)
                     (t ((:witness 1) (:rollback 1)) :consistent :intact)
                     (t ((:witness 2)) :consistent :intact)
                     (t ((:witness 2) (:rollback 0)) :rollback-detected :damaged)))
          (let ((r (fn2-b-one *fn2-profile-tiny* 20261028 1000000 :none mode 2
                              (post :broad (first c) 0 (second c)))))
            (unless (and (eq (fn2-b-result-status r) :pass) (eq (fn2-b-result-witness r) (third c))
                         (eq (fn2-b-result-recovery-class r) (fourth c)))
              (format t "B5 CASE RED scenario=16 mode=~D case=~S result=~S ~S ~S~%" mode c
                      (fn2-b-result-status r) (fn2-b-result-witness r) (fn2-b-result-recovery-class r))
              (error "B5 RECOVERY witness failure"))
            (push (list mode (second c) (fn2-b-result-witness r) (fn2-b-result-recovery-class r)) outcomes))))
      (format t "B5 SCENARIO 16 profile=TINY-4K cases=~D witnessed=detected unwitnessed=no-claim uncredited=no-claim covered=consistent RECOVERY=PASS elapsed-seconds=~,3F~%"
              (length outcomes) (/ (- (get-internal-real-time) started) internal-time-units-per-second)))
    ;; Recovery time per MiB of scanned arena: the same intact run on 16 and
    ;; 192 simulated sectors (5 and 64 extents); the difference is 59 empty
    ;; seal-frame scans of 4 KiB each.
    (flet ((timed (sectors)
             (let ((start (get-internal-real-time)))
               (dotimes (i 5) (fn2-b-one *fn2-profile-tiny* 20261028 1000000 :none 0 2
                                         (list (fn2-cm-profile :crash-only t t nil 0 0) nil sectors)))
               (/ (- (get-internal-real-time) start) internal-time-units-per-second 5.0))))
      (let* ((small (timed 16)) (large (timed 192)) (mib (/ (* 59 4096) 1048576.0)))
        (format t "B5 RECOVERY TIME arena-scan seconds-per-MiB=~,3F (5-run means: 5 extents ~,3Fs, 64 extents ~,3Fs; simulator, ACL2 hashing)~%"
                (/ (- large small) mib) small large))))
  (let ((seeds (parse-integer (or (sb-ext:posix-getenv "FN2_B_SEEDS") "10000")))
        (faults '(:late-success :partial :eio :enospc :failed-barrier)))
    (labels
      ((checked (profile seed cut fault mode members)
         (let ((r (fn2-b-one profile seed cut fault mode members nil)))
           (unless (eq (fn2-b-result-status r) :pass)
             (format t "B3 CASE RED seed=~D cut=~D fault=~S mode=~D result=~S~%"
                     seed cut fault mode r)
             (error "B3 HISTORY/control failure"))
           r))
       (progress (scenario profile cases total started)
         (when (zerop (mod cases 1000))
           (format t "B3 PROGRESS scenario=~D profile=~A cases=~D/~D HISTORY=PASS elapsed-seconds=~,3F~%"
                   scenario profile cases total
                   (/ (- (get-internal-real-time) started) internal-time-units-per-second))
           (finish-output)))
       (summarize (scenario profile cases deaths histogram targets reorders tears fence-max)
         (format t "B3 SCENARIO ~D profile=~A modes=baseline,preflush-fua cases=~D deaths=~D admission-refusals=~D faults=~S write-targets=~S reorder=~D pending-tear=~D max-fences=~D HISTORY=PASS~%"
                 scenario profile cases deaths cases histogram targets reorders tears fence-max)
         (finish-output)))
      (dolist (profile-entry
               (append (list (cons "TINY-4K" *fn2-profile-tiny*))
                (unless (equal (sb-ext:posix-getenv "FN2_B_PROFILE") "tiny")
                  (list (cons "CONCRETE" *fn2-profile-concrete*)))))
        (let* ((profile-start (get-internal-real-time))
               (all-cases 0) (name (car profile-entry)) (profile (cdr profile-entry))
               (tiny (string= name "TINY-4K"))
               (members (if tiny 2 16))
               (pilot0 (checked profile 20261028 1000000 :none 0 members))
               (pilot1 (checked profile 20261028 1000000 :none 1 members))
               (cases 0) (deaths 0) (reorders 0) (tears 0) (max-fences 0))
          (assert (= (fn2-b-result-acks pilot0) (* 2 members)))
          (assert (= (fn2-b-result-acks pilot1) (* 2 members)))
          (dolist (pilot (list pilot0 pilot1))
            (assert (subsetp (list *fn2-commit-state-collect* *fn2-commit-state-seal*
                         *fn2-commit-state-dependencies* *fn2-commit-state-log-write*
                         *fn2-commit-state-fence* *fn2-commit-state-durable* *fn2-commit-state-install*
                         *fn2-commit-state-publish* *fn2-commit-state-notify* *fn2-commit-state-draining*)
                       (fn2-b-result-phases pilot))))
          (dotimes (mode 2)
            (let* ((pilot (if (= mode 0) pilot0 pilot1))
                   (steps (fn2-b-result-steps pilot))
                   (count (if tiny (+ steps 1) (ceiling seeds 2))))
              (dotimes (i count)
                (let* ((seed (if tiny 20261028 (+ (* mode count) i)))
                       (cut (if tiny i (mod (+ (* 2654435761 seed) 17) (+ steps 1))))
                       (r (checked profile seed cut :none mode members)))
                  (incf cases) (incf deaths (fn2-b-result-deaths r))
                  (incf reorders (fn2-b-result-reorders r))
                  (incf tears (fn2-b-result-dirty r))
                  (setf max-fences (max max-fences (fn2-b-result-fence-max r)))
                  (unless tiny (progress 13 name cases (* 2 count) profile-start))))))
          (assert (> reorders 0)) (assert (> tears 0))
          (summarize 13 name cases deaths
                     (list (cons :death-cut deaths) (cons :write-reorder reorders)
                           (cons :pending-tear tears)) nil reorders tears max-fences)
          (setf all-cases cases)
          (let ((isolated (checked profile 20261028 1000000 :none 0 1)))
            (format t "B3 PACKING profile=~A isolated-bytes/ack=~D batch-members=~D batch-bytes/ack=~D record-payload/log-bytes=~,3F acknowledged=~D~%"
                    name (/ (fn2-b-result-write-bytes isolated) (fn2-b-result-acks isolated))
                    members (/ (fn2-b-result-write-bytes pilot0) (fn2-b-result-acks pilot0))
                    (/ (fn2-b-result-payload-bytes pilot0) 16384.0)
                    (fn2-b-result-acks pilot0)))
          (let ((histogram (mapcar (lambda (f) (cons f 0)) faults))
                (targets (loop for f in '(:partial :eio :enospc) append
                           (list (cons (list f :dependency) 0) (cons (list f :log) 0)))))
            (setf cases 0 deaths 0 reorders 0 tears 0 max-fences 0)
            (labels ((record (r)
                       (incf cases) (incf deaths (fn2-b-result-deaths r))
                       (when (fn2-b-result-fault r)
                         (incf (cdr (assoc (fn2-b-result-fault r) histogram))))
                       (when (fn2-b-result-write-target r)
                         (incf (cdr (assoc (list (fn2-b-result-fault r) (fn2-b-result-write-target r)) targets :test #'equal))))
                       (incf reorders (fn2-b-result-reorders r))
                       (incf tears (fn2-b-result-dirty r))
                       (setf max-fences (max max-fences (fn2-b-result-fence-max r)))
                       (unless tiny (progress 14 name cases seeds profile-start))))
              (dotimes (i (if tiny (* 4 (length faults)) seeds))
                (let* ((fault (nth (mod i (length faults)) faults))
                       (mode (mod (floor i (length faults)) 2))
                       (seed (+ 100000 i))
                       (pilot (checked profile seed 1000000 fault mode members)))
                  (assert (member *fn2-commit-state-uncertain* (fn2-b-result-phases pilot)))
                  (if tiny
                      ; Includes cuts before injection and after physical error
                      ; but before harvest: neither falsely requires uncertainty.
                      (dotimes (cut (+ 1 (fn2-b-result-steps pilot)))
                        (record (checked profile seed cut fault mode members)))
                    (record pilot)))))
            (assert (every (lambda (x) (> (cdr x) 0)) histogram))
            (assert (every (lambda (x) (> (cdr x) 0)) targets))
            (summarize 14 name cases deaths histogram targets reorders tears max-fences)
            (format t "B3 TIMING profile=~A scenario-cases=~D elapsed-seconds=~,3F~%"
                    name (+ all-cases cases)
                    (/ (- (get-internal-real-time) profile-start) internal-time-units-per-second)))))))
  (sb-ext:exit :code 0))
 (cl:error (condition)
  (format *error-output* "B3 ACCEPTANCE RED: ~A~%" condition)
  (sb-ext:exit :code 1)))

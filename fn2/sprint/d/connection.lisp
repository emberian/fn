; Every pending operation is identified exactly by its A OpRef. No completion
; mailbox can overwrite an earlier completion: this slice has one in flight.
(defun fn2-sd-issue (id budget fn2-sdconn fn2-core fn2-sprint-c)
 (declare (xargs :stobjs (fn2-sdconn fn2-core fn2-sprint-c) :verify-guards nil) (ignore id))
 (if (or (= (fn2-sdconn-pending 0 fn2-sdconn) 1) (zp budget))
     (mv 0 1 0 nil fn2-sdconn fn2-core fn2-sprint-c)
  (b* ((phase (fn2-sdconn-phase 0 fn2-sdconn))
       ((when (and (= phase *fn2-sdconn-state-log-write*)
                   (> (+ (* 4096 (fn2-sdconn-ordinal 0 fn2-sdconn)) (fn2-sdconn-post-len 0 fn2-sdconn))
                      (fn2-sdconn-storage-bytes 0 fn2-sdconn))))
        (let ((fn2-sdconn (fn2-sdconn-set-outcome 0 1 fn2-sdconn)))
         (mv-let (fn2-sdconn fn2-core) (fn2-sd-reply "441 posting failed; sprint device profile is full"
           *fn2-sdconn-state-command* fn2-sdconn fn2-core)
          (mv 64 8 0 t fn2-sdconn fn2-core fn2-sprint-c))))
       ((mv code op gen fn2-core)
        (cond ((= phase *fn2-sdconn-state-accepting*) (fn2-issue-accept 0 0 250 0 1 0 fn2-core))
              ((= phase *fn2-sdconn-state-log-write*)
               (fn2-issue-write (* 4096 (fn2-sdconn-ordinal 0 fn2-sdconn)) (fn2-sdconn-up-slot 0 fn2-sdconn) (fn2-sdconn-up-gen 0 fn2-sdconn)
                 0 (fn2-sdconn-post-len 0 fn2-sdconn) 0 250 0 1 0 fn2-core))
              ((= phase *fn2-sdconn-state-fence*) (fn2-issue-fence 250 0 1 0 fn2-core))
              (t (fn2-issue-close (fn2-sdconn-cap-index 0 fn2-sdconn) (fn2-sdconn-cap-nonce 0 fn2-sdconn) 250 0 1 0 fn2-core))))
       ((when (and (not (eq code :ok)) (not (eq code :exhausted))))
        (if (= phase *fn2-sdconn-state-log-write*)
         (let ((fn2-sdconn (fn2-sdconn-set-outcome 0 1 fn2-sdconn)))
          (mv-let (fn2-sdconn fn2-core) (fn2-sd-reply "441 posting failed; persistence admission refused"
            *fn2-sdconn-state-command* fn2-sdconn fn2-core)
           (mv 64 8 0 t fn2-sdconn fn2-core fn2-sprint-c)))
         (let ((fn2-sdconn (fn2-sdconn-set-phase 0 *fn2-sdconn-state-draining* fn2-sdconn)))
          (mv 0 8 0 nil fn2-sdconn fn2-core fn2-sprint-c))))
       (fn2-sdconn (if (eq code :ok)
                      (fn2-sdconn-put 0 (pending 1) (op-slot op) (op-gen gen)
                        (outcome (if (= phase *fn2-sdconn-state-log-write*) 2 (fn2-sdconn-outcome 0 fn2-sdconn))))
                    fn2-sdconn)))
   (mv 0 8 (if (eq code :ok) 1 0) (not (eq code :ok)) fn2-sdconn fn2-core fn2-sprint-c))))


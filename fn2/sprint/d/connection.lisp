(defun fn2-sd-receive (fn2-sdconn fn2-core fn2-sprint-c)
 (declare (xargs :stobjs (fn2-sdconn fn2-core fn2-sprint-c) :verify-guards nil))
 (b* ((slot (fn2-sdconn-rx-slot 0 fn2-sdconn)) (gen (fn2-sdconn-rx-gen 0 fn2-sdconn))
      (filled-bytes (fn2-sd-fill slot fn2-core))
      ; Window reset is legal only after every buffered byte was consumed.
      ((mv code fn2-core)
       (if (= filled-bytes (fn2-sdconn-start 0 fn2-sdconn)) (fn2-core-reset slot gen 250 0 1 fn2-core) (mv :ok fn2-core)))
      (fn2-sdconn (if (and (eq code :ok) (= filled-bytes (fn2-sdconn-start 0 fn2-sdconn)))
                     (fn2-sdconn-put 0 (scan 0) (start 0)) fn2-sdconn))
      (available-bytes (- 4096 (fn2-sd-fill slot fn2-core)))
      ((when (zp available-bytes))
       (if (< 0 (fn2-sdconn-start 0 fn2-sdconn))
        (let ((fn2-sdconn (fn2-sdconn-put 0 (wait-reason 4) (seek 0))))
         (mv 0 3 0 t fn2-sdconn fn2-core fn2-sprint-c))
        (mv-let (fn2-sdconn fn2-core) (fn2-sd-reply "501 input line exceeds receive window"
          *fn2-sdconn-state-closing* fn2-sdconn fn2-core)
         (mv 64 4 0 t fn2-sdconn fn2-core fn2-sprint-c))))
      ((mv code op ogen fn2-core)
       (fn2-issue-receive (fn2-sdconn-cap-index 0 fn2-sdconn) (fn2-sdconn-cap-nonce 0 fn2-sdconn)
                         slot gen (min 4096 available-bytes) 250 0 1 0 fn2-core))
      (fn2-sdconn (if (eq code :ok) (fn2-sdconn-put 0 (pending 1) (op-slot op) (op-gen ogen)) fn2-sdconn)))
  (mv 0 8 (if (eq code :ok) 1 0) (not (eq code :ok)) fn2-sdconn fn2-core fn2-sprint-c)))

(defun fn2-sd-command (start end fn2-sdconn fn2-core fn2-sprint-c)
 (declare (xargs :stobjs (fn2-sdconn fn2-core fn2-sprint-c) :verify-guards nil))
 (b* ((slot (fn2-sdconn-rx-slot 0 fn2-sdconn)) (gen (fn2-sdconn-rx-gen 0 fn2-sdconn))
      ((when (>= (fn2-sdconn-ordinal 0 fn2-sdconn) 1152921504606846975))
       (mv-let (fn2-sdconn fn2-core) (fn2-sd-reply "400 command ordinal exhausted"
         *fn2-sdconn-state-closing* fn2-sdconn fn2-core)
        (mv 64 8 0 t fn2-sdconn fn2-core fn2-sprint-c)))
      (word-end (fn2-sd-word-end slot gen start end 512 fn2-core))
      (tag (fn2-sd-command-tag *fn2-sd-grammar* slot gen start (- word-end start) fn2-core))
      (arg (if (< word-end end) (+ word-end 1) end)) (len (- end arg))
      (fn2-sdconn (fn2-sdconn-put 0 (request tag) (arg-off arg) (arg-len len) (seek 0)
                    (ordinal (+ 1 (fn2-sdconn-ordinal 0 fn2-sdconn))))))
  (cond
   ((= tag 1)
    (let* ((group (fn2-sd-group-id *fn2-sd-groups* slot gen arg len fn2-core))
           (fn2-sdconn (if (= group 0) fn2-sdconn
                         (fn2-sdconn-put 0 (query group) (summary-count 0) (summary-low 0) (summary-high 0)
                           (phase *fn2-sdconn-state-group-select*)))))
     (if (= group 0)
      (mv-let (fn2-sdconn fn2-core) (fn2-sd-reply "411 no such newsgroup" *fn2-sdconn-state-command* fn2-sdconn fn2-core)
       (mv 64 8 0 t fn2-sdconn fn2-core fn2-sprint-c))
      (mv 64 8 0 t fn2-sdconn fn2-core fn2-sprint-c))))
   ((= tag 2)
    (mv-let (code byte) (if (< 0 len) (fn2-core-read slot gen arg 250 0 1 fn2-core) (mv :ok 0))
     (if (and (eq code :ok) (= byte 60))
      (let ((fn2-sdconn (fn2-sdconn-put 0 (request 5) (phase *fn2-sdconn-state-lookup*))))
       (mv 64 8 0 t fn2-sdconn fn2-core fn2-sprint-c))
      (mv-let (ncode number) (fn2-sd-number slot gen arg len 0 fn2-core)
       (if (and (eq ncode :ok) (< 0 number) (< 0 (fn2-sdconn-selected 0 fn2-sdconn)))
        (let ((fn2-sdconn (fn2-sdconn-put 0 (query number) (phase *fn2-sdconn-state-lookup*))))
         (mv 64 8 0 t fn2-sdconn fn2-core fn2-sprint-c))
        (mv-let (fn2-sdconn fn2-core) (fn2-sd-reply (if (= (fn2-sdconn-selected 0 fn2-sdconn) 0) "412 no newsgroup selected" "501 syntax error")
               *fn2-sdconn-state-command* fn2-sdconn fn2-core)
         (mv 64 8 0 t fn2-sdconn fn2-core fn2-sprint-c)))))))
   ((and (= tag 3) (= len 0))
    (let ((fn2-core
           (if (and (= (fn2-sdconn-outcome 0 fn2-sdconn) 1) (< 0 (fn2-sdconn-up-gen 0 fn2-sdconn)))
            (mv-let (ignored fn2-core) (fn2-core-release (fn2-sdconn-up-slot 0 fn2-sdconn) (fn2-sdconn-up-gen 0 fn2-sdconn) 250 0 1 fn2-core)
             (declare (ignore ignored)) fn2-core)
            fn2-core)))
    (mv-let (code up ugen fn2-core) (fn2-core-reserve 0 250 0 1 fn2-core)
     (if (eq code :ok)
      (let ((fn2-sdconn (fn2-sdconn-put 0 (up-slot up) (up-gen ugen) (post-len 0) (mid-len 0) (outcome 0))))
       (mv-let (fn2-sdconn fn2-core) (fn2-sd-reply "340 send article to be posted" *fn2-sdconn-state-article-input* fn2-sdconn fn2-core)
        (mv 64 8 0 t fn2-sdconn fn2-core fn2-sprint-c)))
      ; Retain this exact command on resource exhaustion; no false refusal.
      (let ((fn2-sdconn (fn2-sdconn-put 0 (start start) (scan start)
                             (ordinal (nfix (- (fn2-sdconn-ordinal 0 fn2-sdconn) 1))))))
       (mv 64 8 0 t fn2-sdconn fn2-core fn2-sprint-c))))))
   (t (mv-let (fn2-sdconn fn2-core)
       (fn2-sd-reply (if (and (= tag 4) (= len 0)) "205 closing connection" (if (= tag 0) "500 unknown command" "501 syntax error"))
        (if (and (= tag 4) (= len 0)) *fn2-sdconn-state-closing* *fn2-sdconn-state-command*) fn2-sdconn fn2-core)
       (mv 64 8 0 t fn2-sdconn fn2-core fn2-sprint-c))))))

(defun fn2-sd-article-line (start end fn2-sdconn fn2-core fn2-sprint-c)
 (declare (xargs :stobjs (fn2-sdconn fn2-core fn2-sprint-c) :verify-guards nil))
 (b* ((slot (fn2-sdconn-rx-slot 0 fn2-sdconn)) (gen (fn2-sdconn-rx-gen 0 fn2-sdconn))
      (len (- end start))
      ((when (fn2-sd-match "." 0 start len nil slot gen fn2-core))
       (let ((fn2-sdconn (fn2-sdconn-put 0 (phase *fn2-sdconn-state-post-check*) (seek 0))))
        (mv 2 4 0 t fn2-sdconn fn2-core fn2-sprint-c)))
      (dot (and (< 1 len) (fn2-sd-match ".." 0 start 2 nil slot gen fn2-core)))
      (start (if dot (+ start 1) start)) (len (- end start))
      (old (fn2-sdconn-post-len 0 fn2-sdconn))
      ((when (> (+ old len 2) (fn2-sdconn-article-limit 0 fn2-sdconn)))
       ; Explicit supported admission profile; close discards the remaining
       ; article, instead of retaining unbounded input or inventing acceptance.
       (mv-let (fn2-sdconn fn2-core) (fn2-sd-reply "441 posting failed; article exceeds sprint profile" *fn2-sdconn-state-closing* fn2-sdconn fn2-core)
        (mv 2 4 0 t fn2-sdconn fn2-core fn2-sprint-c)))
      (mid-header (and (= (fn2-sdconn-request 0 fn2-sdconn) 3) (<= 12 len)
                        (fn2-sd-match "MESSAGE-ID: " 0 start 12 t slot gen fn2-core)))
      ((when (and mid-header (< 0 (fn2-sdconn-mid-len 0 fn2-sdconn))))
       (mv-let (fn2-sdconn fn2-core) (fn2-sd-reply "441 posting failed; Message-ID appears more than once"
         *fn2-sdconn-state-closing* fn2-sdconn fn2-core)
        (mv 64 8 0 t fn2-sdconn fn2-core fn2-sprint-c)))
      (up (fn2-sdconn-up-slot 0 fn2-sdconn)) (ugen (fn2-sdconn-up-gen 0 fn2-sdconn))
      ((mv code out fn2-core) (fn2-sd-copy slot gen start (+ len 2) up ugen old fn2-core))
      (mid (and (= (fn2-sdconn-request 0 fn2-sdconn) 3) (<= 12 len) (fn2-sd-match "MESSAGE-ID: " 0 start 12 t slot gen fn2-core)))
      (fn2-sdconn (fn2-sdconn-put 0 (post-len out)
                    (request (if (= len 0) 6 (fn2-sdconn-request 0 fn2-sdconn)))
                    (mid-off (if mid (+ old 12) (fn2-sdconn-mid-off 0 fn2-sdconn)))
                    (mid-len (if mid (- len 12) (fn2-sdconn-mid-len 0 fn2-sdconn)))
                    (phase (if (eq code :ok) *fn2-sdconn-state-article-input* *fn2-sdconn-state-closing*)))))
  (mv (* 2 (+ len 2)) 8 0 t fn2-sdconn fn2-core fn2-sprint-c)))

 ; Input-only continuation: TX is a workspace (last Send already completed).
; Two disjoint-range passes avoid unsafe in-place copies and bound each call.
(defun fn2-sd-compact (fn2-sdconn fn2-core fn2-sprint-c)
 (declare (xargs :stobjs (fn2-sdconn fn2-core fn2-sprint-c) :verify-guards nil))
 (b* ((stage (fn2-sdconn-wait-reason 0 fn2-sdconn))
      (cursor (fn2-sdconn-seek 0 fn2-sdconn))
      (start (fn2-sdconn-start 0 fn2-sdconn))
      (rx (fn2-sdconn-rx-slot 0 fn2-sdconn)) (rg (fn2-sdconn-rx-gen 0 fn2-sdconn))
      (tx (fn2-sdconn-tx-slot 0 fn2-sdconn)) (tg (fn2-sdconn-tx-gen 0 fn2-sdconn))
      (total (if (= stage 4) (- (fn2-sd-fill rx fn2-core) start) (fn2-sd-fill tx fn2-core)))
      ((mv code fn2-core) (if (and (= stage 4) (= cursor 0))
                             (fn2-core-reset tx tg 250 0 1 fn2-core) (mv :ok fn2-core)))
      (n (min 1024 (nfix (- total cursor))))
      ((mv code ?out fn2-core) (if (eq code :ok)
       (if (= stage 4) (fn2-sd-copy rx rg (+ start cursor) n tx tg cursor fn2-core)
                        (fn2-sd-copy tx tg cursor n rx rg cursor fn2-core))
       (mv code cursor fn2-core)))
      ((unless (eq code :ok))
       (let ((fn2-sdconn (fn2-sdconn-put 0 (wait-reason 0) (phase *fn2-sdconn-state-closing*))))
        (mv (* 2 n) 12 0 t fn2-sdconn fn2-core fn2-sprint-c)))
      (next (+ cursor n))
      ((mv code fn2-core) (if (and (= stage 4) (= next total))
                             (fn2-core-reset rx rg 250 0 1 fn2-core) (mv :ok fn2-core)))
      (fn2-sdconn
       (cond ((not (eq code :ok)) (fn2-sdconn-put 0 (wait-reason 0) (phase *fn2-sdconn-state-closing*)))
             ((< next total) (fn2-sdconn-set-seek 0 next fn2-sdconn))
             ((= stage 4) (fn2-sdconn-put 0 (seek 0) (wait-reason 5) (start 0)
                             (scan (nfix (- (fn2-sdconn-scan 0 fn2-sdconn) start)))))
             (t (fn2-sdconn-put 0 (seek 0) (wait-reason 0))))))
  (mv (* 2 n) 12 0 t fn2-sdconn fn2-core fn2-sprint-c)))


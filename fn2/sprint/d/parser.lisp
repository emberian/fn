; Pool-only first grammar slice. Strings below are static grammar/renderer data.
(in-package "ACL2")
(include-book "../../books/core")
(include-book "std/util/bstar" :dir :system)

(defconst *fn2-sd-grammar* '(("GROUP" 1 :group) ("ARTICLE" 2 :article) ("POST" 3 :none) ("QUIT" 4 :none)))
(defconst *fn2-sd-groups* '(("test" . 1)))

(defun fn2-sd-upcase (byte)
 (declare (xargs :guard (unsigned-byte-p 8 byte)))
 (if (and (<= 97 byte) (<= byte 122)) (- byte 32) byte))
(defun fn2-sd-match (text i off len fold slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix (- (length text) (nfix i)))))
 (if (or (not (stringp text)) (not (= len (length text)))) nil
  (if (>= (nfix i) (length text)) t
   (mv-let (code byte) (fn2-core-read slot gen (+ off i) 250 0 1 fn2-core)
    (and (eq code :ok)
         (= (if fold (fn2-sd-upcase byte) byte) (char-code (char text i)))
         (fn2-sd-match text (+ 1 (nfix i)) off len fold slot gen fn2-core))))))
(defun fn2-sd-fill (slot fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
  (n) (fn2-pool-slot-fill slot fn2-pool) n))

; Resume at SCAN, including a CR whose LF has not arrived yet. Each byte is
; read at most twice across fragments. The command cap includes its CRLF.
(defun fn2-sd-scan-line (slot gen start scan cap fuel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond ((zp fuel) (mv :yield scan 0))
       ((> (- (nfix scan) (nfix start)) (- (nfix cap) 2)) (mv :line-limit scan 0))
       ((>= (nfix scan) (fn2-sd-fill slot fn2-core)) (mv :need-input scan 0))
       (t (mv-let (code byte) (fn2-core-read slot gen scan 250 0 1 fn2-core)
            (cond ((not (eq code :ok)) (mv code scan 0))
                  ((= byte 10) (mv :bare-lf scan 0))
                  ((= byte 13)
                   (if (>= (+ scan 1) (fn2-sd-fill slot fn2-core)) (mv :need-input scan 0)
                    (mv-let (code next) (fn2-core-read slot gen (+ scan 1) 250 0 1 fn2-core)
                     (cond ((not (eq code :ok)) (mv code scan 0))
                           ((= next 10) (mv :line (+ scan 2) scan))
                           (t (mv :bare-cr scan 0))))))
                  (t (fn2-sd-scan-line slot gen start (+ 1 scan) cap (- fuel 1) fn2-core)))))))
(defun fn2-sd-word-end (slot gen off end fuel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (or (zp fuel) (>= (nfix off) (nfix end))) off
  (mv-let (code byte) (fn2-core-read slot gen off 250 0 1 fn2-core)
   (if (or (not (eq code :ok)) (= byte 32)) off
    (fn2-sd-word-end slot gen (+ off 1) end (- fuel 1) fn2-core)))))
(defun fn2-sd-command-tag (table slot gen off len fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (if (atom table) 0
  (if (fn2-sd-match (caar table) 0 off len t slot gen fn2-core) (cadar table)
   (fn2-sd-command-tag (cdr table) slot gen off len fn2-core))))
(defun fn2-sd-group-id (table slot gen off len fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (if (atom table) 0
  (if (fn2-sd-match (caar table) 0 off len nil slot gen fn2-core) (cdar table)
   (fn2-sd-group-id (cdr table) slot gen off len fn2-core))))
(defun fn2-sd-number (slot gen off left value fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :ok value)
  (mv-let (code byte) (fn2-core-read slot gen off 250 0 1 fn2-core)
   (cond ((not (eq code :ok)) (mv code 0))
         ((or (< byte 48) (> byte 57)) (mv :syntax 0))
         ((>= (+ (* 10 (nfix value)) (- byte 48)) 1152921504606846976) (mv :number-width 0))
         (t (fn2-sd-number slot gen (+ 1 off) (- left 1)
                           (+ (* 10 value) (- byte 48)) fn2-core))))))

(defun fn2-sd-write-text (text i slot gen off fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix (- (length text) (nfix i)))))
 (if (>= (nfix i) (length text)) (mv :ok off fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen off (char-code (char text i)) 250 0 1 fn2-core)
   (if (not (eq code :ok)) (mv code off fn2-core)
    (fn2-sd-write-text text (+ 1 (nfix i)) slot gen (+ off 1) fn2-core)))))
(defun fn2-sd-write-number (n scale left slot gen off fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (or (zp left) (zp scale)) (mv :ok off fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen off (+ 48 (mod (floor (nfix n) scale) 10)) 250 0 1 fn2-core)
   (if (not (eq code :ok)) (mv code off fn2-core)
    (fn2-sd-write-number n (floor scale 10) (- left 1) slot gen (+ off 1) fn2-core)))))
(defun fn2-sd-scale (n scale fuel)
 (declare (xargs :verify-guards nil :measure (nfix fuel)))
 (if (or (zp fuel) (< (nfix n) (* 10 (nfix scale)))) scale
  (fn2-sd-scale n (* 10 scale) (- fuel 1))))
(defun fn2-sd-render-number (n slot gen off fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (fn2-sd-write-number n (fn2-sd-scale n 1 18) 19 slot gen off fn2-core))
(defun fn2-sd-copy (src sgen off left dst dgen out fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :ok out fn2-core)
  (b* (((mv code byte) (fn2-core-read src sgen off 250 0 1 fn2-core))
       ((unless (eq code :ok)) (mv code out fn2-core))
       ((mv code fn2-core) (fn2-core-write dst dgen out byte 250 0 1 fn2-core))
       ((unless (eq code :ok)) (mv code out fn2-core)))
   (fn2-sd-copy src sgen (+ off 1) (- left 1) dst dgen (+ out 1) fn2-core))))

; ARTICLE wire producer: caller supplies at most 1200 source octets per run.
; It acquires its live pinned source range before the success line is built.
(defun fn2-sd-dot-copy (src sgen off left dst dgen out bol fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :ok out fn2-core)
  (b* (((mv code byte) (fn2-core-read src sgen off 250 0 1 fn2-core))
       ((unless (eq code :ok)) (mv code out fn2-core))
       ((mv code fn2-core)
        (if (and bol (= byte 46)) (fn2-core-write dst dgen out 46 250 0 1 fn2-core) (mv :ok fn2-core)))
       ((unless (eq code :ok)) (mv code out fn2-core))
       (out (if (and bol (= byte 46)) (+ out 1) out))
       ((mv code fn2-core) (fn2-core-write dst dgen out byte 250 0 1 fn2-core))
       ((unless (eq code :ok)) (mv code out fn2-core)))
   (fn2-sd-dot-copy src sgen (+ off 1) (- left 1) dst dgen (+ out 1) (= byte 10) fn2-core))))

(in-package "ACL2")
(set-inhibit-output-lst '(proof-tree prove event summary warning observation))
(set-prover-step-limit 5000000)
(set-cbd "fn2/sprint/tests/")
(include-book "integration")
(set-guard-checking nil)
(assert-event (equal (fn2-sprint-admission-control)
                    '(:full-c-no-write t :T1-shape-positive t :T1-invariant-removal t)))
(cw "SPRINT ADMISSION ~x0~%" (fn2-sprint-admission-control))
(cw "SPRINT-EXAMPLE-PASS integration-driver~%")
(good-bye)

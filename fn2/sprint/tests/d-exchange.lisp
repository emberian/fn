(defconst *fn2-sdt-profile*
 (put-assoc-equal :sim-sectors 32
  (put-assoc-equal :pool-classes '((16 . 4096)) *fn2-profile-tiny*)))
(defun fn2-sdt-ascii (s i)
 (declare (xargs :verify-guards nil :measure (nfix (- (length s) (nfix i)))))
 (if (>= (nfix i) (length s)) nil
  (cons (char-code (char s i)) (fn2-sdt-ascii s (+ 1 (nfix i))))))
(defun fn2-sdt-lines (lines)
 (declare (xargs :verify-guards nil))
 (if (atom lines) nil (append (fn2-sdt-ascii (car lines) 0) '(13 10) (fn2-sdt-lines (cdr lines)))))

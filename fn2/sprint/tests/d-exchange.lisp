(defun fn2-sdt-write (bytes off slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (if (atom bytes) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen off (car bytes) 250 0 1 fn2-core)
   (if (eq code :ok) (fn2-sdt-write (cdr bytes) (+ 1 (nfix off)) slot gen fn2-core) (mv code fn2-core)))))
(defun fn2-sdt-seed (bytes number fn2-core fn2-sprint-c)
 (declare (xargs :stobjs (fn2-core fn2-sprint-c) :verify-guards nil))
 (b* (((mv code slot gen fn2-core) (fn2-core-reserve 0 250 0 1 fn2-core))
      ((unless (eq code :ok)) (mv code fn2-core fn2-sprint-c))
      ((mv code fn2-core) (fn2-sdt-write bytes 0 slot gen fn2-core))
      ((unless (eq code :ok)) (mv code fn2-core fn2-sprint-c))
      ((mv code ?row fn2-sprint-c) (fn2-sc-add 1 number slot gen 12 10 slot gen 0 (len bytes) number fn2-sprint-c)))
  (mv code fn2-core fn2-sprint-c)))
(defun fn2-sdt-feed (left bytes cap nonce fn2-sim-network)
 (declare (xargs :stobjs fn2-sim-network :verify-guards nil :measure (nfix left)))
 (if (or (zp left) (atom bytes)) (mv bytes fn2-sim-network)
  (mv-let (code fn2-sim-network) (fn2-network-client-byte cap nonce (car bytes) fn2-sim-network)
   (if (eq code :ok) (fn2-sdt-feed (- left 1) (cdr bytes) cap nonce fn2-sim-network) (mv bytes fn2-sim-network)))))
(defun fn2-sdt-drain (left bytes cap nonce fn2-sim-network)
 (declare (xargs :stobjs fn2-sim-network :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :ok bytes 0 fn2-sim-network)
  (mv-let (code byte fn2-sim-network) (fn2-network-client-read cap nonce fn2-sim-network)
   (cond ((not (eq code :ok)) (mv :ok bytes 0 fn2-sim-network))
         ((or (atom bytes) (not (= byte (car bytes)))) (mv (list :wire-byte byte (car bytes)) bytes 0 fn2-sim-network))
         (t (mv-let (code bytes n fn2-sim-network) (fn2-sdt-drain (- left 1) (cdr bytes) cap nonce fn2-sim-network)
              (mv code bytes (+ n 1) fn2-sim-network)))))))
(defun fn2-sdt-client (fragment input expected fn2-sdconn fn2-sim)
 (declare (xargs :stobjs (fn2-sdconn fn2-sim) :verify-guards nil))
 (if (or (= (fn2-sdconn-phase 0 fn2-sdconn) *fn2-sdconn-state-accepting*)
          (= (fn2-sdconn-cap-nonce 0 fn2-sdconn) 0))
     (mv :ok input expected 0 fn2-sim)
  (stobj-let ((fn2-sim-network (fn2-sim-net fn2-sim)))
   (status input expected n fn2-sim-network)
   (b* (((mv input fn2-sim-network) (fn2-sdt-feed fragment input (fn2-sdconn-cap-index 0 fn2-sdconn) (fn2-sdconn-cap-nonce 0 fn2-sdconn) fn2-sim-network))
        ((mv status expected n fn2-sim-network) (fn2-sdt-drain 4096 expected (fn2-sdconn-cap-index 0 fn2-sdconn) (fn2-sdconn-cap-nonce 0 fn2-sdconn) fn2-sim-network)))
    (mv status input expected n fn2-sim-network))
   (mv status input expected n fn2-sim))))
(defun fn2-sdt-harvest (fn2-sdconn fn2-core)
 (declare (xargs :stobjs (fn2-sdconn fn2-core) :verify-guards nil))
 (b* (((mv found op gen ?cell event outcome ?reason count a b fn2-core) (fn2-harvest-one fn2-core))
      ((unless found) (mv :ok fn2-sdconn fn2-core)))
  (fn2-sd-observe op gen event outcome count a b fn2-sdconn fn2-core)))

(defthm fn2-sdt-countdown
 (implies (not (zp x)) (o< (nfix (- x 1)) (nfix x))) :rule-classes nil)
(defthm fn2-sdt-count-op (o-p (nfix x)) :rule-classes nil)

(defun fn2-sdt-rounds (fuel fragment failure input expected read-count uncertain-seen fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)
  :hints (("Goal" :use ((:instance fn2-sdt-countdown (x fuel)) (:instance fn2-sdt-count-op (x fuel))) :in-theory nil))))
 (b* (((when (zp fuel)) (mv (list :fuel input expected) read-count uncertain-seen fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own))
      ((mv status input expected n fn2-sim) (fn2-sdt-client fragment input expected fn2-sdconn fn2-sim))
      (read-count (+ read-count n))
      ((unless (eq status :ok)) (mv status read-count uncertain-seen fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own))
      ((when (and (null input) (null expected) (= (fn2-sdconn-phase 0 fn2-sdconn) *fn2-sdconn-state-done*)))
       (mv :pass read-count uncertain-seen fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own))
      ((mv bytes steps descriptors ?runnable fn2-sdconn fn2-core fn2-sprint-c) (fn2-sd-run 0 4 fn2-sdconn fn2-core fn2-sprint-c))
      ((unless (and (<= bytes 4096) (<= steps 32) (<= descriptors 4)))
       (mv :budget read-count uncertain-seen fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own))
      (uncertain-seen (or uncertain-seen (= (fn2-sdconn-outcome 0 fn2-sdconn) 2)))
      ; A simulator takes actual descriptors and physically copies pool bytes.
      ((mv ?took fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
      ((mv found flight) (fn2-sim-next-flight fn2-sim))
      ((mv ?advanced fn2-core fn2-sim fn2-own)
       (if found
        (if (= (fn2-sim-kind flight fn2-sim) *fn2-action-accept*)
         (fn2-sim-echo-accept flight 26 4096 t fn2-core fn2-sim fn2-own)
         (fn2-sim-complete flight
          (if (and failure (= (fn2-sim-kind flight fn2-sim) *fn2-action-fence*)) 23 26)
          4096 fn2-core fn2-sim fn2-own))
        (mv nil fn2-core fn2-sim fn2-own)))
      ((mv ?observe fn2-sdconn fn2-core) (fn2-sdt-harvest fn2-sdconn fn2-core))
      (own (fn2-check-own fn2-core fn2-own))
      ((unless (eq own :pass)) (mv own read-count uncertain-seen fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own)))
  (fn2-sdt-rounds (- fuel 1) fragment failure input expected read-count uncertain-seen fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own)))
(defun fn2-sdt-durable-bytes (bytes offset fn2-sim-storage)
 (declare (xargs :stobjs fn2-sim-storage :verify-guards nil))
 (if (atom bytes) t
  (and (< (nfix offset) (fn2-sim-storage-rows fn2-sim-storage))
       (= (car bytes) (fn2-sim-storage-durable offset fn2-sim-storage))
       (fn2-sdt-durable-bytes (cdr bytes) (+ 1 (nfix offset)) fn2-sim-storage))))
(defun fn2-sdt-run (fragment failure fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own) :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-sdt-profile* fn2-core))
      (fn2-sprint-c (fn2-sc-init 8 fn2-sprint-c))
      (fn2-sdconn (fn2-sdconn-prepare 1 0 1 fn2-sdconn))
      (fn2-sdconn (fn2-sdconn-put 0
        (article-limit (cdr (assoc-eq :max-article-octets *fn2-sd-supported-profile*)))
        (storage-bytes (* 4096 (fn2-sim-sectors *fn2-sdt-profile*)))))
      ((mv code rx rgen fn2-core) (fn2-core-reserve 0 250 0 1 fn2-core))
      ((unless (eq code :ok)) (mv (list :init code) fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own))
      ((mv code tx tgen fn2-core) (fn2-core-reserve 0 250 0 1 fn2-core))
      ((unless (eq code :ok)) (mv (list :init code) fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own))
      (fn2-sdconn (fn2-sdconn-put 0 (rx-slot rx) (rx-gen rgen) (tx-slot tx) (tx-gen tgen)))
      ((mv code fn2-core fn2-sprint-c) (fn2-sdt-seed *fn2-sdt-one* 1 fn2-core fn2-sprint-c))
      ((unless (eq code :ok)) (mv (list :init code) fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own))
      ((mv code fn2-core fn2-sprint-c) (fn2-sdt-seed *fn2-sdt-far* 100 fn2-core fn2-sprint-c))
      ((unless (eq code :ok)) (mv (list :init code) fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own))
      (fn2-sim (fn2-sim-init 20261028 :none :sprint-cd *fn2-sdt-profile* fn2-sim))
      (fn2-sim (stobj-let ((fn2-sim-network (fn2-sim-net fn2-sim)))
                 (fn2-sim-network) (fn2-network-restart fn2-sim-network) fn2-sim))
      (fn2-own (fn2-own-init *fn2-sdt-profile* fn2-own))
      ((mv status n uncertainty fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own)
       (fn2-sdt-rounds 10000 fragment failure (if failure *fn2-sdt-failure-input* *fn2-sdt-input*)
        (if failure *fn2-sdt-failure-expected* *fn2-sdt-expected*) 0 nil fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own))
      (count (fn2-sc-count fn2-sprint-c))
      (outcome (fn2-sdconn-outcome 0 fn2-sdconn))
      (writes (fn2-sim-action-countsi *fn2-action-write* fn2-sim))
      (fences (fn2-sim-action-countsi *fn2-action-fence* fn2-sim))
      (durable (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim)))
                 (ok) (fn2-sdt-durable-bytes *fn2-sdt-new* (if failure 4096 16384) fn2-sim-storage) ok))
      (pass (and (if failure (not durable) durable) (eq status :pass) uncertainty (= count (if failure 2 3))
                 (= outcome (if failure 2 3)) (= writes 1) (= fences 1))))
  (progn$ (cw "D EXCHANGE fragment=~x0 fence-failure=~x1 WIRE/OWN=~x2 bytes=~x3 C-rows=~x4 outcome=~x5 saw-uncertain=~x6 writes=~x7 fences=~x8 durable=~x9~%"
             fragment failure (if pass :pass (if (eq status :pass) (list :postcondition-failure n count outcome uncertainty writes fences durable) status)) n count outcome uncertainty writes fences durable)
   (mv (list (if pass :pass (if (eq status :pass) (list :postcondition-failure n count outcome uncertainty writes fences durable) status)) n count outcome uncertainty writes fences) fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own))))
(defun fn2-sdt-example (fragment failure)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-sdconn
  (mv-let (answer fn2-sdconn)
   (with-local-stobj fn2-core
    (mv-let (answer fn2-sdconn fn2-core)
     (with-local-stobj fn2-sprint-c
      (mv-let (answer fn2-sdconn fn2-core fn2-sprint-c)
       (with-local-stobj fn2-sim
        (mv-let (answer fn2-sdconn fn2-core fn2-sprint-c fn2-sim)
         (with-local-stobj fn2-own
          (mv-let (answer fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own)
           (fn2-sdt-run fragment failure fn2-sdconn fn2-core fn2-sprint-c fn2-sim fn2-own)
           (mv answer fn2-sdconn fn2-core fn2-sprint-c fn2-sim)))
         (mv answer fn2-sdconn fn2-core fn2-sprint-c)))
       (mv answer fn2-sdconn fn2-core)))
     (mv answer fn2-sdconn)))
   answer)))

; Control: a full RX window retains GROU after a consumed prefix. Compaction
; must preserve the tail and scan position, then the appended suffix dispatches.
(defun fn2-sdt-padding (n)
 (declare (xargs :verify-guards nil :measure (nfix n)))
 (if (zp n) nil (cons 65 (fn2-sdt-padding (- n 1)))))
(defun fn2-sdt-compact-check (fn2-sdconn fn2-core fn2-sprint-c)
 (declare (xargs :stobjs (fn2-sdconn fn2-core fn2-sprint-c) :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-sdt-profile* fn2-core))
      (fn2-sprint-c (fn2-sc-init 8 fn2-sprint-c))
      (fn2-sdconn (fn2-sdconn-prepare 1 0 1 fn2-sdconn))
      ((mv ?code rx rg fn2-core) (fn2-core-reserve 0 250 0 1 fn2-core))
      ((mv ?code tx tg fn2-core) (fn2-core-reserve 0 250 0 1 fn2-core))
      ((mv ?code fn2-core) (fn2-sdt-write (append (fn2-sdt-padding 4092) '(71 82 79 85)) 0 rx rg fn2-core))
      (fn2-sdconn (fn2-sdconn-put 0 (rx-slot rx) (rx-gen rg) (tx-slot tx) (tx-gen tg)
                    (start 4092) (scan 4095) (phase *fn2-sdconn-state-command*)))
      ((mv ?b ?s ?d ?r fn2-sdconn fn2-core fn2-sprint-c) (fn2-sd-receive fn2-sdconn fn2-core fn2-sprint-c))
      (started (= (fn2-sdconn-wait-reason 0 fn2-sdconn) 4))
      ((mv b1 ?s ?d ?r fn2-sdconn fn2-core fn2-sprint-c) (fn2-sd-input 0 32 nil fn2-sdconn fn2-core fn2-sprint-c))
      ((mv b2 ?s ?d ?r fn2-sdconn fn2-core fn2-sprint-c) (fn2-sd-input 0 32 nil fn2-sdconn fn2-core fn2-sprint-c))
      (rebased (and (= (fn2-sd-fill rx fn2-core) 4) (= (fn2-sdconn-start 0 fn2-sdconn) 0)
                    (= (fn2-sdconn-scan 0 fn2-sdconn) 3) (= (fn2-sdconn-wait-reason 0 fn2-sdconn) 0)))
      ((mv ?code fn2-core) (fn2-sdt-write '(80 32 116 101 115 116 13 10) 4 rx rg fn2-core))
      ((mv ?b ?s ?d ?r fn2-sdconn fn2-core fn2-sprint-c) (fn2-sd-input 0 32 nil fn2-sdconn fn2-core fn2-sprint-c))
      (pass (and started rebased (= b1 8) (= b2 8)
                 (= (fn2-sdconn-phase 0 fn2-sdconn) *fn2-sdconn-state-group-select*)
                 (= (fn2-sdconn-query 0 fn2-sdconn) 1))))
  (progn$ (cw "D COMPACTION started=~x0 rebased=~x1 copy-quanta=(~x2 ~x3) GROUP-dispatched=~x4~%" started rebased b1 b2 pass)
   (mv pass fn2-sdconn fn2-core fn2-sprint-c))))
(defun fn2-sdt-compact-example ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-sdconn
  (mv-let (answer fn2-sdconn)
   (with-local-stobj fn2-core
    (mv-let (answer fn2-sdconn fn2-core)
     (with-local-stobj fn2-sprint-c
      (mv-let (answer fn2-sdconn fn2-core fn2-sprint-c)
       (fn2-sdt-compact-check fn2-sdconn fn2-core fn2-sprint-c)
       (mv answer fn2-sdconn fn2-core)))
     (mv answer fn2-sdconn)))
   answer)))

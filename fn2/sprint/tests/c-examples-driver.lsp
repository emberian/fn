(in-package "ACL2")
(set-prover-step-limit 5000000)
(set-cbd "fn2/sprint/tests/")
(include-book "c-examples")
(set-guard-checking nil)
:q
(handler-case
 (let ((report (fn2-sc-examples)))
  (format t "C EXAMPLES ~S~%" report)
  (assert (eq (second report) :sealed-volatile))
  (assert (eq (getf report :check) :ok))
  (assert (eq (getf report :corruption) :bad-hash))
  (assert (eq (getf report :immutable) :state))
  (assert (getf report :source-reclaimed))
  (assert (eq (getf report :malformed) :malformed-entry))
  (assert (eq (getf report :bad-phase) :state))
  (assert (getf report :summary-cuts))
  (assert (getf report :summary-mutant))
  (assert (equal (getf report :lookup)
   '(:present :found 1 :absent :absent :yield :yield 1 :resume :found 1 :same-tag t :different-octets :different)))
  (assert (equal (getf report :cursor)
   '(:first (:yield 0 2 900 54) :resume (:done 2 1 1000000 27) :byte-yield (:yield 0 1 2 27))))
  (assert (equal (getf report :page-lookup)
   '(:present :found 1 :tag 42 :absent :absent :yield :yield 1 :resume :found 1 :other-id :found 0 :same-tag t)))
  (format t "C SEAL / EXACT-IDENTITY / SPARSE-CURSOR / SUMMARY PASS~%")
  (format t "SPRINT-EXAMPLE-PASS c-examples-driver~%")
  (sb-ext:exit :code 0))
 (cl:error (condition) (format t "C EXAMPLES ERROR: ~A~%" condition) (sb-ext:exit :code 1)))

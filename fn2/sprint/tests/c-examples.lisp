(in-package "ACL2")
(include-book "../c/page-lookup")
(include-book "../../books/format-check")

; Fixture writing is the only byte-list entry. Runtime C uses pool handles.
(defun fn2-sc-test-write (xs slot off fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (if (atom xs) fn2-pool
  (mv-let (code fn2-pool) (fn2-pool-write slot 1 off (car xs) 250 0 1 fn2-pool)
   (declare (ignore code))
   (fn2-sc-test-write (cdr xs) slot (+ off 1) fn2-pool))))
(defun fn2-sc-test-reserve (left fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix left)))
 (if (zp left) fn2-pool
  (mv-let (code slot gen fn2-pool) (fn2-pool-reserve 0 250 0 1 fn2-pool)
   (declare (ignore code slot gen))
   (fn2-sc-test-reserve (- left 1) fn2-pool))))
(defun fn2-sc-test-malform (left off fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix left)))
 (if (zp left) fn2-pool
  (mv-let (code fn2-pool) (fn2-pool-write 12 1 off 128 250 0 1 fn2-pool)
   (declare (ignore code))
   (fn2-sc-test-malform (- left 1) (+ off 1) fn2-pool))))
(defun fn2-sc-test-init (fn2-sprint-c fn2-pool fn2-fields fn2-b3 fn2-fc)
 (declare (xargs :stobjs (fn2-sprint-c fn2-pool fn2-fields fn2-b3 fn2-fc) :verify-guards nil))
 (b* ((fn2-sprint-c (fn2-sc-init 64 fn2-sprint-c))
      (fn2-pool (fn2-pool-init '((12 . 256) (1 . 65536)) 1 100 fn2-pool))
      (fn2-pool (fn2-sc-test-reserve 12 fn2-pool))
      ((mv code slot gen fn2-pool) (fn2-pool-reserve 1 250 0 1 fn2-pool))
      (- code slot gen)
      (fn2-fields (fn2-fields-init 128 fn2-fields))
      (fn2-b3 (fn2-b3-table-init 1 fn2-b3))
      (fn2-fc (fn2-fc-init 1 fn2-fc))
      (fn2-pool (fn2-sc-test-write '(60 97 64 120 62) 0 0 fn2-pool))
      (fn2-pool (fn2-sc-test-write '(60 98 64 120 62) 1 0 fn2-pool))
      (fn2-pool (fn2-sc-test-write '(60 99 64 120 62) 2 0 fn2-pool))
      (fn2-pool (fn2-sc-test-write '(60 100 64 120 62) 3 0 fn2-pool))
      (fn2-pool (fn2-sc-test-write '(60 98 64 120 62) 4 0 fn2-pool))
      (fn2-pool (fn2-sc-test-write '(60 122 64 120 62) 5 0 fn2-pool))
      (fn2-pool (fn2-sc-test-write '(72 101 108 108 111 13 10) 6 0 fn2-pool))
      (fn2-pool (fn2-sc-test-write '(60 97 64 120 62) 7 0 fn2-pool))
      ((mv code row fn2-sprint-c) (fn2-sc-add 7 2 0 1 0 5 6 1 0 7 42 fn2-sprint-c))
      (- code row)
      ((mv code row fn2-sprint-c) (fn2-sc-add 7 900 1 1 0 5 6 1 0 7 42 fn2-sprint-c))
      (- code row)
      ((mv code row fn2-sprint-c) (fn2-sc-add 7 1000000 2 1 0 5 6 1 0 7 43 fn2-sprint-c))
      (- code row)
      ((mv code row fn2-sprint-c) (fn2-sc-add 8 1 3 1 0 5 6 1 0 7 44 fn2-sprint-c))
      (- code row))
  (mv fn2-sprint-c fn2-pool fn2-fields fn2-b3 fn2-fc)))
(defun fn2-sc-test-cuts (cut fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c :verify-guards nil :measure (nfix (- 5 (nfix cut)))))
 (if (>= (nfix cut) 5) t
  (and (= (fn2-sc-fold cut 4 (fn2-sc-fold 0 cut 0 fn2-sprint-c) fn2-sprint-c)
          (fn2-sc-fold 0 4 0 fn2-sprint-c))
       (fn2-sc-test-cuts (+ 1 (nfix cut)) fn2-sprint-c))))
(defun fn2-sc-test-lookups (fn2-sprint-c fn2-pool)
 (declare (xargs :stobjs (fn2-sprint-c fn2-pool) :verify-guards nil))
 (b* (((mv present row next) (fn2-sc-lookup 4 1 0 5 250 0 1 0 32 fn2-pool fn2-sprint-c))
      (- next)
      ((mv absent arow anext) (fn2-sc-lookup 5 1 0 5 250 0 1 0 32 fn2-pool fn2-sprint-c))
      (- arow anext)
      ((mv yielded yrow ynext) (fn2-sc-lookup 4 1 0 5 250 0 1 0 1 fn2-pool fn2-sprint-c))
      (- yrow)
      ((mv resumed rrow rnext) (fn2-sc-lookup 4 1 0 5 250 0 1 ynext 1 fn2-pool fn2-sprint-c))
      (- rnext)
      ((mv same-tag same-work) (fn2-sc-compare 0 1 0 1 1 0 5 250 0 1 fn2-pool))
      (- same-work))
  (list :present present row :absent absent :yield yielded ynext :resume resumed rrow
        :same-tag (= (fn2-sc-row-content-tag 0 fn2-sprint-c) (fn2-sc-row-content-tag 1 fn2-sprint-c))
        :different-octets same-tag)))
(defun fn2-sc-test-cursor (fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c :verify-guards nil))
 (b* (((mv code first count key bytes) (fn2-sc-cursor 7 0 1000000 2 4096 fn2-sprint-c))
      ((mv code2 first2 count2 key2 bytes2) (fn2-sc-cursor 7 key 1000000 2 4096 fn2-sprint-c))
      ((mv code3 first3 count3 key3 bytes3) (fn2-sc-cursor 7 0 1000000 32 40 fn2-sprint-c)))
  (list :first (list code first count key bytes) :resume (list code2 first2 count2 key2 bytes2)
        :byte-yield (list code3 first3 count3 key3 bytes3))))
(defun fn2-sc-test-seal-drive (fuel calls fn2-sc-sealer fn2-sprint-c fn2-fields fn2-b3 fn2-pool)
 (declare (xargs :stobjs (fn2-sc-sealer fn2-sprint-c fn2-fields fn2-b3 fn2-pool)
                 :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :driver-budget calls fn2-sc-sealer fn2-sprint-c fn2-fields fn2-b3 fn2-pool)
  (mv-let (code fn2-sc-sealer fn2-sprint-c fn2-fields fn2-b3 fn2-pool)
   (fn2-sc-seal-step 12 1 250 0 1 fn2-sc-sealer fn2-sprint-c fn2-fields fn2-b3 fn2-pool)
   (if (eq code :more)
       (fn2-sc-test-seal-drive (- fuel 1) (+ calls 1) fn2-sc-sealer fn2-sprint-c fn2-fields fn2-b3 fn2-pool)
    (mv code (+ calls 1) fn2-sc-sealer fn2-sprint-c fn2-fields fn2-b3 fn2-pool)))))
(defun fn2-sc-test-check-drive (fuel calls fn2-fc fn2-b3 fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fc fn2-b3 fn2-fields fn2-pool) :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :driver-budget calls fn2-fc fn2-b3 fn2-fields fn2-pool)
  (mv-let (code fn2-fc fn2-b3 fn2-fields fn2-pool)
   (fn2-format-check-page 0 12 1 0 65536 96 250 0 1 4096 fn2-fc fn2-b3 fn2-fields fn2-pool)
   (if (eq code :more)
       (fn2-sc-test-check-drive (- fuel 1) (+ calls 1) fn2-fc fn2-b3 fn2-fields fn2-pool)
    (mv code (+ calls 1) fn2-fc fn2-b3 fn2-fields fn2-pool)))))
(defun fn2-sc-test-context (d0 d1 d2 d3 d4 d5 d6 d7 fn2-fields)
 (declare (xargs :stobjs fn2-fields :verify-guards nil))
 (let* ((fn2-fields (fn2-sc-set-field 96 17 fn2-fields))
        (fn2-fields (fn2-sc-set-field 97 1 fn2-fields))
        (fn2-fields (fn2-sc-set-field 98 1 fn2-fields))
        (fn2-fields (fn2-sc-set-field 99 1 fn2-fields))
        (fn2-fields (fn2-sc-set-field 100 1 fn2-fields))
        (fn2-fields (fn2-sc-set-field 102 0 fn2-fields))
        (fn2-fields (fn2-sc-set-field 103 65536 fn2-fields))
        (fn2-fields (fn2-sc-set-field 104 d0 fn2-fields))
        (fn2-fields (fn2-sc-set-field 105 d1 fn2-fields))
        (fn2-fields (fn2-sc-set-field 106 d2 fn2-fields))
        (fn2-fields (fn2-sc-set-field 107 d3 fn2-fields))
        (fn2-fields (fn2-sc-set-field 108 d4 fn2-fields))
        (fn2-fields (fn2-sc-set-field 109 d5 fn2-fields))
        (fn2-fields (fn2-sc-set-field 110 d6 fn2-fields))
        (fn2-fields (fn2-sc-set-field 111 d7 fn2-fields))) fn2-fields))
(defun fn2-sc-test-page-lookups (fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* (((mv present row next tag fn2-fields)
       (fn2-sc-page-lookup 4 1 0 5 12 1 0 4 250 0 1 fn2-fields fn2-pool))
      (- next)
      ((mv absent ar an atag fn2-fields)
       (fn2-sc-page-lookup 5 1 0 5 12 1 0 4 250 0 1 fn2-fields fn2-pool))
      (- ar an atag)
      ((mv yielded yr yn yt fn2-fields)
       (fn2-sc-page-lookup 4 1 0 5 12 1 0 1 250 0 1 fn2-fields fn2-pool))
      (- yr yt)
      ((mv resumed rr rn rt fn2-fields)
       (fn2-sc-page-lookup 4 1 0 5 12 1 yn 1 250 0 1 fn2-fields fn2-pool))
      (- rn rt)
      ((mv first fr fn ft fn2-fields)
       (fn2-sc-page-lookup 7 1 0 5 12 1 0 4 250 0 1 fn2-fields fn2-pool))
      (- fn))
  (mv (list :present present row :tag tag :absent absent :yield yielded yn
            :resume resumed rr :other-id first fr :same-tag (= ft tag)) fn2-fields)))
(defun fn2-sc-test-run (fn2-sc-sealer fn2-sprint-c fn2-pool fn2-fields fn2-b3 fn2-fc)
 (declare (xargs :stobjs (fn2-sc-sealer fn2-sprint-c fn2-pool fn2-fields fn2-b3 fn2-fc) :verify-guards nil))
 (b* (((mv fn2-sprint-c fn2-pool fn2-fields fn2-b3 fn2-fc)
       (fn2-sc-test-init fn2-sprint-c fn2-pool fn2-fields fn2-b3 fn2-fc))
      (fn2-sc-sealer (fn2-sc-seal-init fn2-sc-sealer fn2-sprint-c))
      ((mv seal-code seal-calls fn2-sc-sealer fn2-sprint-c fn2-fields fn2-b3 fn2-pool)
       (fn2-sc-test-seal-drive 100 0 fn2-sc-sealer fn2-sprint-c fn2-fields fn2-b3 fn2-pool))
      ((mv d0 d1 d2 d3 d4 d5 d6 d7) (fn2-b3-finalize 0 fn2-b3))
      (fn2-fields (fn2-sc-test-context d0 d1 d2 d3 d4 d5 d6 d7 fn2-fields))
      ((mv check-code check-calls fn2-fc fn2-b3 fn2-fields fn2-pool)
       (fn2-sc-test-check-drive 100 0 fn2-fc fn2-b3 fn2-fields fn2-pool))
      (lookups (fn2-sc-test-lookups fn2-sprint-c fn2-pool))
      ((mv released fn2-pool) (fn2-pool-release 0 1 250 0 1 fn2-pool))
      (- released)
      ((mv released fn2-pool) (fn2-pool-release 1 1 250 0 1 fn2-pool))
      (- released)
      ((mv released fn2-pool) (fn2-pool-release 2 1 250 0 1 fn2-pool))
      (- released)
      ((mv released fn2-pool) (fn2-pool-release 3 1 250 0 1 fn2-pool))
      (- released)
      ((mv released fn2-pool) (fn2-pool-release 6 1 250 0 1 fn2-pool))
      (- released)
      (original-unreadable
       (and (not (eq (fn2-pool-readable-code 0 1 250 0 1 fn2-pool) :ok))
            (not (eq (fn2-pool-readable-code 1 1 250 0 1 fn2-pool) :ok))
            (not (eq (fn2-pool-readable-code 2 1 250 0 1 fn2-pool) :ok))
            (not (eq (fn2-pool-readable-code 3 1 250 0 1 fn2-pool) :ok))
            (not (eq (fn2-pool-readable-code 6 1 250 0 1 fn2-pool) :ok))))
      ((mv page-lookups fn2-fields) (fn2-sc-test-page-lookups fn2-fields fn2-pool))
      (cursor (fn2-sc-test-cursor fn2-sprint-c))
      (cuts (fn2-sc-test-cuts 0 fn2-sprint-c))
      (summary (fn2-sc-fold 0 2 0 fn2-sprint-c))
      (bad-summary (not (= (fn2-sc-fold 2 4 (+ summary 1) fn2-sprint-c)
                           (fn2-sc-fold 0 4 0 fn2-sprint-c))))
      ((mv immutable fn2-pool) (fn2-pool-write 12 1 73 8 250 0 1 fn2-pool))
      ((mv released fn2-pool) (fn2-pool-release-out 12 1 fn2-pool))
      (- released)
      ((mv corrupt fn2-pool) (fn2-pool-write 12 1 73 8 250 0 1 fn2-pool))
      (- corrupt)
      (fn2-fc (fn2-fc-reset 0 fn2-fc))
      ((mv corrupt-code corrupt-calls fn2-fc fn2-b3 fn2-fields fn2-pool)
       (fn2-sc-test-check-drive 100 0 fn2-fc fn2-b3 fn2-fields fn2-pool))
      (- corrupt-calls)
      (fn2-pool (fn2-sc-test-malform 1000 73 fn2-pool))
      (fn2-pool (fn2-sc-test-write '(0 8 0 0) 12 69 fn2-pool))
      (fn2-pool (fn2-sc-test-write '(73 0 0 0) 12 2048 fn2-pool))
      ((mv malformed mr mn mt fn2-fields)
       (fn2-sc-page-lookup 4 1 0 5 12 1 0 4 250 0 1 fn2-fields fn2-pool))
      (- mr mn mt)
      (fn2-sc-sealer (fn2-sc-sealer-set-phase 0 8 fn2-sc-sealer))
      ((mv bad-phase fn2-sc-sealer fn2-sprint-c fn2-fields fn2-b3 fn2-pool)
       (fn2-sc-seal-step 12 1 250 0 1 fn2-sc-sealer fn2-sprint-c fn2-fields fn2-b3 fn2-pool))
      (report (list :seal seal-code :seal-calls seal-calls :digest (list d0 d1 d2 d3 d4 d5 d6 d7)
               :check check-code :check-calls check-calls :immutable immutable :corruption corrupt-code
               :lookup lookups :page-lookup page-lookups :source-reclaimed original-unreadable
               :cursor cursor :summary-cuts cuts :summary-mutant bad-summary
               :malformed malformed :bad-phase bad-phase)))
  (mv report fn2-sc-sealer fn2-sprint-c fn2-pool fn2-fields fn2-b3 fn2-fc)))
(defun fn2-sc-examples ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-sc-sealer
  (mv-let (report fn2-sc-sealer)
   (with-local-stobj fn2-sprint-c
    (mv-let (report fn2-sc-sealer fn2-sprint-c)
     (with-local-stobj fn2-pool
      (mv-let (report fn2-sc-sealer fn2-sprint-c fn2-pool)
       (with-local-stobj fn2-fields
        (mv-let (report fn2-sc-sealer fn2-sprint-c fn2-pool fn2-fields)
         (with-local-stobj fn2-b3
          (mv-let (report fn2-sc-sealer fn2-sprint-c fn2-pool fn2-fields fn2-b3)
           (with-local-stobj fn2-fc
            (mv-let (report fn2-sc-sealer fn2-sprint-c fn2-pool fn2-fields fn2-b3 fn2-fc)
             (fn2-sc-test-run fn2-sc-sealer fn2-sprint-c fn2-pool fn2-fields fn2-b3 fn2-fc)
             (mv report fn2-sc-sealer fn2-sprint-c fn2-pool fn2-fields fn2-b3)))
           (mv report fn2-sc-sealer fn2-sprint-c fn2-pool fn2-fields)))
         (mv report fn2-sc-sealer fn2-sprint-c fn2-pool)))
       (mv report fn2-sc-sealer fn2-sprint-c)))
     (mv report fn2-sc-sealer)))
   report)))

; Sol's independent composed admission control, over the actual C/D subjects.
(in-package "ACL2")
(include-book "d-exchange")
(include-book "../d/owed")

(defun fn2-sprint-outbox-count (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
  (n) (fn2-outbox-queued fn2-ops) n))

(defun fn2-sprint-admission-run (fn2-sdconn fn2-core fn2-sprint-c)
 (declare (xargs :stobjs (fn2-sdconn fn2-core fn2-sprint-c) :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-sdt-profile* fn2-core))
      (fn2-sprint-c (fn2-sc-init 1 fn2-sprint-c))
      (fn2-sdconn (fn2-sdconn-prepare 1 0 1 fn2-sdconn))
      (fn2-sdconn (fn2-sdconn-put 0
                    (article-limit (cdr (assoc-eq :max-article-octets *fn2-sd-supported-profile*)))
                    (storage-bytes (* 4096 (fn2-sim-sectors *fn2-sdt-profile*)))))
      ((mv code fn2-core fn2-sprint-c)
       (fn2-sdt-seed *fn2-sdt-one* 1 fn2-core fn2-sprint-c))
      ((unless (eq code :ok)) (mv (list :seed code) fn2-sdconn fn2-core fn2-sprint-c))
      ((mv code up gen fn2-core) (fn2-core-reserve 0 250 0 1 fn2-core))
      ((unless (eq code :ok)) (mv (list :reserve code) fn2-sdconn fn2-core fn2-sprint-c))
      ((mv code fn2-core) (fn2-sdt-write *fn2-sdt-new* 0 up gen fn2-core))
      ((unless (eq code :ok)) (mv (list :fill code) fn2-sdconn fn2-core fn2-sprint-c))
      (fn2-sdconn (fn2-sdconn-put 0 (phase *fn2-sdconn-state-post-check*)
                    (up-slot up) (up-gen gen) (mid-off 12) (mid-len 10)
                    (post-len (len *fn2-sdt-new*)) (ordinal 1)))
      (before (fn2-sd-inv fn2-sdconn fn2-core fn2-sprint-c))
      ((mv bytes steps descriptors runnable fn2-sdconn fn2-core fn2-sprint-c)
       (fn2-sd-run 0 4 fn2-sdconn fn2-core fn2-sprint-c))
      (after (fn2-sd-inv fn2-sdconn fn2-core fn2-sprint-c))
      (full-safe (and before after (<= bytes 4096) (<= steps 32)
                      (= descriptors 0) runnable (= (fn2-sprint-outbox-count fn2-core) 0)
                      (= (fn2-sdconn-phase 0 fn2-sdconn) *fn2-sdconn-state-post-check*)
                      (= (fn2-sdconn-outcome 0 fn2-sdconn) 0)
                      (= (fn2-sc-count fn2-sprint-c) 1)))
      ; Remove the invariant premise with a concrete invalid TX continuation.
      ; The actual next run retains it, falsifying the same post-invariant.
      (fn2-sdconn (fn2-sdconn-put 0 (tx-off 1) (tx-len 0)))
      (bad-before (not (fn2-sd-inv fn2-sdconn fn2-core fn2-sprint-c)))
      ((mv bytes steps descriptors runnable fn2-sdconn fn2-core fn2-sprint-c)
       (fn2-sd-run 0 4 fn2-sdconn fn2-core fn2-sprint-c))
      (- bytes steps descriptors runnable)
      (bad-after (not (fn2-sd-inv fn2-sdconn fn2-core fn2-sprint-c)))
      (report (list :full-c-no-write full-safe :T1-shape-positive (and before after)
                    :T1-invariant-removal (and bad-before bad-after))))
  (mv report fn2-sdconn fn2-core fn2-sprint-c)))

(defun fn2-sprint-admission-control ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-sdconn
  (mv-let (answer fn2-sdconn)
   (with-local-stobj fn2-core
    (mv-let (answer fn2-sdconn fn2-core)
     (with-local-stobj fn2-sprint-c
      (mv-let (answer fn2-sdconn fn2-core fn2-sprint-c)
       (fn2-sprint-admission-run fn2-sdconn fn2-core fn2-sprint-c)
       (mv answer fn2-sdconn fn2-core)))
     (mv answer fn2-sdconn)))
   answer)))

(defun fn2-sc-key< (ga na gb nb)
 (declare (xargs :guard (and (natp ga) (natp na) (natp gb) (natp nb))))
 (or (< ga gb) (and (= ga gb) (< na nb))))
(defun fn2-sc-add (group number mid-slot mid-gen mid-off mid-len
                  body-slot body-gen body-off body-len content-tag fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c :verify-guards nil))
 (let ((row (fn2-sc-used fn2-sprint-c)))
  (cond
   ((not (and (unsigned-byte-p 60 group) (unsigned-byte-p 60 number)
              (< 0 number) (unsigned-byte-p 32 mid-slot) (unsigned-byte-p 60 mid-gen)
              (unsigned-byte-p 32 mid-off) (posp mid-len) (<= mid-len 250)
              (unsigned-byte-p 32 body-slot) (unsigned-byte-p 60 body-gen)
              (unsigned-byte-p 32 body-off) (unsigned-byte-p 32 body-len)
              (unsigned-byte-p 60 content-tag))) (mv :bounds row fn2-sprint-c))
   ((>= row (fn2-sprint-c-rows fn2-sprint-c)) (mv :exhausted row fn2-sprint-c))
   ((and (< 0 row)
         (not (fn2-sc-key< (fn2-sc-row-group (- row 1) fn2-sprint-c)
                           (fn2-sc-row-number (- row 1) fn2-sprint-c) group number)))
    (mv :nonincreasing row fn2-sprint-c))
   (t (let* ((fn2-sprint-c (fn2-sprint-c-set-group row group fn2-sprint-c))
             (fn2-sprint-c (fn2-sprint-c-set-number row number fn2-sprint-c))
             (fn2-sprint-c (fn2-sprint-c-set-mid-slot row mid-slot fn2-sprint-c))
             (fn2-sprint-c (fn2-sprint-c-set-mid-gen row mid-gen fn2-sprint-c))
             (fn2-sprint-c (fn2-sprint-c-set-mid-off row mid-off fn2-sprint-c))
             (fn2-sprint-c (fn2-sprint-c-set-mid-len row mid-len fn2-sprint-c))
             (fn2-sprint-c (fn2-sprint-c-set-body-slot row body-slot fn2-sprint-c))
             (fn2-sprint-c (fn2-sprint-c-set-body-gen row body-gen fn2-sprint-c))
             (fn2-sprint-c (fn2-sprint-c-set-body-off row body-off fn2-sprint-c))
             (fn2-sprint-c (fn2-sprint-c-set-body-len row body-len fn2-sprint-c))
             (fn2-sprint-c (fn2-sprint-c-set-content-tag row content-tag fn2-sprint-c))
             (fn2-sprint-c (update-fn2-sc-used (+ row 1) fn2-sprint-c)))
        (mv :ok row fn2-sprint-c))))))

; Length is capped by the supported Message-ID profile, not retained history.
(defun fn2-sc-compare (slot gen off rslot rgen roff left okind oslot ogen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :equal 0)
  (b* (((mv code a) (fn2-pool-read slot gen off okind oslot ogen fn2-pool))
       ((unless (eq code :ok)) (mv code 0))
       ((mv code b) (fn2-pool-read rslot rgen roff okind oslot ogen fn2-pool))
       ((unless (eq code :ok)) (mv code 0))
       ((unless (= a b)) (mv :different 1))
       ((mv code work) (fn2-sc-compare slot gen (+ off 1) rslot rgen (+ roff 1)
                                           (- left 1) okind oslot ogen fn2-pool)))
    (mv code (+ 1 work)))))
(defun fn2-sc-lookup-loop (slot gen off len okind oslot ogen row fuel bytes fn2-pool fn2-sprint-c)
 (declare (xargs :stobjs (fn2-pool fn2-sprint-c) :verify-guards nil :measure (nfix fuel)))
 (cond ((>= (nfix row) (fn2-sc-count fn2-sprint-c)) (mv :absent 0 row))
       ((or (zp fuel) (< (nfix bytes) (nfix len))) (mv :yield 0 row))
       ((not (= len (fn2-sc-row-mid-len row fn2-sprint-c)))
        (fn2-sc-lookup-loop slot gen off len okind oslot ogen (+ 1 row) (- fuel 1) bytes fn2-pool fn2-sprint-c))
       (t (mv-let (code work)
            (fn2-sc-compare slot gen off (fn2-sc-row-mid-slot row fn2-sprint-c)
             (fn2-sc-row-mid-gen row fn2-sprint-c) (fn2-sc-row-mid-off row fn2-sprint-c)
             len okind oslot ogen fn2-pool)
            (cond ((eq code :equal) (mv :found row (+ 1 row)))
                  ((not (eq code :different)) (mv code 0 row))
                  (t (fn2-sc-lookup-loop slot gen off len okind oslot ogen (+ 1 row) (- fuel 1)
                                         (- bytes work) fn2-pool fn2-sprint-c)))))))
(defun fn2-sc-lookup (slot gen off len okind oslot ogen start fuel fn2-pool fn2-sprint-c)
 (declare (xargs :stobjs (fn2-pool fn2-sprint-c) :verify-guards nil))
 (if (not (and (unsigned-byte-p 32 start) (natp fuel) (unsigned-byte-p 32 off)
                (posp len) (<= len 250))) (mv :bounds 0 start)
  (let ((code (fn2-pool-readable-code slot gen okind oslot ogen fn2-pool)))
   (cond ((not (eq code :ok)) (mv code 0 start))
         ((> (+ off len) (fn2-pool-slot-fill slot fn2-pool)) (mv :bounds 0 start))
         (t
          ; Two pool reads per compared octet: at most 4096 pool reads.
          (fn2-sc-lookup-loop slot gen off len okind oslot ogen start (min 32 fuel) 2048 fn2-pool fn2-sprint-c))))))

(defun fn2-sc-number (group number start fuel fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c :verify-guards nil :measure (nfix fuel)))
 (cond ((>= (nfix start) (fn2-sc-count fn2-sprint-c)) (mv :absent 0 start))
       ((zp fuel) (mv :yield 0 start))
       ((and (= group (fn2-sc-row-group start fn2-sprint-c))
             (= number (fn2-sc-row-number start fn2-sprint-c))) (mv :found start (+ 1 start)))
       ((fn2-sc-key< group number (fn2-sc-row-group start fn2-sprint-c)
                                (fn2-sc-row-number start fn2-sprint-c)) (mv :absent 0 start))
       (t (fn2-sc-number group number (+ 1 (nfix start)) (- (min 32 (nfix fuel)) 1) fn2-sprint-c))))
(defun fn2-sc-group (group start fuel count low high fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c :verify-guards nil :measure (nfix fuel)))
 (cond ((>= (nfix start) (fn2-sc-count fn2-sprint-c)) (mv :done start count low high))
       ((zp fuel) (mv :yield start count low high))
       ((> (fn2-sc-row-group start fn2-sprint-c) group) (mv :done start count low high))
       (t (let* ((hit (= group (fn2-sc-row-group start fn2-sprint-c)))
                 (n (fn2-sc-row-number start fn2-sprint-c)))
            (fn2-sc-group group (+ 1 (nfix start)) (- (min 32 (nfix fuel)) 1)
             (if hit (+ 1 (nfix count)) count) (if (and hit (= (nfix count) 0)) n low)
             (if hit n high) fn2-sprint-c)))))

; Binary seek across stored keys, independent of a sparse group's number gaps.
; Returns remaining structural fuel, shared with the bounded output batch.
(defun fn2-sc-seek (group after lo hi fuel fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c :verify-guards nil :measure (nfix fuel)))
 (cond ((>= (nfix lo) (nfix hi)) (mv :ok lo hi fuel))
       ((zp fuel) (mv :seek-budget lo hi 0))
       (t (let ((mid (floor (+ (nfix lo) (nfix hi)) 2)))
            (if (or (< (fn2-sc-row-group mid fn2-sprint-c) group)
                    (and (= (fn2-sc-row-group mid fn2-sprint-c) group)
                         (<= (fn2-sc-row-number mid fn2-sprint-c) after)))
                (fn2-sc-seek group after (+ mid 1) hi (- fuel 1) fn2-sprint-c)
              (fn2-sc-seek group after lo mid (- fuel 1) fn2-sprint-c))))))
(defun fn2-sc-overview-size (row fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c :verify-guards nil))
 ; Sprint wire shape: number + TAB + exact Message-ID + CRLF, decimal <=19.
 (+ 22 (fn2-sc-row-mid-len row fn2-sprint-c)))
(defun fn2-sc-cursor-loop (group max-number row first count resume bytes entries budget fuel fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c :verify-guards nil :measure (nfix fuel)))
 (cond ((or (>= (nfix row) (fn2-sc-count fn2-sprint-c))
            (not (= group (fn2-sc-row-group row fn2-sprint-c)))
            (> (fn2-sc-row-number row fn2-sprint-c) max-number)) (mv :done first count resume bytes))
       ((or (zp fuel) (>= (nfix count) (nfix entries))) (mv :yield first count resume bytes))
       ((> (+ bytes (fn2-sc-overview-size row fn2-sprint-c)) budget)
        (mv (if (zp count) :entry-budget :yield) first count resume bytes))
       (t (fn2-sc-cursor-loop group max-number (+ 1 (nfix row)) first (+ 1 (nfix count))
             (fn2-sc-row-number row fn2-sprint-c) (+ bytes (fn2-sc-overview-size row fn2-sprint-c))
             entries budget (- fuel 1) fn2-sprint-c))))
; Extended cursor preserves a binary seek across a yield. phase=0 seeks within
; [lo,hi); phase=1 starts output at lo. The stable key resumes the next batch;
; lo/hi/phase only resume an unfinished seek before any entry was emitted.
(defun fn2-sc-cursor-step (group after-number max-number entry-budget byte-budget lo hi phase fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c :verify-guards nil))
 (if (not (and (natp group) (natp after-number) (natp max-number)
                (posp entry-budget) (posp byte-budget)
                (natp lo) (natp hi) (<= lo hi) (<= hi (fn2-sc-count fn2-sprint-c))
                (member phase '(0 1))))
     (mv :bounds 0 0 after-number 0 lo hi phase)
  (mv-let (code row top fuel)
   (if (= phase 1) (mv :ok lo hi 32)
    (fn2-sc-seek group after-number lo hi 32 fn2-sprint-c))
   (if (or (not (eq code :ok)) (zp fuel))
       (mv :yield row 0 after-number 0 row top (if (eq code :ok) 1 0))
    (mv-let (code first count key bytes)
     (fn2-sc-cursor-loop group max-number row row 0 after-number 0
                         (min 32 entry-budget) (min 4096 byte-budget) fuel fn2-sprint-c)
     (mv code first count key bytes 0 (fn2-sc-count fn2-sprint-c) 0))))))
(defun fn2-sc-cursor (group after-number max-number entry-budget byte-budget fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c :verify-guards nil))
 (mv-let (code first count key bytes lo hi phase)
  (fn2-sc-cursor-step group after-number max-number entry-budget byte-budget
                     0 (fn2-sc-count fn2-sprint-c) 0 fn2-sprint-c)
  (declare (ignore lo hi phase))
  (mv (if (and (eq code :yield) (equal count 0)) :cursor-continuation-needed code)
      first count key bytes)))

; Executable summary fold over scalar article tags; concrete bytes remain pool handles.
(defun fn2-sc-fold (lo hi sum fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c :verify-guards nil :measure (nfix (- (nfix hi) (nfix lo)))))
 (if (or (>= (nfix lo) (nfix hi)) (>= (nfix lo) (fn2-sc-count fn2-sprint-c))) (nfix sum)
  (fn2-sc-fold (+ 1 (nfix lo)) hi (+ (nfix sum) (fn2-sc-row-content-tag lo fn2-sprint-c)) fn2-sprint-c)))
(defthm-owed fn2-sc-summary-equation (cut summary fn2-sprint-c)
 (implies (equal summary (fn2-sc-fold 0 cut 0 fn2-sprint-c))
  (equal (fn2-sc-fold cut (fn2-sc-count fn2-sprint-c) summary fn2-sprint-c)
         (fn2-sc-fold 0 (fn2-sc-count fn2-sprint-c) 0 fn2-sprint-c)))
 :teeth "tests/c-examples checks every cut of a four-record run; changing a summary value changes the result."
 :doc "Sprint scalar fold only. Durable fold schema/coverage/root commitments still owed.")
(defthm-owed fn2-sc-identity-exactness
 (slot gen off len okind oslot ogen start fuel fn2-pool fn2-sprint-c)
 (implies (equal (mv-nth 0 (fn2-sc-lookup slot gen off len okind oslot ogen start fuel fn2-pool fn2-sprint-c)) :found)
  (let ((row (mv-nth 1 (fn2-sc-lookup slot gen off len okind oslot ogen start fuel fn2-pool fn2-sprint-c))))
   (and (equal len (fn2-sc-row-mid-len row fn2-sprint-c))
        (equal (take len (nthcdr off (fn2-pool-bytes-view slot fn2-pool)))
               (take len (nthcdr (fn2-sc-row-mid-off row fn2-sprint-c)
                                 (fn2-pool-bytes-view (fn2-sc-row-mid-slot row fn2-sprint-c) fn2-pool)))))))
 :teeth "tests/c-examples uses same content tag for distinct exact Message-IDs and verifies row selection."
 :doc "Owed, not admitted as a theorem. Equality is exact bytes, never content-tag equality.")

; Sprint ordered metadata run + active append overlay. Bytes never leave A's pool.
(in-package "ACL2")
(include-book "../../books/pool")
(include-book "../../books/owed")
(include-book "std/util/bstar" :dir :system)

(defcolumns fn2-sprint-c
 ((group :u60) (number :u60) (mid-slot :u32) (mid-gen :u60)
  (mid-off :u32) (mid-len :u32) (body-slot :u32) (body-gen :u60)
  (body-off :u32) (body-len :u32) (content-tag :u60))
 :init-name fn2-sc-columns-init
 :extra-fields ((fn2-sc-used :type (unsigned-byte 32) :initially 0)
                (fn2-sc-sealed :type (unsigned-byte 32) :initially 0)))

(defun fn2-sc-init (capacity fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c :guard (unsigned-byte-p 32 capacity)))
 (let* ((fn2-sprint-c (fn2-sc-columns-init capacity fn2-sprint-c))
        (fn2-sprint-c (update-fn2-sc-used 0 fn2-sprint-c))
        (fn2-sprint-c (update-fn2-sc-sealed 0 fn2-sprint-c))) fn2-sprint-c))
(defun fn2-sc-count (fn2-sprint-c)
 (declare (xargs :stobjs fn2-sprint-c)) (fn2-sc-used fn2-sprint-c))


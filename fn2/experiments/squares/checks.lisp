; E1 Q1 iteration checker and allocator monitor. No proof claim.
(in-package "ACL2")
(include-book "../../books/reference")

(defun fn2-e1-catalogue-machine (name phases observations)
  (declare (xargs :verify-guards nil :measure (+ (acl2-count phases) (acl2-count observations))))
  (if (consp phases)
      (cons (list :run name (car phases))
            (fn2-e1-catalogue-machine name (cdr phases) observations))
    (if (consp observations)
        (cons (list :observe name (caar observations))
              (fn2-e1-catalogue-machine name nil (cdr observations))) nil)))
(defun fn2-e1-catalogue (names world)
  (declare (xargs :verify-guards nil))
  (if (atom names) nil
    (append (fn2-e1-catalogue-machine (car names)
              (fn2-machine-property (car names) :states world)
              (fn2-machine-property (car names) :observes world))
            (fn2-e1-catalogue (cdr names) world))))
(make-event
 (value `(defconst *fn2-e1-labels*
           ',(append (fn2-e1-catalogue (fn2-machine-names (w state)) (w state))
                     '((:router :fallback) (:executor :clock) (:executor :signal)
                       (:executor :service 0) (:executor :service 1)
                       (:executor :service 2) (:executor :service 3)
                       (:executor :empty-principal))))))
(assert-event (equal (len *fn2-e1-labels*) 39))
(defun fn2-e1-phase-map (names world)
  (declare (xargs :verify-guards nil))
  (if (atom names) nil
    (cons (cons (car names) (fn2-machine-property (car names) :states world))
          (fn2-e1-phase-map (cdr names) world))))
(make-event (value `(defconst *fn2-e1-phases*
                      ',(fn2-e1-phase-map (fn2-machine-names (w state)) (w state)))))

(defun fn2-e1-next-event (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (event)
    (let* ((index (fn2-ops-posted-fifoi (fn2-ops-post-head fn2-ops) fn2-ops))
           (slot (floor index 2)) (cell (mod index 2)))
      (mv-let (p h event o r c a b) (fn2-op-cell cell slot fn2-ops)
        (declare (ignore p h o r c a b)) event)) event))
(defun fn2-e1-clockp (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (yes)
    (= (fn2-ops-clock-posted fn2-ops) 1) yes))
(defun fn2-e1-label (lists fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (cond
   ((fn2-core-posted-p fn2-core)
    (mv-let (found kind id gen principal) (fn2-core-next-owner fn2-core)
      (declare (ignore principal))
      (let* ((event (fn2-e1-next-event fn2-core))
             (name (car (nth kind *fn2-e1-phases*)))
             (label (list :observe name (fn2-event-code->keyword event))))
        (if (and found (fn2-machine-idp id fn2-core)
                 (equal gen (fn2-machine-generation id fn2-core))
                 (equal kind (fn2-machine-kind id fn2-core))
                 (fn2-machine-observe-accepts-p kind (fn2-machine-phase id fn2-core) event)
                 (member-equal label *fn2-e1-labels*)) label '(:router :fallback)))))
   ((fn2-exec-observation-p fn2-core)
    (if (fn2-e1-clockp fn2-core) '(:executor :clock) '(:executor :signal)))
   ((fn2-exec-eligible-p fn2-core)
    (let* ((entry (nth (nth 1 lists) (nth 0 lists)))
           (queue (fn2-ref-queue (cadr entry) (nth 2 lists))) (id (car queue)))
      (cond ((eq (car entry) :service) (list :executor :service (cadr entry)))
            ((atom queue) '(:executor :empty-principal))
            ((or (not (fn2-machine-idp id fn2-core)) (= (fn2-machine-stopped id fn2-core) 1))
             '(:outside-catalogue :stopped-or-invalid))
            (t (let* ((entry (nth (fn2-machine-kind id fn2-core) *fn2-e1-phases*))
                      (phase (nth (fn2-machine-phase id fn2-core) (cdr entry))))
                 (if phase (list :run (car entry) phase) '(:outside-catalogue :invalid-phase)))))))
   (t '(:outside-catalogue :no-transition))))

; Normalization writes exactly the two reference work counters. The runner
; supplies rb/rs accumulated independently from reference return values.
(defun fn2-e1-g1-step (budget rb rs lists fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (b* ((before (fn2-ref-difference fn2-core fn2-ref-core lists))
       ((mv o v a b s fn2-core) (fn2-transition t budget fn2-core))
       (fn2-core (fn2-exec-account-work b s fn2-core))
       ((mv ro rv ra rbytes rsteps lists fn2-ref-core)
        (fn2-ref-transition budget lists fn2-ref-core))
       (rb (+ (nfix rb) (nfix rbytes))) (rs (+ (nfix rs) (nfix rsteps)))
       (fn2-ref-core (fn2-exec-set-turn-bytes rb fn2-ref-core))
       (fn2-ref-core (fn2-exec-set-turn-steps rs fn2-ref-core))
       (error (or before
                  (and (not (equal (list o v a b s) (list ro rv ra rbytes rsteps)))
                       (list :five-results (list o v a b s) (list ro rv ra rbytes rsteps)))
                  (fn2-ref-difference fn2-core fn2-ref-core lists)
                  (and (not (and (fn2-core-wfp fn2-core) (fn2-core-wfp fn2-ref-core)))
                       '(:loop-shape-invariant)))))
    (mv error (list o v a rb rs) lists fn2-core fn2-ref-core)))

(defun fn2-e1-free-chain (fuel id fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
  (cond ((equal id 4294967295) nil)
        ((or (zp fuel) (not (fn2-machine-idp id fn2-core))
             (not (equal (fn2-machine-kind id fn2-core) *fn2-echo-kind*))) '(:bad-chain))
        (t (mv-let (gen next) (fn2-echo-free-fields id fn2-core)
             (declare (ignore gen))
             (cons id (fn2-e1-free-chain (- (nfix fuel) 1) next fn2-core))))))
(defun fn2-e1-allocator-rows (fuel id free fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
  (if (zp fuel) (mv nil 0)
    (mv-let (error active) (fn2-e1-allocator-rows (- (nfix fuel) 1) (+ (nfix id) 1) free fn2-core)
      (let ((phase (fn2-machine-phase id fn2-core)))
        (mv (or error
                (and (not (iff (member-equal id free) (equal phase *fn2-echo-state-free*)))
                     (list :free-membership id phase)))
            (+ active (if (member-equal phase (list *fn2-echo-state-free* *fn2-echo-state-retired*)) 0 1)))))))
(defun fn2-e1-allocator-check (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (let* ((n (fn2-machine-connection-count fn2-core))
         (free (fn2-e1-free-chain (+ 1 n) (fn2-machine-free-head fn2-core) fn2-core)))
    (mv-let (error active) (fn2-e1-allocator-rows n (fn2-machine-kind-base *fn2-echo-kind* fn2-core) free fn2-core)
      (or (and (or (member-eq :bad-chain free) (not (no-duplicatesp-equal free))) '(:free-chain))
          error (and (not (equal active (fn2-machine-active-count fn2-core))) '(:active-count))))))
(in-theory (disable fn2-e1-label fn2-e1-g1-step fn2-e1-allocator-check))

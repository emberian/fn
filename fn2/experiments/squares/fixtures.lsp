; Supplied deep prefixes are controls, not evidence search found their states.
(in-package "ACL2")
(defun e1-flight (world kind fault word)
 (let ((sim (e1-world-sim world)))
  (loop for slot below (fn2-sim-rows sim)
   when (and (= (fn2-sim-active slot sim) 1) (= (fn2-sim-kind slot sim) kind))
   return (fn2-e1-occurrence slot fault word sim))))
(defun e1-land-kind (world kind fault word)
 (let ((choice (e1-flight world kind fault word)))
  (unless choice (error "Fixture has no enabled operation ~S" kind))
  (e1-step choice world)))
(defun e1-listener-prefix ()
 (let ((world (e1-new)))
  (e1-settle world)
  (e1-land-kind world *fn2-action-accept* 26 0)
  (e1-step '(:client 0) world)
  (e1-settle world)
  (e1-land-kind world *fn2-action-receive* 3 0)
  (e1-settle world)
  (unless (and (e1-flight world *fn2-action-accept* 26 0)
               (e1-flight world *fn2-action-close* 26 0))
   (error "Listener fixture did not reach coenabled Accept and Close"))
  world))
(defun e1-send-prefix ()
 (let ((world (e1-new)))
  (e1-settle world)
  (e1-land-kind world *fn2-action-accept* 26 0)
  (e1-step '(:client 1) world)
  (e1-settle world)
  (e1-land-kind world *fn2-action-receive* 26 0)
  (e1-settle world)
  (unless (e1-flight world *fn2-action-send* 1 0) (error "Send fixture has no Send"))
  world))
(defun e1-complete-closes (world)
 (dotimes (i 8)
  (let ((close (e1-flight world *fn2-action-close* 26 0)))
   (unless close (return))
   (e1-step close world) (e1-settle world)))
 world)
(defun e1-negative-control ()
 (let* ((world (e1-listener-prefix)) (prefix (e1-world-choices world))
        (a (e1-flight world *fn2-action-accept* 26 0))
        (b (e1-flight world *fn2-action-close* 26 0)))
  (e1-save "fn2/experiments/squares/results/listener-prefix.sexp" prefix)
  (e1-save "fn2/experiments/squares/results/listener-state.sexp"
   (list :profile *e1-profile* :prefix prefix :a a :b b
         :free-head (fn2-machine-free-head (e1-world-core world))
         :active-count (fn2-machine-active-count (e1-world-core world))
         :connection-count (fn2-machine-connection-count (e1-world-core world))
         :cursor (e1-world-cursor world) :queues (e1-world-queues world)))
  (assert (e1-independent a b :different-capability))
  (assert (not (e1-independent a b :different-capability-and-allocator-disjoint)))
  (let ((ab (e1-route prefix a b)) (ba (e1-route prefix b a)))
   (e1-inc :g2)
   (assert (and (eq (car ab) :legal) (eq (car ba) :legal)))
   (e1-save "fn2/experiments/squares/results/listener-routes.sexp" (list :ab ab :ba ba))
   (unless (not (equal (second ab) (second ba))) (error "M1 negative control did not distinguish client observations"))
   (list :negative-control-refuted :ab ab :ba ba))))

(defun e1-exact-value (value)
 (cond ((consp value) (cons (e1-exact-value (car value)) (e1-exact-value (cdr value))))
       ((and (vectorp value) (not (stringp value))) (map 'vector #'e1-exact-value value))
       ((stringp value) (copy-seq value)) (t value)))
(defun e1-exact-state (world)
 (e1-exact-value (list (e1-world-core world) (e1-world-ref world)
                      (e1-world-sim world) (e1-world-own world)
                      (e1-world-clients world) (e1-world-cursor world) (e1-world-queues world))))
(defun e1-replay-control ()
 (e1-save "fn2/experiments/squares/results/domain-payloads.sexp"
  (loop for word in '(0 1) collect
   (let* ((mixed (fn2-prng-mix32 (1+ word)))
          (record (fn2-echo-client-new 2 mixed nil 0 *e1-profile*)))
    (list :client-word word :constructor-word mixed :payload (second record)
          :drop-offset (sixth record) :disconnect-turn (nth 8 record)))))
 (let* ((*e1-byte-history* nil) (*e1-close-history* nil)
        (world (e1-send-prefix)) (prefix (e1-world-choices world))
        (first (e1-observation world)) (exact (e1-exact-state world))
        (first-choices (e1-choices world)))
  ; Advancing one branch must not affect a fresh replay of the prefix.
  (e1-land-kind world *fn2-action-send* 1 0)
  (let ((*e1-byte-history* nil) (*e1-close-history* nil))
   (let ((replayed (e1-replay prefix)))
    (assert (equalp exact (e1-exact-state replayed)))
    (assert (equal first (e1-observation replayed)))
    (assert (equal first-choices (e1-choices replayed)))
    (e1-save "fn2/experiments/squares/results/send-prefix.sexp" prefix)
    (list :replay-control-pass :exact-core-reference-sim-own-client-state t
          :branch-isolation t :boundaries (length prefix))))))

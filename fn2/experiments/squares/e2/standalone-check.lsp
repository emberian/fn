; Executable source smoke only: no ACL2 theorem admission or certification.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defun natp (x) (and (integerp x) (>= x 0)))
(defun posp (x) (and (integerp x) (> x 0)))
(defun nfix (x) (if (natp x) x 0))
(defun zp (x) (not (posp x)))
(defun true-listp (x) (if (consp x) (true-listp (cdr x)) (null x)))
(defun member-eq (x xs) (member x xs :test #'eq))
(defun union-eq (x y) (union x y :test #'eq))
(defun intern-in-package-of-symbol (s sym) (intern s (symbol-package sym)))
(defun load-functions (path &optional assertions)
  (with-open-file (in path)
    (loop for form = (read in nil :eof) until (eq form :eof) do
      (case (car form)
        (defun (eval `(defun ,(cadr form) ,(caddr form)
                       ,@(remove-if (lambda (x) (and (consp x) (eq (car x) 'declare)
                                                     (consp (cadr x))
                                                     (eq (caadr x) 'xargs)))
                                    (cdddr form)))))
        (defconst (eval `(defparameter ,(cadr form) ,(caddr form))))
        (mutual-recursion
         (dolist (f (cdr form))
           (eval `(defun ,(cadr f) ,(caddr f) ,@(remove-if
                 (lambda (x) (and (consp x) (eq (car x) 'declare))) (cdddr f))))))
        (assert-event (when assertions (assert (eval (cadr form)))))))))
(dolist (name '("defsquare" "read-state-history" "read-state-summary" "read-state-teeth"
                "q4-checker" "q4-template" "q4-square"))
  (load-functions (format nil "fn2/experiments/squares/e2/~a.lisp" name)
                  (equal name "q4-checker")))
(dolist (kind '(:read :catchup :malformed :composition :converter))
  (let ((got (sq-q4-checker (list :case kind) (car (sq-q4-evidence kind)))))
    (assert (equal got '(:reached 1 :exercised 1 :verdict :pass)))
    (format t "Q4 smoke ~s ~s~%" kind got)))
(format t "Q4 smoke: five fixture cases, two evaluated teeth, and unexercised/bad-pre controls passed. Not ACL2 certification.~%")

; Read every experiment book and driver with a real Common Lisp reader.
(dolist (path (append (directory "fn2/experiments/squares/e2/*.lisp")
                     (directory "fn2/experiments/squares/e2/*.lsp")))
  (with-open-file (stream path)
    (loop for form = (read stream nil :eof) until (eq form :eof))))
(format t "E2 reader: all .lisp/.lsp files parsed.~%")

(load "fn2/experiments/squares/e2/checker.lsp")
(setf *sq-revision* "standalone-smoke-no-ACL2-admission")
(setf *sq-runtime-rows*
      (loop for kind in '(:read :catchup :malformed :composition :converter)
            for id = (intern (format nil "SQ-SMOKE-~A" kind))
            collect (cons id
                          (list :id id :owner '(:correspondence sq-smoke)
                                :template :smoke :contract '(:relation rs-same-reads)
                                :statement id :case kind :proof '(:owed)
                                :teeth '(:positive sq-q4-positive :negative sq-q4-negative)
                                :checker '(:function sq-q4-checker)
                                :evidence (sq-q4-evidence kind) :checks nil))))
(sq-run-declared-evidence)
(assert (sq-report))
(dolist (entry *sq-runtime-rows*)
  (assert (equal (getf (cdr entry) :proof) '(:owed)))
  (assert (= (getf (car (getf (cdr entry) :checks)) :exercised) 1)))
(let* ((row (cdar *sq-runtime-rows*))
       (scope '(:profile :read-state :domain :wrong-case :horizon 1 :unit :call
                :location "standalone-check.lsp"))
       (sample (car (sq-q4-evidence :catchup))))
  (assert (eq (getf (sq-check-row row sample scope) :verdict) :unexercised))
  (assert (eq (getf (car (last (getf row :checks))) :verdict) :unexercised)))
(format t "E2 runtime: real Q4 adapters dispatched, evidence appended, owed unchanged, unexercised retained.~%")
(format t "E2 STANDALONE PASS (no ACL2 admission, certification, or Q1 campaigns).~%")

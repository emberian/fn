; Common Lisp experiment orchestration. Semantic calls go through ACL2 books.
(in-package "ACL2")
(defparameter *e1-profile* (put-assoc-equal :c 1 (put-assoc-equal :accept-credits 1 *fn2-profile-tiny*)))
(defvar *e1-stat* nil)
(defvar *e1-label-counts* nil)
(defvar *e1-replay* nil)
(defvar *e1-g1* nil)
(defvar *e1-deadline* nil)
(defvar *e1-cap* 200000)
(defvar *e1-boundary* 0)
(defvar *e1-schedule* nil)
(defvar *e1-draws* nil)
(defvar *e1-record-random* nil)
(defvar *e1-replay-tape* nil)
(defvar *e1-replay-tapep* nil)
(defvar *e1-byte-history* nil)
(defvar *e1-close-history* nil)
(defvar *e1-hooks* nil)
(defvar *e1-g1-enabled* t)
(defvar *e1-trials* 0)
(defvar *e1-baseline-seed* nil)
(defun e1-inc (key &optional (n 1)) (incf (getf *e1-stat* key 0) n))
(defun e1-seconds () (/ (get-internal-real-time) (float internal-time-units-per-second 1d0)))
(defun e1-total () (loop for k in '(:core :reference :replayed-core :replayed-reference) sum (getf *e1-stat* k 0)))
(defun e1-limit ()
 (when (and *e1-deadline* (>= (e1-seconds) *e1-deadline*)) (throw 'e1-stop '(:censored :wall)))
 (when (>= (e1-total) *e1-cap*) (throw 'e1-stop '(:censored :transitions))))
(defun e1-fail (contract detail)
 (throw 'e1-stop (list :found contract :boundary *e1-boundary* :detail detail
                      :schedule (copy-tree *e1-schedule*) :random-draws (reverse *e1-draws*))))
(defvar *e1-hook-stack* nil)
(defun e1-wrap (name wrapper)
 (dolist (symbol (remove-duplicates (list name (*1*-symbol name))))
  (when (fboundp symbol)
   (let* ((old (symbol-function symbol)) (wrapped (funcall wrapper old)))
    (push (cons symbol old) *e1-hooks*)
    (setf (symbol-function symbol)
     (lambda (&rest args)
      (if (member name *e1-hook-stack*) (apply old args)
       (let ((*e1-hook-stack* (cons name *e1-hook-stack*))) (apply wrapped args)))))))))
(defun e1-both (name wrapper) (e1-wrap name wrapper))
(defvar *e1-counting* nil)
(defun e1-install ()
 (dolist (pair '((fn2-transition :core :replayed-core) (fn2-ref-transition :reference :replayed-reference)))
  (let ((key (second pair)) (replay (third pair)))
   (e1-both (first pair)
    (lambda (old) (lambda (&rest args)
      (if (member key *e1-counting*) (apply old args)
       (let ((*e1-counting* (cons key *e1-counting*)))
        (e1-inc (if *e1-replay* replay key)) (e1-limit) (apply old args))))))))
 (dolist (name '(fn2-sim-complete fn2-sim-echo-accept))
  (e1-wrap name (lambda (old) (lambda (&rest args)
   (e1-inc (if *e1-replay* :replayed-adapter :adapter)) (apply old args)))))
 ; Shared allocator monitor, at the baseline's existing per-turn cadence.
 (e1-wrap 'fn2-echo-check-turn
  (lambda (old) (lambda (&rest args)
   (let ((values (multiple-value-list (apply old args))))
    (let ((allocator (fn2-e1-allocator-check (nth 6 args))))
     (when allocator (e1-fail :allocator allocator)))
    (unless (eq (car values) :pass) (e1-fail :turn-monitors (car values)))
    (values-list values)))))
 ; All configurations observe the actual byte stream and same byte oracle.
 (e1-wrap 'fn2-network-client-read
  (lambda (old) (lambda (cap nonce net)
   (multiple-value-bind (code byte net) (funcall old cap nonce net)
    (when (eq code :ok) (push (list cap nonce byte) *e1-byte-history*))
    (values code byte net)))))
 (e1-wrap 'fn2-echo-client-round
  (lambda (old) (lambda (&rest args)
   (let ((values (multiple-value-list (apply old args))))
    (unless (eq (car values) :pass) (e1-fail :client-oracle (car values)))
    (values-list values)))))
 (e1-wrap 'fn2-network-close
  (lambda (old) (lambda (cap nonce net)
    (let ((before (fn2-network-cap-code cap nonce net)))
     (multiple-value-bind (code net) (funcall old cap nonce net)
      (when (and (eq before :ok) (eq code :ok))
       (push (list cap nonce :closed) *e1-close-history*))
      (values code net))))))
 ; Same declared latency monitor for baseline, random lists, enumeration.
 (e1-wrap 'fn2-sim-delay-flight
  (lambda (old) (lambda (slot fault word sim)
   (e1-inc (if *e1-replay* :replayed-adapter :adapter))
   (let ((now (fn2-sim-now sim)))
    (let ((sim (funcall old slot fault word sim)))
     (when (member fault '(2 14))
      (let ((expected (min #xfffffffffffffff (+ now (if (= fault 2) 100 (nth (mod word 3) '(1000 10000 100000)))))))
       (unless (= expected (fn2-sim-due slot sim))
        (e1-fail :adapter-class-latency (list slot fault word now expected (fn2-sim-due slot sim))))))
     sim)))))
 (e1-wrap 'fn2-sim-random
  (lambda (old) (lambda (sim)
   (when (and *e1-replay-tapep* (null *e1-replay-tape*))
     (throw 'e1-stop '(:replay-prefix-exhausted)))
   (multiple-value-bind (word sim) (funcall old sim)
    (when *e1-replay-tapep* (setf word (pop *e1-replay-tape*)))
    (when *e1-record-random* (push word *e1-draws*)) (values word sim)))))
 (e1-wrap 'fn2-check-trace-turn
  (lambda (old) (lambda (profile cursor queues core ref)
   (when *e1-baseline-seed* (incf *e1-boundary*))
   (funcall old profile cursor queues core ref)))))

(defstruct e1-world core ref sim own clients (cursor 0) queues (choices nil))
(defun e1-new ()
 (let* ((core (fn2-init-executor *e1-profile* :echo t (create-fn2-core)))
        (ref (fn2-ref-reset *e1-profile* core (create-fn2-ref-core)))
        (sim (fn2-sim-echo-network-reset (fn2-sim-init 0 :none "E1@137695dfc" *e1-profile* (create-fn2-sim))))
        (own (fn2-own-init *e1-profile* (create-fn2-own)))
        (net (fn2-sim-net sim)))
  (make-e1-world :core core :ref ref :sim sim :own own
    :clients (fn2-echo-clients-init (fn2-sim-network-rows net) net)
    :queues (fn2-echo-initial-queues *e1-profile*))))

(defun e1-g1-turn (world)
 (let* ((*e1-g1* t)
        (core (fn2-ref-copy-core (e1-world-core world) (fn2-core-init *e1-profile* (create-fn2-core))))
        (ref (fn2-ref-copy-core (e1-world-ref world) (fn2-core-init *e1-profile* (create-fn2-ref-core))))
        (lists (fn2-ref-lists (fn2-profile-p *e1-profile*) (e1-world-cursor world) (e1-world-queues world)))
        (h (fn2-exec-h core)) (k (fn2-exec-k core)) (a (fn2-exec-aturn core))
        (obs 0) (visits 0) (actions 0) (rb 0) (rs 0))
  (setf ref (fn2-ref-import-boundary core ref)
        core (fn2-exec-set-turn-steps 0 (fn2-exec-set-turn-bytes 0 core))
        ref (fn2-exec-set-turn-steps 0 (fn2-exec-set-turn-bytes 0 ref)))
  (let ((entry (fn2-ref-difference core ref lists))) (when entry (e1-fail :g1-entry entry)))
  (loop for fuel downfrom (+ h k) do
   (let* ((cc (and (> fuel 0) (< obs h) (< visits k) (< actions a)
                   (= 0 (fn2-exec-stop core))
                   (or (fn2-exec-observation-p core) (fn2-exec-eligible-p core))))
          (rc (and (> fuel 0) (< obs h) (< visits k) (< actions a)
                   (eq (fn2-ref-status lists ref) :more))))
    (unless (eq (not (null cc)) (not (null rc))) (e1-fail :g1-continue (list cc rc)))
    (unless cc (return))
    (let ((label (fn2-e1-label lists core)))
     (incf (cdr (or (assoc label *e1-label-counts* :test #'equal)
                   (car (push (cons label 0) *e1-label-counts*)))))
     (multiple-value-bind (error out next c r) (fn2-e1-g1-step (- a actions) rb rs lists core ref)
      (e1-inc :g1)
      (when error (e1-fail :g1 (list label error)))
      (setf lists next core c ref r rb (fourth out) rs (fifth out))
      (incf obs (first out)) (incf visits (second out)) (incf actions (third out))))))
  (unless (and (equal (fn2-turn-status core) (fn2-ref-status lists ref))
               (<= obs h) (<= visits k) (<= actions a))
    (e1-fail :g1-exit (list obs visits actions)))
  (list (fn2-turn-status core) obs visits actions rb rs)))

(defun e1-turn (world)
 (let* ((g1 (and *e1-g1-enabled* (e1-g1-turn world)))
        (core (e1-world-core world)) (own (e1-world-own world))
        (before (fn2-echo-outbox-count core)))
  (multiple-value-bind (trace status no nv na cursor queues core ref)
    (fn2-check-trace-turn *e1-profile* (e1-world-cursor world) (e1-world-queues world) core (e1-world-ref world))
   (setf (e1-world-core world) core (e1-world-ref world) ref
         (e1-world-cursor world) cursor (e1-world-queues world) queues)
   (multiple-value-bind (verdict cert core own)
     (fn2-echo-check-turn *e1-profile* before trace no nv na core own)
    (declare (ignore cert))
    (setf (e1-world-core world) core (e1-world-own world) own)
    (unless (eq verdict :pass) (e1-fail :turn-monitors verdict)))
   (when (and g1 (not (equal (subseq g1 0 4) (list status no nv na))))
     (e1-fail :g1-composition (list g1 (list status no nv na))))
   status)))

(defun e1-choices (world)
 (let ((sim (e1-world-sim world)) (core (e1-world-core world)))
  (append (when (eq (fn2-turn-status core) :more) '((:turn)))
          (when (> (fn2-echo-outbox-count core) 0) '((:take 0) (:take 1)))
          '((:client 0) (:client 1))
          (loop for slot below (fn2-sim-rows sim)
           when (member (fn2-sim-active slot sim) '(1 2 3)) append
            (loop for fault in *fn2-e1-faults* append
             (loop for word in *fn2-e1-words* collect (fn2-e1-occurrence slot fault word sim)))))))
(defun e1-step (choice world)
 (setf *e1-boundary* (1+ (length (e1-world-choices world))))
 (unless (member choice (e1-choices world) :test #'equal)
   (e1-inc :rejected-prefixes) (throw 'e1-invalid (list :outside-enabled-domain choice)))
 (setf *e1-schedule* (append (e1-world-choices world) (list choice))
       (e1-world-choices world) *e1-schedule*)
 (e1-limit)
 (case (first choice)
  (:turn (e1-turn world))
  (:take
   (multiple-value-bind (found core sim own)
     (fn2-e1-take (second choice) (e1-world-core world) (e1-world-sim world) (e1-world-own world))
    (unless found (throw 'e1-invalid (list :handoff-refused choice)))
    (setf (e1-world-core world) core (e1-world-sim world) sim (e1-world-own world) own)))
  (:land
   (multiple-value-bind (found earliest) (fn2-sim-next-flight (e1-world-sim world))
    (when (and found (/= earliest (second choice))) (e1-inc :non-earliest)))
   (multiple-value-bind (tag core sim own)
     (fn2-e1-land choice (e1-world-core world) (e1-world-sim world) (e1-world-own world))
    (when (eq tag :rejected) (throw 'e1-invalid (list :occurrence-not-enabled choice)))
    (setf (e1-world-core world) core (e1-world-sim world) sim (e1-world-own world) own)))
  (:client
   (multiple-value-bind (verdict clients a e d c stats sim)
     (fn2-echo-client-round (e1-world-clients world) (second choice) nil *e1-profile* (e1-world-sim world))
    (declare (ignore a e d c stats))
    (unless (eq verdict :pass) (e1-fail :client-oracle verdict))
    (setf (e1-world-clients world) clients (e1-world-sim world) sim)))
  (otherwise (throw 'e1-invalid (list :unknown-choice choice))))
 (let ((own (fn2-check-own (e1-world-core world) (e1-world-own world))))
   (unless (eq own :pass) (e1-fail :own own)))
 world)
(defun e1-replay (prefix)
 (let ((*e1-replay* t) (*e1-boundary* 0) (*e1-schedule* nil))
  (let ((world (e1-new))) (dolist (choice prefix) (e1-step choice world)) world)))

; E1-CLIENT-OWN-STOP-v1. Per-capability byte histories are compared in order;
; close attempts and client terminal outcomes are retained per capability.
; Identifier correspondence is identity (cap index, nonce); no renaming.
(defun e1-group (history)
 (let ((keys (remove-duplicates (mapcar (lambda (e) (subseq e 0 2)) history) :test #'equal)))
  (mapcar (lambda (key) (cons key (loop for e in (reverse history) when (equal key (subseq e 0 2)) collect (third e))))
          (sort keys (lambda (a b) (or (< (first a) (first b)) (and (= (first a) (first b)) (< (second a) (second b)))))))))
(defun e1-observation (world)
 (list :e1-client-own-stop-v1 (e1-group *e1-byte-history*) (e1-group *e1-close-history*)
       (loop for record in (e1-world-clients world) collect (list (first record) (seventh record)))
       (fn2-check-own (e1-world-core world) (e1-world-own world))
       (fn2-core-stop-reason (e1-world-core world))))
(defun e1-capability (occ) (list (nth 5 occ) (nth 6 occ)))
(defun e1-footprint (occ)
 ; Every landing changes the clock, hits/operation counts or posted FIFO.
 ; Admission/reclamation also touch the single allocator. Conservative.
 (append (list :posted-fifo :shared-operation-counts :clock-mailbox
               (list :capability (e1-capability occ)))
         (when (member (nth 4 occ) (list *fn2-action-accept* *fn2-action-close*))
           '(:echo-free-head :active-count :connection-count :principal-0-fifo))))
(defun e1-independent (a b declaration)
 (and (/= (second a) (second b))
      (not (equal (e1-capability a) (e1-capability b)))
      (or (eq declaration :different-capability)
          (not (intersection (e1-footprint a) (e1-footprint b) :test #'equal)))))
(defun e1-settle (world &optional (fuel 32))
 ; Fixed matched continuation: only turns, descriptor handoffs and client
 ; reads/feeds. No additional physical result is invented or selected.
 (dotimes (i fuel)
  (cond ((eq (fn2-turn-status (e1-world-core world)) :more) (e1-step '(:turn) world))
        ((> (fn2-echo-outbox-count (e1-world-core world)) 0) (e1-step '(:take 0) world))
        (t (e1-step '(:client 0) world) (return))))
 world)
(defun e1-route (prefix a b)
 (let ((*e1-byte-history* nil) (*e1-close-history* nil) (*e1-replay* t))
  (catch 'e1-invalid
   (let ((world (e1-replay prefix)))
    (e1-step a world) (e1-step b world) (e1-settle world) (e1-complete-closes world)
    (list :legal (e1-observation world) (e1-world-choices world))))))
(defun e1-diamonds (world declaration)
 (let ((occurrences (remove-if-not
       (lambda (x) (and (eq (car x) :land)
                        (not (member (nth 7 x) '(2 14)))
                        (not (fn2-sim-wake-first-p t (second x) (e1-world-sim world)))))
       (e1-choices world))))
  (loop for tail on occurrences do
   (dolist (b (cdr tail))
    (let ((a (car tail)))
     (if (not (e1-independent a b declaration)) (e1-inc :rejected-candidates)
      (let* ((prefix (e1-world-choices world)) (ab (e1-route prefix a b)) (ba (e1-route prefix b a)))
       (e1-inc :g2)
       (cond ((not (and (eq (car ab) :legal) (eq (car ba) :legal))) (e1-inc :illegal-residual))
             ((not (equal (second ab) (second ba)))
              (setf *e1-schedule* prefix)
              (e1-fail :g2 (list :declaration declaration :a a :b b :ab ab :ba ba)))))))))))

(defun e1-save (path object)
 (with-open-file (s path :direction :output :if-exists :supersede)
  (let ((*print-readably* t) (*print-pretty* nil) (*print-length* nil) (*print-level* nil)) (write object :stream s) (terpri s))))
(defun e1-random-word (state) (mod (+ (* 1664525 state) 1013904223) (expt 2 32)))
(defun e1-random-campaign (seed declaration)
 (loop for trial from 1 do
  (incf *e1-trials*)
  (let ((world (e1-new)) (*e1-byte-history* nil) (*e1-close-history* nil))
   (dotimes (i 128)
    (e1-inc :states-reached) (e1-diamonds world declaration)
    (setf seed (e1-random-word seed))
    (let* ((choices (e1-choices world)) (choice (nth (mod seed (length choices)) choices)))
     (catch 'e1-invalid (e1-step choice world))))
   (e1-inc :states-reached) (e1-diamonds world declaration)) (e1-limit)))
(defun e1-enumerate (prefix horizon declaration)
 (e1-limit) (incf *e1-trials*) (e1-inc :prefixes-enumerated)
 (catch 'e1-invalid
  (let ((*e1-byte-history* nil) (*e1-close-history* nil))
   (let ((world (e1-replay prefix)))
    (e1-inc :states-reached) (e1-diamonds world declaration)
    (when (> horizon 0)
     (dolist (choice (e1-choices world)) (e1-enumerate (append prefix (list choice)) (1- horizon) declaration)))))))
(defun e1-replay-saved (saved)
 (let* ((result (getf saved :result)) (data (cddr result)))
  (cond
   ((equal (getf saved :config) "baseline")
    (let ((*e1-replay-tapep* t) (*e1-record-random* t)
          (*e1-replay-tape* (getf data :random-draws))
          (*e1-baseline-seed* (getf saved :seed)))
     (let ((answer (fn2-sim-run-echo (getf saved :seed) 2 *e1-profile*)))
      (unless (eq (car answer) :pass) (e1-fail :baseline answer))
      (let ((live (nth 9 answer)))
       (unless (and (eq (first live) :pass) (= (second live) (third live) 200)
                    (zerop (fourth live))) (e1-fail :baseline-liveness live))))))
   ((eq (second result) :g2)
    (let* ((detail (getf data :detail)) (prefix (getf data :schedule))
           (a (getf detail :a)) (b (getf detail :b))
           (ab (e1-route prefix a b)) (ba (e1-route prefix b a)))
     (unless (and (equal ab (getf detail :ab)) (equal ba (getf detail :ba)))
       (e1-fail :replay-mismatch (list ab ba)))
     (when (not (equal (second ab) (second ba)))
      (setf *e1-schedule* prefix)
      (e1-fail :g2 (list :declaration (getf detail :declaration) :a a :b b :ab ab :ba ba)))))
   (t (let ((*e1-replay* t) (world (e1-new)))
        (dolist (choice (getf data :schedule))
         (let ((invalid (catch 'e1-invalid (e1-step choice world) nil)))
          (when invalid
           (return-from e1-replay-saved
            (list :invalid-prefix :outside-enabled-domain :boundary *e1-boundary* :detail invalid)))))))))
 '(:completed :replay))

(defun e1-main ()
 (e1-install)
 (load "fn2/experiments/squares/fixtures.lsp")
 (let* ((config (or (sb-ext:posix-getenv "E1_CONFIG") "probe"))
        (seed (parse-integer (or (sb-ext:posix-getenv "E1_SEED") "1")))
        (initial-seed seed)
        (mutant (or (sb-ext:posix-getenv "E1_MUTANT") "ORIGINAL"))
        (declaration (if (equal mutant "M1") :different-capability :different-capability-and-allocator-disjoint))
        (start (e1-seconds))
        (*e1-stat* nil) (*e1-label-counts* nil) (*e1-trials* 0)
        (*e1-deadline* (+ start 120d0)) (*e1-boundary* 0) (*e1-schedule* nil)
        (*e1-draws* nil) (*e1-byte-history* nil) (*e1-close-history* nil)
        (result
         (catch 'e1-stop
          (cond
           ((equal config "baseline")
            (let ((*e1-record-random* t) (*e1-baseline-seed* seed) (*e1-g1-enabled* nil))
             (loop
              (incf *e1-trials*)
              (let ((answer (fn2-sim-run-echo seed 2 *e1-profile*)))
               (unless (eq (car answer) :pass) (e1-fail :baseline answer))
               (let ((live (nth 9 answer)))
                (unless (and (eq (first live) :pass) (= (second live) (third live) 200)
                             (zerop (fourth live)))
                 (e1-fail :baseline-liveness live))))
              (setf seed (e1-random-word seed))
              (e1-limit))))
           ((equal config "latency-control")
            (let ((world (e1-new)))
             (e1-step '(:turn) world) (e1-step '(:take 0) world)
             (e1-land-kind world *fn2-action-accept* 2 0)
             (e1-save "fn2/experiments/squares/results/latency-prefix.sexp" (e1-world-choices world))
             '(:completed :latency-control)))
           ((equal config "replay-control") (e1-replay-control))
           ((equal config "replay")
            (with-open-file (s (sb-ext:posix-getenv "E1_REPLAY"))
             (e1-replay-saved (read s))))
           ((equal config "negative-control") (e1-negative-control))
           ((equal config "random") (e1-random-campaign seed declaration))
           ((equal config "exhaustive") (e1-enumerate nil 4 declaration) '(:completed :domain-exhausted))
           (t (let ((world (e1-new)))
                (e1-step '(:turn) world)
                (e1-step '(:take 0) world)
                (format t "E1 PROBE choices=~S~%" (e1-choices world))
                (e1-step (find-if (lambda (x) (and (eq (car x) :land) (= (nth 7 x) 26))) (e1-choices world)) world)
                (e1-step '(:turn) world)
                '(:completed :probe)))))))
  (let* ((stem (format nil "fn2/experiments/squares/results/~A-~A-~D~A" mutant config initial-seed
                       (or (sb-ext:posix-getenv "E1_OUTPUT_TAG") "")))
         (report (list :mutant mutant :config config :seed initial-seed :seconds (- (e1-seconds) start)
                       :trials *e1-trials* :counters *e1-stat* :result result :labels *e1-label-counts*
                       :replay-source (sb-ext:posix-getenv "E1_REPLAY"))))
   (e1-save (concatenate 'string stem ".sexp") report)
   (when (eq (car result) :found) (e1-save (concatenate 'string stem "-schedule.sexp") report))
   (let ((*print-pretty* nil)) (format t "E1 SUMMARY mutant=~A config=~A seed=~D status=~S contract=~S seconds=~,6F trials=~D counters=~S boundary=~S result=~A.sexp~%"
           mutant config initial-seed (car result) (second result) (getf report :seconds)
           *e1-trials* *e1-stat* (and (eq (car result) :found) (getf (cddr result) :boundary)) stem))
   (finish-output))))

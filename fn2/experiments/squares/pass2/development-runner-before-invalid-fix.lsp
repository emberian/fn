; Pass 2 orchestration over the certified E1 books. No layer A definitions.
(in-package "ACL2")
(defvar *e2-original-functions* nil)
(defvar *e2-validating* nil)
(defvar *e2-mutant* "ORIGINAL")
(defvar *e2-declaration* :different-capability-and-allocator-disjoint)
(defvar *e2-known* nil)
(defvar *e2-pending* nil)
(defvar *e2-correspondences* nil)
(defvar *e2-horizons* nil)
(defvar *e2-horizon* nil)
(defvar *e2-deepest* -1)
(defvar *e2-seen* nil)
(defvar *e2-dedup* nil)
(defvar *e2-last-label* nil)
(defvar *e2-label-pending* nil)
(defvar *e2-first-positive* nil)
(defvar *e2-baseline-trials* nil)
(defvar *e2-current-seed* nil)
(defparameter *e2-original-inc* (symbol-function 'e1-inc))
(defparameter *e2-original-independent* (symbol-function 'e1-independent))
(defun e1-inc (key &optional (n 1))
 (funcall *e2-original-inc*
  (if *e2-validating* (intern (concatenate 'string "CONTROL-" (symbol-name key)) "KEYWORD") key) n))
(defun e1-total ()
 (loop for (key value) on *e1-stat* by #'cddr
       when (member key '(:core :reference :replayed-core :replayed-reference
                         :control-core :control-reference :control-replayed-core :control-replayed-reference))
       sum value))
(defun e2-function-symbols ()
 (remove-duplicates
  (append (mapcar #'car *e1-hooks*)
   (loop for name in '(fn2-echo-observe-send fn2-exec-harvest fn2-sched-make-runnable fn2-sim-delay-flight)
         append (list name (*1*-symbol name))))))
(defun e2-label-hooks ()
 (e1-wrap 'fn2-e1-label
  (lambda (old) (lambda (&rest args)
   (let ((label (apply old args))) (setf *e2-last-label* label *e2-label-pending* t) label))))
 (e1-wrap 'fn2-e1-g1-step
  (lambda (old) (lambda (&rest args)
   (let ((values (multiple-value-list (apply old args))))
    (setf *e2-label-pending* nil) (values-list values))))))
(defun e2-capture-original ()
 (e1-install) (e2-label-hooks)
 (setf *e2-original-functions*
  (loop for symbol in (e2-function-symbols) when (fboundp symbol) collect (cons symbol (symbol-function symbol))))
 (dolist (pair *e1-hooks*) (setf (symbol-function (car pair)) (cdr pair)))
 (setf *e1-hooks* nil))
(defun e2-original-call (thunk)
 (let ((saved (mapcar (lambda (p) (cons (car p) (symbol-function (car p)))) *e2-original-functions*))
       (*e2-validating* t) (*e1-hook-stack* nil) (*e1-counting* nil)
       (*e1-label-counts* nil) (*e2-last-label* nil) (*e2-label-pending* nil) (*e1-byte-history* nil) (*e1-close-history* nil)
       (*e1-boundary* 0) (*e1-schedule* nil) (*e2-correspondences* nil))
  (unwind-protect
   (progn
    (dolist (p *e2-original-functions*) (setf (symbol-function (car p)) (cdr p)))
    (let ((answer (catch 'e1-invalid
                    (catch 'e1-stop (funcall thunk) '(:completed :original-prefix)))))
     (list :result answer :correspondences (reverse *e2-correspondences*))))
   (dolist (p saved) (setf (symbol-function (car p)) (cdr p))))))
(defun e2-original-step (choice world)
 ; Same external occurrence identity/fault/word. Range/retained terminal fields
 ; are descriptor outputs, checked and recorded as an explicit correspondence.
 (let ((actual (if (eq (first choice) :land)
                  (find-if (lambda (x) (and (eq (car x) :land)
                                           (equal (subseq x 0 9) (subseq choice 0 9))))
                           (e1-choices world)) choice)))
  (unless actual (throw 'e1-invalid (list :inapplicable-original :choice choice :boundary (1+ (length (e1-world-choices world))))))
  (unless (equal choice actual) (push (list :recorded choice :original actual) *e2-correspondences*))
  (e1-step actual world)))
(defun e2-original-world (prefix)
 (let ((*e1-replay* t) (world (e1-new)))
  (dolist (choice prefix) (e2-original-step choice world)) world))
(defun e2-original-route (prefix a b)
 (let ((*e1-byte-history* nil) (*e1-close-history* nil) (*e1-replay* t))
  (let ((world (e2-original-world prefix)))
   (e2-original-step a world) (e2-original-step b world)
   (e1-settle world) (e1-complete-closes world)
   (list :legal (e1-observation world) (e1-world-choices world)))))
(defun e2-signature (result)
 (and (eq (first result) :found) (list (second result) (getf (cddr result) :boundary))))
(defun e2-handle (candidate)
 (setf *e2-pending* candidate)
 (when (equal *e2-mutant* "ORIGINAL")
  (throw 'e2-stop (cons :original-finding (cdr candidate))))
 (let* ((data (cddr candidate)) (prefix (getf data :schedule))
        (detail (getf data :detail))
        (control
         (if (and (eq (second candidate) :g2) (equal *e2-mutant* "M1"))
          (list :result '(:completed :original-declaration-rejects-pair))
          (e2-original-call
           (lambda ()
            (if (eq (second candidate) :g2)
             (let ((ab (e2-original-route prefix (getf detail :a) (getf detail :b)))
                   (ba (e2-original-route prefix (getf detail :b) (getf detail :a))))
              (unless (equal (second ab) (second ba))
               (e1-fail :g2 (list :ab ab :ba ba))))
             (e2-original-world prefix))))))
        (result (getf control :result)))
  (cond
   ((eq (car result) :censored) (throw 'e2-stop result))
   ((or (equal (e2-signature result) (e2-signature candidate))
        (and (eq (second candidate) :g2) (eq (second result) :g2)))
    (push (list :candidate candidate :control control) *e2-known*)
    (e1-inc :known-original-findings) (setf *e2-pending* nil) :known)
   ((eq (car result) :inapplicable-original)
    (e1-inc :unqualified-candidates)
    (push (list :candidate candidate :control control) *e2-known*)
    (setf *e2-pending* nil) :inapplicable)
   ((member (car result) '(:completed :found))
    (throw 'e2-stop (append candidate (list :original-control control))))
   (t (throw 'e2-stop (list :control-error control))))))
(defun e2-guard (thunk)
 (let ((result (catch 'e1-stop (list :ok (funcall thunk)))))
  (cond ((eq (car result) :ok) (second result))
        ((eq (car result) :found) (e2-handle result))
        (t (throw 'e2-stop result)))))
(defun e2-data-occurrence-p (occ)
 (and (member (nth 4 occ) (list *fn2-action-receive* *fn2-action-send*))
      (member (nth 3 occ) '(1 2 3))))
(defun e1-independent (a b declaration)
 (if (eq declaration :data-different-echo-capability)
  (and (/= (second a) (second b)) (e2-data-occurrence-p a) (e2-data-occurrence-p b)
       (not (equal (e1-capability a) (e1-capability b))))
  (funcall *e2-original-independent* a b declaration)))
(defun e1-diamonds (world declaration)
 (let ((occurrences (remove-if-not
       (lambda (x) (and (eq (car x) :land) (not (member (nth 7 x) '(2 14)))
                        (not (fn2-sim-wake-first-p t (second x) (e1-world-sim world))))) (e1-choices world))))
  (loop for tail on occurrences do
   (dolist (b (cdr tail))
    (let ((a (car tail)))
     (if (not (e1-independent a b declaration)) (e1-inc :rejected-candidates)
      (let* ((prefix (e1-world-choices world)) (ab (e1-route prefix a b)) (ba (e1-route prefix b a)))
       (e1-inc :g2)
       (cond ((not (and (eq (car ab) :legal) (eq (car ba) :legal))) (e1-inc :illegal-residual))
             ((equal (second ab) (second ba))
              (e1-inc :g2-positive)
              (when (second (second ab)) (e1-inc :g2-positive-with-bytes))
              (unless *e2-first-positive*
               (setf *e2-first-positive* (list :prefix prefix :a a :b b :ab ab :ba ba))))
             (t
              (e1-inc :g2-refutations)
              (e2-handle (list :found :g2 :boundary *e1-boundary* :schedule prefix
                               :detail (list :declaration declaration :a a :b b :ab ab :ba ba
                                             :state (e2-state-summary world)))))))))))))
(defun e2-random (seed declaration prefix)
 (loop
  (incf *e1-trials*)
  (let ((*e1-byte-history* nil) (*e1-close-history* nil))
   (e2-guard (lambda ()
    (let ((world (e1-replay prefix)))
     (dotimes (i 128)
      (e1-inc :states-reached) (e1-diamonds world declaration)
      (setf seed (e1-random-word seed))
      (let ((choices (e1-choices world)))
       (catch 'e1-invalid (e1-step (nth (mod seed (length choices)) choices) world))))
     (e1-inc :states-reached) (e1-diamonds world declaration)))))
  (e1-limit)))
(defun e2-enumerate (prefix left declaration)
 (e1-limit) (incf *e1-trials*) (incf (getf *e2-horizon* :prefixes 0)) (e1-inc :prefixes-enumerated)
 (e2-guard (lambda ()
  (catch 'e1-invalid
   (let ((*e1-byte-history* nil) (*e1-close-history* nil))
    (let ((world (e1-replay prefix)))
     (incf (getf *e2-horizon* :states 0)) (e1-inc :states-reached)
     (let ((key (and *e2-dedup*
                    (list left (e1-exact-state world) (copy-tree *e1-byte-history*) (copy-tree *e1-close-history*)))))
      (if (and key (gethash key *e2-seen*))
       (progn (e1-inc :exact-duplicates) (incf (getf *e2-horizon* :duplicates 0)))
       (progn
        (when key
         ; Bounded retention changes efficiency only: forgotten states are
         ; explored again. Exact equality is still required for every prune.
         (when (>= (hash-table-count *e2-seen*) 64)
          (clrhash *e2-seen*) (e1-inc :dedup-cache-clears))
         (setf (gethash key *e2-seen*) t))
        (e1-diamonds world declaration)
        (when (> left 0)
         (dolist (choice (e1-choices world))
          (e2-enumerate (append prefix (list choice)) (1- left) declaration))))))))))))
(defun e2-deepen (declaration prefix)
 (loop for depth from 0 do
  (setf *e2-horizon* (list :depth depth :prefixes 0 :states 0 :duplicates 0 :complete nil)
        *e2-seen* (and *e2-dedup* (make-hash-table :test #'equalp)))
  (push *e2-horizon* *e2-horizons*)
  (e2-enumerate prefix depth declaration)
  (setf (getf *e2-horizon* :complete) t *e2-deepest* depth)))
(defun e2-baseline (seed controls)
 (let ((*e1-record-random* t) (*e1-g1-enabled* nil))
  (loop
   (incf *e1-trials*) (setf *e2-current-seed* seed)
   (let* ((*e1-boundary* 0) (*e1-draws* nil) (*e1-schedule* nil) (*e1-baseline-seed* seed)
          (result (catch 'e1-stop
            (let ((answer (fn2-sim-run-echo seed 2 *e1-profile*)))
             (unless (eq (car answer) :pass) (e1-fail :baseline answer))
             (let ((live (nth 9 answer)))
              (unless (and (eq (first live) :pass) (= (second live) (third live) 200) (zerop (fourth live)))
               (e1-fail :baseline-liveness live)))) '(:completed :baseline)))
          (record (list :trial-seed seed :last-boundary *e1-boundary* :signature (e2-signature result)
                        :complete (not (eq (car result) :censored)) :result result))
          (control (find seed controls :key (lambda (x) (getf x :trial-seed)))))
    (push record *e2-baseline-trials*)
    (cond
     ((eq (car result) :censored) (throw 'e2-stop result))
     ((equal *e2-mutant* "ORIGINAL")
      (if (eq (second result) :baseline-liveness)
       (progn (push record *e2-known*) (e1-inc :known-original-findings))
       (when (eq (car result) :found) (throw 'e2-stop (cons :original-finding (cdr result))))))
     ((eq (car result) :found)
      (cond
       ((and control (equal (getf control :signature) (e2-signature result)))
        (push (list :candidate record :control control) *e2-known*) (e1-inc :known-original-findings))
       ((and control (or (getf control :complete) (>= (getf control :last-boundary) *e1-boundary*)))
        (throw 'e2-stop (append result (list :trial-seed seed :original-control control))))
       (t (throw 'e2-stop (list :control-needed :trial-seed seed :candidate result :control control)))))))
   (setf seed (e1-random-word seed)) (e1-limit))))
(defun e2-state-summary (world)
 (list :free-head (fn2-machine-free-head (e1-world-core world))
       :active (fn2-machine-active-count (e1-world-core world))
       :capacity (fn2-machine-connection-count (e1-world-core world))
       :cursor (e1-world-cursor world) :queues (e1-world-queues world)
       :choices (e1-choices world)))
(defun e2-land-cap (world kind cap)
 (let ((choice (find-if (lambda (x) (and (eq (car x) :land) (= (nth 4 x) kind)
                                        (= (nth 5 x) cap) (= (nth 7 x) 26) (= (nth 8 x) 0)))
                       (e1-choices world))))
  (unless choice (error "No flight kind ~S cap ~S" kind cap))
  (e1-step choice world)))
(defun e2-data-prefix ()
 (let ((world (e1-new)))
  (e1-settle world) (e1-land-kind world *fn2-action-accept* 26 0)
  (e1-step '(:client 0) world) (e1-settle world)
  (e1-land-kind world *fn2-action-accept* 26 1)
  (e1-step '(:client 1) world) (e1-settle world)
  (e2-land-cap world *fn2-action-receive* 0) (e1-settle world)
  (e2-land-cap world *fn2-action-receive* 1) (e1-settle world)
  (assert (= 2 (length (remove-if-not
     (lambda (x) (and (eq (car x) :land) (= (nth 4 x) *fn2-action-send*) (= (nth 7 x) 26) (= (nth 8 x) 0)))
     (e1-choices world)))))
  (e1-world-choices world)))
(defun e2-read (path) (with-open-file (s path) (read s)))
(defun e2-main ()
 (let* ((config (or (sb-ext:posix-getenv "E2_CONFIG") "probe"))
        (seed (parse-integer (or (sb-ext:posix-getenv "E1_SEED") "1")))
        (*e2-mutant* (or (sb-ext:posix-getenv "E1_MUTANT") "ORIGINAL"))
        (profile-name (or (sb-ext:posix-getenv "E2_PROFILE") "c1"))
        (*e1-profile* (if (equal profile-name "c2")
                        (put-assoc-equal :qa 8 (put-assoc-equal :c 2 *e1-profile*)) *e1-profile*))
        (decl-name (or (sb-ext:posix-getenv "E2_DECLARATION") "default"))
        (*e2-declaration* (cond ((equal decl-name "data") :data-different-echo-capability)
                               ((equal *e2-mutant* "M1") :different-capability)
                               (t :different-capability-and-allocator-disjoint)))
        (prefix-name (or (sb-ext:posix-getenv "E2_PREFIX") "initial"))
        (prefix (if (equal prefix-name "initial") nil
                    (e2-read (format nil "fn2/experiments/squares/~A" (cond
                     ((equal prefix-name "data") "pass2/data-prefix.sexp")
                     ((equal prefix-name "listener") "results/listener-prefix.sexp")
                     (t "results/send-prefix.sexp"))))))
        (controls (and (equal config "baseline") (not (equal *e2-mutant* "ORIGINAL"))
                       (getf (e2-read (format nil "fn2/experiments/squares/pass2/results/ORIGINAL-baseline-c1-default-initial-~D.sexp" seed)) :baseline-trials)))
        (start (e1-seconds)) (*e1-deadline* (+ start 120d0))
        (*e1-stat* nil) (*e1-label-counts* nil) (*e1-trials* 0)
        (*e2-last-label* nil) (*e2-label-pending* nil)
        (*e1-boundary* 0) (*e1-schedule* nil) (*e1-draws* nil)
        (*e1-byte-history* nil) (*e1-close-history* nil)
        (*e2-known* nil) (*e2-pending* nil) (*e2-first-positive* nil)
        (*e2-horizons* nil) (*e2-horizon* nil) (*e2-deepest* -1)
        (*e2-baseline-trials* nil) (*e2-current-seed* nil)
        (*e2-dedup* (equal config "dedup"))
        (result (catch 'e2-stop
          (catch 'e1-stop
           (cond
            ((equal config "fixture")
             (let ((prefix (e2-data-prefix)))
              (e1-save "fn2/experiments/squares/pass2/data-prefix.sexp" prefix)
              (e1-save "fn2/experiments/squares/pass2/data-state.sexp" (e2-state-summary (e1-replay prefix)))
              (e1-diamonds (e1-replay prefix) *e2-declaration*) '(:completed :fixture)))
            ((equal config "baseline") (e2-baseline seed controls))
            ((equal config "random") (e2-random seed *e2-declaration* prefix))
            ((member config '("iterative" "dedup") :test #'equal) (e2-deepen *e2-declaration* prefix))
            ((equal config "replay")
             (let* ((saved (e2-read (sb-ext:posix-getenv "E2_REPLAY"))) (finding (getf saved :result)))
              (if (eq (second finding) :g2)
               (let* ((d (getf (cddr finding) :detail)) (p (getf (cddr finding) :schedule))
                      (ab (e1-route p (getf d :a) (getf d :b))) (ba (e1-route p (getf d :b) (getf d :a))))
                (assert (equal ab (getf d :ab))) (assert (equal ba (getf d :ba)))
                '(:completed :exact-diamond-replay))
               (if (equal (getf saved :config) "baseline")
                (let ((*e1-record-random* t) (*e1-replay-tapep* t)
                      (*e1-replay-tape* (getf (cddr finding) :random-draws))
                      (*e1-baseline-seed* (getf (cddr finding) :trial-seed)))
                 (fn2-sim-run-echo *e1-baseline-seed* 2 *e1-profile*) '(:completed :baseline-replay))
                (progn (e1-replay (getf (cddr finding) :schedule)) '(:completed :prefix-replay))))))
            (t (e2-guard (lambda () (e1-replay prefix))) '(:completed :probe))))))
        (stem (format nil "fn2/experiments/squares/pass2/results/~A-~A-~A-~A-~A-~D"
                      *e2-mutant* config profile-name decl-name prefix-name seed))
        (interrupted-label (and *e2-label-pending* *e2-last-label*))
        (completed-labels (let ((counts (copy-tree *e1-label-counts*)))
          (when interrupted-label (decf (cdr (assoc interrupted-label counts :test #'equal)))) counts))
        (report (list :mutant *e2-mutant* :config config :profile profile-name :declaration decl-name
                      :prefix prefix-name :seed seed :seconds (- (e1-seconds) start)
                      :trials *e1-trials* :counters *e1-stat* :result result :labels completed-labels :interrupted-label interrupted-label
                      :deepest-completed *e2-deepest* :horizons (reverse *e2-horizons*)
                      :known-original (reverse *e2-known*) :pending-candidate *e2-pending*
                      :baseline-trials (reverse *e2-baseline-trials*) :first-positive *e2-first-positive*)))
  (e1-save (concatenate 'string stem ".sexp") report)
  (when (member (car result) '(:found :original-finding))
   (e1-save (concatenate 'string stem "-schedule.sexp") report))
  (let ((*print-pretty* nil))
   (format t "E2 SUMMARY mutant=~A config=~A profile=~A declaration=~A prefix=~A seed=~D status=~S contract=~S seconds=~,6F trials=~D deepest=~D horizons=~S counters=~S result=~A.sexp~%"
    *e2-mutant* config profile-name decl-name prefix-name seed (car result) (second result)
    (getf report :seconds) *e1-trials* *e2-deepest* (getf report :horizons) *e1-stat* stem))
  (finish-output)))

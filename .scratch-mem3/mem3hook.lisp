;;; MEM-003 measurement hook (no image change).  Loaded with --eval before the restart.
;;; MEM3_ARM = 0 (log only) | 1 (gc :gen 1 once per idle period, from the maintenance tick)
;;;          | 2 (gc :gen 1 right after fnn-owner-publish-captured returns, i.e. after the service nursery is restored)
;;; MEM3_LOG = event log: GC <epoch-us> <gc-run-us> <dynamic-usage> / PUB-START / PUB-END / FIRE <arm> <epoch-us> <us-taken>
(in-package "CL-USER")
(defvar *m3-log* nil)
(defvar *m3-lock* (sb-thread:make-mutex :name "m3"))
(defun m3-now () (multiple-value-bind (s us) (sb-ext:get-time-of-day) (+ (* s 1000000) us)))
(defun m3-emit (&rest parts)
  (when *m3-log*
    (sb-thread:with-mutex (*m3-lock*)
      (format *m3-log* "~{~a~^ ~}~%" parts) (finish-output *m3-log*))))
(defun m3-sym (name)
  (let (found) (dolist (p (list-all-packages) found)
                 (let ((s (find-symbol name p))) (when (and s (fboundp s)) (setq found s) (return s))))))
(defvar *m3-arm* (parse-integer (or (sb-ext:posix-getenv "MEM3_ARM") "0")))
(defvar *m3-pubs* 0) (defvar *m3-pipes* 0) (defvar *m3-pub-active* 0)
(defvar *m3-last-pipes* -1) (defvar *m3-last-consed* 0) (defvar *m3-quiet* 0) (defvar *m3-fired* nil)
(defvar *m3-consed-at-gc* 0)
(defun m3-gc-now ()
  (let ((t0 (m3-now)))
    (sb-ext:gc :gen 1)
    (m3-emit "FIRE" *m3-arm* t0 (- (m3-now) t0))))

(defun m3-status (key)
  (with-open-file (in "/proc/self/status")
    (loop for l = (read-line in nil) while l
          when (and (> (length l) (length key)) (string= key l :end2 (length key)))
          return (parse-integer l :start (1+ (length key)) :junk-allowed t))))
(defun m3-gen-bytes (g)
  (let ((f (or (find-symbol "GENERATION-BYTES-ALLOCATED" "SB-EXT") (find-symbol "GENERATION-BYTES-ALLOCATED" "SB-KERNEL"))))
    (and f (fboundp f) (funcall f g))))
(defun m3-read (label)
  (m3-emit "PROBE" label "dyn" (sb-kernel:dynamic-usage) "anon_kb" (m3-status "RssAnon") "file_kb" (m3-status "RssFile")
           "rss_kb" (m3-status "VmRSS")
           "gens" (loop for g from 0 to 5 collect (list g (m3-gen-bytes g) (sb-ext:generation-number-of-gcs g)))
           "cbg" (sb-ext:bytes-consed-between-gcs)))
(defvar *m3-probed* nil)
(defun m3-probe ()
  (m3-read "a-before")
  (sb-ext:gc :gen 1) (m3-read "b-gen1")
  (sb-ext:gc :gen 2) (m3-read "c-gen2")
  (sb-ext:gc :full t) (m3-read "d-full")
  (sleep 2) (m3-read "e-full+2s"))
(let ((path (sb-ext:posix-getenv "MEM3_LOG")))
  (when path
    (setq *m3-log* (open path :direction :output :if-exists :supersede))
    (push (lambda () (setq *m3-consed-at-gc* (sb-ext:get-bytes-consed))
            (m3-emit "GC" (m3-now) (round (* 1000000 sb-ext:*gc-run-time*) internal-time-units-per-second)
                     (sb-kernel:dynamic-usage)))
          sb-ext:*after-gc-hooks*)
    (let ((pub (m3-sym "FNN-OWNER-PUBLISH-CAPTURED")) (pipe (m3-sym "FNN-OWNER-COMMIT-PIPELINE"))
          (tick (m3-sym "FNN-OWNER-MAINTENANCE-TICK")))
      (m3-emit "HOOKS" pub pipe tick "arm" *m3-arm*)
      (when pub
        (sb-int:encapsulate pub 'm3-pub
          (lambda (f &rest a)
            (incf *m3-pub-active*) (m3-emit "PUB-START" (m3-now))
            (unwind-protect (apply f a)
              (decf *m3-pub-active*) (m3-emit "PUB-END" (m3-now))
              (when (= *m3-arm* 2) (m3-gc-now))))))
      (when pipe
        (sb-int:encapsulate pipe 'm3-pipe
          (lambda (f &rest a) (incf *m3-pipes*) (apply f a))))
      (when (and tick (= *m3-arm* 9))
        (sb-int:encapsulate tick 'm3-tick
          (lambda (f &rest a)
            (multiple-value-prog1 (apply f a)
              (let* ((consed (sb-ext:get-bytes-consed))
                     (quiet (and (= *m3-pipes* *m3-last-pipes*) (zerop *m3-pub-active*)
                                 (< (- consed *m3-last-consed*) (* 512 1024)))))
                (setq *m3-last-pipes* *m3-pipes* *m3-last-consed* consed)
                (if quiet (incf *m3-quiet*) (setq *m3-quiet* 0))
                (when (and (>= *m3-quiet* 3) (> *m3-pipes* 900) (not *m3-probed*))
                  (setq *m3-probed* t) (m3-probe)))))))
      (when (and tick (= *m3-arm* 1))
        (sb-int:encapsulate tick 'm3-tick
          (lambda (f &rest a)
            (multiple-value-prog1 (apply f a)
              ;; idle = no commit pipeline run, no publication, < 512 KiB consed since the previous tick
              (let* ((consed (sb-ext:get-bytes-consed))
                     (quiet (and (= *m3-pipes* *m3-last-pipes*) (zerop *m3-pub-active*)
                                 (< (- consed *m3-last-consed*) (* 512 1024)))))
                (setq *m3-last-pipes* *m3-pipes* *m3-last-consed* consed)
                (if quiet (incf *m3-quiet*) (setq *m3-quiet* 0 *m3-fired* nil))
                (when (and (>= *m3-quiet* 2) (not *m3-fired*)
                           (> (- consed *m3-consed-at-gc*) (* 1024 1024)))
                  (setq *m3-fired* t)
                  (m3-gc-now) (setq *m3-last-consed* (sb-ext:get-bytes-consed))))))))))
)

;;; arm 7 = the lane's code (books/idle-collection.lisp forms + the host snippet of owner.lisp, read from MEM3_LANE_DIR),
;;; called after every fnn-owner-maintenance-tick as the lane's owner.lisp calls it.  Not an image: fnn-call's interface
;;; table is not exercised, so fnn-core is wrapped to apply the two entries directly.
(defun m3-strip-xargs (form)
  (if (and (consp form) (eq (car form) 'declare) (consp (cadr form)) (eq (caadr form) 'xargs)) nil form))
(defun m3-load-lane (dir)
  (unless (fboundp (quote acl2::assoc-eq)) (setf (fdefinition (quote acl2::assoc-eq)) (lambda (k a) (assoc k a :test (function eq)))))
  (let ((*package* (find-package "ACL2")))
    (dolist (file '("profile-limits.lisp" "idle-collection.lisp"))
      (with-open-file (in (concatenate 'string dir "/" file))
        (loop for form = (read in nil :eof) until (eq form :eof)
              do (when (consp form)
                   (case (car form)
                     (acl2::defconst (eval `(defparameter ,@(cdr form))))
                     (acl2::defmacro (eval form))
                     (acl2::defun (eval `(defun ,(second form) ,(third form)
                                           ,@(remove nil (mapcar #'m3-strip-xargs (cdddr form))))))
                     (t nil))))))
    (load (concatenate 'string dir "/owner-snippet.lisp"))))
(when (and *m3-log* (= *m3-arm* 7))
  (m3-load-lane (sb-ext:posix-getenv "MEM3_LANE_DIR"))
  (let ((core (m3-sym "FNN-CORE")) (tick (m3-sym "FNN-OWNER-MAINTENANCE-TICK"))
        (maybe (find-symbol "FNN-OWNER-MAYBE-COLLECT-IDLE" "ACL2")))
    (m3-emit "LANE" maybe (fboundp maybe))
    (sb-int:encapsulate core 'm3-core
      (lambda (f name &rest args)
        (if (member name '(acl2::fn-idle-gc-quiet acl2::fn-idle-gc-decide))
            (apply name args)
          (apply f name args))))
    (sb-int:encapsulate tick 'm3-lane-tick
      (lambda (f &rest a)
        (multiple-value-prog1 (apply f a)
          (let ((before (symbol-value (find-symbol "*FNN-IDLE-GC-COLLECT-MARK*" "ACL2")))
                (t0 (m3-now)))
            (apply maybe a)
            (m3-emit "TICK" (m3-now) "quiet" (symbol-value (find-symbol "*FNN-IDLE-GC-QUIET*" "ACL2"))
                     "jobs" (funcall (find-symbol "FNN-OWNER-SNAPSHOT-JOBS-DRAINED-P" "ACL2") (car a))
                     "since-collect" (- (sb-ext:get-bytes-consed) (symbol-value (find-symbol "*FNN-IDLE-GC-COLLECT-MARK*" "ACL2"))))
            (unless (eql before (symbol-value (find-symbol "*FNN-IDLE-GC-COLLECT-MARK*" "ACL2")))
              (m3-emit "FIRE" 7 t0 (- (m3-now) t0)))))))))

#!/usr/bin/env python3
"""Run the certified native image node: fn init IMAGE; fn serve IMAGE."""
import argparse
import os
from pathlib import Path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("command", choices=("init", "serve"))
parser.add_argument("image", type=Path)
parser.add_argument("--size", default="33554432", help="image bytes for init (default 32 MiB)")
parser.add_argument("--port", default="0")
args = parser.parse_args()
root = Path(__file__).resolve().parent
env = os.environ.copy()
env.update(FN2_IMAGE=str(args.image.resolve()), FN2_IMAGE_MODE=args.command,
           FN2_IMAGE_BYTES=args.size, FN2_LISTENER_PORT=args.port)
os.chdir(root)
with open(root / "tools/image-node.lsp", "rb") as script:
    os.dup2(script.fileno(), 0)
os.execve(str(root / "tools/acl2"), [str(root / "tools/acl2")], env)

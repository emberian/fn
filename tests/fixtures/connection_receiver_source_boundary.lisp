(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defmacro mv (&rest xs) `(values ,@xs))
(defmacro mv-let (vars expr &body body) `(multiple-value-bind ,vars ,expr ,@body))
(defmacro stobj-let (bindings vars expr out)
 `(let ,(mapcar (lambda (b) (list (car b) (cadr b))) bindings)
    (multiple-value-bind ,vars ,expr ,out)))
(defun nfix (x) (if (and (integerp x) (>= x 0)) x 0))
(defun natp (x) (and (integerp x) (>= x 0)))
(defun fn-omk-at (n x) (nth n x))
(defun fn-omk-widthp (x n) (and (listp x) (= (length x) n)))
(defun fn-ich-tokenp (x)
 (and (fn-omk-widthp x 4) (eq (car x) :connection-holder)
      (every #'natp (cdr x))))
(defvar *trace*)
(defvar *runtime*)
(defvar *open-result*)
(defvar *open-erp*)
(defvar *open-escape*)
(defvar *abort*)
(defvar *bind*)
(defvar *origin*)
(defvar *origin-word*)
(defvar *started*)
(defvar *ticket*)
(defvar *consumable*)
(defvar *revoked*)
(defvar *count* 0)
(defun note (name &rest args) (push (cons name args) *trace*))
(defun names () (mapcar #'car (reverse *trace*)))
(defun f-boundp-global (key state) (nth-value 1 (gethash key state)))
(defun f-get-global (key state) (gethash key state))
(defun f-put-global (key value state)
 (note :state-write key value) (setf (gethash key state) value) state)
(defun fn-mio$c-provider (mio) mio)
(defun fn-ibp-slot-depth (backing) (declare (ignore backing)) 2)
(defun fn-owner-runtime-receiver-source (provider turn current pool state)
 (declare (ignore turn pool state))
 (note :runtime provider current)
 (let ((r (if (cdr *runtime*) (pop *runtime*) (car *runtime*))))
  (if (and (eq provider :provider) (eq current :current))
      (values-list r) (values :unavailable nil nil))))
(defun fn-mio-connection-abort (holder fuel mio pool)
 (note :abort holder fuel) (values *abort* (- fuel 15) mio pool))
(defun fn-owner-index-open (kind family address peer holder fuel mio pool state)
 (declare (ignore kind family address peer))
 (note :open holder fuel)
 (when *open-escape* (error "actual open escaped"))
 (values *open-erp* *open-result* mio pool state))
(defun fn-mio-connection-event (holder op id value fuel mio)
 (note op holder id fuel value)
 (case op
  (:rx-bind (when (eq *bind* :associated) (setf *origin* value))
             (values *bind* value 0 mio))
  (:rx-origin (values *origin-word* *origin* 0 mio))
  (:rx-revoke (when (eq *revoked* :revoked) (setf *origin* nil))
               (values *revoked* nil 0 mio))))
(defun fn-owner-rx-turn-start (capacity demand provider turn pool)
 (note :core-issue capacity demand provider)
 (values *started* (and (eq *started* :admitted) *ticket*) turn pool))
(defun fn-owner-rx-turn-consumablep (ticket provider turn pool)
 (declare (ignore turn pool)) (note :consumable ticket provider) *consumable*)
(defun fn-owner-index-close (id holder faultp fuel mio pool arena state)
 (declare (ignore arena))
 (note (if faultp :fault :close) id holder fuel)
 (assert (null *origin*))
 (assert (null (fn-owner-rx-connection-issued state)))
 (values nil (list :closed id nil) mio pool state))

(defvar *fnn-extent-lock* (sb-thread:make-mutex :name "recording extent"))
(defvar *the-live-state* :live-state)
(defvar *native-args*)
(defvar *native-erp* nil)
(defvar *native-word* :admitted)
(defmacro fnn-core-mv (subject expression) (declare (ignore subject)) `(values-list ,expression))
(defstruct fnn-owner-service connection-raw-token connection-mio connection-pool connection-fuel
 connection-start connection-open connection-close receiver-runtime)
(defstruct fnn-owner-receiver-turn-runtime provider turn current turn-start)
(defstruct fnn-connection-custody token cid phase)
(defun fnn-owner-connection-selected-p (service) (declare (ignore service)) t)
(defun fnn-fixed-callback-fail (subject word detail) (error "~s ~s ~s" subject word detail))
(defun fnn-refuse (fmt &rest args) (error (apply #'format nil fmt args)))
(defun fnn-connection-custody-publish-raw (service)
 (prog1 (make-fnn-connection-custody :token (fnn-owner-service-connection-raw-token service) :phase :pending)
  (setf (fnn-owner-service-connection-raw-token service) nil)))
(defun fnn-connection-custody-released (service node)
 (declare (ignore service)) (setf (fnn-connection-custody-phase node) :released))
(defun fnn-live-arena () :live-arena)
(load __SOURCE_FILE__)
(defmacro scenario (&body body)
 `(let ((*trace* nil) (*runtime* (list (list :current :capacity 4)))
        (*open-result* (list :opened 7 '(:connection-holder 21 0 3)))
        (*open-erp* nil) (*open-escape* nil) (*abort* :released)
        (*bind* :associated) (*origin* nil) (*origin-word* :current)
        (*started* :admitted) (*ticket* '(:receiver-turn 45))
        (*consumable* t) (*revoked* :revoked)
        (holder '(:connection-holder 21 0 3))
        (state (make-hash-table)) (mio :mio) (pool :pool)
        (provider :provider) (turn :turn) (current :current))
   (incf *count*) ,@body))
(defun open-it (holder fuel mio provider turn current pool state)
 (multiple-value-bind (erp result m p s)
  (fn-owner-index-rx-open :reader :inet nil nil holder fuel mio provider turn current pool state)
  (assert (eq m mio)) (assert (eq p pool)) (assert (eq s state))
  (values erp result)))
(defun start-it (id holder fuel mio provider turn current pool state)
 (multiple-value-bind (word ticket m tr p s)
  (fn-owner-rx-connection-turn-start id holder fuel :actual-demand mio provider turn current pool state)
  (assert (eq m mio)) (assert (eq tr turn)) (assert (eq p pool)) (assert (eq s state))
  (values word ticket)))
(scenario
 (assert (equal (nth-value 1 (open-it holder 24 mio provider turn current pool state)) *open-result*))
 (assert (equal (names) '(:runtime :open :runtime :rx-bind)))
 (assert (= (third (assoc :open *trace*)) 21))
 (assert (= (fourth (assoc :rx-bind *trace*)) 3))
 (assert (equal *origin* (list :connection-rx-origin 7 holder :capacity 4))))
(scenario
 (assert (equal (nth-value 1 (open-it holder 23 mio provider turn current pool state)) (list :yield nil holder)))
 (assert (null *trace*)))
(dolist (runtime '(:unavailable :uncertain :recovery-required))
 (scenario (setf *runtime* (list (list runtime nil nil)))
  (assert (equal (nth-value 1 (open-it holder 24 mio provider turn current pool state)) '(:unavailable nil nil)))
  (assert (equal (names) '(:runtime :abort))) (assert (null *origin*))))
(scenario (setf *runtime* '((:unavailable nil nil)) *abort* :stale)
 (assert (equal (nth-value 1 (open-it holder 24 mio provider turn current pool state)) (list :recovery-required nil holder)))
 (assert (equal (names) '(:runtime :abort))))
(dolist (result '((:refused nil nil) (:recovery-required 7 (:connection-holder 21 0 3))))
 (scenario (setf *open-result* result)
  (assert (equal (nth-value 1 (open-it holder 24 mio provider turn current pool state)) result))
  (assert (equal (names) '(:runtime :open))) (assert (null *origin*))))
(scenario (setf *open-erp* :actual-erp)
 (assert (eq (nth-value 0 (open-it holder 24 mio provider turn current pool state)) :actual-erp))
 (assert (equal (names) '(:runtime :open))) (assert (null *origin*)))
(scenario (setf *open-escape* t)
 (assert (handler-case (progn (open-it holder 24 mio provider turn current pool state) nil) (error () t)))
 (assert (equal (names) '(:runtime :open))) (assert (null *origin*)))
(dolist (after '((:unavailable :capacity 4) (:current :changed-capacity 4) (:current :capacity 5)))
 (scenario (setf *runtime* (list (list :current :capacity 4) after))
  (assert (equal (nth-value 1 (open-it holder 24 mio provider turn current pool state)) (list :recovery-required 7 holder)))
  (assert (equal (names) '(:runtime :open :runtime))) (assert (null *origin*))))
(scenario (setf *bind* :stale)
 (assert (equal (nth-value 1 (open-it holder 24 mio provider turn current pool state)) (list :recovery-required 7 holder)))
 (assert (null *origin*)))
(scenario
 (setf *origin* (list :connection-rx-origin 7 holder :capacity 4))
 (assert (eq (start-it 7 holder 3 mio provider turn current pool state) :admitted))
 (assert (equal (names) '(:runtime :rx-origin :core-issue :state-write)))
 (assert (equal (fn-owner-rx-connection-issued state) (list :connection-rx-turn *origin* *ticket*)))
 (assert (fn-owner-rx-parser-source-currentp 7 holder *ticket* provider turn current pool state))
 (assert (equal (mapcar #'car (last (reverse *trace*) 2)) '(:runtime :consumable))))
(dolist (bad '("id" "holder" "capacity" "instance"))
 (scenario
  (setf *origin* (list :connection-rx-origin 7 holder :capacity 4))
  (let ((id 7) (h holder))
   (cond ((string= bad "id") (setf id 8))
         ((string= bad "holder") (setf h '(:connection-holder 22 0 3)))
         ((string= bad "capacity") (setf *runtime* '((:current :other 4))))
         (t (setf *runtime* '((:current :capacity 5)))))
   (assert (eq (start-it id h 3 mio provider turn current pool state) :receiver-unavailable)))
  (assert (equal (names) '(:runtime :rx-origin)))
  (assert (null (fn-owner-rx-connection-issued state)))))
(scenario (setf *origin-word* :yield)
 (assert (eq (start-it 7 holder 0 mio provider turn current pool state) :yield))
 (assert (equal (names) '(:runtime :rx-origin))))
(scenario (setf *runtime* '((:unavailable nil nil)))
 (assert (eq (start-it 7 holder 3 mio provider turn current pool state) :receiver-unavailable))
 (assert (equal (names) '(:runtime))))
(scenario
 (setf *origin* (list :connection-rx-origin 7 holder :capacity 4) *started* :busy)
 (setf (gethash 'fn-owner-rx-connection-issued state) :previous-issued)
 (assert (eq (start-it 7 holder 3 mio provider turn current pool state) :busy))
 (assert (equal (names) '(:runtime :rx-origin :core-issue)))
 (assert (eq (fn-owner-rx-connection-issued state) :previous-issued)))
(dolist (bad '(:id :holder :ticket :capacity :instance :current :not-filled))
 (scenario
  (setf (gethash 'fn-owner-rx-connection-issued state)
        (fn-crx-issued (list :connection-rx-origin 7 holder :capacity 4) :admitted *ticket*))
  (let ((id 7) (h holder) (ticket *ticket*))
   (case bad
    (:id (setf id 8)) (:holder (setf h '(:connection-holder 22 0 3)))
    (:ticket (setf ticket '(:receiver-turn 46)))
    (:capacity (setf *runtime* '((:current :other 4))))
    (:instance (setf *runtime* '((:current :capacity 5))))
    (:current (setf *runtime* '((:unavailable :capacity 4))))
    (:not-filled (setf *consumable* nil)))
   (assert (not (fn-owner-rx-parser-source-currentp id h ticket provider turn current pool state))))
  (assert (not (member :core-issue (names))))))
(dolist (fault '(nil t))
 (scenario
  (setf *origin* (list :connection-rx-origin 7 holder :capacity 4))
  (setf (gethash 'fn-owner-rx-connection-issued state) (fn-crx-issued *origin* :admitted *ticket*))
  (assert (equal (nth-value 1 (fn-owner-index-rx-close 7 holder fault 18 mio pool nil state)) '(:closed 7 nil)))
  (assert (equal (names) (list :rx-revoke :state-write (if fault :fault :close))))
  (assert (= (fourth (assoc :rx-revoke *trace*)) 3))
  (assert (= (fourth (assoc (if fault :fault :close) *trace*)) 15))))
(scenario
 (assert (equal (nth-value 1 (fn-owner-index-rx-close 7 holder nil 17 mio pool nil state)) (list :yield 7 holder)))
 (assert (null *trace*)))
(scenario (setf *revoked* :stale)
 (assert (equal (nth-value 1 (fn-owner-index-rx-close 7 holder nil 18 mio pool nil state)) (list :recovery-required 7 holder)))
 (assert (equal (names) '(:rx-revoke))))
(dolist (bad '(:provider :current))
 (scenario
  (setf (gethash 'fn-owner-rx-connection-issued state)
        (fn-crx-issued (list :connection-rx-origin 7 holder :capacity 4) :admitted *ticket*))
  (assert (not (fn-owner-rx-parser-source-currentp 7 holder *ticket*
                 (if (eq bad :provider) :wrong provider) turn
                 (if (eq bad :current) :wrong current) pool state)))
  (assert (equal (names) '(:runtime)))))


(let* ((*native-args* nil)
       (runtime (make-fnn-owner-receiver-turn-runtime :provider :provider :turn :turn :current :current))
       (service (make-fnn-owner-service :connection-mio :mio :connection-pool :pool
                  :connection-fuel 24 :receiver-runtime runtime))
       (token '(:connection-holder 21 0 3)))
 (setf (fnn-owner-service-connection-start service)
       (lambda (&rest args) (push (cons :start args) *native-args*)
        (list nil :reserved token 24 :mio :pool :live-state))
       (fnn-owner-service-connection-open service)
       (lambda (&rest args) (push (cons :open args) *native-args*)
        (list nil (list :opened 7 token) :mio-open :pool-open :live-state)))
 (multiple-value-bind (id node)
  (fnn-owner-connection-open-locked service :reader :inet :address :peer)
  (incf *count*) (assert (= id 7)) (assert (equal (fnn-connection-custody-token node) token))
  (assert (equal (cdr (assoc :open *native-args*))
                 (list :reader :inet :address :peer token 24 :mio :provider :turn :current :pool :live-state)))
  (assert (eq (fnn-owner-service-connection-mio service) :mio-open))
  (assert (eq (fnn-owner-service-connection-pool service) :pool-open))
  (setf (fnn-owner-receiver-turn-runtime-turn-start runtime)
        (lambda (&rest args) (push (cons :turn args) *native-args*)
         (list :busy nil :mio-turn :turn-modified :pool-turn :live-state)))
  (multiple-value-bind (word ticket pool) (fnn-owner-receiver-turn-start service 7 node :demand)
   (incf *count*) (assert (eq word :busy)) (assert (null ticket)) (assert (eq pool :pool-turn))
   (assert (equal (cdr (assoc :turn *native-args*))
                  (list 7 token 24 :demand :mio-open :provider :turn :current :pool-open :live-state)))
   (assert (eq (fnn-owner-service-connection-mio service) :mio-turn))
   (assert (eq (fnn-owner-service-connection-pool service) :pool-turn))
   (assert (eq (fnn-owner-receiver-turn-runtime-turn runtime) :turn-modified)))
  (setf (fnn-owner-service-connection-close service)
        (lambda (&rest args) (push (cons :close args) *native-args*)
         (list nil (list :closed-held 7 token) :mio-close :pool-close :live-state)))
  (assert (eq (fnn-owner-connection-close-locked service 7 node t) :closed-held))
  (incf *count*)
  (assert (equal (cdr (assoc :close *native-args*))
                 (list 7 token t 24 :mio-turn :pool-turn :live-arena :live-state)))
  (assert (eq (fnn-connection-custody-phase node) :retiring))
  (assert (eq (fnn-owner-service-connection-mio service) :mio-close))
  (assert (eq (fnn-owner-service-connection-pool service) :pool-close))))
(format t "PASS connection receiver boundaries: ~d scenarios~%" *count*)

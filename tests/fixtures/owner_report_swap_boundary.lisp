; Literal native swap block +actual core writer wrappers. I/O modeled.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(proclaim '(declaration xargs))
(defmacro mv (&rest x) `(values ,@x))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun nfix (x) (if (natp x) x 0))
(defun zp (x) (or (not (integerp x)) (<= x 0)))
(defun len (x) (length x))
(defun true-listp (x) (typep x 'list))
(defun boundp-global (k s) (nth-value 1 (gethash k s)))
(defun f-get-global (k s) (gethash k s))
(defun f-put-global (k v s) (setf (gethash k s) v) s)
(defun update-nth (n v x) (let ((y (copy-list x))) (setf (nth n y) v) y))
(defvar *state*) (defvar *escape*) (defvar *calls*)
(defun fnn-owner-core (name &rest args)
 (if (member name '(fn-owner-report-writer-enter fn-owner-report-writer-leave fn-owner-report-writer-fault))
     (multiple-value-bind (erp val state) (funcall name *state*)
      (setf *state* state) (assert (null erp)) (push name *calls*) val)
   (progn (assert (eq name 'fn-owner-orcp-swap)) (record :owner-swap) (car args))))
(defun record (action)
 (assert (eq :mutating (fn-orc-source *state*)))
 (assert (eq :snapshot-changed (fn-orc-current '(:report 7) *state*)))
 (push action *calls*)
 (when (eq *escape* action) (error "modeled swap write escape")))
(defun fnn-state-checkpoint-install (&rest args) (declare (ignore args)) (record :checkpoint))
(defun fnn-reclaim-cut (x) (push x *calls*))
(defun fnn-install-stobj (name value) (declare (ignore value))
 (record (if (eq name 'fn-cat) :cat :hist)))
(defun fnn-owner-reclaim-barriers (store) (declare (ignore store)) (record :barriers))
(load "__SOURCE_FILE__")
(defun execute-swap (w)
 (let ((store 'actual-store) (stage 'actual-stage) (rebuilt 'actual-rebuilt)
       (cat 'new-cat) (hist 'new-hist) (installed nil) (swapped nil))
  __SWAP_BODY__
  (values installed swapped)))
(dolist (*escape* '(nil :checkpoint :owner-swap :cat :hist :barriers))
 (let* ((*state* (make-hash-table)) (*calls* nil) (claim '(charged-report)))
  (f-put-global 'fn-owner-report-source-phase :stable *state*)
  (fn-orc-register-internal '(:report 7) :status nil nil '(capture) '(cursor) claim *state*)
  (if *escape*
      (assert (handler-case (progn (execute-swap :swap) nil) (error () t)))
    (multiple-value-bind (installed swapped) (execute-swap :swap) (assert installed) (assert swapped)))
  (assert (eq (fn-orc-source *state*) (if *escape* :fault :stable)))
  (assert (eq claim (nth 9 (fn-orc-job *state*))))
  (assert (eq :snapshot-changed (fn-orc-current '(:report 7) *state*)))
  (assert (eq 'fn-owner-report-writer-enter (car (last *calls*))))
  (assert (eq (car *calls*) (if *escape* 'fn-owner-report-writer-fault 'fn-owner-report-writer-leave)))))
(let ((*state* (make-hash-table)) (*calls* nil) (*escape* nil))
 (f-put-global 'fn-owner-report-source-phase :stable *state*)
 (execute-swap :busy)
 (assert (null *calls*)) (assert (eq :stable (fn-orc-source *state*))))
(format t "PASS actual swap report ordering~%")

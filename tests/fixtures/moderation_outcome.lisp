(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defvar *plan* '(:withdraw ("withdraw") (60 97 62) ((102 110)) (97)))
(defvar *admin* :accepted)
(defvar *cause* :refused)
(defvar *published* nil)
(defvar *submitted* nil)
(defun fnn-owner-serialized (service cid thunk)
 (declare (ignore service cid)) (funcall thunk))
(defun fnn-owner-advance-clock () nil)
(defun fnn-owner-core (name &rest arguments) (declare (ignore name arguments)) *plan*)
(defun fnn-core (name &rest arguments) (apply name arguments))
(defun fnn-octets (x) x)
(defun fnn-octet-list-p (x) (and (listp x) (every (lambda (n) (typep n '(unsigned-byte 8))) x)))
(defun fnn-fault (message) (error message))
(defun fnn-owner-live-admin-serialized (service argv)
 (declare (ignore service argv))
 (when (eq *admin* :accepted) (setf *published* t)) *admin*)
(defun fnn-owner-control-submit-serialized (service msgid groups octets)
 (declare (ignore service msgid groups octets))
 (assert *published*) (setf *submitted* t) *cause*)
(load "__SOURCE__")
(dolist (row '((:accepted :accepted)
              (:duplicate :duplicate)
              (:refused (:reason :uncertain :withdrawal-authorized-cause-refused))
              ((:reason :refused :operator-not-authorized) (:reason :uncertain :withdrawal-authorized-cause-refused))
              (:clock-unusable (:reason :uncertain :withdrawal-authorized-cause-clock-unusable))
              (:busy (:reason :uncertain :withdrawal-authorized-cause-busy))
              (:article-exceeds-profile-bound (:reason :uncertain :withdrawal-authorized-cause-exceeds-profile-bound))
              (:uncertain (:reason :uncertain :withdrawal-authorized-cause-uncertain))
              (:fault (:reason :fault :withdrawal-authorized-cause-fault))
              (nil (:reason :fault :withdrawal-authorized-cause-invalid))
              ((:other :accepted) (:reason :fault :withdrawal-authorized-cause-invalid))))
 (let ((*cause* (first row)) (*published* nil) (*submitted* nil))
  (assert (equal (fnn-owner-moderation-serialized nil :withdraw nil nil nil) (second row)))
  (assert *published*) (assert *submitted*)))
(dolist (status '(:refused :uncertain :fault (:reason :refused :not-authorized)))
 (let ((*admin* status) (*published* nil) (*submitted* nil))
  (assert (equal (fnn-owner-moderation-serialized nil :withdraw nil nil nil) status))
  (assert (not *published*)) (assert (not *submitted*))))
(let ((*plan* '(:withdraw nil (60 97 62) ((102 110)) (97))) (*published* t))
 (assert (equal (fnn-owner-moderation-serialized nil :withdraw nil nil nil)
                '(:reason :uncertain :withdrawal-authorized-cause-refused))))
(format t "PASS moderation combined outcome~%")

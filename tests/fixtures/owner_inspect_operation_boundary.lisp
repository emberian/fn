; Recording boundary: actual composed functions, modeled qualified factories.
; This fixture does not install a runtime family or native callback.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(proclaim '(declaration xargs))
(defmacro mv (&rest x) `(values ,@x))
(defmacro mv-let (names form &body body) `(multiple-value-bind ,names ,form ,@body))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defvar *calls* nil)
(defvar *available* t)
(defvar *resource* '(:inspect-response-source 900 (1 2 3 4 5)))
(defvar *request* '(actual-request))
(defvar *cache* '(actual-cache))
(defun fn-ats-slotp (slot slots) (and (eql slot 0) (consp slots)))
(defun fn-ats-matchingp (slot nonce slots pool) (declare (ignore slot pool)) (eql nonce (getf slots :nonce)))
(defun fn-ats-kindsi (slot slots) (declare (ignore slot)) (getf slots :role))
(defun fn-ats-phasesi (slot slots) (declare (ignore slot)) (getf slots :phase))
(defun fn-ats-role-bodyp (slot nonce role slots pool)
 (and (fn-ats-matchingp slot nonce slots pool) (eq role (getf slots :role)) (eql 3 (getf slots :phase))))
(defun fn-aec-pool-statep (pool) (eq pool :actual-pool))
(defun fn-apr-naturals (n xs)
 (if (zerop n) (null xs)
  (and (consp xs) (natp (car xs)) (fn-apr-naturals (1- n) (cdr xs)))))
(defun fn-owner-runtime-operation-resources (kind pool state)
 (declare (ignore pool state)) (assert (eq kind :owner-control-inspect))
 (push :resources *calls*)
 (if *available* (mv :runtime-operation-available *resource*)
  (mv :runtime-operation-unavailable nil)))
(defun fn-owner-runtime-operation-body-cost (kind request cache pool state)
 (declare (ignore kind pool state))
 (assert (eq request *request*)) (assert (eq cache *cache*))
 (push :cost *calls*) (mv :runtime-operation-available 123))
(defun fn-ats-prepay-body-internal (slot nonce cost slots pool)
 (declare (ignore slot nonce)) (assert (eql 2 (getf slots :phase))) (assert (eql cost 123))
 (push :prepay *calls*) (mv :prepaid (list :phase 3 :role :owner-control :nonce 7) pool))
(defun fn-owner-runtime-acceptance-observe (kind pool state)
 (declare (ignore kind pool state)) (push :runtime-observe *calls*)
 (mv :runtime-operation-available nil :request-budget 19 0 123 1))
(defun fn-owner-history-operation-observe (backing pool state)
 (declare (ignore pool state)) (assert (eq backing :actual-retained-backing))
 (push :history-observe *calls*)
 (mv :waiting '(:actual-token) :reserved :writing 19 0 7 23 :request-budget 123 1 '(1 2 3 4 5) nil))
(defun fn-prl-nth (n x) (nth n x))
(defun fn-od-correlated-report (&rest args)
 (assert (eql 900 (car (last args))))
 (push :render *calls*) (mv :rendered '(111 107)))
(load "__SOURCE_FILE__")
(defun invoke (phase &optional (nonce 7))
 (fn-owner-inspect-operation-answer *request* *cache* 0 nonce
  (list :phase phase :role :owner-control :nonce 7) :actual-retained-backing :actual-pool :actual-state))
(setf *calls* nil)
(multiple-value-bind (word octets slots pool state) (invoke 2)
 (assert (eq word :rendered)) (assert (equal octets '(111 107)))
 (assert (eql 3 (getf slots :phase))) (assert (eq pool :actual-pool)) (assert (eq state :actual-state))
 (assert (equal (reverse *calls*) '(:resources :cost :prepay :runtime-observe :history-observe :render))))
; Nested response capacity is 900, distinct from retained job/rescue vectors.
(setf *resource* '(:inspect-report-source (10 20 30 40 1) (0 0 0 9 0)
                  (:inspect-response-source 900 (1 2 3 4 5))))
(assert (eq :rendered (invoke 2)))
(setf *resource* '(:inspect-report-source (10 20 30 40 1) (0 0 0 9 0)
                  (:inspect-response-source 900 malformed)))
(setf *calls* nil)
(assert (eq :inspect-source-unavailable (invoke 2)))
(assert (equal *calls* '(:resources)))
(setf *resource* '(:inspect-response-source 900 (1 2 3 4 5)))
(dolist (phase '(0 1 3 4 5 6))
 (setf *calls* nil)
 (assert (eq :inspect-source-unavailable (invoke phase))) (assert (null *calls*)))
(setf *calls* nil)
(assert (eq :inspect-source-unavailable (invoke 2 8))) (assert (null *calls*))
(setf *calls* nil *available* nil)
(assert (eq :inspect-source-unavailable (invoke 2))) (assert (equal *calls* '(:resources)))
(format t "PASS actual inspect ordering~%")

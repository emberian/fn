(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(proclaim '(declaration xargs))
(defmacro mv (&rest x) `(values ,@x))
(defmacro mv-let (names form &body body) `(multiple-value-bind ,names ,form ,@body))
(defun len (x) (if (consp x) (1+ (len (cdr x))) 0))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun posp (x) (and (integerp x) (< 0 x)))
(defun zp (x) (or (not (integerp x)) (<= x 0)))
(load "__SOURCE_FILE__")
(defun report (budget &optional (reason :waiting) (source 0))
 (fn-od-report :observed reason :reserved :writing 19 source 7 23 :request-budget
  100 2 13 17 19 23 29 nil budget))
(multiple-value-bind (word bytes) (report 1000)
 (assert (eq word :rendered))
 (let* ((text (coerce (mapcar #'code-char bytes) 'string)) (n (length bytes)))
  (assert (search "source=0" text))
  (assert (search "reason=waiting" text))
  (assert (search "pool-mode=request-budget" text))
  (assert (not (search "physical-fit" text)))
  (multiple-value-bind (w b) (report n) (assert (eq w :rendered)) (assert (equal b bytes)))
  (multiple-value-bind (w b) (report (1- n))
   (assert (eq w :response-budget-unavailable)) (assert (null b)))))
(multiple-value-bind (word bytes) (report 1000 :credential-secret)
 (assert (eq word :rendered))
 (assert (not (search "credential-secret" (coerce (mapcar #'code-char bytes) 'string)))))
(multiple-value-bind (word bytes) (report 0)
 (assert (eq word :response-budget-unavailable)) (assert (null bytes)))
(multiple-value-bind (word bytes) (report 1000 :waiting (expt 10 10000))
 (assert (eq word :response-budget-unavailable)) (assert (null bytes)))
(multiple-value-bind (word bytes) (fn-od-value (expt 10 10000) 3)
 (assert (eq word :response-budget-unavailable)) (assert (null bytes)))
(format t "PASS operation diagnostics scalar budget boundary~%")

(multiple-value-bind (word bytes) (report 1000 :writer-source-changed)
 (assert (eq word :rendered))
 (assert (search "reason=writer-source-changed" (coerce (mapcar #'code-char bytes) 'string))))

(multiple-value-bind (word bytes)
 (fn-od-correlated-report 731 :article :observed :writer-source-changed :reserved :prepared
  19 0 7 23 :request-budget 100 2 13 17 19 23 29 nil 1000)
 (assert (eq word :rendered))
 (let ((text (coerce (mapcar #'code-char bytes) 'string)))
  (assert (search "admission-nonce=731" text))
  (assert (search "operation-kind=article" text))
  (assert (search "producer=prepared" text))))

(assert (equal (fn-od-word :promoted) '(112 114 111 109 111 116 101 100)))
(assert (equal (fn-od-word :uncertain) '(117 110 99 101 114 116 97 105 110)))

; :CONFIG is the actual FnAPRIdentityP/FnAPRTokenP enum, not :CONFIGURATION.
(assert (equal (fn-od-word :config) '(99 111 110 102 105 103)))

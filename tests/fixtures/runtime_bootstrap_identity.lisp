(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defvar *the-live-state* nil)
(defvar *live-pool* nil)
(defvar *samples* 0)
(defvar *calls* 0)
(defun user-stobj-alist (state) state)
(defun fnn-live-page-read-pool () *live-pool*)
(defmacro fnn-core-mv (name call) (declare (ignore name)) call)
(defun fnn-fixed-callback-fail (&rest args) (declare (ignore args)) (error "fixed fault"))
(load "host/native/runtime-bootstrap.lisp")
(let* ((pool (list :pool))
       (*live-pool* pool)
       (*the-live-state* (list (cons 'fn-page-read-pool pool)))
       (*fnn-runtime-bootstrap*
         (%make-fnn-runtime-bootstrap :pool pool :phase :saved
          :admit (lambda (status pages bytes reservation same)
                   (assert (eq status :qualification-request))
                   (assert (and (null pages) (null bytes) (null reservation)))
                   (assert (eq same pool))
                   (incf *calls*)
                   (values :runtime-qualification-unavailable :refused same)))))
  (multiple-value-bind (word outcome) (fnn-runtime-bootstrap-entry)
    (assert (eq word :runtime-qualification-unavailable))
    (assert (eq outcome :refused)))
  (assert (= *calls* 1))
  (assert (handler-case (progn (fnn-runtime-bootstrap-entry) nil) (error () t)))
  (setf (fnn-runtime-bootstrap-phase *fnn-runtime-bootstrap*) :saved
        *the-live-state* (list (cons 'fn-page-read-pool (list :substituted))))
  (multiple-value-bind (word outcome) (fnn-runtime-bootstrap-entry)
    (assert (eq word :runtime-registry-mismatch))
    (assert (eq outcome :fenced)))
  (assert (= *calls* 1)))
(format t "BOOTSTRAP-IDENTITY PASS qualification refusal/repeated attempt/registry substitution; recording core only~%")

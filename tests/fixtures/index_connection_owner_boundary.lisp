(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defmacro mv (&rest xs) `(values ,@xs))
(defmacro mv-let (vars form &body body) `(multiple-value-bind ,vars ,form ,@body))
(defmacro value (x) `(values nil ,x state))
(defun nfix (x) (if (and (integerp x) (>= x 0)) x 0))
(defun member-eq (x xs) (member x xs :test #'eq))
(defvar *trace*)
(defvar *accept*)
(defvar *ready*)
(defvar *capture*)
(defvar *finish*)
(defvar *abort*)
(defvar *closing*)
(defvar *settle*)
(defvar *open-error*)
(defvar *close-error*)
(defvar *pins*)
(defvar *charged*)
(defvar *scenario-count* 0)
(defun note (name &rest args) (push (cons name args) *trace*))
(defun fn-owner-core (state) (gethash :ocfg state))
(defun fn-owner-ocfg (state) (gethash :ocfg state))
(defun fn-owner-auth (state) (gethash :auth state))
(defun fn-own-next-id (owner) (getf owner :next))
(defun fn-own-conns (owner) (getf owner :conns))
(defun fn-own-find-conn (id conns) (assoc id conns))
(defun fn-own-view (owner) (getf owner :view))
(defun fn-owner-reader-views (state) (gethash :views state))
(defun fn-ocfg-at-reader-view (owner views)
 (let ((copy (copy-list owner))) (setf (getf copy :view) (car views)) copy))
(defun fn-ocfg-with-view (owner working)
 (let ((copy (copy-list owner))) (setf (getf copy :view) working) copy))
(defun fn-owner-install-ocfg (owner state) (setf (gethash :ocfg state) owner) state)
(defun fn-owner-install-effects (effects state) (setf (gethash :effects state) effects) state)
(defun f-put-global (name val state) (setf (gethash name state) val) state)
(defun fn-olog-connection-line (owner id peer) (declare (ignore owner id peer)) :log)
(defun fn-store-octets->string (octets) (map 'string #'code-char octets))
(defun core-open (owner)
 (note :actual-core-open (fn-own-view owner))
 (when *open-error* (error "injected core escape"))
 (if *accept*
  (cons '(:greeting)
   (list :next 8 :conns (list (cons 7 (fn-own-view owner))) :view (fn-own-view owner)))
  (cons '(:refusal) owner)))
(defun fn-ocar-ocfg-open (owner auth) (declare (ignore auth)) (core-open owner))
(defun fn-ocfg-open-peer (owner peer auth) (declare (ignore peer auth)) (core-open owner))
(defun fn-owner-exposure-state (state) (gethash :exposure state))
(defun fn-owner-exposure-limits (state) (declare (ignore state)) :limits)
(defun fn-owner-exposure-now (state) (declare (ignore state)) 0)
(defun fn-ocar-exp-open (owner exposure limits auth peer address now)
 (declare (ignore limits auth peer address now))
 (let ((r (core-open owner)))
  (list :ocfg (cdr r) :state exposure :id (and *accept* 7) :effects (car r) :refusal '(:refusal))))
(defun fn-exp-open-ocfg (r) (getf r :ocfg))
(defun fn-exp-open-state (r) (getf r :state))
(defun fn-exp-open-id (r) (getf r :id))
(defun fn-exp-open-effects (r) (getf r :effects))
(defun fn-exp-open-refusal (r) (getf r :refusal))
(defun fn-owner-step (event arena state)
 (declare (ignore arena))
 (note :actual-core-close event)
 (when *close-error* (error "injected close escape"))
 (setf (getf (gethash :ocfg state) :conns) nil) state)
(defun fn-owner-credits (state) (gethash :credits state))
(defun fn-mca-close (credits id) (declare (ignore id)) credits)
(defun fn-owner-put-credits (credits state) (setf (gethash :credits state) credits) state)
(defun fn-ocfg-fault (owner id)
 (note :actual-core-fault id)
 (cons '(:fault) (list :next (getf owner :next) :view (getf owner :view) :conns nil)))
(defun fn-mio-connection-open-preflight (id token fuel mio)
 (declare (ignore fuel mio)) (note :preflight id token) *ready*)
(defun capture (kind token fuel mio)
 (note :capture kind token)
 (when (eq *capture* :captured) (incf *pins*))
 (values *capture* (and (eq *capture* :captured) :pin) (- fuel 2) mio))
(defun fn-owner-index-connection-capture (token fuel mio state)
 (capture (if (consp (fn-owner-reader-views state)) :d :current) token fuel mio))
(defun fn-owner-index-working-connection-capture (token fuel mio)
 (capture :current token fuel mio))
(defun fn-mio-connection-finish-open (id token fuel mio)
 (note :finish id token) (values *finish* (- fuel 1) mio))
(defun fn-mio-connection-abort (token fuel mio pool)
 (note :abort token)
 (when (eq *abort* :released) (setf *pins* 0 *charged* 0))
 (values *abort* (- fuel 5) mio pool))
(defun fn-mio-connection-close-preflight (fuel mio)
 (declare (ignore mio)) (>= fuel 5))
(defun fn-mio-connection-event (token op id value fuel mio)
 (declare (ignore value)) (note :mark-closing op id token) (values *closing* nil (- fuel 1) mio))
(defun fn-mio-connection-settle (token fuel mio pool)
 (note :settle token)
 (when (eq *settle* :released) (setf *pins* 0 *charged* 0))
 (values *settle* (- fuel 4) mio pool))
(load __SOURCE_FILE__)

(defmacro scenario (&body body)
 `(let ((*trace* nil) (*accept* t) (*ready* :ready) (*capture* :captured)
        (*finish* :opened) (*abort* :released) (*closing* :closing) (*settle* :released)
        (*open-error* nil) (*close-error* nil) (*pins* 0) (*charged* 40)
        (state (make-hash-table)) (mio (list :mio)) (pool (list :pool)) (token '(:holder 1)))
   (incf *scenario-count*)
   (setf (gethash :ocfg state) (list :next 7 :view :working :conns nil)
         (gethash :views state) '(:d :n))
   ,@body))
(defun run-open (kind token mio pool state)
 (multiple-value-bind (erp result next-mio next-pool next-state)
  (fn-owner-index-open kind :inet '(127 0 0 1) '(80) token 7 mio pool state)
  (assert (null erp)) (assert (eq next-mio mio)) (assert (eq next-pool pool))
  (assert (eq next-state state)) result))
(defun trace-names () (mapcar #'car (reverse *trace*)))
(dolist (kind '(:reader :exposure :peer))
 (scenario
  (assert (equal (run-open kind token mio pool state) (list :opened 7 token)))
  (assert (equal (trace-names) '(:preflight :capture :actual-core-open :finish)))
  (let ((chosen (if (eq kind :reader) :d :working)))
   (assert (eq (second (assoc :actual-core-open *trace*)) chosen))
   (assert (eq (cdr (assoc 7 (fn-own-conns (fn-owner-core state)))) chosen)))
  (assert (eq (fn-own-view (fn-owner-core state)) :working))
  (assert (= *pins* 1)) (assert (= *charged* 40))))
(dolist (ready '(:yield :stale :recovery-required))
 (scenario (setf *ready* ready)
  (assert (equal (run-open :reader token mio pool state) (list ready nil token)))
  (assert (equal (trace-names) '(:preflight))) (assert (= *charged* 40))))
(dolist (kind '(:reader :exposure :peer))
 (scenario (setf *accept* nil)
  (assert (equal (run-open kind token mio pool state) '(:refused nil nil)))
  (assert (equal (trace-names) '(:preflight :capture :actual-core-open :abort)))
  (assert (= *pins* 0)) (assert (= *charged* 0))))
(scenario (setf *capture* :unavailable)
 (assert (equal (run-open :reader token mio pool state) '(:unavailable nil nil)))
 (assert (equal (trace-names) '(:preflight :capture :abort))))
(scenario (setf *capture* :recovery-required)
 (assert (equal (run-open :reader token mio pool state) (list :recovery-required nil token)))
 (assert (equal (trace-names) '(:preflight :capture))) (assert (= *charged* 40)))
(scenario (setf *finish* :recovery-required)
 (assert (equal (run-open :reader token mio pool state) (list :recovery-required 7 token)))
 (assert (fn-own-find-conn 7 (fn-own-conns (fn-owner-core state))))
 (assert (not (member :abort (trace-names)))) (assert (= *pins* 1)))
(scenario (setf *open-error* t)
 (assert (handler-case (progn (run-open :reader token mio pool state) nil) (error () t)))
 (assert (equal (trace-names) '(:preflight :capture :actual-core-open)))
 (assert (= *pins* 1)) (assert (= *charged* 40)))
(dolist (word '(:released :held :busy :recovery-required))
 (scenario (setf *settle* word *pins* 1)
  (multiple-value-bind (erp result next-mio next-pool next-state)
   (fn-owner-index-close 7 token nil 5 mio pool nil state)
   (assert (null erp)) (assert (eq next-mio mio)) (assert (eq next-pool pool))
   (assert (eq next-state state))
   (assert (equal result (case word
     (:released '(:closed 7 nil))
     ((:held :busy) (list :closed-held 7 token))
     (otherwise (list :recovery-required 7 token))))))
  (assert (equal (trace-names) '(:mark-closing :actual-core-close :settle)))
  (assert (= *charged* (if (eq word :released) 0 40)))))
(scenario (setf *pins* 1)
 (multiple-value-bind (erp result next-mio next-pool next-state)
  (fn-owner-index-close 7 token t 5 mio pool nil state)
  (declare (ignore next-mio next-pool next-state))
  (assert (null erp)) (assert (equal result '(:closed 7 nil))))
 (assert (equal (trace-names) '(:mark-closing :actual-core-fault :settle))))
(scenario (setf *closing* :stale)
 (multiple-value-bind (erp result next-mio next-pool next-state)
  (fn-owner-index-close 7 token nil 5 mio pool nil state)
  (declare (ignore erp next-mio next-pool next-state))
  (assert (equal result (list :stale 7 token))))
 (assert (equal (trace-names) '(:mark-closing))))
(scenario (setf *close-error* t *pins* 1)
 (assert (handler-case (progn (fn-owner-index-close 7 token nil 5 mio pool nil state) nil) (error () t)))
 (assert (equal (trace-names) '(:mark-closing :actual-core-close)))
 (assert (= *pins* 1)) (assert (= *charged* 40)))
(format t "PASS connection owner boundaries: ~d scenarios~%" *scenario-count*)

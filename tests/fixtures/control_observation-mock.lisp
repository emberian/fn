(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defmacro defconst (name value) `(defparameter ,name ,value))
(defun natp (x) (and (integerp x) (<= 0 x)))
(deftype fnn-octets () '(vector (unsigned-byte 8)))
(defconstant +fnn-control-io-seconds+ 10)
(defconstant +fnn-max-read+ 4096)
(defvar *now* 0)
(defvar *delay* 13)
(defvar *read-count* 0)
(defvar *maximum-seconds* 0)
(defvar *closed* nil)
(defvar *connect-fails* nil)
(defvar *write-fails* nil)
(defun fnn-core (name &rest args)
 (case name
  (fn-native-control-host-max-frame 64)
  (otherwise (apply name args))))
(defun fnn-control-connect (path)
 (declare (ignore path)) (when *connect-fails* (error "connect failed")) :socket)
(defun fnn-socket-fd (socket) (declare (ignore socket)) 42)
(defun fnn-octets (bytes) bytes) ; named input conversion seam: already octet vectors
(defun fnn-make-octets (length) (make-array length :element-type '(unsigned-byte 8)))
(defun fnn-control-send-request (socket fd bytes)
 (declare (ignore socket fd bytes)) (when *write-fails* (error "write failed")))
(defun fnn-socket-shut (socket) (declare (ignore socket)) (setf *closed* t))
(defun fnn-fault (message) (error message))
(defun fnn-now () *now*)
(defun fnn-seconds-to-deadline (deadline) (/ (- deadline *now*) internal-time-units-per-second))
(defun fnn-recv (fd seconds maximum)
 (declare (ignore fd))
 (setf *maximum-seconds* (max *maximum-seconds* seconds))
 (assert (<= maximum 65))
 (incf *read-count*)
 (if (= *read-count* 1)
     (if (> *delay* seconds) :timeout
       (progn (incf *now* (* *delay* internal-time-units-per-second))
              (make-array 3 :element-type '(unsigned-byte 8) :initial-contents '(1 2 3))))
   (make-array 0 :element-type '(unsigned-byte 8))))
(load "__SOURCE__")
(defun check-exchange (bytes explicit expected-frame expected-stage)
 (let ((*now* 0) (*read-count* 0) (*closed* nil) (*maximum-seconds* 0))
  (multiple-value-bind (frame stage) (fnn-control-exchange "fixture" bytes nil explicit)
   (assert (eql (not (null frame)) expected-frame))
   (when frame (assert (equalp frame #(1 2 3))))
   (assert (eq stage expected-stage))
   (assert (or *connect-fails* *closed*))
   *maximum-seconds*)))
(let ((large (make-array (* 10 1024 1024) :element-type '(unsigned-byte 8)))
      (small (make-array 100 :element-type '(unsigned-byte 8))))
 (assert (= (check-exchange large nil t :after-submission) 170))
 (assert (= (check-exchange small nil nil :after-submission) 11))
 (assert (= (check-exchange large 10 nil :after-submission) 10))
 (assert (= (check-exchange small 30 t :after-submission) 30))
 (let ((*delay* 171)) (check-exchange large nil nil :after-submission))
 (let ((*connect-fails* t)) (check-exchange large nil nil :before-submission))
 (let ((*write-fails* t)) (check-exchange large nil nil :after-submission)))
(assert (eq (fn-native-control-transport-outcome :after-submission) :uncertain))
(assert (eq (fn-native-control-transport-outcome :before-submission) :refused))
(assert (= (fn-nco-reply-seconds 0) 10))
(assert (= (fn-nco-reply-seconds 65536) 11))
(assert (= (fn-nco-reply-seconds 65537) 12))
(assert (< 10 (fn-nco-reply-seconds (1- (expt 2 64)))))
(format t "PASS control observation~%")

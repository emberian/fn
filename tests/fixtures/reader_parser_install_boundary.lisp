(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defmacro mv (&rest xs) `(values ,@xs))
(defmacro mv-let (vars expr &body body) `(multiple-value-bind ,vars ,expr ,@body))
(defun natp (x) (and (integerp x) (>= x 0)))
(defvar *trace*)
(defvar *cut*)
(defvar *require-stage*)
(defvar *parser-root*)
(defvar *actual-rc*)
(defvar *count* 0)
(defun note (name) (push name *trace*))
(defun checked-write (name key value state)
 (note name)
 (when *require-stage*
  (assert (eq (getf *parser-root* :phase) :parser-installing))
  (assert (eq (getf *parser-root* :rc) *actual-rc*)))
 (when (equal *cut* (list name :before)) (error "STATE write cut before ~s" name))
 (setf (gethash key state) value)
 (when (equal *cut* (list name :after)) (error "STATE write cut after ~s" name)) state)
(defun fn-owner-core (state) (gethash :owner state))
(defun fn-own-conns (owner) (getf owner :conns))
(defun fn-own-find-conn (id conns) (assoc id conns))
(defun fn-octets-len (octets) (length octets))
(defun fn-owner-access-cache (state) (gethash :cache state))
(defun fn-scr-prepare-access (cache owner id)
 (declare (ignore cache owner id)) (note :prepare-cache) (list :new-cache))
(defun fn-owner-credits (state) (gethash :credits state))
(defun fn-owner-ocfg (state) (fn-owner-core state))
(defun fn-owner-reader-views (state) (declare (ignore state)) :views)
(defun fn-owner-article-slots (state) (declare (ignore state)) :slots)
(defun fn-owner-credit-reserve (state) (declare (ignore state)) :reserve)
(defun fn-mca-read-span (&rest inputs)
 (declare (ignore inputs)) (note :actual-evaluate) *actual-rc*)
(defun fn-own-tls-result-effects (result) (getf result :effects))
(defun fn-own-tls-result-consumed (result) (getf result :consumed))
(defun fn-own-tls-result-owner (result) (getf result :owner))
(defun f-put-global (key value state) (checked-write :cache key value state))
(defun fn-owner-put-credits (credits state) (checked-write :credits :credits credits state))
(defun fn-owner-install-ocfg (owner state) (checked-write :owner :owner owner state))
(defun fn-owner-exposure-observe (id effects consumed state)
 (declare (ignore id effects consumed)) (checked-write :exposure :exposure :observed state))
(defun fn-served-closingp (effects) (declare (ignore effects)) nil)
(defun fn-served-starttlsp (effects) (declare (ignore effects)) nil)
(defun fn-served-submission (effects) (declare (ignore effects)) nil)
(defun fn-olog-served-refusal-lines (owner id effects) (declare (ignore owner id effects)) nil)
(defun f-get-global (key state) (gethash key state))
(defun fn-splan-step-make (effects close tls submitted consumed refusal exposure)
 (note :actual-step)
 (list :served-step effects close tls submitted consumed refusal exposure))

(defmacro stobj-let (bindings vars expr out)
 `(let ,(mapcar (lambda (b) (list (car b) (cadr b))) bindings)
    (multiple-value-bind ,vars ,expr ,out)))
(defun member-eq (x xs) (member x xs :test #'eq))
(defun fn-own-conn-wire (conn) (cdr conn))
(defvar *capacity*)
(defvar *gate* t)
(defvar *finish-word* :response-recorded)
(defvar *octets*)
(defun fn-owner-rx-parser-source-currentp (id holder ticket provider turn current pool state)
 (declare (ignore turn pool state)) (note :actual-source-gate)
 (assert (= id 7)) (assert (eq holder :holder)) (assert (eq ticket :ticket))
 (assert (eq provider :provider)) (assert (eq current :current)) *gate*)
(defun fn-owner-rx-turn-parser-acquire (ticket preOC wire provider turn pool)
 (declare (ignore ticket preOC wire provider)) (note :parser-acquire)
 (setf *parser-root* (list :phase :parser-owned :source :held-source :rc nil))
 (values :parser-acquired turn pool))
(defun fn-owner-rx-turn-consumer-range (ticket provider turn pool)
 (declare (ignore ticket provider turn pool)) (note :actual-range)
 (values :receiver-readable 0 3))
(defun fn-rxp-octets (provider) (declare (ignore provider)) *octets*)
(defun fn-rxp-carry (provider) (declare (ignore provider)) :carry)
(defun fn-rxc-token (carry) (declare (ignore carry)) :carry-token)
(defun fn-rxc-currentp (token carry) (declare (ignore token carry)) t)
(defun fn-owner-rx-turn-parser-stage (ticket RC provider turn pool)
 (declare (ignore ticket)) (recorded-stage RC) (setf *capacity* :revoked)
 (values :parser-staged provider turn pool))
(defun fn-owner-rx-turn-parser-staged-rc (ticket provider turn pool)
 (declare (ignore ticket provider turn pool)) (note :staged-rc-read)
 (assert (eq *capacity* :revoked))
 (values :staged-result (getf *parser-root* :rc)))
(defun fn-owner-rx-turn-parser-finish (ticket wire step provider turn pool)
 (declare (ignore ticket)) (note :parser-finish)
 (assert (eq *capacity* :revoked))
 (assert (eq (getf *parser-root* :rc) *actual-rc*))
 (assert (eq wire :current-wire))
 (setf (getf *parser-root* :step) step)
 (case *finish-word*
  (:response-recorded (setf (getf *parser-root* :phase) :response-owned))
  (:parser-progress-recorded (setf (getf *parser-root* :phase) :parser-owned *capacity* :published)))
 (values *finish-word* (and (eq *finish-word* :response-recorded) '(:receiver-response :ticket 1)) provider turn pool))
(defun fn-owner-rx-turn-parser-fence (ticket RC wire step provider turn pool)
 (declare (ignore ticket wire)) (note :parser-fence)
 (setf *capacity* :revoked *parser-root* (list :phase :parser-recovery :source :held-source :rc RC :step step))
 (values :parser-recovery provider turn pool))
(load __SOURCE_FILE__)
(defmacro scenario (&body body)
 `(let ((*trace* nil) (*cut* nil) (*require-stage* t) (*parser-root* nil)
        (*actual-rc* (cons (list :effects '(:reply) :consumed 3 :owner (list :conns '((7 . :current-wire)))) :new-credits))
        (state (make-hash-table)) (octets (vector 65 66 67)))
   (incf *count*)
   (setf (gethash :owner state) (list :conns '((7 . :old-wire)))
         (gethash :cache state) :old-cache (gethash :credits state) :old-credits)
   ,@body))
(defun recorded-stage (RC)
 (note :parser-stage)
 (setf *parser-root* (list :phase :parser-installing :source :held-source :rc RC)))
(scenario
 (multiple-value-bind (erp cache RC state1)
  (fn-owner-chunk-span-evaluate 7 0 3 :sched octets nil nil state)
  (assert (null erp)) (assert (eq state1 state)) (assert (eq RC *actual-rc*))
  (assert (eq (gethash :cache state) :old-cache)) (assert (eq (gethash :credits state) :old-credits))
  (assert (equal (reverse *trace*) '(:prepare-cache :actual-evaluate)))
  (recorded-stage RC)
  (multiple-value-bind (step state2) (fn-owner-chunk-span-install-result 7 cache RC state)
   (assert (eq state2 state)) (assert (equal step '(:served-step (:reply) nil nil nil 3 nil nil)))
   (assert (eq (getf *parser-root* :rc) RC))
   (assert (equal (reverse *trace*) '(:prepare-cache :actual-evaluate :parser-stage :cache :credits :owner :exposure :actual-step))))))
(dolist (write '(:cache :credits :owner :exposure))
 (dolist (side '(:before :after))
  (scenario (setf *cut* (list write side))
   (multiple-value-bind (erp cache RC state1)
    (fn-owner-chunk-span-evaluate 7 0 3 :sched octets nil nil state)
    (declare (ignore erp state1)) (recorded-stage RC)
    (assert (handler-case (progn (fn-owner-chunk-span-install-result 7 cache RC state) nil) (error () t)))
    (assert (eq (getf *parser-root* :phase) :parser-installing))
    (assert (eq (getf *parser-root* :rc) *actual-rc*))
    (assert (eq (getf *parser-root* :source) :held-source))
    (assert (not (member :actual-step *trace*)))
    (assert (< (position :parser-stage (reverse *trace*)) (position write (reverse *trace*))))))))
(dolist (bad '(:unknown :bad-range))
 (scenario
  (multiple-value-bind (erp cache RC state1)
   (fn-owner-chunk-span-evaluate (if (eq bad :unknown) 8 7) 0 (if (eq bad :bad-range) 4 3) :sched octets nil nil state)
   (assert (eq erp bad)) (assert (null cache)) (assert (null RC)) (assert (eq state1 state))
   (assert (null *trace*)))
  (let ((*require-stage* nil))
   (multiple-value-bind (erp step state1)
    (fn-owner-chunk-span-at (if (eq bad :unknown) 8 7) 0 (if (eq bad :bad-range) 4 3) :sched octets nil nil state)
    (assert (null erp)) (assert (eq step bad)) (assert (eq state1 state))))))
(scenario
 (let ((*require-stage* nil))
  (multiple-value-bind (erp step state1) (fn-owner-chunk-span-at 7 0 3 :sched octets nil nil state)
   (assert (null erp)) (assert (equal step '(:served-step (:reply) nil nil nil 3 nil nil)))
   (assert (eq state1 state)))))


(scenario
 (let ((*octets* octets) (*capacity* :published) (*gate* t) (*finish-word* :response-recorded))
  (multiple-value-bind (word step episode provider turn pool state1)
   (fn-owner-rx-turn-parser-span 7 :holder :sched :ticket :provider :turn :current :pool nil nil state)
   (assert (eq word :response-recorded))
   (assert (equal step '(:served-step (:reply) nil nil nil 3 nil nil)))
   (assert (equal episode '(:receiver-response :ticket 1)))
   (assert (eq provider :provider)) (assert (eq turn :turn)) (assert (eq pool :pool)) (assert (eq state1 state))
   (assert (eq (getf *parser-root* :phase) :response-owned))
   (assert (eq *capacity* :revoked))
   (assert (equal (reverse *trace*) '(:actual-source-gate :parser-acquire :actual-range :prepare-cache :actual-evaluate
                                     :parser-stage :staged-rc-read :cache :credits :owner :exposure :actual-step :parser-finish))))))
(dolist (write '(:cache :credits :owner :exposure))
 (dolist (side '(:before :after))
  (scenario (setf *cut* (list write side))
   (let ((*octets* octets) (*capacity* :published) (*gate* t))
    (assert (handler-case
      (progn (fn-owner-rx-turn-parser-span 7 :holder :sched :ticket :provider :turn :current :pool nil nil state) nil)
      (error () t)))
    (assert (eq *capacity* :revoked))
    (assert (eq (getf *parser-root* :phase) :parser-installing))
    (assert (eq (getf *parser-root* :rc) *actual-rc*))
    (assert (eq (getf *parser-root* :source) :held-source))
    (assert (not (member :parser-finish *trace*)))
    (assert (not (member :actual-step *trace*)))))))
(scenario
 (let ((*octets* octets) (*capacity* :published) (*gate* nil))
  (multiple-value-bind (word step episode provider turn pool state1)
   (fn-owner-rx-turn-parser-span 7 :holder :sched :ticket :provider :turn :current :pool nil nil state)
   (declare (ignore provider turn pool))
   (assert (eq word :unavailable-parser-source)) (assert (null step)) (assert (null episode))
   (assert (eq state1 state)) (assert (equal *trace* '(:actual-source-gate)))
   (assert (null *parser-root*)))))
(scenario
 (let ((*octets* octets) (*capacity* :published) (*gate* t) (*finish-word* :parser-progress-recorded))
  (setf (getf (car *actual-rc*) :effects) nil)
  (multiple-value-bind (word step episode provider turn pool state1)
   (fn-owner-rx-turn-parser-span 7 :holder :sched :ticket :provider :turn :current :pool nil nil state)
   (declare (ignore provider turn pool state1))
   (assert (eq word :parser-progress-recorded)) (assert (null step)) (assert (null episode))
   (assert (eq *capacity* :published))
   (assert (eq (getf *parser-root* :rc) *actual-rc*)))))
(scenario
 (let ((*octets* octets) (*capacity* :published) (*gate* t) (*finish-word* :unavailable))
  (multiple-value-bind (word step episode provider turn pool state1)
   (fn-owner-rx-turn-parser-span 7 :holder :sched :ticket :provider :turn :current :pool nil nil state)
   (declare (ignore provider turn pool state1))
   (assert (eq word :parser-recovery)) (assert (null step)) (assert (null episode))
   (assert (eq *capacity* :revoked))
   (assert (eq (getf *parser-root* :rc) *actual-rc*))
   (assert (equal (getf *parser-root* :step) '(:served-step (:reply) nil nil nil 3 nil nil))))))
(format t "PASS parser install cuts: ~d scenarios~%" *count*)

; Actual native hook/publisher and frozen owner function; modeled ATS/gate.
(defvar *the-live-state* :old-state)
(defvar *fnn-live-status-buffers* :initial-cache)
(defvar *calls* nil)
(defvar *gate-held* nil)
(defvar *turn* 0)
(defvar *expect-retained* nil)
(defvar *intervening-cache* nil)
(defstruct service inspector binding stopping)
(defun fnn-owner-service-inspector-binding (s) (service-inspector s))
(defun fnn-owner-service-control-binding (s) (service-binding s))
(defun fnn-owner-service-stopping (s) (service-stopping s))
(defun fnn-octet-list-p (x)
 (when *expect-retained* (assert *gate-held*) (assert (eq *the-live-state* :complete-state)) (push :publish-check *calls*))
 (and (listp x) (every (lambda (n) (and (integerp n) (<= 0 n 255))) x)))
(defun fnn-fault (why) (error "~A" why))
(defun fnn-refuse (why) (error "~A" why))
(defun fnn-fixed-callback-fail (&rest why) (error "~S" why))
(defmacro fnn-owner-gated ((service class) &body body)
 `(progn (assert (eq ,class :inspect))
   (let ((*gate-held* t))
    (multiple-value-prog1 (progn ,@body)
     (push :cleanup *calls*)
     (when (and *intervening-cache* (= *turn* 1))
      (setf *fnn-live-status-buffers* :concurrent-cache))))))
(defmacro fnn-with-owner-control-issued-turn ((binding slot nonce slots pool) &body body)
 `(let* ((,slot 0) (,nonce (incf *turn*)) (,slots :actual-slots) (,pool :actual-pool))
   (assert ,binding) (push :enter *calls*)
   (multiple-value-prog1 (progn ,@body) (push :finish *calls*))))
(defun fnn-owner-shared-action-locked (service cid thunk)
 (declare (ignore service)) (assert (null cid)) (assert *gate-held*) (funcall thunk))
(defun fnn-control-live-status-legacy-answer (service request)
 (declare (ignore service request)) (push :legacy *calls*) '(76))
(load "__OWNER_SOURCE__")
(load "__CONTROL_SOURCE__")
(setf *calls* nil)
(assert (equal '(76) (fnn-control-live-status-answer (make-service) '(actual-request))))
(assert (equal *calls* '(:legacy)))
(let* ((request '(actual-request))
       (n 0)
       (s (make-service :binding :actual-installed-control
           :inspector (lambda (r cached job slot nonce slots pool)
            (assert *gate-held*) (assert (eq r request)) (assert (eq cached :initial-cache))
            (assert (eql slot 0)) (assert (eql nonce (1+ n)))
            (assert (eq slots :actual-slots)) (assert (eq pool :actual-pool))
            (assert (if (= n 0) (null job) (equal job '(:report-job 731))))
            (incf n) (push :body *calls*)
            (if (= n 1) (values :yield '(:report-continuation (:report-job 731)) :next-slots :next-pool :yield-state)
             (values :rendered (list '(79 75) :complete-cache) :next-slots :next-pool :complete-state))))))
 (setf *calls* nil *turn* 0 *expect-retained* t *intervening-cache* t)
 (assert (equal '(79 75) (fnn-control-live-status-answer s request)))
 (assert (eq *the-live-state* :complete-state))
 (assert (eq *fnn-live-status-buffers* :complete-cache))
 (assert (equal (reverse *calls*) '(:enter :body :cleanup :finish :enter :body :publish-check :cleanup :finish))))
(setf *expect-retained* nil)
; Actual publisher refuses malformed output without changing cache.
(setf *fnn-live-status-buffers* :prior-cache)
(assert (handler-case (progn (fnn-control-publish-inspect-answer :rendered 'bad) nil) (error () t)))
(assert (eq *fnn-live-status-buffers* :prior-cache))
(format t "PASS actual inspect transport~%")

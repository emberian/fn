; Actual selected recovery body; typed recovery/accessor outputs modeled.
; This records ordering, not source invariant, compiler cost or native runtime.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(proclaim '(declaration xargs))
(defmacro mv (&rest x) `(values ,@x))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun nfix (x) (if (natp x) x 0))
(defun zp (x) (or (not (integerp x)) (<= x 0)))
(defun len (x) (length x))
(defun true-listp (x) (typep x 'list))
(defun boundp-global (k s) (nth-value 1 (gethash k s)))
(defun f-get-global (k s) (gethash k s))
(defun f-put-global (k v s) (setf (gethash k s) v) s)
(defun update-nth (n v x) (let ((y (copy-list x))) (setf (nth n y) v) y))
(defvar *state*) (defvar *scenario*) (defvar *writes*)
__MODELED_ACCESSORS__
(defun fn-onb-open-okp (oc) (declare (ignore oc)) (not (eq *scenario* :damaged)))
(defun fn-sca-load-held-rows-keyed (&rest args)
 (assert (eq :mutating (fn-orc-source *state*)))
 (assert (eq :snapshot-changed (fn-orc-current '(:report 7) *state*)))
 (incf *writes*)
 (when (eq *scenario* :escape-cat) (error "modeled reload escape"))
 (car (last args)))
(defun fn-hist-load (&rest args)
 (assert (eq :mutating (fn-orc-source *state*)))
 (when (eq *scenario* :escape-hist) (error "modeled history escape"))
 (car (last args)))
(load "__SOURCE_FILE__")
(dolist (*scenario* '(:accepted :escape-cat :escape-hist :fault :damaged))
 (let* ((*state* (make-hash-table)) (*writes* 0) (claim '(actual-report-claim)))
  (f-put-global 'fn-owner-report-source-phase :stable *state*)
  (fn-orc-register-internal '(:report 7) :status nil nil '(capture) '(cursor) claim *state*)
  (if (member *scenario* '(:escape-cat :escape-hist))
      (handler-case (progn (fn-owner-install-extended 'oc nil nil nil nil nil *state*) (error "missing escape"))
        (error () (assert (eq :mutating (fn-orc-source *state*)))))
    (fn-owner-install-extended (if (eq *scenario* :fault) :fault 'oc) nil nil nil nil nil *state*))
  (assert (= *writes* (if (member *scenario* '(:fault :damaged)) 0 1)))
  (assert (eq claim (nth 9 (fn-orc-job *state*))))
  (assert (eq (fn-orc-source *state*) (if (member *scenario* '(:escape-cat :escape-hist)) :mutating :stable)))
  (assert (eq (fn-orc-current '(:report 7) *state*)
              (if (member *scenario* '(:fault :damaged)) :report-current :snapshot-changed)))))
(format t "PASS actual recovery report ordering~%")

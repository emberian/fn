; Actual PRS issue and report reservation bodies; qualified family, STATE and
; pool representation modeled. This is not an installed/native allowance.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(proclaim '(declaration xargs))
(defmacro mv (&rest x) `(values ,@x))
(defmacro mv-let (names form &body body) `(multiple-value-bind ,names ,form ,@body))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun nfix (x) (if (natp x) x 0))
(defun zp (x) (or (not (integerp x)) (<= x 0)))
(defun len (x) (length x))
(defun true-listp (x) (typep x 'list))
(defun boundp-global (key state) (nth-value 1 (gethash key state)))
(defun f-get-global (key state) (gethash key state))
(defun f-put-global (key value state) (setf (gethash key state) value) state)
(defun update-nth (n value x) (let ((y (copy-list x))) (setf (nth n y) value) y))
(defvar *source-available* t)
(defvar *escape* nil)
(defvar *state*)
(defvar *capture* '(actual-immutable-capture))
(defvar *debits* 0)
(defvar *demand* '(100 0 0 0 1))
(defun fn-prl-nth (n x) (nth n x))
(defun fn-prl-baseline (x) (nth 4 x))
(defun fn-prl-build (b c n bindings baseline) (list b c n bindings baseline))
(defun fn-owner-page-read-ledger (pool) (gethash :ledger pool))
(defun fn-owner-page-read-keep-ledger (ledger pool)
 (assert (eq :owner-report-reserving (car (fn-orc-job *state*))))
 (assert (eq *capture* (nth 5 (fn-orc-job *state*))))
 (incf *debits*) (setf (gethash :ledger pool) ledger)
 (when *escape* (error "recorded debit escape")) pool)
(defun fn-aec-pool-statep (pool) (hash-table-p pool))
(defun fn-ats-role-bodyp (slot nonce role slots pool)
 (declare (ignore pool)) (and (eql slot 0) (eql nonce 33) (eq role :owner-control) (eq slots :paid-body)))
(defun fn-owner-runtime-operation-resources (kind pool state)
 (declare (ignore pool state)) (assert (eq kind :owner-control-inspect))
 (if *source-available* (mv :runtime-operation-available
  (list :inspect-report-source *demand* '(0 0 0 0 0) '(:inspect-response-source 1000 (1 0 0 0 0))))
 (mv :runtime-operation-unavailable nil)))
(load "__SOURCE_FILE__")
(defun setup (&optional (budget 1000))
 (setf *state* (make-hash-table) *debits* 0 *source-available* t *escape* nil)
 (f-put-global 'fn-owner-report-source-phase :stable *state*)
 (let ((pool (make-hash-table)))
  (setf (gethash :ledger pool) (fn-prl-build (list budget 0 0 0 10) '(0 0 0 0 0) 0 nil '(0 0 0 0 0))) pool))
(defun reserve (pool) (fn-orc-reserve-internal '(request) nil :status *capture* '(cursor) 0 33 :paid-body pool *state*))
(let ((pool (setup)))
 (multiple-value-bind (word token output state) (reserve pool)
  (assert (eq :report-reserved word)) (assert (equal token '(:owner-report 1)))
  (assert (eq pool output)) (assert (eq *state* state))
  (assert (equal *demand* (nth 1 (fn-owner-page-read-ledger pool))))
  (assert (eq :report-current (fn-orc-current token state)))
  (assert (eql 1 *debits*))
  (assert (eq :report-busy (reserve pool))) (assert (eql 1 *debits*))))
(let ((pool (setup 99)))
 (assert (eq :read-resources-unavailable (reserve pool)))
 (assert (null (fn-orc-job *state*))) (assert (eql 0 *debits*)))
(let ((pool (setup)))
 (setf *source-available* nil)
 (assert (eq :report-source-unavailable (reserve pool)))
 (assert (null (fn-orc-job *state*))) (assert (eql 0 *debits*)))
(let ((pool (setup)))
 (setf *escape* t)
 (assert (handler-case (progn (reserve pool) nil) (error () t)))
 (assert (eq :owner-report-reserving (car (fn-orc-job *state*))))
 (assert (eq *capture* (nth 5 (fn-orc-job *state*))))
 (assert (equal *demand* (nth 1 (fn-owner-page-read-ledger pool))))
 (setf *escape* nil)
 (assert (eq :report-busy (reserve pool))) (assert (eql 1 *debits*)))
(format t "PASS actual report PRS reserve~%")

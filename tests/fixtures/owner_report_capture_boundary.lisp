; Literal STATE custody bodies; globals/real issued reservation modeled only.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(proclaim '(declaration xargs))
(defmacro mv (&rest x) `(values ,@x))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun nfix (x) (if (natp x) x 0))
(defun zp (x) (or (not (integerp x)) (<= x 0)))
(defun len (x) (length x))
(defun true-listp (x) (typep x 'list))
(defun boundp-global (key state) (nth-value 1 (gethash key state)))
(defun f-get-global (key state) (gethash key state))
(defun f-put-global (key value state) (setf (gethash key state) value) state)
(defun update-nth (n value x) (let ((y (copy-list x))) (setf (nth n y) value) y))
(load "__SOURCE_FILE__")
(let* ((state (make-hash-table)) (token '(:actual-prs-report 731))
       (capture '(original-oc config pins profile extras))
       (claim '(actual-original-demand-retained)) (cursor '(current-stage)))
 (assert (eq :report-source-unavailable (fn-orc-register-internal token :status '(request) nil capture cursor claim state)))
 (f-put-global 'fn-owner-report-source-phase :stable state)
 (assert (eq :report-registered (fn-orc-register-internal token :status '(request) nil capture cursor claim state)))
 (assert (eq :report-busy (fn-orc-register-internal '(:other 732) :status '(request) nil capture cursor claim state)))
 (assert (eq :report-stale (fn-orc-current '(:other 732) state)))
 (assert (eq :report-current (fn-orc-current token state)))
 (let ((job (fn-orc-job state)))
  (fn-orc-writer-enter state)
  (assert (eq :snapshot-changed (fn-orc-current token state)))
  (assert (eq capture (nth 5 (fn-orc-job state))))
  (assert (eq claim (nth 9 (fn-orc-job state))))
  (fn-orc-writer-enter state)
  (fn-orc-writer-leave state)
  (assert (eq :mutating (fn-orc-source state)))
  (fn-orc-writer-leave state)
  (assert (eq :stable (fn-orc-source state)))
  (assert (eq :snapshot-changed (fn-orc-current token state)))
  (assert (eq :snapshot-changed (fn-orc-keep-progress-internal token '(new-cursor) state)))
  (assert (eq cursor (nth 6 (fn-orc-job state))))
  (assert (eq :snapshot-changed (fn-orc-complete-internal token '(report-octets) state)))
  (assert (eq :report-busy (fn-orc-register-internal '(:new 733) :status nil nil nil nil nil state)))
  (assert (equal (nth 1 job) (nth 1 (fn-orc-job state)))))
 (fn-orc-writer-fault state)
 (fn-orc-writer-enter state) (fn-orc-writer-leave state)
 (assert (eq :fault (fn-orc-source state)))
 (assert (eq claim (nth 9 (fn-orc-job state)))))
(format t "PASS sticky report custody~%")

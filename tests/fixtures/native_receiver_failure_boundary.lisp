(require :sb-bsd-sockets)
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
;; Outcome constants are fixtures; production derives these from ACL2.
(defconstant +fnn-exit-ok+ 0)
(defconstant +fnn-exit-uncertain+ 3)
(defconstant +fnn-exit-fault+ 4)
(defvar *fnn-extent-lock* (sb-thread:make-mutex))
(defvar *fnn-payload-lifecycle-lock* (sb-thread:make-mutex))
(defvar *fnn-payload-lifecycle-owner* nil)
(defvar *fnn-payload-lifecycle-phase* :serving)
(defvar *fnn-owner-measure-label* nil)
(defvar *service* nil)
(defvar *reports* 0)
(defvar *drain-cause* nil)
(defvar *fence-cause* nil)
(defvar *range-mode* :receive-copy)
(defvar *publish-cause* nil)
(defvar *cause* nil)
(defvar *fences* 0)
(defvar *published* 0)
(defvar *stop-hooks* 0)
(defvar *unlock-observations* nil)
(defvar *cases* 0)
(defvar *token* (list :incoming 17))
(defvar *obligation* (list :retained-charge 128))
(defvar *provider* nil)
(deftype fnn-octets () '(simple-array (unsigned-byte 8) (*)))
(defmacro fnn-owner-measured ((label) &body body)
  (declare (ignore label)) `(progn ,@body))
(defun fnn-owner-space-preobserve (service) (declare (ignore service)))
(defun fnn-owner-gate-enter (gate class) (declare (ignore gate class)) 0)
(defun fnn-owner-gate-leave (gate class hold wait)
  (declare (ignore gate class hold wait))
  (push (fnn-owner-service-stopping *service*) *unlock-observations*))
(defun fnn-ms-since (start) (declare (ignore start)) 0)
(defun fnn-developer-selector (name) (declare (ignore name)) nil)
(defun fnn-owner-action (&rest args) (declare (ignore args)) nil)
(defun fnn-err (&rest args) (declare (ignore args)) (error "unexpected diagnostic"))
(define-condition print-trap (error) ()
  (:report (lambda (c s) (declare (ignore c s))
             (incf *reports*) (error "arbitrary condition rendered"))))
(defun fnn-payload-lifecycle-answer (op)
  (assert (eq op :drain))
  (assert (sb-thread:holding-mutex-p (fnn-owner-service-lock *service*)))
  (when *drain-cause* (error *drain-cause*))
  '(:allowed :draining))
(defun fnn-receiver-backing (provider)
  (assert (eq provider *provider*)) (svref provider 0))
(defun fnn-receiver-publish-fill (provider end)
  (assert (eq provider *provider*))
  (assert (sb-thread:holding-mutex-p *fnn-extent-lock*))
  (incf *published*)
  (when *publish-cause* (error *publish-cause*))
  (setf (svref provider 1) end))
(load __SOURCE_FILE__)
(defun bytes (&rest values)
  (make-array (length values) :element-type '(unsigned-byte 8) :initial-contents values))
(defun fresh ()
  (setf *service* (%make-fnn-owner-service
                   :lock (sb-thread:make-mutex)
                   :stop-hooks (list (lambda (service)
                                       (assert (fnn-owner-service-stopping service))
                                       (incf *stop-hooks*))))
        *fnn-payload-lifecycle-owner* *service*
        *fnn-payload-lifecycle-phase* :serving
        *provider* (vector (bytes 9 9 9 9) 0 t *token* *obligation*)
        *reports* 0 *drain-cause* nil *fence-cause* nil
        *range-mode* :receive-copy *publish-cause* nil
        *cause* (make-condition 'print-trap)
        *fences* 0 *published* 0 *stop-hooks* 0 *unlock-observations* nil))
(defun range-callback (token length limits fuel provider)
  (declare (ignore limits))
  (assert (and (eq token *token*) (eq provider *provider*) (= length 2) (= fuel 7)))
  (assert (sb-thread:holding-mutex-p *fnn-extent-lock*))
  (case *range-mode*
    (:error (error *cause*))
    (:escape (throw 'raw-ev-fncall :escaped))
    (otherwise (values *range-mode* 0 2 5 provider))))
(defun fence-callback (token provider)
  (assert (and (eq token *token*) (eq provider *provider*)))
  (assert (sb-thread:holding-mutex-p *fnn-extent-lock*))
  (incf *fences*)
  (cond ((eq *fence-cause* :escape) (throw 'raw-ev-fncall :fence-escaped))
        (*fence-cause* (error *fence-cause*)))
  (setf (svref provider 2) nil)
  (values :receiver-fenced provider))
(defun receive ()
  (fnn-owner-serialized *service* nil
    (lambda ()
      (fnn-owner-receiver-fill (bytes 1 2) *token* *provider*
                               #'range-callback #'fence-callback :limits 7)) :reader))
(defun caught (thunk)
  (handler-case (progn (funcall thunk) nil) (serious-condition (condition) condition)))
(defun assert-stopped (exit)
  (assert (fnn-owner-service-stopping *service*))
  (assert (= (fnn-owner-service-exit-code *service*) exit))
  (assert (every #'identity *unlock-observations*))
  (dolist (class '(:reader :poster :transit :control))
    (let ((ran nil))
      (assert (typep (caught (lambda ()
                             (fnn-owner-serialized *service* nil
                               (lambda () (setf ran t)) class))) 'fnn-store-error))
      (assert (not ran))))
  (assert (eq (svref *provider* 3) *token*))
  (assert (eq (svref *provider* 4) *obligation*))
  (assert (zerop *reports*)))

;; Complete normal result, SAME provider and outside-byte preservation.
(fresh)
(multiple-value-bind (word left provider) (receive)
  (assert (and (eq word :receive-copy) (= left 5) (eq provider *provider*))))
(assert (equalp (svref *provider* 0) (bytes 1 2 9 9)))
(assert (and (= (svref *provider* 1) 2) (= *published* 1) (= *fences* 0)))
(assert (not (fnn-owner-service-stopping *service*)))
(incf *cases*)

;; Every explicit semantic yield/refusal remains a result, with no copy/fence.
(dolist (word '(:receiver-unavailable :bad-receive-range :receive-quantum-full :receive-yield))
  (fresh) (setf *range-mode* word)
  (multiple-value-bind (result left provider) (receive)
    (assert (and (eq result word) (= left 5) (eq provider *provider*))))
  (assert (equalp (svref *provider* 0) (bytes 9 9 9 9)))
  (assert (and (zerop *published*) (zerop *fences*)
               (not (fnn-owner-service-stopping *service*))))
  (incf *cases*))

;; Range condition and raw nonlocal escape; exact subject/tag/cause retained.
(dolist (mode '(:error :escape))
  (fresh) (setf *range-mode* mode)
  (let ((fault (caught #'receive)))
    (assert (typep fault 'fnn-fixed-callback-fault))
    (assert (eq (fnn-fixed-fault-subject fault) 'fn-rxp-fill-range))
    (assert (eq (fnn-fixed-fault-tag fault)
                (if (eq mode :error) :raw-callback-failed :raw-callback-escaped)))
    (assert (eq (fnn-fixed-fault-cause fault) (if (eq mode :error) *cause* nil))))
  (assert (and (= *fences* 1) (not (svref *provider* 2))))
  (assert-stopped +fnn-exit-fault+)
  (incf *cases*))

;; Bytes may already have changed when publishing the fill throws. Keep them
;; and the charge; a successful core fence revokes the provider, without rollback.
(fresh) (setf *publish-cause* *cause*)
(assert (eq (caught #'receive) *cause*))
(assert (equalp (svref *provider* 0) (bytes 1 2 9 9)))
(assert (and (= (svref *provider* 1) 0) (= *fences* 1) (not (svref *provider* 2))))
(assert-stopped +fnn-exit-fault+)
(incf *cases*)

;; Malformed callback words are opaque evidence, never printer input.
(fresh) (setf *range-mode* *cause*)
(let ((fault (caught #'receive)))
  (assert (typep fault 'fnn-fixed-callback-fault))
  (assert (eq (fnn-fixed-fault-tag fault) :invalid-receive-word))
  (assert (eq (fnn-fixed-fault-cause fault) *cause*)))
(assert-stopped +fnn-exit-fault+)
(incf *cases*)

;; Failed fence before mutation leaves readiness set. The global owner stop,
;; not an invented successful core revocation, excludes every later consumer.
(dolist (fence-mode '(:error :escape))
  (fresh) (setf *range-mode* :error
                *fence-cause* (if (eq fence-mode :error) (make-condition 'print-trap) :escape))
  (let ((fault (caught #'receive)))
    (assert (typep fault 'fnn-fixed-callback-fault))
    (assert (eq (fnn-fixed-fault-subject fault) 'fn-rxp-fence)))
  (assert (and (= *fences* 1) (svref *provider* 2)))
  (assert-stopped +fnn-exit-fault+)
  (incf *cases*))

;; A failure inside STOP itself must not reopen the owner, skip wakeups, clear
;; the charge, manufacture a joined lifecycle, or overwrite first-terminal code.
(dolist (exit '(3 4))
  (fresh) (setf *drain-cause* (make-condition 'print-trap))
  (caught (lambda ()
            (fnn-owner-serialized *service* nil
              (lambda ()
                (if (= exit 3)
                    (error 'fnn-store-indeterminate :message "uncertain")
                  (fnn-core-mv 'callback (error *cause*)))))))
  (assert-stopped exit)
  (assert (> (fnn-owner-service-commits *service*) 0))
  (assert (= *stop-hooks* 1))
  (assert (eq *fnn-payload-lifecycle-phase* :serving))
  (sb-thread:with-mutex ((fnn-owner-service-lock *service*))
    (fnn-owner-stop-service-locked *service* +fnn-exit-fault+))
  (assert (= (fnn-owner-service-exit-code *service*) exit))
  (incf *cases*))

;; A known refusal is still connection-scoped, and uncertain remains exit 3.
(fresh)
(assert (typep (caught (lambda () (fnn-owner-serialized *service* nil
                                  (lambda () (fnn-refuse "known refusal"))))) 'fnn-store-error))
(assert (not (fnn-owner-service-stopping *service*)))
(incf *cases*)
(fresh)
(caught (lambda () (fnn-owner-serialized *service* nil
                      (lambda () (error 'fnn-store-indeterminate :message "uncertain")))))
(assert-stopped +fnn-exit-uncertain+)
(incf *cases*)

;; A real second thread is ready to acquire the same mutex before the failure.
;; It must see STOPPING once the failing thread releases ownership.
(fresh)
(let ((started (sb-thread:make-semaphore :count 0)) (thread nil)
      (ran nil) (refused nil))
  (caught (lambda ()
            (fnn-owner-serialized *service* nil
              (lambda ()
                (setf thread (sb-thread:make-thread
                              (lambda ()
                                (sb-thread:signal-semaphore started)
                                (setf refused
                                      (typep (caught (lambda ()
                                                       (fnn-owner-serialized *service* nil
                                                         (lambda () (setf ran t)) :poster)))
                                             'fnn-store-error)))))
                (sb-thread:wait-on-semaphore started)
                (fnn-core-mv 'callback (error *cause*))))))
  (sb-thread:join-thread thread)
  (assert (and refused (not ran)))
  (assert-stopped +fnn-exit-fault+)
  (incf *cases*))
(format t "PASS receiver fault boundary: ~d cases, real mutex exclusion, no condition rendering~%" *cases*)

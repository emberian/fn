(require :sb-bsd-sockets)
(require :sb-posix)
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defvar *fnn-owner-start-hooks* nil)
(defvar *fnn-owner-stop-hooks* nil)
(defvar *fnn-owner-close-hooks* nil)
(defvar *the-live-state* nil)
(defvar *standard-co* nil)
(defconstant +fnn-control-io-seconds+ 10)
(deftype fnn-octets () '(vector (unsigned-byte 8)))
(defun fnn-fault (message &rest args) (apply #'error message args))
(defun fnn-refuse (message &rest args) (apply #'error message args))
(defun fnn-err (message &rest args) (apply #'format *error-output* message args))
(defvar *test-developer* t)
(defun fnn-developer-image-p () *test-developer*)
(defun fnn-lstat (path) (ignore-errors (sb-posix:lstat path)))
(defun fnn-unlink (path) (sb-posix:unlink path))
(defun fnn-socket-shut (socket) (ignore-errors (sb-bsd-sockets:socket-close socket)))
(defun fnn-socket-shutdown (socket) (ignore-errors (sb-bsd-sockets:socket-shutdown socket :direction :io)))
(defun fnn-socket-fd (socket) (sb-bsd-sockets:socket-file-descriptor socket))
; Transport timing/nonblocking primitives are fixture adapters; server request
; handling, peer-UID authorization, lifecycle and developer evaluator are actual.
(defun fnn-accept-observe (socket seconds)
 (if (sb-sys:wait-until-fd-usable (fnn-socket-fd socket) :input seconds)
     (sb-bsd-sockets:socket-accept socket) :timeout))
(defun fnn-control-read-frame (socket maximum)
 (let ((stream (sb-bsd-sockets:socket-make-stream socket :input t :element-type '(unsigned-byte 8) :buffering :none :auto-close nil))
       (bytes (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
  (loop for byte = (read-byte stream nil nil) while byte do
   (when (= (length bytes) maximum) (return-from fnn-control-read-frame :overbound))
   (vector-push-extend byte bytes)) bytes))
(defun fnn-send-all (fd bytes seconds)
 (declare (ignore seconds))
 (let ((stream (sb-sys:make-fd-stream fd :output t :element-type '(unsigned-byte 8) :buffering :none :auto-close nil)))
  (write-sequence bytes stream) (finish-output stream)))
; Real owner admission/fence machinery is not loaded here. This mutex lets the
; socket test verify same-world evaluation without pretending to prove it.
(defvar *owner-lock* (sb-thread:make-mutex))
(defun fnn-owner-serialized (service cid thunk class)
 (declare (ignore service cid class))
 (sb-thread:with-mutex (*owner-lock*) (funcall thunk)))
(load "__CONTROL__")
(let ((*test-developer* nil))
 (assert (null (fnn-developer-selector "FN_NATIVE_DEV_REPL")))
 (assert (string= (fnn-developer-selector-refusal nil) "FN_NATIVE_DEV_REPL")))
(load "__TRACE__")
(load "__REPL__")
;; Upgrade from old function-object registration, then reload again. Hooks
;; retain other participants and contain exactly one current developer hook.
(setf *fnn-owner-start-hooks* (list #'fnn-dev-repl-start 'identity)
      *fnn-owner-stop-hooks* (list #'fnn-dev-repl-stop 'identity)
      *fnn-owner-close-hooks* (list #'fnn-dev-repl-close 'identity))
(load "__REPL__")
(load "__REPL__")
(assert (equal *fnn-owner-start-hooks* '(fnn-dev-repl-start identity)))
(assert (equal *fnn-owner-stop-hooks* '(fnn-dev-repl-stop identity)))
(assert (equal *fnn-owner-close-hooks* '(fnn-dev-repl-close identity)))
; A pre-existing caller file survives a refused start byte-for-byte.
(let ((path (sb-ext:posix-getenv "FN_NATIVE_DEV_REPL")))
 (with-open-file (out path :direction :output :if-exists :error) (write-line "preserve me" out))
 (assert (handler-case (progn (fnn-dev-repl-start :fixture-owner) nil) (error () t)))
 (with-open-file (in path) (assert (string= (read-line in) "preserve me")))
 (delete-file path))
; Failure after binding/listening must release our own path and descriptor.
(let ((original (symbol-function 'fnn-dev-listen))
      (path (sb-ext:posix-getenv "FN_NATIVE_DEV_REPL")))
 (unwind-protect
  (progn
   (setf (symbol-function 'fnn-dev-listen)
         (lambda (control) (funcall original control) (error "injected start failure")))
   (assert (handler-case (progn (fnn-dev-repl-start :fixture-owner) nil) (error () t)))
   (assert (null (fnn-lstat path)))
   (assert (null *fnn-dev-repl*)))
  (setf (symbol-function 'fnn-dev-listen) original)))
(dolist (hook *fnn-owner-start-hooks*) (funcall hook :fixture-owner))
(format t "READY~%")
(finish-output)
(read-line)
(dolist (hook *fnn-owner-stop-hooks*) (funcall hook :fixture-owner))
(dolist (hook *fnn-owner-close-hooks*) (funcall hook :fixture-owner))

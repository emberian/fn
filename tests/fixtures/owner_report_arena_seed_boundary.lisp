; Actual selected recovery body; typed recovery/accessor outputs modeled.
; This records ordering, not source invariant, compiler cost or native runtime.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(proclaim '(declaration xargs))
(defmacro mv (&rest x) `(values ,@x))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun nfix (x) (if (natp x) x 0))
(defun zp (x) (or (not (integerp x)) (<= x 0)))
(defun len (x) (length x))
(defun true-listp (x) (typep x 'list))
(defun boundp-global (k s) (nth-value 1 (gethash k s)))
(defun f-get-global (k s) (gethash k s))
(defun f-put-global (k v s) (setf (gethash k s) v) s)
(defun update-nth (n v x) (let ((y (copy-list x))) (setf (nth n y) v) y))
(defmacro mv-let (vars expr &body body) `(multiple-value-bind ,vars ,expr ,@body))
(defvar *state*) (defvar *scenario*)
(defvar *fn-reader-payload* '(65)) (defvar *fn-reader-archive* '(archive))
(defun probe (cut)
 (assert (eq :mutating (fn-orc-source *state*)))
 (assert (eq :snapshot-changed (fn-orc-current '(:report 7) *state*)))
 (when (eq *scenario* cut) (error "modeled arena escape")))
(defun fn-arena-clear (a) (probe :clear) a)
(defun fn-arena-seal-list (payload a) (declare (ignore payload)) (probe :seal) a)
(defun fn-rdc-selection (&rest args) args)
(defun fn-reader-install-selection (sel s)
 (declare (ignore sel)) (probe :selection) (values (eq *scenario* :erp) :ready s))
(load "__SOURCE_FILE__")
(dolist (*scenario* '(:accepted :clear :seal :selection :erp))
 (let* ((*state* (make-hash-table)) (claim '(held-report-charge)))
  (f-put-global 'fn-owner-report-source-phase :stable *state*)
  (fn-orc-register-internal '(:report 7) :status nil nil '(capture) '(cursor) claim *state*)
  (if (member *scenario* '(:clear :seal :selection))
   (handler-case (fn-reader-use-seed nil *state*) (error () nil))
   (fn-reader-use-seed nil *state*))
  (assert (eq (fn-orc-source *state*)
   (cond ((eq *scenario* :accepted) :stable) ((eq *scenario* :erp) :fault) (t :mutating))))
  (assert (eq claim (nth 9 (fn-orc-job *state*))))
  (assert (eq :snapshot-changed (fn-orc-current '(:report 7) *state*)))))
(format t "PASS actual arena seed report ordering~%")

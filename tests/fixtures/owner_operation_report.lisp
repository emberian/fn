(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(proclaim '(declaration xargs))
(defmacro mv (&rest args) `(values ,@args))
(defmacro mv-let (names form &body body) `(multiple-value-bind ,names ,form ,@body))
(defun len (x) (if (consp x) (1+ (len (cdr x))) 0))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun posp (x) (and (integerp x) (< 0 x)))
(defun zp (x) (or (not (integerp x)) (<= x 0)))
(defun member-eq (x xs) (member x xs :test #'eq))
(defun member-equal (x xs) (member x xs :test #'equal))
(defun fn-ncfg-first (x) (car x))
(defun fn-ncfg-third (x) (caddr x))
(defun fn-ncfg-nth (n x) (nth n x))
; STATE adapter for ordinary Lisp execution. The source reads the same keys;
; this fixture does not assert an ACL2 state or resource-pool theorem.
(defun boundp-global (key state) (nth-value 1 (gethash key state)))
(defun f-get-global (key state) (gethash key state))
; Wire framing/digest observations are the only transport stand-ins here.
(defparameter *fn-nls-chunk-octets* 4096)
(defun fn-record-string-octets (x) (map 'list #'char-code x))
(defun fn-record-octets-string (x) (coerce (mapcar #'code-char x) 'string))
(defun fn-cbor-octet-listp (x) (every (lambda (b) (typep b '(unsigned-byte 8))) x))
(defun fn-record-uint32p (x) (typep x '(unsigned-byte 32)))
(defun fn-frame-trailer (x) (declare (ignore x)) '(1 2 3))
(defun fn-nls-reply-encode (status total digest bytes) (list status total digest bytes))
(defun fn-cev-any-request-decode (request) request)
(defun fn-nlp-pagedp (kind) (declare (ignore kind)) nil)
(defun fn-nsc-answer-report (&rest args) (declare (ignore args)) (error "operation must not scan Store"))
(load "__SOURCE_FILE__")
(defun report-text (bytes) (coerce (mapcar #'code-char bytes) 'string))
(let* ((token '(:admission-grant 731 19 3 4 23 :article))
       (current (list token '(13 17 19 23 29) :reserved :secret-borrowed-graph nil))
       (state (make-hash-table)))
 (setf (gethash 'fn-owner-canonical-admission-pending state) current
       (gethash 'fn-owner-canonical-epoch state) 19
       (gethash 'fn-owner-history-publication state) '(:history-installed 0 1 2 3 19)
       (gethash 'fn-owner-history-semantic-source state)
       (list :history-semantic-source token '(:history-installed 0 1 2 3 19) nil))
 (multiple-value-bind (word bytes) (fn-owner-operation-report 4096 state)
  (assert (eq word :rendered))
  (let ((text (report-text bytes)))
   (dolist (field '("operation observation=observed" "admission-nonce=731" "operation-kind=article" "phase=reserved" "epoch=19" "txid=23" "hold4=29" "reason=writer-current"))
    (assert (search field text)))
   (assert (not (search "secret" text)))
   (assert (not (search "allocated=" text))))
  (multiple-value-bind (w b) (fn-owner-operation-report (length bytes) state)
   (assert (eq w :rendered)) (assert (equal b bytes)))
  (multiple-value-bind (w b) (fn-owner-operation-report (1- (length bytes)) state)
   (assert (eq w :response-budget-unavailable)) (assert (null b))))
 (let* ((answer (fn-native-live-status-host-answer '(:live-status :operation 0) nil nil 0 nil nil nil nil state))
        (bytes (fourth (first answer))) (cache (second answer)))
  (assert (search "admission-nonce=731" (report-text bytes)))
  (setf (gethash 'fn-owner-canonical-admission-pending state) nil)
  (let ((next (fn-native-live-status-host-answer '(:live-status :operation 1) cache nil 0 nil nil nil nil state)))
   (assert (equal (fourth (first next)) (cdr bytes))))
  (let ((fresh (fn-native-live-status-host-answer '(:live-status :operation 0) cache nil 0 nil nil nil nil state)))
   (assert (search "operation-not-issued" (report-text (fourth (first fresh)))))))
 (setf (gethash 'fn-owner-canonical-admission-pending state) current)
 (setf (gethash 'fn-owner-history-completion-fault state) :fenced)
 (assert (search "reason=recovery-required" (report-text (nth-value 1 (fn-owner-operation-report 4096 state)))))
 (remhash 'fn-owner-history-completion-fault state)
 (setf (gethash 'fn-owner-canonical-admission-pending state) nil)
 (assert (search "reason=operation-not-issued" (report-text (nth-value 1 (fn-owner-operation-report 4096 state)))))
 (setf (gethash 'fn-owner-canonical-admission-pending state) '(:malformed))
 (assert (search "observation=unavailable" (report-text (nth-value 1 (fn-owner-operation-report 4096 state)))))
 (multiple-value-bind (word bytes) (fn-oor-report current :waiting (expt 10 10000) nil 4096)
  (assert (eq word :response-budget-unavailable)) (assert (null bytes))))
(let ((plan (fn-nop-parse-command '("operation") "config" nil)))
 (assert (eq (fn-native-operator-result-status plan) :accepted))
 (assert (eq (fn-native-operator-result-status-kind plan) :operation))
 (assert (eq (fn-native-operator-result-native-action plan) :operation)))
(assert (= (fn-nls-kind-code :operation) 14))
(assert (eq (fn-nls-code-kind 14) :operation))
(format t "PASS actual operation report and operator route~%")

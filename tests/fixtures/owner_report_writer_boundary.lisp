; Literal current owner writer bodies. STATE/owner result/catalog represented
; by recording models; no installed authority/native execution claim.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(proclaim '(declaration xargs))
(defmacro mv (&rest x) `(values ,@x))
(defmacro mv-let (vars expr &body body) `(multiple-value-bind ,vars ,expr ,@body))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun nfix (x) (if (natp x) x 0))
(defun zp (x) (or (not (integerp x)) (<= x 0)))
(defun len (x) (length x))
(defun true-listp (x) (typep x 'list))
(defun boundp-global (k s) (nth-value 1 (gethash k s)))
(defun f-get-global (k s) (gethash k s))
(defun f-put-global (k v s) (setf (gethash k s) v) s)
(defun update-nth (n v x) (let ((y (copy-list x))) (setf (nth n y) v) y))
(defvar *state*) (defvar *catalog-word*) (defvar *escape*) (defvar *writes*)
(defun fn-owner-ocfg (s) (gethash 'oc s))
(defun fn-ocfg-staged (oc) (declare (ignore oc)) nil)
(dolist (name '(fn-ocfg-owner fn-own-store fn-sn-files fn-own-view fn-own-view-index fn-pc-held))
 (setf (symbol-function name) #'identity))
(defun fn-sf-completion (x) (declare (ignore x)) '(1 . 12))
(defun fn-owner-take-config (s) (declare (ignore s)) nil)
(defun fn-owner-parse-carry (s) (declare (ignore s)) nil)
(defun fn-apc-own-finish (&rest args) (declare (ignore args)) '(:durable . actual-owner))
(defun fn-owner-replace-core (owner s) (setf (gethash 'core s) owner) s)
(defun fn-owner-store (s) (gethash 'oc s))
(defun fn-owner-core (s) (gethash 'core s))
(defun fn-owner-finish (hist s) (values nil :durable hist s))
(defun fn-pc-expected (x) (declare (ignore x)) 1)
(defun fn-record-msgid (x) (declare (ignore x)) "actual-mid")
(defun fn-own-view-withdrawals (x) (declare (ignore x)) nil)
(defun fn-sca-targets-of (&rest args) (declare (ignore args)) nil)
(defun fn-sca-finish (&rest args)
 (assert (eq :mutating (fn-orc-source *state*)))
 (assert (eq :snapshot-changed (fn-orc-current '(:report 7) *state*)))
 (incf *writes*)
 (when *escape* (error "modeled catalog write escape"))
 (values (list *catalog-word*) nil (car (last args))))
(load "__SOURCE_FILE__")
(dolist (entry '(fn-owner-finish-submission-synced fn-owner-finish-identity))
 (dolist (scenario '(:accepted :stale :escape :no-pending))
  (let* ((*state* (make-hash-table)) (*catalog-word* (if (eq scenario :stale) :stale-token :committed))
         (*escape* (eq scenario :escape)) (*writes* 0) (claim '(charged-original-report)))
   (f-put-global 'oc 'actual-oc *state*)
   (f-put-global 'core 'actual-owner *state*)
   (f-put-global 'fn-owner-cat-pending (unless (eq scenario :no-pending) 'actual-pending) *state*)
   (f-put-global 'fn-owner-report-source-phase :stable *state*)
   (fn-orc-register-internal '(:report 7) :status nil nil '(retained-original-capture) '(cursor) claim *state*)
   (if *escape*
       (handler-case (progn (funcall entry nil 'catalog nil *state*) (error "escape absent"))
         (error () (assert (eq :mutating (fn-orc-source *state*)))))
     (funcall entry nil 'catalog nil *state*))
   (assert (= *writes* (if (eq scenario :no-pending) 0 1)))
   (assert (eq claim (nth 9 (fn-orc-job *state*))))
   (assert (eq (fn-orc-source *state*) (case scenario (:stale :fault) (:escape :mutating) (otherwise :stable))))
   (assert (eq (fn-orc-current '(:report 7) *state*) (if (eq scenario :no-pending) :report-current :snapshot-changed))))))
(format t "PASS actual report writer ordering~%")

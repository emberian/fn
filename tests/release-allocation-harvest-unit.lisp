; Completion-binding controls only. The waiting row is an explicit antecedent,
; not a fabricated proof of issuance, descriptor authentication or publication.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/release-allocation-harvest")
(defun fn2-rah-body (mode fn2-allocation-release)
 (declare (xargs :stobjs fn2-allocation-release :verify-guards nil))
 (b* ((fn2-allocation-release (fn2-allocation-release-init 1 fn2-allocation-release))
      (fn2-allocation-release (fn2-allocation-release-put 0
       (read-phase *fn2-allocation-release-read-phase-wait*) (read-pending 1)
       (read-op-slot 4) (read-op-gen 7) (read-length 4096)
       (owner-kind 3) (owner-slot 2) (owner-gen 11) (checkpoint 17)))
      ((mv code fn2-allocation-release)
       (fn2-allocation-release-harvest
        (if (eq mode :slot) 5 4) (if (eq mode :generation) 8 7)
        (if (eq mode :cell) 1 0) (if (eq mode :event) *fn2-event-write-result* *fn2-event-read-result*)
        (if (eq mode :outcome) *fn2-outcome-failed* *fn2-outcome-done*)
        'arbitrary-reason (if (eq mode :short) 4095 4096) 'arbitrary-aux0 'arbitrary-aux1
        fn2-allocation-release)))
  (mv (and (eq code :ok)
    (= (fn2-allocation-release-owner-kind 0 fn2-allocation-release) 3)
    (= (fn2-allocation-release-owner-slot 0 fn2-allocation-release) 2)
    (= (fn2-allocation-release-owner-gen 0 fn2-allocation-release) 11)
    (= (fn2-allocation-release-checkpoint 0 fn2-allocation-release) 17)
    (= (fn2-allocation-release-read-op-slot 0 fn2-allocation-release) 4)
    (= (fn2-allocation-release-read-op-gen 0 fn2-allocation-release) 7)
    (= (fn2-allocation-release-read-pending 0 fn2-allocation-release)
       (if (member-eq mode '(:slot :generation :cell :event)) 1 0))
    (= (fn2-allocation-release-read-phase 0 fn2-allocation-release)
       (cond ((member-eq mode '(:slot :generation :cell :event)) *fn2-allocation-release-read-phase-wait*)
             ((member-eq mode '(:outcome :short)) *fn2-allocation-release-read-phase-uncertain*)
             (t *fn2-allocation-release-read-phase-loaded*)))) fn2-allocation-release)))
(defun fn2-rah-run (mode)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-allocation-release) (fn2-rah-body mode fn2-allocation-release)))
(assert-event (fn2-rah-run nil))
(assert-event (fn2-rah-run :slot))
(assert-event (fn2-rah-run :generation))
(assert-event (fn2-rah-run :cell))
(assert-event (fn2-rah-run :event))
(assert-event (fn2-rah-run :outcome))
(assert-event (fn2-rah-run :short))

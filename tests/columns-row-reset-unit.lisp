(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/columns-row-reset")
(defcolumns fn2-row-reset-fixture
 ((value :u60) (next :link) (phase (:enum fn2-row-reset-phase (:idle :used))))
 :extra-fields ((fn2-row-reset-fixture-watermark :type (unsigned-byte 60) :initially 0
  :why "A row reset cannot roll back an independent lifetime watermark.")))
(make-event (fn2-columns-row-reset-event 'fn2-row-reset-fixture (w state)))
(defun fn2-row-reset-fixture-body (row fn2-row-reset-fixture)
 (declare (xargs :stobjs fn2-row-reset-fixture :verify-guards nil))
 (b* ((fn2-row-reset-fixture (fn2-row-reset-fixture-init 2 fn2-row-reset-fixture))
      (fn2-row-reset-fixture (update-fn2-row-reset-fixture-watermark 9 fn2-row-reset-fixture))
      (fn2-row-reset-fixture (fn2-row-reset-fixture-put 0 (value 5) (next 9) (phase *fn2-row-reset-phase-used*)))
      (fn2-row-reset-fixture (fn2-row-reset-fixture-put 1 (value 7) (next 8) (phase *fn2-row-reset-phase-used*)))
      (typed (and (fn2-row-reset-fixturep fn2-row-reset-fixture) (fn2-row-reset-fixture-wfp fn2-row-reset-fixture)))
      (fn2-row-reset-fixture (fn2-row-reset-fixture-reset-row row fn2-row-reset-fixture)))
  (mv (and typed (fn2-row-reset-fixturep fn2-row-reset-fixture) (fn2-row-reset-fixture-wfp fn2-row-reset-fixture)
           (= (fn2-row-reset-fixture-rows fn2-row-reset-fixture) 2)
           (= (fn2-row-reset-fixture-watermark fn2-row-reset-fixture) 9)
           (= (fn2-row-reset-fixture-value 1 fn2-row-reset-fixture) 7)
           (= (fn2-row-reset-fixture-next 1 fn2-row-reset-fixture) 8)
           (= (fn2-row-reset-fixture-phase 1 fn2-row-reset-fixture) *fn2-row-reset-phase-used*)
           (= (fn2-row-reset-fixture-value 0 fn2-row-reset-fixture) (if (= row 0) 0 5))
           (= (fn2-row-reset-fixture-next 0 fn2-row-reset-fixture) (if (= row 0) *fn2-none* 9))
           (= (fn2-row-reset-fixture-phase 0 fn2-row-reset-fixture) (if (= row 0) *fn2-row-reset-phase-idle* *fn2-row-reset-phase-used*)))
      fn2-row-reset-fixture)))
(defun fn2-row-reset-fixture-test (row)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-row-reset-fixture
  (mv-let (answer fn2-row-reset-fixture) (fn2-row-reset-fixture-body row fn2-row-reset-fixture) answer)))
(assert-event (fn2-row-reset-fixture-test 0))
(assert-event (fn2-row-reset-fixture-test -1))
(assert-event (fn2-row-reset-fixture-test 2))

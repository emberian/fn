; Packet identity after actual physical prefixes, before terminal publication.
(in-package "ACL2")
(include-book "native-cut-program-unit")

; The Read starts with an explicit initial image byte, then reaches disk bounds
; after copying that byte. The Write issues two bytes and selects a one-byte
; physical prefix. Neither test fabricates a descriptor or returned packet.
(defun fn2-native-binding-fixture (readp fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
       (fn2-sim (fn2-sim-init 7 :friendly "native-binding-unit" *fn2-profile-tiny* fn2-sim))
       ((mv code range gen fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
       ((unless (eq code :ok)) (mv nil 0 0 fn2-core fn2-sim fn2-own))
       (offset (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim)))
                 (n) (- (fn2-sim-storage-rows fn2-sim-storage) 1) n))
       (fn2-sim (if readp
                    (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim)))
                      (fn2-sim-storage)
                      (fn2-sim-storage-set-pending offset 23 fn2-sim-storage)
                      fn2-sim)
                  fn2-sim))
       ((mv code fn2-core) (if readp (mv :ok fn2-core)
                            (fn2-core-write range gen 0 17 1 0 1 fn2-core)))
       (fn2-own (if readp fn2-own
                  (fn2-own-observe-core-write range gen 0 code 17 fn2-core fn2-own)))
       ((unless (eq code :ok)) (mv nil 0 0 fn2-core fn2-sim fn2-own))
       ((mv code fn2-core) (if readp (mv :ok fn2-core)
                            (fn2-core-write range gen 1 19 1 0 1 fn2-core)))
       (fn2-own (if readp fn2-own
                  (fn2-own-observe-core-write range gen 1 code 19 fn2-core fn2-own)))
       ((unless (eq code :ok)) (mv nil 0 0 fn2-core fn2-sim fn2-own))
       ((mv code op & fn2-core)
        (if readp (fn2-issue-read offset range gen 2 1 0 1 0 fn2-core)
          (fn2-issue-write 0 range gen 0 2 0 1 0 1 0 fn2-core)))
       ((unless (eq code :ok)) (mv nil 0 0 fn2-core fn2-sim fn2-own))
       (fn2-own (fn2-own-observe-issue op fn2-core fn2-own))
       ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own)))
    (mv (and (= taken 1) (fn2-sim-native-storagep op fn2-sim)
             (fn2-core-wfp fn2-core) (fn2-sim-ready fn2-sim) (fn2-own-wfp fn2-own))
        op range fn2-core fn2-sim fn2-own)))

; This observable projection includes byte effects, the saved raw packet, and
; publication state. The general rejection theorem also states the full frame.
(defun fn2-native-binding-observe (op range fn2-core fn2-sim)
  (declare (xargs :stobjs (fn2-core fn2-sim) :verify-guards nil))
  (list (fn2-sim-stamp fn2-sim) (fn2-sim-active op fn2-sim)
        (fn2-sim-saved-return op fn2-sim)
        (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
          (posted) (fn2-ops-c0-posted op fn2-ops) posted)
        (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
          (bytes) (list (fn2-pool-datai (fn2-pool-base range fn2-pool) fn2-pool)
                        (fn2-pool-datai (+ 1 (fn2-pool-base range fn2-pool)) fn2-pool)) bytes)
        (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim)))
          (bytes) (list (fn2-sim-storage-pending 0 fn2-sim-storage)
                        (fn2-sim-storage-pending 1 fn2-sim-storage)) bytes)))

(defun fn2-native-binding-refusals (packets op range fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (if (endp packets) (mv t fn2-core fn2-sim fn2-own)
    (b* ((before (fn2-native-binding-observe op range fn2-core fn2-sim))
         ((mv posted fn2-core fn2-sim fn2-own)
          (fn2-sim-native-post (car packets) fn2-core fn2-sim fn2-own))
         ((mv rest fn2-core fn2-sim fn2-own)
          (fn2-native-binding-refusals (cdr packets) op range fn2-core fn2-sim fn2-own)))
      (mv (and (not posted) rest
               (equal before (fn2-native-binding-observe op range fn2-core fn2-sim)))
          fn2-core fn2-sim fn2-own))))

(defun fn2-native-binding-control (readp fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* (((mv ready op range fn2-core fn2-sim fn2-own)
        (fn2-native-binding-fixture readp fn2-core fn2-sim fn2-own))
       ((unless ready) (mv nil fn2-core fn2-sim fn2-own))
       (fault (if readp *fn2-fault-none* *fn2-fault-short-write*))
       ((mv status packet fn2-core fn2-sim fn2-own)
        (fn2-sim-native-stage op fault 1 fn2-core fn2-sim fn2-own))
       (before (fn2-native-binding-observe op range fn2-core fn2-sim))
       (returned (and (eq status :returned) (equal packet (nth 2 before))
                      (= (nth 0 before) 1) (= (nth 1 before) *fn2-sim-native-returned*)
                      (= (nth 3 before) 0) (= (nth 4 packet) 2) (= (nth 6 packet) 1)
                      (if readp (and (eq (nth 5 packet) :bounds) (equal (nth 4 before) '(23 0)))
                        (and (eq (nth 5 packet) :ok) (equal (nth 5 before) '(17 0))))))
       ; These mutations preserve the descriptor for code/count/aux/word/time/
       ; fault; generation additionally exercises incarnation rejection.
       ((mv refused fn2-core fn2-sim fn2-own)
        (fn2-native-binding-refusals
          (list (update-nth 5 (if readp :ok :io) packet)
                (update-nth 6 2 packet) (update-nth 7 1 packet)
                (update-nth 8 2 packet) (update-nth 9 (+ 1 (nth 9 packet)) packet)
                (update-nth 10 *fn2-fault-read-io* packet)
                (update-nth 1 (+ 1 (nth 1 packet)) packet))
          op range fn2-core fn2-sim fn2-own))
       ((mv reissued fn2-core fn2-sim fn2-own)
        (fn2-sim-complete op fault 1 fn2-core fn2-sim fn2-own))
       (once (and (not reissued) (equal before (fn2-native-binding-observe op range fn2-core fn2-sim))))
       ((mv posted fn2-core fn2-sim fn2-own) (fn2-sim-native-post packet fn2-core fn2-sim fn2-own))
       (after (fn2-native-binding-observe op range fn2-core fn2-sim))
       ((mv twice fn2-core fn2-sim fn2-own) (fn2-sim-native-post packet fn2-core fn2-sim fn2-own)))
    (mv (and returned refused once posted (not twice)
             (= (nth 0 after) 1) (= (nth 1 after) 0) (= (nth 3 after) 1)
             (equal (nth 2 after) packet)
             (equal (nth 4 before) (nth 4 after)) (equal (nth 5 before) (nth 5 after))
             (equal after (fn2-native-binding-observe op range fn2-core fn2-sim)))
        fn2-core fn2-sim fn2-own)))

(defun fn2-native-binding-controls ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (ok fn2-core)
      (with-local-stobj fn2-sim
        (mv-let (ok fn2-core fn2-sim)
          (with-local-stobj fn2-own
            (mv-let (ok fn2-core fn2-sim fn2-own)
              (b* (((mv write fn2-core fn2-sim fn2-own)
                    (fn2-native-binding-control nil fn2-core fn2-sim fn2-own))
                   ((mv read fn2-core fn2-sim fn2-own)
                    (fn2-native-binding-control t fn2-core fn2-sim fn2-own)))
                (mv (list write read) fn2-core fn2-sim fn2-own))
              (mv ok fn2-core fn2-sim)))
          (mv ok fn2-core)))
      ok)))

(assert-event (equal (fn2-native-binding-controls) '(t t)))
(assert-event
 (equal (list (fn2-sim-return-code-keyword->code :eof)
              (fn2-sim-return-code-keyword->code :exhausted)
              (fn2-sim-return-code-keyword->code :state)
              (fn2-sim-return-code-keyword->code :owner))
        '(13 14 15 16)))

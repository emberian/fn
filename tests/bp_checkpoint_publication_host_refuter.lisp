;; Actual publication control flow; every primitive/core observation recorded.
;; No disk, grant, scheduler, native image or allocation qualification.
(require :sb-posix)
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(defparameter +fnn-o-nofollow+ 0)
(defparameter +fnn-o-directory+ 0)
(defvar *trace* nil)
(defvar *fail-replace* nil)
(defvar *fail-barrier* nil)
(defvar *fail-close* nil)
(defvar *fail-observe* nil)
(defparameter *phases* '(:directory :open-generation :generation-barrier :close-generation
 :open-initial-root :initial-root-barrier :close-initial-root :replace
 :open-final-root :final-root-barrier :close-final-root))
(defun fnn-mkdir (&rest args) (declare (ignore args)) (push :directory *trace*))
(defun fnn-open (&rest args) (declare (ignore args)) (push :open *trace*) 321)
(defun fnn-fsync-file (fd)
  (assert (= fd 321)) (push :barrier *trace*)
  (when *fail-barrier* (error "injected barrier failure")))
(defun fnn-close (fd)
  (assert (= fd 321)) (push :close *trace*)
  (when *fail-close* (error "injected ambiguous close")))
(defun fnn-replace (&rest args)
  (declare (ignore args)) (push :replace *trace*)
  (when *fail-replace* (error "injected ambiguous replace")))
(defun fnn-fault (&rest args) (error "~s" args))
(defun fnn-core (name &rest args)
  (case name
    (fn-bpck-publication-begin
     (if (or (fifth args) (sixth args)) '(:done :uncertain) '(:directory :pending)))
    (fn-bpck-publication-action
     (let* ((control (first args)) (fd (second args)) (phase (first control))
            (action (case phase
             (:directory :make-directory) (:open-generation :open-generation)
             ((:open-initial-root :open-final-root) :open-root)
             ((:generation-barrier :initial-root-barrier :final-root-barrier) :barrier)
             ((:close-generation :close-initial-root :close-final-root) :close)
             (:replace :replace)
             (:done (if (and (eq (second control) :uncertain) (eq fd :open)) :close :done))
             (otherwise :fence))))
       (if (or (member action '(:done :fence))
               (eq fd (if (member action '(:barrier :close)) :open :closed))) action :fence)))
    (fn-bpck-publication-observe
     (when *fail-observe* (error "injected core observation failure"))
     (let* ((job (first args)) (control (second args)) (word (third args))
            (phase (first control)) (tail (member phase *phases*))
            (next (cond ((eq phase :done) control)
                        ((eq word :error) '(:done :uncertain))
                        ((cdr tail) (list (second tail) :pending))
                        ((eq phase :close-final-root) '(:done :durable))
                        (t '(:done :uncertain)))))
       (list next (case (second next) (:durable :published) (:uncertain :uncertain) (otherwise job)))))
    (otherwise (error "Unexpected core call ~s" name))))
(load "host/native/bp-checkpoint-writer.lisp")
(load "host/native/bp-checkpoint-publication.lisp")
(defun recording-publication ()
  (fnn-bps-checkpoint-publication-open "root" "generation" "stage" "CURRENT"
    (%make-fnn-bpck-io :job :private :control '(:done :written))))
(let* ((*trace* nil) (record (recording-publication)))
  (dotimes (i 11)
    (let ((before (length *trace*)))
      (assert (eq (fnn-bps-checkpoint-publication-turn record) record))
      (assert (= (length *trace*) (1+ before)))))
  (assert (equal (fnn-bpck-publication-control record) '(:done :durable)))
  (assert (eq (fnn-bpck-publication-job record) :published))
  (assert (eq (fnn-bpck-publication-close-result record) :closed))
  (let ((before (copy-list *trace*)))
    (fnn-bps-checkpoint-publication-turn record) (assert (equal *trace* before))))
(let* ((*trace* nil) (*fail-replace* t) (record (recording-publication)))
  (dotimes (i 8) (fnn-bps-checkpoint-publication-turn record))
  (assert (typep (fnn-bpck-publication-failure record) 'error))
  (assert (equal (fnn-bpck-publication-control record) '(:done :uncertain)))
  (let ((before (copy-list *trace*)))
    (fnn-bps-checkpoint-publication-turn record) (assert (equal *trace* before))))
(let* ((*trace* nil) (*fail-barrier* t) (record (recording-publication)))
  (dotimes (i 3) (fnn-bps-checkpoint-publication-turn record))
  (assert (= (fnn-bpck-publication-fd record) 321))
  (assert (eq (fnn-bpck-publication-close-result record) :open))
  (fnn-bps-checkpoint-publication-turn record)
  (assert (null (fnn-bpck-publication-fd record)))
  (assert (eq (fnn-bpck-publication-close-result record) :closed))
  (assert (equal (fnn-bpck-publication-control record) '(:done :uncertain))))
(let* ((*trace* nil) (*fail-close* t) (record (recording-publication)))
  (dotimes (i 4) (fnn-bps-checkpoint-publication-turn record))
  (assert (null (fnn-bpck-publication-fd record)))
  (assert (eq (fnn-bpck-publication-close-result record) :uncertain))
  (let ((before (copy-list *trace*)))
    (fnn-bps-checkpoint-publication-turn record) (assert (equal *trace* before))))
(let* ((*trace* nil) (record (recording-publication)))
  (fnn-bps-checkpoint-publication-turn record)
  (let ((*fail-observe* t)) (fnn-bps-checkpoint-publication-turn record))
  (assert (= (fnn-bpck-publication-fd record) 321))
  (assert (typep (fnn-bpck-publication-core-failure record) 'error))
  (assert (eq (fnn-bpck-publication-source-result record) :returned))
  (let ((before (copy-list *trace*)))
    (fnn-bps-checkpoint-publication-turn record) (assert (equal *trace* before))))
(let* ((*trace* nil)
       (writer (%make-fnn-bpck-io :job :private :control '(:done :written)
                                 :core-failure (make-condition 'simple-error)))
       (record (fnn-bps-checkpoint-publication-open "root" "generation" "stage" "CURRENT" writer)))
  (assert (equal (fnn-bpck-publication-control record) '(:done :uncertain)))
  (fnn-bps-checkpoint-publication-turn record) (assert (null *trace*)))
(format t "PASS: one publication primitive per turn, retained FD/barrier/close/core failures, no retry.~%")

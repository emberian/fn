; Execute the actual event producer without ACL2 or a proof job.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun len (x) (length x))
(defun member-eq (x xs) (member x xs))
(defun position-eq (x xs) (position x xs))
; Guard-relevant translated-term subset used by this actual producer.
; In particular, bare numeric constants are NOT pseudo-terms.
(defun pseudo-termp (term)
 (cond ((atom term) (symbolp term))
       ((eq (car term) 'quote) (= (length term) 2))
       (t (and (symbolp (car term)) (every #'pseudo-termp (cdr term))))))
(defun sublis-var (bindings term)
 (assert (and (every (lambda (pair) (and (symbolp (car pair)) (pseudo-termp (cdr pair)))) bindings)
              (pseudo-termp term)))
 (cond ((atom term) (let ((pair (assoc term bindings))) (if pair (cdr pair) term)))
       ((eq (car term) 'quote) term)
       (t (cons (car term) (mapcar (lambda (x) (sublis-var bindings x)) (cdr term))))))
(defun getpropc (name key default world) (getf (cdr (assoc name world)) (intern (symbol-name key) "KEYWORD") default))
(defun fn2-columns-sym (name suffix) (intern (concatenate 'string (symbol-name name) suffix)))
(defmacro er (&rest args) (declare (ignore args)) '(error "Expected ABI rejection"))
(with-open-file (in "books/blake3-word-frames.lisp")
 (loop for form = (read in nil :eof) until (eq form :eof) do
  (when (and (eq (car form) 'defun) (eq (cadr form) 'fn2-b3-word-frame-event)) (eval form))))
(let* ((world '((fn2-b3-words-length :formals (fn2-b3) :stobjs-in (fn2-b3) :stobjs-out (nil) :unnormalized-body (len (nth '97 fn2-b3)))
                (subject :formals (row i fn2-b3) :stobjs-out (nil fn2-b3))
                (shifted :formals (row i fn2-b3) :stobjs-out (nil nil fn2-b3))
                (single :formals (row i fn2-b3) :stobjs-out (fn2-b3))
                (missing :formals (row i fn2-b3) :stobjs-out (nil))))
       (plain-pair (fn2-b3-word-frame-event 'subject nil world))
       (plain (cadr plain-pair))
       (stripe-pair (fn2-b3-word-frame-event 'subject :stripe world))
       (stripe (cadr stripe-pair))
       (index (cadr (fn2-b3-word-frame-event 'subject :index world))))
 (assert (pseudo-termp (caddr (caddr plain-pair))))
 (assert (handler-case
           (progn (sublis-var '((fn2-b3 . (mv-nth 1 (subject row i fn2-b3))))
                              '(len (nth '97 fn2-b3))) nil)
           (error () t)))
 (assert (equal (caddr (caddr plain-pair))
  '(equal (len (nth '97 (mv-nth '1 (subject row i fn2-b3))))
          (len (nth '97 fn2-b3)))))
 (assert (equal (cadr (caddr (caddr stripe-pair))) (cadr (caddr stripe))))
 (assert (eq (getf (cdar (getf (cdddr (caddr plain-pair)) :hints)) :use) 'subject-word-frame))
 (let ((plain-theory (getf (cdar (getf (cdddr plain) :hints)) :in-theory))
       (stripe-theory (getf (cdar (getf (cdddr stripe) :hints)) :in-theory)))
  (assert (member 'fn2-b3-words-length (cadr plain-theory)))
  (assert (not (member 'fn2-b3-words-length (caddr plain-theory))))
  (assert (member 'fn2-b3-words-length (caddr stripe-theory)))
  (assert (not (member 'fn2-b3-words-length (cadr stripe-theory)))))
 (assert (equal (caddr plain)
   '(equal (fn2-b3-words-length (mv-nth 1 (subject row i fn2-b3))) (fn2-b3-words-length fn2-b3))))
 (assert (equal (cadadr (caddr stripe)) '(fn2-b3-word-stripep row fn2-b3)))
 (assert (equal (cadr (caddr index)) '(and (fn2-b3-word-stripep row fn2-b3) (natp i) (<= i 16))))
 (assert (equal (caddr (cadr (fn2-b3-word-frame-event 'shifted nil world)))
   '(equal (fn2-b3-words-length (mv-nth 2 (shifted row i fn2-b3))) (fn2-b3-words-length fn2-b3))))
 (assert (equal (caddr (cadr (fn2-b3-word-frame-event 'single nil world)))
   '(equal (fn2-b3-words-length (single row i fn2-b3)) (fn2-b3-words-length fn2-b3))))
 (assert (handler-case (progn (fn2-b3-word-frame-event 'missing nil world) nil) (error () t)))
 (assert (handler-case (progn (fn2-b3-word-frame-event 'subject :unsupported world) nil) (error () t))))
(format t "B3 WORD FRAME SOURCE CONTROLS PASS~%")

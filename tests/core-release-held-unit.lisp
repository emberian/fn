; Actual child boundary, full snapshots: holding a query source is normal
; retained ownership; completion retries release. Other failures still stop.
(in-package "ACL2")
(include-book "../books/arm-children")
(include-book "column-snapshot-support")
(defun fn2-held-control-index (field fields)
 (declare (xargs :verify-guards nil))
 (if (atom fields) nil
  (if (eq field (caar fields)) 0
   (let ((rest (fn2-held-control-index field (cdr fields))))
    (and (natp rest) (+ 1 rest))))))
(make-event
 (let* ((world (w state))
        (fields (fn2-test-snapshot-fields 'fn2-control world))
        (stop (fn2-held-control-index 'fn2-control-stop fields))
        (reason (fn2-held-control-index 'fn2-control-stop-reason fields))
        (events (append (fn2-test-column-snapshot-events 'fn2-pool world)
                        (fn2-test-column-snapshot-events 'fn2-control world))))
  (if (not (and (natp stop) (natp reason) (not (equal stop reason))))
      (er soft 'fn2-held-control-index "Actual control stop fields are missing.")
  (value `(progn
            (defconst *fn2-held-control-stop-index* ,stop)
            (defconst *fn2-held-control-reason-index* ,reason)
            (local (deftheory fn2-held-release-snapshot-base (current-theory :here)))
            (encapsulate () (local (in-theory nil)) ,@events)
            (local (in-theory (theory 'fn2-held-release-snapshot-base))))))))

(defun fn2-held-release-run (mode fn2-pool fn2-control)
 (declare (xargs :stobjs (fn2-pool fn2-control) :verify-guards nil))
 (b* ((fn2-pool (fn2-pool-init '((4 . 64)) 1 10 fn2-pool))
      (fn2-control (fn2-control-init *fn2-profile-tiny* fn2-control))
      (fn2-control (update-fn2-control-turn-bytes 17 fn2-control))
      (fn2-control (update-fn2-control-turn-steps 19 fn2-control))
      (fn2-control (update-fn2-control-wake-generation 23 fn2-control))
      ((mv reserve slot gen fn2-pool) (fn2-pool-reserve 0 7 3 4 fn2-pool))
      ((mv sibling-reserve sibling sibling-gen fn2-pool) (fn2-pool-reserve 0 8 5 6 fn2-pool))
      ((mv write fn2-pool) (fn2-pool-write slot gen 0 65 7 3 4 fn2-pool))
      ((mv sibling-write fn2-pool) (fn2-pool-write sibling sibling-gen 0 77 8 5 6 fn2-pool))
      ((mv acquire fn2-pool)
       (if (eq mode :state)
           (mv-let (code offset fn2-pool) (fn2-pool-lease-in slot gen 1 0 1 7 3 4 fn2-pool)
             (declare (ignore offset)) (mv code fn2-pool))
         (fn2-pool-query-acquire slot gen 0 1 7 3 4 fn2-pool)))
      (whole-h (and (eq reserve :ok) (eq sibling-reserve :ok)
                    (eq write :ok) (eq sibling-write :ok) (eq acquire :ok)
                    (not (equal slot sibling))
                    (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
                    (fn2-controlp fn2-control) (fn2-control-wfp fn2-control)
                    (equal (fn2-control-stop fn2-control) 0)
                    (equal (fn2-control-stop-reason fn2-control) 0)
                    (fn2-pool-release-countp slot fn2-pool)
                    (equal (fn2-pool-gen slot fn2-pool) gen)
                    (equal (fn2-pool-owner-kind slot fn2-pool) 7)
                    (equal (fn2-pool-owner-slot slot fn2-pool) 3)
                    (equal (fn2-pool-owner-gen slot fn2-pool) 4)
                    (equal (fn2-pool-query-ref-count slot fn2-pool)
                           (if (eq mode :state) 0 1))
                    (equal (fn2-pool-state slot fn2-pool)
                           (if (eq mode :state) *fn2-pool-state-leased-in*
                               *fn2-pool-state-workspace*))))
      (before (fn2-test-table-snapshot-fn2-pool fn2-pool))
      (control-before (fn2-test-table-snapshot-fn2-control fn2-control))
      ((mv code fn2-pool fn2-control)
       (fn2-core-release-children slot gen 7 (if (eq mode :owner) 9 3) 4 fn2-pool fn2-control))
      (held-pool (fn2-test-table-snapshot-fn2-pool fn2-pool))
      (held-control (fn2-test-table-snapshot-fn2-control fn2-control))
      ((unless (eq mode :held))
       (mv (and whole-h (eq code (if (eq mode :owner) :owner :state))
                (equal before held-pool)
                (equal (fn2-control-stop fn2-control) 1)
                (equal (fn2-control-stop-reason fn2-control) *fn2-stop-reason-pool-release*)
                ; Pure snapshot arithmetic specifies exactly the two stop
                ; fields; every other scalar and path octet stays identical.
                (equal held-control
                  (update-nth *fn2-held-control-reason-index* *fn2-stop-reason-pool-release*
                    (update-nth *fn2-held-control-stop-index* 1 control-before))))
           fn2-pool fn2-control))
      (held-ok (and whole-h (eq code :held)
                    (equal before held-pool) (equal control-before held-control)))
      ((mv close last fn2-pool) (fn2-pool-query-release slot gen fn2-pool))
      ((mv released fn2-pool fn2-control) (fn2-core-release-children slot gen 7 3 4 fn2-pool fn2-control))
      ((mv sibling-read byte) (fn2-pool-read sibling sibling-gen 0 8 5 6 fn2-pool)))
  (mv (and held-ok (eq close :ok) last (eq released :ok)
           (equal (fn2-pool-query-ref-count slot fn2-pool) 0)
           (equal (fn2-pool-state slot fn2-pool) *fn2-pool-state-free*)
           (equal (fn2-pool-gen slot fn2-pool) (+ 1 gen))
           (equal control-before (fn2-test-table-snapshot-fn2-control fn2-control))
           (eq sibling-read :ok) (equal byte 77)) fn2-pool fn2-control)))
(defun fn2-held-release-control (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool
  (mv-let (yes fn2-pool)
   (with-local-stobj fn2-control
    (mv-let (yes fn2-pool fn2-control)
     (fn2-held-release-run mode fn2-pool fn2-control) (mv yes fn2-pool))) yes)))
(assert-event (and (fn2-held-release-control :held)
                   (fn2-held-release-control :owner)
                   (fn2-held-release-control :state)))

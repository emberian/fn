; Prepared/unexecuted primitive controls. Synthetic admitted group geometry is
; explicit: two working units and one drain unit for each of two B rows.
; No actor admission, complete checkpoint, or runtime grant is claimed.
(in-package "ACL2")
(include-book "../books/pool-credit")
; Fixture-only snapshot includes every configured credit cell and class cache;
; the generated row view alone deliberately excludes extra fields.
(defun-nx fn2-pcu-arrays (i n fn2-pool)
 (declare (xargs :stobjs fn2-pool :measure (nfix (- (nfix n) (nfix i)))))
 (if (not (and (natp i) (natp n) (< i n))) nil
  (cons (list
    (if (< i (fn2-pool-credit-protected-length fn2-pool)) (fn2-pool-credit-protectedi i fn2-pool) nil)
    (if (< i (fn2-pool-credit-purpose-length fn2-pool)) (fn2-pool-credit-purposei i fn2-pool) nil)
    (if (< i (fn2-pool-credit-phase-length fn2-pool)) (fn2-pool-credit-phasei i fn2-pool) nil)
    (if (< i (fn2-pool-credit-nonce-length fn2-pool)) (fn2-pool-credit-noncei i fn2-pool) nil)
    (if (< i (fn2-pool-credit-owner-kind-length fn2-pool)) (fn2-pool-credit-owner-kindi i fn2-pool) nil)
    (if (< i (fn2-pool-credit-owner-slot-length fn2-pool)) (fn2-pool-credit-owner-sloti i fn2-pool) nil)
    (if (< i (fn2-pool-credit-owner-gen-length fn2-pool)) (fn2-pool-credit-owner-geni i fn2-pool) nil)
    (if (< i (fn2-pool-credit-demand-length fn2-pool)) (fn2-pool-credit-demandi i fn2-pool) nil)
    (if (< i (fn2-pool-credit-available-length fn2-pool)) (fn2-pool-credit-availablei i fn2-pool) nil)
    (if (< i (fn2-pool-nclasses fn2-pool))
        (list (fn2-pool-class-countsi i fn2-pool) (fn2-pool-class-headsi i fn2-pool)) nil))
   (fn2-pcu-arrays (+ i 1) n fn2-pool))))
(defun-nx fn2-pcu-view (fn2-pool)
 (declare (xargs :stobjs fn2-pool))
 (list (fn2-pool-view fn2-pool) (fn2-pool-credit-configured fn2-pool)
       (fn2-pool-credit-group-count fn2-pool) (fn2-pool-retired-count fn2-pool)
       (fn2-pcu-arrays 0 (max (fn2-pool-nclasses fn2-pool)
                            (fn2-pool-credit-group-count fn2-pool)
                            (fn2-pool-credit-demand-length fn2-pool)) fn2-pool)))
(defun fn2-pcu-body (fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (b* ((fn2-pool (fn2-pool-init '((6 . 4096)) 1 10 fn2-pool))
      (before (fn2-pcu-view fn2-pool))
      ((mv shortage fn2-pool) (fn2-pool-credit-configure '((1 5) (2 1) (2 1)) fn2-pool))
      ((unless (and (eq shortage :exhausted) (equal before (fn2-pcu-view fn2-pool)))) (mv nil fn2-pool))
      ((mv configured fn2-pool) (fn2-pool-credit-configure '((1 2) (2 1) (2 1)) fn2-pool))
      ((mv o1 a ag fn2-pool) (fn2-pool-reserve 0 20 0 1 fn2-pool))
      ((mv o2 b bg fn2-pool) (fn2-pool-reserve 0 20 1 1 fn2-pool))
      (before (fn2-pcu-view fn2-pool))
      ((mv refused & & fn2-pool) (fn2-pool-reserve 0 20 2 1 fn2-pool))
      ((unless (and (eq configured :ok) (eq o1 :ok) (eq o2 :ok) (eq refused :exhausted)
                    (equal before (fn2-pcu-view fn2-pool)) (equal (fn2-pool-class-countsi 0 fn2-pool) 4)
                    (equal (fn2-pool-credit-protectedi 0 fn2-pool) 4))) (mv nil fn2-pool))
      ((mv begun fn2-pool) (fn2-pool-credit-begin 0 *fn2-pool-credit-working* 7 9 1 3 fn2-pool))
      ((mv w1 x xg fn2-pool) (fn2-pool-reserve-credit 0 7 0 9 1 3 fn2-pool))
      (before (fn2-pcu-view fn2-pool))
      ((mv stale & & fn2-pool) (fn2-pool-reserve-credit 0 7 0 9 1 4 fn2-pool))
      ((mv premature fn2-pool) (fn2-pool-credit-end 0 7 9 1 3 fn2-pool))
      ((unless (and (eq begun :ok) (eq w1 :ok) (eq stale :owner) (eq premature :pending)
                    (equal before (fn2-pcu-view fn2-pool)))) (mv nil fn2-pool))
      ((mv w2 y yg fn2-pool) (fn2-pool-reserve-credit 0 7 0 9 1 3 fn2-pool))
      ((mv ended fn2-pool) (fn2-pool-credit-end 0 7 9 1 3 fn2-pool))
      ; Ordinary drain can redeem its independent group with ordinary space0.
      ((mv db fn2-pool) (fn2-pool-credit-begin 1 *fn2-pool-credit-drain* 1 10 2 4 fn2-pool))
      ((mv d1 d dg fn2-pool) (fn2-pool-reserve-credit 1 1 0 10 2 4 fn2-pool))
      ((mv de fn2-pool) (fn2-pool-credit-end 1 1 10 2 4 fn2-pool))
      ((unless (and (eq w2 :ok) (eq ended :ok) (eq db :ok) (eq d1 :ok) (eq de :ok)
                    (equal (fn2-pool-class-countsi 0 fn2-pool) 1)
                    (equal (fn2-pool-credit-protectedi 0 fn2-pool) 1)
                    (equal (fn2-pool-reservable-count 0 fn2-pool) 0))) (mv nil fn2-pool))
      (before (fn2-pcu-view fn2-pool))
      ((mv generic fn2-pool) (fn2-pool-release x xg 9 1 3 fn2-pool))
      ((mv wrong fn2-pool) (fn2-pool-release-credit x xg 0 8 9 1 3 fn2-pool))
      ((unless (and (eq generic :credit) (eq wrong :owner) (equal before (fn2-pcu-view fn2-pool)))) (mv nil fn2-pool))
      ((mv qr fn2-pool) (fn2-pool-query-acquire x xg 0 0 9 1 3 fn2-pool))
      (before (fn2-pcu-view fn2-pool))
      ((mv held fn2-pool) (fn2-pool-release-credit x xg 0 7 9 1 3 fn2-pool))
      ((unless (and (eq qr :ok) (eq held :held) (equal before (fn2-pcu-view fn2-pool)))) (mv nil fn2-pool))
      ((mv qdone last fn2-pool) (fn2-pool-query-release x xg fn2-pool))
      ((mv handed fn2-pool) (fn2-pool-hand x xg 9 1 3 11 3 5 fn2-pool))
      ((mv accepted fn2-pool) (fn2-pool-accept-hand x xg 11 3 5 fn2-pool))
      ((unless (and (eq qdone :ok) last (eq handed :ok) (eq accepted :ok)
                    (equal (fn2-pool-credit-group x fn2-pool) 0)
                    (equal (fn2-pool-credit-nonce x fn2-pool) 7)
                    (equal (fn2-pool-credit-owner-gen x fn2-pool) 3))) (mv nil fn2-pool))
      (before (fn2-pcu-view fn2-pool))
      ((mv borrowed-return fn2-pool) (fn2-pool-release-credit x xg 0 7 9 1 3 fn2-pool))
      ((unless (and (eq borrowed-return :owner) (equal before (fn2-pcu-view fn2-pool)))) (mv nil fn2-pool))
      ((mv back fn2-pool) (fn2-pool-hand x xg 11 3 5 9 1 3 fn2-pool))
      ((mv back-accepted fn2-pool) (fn2-pool-accept-hand x xg 9 1 3 fn2-pool))
      ((mv r1 fn2-pool) (fn2-pool-release-credit x xg 0 7 9 1 3 fn2-pool))
      ((mv r2 fn2-pool) (fn2-pool-release-credit y yg 0 7 9 1 3 fn2-pool))
      ((mv rd fn2-pool) (fn2-pool-release-credit d dg 1 1 10 2 4 fn2-pool))
      ((mv ra fn2-pool) (fn2-pool-release a ag 20 0 1 fn2-pool))
      ((mv rb fn2-pool) (fn2-pool-release b bg 20 1 1 fn2-pool))
      ((unless (and (eq back :ok) (eq back-accepted :ok) (eq r1 :ok) (eq r2 :ok) (eq rd :ok)
                    (eq ra :ok) (eq rb :ok) (equal (fn2-pool-class-countsi 0 fn2-pool) 6)
                    (equal (fn2-pool-credit-protectedi 0 fn2-pool) 4)
                    (equal (fn2-pool-credit-phasei 0 fn2-pool) *fn2-pool-credit-idle*)
                    (equal (fn2-pool-credit-phasei 1 fn2-pool) *fn2-pool-credit-idle*))) (mv nil fn2-pool))
      ; Generation retirement is not replenished capacity.
      (fn2-pool (fn2-pool-init '((2 . 4096)) 1 1 fn2-pool))
      ((mv rc fn2-pool) (fn2-pool-credit-configure '((1 1)) fn2-pool))
      ((mv rbegin fn2-pool) (fn2-pool-credit-begin 0 *fn2-pool-credit-working* 1 9 0 1 fn2-pool))
      ((mv rr z zg fn2-pool) (fn2-pool-reserve-credit 0 1 0 9 0 1 fn2-pool))
      ((mv re fn2-pool) (fn2-pool-credit-end 0 1 9 0 1 fn2-pool))
      ((mv retired fn2-pool) (fn2-pool-release-credit z zg 0 1 9 0 1 fn2-pool))
      (before (fn2-pcu-view fn2-pool))
      ((mv no-redeem fn2-pool) (fn2-pool-credit-begin 0 *fn2-pool-credit-working* 2 9 0 1 fn2-pool))
      ((unless (and (eq rc :ok) (eq rbegin :ok) (eq rr :ok) (eq re :ok) (eq retired :retired)
                    (eq no-redeem :owner) (equal before (fn2-pcu-view fn2-pool))
                    (equal (fn2-pool-credit-protectedi 0 fn2-pool) 0)
                    (equal (fn2-pool-class-countsi 0 fn2-pool) 1)
                    (equal (fn2-pool-credit-phasei 0 fn2-pool) *fn2-pool-credit-depleted*))) (mv nil fn2-pool))
      (fn2-pool (fn2-pool-init '((2 . 4096)) 1 10 fn2-pool)))
  (mv (and (equal (fn2-pool-credit-configured fn2-pool) 0)
           (equal (fn2-pool-credit-group-count fn2-pool) 0)
           (equal (fn2-pool-credit-demand-length fn2-pool) 0)
           (equal (fn2-pool-credit-available-length fn2-pool) 0)
           (equal (fn2-pool-credit-protected-length fn2-pool) 0)
           (equal (fn2-pool-credit-group 0 fn2-pool) *fn2-none*)
           (equal (fn2-pool-reservable-count 0 fn2-pool) 2)) fn2-pool)))
(defun fn2-pcu-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool (mv-let (ok fn2-pool) (fn2-pcu-body fn2-pool) ok)))
(assert-event (fn2-pcu-run))

; Explicit no-IO primitive premise: this control calls only pool operations,
; never a storage issue. Actual producer ordering is a separate obligation.
(defun fn2-pcu-noio-body (fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (b* ((fn2-pool (fn2-pool-init '((1 . 4096)) 1 10 fn2-pool))
      ((mv configured fn2-pool) (fn2-pool-credit-configure '((1 1)) fn2-pool))
      ((mv begun fn2-pool) (fn2-pool-credit-begin 0 *fn2-pool-credit-working* 1 9 0 1 fn2-pool))
      ((mv reserved a ag fn2-pool) (fn2-pool-reserve-credit 0 1 0 9 0 1 fn2-pool))
      ((mv returned fn2-pool) (fn2-pool-release-credit a ag 0 1 9 0 1 fn2-pool))
      ((mv aborted fn2-pool) (fn2-pool-credit-abort-empty 0 1 9 0 1 fn2-pool))
      ((unless (and (eq configured :ok) (eq begun :ok) (eq reserved :ok) (eq returned :ok) (eq aborted :ok)
                    (equal (fn2-pool-credit-phasei 0 fn2-pool) *fn2-pool-credit-aborted-empty*))) (mv nil fn2-pool))
      (before (fn2-pcu-view fn2-pool))
      ((mv wrong-owner fn2-pool) (fn2-pool-credit-begin 0 *fn2-pool-credit-working* 1 9 0 2 fn2-pool))
      ((mv wrong-purpose fn2-pool) (fn2-pool-credit-begin 0 *fn2-pool-credit-drain* 1 9 0 1 fn2-pool))
      ((unless (and (eq wrong-owner :owner) (eq wrong-purpose :owner) (equal before (fn2-pcu-view fn2-pool)))) (mv nil fn2-pool))
      ((mv retried fn2-pool) (fn2-pool-credit-begin 0 *fn2-pool-credit-working* 1 9 0 1 fn2-pool))
      ((mv reserved2 b bg fn2-pool) (fn2-pool-reserve-credit 0 1 0 9 0 1 fn2-pool))
      ((mv ended fn2-pool) (fn2-pool-credit-end 0 1 9 0 1 fn2-pool))
      ((mv returned2 fn2-pool) (fn2-pool-release-credit b bg 0 1 9 0 1 fn2-pool))
      ((unless (and (eq retried :ok) (eq reserved2 :ok) (eq ended :ok) (eq returned2 :ok)
                    (equal (fn2-pool-credit-phasei 0 fn2-pool) *fn2-pool-credit-idle*))) (mv nil fn2-pool))
      (before (fn2-pcu-view fn2-pool))
      ((mv completed-stale fn2-pool) (fn2-pool-credit-begin 0 *fn2-pool-credit-working* 1 9 0 1 fn2-pool)))
  (mv (and (eq completed-stale :owner) (equal before (fn2-pcu-view fn2-pool))) fn2-pool)))
(defun fn2-pcu-noio-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool (mv-let (ok fn2-pool) (fn2-pcu-noio-body fn2-pool) ok)))
(assert-event (fn2-pcu-noio-run))

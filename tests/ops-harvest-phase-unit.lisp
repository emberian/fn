; Completion lifecycle preflight: full structural guards, exact refusal frame.
(in-package "ACL2")
(include-book "../books/ops-harvest-phase")
(include-book "std/util/bstar" :dir :system)

(defun fn2-harvest-phase-refusal-run (phase cell fn2-ops)
 (declare (xargs :stobjs fn2-ops :verify-guards nil))
 (b* ((fn2-ops (fn2-ops-init *fn2-profile-tiny* fn2-ops))
      (fn2-ops (fn2-ops-set-phase 0 phase fn2-ops))
      (fn2-ops (if (equal cell 0) (fn2-ops-set-c0-posted 0 1 fn2-ops)
                  (fn2-ops-set-c1-posted 0 1 fn2-ops)))
      (fn2-ops (update-fn2-ops-posted-fifoi 0 cell fn2-ops))
      (fn2-ops (update-fn2-ops-post-count 1 fn2-ops))
      (before (fn2-ops-snapshot fn2-ops))
      (hyps (and (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops)
                 (not (fn2-completion-phasep cell phase))))
      ((mv found slot gen got-cell fn2-ops) (fn2-harvest-next fn2-ops)))
  (mv (and hyps (eq found :corrupt) (equal slot 0) (equal gen 0) (equal got-cell 0)
           (equal before (fn2-ops-snapshot fn2-ops))) fn2-ops)))
(defun fn2-harvest-phase-refusal (phase cell)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-ops (mv-let (answer fn2-ops) (fn2-harvest-phase-refusal-run phase cell fn2-ops) answer)))
(assert-event (and (fn2-harvest-phase-refusal *fn2-op-phase-free* 0)
                   (fn2-harvest-phase-refusal *fn2-op-phase-reserved* 0)
                   (fn2-harvest-phase-refusal *fn2-op-phase-queued* 0)
                   (fn2-harvest-phase-refusal *fn2-op-phase-done* 0)
                   (fn2-harvest-phase-refusal *fn2-op-phase-retired* 0)
                   (fn2-harvest-phase-refusal *fn2-op-phase-release-pending* 0)
                   (fn2-harvest-phase-refusal *fn2-op-phase-free* 1)))

(defun fn2-harvest-phase-legal-run (release-first fn2-ops)
 (declare (xargs :stobjs fn2-ops :verify-guards nil))
 (b* ((fn2-ops (fn2-ops-init *fn2-profile-tiny* fn2-ops))
      ((mv reserve slot gen fn2-ops) (fn2-op-reserve *fn2-action-send* 1 2 3 1 1 fn2-ops))
      ((mv range fn2-ops) (fn2-op-set-range slot gen 0 1 0 7 fn2-ops))
      ((mv enqueue fn2-ops) (fn2-op-enqueue slot gen fn2-ops))
      ((mv ack fn2-ops) (fn2-outbox-ack 1 fn2-ops))
      (first-cell (if release-first 1 0))
      (fn2-ops (if release-first
         (fn2-post-result 1 slot gen *fn2-event-borrow-released* *fn2-outcome-done* *fn2-reason-none* 0 0 0 fn2-ops)
         (fn2-post-result 0 slot gen *fn2-event-send-result* *fn2-outcome-done* *fn2-reason-none* 7 1 0 fn2-ops)))
      (hyps (and (eq reserve :ok) (eq range :ok) (eq enqueue :ok) (eq ack :ok)
                 (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops) (fn2-ops-semanticp fn2-ops)))
      ((mv found hs hg cell fn2-ops) (fn2-harvest-next fn2-ops))
      (first-ok (and (eq found t) (equal hs slot) (equal hg gen) (equal cell first-cell)
                     (equal (fn2-ops-phase slot fn2-ops)
                      (if release-first *fn2-op-phase-submitted* *fn2-op-phase-release-pending*))
                     (fn2-ops-semanticp fn2-ops)))
      (fn2-ops (if release-first
         (fn2-post-result 0 slot gen *fn2-event-send-result* *fn2-outcome-done* *fn2-reason-none* 7 1 0 fn2-ops)
         (fn2-post-result 1 slot gen *fn2-event-borrow-released* *fn2-outcome-done* *fn2-reason-none* 0 0 0 fn2-ops)))
      (second-hyps (and (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops) (fn2-ops-semanticp fn2-ops)))
      ((mv found hs hg cell fn2-ops) (fn2-harvest-next fn2-ops)))
  (mv (and hyps first-ok second-hyps (eq found t) (equal hs slot) (equal hg gen)
           (equal cell (- 1 first-cell)) (equal (fn2-ops-phase slot fn2-ops) *fn2-op-phase-done*)
           (fn2-ops-semanticp fn2-ops)) fn2-ops)))
(defun fn2-harvest-phase-legal (release-first)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-ops (mv-let (answer fn2-ops) (fn2-harvest-phase-legal-run release-first fn2-ops) answer)))
(assert-event (and (fn2-harvest-phase-legal nil) (fn2-harvest-phase-legal t)))

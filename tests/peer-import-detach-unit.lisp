; Guarded private import detach, through the assembled C owner operations.
; Source controls only until allocated admission/execution. Foreign queries
; and their octets are observed, never cleared by a test perturbation.
(in-package "ACL2")
(include-book "peer-import-unit")

(defun fn2-pid-read (n slot gen off kind owner generation fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix n)))
 (if (zp n) nil
  (mv-let (code byte) (fn2-pool-read slot gen off kind owner generation fn2-pool)
   (if (eq code :ok)
       (cons byte (fn2-pid-read (- n 1) slot gen (+ 1 off) kind owner generation fn2-pool))
     (list code)))))
; Complete generated query state, plus both actual referenced byte ranges,
; read with that query's own owner triple (including alias/same-owner cases).
(defun fn2-pid-query-image (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let* ((query (fn2-piu-whole-query fn2-core)) (row (car query))
        (name (nth 2 query)) (digest (nth 5 query)))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (image)
   (list query
     (fn2-pid-read (nth 4 name) (nth 1 name) (nth 2 name) (nth 3 name)
                  (nth 2 row) (nth 3 row) (nth 4 row) fn2-pool)
     (fn2-pid-read (nth 4 digest) (nth 1 digest) (nth 2 digest) (nth 3 digest)
                  (nth 2 row) (nth 3 row) (nth 4 row) fn2-pool)) image)))
(defun fn2-pid-private (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-peer-imports (fn2-core-peer-imports fn2-core))) (slot gen)
  (mv (fn2-peer-imports-slot 0 fn2-peer-imports) (fn2-peer-imports-gen 0 fn2-peer-imports))
  (mv slot gen)))
(defun fn2-pid-lifetime (slot oldgen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (lifetime)
  (list (fn2-pool-workspace-code slot oldgen 5 1 1 fn2-pool)
        (equal (fn2-pool-gen slot fn2-pool) oldgen)
        (equal (fn2-pool-gen slot fn2-pool) (+ 1 oldgen))
        (equal (fn2-pool-state slot fn2-pool) *fn2-pool-state-workspace*)
        (equal (fn2-pool-state slot fn2-pool) *fn2-pool-state-free*)) lifetime))

(defun fn2-pid-retained-p (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (and (fn2-peer-import-owned-p 0 5 1 1 fn2-core)
  (stobj-let ((fn2-peer-imports (fn2-core-peer-imports fn2-core))) (interfered)
   (equal (fn2-peer-imports-phase 0 fn2-peer-imports) *fn2-peer-import-phase-interfered*) interfered)))

; The actual owner starts and completes the import's query; actual START
; then replaces that DONE query and increments its incarnation. ALIAS uses
; the retained private bytes under the same owner; the other case uses
; separate takings owned by the foreign query.
(defun fn2-pid-setup (alias fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-piu-profile* fn2-core))
      ((mv mc ms mg fn2-core) (fn2-core-reserve 0 5 1 1 fn2-core))
      ((mv dc ds dg fn2-core) (fn2-core-reserve 0 5 1 1 fn2-core))
      ((mv mw fn2-core) (fn2-piu-write 1 109 ms mg 0 fn2-core))
      ((mv dw fn2-core) (fn2-piu-write 32 7 ds dg 0 fn2-core))
      (fn2-core (fn2-piu-input ms mg ds dg 95 0 fn2-core))
      ((mv start fn2-core) (fn2-peer-import-start 0 0 16 t 5 1 1 fn2-core))
      ((mv done fn2-core) (fn2-piu-drive 100 0 fn2-core))
      ((mv slot gen) (fn2-pid-private fn2-core))
      (name-alias (member-eq alias '(:both :name)))
      (digest-alias (member-eq alias '(:both :digest)))
      (kind (if alias 5 6)) (owner (if alias 1 2))
      ((mv fmcode fm fg fn2-core)
       (if name-alias (mv :ok slot gen fn2-core) (fn2-core-reserve 0 kind owner 1 fn2-core)))
      ((mv fdcode fd fgd fn2-core)
       (if digest-alias (mv :ok slot gen fn2-core) (fn2-core-reserve 0 kind owner 1 fn2-core)))
      ((mv fmwrite fn2-core)
       (if name-alias (mv :ok fn2-core) (fn2-piu-owner-write 1 110 fm fg 0 kind owner 1 fn2-core)))
      ((mv fdwrite fn2-core)
       (if digest-alias (mv :ok fn2-core) (fn2-piu-owner-write 32 8 fd fgd 0 kind owner 1 fn2-core)))
      ((mv foreign fn2-core)
       (fn2-identity-decide-start 0 fm fg 0 1 fd fgd (if digest-alias 1 0) kind owner 1 fn2-core)))
  (mv (list mc dc mw dw start done fmcode fdcode fmwrite fdwrite foreign)
      slot gen fn2-core)))
(defun fn2-pid-plain (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv setup slot gen fn2-core) (fn2-pid-setup nil fn2-core))
      (before (fn2-pid-query-image fn2-core))
      ((mv declare fn2-core) (fn2-peer-import-declare 0 0 16 t 5 1 1 fn2-core))
      (declared-preserved (equal before (fn2-pid-query-image fn2-core)))
      (retained (fn2-pid-retained-p fn2-core))
      (held (fn2-pid-lifetime slot gen fn2-core))
      ((mv abort fn2-core) (fn2-peer-import-abort 0 5 1 1 fn2-core))
      (preserved (equal before (fn2-pid-query-image fn2-core)))
      (idle (fn2-peer-import-idle-p 0 fn2-core))
      (freed (fn2-pid-lifetime slot gen fn2-core))
      ((mv foreign-done fn2-core) (fn2-piu-drive 100 0 fn2-core)))
  (mv (list setup declare declared-preserved retained held abort preserved idle freed
            (equal (nth 1 before) '(110))
            (equal (nth 2 before) (make-list 32 :initial-element 8))
            foreign-done (fn2-piu-incarnation fn2-core)) fn2-core)))
(defun fn2-pid-alias (which fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv setup slot gen fn2-core) (fn2-pid-setup which fn2-core))
      (before (fn2-pid-query-image fn2-core))
      ((mv declare fn2-core) (fn2-peer-import-declare 0 0 16 t 5 1 1 fn2-core))
      ((mv blocked fn2-core) (fn2-peer-import-abort 0 5 1 1 fn2-core))
      (preserved (equal before (fn2-pid-query-image fn2-core)))
      (retained (fn2-pid-retained-p fn2-core))
      (held (fn2-pid-lifetime slot gen fn2-core))
      ; The actual query owner ends its own query. Detach may now free the
      ; shared bytes: the old alias fields are no longer a live query.
      ((mv release fn2-core) (fn2-successor-release 0 fn2-core))
      (released-query (fn2-piu-whole-query fn2-core))
      ((mv abort fn2-core) (fn2-peer-import-abort 0 5 1 1 fn2-core))
      (still-preserved (equal released-query (fn2-piu-whole-query fn2-core)))
      (idle (fn2-peer-import-idle-p 0 fn2-core))
      (freed (fn2-pid-lifetime slot gen fn2-core)))
  (mv (list setup declare blocked preserved retained held
            (equal (nth 1 before) (if (member-eq which '(:both :name)) '(109) '(110)))
            (equal (nth 2 before) (make-list 32 :initial-element (if (member-eq which '(:both :digest)) 7 8)))
            release abort still-preserved idle freed (fn2-piu-incarnation fn2-core)) fn2-core)))

; This is an internal C transition control, not persisted acceptance.
; An actual independent successor claim reaches BOUND. Import detach cannot
; undo it: only its owner publishes and releases that claim before retrying.
(defun fn2-pid-bound (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv setup slot gen fn2-core) (fn2-pid-setup nil fn2-core))
      ((mv foreign-done fn2-core) (fn2-piu-drive 100 0 fn2-core))
      (foreign-query (fn2-piu-whole-query fn2-core))
      (name-ref (nth 2 foreign-query)) (digest-ref (nth 5 foreign-query))
      ((mv put fn2-core)
       (fn2-consumer-cursor-rebase 0 7 (consumer 7) (epoch 1) (query 1) (start 0) fn2-core))
      ((mv resolved fn2-core) (fn2-piu-resolve 100 0 fn2-core))
      ((mv stage & fn2-core) (fn2-successor-stage 0 fn2-core))
      ((mv bind fn2-core) (fn2-successor-bind 0 4 10 fn2-core))
      ; Generic successor staging uses the query field stripe as scratch.
      ; A new actual START restores this foreign owner's live query after
      ; binding, without changing the BOUND successor claim.
      ((mv replaced fn2-core)
       (fn2-identity-decide-start 0 (nth 1 name-ref) (nth 2 name-ref) (nth 3 name-ref) (nth 4 name-ref)
                                  (nth 1 digest-ref) (nth 2 digest-ref) (nth 3 digest-ref) 6 2 1 fn2-core))
      (before (fn2-pid-query-image fn2-core))
      (successor (fn2-piu-foreign-progress fn2-core))
      ((mv declare fn2-core) (fn2-peer-import-declare 0 0 16 t 5 1 1 fn2-core))
      ((mv blocked fn2-core) (fn2-peer-import-abort 0 5 1 1 fn2-core))
      (preserved (and (equal before (fn2-pid-query-image fn2-core))
                      (equal successor (fn2-piu-foreign-progress fn2-core))))
      (retained (fn2-pid-retained-p fn2-core))
      (held (fn2-pid-lifetime slot gen fn2-core))
      ((mv early-release fn2-core) (fn2-successor-release 0 fn2-core))
      (still-bound (equal successor (fn2-piu-foreign-progress fn2-core)))
      ((mv publish fn2-core) (fn2-successor-publish 4 fn2-core))
      ((mv release fn2-core) (fn2-successor-release 0 fn2-core))
      (released-query (fn2-pid-query-image fn2-core))
      ((mv abort fn2-core) (fn2-peer-import-abort 0 5 1 1 fn2-core))
      (still-preserved (equal released-query (fn2-pid-query-image fn2-core)))
      (idle (fn2-peer-import-idle-p 0 fn2-core))
      (freed (fn2-pid-lifetime slot gen fn2-core)))
  (mv (list setup foreign-done put resolved stage bind replaced declare blocked preserved retained held
            early-release still-bound publish release abort still-preserved idle freed
            (equal (nth 1 before) '(110))
            (equal (nth 2 before) (make-list 32 :initial-element 8))
            (fn2-piu-incarnation fn2-core)) fn2-core)))
(defmacro fn2-pid-result (name body)
 `(defun ,name ()
   (declare (xargs :verify-guards nil))
   (with-local-stobj fn2-core (mv-let (result fn2-core) (,body fn2-core) result))))
(fn2-pid-result fn2-pid-plain-result fn2-pid-plain)
(defun fn2-pid-alias-result (which)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (result fn2-core) (fn2-pid-alias which fn2-core) result)))
(fn2-pid-result fn2-pid-bound-result fn2-pid-bound)
(assert-event
 (equal (fn2-pid-plain-result)
  '((:ok :ok :ok :ok :ok :stored :ok :ok :ok :ok :ok)
    :interference t t (:ok t nil t nil) :ok t t (:stale nil t nil t) t t :stored 2)))
(defconst *fn2-pid-alias-expected*
 '((:ok :ok :ok :ok :ok :stored :ok :ok :ok :ok :ok)
   :interference :held t t (:held t nil t nil) t t :ok :ok t t (:stale nil t nil t) 2))
(assert-event
 (and (equal (fn2-pid-alias-result :both) *fn2-pid-alias-expected*)
      (equal (fn2-pid-alias-result :name) *fn2-pid-alias-expected*)
      (equal (fn2-pid-alias-result :digest) *fn2-pid-alias-expected*)))
(assert-event
 (equal (fn2-pid-bound-result)
  '((:ok :ok :ok :ok :ok :stored :ok :ok :ok :ok :ok)
    :stored :ok :ok :ok :ok :ok :interference :state t t (:ok t nil t nil)
    :state t :ok :ok :ok t t (:stale nil t nil t) t t 3)))

; Actual run writer and promotion controls; prepared for ACL2, not yet run.
(in-package "ACL2")
(include-book "../books/runs")
(defun fn2-run-close-full-unit (fn2-run-writers)
 (declare (xargs :stobjs fn2-run-writers :verify-guards nil))
 (b* ((fn2-run-writers (fn2-run-writers-init 3 fn2-run-writers))
      (fn2-run-writers (fn2-run-writers-put 0 (phase *fn2-run-writer-phase-open*) (entries 0) (pos 19)))
      (fn2-run-writers (fn2-run-writers-put 1 (phase *fn2-run-writer-phase-open*) (entries 0) (pos 29)))
      (fn2-run-writers (fn2-run-writers-put 2 (phase *fn2-run-writer-phase-open*) (entries 3) (pos 39)))
      ((mv leaf fn2-run-writers) (fn2-run-close-full 0 fn2-run-writers))
      ((mv parent fn2-run-writers) (fn2-run-promote-commit 0 :full fn2-run-writers))
      (empty-ok (and (eq leaf :length) (eq parent :length)
                    (equal (fn2-run-writers-phase 0 fn2-run-writers) *fn2-run-writer-phase-open*)
                    (equal (fn2-run-writers-phase 1 fn2-run-writers) *fn2-run-writer-phase-open*)
                    (equal (fn2-run-writers-pos 0 fn2-run-writers) 19)
                    (equal (fn2-run-writers-pos 1 fn2-run-writers) 29)
                    (equal (fn2-run-writers-entries 0 fn2-run-writers) 0)
                    (equal (fn2-run-writers-entries 1 fn2-run-writers) 0)))
      ((mv nonempty fn2-run-writers) (fn2-run-promote-commit 1 :full fn2-run-writers)))
  (mv (and empty-ok (eq nonempty :more)
           (equal (fn2-run-writers-phase 2 fn2-run-writers) *fn2-run-writer-phase-closing*)
           (equal (fn2-run-writers-pos 2 fn2-run-writers) 0)
           (equal (fn2-run-writers-entries 2 fn2-run-writers) 3)
           (equal (fn2-run-writers-rows fn2-run-writers) 3)) fn2-run-writers)))
(assert-event
 (with-local-stobj fn2-run-writers
  (mv-let (answer fn2-run-writers) (fn2-run-close-full-unit fn2-run-writers) answer)))

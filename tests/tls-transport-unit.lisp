; The host-called next/observe pair, including short I/O and stale epochs.
(in-package "ACL2")
(include-book "../books/tls-transport")

(defun fn2-tls-transport-unit-run (steps fn2-tls-transport)
 (declare (xargs :stobjs fn2-tls-transport :verify-guards nil))
 (if (atom steps) (mv t fn2-tls-transport)
  (let* ((s (car steps)) (room (nth 0 s)) (pending (nth 1 s)))
   (mv-let (status action offset count serial fn2-tls-transport)
    (fn2-tls-transport-next room pending fn2-tls-transport)
    (let ((selected (equal (list status action offset count) (cons :act (take 3 (nthcdr 2 s))))))
     (mv-let (observed kick fn2-tls-transport)
      (fn2-tls-transport-observe 7 17 3 9 serial (nth 5 s) 0 (nth 6 s) fn2-tls-transport)
      (declare (ignore kick))
      (let ((valid (and selected (equal observed (nth 7 s))
                        (fn2-tls-transport-invariant fn2-tls-transport))))
       (mv-let (rest fn2-tls-transport) (fn2-tls-transport-unit-run (cdr steps) fn2-tls-transport)
        (mv (and valid rest) fn2-tls-transport)))))))))

(defun fn2-tls-transport-unit-retention (fn2-tls-transport)
 (declare (xargs :stobjs fn2-tls-transport :verify-guards nil))
 (mv-let (start fn2-tls-transport) (fn2-tls-transport-start 7 17 3 9 8 8 4 20 fn2-tls-transport)
  (mv-let (ok fn2-tls-transport)
   (fn2-tls-transport-unit-run
    '((3 0 1 0 4 4 0 :ok) ; copy both chunks before any SSL call
      (3 0 1 4 4 4 0 :ok)
      (3 0 2 0 3 2 0 :ok) ; partial BIO acceptance retains the suffix
      (0 5 4 0 4 4 0 :ok) ; drain at most one quantum
      (0 1 5 0 4 2 0 :ok) ; short send
      (0 1 5 2 2 -1 11 :blocked) ; no prefix loss on EAGAIN
      (0 1 5 2 2 2 0 :ok)
      (0 1 4 0 1 1 0 :ok)
      (0 0 5 0 1 1 0 :ok)
      (0 0 7 0 0 0 0 :ok)) ; library completion may leave staged seed
     fn2-tls-transport)
   (mv-let (done action offset count serial fn2-tls-transport)
    (fn2-tls-transport-next 0 0 fn2-tls-transport)
    (declare (ignore action offset count serial))
    (mv-let (handoff copied fed il io ol oo fn2-tls-transport)
     (fn2-tls-transport-handoff 7 17 3 9 fn2-tls-transport)
     (let ((first (and (eq start :ok) ok (eq done :done) (eq handoff :ok)
                      (= copied 8) (= fed 2) (= il io) (= ol oo))))
      (mv-let (duplicate c f a b d e fn2-tls-transport)
       (fn2-tls-transport-handoff 7 17 3 9 fn2-tls-transport)
       (declare (ignore c f a b d e))
       (mv (and first (eq duplicate :stale)) fn2-tls-transport))))))))
(defun fn2-tls-transport-check-retention ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-tls-transport
  (mv-let (ok fn2-tls-transport) (fn2-tls-transport-unit-retention fn2-tls-transport) ok)))
(assert-event (fn2-tls-transport-check-retention))

(defun fn2-tls-transport-unit-stale (fn2-tls-transport)
 (declare (xargs :stobjs fn2-tls-transport :verify-guards nil))
 (mv-let (start fn2-tls-transport) (fn2-tls-transport-start 7 17 3 9 8 8 4 20 fn2-tls-transport)
  (mv-let (status action offset count serial fn2-tls-transport)
   (fn2-tls-transport-next 0 0 fn2-tls-transport)
   (declare (ignore action offset count))
   (mv-let (stale kick fn2-tls-transport)
    (fn2-tls-transport-observe 7 18 3 9 serial 4 0 0 fn2-tls-transport)
    (declare (ignore kick))
    (mv-let (stale-cap kick fn2-tls-transport)
     (fn2-tls-transport-observe 8 17 3 9 serial 4 0 0 fn2-tls-transport)
     (declare (ignore kick))
    (let ((unchanged (and (eq stale-cap :stale) (= (fn2-tls-transport-copied 0 fn2-tls-transport) 0)
                          (= (fn2-tls-transport-pending 0 fn2-tls-transport) 1))))
     (mv-let (valid kick fn2-tls-transport)
      (fn2-tls-transport-observe 7 17 3 9 serial 4 0 0 fn2-tls-transport)
      (declare (ignore kick))
      (mv-let (duplicate kick fn2-tls-transport)
       (fn2-tls-transport-observe 7 17 3 9 serial 4 0 0 fn2-tls-transport)
       (declare (ignore kick))
       (mv (and (eq start :ok) (eq status :act) (eq stale :stale) unchanged
                (eq valid :ok) (eq duplicate :stale)
                (= (fn2-tls-transport-copied 0 fn2-tls-transport) 4)) fn2-tls-transport)))))))))
(defun fn2-tls-transport-check-stale ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-tls-transport
  (mv-let (ok fn2-tls-transport) (fn2-tls-transport-unit-stale fn2-tls-transport) ok)))
(assert-event (fn2-tls-transport-check-stale))

(defun fn2-tls-transport-unit-budget (fn2-tls-transport)
 (declare (xargs :stobjs fn2-tls-transport :verify-guards nil))
 (mv-let (bad fn2-tls-transport) (fn2-tls-transport-start 7 17 3 9 2 1 1 1 fn2-tls-transport)
  (let ((empty (= (fn2-tls-transport-rows fn2-tls-transport) 0)))
   (mv-let (start fn2-tls-transport) (fn2-tls-transport-start 7 17 3 9 1 1 1 1 fn2-tls-transport)
    (mv-let (ok fn2-tls-transport)
     (fn2-tls-transport-unit-run '((0 0 1 0 1 1 0 :ok)) fn2-tls-transport)
     (mv-let (status action offset count serial fn2-tls-transport)
      (fn2-tls-transport-next 0 0 fn2-tls-transport)
      (declare (ignore action offset count serial))
      (mv (and (eq bad :bounds) empty (eq start :ok) ok (eq status :failed)
               (fn2-tls-transportp fn2-tls-transport)
               (fn2-tls-transport-wfp fn2-tls-transport)
               (= (fn2-tls-transport-rows fn2-tls-transport) 1)
               (not (equal (fn2-tls-transport-budget 0 fn2-tls-transport) (- 0 1)))
               (= (fn2-tls-transport-budget 0 fn2-tls-transport) 0)
               (= (fn2-tls-transport-serial 0 fn2-tls-transport) 1)) fn2-tls-transport)))))))
(defun fn2-tls-transport-check-budget ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-tls-transport
  (mv-let (ok fn2-tls-transport) (fn2-tls-transport-unit-budget fn2-tls-transport) ok)))
(assert-event (fn2-tls-transport-check-budget))

(defun fn2-tls-transport-invariant-positive-run (fn2-tls-transport)
 (declare (xargs :stobjs fn2-tls-transport :verify-guards nil))
 (mv-let (start fn2-tls-transport) (fn2-tls-transport-start 7 17 3 9 8 8 4 20 fn2-tls-transport)
  (let ((before-next (and (= (fn2-tls-transport-budget 0 fn2-tls-transport) 20)
                         (= (fn2-tls-transport-serial 0 fn2-tls-transport) 0)
                         (fn2-tls-transportp fn2-tls-transport)
                         (fn2-tls-transport-wfp fn2-tls-transport)
                         (= (fn2-tls-transport-rows fn2-tls-transport) 1)
                         (fn2-tls-transport-invariant fn2-tls-transport))))
   (mv-let (status action offset count serial fn2-tls-transport)
    (fn2-tls-transport-next 0 0 fn2-tls-transport)
    (let ((before-observe (and (= (fn2-tls-transport-budget 0 fn2-tls-transport) 19)
                              (= (fn2-tls-transport-serial 0 fn2-tls-transport) 1)
                              (fn2-tls-transportp fn2-tls-transport)
                              (fn2-tls-transport-wfp fn2-tls-transport)
                              (= (fn2-tls-transport-rows fn2-tls-transport) 1)
                              (fn2-tls-transport-invariant fn2-tls-transport))))
     (mv-let (observed kick fn2-tls-transport)
      (fn2-tls-transport-observe 7 17 3 9 serial 4 0 0 fn2-tls-transport)
      (mv (and (eq start :ok) before-next before-observe
               (equal (list status action offset count) '(:act 1 0 4))
               (eq observed :ok) kick
               (= (fn2-tls-transport-copied 0 fn2-tls-transport) 4)
               (fn2-tls-transport-invariant fn2-tls-transport)) fn2-tls-transport)))))))
(defun fn2-tls-transport-invariant-positive ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-tls-transport
  (mv-let (ok fn2-tls-transport) (fn2-tls-transport-invariant-positive-run fn2-tls-transport) ok)))

(defun fn2-tls-transport-invariant-negative-run (observe fn2-tls-transport)
 (declare (xargs :stobjs fn2-tls-transport :verify-guards nil))
 (mv-let (start fn2-tls-transport) (fn2-tls-transport-start 7 17 3 9 8 8 4 20 fn2-tls-transport)
  (let* ((fn2-tls-transport (fn2-tls-transport-put 0
           (copied 5) (fed 5) (pending 1) (offset 0) (requested 1)))
         (other-hyps (and (fn2-tls-transportp fn2-tls-transport)
                          (fn2-tls-transport-wfp fn2-tls-transport)
                          (= (fn2-tls-transport-rows fn2-tls-transport) 1)))
         (missing (not (fn2-tls-transport-invariant fn2-tls-transport))))
   (if observe
    (mv-let (status kick fn2-tls-transport)
     (fn2-tls-transport-observe 7 17 3 9 0 1 0 0 fn2-tls-transport)
     (declare (ignore kick))
     (mv (and (eq start :ok) other-hyps missing (eq status :ok)
              (not (fn2-tls-transport-invariant fn2-tls-transport))) fn2-tls-transport))
    (mv-let (status action offset count serial fn2-tls-transport)
     (fn2-tls-transport-next 0 0 fn2-tls-transport)
     (declare (ignore action offset count serial))
     (mv (and (eq start :ok) other-hyps missing (eq status :pending)
              (not (fn2-tls-transport-invariant fn2-tls-transport))) fn2-tls-transport))))))
(defun fn2-tls-transport-observe-invariant-negative ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-tls-transport
  (mv-let (ok fn2-tls-transport) (fn2-tls-transport-invariant-negative-run t fn2-tls-transport) ok)))
(defun fn2-tls-transport-next-invariant-negative ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-tls-transport
  (mv-let (ok fn2-tls-transport) (fn2-tls-transport-invariant-negative-run nil fn2-tls-transport) ok)))
(fn2-assert-owed-teeth fn2-tls-transport-observe-preserves-invariant fn2-tls-transport-next-preserves-invariant)


(defun fn2-tls-transport-unit-retire (fn2-tls-transport)
 (declare (xargs :stobjs fn2-tls-transport :verify-guards nil))
 (mv-let (opened fn2-tls-transport) (fn2-tls-transport-unit-open 8 8 4 20 fn2-tls-transport)
  (mv-let (duplicate fn2-tls-transport)
   (fn2-tls-transport-start 7 18 4 10 8 8 4 20 512 fn2-tls-transport)
   (mv-let (stale fn2-tls-transport) (fn2-tls-transport-retire 7 18 fn2-tls-transport)
    (let ((before (and (eq opened :ok) (eq duplicate :state) (eq stale :stale)
                       (= (fn2-tls-transport-handle fn2-tls-transport) 4096)
                       (fn2-tls-transport-handle-invariant fn2-tls-transport))))
     (mv-let (closing fn2-tls-transport) (fn2-tls-transport-retire 7 17 fn2-tls-transport)
      (mv-let (freed fn2-tls-transport)
       (fn2-tls-transport-unit-run '((0 0 9 0 0 0 0 :ok)) fn2-tls-transport)
       (mv-let (done fn2-tls-transport) (fn2-tls-transport-retire 7 17 fn2-tls-transport)
        (let ((closed (and before (eq closing :closing) freed (eq done :done)
                           (= (fn2-tls-transport-handle fn2-tls-transport) 0)
                           (= (fn2-tls-transport-cleanup-credit 0 fn2-tls-transport) 0)
                           (fn2-tls-transport-selected-p 7 17 fn2-tls-transport)
                           (fn2-tls-transport-handle-invariant fn2-tls-transport))))
         (mv-let (rebound fn2-tls-transport)
          (fn2-tls-transport-start 7 18 4 10 8 8 4 20 512 fn2-tls-transport)
          (mv-let (old-cap fn2-tls-transport) (fn2-tls-transport-retire 7 17 fn2-tls-transport)
           (mv (and closed (eq rebound :ok) (eq old-cap :stale)
                    (not (fn2-tls-transport-selected-p 7 17 fn2-tls-transport))
                    (fn2-tls-transport-selected-p 7 18 fn2-tls-transport)
                    (= (fn2-tls-transport-copied 0 fn2-tls-transport) 0)
                    (= (fn2-tls-transport-cleanup-credit 0 fn2-tls-transport) 1)
                    (fn2-tls-transport-handle-invariant fn2-tls-transport)) fn2-tls-transport))))))))))))

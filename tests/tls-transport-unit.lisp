(defun fn2-tls-transport-unit-budget (fn2-tls-transport)
 (declare (xargs :stobjs fn2-tls-transport :verify-guards nil))
 (mv-let (bad fn2-tls-transport) (fn2-tls-transport-unit-open 2 1 1 2 fn2-tls-transport)
  (let ((empty (= (fn2-tls-transport-rows fn2-tls-transport) 0)))
   (mv-let (start fn2-tls-transport) (fn2-tls-transport-unit-open 1 1 1 2 fn2-tls-transport)
    (mv-let (ok fn2-tls-transport)
     (fn2-tls-transport-unit-run '((0 0 1 0 1 1 0 :ok)) fn2-tls-transport)
     (mv-let (closing a b c d fn2-tls-transport)
      (fn2-tls-transport-next 0 0 fn2-tls-transport)
      (declare (ignore a b c d))
      (mv-let (freed fn2-tls-transport)
       (fn2-tls-transport-unit-run '((0 0 9 0 0 0 0 :ok)) fn2-tls-transport)
       (mv-let (status action offset count serial fn2-tls-transport)
        (fn2-tls-transport-next 0 0 fn2-tls-transport)
        (declare (ignore action offset count serial))
        (mv (and (eq bad :bounds) empty (eq start :ok) ok
                 (eq closing :closing) freed (eq status :failed)
                 (fn2-tls-transportp fn2-tls-transport)
                 (fn2-tls-transport-wfp fn2-tls-transport)
                 (= (fn2-tls-transport-rows fn2-tls-transport) 1)
                 (not (equal (fn2-tls-transport-budget 0 fn2-tls-transport) (- 0 1)))
                 (= (fn2-tls-transport-budget 0 fn2-tls-transport) 0)
                 (= (fn2-tls-transport-alive 0 fn2-tls-transport) 0)
                 (= (fn2-tls-transport-cleanup-credit 0 fn2-tls-transport) 0)
                 (= (fn2-tls-transport-serial 0 fn2-tls-transport) 3)) fn2-tls-transport)))))))))

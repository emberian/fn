(defun fn2-tls-transport-invariant-negative-run (observe fn2-tls-transport)
 (declare (xargs :stobjs fn2-tls-transport :verify-guards nil))
 (mv-let (start fn2-tls-transport) (fn2-tls-transport-unit-open 8 8 4 (+ 1 20) fn2-tls-transport)
  (let* ((fn2-tls-transport (fn2-tls-transport-put 0
           (copied 5) (fed 5) (pending 1) (offset 0) (requested 1)))
         (other-hyps (and (fn2-tls-transportp fn2-tls-transport)
                          (fn2-tls-transport-wfp fn2-tls-transport)
                          (= (fn2-tls-transport-rows fn2-tls-transport) 1)))
         (missing (not (fn2-tls-transport-invariant fn2-tls-transport))))
   (if observe
    (mv-let (status kick fn2-tls-transport)
     (fn2-tls-transport-observe 7 17 3 9 1 1 0 0 fn2-tls-transport)
     (declare (ignore kick))
     (mv (and (eq start :ok) other-hyps missing (eq status :ok)
              (not (fn2-tls-transport-invariant fn2-tls-transport))) fn2-tls-transport))
    (mv-let (status action offset count serial fn2-tls-transport)
     (fn2-tls-transport-next 0 0 fn2-tls-transport)
     (declare (ignore action offset count serial))
     (mv (and (eq start :ok) other-hyps missing (eq status :pending)
              (not (fn2-tls-transport-invariant fn2-tls-transport))) fn2-tls-transport))))))

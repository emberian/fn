; Real nonempty codecs/page builder + actual sealer and range step. Initial
; four runs/four overlays are a component environment, not a durable B seed.
; The selected merge/INSTALL/atomic drain and query resume use actual functions.
; Prepared and unexecuted; no model-only success or disk Fence claim.
(in-package "ACL2")
(include-book "runs-assembly")
(include-book "../books/sealer")
(include-book "../books/machines-c-read")
(defconst *fn2-dr8-stobjs* '(fn2-seals fn2-overlays fn2-overlay-index fn2-run-installed fn2-run-builds fn2-run-writers fn2-run-restarts fn2-run-cache fn2-ribbon-builds fn2-ribbon-band fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-paths))
(defconst *fn2-dr8-query-readers* (+ 64 *fn2-seal-field-rows*))
(defconst *fn2-dr8-query-lo* (+ *fn2-dr8-query-readers* (* 8 *fn2-run-reader-fields*)))
(defconst *fn2-dr8-query-hi* (+ *fn2-dr8-query-lo* *fn2-run-entry-rows*))
(defconst *fn2-dr8-merge-readers* (+ *fn2-dr8-query-hi* *fn2-run-entry-rows*))
(defconst *fn2-dr8-merge-query* (+ *fn2-dr8-merge-readers* (* 8 *fn2-run-reader-fields*)))
(defconst *fn2-dr8-fields* (max (+ *fn2-rga-heads* (* 8 *fn2-run-reader-fields*))
                             (+ *fn2-dr8-merge-query* (* 2 *fn2-run-entry-rows*))))
(defmacro fn2-dr8-defun (name args &rest body)
 `(defun ,name (,@args ,@*fn2-dr8-stobjs*)
   (declare (xargs :stobjs ,*fn2-dr8-stobjs* :verify-guards nil
                  ,@(and (member-eq (car args) '(fuel k)) `(:measure (nfix ,(car args)))))) ,@body))
(defmacro fn2-dr8-mv (code) `(mv ,code ,@*fn2-dr8-stobjs*))
(defmacro fn2-dr8-call (name &rest args) `(,name ,@args ,@*fn2-dr8-stobjs*))
(defmacro fn2-dr8-step () `(fn2-seal-step 4096 ,@*fn2-dr8-stobjs*))
(defmacro fn2-dr8-setup ()
 `(b* (((mv code ,@*fn2-rga-stobjs*) (fn2-rga-call fn2-rga-setup))
       ((unless (eq code :ok)) (fn2-dr8-mv code))
       (fn2-ranges (fn2-ranges-init 2 fn2-ranges))
       (fn2-range-sources (fn2-range-sources-init 16 fn2-range-sources))
       (fn2-overlays (fn2-overlays-init 4 fn2-overlays))
       (fn2-overlay-index (fn2-overlay-index-init 1024 fn2-overlay-index))
       (fn2-run-cursors (fn2-run-cursors-init 16 fn2-run-cursors))
       (fn2-run-paths (fn2-run-paths-init (* 16 *fn2-run-max-levels*) fn2-run-paths))
       (fn2-fields (fn2-fields-init *fn2-dr8-fields* fn2-fields))
       (fn2-seals (fn2-seals-init 1 fn2-seals))
       (fn2-ribbon-builds (fn2-ribbon-builds-init 1 fn2-ribbon-builds))
       (fn2-ribbon-band (fn2-ribbon-band-init (fn2-ribbon-slots 256) fn2-ribbon-band)))
   (fn2-dr8-mv :ok)))
(defun fn2-dr8-entry (n)
 (declare (xargs :verify-guards nil))
 (list 1 n (+ 100 n) (* 10 n) (list 65 (+ 48 n))))
(defun fn2-dr8-entries (n k)
 (declare (xargs :verify-guards nil :measure (nfix k)))
 (if (zp k) nil (cons (fn2-dr8-entry n) (fn2-dr8-entries (+ 1 n) (- k 1)))))
(defmacro fn2-dr8-build-one (k)
 `(b* (((mv code ,@*fn2-rga-stobjs*)
        (fn2-rga-call fn2-rga-build 3 *fn2-overview-entry* (list (fn2-dr8-entry (+ 1 ,k))) ,k))
       ((unless (and (eq code :ok) (= (fn2-run-installed-top ,k fn2-run-installed) 0))) (fn2-dr8-mv :build))
       (unit (fn2-run-installed-unit ,k fn2-run-installed))
       ((mv interval fn2-run-installed) (fn2-run-install-units ,k unit unit fn2-run-installed)))
   (fn2-dr8-mv interval)))
(fn2-dr8-defun fn2-dr8-build-runs (k)

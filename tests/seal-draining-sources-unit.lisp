(fn2-dr8-defun fn2-dr8-until-publication (fuel)
 (cond ((= (fn2-seals-phase 0 fn2-seals) *fn2-seal-phase-overlay-return*) (fn2-dr8-mv :published))
       ((zp fuel) (fn2-dr8-mv :fuel))
       (t (b* (((mv code fn2-seals fn2-overlays fn2-overlay-index fn2-run-installed fn2-run-builds fn2-run-writers fn2-run-restarts fn2-run-cache fn2-ribbon-builds fn2-ribbon-band fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-paths) (fn2-dr8-step))
               ((unless (member-eq code '(:more :retired :done))) (fn2-dr8-mv code)))
            (fn2-dr8-call fn2-dr8-until-publication (- fuel 1))))))
(fn2-dr8-defun fn2-dr8-first (fuel)

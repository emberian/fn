  (b* (((mv code fn2-seals fn2-overlays fn2-overlay-index fn2-run-installed fn2-run-builds fn2-run-writers fn2-run-restarts fn2-run-cache fn2-ribbon-builds fn2-ribbon-band fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-paths) (fn2-dr8-call fn2-dr8-build-runs (- k 1)))
       ((unless (eq code :ok)) (fn2-dr8-mv code)))
   (fn2-dr8-build-one (- k 1)))))
(fn2-dr8-defun fn2-dr8-overlay (o)
 (b* (((mv a arena agen fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv b src sgen fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv c fn2-overlays fn2-pool)
       (fn2-ov-start o 3 arena agen (* o 256) 256 9 0 1 0 fn2-overlays fn2-overlay-index fn2-pool))
      ((mv loaded & fn2-fields fn2-pool)
       (fn2-run-load-values *fn2-overview-entry* (fn2-dr8-entry (+ 5 o)) 0 src sgen 0 9 0 1 fn2-fields fn2-pool))
      ((mv inserted fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
       (fn2-ov-insert o 0 128 fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (fn2-overlays (fn2-overlays-set-seq o (+ 5 o) fn2-overlays))
      ((mv frozen fn2-overlays) (fn2-ov-freeze o fn2-overlays)))
  (fn2-dr8-mv (if (and (eq a :ok) (eq b :ok) (eq c :ok) (eq loaded :ok)
                        (eq inserted :ok) (eq frozen :ok) (= (fn2-overlays-count o fn2-overlays) 1)) :ok :overlay))))

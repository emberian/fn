(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun intern-in-package-of-symbol (name sym) (intern name (symbol-package sym)))
(defun load-selected (path names)
 (with-open-file (in path)
  (loop for f = (read in nil :eof) until (eq f :eof) do
   (when (and (consp f) (member (car f) '(defun defmacro)) (member (cadr f) names)) (eval f)))))
(defun calls (path)
 (with-open-file (in path)
  (loop for f = (read in nil :eof) until (eq f :eof)
   when (and (consp f) (eq (car f) 'fn2-cns-source-frames)) collect f)))
(load-selected "books/columns.lisp" '(fn2-columns-sym))
(load-selected (second sb-ext:*posix-argv*) '(fn2-cns-source-frame-hyps fn2-cns-source-frame-specs fn2-cns-source-frames))
(let* ((current (calls "books/cns-source-raw.lisp"))
       (legacy (mapcar (lambda (f) (subseq f 0 5)) current))
       (old (mapcar #'macroexpand-1 legacy)))
 (assert (= 4 (length current)))
 (load-selected (or (third sb-ext:*posix-argv*) "books/cns-source-state.lisp")
  '(fn2-cns-source-frame-hyps fn2-cns-source-frame-specs fn2-cns-source-frames))
 (assert (equal old (mapcar #'macroexpand-1 legacy)))
 (loop for call in current for before in old for after = (macroexpand-1 call) do
  (assert (equal before (subseq after 0 (length before)))))
 (let* ((base (car legacy))
        (nil-form (macroexpand-1 (append base '(nil))))
        (custom (macroexpand-1 (append base '((("Goal" :do-not-induct t)))))))
  (assert (equal (last nil-form 2) '(:hints nil)))
  (assert (equal (last custom 2) '(:hints (("Goal" :do-not-induct t))))))
 (format t "CNS SOURCE FRAME HINT CONTROLS PASS~%"))

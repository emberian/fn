; Real same-backend FNCT REGISTER/APPEND prefix for live-publication controls.
; Lists below are client wire/evidence, never installed C state. Fuel limits
; this finite test only. No accepted reply or persistence outcome is assigned.
(in-package "ACL2")
(include-book "checkpoint-live-publication-support")
(include-book "fnct-client")

(defun fn2-cln-pump (accept cap fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((when (fn2-b-rec-posted fn2-core))
       (mv-let (status & fn2-core) (fn2-b-turn fn2-core)
        (mv (if (eq status :stop) :failed :more) fn2-core fn2-sim fn2-own)))
      ((when (consp (fn2-b-outbox fn2-core)))
       (mv-let (& fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own)
        (mv :more fn2-core fn2-sim fn2-own)))
      ((mv found slot) (fn2-sim-next-flight fn2-sim))
      ((when (or found (= (fn2-sim-wake-pending fn2-sim) 1)))
       (mv-let (& fn2-core fn2-sim fn2-own)
        (fn2-sim-advance-selected nil accept found slot *fn2-fault-none* cap fn2-core fn2-sim fn2-own)
        ; A waiting Accept/Recv remains a flight. Give the real executor its
        ; turn even when that completion only moved the flight deadline.
        (mv-let (status & fn2-core) (fn2-b-turn fn2-core)
         (mv (if (eq status :stop) :failed :more) fn2-core fn2-sim fn2-own))))
      ((mv status & fn2-core) (fn2-b-turn fn2-core)))
  (mv (if (eq status :stop) :failed :more) fn2-core fn2-sim fn2-own)))

; One client byte and one observed reply byte per turn, with backpressure.
; Nonce comes only from actual network ACCEPT. No automatic echo/client drain.
(defun fn2-cln-exchange (fuel cap nonce request reply fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (b* (((when (and (<= 10 (len reply))
                  (<= (+ 42 (fnc-be-value (take 4 (nthcdr 6 reply)) 0)) (len reply))))
       (mv :reply (fnc-frame-extent reply) nonce fn2-core fn2-sim fn2-own))
      ((when (zp fuel)) (mv :fuel reply nonce fn2-core fn2-sim fn2-own))
      ((mv sent received byte actual fn2-sim)
       (stobj-let ((fn2-sim-network (fn2-sim-net fn2-sim)))
        (sent received byte actual fn2-sim-network)
        (b* ((actual (if (< cap (fn2-sim-network-rows fn2-sim-network))
                          (fn2-sim-network-nonce cap fn2-sim-network) 0))
             ((mv sent fn2-sim-network)
              (if (and (posp actual) (consp request))
               (fn2-network-client-byte cap actual (car request) fn2-sim-network)
               (mv :would-block fn2-sim-network)))
             ((mv received byte fn2-sim-network)
              (if (posp actual) (fn2-network-client-read cap actual fn2-sim-network)
               (mv :would-block 0 fn2-sim-network))))
         (mv sent received byte actual fn2-sim-network))
        (mv sent received byte actual fn2-sim)))
      ((when (and (posp nonce) (not (= nonce actual))))
       (mv :changed reply nonce fn2-core fn2-sim fn2-own))
      (request (if (eq sent :ok) (cdr request) request))
      (reply (if (eq received :ok) (append reply (list byte)) reply))
      ((mv code fn2-core fn2-sim fn2-own)
       (fn2-cln-pump (zp actual) cap fn2-core fn2-sim fn2-own)))
  (if (eq code :failed) (mv code reply actual fn2-core fn2-sim fn2-own)
   (fn2-cln-exchange (- fuel 1) cap actual request reply fn2-core fn2-sim fn2-own))))

; Caller supplies a freshly booted real listening node and an unused cap >0
; (SIM init owns cap0). Peer configuration is external test I/O, not authority.
; Returns the node-issued cursor and actual accepted article position.
(defun fn2-cln-register-append (cap uid consumer op article fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((unused
       (stobj-let ((fn2-sim-network (fn2-sim-net fn2-sim))) (unused)
        (and (posp cap) (< cap (fn2-sim-network-rows fn2-sim-network))
             (= (fn2-sim-network-nonce cap fn2-sim-network) 0)) unused))
      ((unless unused) (mv :cap nil 0 0 fn2-core fn2-sim fn2-own))
      ((mv peer fn2-sim)
       (stobj-let ((fn2-sim-network (fn2-sim-net fn2-sim))) (code fn2-sim-network)
        (fn2-network-set-peer cap *fn2-peer-family-local* uid 0 fn2-sim-network)
        (mv code fn2-sim)))
      ((unless (eq peer :ok)) (mv peer nil 0 0 fn2-core fn2-sim fn2-own))
      ((mv code registered nonce fn2-core fn2-sim fn2-own)
       (fn2-cln-exchange 400000 cap 0 (fnc-register consumer 1) nil fn2-core fn2-sim fn2-own))
      ((unless (and (eq code :reply) (eq (car (fnc-reply 'register registered)) :accepted)))
       (mv :register nil 0 nonce fn2-core fn2-sim fn2-own))
      (cursor (fnc-reply-cursor 'register registered))
      ((mv code appended nonce fn2-core fn2-sim fn2-own)
       (fn2-cln-exchange 400000 cap nonce (fnc-append op article) nil fn2-core fn2-sim fn2-own))
      (result (fnc-reply 'append appended))
      ((unless (and (eq code :reply) (eq (car result) :accepted)
                    (posp (car (caddr result)))))
       (mv :append cursor 0 nonce fn2-core fn2-sim fn2-own)))
  (mv :complete cursor (car (caddr result)) nonce fn2-core fn2-sim fn2-own)))

; Full shared boundary: REGISTER and APPEND replies precede snapshot acquisition.
; The cursor/position are copied reply octets/scalars, not inferred C rows.
(defun fn2-cln-prefix-to-held (cap uid consumer op article fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((mv prefix cursor position nonce fn2-core fn2-sim fn2-own)
       (fn2-cln-register-append cap uid consumer op article fn2-core fn2-sim fn2-own))
      ((unless (eq prefix :complete))
       (mv prefix cursor position nonce fn2-core fn2-sim fn2-own))
      ((mv held fn2-core fn2-sim fn2-own)
       (fn2-clc-prefix-to-held fn2-core fn2-sim fn2-own)))
  (mv held cursor position nonce fn2-core fn2-sim fn2-own)))

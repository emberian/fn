; Source-only leaf controls over actual pool primitives; no synthetic OpRefs.
(in-package "ACL2")
(include-book "../books/pool-ranges")
(include-book "std/util/bstar" :dir :system)
(defun fn2-pqr-bytes (n off fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (if (zp n) nil (cons (fn2-pool-datai off fn2-pool) (fn2-pqr-bytes (- n 1) (+ off 1) fn2-pool))))
(defun fn2-pqr-row (i fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (list
  (fn2-pool-gen i fn2-pool)
  (fn2-pool-base i fn2-pool)
  (fn2-pool-cap i fn2-pool)
  (fn2-pool-state i fn2-pool)
  (fn2-pool-owner-kind i fn2-pool)
  (fn2-pool-owner-slot i fn2-pool)
  (fn2-pool-owner-gen i fn2-pool)
  (fn2-pool-lease-op-slot i fn2-pool)
  (fn2-pool-lease-op-gen i fn2-pool)
  (fn2-pool-lease-off i fn2-pool)
  (fn2-pool-lease-len i fn2-pool)
  (fn2-pool-out-count i fn2-pool)
  (fn2-pool-query-ref-count i fn2-pool)
  (fn2-pool-fill i fn2-pool)
  (fn2-pool-hand-to-kind i fn2-pool)
  (fn2-pool-hand-to-slot i fn2-pool)
  (fn2-pool-hand-to-gen i fn2-pool)
  (fn2-pool-next-free i fn2-pool)
  (fn2-pool-class i fn2-pool)
))
(defun fn2-pqr-view (fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (list (fn2-pqr-row 0 fn2-pool) (fn2-pqr-row 1 fn2-pool)
       (fn2-pqr-bytes (fn2-pool-data-length fn2-pool) 0 fn2-pool)
       (fn2-pool-nslots fn2-pool) (fn2-pool-capacity-bytes fn2-pool)
       (fn2-pool-gen-limit fn2-pool) (fn2-pool-retired-count fn2-pool)
       (fn2-pool-nclasses fn2-pool) (fn2-pool-class-headsi 0 fn2-pool)
       (fn2-pool-class-countsi 0 fn2-pool) (fn2-pool-class-sizesi 0 fn2-pool)))
(defun fn2-pqr-run (fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (b* ((fn2-pool (fn2-pool-init '((2 . 64)) 1 10 fn2-pool))
      ((mv reserve slot gen fn2-pool) (fn2-pool-reserve 0 7 3 4 fn2-pool))
      ((mv w0 fn2-pool) (fn2-pool-write slot gen 0 65 7 3 4 fn2-pool))
      ((mv w1 fn2-pool) (fn2-pool-write slot gen 1 66 7 3 4 fn2-pool))
      ((mv acquire1 fn2-pool) (fn2-pool-query-acquire slot gen 0 1 7 3 4 fn2-pool))
      ((mv acquire2 fn2-pool) (fn2-pool-query-acquire slot gen 0 1 7 3 4 fn2-pool))
      (two (fn2-pool-query-ref-count slot fn2-pool))
      ((mv read byte) (fn2-pool-read slot gen 0 7 3 4 fn2-pool))
      (before (fn2-pqr-view fn2-pool))
      ((mv write fn2-pool) (fn2-pool-write slot gen 0 90 7 3 4 fn2-pool))
      ((mv reset fn2-pool) (fn2-pool-reset slot gen 7 3 4 fn2-pool))
      ((mv release fn2-pool) (fn2-pool-release slot gen 7 3 4 fn2-pool))
      ((mv hand fn2-pool) (fn2-pool-hand slot gen 7 3 4 8 5 6 fn2-pool))
      ((mv input & fn2-pool) (fn2-pool-lease-in slot gen 1 0 1 7 3 4 fn2-pool))
      ((mv copy fn2-pool) (fn2-pool-copy-range slot gen 0 slot gen 0 1 7 3 4 fn2-pool))
      ((mv drop & fn2-pool) (fn2-pool-drop-prefix slot gen 1 0 2 7 3 4 fn2-pool))
      ((mv truncate fn2-pool) (fn2-pool-truncate slot gen 0 7 3 4 fn2-pool))
      (unchanged (equal before (fn2-pqr-view fn2-pool)))
      ((mv wrong-owner fn2-pool) (fn2-pool-query-acquire slot gen 0 1 7 9 4 fn2-pool))
      ((mv wrong-owner-write fn2-pool) (fn2-pool-write slot gen 0 90 7 9 4 fn2-pool))
      ((mv bounds fn2-pool) (fn2-pool-query-acquire slot gen 3 0 7 3 4 fn2-pool))
      ((mv stale fn2-pool) (fn2-pool-query-acquire slot (+ gen 1) 0 1 7 3 4 fn2-pool))
      (refusals-unchanged (equal before (fn2-pqr-view fn2-pool)))
      ((mv loan fn2-pool) (fn2-pool-lease-out slot gen 0 2 7 3 4 fn2-pool))
      ((mv acquire3 fn2-pool) (fn2-pool-query-acquire slot gen 1 1 7 3 4 fn2-pool))
      ((mv release3 last3 fn2-pool) (fn2-pool-query-release slot gen fn2-pool))
      ((mv release2 last2 fn2-pool) (fn2-pool-query-release slot gen fn2-pool))
      ((mv release1 last1 fn2-pool) (fn2-pool-query-release slot gen fn2-pool))
      (loan-state (list (fn2-pool-out-count slot fn2-pool) (fn2-pool-query-ref-count slot fn2-pool)
                        (fn2-pool-state slot fn2-pool)))
      (loan-before (fn2-pqr-view fn2-pool))
      ((mv double-release double-last fn2-pool) (fn2-pool-query-release slot gen fn2-pool))
      (double-unchanged (equal loan-before (fn2-pqr-view fn2-pool)))
      ((mv still-loaned fn2-pool) (fn2-pool-release slot gen 7 3 4 fn2-pool))
      ((mv output-release fn2-pool) (fn2-pool-release-out slot gen fn2-pool))
      ((mv final-release fn2-pool) (fn2-pool-release slot gen 7 3 4 fn2-pool))
      (free-before (fn2-pqr-view fn2-pool))
      ((mv stale-release stale-last fn2-pool) (fn2-pool-query-release slot gen fn2-pool))
      (stale-unchanged (equal free-before (fn2-pqr-view fn2-pool)))
      ((mv reserve-again next-slot next-gen fn2-pool) (fn2-pool-reserve 0 7 3 4 fn2-pool)))
  (mv (list (list reserve w0 w1 acquire1 acquire2 two read byte)
            (list write reset release hand input copy drop truncate unchanged)
            (list wrong-owner wrong-owner-write bounds stale refusals-unchanged)
            (list loan acquire3 release3 last3 release2 last2 release1 last1 loan-state)
            (list double-release double-last double-unchanged still-loaned output-release final-release
                  stale-release stale-last stale-unchanged reserve-again (= next-slot slot) (= next-gen (+ gen 1))
                  (fn2-pool-query-ref-count next-slot fn2-pool))) fn2-pool)))
(defun fn2-pqr-result ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool (mv-let (result fn2-pool) (fn2-pqr-run fn2-pool) result)))
(assert-event
 (equal (fn2-pqr-result)
  (list '(:ok :ok :ok :ok :ok 2 :ok 65)
        '(:held :held :held :held :held :held :held :held t)
        '(:owner :owner :bounds :stale t)
        (list :ok :ok :ok nil :ok nil :ok t (list 1 0 *fn2-pool-state-leased-out*))
        '(:state nil t :state :ok :ok :stale nil t :ok t t 0))))

; Counter exhaustion is a shape-valid boundary, not a circulating query
; history. This hypothesis-removal fixture does not forge an I/O operation.
(defun fn2-pqr-max (fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (b* ((fn2-pool (fn2-pool-init '((2 . 64)) 1 10 fn2-pool))
      ((mv & slot gen fn2-pool) (fn2-pool-reserve 0 7 3 4 fn2-pool))
      ((mv & fn2-pool) (fn2-pool-write slot gen 0 65 7 3 4 fn2-pool))
      (fn2-pool (fn2-pool-set-query-ref-count slot *fn2-pool-query-ref-max* fn2-pool))
      (before (fn2-pqr-view fn2-pool))
      ((mv exhausted fn2-pool) (fn2-pool-query-acquire slot gen 0 1 7 3 4 fn2-pool)))
  (mv (list exhausted (equal before (fn2-pqr-view fn2-pool))
            (fn2-pool-query-ref-count slot fn2-pool)) fn2-pool)))
(defun fn2-pqr-max-result ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool (mv-let (result fn2-pool) (fn2-pqr-max fn2-pool) result)))
(assert-event (equal (fn2-pqr-max-result) (list :exhausted t 1152921504606846975)))

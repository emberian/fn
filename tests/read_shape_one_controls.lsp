; Execute the actual old/new RD macro and the actual shared event constructor.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun intern-in-package-of-symbol (s x) (intern s (symbol-package x)))
(defun packn-pos (xs sym) (intern (format nil "~{~A~}" xs) (symbol-package sym)))
(defun strip-cars (xs) (mapcar #'car xs))
(defun strip-cadrs (xs) (mapcar #'cadr xs))
(defun set-difference-eq (xs ys) (set-difference xs ys :test #'eq))
(defun set-difference-equal (xs ys) (set-difference xs ys :test #'equal))
(defun remove-eq (x xs) (remove x xs :test #'eq))
(defun remove-duplicates-equal (xs) (remove-duplicates xs :test #'equal))
(defun len (xs) (length xs))
(defun zp (n) (zerop n))
(defun book-forms (path)
 (with-open-file (in path) (loop for x = (read in nil :eof) until (eq x :eof) collect x)))
(defun selected (path name)
 (find name (book-forms path) :key (lambda (x) (and (consp x) (cadr x)))))
; Metadata affects auxiliary tuple arity and reader hints, not public claims.
(defun getpropc (name key default world)
 (declare (ignore name world)) (if (eq key 'stobjs-out) (make-list 8) default))
(defun fn2-shape-column-readers (objs world) (declare (ignore objs world)) nil)
(eval (selected "books/columns.lisp" 'fn2-columns-sym))
(eval (selected "books/format-check.lisp" 'fn2-fc-shape-claims))
(eval (selected "books/machines-c-successor.lisp" 'fn2-idc-hyp-list))
(eval (selected "books/machines.lisp" 'fn2-shape-tuple-vars))
(eval (selected "books/machines.lisp" 'fn2-shape-one-events))
(dolist (name '(fn2-rd-shape-disables fn2-rd-keeps fn2-rd-folds))
 (eval (selected "books/machines-c-read.lisp" name)))
(defparameter *baseline* (sb-ext:posix-getenv "FN_RD_BASELINE"))
(defparameter *old* (book-forms *baseline*))
(defparameter *new* (book-forms "books/machines-c-read.lisp"))
(defparameter *old-call* (find-if (lambda (x) (and (eq (car x) 'fn2-rd-shape)
                                                (eq (cadr x) 'fn2-rd-identity))) *old*))
(defparameter *new-call* (find-if (lambda (x) (and (eq (car x) 'fn2-rd-shape)
                                                (eq (cadr x) 'fn2-rd-identity))) *new*))
(let ((mutation (sb-ext:posix-getenv "FN_RD_MUTATION")))
 (cond ((equal mutation "runtime")
        (setf (car (last (find 'fn2-rd-identity *new* :key #'cadr))) nil))
       ((equal mutation "hyps") (setf (nth 4 *new-call*) '(fn2-reads)))))
(defun source-shape (forms)
 (remove-if (lambda (x) (and (eq (car x) 'defmacro) (eq (cadr x) 'fn2-rd-shape)))
  (mapcar (lambda (x) (if (and (eq (car x) 'fn2-rd-shape) (eq (cadr x) 'fn2-rd-identity))
                         (subseq x 0 6) x)) forms)))
(assert (string= (prin1-to-string (source-shape *old*)) (prin1-to-string (source-shape *new*))))
(eval (selected *baseline* 'fn2-rd-shape))
(defparameter *legacy-calls*
 (append (remove-if-not (lambda (x) (eq (car x) 'fn2-rd-shape)) *old*)
  '((fn2-rd-shape sample (x a b) ((a 1) (b 2)) (a b) ((:keep a-rows) callee) nil))))
(defparameter *legacy* (mapcar #'macroexpand-1 *legacy-calls*))
(defparameter *old-event* (cadr (macroexpand-1 *old-call*)))
(eval (selected "books/machines-c-read.lisp" 'fn2-rd-shape))
(assert (string= (prin1-to-string *legacy*) (prin1-to-string (mapcar #'macroexpand-1 *legacy-calls*))))
(assert (equal (macroexpand-1 (append *old-call* '(t nil))) (macroexpand-1 *old-call*)))
(defparameter *one* (macroexpand-1 *new-call*))
(defparameter *shared* (cadr *one*))
(assert (eq (car *shared*) 'fn2-shape-one))
; Explicit enables/disables retain the legacy list and :keep semantics.
(let* ((theory (getf (cdr (car (getf (cdddr *old-event*) :hints))) :in-theory)))
 (assert (equal (nth 7 *shared*) (cadr theory)))
 (assert (equal (nth 8 *shared*) (caddr theory))))
(defparameter *emitted* (apply #'fn2-shape-one-events (append (cdr *shared*) '(nil))))
(defparameter *public* (car (last *emitted*)))
(when (equal (sb-ext:posix-getenv "FN_RD_MUTATION") "rules")
 (setf *public* (append *public* '(:rule-classes nil))))
(assert (equal (subseq *old-event* 0 3) (subseq *public* 0 3)))
(assert (equal (member :rule-classes (cdddr *old-event*)) (member :rule-classes (cdddr *public*))))
(assert (equal (cddr *one*) (cddr (macroexpand-1 *old-call*))))
(format t "READ SHAPE ONE CONTROLS PASS~%")

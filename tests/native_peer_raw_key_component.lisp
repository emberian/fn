;;; Receiver primitive component: PEM signer, raw enrolled-key verifier.
(unless (find-package "ACL2") (make-package "ACL2" :use '("COMMON-LISP")))
(load "host/native/crypto.lisp")
(load "host/native/tls.lisp")
(load "host/native/signatures.lisp")
(in-package "ACL2")

(let* ((private (or (sb-ext:posix-getenv "FN_TEST_ML_DSA_PRIVATE")
                    (error "missing private fixture")))
       (public (or (sb-ext:posix-getenv "FN_TEST_ML_DSA_PUBLIC")
                   (error "missing public fixture")))
       (other (or (sb-ext:posix-getenv "FN_TEST_ML_DSA_PUBLIC_B")
                  (error "missing second public fixture")))
       (message #(102 110 45 112 101 101 114))
       (signature (fnn-hsig-ml-dsa-65-sign private message))
       (raw (fnn-hsig-ml-dsa-65-public-key public))
       (other-raw (fnn-hsig-ml-dsa-65-public-key other)))
  (assert (fnn-hsig-ml-dsa-65-verify public message signature))
  (multiple-value-bind (ok observed)
      (fnn-hsig-ml-dsa-65-verify-raw raw message signature)
    (assert (and ok (equalp observed raw))))
  (multiple-value-bind (ok observed)
      (fnn-hsig-ml-dsa-65-verify-raw other-raw message signature)
    (declare (ignore observed))
    (assert (not ok)))
  (let ((bad (copy-seq signature)))
    (setf (aref bad 0) (logxor (aref bad 0) 1))
    (multiple-value-bind (ok observed)
        (fnn-hsig-ml-dsa-65-verify-raw raw message bad)
      (declare (ignore observed))
      (assert (not ok)))))
(format t "native peer raw-key component passed~%")

(defun fn2-crcu-bytes (i c descriptor batch prior immediate fn2-boot-config fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)
 (declare (xargs :stobjs (fn2-boot-config fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence) :verify-guards nil :measure (nfix (- 160 (nfix i)))))
 (if (or (not (natp i)) (>= i 160)) (mv fn2-boot-config fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)
  (b* ((byte (cond ((< i 32) batch) ((< i 64) prior) ((< i 96) (+ 40 c)) ((< i 128) descriptor) (t immediate)))
       (fn2-boot-config (if (< i 96) (update-fn2-boot-config-anchor-evidencei (+ (* 96 c) i) byte fn2-boot-config) fn2-boot-config))
       (fn2-checkpoint-bytes (if (< i 32) (fn2-checkpoint-bytes-set-value (+ (* 192 c) i) descriptor fn2-checkpoint-bytes) fn2-checkpoint-bytes))
       (fn2-checkpoint-recovery-evidence (update-fn2-checkpoint-recovery-evidence-bytesi (+ 256 (* 160 c) i) byte fn2-checkpoint-recovery-evidence)))
   (fn2-crcu-bytes (+ i 1) c descriptor batch prior immediate fn2-boot-config fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence))))

(defun fn2-crcu-candidate (c mode fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)

 (b* ((child (<= 2 c)) (r (* 6 c)) (e (+ 1 c))
      (checkpoint (if (and child (not (eq mode :same-number))) 11 10))
      (cut-commit (if child 11 10)) (cut-event (if child (if (eq mode :cut-prefix) 102 103) 100))
      (commit (if child 12 11)) (event (if child 105 102)) (first (if child 104 101)) (last (if child 106 103))
      (unit (if child 32 16)) (epoch (if child 4 3)) (allocation (if child 101 100))
      (descriptor (if child 27 17)) (batch (if child 29 (if (and (= c 1) (eq mode :unequal-copy)) 20 19)))
      (prior (if child (if (eq mode :fork) 7 17) (if (eq mode :self-parent) 17 3)))
      (immediate (if child 19 (if (and (= c 1) (eq mode :immediate-predecessor)) 6 5)))
      (fn2-checkpoints (fn2-checkpoints-put c (state *fn2-checkpoint-state-checked*) (builder-token 0)
        (checkpoint checkpoint) (history 1) (incarnation 1) (cut-commit cut-commit) (cut-event cut-event)
        (anchor-mask (ash 1 c)) (bank (floor c 2))))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-put r (storage-domain 0) (physical-unit unit) (writer-epoch epoch)
        (allocation allocation) (page-kind *page-kind-checkpoint-descriptor*) (encoded-length 4096)))
      (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-put e
        (phase *fn2-checkpoint-recovery-evidence-phase-complete*) (ready 1) (candidate c) (tag (+ 1 c)) (ordinal 0)
        (extent (if child 5 4)) (epoch (if child 8 7)) (allocation (if child 201 200))
        (checkpoint checkpoint) (cut-commit cut-commit) (cut-event cut-event) (commit commit) (event event) (first first) (last last)
        (descriptor-domain 0) (descriptor-unit unit) (descriptor-epoch epoch) (descriptor-allocation allocation)
        (descriptor-kind *page-kind-checkpoint-descriptor*) (descriptor-length 4096)))
      ((mv fn2-boot-config fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)
       (fn2-crcu-bytes 0 c descriptor batch prior immediate fn2-boot-config fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)))
  (mv fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)))
(defun fn2-crcu-candidates (c mode fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)
 (declare (xargs :stobjs (fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence) :verify-guards nil :measure (nfix (- 4 (nfix c)))))
 (if (or (not (natp c)) (>= c 4)) (mv fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)
  (mv-let (fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)
   (fn2-crcu-candidate c mode fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)
   (fn2-crcu-candidates (+ c 1) mode fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence))))
(defun fn2-crcu-drive (fuel fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census)
 (declare (xargs :stobjs (fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census) :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-checkpoint-recovery-census)
  (mv-let (code fn2-checkpoint-recovery-census)
   (with-local-stobj fn2-origin
        (let ((fn2-origin (fn2-origin-prepare '((:origin-lineage . 101) (:origin-domain . 103) (:origin-incarnation . 107) (:history-id . 1) (:history-incarnation . 1)) fn2-origin)))
         (fn2-checkpoint-recovery-census-step fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-origin fn2-checkpoint-recovery-census)))
   (if (eq code :more) (fn2-crcu-drive (- fuel 1) fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census)
    (mv code fn2-checkpoint-recovery-census)))))

(defun fn2-crcu-body (mode fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census)
 (declare (xargs :stobjs (fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census) :verify-guards nil))
 (b* ((fn2-boot-config (fn2-boot-config-empty 0 fn2-boot-config))
      (fn2-boot-config (update-fn2-boot-config-anchor-checked-mask
        (cond ((member-eq mode '(:invalid-prior :empty-prior)) 12) ((member-eq mode '(:invalid-slot :incomplete-scan)) 7) (t 15)) fn2-boot-config))
      (fn2-boot-config (update-fn2-boot-config-anchor-empty-mask (if (eq mode :empty-prior) 3 0) fn2-boot-config))
      (fn2-boot-config (update-fn2-boot-config-anchor-invalid-mask
        (cond ((eq mode :invalid-prior) 3) ((eq mode :invalid-slot) 8) ((eq mode :contradictory-masks) 1) (t 0)) fn2-boot-config))
      (fn2-boot-config (update-fn2-boot-config-map-fifo-mask 15 fn2-boot-config)) (fn2-boot-config (update-fn2-boot-config-arena-mask 15 fn2-boot-config))
      (fn2-checkpoints (fn2-checkpoints-init 4 fn2-checkpoints)) (fn2-checkpoint-refs (fn2-checkpoint-refs-init 24 fn2-checkpoint-refs))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-init 768 fn2-checkpoint-bytes))
      (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-init 5 fn2-checkpoint-recovery-evidence))
      (fn2-checkpoint-recovery-census (fn2-checkpoint-recovery-census-init 1 fn2-checkpoint-recovery-census))
      ((mv fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)
       (fn2-crcu-candidates 0 mode fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence))
      (fn2-boot-config (if (eq mode :stale-batch) (update-fn2-boot-config-anchor-evidencei 0 1 fn2-boot-config) fn2-boot-config))
      (fn2-checkpoint-bytes (if (eq mode :stale-descriptor) (fn2-checkpoint-bytes-set-value 0 2 fn2-checkpoint-bytes) fn2-checkpoint-bytes))
      (fn2-checkpoints (if (eq mode :stale-cut) (fn2-checkpoints-set-cut-event 0 99 fn2-checkpoints) fn2-checkpoints))
      (fn2-checkpoint-recovery-evidence (cond
        ((eq mode :missing-evidence) (fn2-checkpoint-recovery-evidence-set-ready 1 0 fn2-checkpoint-recovery-evidence))
        ((eq mode :missing-first) (fn2-checkpoint-recovery-evidence-set-first 1 0 fn2-checkpoint-recovery-evidence))
        (t fn2-checkpoint-recovery-evidence)))
      (positive-bound (if mode t (and
        (with-local-stobj fn2-origin
        (let ((fn2-origin (fn2-origin-prepare '((:origin-lineage . 101) (:origin-domain . 103) (:origin-incarnation . 107) (:history-id . 1) (:history-incarnation . 1)) fn2-origin)))
         (fn2-checkpoint-recovery-census-bound-p 0 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence)))
        (with-local-stobj fn2-origin
        (let ((fn2-origin (fn2-origin-prepare '((:origin-lineage . 101) (:origin-domain . 103) (:origin-incarnation . 107) (:history-id . 1) (:history-incarnation . 1)) fn2-origin)))
         (fn2-checkpoint-recovery-census-bound-p 1 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence)))
        (with-local-stobj fn2-origin
        (let ((fn2-origin (fn2-origin-prepare '((:origin-lineage . 101) (:origin-domain . 103) (:origin-incarnation . 107) (:history-id . 1) (:history-incarnation . 1)) fn2-origin)))
         (fn2-checkpoint-recovery-census-bound-p 2 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence)))
        (with-local-stobj fn2-origin
        (let ((fn2-origin (fn2-origin-prepare '((:origin-lineage . 101) (:origin-domain . 103) (:origin-incarnation . 107) (:history-id . 1) (:history-incarnation . 1)) fn2-origin)))
         (fn2-checkpoint-recovery-census-bound-p 3 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence))))))
      ; Same semantic names, different physical pair: the otherwise bound
      ; candidate must not acquire authority through default1/1 fallback.
      (wrong-physical-bound (if mode t
       (with-local-stobj fn2-origin
        (let ((fn2-origin (fn2-origin-prepare '((:origin-lineage . 101) (:origin-domain . 103) (:origin-incarnation . 107)
                                             (:history-id . 37) (:history-incarnation . 41)) fn2-origin)))
         (not (fn2-checkpoint-recovery-census-bound-p 0 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence))))))
      ((mv begun fn2-checkpoint-recovery-census) (fn2-checkpoint-recovery-census-begin fn2-boot-config fn2-checkpoint-recovery-census))
      ((mv done fn2-checkpoint-recovery-census) (if (eq begun :more)
        (fn2-crcu-drive 100 fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census)
        (mv begun fn2-checkpoint-recovery-census)))
      (expected (cond ((member-eq mode '(:same-number :unequal-copy :self-parent :cut-prefix :immediate-predecessor)) *fn2-checkpoint-recovery-census-topology-conflict*)
                      ((eq mode :fork) *fn2-checkpoint-recovery-census-topology-fork*)
                      ((member-eq mode '(:stale-batch :stale-descriptor :stale-cut :missing-evidence :missing-first :invalid-slot :invalid-prior :contradictory-masks :incomplete-scan)) *fn2-checkpoint-recovery-census-topology-incomplete*)
                      (t *fn2-checkpoint-recovery-census-topology-single-head*))))
  (mv (and positive-bound wrong-physical-bound (eq done (if (member-eq mode '(:incomplete-scan :contradictory-masks)) :scan-incomplete :semantic-roots-owed))
           (= (fn2-checkpoint-recovery-census-topology 0 fn2-checkpoint-recovery-census) expected)
           (= (fn2-checkpoint-recovery-census-semantic-roots-owed 0 fn2-checkpoint-recovery-census) 1)
           ; Invalid slots deliberately retain fully matching old candidate
           ; and ready evidence rows. Only this scan's checked mask admits
           ; ancestry: neither their row nor their incoming column may leak.
           (cond ((eq mode :invalid-slot)
                   (and (= (fn2-checkpoint-recovery-census-bound-mask 0 fn2-checkpoint-recovery-census) 7)
                        (= (fn2-checkpoint-recovery-census-covers 3 (fn2-checkpoint-recovery-census-ancestry 0 fn2-checkpoint-recovery-census)) 0)
                        (= (logand 34952 (fn2-checkpoint-recovery-census-ancestry 0 fn2-checkpoint-recovery-census)) 0)))
                 ((member-eq mode '(:invalid-prior :empty-prior))
                   (and (= (fn2-checkpoint-recovery-census-bound-mask 0 fn2-checkpoint-recovery-census) 12)
                        (= (fn2-checkpoint-recovery-census-parents 0 fn2-checkpoint-recovery-census) 0)
                        (= (fn2-checkpoint-recovery-census-open-parent-mask 0 fn2-checkpoint-recovery-census) 12)))
                 ((eq mode :contradictory-masks)
                   (and (= (fn2-checkpoint-recovery-census-bound-mask 0 fn2-checkpoint-recovery-census) 0)
                        (= (fn2-checkpoint-recovery-census-ancestry 0 fn2-checkpoint-recovery-census) 0)))
                 (t t))
           (or mode (and (= (fn2-checkpoint-recovery-census-head 0 fn2-checkpoint-recovery-census) 2)
                         (= (fn2-checkpoint-recovery-census-head-mask 0 fn2-checkpoint-recovery-census) 12)
                         (= (fn2-checkpoint-recovery-census-open-parent-mask 0 fn2-checkpoint-recovery-census) 3))))
      fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census)))
(defun fn2-crcu-test (mode)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census)
  (fn2-crcu-body mode fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census)))

; Real generated entry codec and run builder/page lookup size boundary.
; Witness blobs are typed opaque fixture data, not authenticated batch evidence.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/runs-served")
(defconst *fn2-easu-entry*
 (list 123 456 1 (make-list 3900 :initial-element 42) (cons 1 (make-list 32 :initial-element 7)) 1
       (make-list *fn2-format-frame-header-max-size* :initial-element 1)
       (make-list *fn2-format-sealed-batch-max-size* :initial-element 2)))
(defun fn2-easu-decode (fuel end slot gen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel 0 fn2-fields)
  (b* ((before (fn2-fields-decode-next 0 fn2-fields))
       ((mv code next fn2-fields)
        (fn2-event-archive-member-entry-decode-step 0 slot gen 0 end 9 0 1 1 fn2-fields fn2-pool))
       ((unless (and (<= before next) (<= (- next before) 1))) (mv :over-budget next fn2-fields))
       ((unless (eq code :more)) (mv code next fn2-fields)))
   (fn2-easu-decode (- fuel 1) end slot gen fn2-fields fn2-pool))))
(defun fn2-easu-body (fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init 128 fn2-fields))
      (fn2-pool (fn2-pool-init '((1 . 65536) (1 . 16384)) 1 100 fn2-pool))
      ((mv a dst dg fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv b src sg fn2-pool) (fn2-pool-reserve 1 9 0 1 fn2-pool))
      ((mv values & fn2-fields fn2-pool)
       (fn2-run-load-values *fn2-event-archive-member-entry* *fn2-easu-entry* 0 src sg 0 9 0 1 fn2-fields fn2-pool))
      (antecedent (fn2-event-archive-member-entry-roundtrip-hyps 0 dst dg 0 9 0 1 fn2-fields fn2-pool))
      (initial-values (fn2-layout-values *fn2-event-archive-member-entry* 0 fn2-fields fn2-pool))
      ((mv wrong-owner & fn2-pool) (fn2-event-archive-member-entry-encode 0 dst dg 0 8 0 1 fn2-fields fn2-pool))
      ((mv encoded end fn2-pool) (fn2-event-archive-member-entry-encode 0 dst dg 0 9 0 1 fn2-fields fn2-pool))
      (fn2-fields (fn2-event-archive-member-entry-start 0 fn2-fields))
      ((mv old-quota old-next fn2-fields) (fn2-event-archive-member-entry-decode-step 0 dst dg 0 end 9 0 1 4096 fn2-fields fn2-pool))
      ((mv full next fn2-fields) (fn2-event-archive-member-entry-decode 0 dst dg 0 end 9 0 1 fn2-fields fn2-pool))
      (whole-conclusion (fn2-layout-roundtrip-resultp *fn2-event-archive-member-entry* initial-values full next end
                        (fn2-layout-values *fn2-event-archive-member-entry* 0 fn2-fields fn2-pool)
                        (fn2-pool-logical-octets end (fn2-pool-base dst fn2-pool) fn2-pool)))
      (complete (and (eq full :ok) (equal next end)
                 (equal (fn2-run-unload-values *fn2-event-archive-member-entry* 0 fn2-fields fn2-pool) *fn2-easu-entry*)))
      (fn2-fields (fn2-event-archive-member-entry-start 0 fn2-fields))
      (before (list (fn2-fields-copy fn2-fields) (fn2-pool-copy fn2-pool)))
      ((mv zero & fn2-fields) (fn2-event-archive-member-entry-decode-step 0 dst dg 0 end 9 0 1 0 fn2-fields fn2-pool))
      (zero-unchanged (and (eq zero :bounds) (equal before (list (fn2-fields-copy fn2-fields) (fn2-pool-copy fn2-pool)))))
      ((mv partial pend fn2-fields) (fn2-easu-decode *fn2-event-archive-member-entry-decode-transitions* end dst dg fn2-fields fn2-pool))
      (streamed (and (eq partial :ok) (equal pend end)
                 (equal (fn2-run-unload-values *fn2-event-archive-member-entry* 0 fn2-fields fn2-pool) *fn2-easu-entry*)))
      ((mv mencoded meend fn2-pool) (fn2-layout-encode *fn2-event-archive-member-entry* src sg 0 9 0 1 fn2-fields fn2-pool))
      (same-image (equal (fn2-pool-logical-octets end (fn2-pool-base dst fn2-pool) fn2-pool)
                         (fn2-pool-logical-octets meend (fn2-pool-base src fn2-pool) fn2-pool)))
      ((mv model mend fn2-fields) (fn2-layout-decode *fn2-event-archive-member-entry* dst dg 0 end 9 0 1 fn2-fields fn2-pool))
      ((mv truncated & fn2-fields) (fn2-event-archive-member-entry-decode 0 dst dg 0 (- end 1) 9 0 1 fn2-fields fn2-pool)))
  (mv (and (eq a :ok) (eq b :ok) (eq values :ok) (eq encoded :ok)
           antecedent whole-conclusion (not (eq wrong-owner :ok))
           (eq old-quota :more) (< old-next end)
           (> end 4096) (<= end *fn2-event-archive-member-entry-max-size*) complete zero-unchanged streamed
           (eq mencoded :ok) (equal meend end) same-image (eq model :ok) (equal mend end) (not (eq truncated :ok))) fn2-fields fn2-pool)))
(defun fn2-easu-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (answer fn2-fields)
   (with-local-stobj fn2-pool
    (mv-let (answer fn2-fields fn2-pool) (fn2-easu-body fn2-fields fn2-pool)
     (mv answer fn2-fields))) answer)))
(assert-event (fn2-easu-test))
; This adapter drives the SAME actual build-add/page packing/hash/cursor/NTH,
; not a separate writer/parser. Pool pages are tested; durable IO is not claimed.
(assert-event
 (equal (fn2-run-lookup-image 20 *fn2-event-archive-member-entry* (list *fn2-easu-entry*)
          *fn2-format-page-size* *fn2-easu-entry*) (list :found *fn2-easu-entry*)))

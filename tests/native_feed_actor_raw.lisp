(dolist (initial '(0 3))
  (let ((s (%make-fnn-owner-service :stopping t :exit-code initial)))
    (fnn-owner-fault-service s nil (make-condition 'simple-error))
    (check (eql (fnn-owner-service-exit-code s) (if (zerop initial) 4 3))
           "cleanup fault escalates graceful stop and never masks uncertainty")))
(define-condition feed-unknown-store-subclass (fnn-store-error) ())
(dolist (condition '(fnn-store-error feed-unknown-store-subclass))
  (let* ((s (%make-fnn-owner-service :stopping t :exit-code 0))
         (runtime (%make-fnn-feed-runtime :service s)))
    (setf (symbol-function 'fnn-feed-worker)
          (lambda (runtime) (declare (ignore runtime)) (error condition)))
    (fnn-feed-worker-guarded runtime)
    (check (eql (fnn-owner-service-exit-code s)
                (if (eq condition 'fnn-store-error) 0 4))
           "known stopping refusal scoped; unknown store subclass faults after stop")))

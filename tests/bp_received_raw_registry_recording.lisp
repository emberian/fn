; Recording execution of actual core bodies using mutable stobj/table shims.
; No ACL2 guard/refinement, raw table cut, family/allocator or native claim.
; Budget/demand are explicitly synthetic internal storage-test inputs.
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun booleanp (x) (or (eq x t) (null x)))
(defun posp (x) (and (integerp x) (< 0 x)))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun nfix (x) (if (natp x) x 0))
(defun zp (x) (or (not (integerp x)) (<= x 0)))
(defun len (x) (length x))
(defun true-listp (x) (if (consp x) (true-listp (cdr x)) (null x)))
(defun implies (a b) (or (not a) b))
(defun member-eq (x xs) (member x xs :test #'eq))
(defun member-equal (x xs) (member x xs :test #'equal))
(defun fn-cbor-ag-car (x) (if (consp x) (car x) nil))
(defun fn-cbor-ag-cdr (x) (if (consp x) (cdr x) nil))
(defun fn-cbor-octetp (x) (and (integerp x) (<= 0 x 255)))
(defun update-nth (n v x) (let ((copy (copy-list x))) (setf (nth n copy) v) copy))
(defmacro mbe (&rest options) (getf options :exec))
(defmacro mv (&rest args) `(values ,@args))
(defmacro mv-let (names expr &body body) `(multiple-value-bind ,names ,expr ,@body))
(defmacro stobj-let (bindings outputs expr result)
 `(let ,bindings (multiple-value-bind ,outputs ,expr ,result)))
(defvar *recording-creators* 0)
(defun recording-stobj (form)
 (let* ((name (second form)) (fields (remove-if-not #'consp (cddr form)))
        (creator (intern (format nil "CREATE-~A" name))) (initial nil))
  (loop for field in fields for index from 0 do
   (let* ((reader (first field)) (options (rest field)) (type (getf options :type))
          (value (getf options :initially)) (writer (intern (format nil "UPDATE-~A" reader))))
    (cond
     ((and (consp type) (eq (car type) 'array))
      (push `(setf (gethash ,index object) (make-array ,(car (third type)) :initial-element ',value)) initial)
      (eval `(defun ,(intern (format nil "~AI" reader)) (at object) (aref (gethash ,index object) at)))
      (eval `(defun ,(intern (format nil "UPDATE-~AI" reader)) (at value object)
               (setf (aref (gethash ,index object) at) value) object)))
     ((and (consp type) (eq (car type) 'stobj-table))
      (push `(setf (gethash ,index object) (make-hash-table :test 'eq)) initial)
      (eval `(defun ,reader (object) (gethash ,index object)))
      (eval `(defun ,(intern (format nil "~A-BOUNDP" reader)) (key object)
               (nth-value 1 (gethash key (,reader object)))))
      ; Default thunk is lazy. Successful child installation is represented
      ; in this recording shim; unknown constructor/table cuts are NOT tested.
      (eval `(defmacro ,(intern (format nil "~A-GET" reader)) (key object default)
               `(multiple-value-bind (value present) (gethash ,key (,',reader ,object))
                 (if present value (setf (gethash ,key (,',reader ,object)) ,default))))))
     (t
      (let ((child (and (symbolp type) (intern (format nil "CREATE-~A" type)))))
       (push `(setf (gethash ,index object)
                   ,(if (and child (fboundp child)) `(,child) `',value)) initial))
      (eval `(defun ,reader (object) (gethash ,index object)))
      (eval `(defun ,writer (value object) (setf (gethash ,index object) value) object))))))
  (eval `(defun ,creator () (incf *recording-creators*)
           (let ((object (make-hash-table))) ,@(reverse initial) object)))))
(defvar *actual-definitions* (make-hash-table))
(defvar *actual-constants* nil)
(defun catalog-file (path)
 (with-open-file (stream path)
  (loop for form = (read stream nil :end) until (eq form :end) do
   (case (car form)
    (defun (setf (gethash (second form) *actual-definitions*) form))
    (defconst (push form *actual-constants*))
    (defstobj (recording-stobj form))))))
(dolist (path '("books/cbor.lisp" "books/tcpcl-records.lisp" "books/tcpcl-octets.lisp"
               "books/clock.lisp" "books/tcpcl-session.lisp" "books/tcpcl-received-source.lisp"
               "books/page-read-resources.lisp" "books/page-read-ledger.lisp"
               "books/tcpcl-segment-source-cursor.lisp" "books/bp-received-byte-storage.lisp"
               "books/bp-received-raw-source.lisp" "books/bp-received-raw-registry.lisp"))
 (catalog-file path))
(dolist (form (reverse *actual-constants*))
 (handler-case (eval `(defparameter ,(second form) ,(third form)))
  (error () nil)))
(defvar *loaded-functions* (make-hash-table))
(defun load-actual (name)
 (let ((form (gethash name *actual-definitions*)))
  (when (and form (not (gethash name *loaded-functions*)))
   (setf (gethash name *loaded-functions*) t)
   (labels ((walk (x)
             (when (consp x)
              (unless (eq (car x) 'quote)
               (if (symbolp (car x)) (load-actual (car x)) (walk (car x)))
               (mapc #'walk (cdr x))))))
    (mapc #'walk (cdddr form)))
   (eval form))))
(dolist (name '(fn-bprr-prepare-completion fn-bprr-install-step fn-bprr-action
               fn-bprr-pin-issue fn-tcl-complete-source fn-tcl-make-session
               fn-tcl-make-params fn-tcl-make-negotiated fn-tcl-sessionp
               fn-tcl-make-xfer-segment fn-bprr-receive-step fn-tcl-messagep fn-tcl-result-session fn-tcl-sessionp))
 (load-actual name))
; Complete raw transfer crosses the256-byte allocation boundary. Real source
; count/root come from the actual TCPCL completion function, no flatten.
(let* ((bytes (loop for i below 340 collect (mod i 256)))
       (root nil) (completion nil)
       (params (fn-tcl-make-params 30 512 1024 '(100 116 110 58 97) nil nil))
       (negotiated (fn-tcl-make-negotiated 30 512 1024 nil '(100 116 110 58 98)))
       (session (fn-tcl-make-session :passive :established params nil nil negotiated nil nil 0 0 0 nil))
       (start (fn-tcl-make-xfer-segment 2 7 nil (subseq bytes 0 210)))
       (middle (fn-tcl-make-xfer-segment 0 7 nil nil))
       (end (fn-tcl-make-xfer-segment 1 7 nil (nthcdr 210 bytes)))
       (registry (create-fn-bprx-raw-registry))
       (ledger '((1048576 0 0 8 1000) (0 0 0 0 0) 17 nil))
       (demand '(32768 0 0 1 1)) (ref nil) (pin nil))
 (assert (fn-tcl-sessionp session))
 (dolist (message (list start middle))
  (assert (fn-tcl-messagep message 512))
  (setf session (fn-tcl-result-session (fn-tcl-step-source session message 0)))
  (assert (fn-tcl-sessionp session)))
 (assert (fn-tcl-messagep end 512))
 (multiple-value-bind (word issued result next-registry-ledger next-registry)
     (fn-bprr-receive-step session end 0 '(:recording-tcpcl 1 7) demand ledger registry)
  (setf completion result root (caddr (fn-bprr-completion result)))
  (assert (fn-tcl-sessionp (fn-tcl-result-session result)))
  (assert (equal root (list (nthcdr 210 bytes) nil (subseq bytes 0 210))))
  (assert (equal (fn-tcl-result-events result)
                (list (list :send (fn-tcl-make-xfer-ack 1 7 340))
                      (list :bundle-segments-received 7 root 340))))
  (assert (eq word :source-reserved)) (assert (equal issued '(:bps-ref 17 17)))
  (assert (= (fn-prl-nth 2 next-registry-ledger) 18))
  (setf ref issued ledger next-registry-ledger registry next-registry))
 ; Repeated registration cannot replace the retained source or issue another ID.
 (multiple-value-bind (word ignored next-ledger ignored-registry)
     (fn-bprr-prepare-completion completion :foreign demand ledger registry)
  (declare (ignore ignored ignored-registry))
  (assert (eq word :source-busy)) (assert (equal ledger next-ledger)))
 (loop repeat 100 until (null (fn-bprr-intent registry)) do
  (multiple-value-bind (word left next) (fn-bprr-install-step 64 registry)
   (declare (ignore left)) (assert (member word '(:source-directory-created :source-retained)))
   (setf registry next)))
 (assert (null (fn-bprr-intent registry)))
 ; Populate is one source-cursor/byte action; constructor calls are separate.
 (let ((published nil))
  (loop repeat 2000 until published do
   (multiple-value-bind (word ignored left next)
       (fn-bprr-action ref :populate nil nil 0 0 64 registry)
    (declare (ignore ignored left)) (setf registry next)
    (cond ((eq word :source-needs-leaf)
           (multiple-value-bind (created ignored left next)
               (fn-bprr-action ref :construct nil nil 0 0 64 registry)
            (declare (ignore ignored left))
            (assert (member created '(:source-directory-created :source-filling :source-leaf-present)))
            (setf registry next)))
          ((eq word :source-published) (setf published t))
          (t (assert (member word '(:yield :source-byte-pending :source-byte)))))))
  (assert published))
 (multiple-value-bind (word issued next-ledger left next)
     (fn-bprr-pin-issue ref '(4096 0 0 0 1) ledger 64 registry)
  (declare (ignore left)) (assert (eq word :source-pinned))
  (assert (equal issued '(:bps-source-pin 18 17 17)))
  (assert (= (fn-prl-nth 2 next-ledger) 19))
  (setf pin issued ledger next-ledger registry next))
 ; Successful copy crosses leaf255/256, and contains exact actual array bytes.
 (let ((before *recording-creators*))
  (multiple-value-bind (word copy left next)
      (fn-bprr-action ref :copy pin nil 240 64 256 registry)
   (declare (ignore left next)) (assert (eq word :source-window))
   (assert (equal copy (subseq bytes 240 304))))
  (assert (= before *recording-creators*)))
 (dolist (case (list (list '(:bps-ref 17 16) pin 0 1 :stale-source)
                    (list ref '(:bps-source-pin 19 17 17) 0 1 :stale-source-pin)
                    (list ref pin 330 11 :source-range)))
  (let ((before *recording-creators*))
   (multiple-value-bind (word copy left next)
       (fn-bprr-action (first case) :copy (second case) nil (third case) (fourth case) 256 registry)
    (declare (ignore left next)) (assert (eq word (fifth case))) (assert (null copy)))
   (assert (= before *recording-creators*))))
 ; Cancel/fence retains source and pin claims. No release or old-ref adoption.
 (let ((saved-ledger (copy-tree ledger)))
  (fn-bprr-action ref :fence nil nil 0 0 64 registry)
  (multiple-value-bind (word copy left next)
      (fn-bprr-action ref :copy pin nil 0 1 64 registry)
   (declare (ignore left next)) (assert (eq word :source-unpublished)) (assert (null copy)))
  (assert (equal saved-ledger ledger))))
(format t "PASS actual raw completion/SAMEPRS registration/populate/freeze/pin/cross-leaf copy/fence bodies (recording only).~%")
; Actual registered controller: native-facing receive never supplies a session.
; Synthetic PRS/factory scope remains explicit; no runtime installer involved.
(dolist (name '(fn-bprr-controller-reserve fn-bprr-controller-install
               fn-bprr-controller-action fn-bprr-registered-receive
               fn-tcl-make-contact fn-tcl-make-sess-init)) (load-actual name))
(let* ((registry (create-fn-bprx-raw-registry))
       (ledger '((1048576 0 0 8 1000) (0 0 0 0 0) 41 nil))
       (demand '(32768 0 0 1 1))
       (params (fn-tcl-make-params 30 512 1024 '(100 116 110 58 97) nil nil))
       (controller nil) (ref nil))
 (multiple-value-bind (word token next-ledger next)
     (fn-bprr-controller-reserve :passive params 0 demand ledger registry)
  (assert (eq word :tcpcl-reserved)) (assert (equal token '(:bps-tcpcl-ref 41 41)))
  (setf controller token ledger next-ledger registry next))
 (loop repeat 64 until (null (fn-bprr-intent registry)) do
  (multiple-value-bind (word left next) (fn-bprr-controller-install 64 registry)
   (declare (ignore left))
   (assert (member word '(:source-directory-created :tcpcl-registered))) (setf registry next)))
 (assert (null (fn-bprr-intent registry)))
 (dolist (message (list (fn-tcl-make-contact 4 0)
                       (fn-tcl-make-sess-init 30 512 1024 '(100 116 110 58 98) nil)
                       (fn-tcl-make-xfer-segment 2 9 nil '(1 2))
                       (fn-tcl-make-xfer-segment 1 9 nil '(3 4))))
  (multiple-value-bind (word token events next-ledger left next)
      (fn-bprr-registered-receive controller message 0 demand ledger 64 registry)
   (declare (ignore left))
   (assert (member word '(:no-source-completion :source-reserved)))
   (when token
    (setf ref token)
    (assert (equal token '(:bps-ref 42 42)))
    (assert (equal events (list (list :send (fn-tcl-make-xfer-ack 1 9 4))
                               (list :source-registered token)))))
   (setf ledger next-ledger registry next)))
 (assert ref) (assert (= (fn-prl-nth 2 ledger) 43))
 (assert (equal (fn-bprr-at 4 (fn-bprr-intent registry)) '((3 4) (1 2)))))
(format t "PASS registered controller handshake/receive retains raw root and exports only issued ref plus held protocol events (recording only).~%")
; Actual END reserve refusal must not release ACK or discard completed source.
(let* ((registry (create-fn-bprx-raw-registry))
       (ledger '((1048576 0 0 8 1000) (0 0 0 0 0) 51 nil))
       (params (fn-tcl-make-params 30 512 1024 '(100 116 110 58 97) nil nil))
       (controller nil))
 (multiple-value-bind (word token next-ledger next)
     (fn-bprr-controller-reserve :passive params 0 '(32768 0 0 1 1) ledger registry)
  (assert (eq word :tcpcl-reserved)) (setf controller token ledger next-ledger registry next))
 (loop repeat 64 until (null (fn-bprr-intent registry)) do (fn-bprr-controller-install 64 registry))
 (dolist (message (list (fn-tcl-make-contact 4 0)
                       (fn-tcl-make-sess-init 30 512 1024 '(100 116 110 58 98) nil)
                       (fn-tcl-make-xfer-segment 2 9 nil '(1 2))))
  (fn-bprr-registered-receive controller message 0 '(32768 0 0 1 1) ledger 64 registry))
 (multiple-value-bind (word ref events next-ledger left next)
     (fn-bprr-registered-receive controller (fn-tcl-make-xfer-segment 1 9 nil '(3 4))
                                0 '(0 0 0 0 0) ledger 64 registry)
  (declare (ignore left next)) (assert (eq word :invalid-source-demand))
  (assert (null ref)) (assert (null events)) (assert (equal ledger next-ledger)))
 ; Inspect only the recording storage shim, never a production snapshot API.
 (let ((node (fn-bprr-controllers registry)) (address 51))
  (loop while (plusp address) do
   (setf node (gethash (if (evenp address) 'fn-bprx-byte-left 'fn-bprx-byte-right)
                      (fn-bprxb-children node)) address (floor address 2)))
  (let ((actual (gethash 'fn-bprx-tcpcl-controller (fn-bprxb-children node))))
   (assert (eq (fn-bprtc-phase actual) :fenced))
   (assert (equal (caddr (fn-bprr-completion (fn-bprtc-pending actual))) '((3 4) (1 2)))))))
(format t "PASS refused END reservation retains exact completion/ACK in fenced controller without emitting it (recording only).~%")

(in-package "ACL2")
(include-book "storage-write-pins-unit")

; Physical stride, journal charge, and payload packing are separate facts.
(assert-event
 (and (= *fn2-storage-extent-units* 16) (= *fn2-storage-extent-bytes* 65536)
      (= *fn2-commit-write-resources* 3)
      (= (* *fn2-commit-write-resources* *fn2-commit-unit-bytes*) 12288)
      (= *fn2-upload-payload-units* 3) (= *fn2-upload-payload-bytes* 12288)
      (not (fn2-am-manifestp 12288)) (fn2-am-manifestp 12289)))

(defun fn2-storage-geometry-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (put-assoc-equal :pool-classes
                 '((8 . 64) (4 . 256) (8 . 4096) (2 . 65536)) *fn2-profile-tiny*))
      (fn2-core (fn2-core-init profile fn2-core))
      ((mv ready extent epoch allocation fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)))
        (ready extent epoch allocation fn2-extents)
        (b* (((mv begin fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
             ((mv first & first-extent & & fn2-extents) (fn2-alloc-reserve fn2-extents))
             ((mv second & extent epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents)))
         (mv (and (eq begin :ok) (eq first :ok) (= first-extent 0)
                  (eq second :ok) (= extent 1)) extent epoch allocation fn2-extents))
        (mv ready extent epoch allocation fn2-core)))
      ((unless ready) (mv nil fn2-core))
      ((mv pool slot gen fn2-core) (fn2-core-reserve 3 1 0 1 fn2-core))
      ((unless (eq pool :ok)) (mv nil fn2-core))
      ; Actual source offset in an owned64KiB buffer, not a copied4KiB twin.
      (boff (- *fn2-storage-extent-bytes* *fn2-commit-unit-bytes*))
      ((mv filled fn2-core) (fn2-write-pin-test-fill 4096 boff slot gen fn2-core))
      ((unless (eq filled :ok)) (mv nil fn2-core))
      (pu (+ (* extent *fn2-storage-extent-units*) 15))
      ((mv stale & & fn2-core)
       (fn2-block-write pu epoch (+ 1 allocation) 0 4096 slot gen boff 1 0 1 0 fn2-core))
      ((mv adjacent & & fn2-core)
       (fn2-block-write (+ 1 pu) epoch allocation 0 4096 slot gen boff 1 0 1 0 fn2-core))
      ((unless (and (eq stale :stale) (eq adjacent :stale) (null (fn2-b-outbox fn2-core))))
       (mv nil fn2-core))
      ((mv issued op og fn2-core)
       (fn2-block-write pu epoch allocation 0 4096 slot gen boff 1 0 1 0 fn2-core))
      ((unless (eq issued :ok)) (mv nil fn2-core))
      (exact (stobj-let ((fn2-ops (fn2-core-ops fn2-core))
                         (fn2-extents (fn2-core-extents fn2-core))
                         (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (exact)
               (and (= (fn2-ops-storage-offset op fn2-ops) 126976)
                    (= (fn2-ops-range-off op fn2-ops) boff) (= (fn2-ops-range-len op fn2-ops) 4096)
                    (fn2-alloc-edge-matchesp (fn2-b-read-pin-edge op fn2-extents) og
                      extent epoch allocation :outstanding-io fn2-alloc-edges)) exact))
      ((mv write-ack fn2-core) (fn2-read-pin-test-ack fn2-core))
      ((mv read-pool read-slot read-gen fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
      ((unless (eq read-pool :ok)) (mv nil fn2-core))
      ((mv read-code read-op read-og fn2-core)
       (fn2-block-read pu epoch allocation 17 1 read-slot read-gen 1 0 1 0 fn2-core))
      ((unless (eq read-code :ok)) (mv nil fn2-core))
      (read-exact (stobj-let ((fn2-ops (fn2-core-ops fn2-core))
                              (fn2-extents (fn2-core-extents fn2-core))
                              (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (exact)
                    (and (= (fn2-ops-storage-offset read-op fn2-ops) 126993)
                         (fn2-alloc-edge-matchesp (fn2-b-read-pin-edge read-op fn2-extents) read-og
                           extent epoch allocation :outstanding-io fn2-alloc-edges)) exact))
      ((mv read-ack fn2-core) (fn2-read-pin-test-ack fn2-core))
      ((mv blocked invariant fn2-core) (fn2-write-pin-test-cancel extent epoch allocation fn2-core))
      (fn2-core (fn2-write-pin-test-post op og fn2-core))
      ((mv delivered & & & & & & & & & fn2-core) (fn2-harvest-one fn2-core))
      ((mv read-still-blocks middle-invariant fn2-core)
       (fn2-write-pin-test-cancel extent epoch allocation fn2-core))
      (fn2-core (fn2-read-pin-test-post read-op read-og fn2-core))
      ((mv read-delivered & & & & & & & & & fn2-core) (fn2-harvest-one fn2-core))
      ((mv released final-invariant fn2-core) (fn2-write-pin-test-cancel extent epoch allocation fn2-core)))
  (mv (and exact read-exact (= pu 31) (eq write-ack :ok) (eq read-ack :ok)
           invariant middle-invariant final-invariant (eq blocked :outstanding-io)
           (eq read-still-blocks :outstanding-io) delivered read-delivered
           (eq released :ok) (not (fn2-core-stopped-p fn2-core))) fn2-core)))
(defun fn2-storage-geometry-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core) (fn2-storage-geometry-body fn2-core) answer)))
(assert-event (fn2-storage-geometry-test))

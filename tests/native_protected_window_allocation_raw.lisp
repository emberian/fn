;;; Actual guarded protected-window reader/digest/private-buffer composition.
;;; Faithful local archive slices replace physical pread only in this fixture.
;;; Reuse fixed private contexts; no new world or certification is required.
(in-package "ACL2")

(defun fndw-drain (archive commitment digest input window)
  (let* ((begin (fnda-function 'fn-ews-begin))
         (effect (fnda-function 'fn-ews-effect))
         (tick (fnda-function 'fn-ews-tick))
         (read (fnda-function 'fn-ews-read))
         (publication (fnda-function 'fn-ewp-publication))
         (get-byte (fnda-function 'fn-ew-bytesi))
         (plan nil) (reads 0) (steps 0))
    (multiple-value-setq (plan digest)
      (funcall begin 7 100 128 164 64 3 23 47 59 commitment digest))
    (loop while (member (car plan) '(:scan :trailer)) do
      (assert (< steps 256)) ; diagnostic runaway guard, no production ceiling
      (incf steps)
      (let ((issued (funcall effect plan digest)))
        (if issued
            (let* ((start (- (fifth issued) 100))
                   (bytes (subseq archive start (+ start (sixth issued)))))
              ;; No independent bounds/coordinate policy; the real core alone
              ;; chooses both the requested slice and its completion identity.
              (setf input (fn-octets-from-list bytes input))
              (incf reads (length bytes))
              (multiple-value-bind (word next next-digest next-window)
                  (funcall read issued :ok plan input digest window)
                (assert (member word '(:continue :verified :digest :commitment)))
                (setf plan next digest next-digest window next-window)))
          (multiple-value-bind (word next next-digest) (funcall tick plan digest)
            (assert (eq word :continue))
            (setf plan next digest next-digest)))))
    (values (list (car plan) (funcall publication plan) reads steps
                  (loop for i below (nth 5 plan) collect (funcall get-byte i window)))
            digest input window)))

(defun fndw-run ()
  (let* ((msg (loop for i below 128 collect i))
         (trailer (funcall (fnda-function 'fn-blake3) msg))
         (commitment (funcall (fnda-function 'fn-bch-pack) trailer))
         (archive (append msg trailer))
         (digest (create-pgs-digest-state)) (input (create-fn-octets))
         (window (create-fn-ew-buffer)) (expected nil)
         (*fnn-trace-state* nil) (*fnn-trace-parent* nil)
         (*fnn-trace-parent-state* nil)
         (*fnn-trace-operation* nil) (*fnn-trace-connection-generation* nil))
    (multiple-value-setq (expected digest input window)
      (fndw-drain archive commitment digest input window))
    (assert (equal (subseq expected 0 3) '(:verified (23 47 59 7 167 61) 160)))
    (assert (equal (fifth expected) (subseq msg 67)))
    (fnda-with-capture-route (t)
      (multiple-value-bind (answer next-digest next-input next-window)
          (fndw-drain archive commitment digest input window)
        (assert (equal answer expected))
        (setf digest next-digest input next-input window next-window)))
    ;; Corrupt a protected byte outside the requested window. A coincidentally
    ;; unchanged selected result must still be refused by whole-prefix hashing.
    (let ((bad (copy-list archive)))
      (setf (car bad) 255)
      (fnda-with-capture-route (t)
        (multiple-value-bind (answer h i w) (fndw-drain bad commitment digest input window)
          (assert (eq (first answer) :digest))
          (assert (null (second answer)))
          (assert (equal (fifth answer) (fifth expected)))
          (setf digest h input i window w))))
    (fnda-with-capture-route (t)
      (multiple-value-bind (answer h i w) (fndw-drain archive (1+ commitment) digest input window)
        (assert (eq (first answer) :commitment))
        (assert (null (second answer)))
        (setf digest h input i window w)))
    (fnn-trace-start :capacity 2 :allocation :process)
    (dolist (route '(:legacy-protected-window :shared-protected-window))
      (fnda-with-capture-route ((eq route :shared-protected-window))
        (dotimes (warm 4)
          (multiple-value-bind (answer h i w) (fndw-drain archive commitment digest input window)
            (assert (equal answer expected)) (setf digest h input i window w)))
        (sb-ext:gc :full t)
        (fnn-trace-span (route :operation 1)
          (dotimes (replay 32)
            (multiple-value-bind (answer h i w) (fndw-drain archive commitment digest input window)
              (assert (equal answer expected)) (setf digest h input i window w))))))
    (fnn-trace-report *standard-output*)
    (format t "NATIVE_PROTECTED_WINDOW_PASS protected=128 read=160 selected=61 replays=32 steps=~d corrupt-prefix=refused wrong-commitment=refused scope=process-inclusive~%"
            (fourth expected))
    :passed))

; Prepared source controls for actual recovery entry boundaries. These are not
; a positive cold-storage or physical-verification witness; execution is pending.
(in-package "ACL2")
(include-book "../books/assembly")
(defun fn2-cre-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      (id (fn2-machine-kind-base *fn2-boot-kind* fn2-core))
      (gen (fn2-machine-generation id fn2-core))
      ((mv phase fn2-core) (fn2-boot-checkpoint-evidence-begin id gen fn2-core))
      ((mv target fn2-core) (fn2-boot-checkpoint-evidence-target id gen fn2-core))
      ((mv sector & fn2-core) (fn2-boot-checkpoint-evidence-sector 0 id gen fn2-core))
      ((mv check fn2-core) (fn2-boot-checkpoint-evidence-check id gen fn2-core))
      ((mv record fn2-core) (fn2-boot-checkpoint-evidence-record id gen fn2-core))
      ((mv next fn2-core) (fn2-boot-checkpoint-evidence-next id gen fn2-core))
      (no-authority (stobj-let ((fn2-checkpoint-recovery-evidence (fn2-core-checkpoint-recovery-evidence fn2-core))) (none)
        (and (not (fn2-checkpoint-recovery-evidence-ready-p 0 fn2-checkpoint-recovery-evidence))
             (not (fn2-checkpoint-recovery-evidence-ready-p 1 fn2-checkpoint-recovery-evidence))
             (not (fn2-checkpoint-recovery-evidence-ready-p 2 fn2-checkpoint-recovery-evidence))
             (not (fn2-checkpoint-recovery-evidence-ready-p 3 fn2-checkpoint-recovery-evidence))) none)))
  (mv (and (eq phase :state) (eq target :state) (eq sector :state)
           (eq check :state) (eq record :state) (eq next :state) no-authority) fn2-core)))
(defun fn2-cre-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-cre-body fn2-core) ok)))
(assert-event (fn2-cre-run))

; Execute emitted programs after admitting their real nested-stobj scopes.
; The fixture boundary changes one native scheduler cell; the replacement
; appends its semantic argument to FIFO and preserves that native cell.
; Actual callback/R correspondence remains a separate application obligation.
(in-package "ACL2")
(include-book "reference-effect-lowering-unit")

(defun fn2-effect-emitted-init (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-sched (fn2-core-sched fn2-core))
             (fn2-effect-extra (fn2-core-extra fn2-core))
             (fn2-effect-other (fn2-core-other fn2-core)))
  (fn2-sched fn2-effect-extra fn2-effect-other)
  (let* ((fn2-sched (fn2-sched-init 1 fn2-sched))
         (fn2-effect-extra (fn2-effect-extra-init 1 fn2-effect-extra))
         (fn2-effect-other (fn2-effect-other-init 1 fn2-effect-other))
         (fn2-effect-extra (fn2-effect-extra-set-value 0 9 fn2-effect-extra))
         (fn2-effect-other (fn2-effect-other-set-value 0 33 fn2-effect-other)))
   (mv fn2-sched fn2-effect-extra fn2-effect-other)) fn2-core))
(defun fn2-effect-emitted-view (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-sched (fn2-core-sched fn2-core))
             (fn2-effect-extra (fn2-core-extra fn2-core))
             (fn2-effect-other (fn2-core-other fn2-core))) (view)
  (list (fn2-sched-link 0 fn2-sched)
        (fn2-effect-extra-value 0 fn2-effect-extra)
        (fn2-effect-other-value 0 fn2-effect-other)) view))

; Pack only scalar results. The original core carrier remains at its real
; ABI position in each call, and is returned separately by this harness.
(defun fn2-effect-emitted-actual (kind x fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (case kind
  (:mutable (mv-let (a b c fn2-core) (fn2-effect-test-mv x fn2-core)
              (mv (list a b c) fn2-core)))
  (:readonly (mv-let (a fn2-core) (fn2-effect-test-read x fn2-core)
               (mv (list a) fn2-core)))
  (otherwise (mv-let (a fn2-core) (fn2-effect-test-two x fn2-core)
               (mv (list a) fn2-core)))))
(defun fn2-effect-emitted-reference (kind x fn2-core fifo)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (case kind
  (:mutable (mv-let (a b c fn2-core fifo) (fn2-effect-test-mv-ref-effect x fn2-core fifo)
              (mv (list a b c) fn2-core fifo)))
  (:readonly (mv-let (a fn2-core fifo) (fn2-effect-test-read-ref-effect x fn2-core fifo)
               (mv (list a) fn2-core fifo)))
  (otherwise (mv-let (a fn2-core fifo) (fn2-effect-test-two-ref-effect x fn2-core fifo)
               (mv (list a) fn2-core fifo)))))

(defun fn2-effect-emitted-run (kind x fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-effect-emitted-init fn2-core))
      ((mv outputs fn2-core) (fn2-effect-emitted-actual kind x fn2-core))
      (actual-view (fn2-effect-emitted-view fn2-core))
      (fn2-core (fn2-effect-emitted-init fn2-core))
      ((mv routputs fn2-core fifo) (fn2-effect-emitted-reference kind x fn2-core '(10)))
      (reference-view (fn2-effect-emitted-view fn2-core))
      (effect-id (case kind (:mutable (if (equal x 0) 7 x))
                           (:readonly (+ x 9)) (otherwise x)))
      (extra (if (eq kind :readonly) 9 x))
      (other (if (eq kind :parallel) x 33))
      (expected-outputs (if (eq kind :mutable) (list x 17 29)
                          (list (if (eq kind :readonly) 9 x)))))
  (mv (and (equal outputs expected-outputs) (equal routputs expected-outputs)
           (equal actual-view (list effect-id extra other))
           (equal reference-view (list 0 extra other))
           (equal fifo (list 10 effect-id))
           ; Carrier omission and scalar truncation retain the other
           ; observed results, but cannot satisfy the complete oracle.
           (not (equal '(10) fifo))
           (if (eq kind :mutable) (not (equal (take 2 outputs) routputs)) t)) fn2-core)))
(defun fn2-effect-emitted-control (kind x)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (yes fn2-core) (fn2-effect-emitted-run kind x fn2-core) yes)))
(assert-event (and (fn2-effect-emitted-control :mutable 0)
                   (fn2-effect-emitted-control :mutable 5)
                   (fn2-effect-emitted-control :readonly 5)
                   (fn2-effect-emitted-control :parallel 7)))

; Standalone source wrapper control, not an actual ACL2/rolling execution.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defvar *calls* 0)
(defvar *change* t)
(defvar *extra* (list :same-object))
(defun fn2-upload-stream-reset (id gen core)
 (declare (ignore id gen)) (incf *calls*)
 (when *change* (incf (aref core 0)))
 (values :ok core *extra* nil))
(defun fn2-upload-snapshot-read-code (id core) (declare (ignore id core)) :ok)
(defun fn2-machine-generation (id core) (declare (ignore id core)) 9)
(defun fn2-upload-row-conn (id core) (declare (ignore id core)) 17)
(defun fn2-upload-row-conn-gen (id core) (declare (ignore id core)) 3)
(defun fn2-upload-row-request (id core) (declare (ignore id core)) 81)
(defun fn2-upload-row-op (id core) (declare (ignore id core)) 91)
(defun fn2-upload-row-stream-resets (id core) (declare (ignore id)) (aref core 0))
(load "tests/native-upload-reset-capture.lsp")
(let ((core (vector 4)))
 (dolist (change '(t nil))
  (let* ((*change* change) (before *calls*)
         (result (multiple-value-list (fn2-upload-stream-reset 2 9 core))))
   (assert (= *calls* (+ 1 before)))
   (assert (equal (first result) :ok)) (assert (eq (second result) core))
   (assert (eq (third result) *extra*)) (assert (equal (length result) 4))
   (assert (null (fourth result))) (assert (= (aref core 0) 5)))))
(format t "RESET CAPTURE SOURCE CONTROL PASS: exactly-once, all values/object identities, no-op unchanged~%")

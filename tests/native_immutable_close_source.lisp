(load "tests/native_rotation_cleanup_source.lisp")
(in-package "ACL2")
(defun true-listp (x) (if (consp x) (true-listp (cdr x)) (null x)))
(defun len (x) (length x))
(defun booleanp (x) (member x '(t nil)))
(defun member-equal (x xs) (member x xs :test #'equal))
(with-open-file (in "books/journal-publish.lisp")
  (loop for f = (read in nil :eof) until (eq f :eof) do
    (when (and (consp f) (eq (car f) 'defun))
      (eval `(defun ,(second f) ,(third f)
               ,@(remove-if (lambda (x) (and (consp x) (eq (car x) 'declare))) (cdddr f)))))))
(with-open-file (in "host/journal-publish-host.lisp")
  (loop for f = (read in nil :eof) until (eq f :eof) do
    (when (and (consp f) (eq (car f) 'defun)
               (search "FN-JPUB-HOST-" (symbol-name (second f)))) (eval f))))
(defvar *publication-failure* nil)
(defvar *publication-calls* nil)
(defvar *published* nil)
(defvar *physical* (make-condition 'fnn-os-error))
(defvar *body-primary* (make-condition 'simple-error :format-control "body escape"))
(defun fnn-core (name &rest args) (apply name args))
(defun fnn-immutable-test-fault (&rest args) (declare (ignore args)))
(defun fnn-open (&rest args) (declare (ignore args)) 55)
(defun fnn-write-all (&rest args)
  (declare (ignore args))
  (when (member *publication-failure* '(:write :write-close)) (error *physical*))
  (when (eq *publication-failure* :body-close) (error *body-primary*)))
(defun fnn-fsync-file (&rest args)
  (declare (ignore args)) (when (eq *publication-failure* :fsync-close) (error *physical*)))
(defun fnn-close (fd)
  (push (list :close fd) *publication-calls*)
  (when (member *publication-failure* '(:close :write-close :fsync-close :body-close)) (error *physical*)))
(defun fnn-link (&rest args) (declare (ignore args)) (setq *published* t))
(defun fnn-fsync-dir (&rest args)
  (declare (ignore args)) (when (eq *publication-failure* :cleanup) (error *physical*)))
(defun fnn-unlink (&rest args) (declare (ignore args)) (push :unlink *publication-calls*))
(with-open-file (in "host/native/io.lisp")
  (loop for f = (read in nil :eof) until (eq f :eof) do
    (when (and (consp f) (member (car f) '(defun defvar))
               (member (second f) '(*fnn-immutable-close-debts* fnn-immutable-close-observation
                 fnn-immutable-close-handle fnn-write-staged fnn-write-staged-at))) (eval f))))
(with-open-file (in "host/native/immutable-publish.lisp")
  (loop for f = (read in nil :eof) until (eq f :eof) do
    (when (and (consp f)
               (or (eq (car f) 'defvar)
                   (and (eq (car f) 'defun) (not (eq (second f) 'fnn-immutable-test-fault)))))
      (eval f))))
(dolist (fault '(:close :write-close :fsync-close :body-close :write nil))
  (let ((*fnn-immutable-close-debts* nil) (*publication-failure* fault)
        (*published* nil) (*publication-calls* nil) (caught nil) (outcome nil))
    (handler-case
        (setq outcome (fnn-immutable-publish-effect (fn-jpub-initial t) "/stage" "/final" "/root" #(1)
                                                     :operation-label :receipt))
      (error (e) (setq caught e)))
    (assert (= 1 (count '(:close 55) *publication-calls* :test #'equal)))
    (cond ((member fault '(:close :write-close :fsync-close :body-close))
           (assert caught)
           (if (eq fault :body-close) (assert (eq caught *body-primary*))
             (assert (typep caught 'fnn-store-indeterminate)))
           (assert (null *published*))
           (assert (eq (fnn-immutable-close-observation) :uncertain))
           (let ((debt (car *fnn-immutable-close-debts*)))
             (assert (equalp (subseq debt 0 4) #(55 "/stage" "/final" :receipt))))
           (let ((before (copy-list *publication-calls*)))
             (handler-case (fnn-immutable-publish-effect (fn-jpub-initial t) "/other" "/other-final" "/root" #(2))
               (fnn-store-indeterminate () nil))
             (assert (equal before *publication-calls*)))
           (let ((store (%make-fnn-store)))
             (handler-case (fnn-store-close store) (fnn-store-indeterminate () nil))
             (assert (fnn-store-close-debt store))))
          ((eq fault :write) (assert (eq outcome :refused)) (assert (null caught)))
          (t (assert (eq outcome :durable)) (assert *published*) (assert (null caught))))))
;; Namespace cleanup remains post-authority and cannot downgrade acceptance.
(let ((*fnn-immutable-close-debts* nil) (*publication-failure* nil))
  (assert (eq (fnn-immutable-publish-effect (fn-jpub-initial t) "/stage" "/final" "/root" #(1)
    :cleanup-directory "/root" :observer (lambda (point state)
       (declare (ignore state)) (when (eq point :directory-barrier) (setq *publication-failure* :cleanup)))) :durable)))
(format t "native immutable exact close custody source PASS~%")
;; Compose the neighbor's actual root-bearing publication-lock observation.
;; In the isolated lane supply its exact source path; integrated tree defaults.
(let ((path (or (sb-ext:posix-getenv "FN_PUBLICATION_SOURCE") "host/native/io.lisp")))
  (with-open-file (in path)
    (loop for f = (read in nil :eof) until (eq f :eof) do
      (when (and (consp f) (member (car f) '(defvar defun))
                 (member (second f) '(*fnn-publication-close-debts* fnn-publication-close-observation)))
        (eval f)))))
(assert (fboundp 'fnn-publication-close-observation))
(let ((*fnn-publication-close-debts* (list (list 91 "/root" *physical*)))
      (*fnn-immutable-close-debts* nil) (store (%make-fnn-store)))
  (handler-case (fnn-store-close store) (fnn-store-indeterminate () nil))
  (assert (fnn-store-fenced store))
  (assert (fnn-store-close-debt store))
  (assert (= (caar *fnn-publication-close-debts*) 91)))
(format t "native publication neighbor Store gate source PASS~%")

(defun fnn-at (&rest args) (declare (ignore args)))
(dolist (command '(fnn-write-staged fnn-write-staged-at))
  (dolist (fault '(:close :write-close :body-close nil))
    (let ((*fnn-immutable-close-debts* nil) (*publication-failure* fault)
          (*publication-calls* nil) (store (%make-fnn-store)) (caught nil))
      (handler-case
          (if (eq command 'fnn-write-staged)
              (fnn-write-staged "/stage" #(1))
            (fnn-write-staged-at store "/stage" #(1) :created :written :unlink-on-failure t))
        (error (condition) (setq caught condition)))
      (assert (= 1 (count '(:close 55) *publication-calls* :test #'equal)))
      (if fault (assert caught) (assert (null caught)))
      (when (eq fault :body-close) (assert (eq caught *body-primary*)))
      (when fault (assert (eq (fnn-immutable-close-observation) :uncertain)))
      (when (and (eq command 'fnn-write-staged-at) (member fault '(:write-close :body-close)))
        (assert (member :unlink *publication-calls*)))
      (when (and fault (eq command 'fnn-write-staged-at)) (assert (fnn-store-fenced store))))))
(format t "native shared staging close custody source PASS~%")

(in-package "ACL2")
(include-book "../sim/envelope-output-dp-loop")
(defun fn2-eo-dp-witness (segments peer corrupt-base)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-envelope-output-state
  (mv-let (ok fn2-envelope-output-state)
   (let* ((fn2-envelope-output-state (update-fn2-eo-phase 4 fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-peer peer fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-scan peer fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-segments segments fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-row (if corrupt-base nil '(t)) fn2-envelope-output-state))
          (antecedent
           (and (equal (fn2-eo-phase fn2-envelope-output-state) 4)
                (equal (fn2-eo-scan fn2-envelope-output-state) (fn2-eo-peer fn2-envelope-output-state))
                (equal (fn2-eo-row fn2-envelope-output-state) '(t))
                (fn2-eo-octets-p (fn2-eo-peer fn2-envelope-output-state))
                (fn2-eo-segments-p (fn2-eo-segments fn2-envelope-output-state))))
          (size (fn2-envelope-output-source-size segments))
          (fuel (+ (+ 1 (len peer))
                   (+ 1 (* 3 (len segments)) size (* size (+ 4 (len peer) (len peer))))))
          (expected (fn2-envelope-output-language-p (revappend segments nil) peer))
          (fn2-envelope-output-state (fn2-envelope-output-run fuel fn2-envelope-output-state)))
    (mv (and (equal (fn2-eo-phase fn2-envelope-output-state) 10)
             (equal (fn2-eo-segments fn2-envelope-output-state) nil)
             (equal (fn2-eo-peer fn2-envelope-output-state) peer)
             (if corrupt-base
                 (and (not antecedent) (not (equal (fn2-eo-result fn2-envelope-output-state) expected)))
               (and antecedent (equal (fn2-eo-result fn2-envelope-output-state) expected))))
        fn2-envelope-output-state)) ok)))
(assert-event
 (and (fn2-eo-dp-witness '((:exact 2) (:prefix 1)) '(2) nil)
      (fn2-eo-dp-witness '((:exact 2) (:prefix 1)) '(1 2) nil)
      (fn2-eo-dp-witness '((:exact 2) (:prefix 1)) '(3) nil)
      (fn2-eo-dp-witness '((:exact 1) (:prefix 1)) '(1) nil)
      (fn2-eo-dp-witness '((:prefix 1 2) (:prefix)) nil nil)
      (fn2-eo-dp-witness nil nil nil)
      (fn2-eo-dp-witness nil '(1) nil)))
(assert-event (fn2-eo-dp-witness '((:prefix 1)) nil t))

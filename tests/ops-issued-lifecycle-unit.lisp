; Real reserve/enqueue/ack/finish, including retirement and repeated finish.
(in-package "ACL2")
(include-book "../books/ops-issued-lifecycle")

(defun fn2-issued-lifecycle-run (retirep fn2-ops)
 (declare (xargs :stobjs fn2-ops :verify-guards nil))
 (b* ((profile (if retirep
                 (put-assoc-equal :generation-limit
                   (fn2-profile-generation-start *fn2-profile-tiny*) *fn2-profile-tiny*)
                 *fn2-profile-tiny*))
      (fn2-ops (fn2-ops-init profile fn2-ops))
      (before (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops))
      ((mv reserve slot gen fn2-ops) (fn2-op-reserve *fn2-action-arm-wake* 0 0 0 0 0 fn2-ops))
      ((mv enqueue fn2-ops) (fn2-op-enqueue slot gen fn2-ops))
      ((mv ack fn2-ops) (fn2-outbox-ack 1 fn2-ops))
      (issued (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops))
      (hyps (and (fn2-profilep profile) (eq reserve :ok) (eq enqueue :ok) (eq ack :ok)
                 (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops) (fn2-ops-semanticp fn2-ops)
                 (equal (fn2-ops-phase slot fn2-ops) *fn2-op-phase-done*)
                 (equal issued (+ 1 before))))
      ((mv finish fn2-ops) (fn2-op-finish slot gen fn2-ops))
      (after (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops))
      (finished (and (eq finish (if retirep :retired :ok)) (equal after issued)
                     (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops) (fn2-ops-semanticp fn2-ops)))
      ((mv repeated fn2-ops) (fn2-op-finish slot gen fn2-ops))
      (stable (and (not (member-eq repeated '(:ok :retired)))
                   (equal after (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops))))
      ((mv reserve2 slot2 gen2 fn2-ops) (fn2-op-reserve *fn2-action-arm-wake* 0 0 0 0 0 fn2-ops))
      ((mv enqueue2 fn2-ops) (fn2-op-enqueue slot2 gen2 fn2-ops)))
  (mv (and hyps finished stable (eq reserve2 :ok) (eq enqueue2 :ok)
            (if retirep (not (equal slot2 slot)) (and (equal slot2 slot) (equal gen2 (+ 1 gen))))
            (equal (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops) (+ 2 before))
            (fn2-ops-semanticp fn2-ops)) fn2-ops)))
(defun fn2-issued-lifecycle (retirep)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-ops (mv-let (answer fn2-ops) (fn2-issued-lifecycle-run retirep fn2-ops) answer)))
(assert-event (fn2-issued-lifecycle nil))
(assert-event (fn2-issued-lifecycle t))
(defun fn2-issued-ack-duplicate-run (fn2-ops)
 (declare (xargs :stobjs fn2-ops :verify-guards nil))
 (b* ((fn2-ops (fn2-ops-init *fn2-profile-tiny* fn2-ops))
      ((mv reserve slot gen fn2-ops) (fn2-op-reserve *fn2-action-close* 0 0 0 0 0 fn2-ops))
      ((mv enqueue fn2-ops) (fn2-op-enqueue slot gen fn2-ops))
      (fn2-ops (update-fn2-ops-out-sloti 1 slot fn2-ops))
      (fn2-ops (update-fn2-ops-out-geni 1 gen fn2-ops))
      (fn2-ops (update-fn2-ops-queued 2 fn2-ops))
      (fn2-ops (update-fn2-ops-out-tail 2 fn2-ops))
      (before (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops))
      (hyps (and (eq reserve :ok) (eq enqueue :ok) (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops)
                 (fn2-outbox-prefixp 2 (fn2-ops-out-head fn2-ops) fn2-ops)))
      ((mv code fn2-ops) (fn2-outbox-ack 2 fn2-ops)))
  (mv (and hyps (eq code :ok) (equal (fn2-ops-queued fn2-ops) 0)
           (equal before (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops))) fn2-ops)))
(defun fn2-issued-ack-duplicate ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-ops (mv-let (answer fn2-ops) (fn2-issued-ack-duplicate-run fn2-ops) answer)))
(assert-event (fn2-issued-ack-duplicate))
(defun fn2-issued-prefix-removal-run (fn2-ops)
 (declare (xargs :stobjs fn2-ops :verify-guards nil))
 (b* ((fn2-ops (fn2-ops-init *fn2-profile-tiny* fn2-ops))
      (fn2-ops (update-fn2-ops-queued 1 fn2-ops))
      (before (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops))
      (hyps (and (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops)
                 (not (fn2-outbox-issued-prefixp 1 (fn2-ops-out-head fn2-ops) fn2-ops))))
      ((mv code fn2-ops) (fn2-outbox-ack 1 fn2-ops))
      (refused (and (eq code :state) (equal before (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops))))
      (fn2-ops (fn2-outbox-submit-prefix 1 fn2-ops)))
  (mv (and hyps refused
           (equal (+ 1 before) (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops))) fn2-ops)))
(defun fn2-issued-prefix-removal ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-ops (mv-let (answer fn2-ops) (fn2-issued-prefix-removal-run fn2-ops) answer)))
(assert-event (fn2-issued-prefix-removal))

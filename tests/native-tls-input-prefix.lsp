;;; Isolated native-emitter control, loaded only into the qualified test world.
;;; Requires tests/input-prefix-unit + the actual host files/OpenSSL adapter.
;;; CERTIFICATE/KEY are ephemeral local test credentials. No socket is opened.
;;; The record primitive is an explicit byte-effect witness: this tests the
;;; actual native selector/observer/emitter callsite, not OpenSSL authentication.
(in-package "ACL2")
(defun fn2-native-tls-input-prefix-control (certificate key)
 (let* ((config (fn2-tls-%config certificate key *fn2-tls-minimum-version*))
        (handle (sb-sys:int-sap 0))
        (free-delegated nil)
        (perform (symbol-function 'fn2-native-tls-record-perform)))
  (assert (not (zerop (sb-sys:sap-int config))))
  (unwind-protect
   (progn
    (setf handle (fn2-tls-%new config 64))
    (assert (not (zerop (sb-sys:sap-int handle))))
    (multiple-value-bind (ready slot generation taken caps core)
        (fn2-input-prefix-fixture (fn2-n-live-core))
     (declare (ignore taken caps))
     (assert ready)
     (let* ((ops (make-array (fn2-profile-o *fn2-profile-tiny*)))
            (tls (fn2-native-tls-open 4 8))
            (host (make-fn2-nhost :core core
                   :bytes (svref (svref core *fn2-core-pool*) *fn2-pool-datai*)
                   :ops ops :trace (make-array 8 :initial-element nil))))
      (dotimes (i (length ops)) (setf (aref ops i) (make-fn2-nop)))
      (setf (fn2-nop-gen (aref ops slot)) generation
            (fn2-nop-kind (aref ops slot)) *fn2-action-receive*
            (fn2-nop-state (aref ops slot)) +fn2-n-waiting+)
      ;; Establish the logical carrier using explicit allocation/handshake
      ;; observations; only the later public record dispatcher is under test.
      (multiple-value-bind (code transport)
          (fn2-tls-transport-start 1 1 slot generation 0 8 4 20 64
           (fn2-native-tls-transport tls))
       (assert (eq code :ok))
       (setf (fn2-native-tls-transport tls) transport))
      (multiple-value-bind (code action offset count serial transport)
          (fn2-tls-transport-next 0 0 (fn2-native-tls-transport tls))
       (declare (ignore offset count))
       (assert (and (eq code :act) (= action 8)))
       (multiple-value-bind (observed kick updated)
           (fn2-tls-transport-observe 1 1 slot generation serial (sb-sys:sap-int handle) 0 0 transport)
        (declare (ignore kick)) (assert (eq observed :ok))
        (setf (fn2-native-tls-transport tls) updated)))
      (multiple-value-bind (code action offset count serial transport)
          (fn2-tls-transport-next 0 0 (fn2-native-tls-transport tls))
       (declare (ignore offset count))
       (assert (and (eq code :act) (= action 7)))
       (multiple-value-bind (observed kick updated)
           (fn2-tls-transport-observe 1 1 slot generation serial 0 0 0 transport)
        (declare (ignore kick)) (assert (eq observed :ok))
        (setf (fn2-native-tls-transport tls) updated)))
      (multiple-value-bind (code action offset count serial transport)
          (fn2-tls-transport-next 0 0 (fn2-native-tls-transport tls))
       (declare (ignore action offset count serial))
       (assert (eq code :done))
       (multiple-value-bind (handed copied fed il io ol oo updated)
           (fn2-tls-transport-handoff 1 1 slot generation transport)
        (declare (ignore copied fed il io ol oo))
        (assert (eq handed :ok)) (setf (fn2-native-tls-transport tls) updated)))
      (setf (symbol-function 'fn2-native-tls-record-perform)
       (lambda (actual-host actual-tls fd action bytes address offset count)
        (declare (ignore fd offset))
        (assert (and (eq actual-host host) (eq actual-tls tls) (= action 12) (= count 4)))
        (setf (aref bytes address) 70 (aref bytes (+ address 1)) 71)
        (values 0 2 0)))
      (multiple-value-bind (code count address)
          (fn2-native-tls-record-step host slot tls -1)
       (declare (ignore count address))
       (assert (eq code :progress)))
      (setf (symbol-function 'fn2-native-tls-record-perform) perform)
      ;; Consume the ACTUAL fn2-n-record capture, never an expected-packet twin.
      (let* ((trace (fn2-n-trace-list host)) (event (car trace)))
       (assert (and (= (length trace) 1) (eq (car event) :input-prefix)))
       (assert (fn2-input-prefix-replay-control :deferred event))
       (assert (fn2-input-prefix-replay-control :ordinary event))
       (assert (fn2-input-prefix-replay-control :duplicate event))
       (assert (fn2-input-prefix-replay-control :after-close-ack event)))
      (setf free-delegated t)
      (fn2-native-tls-close tls 1 1 host)
      t)))
   (setf (symbol-function 'fn2-native-tls-record-perform) perform)
   (unless (or free-delegated (zerop (sb-sys:sap-int handle))) (fn2-tls-%free handle))
   (fn2-tls-%config-free config))))

;;; SCN1134: actual BP startup helpers and actual listener entry callers.
;;; Physical constructors are recorded; no full tariff/native image claim.
(require :sb-posix)
(require :sb-bsd-sockets)
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun source-forms (path names)
 (with-open-file (in path)
  (loop for form = (read in nil :eof) until (eq form :eof)
   when (and (consp form) (member (car form) '(defun defstruct))
             (member (if (consp (second form)) (car (second form)) (second form)) names))
   do (progn (eval form)
             (setf names (remove (if (consp (second form)) (car (second form)) (second form)) names)))
   finally (assert (null names)))))
(source-forms "books/owner-retire-settlement.lisp"
 '(fn-ort-store-close-action fn-ort-service-settlement-action fn-ort-service-claim-action fn-ort-service-start-reason))
(defvar *fnn-owner-caller-reservation* nil)
(defvar *fnn-owner-retained-service* nil)
(defvar *fnn-owner-retained-settlement* :held)
(defvar *fnn-owner-reserving-thread* nil)
(defvar *fnn-log-queue-mutex* (sb-thread:make-mutex))
(defvar *fnn-log-writer* nil)
(defvar *fnn-owner-log-fd* nil)
(defstruct fnn-owner-service store)
(defstruct fnn-store fenced)
(define-condition fixture-stop (error) ())
(defvar *mode* nil)
(defvar *events* nil)
(defvar *pool* nil)
(defvar *workers* nil)
(defvar *store* nil)
(defun fnn-core (name &rest args)
 (case name
  (fn-bpsp-root-release-ready (zerop (first args)))
  (otherwise (apply name args))))
(defun fnn-absolute (path) (assert (equal path "/store")) path)
(defun fnn-indeterminate (&rest args) (declare (ignore args)) (error 'fixture-stop))
(defun fnn-owner-page-read-startup (root connections cold output retain)
 (assert (equal root "/store")) (assert (member connections '(1 2)))
 (assert (null cold)) (assert (null output))
 (assert *fnn-owner-retained-service*)
 (push :preflight *events*)
 (when (eq *mode* :refused) (error 'fixture-stop))
 (setf *pool* t)
 (funcall retain)
 (push :pool-retained *events*)
 (when (eq *mode* :constructor-error) (error 'fixture-stop))
 (setf *workers* t)
 (push :workers *events*))
(defun fnn-owner-install (root connections)
 (declare (ignore root connections))
 (assert (and *pool* *workers*))
 (push :store-open *events*)
 (let ((service (make-fnn-owner-service :store *store*)))
  (when (member *mode* '(:recovery-error :join-error))
   (fnn-owner-retain-run-authority service)
   (error 'fixture-stop))
  service))
(defun fnn-extent-end-recovery-cache () (push :recovery-end *events*))
(defun fnn-extent-executor-stop ()
 (push :executor-join *events*)
 (when (eq *mode* :join-error) (error 'fixture-stop))
 (setf *workers* nil))
(defun fnn-owner-cold-shutdown (service)
 (assert (eq (fnn-owner-service-store service) *store*))
 (fnn-extent-executor-stop))
(defun fnn-store-close (store)
 (assert (eq store *store*)) (assert (not *workers*))
 (push :store-close *events*)
 (when (eq *mode* :close-error) (error 'fixture-stop)))
(source-forms "host/native/owner.lisp"
 '(fnn-owner-claim-run-authority fnn-owner-retain-run-authority fnn-owner-store-settlement))
(source-forms "host/native/bp-service.lisp"
 '(fnn-bp-served-owner-custody fnn-bp-served-owner-start
   fnn-bp-served-owner-stop fnn-bp-served-owner-settle))
(defun helper-case (mode expected held)
 (let ((*mode* mode) (*events* nil) (*pool* nil) (*workers* nil)
       (*store* (make-fnn-store)) (*fnn-owner-retained-service* nil)
       (*fnn-owner-reserving-thread* nil) (service nil)
       (custody (make-fnn-bp-served-owner-custody)))
  (handler-case (setf service (fnn-bp-served-owner-start custody "/store" 2))
   (fixture-stop () nil))
  (handler-case (fnn-bp-served-owner-stop custody service) (fixture-stop () nil))
  (handler-case (fnn-bp-served-owner-settle custody service (not (eq mode :root-debt)))
   (fixture-stop () nil))
  (assert (equal (reverse *events*) expected))
  (assert (eql (and *fnn-owner-retained-service* t) held))
  (when (eq mode :close-error) (assert (fnn-store-fenced *store*)))
  (when held
   ;; A fresh BP/owner claimant cannot overwrite retained physical authority.
   (let ((blocked nil))
    (handler-case (fnn-owner-claim-run-authority) (fixture-stop () (setq blocked t)))
    (assert blocked)))
  (format t "~a events=~s held=~s~%" mode (reverse *events*) held)))
(helper-case :normal '(:preflight :pool-retained :workers :store-open :recovery-end :executor-join :store-close) nil)
(helper-case :refused '(:preflight) nil)
(helper-case :constructor-error '(:preflight :pool-retained :executor-join) nil)
(helper-case :recovery-error '(:preflight :pool-retained :workers :store-open :executor-join :store-close) nil)
(helper-case :join-error '(:preflight :pool-retained :workers :store-open :executor-join) t)
(helper-case :close-error '(:preflight :pool-retained :workers :store-open :recovery-end :executor-join :store-close) t)
(helper-case :root-debt '(:preflight :pool-retained :workers :store-open :recovery-end :executor-join) t)

;;; Call the production commands, not a reconstructed entry recipe. Refusal
;;; before owner return must still stop the partial pool and preserve authority
;;; on join escape. Unrelated FNBS/spool construction is recorded.
(defvar *fnn-bpnode-receipt-signer* nil)
(defvar *fnn-bpnode-budgets* nil)
(defvar *fnn-bp-session-stranded-roots* nil)
(defvar *fnn-bp-session-bank* nil)
(defvar *fnn-bpnode-control-pump* nil)
(defun fnn-bp-config (&rest args) (declare (ignore args)) :config)
(defun fnn-bps-open-node (&rest args) (declare (ignore args)) :bp)
(defun fnn-bps-release (bp) (assert (eq bp :bp)) (push :fnbs-release *events*))
(defun fnn-bpnode-read-budgets (&rest args)
 (declare (ignore args))
 (when (eq *mode* :budget-error) (error 'fixture-stop)) nil)
(defun fnn-bp-journal-dir (root) root)
(defun fnn-tcl-spool-acquire (&rest args) (declare (ignore args)) :spool)
(defun fnn-tcl-spool-release (lock) (assert (eq lock :spool)) (push :spool-release *events*))
(source-forms "host/native/bp-node.lisp" '(fnn-command-bp-node))
(source-forms "host/native/bp-app.lisp" '(fnn-command-bp-app-receive))
(dolist (command '(:node :app))
 (dolist (mode '(:constructor-error :recovery-error :join-error))
  (let ((*mode* mode) (*events* nil) (*pool* nil) (*workers* nil)
        (*store* (make-fnn-store)) (*fnn-owner-retained-service* nil)
        (*fnn-owner-reserving-thread* nil))
   (handler-case
    (if (eq command :node)
     (fnn-command-bp-node 0 nil "/fnbs" "/store" "/receipts" "/workflow"
      "node" "peer" "dest" "policy" "issuer" "host" 4556 1000 2 16 32768 nil 0 nil)
     (fnn-command-bp-app-receive 0 nil "/spool" "/store" "/receipts"
      "node" "peer" "dest" "policy" "issuer" 1000 2 16 32768 2 nil 0))
    (fixture-stop () nil))
   (assert (member :executor-join *events*))
   (assert (eql (and *fnn-owner-retained-service* t) (eq mode :join-error)))
   (when (eq mode :join-error) (assert (not (member :store-close *events*))))
   (assert (member (if (eq command :node) :fnbs-release :spool-release) *events*)))))
(let ((*mode* :budget-error) (*events* nil))
 (handler-case
  (fnn-command-bp-node 0 nil "/fnbs" "/store" "/receipts" "/workflow"
   "node" "peer" "dest" "policy" "issuer" "host" 4556 1000 2 16 32768 nil 0 nil)
  (fixture-stop () nil))
 (assert (equal *events* '(:fnbs-release))))
(format t "PASS actual BP served owner pre-open and teardown custody~%")

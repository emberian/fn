(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun true-listp (x) (typep x 'list))
(defun len (x) (length x))
(defun symbol-listp (x) (every #'symbolp x))
(defun member-eq (x y) (member x y))
(with-open-file (in "books/columns.lisp")
 (loop for f = (read in nil :eof) until (eq f :eof) do
  (when (and (eq (car f) 'defun) (member (cadr f)
    '(fn2-columns-simple-disablep fn2-columns-theory-barrierp fn2-columns-disable-event fn2-columns-batch-phase-aux fn2-columns-batch-phase))) (eval f))))
(defun non-theory (xs) (remove-if #'fn2-columns-simple-disablep xs))
(defun disabled (xs) (loop for x in xs when (fn2-columns-simple-disablep x) append (cdadr x)))
(let* ((a '((defthm a (equal x x) :hints (("Goal" :in-theory (enable x))))
             (in-theory (disable a)) (defun body (x) '(:hints data))
             (in-theory (disable b c)) (defthm d (equal y y))))
       (b (fn2-columns-batch-phase a)))
 (assert (equal (non-theory a) (non-theory b)))
 (assert (equal (disabled a) (disabled b)))
 (assert (= (count-if #'fn2-columns-simple-disablep b) 1))
 (dolist (barrier '((in-theory (enable a)) (local (in-theory (enable a)))
                    (encapsulate () (local (in-theory (enable a))))
                    (progn (in-theory (enable a))) (make-event (value nil))))
  (let* ((events (append a (list barrier) a)) (out (fn2-columns-batch-phase events))
         (pos (position barrier out :test #'equal)))
   (assert pos)
   (assert (equal (disabled (subseq out 0 pos)) (disabled a)))
   (assert (equal (disabled (subseq out (1+ pos))) (disabled a)))
   (assert (equal (non-theory events) (non-theory out))))))
(format t "BATCH CONTROLS PASS: ordered forms/runes and theory/locality barriers.~%")

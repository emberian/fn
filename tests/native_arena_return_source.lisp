(defun fnn-arena-pins-step (event)
  (push event *arena-calls*)
  (case (first event)
    (:release (prog1 *due* (setq *due* nil)))
    (:retire (when (eq *arena-failure* :retire) (error "retire torn")) 0)))
(defun fnn-call (name &rest args)
  (push (list name (first args)) *arena-calls*)
  (case name
    ((fn-arx-commit-reseats fn-lzr-commit-reseats)
     (setf (first *arena*) :extent)
     (when (eq *arena-failure* :reseat) (error "reseat torn")))
    (fn-arena-release
     (setf (nth (first args) *arena*) :released)
     (when (eq *arena-failure* :escape) (throw 'arena-escape :escaped))
     (when (eql *arena-failure* (first args)) (error "release torn")))
    (otherwise (error "unexpected callback ~a" name))))

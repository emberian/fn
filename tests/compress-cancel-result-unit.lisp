; A productive receive survives actual host normalization after carrier Close.
; This is a logical controller/result control, not a socket byte-effect gate.
(in-package "ACL2")
(include-book "../books/host-result")
(include-book "compress-record-unit")
(defun fn2-compress-productive-cancel-control (fn2-compress-operation fn2-compress-transport)
 (declare (xargs :stobjs (fn2-compress-operation fn2-compress-transport) :verify-guards nil))
 (b* (((mv code fn2-compress-transport) (fn2-compress-ready-control fn2-compress-transport))
      ((unless (eq code :ok)) (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv code serial fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-next 4 5 6 7 1 4 fn2-compress-operation fn2-compress-transport))
      ((unless (eq code :ok)) (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv code fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-observe 4 5 6 7 serial 0 1 1 0 fn2-compress-operation fn2-compress-transport))
      ((unless (eq code :progress)) (mv nil fn2-compress-operation fn2-compress-transport))
      ; Close occurs after the observation, before another record NEXT.
      ((mv code fn2-compress-transport) (fn2-compress-transport-retire 4 5 fn2-compress-transport))
      ((unless (eq code :closing)) (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv code action & & serial fn2-compress-transport) (fn2-compress-transport-next 0 0 fn2-compress-transport))
      ((unless (and (eq code :cleanup) (= action 9))) (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv code & fn2-compress-transport)
       (fn2-compress-transport-observe-lifecycle 4 5 6 7 serial 0 0 0 fn2-compress-transport))
      ((unless (and (eq code :ok) (= (fn2-compress-transport-alive 0 fn2-compress-transport) 0)))
       (mv nil fn2-compress-operation fn2-compress-transport))
      ; No live-cap argument: the retained operation owns the application prefix.
      ((mv code fn2-compress-operation)
       (fn2-compress-operation-mark-carrier-closed 4 5 6 7 4 fn2-compress-transport fn2-compress-operation))
      ((unless (eq code :ok)) (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv decision terminal-code prefix won fn2-compress-operation)
       (fn2-compress-operation-cancel t fn2-compress-operation))
      ((unless (and (eq decision :productive) (eq terminal-code :ok) (not won) (= prefix 1))) (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv outcome reason count a0 a1)
       (fn2-host-result *fn2-action-receive* terminal-code prefix 0 4 nil))
      ((mv old-outcome old-reason old-count old-a0 old-a1)
       (fn2-host-result *fn2-action-receive* :cancelled prefix 0 4 nil)))
  (mv (and (equal (list outcome reason count a0 a1)
                  (list *fn2-outcome-done* *fn2-reason-none* 1 0 0))
           (equal (list old-outcome old-reason old-count old-a0 old-a1)
                  (list *fn2-outcome-cancelled* *fn2-reason-none* 0 0 0)))
      fn2-compress-operation fn2-compress-transport)))
(defun fn2-compress-productive-cancel-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-compress-operation
  (mv-let (ok fn2-compress-operation)
   (with-local-stobj fn2-compress-transport
    (mv-let (ok fn2-compress-operation fn2-compress-transport)
     (fn2-compress-productive-cancel-control fn2-compress-operation fn2-compress-transport)
     (mv ok fn2-compress-operation))) ok)))
(assert-event (fn2-compress-productive-cancel-test))

;;; Exact selected core/host bodies with opaque configuration and collector
;;; stubs. Routing/order only: this is not ACL2 admission, funding or native.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defmacro mv-let (names expression &body body)
  `(multiple-value-bind ,names ,expression ,@body))
(defun fn-cp-nth (n x) (nth n x))
(defun fn-ocfg-owner (oc) (first oc))
(defun fn-ocfg-config (oc) (second oc))
(defun fn-ocfg-pins (oc) (third oc))
(defun fn-ocfg-staged (oc) (fourth oc))
(defun fn-ocfg-with-owner (oc owner) (list owner (second oc) (third oc) (fourth oc)))
(defun fn-own-make (&rest fields) fields)
(loop for name in '(fn-own-store fn-own-view fn-own-conns fn-own-next-id
                    fn-own-max-conns fn-own-pending fn-own-ledger-field
                    fn-own-clock fn-own-facts fn-own-config fn-own-queue
                    fn-own-inflight fn-own-feeds fn-own-node-secret fn-own-refused)
      for index from 0 do (eval `(defun ,name (owner) (nth ,index owner))))
(defun fn-own-refresh (&rest ignored) (declare (ignore ignored)) (error "second refresh"))
(defun fn-sn-consumer (store) (nth 11 store))
(defun fn-sn-with-consumer (store cp) (let ((copy (copy-list store))) (setf (nth 11 copy) cp) copy))
(defvar *calls* nil)
(defvar *approved* '(:ok :saved-approved-cp :borrowed-metadata))
(defvar *verdict* :durable)
(defvar *completed* nil)
(defun fn-oclc-publish (oc generation max)
  (push (list :configure oc generation max) *calls*) (values *verdict* *completed*))
(defun fn-owner-ocfg (state) (getf state :oc))
(defun fn-owner-canonical-epoch (state) (getf state :epoch))
(defun fn-owner-served-post-bound (state) (getf state :max))
(defun fn-owner-authority-proposal-consume (epoch cp record state)
  (push (list :consume epoch cp record) *calls*)
  (values *approved* (list* :consumed t state)))
(defun fn-owner-authority-publication-install (one state)
  (push (list :install one) *calls*) (values nil (car one) state))
(defun load-body (form)
  (setf (cdddr form)
        (remove-if (lambda (x) (and (consp x) (eq (car x) 'declare))) (cdddr form)))
  (eval form))
(with-open-file (s "books/consumer-config-publication.lisp")
  (loop for form = (read s nil nil) while form
        when (and (consp form) (eq (car form) 'defun)) do (load-body form)))
(with-open-file (s "planning/evidence/consumer-config-publication-source-2026-09-30/owner-host-complete-current-hunk.lisp")
  (load-body (read s)))
(defun check (yes label) (unless yes (error "~a" label)))
(defparameter *store* '(groups capacity files node keys index keygen verdicts snapshots identity configs :old-cp topic events))
(defparameter *owner* (list *store* :view :conns 7 32 nil :ledger :clock :facts :config :queue :inflight :feeds :secret :refused))
(defparameter *oc* (list *owner* :old-config :pins :actual-staged-object))
(setf *completed* (list *owner* :new-config :pins nil))
(defparameter *state* (list :oc *oc* :epoch 8 :max 4096))
(fn-owner-reconfigure-complete 4 *state*)
(let* ((calls (reverse *calls*)) (packet (second (third calls)))
       (next (second packet)) (next-owner (first next)))
  (check (and (= (length calls) 3)
              (equal (first calls) '(:consume 8 :old-cp :actual-staged-object))
              (eq (car (second calls)) :configure)
              (eq (first packet) :durable)
              (eq (third packet) (third *approved*)) (null (fourth packet))
              (eq (fn-sn-consumer (first next-owner)) :saved-approved-cp)
              (equal (rest next-owner) (rest *owner*))
              (eq (second next) :new-config)) "saved result/root/metadata/order/frame"))
(setf *calls* nil *approved* '(:recovery-required :stale))
(fn-owner-reconfigure-complete 4 *state*)
(check (and (= (length *calls*) 2)
            (equal (first (reverse *calls*)) '(:consume 8 :old-cp :actual-staged-object))
            (equal (second (first *calls*)) (list :recovery-required *oc* nil nil)))
       "stale proposal configured or refused normally")
(dolist (failed '(:refused :recovery-required))
  (setf *calls* nil *approved* '(:ok :saved-approved-cp nil) *verdict* failed)
  (fn-owner-reconfigure-complete 4 *state*)
  (check (equal (second (first *calls*)) (list :recovery-required *oc* nil nil))
         "postdurable failure failed to require recovery"))
(setf *calls* nil *verdict* :durable *approved* '(:ok :saved-approved-cp nil))
(fn-owner-reconfigure-complete 4 *state*)
(check (and (null (third (second (first *calls*))))
            (null (fourth (second (first *calls*))))) "nil metadata became readiness/root")
(format t "config completion routing: five boundaries passed~%")

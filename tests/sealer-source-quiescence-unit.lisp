; Prepared actual callback control, not a planted READY/observer flag. Two
; concrete resident overlays are built with the real codec/freeze boundary;
; this does not witness a B commit or a streaming physical sealer publisher.
(in-package "ACL2")
(include-book "../books/assembly-callbacks-c")
(include-book "std/util/bstar" :dir :system)
(defconst *fn2-ssq-profile*
 (put-assoc-equal :identity-overlays 2
  (put-assoc-equal :identity-overlay-entries 2
   (put-assoc-equal :identity-arena-bytes 4096
    (put-assoc-equal :large-upload-windows 1
     (put-assoc-equal :pool-classes '((12 . 4096) (2 . 65536)) *fn2-profile-tiny*))))))
(defun fn2-ssq-overlay (o number fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-overlays (fn2-core-overlays fn2-core)) (fn2-overlay-index (fn2-core-overlay-index fn2-core))
             (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
  (code fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
  (b* ((class (fn2-pool-class-for 4096 fn2-pool))
       ((mv code arena agen fn2-pool) (fn2-pool-reserve class *fn2-idc-owner-kind* 0 1 fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
       ((mv code source sgen fn2-pool) (fn2-pool-reserve class *fn2-idc-owner-kind* 0 1 fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
       ((mv code fn2-pool) (fn2-pool-write source sgen 0 120 *fn2-idc-owner-kind* 0 1 fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
       ((mv code fn2-overlays fn2-pool) (fn2-ov-start o 3 arena agen (* 2 o) 2 *fn2-idc-owner-kind* 0 1 0 fn2-overlays fn2-overlay-index fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
       (fn2-fields (fn2-fields-put *fn2-overview-entry-field-group* (value 1) (ref-len 0)))
       (fn2-fields (fn2-fields-put *fn2-overview-entry-field-number* (value number) (ref-len 0)))
       (fn2-fields (fn2-fields-put *fn2-overview-entry-field-article* (value (+ 40 number)) (ref-len 0)))
       (fn2-fields (fn2-fields-put *fn2-overview-entry-field-position* (value number) (ref-len 0)))
       (fn2-fields (fn2-fields-put *fn2-overview-entry-field-line* (ref-slot source) (ref-gen sgen) (ref-off 0) (ref-len 1)))
       ((mv code fn2-overlays fn2-overlay-index fn2-pool) (fn2-ov-write o 0 0 nil fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
       ((mv code fn2-overlays) (fn2-ov-freeze o fn2-overlays))
       ((unless (eq code :ok)) (mv code fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
       ((mv code fn2-pool) (fn2-pool-release source sgen *fn2-idc-owner-kind* 0 1 fn2-pool)))
   (mv code fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
  (mv code fn2-core)))
(defun fn2-ssq-observed-p (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-seals (fn2-core-seals fn2-core))) (yes)
  (and (< 0 (fn2-seals-rows fn2-seals)) (posp (fn2-seals-source-receipt 0 fn2-seals))) yes))
(defun fn2-ssq-finish (fuel id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond ((fn2-csnapshot-sealer-quiescent-p fn2-core) (mv :ok fn2-core))
       ((zp fuel) (mv :fuel fn2-core))
       (t (b* (((mv & & & & fn2-core) (fn2-sealer-run id 4 fn2-core))
                ((when (fn2-core-stopped-p fn2-core)) (mv :stopped fn2-core)))
            (fn2-ssq-finish (- fuel 1) id fn2-core)))))
(defun fn2-ssq-polls (fuel token kind owner generation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :more fn2-core)
  (mv-let (code & & fn2-core) (fn2-csnapshot-poll token kind owner generation fn2-core)
   (if (eq code :more) (fn2-ssq-polls (- fuel 1) token kind owner generation fn2-core) (mv code fn2-core)))))
(defun fn2-ssq-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-ssq-profile* fn2-core))
      ((mv genesis fn2-core) (fn2-sealer-genesis *fn2-ssq-profile* fn2-core))
      ((mv started-row fn2-core) (fn2-sealer-start-row t fn2-core))
      (id (fn2-machine-kind-base *fn2-sealer-kind* fn2-core))
      (master (fn2-machine-kind-base *fn2-checkpoint-master-kind* fn2-core))
      (mgen (fn2-machine-generation master fn2-core))
      ((mv first fn2-core) (fn2-ssq-overlay 0 1 fn2-core))
      ((mv granted fn2-core) (fn2-sealer-grant fn2-core))
      ((mv & & & & fn2-core) (fn2-sealer-run id 4 fn2-core))
      ((mv first-sealed fn2-core) (fn2-ssq-finish (* 4 *fn2-format-page-size*) id fn2-core))
      ((mv second fn2-core) (fn2-ssq-overlay 0 2 fn2-core))
      ((mv third fn2-core) (fn2-ssq-overlay 1 3 fn2-core))
      ((mv granted-again fn2-core) (fn2-sealer-grant fn2-core))
      ; With one old resident page and only one free page, the actual plan
      ; merges the old run with overlay0. No physical catalog root exists.
      ((mv & & & & fn2-core) (fn2-sealer-run id 4 fn2-core))
      (active (and (fn2-ssq-observed-p fn2-core) (not (fn2-csnapshot-sealer-quiescent-p fn2-core))
       (stobj-let ((fn2-seals (fn2-core-seals fn2-core))) (yes)
        (and (equal (fn2-seals-phase 0 fn2-seals) *fn2-seal-phase-build*) (< 0 (fn2-seals-k 0 fn2-seals))
             (equal (fn2-seals-held 0 fn2-seals) 0)) yes)))
      ((mv early-release & & fn2-core) (fn2-sealer-source-release fn2-core))
      (retained-after-refusal (fn2-ssq-observed-p fn2-core))
      ((mv begun token fn2-core) (fn2-csnapshot-begin *fn2-checkpoint-master-kind* master mgen fn2-core))
      (allocator-open (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (yes)
       (and (equal (fn2-alloc-freeze-phase fn2-extents) 0) (fn2-alloc-snapshot-activep fn2-extents)) yes))
      (polls (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (n) (+ 2 (fn2-succ-txns-rows fn2-succ-txns)) n))
      ((mv blocked fn2-core) (fn2-ssq-polls polls token *fn2-checkpoint-master-kind* master mgen fn2-core))
      (closing (equal (mv-nth 0 (fn2-csnapshot-state fn2-core)) *fn2-csnapshot-phase-closing*))
      ; The actual actor finishes its normal merge and retires its old inputs.
      ; Lower IDLE makes its old source cursors nonresumable; no prefix is cancelled.
      ((mv finished fn2-core) (fn2-ssq-finish (* 4 *fn2-format-page-size*) id fn2-core))
      (retired-free (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core))) (yes)
       (let ((rows (fn2-run-installed-rows fn2-run-installed)))
        (not (< (fn2-seal-retired-row rows 0 fn2-run-installed) rows))) yes))
      (quiescent (and (fn2-csnapshot-sealer-quiescent-p fn2-core) (not (fn2-ssq-observed-p fn2-core))))
      ; CLOSING also blocks a new observer/source, while overlay1 is pending.
      (pending (stobj-let ((fn2-seals (fn2-core-seals fn2-core)) (fn2-overlays (fn2-core-overlays fn2-core))) (yes)
                 (fn2-seal-pending-p fn2-seals fn2-overlays) yes))
      ((mv new-source fn2-core) (fn2-sealer-step 4096 fn2-core))
      ((mv held fn2-core) (fn2-ssq-polls polls token *fn2-checkpoint-master-kind* master mgen fn2-core))
      (good (and (eq genesis :ok) (eq started-row :ok) (eq first :ok) (equal granted id) (eq first-sealed :ok)
       (eq second :ok) (eq third :ok) (equal granted-again id) active (eq early-release :busy) retained-after-refusal (eq begun :ok) (eq blocked :more) closing allocator-open
       (eq finished :ok) quiescent retired-free pending (eq new-source :busy) (eq held :held) (not (fn2-core-stopped-p fn2-core)))))
  (mv good fn2-core)))
(assert-event (with-local-stobj fn2-core (mv-let (good fn2-core) (fn2-ssq-body fn2-core) good)))

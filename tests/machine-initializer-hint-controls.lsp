; Execute the actual old/new factory; no ACL2 process or proof claims.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun intern-in-package-of-symbol (name sym) (intern name (symbol-package sym)))
(defun assoc-eq (x xs) (assoc x xs))
(defun load-selected (path names)
 (with-open-file (in path)
  (loop for form = (read in nil :eof) until (eq form :eof) do
   (when (and (eq (car form) 'defun) (member (cadr form) names)) (eval form)))))
(defun remove-proof-hints (form)
 (if (atom form) form
  (if (member (car form) '(defthm xargs))
   (loop for rest on form
         unless (or (member (car rest) '(:hints :guard-hints))
                    (and (not (eq rest form))
                         (member (nth (- (length form) (length rest) 1) form)
                                 '(:hints :guard-hints))))
         collect (remove-proof-hints (car rest)))
   (mapcar #'remove-proof-hints form))))
(defun factory (name fields initial)
 (fn2-machine-prepare-events name fields initial))
(load-selected "books/columns.lisp"
 '(fn2-columns-sym fn2-columns-pre fn2-columns-col-name fn2-columns-put-bindings))
(load-selected (second sb-ext:*posix-argv*) '(fn2-machine-initial-values fn2-machine-prepare-events))
(let* ((conn (with-open-file (in "books/conn-schema.lisp")
              (loop for f = (read in nil :eof) until (eq f :eof)
                    when (eq (car f) 'defmachine) return f)))
       (cases (list (list 'fn2-conn (getf (cddr conn) :fields) (getf (cddr conn) :initial))
                    '(custom ((value :u8) (generation :u60))
                             ((value custom-initializer) (generation 1)))))
       (before (mapcar (lambda (args) (apply #'factory args)) cases)))
 (load-selected "books/machines.lisp" '(fn2-machine-prepare-events))
 (loop for args in cases for old in before for new = (apply #'factory args) do
  (assert (equal old (mapcar #'remove-proof-hints new)))
  (assert (= 5 (count 'defthm new :key #'car)))
  (assert (= 2 (count 'defun new :key #'car)))
  (dolist (event new)
   (when (eq (car event) 'defun)
    (assert (equal (getf (cdr (cadr (fourth event))) :guard-hints)
                   `((fn2-columns-call-guard-hint ',(cadr event) nil nil world)))))
   (when (eq (car event) 'defthm)
    (let ((subject (if (search "INITIALIZE-ROWS" (symbol-name (cadr event)))
                       (fn2-columns-sym (car args) "-INITIALIZE-ROWS")
                     (fn2-columns-sym (car args) "-PREPARE"))))
     (assert (equal (getf (cdddr event) :hints)
                    `((fn2-columns-call-guard-hint ',subject nil '(,subject) world))))))))
 (assert (search "CUSTOM-INITIALIZER SLOT BASE N GEN"
                 (write-to-string (factory 'custom '((value :u8)) '((value custom-initializer)))))))
; Reuse the real metadata policy control; add a pure user initializer with
; no output stobj: it must remain open even if named like a setter.
(load "tests/columns-call-guard-controls.lsp")
(let* ((world '(:tables ((output :registered))
               :properties ((initializer formals (left output) stobjs-in (nil output)
                             unnormalized-body (initializer custom-initializer writer))
                            (writer stobjs-out (output))
                            (writer-preserves-type theorem t) (writer-preserves-wfp theorem t)
                            (custom-initializer stobjs-out (nil)))))
       (hint (fn2-columns-call-guard-hint 'initializer nil '(initializer) world))
       (closed (caddr (cadr hint))))
 (assert (member 'writer closed))
 (assert (not (member 'custom-initializer closed)))
 (assert (not (member 'initializer closed))))
(format t "MACHINE INITIALIZER HINT SOURCE CONTROLS PASS~%")

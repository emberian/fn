; Accepted READ-domain fixture, not a normal sealer-reachability witness.
; Four one-entry/page chains have six levels each. Every page is written,
; closed, headed, sealed and checked through the real APIs before cache/install.
; No read phase, :more result, page octets, or installed metadata is seeded.
(in-package "ACL2")
(include-book "../books/assembly-callbacks-c")
(defconst *fn2-cns-tall-principal* 7)
(defconst *fn2-cns-tall-position* 100)
(defconst *fn2-cns-tall-article* 1000)
(defconst *fn2-cns-tall-entry-base* 200)
; Fresh test core only: 24 pages remain live, one small hash workspace.
(defconst *fn2-cns-tall-profile*
 (put-assoc-equal :run-cache 64
  (put-assoc-equal :identity-runs 8
   (put-assoc-equal :pool-classes '((8 . 4096) (32 . 65536)) *fn2-profile-tiny*))))
(defconst *fn2-cns-tall-owner* '(9 0 1))
(defconst *fn2-cns-tall-children* '(fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache))
(defmacro fn2-cns-tall-defun (name args body)
 `(defun ,name ,(append args *fn2-cns-tall-children*)
   (declare (xargs :stobjs ,*fn2-cns-tall-children* :verify-guards nil
    ,@(cond ((eq name 'fn2-cns-tall-chain) '(:measure (nfix (- 6 (nfix level)))))
            ((eq name 'fn2-cns-tall-runs) '(:measure (nfix (- 4 (nfix run)))))
            (t nil)))) ,body))
(defmacro fn2-cns-tall-mv (&rest values)
 `(mv ,@values ,@*fn2-cns-tall-children*))
(fn2-cns-tall-defun fn2-cns-tall-close (fuel)
 (if (zp fuel) (fn2-cns-tall-mv :fuel)
  (mv-let (code fn2-run-writers fn2-fields fn2-pool)
   (fn2-run-close-step 0 4096 fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
   (if (eq code :more) (fn2-cns-tall-close (- fuel 1) fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache)
    (fn2-cns-tall-mv code)))))
(fn2-cns-tall-defun fn2-cns-tall-seal (fuel)
 (if (zp fuel) (fn2-cns-tall-mv :fuel)
  (mv-let (code fn2-run-writers fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
   (fn2-run-seal-step 0 0 136 4096 fn2-run-writers fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
   (if (eq code :more) (fn2-cns-tall-seal (- fuel 1) fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache)
    (fn2-cns-tall-mv code)))))
(fn2-cns-tall-defun fn2-cns-tall-chain (level run hslot hgen)
 (b* ((level (nfix level))
      (e *fn2-cns-tall-entry-base*)
      ; Capture the previously sealed child's real hash/reference before
      ; resetting the writer for its parent. The leaf has no child.
      ((mv child fn2-fields fn2-pool)
       (if (zp level) (mv :ok fn2-fields fn2-pool)
        (fn2-run-child-ref 0 (- level 1) (+ e 2) (+ e 2 *fn2-format-ref-num-fields*)
         136 hslot hgen 9 0 1 fn2-run-writers fn2-fields fn2-pool fn2-digests)))
      ((unless (eq child :ok)) (fn2-cns-tall-mv child))
      ((mv code fn2-run-writers) (fn2-run-reset-writers 1 0 fn2-run-writers))
      ((unless (eq code :ok)) (fn2-cns-tall-mv code))
      ((mv code slot gen fn2-pool) (fn2-pool-reserve (fn2-pool-class-for *fn2-run-page-size* fn2-pool) 9 0 1 fn2-pool))
      ((unless (eq code :ok)) (fn2-cns-tall-mv code))
      (unit (+ 1 (* run 6) level))
      ((mv code fn2-run-writers fn2-pool)
       (fn2-run-open 0 slot gen *fn2-addr-sid* 1 level (+ run 1) level
        (fn2-run-layout-page-kind *fn2-addr-sid* level) unit 1 1 1 1 9 0 1 0
        *fn2-run-page-size* fn2-run-writers fn2-pool))
      ((unless (eq code :ok)) (fn2-cns-tall-mv code))
      (fn2-fields (fn2-fields-set-value e *fn2-cns-tall-principal* fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ e 1) *fn2-cns-tall-position* fn2-fields))
      (fn2-fields (if (zp level) (fn2-fields-set-value (+ e 2) *fn2-cns-tall-article* fn2-fields) fn2-fields))
      (fn2-fields (if (zp level) (fn2-fields-set-value (+ e 3) 3 fn2-fields) fn2-fields))
      (fn2-fields (if (zp level) (fn2-fields-set-value (+ e 4) 1 fn2-fields) fn2-fields))
      ((mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
       (fn2-run-add 0 *fn2-addr-sid* e fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
      ((unless (eq code :ok)) (fn2-cns-tall-mv code))
      ((mv code fn2-run-writers) (fn2-run-close 0 fn2-run-writers))
      ((unless (eq code :ok)) (fn2-cns-tall-mv code))
      ((mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache) (fn2-cns-tall-close 64 fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache))
      ((unless (eq code :ok)) (fn2-cns-tall-mv code))
      ((mv code fn2-run-writers fn2-fields fn2-pool)
       (fn2-run-head 0 fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
      ((unless (eq code :ok)) (fn2-cns-tall-mv code))
      (fn2-fc-context (fn2-run-seal-context 0 0 136 fn2-run-writers fn2-fc-context))
      ((mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache) (fn2-cns-tall-seal 64 fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache))
      ((unless (eq code :ok)) (fn2-cns-tall-mv code))
      ; Same immutable page/context, independently checked by B.
      ((mv code fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
       (fn2-format-drive (fn2-format-fuel *fn2-run-page-size*) 0 :page nil slot gen 0
        *fn2-run-page-size* 0 9 0 1 4096 fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests))
      ((unless (eq code :ok)) (fn2-cns-tall-mv code))
      ((mv code fn2-run-cache) (fn2-run-cache-install unit 1 slot gen fn2-run-cache))
      ((unless (eq code :ok)) (fn2-cns-tall-mv code)))
  (if (< level 5)
   (fn2-cns-tall-chain (+ level 1) run hslot hgen fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache)
   (mv-let (code fn2-run-installed)
    (fn2-run-install run *fn2-addr-sid* (+ run 1) 5 slot gen unit 1 1 9 0 1 fn2-run-installed)
    (fn2-cns-tall-mv code)))))
(fn2-cns-tall-defun fn2-cns-tall-runs (run hslot hgen)
 (if (>= (nfix run) 4) (fn2-cns-tall-mv :ok)
  (b* (((mv code fn2-pool) (fn2-pool-reset hslot hgen 9 0 1 fn2-pool))
       ((unless (eq code :ok)) (fn2-cns-tall-mv code))
       ((mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache) (fn2-cns-tall-chain 0 run hslot hgen fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache)))
   (if (eq code :ok) (fn2-cns-tall-runs (+ 1 (nfix run)) hslot hgen fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache)
    (fn2-cns-tall-mv code)))))
(fn2-cns-tall-defun fn2-cns-tall-setup ()
 (b* (((unless (and (< 0 (fn2-run-writers-rows fn2-run-writers))
                    (<= *fn2-run-restart-capacity* (fn2-run-restarts-rows fn2-run-restarts))
                    (<= 512 (fn2-fields-rows fn2-fields))
                    (< 0 (fn2-fc-rows fn2-fc)) (< 0 (fn2-fc-context-rows fn2-fc-context))
                    (< 0 (fn2-b3-rows fn2-b3)) (< 136 (fn2-digests-rows fn2-digests))
                    (<= 4 (fn2-run-installed-rows fn2-run-installed))
                    (<= 25 (fn2-run-cache-rows fn2-run-cache))))
       (fn2-cns-tall-mv :bounds))
      ((mv code hslot hgen fn2-pool) (fn2-pool-reserve (fn2-pool-class-for 4096 fn2-pool) 9 0 1 fn2-pool))
      ((unless (eq code :ok)) (fn2-cns-tall-mv code))
      ((mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache) (fn2-cns-tall-runs 0 hslot hgen fn2-run-writers fn2-run-restarts fn2-fields fn2-pool fn2-fc fn2-fc-context fn2-b3 fn2-digests fn2-run-installed fn2-run-cache)))
  (fn2-cns-tall-mv code)))
; Fresh test core only; not idempotent and not a served operation.
; The caller owns row0 writer/format scratch and installed rows0..3.

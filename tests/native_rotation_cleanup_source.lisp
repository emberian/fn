(require :sb-posix)
(require :sb-bsd-sockets)
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defconstant +fnn-lock-un+ 8)
(defconstant +fnn-o-nofollow+ 0)
(define-condition fnn-os-error (error) ())
(define-condition fnn-store-indeterminate (error) ())
(define-condition fixture-refused (error) ())
(defvar *physical-condition* (make-condition 'fnn-os-error))
(defvar *calls* nil)
(defvar *fail* nil)
(defvar *rename-result* nil)
(defvar *cut* nil)
(defun fixture-call (name)
  (push name *calls*) (when (member name *fail*) (error *physical-condition*)))
(defun fnn-err (&rest ignored) (declare (ignore ignored)))
(defun fnn-refuse (&rest ignored) (declare (ignore ignored)) (error 'fixture-refused))
(defun fnn-refuse-io (&rest ignored) (declare (ignore ignored)) (error 'fixture-refused))
(defun fnn-indeterminate (&rest ignored) (declare (ignore ignored)) (error 'fnn-store-indeterminate))
(defun fnn-core (name &rest ignored)
  (declare (ignore ignored))
  (case name
    (fn-lgs-next-segment 2) ((fn-lgc-rotate-admitsp fn-lgc-rotate-needed-p) t)
    (fn-lgc-last :digest) (fn-lgc-rotate :new-kernel)
    (fn-store-log-initial-extent 256) (fn-lgc-rotation-octets '(0))
    (otherwise (error "unexpected core ~a" name))))
(defun fnn-nat (value) value)
(defun fnn-open (&rest ignored) (declare (ignore ignored)) :new)
(defun fnn-close (fd) (fixture-call fd))
(defun fnn-flock (&rest ignored) (declare (ignore ignored)) (fixture-call :unlock))
(defun fnn-lstat (&rest ignored) (declare (ignore ignored)) nil)
(defun fnn-unlink (&rest ignored) (declare (ignore ignored)) (fixture-call :unlink))
(defun fnn-log-spare-path (&rest ignored) (declare (ignore ignored)) "/stage")
(defun fnn-segment-path-at (&rest ignored) (declare (ignore ignored)) "/segment")
(defun fnn-journal-dir (&rest ignored) (declare (ignore ignored)) "/journal")
(defun fnn-rename-no-replace (&rest ignored)
  (declare (ignore ignored)) (fixture-call :rename) *rename-result*)
(defun fnn-log-at (cut) (when (eq cut *cut*) (error *physical-condition*)))
(defun fnn-log-preallocate (&rest ignored) (declare (ignore ignored)) (fixture-call :preallocate))
(defun fnn-fsync-file (&rest ignored) (declare (ignore ignored)) (fixture-call :fsync))
(defun fnn-log-pwrite (&rest ignored) (declare (ignore ignored)) (fixture-call :head))
(defun fnn-log-batch-reset (&rest ignored) (declare (ignore ignored)))
(with-open-file (input "host/native/io.lisp")
  (loop for form = (read input nil :eof) until (eq form :eof) do
    (when (and (consp form)
               (or (and (eq (car form) 'defstruct)
                        (consp (second form)) (member (car (second form)) '(fnn-store fnn-log)))
                   (and (eq (car form) 'defmacro) (eq (second form) 'fnn-unwind-cleanups))
                   (and (eq (car form) 'defun)
                        (member (second form) '(fnn-store-close fnn-log-close-active
                          fnn-log-discard-spare fnn-log-prepare-spare fnn-log-rotate)))))
      (eval form))))
(defun fixture-store ()
  (%make-fnn-store :log (%make-fnn-log :fd :old :index 1 :unit 1 :kernel :kernel
                                    :spare '(2 "/stage" :new))))
(dolist (failure '(:rename :rotate-renamed :head :rotate-headed :old))
  (let* ((store (fixture-store)) (log (fnn-store-log store)) (*calls* nil)
         (*fail* (list failure)) (*cut* failure) (caught nil))
    (handler-case (fnn-log-rotate store) (error (e) (setq caught e)))
    (assert caught)
    (assert (equal (fnn-log-spare log) '(2 "/stage" :new)))
    (when (eq failure :old) (assert (fnn-log-active-close-debt log)))
    (let ((*calls* nil) (*fail* nil))
      (handler-case (fnn-store-close store) (error () nil))
      (assert (member :new *calls*))
      (if (eq failure :old) (assert (not (member :old *calls*)))
        (assert (member :old *calls*))))))
(let* ((store (fixture-store)) (log (fnn-store-log store)) (*calls* nil) (*fail* nil) (*cut* nil))
  (assert (equal (fnn-log-rotate store) '(2 :digest)))
  (assert (null (fnn-log-spare log))) (assert (eq (fnn-log-fd log) :new))
  (let ((*calls* nil)) (fnn-store-close store) (assert (equal *calls* '(:new)))))
(let* ((store (fixture-store)) (log (fnn-store-log store)) (*calls* nil)
       (*rename-result* :exists) (*fail* '(:new)) (caught nil))
  (handler-case (fnn-log-rotate store) (error (e) (setq caught e)))
  (assert (typep caught 'fixture-refused))
  (assert (equal (fnn-log-spare-close-debt log)
                 (list '(2 "/stage" :new) *physical-condition*)))
  (let ((*calls* nil) (*fail* nil))
    (handler-case (fnn-store-close store) (error () nil))
    (assert (not (member :new *calls*))) (assert (member :old *calls*))))
(let* ((store (%make-fnn-store :log (%make-fnn-log :fd :old :index 1 :kernel :kernel)))
       (log (fnn-store-log store)) (*fail* '(:preallocate :new)) (*calls* nil) (caught nil))
  (handler-case (fnn-log-prepare-spare store) (error (e) (setq caught e)))
  (assert (typep caught 'fixture-refused))
  (assert (equal (fnn-log-spare-close-debt log)
                 (list '(2 "/stage" :new) *physical-condition*))))
(format t "PASS actual rotation: candidate tracked across rename/head cuts; independent close; no duplicate active close.~%")
;;; Actual OS receipt counterexample: close releases fd, then signals; reuse
;;; that integer for a sentinel. Subsequent Store cleanup must not close it.
(let* ((old (sb-posix:open "/dev/null" sb-posix:o-rdonly))
       (new (sb-posix:open "/dev/null" sb-posix:o-rdonly))
       (log (%make-fnn-log :fd old :spare (list 2 "/absent" new)))
       (store (%make-fnn-store :log log)) (sentinel nil)
       (original (symbol-function 'fnn-close)))
  (unwind-protect
       (progn
         (setf (symbol-function 'fnn-close)
               (lambda (fd)
                 (sb-posix:close fd)
                 (when (= fd old)
                   (setq sentinel (sb-posix:open "/dev/null" sb-posix:o-rdonly))
                   (assert (= sentinel old))
                   (error *physical-condition*))))
         (handler-case (fnn-log-close-active log) (error () nil))
         (handler-case (fnn-store-close store) (error () nil))
         (assert (sb-posix:fstat sentinel)))
    (setf (symbol-function 'fnn-close) original)
    (when sentinel (sb-posix:close sentinel))))
(format t "PASS real descriptor reuse: sticky active close prevents closing reused sentinel.~%")

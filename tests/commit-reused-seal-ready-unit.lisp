; Actual private constructor -> actual pipelined predecessor consumer.
; The typed source row/worker context is synthetic. This is not a public
; admission/reachability or physical persistence witness.
(in-package "ACL2")
(include-book "retirement-live-unit")
(defun fn2-crsr-get (batch fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (code row)
  (fn2-commit-directory-predecessor-seal-slot batch 1 fn2-commit-root) (mv code row)))
(defun fn2-crsr-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init (fn2-b-test-profile *fn2-profile-tiny* 0) fn2-core))
      (id (fn2-machine-kind-base *fn2-commit-kind* fn2-core))
      ((mv next allowed fn2-core)
       (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (next allowed fn2-commit-root)
        (b* ((next (fn2-commit-root-rows fn2-commit-root)) (base (- next 1))
             (fn2-commit-root (fn2-commit-root-put 0 (base-batch base) (base-ready 1)
               (installed base) (published base) (proposed base) (first-key 1)))
             (fn2-commit-root (fn2-commit-root-put 1 (parent 0) (members 1) (seal-ready 1)))
             ((mv code row) (fn2-commit-directory-new-row next fn2-commit-root)))
         (mv next (and (eq code :ok) (= row 1)) fn2-commit-root))
        (mv next allowed fn2-core)))
      (fn2-core (fn2-commit-put-core id (batch-no next) (first-key 1) (member-count 1)))
      (whole-antecedent (and allowed (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
                             (fn2-commit-idp id fn2-core)))
      (fn2-core (fn2-commit-prepare-root id fn2-core))
      ((mv after &) (fn2-crsr-get next fn2-core))
      ; Hypothesis-removal witness: the old ready bit is the only changed
      ; decision input. This is the constructor effect without its new reset.
      (fn2-core (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (fn2-commit-root)
                  (fn2-commit-root-set-seal-ready 1 1 fn2-commit-root) fn2-core))
      ((mv without-reset &) (fn2-crsr-get next fn2-core)))
  (mv (and whole-antecedent (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
           (not (fn2-core-stopped-p fn2-core)) (eq after :more) (eq without-reset :ok)) fn2-core)))
(defun fn2-crsr-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (answer fn2-core) (fn2-crsr-body fn2-core) answer)))
(assert-event (fn2-crsr-test))

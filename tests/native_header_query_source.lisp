(in-package "ACL2")
(defun fix (x) (if (numberp x) x 0))
(defun true-listp (x) (if (consp x) (true-listp (cdr x)) (null x)))
(defun fn-ag-rev-onto (x y) (revappend x y))
(defun fn-ag-less (x y) (< x y))
(defun fn-ng-less-equal (x y) (<= x y))
(defun fn-ng-len (x) (len x))
(defun fn-ng-integerp (x) (integerp x))
(defun fn-ng-char-code (x) (char-code x))
(defun fn-cbor-octet-listp (xs) (and (true-listp xs) (every #'fn-octetp xs)))
(defun fn-octet-listp (xs) (fn-cbor-octet-listp xs))
(defun fn-cbor-at-mostp (xs n) (<= (length xs) n))
(defun header-load-source-constants (path)
  (with-open-file (in path)
    (loop for form = (read in nil :end) until (eq form :end)
          when (and (consp form) (eq (car form) 'defconst))
          do (eval (cons 'defparameter (cdr form))))))
(header-load-source-constants "books/article.lisp")
(source-load-defuns "books/article.lisp")
(header-load-source-constants "books/nov-fields.lisp")

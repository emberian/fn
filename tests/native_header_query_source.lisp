(defvar *header-cold-at* nil)
(defvar *header-cold-fired* nil)
(defun fn-arena-get (h at arena)
  (when (and *header-cold-at* (= at *header-cold-at*) (not *header-cold-fired*))
    (setq *header-cold-fired* t)
    (throw 'header-cold :cold))
  (nth at (nth h arena)))
(defvar *header-checks* 0)
(defun header-check (x) (incf *header-checks*) (unless x (error "header check ~d failed" *header-checks*)))
(defun header-query-run (payload field fuel)
  (let* ((arena (list payload)) (cursor (fn-lhq-begin 0 (length payload) :captured-pin field))
         (*header-cold-at* 4) (*header-cold-fired* nil))
    (loop while (eq (fn-lhq-verdict cursor) :yield) do
      (let ((old cursor))
        (let ((r (catch 'header-cold (multiple-value-list (fn-lhq-tick cursor fuel arena)))))
          (if (eq r :cold) (header-check (eq old cursor))
            (progn (header-check (<= (second r) fuel)) (setq cursor (first r)))))
        (header-check (fn-lhq-ready-p cursor arena))
        (let ((parser (first cursor)))
          (header-check (and (= (fn-lpc-at 0 parser) 0)
                             (= (fn-lpc-at 1 parser) (length payload))
                             (eq (fn-lpc-at 2 parser) :captured-pin))))))
    (let* ((*header-cold-at* nil)
           (reference (fn-nntp-hdr-content field (list "<header@example>" 0) arena))
           (span (fn-lhq-field cursor)))
      (header-check (eq (fn-lhq-verdict cursor) (if (eq (car reference) :ok) :valid :invalid)))
      (when (eq (car reference) :ok)
        (let ((out nil))
          (when span
            (header-check (eq (fourth span) :captured-pin))
            (let ((at (second span)) (left (third span)) (pending nil)
                  (*header-cold-at* (+ 1 (second span))) (*header-cold-fired* nil))
              (loop while (or (plusp left) pending) do
                (let ((old-at at) (old-left left) (old-pending pending))
                  (let ((r (catch 'header-cold
                             (multiple-value-list (fn-nsw-step 0 at left pending fuel arena)))))
                    (if (eq r :cold)
                        (header-check (and (= at old-at) (= left old-left)
                                           (eq pending old-pending)))
                      (destructuring-bind (part next rest carry used) r
                        (header-check (<= used fuel)) (header-check (<= (length part) fuel))
                        (setq out (append out part) at next left rest pending carry))))))))
          (header-check (equal out (second reference))))))
    cursor))
(dolist (payload
         (list (append (bytes "Subject: hello") '(13 10) (bytes "X-Custom: one") '(13 10)
                       (bytes "X-Custom: ignored") '(13 10 13 10) (bytes "body") '(13 10))
               (append (bytes "X-Custom:") '(13 10 32) (bytes "first") '(13 10 9)
                       (bytes "folded") '(13 10 13 10 0 13 10))
               (append (bytes "X-Custom: ") (loop repeat 50 append
                          (append (make-list 200 :initial-element 65) '(13 10 9)))
                       (bytes "last") '(13 10 13 10))
               (append (bytes "X-Custom: good") '(13 10) (bytes "Malformed") '(13 10 13 10))
               (append (bytes "X-Custom: ") (make-list 999 :initial-element 65) '(13 10 13 10))
               (append (bytes "X-Custom: bad") '(10 13 10))
               (append (bytes "X-Custom: good") '(13 10 13 10 65 10))
               (append (bytes "X-Custom: good") '(13 10 13 10 65))))
  (dolist (field (list (bytes "x-custom") (bytes "X-CuStOm") (bytes "subject") (bytes "missing")))
    (dolist (fuel '(1 3 4096)) (header-query-run payload field fuel))))
(format t "header query actual-source PASS checks=~d~%" *header-checks*)

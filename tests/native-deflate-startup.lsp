;;; Evaluate the actual startup function with only its external leaves stubbed.
;;; No ACL2 image, compiler, native library, listener or subprocess is started.
;;; sbcl --script tests/native-deflate-startup.lsp [host/compress.lisp]
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(defvar *decision* :off)
(defvar *selected* nil)
(defvar *exit-code* 0)
(defvar *events* nil)
(defun settings-stub (profile)
 (assert (eq profile :opaque-profile))
 (values *decision* 101 103 107 109 113))
(defun getenv-stub (name)
 (assert (equal name "FN2_DEFLATE_LIBRARY")) *selected*)
(defun prepare-stub (program arguments &key search wait output error)
 (assert (equal program "python3"))
 (assert (equal (subseq arguments 0 2) '("tools/fn_admin.py" "__prepare-native-deflate")))
 (assert (= (length arguments) 3))
 (assert (and search wait (eq output *standard-output*) (eq error *error-output*)))
 (push (list :prepare (third arguments)) *events*)
 :prepared)
(defun exit-stub (process) (assert (eq process :prepared)) *exit-code*)
(defun load-stub (path) (push (list :load path) *events*) path)
(with-open-file (source (or (second sb-ext:*posix-argv*) "host/compress.lisp"))
 (loop for form = (read source nil nil) while form
       when (and (consp form) (eq (car form) 'defun)
                 (eq (cadr form) 'fn2-native-compress-settings))
       do (eval (sublis '((fn2-host-compress-settings . settings-stub)
                         (sb-ext:posix-getenv . getenv-stub)
                         (sb-ext:run-program . prepare-stub)
                         (sb-ext:process-exit-code . exit-stub)
                         (sb-alien:load-shared-object . load-stub)) form))))
(assert (fboundp 'fn2-native-compress-settings))
(dolist (decision '(:off :bounds))
 (let ((*decision* decision) (*events* nil))
  (assert (equal (multiple-value-list (fn2-native-compress-settings :opaque-profile))
                 (list decision 101 103 107 109 113)))
  (assert (null *events*))))
(dolist (path '(nil "build/custom artifacts/exact carrier.so"))
 (let* ((*decision* :ok) (*selected* path) (*events* nil)
        (expected (or path #+darwin "build/lib/libfn2-deflate.dylib" #-darwin "build/lib/libfn2-deflate.so")))
  (assert (equal (multiple-value-list (fn2-native-compress-settings :opaque-profile))
                 '(:ok 101 103 107 109 113)))
  (assert (equal (reverse *events*) (list (list :prepare expected) (list :load expected))))))
(let ((*decision* :ok) (*selected* "build/exact.so") (*exit-code* 2) (*events* nil))
 (assert (handler-case (progn (fn2-native-compress-settings :opaque-profile) nil) (error () t)))
 (assert (equal *events* '((:prepare "build/exact.so")))))
(format t "DEFLATE STARTUP PASS: off/refused skip; admitted default/custom build then exact load; failure refuses load.~%")

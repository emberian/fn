; Actual rolling SOURCE -> owned page -> reused SOURCE context -> manifest.
; Observe actual ROOT hash-keep reusing SOURCE after its digest is saved.
; The real manifest header must still name the retained original commitment.
; Stop at header encoding; this assertion does not claim accepted publication.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "manifest-binding-served-unit")
(defconst *fn2-uslt-profile*
 (put-assoc-equal :aturn 1
  (put-assoc-equal :k 1 (put-assoc-equal :x 1 *fn2-mbs-profile*))))
(defconst *fn2-uslt-source*
 (append '("From: a@example.invalid" "Subject: retained source" "Newsgroups: local.test" "")
         (make-list 220 :initial-element *fn2-mbs-a-line*)))
(defun fn2-uslt-read (n slot gen off owner ogen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix n)))
 (if (zp n) nil
  (cons (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (b)
         (mv-let (ok b) (fn2-gram-read slot gen off *fn2-upload-kind* owner ogen fn2-pool)
          (if ok b 999)) b)
        (fn2-uslt-read (- n 1) slot gen (+ 1 off) owner ogen fn2-core))))
(defun fn2-uslt-write (n slot gen off owner ogen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix n)))
 (if (zp n) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen off 99 *fn2-upload-kind* owner ogen fn2-core)
   (if (eq code :ok) (fn2-uslt-write (- n 1) slot gen (+ 1 off) owner ogen fn2-core)
    (mv code fn2-core)))))
(defun fn2-uslt-await (fuel target accepted clients store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (let ((id (fn2-machine-kind-base *fn2-upload-kind* fn2-core)))
  (cond ((and (eq (fn2-upload-snapshot-read-code id fn2-core) :ok)
              (case target
               (:source (and (equal (fn2-upload-row-phase id fn2-core) *fn2-upload-state-stream-final*)
                             (equal (fn2-upload-row-mstep id fn2-core) 0)))
               (:header (equal (fn2-upload-row-phase id fn2-core) *fn2-upload-state-stream-repack*))
               (:root-reused
                (and (equal (fn2-upload-row-phase id fn2-core) *fn2-upload-state-stream-root-write*)
                     (equal (fn2-upload-row-munit id fn2-core) 0)
                     (equal (fn2-upload-row-mstep id fn2-core) 1)))
               (:stored (and (equal (fn2-upload-row-phase id fn2-core) *fn2-upload-state-stream-final*)
                             (equal (fn2-upload-row-mstep id fn2-core) 1)))
               (otherwise nil)))
         (mv :cut accepted clients store fn2-core))
        ((zp fuel) (mv :fuel accepted clients store fn2-core))
        ((not (equal (fn2-core-stop-reason fn2-core) 0)) (mv :stop accepted clients store fn2-core))
        (t (b* (((mv & & & & fn2-core) (fn2-turn fn2-core))
                 ((mv & accepted clients store fn2-core) (fn2-cw-adapter-one accepted clients store fn2-core)))
             (fn2-uslt-await (- fuel 1) target accepted clients store fn2-core))))))
(defun fn2-uslt-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-uslt-profile* :echo nil fn2-core))
      ((mv ec fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      (source (fn2-cw-crlf-octets *fn2-uslt-source*))
      (post (fn2-cw-crlf-octets (append '("POST") *fn2-uslt-source* '("." "QUIT"))))
      ((mv source-cut accepted clients store fn2-core)
       (fn2-uslt-await 200000 :source 0 (fn2-cw-clients (list (list post (list (len post))))) nil fn2-core))
      ((unless (and (eq ec :ok) (eq source-cut :cut))) (mv nil fn2-core))
      (owner (fn2-machine-kind-base *fn2-upload-kind* fn2-core))
      (ogen (fn2-machine-generation owner fn2-core))
      (page (fn2-upload-row-lslot owner fn2-core)) (pgen (fn2-upload-row-lgen owner fn2-core))
      (unsaved (fn2-uslt-read 32 page pgen *fn2-upload-page-source* owner ogen fn2-core))
      (antecedent (and (= (fn2-upload-row-stored-hashed owner fn2-core)
                           (+ (fn2-upload-row-ilen owner fn2-core)
                              (fn2-upload-row-hashed owner fn2-core)))
                       (= (fn2-upload-row-stream-eof owner fn2-core) 1)
                       (= (fn2-upload-row-stream-stored-finalized owner fn2-core) 1)
                       (= (fn2-upload-row-word owner fn2-core) 0)
                       (= (fn2-upload-row-lease owner fn2-core) *fn2-upload-lease-held*)))
      ((mv stale-owner fn2-core) (fn2-upload-stream-source-final owner (+ 1 ogen) fn2-core))
      (stage-kept (and antecedent (eq stale-owner :fault)
                       (equal unsaved (fn2-uslt-read 32 page pgen *fn2-upload-page-source* owner ogen fn2-core))
                       (= (fn2-upload-row-mstep owner fn2-core) 0)))
      ((mv cut accepted clients store fn2-core)
       (fn2-uslt-await 200000 :stored accepted clients store fn2-core))
      ((unless (eq cut :cut)) (mv nil fn2-core))
      (id (fn2-machine-kind-base *fn2-upload-kind* fn2-core))
      (gen (fn2-machine-generation id fn2-core))
      (ls (fn2-upload-row-lslot id fn2-core)) (lg (fn2-upload-row-lgen id fn2-core))
      (hashed (fn2-upload-row-hashed id fn2-core))
      (ilen (fn2-upload-row-ilen id fn2-core))
      (original (fn2-uslt-read 32 ls lg *fn2-upload-page-source* id gen fn2-core))
      (stored (fn2-uslt-read 32 ls lg *fn2-upload-page-stored-source* id gen fn2-core))
      (prefix (fn2-uslt-read ilen ls lg 0 id gen fn2-core))
      ((unless (and (posp ilen) (= hashed (len source))
                    (= (fn2-upload-row-stored-hashed id fn2-core) (+ ilen hashed))
                    (fn2-am-manifestp (+ ilen hashed))
                    (equal original (fn-blake3 source))
                    (equal stored (fn-blake3 (append prefix source)))
                    (not (equal original stored)))) (mv nil fn2-core))
      ((mv stale fn2-core) (fn2-upload-stream-source-final id (+ 1 gen) fn2-core))
      (kept (and (eq stale :fault)
                  (equal original (fn2-uslt-read 32 ls lg *fn2-upload-page-source* id gen fn2-core))
                  (equal stored (fn2-uslt-read 32 ls lg *fn2-upload-page-stored-source* id gen fn2-core))))
      ((mv header accepted clients store fn2-core) (fn2-uslt-await 200000 :header accepted clients store fn2-core))
      (mfill (fn2-upload-row-mfill id fn2-core))
      ((mv decoded source-slot source-gen source-off fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
        (code slot gen off fn2-fields)
        (mv-let (code next fn2-fields)
         (fn2-am-get-header 0 (+ ilen hashed) ls lg *fn2-upload-page-manifest*
                            (+ *fn2-upload-page-manifest* mfill)
                            *fn2-upload-kind* id gen fn2-fields fn2-pool)
         (declare (ignore next))
         (mv code (fn2-fields-ref-slot *fn2-format-source-manifest-header-field-source-identity* fn2-fields)
                  (fn2-fields-ref-gen *fn2-format-source-manifest-header-field-source-identity* fn2-fields)
                  (fn2-fields-ref-off *fn2-format-source-manifest-header-field-source-identity* fn2-fields) fn2-fields))
        (mv code slot gen off fn2-core)))
      ;; No test mutator: the real ROOT keep operation resets/reuses SOURCE
      ;; and advances mstep to1, while its result waits privately for store.
      ((mv reused & & & fn2-core)
       (fn2-uslt-await 200000 :root-reused accepted clients store fn2-core)))
  (mv (and stage-kept kept (eq reused :cut) (eq header :cut) (eq decoded :ok)
           (equal (fn2-uslt-read 32 source-slot source-gen source-off id gen fn2-core) original)
           (equal stored (fn2-uslt-read 32 ls lg *fn2-upload-page-stored-source* id gen fn2-core))
           (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))) fn2-core)))
(assert-event
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-uslt-body fn2-core) ok)))

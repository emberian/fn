; Compare actual source events; ACL2 admission is the frame proof gate.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defun book-forms (path)
 (with-open-file (in path) (loop for x = (read in nil :eof) until (eq x :eof) collect x)))
(defparameter *locals* '(fn2-id-query-mask-natp fn2-id-query-mask-bound
                        fn2-id-query-qwake-of-set-qmask fn2-id-query-qwake-of-set-qwake))
(defun addedp (x)
 (and (consp x) (eq (car x) 'local) (consp (cadr x))
      (member (cadadr x) *locals*)))
(defun without-guard-hints (x)
 (cond ((atom x) x)
       ((eq (car x) 'xargs)
        (cons 'xargs (loop for (key value) on (cdr x) by #'cddr
                     unless (eq key :guard-hints) append (list key value))))
       (t (mapcar #'without-guard-hints x))))
(defparameter *old* (book-forms (sb-ext:posix-getenv "FN_BIND_BASELINE")))
(defparameter *new* (book-forms "books/machines-c-bind.lisp"))
(defparameter *groups-old* (book-forms (sb-ext:posix-getenv "FN_GROUPS_BASELINE")))
(defparameter *groups-new* (book-forms "books/machines-c-groups.lisp"))
(assert (= (count-if #'addedp *new*) 4))
(let ((mutation (sb-ext:posix-getenv "FN_BIND_MUTATION")))
 (cond ((equal mutation "runtime")
        (setf (car (last (find 'fn2-id-query-release *new* :key #'cadr))) nil))
       ((equal mutation "hyps")
        (let ((shape (find-if (lambda (x) (and (eq (car x) 'fn2-idc-fn-shape)
                                              (eq (cadr x) 'fn2-id-query-release))) *new*)))
         (setf (nth 4 shape) '(fn2-id-decides))))
       ((equal mutation "guard")
        (let* ((fn (find 'fn2-succ-release *new* :key #'cadr)) (xargs (cadr (nth 3 fn))))
         (setf (getf (cdr xargs) :guard) nil)))
       ((equal mutation "group-guard")
        (let* ((fn (find 'fn2-id-decide-step *groups-new* :key #'cadr)) (xargs (cadr (nth 3 fn))))
         (setf (getf (cdr xargs) :guard) nil)))
       ((equal mutation "frame")
        (let* ((local (find-if (lambda (x) (and (addedp x)
                          (eq (cadadr x) 'fn2-id-query-qwake-of-set-qwake))) *new*)))
         (setf (caddr (cadr local)) '(equal wrong-observation v))))))
(assert (string= (prin1-to-string (mapcar #'without-guard-hints *old*))
 (prin1-to-string (mapcar #'without-guard-hints (remove-if #'addedp *new*)))))
(assert (string= (prin1-to-string (mapcar #'without-guard-hints *groups-old*))
                 (prin1-to-string (mapcar #'without-guard-hints *groups-new*))))
(dolist (spec '((fn2-id-query-qwake-of-set-qmask
                (equal (fn2-id-decides-qwake tx (fn2-id-decides-set-qmask i v fn2-id-decides))
                       (fn2-id-decides-qwake tx fn2-id-decides)))
               (fn2-id-query-qwake-of-set-qwake
                (equal (fn2-id-decides-qwake tx (fn2-id-decides-set-qwake tx v fn2-id-decides)) v))))
 (let ((form (find-if (lambda (x) (and (addedp x) (eq (cadadr x) (car spec)))) *new*)))
  (assert (equal (caddr (cadr form)) (cadr spec)))))
; These must remain the only original declaration changes, all proof hints.
(loop for old in (list *old* *groups-old*)
      for new in (list (remove-if #'addedp *new*) *groups-new*)
      for expected in '((fn2-succ-release) (fn2-id-decide-start fn2-id-decide-step)) do
 (assert (equal (loop for a in old for b in new
                     unless (string= (prin1-to-string a) (prin1-to-string b)) collect (cadr b))
                expected)))
(format t "QUERY WAKE FRAME CONTROLS PASS~%")

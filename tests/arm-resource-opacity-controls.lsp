(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun remove-eq (x xs) (remove x xs))
(defun member-eq (x xs) (member x xs))
(defun assoc-eq (x xs) (assoc x xs))
(defun getpropc (name property default world)
 (getf (cdr (assoc name (getf world :properties))) property default))
(defun table-alist (name world) (declare (ignore name)) (getf world :sigs))
; Fixture world already provides the logical body call set; ACL2's ALL-FNNAMES
; supplies this in the real retained-world diagnostic, which checks full H/C.
(defun all-fnnames (body) body)
(with-open-file (in "books/machine-arms.lisp")
 (loop for form = (read in nil :eof) until (eq form :eof) do
  (when (and (eq (car form) 'defun)
             (member (cadr form) '(fn2-arms-sig fn2-arms-resource-stobj-callees fn2-arms-resource-callees)))
   (eval form))))
(let* ((world '(:sigs ((report (table fn2-pool) nil 4)
                       (issuer (table fn2-pool fn2-ops) nil 4))
                :properties ((report unnormalized-body (report reserve classify write add) stobjs-in (nil table fn2-pool))
                             (issuer unnormalized-body (reserve classify))
                             (reserve stobjs-in (nil fn2-pool))
                             (classify stobjs-in (fn2-pool))
                             (write stobjs-in (nil table))
                             (add stobjs-in (nil nil))))))
 (assert (equal (fn2-arms-resource-callees 'report world) '(reserve classify write)))
 (assert (null (fn2-arms-resource-callees 'issuer world))))
(format t "BT RESOURCE OPACITY SOURCE CONTROLS PASS~%")

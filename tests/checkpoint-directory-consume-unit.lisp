(defun fn2-dcu-sources (i mode fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints fn2-commit-root)
 (declare (xargs :stobjs (fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints fn2-commit-root)
  :measure (nfix (- 3 (nfix i))) :verify-guards nil))
 (if (>= (nfix i) 3) (mv t fn2-extents fn2-alloc-edges fn2-commit-root)
  (b* (((mv reserve e epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
       (batch (+ 1 i))
       ((mv commit fn2-extents) (fn2-alloc-commit-allocation e epoch allocation *fn2-commit-kind* batch fn2-extents))
       ((mv pin fn2-extents fn2-alloc-edges) (fn2-alloc-edge-add (+ 7 (* 2 e)) batch e epoch allocation :installed-root fn2-extents fn2-alloc-edges))
       ((mv source fn2-extents fn2-alloc-edges)
        (if (and (= i 0) (not (eq mode :hold)))
            (fn2-alloc-edge-add (fn2-checkpoint-source-edge 0 e fn2-extents fn2-ops fn2-checkpoints)
             9 e epoch allocation :selectable-checkpoint fn2-extents fn2-alloc-edges)
          (mv :ok fn2-extents fn2-alloc-edges)))
       (fn2-commit-root (fn2-commit-root-put batch (parent i) (extent e) (first-key batch) (members 1) (seal-ready 1)))
       ((mv tail fn2-extents fn2-alloc-edges fn2-commit-root)
        (fn2-dcu-sources (+ 1 i) mode fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints fn2-commit-root)))
   (mv (and (eq reserve :ok) (eq commit :ok) (eq pin :ok) (eq source :ok) tail)
       fn2-extents fn2-alloc-edges fn2-commit-root))))
(defun fn2-dcu-body (mode fn2-directory-rebase fn2-checkpoint-summary-authority fn2-csnapshot fn2-checkpoint-publication

      (fn2-commit-root (fn2-commit-root-put 0 (installed 3) (published 3) (proposed 3) (first-key 4)))
      (fn2-csnapshot (fn2-csnapshot-put 0 (phase *fn2-csnapshot-phase-held*) (token 9)
       (owner-kind 7) (owner-slot 0) (owner-gen 1) (cut-commit 1) (cut-event 1)))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-put 0
       (phase *fn2-checkpoint-publication-phase-complete*) (has-base 1) (active-bank 0)
       (base-checkpoint 9) (base-history 37) (base-incarnation 41)
       (bank0-valid 1) (bank0-candidate 0) (bank0-checkpoint 9) (bank0-history 37) (bank0-incarnation 41)))
      (fn2-extents (update-fn2-alloc-freeze-phase 2 fn2-extents))

(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun member-eq (x xs) (member x xs :test #'eq))
(defun intern-in-package-of-symbol (s x) (intern s (symbol-package x)))
(defun load-selected (path names)
 (with-open-file (in path)
  (loop for f = (read in nil :eof) until (eq f :eof) do
   (when (and (consp f) (member (car f) '(defun defmacro)) (member (cadr f) names)) (eval f)))))
(defun wrapper-calls (path)
 (with-open-file (in path)
  (loop for f = (read in nil :eof) until (eq f :eof)
   when (and (consp f) (eq (car f) 'fn2-issue-children-wrapper)) collect f)))
(load-selected "books/columns.lisp" '(fn2-columns-sym fn2-columns-preservation-facts))
(defun fn2-decl-get (key plist) (getf plist key))
(load-selected (second sb-ext:*posix-argv*) '(fn2-issue-children-wrapper))
(let* ((current (wrapper-calls "books/arm-children.lisp"))
       (legacy (mapcar (lambda (f) (subseq f 0 15)) current))
       (before (mapcar #'macroexpand-1 legacy)))
 (load-selected (or (third sb-ext:*posix-argv*) "books/arm-children.lisp") '(fn2-issue-children-wrapper))
 (assert (equal before (mapcar #'macroexpand-1 legacy)))
 (loop for call in current for old in before for new = (macroexpand-1 call) do
  (let ((added (remove-if-not (lambda (f) (and (consp f) (eq (car f) 'fn2-pool-preserves) (member :specs f))) (cdr new))))
   (assert (= (length added) (if (getf (nthcdr 15 call) :rows) 1 0)))
   (let ((checks (remove-if-not (lambda (f) (and (consp f) (eq (car f) 'assert-event))) (cdr new))))
    (assert (= (length checks) (length added)))
    (dolist (check checks)
     (assert (equal check `(assert-event (eq (nth 3 (getpropc ',(second call) 'stobjs-out nil (w state))) 'fn2-pool)))))
    (assert (equal old (remove-if (lambda (f) (or (member f added :test #'equal) (member f checks :test #'equal))) new))))
   (dolist (event added)
    (let* ((name (second event)) (args (third event)) (specs (getf (cdddr event) :specs))
           (facts (fn2-columns-preservation-facts name (cons name args) specs nil nil)))
     (assert (equal (third (car facts)) `(equal (fn2-pool-rows (mv-nth 3 (,name ,@args))) (fn2-pool-rows fn2-pool)))))))))
(format t "STORAGE ROW DIMENSION SOURCE CONTROLS PASS~%")

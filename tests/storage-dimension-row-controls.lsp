(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defconstant hard 'hard)
(defun len (xs) (length xs))
(defun member-eq (x xs) (member x xs :test #'eq))
(defun subsetp-eq (xs ys) (subsetp xs ys :test #'eq))
(defun no-duplicatesp-eq (xs) (equal xs (remove-duplicates xs :test #'eq)))
(defun nfix (x) (if (and (integerp x) (<= 0 x)) x 0))
(defun true-listp (xs) (or (null xs) (and (consp xs) (true-listp (cdr xs)))))
(defun er (&rest args) (error "~S" args))
(defun getpropc (name key default world) (let ((p (assoc key (cdr (assoc name world))))) (if p (cdr p) default)))
(defun intern-in-package-of-symbol (s x) (intern s (symbol-package x)))
(defun fn2-decl-get (key plist) (getf plist key))
(defun load-selected (path names)
 (with-open-file (in path)
  (loop for f = (read in nil :eof) until (eq f :eof) do
   (when (and (consp f) (member (car f) '(defun defmacro)) (member (cadr f) names)) (eval f)))))
(defun wrapper-calls (path)
 (with-open-file (in path)
  (loop for f = (read in nil :eof) until (eq f :eof)
   when (and (consp f) (eq (car f) 'fn2-issue-children-wrapper)) collect f)))
(load-selected "books/columns.lisp" '(fn2-columns-sym fn2-columns-preservation-facts))
(load-selected (or (fourth sb-ext:*posix-argv*) "books/pool-dimensions.lisp") '(fn2-pool-dimension-specs fn2-pool-output-position fn2-pool-dimension-events))
(load-selected (second sb-ext:*posix-argv*) '(fn2-issue-children-wrapper))
(let* ((current (wrapper-calls "books/arm-children.lisp"))
       (legacy (mapcar (lambda (f) (subseq f 0 15)) current))
       (before (mapcar #'macroexpand-1 legacy)))
 (load-selected (or (third sb-ext:*posix-argv*) "books/arm-children.lisp") '(fn2-issue-children-wrapper))
 (assert (equal before (mapcar #'macroexpand-1 legacy)))
 (loop for call in current for old in before for new = (macroexpand-1 call) do
  (let ((added (remove-if-not (lambda (f) (and (consp f) (eq (car f) 'fn2-pool-dimensions))) (cdr new))))
   (assert (= (length added) (if (getf (nthcdr 15 call) :dimensions) 1 0)))
   (assert (equal old (remove-if (lambda (f) (member f added :test #'equal)) new)))
   (dolist (event added)
    (let* ((name (second event)) (args (third (second new)))
           (world `((,name (formals . ,args)
                          (stobjs-in . ,(mapcar (lambda (x) (and (member x '(fn2-pool fn2-ops fn2-control)) x)) args))
                          (stobjs-out nil nil nil fn2-pool fn2-ops fn2-control)
                          (unnormalized-body . actual-logical-body))))
           (facts (fn2-pool-dimension-events name (getf (cddr event) :observations) nil nil world)))
     (assert (= (length facts) 2))
     (loop for fact in facts for observation in '(fn2-pool-rows fn2-pool-data-length) do
      (assert (equal (third fact) `(equal (,observation (mv-nth 3 (,name ,@args))) (,observation fn2-pool)))))
     (dolist (property '(stobjs-in stobjs-out unnormalized-body))
      (let ((invalid (copy-tree world)))
       (setf (cdr (assoc property (cdr (assoc name invalid)))) nil)
       (assert (handler-case (progn (fn2-pool-dimension-events name '(:rows :data) nil nil invalid) nil) (error () t)))))
     (dolist (bad '((:rows :rows) (:unknown) nil))
      (assert (handler-case (progn (fn2-pool-dimension-events name bad nil nil world) nil) (error () t))))))))
)
(format t "STORAGE DIMENSION SOURCE CONTROLS PASS~%")

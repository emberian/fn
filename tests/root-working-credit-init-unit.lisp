; Actual current node initializer, not a synthetic tiny configuration.
; Source-prepared only; assertions are not an execution/certification claim.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/node-profile")
(include-book "pool-credit-unit")
(make-event
 (value `(defconst *fn2-rwciu-b-rows*
           ,(fn2-machine-property 'fn2-commit :capacity (w state)))))
(defun fn2-rwciu-upload-classes (fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (with-local-stobj fn2-input-config
  (mv-let (classes fn2-input-config)
   (let ((fn2-input-config (fn2-input-config-from *fn2-node-profile* fn2-input-config)))
    (mv (fn2-checkpoint-service-upload-classes fn2-input-config fn2-pool) fn2-input-config)) classes)))
(defun fn2-rwciu-protected-classes (i fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil
  :measure (nfix (- (fn2-pool-nclasses fn2-pool) (nfix i)))))
 (if (not (and (natp i) (< i (nfix (fn2-pool-nclasses fn2-pool))))) nil
  (cons (cons (fn2-pool-credit-protectedi i fn2-pool) (fn2-pool-class-sizesi i fn2-pool))
        (fn2-rwciu-protected-classes (+ i 1) fn2-pool))))
(defun fn2-rwciu-protected-profile ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool
  (mv-let (profile fn2-pool)
   (b* ((fn2-pool (fn2-pool-init (fn2-profile-pool-classes *fn2-node-profile*)
                   (fn2-profile-generation-start *fn2-node-profile*)
                   (fn2-profile-generation-limit *fn2-node-profile*) fn2-pool))
        ((mv code fn2-pool) (fn2-checkpoint-working-credit-configure *fn2-node-profile*
          *fn2-rwciu-b-rows* (* *fn2-commit-write-resources* *fn2-rwciu-b-rows*)
          (fn2-checkpoint-service-protocol-classes fn2-pool)
          (fn2-rwciu-upload-classes fn2-pool) fn2-pool)))
    (mv (if (eq code :ok) (put-assoc-equal :pool-classes (fn2-rwciu-protected-classes 0 fn2-pool) *fn2-node-profile*) nil) fn2-pool)) profile)))
(defun fn2-rwciu-node-body (image fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (if image (fn2-image-profile *fn2-node-profile*) *fn2-node-profile*))
      ((unless (and (fn2-profilep profile) (fn2-core-profilep profile))) (mv nil fn2-core))
      (fn2-core (fn2-init-executor profile :null nil fn2-core))
      (stopped (fn2-core-stopped-p fn2-core)))
  (stobj-let ((fn2-commit (fn2-commit-table fn2-core))
              (fn2-commit-io (fn2-core-commit-io fn2-core))
              (fn2-pool (fn2-core-pool fn2-core))) (yes)
   (and (not stopped)
        (= (fn2-commit-rows fn2-commit) *fn2-rwciu-b-rows*)
        (= (fn2-commit-io-rows fn2-commit-io) (* *fn2-commit-write-resources* (fn2-commit-rows fn2-commit)))
        (if image
            (and (fn2-pool-credit-shapep fn2-pool)
                 (= (fn2-pool-credit-group-count fn2-pool) (+ 1 (fn2-allocation-release-credit-group (fn2-commit-rows fn2-commit))))
                 (fn2-pool-credit-fullp 0 0 fn2-pool)
                 (fn2-pool-credit-fullp 1 0 fn2-pool) (fn2-pool-credit-fullp 2 0 fn2-pool)
                 (fn2-pool-credit-fullp (fn2-allocation-release-credit-group (fn2-commit-rows fn2-commit)) 0 fn2-pool))
          (and (= (fn2-pool-credit-configured fn2-pool) 0) (= (fn2-pool-credit-group-count fn2-pool) 0))))
   (mv yes fn2-core))))
(defun fn2-rwciu-short-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (fn2-image-profile (fn2-rwciu-protected-profile)))
      ((unless (and (fn2-profilep profile) (fn2-core-profilep profile))) (mv nil fn2-core))
      (fn2-core (fn2-init-executor profile :null nil fn2-core))
      (reason (fn2-core-stop-reason fn2-core)))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))
              (fn2-id-engine (fn2-core-id-engine fn2-core))) (yes)
   (and (equal reason *fn2-stop-reason-engine-genesis*)
        (= (fn2-pool-credit-configured fn2-pool) 0)
        (= (fn2-id-engine-scratch 0 fn2-id-engine) 0)
        (= (fn2-id-engine-seq 0 fn2-id-engine) 0)
        (= (fn2-pool-free-count 0 fn2-pool) (caar (fn2-profile-pool-classes profile)))
        (= (fn2-pool-free-count 1 fn2-pool) (caadr (fn2-profile-pool-classes profile))))
   (mv yes fn2-core))))
(defun fn2-rwciu-node-run (image)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (yes fn2-core) (fn2-rwciu-node-body image fn2-core) yes)))
(defun fn2-rwciu-short-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (yes fn2-core) (fn2-rwciu-short-body fn2-core) yes)))
(assert-event (fn2-rwciu-node-run t))
(assert-event (fn2-rwciu-node-run nil))
(assert-event (fn2-rwciu-short-run))

; All actual byte requests may select one class. Count aliases as leases,
; not distinct class names; use the actual node's installed size/count data.
(defun fn2-rwciu-alias-body (fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (b* ((classes (fn2-profile-pool-classes *fn2-node-profile*))
      (fn2-pool (fn2-pool-init
        (list (cons (+ (caar classes) (caadr classes)) (cdadr classes)))
        (fn2-profile-generation-start *fn2-node-profile*)
        (fn2-profile-generation-limit *fn2-node-profile*) fn2-pool))
      (paths (fn2-checkpoint-service-protocol-classes fn2-pool))
      (uploads (fn2-rwciu-upload-classes fn2-pool))
      (antecedent (and (fn2-pool-wfp fn2-pool)
        (fn2-checkpoint-service-paths-fitp paths fn2-pool)
        (fn2-checkpoint-service-classes-fitp uploads fn2-pool)
        (equal paths '((0 0) (0 0 0))) (equal uploads '(0 0 0))))
      ((mv code fn2-pool) (fn2-checkpoint-working-credit-configure *fn2-node-profile*
        *fn2-rwciu-b-rows* (* *fn2-commit-write-resources* *fn2-rwciu-b-rows*) paths uploads fn2-pool)))
  (mv (and antecedent (eq code :ok) (fn2-pool-credit-shapep fn2-pool)
           (= (fn2-checkpoint-service-path-demand 0 paths) 3)
           (= (fn2-checkpoint-service-class-count 0 uploads) 3)
           (fn2-pool-credit-fullp 0 0 fn2-pool)) fn2-pool)))
(defun fn2-rwciu-alias-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool (mv-let (yes fn2-pool) (fn2-rwciu-alias-body fn2-pool) yes)))
(assert-event (fn2-rwciu-alias-run))

; Derive capacity for the SAME P and upload/storage envelope, removing only
; protocol actor ranges. Actual initialization must reject this profile before
; genesis rather than accepting a detached storage-only service budget.
(defun fn2-rwciu-service-classes (i service fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil
  :measure (nfix (- (nfix (fn2-pool-nclasses fn2-pool)) (nfix i)))))
 (if (not (and (natp i) (< i (nfix (fn2-pool-nclasses fn2-pool))))) nil
  (cons (cons (+ (fn2-pool-credit-protectedi i fn2-pool) (nfix (nth i service)))
              (fn2-pool-class-sizesi i fn2-pool))
        (fn2-rwciu-service-classes (+ i 1) service fn2-pool))))
(defun fn2-rwciu-without-protocol-profile ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool
  (mv-let (profile fn2-pool)
   (b* ((fn2-pool (fn2-pool-init (fn2-profile-pool-classes *fn2-node-profile*)
                   (fn2-profile-generation-start *fn2-node-profile*)
                   (fn2-profile-generation-limit *fn2-node-profile*) fn2-pool))
        (paths (fn2-checkpoint-service-protocol-classes fn2-pool))
        (uploads (fn2-rwciu-upload-classes fn2-pool))
        ((mv sc service) (fn2-checkpoint-service-demand-vector *fn2-node-profile* (list nil nil) uploads fn2-pool))
        ((mv code fn2-pool) (fn2-checkpoint-working-credit-configure *fn2-node-profile*
          *fn2-rwciu-b-rows* (* *fn2-commit-write-resources* *fn2-rwciu-b-rows*) paths uploads fn2-pool)))
    (mv (if (and (eq sc :ok) (eq code :ok))
            (put-assoc-equal :pool-classes (fn2-rwciu-service-classes 0 service fn2-pool) *fn2-node-profile*) nil)
        fn2-pool)) profile)))
(defun fn2-rwciu-protocol-short-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (fn2-image-profile (fn2-rwciu-without-protocol-profile)))
      ((unless (and (fn2-profilep profile) (fn2-core-profilep profile))) (mv nil fn2-core))
      (fn2-core (fn2-init-executor profile :null nil fn2-core))
      (reason (fn2-core-stop-reason fn2-core)))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))
              (fn2-id-engine (fn2-core-id-engine fn2-core))) (yes)
   (and (equal reason *fn2-stop-reason-engine-genesis*)
        (= (fn2-pool-credit-configured fn2-pool) 0)
        (= (fn2-id-engine-scratch 0 fn2-id-engine) 0)
        (= (fn2-id-engine-seq 0 fn2-id-engine) 0)
        (= (fn2-pool-free-count 0 fn2-pool) (caar (fn2-profile-pool-classes profile)))
        (= (fn2-pool-free-count 1 fn2-pool) (caadr (fn2-profile-pool-classes profile))))
   (mv yes fn2-core))))
(defun fn2-rwciu-protocol-short-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (yes fn2-core) (fn2-rwciu-protocol-short-body fn2-core) yes)))
(assert-event (fn2-rwciu-protocol-short-run))

; Actual image constructor with no NAME work cannot rely on incidental name
; staging to acquire the shared C scratch. Ordinary pressure later cannot take it.
(defun fn2-rwciu-exhaust-class (k class fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix k)))
 (if (zp k) fn2-pool
  (mv-let (code slot gen fn2-pool) (fn2-pool-reserve class 200 0 1 fn2-pool)
   (declare (ignore slot gen))
   (if (eq code :ok) (fn2-rwciu-exhaust-class (- k 1) class fn2-pool) fn2-pool))))
(defun fn2-rwciu-empty-names-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (fn2-image-profile
                (put-assoc-equal :groups nil (put-assoc-equal :authority 0 *fn2-node-profile*))))
      ((unless (and (fn2-profilep profile) (fn2-core-profilep profile)
                    (= (fn2-checkpoint-name-arena-count profile) 0))) (mv nil fn2-core))
      (fn2-core (fn2-init-executor profile :null nil fn2-core))
      (stopped (fn2-core-stopped-p fn2-core)))
  (stobj-let ((fn2-id-engine (fn2-core-id-engine fn2-core))
              (fn2-pool (fn2-core-pool fn2-core))) (yes fn2-id-engine fn2-pool)
   (b* ((slot (fn2-id-engine-slot 0 fn2-id-engine))
        (gen (fn2-id-engine-gen 0 fn2-id-engine))
        (class (fn2-pool-class-for *fn2-idc-scratch-bytes* fn2-pool))
        (owned (and (not stopped) (= (fn2-pool-credit-configured fn2-pool) 1)
                    (= (fn2-id-engine-seq 0 fn2-id-engine) 0)
                    (= (fn2-id-engine-scratch 0 fn2-id-engine) 1)
                    (eq (fn2-pool-workspace-code slot gen *fn2-idc-owner-kind*
                         *fn2-idc-owner-slot* *fn2-idc-owner-gen* fn2-pool) :ok)))
        (fn2-pool (fn2-rwciu-exhaust-class (fn2-pool-rows fn2-pool) class fn2-pool))
        (before (fn2-pcu-view fn2-pool))
        ((mv reused fn2-id-engine fn2-pool) (fn2-idc-scratch fn2-id-engine fn2-pool)))
    (mv (and owned (= (fn2-pool-reservable-count class fn2-pool) 0)
             (eq reused :ok) (= slot (fn2-id-engine-slot 0 fn2-id-engine))
             (= gen (fn2-id-engine-gen 0 fn2-id-engine))
             (equal before (fn2-pcu-view fn2-pool))
             (eq (fn2-pool-workspace-code slot gen *fn2-idc-owner-kind*
                  *fn2-idc-owner-slot* *fn2-idc-owner-gen* fn2-pool) :ok))
        fn2-id-engine fn2-pool))
   (mv yes fn2-core))))
(defun fn2-rwciu-empty-names-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (yes fn2-core) (fn2-rwciu-empty-names-body fn2-core) yes)))
(assert-event (fn2-rwciu-empty-names-run))

; Actual current node initializer, not a synthetic tiny configuration.
; Source-prepared only; assertions are not an execution/certification claim.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/node-profile")
(make-event
 (value `(defconst *fn2-rwciu-b-rows*
           ,(fn2-machine-property 'fn2-commit :capacity (w state)))))
(defun fn2-rwciu-protected-classes (i fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil
  :measure (nfix (- (fn2-pool-nclasses fn2-pool) (nfix i)))))
 (if (not (and (natp i) (< i (nfix (fn2-pool-nclasses fn2-pool))))) nil
  (cons (cons (fn2-pool-credit-protectedi i fn2-pool) (fn2-pool-class-sizesi i fn2-pool))
        (fn2-rwciu-protected-classes (+ i 1) fn2-pool))))
(defun fn2-rwciu-protected-profile ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool
  (mv-let (profile fn2-pool)
   (b* ((fn2-pool (fn2-pool-init (fn2-profile-pool-classes *fn2-node-profile*)
                   (fn2-profile-generation-start *fn2-node-profile*)
                   (fn2-profile-generation-limit *fn2-node-profile*) fn2-pool))
        ((mv code fn2-pool) (fn2-checkpoint-working-credit-configure *fn2-node-profile*
          *fn2-rwciu-b-rows* (* *fn2-commit-write-resources* *fn2-rwciu-b-rows*) fn2-pool)))
    (mv (if (eq code :ok) (put-assoc-equal :pool-classes (fn2-rwciu-protected-classes 0 fn2-pool) *fn2-node-profile*) nil) fn2-pool)) profile)))
(defun fn2-rwciu-node-body (image fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (if image (fn2-image-profile *fn2-node-profile*) *fn2-node-profile*))
      ((unless (and (fn2-profilep profile) (fn2-core-profilep profile))) (mv nil fn2-core))
      (fn2-core (fn2-init-executor profile :null nil fn2-core))
      (stopped (fn2-core-stopped-p fn2-core)))
  (stobj-let ((fn2-commit (fn2-commit-table fn2-core))
              (fn2-commit-io (fn2-core-commit-io fn2-core))
              (fn2-pool (fn2-core-pool fn2-core))) (yes)
   (and (not stopped)
        (= (fn2-commit-rows fn2-commit) *fn2-rwciu-b-rows*)
        (= (fn2-commit-io-rows fn2-commit-io) (* *fn2-commit-write-resources* (fn2-commit-rows fn2-commit)))
        (if image
            (and (fn2-pool-credit-shapep fn2-pool)
                 (= (fn2-pool-credit-group-count fn2-pool) (+ 1 (fn2-allocation-release-credit-group (fn2-commit-rows fn2-commit))))
                 (fn2-pool-credit-fullp 0 0 fn2-pool)
                 (fn2-pool-credit-fullp 1 0 fn2-pool) (fn2-pool-credit-fullp 2 0 fn2-pool)
                 (fn2-pool-credit-fullp (fn2-allocation-release-credit-group (fn2-commit-rows fn2-commit)) 0 fn2-pool))
          (and (= (fn2-pool-credit-configured fn2-pool) 0) (= (fn2-pool-credit-group-count fn2-pool) 0))))
   (mv yes fn2-core))))
(defun fn2-rwciu-short-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (fn2-image-profile (fn2-rwciu-protected-profile)))
      ((unless (and (fn2-profilep profile) (fn2-core-profilep profile))) (mv nil fn2-core))
      (fn2-core (fn2-init-executor profile :null nil fn2-core))
      (reason (fn2-core-stop-reason fn2-core)))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))
              (fn2-id-engine (fn2-core-id-engine fn2-core))) (yes)
   (and (equal reason *fn2-stop-reason-engine-genesis*)
        (= (fn2-pool-credit-configured fn2-pool) 0)
        (= (fn2-id-engine-scratch 0 fn2-id-engine) 0)
        (= (fn2-id-engine-seq 0 fn2-id-engine) 0)
        (= (fn2-pool-free-count 0 fn2-pool) (caar (fn2-profile-pool-classes profile)))
        (= (fn2-pool-free-count 1 fn2-pool) (caadr (fn2-profile-pool-classes profile))))
   (mv yes fn2-core))))
(defun fn2-rwciu-node-run (image)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (yes fn2-core) (fn2-rwciu-node-body image fn2-core) yes)))
(defun fn2-rwciu-short-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (yes fn2-core) (fn2-rwciu-short-body fn2-core) yes)))
(assert-event (fn2-rwciu-node-run t))
(assert-event (fn2-rwciu-node-run nil))
(assert-event (fn2-rwciu-short-run))

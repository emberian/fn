;;; Exercise the shipped developer profile parser, never a copied definition.
(require :sb-posix)
(require :sb-bsd-sockets)
(defpackage "ACL2" (:use "CL"))
(defpackage "ACL2_*1*_ACL2" (:use))
(in-package "ACL2")

(defvar *fnn-bp-profile-points* :unset)
(defvar +fnn-bp-profile-names+ nil)
(defvar *selector* nil)
(defvar *selector-calls* 0)
(defvar *diagnostics* nil)
(defun fnn-developer-selector (name)
  (assert (equal name "FN_BP_TEST_PROFILE"))
  (incf *selector-calls*)
  *selector*)
(defun fnn-err (control &rest args)
  (push (apply #'format nil control args) *diagnostics*))

(let ((missing (list 'fnn-bp-profile-parse 'fnn-bp-profile-points)))
  (with-open-file (stream "host/native/bp.lisp")
    (loop for form = (read stream nil :eof) until (eq form :eof)
          when (and (consp form) (eq (car form) 'defun)
                    (member (cadr form) missing))
            do (eval form) (setq missing (remove (cadr form) missing))))
  (when missing (error "BP profile forms not found: ~s" missing)))

(defun check-accepted (text expected)
  (assert (equal (multiple-value-list (fnn-bp-profile-parse text))
                 (list expected nil))))
(defun check-refused (text)
  ;; No handler swallows an error from a reader-evaluation payload.
  (multiple-value-bind (points reason) (fnn-bp-profile-parse text)
    (assert (null points))
    (assert (and (stringp reason) (plusp (length reason))))
    (let ((*fnn-bp-profile-points* :unset)
          (*selector* text) (*selector-calls* 0) (*diagnostics* nil))
      (assert (null (fnn-bp-profile-points)))
      (assert (null *fnn-bp-profile-points*))
      (assert (equal *diagnostics*
                     (list (format nil "FN_BP_TEST_PROFILE refused: ~a" reason))))
      (assert (not (find #\Newline (car *diagnostics*))))
      ;; A cached refusal must neither parse again nor log again.
      (assert (null (fnn-bp-profile-points)))
      (assert (= *selector-calls* 1))
      (assert (= (length *diagnostics*) 1)))))

(check-accepted "64 128 256" '(64 128 256))
(check-accepted "64,128" '(64 128))
(check-accepted " 8 , " '(8))
(check-accepted "0,0008 ,, 8 0" '(0 8 8 0))
(check-accepted "99999999999999999999,00000000000000000000" '(99999999999999999999 0))
(dolist (text '("" "  ," "#.(error \"evaluated\")" "12a" "-5"
                "123456789012345678901" "000000000000000000000"
                "64 12a" "64 #.(error \"evaluated\")" "+5" "1.0" "1/2"))
  (check-refused text))
(check-refused (format nil "1~c2" #\Tab))
(check-refused (format nil "1~c2" #\Newline))

;; The real profiler setup runs with an empty symbol set in this harness.
(let ((*fnn-bp-profile-points* :unset)
      (*selector* "64,128") (*selector-calls* 0) (*diagnostics* nil))
  (assert (equal (fnn-bp-profile-points) '(64 128)))
  (assert (equal (fnn-bp-profile-points) '(64 128)))
  (assert (= *selector-calls* 1))
  (assert (null *diagnostics*)))
(let ((*fnn-bp-profile-points* :unset)
      (*selector* nil) (*selector-calls* 0) (*diagnostics* nil))
  (assert (null (fnn-bp-profile-points)))
  (assert (null (fnn-bp-profile-points)))
  (assert (= *selector-calls* 1))
  (assert (null *diagnostics*)))
(format t "native BP profile parser passed~%")

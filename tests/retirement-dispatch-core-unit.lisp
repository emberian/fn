; Actual persisted lifecycle dispatcher controls over the bounded B instance.
; Publish phase, installed batch and successful IO flags below are explicit
; logical persisted-state fixture premises, not execution of physical IO.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "retirement-core-instance")
(include-book "../sim/commit-test-profile")

; The existing declaration-owned reference generator includes every field,
; row count and scalar extra field; no hand-written snapshot model.
(defun fn2-riud-projection-events (names world)
 (declare (xargs :verify-guards nil))
 (if (atom names) nil
  (let* ((name (car names))
         (schema (cdr (assoc-eq name (fn2-decl-rows :columns world))))
         (fields (append (fn2-columns-fields name (fn2-decl-get :columns schema))
                         `((,(fn2-columns-sym name "-ROWS") :type (integer 0 ,(- (fn2-decl-get :rows-bound schema) 1)) :initially 0))
                         (fn2-decl-get :extra-fields schema))))
   (append (fn2-columns-reference-events name (fn2-columns-sym name "-REF") fields)
           (fn2-riud-projection-events (cdr names) world)))))
(make-event
 (cons 'progn (fn2-riud-projection-events
               '(fn2-extents fn2-retirement-control fn2-alloc-edges) (w state))))
(defun fn2-riud-state (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
             (fn2-retirement-control (fn2-core-retirement-control fn2-core))
             (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (snapshot)
  (list (fn2-extents-copy fn2-extents)
        (fn2-retirement-control-copy fn2-retirement-control)
        (fn2-alloc-edges-copy fn2-alloc-edges)) snapshot))

(defun fn2-riud-body (removed fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init (fn2-b-test-profile *fn2-profile-tiny* 0) fn2-core))
      (owner (fn2-machine-kind-base *fn2-scribe-kind* fn2-core))
      (ogen (fn2-machine-generation owner fn2-core))
      ((mv reserved target epoch allocation fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)))
        (ok target epoch allocation fn2-extents)
        (b* (((mv begun fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
             ((mv held & target epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
             ((mv committed fn2-extents) (fn2-alloc-commit-allocation target epoch allocation 1 100 fn2-extents)))
         (mv (and (eq begun :ok) (eq held :ok) (eq committed :ok)) target epoch allocation fn2-extents))
        (mv ok target epoch allocation fn2-core)))
      ; A real owned durable protector predates intent. Retirement may
      ; persist while it remains held; physical release is a later operation.
      ((mv protected fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                   (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
        (code fn2-extents fn2-alloc-edges)
        (fn2-alloc-edge-add 0 50 target epoch allocation :obligation fn2-extents fn2-alloc-edges)
        (mv code fn2-core)))
      ; This actual producer selects the containing batch, packs the retained
      ; member bytes, binds intent, opens/joins and records the exact control.
      ((mv submitted batch event fn2-core)
       (fn2-retirement-submit target epoch allocation *fn2-scribe-kind* owner ogen fn2-core))
      ((mv pick id &) (fn2-commit-pick fn2-core))
      ((unless (and reserved (eq protected :ok) (eq submitted :ok) (eq pick :join)
                     (fn2-commit-idp id fn2-core) (posp batch) (posp event)
                     (= (fn2-machine-member-count id fn2-core) 1)
                     (= (fn2-machine-batch-no id fn2-core) batch)
                     (= (fn2-machine-first-key id fn2-core) event)))
       (mv nil fn2-core))
      (row (* *fn2-commit-members-per-batch* (fn2-commit-row id fn2-core)))
      (base (* 128 (fn2-commit-row id fn2-core)))
      ((mv found kind slot gen len okind oslot actual-ogen)
       (fn2-commit-member-ws row fn2-core))
      (bound (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))
                         (fn2-extents (fn2-core-extents fn2-core))) (bound)
        (and (< 0 (fn2-retirement-control-rows fn2-retirement-control))
             (= (fn2-retirement-control-state 0 fn2-retirement-control) *fn2-retirement-state-waiting*)
             (= (fn2-retirement-control-allocation-member 0 fn2-retirement-control) 0)
             (= (fn2-retirement-control-installation-member 0 fn2-retirement-control) 0)
             (= (fn2-retirement-control-slot 0 fn2-retirement-control) slot)
             (= (fn2-retirement-control-gen 0 fn2-retirement-control) gen)
             (= (fn2-retirement-control-batch 0 fn2-retirement-control) batch)
             (= (fn2-retirement-control-event 0 fn2-retirement-control) event)
             (= (fn2-retirement-control-owner-kind 0 fn2-retirement-control) okind)
             (= (fn2-retirement-control-owner-slot 0 fn2-retirement-control) oslot)
             (= (fn2-retirement-control-owner-gen 0 fn2-retirement-control) actual-ogen)
             (= (fn2-retirement-control-extent 0 fn2-retirement-control) target)
             (= (fn2-retirement-control-epoch 0 fn2-retirement-control) epoch)
             (= (fn2-retirement-control-allocation 0 fn2-retirement-control) allocation)
             (eq (fn2-alloc-handle-code target epoch allocation fn2-extents) :ok)
             (= (fn2-extents-state target fn2-extents) *fn2-extent-state-allocated*)
             (fn2-alloc-retirement-intentp target epoch allocation fn2-extents)
             (= (fn2-alloc-retirement-intent-batch fn2-extents) batch)) bound))
      ((unless (and found bound (= kind *fn2-commit-member-kind-txn*) (posp len)
                     (= okind *fn2-scribe-kind*) (= oslot owner) (= actual-ogen ogen)))
       (mv nil fn2-core))
      ((mv framed rkind bytes next fn2-core)
       (fn2-commit-txn-frame base slot gen 0 len okind oslot actual-ogen fn2-core))
      ((unless (and (eq framed :ok) (= rkind *record-kind-retirement*)
                     (< 0 next) (posp bytes) (= (+ next bytes) len)))
       (mv nil fn2-core))
      ((mv decoded-body fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
        (ok fn2-fields)
        (mv-let (decoded end fn2-fields)
         (fn2-format-retirement-decode base
          slot gen next (+ next bytes) okind oslot actual-ogen fn2-fields fn2-pool)
         (mv (and (eq decoded :ok) (= end len)
                   (= (fn2-fields-value (+ base *fn2-format-retirement-field-extent*) fn2-fields) target)
                   (= (fn2-fields-value (+ base *fn2-format-retirement-field-writer-epoch*) fn2-fields) epoch)
                   (= (fn2-fields-value (+ base *fn2-format-retirement-field-allocation*) fn2-fields) allocation)
                   (= (fn2-fields-value (+ base *fn2-format-retirement-field-retirement-commit*) fn2-fields) batch))
             fn2-fields))
        (mv ok fn2-core)))
      ((unless decoded-body) (mv nil fn2-core))
      ; Set the complete persisted dispatcher envelope only after validating
      ; the actual producer receipt. Each negative removes one premise below.
      (fn2-core (fn2-commit-put-core id (phase *fn2-commit-state-publish*)
                   (cb-deps-ok 1) (cb-log-ok 1) (cb-fence-ok 1) (cb-failed 0)))
      (fn2-core (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (fn2-commit-root)
                  (fn2-commit-root-set-installed 0 batch fn2-commit-root) fn2-core))
      (whole-envelope (and (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (same)
                             (and (< 0 (fn2-commit-root-rows fn2-commit-root))
                                  (= (fn2-commit-root-installed 0 fn2-commit-root) batch)) same)
                           (= (fn2-machine-phase id fn2-core) *fn2-commit-state-publish*)
                           (= (fn2-machine-cb-deps-ok id fn2-core) 1)
                           (= (fn2-machine-cb-log-ok id fn2-core) 1)
                           (= (fn2-machine-cb-fence-ok id fn2-core) 1)
                           (= (fn2-machine-cb-failed id fn2-core) 0)
                           (not (fn2-core-stopped-p fn2-core))))
      ((unless whole-envelope) (mv nil fn2-core))
      (fn2-core
       (case removed
        (:phase (fn2-commit-put-core id (phase *fn2-commit-state-collect*)))
        (:deps (fn2-commit-put-core id (cb-deps-ok 0)))
        (:log (fn2-commit-put-core id (cb-log-ok 0)))
        (:fence (fn2-commit-put-core id (cb-fence-ok 0)))
        (:failed (fn2-commit-put-core id (cb-failed 1)))
        (:batch (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (fn2-commit-root)
                  (fn2-commit-root-set-installed 0 (+ 1 batch) fn2-commit-root) fn2-core))
        ; A stale member owner generation fails workspace ownership. The
        ; separate control-event case reaches the exact control identity gate.
        (:member (stobj-let ((fn2-commit-member (fn2-core-commit-members fn2-core))) (fn2-commit-member)
                   (fn2-commit-member-set-ogen row (+ 1 actual-ogen) fn2-commit-member) fn2-core))
        (:control-event (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))) (fn2-retirement-control)
                          (fn2-retirement-control-set-event 0 (+ 1 event) fn2-retirement-control) fn2-core))
        (otherwise fn2-core)))
      ((mv cancelled fn2-core)
       (if (eq removed :intent)
           (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
            (fn2-alloc-retirement-intent-cancel target epoch allocation batch fn2-extents) (mv code fn2-core))
         (mv :ok fn2-core)))
      ((unless (eq cancelled :ok)) (mv nil fn2-core))
      (before (fn2-riud-state fn2-core))
      ((mv code member off fn2-core) (fn2-commit-lifecycle-step id 0 0 fn2-core))
      (after (fn2-riud-state fn2-core))
      (installed (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                             (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (installed)
         (and (eq (fn2-alloc-handle-code target epoch allocation fn2-extents) :ok)
              (= (fn2-extents-state target fn2-extents) *fn2-extent-state-retire-pending*)
              (= (fn2-extents-retirement target fn2-extents) batch)
              (= (fn2-extents-obligation target fn2-extents) 1)
              (fn2-alloc-edge-matchesp 0 50 target epoch allocation :obligation fn2-alloc-edges)
              (= (fn2-alloc-retirement-intent-batch fn2-extents) 0)) installed)))
  (mv (if removed
          (and (eq code :invalid) (equal before after) (not installed))
        (and (eq code :more) (= member 0) (= off len) installed
             ; Ordinary install mutates allocator only, not the retained
             ; source control or any existing protector edge.
             (equal (cadr before) (cadr after)) (equal (caddr before) (caddr after)))) fn2-core)))
(defun fn2-riud-run (removed)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-riud-body removed fn2-core) ok)))
(assert-event (fn2-riud-run nil))
(assert-event (fn2-riud-run :phase))
(assert-event (fn2-riud-run :deps))
(assert-event (fn2-riud-run :log))
(assert-event (fn2-riud-run :fence))
(assert-event (fn2-riud-run :failed))
(assert-event (fn2-riud-run :batch))
(assert-event (fn2-riud-run :member))
(assert-event (fn2-riud-run :control-event))
(assert-event (fn2-riud-run :intent))

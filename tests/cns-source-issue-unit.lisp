; Actual raw issuer controls, not an assembled CNS/selected-dispatch witness.
; The retained source descriptor is an explicit typed environment premise.
; Allocation, promised edge, query pin, operation reservation and issue are real.
; All eight carrier images are compared. The positive oracle below uses only
; schema indices/list arithmetic, never the production issue or state writers.
(in-package "ACL2")
(include-book "../books/cns-source-issue-accounting")
(include-book "column-snapshot-support")
(include-book "../books/runs-page")
(make-event
 (value (cons 'progn
  (append
   (fn2-test-column-snapshot-events 'fn2-cns-sources (w state))
   (fn2-test-column-snapshot-events 'fn2-cns-source-operations (w state))
   (fn2-test-column-snapshot-events 'fn2-extents (w state))
   (fn2-test-column-snapshot-events 'fn2-alloc-edges (w state))
   (fn2-test-column-snapshot-events 'fn2-pool (w state))
   (fn2-test-column-snapshot-events 'fn2-ops (w state))
   (fn2-test-column-snapshot-events 'fn2-control (w state))
   (fn2-test-column-snapshot-events 'fn2-checkpoints (w state))
   (list `(defconst *fn2-csi-fields*
             ',(list
                (strip-cars (fn2-test-snapshot-fields 'fn2-cns-sources (w state)))
                (strip-cars (fn2-test-snapshot-fields 'fn2-cns-source-operations (w state)))
                (strip-cars (fn2-test-snapshot-fields 'fn2-extents (w state)))
                (strip-cars (fn2-test-snapshot-fields 'fn2-alloc-edges (w state)))
                (strip-cars (fn2-test-snapshot-fields 'fn2-pool (w state)))
                (strip-cars (fn2-test-snapshot-fields 'fn2-ops (w state)))
                (strip-cars (fn2-test-snapshot-fields 'fn2-control (w state)))
                (strip-cars (fn2-test-snapshot-fields 'fn2-checkpoints (w state)))
              )))))))
(defun fn2-csi-cell (field row fields image)
 (declare (xargs :verify-guards nil))
 (nth row (nth (position-eq field fields) image)))
(defun fn2-csi-set (field value fields image)
 (declare (xargs :verify-guards nil))
 (update-nth (position-eq field fields) value image))
(defun fn2-csi-row (row updates fields image)
 (declare (xargs :verify-guards nil))
 (if (atom updates) image
  (fn2-csi-row row (cdr updates) fields
   (fn2-csi-set (caar updates)
    (update-nth row (cdar updates) (nth (position-eq (caar updates) fields) image)) fields image))))
; Fresh FREE descriptor row, with a nonempty reserved sibling, is the oracle
; domain. Existing sibling cells, queue prefix and all other state are framed.
(defun fn2-csi-positive-model (before lease lgen op opgen extent edge epoch allocation unit)
 (declare (xargs :verify-guards nil))
 (b* ((sf (nth 0 *fn2-csi-fields*)) (mf (nth 1 *fn2-csi-fields*))
      (ef (nth 2 *fn2-csi-fields*)) (af (nth 3 *fn2-csi-fields*))
      (pf (nth 4 *fn2-csi-fields*)) (of (nth 5 *fn2-csi-fields*))
      (ops (nth 5 before))
      (tail (nth (position-eq 'fn2-ops-out-tail of) ops))
      (out (nth (position-eq 'fn2-ops-out-slot of) ops))
      (gens (nth (position-eq 'fn2-ops-out-gen of) ops))
      (next (fn2-csi-cell 'fn2-ops-next-free$a op of ops))
      (ops (fn2-csi-row op
        (list (cons 'fn2-ops-phase$a *fn2-op-phase-queued*)
              (cons 'fn2-ops-kind$a *fn2-action-read*)
              (cons 'fn2-ops-owner-kind$a 9) (cons 'fn2-ops-owner-slot$a 17)
              (cons 'fn2-ops-owner-gen$a 19) (cons 'fn2-ops-principal$a 0)
              (cons 'fn2-ops-range-slot$a lease) (cons 'fn2-ops-range-gen$a lgen)
              (cons 'fn2-ops-range-off$a *fn2-cns-source-prefix*)
              (cons 'fn2-ops-range-len$a *fn2-commit-unit-bytes*)
              (cons 'fn2-ops-storage-offset$a (* unit *fn2-commit-unit-bytes*))
              (cons 'fn2-ops-next-free$a *fn2-none*)) of ops))
      (ops (fn2-csi-set 'fn2-ops-free-head next of ops))
      (ops (fn2-csi-set 'fn2-ops-free-count
              (- (nth (position-eq 'fn2-ops-free-count of) ops) 1) of ops))
      (ops (fn2-csi-set 'fn2-ops-queued
              (+ (nth (position-eq 'fn2-ops-queued of) ops) 1) of ops))
      (ops (fn2-csi-set 'fn2-ops-out-slot (update-nth tail op out) of ops))
      (ops (fn2-csi-set 'fn2-ops-out-gen (update-nth tail opgen gens) of ops))
      (ops (fn2-csi-set 'fn2-ops-out-tail (mod (+ tail 1) (len out)) of ops)))
  (list
   (fn2-csi-row 0 (list (cons 'fn2-cns-sources-pending$a 1)
      (cons 'fn2-cns-sources-op-slot$a op) (cons 'fn2-cns-sources-op-gen$a opgen)
      (cons 'fn2-cns-sources-unit-length$a *fn2-commit-unit-bytes*)
      (cons 'fn2-cns-sources-unit-copied$a 0) (cons 'fn2-cns-sources-unit-hashed$a 0)
      (cons 'fn2-cns-sources-phase$a *fn2-cns-source-phase-raw-wait*)) sf (nth 0 before))
   (fn2-csi-row op (list (cons 'fn2-cns-source-operations-live$a 1)
      (cons 'fn2-cns-source-operations-generation$a opgen)
      (cons 'fn2-cns-source-operations-source-row$a 0)) mf (nth 1 before))
   (fn2-csi-row extent (list (cons 'fn2-extents-outstanding-io$a
      (+ 1 (fn2-csi-cell 'fn2-extents-outstanding-io$a extent ef (nth 2 before))))) ef (nth 2 before))
   (fn2-csi-row edge (list (cons 'fn2-alloc-edges-state$a *fn2-alloc-edge-state-live*)
      (cons 'fn2-alloc-edges-kind$a *fn2-alloc-edge-kind-outstanding-io*)
      (cons 'fn2-alloc-edges-holder$a opgen) (cons 'fn2-alloc-edges-extent$a extent)
      (cons 'fn2-alloc-edges-epoch$a epoch) (cons 'fn2-alloc-edges-counter$a allocation)) af (nth 3 before))
   (fn2-csi-row lease (list (cons 'fn2-pool-state$a *fn2-pool-state-leased-in*)
      (cons 'fn2-pool-lease-op-slot$a op) (cons 'fn2-pool-lease-op-gen$a opgen)
      (cons 'fn2-pool-lease-off$a *fn2-cns-source-prefix*)
      (cons 'fn2-pool-lease-len$a *fn2-commit-unit-bytes*)) pf (nth 4 before))
   ops (nth 6 before) (nth 7 before))))
(defun fn2-csi-snapshot (fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints)
 (declare (xargs :stobjs (fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints) :verify-guards nil))
 (list
  (fn2-test-table-snapshot-fn2-cns-sources fn2-cns-sources)
  (fn2-test-table-snapshot-fn2-cns-source-operations fn2-cns-source-operations)
  (fn2-test-table-snapshot-fn2-extents fn2-extents)
  (fn2-test-table-snapshot-fn2-alloc-edges fn2-alloc-edges)
  (fn2-test-table-snapshot-fn2-pool fn2-pool)
  (fn2-test-table-snapshot-fn2-ops fn2-ops)
  (fn2-test-table-snapshot-fn2-control fn2-control)
  (fn2-test-table-snapshot-fn2-checkpoints fn2-checkpoints)
))
(defun fn2-csi-domainp (fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints)
 (declare (xargs :stobjs (fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints) :verify-guards nil))
 (and
  (fn2-cns-sourcesp fn2-cns-sources) (fn2-cns-sources-wfp fn2-cns-sources)
  (fn2-cns-source-operationsp fn2-cns-source-operations) (fn2-cns-source-operations-wfp fn2-cns-source-operations)
  (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents)
  (fn2-alloc-edgesp fn2-alloc-edges) (fn2-alloc-edges-wfp fn2-alloc-edges)
  (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
  (fn2-opsp fn2-ops) (fn2-ops-wfp fn2-ops)
  (fn2-controlp fn2-control) (fn2-control-wfp fn2-control)
  (fn2-checkpointsp fn2-checkpoints) (fn2-checkpoints-wfp fn2-checkpoints)
))
(defun fn2-csi-unit-body (fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints)
 (declare (xargs :stobjs (fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints) :verify-guards nil))
 (b* ((fn2-cns-sources (fn2-cns-sources-init 1 fn2-cns-sources))
      (fn2-extents (fn2-alloc-init 2 fn2-extents))
      (fn2-alloc-edges (fn2-alloc-edges-init 512 fn2-alloc-edges))
      (fn2-pool (fn2-pool-init (list (cons 2 *fn2-cns-item-workspace-bytes*)) 1 100 fn2-pool))
      (fn2-ops (fn2-ops-init *fn2-profile-tiny* fn2-ops))
      (fn2-control (fn2-control-init *fn2-profile-tiny* fn2-control))
      (fn2-checkpoints (fn2-checkpoints-init 1 fn2-checkpoints))
      (fn2-cns-source-operations (fn2-cns-source-operations-init (fn2-ops-rows fn2-ops) fn2-cns-source-operations))
      ((mv epoch-code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv reserve-code & extent epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv commit-code fn2-extents) (fn2-alloc-commit-allocation extent epoch allocation 1 1 fn2-extents))
      ((mv sibling-code sibling sgen fn2-pool) (fn2-pool-reserve 0 7 11 13 fn2-pool))
      ((mv write-code fn2-pool) (fn2-pool-write sibling sgen 0 37 7 11 13 fn2-pool))
      ((mv lease-code lease lgen fn2-pool) (fn2-pool-reserve 0 9 17 19 fn2-pool))
      ((mv zero-code fn2-pool) (fn2-run-zero *fn2-cns-source-prefix* lease lgen 0 9 17 19 fn2-pool))
      ((mv sibling-op-code & & fn2-ops) (fn2-op-reserve *fn2-action-close* 7 11 13 0 0 fn2-ops))
      (unit (* extent *fn2-storage-extent-units*))
      ; Explicit descriptor premise only; root readiness/edge is derived below.
      (fn2-cns-sources (fn2-cns-sources-put 0
        (phase *fn2-cns-source-phase-retain*) (cns-id 17) (owner-kind 9) (cns-gen 19)
        (ctl-id 23) (ctl-gen 29) (request 31) (lslot lease) (lgen lgen)
        (article 7) (version 1) (total (* 2 *fn2-commit-unit-bytes*))
        (location-kind *fn2-txn-location-raw-source*) (hashes 64)
        (root-unit unit) (root-epoch epoch) (root-allocation allocation)))
      ((mv hold-code fn2-cns-sources fn2-extents fn2-alloc-edges)
       (fn2-cns-source-root-hold-children 0 17 19 23 29 31 fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops))
      (setup (and (eq epoch-code :ok) (eq reserve-code :ok) (eq commit-code :ok)
        (eq sibling-code :ok) (eq write-code :ok) (eq lease-code :ok) (eq zero-code :ok)
        (eq sibling-op-code :ok) (eq hold-code :ok) (not (equal sibling lease))
        (fn2-cns-source-heldp 0 17 19 23 29 31 unit epoch allocation fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)))
      (before (fn2-csi-snapshot fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints))
      (bad-h (fn2-csi-domainp fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints))
      ((mv bad bo bg fn2-cns-sources fn2-cns-source-operations fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges)
       (fn2-cns-source-issue-children 0 17 20 23 29 31 9 0 fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints))
      (bad-ok (and bad-h (eq bad :bad) (equal bo 0) (equal bg 0)
         (equal before (fn2-csi-snapshot fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints))))
      ((mv acquire fn2-pool) (fn2-pool-query-acquire lease lgen 0 32 9 17 19 fn2-pool))
      (wait-before (fn2-csi-snapshot fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints))
      (wait-h (fn2-csi-domainp fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints))
      ((mv wait wo wg fn2-cns-sources fn2-cns-source-operations fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges)
       (fn2-cns-source-issue-children 0 17 19 23 29 31 9 0 fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints))
      (wait-ok (and wait-h (eq acquire :ok) (eq wait :wait) (equal wo 0) (equal wg 0)
         (equal wait-before (fn2-csi-snapshot fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints))))
      ((mv release last fn2-pool) (fn2-pool-query-release lease lgen fn2-pool))
      (positive-h (fn2-csi-domainp fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints))
      (positive-before (fn2-csi-snapshot fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints))
      (candidate (fn2-ops-free-head fn2-ops)) (generation (fn2-ops-gen candidate fn2-ops))
      (edge (fn2-b-read-pin-edge candidate fn2-extents))
      (queued (fn2-ops-queued fn2-ops))
      (issued (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops))
      (expected (fn2-csi-positive-model positive-before lease lgen candidate generation extent edge epoch allocation unit))
      ((mv code op og fn2-cns-sources fn2-cns-source-operations fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges)
       (fn2-cns-source-issue-children 0 17 19 23 29 31 9 0 fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints))
      (after (fn2-csi-snapshot fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints)))
  (mv (and setup bad-ok wait-ok (eq release :ok) last positive-h
       (equal before positive-before)
       (eq code :ok) (equal op candidate) (equal og generation)
       (equal (fn2-ops-queued fn2-ops) (+ queued 1))
       (equal (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops) (+ issued 1))
       (fn2-csi-domainp fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints)
       (equal after expected)
       ; Omission/sibling corruption cannot pass the whole-image conclusion.
       (not (equal after positive-before))
       (not (equal after (update-nth 4
          (fn2-csi-row sibling (list (cons 'fn2-pool-fill$a 0))
             (nth 4 *fn2-csi-fields*) (nth 4 expected)) expected))))
      fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints)))
(defun fn2-csi-unit ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local
  (fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints)
  (fn2-csi-unit-body fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints)))
(assert-event (fn2-csi-unit))

; Source-only metadata controls. The ACL2 fixture proves the real guard later.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun member-eq (x xs) (member x xs))
(defun remove-eq (x xs) (remove x xs))
(defun intersectp-eq (xs ys) (intersection xs ys))
(defun remove-duplicates-equal (xs) (remove-duplicates xs :test #'equal :from-end t))
(defun set-difference-equal (xs ys) (set-difference xs ys :test #'equal))
(defun fn2-columns-sym (name suffix) (intern (concatenate 'string (symbol-name name) suffix) "ACL2"))
(defun getpropc (name prop default world) (getf (cdr (assoc name (getf world :properties))) prop default))
(defun fn2-decl-row (key world) (cdr (assoc (cadr key) (getf world :tables))))
(defun all-fnnames (body) body)
(defun fn2-columns-getter-runes (tables world)
 (declare (ignore world))
 (loop for table in tables append (list (fn2-columns-sym table "-VALUE") (fn2-columns-sym table "-ROWS"))))
(dolist (path '("books/columns-guard-hints.lisp" "books/columns-call-guards.lisp"))
 (with-open-file (in path)
 (loop for form = (read in nil :eof) until (eq form :eof) do
  (when (and (eq (car form) 'defun)
             (member (cadr form) '(fn2-columns-guard-tablesp fn2-columns-guard-hint
                                  fn2-columns-input-tables fn2-columns-framed-callees
                                  fn2-columns-call-guard-hint))) (eval form)))))
(let* ((world '(:tables ((output :registered) (input :registered))
                :properties ((consumer formals (i output input) stobjs-in (nil output input)
                              stobjs-out (output) unnormalized-body (consumer writer reader predicate incomplete))
                             (writer stobjs-out (nil output))
                             (writer-preserves-type theorem (proved-type))
                             (writer-preserves-wfp theorem (proved-wfp))
                             (reader stobjs-in (input) stobjs-out (nil))
                             (predicate stobjs-in (output) stobjs-out (nil))
                             (incomplete stobjs-out (output))
                             (incomplete-preserves-type theorem (proved-type))
                             (consumer-preserves-type theorem (proved-type))
                             (consumer-preserves-wfp theorem (proved-wfp)))))
       (hint (fn2-columns-call-guard-hint 'consumer '(byte-type) nil world))
       (closed (caddr (cadr hint)))
       (opened (fn2-columns-call-guard-hint 'consumer '(byte-type) '(writer input-value byte-type) world)))
 (assert (subsetp '(output-value output-rows input-value input-rows writer nth byte-type) closed))
 (assert (not (intersection '(consumer reader predicate incomplete writer-preserves-type writer-preserves-wfp) closed)))
 (assert (not (intersection '(writer input-value byte-type) (caddr (cadr opened)))))
 (assert (equal (cadr (cadr opened)) '(writer input-value byte-type)))
 (assert (equal (length hint) 2)))
(format t "COLUMN CALL GUARD SOURCE CONTROLS PASS~%")

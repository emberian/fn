; Actual allocated handle under explicitly synthetic provenance rows. These
; controls exercise classification only; they grant no retirement/FREE.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-owned-extent")
(defun fn2-coeu-body (mode fn2-checkpoint-construction fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-construction fn2-extents) :verify-guards nil))
 (b* ((fn2-extents (fn2-alloc-init 2 fn2-extents))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-init 2 fn2-checkpoint-construction))
      ((mv begun fn2-extents) (fn2-alloc-begin-epoch 7 fn2-extents))
      ((mv reserved & e epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv committed fn2-extents) (fn2-alloc-commit-allocation e epoch allocation (if (eq mode :kind-zero) 0 9) 41 fn2-extents))
      (native (eq mode :native))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-put e (live 1)
       (role (if native 1 *fn2-checkpoint-owned-restored-role*))
       (epoch epoch) (counter (if (eq mode :wrong-handle) (+ allocation 1) allocation))
       (token (if native 41 0)) (owner-kind (if native 9 0))
       (intended-bytes (if native *fn2-storage-extent-bytes* 0))
       (completed-bytes (if (or native (eq mode :fake-complete)) *fn2-storage-extent-bytes* 0))))
      ((mv retired fn2-extents) (if (eq mode :retired)
       (fn2-alloc-retire e epoch allocation 11 fn2-extents) (mv :not-run fn2-extents)))
      (provenance (fn2-checkpoint-owned-provenance-p (if (eq mode :kind-zero) 0 9) e fn2-checkpoint-construction fn2-extents))
      (classified (fn2-checkpoint-owned-extent-p (if (eq mode :kind-zero) 0 9) e fn2-checkpoint-construction fn2-extents)))
  (mv (and (eq begun :ok) (eq reserved :ok) (eq committed :ok)
           (equal classified (if (member-equal mode '(:native :restored :kind-zero)) t nil))
           (equal provenance (if (member-equal mode '(:native :restored :retired :kind-zero)) t nil))
           (or (not (eq mode :retired)) (eq retired :ok))
           (if native (fn2-checkpoint-construction-native-p e fn2-checkpoint-construction)
            (not (fn2-checkpoint-construction-native-p e fn2-checkpoint-construction))))
      fn2-checkpoint-construction fn2-extents)))
(defun fn2-coeu-run (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoint-construction
  (with-local-stobj fn2-extents
   (mv-let (answer fn2-checkpoint-construction fn2-extents)
    (fn2-coeu-body mode fn2-checkpoint-construction fn2-extents) answer))))
(assert-event (fn2-coeu-run :native))
(assert-event (fn2-coeu-run :restored))
(assert-event (fn2-coeu-run :wrong-handle))
(assert-event (fn2-coeu-run :fake-complete))

(assert-event (fn2-coeu-run :retired))

(assert-event (fn2-coeu-run :kind-zero))

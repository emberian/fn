; Compression uses the existing descriptor/loan and terminal vocabulary.
(in-package "ACL2")
(include-book "../books/terminal-values")
(include-book "../books/borrow-release")
(assert-event (fn2-op-upgrade-kindp *fn2-action-compress-start*))
(assert-event (fn2-op-output-kindp *fn2-action-compress-start*))
(assert-event (not (fn2-op-input-kindp *fn2-action-compress-start*)))
(assert-event (equal (fn2-terminal-event *fn2-action-compress-start*) *fn2-event-compress-result*))
(assert-event (fn2-terminal-releases-borrow-p *fn2-action-compress-start* *fn2-event-compress-result* 0 0 0))
(assert-event (not (fn2-terminal-releases-borrow-p *fn2-action-compress-start* *fn2-event-tls-result* 0 0 0)))
(assert-event (not (fn2-event-statusp *fn2-event-compress-result* *fn2-outcome-short* *fn2-reason-none*)))
(defun fn2-compress-action-normalizer-control (raw expected-outcome expected-reason physical expected-count)
 (declare (xargs :guard t))
 (mv-let (outcome reason count a0 a1)
  (fn2-sim-terminal-values *fn2-action-compress-start* raw physical 0 3 nil (eq raw :cancelled))
  (and (equal outcome expected-outcome) (equal reason expected-reason) (equal count expected-count)
       (equal a0 0) (equal a1 0)
       (fn2-event-statusp *fn2-event-compress-result* outcome reason))))
(assert-event (fn2-compress-action-normalizer-control :ok *fn2-outcome-done* *fn2-reason-none* 3 3))
(assert-event (fn2-compress-action-normalizer-control :io *fn2-outcome-failed* *fn2-reason-io* 0 0))
(assert-event (fn2-compress-action-normalizer-control :cancelled *fn2-outcome-cancelled* *fn2-reason-none* 0 0))

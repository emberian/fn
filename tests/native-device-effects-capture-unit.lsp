;;; Narrow SBCL recorder control. This substitutes perform, so it tests the
;;; recorder interface/concurrency only, not the operating system or disk.
(defpackage "ACL2" (:use "COMMON-LISP"))
(load "host/device.lisp")
(in-package "ACL2")
(setf (symbol-function 'fn2-device-submit) (lambda (device job) (declare (ignore device job)) :queued))
(setf (symbol-function 'fn2-device-perform)
 (lambda (device job)
   (declare (ignore device))
   ;; Acquiring this lock inside the original proves the wrapper did not
   ;; serialize the physical operation under its evidence mutex.
   (let ((lock (symbol-value '*fn2-device-evidence-lock*)))
     (assert (sb-thread:grab-mutex lock :waitp nil))
     (sb-thread:release-mutex lock))
   (if (and (eq (fn2-device-job-kind job) :read) (= (fn2-device-job-offset job) 999))
       (setf (fn2-device-job-result job) -1 (fn2-device-job-errno job) 5)
     (progn
       (when (eq (fn2-device-job-kind job) :read)
         (setf (aref (fn2-device-job-bytes job) (fn2-device-job-address job)) 61
               (aref (fn2-device-job-bytes job) (1+ (fn2-device-job-address job))) 62))
       (setf (fn2-device-job-result job) 2 (fn2-device-job-errno job) 0)))
   (values :original-return :second-value)))
; Mock only the host accessors/submission interface; the recorder wraps this
; actual call shape and must capture HOST's slab, not the job's claimed slab.
(setf (symbol-function 'fn2-nhost-bytes) (lambda (host) (cdr host)))
(setf (symbol-function 'fn2-n-storage-submit)
      (lambda (host job) (fn2-device-submit (car host) job)))
(load "tests/native-device-effects-capture.lsp")
(let* ((device (%make-fn2-device :fd 17))
       (bytes (make-array 4 :element-type '(unsigned-byte 8) :initial-contents '(9 1 2 3)))
       (job (make-fn2-device-job :slot 4 :gen 7 :kind :write :bytes bytes :address 1 :length 3 :offset 100)))
 (assert (eq :queued (fn2-device-submit device job)))
 (assert (equal '(:original-return :second-value) (multiple-value-list (fn2-device-perform device job)))))
;; A mutation after submission must be rejected before performing the write.
(let* ((device (%make-fn2-device :fd 17))
       (bytes (make-array 1 :element-type '(unsigned-byte 8) :initial-element 5))
       (job (make-fn2-device-job :slot 4 :gen 8 :kind :write :bytes bytes :address 0 :length 1 :offset 200)))
 (fn2-device-submit device job)
 (setf (aref bytes 0) 6)
 (assert (handler-case (progn (fn2-device-perform device job) nil) (error () t))))
;; Only the returned Read span is captured, not the prefix, unfilled requested
;; suffix, or backing-array suffix. Error Reads have no returned byte witness.
(let* ((device (%make-fn2-device :fd 17))
       (bytes (make-array 6 :element-type '(unsigned-byte 8) :initial-contents '(11 12 0 0 13 14)))
       (job (make-fn2-device-job :slot 5 :gen 7 :kind :read :bytes bytes :address 2 :length 3 :offset 100)))
 (fn2-device-submit device job)
 (fn2-device-perform device job)
 (assert (equal (coerce bytes 'list) '(11 12 61 62 13 14))))
(let* ((device (%make-fn2-device :fd 17))
       (bytes (make-array 6 :element-type '(unsigned-byte 8) :initial-contents '(11 12 55 56 13 14)))
       (job (make-fn2-device-job :slot 6 :gen 7 :kind :read :bytes bytes :address 2 :length 3 :offset 999)))
 (fn2-device-submit device job)
 (fn2-device-perform device job)
 (assert (equal (coerce bytes 'list) '(11 12 55 56 13 14))))
;; Equal bytes do not excuse a shifted Write, shifted Read, or replacement
;; backing object. Every mutation must be refused before original perform.
(dolist (kind '(:write :read))
 (let* ((device (%make-fn2-device :fd 17))
        (bytes (make-array 4 :element-type '(unsigned-byte 8) :initial-element 7))
        (job (make-fn2-device-job :slot 8 :gen 7 :kind kind :bytes bytes :address 0 :length 2 :offset 0)))
  (fn2-n-storage-submit (cons device bytes) job)
  (setf (fn2-device-job-address job) 1)
  (assert (handler-case (progn (fn2-device-perform device job) nil) (error () t)))))
(let* ((device (%make-fn2-device :fd 17))
       (bytes (make-array 3 :element-type '(unsigned-byte 8) :initial-element 7))
       (job (make-fn2-device-job :slot 9 :gen 7 :kind :write :bytes bytes :address 0 :length 2 :offset 0)))
 (fn2-n-storage-submit (cons device bytes) job)
 (setf (fn2-device-job-bytes job) (copy-seq bytes))
 (assert (handler-case (progn (fn2-device-perform device job) nil) (error () t))))
;; The unmatched submit must remain in the stream, never synthesized as zero.
(close *fn2-device-evidence-stream*)
(let ((records (with-open-file (in (sb-ext:posix-getenv "FN2_TEST_DEVICE_EFFECTS"))
                 (loop for row = (read in nil :eof) until (eq row :eof) collect row))))
 (assert (equal records
  '((:submit 1 (17 4 7 :write 100 3 (1 2 3) 1 1 nil))
    (:begin 1) (:return 1 2 0 nil)
    (:submit 2 (17 4 8 :write 200 1 (5) 0 2 nil))
    (:submit 3 (17 5 7 :read 100 3 nil 2 3 nil)) (:begin 3) (:return 3 2 0 (61 62))
    (:submit 4 (17 6 7 :read 999 3 nil 2 4 nil)) (:begin 4) (:return 4 -1 5 nil)
    (:submit 5 (17 8 7 :write 0 2 (7 7) 0 5 5))
    (:submit 6 (17 8 7 :read 0 2 nil 0 6 6))
    (:submit 7 (17 9 7 :write 0 2 (7 7) 0 7 7))))))
(format t "DEVICE EFFECT RECORDER CONTROLS PASS~%")

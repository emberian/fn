; PREPARED, UNEXECUTED COPY primitive composition. Actual private pool leases,
; actual count function and actual pool copy are used. This is not a verified
; page/catalog fixture and supplies no physical-source or hash authority.
(in-package "ACL2")
(include-book "../books/run-physical-bound-step")
(include-book "std/util/bstar" :dir :system)
(defun fn2-rpcb-fill (i slot gen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- 4096 (nfix i)))))
 (if (>= (nfix i) 4096) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen i (mod i 251) 1 0 1 fn2-pool)
   (if (eq code :ok) (fn2-rpcb-fill (+ 1 (nfix i)) slot gen fn2-pool) (mv code fn2-pool)))))
(defun fn2-rpcb-equal (i src sgen dst dgen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- 4096 (nfix i)))))
 (if (>= (nfix i) 4096) t
  (mv-let (sc a) (fn2-pool-read src sgen i 1 0 1 fn2-pool)
   (mv-let (dc b) (fn2-pool-read dst dgen i 1 0 1 fn2-pool)
    (and (eq sc :ok) (eq dc :ok) (= a b) (fn2-rpcb-equal (+ 1 (nfix i)) src sgen dst dgen fn2-pool))))))
(defun fn2-rpcb-body (fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (b* ((fn2-pool (fn2-pool-init '((2 . 4096)) 1 *fn2-u60-max* fn2-pool))
      ((mv sc src sgen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv dc dst dgen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv fill fn2-pool) (fn2-rpcb-fill 0 src sgen fn2-pool))
      (one (fn2-run-load-copy-count 4096 0))
      ((mv first fn2-pool) (fn2-pool-copy-range src sgen 0 dst dgen 0 one 1 0 1 fn2-pool))
      (two (fn2-run-load-copy-count 4096 one))
      ((mv second fn2-pool) (fn2-pool-copy-range src sgen one dst dgen one two 1 0 1 fn2-pool)))
  (mv (and (eq sc :ok) (eq dc :ok) (eq fill :ok) (eq first :ok) (eq second :ok)
           (= one 2048) (= two 2048) (= (+ one two) *fn2-commit-unit-bytes*)
           (= (fn2-run-load-copy-count 1 0) 0) (<= (* 2 one) 4096) (<= (* 2 two) 4096)
           (= (fn2-pool-fill dst fn2-pool) *fn2-commit-unit-bytes*)
           (fn2-rpcb-equal 0 src sgen dst dgen fn2-pool)) fn2-pool)))
(assert-event (with-local-stobj fn2-pool (mv-let (ok fn2-pool) (fn2-rpcb-body fn2-pool) ok)))

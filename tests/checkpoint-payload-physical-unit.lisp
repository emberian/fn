; Actual shared block commitment and physical payload engine controls.
; Expected vector/identity refs are synthetic trusted-entry premises backed
; by actual unit hashing below; no published checkpoint/boot claim is made.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/runs-page")
(include-book "../books/checkpoint-payload-physical-step")
(defun fn2-cppu-drive (fuel fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests)
 (declare (xargs :stobjs (fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests) :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-checkpoint-payload fn2-fields fn2-b3 fn2-digests)
  (mv-let (code next fn2-checkpoint-payload fn2-fields fn2-b3 fn2-digests)
   (fn2-checkpoint-payload-physical-step 4096 fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests)
   (declare (ignore next))
   (if (eq code :more) (fn2-cppu-drive (- fuel 1) fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests)
    (mv code fn2-checkpoint-payload fn2-fields fn2-b3 fn2-digests)))))
(defun fn2-cppu-body (mode fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests)
 (declare (xargs :stobjs (fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests) :verify-guards nil))
 (b* ((raw (eq mode :raw)) (total (if raw 3 20000)) (len (if raw 3 4096))
      (fn2-checkpoint-payload (fn2-checkpoint-payload-init 1 fn2-checkpoint-payload))
      (fn2-fields (fn2-fields-init 1024 fn2-fields))
      (fn2-pool (fn2-pool-init '((3 . 4096)) 1 100 fn2-pool))
      (fn2-b3 (fn2-b3-table-init 9 fn2-b3))
      (fn2-digests (fn2-digests-init (+ (* 9 *fn2-digest-stride*) 16) fn2-digests))
      ((mv reserved hs hg fn2-pool) (fn2-pool-reserve 0 7 0 1 fn2-pool))
      ((mv manifest ms mg fn2-pool) (fn2-pool-reserve 0 7 0 1 fn2-pool))
      ((mv data ds dg fn2-pool) (fn2-pool-reserve 0 7 0 1 fn2-pool))
      ((mv hz fn2-pool) (fn2-run-zero 96 hs hg 0 7 0 1 fn2-pool))
      ((mv mz fn2-pool) (fn2-run-zero 4096 ms mg 0 7 0 1 fn2-pool))
      (fn2-fields (fn2-fields-set-value *fn2-format-source-manifest-header-field-source-length* total fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-source-manifest-header-field-block-size* *fn2-am-block-bytes* fn2-fields))
      (fn2-fields (fn2-fields-put *fn2-format-source-manifest-header-field-source-identity*
       (value 1) (ref-slot hs) (ref-gen hg) (ref-off 32) (ref-len 32)))
      ((mv header & fn2-pool) (fn2-format-source-manifest-header-encode 0 ms mg 0 7 0 1 fn2-fields fn2-pool))
      ((mv a fn2-pool) (fn2-pool-write ds dg 0 65 7 0 1 fn2-pool))
      ((mv b fn2-pool) (fn2-pool-write ds dg 1 66 7 0 1 fn2-pool))
      ((mv c fn2-pool) (fn2-pool-write ds dg 2 67 7 0 1 fn2-pool))
      (slot (if raw ds ms)) (gen (if raw dg mg))
      (row (fn2-b-block-read-row 9))
      ((mv hashed fn2-b3 fn2-digests) (fn2-block-hash-into row slot gen 0 len 7 0 1 fn2-b3 fn2-digests fn2-pool))
      ((mv stored fn2-pool) (fn2-digest-store 32 (fn2-digest-slot row *fn2-b3-result*) hs hg 0 7 0 1 fn2-digests fn2-pool))
      ((mv stored-again fn2-pool) (fn2-digest-store 32 (fn2-digest-slot row *fn2-b3-result*) hs hg 64 7 0 1 fn2-digests fn2-pool))
      ((mv changed fn2-pool) (if (eq mode :corrupt) (fn2-pool-write ms mg 1000 17 7 0 1 fn2-pool) (mv :ok fn2-pool)))
      (stream (fn2-b-payload-retention-row 9))
      ((mv fn2-digests fn2-b3) (fn2-b3-init stream 0 (fn2-digest-slot stream *fn2-b3-key*) fn2-digests fn2-b3))
      (fn2-checkpoint-payload (fn2-checkpoint-payload-put 0
       (phase *fn2-checkpoint-payload-phase-location-verify*) (verify-next (if raw *fn2-checkpoint-payload-phase-block-verify* *fn2-checkpoint-payload-phase-header*))
       (location-kind (if raw 0 1)) (location-units 1) (vector-slot hs) (vector-gen hg) (vector-off (if (eq mode :foreign-vector) 32 0))
       (vector-length (if (eq mode :vector-count) 64 32)) (owner-kind 7) (owner-slot 0) (owner-gen 1)
       (original-slot hs) (original-gen hg) (original-off 32) (stored-slot hs) (stored-gen hg) (stored-off 64)
       (total total) (position 0) (source-unit 16) (source-epoch 4) (source-allocation 31) (manifest-position 0) (loaded-unit 0)
       (manifest-slot ms) (manifest-gen mg) (data-slot ds) (data-gen dg) (field-base (* 128 stream)) (hash-row stream)
       (block-unit 16) (block-epoch 4) (block-allocation 31) (block-length len) (pending 0)))
      ((mv code & fn2-checkpoint-payload fn2-fields fn2-b3 fn2-digests)
       (fn2-checkpoint-payload-physical-step 4096 fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests))
      (no-decode (equal (fn2-fields-value (+ (* 128 stream) *fn2-format-source-manifest-header-field-source-length*) fn2-fields) 0))
      ((mv terminal fn2-checkpoint-payload fn2-fields fn2-b3 fn2-digests)
       (if raw (fn2-cppu-drive 8 fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests)
        (mv-let (again aux fn2-checkpoint-payload fn2-fields fn2-b3 fn2-digests)
         (if (eq mode :manifest) (fn2-checkpoint-payload-physical-step 4096 fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests)
          (mv :unused 0 fn2-checkpoint-payload fn2-fields fn2-b3 fn2-digests))
         (declare (ignore aux)) (mv again fn2-checkpoint-payload fn2-fields fn2-b3 fn2-digests)))))
  (mv (and (eq reserved :ok) (eq manifest :ok) (eq data :ok) (eq hz :ok) (eq mz :ok)
       (if raw t (eq header :ok)) (eq a :ok) (eq b :ok) (eq c :ok) (eq hashed :ok)
       (eq stored :ok) (eq stored-again :ok) (eq changed :ok) no-decode
       (cond (raw (and (eq code :more) (eq terminal :complete)
                 (equal (fn2-checkpoint-payload-position 0 fn2-checkpoint-payload) 3)))
             ((eq mode :manifest) (and (eq code :more) (eq terminal :more)
                 (equal (fn2-checkpoint-payload-phase 0 fn2-checkpoint-payload) *fn2-checkpoint-payload-phase-entry*)))
             ((eq mode :vector-count) (eq code :location-vector))
             (t (and (eq code :hash) (equal (fn2-checkpoint-payload-phase 0 fn2-checkpoint-payload) *fn2-checkpoint-payload-phase-uncertain*)))))
   fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests)))
(defun fn2-cppu-test (mode)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests)
  (fn2-cppu-body mode fn2-checkpoint-payload fn2-fields fn2-pool fn2-b3 fn2-digests)))
(assert-event (fn2-cppu-test :manifest))
(assert-event (fn2-cppu-test :corrupt))
(assert-event (fn2-cppu-test :foreign-vector))
(assert-event (fn2-cppu-test :vector-count))
(assert-event (fn2-cppu-test :raw))

; Descriptor bindings are available only after an actual successful issue.
(in-package "ACL2")
(include-book "../books/machines-a-run")
(include-book "std/testing/must-fail" :dir :system)
(defmachine fn2-issue-bind-probe
 :phases (:free :work :wait)
 :fields ((pending :u32) (stopped :bool) (cap-index :u32) (cap-nonce :u32)
          (saved-op :u32) (saved-op-gen :u60))
 :budget (:bytes 0 :steps 32 :descriptors 1)
 :initial ((generation 1) (ready-prev *fn2-none*) (ready-next *fn2-none*))
 :arms ((:free (:idle))
        (:work (:issue (fn2-issue-close row-cap-index row-cap-nonce :principal row-principal-slot)
                :bind (issued-slot issued-gen)
                :ok ((:set (saved-op issued-slot) (saved-op-gen issued-gen))
                     (:next :wait) (:wait :completion))
                :refused ((:set (saved-op 0)))))
        (:wait (:idle)))
 :observes ())
(defmachine-arms fn2-issue-bind-probe :children)
;; Issue bindings name the actual descriptor only on the successful path.
(defmachine fn2-arms-issue-bad-binding
 :phases (:free :work)
 :fields ((pending :u32) (stopped :bool) (cap-index :u32) (cap-nonce :u32))
 :budget (:bytes 0 :steps 32 :descriptors 1)
 :initial ((generation 1) (ready-prev *fn2-none*) (ready-next *fn2-none*))
 :arms ((:free (:idle))
        (:work (:issue (fn2-issue-close row-cap-index row-cap-nonce :principal row-principal-slot)
                :bind (only-one)
                :ok ((:wait :completion)))))
 :observes ())
(must-fail (defmachine-arms fn2-arms-issue-bad-binding :children))
(defmachine fn2-arms-issue-refused-binding
 :phases (:free :work)
 :fields ((pending :u32) (stopped :bool) (cap-index :u32) (cap-nonce :u32) (saved-op :u32))
 :budget (:bytes 0 :steps 32 :descriptors 1)
 :initial ((generation 1) (ready-prev *fn2-none*) (ready-next *fn2-none*))
 :arms ((:free (:idle))
        (:work (:issue (fn2-issue-close row-cap-index row-cap-nonce :principal row-principal-slot)
                :bind (issued-slot issued-gen)
                :ok ((:wait :completion))
                :refused ((:set (saved-op issued-slot))))))
 :observes ())
(must-fail (defmachine-arms fn2-arms-issue-refused-binding :children))


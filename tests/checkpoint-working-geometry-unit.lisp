; Actual pure scan boundary controls; no reserve/return or composed worker claim.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-working-geometry")
(defun fn2-cwg-boundaries (i fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (and (equal (fn2-checkpoint-window-class-demand i 0 fn2-pool) 0)
      (fn2-checkpoint-admission-roomp i fn2-pool)
      (equal (fn2-checkpoint-future-class-demand i 0 fn2-pool) 0)
      (fn2-checkpoint-future-roomp i fn2-pool)))
(defun fn2-cwg-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool
  (b* ((fn2-pool (fn2-pool-init '((32 . 4096) (32 . 65536)) 1 100 fn2-pool))
       (ok (and (fn2-pool-wfp fn2-pool)
                (fn2-cwg-boundaries nil fn2-pool)
                (fn2-cwg-boundaries -1 fn2-pool)
                (fn2-cwg-boundaries 1/2 fn2-pool)
                (fn2-cwg-boundaries *fn2-checkpoint-working-window-count* fn2-pool)
                (> (fn2-checkpoint-window-class-demand 0 1 fn2-pool) 0)
                (> (fn2-checkpoint-future-class-demand 0 0 fn2-pool) 0)
                (fn2-checkpoint-admission-roomp 0 fn2-pool)
                (fn2-checkpoint-future-roomp 0 fn2-pool))))
   (mv ok fn2-pool)) ok))
(assert-event (fn2-cwg-run))

; Resource reservation and retry controls use an actually admitted echo row.
(in-package "ACL2")
(include-book "machine-budget-turn-fixture")
(include-book "../books/reference-state")
(include-book "executor-residual-controls")

; Whole-state copies are confined to this test. No served path scans them.
(fn2-reference-children-events)
(defun fn2-budget-core-snapshot-calls (children)
 (if (atom children) nil
  (cons `(,(fn2-columns-sym (cadar children) "-COPY") ,(cadar children))
        (fn2-budget-core-snapshot-calls (cdr children)))))
(make-event
 (value `(defun fn2-budget-core-snapshot (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ,(fn2-core-child-bindings *fn2-core-children*) (answer)
   (list ,@(fn2-budget-core-snapshot-calls *fn2-core-children*)) answer))))

(defun fn2-budget-turn-witness-run (short-first fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile *fn2-profile-tiny*)
      (fn2-core (fn2-core-init profile fn2-core))
      (id (fn2-machine-free-head *fn2-echo-admission-ordinal* fn2-core))
      ((mv code fn2-core) (fn2-machine-admit-fn2-echo 7 9 1 fn2-core))
      ((mv wake fn2-core) (fn2-machine-take-wake fn2-core))
      (fn2-core (fn2-exec-wake wake fn2-core))
      (hyps (and (eq code :ok) (equal id wake) (fn2-execution-profilep profile)
                   (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
                   (fn2-machine-idp id fn2-core) (equal (fn2-machine-kind id fn2-core) *fn2-echo-kind*)
                   (fn2-exec-runnable-p fn2-core) (fn2-exec-credit-p fn2-core)))
      (h (fn2-exec-h fn2-core)) (k (fn2-exec-k fn2-core)) (a (fn2-exec-aturn fn2-core))
      (used (+ 1 (- a *fn2-exec-descriptor-reserve*)))
      (before (fn2-budget-core-snapshot fn2-core))
      ((mv shortage fn2-core)
       (if short-first
        (mv-let (status obs visits actions fn2-core)
         (fn2-concrete-loop (+ h k) h k a 0 0 used fn2-core)
         (mv (and (not (fn2-turn-descriptor-room-p used a))
                  (equal (list status obs visits actions) (list :more 0 0 used))
                  (equal before (fn2-budget-core-snapshot fn2-core))) fn2-core))
        (mv t fn2-core)))
      ((mv status obs visits actions fn2-core) (fn2-turn fn2-core)))
  (mv (list hyps shortage status obs visits actions a (<= actions a)
            (fn2-exec-queued fn2-core) (fn2-machine-pending id fn2-core) (fn2-core-success-p fn2-core)) fn2-core)))
(defun fn2-budget-turn-witness (short-first)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (answer fn2-core)
  (fn2-budget-turn-witness-run short-first fn2-core) answer)))
(assert-event (equal (fn2-budget-turn-witness nil) '(t t :idle 0 1 1 8 t 1 1 t)))
; Same whole antecedent, plus refusal-frame equality, then fresh-turn progress.
(assert-event (equal (fn2-budget-turn-witness t) '(t t :idle 0 1 1 8 t 1 1 t)))

; Removing the loop's initial-count premise admits an already overspent
; accumulator even on a well-formed core. No transition can repair the past.
(defun fn2-budget-initial-count-control-run (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      (a (fn2-exec-aturn fn2-core)) (used (+ 1 a))
      (other-hyps (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core) (natp a) (natp used)))
      ((mv ?status ?obs ?visits actions fn2-core)
       (fn2-concrete-loop 0 0 0 a 0 0 used fn2-core)))
  (mv (and other-hyps (not (<= used a)) (equal actions used) (not (<= actions a))) fn2-core)))
(defun fn2-budget-initial-count-control ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (answer fn2-core)
  (fn2-budget-initial-count-control-run fn2-core) answer)))
(assert-event (fn2-budget-initial-count-control))

(fn2-arm-residual-teeth-events)
(fn2-assert-owed-teeth fn2-arm-residual-budget)

; An observed clock may exhaust H, but must leave calendar work enabled.
; This executes the repaired policy together with descriptor reservation.
(defun fn2-budget-clock-progress-run (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (put-assoc-equal :h 1 *fn2-profile-tiny*))
      (fn2-core (fn2-core-init profile fn2-core))
      (id (fn2-machine-free-head *fn2-echo-admission-ordinal* fn2-core))
      ((mv code fn2-core) (fn2-machine-admit-fn2-echo 7 9 1 fn2-core))
      ((mv wake fn2-core) (fn2-machine-take-wake fn2-core))
      (fn2-core (fn2-exec-wake wake fn2-core))
      (fn2-core (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
        (fn2-ops) (fn2-post-clock 1 1 0 fn2-ops) fn2-core))
      (hyps (and (eq code :ok) (equal id wake) (fn2-execution-profilep profile)
                 (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
                 (fn2-machine-idp id fn2-core) (equal (fn2-machine-kind id fn2-core) *fn2-echo-kind*)
                 (equal (fn2-exec-h fn2-core) 1) (fn2-exec-observation-p fn2-core)
                 (fn2-exec-runnable-p fn2-core) (fn2-exec-credit-p fn2-core)))
      (a (fn2-exec-aturn fn2-core))
      ((mv ?status obs visits actions fn2-core) (fn2-turn fn2-core)))
  (mv (and hyps (equal obs 1) (< 0 visits) (equal actions 1) (<= actions a)
            (equal (fn2-machine-pending id fn2-core) 1) (fn2-core-success-p fn2-core)) fn2-core)))
(defun fn2-budget-clock-progress ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (answer fn2-core)
  (fn2-budget-clock-progress-run fn2-core) answer)))
(assert-event (fn2-budget-clock-progress))

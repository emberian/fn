; Checks around the actual emitted callback, to be consumed by the real
; manifest/adoption producer fixture. No state constructor, stub or fabricated
; readiness input. Defining these checks does not execute their assertions.
(in-package "ACL2")
(include-book "../books/assembly-callbacks-e-cns")
(include-book "core-snapshot-support")

(defun fn2-cfm-pending-domainp (stage id generation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((unless (and (member-eq stage '(:preflight :data))
                    (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
                    (not (fn2-core-stopped-p fn2-core))
                    (eq (fn2-cns-snapshot-read-code id fn2-core) :ok)
                    (equal (fn2-machine-generation id fn2-core) generation)
                    (equal (fn2-machine-phase id fn2-core) *fn2-cns-state-source*))) nil)
      (s (fn2-machine-slot id fn2-core))
      (ctl (fn2-cns-row-ctl id fn2-core)) (cg (fn2-cns-row-ctl-gen id fn2-core))
      (request (fn2-cns-row-request id fn2-core))
      (receipt (fn2-cns-row-observer-serial id fn2-core))
      (x (fn2-cns-row-xrow id fn2-core))
      ((unless (and (fn2-cns-source-boundp id generation ctl cg request fn2-core)
                    (eq (fn2-ctl-stream-reply-status ctl cg request id generation fn2-core) :active)
                    (if (eq stage :preflight)
                     (and (equal (fn2-cns-row-stream id fn2-core) 0) (posp receipt))
                     (and (equal (fn2-cns-row-stream id fn2-core) 1) (equal receipt 0))))) nil))
  (stobj-let ((fn2-cns-sources (fn2-core-cns-sources fn2-core))
              (fn2-cns-source-operations (fn2-core-cns-source-operations fn2-core))
              (fn2-ops (fn2-core-ops fn2-core))
              (fn2-reads (fn2-core-reads fn2-core))
              (fn2-succ-txns (fn2-core-succ-txns fn2-core))
              (fn2-cursor-table (fn2-cursor-table fn2-core))
              (fn2-c-source-control (fn2-core-c-source-control fn2-core))
              (fn2-c-source-readers (fn2-core-c-source-readers fn2-core))) (yes)
   (b* ((op (fn2-cns-sources-op-slot s fn2-cns-sources))
        (gen (fn2-cns-sources-op-gen s fn2-cns-sources))
        (parent (fn2-c-source-cns-endpoint (fn2-reads-rows fn2-reads) (fn2-succ-txns-rows fn2-succ-txns)
                                         (fn2-cursor-rows fn2-cursor-table) s)))
    (and (equal (fn2-cns-sources-pending s fn2-cns-sources) 1)
         (equal (fn2-cns-sources-uncertain s fn2-cns-sources) 0)
         (fn2-c-source-count-invariant-p fn2-c-source-control fn2-c-source-readers)
         (if (eq stage :preflight)
          (and (equal (fn2-cns-sources-phase s fn2-cns-sources) *fn2-cns-source-phase-manifest*)
               (equal (fn2-cns-sources-manifest-stage s fn2-cns-sources) *fn2-cns-source-manifest-stage-wait*)
               (equal (fn2-cns-sources-retention-phase s fn2-cns-sources) *fn2-cns-source-retention-collecting*)
               (fn2-read-parent-binding-current-p x parent receipt fn2-reads fn2-c-source-readers))
          (and (equal (fn2-cns-sources-retention-phase s fn2-cns-sources) *fn2-cns-source-retention-ready*)
               (or (equal (fn2-cns-sources-phase s fn2-cns-sources) *fn2-cns-source-phase-raw-wait*)
                   (and (equal (fn2-cns-sources-phase s fn2-cns-sources) *fn2-cns-source-phase-manifest*)
                        (equal (fn2-cns-sources-manifest-stage s fn2-cns-sources) *fn2-cns-source-manifest-stage-data-wait*)))
               (< parent (fn2-c-source-readers-rows fn2-c-source-readers))
               (equal (fn2-c-source-readers-live parent fn2-c-source-readers) 0)
               (equal (fn2-c-source-readers-serial parent fn2-c-source-readers) 0)))
         (natp op) (< op (fn2-ops-rows fn2-ops)) (< op (fn2-cns-source-operations-rows fn2-cns-source-operations))
         (equal (fn2-cns-source-operations-live op fn2-cns-source-operations) 1)
         (equal (fn2-cns-source-operations-generation op fn2-cns-source-operations) gen)
         (equal (fn2-cns-source-operations-source-row op fn2-cns-source-operations) s)
         (equal (fn2-ops-gen op fn2-ops) gen) (equal (fn2-ops-kind op fn2-ops) *fn2-action-read*)
         (member-equal (fn2-ops-phase op fn2-ops) (list *fn2-op-phase-queued* *fn2-op-phase-submitted*))
         (equal (fn2-ops-owner-kind op fn2-ops) *fn2-cns-kind*)
         (equal (fn2-ops-owner-slot op fn2-ops) id) (equal (fn2-ops-owner-gen op fn2-ops) generation)
         (equal (fn2-ops-range-slot op fn2-ops) (fn2-cns-sources-lslot s fn2-cns-sources))
         (equal (fn2-ops-range-gen op fn2-ops) (fn2-cns-sources-lgen s fn2-cns-sources)))) yes)))

; Full ordinary core snapshot, not a live stobj alias. This checks all five
; actual callback results and every child/scalar effect. Reported work is a
; separate assertion from the still-open implementation cost audit.
(defun fn2-cfm-pending-run-check (stage id generation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((unless (fn2-cfm-pending-domainp stage id generation fn2-core)) (mv :domain fn2-core))
      (before (fn2-test-core-snapshot fn2-core))
      ((mv bytes steps descriptors runnable fn2-core) (fn2-cns-run id 4 fn2-core))
      (after (fn2-test-core-snapshot fn2-core)))
  (mv (if (and (equal bytes *fn2-cns-source-unit-work-bytes*)
               (equal steps *fn2-work-poll*) (equal descriptors 0) (not runnable)
               (equal before after) (fn2-cfm-pending-domainp stage id generation fn2-core))
       :pass (list :callback bytes steps descriptors runnable)) fn2-core)))

; Run only against qualified layout2060684e plus the named span projection.
; The full-face3fc donor is quarantined and is not a prerequisite of this test.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/layout")
(deflayout fn2-span-fixture '((code :u8) (body (:octets32 6144)) (tail (:zero 3))))

(defun fn2-span-fields (i fn2-fields)
 (declare (xargs :stobjs fn2-fields :verify-guards nil :measure (nfix (- 8 (nfix i)))))
 (if (>= (nfix i) 8) nil
  (cons (list (fn2-fields-value i fn2-fields) (fn2-fields-ref-slot i fn2-fields)
              (fn2-fields-ref-gen i fn2-fields) (fn2-fields-ref-off i fn2-fields)
              (fn2-fields-ref-len i fn2-fields) (fn2-fields-status i fn2-fields))
        (fn2-span-fields (+ 1 (nfix i)) fn2-fields))))

(defun fn2-span-model-state (code next fn2-fields)
 (declare (xargs :stobjs fn2-fields :verify-guards nil))
 (list code next (fn2-span-fields 0 fn2-fields)
  (list (fn2-fields-cursor fn2-fields) (fn2-fields-pos fn2-fields)
        (fn2-fields-acc fn2-fields) (fn2-fields-high fn2-fields)
        (fn2-fields-size fn2-fields) (fn2-fields-resume-ref fn2-fields)
        (fn2-fields-phase fn2-fields) (fn2-fields-next fn2-fields))))

(defun fn2-span-compiled-state (code next fn2-fields)
 (declare (xargs :stobjs fn2-fields :verify-guards nil))
 (let* ((phase (fn2-fields-decode-phase 0 fn2-fields))
        (i (if (= phase (fn2-span-fixture-phase-keyword->code :done)) 3
             (fn2-span-fixture-field-index phase))))
  (list code next (fn2-span-fields 0 fn2-fields)
   (list i (fn2-fields-decode-pos 0 fn2-fields)
         (fn2-fields-decode-acc 0 fn2-fields) (fn2-fields-decode-high 0 fn2-fields)
         (fn2-fields-decode-size 0 fn2-fields) (fn2-fields-decode-ref 0 fn2-fields)
         (fn2-fields-decode-payload 0 fn2-fields) (fn2-fields-decode-next 0 fn2-fields)))))

(defun fn2-span-private (i fn2-fields)
 (declare (xargs :stobjs fn2-fields :verify-guards nil :measure (nfix (- 8 (nfix i)))))
 (if (>= (nfix i) 8) nil
  (cons (list (fn2-fields-decode-phase i fn2-fields) (fn2-fields-decode-pos i fn2-fields)
              (fn2-fields-decode-acc i fn2-fields) (fn2-fields-decode-high i fn2-fields)
              (fn2-fields-decode-size i fn2-fields) (fn2-fields-decode-ref i fn2-fields)
              (fn2-fields-decode-payload i fn2-fields) (fn2-fields-decode-next i fn2-fields))
        (fn2-span-private (+ 1 (nfix i)) fn2-fields))))

(defun fn2-span-frame (fn2-fields)
 (declare (xargs :stobjs fn2-fields :verify-guards nil))
 (list (fn2-fields-rows fn2-fields) (fn2-span-fields 0 fn2-fields)
       (fn2-span-private 0 fn2-fields)
       (fn2-span-model-state :snapshot 0 fn2-fields)))

(defun fn2-span-model (turns budget resume slot gen end fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil :measure (nfix turns)))
 (if (zp turns) (mv nil fn2-fields)
  (b* (((mv code next fn2-fields)
        (fn2-layout-decode-run '((code :u8) (body (:octets32 6144)) (tail (:zero 3)))
          slot gen 0 end 1 0 1 budget resume fn2-fields fn2-pool))
       (observed (fn2-span-model-state code next fn2-fields))
       ((mv rest fn2-fields)
        (if (eq code :more) (fn2-span-model (- turns 1) budget t slot gen end fn2-fields fn2-pool)
          (mv nil fn2-fields))))
   (mv (cons observed rest) fn2-fields))))

(defun fn2-span-compiled (expected budget slot gen end fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (if (atom expected) (mv nil fn2-fields)
  (b* (((mv code next fn2-fields)
        (fn2-span-fixture-decode-step 0 slot gen 0 end 1 0 1 budget fn2-fields fn2-pool))
       (same (equal (fn2-span-compiled-state code next fn2-fields) (car expected)))
       ((mv rest fn2-fields)
        (if (and (eq code :more) (consp (cdr expected)))
            (fn2-span-compiled (cdr expected) budget slot gen end fn2-fields fn2-pool)
          (mv (and (null (cdr expected)) (eq code :ok) (= next end)) fn2-fields))))
   (mv (and same rest) fn2-fields))))

(defun fn2-span-fill (i n slot gen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- (nfix n) (nfix i)))))
 (if (>= (nfix i) (nfix n)) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen i (mod i 256) 1 0 1 fn2-pool)
   (if (eq code :ok) (fn2-span-fill (+ 1 i) n slot gen fn2-pool) (mv code fn2-pool)))))

(defun fn2-span-case (n budget fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init 8 fn2-fields))
      (fn2-pool (fn2-pool-init '((2 . 8192)) 1 100 fn2-pool))
      ((mv sc source sg fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv dc slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv filled fn2-pool) (fn2-span-fill 0 n source sg fn2-pool))
      (fn2-fields (fn2-fields-set-value 0 11 fn2-fields))
      (fn2-fields (fn2-fields-set-ref-slot 1 source fn2-fields))
      (fn2-fields (fn2-fields-set-ref-gen 1 sg fn2-fields))
      (fn2-fields (fn2-fields-set-ref-off 1 0 fn2-fields))
      (fn2-fields (fn2-fields-set-ref-len 1 n fn2-fields))
      ((mv ec end fn2-pool) (fn2-span-fixture-encode 0 slot gen 0 1 0 1 fn2-fields fn2-pool))
      (premise (and (eq sc :ok) (eq dc :ok) (eq filled :ok) (eq ec :ok)
        (= end (+ n 8)) (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)
        (fn2-poolp fn2-pool) (fn2-pool-semanticp fn2-pool)
        (eq (fn2-layout-range-code slot gen 0 end nil 1 0 1 fn2-pool) :ok)))
      (fn2-fields (fn2-fields-init 8 fn2-fields))
      ((mv expected fn2-fields) (fn2-span-model (+ 1 end) budget nil slot gen end fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-init 8 fn2-fields))
      (fn2-fields (fn2-span-fixture-start 0 fn2-fields))
      (frame (fn2-span-frame fn2-fields))
      ((mv zero-code zero-next fn2-fields)
       (fn2-span-fixture-decode-step 0 slot gen 0 end 1 0 1 0 fn2-fields fn2-pool))
      (zero-same (and (eq zero-code :bounds) (= zero-next 0)
                     (equal frame (fn2-span-frame fn2-fields))))
      ((mv owner-code owner-next fn2-fields)
       (fn2-span-fixture-decode-step 0 slot gen 0 end 1 0 2 budget fn2-fields fn2-pool))
      (owner-same (and (eq owner-code :owner) (= owner-next 0)
                      (equal frame (fn2-span-frame fn2-fields))))
      ((mv equal-visits fn2-fields) (fn2-span-compiled expected budget slot gen end fn2-fields fn2-pool)))
  (mv (and premise zero-same owner-same equal-visits) fn2-fields fn2-pool)))

(defun fn2-span-test (n budget)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (ok fn2-fields)
   (with-local-stobj fn2-pool
    (mv-let (ok fn2-fields fn2-pool) (fn2-span-case n budget fn2-fields fn2-pool)
     (mv ok fn2-fields))) ok)))

; Compare every MORE/OK visit, exact NEXT, all semantic fields (including the
; untouched rows), and the actual model-to-generated continuation mapping.
(assert-event (fn2-span-test 6144 1))
(assert-event (fn2-span-test 6144 4096))
(assert-event (fn2-span-test 1 1))
(assert-event (fn2-span-test 0 4096))

; Actual identity callback versus its generated FIFO-effect program.
; These initialized core callback controls are not a served-turn reachability
; proof. All original scalar results and full R are checked on every step.
(in-package "ACL2")
(include-book "../books/reference-effect-query")
(include-book "cns-query-support")

; Read the antecedent from the generated LIVE obligation, including both
; actual callable guards. The display row is not a substitute hypothesis.
(make-event
 (let* ((world (w state))
        (row (fn2-decl-row '(:square fn2-identity-decide-ref-effect-whole-result) world))
        (formula (fn2-decl-statement-body (fn2-decl-get :statement row) world))
        (hyp (cond ((and (consp formula) (eq (car formula) 'implies)
                         (equal (len formula) 3)) (cadr formula))
                   ((and (consp formula) (eq (car formula) 'if)
                         (equal (len formula) 4) (equal (cadddr formula) ''t))
                    (cadr formula))
                   (t nil))))
   (if (not hyp)
       (er soft 'fn2-ref-query-live-h "Actual whole-result implication is missing or changed.")
     (value `(defun fn2-ref-query-live-whole-h (tx budget lists fn2-core fn2-ref-core)
               (declare (ignorable tx budget)
                        (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
               ,(fn2-lower-source-form
                  (fn2-lower-substitute hyp '((fn2-effect-fifo . lists)) world)))))))

(defun fn2-ref-query-paired-domainp (lists fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (and (fn2-corep fn2-core) (fn2-ref-corep fn2-ref-core)
       (fn2-core-wfp fn2-core) (fn2-core-wfp fn2-ref-core)
       (fn2-representation-relation fn2-core fn2-ref-core lists)))

(defun fn2-ref-query-paired-drive (fuel tx lists fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil
                  :measure (nfix fuel)))
  (b* ((whole-h (fn2-ref-query-live-whole-h tx 4096 lists fn2-core fn2-ref-core))
       ((when (zp fuel)) (mv nil :fuel lists fn2-core fn2-ref-core))
       (before (fn2-test-core-snapshot fn2-core))
       ((mv code fn2-core) (fn2-identity-decide tx 4096 fn2-core))
       ((mv rcode fn2-ref-core after-lists)
        (fn2-identity-decide-ref-effect tx 4096 fn2-ref-core lists))
       (whole-c (and (equal code rcode)
                     (fn2-representation-relation fn2-core fn2-ref-core after-lists)))
       ((unless (and whole-h whole-c)) (mv nil code after-lists fn2-core fn2-ref-core)))
    (if (eq code :more)
        (fn2-ref-query-paired-drive (- fuel 1) tx after-lists fn2-core fn2-ref-core)
      ; Dropping just the semantic carrier preserves the actual code and
      ; modeled core. On the last close this must falsify ORIGINAL post-R.
      (mv (and (eq code :stored)
               (fn2-cns-query-alias-done-framep tx
                 (fn2-cns-drain-cell 'fn2-id-decides-q1slot tx
                   (fn2-cns-drain-child 'fn2-id-decides before))
                 before (fn2-test-core-snapshot fn2-core))
               (not (fn2-representation-relation fn2-core fn2-ref-core lists)))
          code after-lists fn2-core fn2-ref-core))))

(defun fn2-ref-query-effect-run (mode fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (b* ((profile (cond ((eq mode :trace-disabled)
                       (put-assoc-equal :trace nil *fn2-cns-drain-profile*))
                      ((eq mode :trace-lost)
                       (put-assoc-equal :trace-capacity 1 *fn2-cns-drain-profile*))
                      (t *fn2-cns-drain-profile*)))
       ((mv setup id sibling fn2-core) (fn2-cns-drain-setup-profile profile nil fn2-core))
       (gen (fn2-cns-row-generation id fn2-core))
       (slot (fn2-cns-row-ns-slot id fn2-core))
       (sgen (fn2-cns-row-ns-gen id fn2-core))
       ((mv w0 fn2-core) (fn2-cns-query-write '(60 113 62) slot sgen 0 id gen fn2-core))
       ((mv w1 fn2-core) (fn2-cns-query-write (make-list 32 :initial-element 7)
                          slot sgen 3 id gen fn2-core))
       (fn2-core (fn2-machine-set-wake-id *fn2-none* fn2-core))
       ((mv q0 fn2-core) (fn2-identity-decide-start 0 slot sgen 0 3 slot sgen 3
                          *fn2-cns-kind* id gen fn2-core))
       ((mv q1 fn2-core) (fn2-identity-decide-start 1 slot sgen 0 3 slot sgen 3
                          *fn2-cns-kind* id gen fn2-core))
       ((mv done0 fn2-core) (fn2-cns-query-drive 32 0 fn2-core))
       (ordinary (if (eq mode :ordinary-same) id sibling))
       (fn2-core (fn2-machine-wake-row ordinary fn2-core))
       ; Fill/loss concerns diagnostics only. Enqueue the sibling, so the
       ; query owner is still fresh and dropping its FIFO effect is detected.
       (fn2-core
        (if (eq mode :trace-lost)
            (let* ((fn2-core (fn2-core-scheduler-wake sibling fn2-core))
                   (fn2-core (fn2-core-record-enqueue sibling fn2-core))
                   (fn2-core (fn2-core-scheduler-wake sibling fn2-core)))
              (fn2-core-record-enqueue sibling fn2-core)) fn2-core))
       (lists (list (fn2-ref-calendar (fn2-profile-weights profile)) 0
                    (if (eq mode :trace-lost) (list (list 0 sibling)) nil)
                    '(0 0 0 0) nil))
       (fn2-ref-core (fn2-ref-reset profile fn2-core fn2-ref-core))
       (initial (and setup (eq w0 :ok) (eq w1 :ok) (eq q0 :ok) (eq q1 :ok)
                     (eq done0 :stored) (not (equal id sibling))
                     (fn2-ref-query-paired-domainp lists fn2-core fn2-ref-core)))
       (before-refusal (fn2-test-core-snapshot fn2-core))
       ((mv refused fn2-core) (fn2-identity-decide *fn2-none* 4096 fn2-core))
       ((mv rrefused fn2-ref-core refusal-lists)
        (fn2-identity-decide-ref-effect *fn2-none* 4096 fn2-ref-core lists))
       (refusal (and (fn2-ref-query-live-whole-h *fn2-none* 4096 lists fn2-core fn2-ref-core)
                     (eq refused :bounds) (eq rrefused :bounds)
                     (equal lists refusal-lists)
                     (equal before-refusal (fn2-test-core-snapshot fn2-core))
                     (fn2-representation-relation fn2-core fn2-ref-core refusal-lists)))
       ((mv paired code after-lists fn2-core fn2-ref-core)
        (fn2-ref-query-paired-drive 32 1 lists fn2-core fn2-ref-core))
       (after (fn2-test-core-snapshot fn2-core))
       (trace (fn2-cns-drain-child 'fn2-trace after))
       (expected-queue (if (eq mode :trace-lost) (list sibling id) (list id)))
       ((mv wake fn2-core) (fn2-machine-take-wake fn2-core))
       ((mv rwake fn2-ref-core) (fn2-machine-take-wake fn2-ref-core))
       ((mv fn2-ref-core final-lists) (fn2-ref-effect-scheduler-wake rwake fn2-ref-core after-lists))
       (fn2-core (fn2-core-scheduler-wake wake fn2-core))
       (fn2-core (fn2-core-record-enqueue wake fn2-core)))
    (mv (and initial refusal paired (eq code :stored)
             (equal (fn2-ref-queue 0 (nth 2 after-lists)) expected-queue)
             (equal wake ordinary) (equal rwake ordinary)
             (fn2-representation-relation fn2-core fn2-ref-core final-lists)
             (equal (fn2-ref-queue 0 (nth 2 final-lists))
                    (if (or (eq mode :ordinary-same) (eq mode :trace-lost))
                        expected-queue (list id sibling)))
             (cond ((eq mode :trace-disabled)
                    (equal (fn2-cns-drain-get 'fn2-trace-enabled trace) 0))
                   ((eq mode :trace-lost) (< 0 (fn2-cns-drain-get 'fn2-trace-lost trace)))
                   (t t))) fn2-core fn2-ref-core)))

(defun fn2-ref-query-effect-control (mode)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (yes fn2-core)
      (with-local-stobj fn2-ref-core
        (mv-let (yes fn2-core fn2-ref-core)
          (fn2-ref-query-effect-run mode fn2-core fn2-ref-core)
          (mv yes fn2-core))) yes)))
(assert-event (and (fn2-ref-query-effect-control :ordinary-distinct)
                   (fn2-ref-query-effect-control :ordinary-same)
                   (fn2-ref-query-effect-control :trace-disabled)
                   (fn2-ref-query-effect-control :trace-lost)))

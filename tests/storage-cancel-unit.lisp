; Public admitted operations, not a claim that served commit arms issue Cancel.
; Native TAKE acknowledges then submits blocking storage immediately. Cancelling
; such a flight is too late; TLS/network flights remain cancellable.
(in-package "ACL2")
(include-book "native-cut-program-unit")

(defun fn2-storage-cancel-terminal (op outcome fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (ok)
  (and (= (fn2-ops-c0-posted op fn2-ops) 1)
       (= (fn2-ops-c0-outcome op fn2-ops) outcome)) ok))

(defun fn2-storage-cancel-flight (target cancellable fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((gen (fn2-sim-gen target fn2-sim))
      (kind (fn2-sim-kind target fn2-sim))
      ((unless (= (fn2-sim-active target fn2-sim) 1)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv code cancel cg fn2-core) (fn2-issue-cancel target gen 1 0 1 0 fn2-core))
      (- cg)
      ((unless (eq code :ok)) (mv nil fn2-core fn2-sim fn2-own))
      (fn2-own (fn2-own-observe-issue cancel fn2-core fn2-own))
      ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
      ((unless (= taken 1)) (mv nil fn2-core fn2-sim fn2-own))
      (disk-before (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim)))
                     (snapshot) (fn2-sim-storage-copy fn2-sim-storage) snapshot))
      ((mv completed fn2-core fn2-sim fn2-own)
       (fn2-sim-complete cancel *fn2-fault-none* 0 fn2-core fn2-sim fn2-own))
      (disk-after (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim)))
                    (snapshot) (fn2-sim-storage-copy fn2-sim-storage) snapshot))
      (cancel-ok (and completed
                     (fn2-storage-cancel-terminal cancel
                       (if cancellable *fn2-outcome-done* *fn2-outcome-not-found*) fn2-core)
                     (= (fn2-sim-active target fn2-sim) 1)
                     (= (fn2-sim-cancelled target fn2-sim) (if cancellable 1 0))
                     (equal disk-before disk-after)))
      ((mv advanced fn2-core fn2-sim fn2-own)
       (fn2-sim-step-completion target *fn2-fault-none* 0 fn2-core fn2-sim fn2-own))
      (held (and (equal kind *fn2-action-fence*)
                 (= (fn2-sim-active target fn2-sim) *fn2-sim-native-returned*)))
      ((mv posted fn2-core fn2-sim fn2-own)
       (if held (fn2-sim-step-completion target *fn2-fault-none* 0 fn2-core fn2-sim fn2-own)
         (mv t fn2-core fn2-sim fn2-own))))
   (mv (and cancel-ok advanced posted
            (implies (equal kind *fn2-action-fence*) held)
            (= (fn2-sim-active target fn2-sim) 0)
            (fn2-storage-cancel-terminal target
              (if cancellable *fn2-outcome-cancelled* *fn2-outcome-done*) fn2-core))
       fn2-core fn2-sim fn2-own)))

(defun fn2-storage-cancel-write-or-fence (fencep fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((mv ready target fn2-core fn2-sim fn2-own)
       (fn2-native-cut-fixture t fn2-core fn2-sim fn2-own))
      ((unless ready) (mv nil fn2-core fn2-sim fn2-own))
      ((mv ready target fn2-core fn2-sim fn2-own)
       (if (not fencep) (mv t target fn2-core fn2-sim fn2-own)
        (b* (((mv written fn2-core fn2-sim fn2-own)
              (fn2-sim-complete target *fn2-fault-none* 0 fn2-core fn2-sim fn2-own))
             ((mv code fence fg fn2-core) (fn2-issue-fence 1 0 1 0 fn2-core))
             (- fg)
             (fn2-own (fn2-own-observe-issue fence fn2-core fn2-own))
             ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own)))
          (mv (and written (eq code :ok) (= taken 1)) fence fn2-core fn2-sim fn2-own))))
      ((unless ready) (mv nil fn2-core fn2-sim fn2-own))
      ((mv refused fn2-core fn2-sim fn2-own)
       (fn2-storage-cancel-flight target nil fn2-core fn2-sim fn2-own))
      (effect (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim))) (ok)
                (and (= (fn2-sim-storage-pending 0 fn2-sim-storage) 17)
                     (implies fencep (= (fn2-sim-storage-durable 0 fn2-sim-storage) 17))) ok)))
   (mv (and refused effect) fn2-core fn2-sim fn2-own)))

(defun fn2-storage-cancel-input-or-tls (kind fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
      (fn2-sim (fn2-sim-init 7 :friendly "storage-cancel" *fn2-profile-tiny* fn2-sim))
      ((mv nc nonce fn2-sim)
       (stobj-let ((fn2-sim-network (fn2-sim-net fn2-sim))) (code nonce fn2-sim-network)
         (fn2-network-accept 0 fn2-sim-network) (mv code nonce fn2-sim)))
      ((unless (eq nc :ok)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv code range rg fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
      ((unless (eq code :ok)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv code fn2-core) (fn2-core-write range rg 0 17 1 0 1 fn2-core))
      (fn2-own (fn2-own-observe-core-write range rg 0 code 17 fn2-core fn2-own))
      ((unless (eq code :ok)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv disk-code fn2-sim)
       (if (eq kind :read)
           (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim))) (code fn2-sim-storage)
             (fn2-storage-write-byte 0 0 29 1 nil nil fn2-sim-storage)
             (mv code fn2-sim))
         (mv :ok fn2-sim)))
      ((unless (eq disk-code :ok)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv code target tg fn2-core)
       (cond ((eq kind :read) (fn2-issue-read 0 range rg 1 1 0 1 0 fn2-core))
             ((eq kind :tls) (fn2-issue-tls-start 0 nonce range rg 0 1 1 0 1 0 fn2-core))
             (t (fn2-issue-receive 0 nonce range rg 1 1 0 1 0 fn2-core))))
      (- tg)
      ((unless (eq code :ok)) (mv nil fn2-core fn2-sim fn2-own))
      (fn2-own (fn2-own-observe-issue target fn2-core fn2-own))
      ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
      ((unless (= taken 1)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv ok fn2-core fn2-sim fn2-own)
       (fn2-storage-cancel-flight target (not (eq kind :read)) fn2-core fn2-sim fn2-own))
      (effect (if (not (eq kind :read)) t
                (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (yes)
                 (and (= (fn2-pool-datai (fn2-pool-base range fn2-pool) fn2-pool) 17)
                      (= (fn2-pool-datai (+ 1 (fn2-pool-base range fn2-pool)) fn2-pool) 29)) yes))))
   (mv (and ok effect) fn2-core fn2-sim fn2-own)))

(defun fn2-storage-cancel-control (kind)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (ok fn2-core)
   (with-local-stobj fn2-sim
    (mv-let (ok fn2-core fn2-sim)
     (with-local-stobj fn2-own
      (mv-let (ok fn2-core fn2-sim fn2-own)
       (if (member-eq kind '(:write :fence))
           (fn2-storage-cancel-write-or-fence (eq kind :fence) fn2-core fn2-sim fn2-own)
         (fn2-storage-cancel-input-or-tls kind fn2-core fn2-sim fn2-own))
       (mv ok fn2-core fn2-sim)))
     (mv ok fn2-core))) ok)))

(assert-event (fn2-storage-cancel-control :write))
(assert-event (fn2-storage-cancel-control :fence))
(assert-event (fn2-storage-cancel-control :read))
(assert-event (fn2-storage-cancel-control :tls))
(assert-event (fn2-storage-cancel-control :receive))

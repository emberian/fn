(in-package "ACL2")
(include-book "../books/retirement")
(include-book "std/util/bstar" :dir :system)

; Exercise the shared concrete install operation. The containing journal batch
; binds retirement, rather than trusting the cut supplied inside its record.
(defun fn2-retirement-test-body (fn2-fields fn2-extents)
 (declare (xargs :stobjs (fn2-fields fn2-extents) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init 16 fn2-fields))
      (fn2-extents (fn2-alloc-init 2 fn2-extents))
      ((mv begin fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv reserve & extent epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv commit fn2-extents) (fn2-alloc-commit-allocation extent epoch allocation 1 1 fn2-extents))
      ((unless (and (eq begin :ok) (eq reserve :ok) (eq commit :ok)
                    (fn2-alloc-invp fn2-extents)
                    (eq (fn2-alloc-handle-code extent epoch allocation fn2-extents) :ok)
                    (= (fn2-extents-state extent fn2-extents) *fn2-extent-state-allocated*)))
       (mv nil fn2-fields fn2-extents))
      (fn2-fields (fn2-fields-set-value *fn2-format-retirement-field-extent* extent fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-retirement-field-writer-epoch* epoch fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-retirement-field-allocation* allocation fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-retirement-field-retirement-commit* 2 fn2-fields))
      ((mv wrong-batch fn2-extents) (fn2-retirement-install 3 0 fn2-fields fn2-extents))
      ((unless (and (eq wrong-batch :commit)
                    (= (fn2-extents-state extent fn2-extents) *fn2-extent-state-allocated*)))
       (mv nil fn2-fields fn2-extents))
      ((mv installed fn2-extents) (fn2-retirement-install 2 0 fn2-fields fn2-extents))
      ((mv repeated fn2-extents) (fn2-retirement-install 2 0 fn2-fields fn2-extents))
      ((unless (and (eq installed :ok) (eq repeated :ok)
                    (fn2-alloc-invp fn2-extents)
                    (= (fn2-extents-retirement extent fn2-extents) 2)
                    (= (fn2-extents-state extent fn2-extents) *fn2-extent-state-retire-pending*)))
       (mv nil fn2-fields fn2-extents))
      (fn2-fields (fn2-fields-set-value *fn2-format-retirement-field-retirement-commit* 3 fn2-fields))
      ((mv conflict fn2-extents) (fn2-retirement-install 3 0 fn2-fields fn2-extents))
      (fn2-fields (fn2-fields-set-value *fn2-format-retirement-field-writer-epoch* (+ 1 epoch) fn2-fields))
      ((mv stale fn2-extents) (fn2-retirement-install 3 0 fn2-fields fn2-extents)))
  (mv (and (eq conflict :retirement-conflict) (eq stale :identity)
           (fn2-alloc-invp fn2-extents)
           (= (fn2-extents-retirement extent fn2-extents) 2)) fn2-fields fn2-extents)))

(defun fn2-retirement-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (answer fn2-fields)
   (with-local-stobj fn2-extents
    (mv-let (answer fn2-fields fn2-extents)
     (fn2-retirement-test-body fn2-fields fn2-extents) (mv answer fn2-fields)))
   answer)))
(assert-event (fn2-retirement-test))

; The real member encoder and both concrete decoders agree on the header/body
; boundary, including multibyte IDs. Truncation cannot become a valid record.
(defun fn2-retirement-codec-test-body (fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init 16 fn2-fields))
      (fn2-pool (fn2-pool-init '((1 . 128)) 1 100 fn2-pool))
      ((mv reserved slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((unless (eq reserved :ok)) (mv nil fn2-fields fn2-pool))
      ((mv packed end fn2-fields fn2-pool)
       (fn2-retirement-pack-member 17 128 129 130 0 slot gen 0 1 0 1 fn2-fields fn2-pool))
      ((unless (eq packed :ok)) (mv nil fn2-fields fn2-pool))
      ((mv header next fn2-fields)
       (fn2-format-txn-record-decode 8 slot gen 0 end 1 0 1 fn2-fields fn2-pool))
      ((unless (and (eq header :ok)
                    (= (fn2-fields-value (+ 8 *fn2-format-txn-record-field-record-kind*) fn2-fields)
                       *record-kind-retirement*)
                    (= (+ next (fn2-fields-value (+ 8 *fn2-format-txn-record-field-length*) fn2-fields)) end)))
       (mv nil fn2-fields fn2-pool))
      ((mv decoded stop fn2-fields)
       (fn2-format-retirement-decode 0 slot gen next end 1 0 1 fn2-fields fn2-pool))
      ((unless (and (eq decoded :ok) (= stop end)
                    (= (fn2-fields-value *fn2-format-retirement-field-extent* fn2-fields) 17)
                    (= (fn2-fields-value *fn2-format-retirement-field-writer-epoch* fn2-fields) 128)
                    (= (fn2-fields-value *fn2-format-retirement-field-allocation* fn2-fields) 129)
                    (= (fn2-fields-value *fn2-format-retirement-field-retirement-commit* fn2-fields) 130)))
       (mv nil fn2-fields fn2-pool))
      ((mv truncated & fn2-fields)
       (fn2-format-retirement-decode 0 slot gen next (- end 1) 1 0 1 fn2-fields fn2-pool)))
  (mv (not (eq truncated :ok)) fn2-fields fn2-pool)))
(defun fn2-retirement-codec-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (answer fn2-fields)
   (with-local-stobj fn2-pool
    (mv-let (answer fn2-fields fn2-pool)
     (fn2-retirement-codec-test-body fn2-fields fn2-pool) (mv answer fn2-fields)))
   answer)))
(assert-event (fn2-retirement-codec-test))

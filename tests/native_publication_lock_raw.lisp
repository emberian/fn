;;; Exact non-Linux publication lock branch and shared cleanup macro.
(require :sb-posix)
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defun source-definition (path kind name &optional nonlinux)
  (with-open-file (stream path)
    (let* ((text (make-string (file-length stream)))
           (prefix (format nil "(~a ~a " kind name))
           (*features* (if nonlinux (remove :linux *features*) *features*)))
      (read-sequence text stream)
      (let ((start (search prefix text)))
        (unless start (error "missing definition ~a" name))
        (read-from-string text nil nil :start start)))))
(define-condition fnn-os-error (error) ((errno :initarg :errno :reader fnn-os-errno)))
(define-condition refused (error) ())
(define-condition uncertain (error) ())
(defparameter +fnn-o-nofollow+ 0)
(defparameter +fnn-lock-ex+ 2)
(defparameter +fnn-lock-nb+ 4)
(defparameter +fnn-lock-un+ 8)
(defvar *fnn-publication-close-debts* nil)
(defvar *mode* nil)
(defvar *opens* 0)
(defvar *closes* 0)
(defvar *unlocks* 0)
(defvar *close-failure* nil)
(defun fnn-concat (&rest args) (apply #'concatenate 'string args))
(defun fnn-err (&rest args) (declare (ignore args)))
(defun fnn-fault (&rest args) (error "fault ~a" args))
(defun fnn-refuse (&rest args) (declare (ignore args)) (error 'refused))
(defun fnn-indeterminate (&rest args) (declare (ignore args)) (error 'uncertain))
(defun fnn-open (&rest args)
  (declare (ignore args)) (incf *opens*)
  (when (eq *mode* :open-fault) (error 'fnn-os-error :errno sb-posix:eio)) 11)
(defun fnn-fstat (fd)
  (assert (= fd 11))
  (when (eq *mode* :fstat-fault) (error 'fnn-os-error :errno sb-posix:eio)) :info)
(defun fnn-regular-p (info) (assert (eq info :info)) (not (eq *mode* :nonregular)))
(defun fnn-flock (fd flags)
  (assert (= fd 11))
  (if (= flags +fnn-lock-un+)
      (progn (incf *unlocks*) (when (eq *mode* :unlock-fault) (error "unlock-fault")))
    (case *mode*
      (:busy (error 'fnn-os-error :errno sb-posix:eagain))
      (:denied (error 'fnn-os-error :errno sb-posix:eacces))
      (:flock-fault (error 'fnn-os-error :errno sb-posix:eio)))))
(defun fnn-close (fd)
  (assert (= fd 11)) (incf *closes*)
  (when *close-failure* (error "close-fault")))
(defun observed (thunk)
  (handler-case (funcall thunk)
    (fnn-os-error (e) (list :os (fnn-os-errno e)))
    (refused () :refused) (uncertain () :uncertain)
    (error (e) (princ-to-string e))))
(eval (source-definition (or (sb-ext:posix-getenv "FN_CLEANUP_HOST_SOURCE") "host/native/io.lisp")
                         "defmacro" "fnn-unwind-cleanups"))
(dolist (name '("fnn-publication-lock" "fnn-publication-unlock"))
  (eval (source-definition (or (sb-ext:posix-getenv "FN_PUBLICATION_HOST_SOURCE") "host/native/io.lisp")
                           "defun" name t)))
(dolist (case (list (list :success 11 0) (list :busy :refused 1)
                   (list :denied :refused 1)
                   (list :fstat-fault (list :os sb-posix:eio) 1)
                   (list :flock-fault (list :os sb-posix:eio) 1)
                   (list :open-fault (list :os sb-posix:eio) 0)))
  (destructuring-bind (mode expected close-count) case
    (let ((*mode* mode) (*opens* 0) (*closes* 0) (*unlocks* 0)
          (*fnn-publication-close-debts* nil))
      (assert (equal (observed (lambda () (fnn-publication-lock "/root"))) expected))
      (assert (= *closes* close-count)))))
(let ((*mode* :fstat-fault) (*close-failure* t) (*closes* 0)
      (*fnn-publication-close-debts* nil))
  (assert (equal (observed (lambda () (fnn-publication-lock "/root")))
                 (list :os sb-posix:eio)))
  (assert (= *closes* 1))
  (assert (= (caar *fnn-publication-close-debts*) 11)))
(dolist (mode '(:success :unlock-fault :close-fault))
  (let ((*mode* mode) (*close-failure* (eq mode :close-fault))
        (*opens* 0) (*closes* 0) (*unlocks* 0) (*fnn-publication-close-debts* nil))
    (let ((answer (observed (lambda () (fnn-publication-unlock 11)))))
      (assert (= *closes* 1)) (assert (= *unlocks* 1))
      (if (eq mode :success) (assert (null answer))
        (progn (assert (eq answer :uncertain))
               (assert (= (caar *fnn-publication-close-debts*) 11))
               (assert (eq (observed (lambda () (fnn-publication-unlock 11))) :uncertain))
               (assert (= *closes* 1))
               (assert (eq (observed (lambda () (fnn-publication-lock "/other"))) :uncertain))
               (assert (= *opens* 0)))))))
(format t "Non-Linux publication lock custody passed (10 paths)~%")
(let ((*features* (adjoin :linux *features*)))
  (eval (source-definition (or (sb-ext:posix-getenv "FN_PUBLICATION_HOST_SOURCE") "host/native/io.lisp")
                           "defun" "fnn-publication-lock")))
(let ((*opens* 0) (*closes* 0) (*fnn-publication-close-debts* (list '(11 :debt))))
  (assert (null (fnn-publication-lock "/root")))
  (assert (= *opens* 0)) (assert (= *closes* 0)))
(format t "Linux no-lock publication branch passed~%")

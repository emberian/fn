;;; Actual cleanup callbacks/envelope over recording primitive effects.
;;; Real owner exclusion; no descriptor-close or output-pool settlement claim.
(load "tests/native_actor_envelope_raw.lisp")
(in-package "ACL2")

;;; ---- derived stubs: BEGIN (python3 tools/harness_check.py --write-stubs; do not edit) ----
(define-condition harness-stub-reached (serious-condition)
  ((name :initarg :name :reader harness-stub-reached-name)
   (source :initarg :source :reader harness-stub-reached-source))
  (:report (lambda (c s)
             (format s "harness: host function ~(~a~) (~a) was reached; this harness neither stubs nor extracts it"
                     (harness-stub-reached-name c) (harness-stub-reached-source c)))))
(defun harness-stub-reached (name source)
  (format *error-output* "harness: host function ~(~a~) (~a) was reached; this harness neither stubs nor extracts it~%"
          name source)
  (finish-output *error-output*)
  (error 'harness-stub-reached :name name :source source))
(defun fnn-owner-syncer-physical (service grant receipt)
  (declare (ignorable service grant receipt))
  (harness-stub-reached 'fnn-owner-syncer-physical "host/native/owner.lisp"))
(defun fnn-tls-close-channel (channel)
  (declare (ignorable channel))
  (harness-stub-reached 'fnn-tls-close-channel "host/native/tls.lisp"))
(defun fnn-zout-free (zout)
  (declare (ignorable zout))
  (harness-stub-reached 'fnn-zout-free "host/native/deflate.lisp"))
;;; ---- derived stubs: END ----
(load-deployed-forms "host/native/owner.lisp"
 '((def-section fnn-quantum-mux-finish) (defun fnn-owner-thread-escape)))
(load-deployed-forms "host/native/mux.lisp"
 '((defstruct (fnn-mux-cleanup-receipt (:constructor %make-fnn-mux-cleanup-receipt)))
   (defun fnn-mux-service) (defun fnn-mux-cleanup-debt)
   (defun fnn-mux-cleanup-attempt) (defun fnn-mux-handshake-release)
   (defun fnn-mux-finish) (defun fnn-mux-drained-p)))
(defvar *cleanup-calls* nil)
(defvar *cleanup-mode* nil)
(defun fnn-owner-gate-check (gate)
  (declare (ignore gate))
  (when (eq *cleanup-mode* :pre-entry) (error "gate rejected before callback")))
(defun fnn-owner-gate-enter (gate class) (declare (ignore gate class)) 0)
(defun fnn-owner-gate-abort (gate condition) (declare (ignore gate condition)) nil)
(defun fnn-owner-gate-leave (gate class hold wait)
  (declare (ignore gate class hold wait))
  (when (eq *cleanup-mode* :after-return) (error "gate leave after effect returned")))
(defun fnn-owner-stop-service-locked (service code &optional answering)
  (declare (ignore code answering))
  (check (sb-thread:holding-mutex-p (fnn-owner-service-lock service)) "cleanup fence under owner exclusion")
  (setf (fnn-owner-service-stopping service) t))
(defun fnn-owner-fence-service (service) (setf (fnn-owner-service-stopping service) t))
(defun fnn-owner-core (name &rest args)
  (push (cons name args) *cleanup-calls*)
  (when (and (eq name 'fn-owner-close) (eq *cleanup-mode* :torn))
    (throw 'raw-ev-fncall :cut-between-close-puts))
  (case name ((fn-owner-handshake-done fn-owner-handshake-leave) :ok)
             (fn-owner-close :closed) (fn-owner-exposure-release :released)
             (otherwise (error "unexpected actual cleanup subject ~s" name))))
(defun fnn-owner-action (name &rest args) (apply #'fnn-owner-core name args))
(defun fnn-owner-response-unpin (service cid)
  (declare (ignore service cid))
  (push :unpin *cleanup-calls*)
  (when (eq *cleanup-mode* :unpin-fault) (error "unpin failed")))
(defun fnn-owner-await-abandon (service cid) (declare (ignore service cid)) nil)
(defun fnn-socket-shut (socket)
  (push (list :socket-shut socket) *cleanup-calls*)
  (if (eq *cleanup-mode* :socket-fault)
      (values nil :unobserved (make-condition 'simple-error :format-control "socket close failed"))
    (values nil :closed nil)))
(defun fnn-mux-start-waiting-handshake (loop) (declare (ignore loop)) nil)

(let* ((service (%make-fnn-owner-service :lock (sb-thread:make-mutex)))
       (loop (%make-fnn-mux-loop :service service :closed t))
       (conn (%make-fnn-mux-conn :phase :hs-wait :cid 3 :opened-cid 3
               :socket :socket :out #(1 2) :plan '(:plan) :input #(3) :greeting #(4) :zstash #(5))))
  (setf (fnn-owner-service-stopping service) t (fnn-owner-service-mux service) (list loop)
        (fnn-mux-loop-conns loop) (list conn) *cleanup-calls* nil)
  (fnn-mux-finish loop conn)
  (check (and (eq (fnn-mux-conn-phase conn) :done)
              (null (fnn-mux-conn-out conn)) (null (fnn-mux-conn-plan conn))
              (null (fnn-mux-conn-input conn)) (null (fnn-mux-conn-zstash conn))
              (null (fnn-mux-loop-cleanup-debts loop)) (fnn-mux-drained-p service))
         "stopping cleanup runs declared callbacks and clears output aliases before unpin")
  (dolist (subject '(fn-owner-handshake-leave fn-owner-close fn-owner-exposure-release))
    (check (= 1 (count subject *cleanup-calls* :key (lambda (x) (if (consp x) (car x) x))))
           "each literal cleanup subject called once"))
  (let ((before (copy-list *cleanup-calls*)))
    (fnn-mux-finish loop conn)
    (check (equal before *cleanup-calls*) "terminal scheduling does not retry cleanup")))

(dolist (mode '(:pre-entry :after-return))
  (let* ((*cleanup-mode* mode) (*cleanup-calls* nil)
         (service (%make-fnn-owner-service :lock (sb-thread:make-mutex)))
         (loop (%make-fnn-mux-loop :service service :closed t))
         (conn (%make-fnn-mux-conn :phase :serving :hs-id 17)))
    (setf (fnn-owner-service-mux service) (list loop))
    (fnn-mux-handshake-release loop conn)
    (let ((receipt (cdr (assoc '(:handshake-done 17) (fnn-mux-conn-cleanup-receipts conn) :test #'equal))))
      (check (and (equal (fnn-mux-conn-hs-id conn) 17)
                  (fnn-mux-loop-cleanup-debts loop) (not (fnn-mux-drained-p service))
                  (not (fnn-mux-cleanup-receipt-section-returned receipt)))
             "rejected/failed section retains exact handshake identity and root debt")
      (check (if (eq mode :after-return)
                 (and (eq (fnn-mux-cleanup-receipt-stage receipt) :returned)
                      (eq (fnn-mux-cleanup-receipt-value receipt) :ok))
               (eq (fnn-mux-cleanup-receipt-stage receipt) :scheduled))
             "callback return survives gate-leave fault separately from section return")
      (let ((before (copy-list *cleanup-calls*)))
        (fnn-mux-handshake-release loop conn)
        (check (equal before *cleanup-calls*) "failed handshake cleanup never retries")))))

(dolist (mode '(:torn :unpin-fault :socket-fault))
  (let* ((*cleanup-mode* mode) (*cleanup-calls* nil)
         (service (%make-fnn-owner-service :lock (sb-thread:make-mutex)))
         (loop (%make-fnn-mux-loop :service service :closed t))
         (conn (%make-fnn-mux-conn :phase :serving :cid 8 :opened-cid 8 :socket :fd)))
    (setf (fnn-owner-service-mux service) (list loop) (fnn-mux-loop-conns loop) (list conn))
    (fnn-mux-finish loop conn)
    (check (and (member '(:socket-shut :fd) *cleanup-calls* :test #'equal)
                (null (fnn-mux-loop-conns loop))
                (fnn-owner-service-stopping service)
                (fnn-mux-loop-cleanup-debts loop) (not (fnn-mux-drained-p service)))
           "torn semantic/unpin fault preserves debt while independent socket cleanup runs")
    (let ((before (copy-list *cleanup-calls*)))
      (fnn-mux-finish loop conn)
      (check (equal before *cleanup-calls*) "torn finish is never retried"))))

(let* ((*cleanup-calls* nil)
       (service (%make-fnn-owner-service :lock (sb-thread:make-mutex)))
       (loop (%make-fnn-mux-loop :service service))
       (conn (%make-fnn-mux-conn :phase :serving :hs-id 21)))
  (fnn-mux-handshake-release loop conn)
  (setf (fnn-mux-conn-hs-id conn) 22)
  (fnn-mux-handshake-release loop conn)
  (check (and (null (fnn-mux-conn-hs-id conn))
              (member '(fn-owner-handshake-done 21) *cleanup-calls* :test #'equal)
              (member '(fn-owner-handshake-done 22) *cleanup-calls* :test #'equal))
         "new admitted handshake identity has independent once-only receipt"))
(format t "native_mux_cleanup_raw: PASS four actual callbacks/debts/physical cleanup/root drain~%")

;; The actual socket helper preserves primary NIL but exposes a failed close.
(load-deployed-forms "host/native/io.lisp" '((defun fnn-socket-shut)))
(let ((socket (make-instance 'sb-bsd-sockets:inet-socket :type :stream :protocol :tcp)))
  (check (equal (multiple-value-list (fnn-socket-shut socket)) '(nil :closed nil))
         "actual kernel socket close supplies affirmative secondary receipt"))
(let ((original (symbol-function 'sb-bsd-sockets:socket-close))
      (condition (make-condition 'simple-error :format-control "injected close EIO")))
  (unwind-protect
       (progn
         (setf (symbol-function 'sb-bsd-sockets:socket-close)
               (lambda (&rest args) (declare (ignore args)) (error condition)))
         (let ((observed (multiple-value-list (fnn-socket-shut :socket))))
           (check (and (null (first observed)) (eq (second observed) :unobserved)
                       (eq (third observed) condition))
                  "actual helper retains primary NIL and original failed-close condition")))
    (setf (symbol-function 'sb-bsd-sockets:socket-close) original)))

(let* ((service (%make-fnn-owner-service))
       (loop (%make-fnn-mux-loop :service service :closed t))
       (release (sb-thread:make-semaphore :count 0))
       (started (sb-thread:make-semaphore :count 0))
       (thread (sb-thread:make-thread
                (lambda () (sb-thread:signal-semaphore started) (wait-label release)))))
  (setf (fnn-owner-service-mux service) (list loop) (fnn-mux-loop-thread loop) thread)
  (wait-label started)
  (check (not (fnn-mux-drained-p service)) "empty logical loop cannot substitute for physical thread return")
  (sb-thread:signal-semaphore release)
  (sb-thread:join-thread thread)
  (check (fnn-mux-drained-p service) "actual terminal loop and empty debt can authorize root drain observation"))
(format t "native_mux_cleanup_raw: PASS actual socket receipts and live-loop root hold~%")

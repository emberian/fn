; Small helper gate: selected suffixes, not arbitrary subsets or hardware disks.
(in-package "ACL2")
(include-book "../sim/storage")

(defun fn2-sfu-four (durable fn2-sim-storage)
 (declare (xargs :stobjs fn2-sim-storage :verify-guards nil))
 (if durable
     (list (fn2-sim-storage-durable 0 fn2-sim-storage)
           (fn2-sim-storage-durable 1 fn2-sim-storage)
           (fn2-sim-storage-durable 2 fn2-sim-storage)
           (fn2-sim-storage-durable 3 fn2-sim-storage))
   (list (fn2-sim-storage-pending 0 fn2-sim-storage)
         (fn2-sim-storage-pending 1 fn2-sim-storage)
         (fn2-sim-storage-pending 2 fn2-sim-storage)
         (fn2-sim-storage-pending 3 fn2-sim-storage))))

(defun fn2-sfu-run (start fail newer fn2-sim-storage)
 (declare (xargs :stobjs fn2-sim-storage :verify-guards nil))
 (b* ((fn2-sim-storage (fn2-storage-init 1 2 fn2-sim-storage))
      ((mv a fn2-sim-storage) (fn2-storage-write-byte 0 0 11 1 nil nil fn2-sim-storage))
      ((mv b fn2-sim-storage) (fn2-storage-write-byte 1 1 12 1 nil nil fn2-sim-storage))
      ((mv c fn2-sim-storage) (fn2-storage-write-byte 2 2 13 1 nil nil fn2-sim-storage))
      ((mv d fn2-sim-storage) (fn2-storage-write-byte 3 3 14 1 nil nil fn2-sim-storage))
      ((mv e fn2-sim-storage) (fn2-storage-write-byte 8 8 91 1 nil nil fn2-sim-storage))
      ((mv f fn2-sim-storage) (fn2-storage-fence-capture 0 fn2-sim-storage))
      ((mv g fn2-sim-storage) (fn2-storage-fence-complete 0 nil nil fn2-sim-storage))
      (baseline (equal (fn2-sfu-four t fn2-sim-storage) '(11 12 13 14)))
      ((mv h fn2-sim-storage) (fn2-storage-write-byte 0 0 21 2 nil nil fn2-sim-storage))
      ((mv i fn2-sim-storage) (fn2-storage-write-byte 1 1 22 2 nil nil fn2-sim-storage))
      ((mv j fn2-sim-storage) (fn2-storage-write-byte 2 2 23 2 nil nil fn2-sim-storage))
      ((mv k fn2-sim-storage) (fn2-storage-write-byte 3 3 24 2 nil nil fn2-sim-storage))
      ((mv l fn2-sim-storage) (fn2-storage-fence-capture 0 fn2-sim-storage))
      ; Snapshot must not persist this later write until its own fence.
      ((mv m fn2-sim-storage) (fn2-storage-write-byte 2 2 99 3 nil nil fn2-sim-storage))
      ((mv n fn2-sim-storage)
       (if newer (fn2-storage-fence-capture 1 fn2-sim-storage) (mv :ok fn2-sim-storage)))
      ((mv o fn2-sim-storage)
       (if newer (fn2-storage-fence-complete 1 nil nil fn2-sim-storage) (mv :ok fn2-sim-storage)))
      ((mv code fn2-sim-storage)
       (if (equal start 0) (fn2-storage-fence-complete 0 fail nil fn2-sim-storage)
         (fn2-storage-fence-complete-from 0 fail nil start fn2-sim-storage)))
      (want (cond (newer '(21 22 99 24))
                  ((or fail (equal start 4096)) '(11 12 13 14))
                  ((equal start 0) '(21 22 23 24))
                  (t '(11 12 23 24))))
      (before-crash (and (equal (fn2-sfu-four t fn2-sim-storage) want)
                         (equal (fn2-sfu-four nil fn2-sim-storage) '(21 22 99 24))
                         (not (fn2-storage-fence-slot-of 0 fn2-sim-storage))))
      (fn2-sim-storage (fn2-storage-crash-reset fn2-sim-storage)))
  (mv (and (equal (list a b c d e f g h i j k l m n o)
                  '(:ok :ok :ok :ok :ok :ok :ok :ok :ok :ok :ok :ok :ok :ok :ok))
           baseline before-crash
           (eq code (if (and (equal start 0) (not fail)) :ok :io))
           (equal (fn2-sfu-four t fn2-sim-storage) want)
           (equal (fn2-sfu-four nil fn2-sim-storage) want)
           (equal (fn2-sim-storage-durable 8 fn2-sim-storage) 91)) fn2-sim-storage)))

(defun fn2-sfu-case (start fail newer)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-sim-storage
  (mv-let (ok fn2-sim-storage) (fn2-sfu-run start fail newer fn2-sim-storage) ok)))

(assert-event
 (and (fn2-sfu-case 0 nil nil)
      (fn2-sfu-case 2 nil nil)
      (fn2-sfu-case 4096 nil nil)
      (fn2-sfu-case 2 t nil)
      (fn2-sfu-case 2 nil t)))

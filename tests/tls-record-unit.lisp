; Actual controller controls: cross-quantum progress, drain barrier and replay.
(in-package "ACL2")
(include-book "../books/tls-record")
(include-book "std/util/bstar" :dir :system)
(defun fn2-tls-record-run-control (fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-tls-transport fn2-tls-record) :verify-guards nil))
 (b* ((fn2-tls-transport (fn2-tls-transport-init 1 fn2-tls-transport))
      (fn2-tls-transport (fn2-tls-transport-put 0 (cap 7) (nonce 17) (alive 1)
                         (handle-id 4096) (cleanup-credit 1) (terminal 3) (quantum 4)))
      ((mv bound fn2-tls-record) (fn2-tls-record-start 7 17 3 9 10 0 t fn2-tls-record))
      ((mv a1 k1 o1 n1 s1 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r1 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s1 0 4 0 fn2-tls-transport fn2-tls-record))
      ((mv a2 k2 o2 n2 s2 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv stale fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s1 0 4 0 fn2-tls-transport fn2-tls-record))
      (unchanged (and (= (fn2-tls-record-source-progress 0 fn2-tls-record) 4)
                      (= (fn2-tls-record-pending-serial 0 fn2-tls-record) s2)))
      ((mv r2 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s2 0 2 0 fn2-tls-transport fn2-tls-record))
      ((mv a3 k3 o3 n3 s3 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r3 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s3 0 4 0 fn2-tls-transport fn2-tls-record))
      ; SSL completion still has ciphertext to drain before application terminal.
      ((mv a4 k4 o4 n4 s4 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 3 fn2-tls-transport fn2-tls-record))
      ((mv r4 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s4 3 0 0 fn2-tls-transport fn2-tls-record))
      ((mv a5 k5 o5 n5 s5 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r5 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s5 1 0 0 fn2-tls-transport fn2-tls-record))
      ((mv a6 k6 o6 n6 s6 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r6 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s6 2 0 0 fn2-tls-transport fn2-tls-record))
      ((mv done action offset count serial fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record)))
  (declare (ignore action offset serial))
  (mv (and (eq bound :ok) (eq stale :stale) unchanged
           (equal (list a1 k1 o1 n1 a2 k2 o2 n2 a3 k3 o3 n3)
                  '(:act 13 0 4 :act 13 4 4 :act 13 6 4))
           (equal (list a4 k4 o4 n4 a5 k5 o5 n5 a6 k6 o6 n6)
                  '(:act 4 0 3 :act 5 0 3 :act 5 1 2))
           (equal (list r1 r2 r3 r4 r5 r6) '(:ok :ok :ok :ok :ok :ok))
           (eq done :done) (= count 10) (= (fn2-tls-record-terminal 0 fn2-tls-record) 1)
           (= (fn2-tls-record-source-progress 0 fn2-tls-record) 10)
           (= (fn2-tls-transport-output-offset 0 fn2-tls-transport) 3))
      fn2-tls-transport fn2-tls-record)))
(defun fn2-tls-record-check ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-tls-transport
  (mv-let (ok fn2-tls-transport)
   (with-local-stobj fn2-tls-record
    (mv-let (ok fn2-tls-transport fn2-tls-record)
     (fn2-tls-record-run-control fn2-tls-transport fn2-tls-record)
     (mv ok fn2-tls-transport)))
   ok)))
(assert-event (fn2-tls-record-check))

; Logical boundary controls over the actual preflight. No published catalog,
; served lifecycle, CPU-step count or full physical-profile witness is claimed.
(in-package "ACL2")
(include-book "../books/read-close-resource-bounds")
(include-book "../books/columns-call-guards")
(defun fn2-read-close-count-control (active fn2-run-loads fn2-run-cursors
 fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
  :guard (and (natp active) (<= active 2))
  :guard-hints ((fn2-columns-call-guard-hint 'fn2-read-close-count-control nil nil world))))
 (b* ((fn2-run-loads (fn2-run-loads-init 2 fn2-run-loads))
      (fn2-run-cursors (fn2-run-cursors-init 2 fn2-run-cursors))
      (fn2-checkpoint-summary (fn2-checkpoint-summary-init 2 fn2-checkpoint-summary))
      (fn2-checkpoint-summary-leases (fn2-checkpoint-summary-leases-init 2 fn2-checkpoint-summary-leases))
      (fn2-pool (fn2-pool-columns-init 4 fn2-pool))
      (fn2-checkpoint-summary (fn2-checkpoint-summary-put 0 (tag 1) (lease-count active)))
      (fn2-pool (fn2-pool-put 0 (gen 1) (state *fn2-pool-state-workspace*)
        (owner-kind 7) (owner-slot 8) (owner-gen 1)))
      (fn2-pool (fn2-pool-put 1 (gen 1) (state *fn2-pool-state-workspace*)
        (owner-kind 7) (owner-slot 8) (owner-gen 1)))
      (fn2-pool (fn2-pool-put 2 (gen 1) (state *fn2-pool-state-workspace*)
        (owner-kind 7) (owner-slot 8) (owner-gen 1)))
      (fn2-pool (fn2-pool-put 3 (gen 1) (state *fn2-pool-state-workspace*)
        (owner-kind 7) (owner-slot 8) (owner-gen 1)))
      (fn2-run-loads (if (< 0 active)
       (fn2-run-loads-put 0 (phase *fn2-run-load-phase-reserved*)
        (lease-mode *fn2-run-load-lease-mode-owned*) (kind 7) (owner 8) (generation 1)
        (windows 2) (page 0) (page-gen 1) (scratch 1) (scratch-gen 1)) fn2-run-loads))
      (fn2-checkpoint-summary-leases (if (< 0 active)
       (fn2-checkpoint-summary-leases-put 0 (live 1) (tag 1)
        (owner-kind 7) (owner-slot 8) (owner-gen 1)) fn2-checkpoint-summary-leases))
      (fn2-run-loads (if (< 1 active)
       (fn2-run-loads-put 1 (phase *fn2-run-load-phase-reserved*)
        (lease-mode *fn2-run-load-lease-mode-owned*) (kind 7) (owner 8) (generation 1)
        (windows 2) (page 2) (page-gen 1) (scratch 3) (scratch-gen 1)) fn2-run-loads))
      (fn2-checkpoint-summary-leases (if (< 1 active)
       (fn2-checkpoint-summary-leases-put 1 (live 1) (tag 1)
        (owner-kind 7) (owner-slot 8) (owner-gen 1)) fn2-checkpoint-summary-leases))
      ((mv empty-code empty-count) (fn2-run-load-region-park-check 0 0 0 0 0 0 0 7 8 1
       fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      ((mv whole-code whole-count) (fn2-run-load-region-park-check 0 0 2 0 0 0 0 7 8 1
       fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      ((mv suffix-code suffix-count) (fn2-run-load-region-park-check 1 0 2 0 0 0 0 7 8 1
       fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      (domain (and (fn2-run-loads-wfp fn2-run-loads) (fn2-run-cursors-wfp fn2-run-cursors)
                   (fn2-checkpoint-summary-wfp fn2-checkpoint-summary)
                   (fn2-checkpoint-summary-leases-wfp fn2-checkpoint-summary-leases)
                   (fn2-pool-wfp fn2-pool))))
  (mv (and domain (eq empty-code :ok) (equal empty-count 0)
           (eq whole-code :ok) (equal whole-count active)
           (eq suffix-code :ok) (equal suffix-count (if (equal active 2) 1 0))
           ; Whole actual antecedent and conclusion for the budget theorem.
           (<= (nfix (- (fn2-run-load-region-count 2 0 0) (nfix 0))) 2)
           (<= whole-count 2)
           ; Remove precisely that remaining-region premise: two live
           ; leases exceed budget one. No WFP or owner condition is removed.
           (if (equal active 2)
               (and (not (<= (nfix (- (fn2-run-load-region-count 2 0 0) (nfix 0))) 1))
                    (not (<= whole-count 1))) t))
      fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))
(defun fn2-read-close-count-test ()
 (declare (xargs :guard t))
 (fn2-run-with-local (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
  (b* (((mv zero fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
        (fn2-read-close-count-control 0 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
       ((mv partial fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
        (fn2-read-close-count-control 1 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
       ((mv live fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
        (fn2-read-close-count-control 2 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))
   (mv (and zero partial live) fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))))
(assert-event (fn2-read-close-count-test))

; Actual upload primitive interleaving. No actor flags are planted; this is
; not a complete POST/rolling-source or publication witness.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/owed-txn")
(include-book "column-snapshot-support")
(make-event (value (cons 'progn
 (append (fn2-test-column-snapshot-events 'fn2-b3 (w state))
         (fn2-test-column-snapshot-events 'fn2-digests (w state))))))

(defun fn2-udh-trim (at count xs)
 (declare (xargs :verify-guards nil))
 (append (take (nfix at) xs) (nthcdr (+ (nfix at) (nfix count)) xs)))
(defun fn2-udh-trim-columns (at count columns)
 (declare (xargs :verify-guards nil))
 (if (atom columns) nil
  (cons (fn2-udh-trim at count (car columns)) (fn2-udh-trim-columns at count (cdr columns)))))
(defun fn2-udh-snapshot (scratch fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-b3 (fn2-core-b3 fn2-core)) (fn2-digests (fn2-core-digests fn2-core))) (snapshot)
  (let ((b (fn2-test-table-snapshot-fn2-b3 fn2-b3))
        (d (fn2-test-table-snapshot-fn2-digests fn2-digests)))
   (list (fn2-b3-rows fn2-b3) (fn2-b3-words-length fn2-b3) (fn2-digests-rows fn2-digests)
    (fn2-udh-trim-columns scratch 1 (butlast b 2))
    (fn2-udh-trim (* 16 scratch) 16 (car (last b)))
    (fn2-udh-trim-columns (* scratch *fn2-digest-stride*) *fn2-digest-stride* (butlast d 1)))) snapshot))

(defun fn2-udh-write (bytes slot gen off fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (if (atom bytes) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen off (car bytes) *fn2-upload-kind* 0 1 fn2-core)
   (if (eq code :ok) (fn2-udh-write (cdr bytes) slot gen (+ 1 (nfix off)) fn2-core) (mv code fn2-core)))))
(defun fn2-udh-read (n slot gen off fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix n)))
 (if (zp n) nil
  (mv-let (code byte) (fn2-core-read slot gen off *fn2-upload-kind* 0 1 fn2-core)
   (if (eq code :ok) (cons byte (fn2-udh-read (- n 1) slot gen (+ 1 (nfix off)) fn2-core)) nil))))
(defun fn2-udh-zero (fuel to slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-upload-page-zero-to to slot gen *fn2-upload-kind* 0 1 fn2-core)
   (if (eq code :more) (fn2-udh-zero (- fuel 1) to slot gen fn2-core) (mv code fn2-core)))))

(defun fn2-udh-body (alias fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile *fn2-txn-posting-profile*)
      (fn2-core (fn2-core-init profile fn2-core))
      (actual-source (fn2-b-upload-source-hash-row 0))
      (actual-stored (fn2-b-upload-stored-hash-row 0))
      (rows (fn2-b-format-slots profile)) (scratch (fn2-b-block-read-row rows))
      (ctl (fn2-b-ctl-runtime-row 0 (fn2-b-ctl-rows profile) (fn2-b-cns-source-rows profile) rows))
      (source (if (eq alias :block-alias) scratch actual-source))
      (stored (if (eq alias :shared-stream) source actual-stored))
      (selected (and (= source actual-source) (= stored actual-stored)))
      (original (make-list 700 :initial-element 65))
      (stored-bytes (make-list 800 :initial-element 66))
      (block (make-list 4096 :initial-element 67))
      ((mv a os og fn2-core) (fn2-core-reserve 2 *fn2-upload-kind* 0 1 fn2-core))
      ((mv b ss sg fn2-core) (fn2-core-reserve 2 *fn2-upload-kind* 0 1 fn2-core))
      ((mv c ls lg fn2-core) (fn2-core-reserve 2 *fn2-upload-kind* 0 1 fn2-core))
      ((mv aw fn2-core) (fn2-udh-write original os og 0 fn2-core))
      ((mv bw fn2-core) (fn2-udh-write stored-bytes ss sg 0 fn2-core))
      ((mv zero fn2-core) (fn2-udh-zero (+ 1 (ceiling *fn2-upload-page-manifest* 4096))
                                      *fn2-upload-page-manifest* ls lg fn2-core))
      ((mv cw fn2-core) (fn2-udh-write block ls lg *fn2-upload-page-stage* fn2-core))
      (whole (and (fn2-core-wfp fn2-core)
       (not (= os ss)) (not (= os ls)) (not (= ss ls))
       (< 0 (fn2-b-upload-windows profile))
       (= *fn2-storage-extent-units* 16) (= *fn2-commit-write-resources* 3)
       (= *fn2-article-location-hashes-max* 96)
       (= actual-stored (+ 1 actual-source))
       (< actual-stored (fn2-b-upload-source-hash-row 1))
       (< (fn2-b-upload-source-hash-row (- (fn2-b-upload-windows profile) 1)) (fn2-b-sealer-hash-row profile))
       (< (fn2-b-upload-stored-hash-row (- (fn2-b-upload-windows profile) 1)) (fn2-b-sealer-hash-row profile))
       (< (fn2-b-sealer-hash-row profile) ctl) (< ctl scratch)
       (<= 32 *fn2-upload-page-stored-source*)
       (equal (list a b c aw bw zero cw) (make-list 7 :initial-element :ok))
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (owned)
        (and (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool) (fn2-pool-semanticp fn2-pool)
         (eq (fn2-pool-workspace-code os og *fn2-upload-kind* 0 1 fn2-pool) :ok)
         (eq (fn2-pool-workspace-code ss sg *fn2-upload-kind* 0 1 fn2-pool) :ok)
         (eq (fn2-pool-workspace-code ls lg *fn2-upload-kind* 0 1 fn2-pool) :ok)) owned)))
      ((mv start fn2-core) (fn2-upload-hash-begin source fn2-core))
      ((mv first used fn2-core) (fn2-upload-hash-step source os og 0 111 0 1 fn2-core))
      ((mv stored-prefix fn2-core) (fn2-upload-stored-hash stored ss sg 0 0 173 nil ls lg *fn2-upload-kind* 0 1 fn2-core))
      (before (fn2-udh-snapshot scratch fn2-core))
      ((mv bh fn2-core) (fn2-upload-block-hash ls lg 4096 *fn2-upload-kind* 0 1 fn2-core))
      ((mv cv fn2-core) (fn2-upload-block-cv ls lg 4096 1 *fn2-upload-kind* 0 1 fn2-core))
      (full-hash (fn2-udh-read 32 ls lg *fn2-upload-page-hash* fn2-core))
      (full-cv (fn2-udh-read 32 ls lg (+ 32 *fn2-upload-page-hash*) fn2-core))
      ((mv short-hash fn2-core) (fn2-upload-block-hash ls lg 128 *fn2-upload-kind* 0 1 fn2-core))
      (retained (fn2-udh-read 32 ls lg *fn2-upload-page-hash* fn2-core))
      ; Another real scratch user runs after the short hash was copied out.
      ((mv overwritten fn2-core)
       (stobj-let ((fn2-b3 (fn2-core-b3 fn2-core)) (fn2-digests (fn2-core-digests fn2-core))
                   (fn2-pool (fn2-core-pool fn2-core))) (code fn2-b3 fn2-digests)
        (fn2-block-hash-into scratch os og 0 700 *fn2-upload-kind* 0 1 fn2-b3 fn2-digests fn2-pool)
        (mv code fn2-core)))
      ((mv short-cv fn2-core) (fn2-upload-block-cv ls lg 128 1 *fn2-upload-kind* 0 1 fn2-core))
      (short-got (fn2-udh-read 32 ls lg (+ 32 *fn2-upload-page-hash*) fn2-core))
      (preserved (equal before (fn2-udh-snapshot scratch fn2-core)))
      ((mv resumed used2 fn2-core) (fn2-upload-hash-step source os og 111 589 0 1 fn2-core))
      ((mv ended fn2-core) (fn2-upload-hash-end source fn2-core))
      ; Test-only output uses owned page offset0, not the separate SOURCE
      ; producer's retained-field extension. Stored digest remains disjoint.
      ((mv saved fn2-core) (fn2-upload-digest-store source ls lg 0 0 1 fn2-core))
      ((mv stored-end fn2-core) (fn2-upload-stored-hash stored ss sg 173 173 627 t ls lg *fn2-upload-kind* 0 1 fn2-core))
      (original-ok (equal (fn2-udh-read 32 ls lg 0 fn2-core) (fn-blake3 original)))
      (stored-ok (equal (fn2-udh-read 32 ls lg *fn2-upload-page-stored-source* fn2-core) (fn-blake3 stored-bytes))))
  (mv (and whole (equal selected (not alias)) preserved
       (equal (list start first stored-prefix bh cv short-hash overwritten short-cv resumed ended saved stored-end)
              (make-list 12 :initial-element :ok)) (= used 111) (= used2 589)
       (equal full-hash (fn-blake3 block))
       (equal full-cv (fn-b3-words-octets (fn-b3-output-cv (fn-b3-node *fn2-b3-iv* block 4 0))))
       (equal retained (fn-blake3 (take 128 block))) (equal short-got retained)
       (not (equal retained (fn-blake3 original)))
       (equal original-ok (not alias))
       (equal stored-ok (not (eq alias :shared-stream)))
       (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))) fn2-core)))

(defun fn2-udh-test (alias)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (answer fn2-core) (fn2-udh-body alias fn2-core) answer)))
(assert-event (fn2-udh-test nil))
; Missing distinct source/stored selector: stored begin destroys source prefix.
(assert-event (fn2-udh-test :shared-stream))
; Missing disjoint block scratch selector: an ordinary block hash destroys it.
(assert-event (fn2-udh-test :block-alias))

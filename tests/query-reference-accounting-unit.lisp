; Independent accounting teeth over actual generic C transitions.
(in-package "ACL2")
(include-book "../books/query-reference-accounting")
(include-book "../books/assembly-init")
(include-book "std/util/bstar" :dir :system)
(defun fn2-qrt-write (n off byte slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (if (zp n) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen off byte 1 0 1 fn2-core)
   (if (eq code :ok) (fn2-qrt-write (- n 1) (+ off 1) byte slot gen fn2-core) (mv code fn2-core)))))
(defun fn2-qrt-output-counts (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (counts)
  (fn2-query-output-counts (fn2-pool-rows fn2-pool) fn2-pool) counts))
(defun fn2-qrt-pool-rows (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (rows) (fn2-pool-rows fn2-pool) rows))
(defun fn2-qrt-count (slot fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (count) (fn2-pool-query-ref-count slot fn2-pool) count))
(defun fn2-qrt-mask (tx fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-id-decides (fn2-core-id-decides fn2-core))) (mask) (fn2-id-decides-qmask tx fn2-id-decides) mask))
(defun fn2-qrt-output-on (slot fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (count) (fn2-pool-out-count slot fn2-pool) count))

; The exact factors of the full logical H/C statement are evaluated around
; the actual subject. No nx dispatcher or implementation-derived oracle runs.
(defun fn2-qrt-step (op a fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((hyps (and (member-eq op *fn2-query-reference-operations*)
                  (fn2-core-query-reference-domainp fn2-core) (fn2-core-query-counts-matchp fn2-core)))
      (rows (fn2-qrt-pool-rows fn2-core)) (outputs (fn2-qrt-output-counts fn2-core))
      ((mv code fn2-core)
       (case op
        (:start (fn2-identity-decide-start (nth 0 a) (nth 1 a) (nth 2 a) (nth 3 a) (nth 4 a)
                  (nth 5 a) (nth 6 a) (nth 7 a) (nth 8 a) (nth 9 a) (nth 10 a) fn2-core))
        (:step (fn2-identity-decide (nth 0 a) (nth 1 a) fn2-core))
        (:cancel (fn2-successor-release (nth 0 a) fn2-core))
        (otherwise (mv :unknown fn2-core))))
      (conclusion (fn2-query-reference-afterp (fn2-core-query-reference-domainp fn2-core)
                    (fn2-core-query-counts-matchp fn2-core) (= rows (fn2-qrt-pool-rows fn2-core))
                    (equal outputs (fn2-qrt-output-counts fn2-core)))))
  (mv (list hyps code conclusion) fn2-core)))
(defun fn2-qrt-drive (n tx fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (if (zp n) (mv :fuel fn2-core)
  (mv-let (result fn2-core) (fn2-qrt-step :step (list tx 4096) fn2-core)
   (if (not (and (car result) (caddr result))) (mv (list :whole-statement result) fn2-core)
    (if (eq (cadr result) :more) (fn2-qrt-drive (- n 1) tx fn2-core) (mv (cadr result) fn2-core))))))
(defun fn2-qrt-positive (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      ((mv reserve slot gen fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
      ((mv w0 fn2-core) (fn2-qrt-write 1 0 109 slot gen fn2-core))
      ((mv w1 fn2-core) (fn2-qrt-write 32 1 7 slot gen fn2-core))
      ; Real queued output operation, not a forged out-count or OpRef.
      ((mv issue & & fn2-core) (fn2-issue-write 0 slot gen 0 33 0 1 0 1 0 fn2-core))
      ((mv start0 fn2-core) (fn2-qrt-step :start (list 0 slot gen 0 1 slot gen 1 1 0 1) fn2-core))
      ((mv start1 fn2-core) (fn2-qrt-step :start (list 1 slot gen 0 1 slot gen 1 1 0 1) fn2-core))
      (four (fn2-qrt-count slot fn2-core))
      ((mv blocked fn2-core) (fn2-core-write slot gen 0 110 1 0 1 fn2-core))
      ((mv cancel0 fn2-core) (fn2-qrt-step :cancel '(0) fn2-core))
      (two (fn2-qrt-count slot fn2-core))
      ((mv rollback fn2-core) (fn2-qrt-step :start (list 0 slot gen 0 1 slot (+ gen 1) 1 1 0 1) fn2-core))
      (still-two (fn2-qrt-count slot fn2-core))
      ((mv done1 fn2-core) (fn2-qrt-drive 100 1 fn2-core))
      ((mv repeated-done fn2-core) (fn2-qrt-step :step '(1 4096) fn2-core)))
  (mv (list reserve w0 w1 issue start0 start1 four blocked cancel0 two rollback still-two done1 repeated-done
            (fn2-core-query-references-accountedp fn2-core) (fn2-qrt-count slot fn2-core)
            (fn2-qrt-mask 0 fn2-core) (fn2-qrt-mask 1 fn2-core) (fn2-qrt-output-on slot fn2-core)) fn2-core)))
(defun fn2-qrt-positive-result ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (result fn2-core) (fn2-qrt-positive fn2-core) result)))
(assert-event
 (equal (fn2-qrt-positive-result)
  '(:ok :ok :ok :ok (t :ok t) (t :ok t) 4 :held (t :ok t) 2 (t :stale t) 2 :stored
    (t :stored t) t 0 0 0 1)))

; Remove ONLY exact multiplicity. Both actual queries and all source
; ownership/range/phase premises remain valid. With an undercount, actual
; cancellation consumes one token, refuses the second and leaves live
; descriptors without their counted protection. This forged count is not
; reachable from the invariant and is not a production fault mechanism.
(defun fn2-qrt-removal (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      ((mv & slot gen fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
      ((mv & fn2-core) (fn2-qrt-write 1 0 109 slot gen fn2-core))
      ((mv & fn2-core) (fn2-qrt-write 32 1 7 slot gen fn2-core))
      ((mv start0 fn2-core) (fn2-qrt-step :start (list 0 slot gen 0 1 slot gen 1 1 0 1) fn2-core))
      ((mv start1 fn2-core) (fn2-qrt-step :start (list 1 slot gen 0 1 slot gen 1 1 0 1) fn2-core))
      (fn2-core (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (fn2-pool)
                  (fn2-pool-set-query-ref-count slot 1 fn2-pool) fn2-core))
      (domain (fn2-core-query-reference-domainp fn2-core))
      (counts (fn2-core-query-counts-matchp fn2-core))
      ((mv cancel fn2-core) (fn2-qrt-step :cancel '(0) fn2-core)))
  (mv (list start0 start1 domain counts cancel (fn2-qrt-count slot fn2-core)
            (fn2-qrt-mask 0 fn2-core) (fn2-qrt-mask 1 fn2-core)) fn2-core)))
(defun fn2-qrt-removal-result ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (result fn2-core) (fn2-qrt-removal fn2-core) result)))
(assert-event
 (equal (fn2-qrt-removal-result) '((t :ok t) (t :ok t) t nil (nil :state nil) 0 2 3)))
(defun fn2-query-reference-accounting-teeth ()
 (declare (xargs :verify-guards nil))
 (and (equal (fn2-qrt-positive-result)
       '(:ok :ok :ok :ok (t :ok t) (t :ok t) 4 :held (t :ok t) 2 (t :stale t) 2 :stored
         (t :stored t) t 0 0 0 1))
      (equal (fn2-qrt-removal-result) '((t :ok t) (t :ok t) t nil (nil :state nil) 0 2 3))))
(fn2-assert-owed-teeth fn2-core-query-reference-accounting)

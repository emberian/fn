; Actual emission + typed B member + shared C kernel. No durable acceptance,
; scheduler migration or byte/step quota qualification is claimed by this unit.
(in-package "ACL2")
(include-book "../books/executor")
(include-book "../books/successor-binding")
(include-book "std/util/bstar" :dir :system)
(defconst *fn2-sbu-profile*
 (put-assoc-equal :pool-classes '((8 . 64) (4 . 256) (16 . 4096) (8 . 65536)) *fn2-profile-tiny*))
(defun fn2-sbu-resolve (fuel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-successor-resolve 0 4096 fn2-core)
   (if (eq code :more) (fn2-sbu-resolve (- fuel 1) fn2-core) (mv code fn2-core)))))
(defun fn2-sbu-begin (generation batch event budget fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core)) (fn2-id-engine (fn2-core-id-engine fn2-core))
             (fn2-ov-insertion (fn2-core-ov-insertion fn2-core)) (fn2-commit (fn2-commit-table fn2-core))
             (fn2-commit-member (fn2-core-commit-members fn2-core)) (fn2-fields (fn2-core-fields fn2-core))
             (fn2-id-decides (fn2-core-id-decides fn2-core)) (fn2-fc (fn2-core-fc fn2-core)))
  (code fn2-succ-txns fn2-id-engine fn2-ov-insertion)
  (mv-let (code b0) (fn2-idc-stripe 0 (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields)
   (if (eq code :ok)
       (fn2-succ-bind-begin 0 generation batch event budget b0 fn2-succ-txns fn2-id-engine fn2-ov-insertion fn2-commit fn2-commit-member fn2-fields)
    (mv code fn2-succ-txns fn2-id-engine fn2-ov-insertion)))
  (mv code fn2-core)))
(defun fn2-sbu-step (generation batch event budget fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core)) (fn2-succ-slots (fn2-core-succ-slots fn2-core))
             (fn2-id-engine (fn2-core-id-engine fn2-core)) (fn2-ov-insertion (fn2-core-ov-insertion fn2-core))
             (fn2-overlays (fn2-core-overlays fn2-core)) (fn2-overlay-index (fn2-core-overlay-index fn2-core))
             (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core))
             (fn2-commit (fn2-commit-table fn2-core)) (fn2-commit-member (fn2-core-commit-members fn2-core)))
  (code fn2-succ-txns fn2-id-engine fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
  (fn2-succ-bind-step 0 generation batch event budget fn2-succ-txns fn2-succ-slots fn2-id-engine fn2-ov-insertion
   fn2-overlays fn2-overlay-index fn2-fields fn2-pool fn2-commit fn2-commit-member)
  (mv code fn2-core)))
(defun fn2-sbu-drive (fuel generation batch event fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-sbu-step generation batch event 1 fn2-core)
   (if (eq code :more) (fn2-sbu-drive (- fuel 1) generation batch event fn2-core) (mv code fn2-core)))))
(defun fn2-sbu-pending (batch fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-commit (fn2-commit-table fn2-core))) (n)
  (mv-let (found row) (fn2-commit-successor-bind-row batch fn2-commit)
   (if found (fn2-commit-cb-bind-pending row fn2-commit) *fn2-none*)) n))
(defun fn2-sbu-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-sbu-profile* fn2-core))
      ((mv reserve ws wg fn2-core) (fn2-core-reserve 2 5 1 1 fn2-core))
      ((mv put fn2-core) (fn2-successor-put 0 0 4 :insert fn2-core))
      ((mv a fn2-core) (fn2-successor-arg 0 0 0 :value 1 fn2-core))
      ((mv b fn2-core) (fn2-successor-arg 0 0 1 :value 2 fn2-core))
      ((mv c fn2-core) (fn2-successor-arg 0 0 2 :value 3 fn2-core))
      ((mv d fn2-core) (fn2-successor-arg 0 0 3 :value 4 fn2-core))
      ((mv e fn2-core) (fn2-successor-arg 0 0 4 :value 0 fn2-core))
      ((mv resolved fn2-core) (fn2-sbu-resolve 200 fn2-core))
      ((mv staged & fn2-core) (fn2-successor-stage 0 fn2-core))
      ((mv emitted len fn2-core) (fn2-successor-emit 0 ws wg 0 4096 5 1 1 fn2-core))
      (producer (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core) (eq reserve :ok) (eq put :ok) (eq a :ok) (eq b :ok) (eq c :ok) (eq d :ok) (eq e :ok)
                     (eq resolved :ok) (eq staged :ok) (eq emitted :ok)))
      (before (fn2-core-copy fn2-core))
      ((mv forged fn2-core) (fn2-sbu-begin 1 1 1 1 fn2-core))
      (no-forge (and (eq forged :state) (equal before (fn2-core-copy fn2-core))))
      ((mv admitted batch event fn2-core) (fn2-commit-admit-successor 0 1 ws wg len 5 1 1 fn2-core))
      (whole (and producer no-forge (eq admitted :ok) (= (fn2-sbu-pending batch fn2-core) 1)))
      (before (fn2-core-copy fn2-core))
      ((mv stale fn2-core) (fn2-sbu-begin 2 batch event 1 fn2-core))
      (stale-frame (and (eq stale :state) (equal before (fn2-core-copy fn2-core))))
      ((mv zero fn2-core) (fn2-sbu-begin 1 batch event 0 fn2-core))
      (zero-frame (and (eq zero :yield) (equal before (fn2-core-copy fn2-core))))
      ((mv begun fn2-core) (fn2-sbu-begin 1 batch event 1 fn2-core))
      (before (fn2-core-copy fn2-core))
      ((mv zero-step fn2-core) (fn2-sbu-step 1 batch event 0 fn2-core))
      (step-frame (and (eq zero-step :yield) (equal before (fn2-core-copy fn2-core))))
      ((mv release fn2-core) (fn2-successor-release 0 fn2-core))
      (release-frame (and (eq release :state) (equal before (fn2-core-copy fn2-core))))
      ((mv done fn2-core) (fn2-sbu-drive 1000 1 batch event fn2-core))
      (before-ack (= (fn2-sbu-pending batch fn2-core) 1))
      ((mv complete fn2-core) (fn2-commit-successor-bind-complete batch event 0 1 ws wg len 5 1 1 fn2-core))
      ((mv repeated fn2-core) (fn2-commit-successor-bind-complete batch event 0 1 ws wg len 5 1 1 fn2-core)))
  (mv (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core) whole stale-frame zero-frame (eq begun :more) step-frame release-frame (eq done :done)
           before-ack (eq complete :ok) (eq repeated :already) (= (fn2-sbu-pending batch fn2-core) 0)) fn2-core)))
(assert-event (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-sbu-body fn2-core) ok)))

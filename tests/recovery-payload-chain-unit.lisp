; Source-only assertions, UNEXECUTED until a current-closure ACL2 record exists.
; Actual allocator reservations, actual recovery link/directory and claim.
; The authenticated journal/candidate classifications are synthetic premises;
; this fixture does not establish disk authentication or cold recovery.
(in-package "ACL2")
(include-book "../books/assembly")
(include-book "alloc-test-state")
(fn2-alloc-test-reference-events fn2-rec-cand)
(fn2-alloc-test-reference-events fn2-commit-root)
(defun fn2-rpc-snapshot (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-rec-cand (fn2-core-rec-cand fn2-core))
             (fn2-commit-root (fn2-core-commit-root fn2-core))
             (fn2-extents (fn2-core-extents fn2-core))
             (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (snapshot)
  (list (fn2-rec-cand-logical-snapshot fn2-rec-cand)
        (fn2-commit-root-logical-snapshot fn2-commit-root)
        (fn2-extents-logical-snapshot fn2-extents)
        (fn2-alloc-edges-logical-snapshot fn2-alloc-edges)) snapshot))
(defun fn2-rpc-body (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init (put-assoc-equal :extent-slots 6 *fn2-profile-tiny*) fn2-core))
      ((mv reserved j je ja p pe pa q qe qa fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                   (fn2-rec-cand (fn2-core-rec-cand fn2-core)))
        (reserved j je ja p pe pa q qe qa fn2-extents fn2-rec-cand)
        (b* (((mv a & j je ja fn2-extents) (fn2-alloc-reserve fn2-extents))
             ((mv b & p pe pa fn2-extents) (fn2-alloc-reserve fn2-extents))
             ((mv c & q qe qa fn2-extents) (fn2-alloc-reserve fn2-extents))
             (fn2-rec-cand (fn2-rec-cand-put j (status *fn2-rec-status-candidate*)
               (commit 1) (epoch je) (allocation ja) (first 1) (last 1)))
             (fn2-rec-cand (fn2-rec-cand-put p (status *fn2-rec-status-invalid*)))
             (fn2-rec-cand (fn2-rec-cand-put q (status *fn2-rec-status-empty*)))
             (fn2-rec-cand (fn2-rec-cand-put 5 (status *fn2-rec-status-empty*))))
         (mv (and (eq a :ok) (eq b :ok) (eq c :ok)) j je ja p pe pa q qe qa fn2-extents fn2-rec-cand))
        (mv reserved j je ja p pe pa q qe qa fn2-core)))
      ((mv linked fn2-core) (fn2-recovery-link j fn2-core))
      ((mv first hi fn2-core) (fn2-recovery-claim p pe pa 6 101 1 fn2-core))
      ((mv second hi2 fn2-core) (fn2-recovery-claim q qe qa 6 102 1 fn2-core))
      ((mv head-code token count) (fn2-recovery-payload-head j 1 je ja fn2-core))
      ((mv ncode np ne na nk no next) (fn2-recovery-payload-node j 1 je ja token count fn2-core))
      ((mv tcode tp te ta tk to end) (fn2-recovery-payload-node j 1 je ja next (- count 1) fn2-core))
      (positive (and reserved (eq linked :ok) (eq first :ok) (eq second :ok)
        (= hi (+ p 1)) (= hi2 (+ q 1)) (eq head-code :ok) (= token (+ q 1)) (= count 2)
        (eq ncode :ok) (= np q) (= ne qe) (= na qa) (= nk 6) (= no 102) (= next (+ p 1))
        (eq tcode :ok) (= tp p) (= te pe) (= ta pa) (= tk 6) (= to 101) (= end 0)))
      ; Change one antecedent; capture every affected carrier AFTER the
      ; deliberate corruption so refusal must preserve that complete state.
      (fn2-core (if (eq mode :foreign)
       (stobj-let ((fn2-rec-cand (fn2-core-rec-cand fn2-core))) (fn2-rec-cand)
        (fn2-rec-cand-set-commit q 2 fn2-rec-cand) fn2-core) fn2-core))
      (fn2-core (if (eq mode :stale-directory)
       (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (fn2-commit-root)
        (mv-let (code row) (fn2-commit-directory-proposal-row 1 fn2-commit-root)
         (if (eq code :ok) (fn2-commit-root-set-parent row 99 fn2-commit-root) fn2-commit-root)) fn2-core) fn2-core))
      (fn2-core (if (eq mode :cycle)
       (stobj-let ((fn2-rec-cand (fn2-core-rec-cand fn2-core))) (fn2-rec-cand)
        (fn2-rec-cand-set-payload-next p token fn2-rec-cand) fn2-core) fn2-core))
      (before (fn2-rpc-snapshot fn2-core))
      ((mv refused & fn2-core)
       (fn2-recovery-claim (if (member-eq mode '(:foreign :stale-directory)) 5 p)
        (+ pe 1) (+ pa 1) 6 999 1 fn2-core))
      ((mv stale & &) (fn2-recovery-payload-head j 1 (+ je 1) ja fn2-core))
      ((mv cycle & & & & & &) (fn2-recovery-payload-node j 1 je ja (if (eq mode :cycle) next token) 1 fn2-core)))
  (mv (and positive (eq refused :conflict) (equal before (fn2-rpc-snapshot fn2-core))
           (eq stale :conflict) (eq cycle :conflict)) fn2-core)))
(defun fn2-rpc-run (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core) (fn2-rpc-body mode fn2-core) answer)))
(assert-event (fn2-rpc-run :repeat))
(assert-event (fn2-rpc-run :foreign))
(assert-event (fn2-rpc-run :stale-directory))
(assert-event (fn2-rpc-run :cycle))

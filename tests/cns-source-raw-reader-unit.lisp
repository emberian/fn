; PREPARED / UNEXECUTED. Actual source capture, allocation promises, pinned
; issue, adapter input, op posting/harvest/finish, raw verifier and incremental
; source hash. Only selected typed READ authority is synthetic, as in the
; capture fixture. The in-memory disk window is the explicit I/O environment;
; it does not grant publication authority. No SEND/transport is claimed.
(in-package "ACL2")
(include-book "../books/cns-source-capture")
(include-book "../books/cns-source-raw")

(defun fn2-crr-fill (i n slot gen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- (nfix n) (nfix i)))))
 (if (>= (nfix i) (nfix n)) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen i (mod (+ 31 (* 7 (nfix i))) 251) 6 41 43 fn2-pool)
   (if (eq code :ok) (fn2-crr-fill (+ 1 (nfix i)) n slot gen fn2-pool) (mv code fn2-pool)))))

; Environment writes only through the actual leased OpRef, one byte at a
; time. It reads the immutable disk window, not the expected digest vector.
(defun fn2-crr-input (i n disk dg diskoff slot gen op og boff fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- (nfix n) (nfix i)))))
 (if (>= (nfix i) (nfix n)) (mv :ok fn2-pool)
  (b* (((mv read byte) (fn2-pool-read disk dg (+ diskoff i) 6 41 43 fn2-pool))
       ((unless (eq read :ok)) (mv read fn2-pool))
       ((mv write fn2-pool) (fn2-pool-adapter-write slot gen op og (+ boff i) byte fn2-pool)))
   (if (eq write :ok) (fn2-crr-input (+ 1 (nfix i)) n disk dg diskoff slot gen op og boff fn2-pool) (mv write fn2-pool)))))

(defun fn2-crr-bytes-equal (i n disk dg diskoff slot gen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- (nfix n) (nfix i)))))
 (or (>= (nfix i) (nfix n))
  (b* (((mv a x) (fn2-pool-read disk dg (+ diskoff i) 6 41 43 fn2-pool))
       ((mv b y) (fn2-pool-read slot gen i 5 23 29 fn2-pool)))
   (and (eq a :ok) (eq b :ok) (equal x y)
    (fn2-crr-bytes-equal (+ 1 (nfix i)) n disk dg diskoff slot gen fn2-pool)))))

; One real lower completion path in core.lisp order: harvest validated cells,
; return the input workspace, run actual pre-finish hooks, recycle the op.
; This test orchestrator supplies no result identity not read from the op.
(defun fn2-crr-read (disk dg fn2-cns-sources fn2-cns-source-operations fn2-pool fn2-ops fn2-control fn2-checkpoints fn2-extents fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-cns-sources fn2-cns-source-operations fn2-pool fn2-ops fn2-control fn2-checkpoints fn2-extents fn2-alloc-edges) :verify-guards nil))
 (b* ((logical (fn2-cns-sources-offset 0 fn2-cns-sources))
      (unit (fn2-cns-sources-unit-index 0 fn2-cns-sources))
      ((mv issued op og fn2-cns-sources fn2-cns-source-operations fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges)
       (fn2-cns-source-issue-children 0 17 19 23 29 31 9 1 fn2-cns-sources fn2-cns-source-operations fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-checkpoints))
      ((mv slot gen off len) (fn2-op-range op fn2-ops))
      ((mv kind owner generation) (fn2-op-owner op fn2-ops))
      (principal (fn2-ops-principal op fn2-ops))
      (extent (floor (fn2-cns-sources-root-unit 0 fn2-cns-sources) *fn2-storage-extent-units*))
      (pin (fn2-b-read-pin-edge op fn2-extents))
      (issued-h (and (eq issued :ok) (equal kind 9) (equal owner 17) (equal generation 19) (equal principal 1)
       (equal (fn2-ops-kind op fn2-ops) *fn2-action-read*)
       (equal (fn2-ops-storage-offset op fn2-ops)
        (* (+ (fn2-cns-sources-root-unit 0 fn2-cns-sources) unit) *fn2-commit-unit-bytes*))
       (equal off *fn2-cns-source-prefix*) (equal logical (* unit *fn2-commit-unit-bytes*))
       (equal len (min 4096 (- 6144 logical)))
       (equal (fn2-cns-source-operations-live op fn2-cns-source-operations) 1)
       (equal (fn2-cns-source-operations-generation op fn2-cns-source-operations) og)
       (equal (fn2-cns-source-operations-source-row op fn2-cns-source-operations) 0)
       (equal (fn2-extents-outstanding-io extent fn2-extents) 1)
       (fn2-alloc-edge-matchesp pin og extent (fn2-cns-sources-root-epoch 0 fn2-cns-sources)
        (fn2-cns-sources-root-allocation 0 fn2-cns-sources) :outstanding-io fn2-alloc-edges)))
      ((mv ack fn2-ops) (fn2-outbox-ack 1 fn2-ops))
      ((mv input fn2-pool) (fn2-crr-input 0 len disk dg logical slot gen op og off fn2-pool))
      (fn2-ops (fn2-post-result 0 op og *fn2-event-read-result* *fn2-outcome-done* *fn2-reason-none* len 0 0 fn2-ops))
      ((mv found actual actualgen cell fn2-ops) (fn2-harvest-next fn2-ops))
      ((mv posted harvested event outcome reason count aux0 aux1) (fn2-op-cell cell actual fn2-ops))
      ((mv range-slot range-gen range-off range-len) (fn2-op-range actual fn2-ops))
      ((mv completed fn2-pool) (fn2-pool-complete-in range-slot range-gen actual actualgen count fn2-pool))
      ; A stale operation generation cannot harvest the retained source map.
      ((mv stale fn2-cns-sources fn2-cns-source-operations)
       (fn2-cns-source-harvest actual (+ 1 actualgen) cell event outcome reason count aux0 aux1 fn2-cns-sources fn2-cns-source-operations))
      (stale-kept (and (equal (fn2-cns-sources-pending 0 fn2-cns-sources) 1)
                      (equal (fn2-cns-source-operations-live actual fn2-cns-source-operations) 1)))
      ((mv source fn2-cns-sources fn2-cns-source-operations)
       (fn2-cns-source-harvest actual actualgen cell event outcome reason count aux0 aux1 fn2-cns-sources fn2-cns-source-operations))
      ((mv unpinned fn2-extents fn2-alloc-edges)
       (fn2-b-read-pin-harvest actual actualgen cell event outcome reason count aux0 aux1 fn2-extents fn2-alloc-edges))
      ((mv stale-finish fn2-ops) (fn2-op-finish actual (+ 1 actualgen) fn2-ops))
      (finish-kept (and (equal (fn2-ops-gen actual fn2-ops) actualgen)
                        (equal (fn2-ops-phase actual fn2-ops) *fn2-op-phase-done*)))
      ((mv finished fn2-ops) (fn2-op-finish actual actualgen fn2-ops)))
  (mv (and issued-h (eq ack :ok) (eq input :ok) found (equal actual op) (equal actualgen og) (equal cell 0)
       (equal posted 1) (equal harvested 1) (equal event *fn2-event-read-result*)
       (equal outcome *fn2-outcome-done*) (equal reason *fn2-reason-none*) (equal count len)
       (equal range-slot slot) (equal range-gen gen) (equal range-off off) (equal range-len len)
       (eq completed :ok) (eq stale :ok) stale-kept (eq source :ok) (eq unpinned :ok)
       (eq stale-finish :stale) finish-kept (eq finished :ok)
       (equal (fn2-cns-sources-pending 0 fn2-cns-sources) 0)
       (equal (fn2-cns-source-operations-live actual fn2-cns-source-operations) 0)
       (equal (fn2-extents-outstanding-io extent fn2-extents) 0)
       (equal (fn2-extents-promised-read extent fn2-extents) 1)
       (equal (fn2-alloc-edges-state pin fn2-alloc-edges) *fn2-alloc-edge-state-free*)
       (eq (fn2-pool-workspace-code slot gen 9 17 19 fn2-pool) :ok))
      fn2-cns-sources fn2-cns-source-operations fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges)))

; Fuel bounds the fixture driver, not the source size. No phase or hash
; completion is seeded. Every real source-hash turn advances <=1024 bytes.
(defun fn2-crr-verify (fuel fn2-cns-sources fn2-b3 fn2-digests fn2-pool)
 (declare (xargs :stobjs (fn2-cns-sources fn2-b3 fn2-digests fn2-pool) :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv nil fn2-cns-sources fn2-b3 fn2-digests)
  (b* ((before (fn2-cns-sources-hash-offset 0 fn2-cns-sources))
       ((mv code fn2-cns-sources fn2-b3 fn2-digests)
        (fn2-cns-source-raw-step-children 0 17 19 23 29 31 9 1 4096 fn2-cns-sources fn2-b3 fn2-digests fn2-pool))
       (after (fn2-cns-sources-hash-offset 0 fn2-cns-sources))
       ((unless (and (<= before after) (<= after (+ before 1024)))) (mv nil fn2-cns-sources fn2-b3 fn2-digests)))
   (cond ((eq code :ready) (mv t fn2-cns-sources fn2-b3 fn2-digests))
         ((eq code :more) (fn2-crr-verify (1- fuel) fn2-cns-sources fn2-b3 fn2-digests fn2-pool))
         (t (mv nil fn2-cns-sources fn2-b3 fn2-digests))))))

; The real 4KiB CTL window is reset only while owned and unborrowed, after
; checking every copied byte and feeding a distinct observational B3 row.
(defun fn2-crr-copy (fuel disk dg output og fn2-cns-sources fn2-b3 fn2-digests fn2-pool)
 (declare (xargs :stobjs (fn2-cns-sources fn2-b3 fn2-digests fn2-pool) :verify-guards nil :measure (nfix fuel)))
 (if (not (equal (fn2-cns-sources-phase 0 fn2-cns-sources) *fn2-cns-source-phase-raw-copy*))
     (mv t 0 fn2-cns-sources fn2-b3 fn2-digests fn2-pool)
  (if (zp fuel) (mv nil 0 fn2-cns-sources fn2-b3 fn2-digests fn2-pool)
   (b* ((offset (fn2-cns-sources-offset 0 fn2-cns-sources))
        ((mv reset fn2-pool) (fn2-pool-reset output og 5 23 29 fn2-pool))
        ((mv next n eof fn2-cns-sources fn2-pool)
         (fn2-cns-source-next-children 0 17 19 23 29 31 output og 0 1024 5 fn2-cns-sources fn2-pool))
        (same (fn2-crr-bytes-equal 0 n disk dg offset output og fn2-pool))
        ((mv hashed used fn2-b3 fn2-digests)
         (fn2-cns-source-hash-update 1 output og 0 n 5 23 29 fn2-b3 fn2-digests fn2-pool))
        ((unless (and (eq reset :ok) (eq next :ok) (posp n) (<= n 1024) (not eof) same
                      (member-eq hashed '(:ok :more)) (equal used n)
                      (equal (fn2-pool-fill output fn2-pool) n)
                      (equal (fn2-pool-out-count output fn2-pool) 0)))
         (mv nil 0 fn2-cns-sources fn2-b3 fn2-digests fn2-pool))
        ((mv good rest fn2-cns-sources fn2-b3 fn2-digests fn2-pool)
         (fn2-crr-copy (1- fuel) disk dg output og fn2-cns-sources fn2-b3 fn2-digests fn2-pool)))
    (mv good (+ n rest) fn2-cns-sources fn2-b3 fn2-digests fn2-pool)))))


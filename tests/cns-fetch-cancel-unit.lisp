; Real APPEND/FETCH producer, paused after capture at ITEM. Cancellation is
; an actual failed Send plus terminal borrow handback, never a seeded job.
(in-package "ACL2")
(include-book "cns-stream-fetch-unit")
(defun fn2-cfc-source-image (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-cns-sources (fn2-core-cns-sources fn2-core))) (image)
  (list (fn2-cns-sources-phase 0 fn2-cns-sources)
        (fn2-cns-sources-cns-id 0 fn2-cns-sources)
        (fn2-cns-sources-cns-gen 0 fn2-cns-sources)
        (fn2-cns-sources-ctl-id 0 fn2-cns-sources)
        (fn2-cns-sources-ctl-gen 0 fn2-cns-sources)
        (fn2-cns-sources-request 0 fn2-cns-sources)
        (fn2-cns-sources-lslot 0 fn2-cns-sources)
        (fn2-cns-sources-lgen 0 fn2-cns-sources)
        (fn2-cns-sources-total 0 fn2-cns-sources)) image))
(defun fn2-cfc-root-heldp (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-cns-sources (fn2-core-cns-sources fn2-core))
             (fn2-checkpoints (fn2-core-checkpoints fn2-core))
             (fn2-extents (fn2-core-extents fn2-core))
             (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))
             (fn2-ops (fn2-core-ops fn2-core))) (held)
  (fn2-cns-source-heldp 0 (fn2-cns-sources-cns-id 0 fn2-cns-sources)
   (fn2-cns-sources-cns-gen 0 fn2-cns-sources)
   (fn2-cns-sources-ctl-id 0 fn2-cns-sources)
   (fn2-cns-sources-ctl-gen 0 fn2-cns-sources)
   (fn2-cns-sources-request 0 fn2-cns-sources)
   (fn2-cns-sources-root-unit 0 fn2-cns-sources)
   (fn2-cns-sources-root-epoch 0 fn2-cns-sources)
   (fn2-cns-sources-root-allocation 0 fn2-cns-sources)
   fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops) held))
(defun fn2-cfc-root-edge (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-cns-sources (fn2-core-cns-sources fn2-core))
             (fn2-checkpoints (fn2-core-checkpoints fn2-core))
             (fn2-extents (fn2-core-extents fn2-core))
             (fn2-ops (fn2-core-ops fn2-core))) (edge)
  (fn2-cns-source-edge 0
    (floor (fn2-cns-sources-root-unit 0 fn2-cns-sources) *fn2-storage-extent-units*)
    fn2-checkpoints fn2-extents fn2-ops) edge))
(defun fn2-cfc-capturedp (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let* ((image (fn2-cfc-source-image fn2-core)) (id (nth 1 image)))
  (and (not (equal (car image) *fn2-cns-source-phase-free*))
       (fn2-machine-idp id fn2-core)
       (equal (fn2-machine-phase id fn2-core) *fn2-cns-state-item*)
       (equal (nth 8 image) 6144) (fn2-cfc-root-heldp fn2-core))))
(defun fn2-cfc-to-item (fuel clients store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond ((fn2-cfc-capturedp fn2-core) (mv :captured clients store fn2-core))
       ((zp fuel) (mv :fuel clients store fn2-core))
       (t (b* (((mv & & & & & fn2-core) (fn2-transition t 4 fn2-core))
               ((mv & & clients store fn2-core) (fn2-cw-adapter-one 2 clients store fn2-core)))
            (fn2-cfc-to-item (1- fuel) clients store fn2-core)))))
; Peek without mutation. Only an actually submitted transport Send is failed.
(defun fn2-cfc-send-pending (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (yes op gen)
  (mv-let (code op gen) (fn2-outbox-peek 0 fn2-ops)
   (mv (and (eq code :ok) (equal (fn2-ops-kind op fn2-ops) *fn2-action-send*)) op gen))
  (mv yes op gen)))
(defun fn2-cfc-to-send (fuel clients store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (mv-let (send op gen) (fn2-cfc-send-pending fn2-core)
  (cond (send (mv :send op gen clients store fn2-core))
        ((zp fuel) (mv :fuel 0 0 clients store fn2-core))
        (t (b* (((mv & & & & & fn2-core) (fn2-transition t 4 fn2-core))
                ((mv send & &) (fn2-cfc-send-pending fn2-core)))
             (if send (fn2-cfc-to-send (1- fuel) clients store fn2-core)
              (mv-let (& & clients store fn2-core) (fn2-cw-adapter-one 2 clients store fn2-core)
               (fn2-cfc-to-send (1- fuel) clients store fn2-core))))))))
; Bind the selected queue head to the exact captured source/transport tuple.
; A different actor's Send must fail this control before ACK or completion.
(defun fn2-cfc-fetch-sendp (op gen captured fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let* ((cns (nth 1 captured)) (cgen (nth 2 captured))
        (ctl (nth 3 captured)) (ctlgen (nth 4 captured)) (request (nth 5 captured))
        (rxslot (fn2-ctl-row-rx-slot ctl fn2-core))
        (rxgen (fn2-ctl-row-rx-gen ctl fn2-core))
        (txoff (fn2-ctl-row-tx-off ctl fn2-core))
        (txlen (fn2-ctl-row-tx-len ctl fn2-core)))
  (and (fn2-cns-source-boundp cns cgen ctl ctlgen request fn2-core)
       (equal (fn2-machine-phase ctl fn2-core) *fn2-ctl-state-stream-reply*)
       (equal (fn2-machine-generation ctl fn2-core) ctlgen)
       (equal (fn2-ctl-row-cns ctl fn2-core) cns)
       (equal (fn2-ctl-row-cns-gen ctl fn2-core) cgen)
       (equal (fn2-ctl-row-request ctl fn2-core) request)
       (equal (fn2-ctl-row-pending ctl fn2-core) 1)
       (equal (fn2-ctl-row-borrows ctl fn2-core) 1)
       (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (yes)
        (mv-let (code head headgen) (fn2-outbox-peek 0 fn2-ops)
         (and (eq code :ok) (equal head op) (equal headgen gen)
              (equal (fn2-ops-gen op fn2-ops) gen)
              (equal (fn2-ops-phase op fn2-ops) *fn2-op-phase-queued*)
              (equal (fn2-ops-kind op fn2-ops) *fn2-action-send*)
              (equal (fn2-ops-owner-kind op fn2-ops) *fn2-ctl-kind*)
              (equal (fn2-ops-owner-slot op fn2-ops) ctl)
              (equal (fn2-ops-owner-gen op fn2-ops) ctlgen)
              (equal (fn2-ops-range-slot op fn2-ops) rxslot)
              (equal (fn2-ops-range-gen op fn2-ops) rxgen)
              (equal (fn2-ops-range-off op fn2-ops) txoff)
              (posp (fn2-ops-range-len op fn2-ops))
              (equal (fn2-ops-range-len op fn2-ops) (min *fn2-ctl-io-bytes* (nfix (- txlen txoff))))
              (equal (fn2-ops-cap-index op fn2-ops) 1)
              (equal (fn2-ops-cap-nonce op fn2-ops) 78)
              (equal (fn2-ops-may-release op fn2-ops) 1))) yes))))
(defun fn2-cfc-to-closing (fuel ctl fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond ((and (member-equal (fn2-machine-phase ctl fn2-core)
                           (list *fn2-ctl-state-closing* *fn2-ctl-state-draining*))
             (equal (fn2-ctl-row-borrows ctl fn2-core) 1))
        (mv :closing fn2-core))
       ((zp fuel) (mv :fuel fn2-core))
       (t (mv-let (& & & & & fn2-core) (fn2-transition t 4 fn2-core)
            (fn2-cfc-to-closing (1- fuel) ctl fn2-core)))))
(defun fn2-cfc-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core)
   (b* ((fn2-core (fn2-init-executor *fn2-ccu-profile* :echo nil fn2-core))
        ((mv epoch fn2-core)
         (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
          (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
        ((mv posted wire store fn2-core)
         (fn2-ccu-session 0 (list (fn2-ccu-cat (list (fnc-append 17 *fn2-csf-article*) (fnc-control 5)))) fn2-core))
        (reply (car (fnc-replies '(append) wire))) (position (car (nth 2 reply)))
        ((unless (and (eq epoch :ok) (eq posted :quiet) (eq (car reply) :accepted) (posp position)))
         (mv (list :producer epoch posted reply) fn2-core))
        (fn2-core (fn2-listener-take-credit *fn2-ctl-admission-ordinal* fn2-core))
        ((mv admitted fn2-core) (fn2-machine-admit-fn2-ctl 1 78 3 0 fn2-core))
        ((mv wake fn2-core) (fn2-machine-take-wake fn2-core))
        (fn2-core (fn2-exec-wake wake fn2-core))
        (clients (append (fn2-ccu-done-clients 1)
                   (list (fn2-ccu-client (list (fnc-fetch *fn2-csf-mid-bytes* position))))))
        ((mv paused clients store fn2-core) (fn2-cfc-to-item 40000 clients store fn2-core))
        (captured (fn2-cfc-source-image fn2-core))
        (root-at-item (fn2-cfc-root-heldp fn2-core))
        (root-edge (fn2-cfc-root-edge fn2-core))
        ((unless (and (eq admitted :ok) (eq paused :captured)))
         (mv (list :pause admitted paused captured) fn2-core))
        ((mv sent op gen clients store fn2-core) (fn2-cfc-to-send 40000 clients store fn2-core))
        ((unless (eq sent :send)) (mv (list :send sent) fn2-core))
        (target-send (fn2-cfc-fetch-sendp op gen captured fn2-core))
        (stale-op-refused (not (fn2-cfc-fetch-sendp op (1+ gen) captured fn2-core)))
        (stale-ctl-refused
         (not (fn2-cfc-fetch-sendp op gen (update-nth 4 (1+ (nth 4 captured)) captured) fn2-core)))
        ((unless target-send) (mv (list :wrong-send op gen captured) fn2-core))
        (root-before-failure (fn2-cfc-root-heldp fn2-core))
        ((mv ack fn2-core) (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (ack fn2-ops)
                    (fn2-outbox-ack 1 fn2-ops) (mv ack fn2-core)))
        ((unless (eq ack :ok)) (mv (list :ack ack) fn2-core))
        (fn2-core (fn2-cw-post-failed op gen *fn2-event-send-result* *fn2-reason-io* fn2-core))
        ; The source must stay retained until the real transport borrow ends.
        ((mv closing fn2-core) (fn2-cfc-to-closing 4000 (nth 3 captured) fn2-core))
        (root-after-failure (fn2-cfc-root-heldp fn2-core))
        (borrow-still-live (equal (fn2-ctl-row-borrows (nth 3 captured) fn2-core) 1))
        (fn2-core (fn2-cw-post 1 op gen *fn2-event-borrow-released* *fn2-outcome-done* 0 0 0 fn2-core))
        ((mv quiet clients & fn2-core) (fn2-cw-loop 40000 0 2 clients store fn2-core))
        (free (equal (car (fn2-cfc-source-image fn2-core)) *fn2-cns-source-phase-free*))
        (old-lease (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code)
                     (fn2-pool-handle-code (nth 6 captured) (nth 7 captured) fn2-pool) code))
        (edge-free (stobj-let ((fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (yes)
                     (equal (fn2-alloc-edges-state root-edge fn2-alloc-edges) *fn2-alloc-edge-state-free*) yes))
        (source-quiet (stobj-let ((fn2-cns-sources (fn2-core-cns-sources fn2-core))) (yes)
                       (and (equal (fn2-cns-sources-pending 0 fn2-cns-sources) 0)
                            (equal (fn2-cns-sources-borrow-count 0 fn2-cns-sources) 0)) yes))
        (id (nth 1 captured))
        (handed (or (not (equal (fn2-machine-generation id fn2-core) (nth 2 captured)))
                    (equal (fn2-machine-phase id fn2-core) *fn2-cns-state-free*))))
    (mv (list paused root-at-item sent target-send stale-op-refused stale-ctl-refused root-before-failure root-after-failure closing borrow-still-live quiet free
              (not (eq old-lease :ok)) edge-free source-quiet handed (nth 3 (nth 1 clients))
              (fnc-replies '(fetch) (car (nth 1 (fn2-cw-results clients))))
              (fn2-core-stop-reason fn2-core)) fn2-core)) answer)))
(assert-event (equal (fn2-cfc-run)
 '(:captured t :send t t t t t :closing t :quiet t t t t t t nil 0)))

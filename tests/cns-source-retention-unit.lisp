; Primitive retention witness. Source-job/CLAIM setup is synthetic; this does
; not qualify the authenticated decoder, terminal SEND receipt, or served path.
(in-package "ACL2")
(include-book "../books/cns-source-retention")
(defun fn2-cns-retention-test-body (fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)
 (declare (xargs :stobjs (fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops) :verify-guards nil))
 (b* ((fn2-cns-sources (fn2-cns-sources-init 1 fn2-cns-sources))
      (fn2-checkpoints (fn2-checkpoints-init 1 fn2-checkpoints))
      (fn2-extents (fn2-alloc-init 3 fn2-extents))
      (fn2-ops (fn2-ops-columns-init 1 fn2-ops))
      (fn2-alloc-edges (fn2-alloc-edges-init 32 fn2-alloc-edges))
      ((mv began fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv r0 & e0 ep0 a0 fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv c0 fn2-extents) (fn2-alloc-commit-allocation e0 ep0 a0 1 1 fn2-extents))
      ((mv r1 & e1 ep1 a1 fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv c1 fn2-extents) (fn2-alloc-commit-allocation e1 ep1 a1 1 1 fn2-extents))
      ((mv r2 & e2 ep2 a2 fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv c2 fn2-extents) (fn2-alloc-commit-allocation e2 ep2 a2 1 1 fn2-extents))
      (u0 (* e0 *fn2-storage-extent-units*))
      (u1 (* e1 *fn2-storage-extent-units*))
      (u2 (* e2 *fn2-storage-extent-units*))
      (fn2-cns-sources (fn2-cns-sources-put 0 (phase *fn2-cns-source-phase-retain*)
       (cns-id 7) (cns-gen 9) (ctl-id 11) (ctl-gen 13) (request 17)
       (total 1) (location-kind *fn2-txn-location-raw-source*)
       (root-unit u0) (root-epoch ep0) (root-allocation a0)))
      ((mv root fn2-cns-sources fn2-extents fn2-alloc-edges)
       (fn2-cns-source-root-hold-children 0 7 9 11 13 17 fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops))
      (fn2-cns-sources (fn2-cns-sources-put 0 (phase *fn2-cns-source-phase-manifest*)
       (retention-phase *fn2-cns-source-retention-collecting*)
       (manifest-stage *fn2-cns-source-manifest-stage-claim*) (unit u1) (epoch ep1) (allocation a1)))
      ((mv child fn2-extents fn2-alloc-edges)
       (fn2-cns-source-claim-identity 0 7 9 11 13 17 u1 ep1 a1 fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops))
      (fn2-cns-sources (fn2-cns-sources-set-retention-phase 0 *fn2-cns-source-retention-ready* fn2-cns-sources))
      ((mv replay fn2-extents fn2-alloc-edges)
       (fn2-cns-source-claim-identity 0 7 9 11 13 17 u1 ep1 a1 fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops))
      (fn2-cns-sources (fn2-cns-sources-put 0 (unit u2) (epoch ep2) (allocation a2)))
      ((mv expansion fn2-extents fn2-alloc-edges)
       (fn2-cns-source-claim-identity 0 7 9 11 13 17 u2 ep2 a2 fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)))
  (mv (and (eq began :ok) (eq r0 :ok) (eq c0 :ok) (eq r1 :ok) (eq c1 :ok) (eq r2 :ok) (eq c2 :ok)
           (eq root :ok) (eq child :ok) (eq replay :ok) (eq expansion :coverage)
           (equal (fn2-extents-promised-read e0 fn2-extents) 1)
           (equal (fn2-extents-promised-read e1 fn2-extents) 1)
           (equal (fn2-extents-promised-read e2 fn2-extents) 0))
   fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)))
(defun fn2-cns-retention-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-cns-sources
 (mv-let (answer fn2-cns-sources)
 (with-local-stobj fn2-checkpoints
 (mv-let (answer fn2-cns-sources fn2-checkpoints)
 (with-local-stobj fn2-extents
 (mv-let (answer fn2-cns-sources fn2-checkpoints fn2-extents)
 (with-local-stobj fn2-alloc-edges
 (mv-let (answer fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges)
 (with-local-stobj fn2-ops
 (mv-let (answer fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)
 (fn2-cns-retention-test-body fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges fn2-ops)
 (mv answer fn2-cns-sources fn2-checkpoints fn2-extents fn2-alloc-edges)))
 (mv answer fn2-cns-sources fn2-checkpoints fn2-extents)))
 (mv answer fn2-cns-sources fn2-checkpoints)))
 (mv answer fn2-cns-sources)))
 answer)))
(assert-event (fn2-cns-retention-test))

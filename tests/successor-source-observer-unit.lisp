; Prepared, unexecuted actual public successor wrapper control. Empty OPEN
; writes, a decoded borrowed reader field and the writer HELD-cut tuple are
; explicit local premises. No parsed page, actor authorization or selected
; checkpoint publication is claimed. Resolve itself advances RI; no complete
; flag or resolved cursor is seeded. The same actual close serves cancellation.
(in-package "ACL2")
(include-book "../books/assembly-callbacks-c-commit")
(defun fn2-sso-drive (fuel tx fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv nil fn2-core)
  (mv-let (code fn2-core) (fn2-successor-resolve tx 4096 fn2-core)
   (cond ((eq code :ok) (mv t fn2-core))
         ((eq code :more) (fn2-sso-drive (1- fuel) tx fn2-core))
         (t (mv nil fn2-core))))))
(defun fn2-sso-live-H (endpoint receipt b0 fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core)) (fn2-c-source-control (fn2-core-c-source-control fn2-core))
                     (fn2-c-source-readers (fn2-core-c-source-readers fn2-core)) (fn2-fields (fn2-core-fields fn2-core))) (valid)
       (and (fn2-succ-txns-wfp fn2-succ-txns) (fn2-c-source-control-wfp fn2-c-source-control)
        (fn2-c-source-readers-wfp fn2-c-source-readers) (fn2-fields-wfp fn2-fields)
        (equal (fn2-succ-txns-ri 0 fn2-succ-txns) 1)
        (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 1)
        (fn2-c-source-reader-current-p endpoint receipt fn2-c-source-readers)
        (equal (fn2-fields-value (+ b0 *fn2-succ-res*) fn2-fields) 55)
        (equal (fn2-fields-ref-slot (+ b0 *fn2-succ-res*) fn2-fields) 0)
        (equal (fn2-fields-ref-gen (+ b0 *fn2-succ-res*) fn2-fields) 0)
        (equal (fn2-fields-ref-off (+ b0 *fn2-succ-res*) fn2-fields) 0)
        (equal (fn2-fields-ref-len (+ b0 *fn2-succ-res*) fn2-fields) 0)) valid))
(defun fn2-successor-source-observer-unit-body (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      ((mv stripe b0) (stobj-let ((fn2-fc (fn2-core-fc fn2-core)) (fn2-id-decides (fn2-core-id-decides fn2-core))
                                 (fn2-fields (fn2-core-fields fn2-core))) (code base)
        (fn2-idc-stripe 0 (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields) (mv code base)))
      ((mv take slot gen fn2-core) (fn2-core-reserve 1 4 5 6 fn2-core))
      ((mv write fn2-core) (fn2-core-write slot gen 0 71 4 5 6 fn2-core))
      (fn2-core (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core)) (fn2-fields (fn2-core-fields fn2-core)))
       (fn2-succ-txns fn2-fields)
       (b* ((fn2-succ-txns (fn2-succ-txns-put 0 (phase *fn2-succ-phase-open*) (ri 0)))
            (fn2-fields (fn2-fields-put (+ b0 *fn2-idc-rb*) (value 55) (status 0)
             (ref-slot slot) (ref-gen gen) (ref-off 0) (ref-len 1)))
            (fn2-fields (fn2-succ-copy-scalar-row (+ b0 *fn2-idc-rb*) (+ b0 *fn2-succ-res*) fn2-fields)))
        (mv fn2-succ-txns fn2-fields)) fn2-core))
      ((mv first fn2-core) (fn2-successor-resolve 0 4096 fn2-core))
      ((mv receipt endpoint) (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))
                                       (fn2-id-decides (fn2-core-id-decides fn2-core))) (receipt endpoint)
        (mv (fn2-succ-txns-source-receipt 0 fn2-succ-txns)
            (fn2-c-source-successor-endpoint (- (fn2-succ-txns-rows fn2-succ-txns) (fn2-id-decides-rows fn2-id-decides)) 0))
        (mv receipt endpoint)))
      (H (fn2-sso-live-H endpoint receipt b0 fn2-core))
      ; A direct internal reset is forbidden while the actual endpoint is live.
      ((mv bypass fn2-core) (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core)) (fn2-succ-slots (fn2-core-succ-slots fn2-core))
                                      (fn2-id-decides (fn2-core-id-decides fn2-core))) (code fn2-succ-txns fn2-succ-slots fn2-id-decides)
        (fn2-succ-release 0 fn2-succ-txns fn2-succ-slots fn2-id-decides) (mv code fn2-core)))
      ; A live source endpoint cannot enter a staging/snapshot wait.
      ((mv staged & fn2-core) (fn2-successor-stage 0 fn2-core))
      (stage-kept (fn2-sso-live-H endpoint receipt b0 fn2-core))
      ((mv writer fn2-core) (stobj-let ((fn2-c-source-control (fn2-core-c-source-control fn2-core))) (code fn2-c-source-control)
        (fn2-c-source-writer-begin 2 3 4 5 6 7 fn2-c-source-control) (mv code fn2-core)))
      ((mv finished fn2-core)
       (cond ((eq mode :cancel) (mv-let (code fn2-core) (fn2-successor-release 0 fn2-core) (mv (eq code :ok) fn2-core)))
             ((eq mode :error) (mv-let (code fn2-core) (fn2-successor-resolve 0 4097 fn2-core) (mv (eq code :bounds) fn2-core)))
             (t (fn2-sso-drive 32 0 fn2-core))))
      (C (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core)) (fn2-c-source-control (fn2-core-c-source-control fn2-core))
                     (fn2-c-source-readers (fn2-core-c-source-readers fn2-core)) (fn2-fields (fn2-core-fields fn2-core))
                     (fn2-run-cursors (fn2-core-run-cursors fn2-core))) (valid)
       (and (equal (fn2-succ-txns-source-receipt 0 fn2-succ-txns) 0)
        (not (fn2-c-source-reader-current-p endpoint receipt fn2-c-source-readers))
        (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 0)
        (equal (fn2-c-source-control-wake-pending 0 fn2-c-source-control) 1)
        (equal (fn2-run-cursors-phase 0 fn2-run-cursors) *fn2-run-cursor-phase-idle*)
        (equal (fn2-fields-value (+ b0 *fn2-idc-rb*) fn2-fields) 55)
        (equal (fn2-fields-ref-slot (+ b0 *fn2-idc-rb*) fn2-fields) 0)
        (equal (fn2-fields-ref-gen (+ b0 *fn2-idc-rb*) fn2-fields) 0)
        (equal (fn2-fields-ref-off (+ b0 *fn2-idc-rb*) fn2-fields) 0)
        (equal (fn2-fields-ref-len (+ b0 *fn2-idc-rb*) fn2-fields) 0)) valid))
      ((mv poll fn2-core) (stobj-let ((fn2-c-source-control (fn2-core-c-source-control fn2-core))) (code fn2-c-source-control)
        (fn2-c-source-writer-poll 2 3 4 5 6 7 fn2-c-source-control) (mv code fn2-core))))
  (mv (and (eq stripe :ok) (eq take :ok) (eq write :ok) (eq first :more) (posp receipt) H
       (eq bypass :state) (eq staged :state) stage-kept (eq writer :waiting) finished C (eq poll :exclusive)) fn2-core)))
(defun fn2-successor-source-observer-unit (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (good fn2-core) (fn2-successor-source-observer-unit-body mode fn2-core) good)))
(assert-event (fn2-successor-source-observer-unit :complete))
(assert-event (fn2-successor-source-observer-unit :cancel))
(assert-event (fn2-successor-source-observer-unit :error))

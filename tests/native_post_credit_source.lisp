(defun fnn-owner-commit-release-member (service member release)
 (declare (ignore service))
 ;; The real COMPLETE must have released sealed credit before any reply.
 (assert (= 0 (fn-mcr-credit-of :sealed (fn-mcr-ops *credits*))))
 (push (list (third member) release) *delivered*))
(defun fnn-owner-stop-service-locked (service exit)
 (declare (ignore service)) (assert (= exit 3)) (setq *stopped* t))
(source-functions "host/native/owner.lisp"
 '(fnn-owner-post-credit-trace fnn-owner-commit-complete-locked))

;; One full credit, then a second POST reservation refused; move/take/seal,
;; COMPLETE for accepted/refused/duplicate, then a new reservation succeeds.
(dolist (word '(:accepted :refused :duplicate))
 (setq *credits* (fn-mcr-make 100 0 0 0 0 0 nil 0 nil) *held* 1 *delivered* nil)
 (setq *credits* (cadr (fn-mcr-resize *credits* (fn-mca-conn-key 1) 100)))
 (assert (eq (car (fn-mcr-resize *credits* (fn-mca-conn-key 2) 100)) :refused))
 (fnn-owner-post-credit-trace :saturated)
 (setq *credits* (fn-mca-take *credits* 1 100))
 (fnn-owner-action 'fn-owner-credits-seal)
 (fnn-owner-post-credit-trace :sealed)
 (assert (= 100 (fn-mcr-credit-of :sealed (fn-mcr-ops *credits*))))
 (assert (= 1 (fnn-owner-commit-complete-locked :store :complete (list (list 1 nil word nil)) '(:deferred))))
 (assert (= 0 (fn-mcr-total *credits*)))
 (assert (equal *delivered* (list (list word :rendered))))
 (assert (eq (car (fn-mcr-resize *credits* (fn-mca-conn-key 2) 100)) :ok)))

;; An open next batch survives completion of the sealed batch; its own
;; later settlement releases it. This is custody, not a leaked credit.
(setq *credits* (fn-mcr-make 200 0 0 0 0 0 '((:open 0 . 100) (:sealed 0 . 100)) 0 nil))
(fnn-owner-commit-complete-locked :store :complete '((1 nil :accepted nil)) '(:deferred))
(assert (= 100 (fn-mcr-credit-of :open (fn-mcr-ops *credits*))))
(fnn-owner-action 'fn-owner-credits-settle)
(fnn-owner-post-credit-trace :synchronous)
(assert (= 0 (fn-mcr-total *credits*)))
(setq *credits* (fn-mcr-make 100 0 0 0 0 0 '((:open 0 . 100)) 0 nil))
(fnn-owner-action 'fn-owner-credits-settle)
(fnn-owner-post-credit-trace :drain-refused)
(assert (= 0 (fn-mcr-total *credits*)))
;; Production/no-selector control: instrumentation reads no globals.
(let ((*trace* nil)) (fnn-owner-post-credit-trace :must-not-print))
(format t "PASS actual POST credit settlement and readmission~%")

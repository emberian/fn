; Codec-dispatch controls only: neither allocation installation nor durability
; follows from these decoded bytes. The actual producer/installer owns those.
(in-package "ACL2")
(include-book "../books/executor")
(include-book "../books/journal-record-body")
(include-book "std/util/bstar" :dir :system)
(defun fn2-jac-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      ((mv reserved slot gen fn2-core) (fn2-core-reserve 1 1 0 1 fn2-core))
      ((mv answer fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
        (answer fn2-fields fn2-pool)
        (b* ((base 256)
             (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-field-extent*) 7 fn2-fields))
             (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-field-writer-epoch*) 11 fn2-fields))
             (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-field-allocation*) 13 fn2-fields))
             (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-field-owner-kind*) 5 fn2-fields))
             (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-field-owner*) 17 fn2-fields))
             ((mv encoded end fn2-pool) (fn2-format-allocation-encode base slot gen 0 1 0 1 fn2-fields fn2-pool))
             ((mv decoded next fn2-fields) (fn2-journal-body-decode *record-kind-allocation* base slot gen 0 end 1 0 1 fn2-fields fn2-pool))
             (exact (and (eq encoded :ok) (eq decoded :ok) (= end next)
                         (= (fn2-fields-value (+ base *fn2-format-allocation-field-extent*) fn2-fields) 7)
                         (= (fn2-fields-value (+ base *fn2-format-allocation-field-writer-epoch*) fn2-fields) 11)
                         (= (fn2-fields-value (+ base *fn2-format-allocation-field-allocation*) fn2-fields) 13)
                         (= (fn2-fields-value (+ base *fn2-format-allocation-field-owner-kind*) fn2-fields) 5)
                         (= (fn2-fields-value (+ base *fn2-format-allocation-field-owner*) fn2-fields) 17)))
             ((mv truncated & fn2-fields) (fn2-journal-body-decode *record-kind-allocation* base slot gen 0 (- end 1) 1 0 1 fn2-fields fn2-pool))
             ((mv unknown & fn2-fields) (fn2-journal-body-decode (+ 1 *record-kind-authority-head*) base slot gen 0 end 1 0 1 fn2-fields fn2-pool)))
         (mv (and (eq reserved :ok) exact (not (eq truncated :ok)) (eq unknown :kind)) fn2-fields fn2-pool))
        (mv answer fn2-core))))
  (mv answer fn2-core)))
(defun fn2-jac-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (answer fn2-core) (fn2-jac-body fn2-core) answer)))
(assert-event (fn2-jac-test))

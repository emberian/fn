  (harness-stub-reached 'fnn-owner-core "host/native/owner.lisp"))
(defun fnn-owner-syncer-physical (service grant receipt)
  (declare (ignorable service grant receipt))
  (harness-stub-reached 'fnn-owner-syncer-physical "host/native/owner.lisp"))
(defun fnn-owner-transit-serialized (service cid thunk)
  (declare (ignorable service cid thunk))
  (harness-stub-reached 'fnn-owner-transit-serialized "host/native/owner.lisp"))
(defun fnn-pull-admit-flight (runtime plans kind)
  (declare (ignorable runtime plans kind))
  (harness-stub-reached 'fnn-pull-admit-flight "host/native/pull-service.lisp"))
(defun fnn-pull-flight-dispose (flight)
  (declare (ignorable flight))
  (harness-stub-reached 'fnn-pull-flight-dispose "host/native/pull-service.lisp"))
(defun fnn-pull-flight-finish (flight)
  (declare (ignorable flight))
  (harness-stub-reached 'fnn-pull-flight-finish "host/native/pull-service.lisp"))

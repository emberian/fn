; Actual wire admission and callback execution around query-held owners.
; Single-transition stepping uses the same executor/adapter as fn2-cw-loop,
; allowing observation before a drain can reclaim its row in a later visit.
; No owner phase, ready flag, reservation, or query count is installed here.
(in-package "ACL2")
(include-book "../books/owed-txn")
(include-book "query-reference-unit")
(include-book "core-snapshot-support")
; One actual article needs its resident schema pages and one sealer merge
; workspace; keep sixteen large slots rather than snapshot unused capacity.
(defconst *fn2-qod-profile*
 (put-assoc-equal :t 4
  (put-assoc-equal :pool-classes '((8 . 1024) (64 . 4096) (16 . 65536))
    *fn2-txn-posting-profile*)))
(defun fn2-qod-wire (mode)
 (declare (xargs :verify-guards nil))
 (if (eq mode :conn)
     (append (fn2-cw-crlf-octets '("QUIT")) (make-list 33 :initial-element 88))
  (fn2-cw-crlf-octets
   (append '("POST" "From: owner@example.invalid" "Subject: query owner" "Newsgroups: local.test")
           (if (member-eq mode '(:page :page-loss)) nil '("Message-ID: <owner-drain@example.invalid>"))
           '("" "body long enough for an independent name and digest query window")
           (if (eq mode :c0) nil '("." "QUIT"))))))
(defun fn2-qod-client (mode)
 (declare (xargs :verify-guards nil))
 (let ((wire (fn2-qod-wire mode)))
  (list wire (if (eq mode :c0) (list 6 (- (len wire) 6) :eof) (list (len wire))) nil nil)))
(defun fn2-qod-filled (slot gen need fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (yes)
  (and (natp slot) (< slot (fn2-pool-rows fn2-pool))
       (eq (fn2-pool-handle-code slot gen fn2-pool) :ok)
       (<= need (fn2-pool-fill slot fn2-pool))) yes))
; A real TxnOffer has started from the sealed generated-ID upload.
; Do not synthesize a query row or an upload phase to reach this cut.
(defun fn2-qod-offered-page-p (upload fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let* ((tx (fn2-upload-row-txn upload fn2-core))
        (slot (fn2-machine-slot tx fn2-core))
        (page (fn2-upload-row-lslot upload fn2-core))
        (gen (fn2-upload-row-lgen upload fn2-core))
        (mo (fn2-upload-row-mo upload fn2-core))
        (ml (fn2-upload-row-ml upload fn2-core))
        (c0 (fn2-upload-row-c0-slot upload fn2-core))
        (c1 (fn2-upload-row-c1-slot upload fn2-core))
        (owner-gen (fn2-machine-generation upload fn2-core)))
  (and (fn2-machine-idp tx fn2-core)
       (equal (fn2-machine-phase tx fn2-core) *fn2-txn-state-lookup*)
       (equal (fn2-txn-row-offered tx fn2-core) 1)
       (stobj-let ((fn2-id-decides (fn2-core-id-decides fn2-core))) (active)
        (and (natp slot) (< slot (fn2-id-decides-rows fn2-id-decides))
             (equal (fn2-id-decides-qmask slot fn2-id-decides) 3)
             (equal (fn2-id-decides-qk slot fn2-id-decides) *fn2-upload-kind*)
             (equal (fn2-id-decides-qs slot fn2-id-decides) upload)
             (equal (fn2-id-decides-qg slot fn2-id-decides) owner-gen)
             (equal (fn2-id-decides-q1slot slot fn2-id-decides) page)
             (equal (fn2-id-decides-q1gen slot fn2-id-decides) gen)
             (equal (fn2-id-decides-q1off slot fn2-id-decides) mo)
             (equal (fn2-id-decides-q1len slot fn2-id-decides) ml)
             (member (fn2-id-decides-q2slot slot fn2-id-decides) (list c0 c1))
             (equal (fn2-id-decides-q2len slot fn2-id-decides) 32)) active))))
(defun fn2-qod-source-ready (mode conn upload fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (if (eq mode :conn)
     (and (equal (fn2-machine-phase conn fn2-core) *fn2-conn-state-closing*)
          (fn2-qod-filled (fn2-conn-row-rx-slot conn fn2-core)
                          (fn2-conn-row-rx-gen conn fn2-core) 39 fn2-core))
  (let ((phase (fn2-machine-phase upload fn2-core)))
   (cond
    ((eq mode :c0)
     (and (member phase (list *fn2-upload-state-head* *fn2-upload-state-identity*
                              *fn2-upload-state-receiving* *fn2-upload-state-validating*))
          (fn2-qod-filled (fn2-upload-row-c0-slot upload fn2-core)
                          (fn2-upload-row-c0-gen upload fn2-core) 33 fn2-core)))
    ((eq mode :ready)
     (let ((tx (fn2-upload-row-txn upload fn2-core)))
      (and (fn2-machine-idp tx fn2-core)
           (equal (fn2-machine-phase tx fn2-core) *fn2-txn-state-ready*))))
    (t
     (and (equal phase *fn2-upload-state-sealed*)
          (if (member-eq mode '(:page :page-loss))
              (and (or (not (eq mode :page-loss)) (fn2-qod-offered-page-p upload fn2-core))
                   (equal (fn2-upload-row-lease upload fn2-core) *fn2-upload-lease-held*)
                   (fn2-qod-filled (fn2-upload-row-lslot upload fn2-core)
                                   (fn2-upload-row-lgen upload fn2-core) 33 fn2-core))
            (fn2-qod-filled (fn2-upload-row-c0-slot upload fn2-core)
                            (fn2-upload-row-c0-gen upload fn2-core) 33 fn2-core))))))))
(defun fn2-qod-at-target (mode stage conn upload target fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (if (eq stage :source) (fn2-qod-source-ready mode conn upload fn2-core)
  (let ((phase (fn2-machine-phase target fn2-core)))
   (cond ((eq mode :conn)
          (and (equal phase *fn2-conn-state-draining*)
               (equal (fn2-conn-row-pending conn fn2-core) 0)
               (equal (fn2-conn-row-borrows conn fn2-core) 0)))
         ((eq mode :prepare) (equal phase *fn2-txn-state-prepare*))
         ((eq mode :ready) (equal phase *fn2-txn-state-ready*))
         ((eq mode :page-loss)
          (and (equal phase *fn2-upload-state-draining*)
               ; QUIT must really reclaim the feeding connection while the
               ; extra query still retains the upload's page and chunks.
               (not (equal (fn2-machine-generation conn fn2-core)
                           (fn2-upload-row-conn-gen upload fn2-core)))))
         (t (equal phase *fn2-upload-state-draining*))))))
(defun fn2-qod-until (fuel mode stage conn upload target accepted clients store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond
  ((fn2-qod-at-target mode stage conn upload target fn2-core)
   (mv t accepted clients store fn2-core))
  ((or (zp fuel) (fn2-core-stopped-p fn2-core)) (mv nil accepted clients store fn2-core))
  (t (b* (((mv & & & & & fn2-core) (fn2-transition t 4 fn2-core))
          ((mv & accepted clients store fn2-core) (fn2-cw-adapter-one accepted clients store fn2-core)))
       (fn2-qod-until (- fuel 1) mode stage conn upload target accepted clients store fn2-core)))))
(defun fn2-qod-source (mode conn upload fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (cond
  ((eq mode :conn)
   (mv (fn2-conn-row-rx-slot conn fn2-core) (fn2-conn-row-rx-gen conn fn2-core) 6 7
       *fn2-conn-kind* conn (fn2-machine-generation conn fn2-core)))
  ((member-eq mode '(:page :page-loss))
   (mv (fn2-upload-row-lslot upload fn2-core) (fn2-upload-row-lgen upload fn2-core) 0 1
       *fn2-upload-kind* upload (fn2-machine-generation upload fn2-core)))
  (t (mv (fn2-upload-row-c0-slot upload fn2-core) (fn2-upload-row-c0-gen upload fn2-core) 0 1
         *fn2-upload-kind* upload (fn2-machine-generation upload fn2-core)))))
; Complete range metadata, including bytes, query counts and generation.
; Before/after a held visit the entire core, not selected fields, is equal.
(defun fn2-qod-life (slot gen kind owner generation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (life)
  (list (fn2-pool-handle-code slot gen fn2-pool)
        (fn2-pool-workspace-code slot gen kind owner generation fn2-pool)
        (fn2-pool-query-ref-count slot fn2-pool)
        (fn2-pool-state slot fn2-pool) (fn2-pool-gen slot fn2-pool)
        (fn2-pool-fill slot fn2-pool)
        (fn2-pool-owner-kind slot fn2-pool) (fn2-pool-owner-slot slot fn2-pool)
        (fn2-pool-owner-gen slot fn2-pool)
        (fn2-pool-logical-octets (fn2-pool-fill slot fn2-pool) (fn2-pool-base slot fn2-pool) fn2-pool)) life))
(defun fn2-qod-queued-p (id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-sched (fn2-core-sched fn2-core))) (queued)
  (and (natp id) (< id (fn2-sched-rows fn2-sched))
       (equal (fn2-sched-in-queue id fn2-sched) 1)) queued))
(defun fn2-qod-run (mode target fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (cond ((eq mode :conn) (fn2-conn-run target 4 fn2-core))
       ((member-eq mode '(:prepare :ready)) (fn2-txn-run target 4 fn2-core))
       (t (fn2-upload-run target 4 fn2-core))))

(defun fn2-qod-body (mode held cancel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-qod-profile* :echo nil fn2-core))
      ((mv epoch fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      (conn (fn2-machine-kind-base *fn2-conn-kind* fn2-core))
      (upload (fn2-machine-kind-base *fn2-upload-kind* fn2-core))
      ((mv source-ready accepted clients store fn2-core)
       (fn2-qod-until 40000 mode :source conn upload conn 0 (list (fn2-qod-client mode)) nil fn2-core))
      ((unless (and (eq epoch :ok) source-ready)) (mv (list :source mode) fn2-core))
      ((mv slot gen mo doff kind owner generation) (fn2-qod-source mode conn upload fn2-core))
      (target (cond ((eq mode :conn) conn)
                    ((member-eq mode '(:prepare :ready)) (fn2-upload-row-txn upload fn2-core))
                    (t upload)))
      (targetgen (fn2-machine-generation target fn2-core))
      (other (if (eq mode :conn) (fn2-conn-row-tx-slot conn fn2-core)
               (fn2-upload-row-c1-slot upload fn2-core)))
      (othergen (if (eq mode :conn) (fn2-conn-row-tx-gen conn fn2-core)
                  (fn2-upload-row-c1-gen upload fn2-core)))
      ((mv started fn2-core)
       (if held (fn2-identity-decide-start 3 slot gen mo 1 slot gen doff kind owner generation fn2-core)
        (mv :ok fn2-core)))
      ((mv entered accepted clients store fn2-core)
       (fn2-qod-until 40000 mode :target conn upload target accepted clients store fn2-core))
      ((unless (and entered (eq started :ok))) (mv (list :target mode started) fn2-core))
      (query (fn2-qru-image 3 fn2-core))
      (held-phase (fn2-machine-phase target fn2-core))
      (life (fn2-qod-life slot gen kind owner generation fn2-core))
      (other-life (fn2-qod-life other othergen kind owner generation fn2-core))
      (c0 (fn2-upload-row-c0-slot upload fn2-core))
      (g0 (fn2-upload-row-c0-gen upload fn2-core))
      (c0-life (if (eq mode :page-loss) (fn2-qod-life c0 g0 kind owner generation fn2-core) nil))
      (before (fn2-test-core-snapshot fn2-core))
      ((mv bytes steps actions runnable fn2-core) (fn2-qod-run mode target fn2-core))
      (unchanged (equal before (fn2-test-core-snapshot fn2-core)))
      ((unless (if held
                   (and unchanged (equal (list bytes steps actions runnable) (list 0 *fn2-work-state* 0 nil))
                        (equal (take 3 life) '(:ok :held 2))
                        (equal query (fn2-qru-image 3 fn2-core))
                        (equal other-life (fn2-qod-life other othergen kind owner generation fn2-core)))
                 (and (not unchanged) (not (fn2-core-stopped-p fn2-core)))))
       (mv (list :preflight mode held (list bytes steps actions runnable) life other-life) fn2-core))
      ; The actual scheduler visits the retained owner and reaches quiet.
      ; No runnable bit or ready queue entry is installed by this fixture.
      ((mv quiet clients store fn2-core) (fn2-cw-loop 40000 0 accepted clients store fn2-core))
      (parked (if held
                   (and (eq quiet :quiet) (not (fn2-exec-runnable-p fn2-core))
                        (equal (fn2-machine-generation target fn2-core) targetgen)
                        (equal (fn2-machine-phase target fn2-core) held-phase)
                        (equal query (fn2-qru-image 3 fn2-core))
                        (or (not (eq mode :page-loss))
                            (equal c0-life (fn2-qod-life c0 g0 kind owner generation fn2-core)))
                        (equal life (fn2-qod-life slot gen kind owner generation fn2-core))
                        (equal other-life (fn2-qod-life other othergen kind owner generation fn2-core)))
                 t))
      (ordinary-wake (fn2-machine-wake-id fn2-core))
      ((mv finished fn2-core)
       (if held
           (if cancel (fn2-successor-release 3 fn2-core) (fn2-qru-drive 100 3 fn2-core))
         (mv :ok fn2-core)))
      (wake (fn2-machine-wake-id fn2-core))
      (wake-ok (or (not held)
                   (and (equal wake ordinary-wake) (fn2-qod-queued-p owner fn2-core))))
      ; Query completion directly queues its upload source owner without
      ; replacing the ordinary wake. The actual SEALED upload arm then
      ; explicitly forwards its child wake through the ordinary seam.
      ((mv child-wake-ok fn2-core)
       (if (and held (member-eq mode '(:prepare :ready)))
           (b* (((mv & & & & fn2-core) (fn2-upload-run upload 4 fn2-core))
                ((mv child fn2-core) (fn2-machine-take-wake fn2-core))
                (fn2-core (fn2-exec-wake child fn2-core)))
            (mv (and (equal ordinary-wake *fn2-none*) (equal child target)
                     (fn2-qod-queued-p target fn2-core)) fn2-core))
         (mv t fn2-core)))
      ((mv final-status & & fn2-core) (fn2-cw-loop 40000 0 accepted clients store fn2-core))
      (freed (not (equal (fn2-machine-generation target fn2-core) targetgen)))
      (stale-source (car (fn2-qod-life slot gen kind owner generation fn2-core)))
      (stale-other (car (fn2-qod-life other othergen kind owner generation fn2-core)))
      (stale-c0 (if (eq mode :page-loss)
                    (car (fn2-qod-life c0 g0 kind owner generation fn2-core)) :stale)))
  (mv (if (and parked wake-ok child-wake-ok (eq final-status :quiet) freed
               (eq stale-source :stale) (eq stale-other :stale) (eq stale-c0 :stale)
               (or (not held) (eq finished (if cancel :ok :stored)))
               (not (fn2-core-stopped-p fn2-core)))
          t (list :resume mode held parked finished wake owner child-wake-ok freed stale-source stale-other stale-c0)) fn2-core)))
(defun fn2-qod-test (mode held cancel)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core) (fn2-qod-body mode held cancel fn2-core) answer)))
(assert-event (equal (fn2-qod-test :conn t nil) t))
(assert-event (equal (fn2-qod-test :conn t t) t))
(assert-event (equal (fn2-qod-test :conn nil nil) t))
(assert-event (equal (fn2-qod-test :c0 t nil) t))
(assert-event (equal (fn2-qod-test :c0 t t) t))
(assert-event (equal (fn2-qod-test :c0 nil nil) t))
(assert-event (equal (fn2-qod-test :page t nil) t))
(assert-event (equal (fn2-qod-test :page t t) t))
(assert-event (equal (fn2-qod-test :page nil nil) t))
(assert-event (equal (fn2-qod-test :prepare t nil) t))
(assert-event (equal (fn2-qod-test :ready t t) t))

; Proposed reachable owner-loss control (execution pending): actual TxnOffer first pins the generated name page;
; an independent actual query then keeps it alive through QUIT and normal
; SEALED -> DRAINING. Both DONE and cancellation must wake/reclaim it.
; Page-held ABORTING is not claimed reachable: its only incoming edges are
; pre-store work/identity, before acquisition of the storage lease.
(assert-event (equal (fn2-qod-test :page-loss t nil) t))
(assert-event (equal (fn2-qod-test :page-loss t t) t))

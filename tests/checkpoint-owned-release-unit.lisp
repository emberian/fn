; Actual allocator release plus lifetime-ledger cleanup. Ledger provenance and
; persisted checkpoint coverage are explicit synthetic antecedents here, not
; a cold-import, journal persistence or FREE-admission witness.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-owned-release")
(defun fn2-coru-body (mode fn2-checkpoint-construction fn2-extents)
 (declare (xargs :stobjs (fn2-checkpoint-construction fn2-extents) :verify-guards nil))
 (b* ((fn2-extents (fn2-alloc-init 2 fn2-extents))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-init 2 fn2-checkpoint-construction))
      ((mv begun fn2-extents) (fn2-alloc-begin-epoch 7 fn2-extents))
      ((mv reserved & e epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv committed fn2-extents) (fn2-alloc-commit-allocation e epoch allocation 9 41 fn2-extents))
      ((mv retired fn2-extents) (fn2-alloc-retire e epoch allocation 11 fn2-extents))
      (fn2-extents (update-fn2-alloc-cut 11 fn2-extents))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-put e (live 1)
       (role (if (eq mode :native) 1 *fn2-checkpoint-owned-restored-role*))
       (epoch epoch) (counter (if (eq mode :mismatch) (+ allocation 1) allocation))))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-put 1 (live 1) (token 99) (epoch 77) (counter 88)))
      (eligible (fn2-checkpoint-owned-release-code e epoch allocation fn2-checkpoint-construction fn2-extents))
      ((mv code fn2-checkpoint-construction fn2-extents)
       (fn2-checkpoint-owned-release e epoch allocation fn2-checkpoint-construction fn2-extents)))
  (mv (and (eq begun :ok) (eq reserved :ok) (eq committed :ok) (eq retired :ok)
           (= (fn2-checkpoint-construction-token 1 fn2-checkpoint-construction) 99)
           (= (fn2-checkpoint-construction-live 1 fn2-checkpoint-construction) 1)
           (if (eq mode :mismatch)
            (and (eq eligible :ownership) (eq code :ownership)
                 (= (fn2-checkpoint-construction-live e fn2-checkpoint-construction) 1)
                 (= (fn2-extents-state e fn2-extents) *fn2-extent-state-retire-pending*))
            (and (eq eligible :ok) (eq code :ok)
                 (= (fn2-checkpoint-construction-live e fn2-checkpoint-construction) 0)
                 (= (fn2-extents-state e fn2-extents) *fn2-extent-state-free*))))
      fn2-checkpoint-construction fn2-extents)))
(defun fn2-coru-run (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoint-construction
  (with-local-stobj fn2-extents
   (mv-let (answer fn2-checkpoint-construction fn2-extents)
    (fn2-coru-body mode fn2-checkpoint-construction fn2-extents) answer))))
(assert-event (fn2-coru-run :restored))
(assert-event (fn2-coru-run :native))
(assert-event (fn2-coru-run :mismatch))

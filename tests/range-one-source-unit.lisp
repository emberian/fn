; Prepared actual eight-pending-source control. No ACL2 assertions in this
; book have been executed for this source lane. The overlays are encoded by
; the production schema/overlay codec and read by the production range path.
(in-package "ACL2")
(include-book "../books/range-served")
(include-book "std/util/bstar" :dir :system)
(defconst *fn2-ros-count* *fn2-run-active-source-cursors*)
(defconst *fn2-ros-inputs*
 '(((1 1 100 10 (65 0)) (1 9 109 90 (65 0)) (1 13 113 130 (65 0)))
   ((1 1 200 10 (65 1)) (1 8 208 80 (65 1)) (1 13 213 130 (65 1)))
   ((1 1 300 10 (65 2)) (1 7 307 70 (65 2)))
   ((1 2 402 20 (65 3)) (1 6 406 60 (65 3)))
   ((1 3 503 30 (65 4)) (1 5 505 50 (65 4)))
   ((1 4 604 40 (65 5)) (1 10 610 100 (65 5)))
   ((1 5 705 50 (65 6)) (1 11 711 110 (65 6)))
   ((1 6 806 60 (65 7)) (1 12 812 120 (65 7)))))
(defconst *fn2-ros-sequences* '(10 10 20 30 40 50 60 70))
; Key1 and key5/6 show strictly newer overrides. Key13 shows the existing
; equal-sequence tie: the smaller resident overlay row wins. Whole decoded
; values include the copied octet field, not only keys or row counts.
(defconst *fn2-ros-expected*
 '((1 1 300 10 (65 2)) (1 2 402 20 (65 3)) (1 3 503 30 (65 4))
   (1 4 604 40 (65 5)) (1 5 705 50 (65 6)) (1 6 806 60 (65 7))
   (1 7 307 70 (65 2)) (1 8 208 80 (65 1)) (1 9 109 90 (65 0))
   (1 10 610 100 (65 5)) (1 11 711 110 (65 6)) (1 12 812 120 (65 7))
   (1 13 113 130 (65 0))))
(assert-event (and (equal *fn2-ros-count* 8) (equal (len *fn2-ros-inputs*) *fn2-ros-count*)
                   (equal (len *fn2-ros-sequences*) *fn2-ros-count*)))

(defun fn2-ros-write-entries (entries o pos scratch sgen fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-overlays fn2-overlay-index fn2-fields fn2-pool) :verify-guards nil :measure (len entries)))
 (b* (((when (atom entries)) (mv :ok fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ((mv reset fn2-pool) (fn2-pool-reset scratch sgen 9 0 1 fn2-pool))
      ((unless (eq reset :ok)) (mv reset fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ((mv loaded & fn2-fields fn2-pool)
       (fn2-run-load-values *fn2-overview-entry* (car entries) 128 scratch sgen 0 9 0 1 fn2-fields fn2-pool))
      ((unless (eq loaded :ok)) (mv loaded fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ((mv written fn2-overlays fn2-overlay-index fn2-pool)
       (fn2-ov-write o pos 128 nil fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ((unless (eq written :ok)) (mv written fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
  (fn2-ros-write-entries (cdr entries) o (+ (nfix pos) 1) scratch sgen
   fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
(defun fn2-ros-build-overlays (o sources seqs scratch sgen fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-overlays fn2-overlay-index fn2-fields fn2-pool) :verify-guards nil :measure (len sources)))
 (b* (((when (atom sources)) (mv :ok fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ((mv reserved slot gen fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((unless (eq reserved :ok)) (mv reserved fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ((mv started fn2-overlays fn2-pool)
       (fn2-ov-start o 3 slot gen (* 3 o) 3 9 0 1 1 fn2-overlays fn2-overlay-index fn2-pool))
      ((unless (eq started :ok)) (mv started fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ((mv written fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
       (fn2-ros-write-entries (car sources) o 0 scratch sgen fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ((unless (eq written :ok)) (mv written fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ((mv frozen fn2-overlays) (fn2-ov-freeze o fn2-overlays))
      ((unless (eq frozen :ok)) (mv frozen fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (fn2-overlays (fn2-overlays-set-seq o (car seqs) fn2-overlays)))
  (fn2-ros-build-overlays (+ (nfix o) 1) (cdr sources) (cdr seqs) scratch sgen
   fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
; This checks the full eight-source premise before the single-call assertion:
; actual enumeration, eight nonempty frozen overlays and all pending SEEK.
(defun fn2-ros-pending-p (n fn2-range-sources fn2-overlays)
 (declare (xargs :stobjs (fn2-range-sources fn2-overlays) :verify-guards nil :measure (nfix n)))
 (or (zp n)
  (let* ((s (- n 1)) (o (fn2-range-sources-src s fn2-range-sources)))
   (and (equal (fn2-range-sources-kind s fn2-range-sources) *fn2-range-kind-overlay*)
        (equal (fn2-range-sources-state s fn2-range-sources) *fn2-range-state-seek*)
        (equal (fn2-range-sources-count s fn2-range-sources) 0)
        (equal o (- *fn2-ros-count* 1 s))
        (equal (fn2-overlays-phase o fn2-overlays) *fn2-overlay-phase-frozen*)
        (< 0 (fn2-overlays-count o fn2-overlays))
        (fn2-ros-pending-p (- n 1) fn2-range-sources fn2-overlays)))))
(defun fn2-ros-one-head-p (n fn2-range-sources)
 (declare (xargs :stobjs fn2-range-sources :verify-guards nil :measure (nfix n)))
 (or (zp n)
  (let ((s (- n 1)))
   (and (equal (fn2-range-sources-state s fn2-range-sources)
                (if (equal s (- *fn2-ros-count* 1)) *fn2-range-state-head* *fn2-range-state-seek*))
        (equal (fn2-range-sources-count s fn2-range-sources) (if (equal s (- *fn2-ros-count* 1)) 3 0))
        (fn2-ros-one-head-p (- n 1) fn2-range-sources)))))
(defun fn2-ros-drive (fuel budget fn2-ranges fn2-range-sources fn2-overlays fn2-overlay-index fn2-run-installed
 fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-ranges fn2-range-sources fn2-overlays fn2-overlay-index fn2-run-installed fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool)
 :verify-guards nil :measure (nfix fuel)))
 (b* (((when (zp fuel)) (mv :fuel nil fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-paths fn2-fields))
      ((mv code fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-paths fn2-fields)
       (fn2-range-step 0 budget fn2-ranges fn2-range-sources fn2-overlays fn2-overlay-index fn2-run-installed
        fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool))
      ((when (eq code :more))
       (fn2-ros-drive (- fuel 1) budget fn2-ranges fn2-range-sources fn2-overlays fn2-overlay-index fn2-run-installed
        fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool))
      ((unless (eq code :entry)) (mv code nil fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-paths fn2-fields))
      (row (fn2-run-unload-values *fn2-overview-entry* (fn2-ranges-out 0 fn2-ranges) fn2-fields fn2-pool))
      ((mv end rest fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-paths fn2-fields)
       (fn2-ros-drive (- fuel 1) budget fn2-ranges fn2-range-sources fn2-overlays fn2-overlay-index fn2-run-installed
        fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool)))
  (mv end (cons row rest) fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-paths fn2-fields)))

(defun fn2-range-one-source-unit (budget fn2-ranges fn2-range-sources fn2-overlays fn2-overlay-index fn2-run-installed
 fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-ranges fn2-range-sources fn2-overlays fn2-overlay-index fn2-run-installed fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-ranges (fn2-ranges-init 1 fn2-ranges))
      (fn2-range-sources (fn2-range-sources-init *fn2-ros-count* fn2-range-sources))
      (fn2-overlays (fn2-overlays-init *fn2-ros-count* fn2-overlays))
      (fn2-overlay-index (fn2-overlay-index-init (* 3 *fn2-ros-count*) fn2-overlay-index))
      (fn2-run-installed (fn2-run-installed-init 1 fn2-run-installed))
      (fn2-run-cursors (fn2-run-cursors-init *fn2-ros-count* fn2-run-cursors))
      (fn2-run-paths (fn2-run-paths-init (* *fn2-run-max-levels* *fn2-ros-count*) fn2-run-paths))
      (fn2-run-cache (fn2-run-cache-init 1 fn2-run-cache))
      (fn2-fields (fn2-fields-init (+ 256 (* *fn2-ros-count* *fn2-run-reader-fields*)) fn2-fields))
      (fn2-pool (fn2-pool-init (list (cons (+ 1 *fn2-ros-count*) 4096)) 1 100 fn2-pool))
      ((mv reserved scratch sgen fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv built fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
       (fn2-ros-build-overlays 0 *fn2-ros-inputs* *fn2-ros-sequences* scratch sgen fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-put 0 (value 1) (ref-len 0)))
      (fn2-fields (fn2-fields-put 1 (value 0) (ref-len 0)))
      (fn2-fields (fn2-fields-put *fn2-run-entry-rows* (value 1) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ *fn2-run-entry-rows* 1) (value 99) (ref-len 0)))
      ((mv started fn2-ranges fn2-range-sources)
       (fn2-range-start 0 3 0 *fn2-run-entry-rows* 0 *fn2-ros-count* 0 256 *fn2-range-no-position* 0 9 0 1
        fn2-ranges fn2-range-sources fn2-overlays fn2-run-installed))
      (premise (and (eq reserved :ok) (eq built :ok) (eq started :ok)
                    (equal (fn2-ranges-scount 0 fn2-ranges) *fn2-ros-count*)
                    (fn2-ros-pending-p *fn2-ros-count* fn2-range-sources fn2-overlays)))
      ((mv advanced fn2-range-sources fn2-run-cursors fn2-run-paths fn2-fields)
       (fn2-range-advance-all *fn2-ros-count* 0 budget fn2-ranges fn2-range-sources fn2-overlays fn2-overlay-index fn2-run-installed
        fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool))
      (one (and (eq advanced :more) (fn2-ros-one-head-p *fn2-ros-count* fn2-range-sources)))
      ((mv end rows fn2-ranges fn2-range-sources fn2-run-cursors fn2-run-paths fn2-fields)
       (fn2-ros-drive 512 budget fn2-ranges fn2-range-sources fn2-overlays fn2-overlay-index fn2-run-installed
        fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool)))
  (mv (and premise one (eq end :end) (equal rows *fn2-ros-expected*)
           (equal (fn2-ranges-delivered 0 fn2-ranges) 13))
   fn2-ranges fn2-range-sources fn2-overlays fn2-overlay-index fn2-run-installed
   fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool)))
(defconst *fn2-ros-stobjs*
 '(fn2-ranges fn2-range-sources fn2-overlays fn2-overlay-index fn2-run-installed
   fn2-run-cursors fn2-run-paths fn2-run-cache fn2-fields fn2-pool))
(defmacro fn2-range-one-source-control (budget)
 `(fn2-run-with-local ,*fn2-ros-stobjs* (fn2-range-one-source-unit ,budget ,@*fn2-ros-stobjs*)))
(assert-event (fn2-range-one-source-control 1))
(assert-event (fn2-range-one-source-control 8))

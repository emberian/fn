; Actual POST issues storage I/O; the existing native simulator captures that
; real operation, performs a fault, normalizes and posts its real packet.
; Setup/network and earlier I/O use the existing CW adapter. This scopes the
; native model to the captured operation, not a full-device crash history.
; No upload/transaction phase or accepted ACK is planted.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/owed-txn")
(include-book "../sim/native-cut-program")
(defconst *fn2-uui-profile*
 (put-assoc-equal :k 1 (put-assoc-equal :x 1
  (put-assoc-equal :pool-classes '((8 . 1024) (128 . 16384) (64 . 65536)) *fn2-txn-posting-profile*))))
(defconst *fn2-uui-source*
 (append '("From: a@example.invalid" "Subject: uncertain storage" "Newsgroups: local.test"
           "Message-ID: <uncertain@example.invalid>" "")
         (make-list 220 :initial-element "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))
(defun fn2-uui-target (kind fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (yes op owner gen)
  (mv-let (code op opgen) (fn2-outbox-peek 0 fn2-ops)
   (declare (ignore opgen))
   (if (and (eq code :ok) (= (fn2-ops-kind op fn2-ops) kind)
            (= (fn2-ops-owner-kind op fn2-ops) *fn2-upload-kind*))
    (mv t op (fn2-ops-owner-slot op fn2-ops) (fn2-ops-owner-gen op fn2-ops))
    (mv nil 0 0 0))) (mv yes op owner gen)))
(defun fn2-uui-await (fuel kind accepted clients store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (b* (((mv yes op owner gen) (fn2-uui-target kind fn2-core)))
  (cond (yes (mv :cut op owner gen clients fn2-core))
        ((zp fuel) (mv :fuel 0 0 0 clients fn2-core))
        ((fn2-core-stopped-p fn2-core) (mv :stop 0 0 0 clients fn2-core))
        (t (b* (((mv & accepted clients store fn2-core) (fn2-cw-adapter-one accepted clients store fn2-core))
                 ((mv & & & & fn2-core) (fn2-turn fn2-core)))
             (fn2-uui-await (- fuel 1) kind accepted clients store fn2-core))))))
(defun fn2-uui-bytes (n slot gen off owner ogen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix n)))
 (if (zp n) nil
  (cons (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (b)
         (mv-let (ok b) (fn2-gram-read slot gen off *fn2-upload-kind* owner ogen fn2-pool)
          (if ok b 999)) b)
        (fn2-uui-bytes (- n 1) slot gen (+ 1 off) owner ogen fn2-core))))
(defun fn2-uui-window (slot gen owner ogen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((fill (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (n) (fn2-gram-fill slot fn2-pool) n)))
  (list slot gen fill (fn2-uui-bytes fill slot gen 0 owner ogen fn2-core))))
(defun fn2-uui-resources (id gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (list (fn2-machine-generation id fn2-core)
       (fn2-upload-row-pext id fn2-core) (fn2-upload-row-pepoch id fn2-core) (fn2-upload-row-palloc id fn2-core)
       (fn2-upload-row-cext id fn2-core) (fn2-upload-row-cepoch id fn2-core) (fn2-upload-row-calloc id fn2-core)
       (fn2-upload-row-cfree id fn2-core) (fn2-upload-row-mfill id fn2-core) (fn2-upload-row-munit id fn2-core)
       (fn2-upload-row-mstep id fn2-core) (fn2-upload-row-pdone id fn2-core)
       (fn2-upload-row-lease id fn2-core) (fn2-upload-row-hashed id fn2-core)
       (fn2-upload-row-stored-hashed id fn2-core) (fn2-upload-row-location-hashed id fn2-core)
       (fn2-uui-window (fn2-upload-row-c0-slot id fn2-core) (fn2-upload-row-c0-gen id fn2-core) id gen fn2-core)
       (fn2-uui-window (fn2-upload-row-c1-slot id fn2-core) (fn2-upload-row-c1-gen id fn2-core) id gen fn2-core)
       (fn2-uui-window (fn2-upload-row-lslot id fn2-core) (fn2-upload-row-lgen id fn2-core) id gen fn2-core)))
(defun fn2-uui-ownedp (id gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((p (fn2-upload-row-pext id fn2-core)) (ep (fn2-upload-row-pepoch id fn2-core))
       (a (fn2-upload-row-palloc id fn2-core)) (c (fn2-upload-row-cext id fn2-core))
       (ce (fn2-upload-row-cepoch id fn2-core)) (ca (fn2-upload-row-calloc id fn2-core))
       (c0 (fn2-upload-row-c0-slot id fn2-core)) (g0 (fn2-upload-row-c0-gen id fn2-core))
       (c1 (fn2-upload-row-c1-slot id fn2-core)) (g1 (fn2-upload-row-c1-gen id fn2-core))
       (ls (fn2-upload-row-lslot id fn2-core)) (lg (fn2-upload-row-lgen id fn2-core)))
  (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (yes)
   (and (eq (fn2-alloc-handle-code p ep a fn2-extents) :ok)
        (= (fn2-extents-state p fn2-extents) *fn2-extent-state-reserved*)
        (eq (fn2-alloc-handle-code c ce ca fn2-extents) :ok)
        (= (fn2-extents-state c fn2-extents) *fn2-extent-state-reserved*)
        (eq (fn2-pool-readable-code c0 g0 *fn2-upload-kind* id gen fn2-pool) :ok)
        (eq (fn2-pool-readable-code c1 g1 *fn2-upload-kind* id gen fn2-pool) :ok)
        (eq (fn2-pool-readable-code ls lg *fn2-upload-kind* id gen fn2-pool) :ok)) yes)))
(defun fn2-uui-stop (fuel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond ((fn2-core-stopped-p fn2-core) (mv t fn2-core))
       ((zp fuel) (mv nil fn2-core))
       (t (b* (((mv & & & & fn2-core) (fn2-turn fn2-core))) (fn2-uui-stop (- fuel 1) fn2-core)))))
(defun fn2-uui-body (kind fault fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-uui-profile* :echo nil fn2-core))
      ((mv ec fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      (post (fn2-cw-crlf-octets (append '("POST") *fn2-uui-source* '("." "QUIT"))))
      ((mv cut op id gen clients fn2-core)
       (fn2-uui-await 200000 kind 0 (fn2-cw-clients (list (list post (list (len post))))) nil fn2-core))
      ((unless (and (eq ec :ok) (eq cut :cut) (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))
                    (eq (fn2-upload-snapshot-read-code id fn2-core) :ok) (= (fn2-machine-generation id fn2-core) gen)
                    (= (fn2-upload-row-lease id fn2-core) *fn2-upload-lease-held*)
                    (fn2-am-manifestp (+ (fn2-upload-row-ilen id fn2-core) (fn2-upload-row-hashed id fn2-core)))
                    (posp (fn2-upload-row-mfill id fn2-core)) (fn2-uui-ownedp id gen fn2-core)
                    (= (fn2-upload-row-phase id fn2-core)
                       (if (= kind *fn2-action-write*) *fn2-upload-state-store-wrote* *fn2-upload-state-store-fenced*))))
       (mv nil fn2-core fn2-sim fn2-own))
      (before (fn2-uui-resources id gen fn2-core))
      (fn2-own (fn2-own-init *fn2-uui-profile* fn2-own))
      (fn2-sim (fn2-sim-init 7 :friendly "upload-uncertainty" *fn2-uui-profile* fn2-sim))
      ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
      ((mv physical packet fn2-core fn2-sim fn2-own) (fn2-sim-native-stage op fault 0 fn2-core fn2-sim fn2-own))
      ((unless (and (= taken 1) (eq physical :returned) (fn2-sim-native-packetp packet fn2-sim)
                    (= (nth 0 packet) op) (= (nth 2 packet) kind)
                    (= (fn2-sim-result-outcome kind (nth 5 packet) (nth 6 packet) (nth 4 packet)) *fn2-outcome-failed*)
                    (if (= fault *fn2-fault-short-write*)
                     (and (< 0 (nth 6 packet)) (< (nth 6 packet) (nth 4 packet))) t)))
       (mv nil fn2-core fn2-sim fn2-own))
      ;; Harvest any unrelated queued completion before posting the captured
      ;; packet; its source owner is still waiting on this real operation.
      ((mv & & & & fn2-core) (fn2-turn fn2-core))
      ((mv posted fn2-core fn2-sim fn2-own) (fn2-sim-native-post packet fn2-core fn2-sim fn2-own))
      ((mv stopped fn2-core) (fn2-uui-stop 2000 fn2-core))
      (wire (car (car (fn2-cw-results clients)))))
  (mv (and posted stopped (= (fn2-core-stop-reason fn2-core) *fn2-stop-reason-upload-uncertain*)
           (= (fn2-upload-row-phase id fn2-core) *fn2-upload-state-uncertain*)
           (= (fn2-upload-row-word id fn2-core) *fn2-upload-word-uncertain*)
           (= (fn2-upload-row-sevent id fn2-core) (fn2-terminal-event kind))
           (= (fn2-upload-row-soutcome id fn2-core) *fn2-outcome-failed*)
           (= (fn2-upload-row-scount id fn2-core) (nth 6 packet))
           (equal before (fn2-uui-resources id gen fn2-core)) (fn2-uui-ownedp id gen fn2-core)
           (equal wire (fn2-cw-crlf-octets '("200 fn-nntp experimental server ready" "340 send article to be posted")))
           (fn2-core-wfp fn2-core) (fn2-sim-ready fn2-sim) (fn2-own-wfp fn2-own))
      fn2-core fn2-sim fn2-own)))
(defun fn2-uui-run (kind fault)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (with-local-stobj fn2-sim
   (with-local-stobj fn2-own
    (mv-let (ok fn2-core fn2-sim fn2-own) (fn2-uui-body kind fault fn2-core fn2-sim fn2-own) ok)))))
(assert-event (fn2-uui-run *fn2-action-write* *fn2-fault-write-io*))
(assert-event (fn2-uui-run *fn2-action-write* *fn2-fault-short-write*))
(assert-event (fn2-uui-run *fn2-action-fence* *fn2-fault-flush-io*))

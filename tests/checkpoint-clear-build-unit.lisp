; Actual helper controls: invalid logical indices do not extend any column.
(in-package "ACL2")
(include-book "../books/checkpoint")
(include-book "std/util/bstar" :dir :system)
(defun fn2-checkpoint-clear-build-control (fn2-checkpoint-refs)
 (declare (xargs :stobjs fn2-checkpoint-refs :verify-guards nil))
 (b* ((fn2-checkpoint-refs (fn2-checkpoint-refs-init 1 fn2-checkpoint-refs))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-set-root-build-token 0 7 fn2-checkpoint-refs))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-set-root-source-complete 0 1 fn2-checkpoint-refs))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-set-root-intended-bytes 0 4096 fn2-checkpoint-refs))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-set-root-completed-bytes 0 4096 fn2-checkpoint-refs))
      (before (fn2-checkpoint-refs-view fn2-checkpoint-refs))
      (fn2-checkpoint-refs (fn2-checkpoint-ref-clear-build 1 fn2-checkpoint-refs))
      (upper (equal before (fn2-checkpoint-refs-view fn2-checkpoint-refs)))
      (fn2-checkpoint-refs (fn2-checkpoint-ref-clear-build -1 fn2-checkpoint-refs))
      (negative (equal before (fn2-checkpoint-refs-view fn2-checkpoint-refs)))
      (fn2-checkpoint-refs (fn2-checkpoint-ref-clear-build 0 fn2-checkpoint-refs)))
  (mv (and upper negative
       (fn2-checkpoint-refsp fn2-checkpoint-refs)
       (fn2-checkpoint-refs-wfp fn2-checkpoint-refs)
       (equal (fn2-checkpoint-refs-rows fn2-checkpoint-refs) 1)
       (equal (fn2-checkpoint-refs-root-build-token 0 fn2-checkpoint-refs) 0)
       (equal (fn2-checkpoint-refs-root-source-complete 0 fn2-checkpoint-refs) 0)
       (equal (fn2-checkpoint-refs-root-intended-bytes 0 fn2-checkpoint-refs) 0)
       (equal (fn2-checkpoint-refs-root-completed-bytes 0 fn2-checkpoint-refs) 0))
      fn2-checkpoint-refs)))
(defun fn2-checkpoint-clear-build-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoint-refs
  (mv-let (answer fn2-checkpoint-refs)
   (fn2-checkpoint-clear-build-control fn2-checkpoint-refs) answer)))
(assert-event (fn2-checkpoint-clear-build-run))

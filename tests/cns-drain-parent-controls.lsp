; Run the actual parent predicate and final CNS draining wake instruction.
; Row readers are stubs; this is not generated-core or actor qualification.
(load "tests/ctl-stream-arm-controls.lsp")
(in-package "ACL2")
(defparameter *parent* '(:generation 5 :request 6 :phase :closing))
(defparameter *fn2-ctl-state-free* :free)
(defparameter *fn2-ctl-state-retired* :retired)
(defun fn2-ctl-snapshot-read-code (ctl core)
 (declare (ignore core)) (if (= ctl 4) :ok :bounds))
(defun fn2-machine-generation (ctl core) (declare (ignore ctl)) (getf core :generation))
(defun fn2-ctl-row-request (ctl core) (declare (ignore ctl)) (getf core :request))
(defun fn2-ctl-row-phase (ctl core) (declare (ignore ctl)) (getf core :phase))
(defun find-form (predicate tree)
 (cond ((atom tree) nil) ((funcall predicate tree) tree)
       (t (or (find-form predicate (car tree)) (find-form predicate (cdr tree))))))
(defparameter *source-forms*
 (with-open-file (in "books/cns.lisp")
  (loop for form = (read in nil :end) until (eq form :end) collect form)))
(let* ((definition (find-form
                    (lambda (f) (and (eq (car f) 'defun)
                                     (eq (cadr f) 'fn2-cns-stream-ctl-live-p))) *source-forms*))
       (copy (copy-tree definition)))
 (assert definition)
 (setf (cadr copy) 'actual-cns-parent-live-p)
 (eval copy))
; The declarative arm implicitly supplies the concrete core argument.
(defun fn2-cns-stream-ctl-live-p (ctl gen request)
 (actual-cns-parent-live-p ctl gen request *parent*))
(defparameter *wake-step*
 (let* ((machine (find-form (lambda (f) (and (eq (car f) 'defmachine-arms)
                                            (eq (cadr f) 'fn2-cns)
                                            (eq (caddr f) :declare))) *source-forms*))
        (draining (assoc :draining (getf (cdddr machine) :arms))))
  (find-form (lambda (f) (and (eq (car f) :if)
                             (consp (cadr f))
                             (eq (caadr f) 'fn2-cns-stream-ctl-live-p))) draining)))
(assert *wake-step*)
(defun final-wake (stream request)
 (run (list *wake-step*) `((row-stream . ,stream) (row-ctl . 4) (row-ctl-gen . 5) (row-request . ,request))))
; Close before first decode leaves STREAM=0; final reclamation still wakes.
(assert (equal (final-wake 0 6) '((:wake-row row-ctl))))
(assert (equal (final-wake 1 6) '((:wake-row row-ctl))))
; Same parent generation, newer request: no late wake of the replacement.
(assert (null (final-wake 0 7)))
(let ((*parent* '(:generation 6 :request 6 :phase :closing)))
 (assert (null (final-wake 0 6))))
(let ((*parent* '(:generation 5 :request 6 :phase :retired)))
 (assert (null (final-wake 0 6))))
(format t "CNS ACTUAL FINAL WAKE SOURCE CONTROLS PASS: undecoded stream0, stream1, stale request/generation, retired parent~%")

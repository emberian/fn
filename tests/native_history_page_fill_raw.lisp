;;; Execute the actual page fill and close entry with a recorded pread leaf.
;;; The immutable history-image exclusion covers the descriptor while E is free.
(require :sb-posix)
(defpackage "ACL2" (:use "CL"))
(defpackage "ACL2_*1*_ACL2" (:use "CL"))
(in-package "ACL2")
(define-condition fnn-extent-fault (error)
  ((message :initarg :message :reader fault-message)))
(defvar *fnn-extent-lock* (sb-thread:make-mutex :name "page fixture E"))
(defmacro fnn-with-observed-mutex ((lock label &rest options) &body body)
  (declare (ignore label options))
  `(sb-thread:with-mutex (,lock) ,@body))
(defvar *fnn-extent-image-id* nil)
(defvar *fnn-extent-fds* (make-hash-table))
(defvar *fnn-extent-bases* (make-hash-table))
(defvar *fnn-extent-paths* (make-hash-table))
(setf (gethash 7 *fnn-extent-fds*) 99
      (gethash 7 *fnn-extent-bases*) 4096
      (gethash 7 *fnn-extent-paths*) "immutable-image")
(defvar *reads* 0)
(defvar *short* nil)
(defvar *entered* (sb-thread:make-semaphore :count 0))
(defvar *resume* (sb-thread:make-semaphore :count 0))
(defvar *hold* nil)
(defun fnn-live-pgb () (vector (make-array 16384 :element-type '(unsigned-byte 8)) 16384))
(defun fn-pgs-frame-len (sel mem) (declare (ignore sel mem)) 2048)
(defun fn-pgb-frame-put (sel base st mem) (declare (ignore sel base st)) mem)
(defun fnn-extent-pread (fd bytes offset)
  (assert (not (sb-thread:holding-mutex-p *fnn-extent-lock*)))
  (assert (= fd 99)) (assert (= offset (+ 4096 16384)))
  (assert (= (length bytes) 16384)) (incf *reads*)
  (when *hold*
    (sb-thread:signal-semaphore *entered*)
    (assert (sb-thread:wait-on-semaphore *resume* :timeout 5)))
  (if *short* 3 16384))
(defun load-page-entries ()
  (with-open-file (in "host/native/extent.lisp")
    (loop for form = (read in nil :eof) until (eq form :eof)
          when (and (consp form) (eq (first form) 'defun)
                    (member (second form) '(fn-pgs-fill-frame fnn-extent-close fnn-extent-image-publish fnn-extent-image-file)))
          do (handler-bind ((warning #'muffle-warning)) (eval form)))))
(load-page-entries)
(defun refuses (thunk text)
  (handler-case (progn (funcall thunk) (error "expected refusal: ~a" text))
    (fnn-extent-fault (c) (assert (search text (fault-message c))))))
(refuses (lambda () (fnn-extent-image-publish 8)) "no registered descriptor")
(assert (= (fnn-extent-image-publish 7) 7))
(assert (= (fnn-extent-image-file) 7))
(refuses (lambda () (fnn-extent-image-publish 7)) "already adopted")
(assert (eq (fn-pgs-fill-frame 7 1 0 0 :memory) :memory))
(refuses (lambda () (fn-pgs-fill-frame 8 1 0 0 :memory)) "adopted history image")
(sb-thread:with-mutex (*fnn-extent-lock*)
  (refuses (lambda () (fn-pgs-fill-frame 7 1 0 0 :memory)) "caller holds extent lock"))
(assert (= *reads* 1))
(let ((*short* t))
  (refuses (lambda () (fn-pgs-fill-frame 7 1 0 0 :memory)) "immutable-image: 3 of 16384"))
;; A descriptor-close attempt overlaps the off-E pread and must be refused.
(let ((thread (sb-thread:make-thread
               (lambda () (let ((*hold* t)) (fn-pgs-fill-frame 7 1 0 0 :memory))))))
  (unwind-protect
      (progn
        (assert (sb-thread:wait-on-semaphore *entered* :timeout 5))
        (refuses (lambda () (fnn-extent-close '(7))) "history image cannot be retired")
        (assert (= (gethash 7 *fnn-extent-fds*) 99)))
    (sb-thread:signal-semaphore *resume*)
    (assert (eq (sb-thread:join-thread thread :timeout 5) :memory))))
(format t "history page fill raw: PASS (off-E read, lifetime exclusion, wrong-file/held-E/short-read refusals)~%")

             (oc (fn-ocfg-make owner nil nil nil))
             (before (if (boundp-global 'fn-owner state)
                         (f-get-global 'fn-owner state) nil))
             (state (f-put-global 'fn-owner oc state))
             (xs '(78 69 87 78 69 87 83 13 10 65 82 84 73 67 76 69 32 49 13 10))
             (fn-octets (fn-octets-from-list xs fn-octets)))
        (mv-let (erp preview state) (fn-owner-output-preview 4 0 20 fn-octets state)
          (mv-let (erp2 tariff state) (fn-owner-output-tariff-preview 4 preview state)
            (let ((ok (and (null erp) (null erp2)

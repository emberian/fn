(in-package "ACL2")
(defun fn-output-preview-fixture (state)
  (declare (xargs :stobjs state :mode :program))
  (with-local-stobj fn-octets
    (mv-let (ok state fn-octets)
      (let* ((wire (fn-wire-make-state :command nil 0 nil nil 0 510 8192))
             (view (fn-own-view-make 7 17 nil))

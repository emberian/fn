(defun nfix (x) (if (and (integerp x) (>= x 0)) x 0))
(defun zp (x) (not (and (integerp x) (> x 0))))
(defun natp (x) (and (integerp x) (>= x 0)))
(defun mbe (&key logic exec) (declare (ignore exec)) logic)
(defconstant +fnn-pull-poll-seconds+ 0)
(defvar *path* (second sb-ext:*posix-argv*))
(defvar *mode* (third sb-ext:*posix-argv*))
(defvar *kind* (if (equal (fourth sb-ext:*posix-argv*) "catch-up") :catch-up :pull))
(defvar *runtime* nil)
(defvar *retired-fd* nil)
(defvar *live-fd* nil)
(defvar *stop-checks* 0)
(defvar *opened* 0)
(defvar *close-count* 0)
(defvar *plans* '(((66) nil nil nil 5000)))
(defun registry-check (test message)
  (unless test
    (format t "~&JOURNAL_REGISTRY_ASSERTION:~a~%" message) (finish-output)
    (error "registry assertion: ~a" message)))
(defun fd-open-p (fd)
  (handler-case (progn (sb-posix:fstat fd) t)
    (sb-posix:syscall-error (e)
      (unless (= (sb-posix:syscall-errno e) sb-posix:ebadf) (error e)) nil)))
(defun fnn-close (fd)
  (incf *close-count*) (sb-posix:close fd)
  (when (equal *mode* "close-fault") (error 'fnn-os-error :errno sb-posix:eio)))
(defun fnn-owner-service-store (service) service)
(defun fnn-owner-transit-serialized (service cid thunk)
  (declare (ignore service cid)) (funcall thunk))
(defun fnn-owner-core (subject)
  (unless (member subject '(fn-owner-pull-plans fn-owner-catchup-plans))
    (error "unexpected owner subject ~s" subject))
  (if (eq (eq subject 'fn-owner-catchup-plans) (eq *kind* :catch-up)) *plans* nil))
(defun fnn-pull-monotonic () 10000)
(defun fnn-pull-stoppingp (runtime) (declare (ignore runtime)) (> (incf *stop-checks*) 1))
(defun fnn-core (subject &rest args)
  (when (eq subject 'fn-pull-schedule)
    ;; Observe before ordinary worker exit closes its remaining live cache.
    (registry-check (not (fd-open-p *retired-fd*))
                    "removed peer must release journal descriptor custody")
    (registry-check (fd-open-p *live-fd*) "unchanged peer remains in custody"))
  (case subject
    (fn-pull-plan-for (apply #'fn-pull-plan-for args))
    (fn-pull-plan-peer (apply #'fn-pull-plan-peer args))
    (fn-pull-schedule (apply #'fn-pull-schedule args))
    (fn-sched-pull-due (apply #'fn-sched-pull-due args))
    ((fn-prd-sweep fn-prd-select fn-prd-idle-ms) (apply (symbol-function subject) args))
    (otherwise (error "unexpected core subject ~s" subject))))
(defun fnn-pull-journal-open (store peer)
  (declare (ignore store peer)) (incf *opened*)
  (let ((fd (sb-posix:open *path* sb-posix:o-rdonly)))
    (values (%make-fnn-owner-feed-journal :fd fd :path *path* :phase :ready)
            (list :replayed *opened*))))
(defun fnn-catchup-journal-open (store peer) (fnn-pull-journal-open store peer))
(let* ((old (sb-posix:open *path* (logior sb-posix:o-creat sb-posix:o-rdwr) #o600))
       (live (sb-posix:open *path* sb-posix:o-rdonly))
       (old-journal (%make-fnn-owner-feed-journal :fd old :path *path* :phase :ready))
       (live-journal (%make-fnn-owner-feed-journal :fd live :path *path* :phase :ready))
       (runtime (%make-fnn-pull-runtime :service :store))
       (cache (list (cons "A" old-journal) (cons "B" live-journal)))
       (cursors '(("A" . :stale) ("B" . :live)))
       (schedule '(((65) 1 1000 nil) ((66) 9000 1000 t))))
  (setq *runtime* runtime *retired-fd* old *live-fd* live)
  (if (eq *kind* :catch-up)
      (setf (fnn-pull-runtime-cu-journals runtime) cache
            (fnn-pull-runtime-cu-cursors runtime) cursors
            (fnn-pull-runtime-cu-schedule runtime) schedule)
    (setf (fnn-pull-runtime-journals runtime) cache
          (fnn-pull-runtime-cursors runtime) cursors
          (fnn-pull-runtime-schedule runtime) schedule))
  (when (equal *mode* "schedule")
    (registry-check (equal (fn-pull-schedule *plans* 10000 schedule)
                           '(((66) 9000 5000 t)))
                    "removed peer must no longer remain due in ACL2 schedule")
    (registry-check (equal (fn-pull-schedule *plans* 10000 nil)
                           '(((66) 10000 5000 nil)))
                    "returning peer is due with fresh admission")
    (registry-check (null (fn-pull-schedule nil 10000 schedule))
                    "empty current plans retire whole schedule")
    (fnn-owner-feed-close old-journal) (fnn-owner-feed-close live-journal)
    (format t "~&PULL_JOURNAL_REGISTRY_PASS ~a schedule~%" *kind*)
    (sb-ext:exit :code 0))
  (if (equal *mode* "close-fault")
      (progn
        (setq *plans* nil)
        (handler-case (if (eq *kind* :catch-up) (fnn-catchup-tick runtime) (fnn-pull-worker runtime))
          (fnn-os-error () nil))
        (registry-check (and (not (fd-open-p old)) (not (fd-open-p live)))
                        "close fault still attempts every retired descriptor"))
    (progn
      (if (eq *kind* :catch-up) (fnn-catchup-tick runtime) (fnn-pull-worker runtime))
      (let ((remaining (if (eq *kind* :catch-up) (fnn-pull-runtime-cu-journals runtime)
                         (fnn-pull-runtime-journals runtime)))
            (values (if (eq *kind* :catch-up) (fnn-pull-runtime-cu-cursors runtime)
                      (fnn-pull-runtime-cursors runtime)))
            (tbl (if (eq *kind* :catch-up) (fnn-pull-runtime-cu-schedule runtime)
                   (fnn-pull-runtime-schedule runtime))))
        (registry-check (equal (mapcar #'car remaining) '("B")) "retired journal cache removed")
        (registry-check (equal values '(("B" . :live))) "retired cursor cache removed")
        (registry-check (equal tbl '(((66) 9000 5000 t))) "live schedule preserves next and busy"))
      (when (equal *mode* "reappear")
        (multiple-value-bind (journal cursor)
            (if (eq *kind* :catch-up) (fnn-catchup-cursor-for runtime '((65)))
              (fnn-pull-cursor-for runtime '((65))))
          (registry-check (and (= *opened* 1) (equal cursor '(:replayed 1))
                               (fd-open-p (fnn-owner-feed-journal-fd journal)))
                          "returning peer must reopen through replay leaf")
          (fnn-owner-feed-close journal)))))
  (when (fnn-owner-feed-journal-fd live-journal) (fnn-owner-feed-close live-journal))
  (format t "~&PULL_JOURNAL_REGISTRY_PASS ~a ~a~%" *kind* *mode*))

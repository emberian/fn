; Actual allocator primitive control for historical identity admission.
; This does not assert an authenticated recovery or complete replay witness.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/alloc")
(defun fn2-aai-body (duplicate fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (b* ((fn2-extents (fn2-alloc-init 2 fn2-extents))
      ((mv begun fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv reserved & first epoch counter fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv committed fn2-extents) (fn2-alloc-commit-allocation first epoch counter 6 11 fn2-extents))
      (second (fn2-alloc-free-head fn2-extents))
      (recorded (if duplicate counter (fn2-alloc-next-counter fn2-extents)))
      ; Explicit synthetic cold phase isolates the actual adoption primitive.
      ; This is not a checkpoint publication or authenticated replay premise.
      (fn2-extents (update-fn2-alloc-epoch-begun 0 fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-phase 4 fn2-extents))
      ((mv observed fn2-extents) (fn2-alloc-cold-observe-identity epoch recorded fn2-extents))
      (antecedent (and (eq begun :ok) (eq reserved :ok) (eq committed :ok)
                       (eq observed :ok) (fn2-alloc-invp fn2-extents)
                       (not (= first second))
                       (= (fn2-extents-state second fn2-extents) *fn2-extent-state-free*)))
      ((mv adopted fn2-extents)
       (fn2-alloc-adopt-transition second *fn2-alloc-none* epoch recorded fn2-extents)))
  (mv (and antecedent (eq adopted :ok)
       (= (fn2-extents-epoch first fn2-extents) epoch)
       (= (fn2-extents-counter first fn2-extents) counter)
       (= (fn2-extents-state first fn2-extents) *fn2-extent-state-allocated*)
       (= (fn2-extents-state second fn2-extents) *fn2-extent-state-reserved*)
       (= (fn2-extents-counter second fn2-extents) recorded)
       (if duplicate (not (fn2-alloc-invp fn2-extents)) (fn2-alloc-invp fn2-extents)))
      fn2-extents)))
(defun fn2-aai-run (duplicate)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-extents
  (mv-let (answer fn2-extents) (fn2-aai-body duplicate fn2-extents) answer)))
(assert-event (fn2-aai-run nil))
(assert-event (fn2-aai-run t))

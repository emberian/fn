; Primitive freeze controls. Fixture installation of the token is NOT evidence
; that the production construction set was closed or a C cut was established.
(in-package "ACL2")
(include-book "../books/alloc-freeze")
(include-book "std/util/bstar" :dir :system)
(defun fn2-alloc-freeze-control (freeze fn2-extents fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-extents fn2-alloc-edges) :verify-guards nil))
 (b* ((fn2-extents (fn2-alloc-init 4 fn2-extents))
      (fn2-alloc-edges (fn2-alloc-edges-init 2 fn2-alloc-edges))
      (fn2-alloc-edges (fn2-alloc-edges-set-state 0 *fn2-alloc-edge-state-free* fn2-alloc-edges))
      (fn2-alloc-edges (fn2-alloc-edges-set-state 1 *fn2-alloc-edge-state-free* fn2-alloc-edges))
      ((mv epoch-code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv reserved & e ep al fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((unless (and (eq epoch-code :ok) (eq reserved :ok))) (mv nil fn2-extents fn2-alloc-edges))
      (fn2-extents (update-fn2-alloc-freeze-phase (if freeze 1 0) fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-token 9 fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-owner-kind 1 fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-owner-slot 2 fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-owner-gen 3 fn2-extents))
      (before (fn2-alloc-view fn2-extents))
      ((mv reserve-code & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv cancel-code fn2-extents) (fn2-alloc-cancel-reservation e ep al fn2-extents)))
  (if (not freeze)
      (mv (and (eq reserve-code :ok) (eq cancel-code :ok)
               (not (equal before (fn2-alloc-view fn2-extents)))) fn2-extents fn2-alloc-edges)
   (b* (((mv commit-code fn2-extents) (fn2-alloc-commit-allocation e ep al 1 2 fn2-extents))
        ((mv retire-code fn2-extents) (fn2-alloc-retire e ep al 1 fn2-extents))
        ((mv adopt-code fn2-extents) (fn2-alloc-adopt 1 1 1 fn2-extents))
        ((mv epoch-code fn2-extents) (fn2-alloc-begin-epoch 2 fn2-extents))
        ((mv drain-code fn2-extents) (fn2-alloc-checkpoint-drain 1 1 fn2-extents))
        ((mv release-code fn2-extents) (fn2-alloc-release e ep al fn2-extents))
        (stable (and (equal before (fn2-alloc-view fn2-extents))
                     (equal (fn2-alloc-current-epoch fn2-extents) 1)
                     (fn2-alloc-copy-ownerp 9 1 2 3 fn2-extents)
                     (not (fn2-alloc-copy-ownerp 9 1 2 4 fn2-extents))))
        ((mv pin-code fn2-extents fn2-alloc-edges)
         (fn2-alloc-edge-add 0 7 e ep al :outstanding-io fn2-extents fn2-alloc-edges))
        ((mv unpin-code fn2-extents fn2-alloc-edges)
         (fn2-alloc-edge-drop 0 7 e ep al :outstanding-io fn2-extents fn2-alloc-edges)))
    (mv (and stable (eq reserve-code :frozen) (eq cancel-code :frozen)
             (eq commit-code :frozen) (eq retire-code :frozen) (eq adopt-code :frozen)
             (eq epoch-code :frozen) (eq drain-code :frozen) (eq release-code :frozen)
             (eq pin-code :ok) (eq unpin-code :ok)
             (equal before (fn2-alloc-view fn2-extents))
             (fn2-alloc-ownership-invp fn2-extents fn2-alloc-edges))
        fn2-extents fn2-alloc-edges)))))
(defun fn2-alloc-freeze-control-run (freeze)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-extents
  (mv-let (ok fn2-extents)
   (with-local-stobj fn2-alloc-edges
    (mv-let (ok fn2-extents fn2-alloc-edges)
     (fn2-alloc-freeze-control freeze fn2-extents fn2-alloc-edges)
     (mv ok fn2-extents))) ok)))
(assert-event (fn2-alloc-freeze-control-run t))
(assert-event (fn2-alloc-freeze-control-run nil))

; Phase4 is an explicit primitive antecedent here, not a fabricated boot
; success. Source reconstruction and final Fence remain composed obligations.
(defun fn2-alloc-cold-base-control (cold fn2-extents fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-extents fn2-alloc-edges) :verify-guards nil))
 (b* ((fn2-extents (fn2-alloc-init 4 fn2-extents))
      (fn2-alloc-edges (fn2-alloc-edges-init 2 fn2-alloc-edges))
      ((mv epoch-code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv reserve-code & e epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((unless (and (eq epoch-code :ok) (eq reserve-code :ok))) (mv nil fn2-extents fn2-alloc-edges))
      ((mv base-code fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 0 7 e epoch allocation :recovery-base fn2-extents fn2-alloc-edges))
      ((mv pin-code fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 1 8 e epoch allocation :outstanding-io fn2-extents fn2-alloc-edges))
      ((unless (and (eq base-code :ok) (eq pin-code :ok)
                    (fn2-alloc-edge-matchesp 0 7 e epoch allocation :recovery-base fn2-alloc-edges)
                    (= (fn2-extents-recovery-base e fn2-extents) 1))) (mv nil fn2-extents fn2-alloc-edges))
      (fn2-extents (update-fn2-alloc-freeze-phase (if cold 4 0) fn2-extents))
      (before (fn2-extents-copy fn2-extents))
      (edges-before (fn2-alloc-edges-copy fn2-alloc-edges))
      ((mv code fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-drop 0 7 e epoch allocation :recovery-base fn2-extents fn2-alloc-edges))
      (base-ok (if cold
                 (and (eq code :cold-recovery)
                      (equal before (fn2-extents-copy fn2-extents))
                      (equal edges-before (fn2-alloc-edges-copy fn2-alloc-edges)))
                (and (eq code :ok) (= (fn2-extents-recovery-base e fn2-extents) 0))))
      ((mv unpin-code fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-drop 1 8 e epoch allocation :outstanding-io fn2-extents fn2-alloc-edges)))
  (mv (and base-ok (eq unpin-code :ok)
           (= (fn2-extents-outstanding-io e fn2-extents) 0)
           (= (fn2-extents-recovery-base e fn2-extents) (if cold 1 0))
           (fn2-alloc-ownership-invp fn2-extents fn2-alloc-edges))
      fn2-extents fn2-alloc-edges)))
(defun fn2-alloc-cold-base-control-run (cold)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-extents
  (mv-let (ok fn2-extents)
   (with-local-stobj fn2-alloc-edges
    (mv-let (ok fn2-extents fn2-alloc-edges)
     (fn2-alloc-cold-base-control cold fn2-extents fn2-alloc-edges)
     (mv ok fn2-extents))) ok)))
(assert-event (fn2-alloc-cold-base-control-run t))
(assert-event (fn2-alloc-cold-base-control-run nil))

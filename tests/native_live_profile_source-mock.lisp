(source-forms "host/native/control.lisp" '(fnn-control-reply-octets fnn-control-handle-client))
(source-forms "host/native/bp-control.lisp" '(fnn-bpnc-handle))
(setq *fnn-hybrid-control-handler* #'fnn-store-identity-control-handle)
(dolist (kind '(:nntp :bp))
  (let* ((service (make-fixture-store))
         (control (make-fnn-control-state :service service :read-maximum 1024))
         (socket (make-instance 'sb-bsd-sockets:local-socket :type :stream))
         (*sent-profile* nil) (*bp-admin-turns* 0))
    (unwind-protect
        (progn
          (if (eq kind :bp)
              (fnn-bpnc-handle (make-fnn-bpnc :owner service :control control) socket)
            (fnn-control-handle-client control socket))
          (assert (equal *sent-profile* '(27)))
          (assert (zerop *bp-admin-turns*)))
      (ignore-errors (sb-bsd-sockets:socket-close socket)))))
;; Neither a non-read kind nor failed peer credentials can take BP's read
;; route, even with a profile-shaped frame at the codec seam.
(dolist (case '((4 t) (26 nil)))
  (let* ((*frame-kind* (first case)) (*peer-owner* (second case))
         (*sent-profile* nil) (*bp-admin-turns* 0)
         (socket (make-instance 'sb-bsd-sockets:local-socket :type :stream)))
    (fnn-bpnc-handle (make-fnn-bpnc :owner (make-fixture-store)
                                 :control (make-fnn-control-state :read-maximum 1024)) socket)
    (assert (equal *sent-profile* '(2)))
    (assert (= *bp-admin-turns* 1))))
(format t "live profile: NNTP/BP kind-table dispatch and peer refusal passed~%")

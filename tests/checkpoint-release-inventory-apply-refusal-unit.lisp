; Real prefix entrypoint refusal and source-byte binding. These are component
; controls, not authenticated prefix acceptance or a nonseeded boot witness.
; Nominal COMPLETE/APPLIED counts alone deliberately supply no authority.
(in-package "ACL2")
(include-book "../books/checkpoint-release-inventory-apply")
(include-book "../books/runs-page")
(include-book "column-snapshot-support")
(defun fn2-riau-snapshot-events (children world)
 (declare (xargs :verify-guards nil))
 (if (atom children) nil
  (append (fn2-test-column-snapshot-events (car children) world)
          (fn2-riau-snapshot-events (cdr children) world))))
(make-event (cons 'progn (fn2-riau-snapshot-events *fn2-checkpoint-release-inventory-apply-children* (w state))))
(defun fn2-riau-snapshot-calls (children)
 (declare (xargs :verify-guards nil))
 (if (atom children) nil
  (cons (list (fn2-columns-sym 'fn2-test-table-snapshot- (symbol-name (car children))) (car children))
        (fn2-riau-snapshot-calls (cdr children)))))
(defmacro fn2-riau-snapshot ()
 `(list ,@(fn2-riau-snapshot-calls *fn2-checkpoint-release-inventory-apply-children*)))
(defmacro fn2-riau-refusal-definition ()
 `(defun fn2-riau-refusal (mode ,@*fn2-checkpoint-release-inventory-apply-children*)
   (declare (xargs :stobjs ,*fn2-checkpoint-release-inventory-apply-children* :verify-guards nil))
   (b* ((fn2-checkpoint-restore-release-inventory
          (if (member-eq mode '(:complete :applied))
           (fn2-checkpoint-restore-release-inventory-init 1 fn2-checkpoint-restore-release-inventory)
           fn2-checkpoint-restore-release-inventory))
        (fn2-checkpoint-restore-release-inventory
          (if (member-eq mode '(:complete :applied))
           (fn2-checkpoint-restore-release-inventory-put 0
            (phase (if (eq mode :complete) *fn2-checkpoint-restore-release-inventory-phase-complete*
                      *fn2-checkpoint-restore-release-inventory-phase-applied*))
            (total 0) (materialized 0) (settled 0) (head *fn2-alloc-none*) (tail *fn2-alloc-none*) (cursor *fn2-alloc-none*))
           fn2-checkpoint-restore-release-inventory))
        (typed (and ,@(fn2-columns-carrier-hyps (pairlis$ *fn2-checkpoint-release-inventory-apply-children* nil))))
        (terminal (fn2-checkpoint-release-inventory-call fn2-checkpoint-release-inventory-applied-p))
        (before (fn2-riau-snapshot))
        ((mv code ,@*fn2-checkpoint-release-inventory-apply-outputs*)
          (fn2-checkpoint-release-inventory-call fn2-checkpoint-release-inventory-step (if (eq mode :bad-id) :bad 0) 1)))
    (mv (and typed (not terminal) (eq code :source) (equal before (fn2-riau-snapshot)))
     ,@*fn2-checkpoint-release-inventory-apply-children*))))
(fn2-riau-refusal-definition)
(defmacro fn2-riau-refusal-test-definition ()
 `(defun fn2-riau-refusal-test (mode)
   (declare (xargs :verify-guards nil))
   (fn2-run-with-local ,*fn2-checkpoint-release-inventory-apply-children*
    (fn2-riau-refusal mode ,@*fn2-checkpoint-release-inventory-apply-children*))))
(fn2-riau-refusal-test-definition)
(assert-event (fn2-riau-refusal-test :empty))
(assert-event (fn2-riau-refusal-test :complete))
(assert-event (fn2-riau-refusal-test :applied))
(assert-event (fn2-riau-refusal-test :bad-id))

(defun fn2-riau-fill (i fn2-checkpoint-restore-release-entries)
 (declare (xargs :stobjs fn2-checkpoint-restore-release-entries :verify-guards nil :measure (nfix (- 96 (nfix i)))))
 (if (>= (nfix i) 96) fn2-checkpoint-restore-release-entries
  (let ((fn2-checkpoint-restore-release-entries
    (update-fn2-checkpoint-restore-release-entries-hashesi i (mod (+ 13 i) 256) fn2-checkpoint-restore-release-entries)))
   (fn2-riau-fill (+ 1 (nfix i)) fn2-checkpoint-restore-release-entries))))
(defun fn2-riau-hash-p (i fn2-checkpoint-restore-release-entries fn2-allocation-release)
 (declare (xargs :stobjs (fn2-checkpoint-restore-release-entries fn2-allocation-release) :verify-guards nil :measure (nfix (- 32 (nfix i)))))
 (or (>= (nfix i) 32)
  (and (= (fn2-allocation-release-descriptori i fn2-allocation-release)
          (fn2-checkpoint-restore-release-entries-hashesi (+ 64 i) fn2-checkpoint-restore-release-entries))
       (fn2-riau-hash-p (+ 1 (nfix i)) fn2-checkpoint-restore-release-entries fn2-allocation-release))))
(defun fn2-riau-copy-frame-checks (fields i)
 (declare (xargs :verify-guards nil))
 (if (atom fields) nil
  (append (and (not (eq (caar fields) 'fn2-allocation-release-descriptor))
               (list `(equal (nth ,i before) (nth ,i after))))
          (fn2-riau-copy-frame-checks (cdr fields) (+ 1 i)))))
(make-event
 (value `(defun fn2-riau-copy-frame-p (before after)
   (declare (xargs :verify-guards nil))
   (and ,@(fn2-riau-copy-frame-checks (fn2-test-snapshot-fields 'fn2-allocation-release (w state)) 0)))))
(defun fn2-riau-copy (fn2-checkpoint-restore-release-entries fn2-allocation-release)
 (declare (xargs :stobjs (fn2-checkpoint-restore-release-entries fn2-allocation-release) :verify-guards nil))
 (b* ((fn2-checkpoint-restore-release-entries (fn2-checkpoint-restore-release-entries-init 3 fn2-checkpoint-restore-release-entries))
      (fn2-allocation-release (fn2-allocation-release-init 1 fn2-allocation-release))
      (fn2-checkpoint-restore-release-entries (fn2-riau-fill 0 fn2-checkpoint-restore-release-entries))
      (typed (and (fn2-checkpoint-restore-release-entriesp fn2-checkpoint-restore-release-entries)
        (fn2-checkpoint-restore-release-entries-wfp fn2-checkpoint-restore-release-entries)
        (fn2-allocation-releasep fn2-allocation-release) (fn2-allocation-release-wfp fn2-allocation-release)))
      (source (fn2-test-table-snapshot-fn2-checkpoint-restore-release-entries fn2-checkpoint-restore-release-entries))
      (before (fn2-test-table-snapshot-fn2-allocation-release fn2-allocation-release))
      (fn2-allocation-release (fn2-checkpoint-release-inventory-copy-hash 0 2 fn2-checkpoint-restore-release-entries fn2-allocation-release))
      (after (fn2-test-table-snapshot-fn2-allocation-release fn2-allocation-release))
      (copied (and (fn2-riau-hash-p 0 fn2-checkpoint-restore-release-entries fn2-allocation-release)
        (= (fn2-allocation-release-descriptori 0 fn2-allocation-release) 77)
        (= (fn2-allocation-release-descriptori 31 fn2-allocation-release) 108)
        (fn2-riau-copy-frame-p before after)
        (equal source (fn2-test-table-snapshot-fn2-checkpoint-restore-release-entries fn2-checkpoint-restore-release-entries))))
      (fn2-allocation-release (fn2-checkpoint-release-inventory-copy-hash 0 3 fn2-checkpoint-restore-release-entries fn2-allocation-release)))
  (mv (and typed copied (equal after (fn2-test-table-snapshot-fn2-allocation-release fn2-allocation-release)))
      fn2-checkpoint-restore-release-entries fn2-allocation-release)))
(defun fn2-riau-copy-test ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-checkpoint-restore-release-entries fn2-allocation-release)
  (fn2-riau-copy fn2-checkpoint-restore-release-entries fn2-allocation-release)))
(assert-event (fn2-riau-copy-test))

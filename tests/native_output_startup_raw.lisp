  (case name
    (fn-native-operator-host-result-run-auth-path-octets nil)
    ((fn-native-operator-host-result-run-auth-requiredp fn-native-operator-host-result-run-auth-protected-onlyp) nil)
    (fn-native-operator-host-result-health-min-percent 10)
    (fn-native-operator-host-result-run-store-octets '(115 116 111 114 101))
    (fn-native-operator-host-result-run-listener-host-octets '(49 50 55 46 48 46 48 46 49))
    (fn-native-operator-host-result-run-listener-port 1119)
    (fn-native-operator-host-result-run-oncep nil)
    (fn-native-operator-host-result-run-max-connections 3)
    (fn-native-operator-host-result-run-control-path-octets '(47 116 109 112 47 99 116 114 108))
    (fn-native-operator-host-result-run-posting-enabledp t)
    (fn-native-operator-host-result-run-cold-resources *startup-cold*)
    (fn-native-operator-host-result-run-output-resources *startup-output*)
    (fn-native-control-host-max-active-clients 4)
    (fn-native-control-host-lease-path '(47 116 109 112 47 108 101 97 115 101))
    (fn-native-config-host-listener-addresses '((:inet (127 0 0 1))))
    (fn-native-health-host-run-stopped-line nil)
    (fn-orv-startup-slots (apply #'fn-orv-startup-slots args))
    (fn-orv-startup-grant (if *startup-refuse* '(:refused :output-pool-not-held) '(:hold)))
    (create-fn-resource-ledger (incf *startup-allocations*) (setq *startup-ledger* (list :private-ledger)))
    (fn-heap-figure-octets 1000000)
    (fn-ort-log-close-exit (apply #'fn-ort-log-close-exit args))
    (otherwise (error "unrecorded startup subject ~s" name))))

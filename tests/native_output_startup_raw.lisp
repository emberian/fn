(check (= 0 (fnn-operator-execute-run :accepted-result)) "actual accepted-plan transport reaches owner")
(check (and (eq (nth 11 *startup-run-args*) *startup-cold*)
            (eq (nth 12 *startup-run-args*) *startup-output*))
       "same accepted cold/output descriptor objects survive operator/control/normalized owner chain")
(dolist (subject '(fn-native-operator-host-result-run-cold-resources fn-native-operator-host-result-run-output-resources))
  (check (equal (cdr (assoc subject *startup-calls*)) '(:accepted-result)) "both resources captured from the same actual result"))
(let ((service (%make-fnn-owner-service :cold-resources *startup-cold*
                                      :output-resources *startup-output* :output-slots 5)))
  (setq *startup-calls* nil *startup-allocations* 0)
  (fnn-owner-output-install service 64000000 1000000)
  (check (and (= *startup-allocations* 1)
              (eq (fnn-owner-service-output-ledger service) *startup-ledger*)
              (equal (subseq (cdr (assoc 'fn-rlo-install *startup-calls*)) 0 5)
                     (list 64000000 1000000 *startup-cold* *startup-output* 5)))
         "actual startup installer retains actual private ledger and exact captured funding inputs")
  (let ((ordered (reverse *startup-calls*)))
    (check (equal (mapcar #'car ordered) '(fn-orv-startup-grant create-fn-resource-ledger fn-rlo-install))
           "headroom grant precedes private constructor/resize")))
(let* ((*startup-refuse* t) (*startup-allocations* 0)
       (service (%make-fnn-owner-service :cold-resources *startup-cold*
                  :output-resources *startup-output* :output-slots 5)))
  (check (handler-case (progn (fnn-owner-output-install service 1 1000000) nil)
           (fnn-store-error () t)) "insufficient captured headroom refuses")
  (check (and (zerop *startup-allocations*) (null (fnn-owner-service-output-ledger service)))
         "headroom refusal allocates no private ledger"))
(let ((*startup-allocations* 0) (service (%make-fnn-owner-service)))
  (fnn-owner-output-install service 1 1000000)
  (check (zerop *startup-allocations*) "absent staged policy creates no output pool"))
(format t "native_output_startup_raw: PASS actual accepted-plan chain/headroom-before-allocation~%")


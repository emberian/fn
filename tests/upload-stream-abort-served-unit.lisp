; Actual adapter EOF/refusal cuts, no actor/ACK setters. SOURCE ONLY, UNRUN.
; Root-reserve/root-Write owner-disconnect is unreachable-in-composition:
; Conn issues no Receive after its complete article terminator. The late
; control uses an actual duplicate transaction refusal, never fake EOF.
(in-package "ACL2")
(include-book "upload-rolling-served-unit")
(include-book "../sim/native-cut-program")

(defun fn2-ua-packet (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (packet)
  (mv-let (code op gen) (fn2-outbox-peek 0 fn2-ops)
   (if (eq code :ok)
    (list op gen (fn2-ops-kind op fn2-ops) (fn2-ops-owner-kind op fn2-ops)
          (fn2-ops-owner-slot op fn2-ops) (fn2-ops-owner-gen op fn2-ops)) nil)) packet))
(defun fn2-ua-handles (id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (remove-equal (list *fn2-none* 0 0)
  (list (list (fn2-upload-row-pext id fn2-core) (fn2-upload-row-pepoch id fn2-core) (fn2-upload-row-palloc id fn2-core))
        (list (fn2-upload-row-cext id fn2-core) (fn2-upload-row-cepoch id fn2-core) (fn2-upload-row-calloc id fn2-core))
        (list (fn2-upload-row-rootext id fn2-core) (fn2-upload-row-rootepoch id fn2-core) (fn2-upload-row-rootalloc id fn2-core)))))
(defun fn2-ua-window (slot lease id gen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (let ((fill (fn2-pool-fill slot fn2-pool)))
  (list slot lease fill (fn2-pool-state slot fn2-pool)
        (fn2-pool-owner-kind slot fn2-pool) (fn2-pool-owner-slot slot fn2-pool) (fn2-pool-owner-gen slot fn2-pool)
        (fn2-ur-bytes fill 0 slot lease id gen fn2-pool))))
(defun fn2-ua-resources (id gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (cons (fn2-ua-handles id fn2-core)
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (windows)
   (list (fn2-ua-window (fn2-upload-row-c0-slot id fn2-core) (fn2-upload-row-c0-gen id fn2-core) id gen fn2-pool)
         (fn2-ua-window (fn2-upload-row-c1-slot id fn2-core) (fn2-upload-row-c1-gen id fn2-core) id gen fn2-pool)
         (fn2-ua-window (fn2-upload-row-lslot id fn2-core) (fn2-upload-row-lgen id fn2-core) id gen fn2-pool)) windows)))
(defun fn2-ua-free-handles-p (handles fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (if (atom handles) t
  (and (fn2-alloc-slotp (caar handles) fn2-extents)
       (= (fn2-extents-state (caar handles) fn2-extents) *fn2-extent-state-free*)
       (= (fn2-extents-reservation (caar handles) fn2-extents) 0)
       (fn2-ua-free-handles-p (cdr handles) fn2-extents))))
(defun fn2-ua-retained-handles-p (handles fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (if (atom handles) t
  (and (eq (fn2-alloc-handle-code (nth 0 (car handles)) (nth 1 (car handles))
                                 (nth 2 (car handles)) fn2-extents) :ok)
       (= (fn2-extents-state (caar handles) fn2-extents) *fn2-extent-state-reserved*)
       (= (fn2-extents-reservation (caar handles) fn2-extents) 1)
       (fn2-ua-retained-handles-p (cdr handles) fn2-extents))))
(defun fn2-ua-no-upload-pool-p (left fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix left)))
 (if (zp left) t
  (and (not (= (fn2-pool-owner-kind (- left 1) fn2-pool) *fn2-upload-kind*))
       (fn2-ua-no-upload-pool-p (- left 1) fn2-pool))))
(defun fn2-ua-final (handles unrelated fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (yes)
  (and (fn2-extents-wfp fn2-extents) (fn2-pool-wfp fn2-pool) (fn2-pool-semanticp fn2-pool)
       (fn2-ua-free-handles-p handles fn2-extents)
       (eq (fn2-alloc-handle-code (nth 0 unrelated) (nth 1 unrelated) (nth 2 unrelated) fn2-extents) :ok)
       (= (fn2-extents-state (nth 0 unrelated) fn2-extents) *fn2-extent-state-reserved*)
       (= (fn2-extents-reservation (nth 0 unrelated) fn2-extents) 1)
       (= (fn2-alloc-total-reserved fn2-extents) 1)
       (= (+ (fn2-alloc-total-free fn2-extents) (fn2-alloc-total-allocated fn2-extents)
             (fn2-alloc-total-retired fn2-extents) 1) (fn2-extents-rows fn2-extents))
       (fn2-ua-no-upload-pool-p (fn2-pool-rows fn2-pool) fn2-pool)) yes))

; Execute the same captured real operation through the existing fault driver.
(defun fn2-ua-fail-fence (op fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (with-local-stobj fn2-sim
  (with-local-stobj fn2-own
   (mv-let (ok fn2-core fn2-sim fn2-own)
    (b* ((fn2-own (fn2-own-init *fn2-ur-profile* fn2-own))
         (fn2-sim (fn2-sim-init 7 :friendly "rolling-refusal-fence" *fn2-ur-profile* fn2-sim))
         ((mv took fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
         ((mv physical packet fn2-core fn2-sim fn2-own)
          (fn2-sim-native-stage op *fn2-fault-flush-io* 0 fn2-core fn2-sim fn2-own))
         ((mv posted fn2-core fn2-sim fn2-own) (fn2-sim-native-post packet fn2-core fn2-sim fn2-own)))
     (mv (and (= took 1) (eq physical :returned) posted (fn2-sim-native-packetp packet fn2-sim)
              (= (nth 0 packet) op) (= (nth 2 packet) *fn2-action-fence*)
              (= (fn2-sim-result-outcome *fn2-action-fence* (nth 5 packet) (nth 6 packet) (nth 4 packet))
                 *fn2-outcome-failed*))
         fn2-core fn2-sim fn2-own))
    (mv ok fn2-core)))))

; LOG=(seen-handles EOF-cut root-reserved root-write-done fault-snapshot fault-id fault-gen).
(defun fn2-ua-loop (fuel idle accepted clients store mode log fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel clients log fn2-core)
  (b* ((row (fn2-ur-observe-kind fn2-core))
       (id (fn2-ur-at :id row)) (gen (fn2-ur-at :gen row))
       ; The late case's seed is short; observe only the actual later upload.
       (active (and row (or (not (eq mode :late)) (< 1000 (fn2-ur-at :hashed row)))))
       (handles (if active (union-equal (fn2-ua-handles id fn2-core) (nth 0 log)) (nth 0 log)))
       (packet (fn2-ua-packet fn2-core))
       (eof-pending (and packet (= (nth 2 packet) *fn2-action-receive*)
                  (atom (nth 0 (car clients))) (eq (car (nth 1 (car clients))) :eof)))
       ; A delayed network completion is external scheduling, not actor state.
       ; Leave the actual descriptor in the outbox until its requested cut.
       (deliver-eof (and eof-pending active
         (if (eq mode :before) (= (fn2-upload-row-stream-provisional id fn2-core) 0)
                               (< 0 (fn2-upload-row-stream-provisional id fn2-core)))))
       (cut (if deliver-eof (list (fn2-upload-row-stream-provisional id fn2-core)
                           (fn2-upload-row-cfree id fn2-core) (fn2-upload-row-pending id fn2-core)) (nth 1 log)))
       (root (or (nth 2 log) (and active (not (= (fn2-ur-at :root row) *fn2-none*)))))
       (rootwrite (or (nth 3 log)
        (and active (= (fn2-ur-at :phase row) *fn2-upload-state-stream-root-wrote*)
         (= (fn2-ur-at :ready row) 1) (= (fn2-ur-at :event row) *fn2-event-write-result*)
         (= (fn2-ur-at :outcome row) *fn2-outcome-done*) (= (fn2-ur-at :pending row) 0))))
       (fail (and (eq mode :failed) (not (nth 4 log)) active packet
              (= (nth 2 packet) *fn2-action-fence*) (= (nth 3 packet) *fn2-upload-kind*)
              (= (fn2-ur-at :phase row) *fn2-upload-state-stream-refuse-fenced*)))
       (snapshot (if fail (fn2-ua-resources id gen fn2-core) (nth 4 log)))
       (rootid (if (and active (not (= (fn2-ur-at :root row) *fn2-none*)))
                  (list (fn2-ur-at :root row) (fn2-upload-row-rootepoch id fn2-core)
                        (fn2-upload-row-rootalloc id fn2-core)) nil))
       (firstroot (or (nth 7 log) rootid))
       (rootbad (or (nth 8 log) (and rootid (not (equal firstroot rootid)))))
       (rootfence (or (nth 9 log)
         (and active rootid (= (fn2-ur-at :phase row) *fn2-upload-state-stream-root-fenced*)
          (= (fn2-ur-at :ready row) 1) (= (fn2-ur-at :event row) *fn2-event-fence-result*)
          (= (fn2-ur-at :outcome row) *fn2-outcome-done*) (= (fn2-ur-at :pending row) 0))))
       (log (list handles cut root rootwrite snapshot (if fail id (nth 5 log)) (if fail gen (nth 6 log)) firstroot rootbad rootfence))
       ((mv took accepted clients store fn2-core)
        (if fail
         (mv-let (ok fn2-core) (fn2-ua-fail-fence (car packet) fn2-core)
          (mv ok accepted clients store fn2-core))
         (if (and eof-pending (not deliver-eof))
             (mv nil accepted clients store fn2-core)
           (fn2-cw-adapter-one accepted clients store fn2-core))))
       ((mv & observed visited actions fn2-core) (fn2-turn fn2-core))
       (idle (if (or took (< 0 observed) (< 0 visited) (< 0 actions)) 0 (+ 1 (nfix idle)))))
   (if (or (<= 3 idle) (fn2-core-stopped-p fn2-core)) (mv :quiet clients log fn2-core)
    (fn2-ua-loop (- fuel 1) idle accepted clients store mode log fn2-core)))))

(defun fn2-ua-body (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-ur-profile* :echo nil fn2-core))
      ((mv epoch unrelated fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code handle fn2-extents)
        (b* (((mv code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
             ((mv reserve & e ep al fn2-extents) (fn2-alloc-reserve fn2-extents)))
         (mv (if (eq code :ok) reserve code) (list e ep al) fn2-extents))
        (mv code handle fn2-core)))
      (early (not (eq mode :late)))
      (article (append *fn2-ur-head* (fn2-ur-lines (if (eq mode :before) 1000 (if early 8192 32768)))))
      (input (fn2-cw-crlf-octets
       (if early (append '("POST") article)
        (append '("POST") *fn2-ur-head* '("seed" "." "POST") article '("." "QUIT")))))
      ((mv status clients log fn2-core)
       (fn2-ua-loop 800000 0 0
        (fn2-cw-clients (list (list input (if early (list (len input) :eof) (list (len input)))))) nil mode nil fn2-core))
      (cut (nth 1 log)) (wire (car (car (fn2-cw-results clients)))))
  (mv (and (eq epoch :ok) (eq status :quiet) (fn2-core-wfp fn2-core)
   (consp (nth 0 log))
   (if (eq mode :failed)
    (and (nth 4 log) (fn2-core-stopped-p fn2-core)
         (= (fn2-core-stop-reason fn2-core) *fn2-stop-reason-upload-uncertain*)
         (= (fn2-machine-generation (nth 5 log) fn2-core) (nth 6 log))
         (equal (nth 4 log) (fn2-ua-resources (nth 5 log) (nth 6 log) fn2-core))
         (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (retained)
          (fn2-ua-retained-handles-p (nth 0 log) fn2-extents) retained)
         (not (search (fn2-cw-crlf-octets '("240 article received OK")) wire)))
    (and (not (fn2-core-stopped-p fn2-core)) (fn2-ua-final (nth 0 log) unrelated fn2-core)
     (if early
      (and cut
           (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (empty)
            (and (= (fn2-alloc-total-allocated fn2-extents) 0)
                 (= (fn2-alloc-total-retired fn2-extents) 0)
                 (= (+ 1 (fn2-alloc-total-free fn2-extents)) (fn2-extents-rows fn2-extents))) empty)
           (if (eq mode :before) (= (car cut) 0) (< 0 (car cut)))
           (equal wire (fn2-cw-crlf-octets '("200 fn-nntp experimental server ready" "340 send article to be posted"))))
      (and (nth 2 log) (nth 3 log) (nth 9 log) (not (nth 8 log))
       (equal (fn2-cw-results clients)
        (list (list (fn2-cw-crlf-octets '("200 fn-nntp experimental server ready" "340 send article to be posted"
         "240 article received OK" "340 send article to be posted"
         "441 posting failed; a different article with this Message-ID is stored here" "205 closing connection")) t))))))))
   fn2-core)))

(assert-event (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-ua-body :before fn2-core) ok)))
(assert-event (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-ua-body :after fn2-core) ok)))
(assert-event (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-ua-body :failed fn2-core) ok)))
(assert-event (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-ua-body :late fn2-core) ok)))

; assembly import. CNS's served fn2-cns-dec-append calls this full DECODE and
; rejects :more, but its actor/frame path is NOT executed by this fixture.
; Empty stream/op still encode code1+stream1+op2+article4 = EIGHT octets.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/consumer-codec")

(defun fn2-fab-fill (i n slot gen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- (nfix n) (nfix i)))))
 (if (>= (nfix i) (nfix n)) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen i 65 1 0 1 fn2-pool)
   (if (eq code :ok) (fn2-fab-fill (+ 1 i) n slot gen fn2-pool) (mv code fn2-pool)))))

(defun fn2-fab-ref (i n slot gen fn2-fields)
 (declare (xargs :stobjs fn2-fields :verify-guards nil))
 (let* ((fn2-fields (fn2-fields-set-ref-slot i slot fn2-fields))
        (fn2-fields (fn2-fields-set-ref-gen i gen fn2-fields))
        (fn2-fields (fn2-fields-set-ref-off i 0 fn2-fields)))
  (fn2-fields-set-ref-len i n fn2-fields)))

(defun fn2-fab-bytes-p (i end n slot gen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- (nfix end) (nfix i)))))
 (if (>= (nfix i) (nfix end)) t
  (mv-let (code byte) (fn2-pool-read slot gen i 1 0 1 fn2-pool)
   (and (eq code :ok)
    (= byte (cond ((= i 0) 11) ((< i 4) 0)
                  ((< i 8) (mod (ash n (- (* 8 (- 7 i)))) 256)) (t 65)))
    (fn2-fab-bytes-p (+ 1 i) end n slot gen fn2-pool)))))

(defun fn2-fab-resume (fuel slot gen end fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel 0 fn2-fields)
  (mv-let (code next fn2-fields)
   (fn2-fnct-k4-append-decode-step 16 slot gen 0 end 1 0 1 1 fn2-fields fn2-pool)
   (if (eq code :more) (fn2-fab-resume (- fuel 1) slot gen end fn2-fields fn2-pool)
    (mv code next fn2-fields)))))

(defun fn2-fab-case (n fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init 128 fn2-fields))
      (fn2-pool (fn2-pool-init '((2 . 8192)) 1 100 fn2-pool))
      ((mv src source sg fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv dst slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv filled fn2-pool) (fn2-fab-fill 0 n source sg fn2-pool))
      (fn2-fields (fn2-fields-set-value *fn2-fnct-k4-append-field-code* 11 fn2-fields))
      (fn2-fields (fn2-fab-ref *fn2-fnct-k4-append-field-stream* 0 source sg fn2-fields))
      (fn2-fields (fn2-fab-ref *fn2-fnct-k4-append-field-op* 0 source sg fn2-fields))
      (fn2-fields (fn2-fab-ref *fn2-fnct-k4-append-field-article* n source sg fn2-fields))
      ((mv encoded end fn2-pool) (fn2-fnct-k4-append-encode 0 slot gen 0 1 0 1 fn2-fields fn2-pool))
      (valid (and (eq src :ok) (eq dst :ok) (eq filled :ok) (eq encoded :ok)
       (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields) (fn2-poolp fn2-pool)
       (fn2-pool-wfp fn2-pool) (fn2-pool-semanticp fn2-pool)
       (<= (+ 16 *fn2-fnct-k4-append-num-fields*) (fn2-fields-rows fn2-fields))
       (eq (fn2-layout-range-code slot gen 0 end nil 1 0 1 fn2-pool) :ok)
       (eq (fn2-fnct-k4-append-check-values 0 slot 0 end 1 0 1 fn2-fields fn2-pool) :ok)))
      (bytes (and (= end (+ n 8)) (fn2-fab-bytes-p 0 end n slot gen fn2-pool)))
      ((mv full next fn2-fields) (fn2-fnct-k4-append-decode 16 slot gen 0 end 1 0 1 fn2-fields fn2-pool))
      (phase (fn2-fields-decode-phase 16 fn2-fields))
      ((mv terminal final fn2-fields)
       (if (eq full :more) (fn2-fab-resume (+ 1 end) slot gen end fn2-fields fn2-pool)
        (mv full next fn2-fields)))
      (a (+ 16 *fn2-fnct-k4-append-field-article*))
      (decoded (and (= (fn2-fields-value (+ 16 *fn2-fnct-k4-append-field-code*) fn2-fields) 11)
       (= (fn2-fields-ref-len (+ 16 *fn2-fnct-k4-append-field-stream*) fn2-fields) 0)
       (= (fn2-fields-ref-len (+ 16 *fn2-fnct-k4-append-field-op*) fn2-fields) 0)
       (= (fn2-fields-ref-slot a fn2-fields) slot) (= (fn2-fields-ref-gen a fn2-fields) gen)
       (= (fn2-fields-ref-off a fn2-fields) 8) (= (fn2-fields-ref-len a fn2-fields) n)
       (= (fn2-fields-decode-phase 16 fn2-fields) (fn2-fnct-k4-append-phase-keyword->code :done)))))
  (mv (list valid bytes end full next phase terminal final decoded) fn2-fields fn2-pool)))

(defun fn2-fab-test (n)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (result fn2-fields)
   (with-local-stobj fn2-pool
    (mv-let (result fn2-fields fn2-pool) (fn2-fab-case n fn2-fields fn2-pool)
     (mv result fn2-fields))) result)))

(defun fn2-fab-result-p (n result)
 (declare (xargs :verify-guards nil))
 (and (nth 0 result) (nth 1 result) (= (nth 2 result) (+ n 8))
  (eq (nth 3 result) (if (<= (+ n 8) 4096) :ok :more))
  (= (nth 4 result) (min (+ n 8) 4096))
  (equal (= (nth 5 result) (fn2-fnct-k4-append-phase-keyword->code :done)) (<= (+ n 8) 4096))
  (eq (nth 6 result) :ok) (= (nth 7 result) (+ n 8)) (nth 8 result)))

; Exact whole encoded spans 4095,4096,4097 and a ~6KiB opaque article.
(assert-event (fn2-fab-result-p 4087 (fn2-fab-test 4087)))
(assert-event (fn2-fab-result-p 4088 (fn2-fab-test 4088)))
(assert-event (fn2-fab-result-p 4089 (fn2-fab-test 4089)))
(assert-event (fn2-fab-result-p 6144 (fn2-fab-test 6144)))

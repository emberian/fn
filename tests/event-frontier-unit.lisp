(in-package "ACL2")
(include-book "journal-members-unit")
(include-book "../books/event-frontier")

; This driver consumes the actual commit writer's resident records. Logical
; octet extraction is test evidence only; the producer hashes the owned pool.
(defun fn2-efu-drive (fuel row leaf records fn2-journal-members fn2-mk fn2-core)
 (declare (xargs :stobjs (fn2-journal-members fn2-mk fn2-core) :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel records fn2-journal-members fn2-mk fn2-core)
  (b* ((ready (= (fn2-journal-members-phase 0 fn2-journal-members) *fn2-journal-members-phase-leaf*))
       (capture (and ready (= (fn2-journal-members-hash-phase 0 fn2-journal-members) 0)))
       (slot (fn2-journal-members-slot 0 fn2-journal-members))
       (start (fn2-journal-members-start 0 fn2-journal-members))
       (size (- (fn2-journal-members-leaf-end 0 fn2-journal-members) start))
       (records (if capture
                    (cons (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (bytes)
                           (fn2-pool-logical-octets size (+ (fn2-pool-base slot fn2-pool) start) fn2-pool) bytes)
                          records) records))
       ((mv code fn2-journal-members fn2-mk fn2-core)
        (if ready
            (stobj-let ((fn2-b3 (fn2-core-b3 fn2-core)) (fn2-digests (fn2-core-digests fn2-core))
                        (fn2-pool (fn2-core-pool fn2-core)))
             (code fn2-journal-members fn2-mk fn2-b3 fn2-digests)
             (fn2-event-member-hash-step row leaf fn2-journal-members fn2-mk fn2-b3 fn2-digests fn2-pool)
             (mv code fn2-journal-members fn2-mk fn2-core))
          (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
           (code fn2-journal-members fn2-fields)
           (fn2-journal-members-step 256 fn2-journal-members fn2-fields fn2-pool)
           (mv code fn2-journal-members fn2-mk fn2-core))))
       ((unless (member-eq code '(:more :leaf :appended)))
        (mv code (reverse records) fn2-journal-members fn2-mk fn2-core)))
   (fn2-efu-drive (- fuel 1) row leaf records fn2-journal-members fn2-mk fn2-core))))

(defun fn2-efu-body (wrong-count fn2-journal-members fn2-mk fn2-core)
 (declare (xargs :stobjs (fn2-journal-members fn2-mk fn2-core) :verify-guards nil))
 (b* (((mv produced fn2-journal-members fn2-core) (fn2-jmu-body nil fn2-journal-members fn2-core))
      (slot (fn2-journal-members-slot 0 fn2-journal-members))
      (gen (fn2-journal-members-gen 0 fn2-journal-members))
      (okind (fn2-journal-members-owner-kind 0 fn2-journal-members))
      (oslot (fn2-journal-members-owner-slot 0 fn2-journal-members))
      (ogen (fn2-journal-members-owner-gen 0 fn2-journal-members))
      ((mv code off end fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
        (code off end fn2-fields)
        (b* (((mv code off fn2-fields)
              (fn2-format-frame-header-decode 256 slot gen 0 4096 okind oslot ogen fn2-fields fn2-pool)))
         (mv code off (+ off (fn2-fields-value (+ 256 *fn2-format-frame-header-field-payload-length*) fn2-fields)) fn2-fields))
        (mv code off end fn2-core)))
      (rows (stobj-let ((fn2-b3 (fn2-core-b3 fn2-core))) (rows) (fn2-b3-rows fn2-b3) rows))
      (leaf (stobj-let ((fn2-digests (fn2-core-digests fn2-core))) (leaf) (- (fn2-digests-rows fn2-digests) 2) leaf))
      (fn2-mk (fn2-mk-table-init rows fn2-mk))
      (fn2-mk (fn2-mk-init 2 fn2-mk))
      (fn2-mk (if wrong-count (fn2-mk-set-size 2 1 fn2-mk) fn2-mk))
      ((mv begun fn2-journal-members) (fn2-journal-members-begin 1 2 off end slot gen okind oslot ogen fn2-journal-members))
      ((mv result records fn2-journal-members fn2-mk fn2-core)
       (fn2-efu-drive 100 2 leaf nil fn2-journal-members fn2-mk fn2-core))
      ((when wrong-count)
       (mv (and produced (eq code :ok) (eq begun :ok) (eq result :state)
                (= (fn2-mk-size 2 fn2-mk) 1) (= (fn2-journal-members-next-event 0 fn2-journal-members) 1))
           fn2-journal-members fn2-mk fn2-core))
      ((mv root fn2-core)
       (stobj-let ((fn2-digests (fn2-core-digests fn2-core))) (root fn2-digests)
        (let ((fn2-digests (fn2-mk-root (+ leaf 1) 2 fn2-digests fn2-mk)))
         (mv (fn2-digest-list (+ leaf 1) fn2-digests) fn2-digests)) (mv root fn2-core))))
  (mv (and produced (eq code :ok) (eq begun :ok) (eq result :done)
           (= (len records) 2) (= (fn2-mk-size 2 fn2-mk) 2)
           (equal root (fn-b3-words 8 (fn2-mk-mth records))))
      fn2-journal-members fn2-mk fn2-core)))
(defun fn2-efu-test (wrong-count)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-journal-members
  (mv-let (answer fn2-journal-members)
   (with-local-stobj fn2-mk
    (mv-let (answer fn2-journal-members fn2-mk)
     (with-local-stobj fn2-core
      (mv-let (answer fn2-journal-members fn2-mk fn2-core)
       (fn2-efu-body wrong-count fn2-journal-members fn2-mk fn2-core)
       (mv answer fn2-journal-members fn2-mk))) (mv answer fn2-journal-members))) answer)))
(assert-event (fn2-efu-test nil))
(assert-event (fn2-efu-test t))

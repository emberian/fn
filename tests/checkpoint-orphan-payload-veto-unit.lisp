; Typed mixed-state hardening, not a demonstrated reachable upload bug.
; The payload-use fact is an explicit synthetic authenticated-verifier result.
; Actual positive metadata journal/fence controls live in the included unit.
(in-package "ACL2")
(include-book "checkpoint-owned-retirement-unit")
(include-book "core-snapshot-support")
(defun fn2-copv-setup (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
             (fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core))
             (fn2-checkpoint-payload-proofs (fn2-core-checkpoint-payload-proofs fn2-core)))
  (setup e ep al fn2-extents fn2-checkpoint-construction fn2-checkpoint-payload-proofs)
  (b* (((mv begun fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
       ((mv reserved & e ep al fn2-extents) (fn2-alloc-reserve fn2-extents))
       ((mv committed fn2-extents) (fn2-alloc-commit-allocation e ep al *fn2-checkpoint-master-kind* 17 fn2-extents))
       (fn2-checkpoint-construction (fn2-checkpoint-construction-put e
        (live 1) (role *fn2-checkpoint-owned-restored-role*) (epoch ep) (counter al)))
       (fn2-checkpoint-payload-proofs (fn2-checkpoint-payload-proofs-put e
        (serial 1) (token 41) (schema 2) (origin 0) (unit (* e *fn2-storage-extent-units*))
        (epoch ep) (allocation al) (roles (ash 1 *fn2-checkpoint-restore-reach-role-payload-raw*))
        (allocation-owner-kind *fn2-checkpoint-master-kind*) (allocation-owner 17))))
   (mv (and (eq begun :ok) (eq reserved :ok) (eq committed :ok)) e ep al
       fn2-extents fn2-checkpoint-construction fn2-checkpoint-payload-proofs))
  (mv setup e ep al fn2-core)))
(defun fn2-copv-scan (e fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core))
             (fn2-checkpoint-build (fn2-core-checkpoint-build fn2-core))
             (fn2-csnapshot (fn2-core-csnapshot fn2-core)) (fn2-extents (fn2-core-extents fn2-core))
             (fn2-checkpoint-payload-proofs (fn2-core-checkpoint-payload-proofs fn2-core))
             (fn2-checkpoint-bank-closures (fn2-core-checkpoint-bank-closures fn2-core))
             (fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core))) (code next ep al)
  (fn2-checkpoint-owned-retirement-scan *fn2-checkpoint-master-kind* e fn2-checkpoint-construction
   fn2-checkpoint-build fn2-csnapshot fn2-extents fn2-checkpoint-payload-proofs fn2-checkpoint-bank-closures fn2-checkpoint-publication)
  (mv code next ep al)))
(defun fn2-copv-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init (fn2-b-test-profile *fn2-profile-tiny* 0) fn2-core))
      (id (fn2-machine-kind-base *fn2-checkpoint-master-kind* fn2-core))
      (ogen (fn2-machine-generation id fn2-core))
      ((mv setup e ep al fn2-core) (fn2-copv-setup fn2-core))
      (fn2-core (fn2-machine-write-phase id *fn2-checkpoint-master-state-teardown-owned-submit* fn2-core))
      (fn2-core (fn2-machine-write-scan id e fn2-core))
      (fn2-core (fn2-machine-write-teardown-extent id e fn2-core))
      (fn2-core (fn2-machine-write-teardown-epoch id ep fn2-core))
      (fn2-core (fn2-machine-write-teardown-allocation id al fn2-core))
      (whole-antecedent (and setup (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
        (fn2-checkpoint-owned-retirement-actor-p id ogen *fn2-checkpoint-master-state-teardown-owned-submit* fn2-core)
        (fn2-checkpoint-owned-retirement-payload-p id fn2-core)))
      (before (fn2-test-core-snapshot fn2-core))
      ((mv scan next & &) (fn2-copv-scan e fn2-core))
      ((mv refused outcome batch event fn2-core) (fn2-checkpoint-owned-retirement-submit-op id ogen fn2-core))
      (frame (equal before (fn2-test-core-snapshot fn2-core)))
      ; Hypothesis-removal witness: change only the positive use fact. The
      ; SAME actual scan/submit now admits ordinary metadata retirement.
      (fn2-core (stobj-let ((fn2-checkpoint-payload-proofs (fn2-core-checkpoint-payload-proofs fn2-core)))
                  (fn2-checkpoint-payload-proofs)
                  (fn2-checkpoint-payload-proofs-set-serial e 0 fn2-checkpoint-payload-proofs) fn2-core))
      (typed-after (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core)))
      ((mv eligible same pep pal) (fn2-copv-scan e fn2-core))
      ((mv accepted submitted b ev fn2-core) (fn2-checkpoint-owned-retirement-submit-op id ogen fn2-core)))
  (mv (and whole-antecedent frame (eq scan :more) (= next (+ e 1))
           (eq refused :retained) (eq outcome :retained) (= batch 0) (= event 0)
           typed-after (eq eligible :eligible) (= same e) (= pep ep) (= pal al)
           (eq accepted :ok) (eq submitted :ok) (posp b) (posp ev)) fn2-core)))
(defun fn2-copv-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (answer fn2-core) (fn2-copv-body fn2-core) answer)))
(assert-event (fn2-copv-test))

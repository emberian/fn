;;; Actual service functions with recording core/publication, exercising a
;;; family needing three quanta. Before S026 this finished in its first call
;;; and did the whole sweep again inside the kind-5 receive callback.
(require :sb-posix)
(require :sb-bsd-sockets)
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")

;;; ---- derived stubs: BEGIN (python3 tools/harness_check.py --write-stubs; do not edit) ----
(define-condition harness-stub-reached (serious-condition)
  ((name :initarg :name :reader harness-stub-reached-name)
   (source :initarg :source :reader harness-stub-reached-source))
  (:report (lambda (c s)
             (format s "harness: host function ~(~a~) (~a) was reached; this harness neither stubs nor extracts it"
                     (harness-stub-reached-name c) (harness-stub-reached-source c)))))
(defun harness-stub-reached (name source)
  (format *error-output* "harness: host function ~(~a~) (~a) was reached; this harness neither stubs nor extracts it~%"
          name source)
  (finish-output *error-output*)
  (error 'harness-stub-reached :name name :source source))
(defun fnn-bps-settle-conflict (service effect)
  (declare (ignorable service effect))
  (harness-stub-reached 'fnn-bps-settle-conflict "host/native/bp-service.lisp"))
;;; ---- derived stubs: END ----
(defvar *steps* 0)
(defvar *starts* 0)
(defvar *proposals* nil)
(defvar *effects* nil)
(defvar *callback* nil)
(defvar *stale* nil)
(defstruct fnn-bp-tally wall wall-error config)
(defun fnn-bp-observation (a b) (list a b))
(defun fnn-core (name &rest args)
 (case name
  (fn-bpfj-next-candidate (unless (member :family (third args)) '(:ready 7 :family)))
  (fn-bpnf-held-list :held)
  (fn-bpnf-find-arrival :anchor)
  (fn-bpfj-start (incf *starts*) 0)
  (fn-bpnpf-held-octets 100000)
  (fn-bpfj-step (assert (not *callback*)) (assert (= (second args) 4096))
                 (incf *steps*) (1+ (first args)))
  (fn-bpfj-finishedp (= (first args) 3))
  (fn-bpnpf-admitted-receive-event :ready)
  (fn-bpnf-receive-wire-readyp t)
  (fn-bpnf-receive-wire-event-value '(:receive :bundle :wire :ingress))
  (fn-bpb-payload '(1 2))
  (fn-bpnf-callback-result '(:accepted :path))
  (otherwise (error "unexpected core ~s" name))))
(defun fnn-bps-foundation-step (service event)
 (declare (ignore service))
 (case (first event)
  (:family (push event *proposals*) (unless *stale* '((:family-proposed))))
  (:receive '((:persist 2 3 :held)))
  (:persist-result '((:receive-answer :accepted)))
  (otherwise (error "unexpected event ~s" event))))
(defun fnn-bps-drive-effects (service effects)
 (declare (ignore service)) (setq *effects* effects))
(defun fnn-bps-persist-kind-five (&rest x) (declare (ignore x)) (values :durable :path))
(defun fnn-bps-note (&rest x) (declare (ignore x)))
(defun fnn-indeterminate (&rest x) (error "uncertain ~s" x))
(defun load-shipped (path names)
 (with-open-file (stream path)
  (dolist (name names)
   (file-position stream 0)
   (loop for form = (read stream nil :eof)
         when (eq form :eof) do (error "missing ~s" name)
         when (and (consp form) (member (car form) '(defun defstruct defconstant))
                   (eq (second form) name)) do (eval form) (return)))))
(load-shipped "host/native/bp-service.lisp"
 '(fnn-bps +fnn-bps-fragment-quantum+ fnn-bps-fragment-effects
   fnn-bps-fragment-progress fnn-bps-fragment-work-p fnn-bps-receive))
(let ((service (make-fnn-bps :tally (make-fnn-bp-tally) :state :state :profile :profile)))
 (dotimes (n 3)
  (fnn-bps-fragment-progress service)
  (assert (= *steps* (1+ n)))
  (assert (= *starts* 1))
  (if (< n 2)
   (progn (assert (null *proposals*)) (assert (fnn-bps-fragment-pending service)))
   (progn (assert (= (length *proposals*) 1)) (assert (null (fnn-bps-fragment-pending service)))
    (assert (equal (fnn-bps-fragment-job service) '(3 . 100000))))))
 (fnn-bps-fragment-progress service)
 (assert (= *steps* 3))
 (let ((*callback* t))
  (multiple-value-bind (result adu) (fnn-bps-receive service :admission :wire)
   (assert (eq (first result) :accepted)) (assert (equal adu '(1 2)))))
 (assert (= *steps* 3))
 (assert (fnn-bps-fragment-rescan service))
 ;; A family changing during retained work is decided by the actual :family
 ;; model callback, never installed by the host. No proposal publication.
 (setq *stale* t *effects* nil)
 (dotimes (n 3) (fnn-bps-fragment-progress service))
 (assert (= *starts* 2)) (assert (null *effects*))
 (assert (null (fnn-bps-fragment-pending service)))
 (fnn-bps-fragment-progress service)
 (assert (not (fnn-bps-fragment-work-p service))))
(format t "PASS shipped BP reassembly: one quantum per turn, retained job, callback ACK independence, stale decision deferred to ACL2.~%")

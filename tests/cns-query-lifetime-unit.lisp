; Actual ACTIVE queries retain a real admitted CNS owner; DONE closes
; readers, wakes only its live incarnation, then public draining retries.
(in-package "ACL2")
(include-book "cns-query-support")

(defun fn2-cns-query-lifetime-run (source-name mode fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (b* ((profile (cond ((eq mode :trace-disabled)
                        (put-assoc-equal :trace nil *fn2-cns-drain-profile*))
                       ((eq mode :trace-lost)
                        (put-assoc-equal :trace-capacity 1 *fn2-cns-drain-profile*))
                       (t *fn2-cns-drain-profile*)))
       ((mv setup id sibling fn2-core) (fn2-cns-drain-setup-profile profile nil fn2-core))
       (stale (member-eq mode '(:stale-owner :stale-owner-mutant :free-owner :retired-owner)))
       (ogen (fn2-cns-row-generation id fn2-core))
       (ws (fn2-cns-row-ws-slot id fn2-core)) (wg (fn2-cns-row-ws-gen id fn2-core))
       (ns (fn2-cns-row-ns-slot id fn2-core)) (ng (fn2-cns-row-ns-gen id fn2-core))
       (source (if (eq source-name :name) ns ws))
       (gen (if (eq source-name :name) ng wg))
       ; Both query windows share only ONE source. The other range stays
       ; releasable, so a sequential release-then-check mutant is detected.
       ((mv wc0 fn2-core) (fn2-cns-query-write '(60 113 62) source gen 0 id ogen fn2-core))
       ((mv wc1 fn2-core) (fn2-cns-query-write (make-list 32 :initial-element 7)
                           source gen 3 id ogen fn2-core))
       (fn2-core (fn2-machine-set-wake-id *fn2-none* fn2-core))
       ((mv q0 fn2-core) (fn2-identity-decide-start 0 source gen 0 3 source gen 3
                          *fn2-cns-kind* id ogen fn2-core))
       ((mv q1 fn2-core) (fn2-identity-decide-start 1 source gen 0 3 source gen 3
                          *fn2-cns-kind* id ogen fn2-core))
       (before (fn2-test-core-snapshot fn2-core))
       (pool (fn2-cns-drain-child 'fn2-pool before))
       (whole-h (fn2-cns-query-whole-h-p id before fn2-core))
       (active (and setup (eq wc0 :ok) (eq wc1 :ok) (eq q0 :ok) (eq q1 :ok)
                    (not (equal id sibling))
                    (not (equal id (fn2-machine-slot id fn2-core)))
                    (fn2-core-query-references-accountedp fn2-core)
                    (equal (fn2-cns-drain-cell 'fn2-pool-query-ref-count source pool) 4)
                    (equal (fn2-cns-drain-cell 'fn2-pool-out-count source pool) 0)))
       ((mv b s d r fn2-core) (fn2-cns-run id 4 fn2-core))
       (held (fn2-test-core-snapshot fn2-core))
       (held-ok (and active whole-h (fn2-cns-draining-resultp id before b s d r held)
                     (equal (list b s d r held) (list 0 *fn2-work-state* 0 nil before))))
       ((when (eq mode :partial-release))
        (b* (((mv & fn2-core) (fn2-core-release ws wg *fn2-cns-kind* id ogen fn2-core))
             ((mv & fn2-core) (fn2-core-release ns ng *fn2-cns-kind* id ogen fn2-core))
             (changed (fn2-test-core-snapshot fn2-core)))
          (mv (and held-ok
                   (not (fn2-cns-draining-resultp id before 0 *fn2-work-state* 0 nil changed)))
              fn2-core)))
       (before-done0 (fn2-test-core-snapshot fn2-core))
       ((mv done0 fn2-core) (fn2-cns-query-drive 32 0 fn2-core))
       (after-done0 (fn2-test-core-snapshot fn2-core))
       (first-done (and (eq done0 :stored)
                       (fn2-cns-query-alias-done-framep 0 source before-done0 after-done0)
                       (fn2-core-query-references-accountedp fn2-core)))
       (h2 (fn2-cns-query-whole-h-p id after-done0 fn2-core))
       ((mv b2 s2 d2 r2 fn2-core) (fn2-cns-run id 4 fn2-core))
       (held2 (fn2-test-core-snapshot fn2-core))
       (still-held (and h2 (equal held2 after-done0)
                        (fn2-cns-draining-resultp id after-done0 b2 s2 d2 r2 held2)))
       ; Stale, free and retired owners are typed/WFP defensive inputs. They
       ; are deliberately
       ; not called a reachable initialized-state or old-domain witness.
       (fn2-core
        (cond ((eq mode :free-owner) (fn2-cns-put-core id (phase *fn2-cns-state-free*)))
              ((eq mode :retired-owner) (fn2-cns-put-core id (phase *fn2-cns-state-retired*)))
              (stale (fn2-cns-put-core id (generation (+ 1 ogen))))
              (t fn2-core)))
       (ordinary (if (eq mode :ordinary-same) id sibling))
       (fn2-core (fn2-machine-wake-row ordinary fn2-core))
       ; Real idempotent enqueue attempts fill a one-slot ring. Their
       ; diagnostic loss must not prevent the later query enqueue.
       (fn2-core
        (if (eq mode :trace-lost)
            (let* ((fn2-core (fn2-core-scheduler-wake id fn2-core))
                   (fn2-core (fn2-core-record-enqueue id fn2-core))
                   (fn2-core (fn2-core-scheduler-wake id fn2-core)))
              (fn2-core-record-enqueue id fn2-core)) fn2-core))
       (typed (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core)))
       (diagnostic-context
        (let ((trace (fn2-cns-drain-child 'fn2-trace (fn2-test-core-snapshot fn2-core))))
          (cond ((eq mode :trace-disabled)
                 (equal (fn2-cns-drain-get 'fn2-trace-enabled trace) 0))
                ((eq mode :trace-lost) (< 0 (fn2-cns-drain-get 'fn2-trace-lost trace)))
                (t t))))
       (before-done1 (fn2-test-core-snapshot fn2-core))
       ((mv done1 fn2-core) (fn2-cns-query-drive 32 1 fn2-core))
       (after-done1 (fn2-test-core-snapshot fn2-core))
       (dir (fn2-cns-drain-child 'fn2-machines after-done1))
       (last-done (and typed diagnostic-context (eq done1 :stored)
                      (fn2-cns-query-alias-done-framep 1 source before-done1 after-done1)
                      (fn2-core-query-references-accountedp fn2-core)
                      (equal (fn2-cns-drain-get 'fn2-machines-wake-id dir)
                             ordinary)))
       ((when stale)
        (let* ((fn2-core (if (eq mode :stale-owner-mutant)
                            (fn2-core-record-enqueue id (fn2-core-scheduler-wake id fn2-core)) fn2-core))
               (changed (fn2-test-core-snapshot fn2-core)))
          (mv (and held-ok first-done still-held last-done
                   (if (eq mode :stale-owner-mutant)
                       (not (fn2-cns-query-alias-done-framep 1 source before-done1 changed))
                     (equal changed after-done1))) fn2-core)))
       ; The earlier ordinary intent is still present. Consume it using
       ; the same concrete enqueue seam, then pop the query owner's FIFO.
       ((mv ordinary-id fn2-core) (fn2-machine-take-wake fn2-core))
       (before-ordinary (fn2-test-core-snapshot fn2-core))
       (fn2-core (fn2-core-scheduler-wake ordinary-id fn2-core))
       (fn2-core (fn2-core-record-enqueue ordinary-id fn2-core))
       (after-ordinary (fn2-test-core-snapshot fn2-core))
       (dir-now (fn2-cns-drain-child 'fn2-machines after-ordinary))
       (own-now (fn2-cns-drain-child 'fn2-cns after-ordinary))
       (principal (fn2-cns-drain-cell 'fn2-cns-principal-slot
                    (fn2-cns-drain-cell 'fn2-machines-slot id dir-now) own-now))
       (sched-now (fn2-cns-drain-child 'fn2-sched after-ordinary))
       (both-intents
        (and (equal ordinary-id ordinary)
             (equal after-ordinary (fn2-cns-query-enqueue-core-expected ordinary before-ordinary))
             (equal (fn2-cns-query-fifo (fn2-cns-drain-get 'fn2-sched-rows sched-now)
                      (fn2-cns-drain-cell 'fn2-sched-heads principal sched-now) sched-now)
                    (if (equal ordinary id) (list id) (list id sibling)))))
       ((mv pop-code retry-id fn2-core) (fn2-cns-query-pop principal fn2-core))
       (before-retry (fn2-test-core-snapshot fn2-core))
       (final-h (fn2-cns-query-whole-h-p id before-retry fn2-core))
       (zero-query (fn2-cns-draining-query-clear-p id before-retry))
       ((mv fb fs fd fr fn2-core) (fn2-cns-run retry-id 4 fn2-core))
       (after-free (fn2-test-core-snapshot fn2-core))
       (final (and both-intents (eq pop-code :ok) (equal retry-id id) final-h zero-query
                   (fn2-cns-draining-resultp id before-retry fb fs fd fr after-free)
                   (equal (list fb fs fd fr after-free)
                          (fn2-cns-draining-zero-query-expected id before-retry))
                   (equal (fn2-cns-row-phase id fn2-core) *fn2-cns-state-free*)
                   (fn2-core-query-references-accountedp fn2-core)))
       ((mv facts verdict selection h evidence coverage) (fn2-identity-facts 1 fn2-core))
       (before-repeat (fn2-test-core-snapshot fn2-core))
       ((mv repeat fn2-core) (fn2-identity-decide 1 4096 fn2-core))
       (after-repeat (fn2-test-core-snapshot fn2-core)))
    (mv (and held-ok first-done still-held last-done final
             (equal (list facts verdict selection h evidence coverage)
                    '(:ok :stored :none 0 :none :complete))
             (eq repeat :stored) (equal before-repeat after-repeat)) fn2-core)))
(defun fn2-cns-query-lifetime-control (source-name mode)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (yes fn2-core) (fn2-cns-query-lifetime-run source-name mode fn2-core) yes)))
(defun fn2-cns-drain-query-held-positive ()
  (declare (xargs :verify-guards nil))
  (and (fn2-cns-query-lifetime-control :workspace :complete)
       (fn2-cns-query-lifetime-control :name :complete)
       (fn2-cns-query-lifetime-control :name :ordinary-same)
       (fn2-cns-query-lifetime-control :name :trace-disabled)
       (fn2-cns-query-lifetime-control :name :trace-lost)))
(defun fn2-cns-drain-query-stale-owner ()
  (declare (xargs :verify-guards nil))
  (and (fn2-cns-query-lifetime-control :name :stale-owner)
       (fn2-cns-query-lifetime-control :name :free-owner)
       (fn2-cns-query-lifetime-control :name :retired-owner)
       (fn2-cns-query-lifetime-control :name :stale-owner-mutant)))
(defun fn2-cns-drain-query-partial-release-mutant ()
  (declare (xargs :verify-guards nil))
  (and (fn2-cns-query-lifetime-control :workspace :partial-release)
       (fn2-cns-query-lifetime-control :name :partial-release)))
(assert-event (and (fn2-cns-drain-query-held-positive)
                   (fn2-cns-drain-query-stale-owner)
                   (fn2-cns-drain-query-partial-release-mutant)))

(fn2-assert-owed-teeth fn2-cns-draining-counted-independent)

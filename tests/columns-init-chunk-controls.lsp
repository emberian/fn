(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun nfix (x) (if (and (integerp x) (<= 0 x)) x 0))
(defun len (x) (length x))
(defun take (n xs) (subseq xs 0 n))
(defun explode-nonnegative-integer (x radix tail) (declare (ignore radix)) (append (coerce (format nil "~D" x) 'list) tail))
(defun intern-in-package-of-symbol (x sym) (intern x (symbol-package sym)))
(with-open-file (in "books/columns.lisp")
 (loop for f = (read in nil :eof) until (eq f :eof) do
  (when (and (eq (car f) 'defun) (member (cadr f)
   '(fn2-columns-sym fn2-columns-pre fn2-columns-col-name fn2-columns-resize-bindings
     fn2-columns-init-chunk-name fn2-columns-init-chunk-names fn2-columns-init-chunk-events fn2-columns-init-chunk-bindings))) (eval f))))
(defun chunk-check (count)
 (let* ((cols (loop for i below count collect (list (intern (format nil "F~D" i)) :u8)))
        (events (fn2-columns-init-chunk-events 'table 'table-init cols 4294967296 0))
        (names (fn2-columns-init-chunk-names 'table-init cols 0))
        (bindings (fn2-columns-init-chunk-bindings 'table names))
        (flat (loop for e in events append (cadr (fifth e)))))
  (assert (= (length events) (ceiling count 8)))
  (assert (equal (mapcar #'cadr events) names))
  (assert (equal flat (fn2-columns-resize-bindings 'table cols)))
  (assert (= (length flat) (* 2 count)))
  (loop for e in events for b in bindings do
   (assert (equal (third e) '(n table)))
   (assert (equal (fourth e) '(declare (xargs :stobjs table :guard (and (natp n) (< n 4294967296))))))
   (assert (equal b `(table (,(cadr e) n table))))
   (assert (<= (length (cadr (fifth e))) 16))
   (assert (equal (third (fifth e)) 'table)))
  ; Zero-before-size is observable: this mutation must be rejected.
  (when flat (assert (not (equal (reverse flat) flat))))))
(dolist (n '(0 1 7 8 9 16 17 65 70)) (chunk-check n))
(format t "INIT CHUNK CONTROLS PASS: exact bindings/order/guards,9 boundary sizes,zero-before-size.~%")

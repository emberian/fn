; Boundary fixture only: actual writer encoder -> generated decoder/zero-tail.
; The separate event-read-verified-unit exercises full physical authentication.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/event-read-verify")
(include-book "../books/commit-format")
(include-book "../books/runs-page")
(defun fn2-ess-body (fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init *fn2-format-sealed-batch-num-fields* fn2-fields))
      (fn2-pool (fn2-pool-init '((2 . 4096)) 1 100 fn2-pool))
      ((mv a slot gen fn2-pool) (fn2-pool-reserve 0 7 0 1 fn2-pool))
      ((mv b scratch sg fn2-pool) (fn2-pool-reserve 0 7 0 1 fn2-pool))
      ((mv zero fn2-pool) (fn2-run-zero 4096 slot gen 0 7 0 1 fn2-pool))
      ((mv szero fn2-pool) (fn2-run-zero 128 scratch sg 0 7 0 1 fn2-pool))
      (off *fn2-format-frame-header-max-size*)
      ((mv packed end fn2-fields fn2-pool)
       (fn2-commit-pack :seal 2 0 slot gen off scratch sg 1 2 3 1 1 1
        7 0 1 1 2 3 4 5 fn2-fields fn2-pool))
      ((mv valid length fn2-fields)
       (fn2-event-read-seal-span 0 slot gen off 3900 7 0 1 fn2-fields fn2-pool))
      ((mv malformed mlen fn2-fields)
       (fn2-event-read-seal-span 0 slot gen off 1 7 0 1 fn2-fields fn2-pool))
      ((mv written fn2-pool) (fn2-pool-write slot gen end 1 7 0 1 fn2-pool))
      ((mv padding plen fn2-fields)
       (fn2-event-read-seal-span 0 slot gen off 3900 7 0 1 fn2-fields fn2-pool)))
  (mv (and (eq a :ok) (eq b :ok) (eq zero :ok) (eq szero :ok) (eq packed :ok)
           (eq valid :ok) (posp length) (equal length (- end off))
           (<= length *fn2-format-sealed-batch-max-size*) (< length 3900)
           (eq malformed :format) (equal mlen 0) (eq written :ok)
           (eq padding :padding) (equal plen 0)) fn2-fields fn2-pool)))
(defun fn2-ess-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (answer fn2-fields)
   (with-local-stobj fn2-pool
    (mv-let (answer fn2-fields fn2-pool) (fn2-ess-body fn2-fields fn2-pool)
     (mv answer fn2-fields))) answer)))
(assert-event (fn2-ess-test))

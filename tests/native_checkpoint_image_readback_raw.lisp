;;; Actual staging/readback/install and private snapshot custody. Kernel files
;;; and page codec are real; framed-run admission and snapshot storage record
;;; their boundaries. This is not a saved-image or page-store refinement claim.
(load "tests/native_section_envelope_raw.lisp")
(in-package "ACL2")

(defun natp (x) (and (integerp x) (<= 0 x)))
(defun zp (x) (not (and (integerp x) (> x 0))))
(defun nfix (x) (if (natp x) x 0))
(defun ifix (x) (if (integerp x) x 0))
(defun len (x) (length x))
(defmacro mbe (&key logic exec) (declare (ignore logic)) exec)
(defun take (n x) (loop for i below n collect (nth i x)))
(defvar *fnn-checkpoint-image-custody* nil)
(defvar *fnn-checkpoint-stop-test* nil)
(defparameter *readback-new*
 (with-open-file (s "host/native/io.lisp")
  (loop for f = (read s nil :eof) until (eq f :eof)
   thereis (and (consp f) (eq (car f) 'defmacro) (eq (cadr f) 'fnn-with-history-image)))))
(unless *readback-new* (defmacro fnn-with-history-image (&body body) `(progn ,@body)))

; PREPARED, UNEXECUTED. Real post-Fence producer, actual CNS machine takes
; and canonical region/window constructors. These primitive reservations are
; test-only resource premises, not signed-client ancestry or served admission.
; No APPLIED/reopen/READY/free-count is seeded. The actual writer EXCLUSIVE
; receipt drives the full live row/operation scan while old cold room is false.
; Provider projection:42d9281ae catalog,0e18a52b0 cbase,5064aafc2 install;
; actual assemblyC invokes those same three event macros before core use.
(in-package "ACL2")
(include-book "checkpoint-live-publication-support")
(include-book "core-snapshot-support")
(include-book "../books/checkpoint-live-install")
(include-book "../books/run-physical-readiness-core")

(make-event
 (mv-let (err events) (fn2-run-loader-core-face-events
  '(fn2-checkpoint-live-catalog-begin-op fn2-checkpoint-live-catalog-step-op
    fn2-checkpoint-live-cbase-step-op fn2-checkpoint-live-replace-begin-op) (w state))
  (if err (er soft 'fn2-live-room-writer "~@0" err) (value (cons 'progn events)))))
; All mutable core children and backing arrays except the intended scan cursor.
(make-event
 (value `(defun fn2-lrw-preserved (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (list ,@(fn2-test-core-snapshot-calls
           (remove-assoc-eq 'fn2-core-run-load-readiness *fn2-core-children*))))))
(defun fn2-lrw-cold-room-p (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core)) (fn2-ops (fn2-core-ops fn2-core))) (room)
  (fn2-run-load-readiness-roomp fn2-pool fn2-ops) room))
(defun fn2-lrw-park (i b0 n0 b1 n1 b2 n2 kind owner generation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil
  :measure (nfix (- (fn2-run-load-region-count n0 n1 n2) (nfix i)))))
 (if (>= (nfix i) (fn2-run-load-region-count n0 n1 n2)) (mv :parked fn2-core)
  (b* ((c (fn2-run-load-region-cursor i b0 n0 b1 n1 b2 n2))
       ((mv code fn2-core)
        (stobj-let ((fn2-run-loads (fn2-core-run-loads fn2-core)) (fn2-run-cursors (fn2-core-run-cursors fn2-core))
                    (fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
                    (fn2-checkpoint-summary-leases (fn2-core-checkpoint-summary-leases fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
         (code fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases)
         (fn2-run-load-park-source c kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
         (mv code fn2-core)))
       ((unless (and (eq code :ok) (fn2-run-load-parked-machine-current-p c fn2-core))) (mv :park fn2-core)))
   (fn2-lrw-park (+ 1 (nfix i)) b0 n0 b1 n1 b2 n2 kind owner generation fn2-core))))
; Always acquire and park at least one real job set even if protected
; credit headroom already makes new-request room false. At most the actual
; admitted CNS population; each iteration reserves its real
; plan's complete class recipe, never edits pool counters or waits partially.
(defun fn2-lrw-pressure (remaining started fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix remaining)))
 (cond ((and started (not (fn2-lrw-cold-room-p fn2-core))) (mv :pressured 0 fn2-core))
       ((zp remaining) (mv :population 0 fn2-core))
       (t
        (b* (((mv taken owner generation fn2-core)
              (fn2-machine-take-fn2-cns *fn2-none* *fn2-none* 0 1 0 0 4 *fn2-none* 0 fn2-core))
             ((unless (eq taken :ok)) (mv taken 0 fn2-core))
             ((mv planned kind b0 n0 b1 n1 b2 n2) (fn2-c-actor-loader-plan owner generation fn2-core))
             ((unless (and (eq planned :ok) (equal kind *fn2-cns-kind*))) (mv :plan 0 fn2-core))
             ((mv reserved complete fn2-core)
              (stobj-let ((fn2-run-loads (fn2-core-run-loads fn2-core)) (fn2-run-cursors (fn2-core-run-cursors fn2-core))
                          (fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
                          (fn2-checkpoint-summary-leases (fn2-core-checkpoint-summary-leases fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
               (code complete fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
               (fn2-run-load-region-reserve b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
               (mv code complete fn2-core)))
             ((unless (and (eq reserved :ok) (equal complete 1))) (mv :reservation 0 fn2-core))
             ((mv parked fn2-core) (fn2-lrw-park 0 b0 n0 b1 n1 b2 n2 kind owner generation fn2-core))
             ((unless (eq parked :parked)) (mv parked 0 fn2-core))
             ((mv code count fn2-core) (fn2-lrw-pressure (1- remaining) t fn2-core)))
         (mv code (+ 1 count) fn2-core)))))
(defun fn2-lrw-source-stage (hold fuel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (b* (((mv code fn2-core) (if hold (fn2-checkpoint-live-cbase-step-op fn2-core)
                            (fn2-checkpoint-live-catalog-step-op fn2-core))))
   (if (eq code :more) (fn2-lrw-source-stage hold (1- fuel) fn2-core) (mv code fn2-core)))))
(defun fn2-lrw-scan (fuel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel 0 fn2-core)
  (b* (((mv code fn2-core) (fn2-run-load-readiness-owned-step 1 fn2-core)))
   (if (eq code :more)
    (mv-let (code count fn2-core) (fn2-lrw-scan (1- fuel) fn2-core) (mv code (+ 1 count) fn2-core))
    (mv code 1 fn2-core)))))
(defun fn2-lrw-complete-current-p (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
             (fn2-c-source-control (fn2-core-c-source-control fn2-core))
             (fn2-run-load-readiness (fn2-core-run-load-readiness fn2-core))
             (fn2-run-load-geometry (fn2-core-run-load-geometry fn2-core))
             (fn2-id-decides (fn2-core-id-decides fn2-core)) (fn2-reads (fn2-core-reads fn2-core))
             (fn2-run-loads (fn2-core-run-loads fn2-core)) (fn2-run-cursors (fn2-core-run-cursors fn2-core))
             (fn2-checkpoint-summary-leases (fn2-core-checkpoint-summary-leases fn2-core))
             (fn2-run-load-ops (fn2-core-run-load-ops fn2-core)) (fn2-ops (fn2-core-ops fn2-core))
             (fn2-fc (fn2-core-fc fn2-core)) (fn2-fc-context (fn2-core-fc-context fn2-core))
             (fn2-b3 (fn2-core-b3 fn2-core)) (fn2-fields (fn2-core-fields fn2-core))
             (fn2-digests (fn2-core-digests fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (complete)
  (fn2-run-load-readiness-live-complete-current-p fn2-checkpoint-summary fn2-c-source-control fn2-run-load-readiness
   fn2-run-load-geometry fn2-id-decides fn2-reads fn2-run-loads fn2-run-cursors fn2-checkpoint-summary-leases
   fn2-run-load-ops fn2-ops fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-digests fn2-pool) complete))
(defun fn2-run-physical-live-room-writer-unit-body (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((mv produced fn2-core fn2-sim fn2-own) (fn2-clc-produce-held fn2-core fn2-sim fn2-own))
      ((unless (and (eq produced :held) (fn2-core-wfp fn2-core) (fn2-clc-published-held-p fn2-core)
                    (fn2-clc-full-live-source-p fn2-core)))
       (mv nil fn2-core fn2-sim fn2-own))
      (population (fn2-machine-connection-count *fn2-cns-admission-ordinal* fn2-core))
      ((mv pressured actors fn2-core) (fn2-lrw-pressure population nil fn2-core))
      ((unless (and (eq pressured :pressured) (posp actors) (<= actors population)
                    (not (fn2-lrw-cold-room-p fn2-core)))) (mv nil fn2-core fn2-sim fn2-own))
      ((mv begun fn2-core) (fn2-checkpoint-live-catalog-begin-op fn2-core))
      ((mv captured fn2-core) (fn2-lrw-source-stage nil 100000 fn2-core))
      ((mv held fn2-core) (fn2-lrw-source-stage t 100000 fn2-core))
      ((mv exclusive fn2-core) (fn2-checkpoint-live-replace-begin-op fn2-core))
      ((unless (and (eq begun :more) (eq captured :captured) (eq held :held) (eq exclusive :more)))
       (mv nil fn2-core fn2-sim fn2-own))
      (before (fn2-lrw-preserved fn2-core))
      ((mv ready-begin fn2-core) (fn2-run-load-readiness-live-begin-op fn2-core))
      (rows (stobj-let ((fn2-run-loads (fn2-core-run-loads fn2-core))
                        (fn2-run-load-ops (fn2-core-run-load-ops fn2-core))) (rows)
       (+ (fn2-run-loads-rows fn2-run-loads) (fn2-run-load-ops-rows fn2-run-load-ops)) rows))
      ((mv scanned steps fn2-core) (fn2-lrw-scan (+ rows 3) fn2-core))
      (actual-end (stobj-let ((fn2-run-load-readiness (fn2-core-run-load-readiness fn2-core))
                             (fn2-run-loads (fn2-core-run-loads fn2-core))
                             (fn2-run-load-ops (fn2-core-run-load-ops fn2-core))) (end)
       (and (equal (fn2-run-load-readiness-cursor-end 0 fn2-run-load-readiness) (fn2-run-loads-rows fn2-run-loads))
            (equal (fn2-run-load-readiness-row 0 fn2-run-load-readiness) (fn2-run-load-ops-rows fn2-run-load-ops))) end)))
  (mv (and (eq ready-begin :more) (eq scanned :complete) (equal steps (+ rows 2)) actual-end
       (fn2-lrw-complete-current-p fn2-core) (not (fn2-lrw-cold-room-p fn2-core))
       (equal before (fn2-lrw-preserved fn2-core)) (not (fn2-core-stopped-p fn2-core))) fn2-core fn2-sim fn2-own)))
(assert-event
 (with-local-stobj fn2-core (with-local-stobj fn2-sim (with-local-stobj fn2-own
  (mv-let (good fn2-core fn2-sim fn2-own) (fn2-run-physical-live-room-writer-unit-body fn2-core fn2-sim fn2-own) good)))))

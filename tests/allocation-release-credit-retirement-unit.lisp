; Actual outgoing-workspace cleanup at the supported pool generation limit.
; PERSISTED, successful notification and accepted settlement are explicit
; synthetic authorization premises, not a disk/E3/publication witness. Actual
; credit acquisition, B member/settled ownership, poll and retirement run here.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "retirement-publish-core-unit")
(include-book "checkpoint-working-credit-configure-unit")
(include-book "pool-credit-unit")
(defun fn2-arcr-pool (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (view) (fn2-pcu-view fn2-pool) view))
(defun fn2-arcr-body (persisted fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (fn2-b-test-profile (put-assoc-equal :generation-limit 1 *fn2-profile-tiny*) 0))
      (fn2-core (fn2-core-init profile fn2-core))
      ((mv configured fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (ok fn2-pool)
        (fn2-cwc-body-with-limit 1 fn2-pool) (mv ok fn2-core)))
      ((mv epoch fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      (kind *fn2-scribe-kind*) (owner (fn2-machine-kind-base kind fn2-core))
      (generation (fn2-machine-generation owner fn2-core))
      ((mv info group class) (fn2-release-live-credit-info fn2-core))
      ((unless (and configured (eq epoch :ok) (eq info :ok))) (mv nil fn2-core))
      ((mv begun fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
        (fn2-pool-credit-begin group *fn2-pool-credit-working* 1 kind owner generation fn2-pool) (mv code fn2-core)))
      ((mv acquired slot gen fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code slot gen fn2-pool)
        (fn2-pool-reserve-credit group 1 class kind owner generation fn2-pool) (mv code slot gen fn2-core)))
      ((unless (and (eq begun :ok) (eq acquired :ok) (= gen 1))) (mv nil fn2-core))
      (fn2-core
       (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))) (fn2-allocation-release)
        (fn2-allocation-release-put 0 (phase *fn2-allocation-release-phase-staged*)
         (owner-kind kind) (owner-slot owner) (owner-gen generation) (slot slot) (gen gen)) fn2-core))
      ((unless persisted)
       (b* (((mv returned fn2-core) (fn2-release-live-return-empty group 1 slot gen kind owner generation fn2-core))
            (before (fn2-arcr-pool fn2-core))
            ((mv retry fn2-core)
             (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
              (fn2-pool-credit-begin group *fn2-pool-credit-working* 1 kind owner generation fn2-pool) (mv code fn2-core)))
            (depleted (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (yes)
                        (and (= (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-depleted*)
                             (= (fn2-pool-state slot fn2-pool) *fn2-pool-state-retired*)) yes)))
        (mv (and (eq returned :retired) (eq retry :owner) depleted
                 (equal before (fn2-arcr-pool fn2-core)) (not (fn2-core-stopped-p fn2-core))) fn2-core)))
      ((mv ended fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
        (fn2-pool-credit-end group 1 kind owner generation fn2-pool) (mv code fn2-core)))
      (writer (fn2-machine-kind-base *fn2-commit-kind* fn2-core))
      ((mv started fn2-core) (fn2-commit-start writer 1 1 0 (+ 1 writer) fn2-core))
      ((mv member fn2-core)
       (fn2-commit-put-txn-member (fn2-commit-row writer fn2-core) 0 slot gen 1 kind owner generation 1 fn2-core))
      ((unless (and (eq ended :ok) (eq started :ok) (eq member :ok))) (mv nil fn2-core))
      ; SYNTHETIC persisted/publication/last-reader premises. This does not
      ; execute IO or establish the source-specific E3 dispatch antecedent.
      (fn2-core (fn2-commit-put-core writer (phase *fn2-commit-state-notify*)
                  (cb-published 1) (cb-acks 1) (cb-deps-ok 1) (cb-log-ok 1) (cb-fence-ok 1)))
      (writer-gen (fn2-machine-generation writer fn2-core))
      (fn2-core
       (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))) (fn2-allocation-release)
        (fn2-allocation-release-put 0 (phase *fn2-allocation-release-phase-persisted*)
         (batch 1) (event 1) (writer-slot writer) (writer-gen writer-gen)
         (member-length 1) (evidence-owned 1) (workspace-released 0)) fn2-core))
      (fn2-core (fn2-commit-settle-member writer 0 *fn2-commit-outcome-accepted* 1 fn2-core))
      ((mv polled batch event fn2-core) (fn2-allocation-release-poll kind owner generation fn2-core))
      (released (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))
                            (fn2-pool (fn2-core-pool fn2-core))) (yes)
                  (and (= (fn2-allocation-release-phase 0 fn2-allocation-release) *fn2-allocation-release-phase-persisted*)
                       (= (fn2-allocation-release-workspace-released 0 fn2-allocation-release) 1)
                       (= (fn2-allocation-release-slot 0 fn2-allocation-release) slot)
                       (= (fn2-allocation-release-gen 0 fn2-allocation-release) gen)
                       (= (fn2-allocation-release-evidence-owned 0 fn2-allocation-release) 1)
                       (= (fn2-pool-state slot fn2-pool) *fn2-pool-state-retired*)
                       (= (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-depleted*)) yes))
      (before (fn2-arcr-pool fn2-core))
      ((mv repeated same-batch same-event fn2-core) (fn2-allocation-release-poll kind owner generation fn2-core)))
  (mv (and (eq polled :persisted) (= batch 1) (= event 1) released
           (eq repeated :persisted) (= same-batch batch) (= same-event event)
           (equal before (fn2-arcr-pool fn2-core)) (not (fn2-core-stopped-p fn2-core))) fn2-core)))
(defun fn2-arcr-run (persisted)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-arcr-body persisted fn2-core) ok)))
(assert-event (fn2-arcr-run nil))
(assert-event (fn2-arcr-run t))

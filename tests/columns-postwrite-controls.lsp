; Source controls execute the shared selector, not an alternative lowering.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defmacro mv (&rest xs) `(values ,@xs))
(defmacro mv-let (vars expr &body body) `(multiple-value-bind ,vars ,expr ,@body))
(defmacro mutual-recursion (&body forms) `(progn ,@forms))
(defmacro er (mode context message &rest args)
 (declare (ignore mode)) `(error "~S ~S ~S" ',context ,message (list ,@args)))
(defun all-fnnames (term)
 (cond ((atom term) nil) ((eq (car term) 'quote) nil)
       (t (union (if (symbolp (car term)) (list (car term))
                    (all-fnnames (caddar term)))
                 (mapcan #'all-fnnames (cdr term))))))
(defun nfix (x) (if (and (integerp x) (<= 0 x)) x 0))
(defun zp (x) (not (and (integerp x) (< 0 x))))
(defun len (x) (length x))
(defun assoc-eq (key xs) (assoc key xs))
(defun member-eq (key xs) (member key xs))
(defun union-eq (xs ys) (union xs ys))
(defun intersectp-eq (xs ys) (intersection xs ys))
(defun remove-eq (x xs) (remove x xs))
(defun remove-duplicates-equal (xs) (remove-duplicates xs :test #'equal))
(defun set-difference-eq (xs ys) (set-difference xs ys))
(defun set-difference-equal (xs ys) (set-difference xs ys :test #'equal))
(defun pairlis$ (xs ys) (mapcar #'cons xs ys))
(defun fn2-decl-get (key row) (getf row key))
(defun fn2-decl-row (key world) (cdr (assoc key (getf world :rows) :test #'equal)))
(defun getpropc (name property default world) (getf (cdr (assoc name (getf world :properties))) property default))
(defun fn2-columns-sym (name suffix) (intern (concatenate 'string (symbol-name name) suffix) "ACL2"))
(defun fn2-columns-pre (prefix name) (intern (concatenate 'string prefix (symbol-name name)) "ACL2"))
(defun fn2-columns-col-name (table field) (fn2-columns-sym table (concatenate 'string "-" (symbol-name field))))
(defun fn2-columns-projection-readers (table cols) (mapcar (lambda (c) (fn2-columns-col-name table (car c))) cols))
(dolist (path '("books/columns-guard-hints.lisp" "books/columns-call-guards.lisp"))
 (with-open-file (in path)
  (loop for form = (read in nil :eof) until (eq form :eof) do
   (when (member (car form) '(defun mutual-recursion)) (eval form)))))
(defun interface-properties (table field)
 (let* ((reader (fn2-columns-col-name table field))
        (writer (fn2-columns-col-name table (fn2-columns-pre "SET-" field))))
  (list (list reader 'unnormalized-body '(quote 0) 'symbol-class :common-lisp-compliant
              'stobjs-in (list nil table) 'stobjs-out '(nil))
        (list writer 'unnormalized-body table 'symbol-class :common-lisp-compliant
              'stobjs-in (list nil nil table) 'stobjs-out (list table))
        (list (fn2-columns-sym writer "-NTH") 'theorem '(equal x x)))))
(defun fixture-world (body)
 (list :rows '(((:columns table) :columns ((x :u32) (y :u32) (z :u32)))
               ((:columns other) :columns ((x :u32) (y :u32))))
       :properties (append
         (list (list 'caller 'formals '(i v table other) 'stobjs-in '(nil nil table other)
                     'symbol-class :common-lisp-compliant 'unnormalized-body body))
         (loop for table in '(table other) append
           (list (list (fn2-columns-sym table "-ROWS") 'stobjs-in (list table) 'stobjs-out '(nil))))
         (loop for table in '(table other) append
           (loop for field in '(x y z) append (interface-properties table field))))))
(defun selected (body) (fn2-columns-postwrite-readers 'caller '(table other) (fixture-world body)))
; Nested setters of the same table expose only the observer, not other reads.
(assert (equal (selected '(table-y i (table-set-x i v (table-set-z i v table)))) '(table-y)))
(assert (null (selected '(table-y i (other-set-x i v other)))))
(assert (null (selected '(table-y i table))))
(assert (null (selected '(quote (table-y i (table-set-x i v table))))))
; Real translated sequential LET bindings: track state aliases, not copied terms.
(assert (equal
 (selected '((lambda (table) (table-y i table)) (table-set-x i v table))) '(table-y)))
(assert (equal
 (selected '((lambda (table)
               ((lambda (table) (table-y i table)) (table-set-z i v table)))
             (table-set-x i v table))) '(table-y)))
; Shadowing must clear provenance when the new binding is an untouched table.
(assert (null
 (selected '((lambda (table) ((lambda (table) (table-y i table)) other))
             (table-set-x i v table)))))
; Both branch paths are inspected; unknown producers are not guessed to frame.
(assert (equal (selected '(table-y i (if p (table-set-x i v table) table))) '(table-y)))
(assert (null (selected '(table-y i (unknown-producer (table-set-x i v table))))))
; Actual hint integration: explicit opt-ins survive, unrelated getters stay shut.
(let* ((world (fixture-world '(list (table-x i table)
                            (table-y i (table-set-x i v table)) (table-z i table))))
       (hint (fn2-columns-call-guard-hint 'caller '(opaque-producer) '(table-z) world))
       (theory (cadr hint)))
 (assert (equal (car theory) 'e/d))
 (assert (member 'table-y (cadr theory)))
 (assert (member 'table-z (cadr theory)))
 (assert (member 'table-rows (cadr theory)))
 (assert (member 'other-rows (caddr theory)))
 (assert (member 'table-x (caddr theory)))
 (assert (member 'opaque-producer (caddr theory)))
 (assert (member 'nth (caddr theory)))
 (assert (not (member 'table-y (caddr theory)))))
; An explicit opacity request wins over automatic selection; an explicit
; enable still has the original final say.
(let* ((world (fixture-world '(table-y i (table-set-x i v table))))
       (closed (cadr (fn2-columns-call-guard-hint 'caller '(table-y) nil world)))
       (opened (cadr (fn2-columns-call-guard-hint 'caller '(table-y) '(table-y) world))))
 (assert (not (member 'table-y (cadr closed))))
 (assert (member 'table-y (caddr closed)))
 (assert (member 'table-rows (caddr closed)))
 (assert (member 'table-y (cadr opened)))
 (assert (not (member 'table-y (caddr opened)))))
; Explicit row opacity wins without suppressing the selected field reader.
(let* ((world (fixture-world '(table-y i (table-set-x i v table))))
       (theory (cadr (fn2-columns-call-guard-hint 'caller '(table-rows) nil world))))
 (assert (member 'table-y (cadr theory)))
 (assert (member 'table-rows (caddr theory)))
 (assert (not (member 'table-rows (cadr theory)))))
; No guessed row observer for an absent/mismatched scalar ABI.
(let ((world (fixture-world '(table-y i (table-set-x i v table)))))
 (setf (getf (cdr (assoc 'table-rows (getf world :properties))) 'stobjs-in) '(other))
 (assert (not (member 'table-rows (fn2-columns-postwrite-runes 'caller '(table) nil world)))))
; Fail closed on unavailable proof interfaces or incompatible stobj signatures.
(let ((world (fixture-world '(table-y i (table-set-x i v table)))))
 (setf (getf (cdr (assoc 'table-set-x-nth (getf world :properties))) 'theorem) nil)
 (assert (null (fn2-columns-postwrite-readers 'caller '(table) world))))
(let ((world (fixture-world '(table-y i (table-set-x i v table)))))
 (setf (getf (cdr (assoc 'table-set-x (getf world :properties))) 'stobjs-out) '(other))
 (assert (null (fn2-columns-postwrite-readers 'caller '(table) world))))
(let ((world (fixture-world '(table-y i (table-set-x i v table)))))
 (setf (getf world :rows) nil)
 (assert (null (fn2-columns-postwrite-readers 'caller '(table) world))))
(format t "COLUMNS POSTWRITE SOURCE CONTROLS PASS~%")

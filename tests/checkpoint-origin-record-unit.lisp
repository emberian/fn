; Actual installation-member writer + actual transaction-header writer feed the
; actual cold evidence record consumer. Physical checked-candidate/evidence
; premises are synthetic here; this is not an anchor/hash/IO or selection proof.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-member")
(include-book "../books/commit-format")
(include-book "../books/runs-page")
(include-book "../books/checkpoint-recovery-evidence-records")

(defun fn2-cor-body (mode fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fields fn2-pool) :verify-guards nil))
 (b* ((profile '((:origin-lineage . 101) (:origin-domain . 103) (:origin-incarnation . 107)
                (:history-id . 37) (:history-incarnation . 41)))
      (fn2-origin (fn2-origin-prepare profile fn2-origin))
      (fn2-checkpoints (fn2-checkpoints-init 1 fn2-checkpoints))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-init 6 fn2-checkpoint-refs))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-init 192 fn2-checkpoint-bytes))
      (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-init 5 fn2-checkpoint-recovery-evidence))
      (fn2-fields (fn2-fields-init 1024 fn2-fields))
      (fn2-pool (fn2-pool-init '((3 . 4096)) 1 100 fn2-pool))
      ((mv mr mslot mgen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv rr rslot rgen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv sr scratch sgen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      (fn2-checkpoints (fn2-checkpoints-put 0 (state *fn2-checkpoint-state-checked*) (checkpoint 500)
       (history (fn2-origin-history fn2-origin)) (incarnation (fn2-origin-history-incarnation fn2-origin))
       (cut-commit 11) (cut-event 20)))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-put 0 (storage-domain 0) (physical-unit 16)
       (writer-epoch 3) (allocation 5) (page-kind *page-kind-checkpoint-descriptor*) (encoded-length 4096)))
      ; The producer obtains all installation body fields/hash from the actual
      ; candidate/ref/byte carriers. No matching encoded body fields are filled.
      ((mv member mlen fn2-fields fn2-pool)
       (fn2-checkpoint-installation-pack-member 0 0 mslot mgen 1 0 1
        fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool))
      ((mv frame body-off fn2-fields)
       (fn2-format-txn-record-decode 128 mslot mgen 0 mlen 1 0 1 fn2-fields fn2-pool))
      ((unless (and (eq mr :ok) (eq rr :ok) (eq sr :ok) (eq member :ok) (eq frame :ok)
                     (< body-off mlen)
                     (= (fn2-fields-value (+ 128 *fn2-format-txn-record-field-record-kind*) fn2-fields) *record-kind-checkpoint-installation*)))
       (mv nil fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fields fn2-pool))
      ; This is the served common-header writer, with the semantic tuple from
      ; the configured origin. The negative control deliberately substitutes
      ; the physical incarnation 41 for semantic 107 in this actual writer.
      ((mv header header-end fn2-fields fn2-pool)
       (fn2-commit-pack-txn-header *record-kind-checkpoint-installation* 21 0 rslot rgen 0 scratch sgen 1 0 1
        (fn2-origin-lineage fn2-origin) (fn2-origin-domain fn2-origin)
        (if (eq mode :physical-incarnation) (fn2-origin-history-incarnation fn2-origin) (fn2-origin-incarnation fn2-origin))
        fn2-fields fn2-pool))
      ((mv copied fn2-pool)
       (fn2-pool-copy-range mslot mgen body-off rslot rgen header-end (- mlen body-off) 1 0 1 fn2-pool))
      (end (+ header-end (- mlen body-off)))
      ((mv decoded decoded-end fn2-fields)
       (fn2-format-record-header-decode 0 rslot rgen 0 header-end 1 0 1 fn2-fields fn2-pool))
      (envelope (and (eq decoded :ok) (= decoded-end header-end)
       (= (fn2-fields-value *fn2-format-record-header-field-lineage* fn2-fields) 101)
       (= (fn2-fields-value *fn2-format-record-header-field-domain* fn2-fields) 103)
       (= (fn2-fields-value *fn2-format-record-header-field-incarnation* fn2-fields) (if (eq mode :physical-incarnation) 41 107))
       (= (fn2-fields-value *fn2-format-record-header-field-event* fn2-fields) 21)
       (= (fn2-fields-value *fn2-format-record-header-field-occurrence* fn2-fields) 21)))
      ; Mutate only one field of the actually decoded header for the malformed
      ; occurrence control, then use its existing generated encoder.
      (fn2-fields (if (eq mode :occurrence)
       (fn2-fields-set-value *fn2-format-record-header-field-occurrence* 22 fn2-fields) fn2-fields))
      ((mv rewrite rewrite-end fn2-pool) (if (eq mode :occurrence)
       (fn2-format-record-header-encode 0 rslot rgen 0 1 0 1 fn2-fields fn2-pool)
       (mv :ok header-end fn2-pool)))
      (fn2-origin (cond ((eq mode :lineage)
       (fn2-origin-prepare (put-assoc-equal :origin-lineage 201 profile) fn2-origin))
       ((eq mode :domain) (fn2-origin-prepare (put-assoc-equal :origin-domain 203 profile) fn2-origin))
       (t fn2-origin)))
      (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-put 0
       (phase *fn2-checkpoint-recovery-evidence-phase-walk*) (candidate 0) (checkpoint 500) (cut-commit 11) (cut-event 20)
       (descriptor-domain 0) (descriptor-unit 16) (descriptor-epoch 3) (descriptor-allocation 5)
       (descriptor-kind *page-kind-checkpoint-descriptor*) (descriptor-length 4096)
       (record-slot rslot) (record-gen rgen) (owner-kind 1) (owner-slot 0) (owner-gen 1)
       (commit 12) (first (if (eq mode :event) 22 21)) (last (if (eq mode :event) 22 21))
       (previous-event (if (eq mode :order) 23 0)) (cursor 0) (end end) (matches 0)))
      (antecedent (and (eq header :ok) (eq copied :ok) envelope (eq rewrite :ok) (= rewrite-end header-end)
       (= (fn2-checkpoints-history 0 fn2-checkpoints) 37) (= (fn2-checkpoints-incarnation 0 fn2-checkpoints) 41)
       (= (fn2-origin-history fn2-origin) 37) (= (fn2-origin-history-incarnation fn2-origin) 41)
       (fn2-checkpoint-recovery-evidence-bound-candidate-p fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)))
      ((mv consumed fn2-checkpoint-recovery-evidence fn2-fields)
       (fn2-checkpoint-recovery-evidence-record fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fields fn2-origin fn2-pool))
      ((when mode)
       (mv (and antecedent (eq consumed :invalid) (= (fn2-checkpoint-recovery-evidence-cursor 0 fn2-checkpoint-recovery-evidence) 0))
        fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fields fn2-pool))
      (matched (and (eq consumed :more)
       (= (fn2-checkpoint-recovery-evidence-cursor 0 fn2-checkpoint-recovery-evidence) end)
       (= (fn2-checkpoint-recovery-evidence-matches 0 fn2-checkpoint-recovery-evidence) 1)
       (= (fn2-checkpoint-recovery-evidence-previous-event 0 fn2-checkpoint-recovery-evidence) 21)))
      ((mv terminal fn2-checkpoint-recovery-evidence fn2-fields)
       (fn2-checkpoint-recovery-evidence-record fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fields fn2-origin fn2-pool)))
  (mv (and antecedent matched (eq terminal :member)
           (= (fn2-checkpoint-recovery-evidence-ready 1 fn2-checkpoint-recovery-evidence) 1)
           (= (fn2-checkpoint-recovery-evidence-event 1 fn2-checkpoint-recovery-evidence) 21))
      fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fields fn2-pool)))

(defun fn2-cor-run (mode)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fields fn2-pool)
  (fn2-cor-body mode fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fields fn2-pool)))
(assert-event (fn2-cor-run nil))
(assert-event (fn2-cor-run :physical-incarnation))
(assert-event (fn2-cor-run :lineage))
(assert-event (fn2-cor-run :domain))
(assert-event (fn2-cor-run :occurrence))
(assert-event (fn2-cor-run :event))
(assert-event (fn2-cor-run :order))

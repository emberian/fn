; Finite workspace-interleaving control, not a scheduler or checkpoint proof.
; Pause incremental B3 on the actual checkpoint selector, run the ordinary
; commitment and block decisions, and resume. The upload workspace is also
; live throughout. Expected final bytes are the independent BLAKE3("abc")
; vector in location-commitment-unit, not an output of this hasher.
(in-package "ACL2")
(include-book "location-commitment-unit")
(include-book "../books/machines-b")

(defun fn2-bwi-words (i row fn2-b3)
 (declare (xargs :stobjs fn2-b3 :verify-guards nil :measure (nfix (- 16 i))))
 (if (>= i 16) nil
  (cons (fn2-b3-word row i fn2-b3) (fn2-bwi-words (+ 1 i) row fn2-b3))))
(defun fn2-bwi-digests (i row fn2-digests)
 (declare (xargs :stobjs fn2-digests :verify-guards nil :measure (nfix (- *fn2-digest-stride* i))))
 (if (>= i *fn2-digest-stride*) nil
  (cons (fn2-digest-list (fn2-digest-slot row i) fn2-digests)
        (fn2-bwi-digests (+ 1 i) row fn2-digests))))
(defun fn2-bwi-snapshot (row fn2-b3 fn2-digests)
 (declare (xargs :stobjs (fn2-b3 fn2-digests) :verify-guards nil))
 (list (fn2-b3-pos row fn2-b3) (fn2-b3-blocks row fn2-b3)
       (fn2-b3-counter row fn2-b3) (fn2-b3-origin row fn2-b3)
       (fn2-b3-depth row fn2-b3) (fn2-b3-flags row fn2-b3)
       (fn2-b3-verify-phase row fn2-b3) (fn2-b3-verify-next row fn2-b3)
       (fn2-b3-verify-base row fn2-b3) (fn2-b3-verify-count row fn2-b3)
       (fn2-b3-verify-target row fn2-b3) (fn2-b3-verify-length row fn2-b3)
       (fn2-bwi-words 0 row fn2-b3) (fn2-bwi-digests 0 row fn2-digests)))
(defun fn2-bwi-check (old-workspace fn2-b3 fn2-digests fn2-pool)
 (declare (xargs :stobjs (fn2-b3 fn2-digests fn2-pool) :verify-guards nil))
 (b* ((profile '((:large-upload-windows . 1) (:control-connections . 0)))
      (rows (fn2-b-format-slots profile))
      (checkpoint (fn2-b-checkpoint-row rows))
      (ordinary (fn2-b-block-read-row rows))
      ;; B's documented first upload hasher row; one actual window above.
      (upload 3)
      (fn2-digests (fn2-digests-init (* *fn2-digest-stride* rows) fn2-digests))
      (fn2-b3 (fn2-b3-table-init rows fn2-b3))
      (fn2-pool (fn2-pool-init '((1 . 128)) 1 100 fn2-pool))
      ((mv reserve & & fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ;; Short block: its chaining-value proof is its digest as well.
      ((mv wrote fn2-pool)
       (fn2-lcu-write (append *fn2-lcu-abc-hash* *fn2-lcu-abc-hash* '(97 98 99)) 0 fn2-pool))
      ((mv fn2-digests fn2-b3)
       (fn2-b3-init checkpoint 0 (fn2-digest-slot checkpoint *fn2-b3-key*) fn2-digests fn2-b3))
      ((mv c1 n1 fn2-digests fn2-b3)
       (fn2-b3-update checkpoint 0 1 64 1 1 0 1 fn2-digests fn2-b3 fn2-pool))
      ((mv fn2-digests fn2-b3)
       (fn2-b3-init upload 0 (fn2-digest-slot upload *fn2-b3-key*) fn2-digests fn2-b3))
      ((mv c2 n2 fn2-digests fn2-b3)
       (fn2-b3-update upload 0 1 64 2 1 0 1 fn2-digests fn2-b3 fn2-pool))
      (before-cp (fn2-bwi-snapshot checkpoint fn2-b3 fn2-digests))
      (before-up (fn2-bwi-snapshot upload fn2-b3 fn2-digests))
      ;; Hypothesis-removal control: explicitly reuse the checkpoint row,
      ;; as the old rows-1 choice did. This is not the current selector.
      ((mv collision fn2-b3 fn2-digests)
       (if old-workspace
        (fn2-block-hash-into checkpoint 0 1 64 3 1 0 1 fn2-b3 fn2-digests fn2-pool)
        (mv :ok fn2-b3 fn2-digests)))
      ((mv commitment fn2-b3 fn2-digests)
       (fn2-block-read-commitment-children 3 3 0 1 64 0 1 0 1 0 1 fn2-b3 fn2-digests fn2-pool))
      ((mv block fn2-b3 fn2-digests)
       (fn2-block-read-done-children 3 3 1 0 1 64 0 32 0 1 0 1 fn2-b3 fn2-digests fn2-pool))
      (cp-preserved (equal before-cp (fn2-bwi-snapshot checkpoint fn2-b3 fn2-digests)))
      (up-preserved (equal before-up (fn2-bwi-snapshot upload fn2-b3 fn2-digests)))
      ((mv c3 n3 fn2-digests fn2-b3)
       (fn2-b3-update checkpoint 0 1 65 2 1 0 1 fn2-digests fn2-b3 fn2-pool))
      (fn2-digests (fn2-b3-finalize (fn2-digest-slot checkpoint *fn2-b3-result*) checkpoint fn2-digests fn2-b3))
      (cp-result (fn-b3-words-octets (fn2-digest-list (fn2-digest-slot checkpoint *fn2-b3-result*) fn2-digests)))
      ((mv c4 n4 fn2-digests fn2-b3)
       (fn2-b3-update upload 0 1 66 1 1 0 1 fn2-digests fn2-b3 fn2-pool))
      (fn2-digests (fn2-b3-finalize (fn2-digest-slot upload *fn2-b3-result*) upload fn2-digests fn2-b3))
      (up-result (fn-b3-words-octets (fn2-digest-list (fn2-digest-slot upload *fn2-b3-result*) fn2-digests))))
  (mv (and (not (equal checkpoint ordinary)) (not (equal upload ordinary))
           (equal (list reserve wrote collision commitment block c1 c2 c3 c4)
                  '(:ok :ok :ok :ok :ok :ok :ok :ok :ok))
           (equal (list n1 n2 n3 n4) '(1 2 2 1))
           up-preserved (equal up-result *fn2-lcu-abc-hash*)
           (if old-workspace
            (and (not cp-preserved) (not (equal cp-result *fn2-lcu-abc-hash*)))
            (and cp-preserved (equal cp-result *fn2-lcu-abc-hash*))))
      fn2-b3 fn2-digests fn2-pool)))
(defun fn2-bwi-run (old-workspace)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-b3
  (mv-let (ok fn2-b3)
   (with-local-stobj fn2-digests
    (mv-let (ok fn2-b3 fn2-digests)
     (with-local-stobj fn2-pool
      (mv-let (ok fn2-b3 fn2-digests fn2-pool)
       (fn2-bwi-check old-workspace fn2-b3 fn2-digests fn2-pool)
       (mv ok fn2-b3 fn2-digests)))
     (mv ok fn2-b3))) ok)))
(assert-event (fn2-bwi-run nil))
(assert-event (fn2-bwi-run t))

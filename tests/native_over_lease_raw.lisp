  (harness-stub-reached 'fnn-owner-cursor-step "host/native/owner.lisp"))
;;; ---- derived stubs: END ----
(defvar *calls* nil)
(defvar *answers* nil)
(defvar *owner-entries* nil)
(defvar *generic-answer* nil)
(defvar *article-answer* nil)
(defvar *st* (vector nil (make-array 128 :element-type '(unsigned-byte 8) :initial-element 0)))
(defconstant *fn-rtc-c-bytesi* 1)
(defun fnn-live-rtc-st () *st*)
(defun fnn-live-stobj (name) name)
(defun fnn-owner-over-window () 3)
(defun fnn-owner-service-lease-ready (service) (declare (ignore service)) t)
(defun fnn-owner-ready-plan-step (service cid plan class)
  (declare (ignore service cid class)) (values plan t nil nil))
(defun fnn-owner-cursor-step-serialized (service cid thunk class)
  (declare (ignore service cid class)) (funcall thunk))
(defun fnn-owner-window-activation (thunk) (funcall thunk))
(defun fnn-owner-over-pause-after-quantum (service cid) (declare (ignore service cid)) nil)
(defun fnn-make-octets (n) (make-array n :element-type '(unsigned-byte 8)))
(defun fnn-owner-render-next (&rest args)
  (push (cons :generic args) *owner-entries*)
  (unless *generic-answer*
    (error "leased OVER reached the replaced generic renderer"))
  (values-list *generic-answer*))
(defun fnn-owner-lease-article-step (&rest args)
  (push (cons :article args) *owner-entries*)
  (unless *article-answer* (error "unexpected ARTICLE lease step"))
  *article-answer*)
(defun fnn-fault (control &rest args) (error (apply #'format nil control args)))
(defun fnn-call (name &rest args)
  (push (cons name args) *calls*)
  (let ((answer (pop *answers*)))
    (assert (eq name (car answer)))
    (cdr answer)))
(defun fnn-core (name &rest args) (first (apply #'fnn-call name args)))
(defun load-owner-forms (names)
  (with-open-file (s "host/native/owner.lisp")
    (loop for f = (read s nil :eof) until (eq f :eof)
          when (member (list (car f) (cadr f)) names :test #'equal)
            do (eval f) (setf names (remove (list (car f) (cadr f)) names :test #'equal))))
  (assert (null names)))
(load-owner-forms '((defstruct (fnn-lease (:constructor fnn-make-lease)))
                   (defun fnn-owner-lease-sent-locked) (defun fnn-owner-lease-over-step)
                   (defun fnn-owner-render-next-quantum)))
;; Observe entry into OVER while still executing the actual loaded host body.
(let ((step (symbol-function 'fnn-owner-lease-over-step)))
  (setf (symbol-function 'fnn-owner-lease-over-step)
        (lambda (&rest args)
          (push (cons :over args) *owner-entries*)
          (apply step args))))
(let ((lease (fnn-make-lease)) (plan '(:plan)) (next '(:next)))
  (setf *answers* (list (list 'fn-hld-begin *st* 7 8 nil)
                       (list 'fn-hld-workspace 4)
                       (list 'fn-ovr-plan-lease-quantum 2 :next-cursor 17 9 *st*)
                       (list 'fn-hld-window-base 32)
                       (list 'fn-ovr-plan-next next)
                       (list 'fn-qplan-donep nil)))
  (let ((result (fnn-owner-lease-over-step 21 lease plan)))
    (assert (equal result (list :warm (svref *st* 1) 32 49 next nil)))
    (assert (eq (second result) (svref *st* 1)))
    (assert (= (fnn-lease-n lease) 17))
    (assert (= (fnn-lease-op lease) 9))
    (assert (equal (cdr (assoc 'fn-ovr-plan-lease-quantum *calls*))
                   (list plan 3 4 7 8 *st* 'fn-arena 'fn-cat))))
  ;; The next window first settles the previous submitted send with J, not N.
  (setf *calls* nil *answers*
        (list (list 'fn-hld-sent *st* nil) (list 'fn-hld-workspace 4)
              (list 'fn-ovr-plan-lease-quantum 1 nil 0 nil *st*)
              (list 'fn-hld-window-base 32) (list 'fn-ovr-plan-next '(:done))
              (list 'fn-qplan-donep t)))
  (assert (equal (fnn-owner-lease-over-step 21 lease next) '(:warm nil 32 32 (:done) t)))
  (assert (equal (reverse (mapcar #'car *calls*))
                 '(fn-hld-sent fn-hld-workspace fn-ovr-plan-lease-quantum
                   fn-hld-window-base fn-ovr-plan-next fn-qplan-donep)))
  (assert (equal (subseq (cdr (assoc 'fn-hld-sent *calls*)) 0 4) '(7 8 9 (:done 17))))
  (assert (null *answers*)))
(let ((lease (fnn-make-lease)))
  (setf *answers* (list (list 'fn-hld-begin *st* nil nil nil)))
  (assert (equal (fnn-owner-lease-over-step 21 lease '(:plan)) '(:wait)))
  (assert (null (fnn-lease-id lease)))
  (setf *answers* (list (list 'fn-hld-begin *st* 7 8 nil) (list 'fn-hld-workspace nil)))
  (assert (equal (fnn-owner-lease-over-step 21 lease '(:plan)) '(:wait)))
  (assert (= (fnn-lease-id lease) 7)))
; The real dispatcher chooses the pool OVER arm, returning the same array.
(let ((lease (fnn-make-lease)) (plan '(:plan)))
  (setf *answers* (list (list 'fn-asto-plan-articlep nil)
                       (list 'fn-ovr-plan-cursor :cursor)
                       (list 'fn-ovr-plan-cursor :cursor)
                       (list 'fn-hld-begin *st* 7 8 nil) (list 'fn-hld-workspace 4)
                       (list 'fn-ovr-plan-lease-quantum 2 nil 17 9 *st*)
                       (list 'fn-hld-window-base 32) (list 'fn-ovr-plan-next '(:done))
                       (list 'fn-qplan-donep t) (list 'fn-ovr-plan-cursor :cursor)))
  (multiple-value-bind (array next done yield cold end extra start)
      (fnn-owner-render-next-quantum :service 21 plan :reader nil nil lease)
    (assert (eq array (svref *st* 1))) (assert (equal next '(:done)))
    (assert (and done (not yield) (not cold) (not extra)))
    (assert (= start 32)) (assert (= end 49)))
  (assert (null *answers*)))
(format t "OVER pool lease host sequence: PASS~%")

;; T1: LEASE alone does not select OVER. Both book selectors refuse HDR,
;; so only the generic entry runs, with no pool instance/workspace/quantum.
(let* ((lease (fnn-make-lease)) (plan '(:hdr-plan)) (next '(:hdr-done))
       (array (fnn-make-octets 5))
       (*calls* nil) (*owner-entries* nil)
       (*generic-answer* (list array next t nil 5))
       (*answers* (list (list 'fn-asto-plan-articlep nil)
                       (list 'fn-ovr-plan-cursor nil)
                       (list 'fn-asto-plan-articlep nil))))
  (assert (equal (multiple-value-list
                  (fnn-owner-render-next-quantum :service 21 plan :reader nil nil lease))
                 (list array next t nil nil 5)))
  (assert (equal *owner-entries* (list (list :generic plan nil nil))))
  (assert (equal (reverse (mapcar #'car *calls*))
                 '(fn-asto-plan-articlep fn-ovr-plan-cursor fn-asto-plan-articlep)))
  (dolist (name '(fn-hld-begin fn-hld-workspace fn-ovr-plan-lease-quantum))
    (assert (null (assoc name *calls*))))
  (assert (null (fnn-lease-id lease)))
  (assert (null (fnn-lease-op lease)))
  (assert (null *answers*)))
(format t "OVER false routing uses generic entry: PASS~%")

;; T1 control: ARTICLE still takes its lease entry when the OVER selector
;; is nil. Mock only that entry; the dispatcher itself is the real host code.
(let* ((lease (fnn-make-lease)) (plan '(:article-plan)) (next '(:article-done))
       (array (fnn-make-octets 5))
       (*calls* nil) (*owner-entries* nil)
       (*article-answer* (list :warm array 1 5 next t))
       (*answers* (list (list 'fn-asto-plan-articlep t)
                       (list 'fn-ovr-plan-cursor nil)
                       (list 'fn-ovr-plan-cursor nil))))
  (assert (equal (multiple-value-list
                  (fnn-owner-render-next-quantum :service 21 plan :reader nil nil lease))
                 (list array next t nil nil 5 nil 1)))
  (assert (equal *owner-entries* (list (list :article 21 lease plan))))
  (assert (equal (reverse (mapcar #'car *calls*))
                 '(fn-asto-plan-articlep fn-ovr-plan-cursor fn-ovr-plan-cursor)))
  (assert (null *answers*)))
(format t "OVER false routing retains ARTICLE entry: PASS~%")

;; T2: settle an earlier send, then refuse the next row (N=0). Even with
;; nonzero J and OP in the mock answer, the host must fault before recording
;; them. It cannot settle again or ask for the window base/next plan.
(let* ((lease (fnn-make-lease :id 7 :inc 8 :op 9 :n 17)) (plan '(:plan))
       (*calls* nil) (*owner-entries* nil) (fault nil)
       (*answers* (list (list 'fn-hld-sent *st* nil)
                       (list 'fn-hld-workspace 4)
                       (list 'fn-ovr-plan-lease-quantum 0 :cursor 99 10 *st*))))
  (handler-case (fnn-owner-lease-over-step 21 lease plan)
    (error (condition) (setf fault condition)))
  (assert fault)
  (assert (search "the OVER lease refused its next window" (format nil "~a" fault)))
  (assert (equal *owner-entries* (list (list :over 21 lease plan))))
  (assert (null (fnn-lease-op lease)))
  (assert (zerop (fnn-lease-n lease)))
  (assert (= (fnn-lease-id lease) 7))
  (assert (= (fnn-lease-inc lease) 8))
  (assert (equal (reverse (mapcar #'car *calls*))
                 '(fn-hld-sent fn-hld-workspace fn-ovr-plan-lease-quantum)))
  (assert (= (count 'fn-hld-sent *calls* :key #'car) 1))
  (assert (equal (subseq (cdr (assoc 'fn-hld-sent *calls*)) 0 4) '(7 8 9 (:done 17))))
  (assert (null *answers*)))
(format t "OVER refused window faults before a send: PASS~%")

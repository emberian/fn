; Replay actual admitted Accept/Receive/Close descriptors. Physical input is
; recorded before Close; publication may follow it, without another write.
(in-package "ACL2")
(include-book "../sim/envelope-prefix")

(defun fn2-input-prefix-bytes (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (bytes)
   (fn2-pool-logical-octets 128 0 fn2-pool) bytes))

(defun fn2-input-prefix-take (op gen taken caps fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((descriptor (fn2-envelope-descriptor op fn2-core)))
  (fn2-envelope-prefix (list (append (list :take op gen) descriptor) '(:ack 1))
                       0 t taken caps fn2-core)))

(defun fn2-input-prefix-fixture (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      ((mv code accept ag fn2-core) (fn2-issue-accept 0 0 1 0 1 0 fn2-core))
      ((unless (eq code :ok)) (mv nil 0 0 nil nil fn2-core))
      ((mv verdict taken caps fn2-core) (fn2-input-prefix-take accept ag nil nil fn2-core))
      ((unless (eq verdict :pass)) (mv nil 0 0 taken caps fn2-core))
      (post (list :post 0 accept ag *fn2-event-accept-result* *fn2-outcome-done*
                  *fn2-reason-none* 0 1 1 *fn2-peer-family-inet* '(119 2130706433 0 0 0) nil))
      ((mv verdict taken caps fn2-core) (fn2-envelope-prefix (list post) 2 t taken caps fn2-core))
      ((unless (eq verdict :pass)) (mv nil 0 0 taken caps fn2-core))
      ((mv code range rg fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
      ((unless (eq code :ok)) (mv nil 0 0 taken caps fn2-core))
      ((mv code fn2-core) (fn2-core-write range rg 0 17 1 0 1 fn2-core))
      ((unless (eq code :ok)) (mv nil 0 0 taken caps fn2-core))
      ((mv code op gen fn2-core) (fn2-issue-receive 1 1 range rg 4 1 0 1 0 fn2-core))
      ((unless (eq code :ok)) (mv nil 0 0 taken caps fn2-core))
      ((mv verdict taken caps fn2-core) (fn2-input-prefix-take op gen taken caps fn2-core)))
   (mv (eq verdict :pass) op gen taken caps fn2-core)))

(defun fn2-input-prefix-close (postp taken caps fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv code op gen fn2-core) (fn2-issue-close 1 1 1 0 1 0 fn2-core))
      ((unless (eq code :ok)) (mv nil taken caps fn2-core))
      ((mv verdict taken caps fn2-core) (fn2-input-prefix-take op gen taken caps fn2-core))
      ((unless (eq verdict :pass)) (mv nil taken caps fn2-core))
      (post (list :post 0 op gen *fn2-event-close-result* *fn2-outcome-done*
                  *fn2-reason-none* 0 0 0 *fn2-peer-family-none* '(0 0 0 0 0) nil))
      ((mv verdict taken caps fn2-core)
       (if postp (fn2-envelope-prefix (list post) 0 t taken caps fn2-core)
         (mv :pass taken caps fn2-core))))
   (mv (and (eq verdict :pass) (not (fn2-envelope-input-open-p 1 1 caps))) taken caps fn2-core)))

; RECORDED may be supplied by the actual codec dispatcher in the native
; fixture. The local controls construct the same schema, including mutants.
(defun fn2-input-prefix-replay-run (mode recorded fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv ready op gen taken caps fn2-core) (fn2-input-prefix-fixture fn2-core))
      ((unless ready) (mv nil fn2-core))
      (before (fn2-input-prefix-bytes fn2-core))
      (prefix (or recorded (list :input-prefix op gen 0 2 '(70 71))))
      (prefix (if (eq mode :stale) (update-nth 2 (+ 1 gen) prefix) prefix))
      (prefix (if (eq mode :span) (update-nth 3 4 prefix) prefix))
      ((mv verdict taken caps fn2-core)
       (if (member-eq mode '(:forged :after-close :after-close-ack :legacy)) (mv :pass taken caps fn2-core)
         (fn2-envelope-prefix (list prefix) 0 t taken caps fn2-core)))
      ((when (member-eq mode '(:stale :span)))
       (mv (and (equal verdict (list (if (eq mode :stale) :input-prefix-descriptor :input-prefix-span) 0))
                (equal before (fn2-input-prefix-bytes fn2-core))) fn2-core))
      ((unless (eq verdict :pass)) (mv nil fn2-core))
      ((mv verdict taken caps fn2-core)
       (if (eq mode :duplicate) (fn2-envelope-prefix (list prefix) 1 t taken caps fn2-core)
         (mv :pass taken caps fn2-core)))
      ((when (eq mode :duplicate))
       (mv (and (equal verdict '(:input-prefix-span 1))
                (equal (nth 14 (fn2-envelope-get op taken)) '(2 (70 71)))) fn2-core))
      ((mv closed taken caps fn2-core)
       (if (member-eq mode '(:ordinary :legacy)) (mv t taken caps fn2-core)
         (fn2-input-prefix-close (not (eq mode :after-close-ack)) taken caps fn2-core)))
      ((unless closed) (mv nil fn2-core))
      ((mv verdict taken caps fn2-core)
       (if (member-eq mode '(:after-close :after-close-ack)) (fn2-envelope-prefix (list prefix) 1 t taken caps fn2-core)
         (mv :pass taken caps fn2-core)))
      ((when (member-eq mode '(:after-close :after-close-ack)))
       (mv (and (equal verdict '(:input-prefix-after-close 1))
                (equal before (fn2-input-prefix-bytes fn2-core))) fn2-core))
      (physical (fn2-input-prefix-bytes fn2-core))
      (post (list :post 0 op gen *fn2-event-receive-result* *fn2-outcome-done*
                  *fn2-reason-none* 2 0 0 *fn2-peer-family-none* '(0 0 0 0 0)
                  (if (eq mode :mismatch) '(70 72) '(70 71))))
      ((mv verdict taken caps fn2-core) (fn2-envelope-prefix (list post) 2 t taken caps fn2-core))
      (- taken) (- caps)
      (after (fn2-input-prefix-bytes fn2-core)))
   (mv (cond ((eq mode :forged) (and (equal verdict '(:post-after-close 2)) (equal after before)))
             ((eq mode :mismatch) (and (equal verdict '(:input-prefix-result 2)) (equal after physical)))
             (t (and (eq verdict :pass)
                     (equal after (append (take 1 before) '(70 71) (nthcdr 3 before)))
                     (or (eq mode :legacy) (equal after physical)))))
       fn2-core)))

(defun fn2-input-prefix-replay-control (mode recorded)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (ok fn2-core) (fn2-input-prefix-replay-run mode recorded fn2-core) ok)))

(assert-event (fn2-input-prefix-replay-control :deferred nil))
(assert-event (fn2-input-prefix-replay-control :ordinary nil))
(assert-event (fn2-input-prefix-replay-control :legacy nil))
(assert-event (fn2-input-prefix-replay-control :forged nil))
(assert-event (fn2-input-prefix-replay-control :after-close nil))
(assert-event (fn2-input-prefix-replay-control :stale nil))
(assert-event (fn2-input-prefix-replay-control :span nil))
(assert-event (fn2-input-prefix-replay-control :duplicate nil))
(assert-event (fn2-input-prefix-replay-control :mismatch nil))

(assert-event (fn2-input-prefix-replay-control :after-close-ack nil))

; Actual shared protocol requests and actual pool class/reservation controls.
; This does not exercise upload TAKE, window reuse or P+F service admission.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/upload-window-geometry")
(include-book "../books/pool")
(assert-event (equal *fn2-upload-header-workspace-bytes* 17440))
(assert-event (equal *fn2-upload-body-window-bytes* *fn2-commit-unit-bytes*))
(defun fn2-uwg-control ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool
  (mv-let (ok fn2-pool)
   (b* ((fn2-pool (fn2-pool-init '((2 . 4096) (1 . 65536)) 1 1000 fn2-pool))
        (header (fn2-pool-class-for *fn2-upload-header-workspace-bytes* fn2-pool))
        (body (fn2-pool-class-for *fn2-upload-body-window-bytes* fn2-pool))
        ((mv h hs hg fn2-pool) (fn2-pool-reserve header 1 1 1 fn2-pool))
        ((mv b bs bg fn2-pool) (fn2-pool-reserve body 1 1 1 fn2-pool)))
    (mv (and (= header 1) (= body 0) (eq h :ok) (eq b :ok)
             (not (= hs bs)) (= (fn2-pool-cap hs fn2-pool) 65536)
             (= (fn2-pool-cap bs fn2-pool) 4096)
             (eq (fn2-pool-workspace-code hs hg 1 1 1 fn2-pool) :ok)
             (eq (fn2-pool-workspace-code bs bg 1 1 1 fn2-pool) :ok)
             (fn2-pool-wfp fn2-pool)) fn2-pool)) ok)))
(assert-event (fn2-uwg-control))

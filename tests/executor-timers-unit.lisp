; Registered services execute through the real dispatcher and an independent
; reference FIFO. The deadline itself is semantic state in the relation.
(in-package "ACL2")
(include-book "reference-unit")
(include-book "../books/sched-timers")
(include-book "std/testing/must-fail" :dir :system)

(defun fn2-et-arm (id ms fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-sched (fn2-core-sched fn2-core)) (fn2-control (fn2-core-control fn2-core)))
    (code deadline fn2-sched fn2-control) (fn2-sched-arm-delay-ms id ms fn2-sched fn2-control)
    (mv code deadline fn2-core)))
(defun fn2-et-clear (id fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-sched (fn2-core-sched fn2-core)))
    (code fn2-sched) (fn2-sched-clear-deadline id fn2-sched)
    (mv code fn2-core)))
(defun fn2-et-expired (id fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-sched (fn2-core-sched fn2-core)))
    (yes) (fn2-sched-timer-expired-p id fn2-sched) yes))
(defun fn2-et-service (lists fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (b* ((pre (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
                (fn2-ref-corep fn2-ref-core) (fn2-core-wfp fn2-ref-core)
                (fn2-representation-relation fn2-core fn2-ref-core lists)
                (not (fn2-exec-grant-p fn2-core))))
       ((mv obs visits actions bytes steps fn2-core) (fn2-exec-service 1 0 0 fn2-core))
       ((mv reference-steps lists fn2-ref-core) (fn2-ref-run-services 1 lists fn2-ref-core))
       (fn2-ref-core (fn2-exec-charge-run (fn2-exec-system-row fn2-ref-core) 0
                                        (+ reference-steps *fn2-work-empty*) fn2-ref-core)))
    (mv (and pre (equal (list obs visits actions bytes) '(0 1 0 0))
             (equal steps (+ reference-steps *fn2-work-empty*))
             (<= reference-steps *fn2-timer-service-step-max*)
             (fn2-representation-relation fn2-core fn2-ref-core lists)
             (not (fn2-core-stopped-p fn2-core))) lists fn2-core fn2-ref-core)))
(defun fn2-et-drain (fuel lists fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil :measure (nfix fuel)))
  (if (not (fn2-exec-services-ready-p fn2-core)) (mv t lists fn2-core fn2-ref-core)
    (if (zp fuel) (mv nil lists fn2-core fn2-ref-core)
      (mv-let (ok lists fn2-core fn2-ref-core) (fn2-et-service lists fn2-core fn2-ref-core)
        (if (not ok) (mv nil lists fn2-core fn2-ref-core)
          (fn2-et-drain (- fuel 1) lists fn2-core fn2-ref-core))))))
(defun fn2-et-run (fn2-core fn2-ref-core)
  (declare (xargs :stobjs (fn2-core fn2-ref-core) :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       (fn2-ref-core (fn2-core-init *fn2-profile-tiny* fn2-ref-core))
       (fn2-core (fn2-exec-clock 50 fn2-core))
       ((mv a0 d0 fn2-core) (fn2-et-arm 0 1 fn2-core))
       ((mv a16 d16 fn2-core) (fn2-et-arm 16 1 fn2-core))
       ((mv old old-dl fn2-core) (fn2-et-arm 1 1 fn2-core))
       ((mv cancel fn2-core) (fn2-et-clear 1 fn2-core))
       ((mv reuse new-dl fn2-core) (fn2-et-arm 1 3 fn2-core))
       (fn2-ref-core (fn2-ref-copy-core fn2-core fn2-ref-core))
       (lists (fn2-ref-lists '(1 1 1 1) 0 nil))
       (fn2-core (fn2-exec-clock 1049 fn2-core))
       (fn2-ref-core (fn2-exec-clock 1049 fn2-ref-core))
       (early (not (fn2-exec-services-ready-p fn2-core)))
       ((mv early-ok lists fn2-core fn2-ref-core) (fn2-et-service lists fn2-core fn2-ref-core))
       (fn2-core (fn2-exec-clock 1050 fn2-core))
       (fn2-ref-core (fn2-exec-clock 1050 fn2-ref-core))
       (due (fn2-exec-services-ready-p fn2-core))
       ((mv first-ok lists fn2-core fn2-ref-core) (fn2-et-service lists fn2-core fn2-ref-core))
       (bounded (and (fn2-et-expired 0 fn2-core) (not (fn2-et-expired 16 fn2-core))
                     (not (fn2-et-expired 1 fn2-core))
                     (= (fn2-exec-timer-cursor fn2-core) 16)
                     (fn2-exec-services-ready-p fn2-core)))
       ((mv rest-ok lists fn2-core fn2-ref-core)
        (fn2-et-drain (fn2-exec-rows fn2-core) lists fn2-core fn2-ref-core))
       (later (and (fn2-et-expired 16 fn2-core) (not (fn2-et-expired 1 fn2-core))
                   (equal (fn2-ref-queue 0 (nth 2 lists)) '(0 16))))
       (fn2-core (fn2-exec-clock 3050 fn2-core))
       (fn2-ref-core (fn2-exec-clock 3050 fn2-ref-core))
       ((mv reuse-ok lists fn2-core fn2-ref-core)
        (fn2-et-drain (fn2-exec-rows fn2-core) lists fn2-core fn2-ref-core))
       (reused (and (fn2-et-expired 1 fn2-core)
                    (equal (fn2-ref-queue 0 (nth 2 lists)) '(0 16 1))))
       ;; Hypothesis-removal control: losing a pending deadline breaks R,
       ;; even when both intrusive/FIFO queue views remain unchanged.
       ((mv tamper fn2-ref-core) (fn2-et-clear 1 fn2-ref-core))
       (different (not (fn2-representation-relation fn2-core fn2-ref-core lists)))
       (fn2-core (fn2-exec-clock (- *fn2-no-deadline* 500) fn2-core))
       ((mv overflow & fn2-core) (fn2-et-arm 2 1 fn2-core)))
    (mv (and (equal (list a0 a16 old cancel reuse tamper) '(:ok :ok :ok :ok :ok :ok))
             (= d0 1050) (= d16 1050) (= old-dl 1050) (= new-dl 3050)
             early early-ok due first-ok bounded rest-ok later reuse-ok reused different
             (eq overflow :bounds)) fn2-core fn2-ref-core)))
(defun fn2-et-test ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (ok fn2-core)
      (with-local-stobj fn2-ref-core
        (mv-let (ok fn2-core fn2-ref-core) (fn2-et-run fn2-core fn2-ref-core)
          (mv ok fn2-core))) ok)))
(assert-event (fn2-et-test))

; Registry controls reject slot collisions and unaccounted descriptors.
(must-fail
 (defservice :duplicate-timer :slot 1
   :children ((fn2-sched fn2-core-sched) (fn2-control fn2-core-control))
   :ready fn2-timer-service-ready-p :step fn2-timer-service-step
   :reference fn2-ref-timer-service-step :bound (:steps 16 :descriptors 0) :doc "collision"))
(must-fail
 (defservice :unaccounted-actions :slot 2
   :children ((fn2-sched fn2-core-sched))
   :ready fn2-timer-service-ready-p :step fn2-timer-service-step
   :reference fn2-ref-timer-service-step :bound (:steps 16 :descriptors 1) :doc "unaccounted descriptor"))

; Actual manifest encoder/decoder, allocator settlement and recovery-entry
; consumer controls at a nonzero extent. Synthetic digest bytes deliberately
; do not claim hashing, physical IO, a sealed journal or complete cold boot.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "upload-stored-source-unit")
(defun fn2-ump-reserved (e ep allocation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (yes)
  (and (eq (fn2-alloc-handle-code e ep allocation fn2-extents) :ok)
       (= (fn2-extents-state e fn2-extents) *fn2-extent-state-reserved*)) yes))
(defun fn2-ump-entry (ls lg off end kind owner gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
  (code next lo len unit epoch allocation fn2-fields)
  (fn2-am-get-entry 0 ls lg off end kind owner gen fn2-fields fn2-pool)
  (mv code next lo len unit epoch allocation fn2-core)))
(defun fn2-ump-settle (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-txn-posting-profile* fn2-core))
      ((mv ec fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv r0 other oep oa fn2-core) (fn2-upload-payload-reserve fn2-core))
      ((mv r1 e ep allocation fn2-core) (fn2-upload-payload-reserve fn2-core))
      ((mv r2 ls lg fn2-core) (fn2-core-reserve 2 *fn2-upload-kind* 0 1 fn2-core))
      ((mv zero fn2-core) (fn2-upload-page-zero *fn2-upload-page-manifest* 0 ls lg *fn2-upload-kind* 0 1 fn2-core))
      ((mv stale-encoded stale-end fn2-core)
       (fn2-upload-block-entry 3 ls lg 0 *fn2-commit-unit-bytes*
        (* *fn2-storage-extent-units* e) (+ 1 ep) allocation 0 *fn2-upload-kind* 0 1 fn2-core))
      ((mv stale fn2-core)
       (fn2-upload-manifest-extents 1 nil 0 0 ls lg 0 stale-end stale-end *fn2-upload-kind* 0 1 fn2-core))
      (stale-kept (and (fn2-ump-reserved e ep allocation fn2-core)
                       (fn2-ump-reserved other oep oa fn2-core)))
      ((mv a first-end fn2-core)
       (fn2-upload-block-entry 3 ls lg 0 *fn2-commit-unit-bytes*
        (* *fn2-storage-extent-units* e) ep allocation 0 *fn2-upload-kind* 0 1 fn2-core))
      ((mv b end fn2-core)
       (fn2-upload-block-entry 3 ls lg 1 *fn2-commit-unit-bytes*
        (+ (* *fn2-storage-extent-units* e) 1) ep allocation first-end *fn2-upload-kind* 0 1 fn2-core))
      ((mv read next lo len unit got-ep got-a fn2-core)
       (fn2-ump-entry ls lg *fn2-upload-page-manifest* (+ *fn2-upload-page-manifest* end)
                      *fn2-upload-kind* 0 1 fn2-core))
      ((unless (and (eq ec :ok) (eq r0 :ok) (eq r1 :ok) (posp e) (not (= e other))
                    (eq r2 :ok) (eq zero :ok) (eq stale-encoded :ok) (eq stale :fault) stale-kept (eq a :ok) (eq b :ok) (eq read :ok)
                    (= next (+ *fn2-upload-page-manifest* first-end)) (= lo 0)
                    (= len *fn2-commit-unit-bytes*) (= unit (* *fn2-storage-extent-units* e))
                    (= got-ep ep) (= got-a allocation))) (mv nil fn2-core))
      ;; A nonleader is a reference, not a second cancellation of its extent.
      ((mv skip fn2-core)
       (fn2-upload-manifest-extents 1 nil 0 0 ls lg first-end end end *fn2-upload-kind* 0 1 fn2-core))
      (kept (fn2-ump-reserved e ep allocation fn2-core))
      ((mv cancel fn2-core)
       (fn2-upload-manifest-extents 2 nil 0 0 ls lg 0 end end *fn2-upload-kind* 0 1 fn2-core))
      (freed (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (yes)
               (= (fn2-extents-state e fn2-extents) *fn2-extent-state-free*) yes)))
  (mv (and (eq skip :ok) kept (eq cancel :ok) freed
           (fn2-ump-reserved other oep oa fn2-core) (fn2-core-wfp fn2-core)
           (not (fn2-core-stopped-p fn2-core))) fn2-core)))
(defun fn2-ump-recovery (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-txn-posting-profile* fn2-core))
      ((mv ec fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv r0 other & & fn2-core) (fn2-upload-payload-reserve fn2-core))
      ((mv r1 e ep allocation fn2-core) (fn2-upload-payload-reserve fn2-core))
      (rid (fn2-machine-global-id *fn2-recovery-machine-kind* 0 *fn2-txn-posting-profile*))
      ((mv r2 ls lg fn2-core) (fn2-core-reserve 2 *fn2-recovery-machine-kind* rid 1 fn2-core))
      ((mv zero fn2-core) (fn2-upload-page-zero *fn2-upload-page-manifest* 0 ls lg *fn2-recovery-machine-kind* rid 1 fn2-core))
      ((mv encoded end fn2-core)
       (fn2-upload-block-entry 3 ls lg 0 *fn2-commit-unit-bytes*
        (* *fn2-storage-extent-units* e) ep allocation 0 *fn2-recovery-machine-kind* rid 1 fn2-core))
      ;; Same owned checked pool copy puts this real encoded entry in the
      ;; recovery reader's unit window. No journal/seal authority is asserted.
      ((mv copied fn2-core)
       (fn2-core-copy-range ls lg *fn2-upload-page-manifest* ls lg 0 end *fn2-recovery-machine-kind* rid 1 fn2-core))
      (before (fn2-recovery-cand-status e fn2-core))
      ((mv refused wrong-hi fn2-core)
       (fn2-recovery-claim-article (* *fn2-commit-write-resources* e) ep allocation 7 8 fn2-core))
      (refusal-kept (= before (fn2-recovery-cand-status e fn2-core)))
      ((mv read hi epoch fn2-core)
       (fn2-rp-entries 1 0 *fn2-commit-unit-bytes* 7 8 0 0 ls lg rid 1 fn2-core))
      (matched (stobj-let ((fn2-rec-cand (fn2-core-rec-cand fn2-core))) (yes)
                 (and (= (fn2-rec-cand-status e fn2-rec-cand) *fn2-rec-status-payload*)
                      (= (fn2-rec-cand-epoch e fn2-rec-cand) ep)
                      (= (fn2-rec-cand-allocation e fn2-rec-cand) allocation)
                      (= (fn2-rec-cand-owner e fn2-rec-cand) 7)
                      (= (fn2-rec-cand-commit e fn2-rec-cand) 8)
                      (not (= (fn2-rec-cand-status other fn2-rec-cand) *fn2-rec-status-payload*))) yes)))
  (mv (and (eq ec :ok) (eq r0 :ok) (eq r1 :ok) (posp e) (eq r2 :ok)
           (eq zero :ok) (eq encoded :ok) (eq copied :ok) (eq refused :invalid) (= wrong-hi 0) refusal-kept (eq read :done)
           (= hi (+ 1 e)) (= epoch ep) matched (fn2-core-wfp fn2-core)
           (not (fn2-core-stopped-p fn2-core))) fn2-core)))
(assert-event (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-ump-settle fn2-core) ok)))
(assert-event (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-ump-recovery fn2-core) ok)))

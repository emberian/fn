; Actual B entries with explicitly synthetic production provenance. This checks
; the allocation barrier and planner seam, never witnesses physical construction
; or persisted installation. No runtime/admission result is claimed by source.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-allocation-coordinator-unit")
(defun fn2-cic-roots (role fn2-checkpoint-refs)
 (declare (xargs :stobjs fn2-checkpoint-refs :verify-guards nil :measure (nfix (- 6 (nfix role)))))
 (if (>= (nfix role) 6) fn2-checkpoint-refs
  (let ((fn2-checkpoint-refs (fn2-checkpoint-refs-put role
         (encoded-length 128) (root-build-token 7) (root-source-complete 1) (root-intended-bytes 128) (root-completed-bytes 128))))
   (fn2-cic-roots (+ 1 role) fn2-checkpoint-refs))))
(defun fn2-cic-scan (left fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :horizon fn2-core)
  (mv-let (code fn2-core) (fn2-checkpoint-installation-step fn2-core)
   (if (eq code :more) (fn2-cic-scan (- left 1) fn2-core) (mv code fn2-core)))))
(defun fn2-cic-submit (left fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :horizon 0 0 fn2-core)
  (mv-let (code batch event fn2-core) (fn2-checkpoint-installation-submit fn2-core)
   (if (eq code :exhausted) (fn2-cic-submit (- left 1) fn2-core) (mv code batch event fn2-core)))))
(defun fn2-cic-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init (fn2-b-test-profile *fn2-profile-tiny* 0) fn2-core))
      ((mv absent fn2-core) (fn2-checkpoint-installation-begin 0 7 1 2 3 fn2-core))
      ((mv begun fn2-core) (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv a data fn2-core) (fn2-cac-seed 128 fn2-core))
      ((mv b ticket fn2-core) (fn2-cac-seed 0 fn2-core))
      (fn2-core (stobj-let ((fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core))
                            (fn2-checkpoints (fn2-core-checkpoints fn2-core))
                            (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core)))
        (fn2-checkpoint-construction fn2-checkpoints fn2-checkpoint-refs)
        (let* ((fn2-checkpoint-construction (fn2-checkpoint-construction-put ticket (role 6) (ordinal 0)
                 (intended-bytes (* *fn2-commit-write-resources* *fn2-commit-unit-bytes*))))
               (fn2-checkpoints (fn2-checkpoints-put 0 (state *fn2-checkpoint-state-checked*) (checkpoint 500)
                 (builder-token 7) (builder-owner-kind 1) (builder-owner-slot 2) (builder-owner-gen 3)))
               (fn2-checkpoint-refs (fn2-cic-roots 0 fn2-checkpoint-refs))
               (fn2-checkpoint-refs (fn2-checkpoint-refs-put 0 (storage-domain 0) (physical-unit 0)
                 (writer-epoch 1) (allocation 1) (page-kind *page-kind-checkpoint-descriptor*) (encoded-length 128))))
         (mv fn2-checkpoint-construction fn2-checkpoints fn2-checkpoint-refs)) fn2-core))
      (fn2-core (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (fn2-extents)
        (let* ((fn2-extents (update-fn2-alloc-freeze-phase 2 fn2-extents))
               (fn2-extents (update-fn2-alloc-freeze-token 7 fn2-extents))
               (fn2-extents (update-fn2-alloc-freeze-owner-kind 1 fn2-extents))
               (fn2-extents (update-fn2-alloc-freeze-owner-slot 2 fn2-extents)))
         (update-fn2-alloc-freeze-owner-gen 3 fn2-extents)) fn2-core))
      ((mv wrong fn2-core) (fn2-checkpoint-installation-begin 0 8 1 2 3 fn2-core))
      ((mv start fn2-core) (fn2-checkpoint-installation-begin 0 7 1 2 3 fn2-core))
      ((mv pending fn2-core) (fn2-checkpoint-installation-step fn2-core))
      ; Install the synthetic completed data reservation through the existing
      ; allocation primitive; final scan must distinguish reserved/allocated.
      ((mv allocated fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core))
                   (fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core))
                   (fn2-extents (fn2-core-extents fn2-core))) (code fn2-fields fn2-extents)
        (let* ((fn2-fields (fn2-fields-set-value *fn2-format-allocation-field-extent* data fn2-fields))
               (fn2-fields (fn2-fields-set-value *fn2-format-allocation-field-writer-epoch* (fn2-checkpoint-construction-epoch data fn2-checkpoint-construction) fn2-fields))
               (fn2-fields (fn2-fields-set-value *fn2-format-allocation-field-allocation* (fn2-checkpoint-construction-counter data fn2-checkpoint-construction) fn2-fields))
               (fn2-fields (fn2-fields-set-value *fn2-format-allocation-field-owner-kind* 1 fn2-fields))
               (fn2-fields (fn2-fields-set-value *fn2-format-allocation-field-owner* 7 fn2-fields)))
         (mv-let (code fn2-extents) (fn2-checkpoint-allocation-install 0 fn2-checkpoint-construction fn2-fields fn2-extents)
          (mv code fn2-fields fn2-extents))) (mv code fn2-core)))
      ((mv staged fn2-core) (fn2-cic-scan 32 fn2-core))
      ((mv slot gen len) (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))) (slot gen len)
        (mv (fn2-retirement-control-slot 0 fn2-retirement-control) (fn2-retirement-control-gen 0 fn2-retirement-control)
            (fn2-retirement-control-bytes 0 fn2-retirement-control)) (mv slot gen len)))
      ((mv generic & & fn2-core) (fn2-commit-admit-txn slot gen len 1 2 3 fn2-core))
      ((mv submitted batch event fn2-core) (fn2-cic-submit 4 fn2-core))
      ((mv frame & bytes next fn2-core) (fn2-commit-txn-frame 0 slot gen 0 len 1 2 3 fn2-core))
      ((mv no-persist & & fn2-core) (fn2-commit-lifecycle-step 0 0 0 fn2-core))
      (fn2-core (fn2-cac-token 8 fn2-core))
      ((mv stale fn2-core) (fn2-checkpoint-installation-install-member 0 slot gen 0 next bytes len batch event 1 2 3 fn2-core))
      (unchanged (stobj-let ((fn2-checkpoints (fn2-core-checkpoints fn2-core))
                             (fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core))) (ok)
        (and (= (fn2-checkpoints-state 0 fn2-checkpoints) *fn2-checkpoint-state-checked*)
             (= (fn2-checkpoints-installation-commit 0 fn2-checkpoints) 0)
             (= (fn2-checkpoint-construction-ticket-claimed ticket fn2-checkpoint-construction) 1)
             (= (fn2-checkpoint-construction-ticket-batch ticket fn2-checkpoint-construction) batch)) ok)))
  (mv (and (eq absent :pending) (eq begun :ok) (eq a :ok) (eq b :ok) (eq wrong :pending)
           (eq start :ok) (eq pending :pending) (eq allocated :ok) (eq staged :staged)
           (not (eq generic :ok)) (eq submitted :ok) (eq frame :ok)
           (eq no-persist :invalid) (eq stale :invalid) unchanged) fn2-core)))
(defun fn2-cic-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-cic-body fn2-core) ok)))
(assert-event (fn2-cic-run))

  (let ((fn2-checkpoint-root1 (fn2-checkpoint-root1-put 0 (token 7)
    (phase (if payload *fn2-checkpoint-root1-phase-payload* *fn2-checkpoint-root1-phase-semantic*)) (read-kind (if payload 2 1)))))
   (if payload
    (let ((fn2-checkpoint-payload (fn2-checkpoint-payload-put 0
      (phase *fn2-checkpoint-payload-phase-wait-block*) (token 7) (owner-kind 9) (owner-slot 0) (owner-gen 1)
      (pending 1) (op-slot op) (op-gen og) (block-length 4096))))
     (mv fn2-checkpoint-root1 fn2-checkpoint-semantic fn2-checkpoint-payload))
    (let ((fn2-checkpoint-semantic (fn2-checkpoint-semantic-put 0
      (phase *fn2-checkpoint-semantic-phase-wait*) (token 7) (owner-kind 9) (owner-slot 0) (owner-gen 1)
      (pending 1) (op-slot op) (op-gen og))))
     (mv fn2-checkpoint-root1 fn2-checkpoint-semantic fn2-checkpoint-payload))))
  fn2-core))


(defun fn2-cra-body (payload fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-cra-profile* fn2-core))
      ((mv allocated e ep ac fn2-core) (fn2-cra-allocate fn2-core))
      (fn2-core (fn2-cra-claim-context fn2-core))
      ((mv reserved fn2-core) (fn2-cra-reserve fn2-core))
      ((mv cancel-begin fn2-core) (fn2-cra-plan-cancel fn2-core))
      ((mv slot gen) (fn2-cra-read-window fn2-core))
      ((mv read op og fn2-core) (fn2-block-read (* e *fn2-storage-extent-units*) ep ac 0 4096 slot gen 9 0 1 0 fn2-core))
      (fn2-core (fn2-cra-pending payload op og fn2-core))
      ; Prepared candidate cleanup interleaves with the actual source read pin.
      ((mv cancelled fn2-core) (fn2-cra-cancel-loop 34 fn2-core))
      ((mv clean fn2-core) (fn2-cra-clean-loop (+ 32 202) fn2-core))
      ((mv refused fn2-core) (fn2-cra-reset-step fn2-core))
      (before (fn2-cra-observe e payload nil fn2-core))
      ((mv ack fn2-core) (fn2-cra-ack fn2-core))
      (fn2-core (fn2-cra-post op (+ og 1) fn2-core))
      ((mv stale & & & & & & & & & fn2-core) (fn2-harvest-one fn2-core))
      ((mv still-refused fn2-core) (fn2-cra-reset-step fn2-core))
      (still (fn2-cra-observe e payload nil fn2-core))
      (fn2-core (fn2-cra-post op og fn2-core))
      ((mv delivered & & & & & & & & & fn2-core) (fn2-harvest-one fn2-core))
      ((mv reset fn2-core) (fn2-cra-reset-loop (+ (* 3 *fn2-run-max-levels*) 20) fn2-core)))
  (mv (and allocated (eq reserved :ok) (eq cancel-begin :ok) (eq read :ok) (eq cancelled :ledger-empty)
           (eq clean :clean) (eq refused :recovery-required) before (eq ack :ok) (not stale)
           (eq still-refused :recovery-required) still delivered (eq reset :reset)
           (fn2-cra-observe e payload t fn2-core) (not (fn2-core-stopped-p fn2-core))) fn2-core)))

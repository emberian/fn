; Actual declarative CTL output arms under leaf callback stubs; no claim
; about generated guards, the reader's integrity proof, or socket I/O.
(load "tests/ctl-stream-arm-controls.lsp")
(in-package "ACL2")
(defparameter *results* nil)
(defparameter *borrow-count* 0)
(defun fn2-machine-pool-borrows-read-code (slot) (declare (ignore slot)) :ok)
(defun fn2-machine-pool-borrows (slot) (declare (ignore slot)) *borrow-count*)
(defun fn2-core-query-heldp (slot gen) (declare (ignore slot gen)) nil)
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun nfix (x) (if (natp x) x 0))
(setf (symbol-function 'base-execute-steps) (symbol-function 'execute-steps))
(defun execute-steps (steps)
 (dolist (step steps)
  (case (car step)
   (:let (push (cons (second step) (expression (third step))) *vars*))
   (:do (let* ((name (car (third step))) (result (assoc name *results*)))
          (assert result) (assert (= (length (second step)) (length (cdr result))))
          (push (list :call name) *effects*)
          (loop for variable in (second step) for value in (cdr result)
                do (push (cons variable value) *vars*))))
   (:issue (push step *effects*))
   (otherwise (base-execute-steps (list step))))))
(defparameter *out-vars*
 '((row-pending . 0) (row-rx-slot . 1) (row-rx-gen . 2) (budget . 8192)
   (row-fill . 0) (row-oleft . 0) (row-ochecked . 0)
   (row-tx-off . 0) (row-tx-len . 32)
   (*fn2-ctl-output-prefix* . 1) (*fn2-ctl-output-fill* . 2)
   (*fn2-ctl-output-hash* . 3) (*fn2-ctl-output-send* . 4)
   (*fn2-ctl-output-trailer* . 5) (*fn2-ctl-output-last* . 6)
   (*fn2-ctl-output-done* . 7) (*fn2-ctl-io-bytes* . 4096)))
(defparameter *out-arm* (cdddr (assoc :stream-reply (getf (cdddr *ctl*) :arms))))
;; No next/finish/reset or Send can run while a loan remains borrowed.
(let ((*borrow-count* 1))
 (multiple-value-bind (effects vars) (run *out-arm* (cons '(row-ophase . 7) *out-vars*))
  (declare (ignore vars))
  (assert (equal (mapcar #'car effects) '(:charge)))))
;; A provisional read failure closes without proceeding to hash or trailer.
(let ((*results* '((fn2-cns-stream-source-next :bad 0 nil))))
 (multiple-value-bind (effects vars) (run *out-arm* (cons '(row-ophase . 2) *out-vars*))
  (declare (ignore vars))
  (assert (member '(:next :closing) effects :test #'equal))
  (assert (= (count :call effects :key #'car) 1))))
;; A zero-capacity EOF check is allowed only when the source confirms it.
(let ((*results* '((fn2-cns-stream-source-next :ok 0 t))))
 (multiple-value-bind (effects vars) (run *out-arm* (cons '(row-ophase . 2) *out-vars*))
  (assert (not (assoc :next effects)))
  (assert (= (cdr (assoc 'row-ochecked vars)) 1))
  (assert (= (cdr (assoc 'row-ophase vars)) 3))))
;; Last trailer bytes outstanding issue Send, never release the source.
(multiple-value-bind (effects vars) (run *out-arm* (cons '(row-ophase . 6) *out-vars*))
 (declare (ignore vars))
 (assert (assoc :issue effects)) (assert (not (assoc :call effects))))
;; Returned final Send only enters handback; it cannot skip that phase.
(multiple-value-bind (effects vars)
 (run *out-arm* (append '((row-ophase . 6) (row-tx-off . 32)) *out-vars*))
 (assert (not (assoc :call effects)))
 (assert (= (cdr (assoc 'row-ophase vars)) 7)))
(format t "CTL OUTPUT ACTUAL ARM SOURCE CONTROLS PASS: retained loan, bad source, checked zero-cap EOF, final Send handback~%")
;; Handback acknowledgement wakes CNS before this request tuple is dropped;
;; no source lease release is hidden in the transport's callback sequence.
(let ((*results* '((fn2-cns-stream-source-finish :ok) (fn2-core-reset :ok))))
 (multiple-value-bind (effects vars)
  (run *out-arm* (append '((row-ophase . 7) (*fn2-none* . 999)
                           (*fn2-ctl-output-none* . 0) (*fn2-ctl-stream-none* . 0)) *out-vars*))
  (assert (member '(:call fn2-cns-stream-source-finish) effects :test #'equal))
  (assert (member '(:wake-row row-cns) effects :test #'equal))
  (assert (member '(:next :frame) effects :test #'equal))
  (assert (= (cdr (assoc 'row-cns vars)) 999))
  (assert (= (cdr (assoc 'row-cns-gen vars)) 0))))
;; An unproductive successful next cannot spin forever or authorize EOF.
(let ((*results* '((fn2-cns-stream-source-next :ok 0 nil))))
 (multiple-value-bind (effects vars) (run *out-arm* (cons '(row-ophase . 2) *out-vars*))
  (declare (ignore vars))
  (assert (member '(:next :closing) effects :test #'equal))))
(format t "CTL OUTPUT HANDBACK SOURCE CONTROLS PASS: checked child wake, tuple clear, zero-progress refusal~%")
;; Execute the actual status function on mocked physical row observations.
(defparameter *query-held* nil)
(defun fn2-core-query-heldp (slot gen &optional core)
 (declare (ignore slot gen core)) *query-held*)
(defun fn2-machine-pool-borrows-read-code (slot &optional core)
 (declare (ignore slot core)) :ok)
(defun fn2-machine-pool-borrows (slot &optional core)
 (declare (ignore slot core)) *borrow-count*)
(defun fn2-ctl-stream-child-live-p (child gen &optional core)
 (declare (ignore core)) (and (= child 4) (= gen 5)))
(defparameter *fn2-ctl-state-closing* 10)
(defparameter *fn2-ctl-state-draining* 11)
(defparameter *fn2-ctl-state-stream-reply* 12)
(defparameter *fn2-ctl-state-waiting* 13)
(defparameter *fn2-ctl-output-done* 7)
(defparameter *fn2-ctl-output-cancelled* 9)
(loop for (name key default) in
 '((fn2-ctl-row-cns :child 4) (fn2-ctl-row-cns-gen :child-gen 5)
   (fn2-ctl-row-phase :phase 12) (fn2-ctl-row-ophase :output 2)
   (fn2-ctl-row-rx-slot :slot 1) (fn2-ctl-row-rx-gen :slot-gen 2)
   (fn2-ctl-row-pending :pending 0) (fn2-ctl-row-borrows :borrows 0))
 do (eval `(defun ,name (ctl core) (declare (ignore ctl)) (getf core ,key ,default))))
(with-open-file (in "books/ctl-output-events.lisp")
 (loop for form = (read in nil :end) until (eq form :end) do
  (when (and (consp form) (eq (car form) 'defmacro)
             (eq (cadr form) 'fn2-ctl-output-status-events))
   (eval (second (fourth form))))))
(assert (eq (fn2-ctl-stream-reply-status 1 2 3 4 5 '(:phase 10 :output 9)) :aborting))
(assert (eq (fn2-ctl-stream-reply-status 1 2 3 4 5 '(:phase 11 :pending 1)) :aborting))
(let ((*borrow-count* 1))
 (assert (eq (fn2-ctl-stream-reply-status 1 2 3 4 5 '(:phase 11)) :aborting)))
(let ((*query-held* t))
 (assert (eq (fn2-ctl-stream-reply-status 1 2 3 4 5 '(:phase 11)) :aborting)))
(assert (eq (fn2-ctl-stream-reply-status 1 2 3 4 5 '(:phase 11)) :cancelled))
(assert (eq (fn2-ctl-stream-reply-status 1 2 3 4 5 '(:phase 12 :output 7)) :handback))
(assert (eq (fn2-ctl-stream-reply-status 1 2 99 4 5 '(:phase 11)) :stale))
;; Actual draining arm re-notifies after the terminal close/borrow wake.
(multiple-value-bind (effects vars)
 (run (cdr (assoc :draining (getf (cdddr *ctl*) :arms)))
      '((row-pending . 0) (row-borrows . 0) (row-cns . 4) (row-cns-gen . 5)
        (row-ophase . 9) (*fn2-ctl-output-cancelled* . 9)))
 (declare (ignore vars))
 (assert (member '(:wake-row row-cns) effects :test #'equal)))
(format t "CTL ACTUAL CANCEL STATUS CONTROLS PASS: pending/borrow/query holds, closed quiescence, stale request, final re-notify~%")

;; Issued Send spans are nonempty; a zero-count terminal cannot cause an
;; endless retry of the same loan or authorize source handback.
(multiple-value-bind (effects vars)
 (run (cdddr (assoc :send-result (getf (cdddr *ctl*) :observes)))
      '((row-rx-slot . 1) (row-tx-off . 0) (row-tx-len . 32)
        (outcome . 1) (count . 0) (*fn2-outcome-done* . 1) (*fn2-outcome-short* . 2)))
 (declare (ignore vars))
 (assert (member '(:next :closing) effects :test #'equal)))
(format t "CTL SEND SOURCE CONTROL PASS: zero-progress terminal closes~%")

; Actual C seeded transactions + actual sealer/reader, stopped immediately at
; atomic publication. Includes the existing real read harness, not a new core.
; Query refs are injected through the real pool API as an adversarial component
; hold; the current public TxnOffer producer does not pin old C arenas this way.
; Prepared, unexecuted. This is not a disk-checkpoint/Fence adoption witness.
(in-package "ACL2")
(include-book "read-unit")

(defun fn2-drp-first (fuel x fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-read-next x 512 fn2-core)
   (if (eq code :more) (fn2-drp-first (- fuel 1) x fn2-core) (mv code fn2-core)))))

; Acquire a genuine reference to the arena of the actually delivered line.
; Owner/range come from the typed delivered field and actual pool row.
(defun fn2-drp-pin-line (x fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-reads (fn2-core-reads fn2-core))
             (fn2-run-installed (fn2-core-run-installed fn2-core))
             (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
  (code slot gen fn2-pool)
  (b* (((mv code row) (fn2-rd-entry-row x *fn2-overview-entry-field-line* fn2-reads fn2-run-installed fn2-fields))
       ((unless (eq code :ok)) (mv code 0 0 fn2-pool))
       (slot (fn2-fields-ref-slot row fn2-fields)) (gen (fn2-fields-ref-gen row fn2-fields))
       (off (fn2-fields-ref-off row fn2-fields)) (len (fn2-fields-ref-len row fn2-fields))
       ((unless (and (< slot (fn2-pool-rows fn2-pool)) (posp len))) (mv :field slot gen fn2-pool))
       ((mv code fn2-pool) (fn2-pool-query-acquire slot gen off len
        (fn2-pool-owner-kind slot fn2-pool) (fn2-pool-owner-slot slot fn2-pool)
        (fn2-pool-owner-gen slot fn2-pool) fn2-pool)))
   (mv code slot gen fn2-pool))
  (mv code slot gen fn2-core)))

(defun fn2-drp-target-p (slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-seals (fn2-core-seals fn2-core)) (fn2-overlays (fn2-core-overlays fn2-core)))
  (yes)
  (and (< 0 (fn2-seals-rows fn2-seals))
       (= (fn2-seals-phase 0 fn2-seals) *fn2-seal-phase-overlay-return*)
       (= (fn2-seals-sid 0 fn2-seals) *fn2-cursor-overview-sid*)
       (< (fn2-seals-o 0 fn2-seals) (fn2-overlays-rows fn2-overlays))
       (= (fn2-overlays-slot (fn2-seals-o 0 fn2-seals) fn2-overlays) slot)
       (= (fn2-overlays-gen (fn2-seals-o 0 fn2-seals) fn2-overlays) gen))
  yes))
(defun fn2-drp-to-publication (fuel slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond ((fn2-drp-target-p slot gen fn2-core) (mv :published fn2-core))
       ((zp fuel) (mv :fuel fn2-core))
       (t (mv-let (code fn2-core) (fn2-sealer-step 4096 fn2-core)
           (if (member-eq code '(:more :retired :done))
               (fn2-drp-to-publication (- fuel 1) slot gen fn2-core)
             (mv code fn2-core))))))
(defun fn2-drp-retained-p (slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-seals (fn2-core-seals fn2-core)) (fn2-overlays (fn2-core-overlays fn2-core))
             (fn2-pool (fn2-core-pool fn2-core)))
  (yes)
  (and (< slot (fn2-pool-rows fn2-pool))
       (< (fn2-seals-o 0 fn2-seals) (fn2-overlays-rows fn2-overlays))
       (= (fn2-overlays-phase (fn2-seals-o 0 fn2-seals) fn2-overlays) *fn2-overlay-phase-draining*)
       (posp (fn2-overlays-count (fn2-seals-o 0 fn2-seals) fn2-overlays))
       (= (fn2-pool-slot-gen slot fn2-pool) gen)
       (eq (fn2-pool-slot-state slot fn2-pool) :workspace)
       (= (fn2-pool-query-ref-count slot fn2-pool) 1)
       (= (fn2-pool-credit-group slot fn2-pool) *fn2-none*)
       (= (fn2-pool-credit-nonce slot fn2-pool) 0)
       (< (fn2-seals-rslot 0 fn2-seals) (fn2-pool-rows fn2-pool))
       (< (fn2-seals-hslot 0 fn2-seals) (fn2-pool-rows fn2-pool))
       (= (fn2-pool-credit-group (fn2-seals-rslot 0 fn2-seals) fn2-pool) *fn2-none*)
       (= (fn2-pool-credit-nonce (fn2-seals-rslot 0 fn2-seals) fn2-pool) 0)
       (= (fn2-pool-credit-group (fn2-seals-hslot 0 fn2-seals) fn2-pool) *fn2-none*)
       (= (fn2-pool-credit-nonce (fn2-seals-hslot 0 fn2-seals) fn2-pool) 0)
       (fn2-seal-pending-p fn2-seals fn2-overlays))
  yes))
(defun fn2-drp-close (slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
  (code last fn2-pool) (fn2-pool-query-release slot gen fn2-pool)
  (mv code last fn2-core)))

(defun fn2-drp-run (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-rdu-profile* :null nil fn2-core))
      ((mv seeded & fn2-core) (fn2-cs-seed-all *fn2-rdu-seeds* 1 fn2-core))
      ((mv reserved out ogen fn2-core) (fn2-core-reserve 0 200 0 1 fn2-core))
      ((mv started fn2-core)
       (fn2-cs-chain (fn2-read-key 0 :lo 0 1 fn2-core) (fn2-read-key 0 :lo 1 0 fn2-core)
        (fn2-read-key 0 :hi 0 1 fn2-core) (fn2-read-key 0 :hi 1 *fn2-rdu-max* fn2-core)
        (fn2-read-range 0 *fn2-cursor-overview-sid* *fn2-range-no-position* 0 fn2-core)))
      ((mv entry fn2-core) (fn2-drp-first 200 0 fn2-core))
      ((mv before fn2-core) (fn2-rdu-entry 0 out ogen fn2-core))
      ((mv pinned slot gen fn2-core) (fn2-drp-pin-line 0 fn2-core))
      ((mv published fn2-core) (fn2-drp-to-publication 4000 slot gen fn2-core))
      (retained-before (fn2-drp-retained-p slot gen fn2-core))
      ((mv held fn2-core) (fn2-sealer-step 4096 fn2-core))
      (retained-after (fn2-drp-retained-p slot gen fn2-core))
      ((mv value-code &) (fn2-read-value 0 *fn2-overview-entry-field-number* fn2-core))
      ((mv octet-code & & fn2-core) (fn2-read-octets 0 *fn2-overview-entry-field-line* 0 4 out ogen 0 200 0 1 fn2-core))
      ((mv rest & fn2-core) (fn2-rdu-walk 200 0 nil out ogen nil nil fn2-core))
      ((mv released fn2-core) (fn2-read-release 0 fn2-core))
      ((mv closed last fn2-core) (fn2-drp-close slot gen fn2-core))
      ((mv arena-return fn2-core) (fn2-sealer-step 4096 fn2-core))
      ((mv hash-return fn2-core) (fn2-sealer-step 4096 fn2-core))
      (no-longer-workspace (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (yes)
       (member-eq (fn2-pool-slot-state slot fn2-pool) '(:free :retired)) yes)))
  (mv (and (eq seeded :ok) (eq reserved :ok) (eq started :ok) (eq entry :entry)
           (equal before (car *fn2-rdu-three*)) (eq pinned :ok) (eq published :published)
           retained-before (eq held :held) retained-after
           (eq value-code :stale) (eq octet-code :stale)
           (equal rest (cdr *fn2-rdu-three*)) (eq released :ok) (eq closed :ok) last
           (eq arena-return :more) (eq hash-return :done) no-longer-workspace)
      fn2-core)))
(assert-event
 (with-local-stobj fn2-core
  (mv-let (ok fn2-core) (fn2-drp-run fn2-core) ok)))

(defun fnn-owner-page-read-startup (root connections cold output retain)
  (declare (ignore root connections cold output))
  (push :preflight *events*)
  (when (eq *mode* :refused) (error 'fixture-stop))
  (setf *installed* t)
  (funcall retain)
  (push :pool-installed *events*)
  (when (eq *mode* :table-error) (error 'fixture-stop))
  (setf *workers* t *fnn-cold-workers* '(:owned))
  (push :executor-start *events*)
  :started)
(defun fnn-owner-install (&rest args)

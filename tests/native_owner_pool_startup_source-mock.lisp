(defun helper-case (label plan word expected events)
  (let ((*plan* plan) (*install-word* word) (*events* nil))
    (assert
     (= (handler-case
            (progn (funcall *actual-startup* "/scratch" 2 nil nil
                            (lambda () (push :retain *events*))) 0)
          (fixture-stop () 1) (fixture-uncertain () 3) (fixture-fault () 4)) expected))
    (assert (equal (reverse *events*) events))
    (format t "~a events=~s code=~d~%" label (reverse *events*) expected)))
(helper-case :startup-order '(:admitted :budget :baseline 11 12 99 4 21) :installed
  0 '(:preflight :install :retain :tables :guards :workers))
(let ((*fnn-arena-release-custody* (vector :calling)))
  (helper-case :prior-arena-debt '(:admitted :budget :baseline 11 12 99 4 21) :installed 3 '(:retain)))
(helper-case :startup-refusal '(:refused :insufficient) :installed 1 '(:preflight))
(helper-case :malformed-admitted '(:admitted) :installed 4 '(:preflight))
(helper-case :unknown-status '(:unexpected) :installed 4 '(:preflight))
(helper-case :already-installed '(:admitted :budget :baseline 11 12 99 4 21)
  :already-installed 1 '(:preflight :install))

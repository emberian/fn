(let ((*peer-policy* :policy) (*peer-grant* '(:refused :peer-native-reservation-not-held)))
 (helper-case :peer-native-refusal '(:admitted :budget :baseline 11 12 99 4 21)
              :installed 1 '(:preflight :peer-check)))
(let* ((*peer-policy* :policy)
       (capture '(1000 100 :policy 8192 1024))
       (*peer-grant* (list :hold capture))
       (*plan* '(:admitted :budget :baseline 11 12 99 4 21))
       (*install-word* :installed) (*events* nil))
 (multiple-value-bind (plan returned)

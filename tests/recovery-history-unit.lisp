; Actual writer/decode -> actual M7 adapters. Synthetic owned test windows and
; initialized core are premises. This checks tentative identity propagation and
; body agreement; it does not claim a seal/hash/IO or chain-publication witness.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/assembly")
(defun fn2-rh-input (kind history incarnation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
  (ok fn2-fields fn2-pool)
  (b* ((fn2-fields (fn2-fields-init 1024 fn2-fields))
       (fn2-pool (fn2-pool-init '((2 . 4096)) 1 100 fn2-pool))
       ((mv a slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
       ((mv b scratch sgen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
       (fn2-pool (fn2-pool-set-fill scratch 4096 fn2-pool))
       ((mv code end fn2-fields fn2-pool)
        (fn2-commit-pack kind 2 0 slot gen 0 scratch sgen 0 3 5 12 21 1 1 0 1 101 103 107 history incarnation fn2-fields fn2-pool))
       ((mv decoded next fn2-fields)
        (if (eq kind :frame)
         (fn2-format-frame-header-decode *fn2-rec-field-base* slot gen 0 end 1 0 1 fn2-fields fn2-pool)
         (fn2-format-sealed-batch-decode *fn2-rec-field-base* slot gen 0 end 1 0 1 fn2-fields fn2-pool))))
   (mv (and (eq a :ok) (eq b :ok) (eq code :ok) (eq decoded :ok) (= next end)) fn2-fields fn2-pool))
  (mv ok fn2-core)))
(defun fn2-rh-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (put-assoc-equal :history-id 37 (put-assoc-equal :history-incarnation 41
       (put-assoc-equal :origin-lineage 101 (put-assoc-equal :origin-domain 103 (put-assoc-equal :origin-incarnation 107 *fn2-profile-tiny*))))))
      (fn2-core (fn2-core-init profile fn2-core))
      ((mv unbound fn2-core) (fn2-recovery-context 0 2 3 5 12 0 0 fn2-core))
      ((mv frame fn2-core) (fn2-rh-input :frame 29 31 fn2-core))
      ((mv header commit epoch allocation payload fn2-core) (fn2-recovery-header 0 fn2-core))
      ((mv context fn2-core) (fn2-recovery-context 0 2 epoch allocation commit 0 0 fn2-core))
      (retained (stobj-let ((fn2-rec-cand (fn2-core-rec-cand fn2-core)) (fn2-fc-context (fn2-core-fc-context fn2-core))
                           (fn2-origin (fn2-core-origin fn2-core))) (ok)
       (and (= (fn2-rec-cand-history 0 fn2-rec-cand) 29) (= (fn2-rec-cand-history-incarnation 0 fn2-rec-cand) 31)
        (= (fn2-fc-context-history *fn2-rec-checker-row* fn2-fc-context) 29)
        (= (fn2-fc-context-incarnation *fn2-rec-checker-row* fn2-fc-context) 31)
        (= (fn2-origin-history fn2-origin) 37) (= (fn2-origin-history-incarnation fn2-origin) 41)
        (= (fn2-origin-lineage fn2-origin) 101) (= (fn2-origin-domain fn2-origin) 103) (= (fn2-origin-incarnation fn2-origin) 107)
        (= (fn2-rec-cand-status 0 fn2-rec-cand) *fn2-rec-status-unread*)) ok))
      ((mv body fn2-core) (fn2-rh-input :seal 29 31 fn2-core))
      ((mv agreement first last prev final records deps) (fn2-recovery-seal-fields 0 commit epoch allocation fn2-core))
      ((mv wrong fn2-core) (fn2-rh-input :seal 37 41 fn2-core))
      ((mv mismatch wrong-first wrong-last wrong-prev wrong-final wrong-records wrong-deps)
       (fn2-recovery-seal-fields 0 commit epoch allocation fn2-core)))
  (mv (and (eq unbound :bounds) frame header (eq context :ok) retained body agreement wrong (not mismatch)
       (= commit 12) (= epoch 3) (= allocation 5) (= payload 3900) (= first 21) (= last 21)
       (= first wrong-first) (= last wrong-last) (= prev wrong-prev) (= final wrong-final)
       (= records wrong-records) (= deps wrong-deps)) fn2-core)))
(defun fn2-rh-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-rh-body fn2-core) ok)))
(assert-event (fn2-rh-run))

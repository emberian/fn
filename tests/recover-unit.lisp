(in-package "ACL2")
(include-book "../sim/recover-stub")
(include-book "std/util/bstar" :dir :system)

; Test-only traversal exercises actual byte images, no mirrored classifier.
(defun fn2-recover-test-run (fn2-recovery-image)
  (declare (xargs :stobjs fn2-recovery-image :verify-guards nil))
  (b* ((fn2-recovery-image (fn2-recovery-init 3 fn2-recovery-image))
       ((mv code & & & &) (fn2-recover-stub 0 nil fn2-recovery-image))
       ((unless (eq code :intact)) (mv :empty fn2-recovery-image))
       ((mv code & & & &) (fn2-recover-stub 1 nil fn2-recovery-image))
       ((unless (eq code :damaged)) (mv :lost-entire-image fn2-recovery-image))
       (fn2-recovery-image (fn2-recovery-stamp 0 fn2-recovery-image))
       (fn2-recovery-image (fn2-recovery-stamp 1 fn2-recovery-image))
       ((mv code valid & & &) (fn2-recover-stub 2 nil fn2-recovery-image))
       ((unless (and (eq code :intact) (= valid 2))) (mv :valid-prefix fn2-recovery-image))
       (fn2-recovery-image (fn2-recovery-put-byte 100 42 fn2-recovery-image))
       ((mv code & & & &) (fn2-recover-stub 2 nil fn2-recovery-image))
       ((unless (eq code :damaged)) (mv :corrupt-middle fn2-recovery-image))
       (fn2-recovery-image (fn2-recovery-stamp 0 fn2-recovery-image))
       (fn2-recovery-image (fn2-recovery-put-byte 5000 42 fn2-recovery-image))
       ((mv code & & & &) (fn2-recover-stub 1 nil fn2-recovery-image))
       ((unless (eq code :unknown)) (mv :broad-final fn2-recovery-image))
       ((mv code & & & &) (fn2-recover-stub 1 t fn2-recovery-image))
       ((unless (eq code :torn-tail)) (mv :crash-final fn2-recovery-image))
       (fn2-recovery-image (fn2-recovery-stamp 1 fn2-recovery-image))
       (fn2-recovery-image (fn2-recovery-put-u32 4104 0 fn2-recovery-image))
       ((unless (eq (fn2-recovery-sector 1 fn2-recovery-image) :misdirected))
        (mv :wrong-address fn2-recovery-image))
       ((mv code & & & &) (fn2-recover-stub 2 nil fn2-recovery-image))
       ((unless (eq code :damaged)) (mv :misdirected-ack fn2-recovery-image)))
    (mv :pass fn2-recovery-image)))

(defun fn2-recover-test ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-recovery-image
    (mv-let (code fn2-recovery-image) (fn2-recover-test-run fn2-recovery-image) code)))
(assert-event (eq (fn2-recover-test) :pass))

(defun fn2-recover-hole-test-run (fn2-recovery-image)
  (declare (xargs :stobjs fn2-recovery-image :verify-guards nil))
  (b* ((fn2-recovery-image (fn2-recovery-init 3 fn2-recovery-image))
       (fn2-recovery-image (fn2-recovery-stamp 1 fn2-recovery-image))
       ((mv broad & & & &) (fn2-recover-stub 0 nil fn2-recovery-image))
       ((mv crash & & & &) (fn2-recover-stub 0 t fn2-recovery-image))
       ((mv ack & & & &) (fn2-recover-stub 1 t fn2-recovery-image)))
    (mv (and (eq broad :unknown) (eq crash :torn-tail) (eq ack :damaged)) fn2-recovery-image)))
(defun fn2-recover-hole-test ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-recovery-image
    (mv-let (ok fn2-recovery-image) (fn2-recover-hole-test-run fn2-recovery-image) ok)))
(assert-event (fn2-recover-hole-test))

; A process may die after sector zero, losing cursor and accumulators. The
; immutable byte image is re-opened, not shortened to the prefix scanned so far.
(defun fn2-recover-interrupted-run (fn2-recovery-image)
  (declare (xargs :stobjs fn2-recovery-image :verify-guards nil))
  (b* ((fn2-recovery-image (fn2-recovery-init 3 fn2-recovery-image))
       (fn2-recovery-image (fn2-recovery-stamp 0 fn2-recovery-image))
       (fn2-recovery-image (fn2-recovery-stamp 1 fn2-recovery-image))
       (fn2-recovery-image (fn2-recovery-stamp 2 fn2-recovery-image))
       (fn2-recovery-image (fn2-recovery-put-byte 9000 17 fn2-recovery-image))
       ((mv code n tail damage) (fn2-recover-start 2 fn2-recovery-image))
       ((unless (eq code :ok)) (mv nil fn2-recovery-image))
       ((mv done next tail damage valid never bad misplaced)
        (fn2-recover-step 0 n 2 tail damage 0 0 0 0 fn2-recovery-image))
       ((unless (and (not done) (= next 1) (= valid 1) (= bad 0)))
        (mv nil fn2-recovery-image))
       ; Control: complete from the saved progress.
       ((mv tail damage valid never bad misplaced)
        (fn2-recover-scan next n 2 tail damage valid never bad misplaced fn2-recovery-image))
       (control (list (fn2-recover-classification nil tail damage) valid never bad misplaced))
       ; Death: discard every scalar and restart from the exact same image.
       ((mv class valid never bad misplaced) (fn2-recover-stub 2 nil fn2-recovery-image)))
    (mv (and (equal control '(:unknown 2 0 1 0))
             (equal (list class valid never bad misplaced) control)) fn2-recovery-image)))
(defun fn2-recover-interrupted-test ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-recovery-image
    (mv-let (ok fn2-recovery-image) (fn2-recover-interrupted-run fn2-recovery-image) ok)))
(assert-event (fn2-recover-interrupted-test))

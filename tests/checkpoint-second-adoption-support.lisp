; PREPARED, UNEXECUTED same-SIM ancestry. Client REGISTER/APPEND is real
; transport. The later direct READ is a primitive actual-owned CNS resource
; control, not an additional signed-client/FETCH witness. Every page comes
; through real MISS selection, pinned BREAD, SIM completion and verification.
(in-package "ACL2")
(include-book "checkpoint-live-network-prefix-support")
(defconst *fn2-sad-article*
 (append (fn2-fc-string-bytes "From: test@example.invalid" 0) '(13 10)
         (fn2-fc-string-bytes "Subject: actual adoption" 0) '(13 10)
         (fn2-fc-string-bytes "Newsgroups: local.test" 0) '(13 10 13 10)
         (fn2-fc-string-bytes "same simulator, physical source" 0) '(13 10)))
(defun fn2-sad-create (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-ccp-profile* :node nil fn2-core))
      (fn2-sim (fn2-sim-init 1 :none "second-adoption" *fn2-ccp-profile* fn2-sim))
      (fn2-own (fn2-own-init *fn2-ccp-profile* fn2-own))
      ((mv started fn2-core) (fn2-boot-start t *fn2-ccp-image-size* fn2-core))
      ((mv created fn2-core fn2-sim fn2-own) (fn2-ccp-drive 200000 nil fn2-core fn2-sim fn2-own)))
  (mv (if (and (eq started :ok) (eq created :ready)) :created :create) fn2-core fn2-sim fn2-own)))
; Completion test is the real master cleanup terminal, not just APPLIED.
(defun fn2-sad-adopt (fuel fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (cond ((fn2-core-stopped-p fn2-core) (mv :stopped fn2-core fn2-sim fn2-own))
       ((fn2-ccp-live-complete-p t 0 fn2-core) (mv :complete fn2-core fn2-sim fn2-own))
       ((zp fuel) (mv :fuel fn2-core fn2-sim fn2-own))
       (t (mv-let (code fn2-core fn2-sim fn2-own) (fn2-cln-pump nil 1 fn2-core fn2-sim fn2-own)
           (if (eq code :failed) (mv code fn2-core fn2-sim fn2-own)
            (fn2-sad-adopt (1- fuel) fn2-core fn2-sim fn2-own))))))
(defun fn2-sad-register-flight (fuel op gen fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (cond ((and (< op (fn2-sim-rows fn2-sim)) (equal (fn2-sim-active op fn2-sim) 1)
             (equal (fn2-sim-gen op fn2-sim) gen)) (mv :registered fn2-core fn2-sim fn2-own))
       ((zp fuel) (mv :queue fn2-core fn2-sim fn2-own))
       (t (mv-let (taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own)
           (if (equal taken 1) (fn2-sad-register-flight (1- fuel) op gen fn2-core fn2-sim fn2-own)
            (mv :queue fn2-core fn2-sim fn2-own))))))
(defun fn2-sad-load (fuel owner generation fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (b* (((when (zp fuel)) (mv :fuel 0 fn2-core fn2-sim fn2-own))
      ((mv phase c & fn2-core) (fn2-c-actor-loader-state owner generation fn2-core)))
  (case phase
   (:clear (mv :loaded 0 fn2-core fn2-sim fn2-own))
   (:bind (mv-let (code fn2-core) (fn2-run-page-bind c *fn2-cns-kind* owner generation fn2-core)
           (if (eq code :need-read) (fn2-sad-load (1- fuel) owner generation fn2-core fn2-sim fn2-own)
            (mv code 0 fn2-core fn2-sim fn2-own))))
   (:step (mv-let (code fn2-core) (fn2-run-page-step c 4096 fn2-core)
           (if (member-eq code '(:more :ready :need-read)) (fn2-sad-load (1- fuel) owner generation fn2-core fn2-sim fn2-own)
            (mv code 0 fn2-core fn2-sim fn2-own))))
   (:read
    (b* (((mv code op gen fn2-core) (fn2-run-page-read c 4096 fn2-core))
         ((unless (eq code :ok)) (mv code 0 fn2-core fn2-sim fn2-own))
         (rows (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (rows) (fn2-ops-rows fn2-ops) rows))
         ((mv registered fn2-core fn2-sim fn2-own) (fn2-sad-register-flight (+ rows 1) op gen fn2-core fn2-sim fn2-own))
         ((unless (eq registered :registered)) (mv registered 0 fn2-core fn2-sim fn2-own))
         ((mv done fn2-core fn2-sim fn2-own) (fn2-sim-complete op *fn2-fault-none* 1 fn2-core fn2-sim fn2-own))
         ((mv harvested & & & & fn2-core) (fn2-exec-harvest fn2-core))
         (settled (stobj-let ((fn2-run-loads (fn2-core-run-loads fn2-core))
                              (fn2-run-load-ops (fn2-core-run-load-ops fn2-core))) (settled)
          (and (equal (fn2-run-loads-pending c fn2-run-loads) 0)
               (equal (fn2-run-load-ops-live op fn2-run-load-ops) 0)
               (equal (fn2-run-loads-phase c fn2-run-loads) *fn2-run-load-phase-copy*)) settled))
         ((unless (and done (equal harvested 1) settled (eq (fn2-check-own fn2-core fn2-own) :pass)))
          (mv :completion 0 fn2-core fn2-sim fn2-own))
         ((mv code reads fn2-core fn2-sim fn2-own) (fn2-sad-load (1- fuel) owner generation fn2-core fn2-sim fn2-own)))
     (mv code (+ reads 1) fn2-core fn2-sim fn2-own)))
   (otherwise (mv phase 0 fn2-core fn2-sim fn2-own)))))
(defun fn2-sad-read (fuel ranged x owner generation fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (b* (((when (zp fuel)) (mv :fuel 0 0 fn2-core fn2-sim fn2-own))
      ((mv code fn2-core) (if ranged (fn2-read-next x 1 fn2-core)
                           (fn2-read-lookup x *fn2-txn-counts-sid* 1 fn2-core))))
  (case code
   (:ok (mv-let (value-code value) (fn2-read-value x *fn2-group-counts-entry-field-count* fn2-core)
         (mv value-code value 0 fn2-core fn2-sim fn2-own)))
   (:more (fn2-sad-read (1- fuel) ranged x owner generation fn2-core fn2-sim fn2-own))
   (:miss (b* (((mv loaded reads fn2-core fn2-sim fn2-own) (fn2-sad-load 20000 owner generation fn2-core fn2-sim fn2-own))
               ((unless (eq loaded :loaded)) (mv loaded 0 reads fn2-core fn2-sim fn2-own))
               ((mv code value rest fn2-core fn2-sim fn2-own) (fn2-sad-read (1- fuel) ranged x owner generation fn2-core fn2-sim fn2-own)))
           (mv code value (+ reads rest) fn2-core fn2-sim fn2-own)))
   (otherwise (mv code 0 0 fn2-core fn2-sim fn2-own)))))
(defun fn2-sad-direct-query (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((mv taken owner generation fn2-core)
       (fn2-machine-take-fn2-cns *fn2-none* *fn2-none* 0 1 0 0 4 *fn2-none* 0 fn2-core))
      ((unless (eq taken :ok)) (mv taken 0 0 0 fn2-core fn2-sim fn2-own))
      ((mv planned kind b0 n0 b1 n1 b2 n2) (fn2-c-actor-loader-plan owner generation fn2-core))
      ((mv reserved complete fn2-core) (fn2-c-actor-loader-reserve owner generation fn2-core))
      (transactions (stobj-let ((fn2-id-decides (fn2-core-id-decides fn2-core))) (rows) (fn2-id-decides-rows fn2-id-decides) rows))
      (x (- b1 transactions))
      ((unless (and (eq planned :ok) (equal kind *fn2-cns-kind*) (equal n1 1) (eq reserved :ok) (equal complete 1)))
       (mv :resources 0 owner generation fn2-core fn2-sim fn2-own))
      ((mv key fn2-core) (fn2-read-key x :lo *fn2-group-counts-entry-field-group* 1 fn2-core))
      ((mv lookup value lreads fn2-core fn2-sim fn2-own) (fn2-sad-read 20000 nil x owner generation fn2-core fn2-sim fn2-own))
      ((mv released fn2-core) (fn2-read-release x fn2-core))
      ((mv lo fn2-core) (fn2-read-key x :lo *fn2-group-counts-entry-field-group* 1 fn2-core))
      ((mv hi fn2-core) (fn2-read-key x :hi *fn2-group-counts-entry-field-group* 2 fn2-core))
      ((mv range fn2-core) (fn2-read-range x *fn2-txn-counts-sid* *fn2-range-no-position* 0 fn2-core))
      ((mv ranged rvalue rreads fn2-core fn2-sim fn2-own) (fn2-sad-read 20000 t x owner generation fn2-core fn2-sim fn2-own))
      ((mv closed fn2-core) (fn2-read-release x fn2-core))
      ((mv cleaned fn2-core)
       (stobj-let ((fn2-run-loads (fn2-core-run-loads fn2-core)) (fn2-run-cursors (fn2-core-run-cursors fn2-core))
                   (fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
                   (fn2-checkpoint-summary-leases (fn2-core-checkpoint-summary-leases fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
        (code fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
        (fn2-run-load-region-clean 0 b0 n0 b1 n1 b2 n2 kind owner generation fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
        (mv code fn2-core))))
  (mv (if (and (eq key :ok) (eq lookup :ok) (equal value 1) (<= *fn2-storage-extent-units* lreads)
               (eq released :ok) (eq lo :ok) (eq hi :ok) (eq range :ok) (eq ranged :ok) (equal rvalue 1)
               (<= *fn2-storage-extent-units* rreads) (eq closed :ok) (eq cleaned :ok)) :productive :query)
      (+ lreads rreads) owner generation fn2-core fn2-sim fn2-own)))

; Let the queued actual CNS owner follow its ordinary invalid-frame/draining
; path after the isolated primitive read. No machine phase or ready bit is set.
(defun fn2-sad-drain-query (fuel owner generation fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (cond ((and (eq (fn2-cns-snapshot-read-code owner fn2-core) :ok)
             (or (not (equal (fn2-machine-generation owner fn2-core) generation))
                 (member (fn2-machine-phase owner fn2-core) (list *fn2-cns-state-free* *fn2-cns-state-retired*))))
        (mv :drained fn2-core fn2-sim fn2-own))
       ((zp fuel) (mv :fuel fn2-core fn2-sim fn2-own))
       (t (mv-let (code fn2-core fn2-sim fn2-own) (fn2-cln-pump nil 1 fn2-core fn2-sim fn2-own)
           (if (eq code :failed) (mv code fn2-core fn2-sim fn2-own)
            (fn2-sad-drain-query (1- fuel) owner generation fn2-core fn2-sim fn2-own))))))
(defun fn2-sad-physical-count (i fn2-run-installed)
 (declare (xargs :stobjs fn2-run-installed :verify-guards nil
  :measure (nfix (- (fn2-run-installed-rows fn2-run-installed) (nfix i)))))
 (if (>= (nfix i) (fn2-run-installed-rows fn2-run-installed)) 0
  (+ (if (and (not (equal (fn2-run-installed-state i fn2-run-installed) *fn2-run-installed-state-free*))
              (equal (fn2-run-installed-physical i fn2-run-installed) 1)) 1 0)
     (fn2-sad-physical-count (+ 1 (nfix i)) fn2-run-installed))))
(defun fn2-sad-current (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
             (fn2-checkpoint-summary-authority (fn2-core-checkpoint-summary-authority fn2-core))
             (fn2-c-source-control (fn2-core-c-source-control fn2-core)) (fn2-run-installed (fn2-core-run-installed fn2-core))) (ok tag checkpoint cut)
  (mv (and (equal (fn2-checkpoint-summary-phase 0 fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-applied*)
           (equal (fn2-checkpoint-summary-phase 1 fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-idle*)
           (equal (fn2-checkpoint-summary-authority-phase 0 fn2-checkpoint-summary-authority) *fn2-checkpoint-summary-authority-phase-complete*)
           (equal (fn2-checkpoint-summary-authority-phase 1 fn2-checkpoint-summary-authority) *fn2-checkpoint-summary-authority-phase-idle*)
           (equal (fn2-c-source-control-phase 0 fn2-c-source-control) *fn2-c-source-writer-phase-idle*)
           (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 0)
           (posp (fn2-run-installed-physical-count fn2-run-installed))
           (equal (fn2-run-installed-physical-count fn2-run-installed) (fn2-sad-physical-count 0 fn2-run-installed)))
      (fn2-checkpoint-summary-tag 0 fn2-checkpoint-summary)
      (fn2-checkpoint-summary-checkpoint 0 fn2-checkpoint-summary)
      (fn2-checkpoint-summary-cut-commit 0 fn2-checkpoint-summary))
  (mv ok tag checkpoint cut)))

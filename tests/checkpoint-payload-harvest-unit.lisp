; Source controls: actual operation lifecycle; payload binding is an explicit
; synthetic premise. These do not assert semantic source admission or boot ready.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/runs-page")
(include-book "../books/checkpoint-payload-harvest")
(defun fn2-cphu-body (variant fn2-checkpoint-payload fn2-ops)
 (declare (xargs :stobjs (fn2-checkpoint-payload fn2-ops) :verify-guards nil))
 (b* ((fn2-ops (fn2-ops-init *fn2-profile-tiny* fn2-ops))
      (fn2-checkpoint-payload (fn2-checkpoint-payload-init 1 fn2-checkpoint-payload))
      ((mv reserved slot gen fn2-ops) (fn2-op-reserve *fn2-action-read* 7 0 1 0 0 fn2-ops))
      ((mv ranged fn2-ops) (fn2-op-set-range slot gen 4 5 0 3 fn2-ops))
      ((mv queued fn2-ops) (fn2-op-enqueue slot gen fn2-ops))
      ((mv acked fn2-ops) (fn2-outbox-ack 1 fn2-ops))
      (fn2-ops (fn2-post-result 0 slot gen *fn2-event-read-result* *fn2-outcome-done* *fn2-reason-none* 3 0 0 fn2-ops))
      ((mv found hslot hgen cell fn2-ops) (fn2-harvest-next fn2-ops))
      (cold (eq variant :cold))
      (ignored (not (eq variant :live)))
      (fn2-checkpoint-payload (fn2-checkpoint-payload-put 0
       (mode (if cold *fn2-checkpoint-payload-mode-cold* *fn2-checkpoint-payload-mode-live*))
       (phase *fn2-checkpoint-payload-phase-wait-block*) (pending 1)
       (op-slot slot) (op-gen gen) (owner-kind 7) (owner-slot 0)
       (owner-gen (if (eq variant :owner) 2 1)) (data-slot 4) (data-gen 5)
       (block-length 3) (location-kind 0) (vector-slot 9) (vector-gen 10) (vector-off 32) (vector-length 32)))
      (cannot-rebind (not (fn2-checkpoint-payload-rebindablep fn2-checkpoint-payload)))
      (before (fn2-ops-snapshot fn2-ops))
      ((mv code fn2-checkpoint-payload fn2-ops)
       (fn2-checkpoint-payload-harvest-children hslot (if (eq variant :stale) (+ 1 hgen) hgen) cell
        *fn2-event-read-result* *fn2-outcome-done* *fn2-reason-none* 3 0 0 fn2-checkpoint-payload fn2-ops))
      (unchanged-ops (equal before (fn2-ops-snapshot fn2-ops)))
      (observed (and (equal (fn2-checkpoint-payload-pending 0 fn2-checkpoint-payload) (if ignored 1 0))
                     (equal (fn2-checkpoint-payload-phase 0 fn2-checkpoint-payload)
                      (if ignored *fn2-checkpoint-payload-phase-wait-block* *fn2-checkpoint-payload-phase-location-verify*))
                     (equal (fn2-checkpoint-payload-vector-slot 0 fn2-checkpoint-payload) 9)
                     (equal (fn2-checkpoint-payload-vector-gen 0 fn2-checkpoint-payload) 10)
                     (equal (fn2-checkpoint-payload-vector-off 0 fn2-checkpoint-payload) 32)
                     (equal (fn2-checkpoint-payload-vector-length 0 fn2-checkpoint-payload) 32)))
      ((mv finished fn2-ops) (fn2-op-finish slot gen fn2-ops)))
  (mv (and (eq reserved :ok) (eq ranged :ok) (eq queued :ok) (eq acked :ok) found
           cannot-rebind (eq code :ok) unchanged-ops observed (eq finished :ok))
      fn2-checkpoint-payload fn2-ops)))
(defun fn2-cphu-test (variant)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-checkpoint-payload fn2-ops)
  (fn2-cphu-body variant fn2-checkpoint-payload fn2-ops)))
(assert-event (fn2-cphu-test :live))
(assert-event (fn2-cphu-test :cold))
(assert-event (fn2-cphu-test :stale))
(assert-event (fn2-cphu-test :owner))

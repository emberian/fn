; PREPARED, UNEXECUTED SAME-emitter/controller metadata gate. Counts native
; row-access/phase-flush categories and bounded case probes, never AST work.
; Cheap outer invalid-snapshot refusal has no DO and is checked separately.
(in-package "ACL2")
(include-book "../books/assembly-attach")
(include-book "../books/checkpoint-master-work")
(defun fn2-master-work-definition (name tree)
 (declare (xargs :verify-guards nil))
 (cond ((atom tree) nil) ((and (eq (car tree) 'defun) (eq (cadr tree) name)) tree)
       (t (or (fn2-master-work-definition name (car tree)) (fn2-master-work-definition name (cdr tree))))))
(mutual-recursion
 (defun fn2-master-work-expr (x op fuel)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (cond ((zp fuel) (mv nil 0)) ((atom x) (mv t 0))
   ((member-eq (car x) '(quote declare)) (mv t 0))
   ((eq (car x) op) (fn2-master-work-list (cdr x) op (1- fuel))) ; separate actual shared face cost
   ((eq (car x) 'fn2-checkpoint-master-snapshot-read-code) (mv t *fn2-master-snapshot-steps*))
   ((member-eq (car x) '(fn2-checkpoint-master-row-token fn2-checkpoint-master-row-generation)) (mv t *fn2-master-row-read-steps*))
   ((eq (car x) 'fn2-checkpoint-master-write+phase) (mv t *fn2-master-phase-write-steps*))
   ((eq (car x) 'if)
    (b* (((mv a ca) (fn2-master-work-expr (cadr x) op (1- fuel)))
         ((mv b cb) (fn2-master-work-expr (caddr x) op (1- fuel)))
         ((mv c cc) (fn2-master-work-expr (cadddr x) op (1- fuel)))) (mv (and a b c) (+ ca (max cb cc)))))
   ((member-eq (car x) '(let let*))
    (b* (((mv a ca) (fn2-master-work-list (strip-cadrs (cadr x)) op (1- fuel)))
         ((mv b cb) (fn2-master-work-list (cddr x) op (1- fuel)))) (mv (and a b) (+ ca cb))))
   ((eq (car x) 'mv-let) (fn2-master-work-list (cddr x) op (1- fuel)))
   ((member-eq (car x) '(member member-equal))
    (if (and (eq (car (caddr x)) 'quote) (true-listp (cadr (caddr x))))
     (mv t (+ 1 (len (cadr (caddr x))))) (mv nil 0)))
   ((member-eq (car x) '(equal eq eql not natp posp zp nfix < <= > >= + - max min mv list and or))
    (fn2-master-work-list (cdr x) op (1- fuel)))
   (t (mv nil 0))))
 (defun fn2-master-work-list (xs op fuel)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (if (zp fuel) (mv nil 0)
   (if (atom xs) (mv t 0)
    (b* (((mv a ca) (fn2-master-work-expr (car xs) op (1- fuel)))
         ((mv b cb) (fn2-master-work-list (cdr xs) op (1- fuel)))) (mv (and a b) (+ ca cb)))))))
(defun fn2-master-work-has-call (op tree)
 (declare (xargs :verify-guards nil))
 (and (consp tree) (or (eq (car tree) op) (fn2-master-work-has-call op (car tree)) (fn2-master-work-has-call op (cdr tree)))))
; Every real DO-following terminal, including :accept refusal, reports
; the full shared face+controller charge. Cheap outer/no-DO paths are distinct.
(mutual-recursion
 (defun fn2-master-work-terminals (x op entered bytes steps world fuel)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (cond ((zp fuel) (mv nil 0)) ((atom x) (mv t 0))
   ((eq (car x) 'quote) (mv t 0))
   ((and entered (eq (car x) 'mv) (equal (len x) 6))
    (let ((values (fn2-cost-values (list :bytes (cadr x) :steps (caddr x) :descriptors (cadddr x)) world)))
     (mv (equal values (list bytes steps 0)) 1)))
   ((eq (car x) 'mv-let)
    (fn2-master-work-terminals-list (cdddr x) op (or entered (fn2-master-work-has-call op (caddr x))) bytes steps world (1- fuel)))
   (t (fn2-master-work-terminals-list (cdr x) op entered bytes steps world (1- fuel)))))
 (defun fn2-master-work-terminals-list (xs op entered bytes steps world fuel)
  (declare (xargs :verify-guards nil :measure (nfix fuel)))
  (if (zp fuel) (mv nil 0)
   (if (atom xs) (mv t 0)
    (b* (((mv a ca) (fn2-master-work-terminals (car xs) op entered bytes steps world (1- fuel)))
         ((mv b cb) (fn2-master-work-terminals-list (cdr xs) op entered bytes steps world (1- fuel))))
     (mv (and a b) (+ ca cb)))))))
; Inspect actual generated function bodies, not a manually written callback.
(make-event
 (mv-let (err events) (fn2-arms-events 'fn2-checkpoint-master :core (w state))
  (if err (er soft 'checkpoint-master-controller-source-unit "~@0" err)
   (let* ((definition (fn2-master-work-definition 'fn2-checkpoint-master-run-rebase-consume events))
          (body (car (last definition)))
          (outer-test '(eq (fn2-checkpoint-master-snapshot-read-code id fn2-core) :ok))
          (budget (fn2-machine-property 'fn2-checkpoint-master :budget (w state)))
          (ceiling (fn2-machine-work-ceiling 'fn2-checkpoint-master (w state))))
    (mv-let (known inner) (fn2-master-work-expr (caddr body) 'fn2-checkpoint-directory-rebase-consume-op 10000)
     (let* ((controller (+ *fn2-master-snapshot-steps* inner))
            (steps (+ *fn2-directory-rebase-consume-steps* controller)))
      (mv-let (charged terminals) (fn2-master-work-terminals body 'fn2-checkpoint-directory-rebase-consume-op nil
       *fn2-directory-rebase-consume-bytes* steps (w state) 10000)
      (if (and (equal (caddr definition) '(id budget fn2-core))
               (eq (car body) 'if) (equal (cadr body) outer-test)
               (not (fn2-master-work-has-call 'fn2-checkpoint-directory-rebase-consume-op (cadddr body)))
               charged (equal terminals 2) known (equal controller *fn2-master-consume-controller-steps*)
               (equal steps *fn2-master-consume-turn-steps*)
               (<= *fn2-directory-rebase-consume-bytes* (nfix (fn2-arm-get :bytes budget)))
               (<= steps (nfix (fn2-arm-get :steps budget)))
               (fn2-run-quantitiesp *fn2-directory-rebase-consume-bytes* steps 0 0 ceiling)
               (<= ceiling (max 1 (fn2-machine-registry-quantity-max (fn2-machine-names (w state)) t (w state)))))
          (value '(value-triple :actual-master-consume-controller-fit))
       (er soft 'checkpoint-master-controller-source-unit "Actual emitted controller category/body or registered admission changed.")))))))))

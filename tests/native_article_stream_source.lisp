; Execute the actual shared producer bodies over the arena list model.
; This fixture does not substitute for the owner/cold consumer refinement.
(unless (find-package "ACL2") (make-package "ACL2" :use '("COMMON-LISP")))
(in-package "ACL2")
(declaim (declaration xargs))
(defmacro mv (&rest xs) `(values ,@xs))
(defmacro mv-let (names call &body body) `(multiple-value-bind ,names ,call ,@body))
(defmacro mbe (&key logic exec) (declare (ignore logic)) exec)
(defun nfix (n) (if (and (integerp n) (<= 0 n)) n 0))
(defun natp (n) (and (integerp n) (<= 0 n)))
(defun zp (n) (or (not (integerp n)) (<= n 0)))
(defun len (xs) (length xs))
(defun member-eq (a xs) (member a xs :test #'eq))
(defparameter *fn-nntp-max-article-number* 2147483647)
(defparameter *fn-nntp-max-message-id-octets* 250)
(defun fn-article-memberships (article) (third article))
(defun fn-ag-car (x) (if (consp x) (car x) nil))
(defun fn-ag-cdr (x) (if (consp x) (cdr x) nil))
(defun fn-ng-char-code (x) (char-code x))
(defun posp (x) (and (integerp x) (< 0 x)))
(defun fn-cbor-ag-car (x) (if (consp x) (car x) nil))
(defun fn-cbor-ag-cdr (x) (if (consp x) (cdr x) nil))
(defun fn-octetp (x) (and (integerp x) (<= 0 x 255)))
(defun fn-arena-count (arena) (length arena))
(defun fn-arena-payload-len (h arena) (length (nth h arena)))
(defun fn-arena-get (h at arena) (nth at (nth h arena)))
(defun fn-article-payload (article) (second article))
(defun fn-article-msgid (article) (first article))
(defun fn-nntp-article-bytes (article arena)
  (let ((p (fn-article-payload article))) (if (natp p) (nth p arena) p)))
(defun digit-to-char (n) (digit-char n))
(defun source-load-defuns (path &optional names)
  (with-open-file (in path)
    (loop for form = (read in nil :end) until (eq form :end)
          when (and (consp form) (eq (car form) 'defun)
                    (or (not names) (member (second form) names)))
          do (eval form))))

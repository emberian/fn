(defvar *checks* 0)
(defun source-check (condition)
  (incf *checks*) (unless condition (error "article source check ~d failed" *checks*)))
(defun bytes (text) (map 'list #'char-code text))
(defun source-scan (source quantum arena)
  (let ((scan (fn-ast-preflight source)))
    (loop until (fn-ast-scan-donep scan) do
      (multiple-value-bind (next used) (fn-ast-scan-step scan quantum arena)
        (source-check (<= 0 used quantum))
        (source-check (<= (- (third (first scan)) (third (first next))) quantum))
        (setf scan next))) scan))
(defun source-render (cur quantum arena)
  (let ((acc nil) (initial (copy-tree cur)))
    (loop until (eq (car cur) :done) do
      (multiple-value-bind (out next used) (fn-ast-render-step cur quantum arena)
        (source-check (<= 0 used quantum))
        (source-check (<= (length out) (* 2 quantum)))
        (setf acc (revappend out acc) cur next)))
    (source-check (not (eq (car initial) :done)))
    (reverse acc)))
(defun source-render-window (cur window arena)
  (let ((acc nil) (initial (copy-tree cur)) (original cur))
    (loop until (fn-ast-window-donep cur) do
      (multiple-value-bind (out next) (fn-ast-render-window cur window window arena)
        (source-check (<= (length out) window))
        (setf acc (revappend out acc) cur next)))
    (source-check (equal initial original))
    (reverse acc)))
(defun source-reference (payload kind number mid &optional server pairs)
  (let* ((split (loop for at below (- (length payload) 3)
                     when (equal (subseq payload at (+ 4 at)) '(13 10 13 10)) return (+ at 4)))
         (section (case kind (:head (subseq payload 0 (- split 2)))
                            (:body (subseq payload split)) (t payload)))
         (xref (and server (consp pairs) (not (eq kind :body))
                    (append (bytes "Xref: ") server
                      (loop for (group . num) in pairs append (bytes (format nil " ~a:~d" group num)))
                      '(13 10))))
         (initial (bytes (format nil "~d ~d ~a ~a" (case kind (:head 221) (:body 222) (t 220))
                                  number mid (case kind (:head "headers follow") (:body "body follows")
                                                      (t "article follows")))))
         (block (fn-nntp-block-rev (append xref section) t nil)))
    (append initial '(13 10) (revappend block '(46 13 10)))))
(let* ((payload (append (bytes "Subject: example") '(13 10 13 10)
                        (bytes ".first") '(13 10) (bytes "last") '(13 10)))
       (article (list "<stream@example>" 0)) (arena (list payload))
       (pairs '(("fn.a" . 123456789012345678901234567890) ("fn.b" . 2)))
       (server (bytes "node.example")))
  (dolist (quantum '(1 2 3 4 7 16 256))
    (let ((scan (source-scan (fn-ast-source article arena) quantum arena)))
      (source-check (fn-ast-scan-validp scan))
      (dolist (kind '(:article :head :body))
        (let* ((ready (fn-ast-ready scan kind 123456789012345678901234567890 article server pairs))
               (before (copy-tree ready))
               (one (source-render ready quantum arena))
               (two (source-render ready (1+ quantum) arena)))
          (source-check (equal ready before))
          (source-check (equal one two))
          (source-check (equal one (source-reference payload kind 123456789012345678901234567890
                                                     "<stream@example>" server pairs))))))))
(dolist (payload '(nil (13) (10) (0) (65 13 10) (13 10 13 10) (13 10 13 10 65)
                   (13 10 13 10 46 13 10) (13 10 13 10 13 13 10) (13 10 13 10 0 13 10)))
  (dolist (quantum '(1 2 3 7))
    (let ((scan (source-scan (list nil 0 (length payload) payload) quantum nil)))
      (source-check (equal (and (fn-ast-scan-validp scan) t)
                          (and (fn-nntp-crlf-validp payload t) (fn-nntp-blank-linep payload) t))))))
(let* ((payload (append (bytes "Subject: dense") '(13 10 13 10)
                        (loop repeat 5000 append '(46 13 10))))
       (article (list "<dense@example>" 0)) (arena (list payload))
       (scan (source-scan (fn-ast-source article arena) 4096 arena))
       (ready (fn-ast-ready scan :body 7 article nil nil))
       (saved (copy-tree ready))
       (reference (source-reference payload :body 7 "<dense@example>")))
  (dolist (window '(1 2 3 4096))
    (source-check (equal (source-render-window ready window arena) reference))
    (source-check (equal ready saved))))
(let* ((payload (append (bytes "Subject: Xref") '(13 10 13 10 46 13 10)))
       (arena (list payload)) (server (bytes "node.example")))
  (dolist (memberships (list nil '(("fn.a" . 2) ("fn.b" . 3))
                            '(("fn.a" . 2) ("fn.a" . 3) ("fn.a" . 2))
                            '(("bad:name" . 1) ("bad name" . 2) ("" . 3) ("fn.a" . 0)
                              ("fn.b" . 2147483648) ("fn.c" . 7))
                            (list (cons (make-string 5000 :initial-element #\a) 9))))
    (let* ((article (list "<xref@example>" 0 memberships))
           (scan (source-scan (fn-ast-source article arena) 7 arena))
           (pairs (fn-xref-pairs article)))
      (dolist (kind '(:article :head :body))
        (let ((ready (fn-ast-ready-memberships scan kind 7 article server)))
          (dolist (window '(1 3 4096))
            (source-check (equal (source-render-window ready window arena)
                                 (source-reference payload kind 7 "<xref@example>" server pairs)))))))))
(let* ((payload (append (bytes "Subject: server") '(13 10 13 10 46 13 10)))
       (arena (list payload))
       (article (list "<server@example>" 0 '(("fn.a" . 2))))
       (scan (source-scan (fn-ast-source article arena) 3 arena)))
  (dolist (server (list nil '(33 126 58) '(32) '(127) '(65 . 66) "server"
                       (append (make-list 5000 :initial-element 65) '(32))
                       (make-list 5000 :initial-element 65)))
    (dolist (kind '(:article :head :body))
      (dolist (window '(1 3 4096))
        (source-check
         (equal (source-render-window (fn-ast-ready-memberships scan kind 2 article server) window arena)
                (source-reference payload kind 2 "<server@example>"
                                  (and (fn-xref-serverp server) server)
                                  (fn-xref-pairs article))))))))
(let ((articles (loop for n from 1 to 200 collect
                  (list (format nil "<select~d@example>" n) 0
                        (list (cons "fn.other" (+ n 300)) (cons "fn.a" n))))))
  (dolist (mode '(:number :current))
    (dolist (number '(1 99 200 201))
      (dolist (fuel '(1 3 4096))
        (let ((it (fn-ast-select-state mode "fn.a" number articles nil nil nil 0 :next)))
          (loop until (fn-ast-select-donep it) do (setf it (fn-ast-select-step it fuel)))
          (let ((reference (if (eq mode :number)
                               (fn-nntp-find-group-number "fn.a" number articles)
                             (fn-nntp-available-article "fn.a" number articles))))
            (source-check (eq (fn-ast-at 5 it) reference))
            (source-check (eq (fn-ast-at 9 it) (if reference :selected :missing)))))))))
; Actual source archive fallback and selected-group number projection. The
; requested ID is bounded by the command parser; memberships are unbounded.
(source-load-defuns "books/acceptance.lisp" '(fn-find-article))
(let* ((long-group (make-string 5000 :initial-element #\a))
       (first (list "<same@example>" 0 (list (cons "fn.other" 3) (cons "fn.a" 17))))
       (duplicate (list "<same@example>" 0 '(("fn.a" . 23))))
       (long (list "<long@example>" 0 (list (cons long-group 19))))
       (articles (list (list "invalid ID" 0 nil) first duplicate long)))
  (dolist (key '("<same@example>" "<long@example>" "<missing@example>"))
    (dolist (group (list nil "fn.a" "fn.absent" long-group))
      (dolist (fuel '(1 3 4096))
        (let ((it (fn-ast-select-state :msgid group key articles nil nil nil 0 :msgid-next)))
          (loop until (fn-ast-select-donep it) do (setf it (fn-ast-select-step it fuel)))
          (let ((reference (fn-find-article key articles)))
            (source-check (eq (fn-ast-at 5 it) reference))
            (source-check (eq (fn-ast-at 9 it) (if reference :selected :missing)))
            (when reference
              (source-check (= (fn-ast-at 3 it) (if group (fn-nntp-article-number group reference) 0)))))))))
  (dolist (article (list first long (list "bad ID" 0 '(("fn.a" . 17)))
                        (list "<huge@example>" 0 '(("fn.a" . 2147483648)))
                        (list "<dup@example>" 0 '(("fn.a" . 0) ("fn.a" . 9)))))
    (dolist (group (list nil "fn.a" "fn.absent" long-group))
      (let ((it (fn-ast-msgid-local-start group article)))
        (loop until (fn-ast-select-donep it) do (setf it (fn-ast-select-step it 1)))
        (source-check (eq (fn-ast-at 5 it) article))
        (source-check (= (fn-ast-at 3 it) (if group (fn-nntp-article-number group article) 0)))))))
(dolist (it (list (fn-ast-xref-state 77 nil :word 9 0 nil 0)
                 (fn-ast-xref-state nil nil :compare '("fn.a" . 1) 0 77 0)
                 (fn-ast-xref-state nil nil :compare '("fn.a" . 0) 0 '(("fn.a" . 0)) 0)))
  (source-check (eq (fn-ast-xref-one it) :wait)))

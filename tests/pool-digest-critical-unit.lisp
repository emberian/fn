; Ruling22 CRITICAL extraction / cursor-resource witness package.
; Component byte-loader scope, not actor reachability or network progress.
; The legacy defun and production theorem/guard remain untouched.
; All assertions and discharge events in this TEST book are SOURCE ONLY / UNRUN.
(in-package "ACL2")
(include-book "pool-digest-budget-unit")
(include-book "../books/owed-discharge")

; First source word has four independent nonzero bytes: 04 03 02 01.
(defun fn2-rdc-reset (fn2-fields fn2-digests)
 (declare (xargs :stobjs (fn2-fields fn2-digests) :verify-guards nil))
 (mv-let (fn2-fields fn2-digests) (fn2-rdb-seed 0 fn2-fields fn2-digests)
  (let ((fn2-fields (fn2-fields-set-value 0 16909060 fn2-fields)))
   (mv fn2-fields fn2-digests))))

; Independent literal oracle for offset3..30 of the encoded source.
(defconst *fn2-rdc-shifted* '(65281 65536 16776960 16777216 4294967040 127 4294967168))
(defun fn2-rdc-shifted-p (i fn2-digests)
 (declare (xargs :stobjs fn2-digests :verify-guards nil :measure (nfix (- 8 (nfix i)))))
 (if (>= (nfix i) 8) t
  (and (equal (fn2-digest-word 0 (nfix i) fn2-digests)
              (if (zp i) *fn2-rdb-sentinel* (nth (- (nfix i) 1) *fn2-rdc-shifted*)))
       (equal (fn2-digest-word 1 (nfix i) fn2-digests) 1431655765)
       (fn2-rdc-shifted-p (+ 1 (nfix i)) fn2-digests))))
; Both registered continuation laws' WHOLE H and conclusions at one step.
(defun fn2-rdc-step-laws (budget next acc after partial)
 (declare (xargs :verify-guards nil))
 (and (natp budget) (natp 0) (fn2-rec-fetch-state-p next acc)
      (<= next after) (<= after 32) (<= (- after next) budget)
      (fn2-rec-fetch-state-p after partial)))

(defun fn2-rdc-case (kind fn2-fields fn2-pool fn2-digests)
 (declare (xargs :stobjs (fn2-fields fn2-pool fn2-digests) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init 8 fn2-fields))
      (fn2-pool (fn2-pool-init '((1 . 64)) 1 100 fn2-pool))
      (fn2-digests (fn2-digests-init 2 fn2-digests))
      ((mv reserved slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv fn2-fields fn2-digests) (fn2-rdc-reset fn2-fields fn2-digests))
      ((mv encoded end fn2-pool) (fn2-rec-budget-words-encode 0 slot gen 0 1 0 1 fn2-fields fn2-pool))
      (setup (and (eq reserved :ok) (eq encoded :ok) (= end 32)
                  (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
                  (fn2-digestsp fn2-digests) (fn2-digest-rowp 0 fn2-digests)
                  (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)
                  (eq (fn2-pool-readable-code slot gen 1 0 1 fn2-pool) :ok)))
      ((unless setup) (mv nil fn2-fields fn2-pool fn2-digests))
      (before (fn2-digests-copy fn2-digests))
      (source (fn2-pool-copy fn2-pool)))
  (cond
   ((or (eq kind :positive) (eq kind :without-off))
    (b* ((k 1) (off (if (eq kind :without-off) -1 0))
         ; Every original H except OFF holds in BOTH cases.
         (other-h (and (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
                       (fn2-digestsp fn2-digests) (fn2-digest-rowp 0 fn2-digests)
                       (natp k) (<= k 8)))
         (whole-h (and other-h (natp off)))
         ; Negative case deliberately evaluates outside the OFF guard.
         ; Pool accesses themselves are valid offsets3..30 when k1/off-1.
         ((mv legacy-code fn2-digests)
          (fn2-rec-fetch k 0 slot gen off 1 0 1 fn2-pool fn2-digests))
         (legacy (fn2-digests-copy fn2-digests))
         (shifted (fn2-rdc-shifted-p 0 fn2-digests))
         (old-updates (and (not (equal before legacy))
                           (equal (fn2-digest-word 0 0 fn2-digests) *fn2-rdb-sentinel*)
                           (equal (fn2-digest-word 1 0 fn2-digests) 1431655765)))
         ((mv fn2-fields fn2-digests) (fn2-rdc-reset fn2-fields fn2-digests))
         (same-initial (equal before (fn2-digests-copy fn2-digests)))
         ((mv code next acc fn2-digests)
          (fn2-rec-fetch-step (- 32 (* 4 k)) (* 4 k) 0 0 slot gen off 1 0 1 fn2-pool fn2-digests))
         (after (fn2-digests-copy fn2-digests))
         ; EXACT conclusion compares code and the complete digest carrier.
         (conclusion (equal (list legacy-code legacy) (list code after))))
     (mv (and other-h same-initial old-updates (eq legacy-code :ok)
              (equal source (fn2-pool-copy fn2-pool))
              (if (eq kind :positive)
               (and whole-h (< k 8) (eq code :ok) (= next 32) (= acc 0)
                    conclusion (fn2-rdb-words 0 1 7 fn2-fields fn2-digests))
               (and shifted (not (natp off)) (not whole-h) (not conclusion)
                    (eq code :bounds) (= next 4) (= acc 0) (equal before after))))
         fn2-fields fn2-pool fn2-digests)))
   ((eq kind :partition)
    (b* ((whole-h (and (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
                       (fn2-digestsp fn2-digests) (fn2-digest-rowp 0 fn2-digests)
                       (natp 0) (<= 0 8) (natp 0)))
         ((mv legacy-code fn2-digests) (fn2-rec-fetch 0 0 slot gen 0 1 0 1 fn2-pool fn2-digests))
         (legacy (fn2-digests-copy fn2-digests))
         ((mv fn2-fields fn2-digests) (fn2-rdc-reset fn2-fields fn2-digests))
         ((mv c1 n1 a1 fn2-digests) (fn2-rec-fetch-step 1 0 0 0 slot gen 0 1 0 1 fn2-pool fn2-digests))
         (first (and (fn2-rdc-step-laws 1 0 0 n1 a1) (eq c1 :more) (= n1 1) (= a1 4) (equal before (fn2-digests-copy fn2-digests))))
         ((mv c3 n3 a3 fn2-digests) (fn2-rec-fetch-step 3 n1 a1 0 slot gen 0 1 0 1 fn2-pool fn2-digests))
         (word (and (fn2-rdc-step-laws 3 n1 a1 n3 a3) (eq c3 :more) (= n3 4) (= a3 0) (equal (fn2-digest-word 0 0 fn2-digests) 16909060)))
         ((mv c5 n5 a5 fn2-digests) (fn2-rec-fetch-step 5 n3 a3 0 slot gen 0 1 0 1 fn2-pool fn2-digests))
         (five (and (fn2-rdc-step-laws 5 n3 a3 n5 a5) (eq c5 :more) (= n5 9) (= a5 0) (fn2-rec-fetch-state-p n5 a5)))
         ((mv code next acc fn2-digests) (fn2-rec-fetch-step 23 n5 a5 0 slot gen 0 1 0 1 fn2-pool fn2-digests)))
     (mv (and whole-h first word five (fn2-rdc-step-laws 23 n5 a5 next acc) (eq legacy-code :ok) (eq code :ok)
              (= next 32) (= acc 0) (not (equal before legacy))
              (equal legacy (fn2-digests-copy fn2-digests))
              (fn2-rdb-words 0 0 8 fn2-fields fn2-digests)
              (equal source (fn2-pool-copy fn2-pool))) fn2-fields fn2-pool fn2-digests)))
   ((eq kind :partial-error)
    (b* ((fn2-pool (fn2-pool-set-fill slot 2 fn2-pool))
         ((mv code next acc fn2-digests) (fn2-rec-fetch-step 3 0 0 0 slot gen 0 1 0 1 fn2-pool fn2-digests))
         (partial-carrier (fn2-digests-copy fn2-digests))
         ((mv old-code fn2-digests) (fn2-rec-fetch 0 0 slot gen 0 1 0 1 fn2-pool fn2-digests)))
     (mv (and (eq code :bounds) (eq old-code code) (= next 2) (= acc 772)
              (fn2-rec-fetch-state-p next acc) (equal before partial-carrier)
              (equal before (fn2-digests-copy fn2-digests))) fn2-fields fn2-pool fn2-digests)))
   ((eq kind :without-budget)
    (b* ((budget -1) (next 0) (acc 0)
         (other-h (and (natp 0) (fn2-rec-fetch-state-p next acc)))
         ((mv code after partial fn2-digests) (fn2-rec-fetch-step budget next acc 0 slot gen 0 1 0 1 fn2-pool fn2-digests))
         (conclusion (and (<= next after) (<= after 32) (<= (- after next) budget))))
     (mv (and other-h (not (natp budget)) (eq code :bounds)
              (= after next) (= partial acc) (not conclusion)
              (equal before (fn2-digests-copy fn2-digests))) fn2-fields fn2-pool fn2-digests)))
   ((eq kind :without-state)
    (b* ((next 33) (acc 0) (budget 1)
         (other-h (and (natp budget) (natp 0)))
         ((mv code after partial fn2-digests) (fn2-rec-fetch-step budget next acc 0 slot gen 0 1 0 1 fn2-pool fn2-digests)))
     (mv (and other-h (not (fn2-rec-fetch-state-p next acc))
              (eq code :bounds) (= after next) (= partial acc)
              (not (fn2-rec-fetch-state-p after partial))
              (equal before (fn2-digests-copy fn2-digests))) fn2-fields fn2-pool fn2-digests)))
   (t (mv nil fn2-fields fn2-pool fn2-digests)))))

(defun fn2-rdc-run (kind)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (answer fn2-fields)
   (with-local-stobj fn2-pool
    (mv-let (answer fn2-fields fn2-pool)
     (with-local-stobj fn2-digests
      (mv-let (answer fn2-fields fn2-pool fn2-digests)
       (fn2-rdc-case kind fn2-fields fn2-pool fn2-digests)
       (mv answer fn2-fields fn2-pool))) (mv answer fn2-fields))) answer)))
(defun fn2-rdc-positive ()
 (declare (xargs :verify-guards nil))
 (fn2-rdc-run :positive))
(defun fn2-rdc-partition ()
 (declare (xargs :verify-guards nil))
 (fn2-rdc-run :partition))
(defun fn2-rdc-partial-error ()
 (declare (xargs :verify-guards nil))
 (fn2-rdc-run :partial-error))
(defun fn2-rdc-without-budget ()
 (declare (xargs :verify-guards nil))
 (fn2-rdc-run :without-budget))
(defun fn2-rdc-without-state ()
 (declare (xargs :verify-guards nil))
 (fn2-rdc-run :without-state))
; This zero-argument tooth is expressly a LOGICAL guard-removal witness.
; It changes only OFF=-1; it does not relax the production function guard.
(defun fn2-rdc-without-off-logical ()
 (declare (xargs :verify-guards nil))
 (with-guard-checking :none (fn2-rdc-run :without-off)))

(defthm-owed fn2-rec-fetch-critical-refinement (k dst slot gen off okind oslot ogen p d)
 (implies (and (fn2-poolp p) (fn2-pool-wfp p)
               (fn2-digestsp d) (fn2-digest-rowp dst d)
               (natp k) (<= k 8) (natp off))
  (equal (mv-list 2 (fn2-rec-fetch k dst slot gen off okind oslot ogen p d))
         (mv-list 2 (if (or (not (natp k)) (>= k 8)) (mv :ok d)
   (mv-let (code next acc d)
    (fn2-rec-fetch-step (- 32 (* 4 k)) (* 4 k) 0 dst slot gen off okind oslot ogen p d)
    (declare (ignore next acc))
    (mv code d))))))
 :teeth (fn2-rdc-positive fn2-rdc-without-off-logical) :layer :b :schema :g1 :claim :representation
 :doc "Manual CRITICAL extraction/cursor-resource classification; exact original formula, component scope.")
(defthm fn2-rec-fetch-critical-refinement-proved
 (fn2-rec-fetch-critical-refinement$owed k dst slot gen off okind oslot ogen p d)
 :hints (("Goal" :use ((:instance fn2-rec-fetch-exec-refines (fn2-pool p) (fn2-digests d)))
                 :in-theory (enable fn2-rec-fetch-critical-refinement$owed)))
 :rule-classes nil)
(fn2-owed-discharge fn2-rec-fetch-critical-refinement fn2-rec-fetch-critical-refinement-proved)
(defthm-owed fn2-rec-fetch-critical-progress (budget next acc dst slot gen off okind oslot ogen p d)
 (implies (and (natp budget) (natp off) (fn2-rec-fetch-state-p next acc))
  (and (<= next (mv-nth 1 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen p d)))
       (<= (mv-nth 1 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen p d)) 32)
       (<= (- (mv-nth 1 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen p d)) next) budget)))
 :teeth (fn2-rdc-partition fn2-rdc-without-budget) :layer :b :schema :g1 :claim :representation
 :doc "Manual CRITICAL extraction/cursor-resource classification; exact original formula, component scope.")
(defthm fn2-rec-fetch-critical-progress-proved
 (fn2-rec-fetch-critical-progress$owed budget next acc dst slot gen off okind oslot ogen p d)
 :hints (("Goal" :use ((:instance fn2-rec-fetch-step-progress-bound (fn2-pool p) (fn2-digests d)))
                 :in-theory (enable fn2-rec-fetch-critical-progress$owed)))
 :rule-classes nil)
(fn2-owed-discharge fn2-rec-fetch-critical-progress fn2-rec-fetch-critical-progress-proved)
(defthm-owed fn2-rec-fetch-critical-state (budget next acc dst slot gen off okind oslot ogen p d)
 (implies (and (natp budget) (natp off) (fn2-rec-fetch-state-p next acc))
  (fn2-rec-fetch-state-p
   (mv-nth 1 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen p d))
   (mv-nth 2 (fn2-rec-fetch-step budget next acc dst slot gen off okind oslot ogen p d))))
 :teeth (fn2-rdc-partition fn2-rdc-without-state) :layer :b :schema :g1 :claim :representation
 :doc "Manual CRITICAL extraction/cursor-resource classification; exact original formula, component scope.")
(defthm fn2-rec-fetch-critical-state-proved
 (fn2-rec-fetch-critical-state$owed budget next acc dst slot gen off okind oslot ogen p d)
 :hints (("Goal" :use ((:instance fn2-rec-fetch-step-result-state (fn2-pool p) (fn2-digests d)))
                 :in-theory (enable fn2-rec-fetch-critical-state$owed)))
 :rule-classes nil)
(fn2-owed-discharge fn2-rec-fetch-critical-state fn2-rec-fetch-critical-state-proved)

(assert-event (fn2-rdc-partial-error))
; Keep logical-only evaluation conspicuous even outside the registry gate.
(assert-event (with-guard-checking :none (fn2-rdc-without-off-logical)))
(fn2-assert-owed-teeth fn2-rec-fetch-critical-refinement
                      fn2-rec-fetch-critical-progress fn2-rec-fetch-critical-state)

; Actual holder predicate over explicit typed carrier states. This checks
; metadata-lifetime vetoes only, never bank/edge discharge or physical FREE.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-dispose-holders")
(include-book "../books/runs-page")
(defun fn2-cdh-body (mode fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control)
 (declare (xargs :stobjs (fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control) :verify-guards nil))
 (b* ((fn2-checkpoints (fn2-checkpoints-init 2 fn2-checkpoints))
      (fn2-checkpoints (fn2-checkpoints-put 1 (state *fn2-checkpoint-state-installed*) (checkpoint 9)))
      (fn2-checkpoint-summary (fn2-checkpoint-summary-init 2 fn2-checkpoint-summary))
      (fn2-checkpoint-summary-authority (fn2-checkpoint-summary-authority-init 2 fn2-checkpoint-summary-authority))
      (fn2-checkpoint-cbase-holds (fn2-checkpoint-cbase-holds-init 2 fn2-checkpoint-cbase-holds))
      (fn2-checkpoint-restore-events (fn2-checkpoint-restore-events-init 2 fn2-checkpoint-restore-events))
      (fn2-directory-rebase (fn2-directory-rebase-init 1 fn2-directory-rebase))
      (fn2-checkpoint-build (fn2-checkpoint-build-init 1 fn2-checkpoint-build))
      (fn2-allocation-release (fn2-allocation-release-init 1 fn2-allocation-release))
      (fn2-retirement-control (fn2-retirement-control-init 1 fn2-retirement-control))
      (stale (eq mode :stale-inactive))
      (fn2-checkpoint-summary (fn2-checkpoint-summary-put 0 (candidate 1) (tag 7)
       (phase (if (eq mode :catalog0) *fn2-checkpoint-summary-phase-capture* *fn2-checkpoint-summary-phase-idle*))))
      (fn2-checkpoint-summary (fn2-checkpoint-summary-put 1 (candidate 1) (tag 8)
       (phase (if (eq mode :catalog1) *fn2-checkpoint-summary-phase-captured* *fn2-checkpoint-summary-phase-idle*))
       (lease-count (if (eq mode :lease) 1 0))))
      (fn2-checkpoint-summary-authority (fn2-checkpoint-summary-authority-put 0 (candidate 1) (tag 9)
       (phase (if (eq mode :authority0) *fn2-checkpoint-summary-authority-phase-complete* *fn2-checkpoint-summary-authority-phase-idle*))))
      (fn2-checkpoint-summary-authority (fn2-checkpoint-summary-authority-put 1 (candidate 1) (tag 10)
       (phase (if (eq mode :authority1) *fn2-checkpoint-summary-authority-phase-copy* *fn2-checkpoint-summary-authority-phase-idle*))))
      (fn2-checkpoint-cbase-holds (if (member-equal mode '(:cbase :released :stale-inactive))
       (fn2-checkpoint-cbase-holds-put 1 (phase *fn2-checkpoint-cbase-phase-released*) (tag 11)
        (limit 2) (cursor (if (eq mode :cbase) 1 2)) (seen 0)) fn2-checkpoint-cbase-holds))
      (fn2-checkpoint-restore-events (fn2-checkpoint-restore-events-put 1 (candidate 1)
       (phase (if (eq mode :event-catalog) *fn2-checkpoint-restore-events-phase-complete* *fn2-checkpoint-restore-events-phase-idle*))))
      (fn2-checkpoint-restore-events (fn2-checkpoint-restore-events-put 0 (candidate 1)
       (phase (cond ((eq mode :event-investigation) *fn2-checkpoint-restore-events-phase-directory*)
                    (stale *fn2-checkpoint-restore-events-phase-complete*) (t *fn2-checkpoint-restore-events-phase-idle*)))))
      (fn2-directory-rebase (fn2-directory-rebase-put 0 (candidate 1)
       (phase (cond ((eq mode :rebase) *fn2-directory-rebase-phase-source-scanned*)
                    (stale *fn2-directory-rebase-phase-committed*) (t *fn2-directory-rebase-phase-idle*)))))
      (fn2-checkpoint-build (fn2-checkpoint-build-put 0 (candidate 1)
       (phase (if (eq mode :build) *fn2-checkpoint-build-phase-ready* *fn2-checkpoint-build-phase-idle*))))
      (fn2-allocation-release (fn2-allocation-release-put 0 (candidate 1) (checkpoint 9)
       (phase (cond ((eq mode :release) *fn2-allocation-release-phase-staged*)
                    (stale *fn2-allocation-release-phase-complete*) (t *fn2-allocation-release-phase-idle*)))))
      (fn2-retirement-control (fn2-retirement-control-put 0 (candidate 1)
       (state (if (member-equal mode '(:checkpoint-member :ordinary-member)) *fn2-retirement-state-waiting* *fn2-retirement-state-idle*))
       (allocation-member (if (or stale (eq mode :checkpoint-member)) 1 0)))))
  (mv (equal (fn2-checkpoint-dispose-held-p 1 9 fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control)
             (if (member-equal mode '(:catalog0 :catalog1 :lease :authority0 :authority1 :cbase :event-catalog :event-investigation :rebase :build :release :checkpoint-member)) t nil))
      fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control)))
(defun fn2-cdh-test (mode)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control) (fn2-cdh-body mode fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds fn2-checkpoint-restore-events fn2-directory-rebase fn2-checkpoint-build fn2-allocation-release fn2-retirement-control)))
(assert-event (fn2-cdh-test :catalog0))
(assert-event (fn2-cdh-test :catalog1))
(assert-event (fn2-cdh-test :lease))
(assert-event (fn2-cdh-test :authority0))
(assert-event (fn2-cdh-test :authority1))
(assert-event (fn2-cdh-test :cbase))
(assert-event (fn2-cdh-test :event-catalog))
(assert-event (fn2-cdh-test :event-investigation))
(assert-event (fn2-cdh-test :rebase))
(assert-event (fn2-cdh-test :build))
(assert-event (fn2-cdh-test :release))
(assert-event (fn2-cdh-test :checkpoint-member))
(assert-event (fn2-cdh-test :empty))
(assert-event (fn2-cdh-test :released))
(assert-event (fn2-cdh-test :ordinary-member))
(assert-event (fn2-cdh-test :stale-inactive))

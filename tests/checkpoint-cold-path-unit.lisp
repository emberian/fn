; Connected source fixture: actual image create -> ordinary prefix -> actual
; maintenance publication -> ordinary suffix -> simulated process death ->
; selected cold boot -> held final epoch Fence -> actual completion.
; UNEXECUTED. Assertions below target the actual final epoch/resource join.
; Catalog entry is test-only, parent-authorized: activation remains NIL and
; this makes no scheduler-reachability claim for automatic maintenance.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/node-profile")
(include-book "checkpoint-cold-path-drive")
(include-book "column-snapshot-support")
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-pool (w state))))

(defconst *fn2-ccp-image-size* 33554432)
(defconst *fn2-ccp-profile*
 (put-assoc-equal :sim-sectors (/ *fn2-ccp-image-size* 512)
  (fn2-image-profile *fn2-node-profile*)))

(defun fn2-ccp-live-complete-p (publish batch fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (if publish
  (let ((id (fn2-machine-kind-base *fn2-checkpoint-master-kind* fn2-core)))
   (and (eq (fn2-checkpoint-master-snapshot-read-code id fn2-core) :ok)
        (member-equal (fn2-machine-phase id fn2-core)
         (list *fn2-checkpoint-master-state-idle* *fn2-checkpoint-master-state-disabled*))
        (= (fn2-checkpoint-master-row-token id fn2-core) 0)
        (stobj-let ((fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core))) (complete)
         (and (= (fn2-checkpoint-publication-has-base 0 fn2-checkpoint-publication) 1)
              (= (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication) *fn2-checkpoint-publication-phase-complete*)) complete)))
  (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (complete)
   (and (posp batch) (<= batch (fn2-commit-root-installed 0 fn2-commit-root))) complete)))

(defun fn2-ccp-live-drive (fuel publish batch fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (cond ((zp fuel) (mv :fuel fn2-core fn2-sim fn2-own))
       ((fn2-core-stopped-p fn2-core) (mv :failed fn2-core fn2-sim fn2-own))
       ((fn2-ccp-live-complete-p publish batch fn2-core) (mv :complete fn2-core fn2-sim fn2-own))
       (t (b* (((mv status fn2-core fn2-sim fn2-own) (fn2-ccp-pump fn2-core fn2-sim fn2-own)))
           (if (eq status :failed) (mv status fn2-core fn2-sim fn2-own)
            (fn2-ccp-live-drive (- fuel 1) publish batch fn2-core fn2-sim fn2-own))))))

; Enter only the parked, empty typed owner. Candidate, checkpoint number,
; source cut, roots, verification and Fence results come from its real arms.
(defun fn2-ccp-maintenance-entry (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((id (fn2-machine-kind-base *fn2-checkpoint-master-kind* fn2-core))
      ((unless (and (eq (fn2-checkpoint-master-snapshot-read-code id fn2-core) :ok)
                    (member-equal (fn2-machine-phase id fn2-core)
                     (list *fn2-checkpoint-master-state-idle* *fn2-checkpoint-master-state-disabled*))
                    (= (fn2-checkpoint-master-row-token id fn2-core) 0)
                    (= (fn2-checkpoint-master-row-pending id fn2-core) 0))) (mv :state fn2-core))
      (fn2-core (fn2-checkpoint-master-put-core id (phase *fn2-checkpoint-master-state-catalog*)
        (scan 0) (highest 0) (candidate 0) (candidate-found 0)))
      (fn2-core (fn2-exec-wake id fn2-core)))
  (mv :ok fn2-core)))

(defun fn2-ccp-prefix-and-publication (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((mv admitted writer prefix & fn2-core) (fn2-commit-admit-keyed 1 0 0 0 0 fn2-core))
      ((unless (eq admitted :ok)) (mv admitted 0 0 fn2-core fn2-sim fn2-own))
      (fn2-core (fn2-exec-wake writer fn2-core))
      ((mv committed fn2-core fn2-sim fn2-own) (fn2-ccp-live-drive 200000 nil prefix fn2-core fn2-sim fn2-own))
      ((unless (eq committed :complete)) (mv committed 0 0 fn2-core fn2-sim fn2-own))
      ((mv entered fn2-core) (fn2-ccp-maintenance-entry fn2-core))
      ((unless (eq entered :ok)) (mv entered 0 0 fn2-core fn2-sim fn2-own))
      ((mv published fn2-core fn2-sim fn2-own) (fn2-ccp-live-drive 400000 t 0 fn2-core fn2-sim fn2-own))
      ((unless (eq published :complete)) (mv published 0 0 fn2-core fn2-sim fn2-own))
      ((mv admitted writer suffix & fn2-core) (fn2-commit-admit-keyed 1 0 0 0 0 fn2-core))
      ((unless (eq admitted :ok)) (mv admitted 0 0 fn2-core fn2-sim fn2-own))
      (fn2-core (fn2-exec-wake writer fn2-core))
      ((mv committed fn2-core fn2-sim fn2-own) (fn2-ccp-live-drive 200000 nil suffix fn2-core fn2-sim fn2-own)))
  (mv committed prefix suffix fn2-core fn2-sim fn2-own)))

; This observation is after the actual constructor/replay path, never setup.
; Both the recovered terminal and selected source must still be current while
; issuance is frozen. The terminal includes the installation and new suffix.
(defun fn2-ccp-before-open-p (prefix suffix fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((recovery (fn2-machine-kind-base *fn2-recovery-machine-kind* fn2-core)))
  (and (fn2-ccp-epoch-fence-p fn2-core)
       (eq (fn2-boot-recovered fn2-core) :ok)
       (fn2-recovery-selected-current-p recovery fn2-core)
       (= (fn2-machine-rc-base recovery fn2-core) prefix)
       (= (fn2-machine-rc-chain recovery fn2-core) suffix)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                   (fn2-commit-root (fn2-core-commit-root fn2-core))
                   (fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))) (closed)
        (and (= (fn2-alloc-freeze-phase fn2-extents) 4) (= (fn2-alloc-epoch-begun fn2-extents) 0)
             (= (fn2-commit-root-base-ready 0 fn2-commit-root) 1)
             (= (fn2-commit-root-base-batch 0 fn2-commit-root) prefix)
             (= (fn2-commit-root-installed 0 fn2-commit-root) suffix)
             (= (fn2-checkpoint-summary-phase 0 fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-applied*)
             (= (fn2-checkpoint-summary-cut-commit 0 fn2-checkpoint-summary) prefix)) closed))))

(defun fn2-ccp-body (fault fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-ccp-profile* :null nil fn2-core))
      (fn2-sim (fn2-sim-init 1 :none "checkpoint-cold-path" *fn2-ccp-profile* fn2-sim))
      (fn2-own (fn2-own-init *fn2-ccp-profile* fn2-own))
      ((mv started fn2-core) (fn2-boot-start t *fn2-ccp-image-size* fn2-core))
      ((mv created fn2-core fn2-sim fn2-own) (fn2-ccp-drive 200000 nil fn2-core fn2-sim fn2-own))
      ((unless (and (eq started :ok) (eq created :ready)))
       (mv (list :create started created) fn2-core fn2-sim fn2-own))
      ((mv published prefix suffix fn2-core fn2-sim fn2-own) (fn2-ccp-prefix-and-publication fn2-core fn2-sim fn2-own))
      ((unless (eq published :complete)) (mv (list :publication published) fn2-core fn2-sim fn2-own))
      ((mv restarted fn2-core fn2-sim fn2-own) (fn2-ccp-restart *fn2-ccp-profile* *fn2-ccp-image-size* fn2-core fn2-sim fn2-own))
      ((mv held fn2-core fn2-sim fn2-own) (fn2-ccp-drive 600000 t fn2-core fn2-sim fn2-own))
      ((unless (and (eq restarted :ok) (eq held :epoch-held) (fn2-ccp-before-open-p prefix suffix fn2-core)))
       (mv (list :selected restarted held) fn2-core fn2-sim fn2-own))
      (boot (fn2-machine-kind-base *fn2-boot-kind* fn2-core))
      (owner-generation (fn2-machine-generation boot fn2-core))
      (root-slot (fn2-machine-root-slot boot fn2-core)) (root-gen (fn2-machine-root-gen boot fn2-core))
      (closed-epoch (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (epoch)
                     (fn2-alloc-current-epoch fn2-extents) epoch))
      ((mv posted fn2-core fn2-sim fn2-own) (fn2-ccp-complete-epoch fault fn2-core fn2-sim fn2-own))
      ((mv finished fn2-core fn2-sim fn2-own) (fn2-ccp-drive 200000 nil fn2-core fn2-sim fn2-own))
      ; Complete cold source/consumer authority came from the actual image,
      ; selected roots and replay above, not the isolated terminal fixture.
      (cleared (and (= (fn2-machine-root-slot boot fn2-core) 0)
                    (= (fn2-machine-root-gen boot fn2-core) 0)
                    (= (fn2-machine-root-cursor boot fn2-core) 0)
                    (= (fn2-machine-root-role boot fn2-core) 0)))
      (pool-before-repeat (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (snapshot)
                           (fn2-test-table-snapshot-fn2-pool fn2-pool) snapshot))
      ((mv repeat fn2-core) (fn2-boot-release-root-window boot owner-generation fn2-core))
      (repeat-unchanged (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (same)
                        (equal pool-before-repeat (fn2-test-table-snapshot-fn2-pool fn2-pool)) same))
      ((mv phase begun epoch window rebindable)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-pool (fn2-core-pool fn2-core))
                   (fn2-checkpoint-payload (fn2-core-checkpoint-payload fn2-core))) (phase begun epoch window rebindable)
        (mv (fn2-alloc-freeze-phase fn2-extents) (fn2-alloc-epoch-begun fn2-extents)
            (fn2-alloc-current-epoch fn2-extents)
            (fn2-pool-workspace-code root-slot root-gen *fn2-boot-kind* boot owner-generation fn2-pool)
            (fn2-checkpoint-payload-rebindablep fn2-checkpoint-payload))
        (mv phase begun epoch window rebindable)))
      (released (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (closed)
                  (let ((code (fn2-pool-handle-code root-slot root-gen fn2-pool)))
                   (or (eq code :stale)
                       (and (eq code :ok)
                            (= (fn2-pool-state root-slot fn2-pool) *fn2-pool-state-retired*)))) closed))
      (open (if (and (= phase 0) (= begun 1) (< closed-epoch epoch)
                     (member-eq window '(:stale :state)) rebindable cleared released
                     (eq repeat :state) repeat-unchanged) t nil)))
  (mv (list posted finished open prefix suffix (list phase begun epoch window rebindable closed-epoch)
            (list root-slot root-gen cleared repeat repeat-unchanged
                  (= (fn2-machine-root-slot boot fn2-core) root-slot)
                  (= (fn2-machine-root-gen boot fn2-core) root-gen) released)) fn2-core fn2-sim fn2-own)))

(defun fn2-ccp-test (fault)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-core fn2-sim fn2-own)
  (fn2-ccp-body fault fn2-core fn2-sim fn2-own)))
; Each assertion constructs its own image, publication, suffix and crash. No
; previous synthetic terminal fixture or saved READY core supplies authority.
(assert-event
 (let* ((result (fn2-ccp-test *fn2-fault-none*)) (facts (nth 5 result)) (resource (nth 6 result)))
  (and (eq (car result) :posted) (eq (cadr result) :ready) (eq (nth 2 result) t)
       (posp (nth 3 result)) (< (+ 1 (nth 3 result)) (nth 4 result))
       (= (len facts) 6) (= (nth 0 facts) 0) (= (nth 1 facts) 1)
       (< (nth 5 facts) (nth 2 facts)) (member-eq (nth 3 facts) '(:stale :state))
       (nth 4 facts) (posp (nth 1 resource)) (nth 2 resource)
       (eq (nth 3 resource) :state) (nth 4 resource) (nth 7 resource))))
(assert-event
 (let* ((result (fn2-ccp-test *fn2-fault-flush-io*)) (facts (nth 5 result)) (resource (nth 6 result)))
  (and (eq (car result) :posted) (eq (cadr result) :failed) (not (nth 2 result))
       (posp (nth 3 result)) (< (+ 1 (nth 3 result)) (nth 4 result))
       (= (len facts) 6) (= (nth 0 facts) 4) (= (nth 1 facts) 0)
       (= (nth 2 facts) (nth 5 facts)) (eq (nth 3 facts) :ok) (nth 4 facts)
       (posp (nth 1 resource)) (not (nth 2 resource))
       (eq (nth 3 resource) :state) (nth 4 resource)
       (nth 5 resource) (nth 6 resource) (not (nth 7 resource)))))

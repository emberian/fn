; The result path reads the actual shared cursor writer's bytes in both
; published fncu versions. No actor, journal reader or test codec is loaded.
(in-package "ACL2")
(include-book "../books/xfnc-batch-codec")

(defun fn2-xbcu-run (position wanted-version fn2-fields fn2-digests fn2-b3 fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-digests fn2-b3 fn2-pool) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init 256 fn2-fields))
      (fn2-digests (fn2-digests-init *fn2-digest-stride* fn2-digests))
      (fn2-b3 (fn2-b3-table-init 1 fn2-b3))
      (fn2-pool (fn2-pool-init '((1 . 1024)) 1 100 fn2-pool))
      ((mv reserve slot gen fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv chain fn2-pool) (fn2-fnct-put-be 0 0 32 slot gen 9 0 1 fn2-pool))
      ((mv cursor off len fn2-fields fn2-pool)
       (fn2-cns-put-query-cursor 0 6 8 5 7 12 1 3 1 position slot gen 9 0 1 fn2-fields fn2-pool))
      ((mv read-ver version) (fn2-pool-read slot gen (+ off 4) 9 0 1 fn2-pool))
      ((mv header result size fn2-fields fn2-pool)
       (fn2-xfnc-put-batch-header 0 5 7 1 0 12 3 position position 0 0 off len slot gen 9 0 1 fn2-fields fn2-pool))
      ((mv sealed start total fn2-fields fn2-digests fn2-b3 fn2-pool)
       (fn2-fnct-put-k28 0 0 0 0 0 result size slot gen 9 0 1 fn2-fields fn2-digests fn2-b3 fn2-pool))
      ((mv opened kind plen fn2-fields fn2-digests fn2-b3)
       (fn2-fnct-open-pool-span 0 0 slot gen start (+ start total) 9 0 1 fn2-fields fn2-digests fn2-b3 fn2-pool))
      (body (+ start *fn2-fnct-header-octets*))
      ((mv wrapper first end fn2-fields)
       (fn2-xfnc-get-batch-result-span 0 body (+ body plen) slot gen 9 0 1 fn2-fields fn2-pool))
      ((mv wrong & fn2-fields)
       (fn2-xfnc-get-batch-header 0 128 first end 9 6 1 1 5 7 12 3 position slot gen 9 0 1 fn2-fields fn2-pool))
      ((mv right tail fn2-fields)
       (fn2-xfnc-get-batch-header 0 128 first end 8 6 1 1 5 7 12 3 position slot gen 9 0 1 fn2-fields fn2-pool)))
   (mv (and (eq reserve :ok) (eq chain :ok) (eq cursor :ok) (eq read-ver :ok)
            (equal version wanted-version) (eq header :ok) (eq sealed :ok)
            (eq opened :ok) (equal kind *fn2-fnct-port-reply-kind*) (eq wrapper :ok)
            (eq wrong :scope) (eq right :ok) (equal tail end)
            (equal position (fn2-fields-value *fn2-xfnc-batch-header-field-next* fn2-fields)))
       fn2-fields fn2-digests fn2-b3 fn2-pool)))

(defun fn2-xbcu-test (position version)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-fields fn2-digests fn2-b3 fn2-pool)
  (fn2-xbcu-run position version fn2-fields fn2-digests fn2-b3 fn2-pool)))

(assert-event (fn2-xbcu-test 3 1))
(assert-event (fn2-xbcu-test 4294967296 2))

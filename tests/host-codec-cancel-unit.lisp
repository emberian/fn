; Actual submitted Cancel + public loan closure, including a never-started sibling.
(in-package "ACL2")
(include-book "host-codec-unit")
(include-book "../books/host-result")
(defun fn2-host-codec-cancel-setup (target target-gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
  (code cancel gen fn2-ops)
  (b* (((mv code cancel gen fn2-ops) (fn2-op-reserve *fn2-action-cancel* 1 0 1 0 0 fn2-ops))
       ((unless (eq code :ok)) (mv code cancel gen fn2-ops))
       ((mv code fn2-ops) (fn2-op-set-cancel-target cancel gen target target-gen fn2-ops))
       ((unless (eq code :ok)) (mv code cancel gen fn2-ops))
       ((mv code fn2-ops) (fn2-op-enqueue cancel gen fn2-ops))
       ((unless (eq code :ok)) (mv code cancel gen fn2-ops))
       ((mv code fn2-ops) (fn2-outbox-ack 1 fn2-ops)))
   (mv code cancel gen fn2-ops))
  (mv code cancel gen fn2-core)))
(defun fn2-host-codec-cancel-run (receivep fresh stopped fn2-core fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-core fn2-tls-transport fn2-tls-record) :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      (kind (if receivep *fn2-action-receive* *fn2-action-send*))
      ((mv setup op gen fn2-core) (fn2-host-codec-test-loan kind nil nil 17 fn2-core))
      ((mv cancel-setup cancel cancel-gen fn2-core) (fn2-host-codec-cancel-setup op gen fn2-core))
      ((mv opened fn2-tls-transport) (fn2-tls-transport-unit-open 0 8 4 20 fn2-tls-transport))
      ((mv handshake & & & serial fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv handshake-observed & fn2-tls-transport) (fn2-tls-transport-observe 7 17 3 9 serial 0 0 0 fn2-tls-transport))
      ((mv ready & & & & fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv handed & & & & & & fn2-tls-transport) (fn2-tls-transport-handoff 7 17 3 9 fn2-tls-transport))
      ((unless (and (eq setup :ok) (eq cancel-setup :ok) (eq opened :ok) (eq handshake :act)
                    (eq handshake-observed :ok) (eq ready :done) (eq handed :ok)
                    (fn2-core-wfp fn2-core)))
       (mv :setup fn2-core fn2-tls-transport fn2-tls-record))
      ; A fresh sibling has no record row; live-core authorization must bind it.
      ((mv progressed fn2-tls-transport fn2-tls-record)
       (if fresh (mv :ok fn2-tls-transport fn2-tls-record)
        (mv-let (selected action address offset count serial fn2-tls-transport fn2-tls-record)
         (fn2-host-tls-record-next op gen 8 0 fn2-tls-transport fn2-tls-record fn2-core)
         (declare (ignore action address offset count))
         (if (not (eq selected :act)) (mv selected fn2-tls-transport fn2-tls-record)
          (fn2-tls-record-step-observe serial 0 1 0 fn2-tls-transport fn2-tls-record)))))
      ((mv retiring fn2-tls-transport) (fn2-tls-transport-retire 7 17 fn2-tls-transport))
      ((mv cleanup & & & serial fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv freed & fn2-tls-transport)
       (fn2-tls-transport-observe 7 17
        (fn2-tls-transport-slot 0 fn2-tls-transport) (fn2-tls-transport-generation 0 fn2-tls-transport)
        serial 0 0 0 fn2-tls-transport))
      ((mv retired fn2-tls-transport) (fn2-tls-transport-retire 7 17 fn2-tls-transport))
      (fn2-core (if stopped (fn2-core-kind-stop 1 1 fn2-core) fn2-core))
      ((mv marked fn2-tls-record) (fn2-host-tls-mark-closed op gen fn2-tls-transport fn2-tls-record fn2-core))
      ((mv stale & & & & & fn2-tls-record)
       (fn2-host-tls-cancel-result cancel (+ 1 cancel-gen) fn2-tls-record fn2-core))
      ((mv decision target code count won address fn2-tls-record)
       (fn2-host-tls-cancel-result cancel cancel-gen fn2-tls-record fn2-core))
      ((mv outcome & normalized & &) (fn2-host-result kind code count 0 (if receivep 8 1) nil))
      ((mv cancel-outcome & & & &) (fn2-host-result *fn2-action-cancel* :ok 0 0 0 won))
      ((mv duplicate & & & & & fn2-tls-record)
       (fn2-host-tls-cancel-result cancel cancel-gen fn2-tls-record fn2-core))
      (productive (and receivep (not fresh))))
  (mv (and (eq progressed :ok) (eq retiring :closing) (eq cleanup :cleanup) (eq freed :ok) (eq retired :done)
           (eq marked :ok) (eq stale :stale) (= target op) (natp address)
           (eq decision (if productive :productive :cancelled)) (= count (if fresh 0 1))
           (= normalized count) (= outcome (if productive *fn2-outcome-done* *fn2-outcome-cancelled*))
           (= cancel-outcome (if productive *fn2-outcome-not-found* *fn2-outcome-done*))
           (eq duplicate :too-late) (equal (fn2-core-stopped-p fn2-core) stopped))
      fn2-core fn2-tls-transport fn2-tls-record)))
(defun fn2-host-codec-cancel-check (receivep fresh stopped)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (result fn2-core)
   (with-local-stobj fn2-tls-transport
    (mv-let (result fn2-core fn2-tls-transport)
     (with-local-stobj fn2-tls-record
      (mv-let (result fn2-core fn2-tls-transport fn2-tls-record)
       (fn2-host-codec-cancel-run receivep fresh stopped fn2-core fn2-tls-transport fn2-tls-record)
       (mv result fn2-core fn2-tls-transport)))
     (mv result fn2-core)))
   result)))
(assert-event (fn2-host-codec-cancel-check t nil nil))
(assert-event (fn2-host-codec-cancel-check nil nil nil))
(assert-event (fn2-host-codec-cancel-check t t nil))
(assert-event (fn2-host-codec-cancel-check nil t nil))
(assert-event (fn2-host-codec-cancel-check t nil t))
(assert-event (fn2-host-codec-cancel-check nil t t))

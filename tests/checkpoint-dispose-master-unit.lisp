(defun fn2-cdm-array-frame (at first count before after)
 (declare (xargs :verify-guards nil :measure (acl2-count before)))
 (if (atom before) (equal before after)
  (and (consp after)
       (or (and (<= first at) (< at (+ first count))) (equal (car before) (car after)))
       (fn2-cdm-array-frame (+ 1 (nfix at)) first count (cdr before) (cdr after)))))

 (declare (xargs :verify-guards nil :measure (acl2-count values)))
 (if (atom values) (<= (+ first count) (nfix at))
  (and (or (< at first) (<= (+ first count) at) (equal (car values) default))
       (fn2-cdm-array-defaults (+ 1 (nfix at)) first count default (cdr values)))))

; Exact48-word transfer control with explicitly seeded typed pending/HELD
; premises. This does not witness cold verification, physical Fence or copy IO.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-bank-transfer")
(defun fn2-cbt-meta (i fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :verify-guards nil :measure (nfix (- 12 (nfix i)))))
 (if (>= (nfix i) 12) fn2-checkpoint-publication
  (let* ((value (case i (0 2) ((2 3 4 7 8 9 10) 1) (11 48) (otherwise 0)))
         (fn2-checkpoint-publication (update-fn2-checkpoint-publication-cold-metai i value fn2-checkpoint-publication)))
   (fn2-cbt-meta (+ i 1) fn2-checkpoint-publication))))
(defun fn2-cbt-body (fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
 (declare (xargs :stobjs (fn2-checkpoint-teardown-debt fn2-checkpoint-publication) :verify-guards nil))
 (b* ((fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-init 1 fn2-checkpoint-teardown-debt))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-init 1 fn2-checkpoint-publication))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-put 0
       (cold-bind-phase *fn2-checkpoint-cold-bind-phase-complete*) (cold-bound-mask 1) (cold-pending-mask 1)
       (bank1-valid 1) (bank1-candidate 1) (bank1-checkpoint 2) (bank1-history 1) (bank1-incarnation 1)))
      (fn2-checkpoint-publication (fn2-cbt-meta 0 fn2-checkpoint-publication))
      (fn2-checkpoint-teardown-debt (fn2-checkpoint-teardown-debt-put 0 (phase *fn2-checkpoint-teardown-debt-phase-held*)
       (token 9) (owner-kind 1) (owner-slot 2) (owner-gen 3) (checkpoint 1) (history 1) (incarnation 1)
       (installation-commit 1) (installation-event 1) (word-cursor 40) (anchor-mask 1)))
      (blocked (not (fn2-checkpoint-bank-obligations-excludedp 0 1 1 1 fn2-checkpoint-publication)))
      ; Remove only the final slot-specific word equality, not the common tuple.
      (fn2-checkpoint-teardown-debt (update-fn2-checkpoint-teardown-debt-anchorsi 7 1 fn2-checkpoint-teardown-debt))
      ((mv refused fn2-checkpoint-publication)
       (fn2-checkpoint-bank-obligations-transfer 0 fn2-checkpoint-teardown-debt fn2-checkpoint-publication))
      (kept (and (eq refused :retained) (= (fn2-checkpoint-publication-cold-pending-mask 0 fn2-checkpoint-publication) 1)
                  (= (fn2-checkpoint-publication-cold-retired-mask 0 fn2-checkpoint-publication) 0)))
      (fn2-checkpoint-teardown-debt (update-fn2-checkpoint-teardown-debt-anchorsi 7 0 fn2-checkpoint-teardown-debt))
      (whole (fn2-checkpoint-teardown-cold-retainedp 0 fn2-checkpoint-teardown-debt fn2-checkpoint-publication))
      ((mv transferred fn2-checkpoint-publication)
       (fn2-checkpoint-bank-obligations-transfer 0 fn2-checkpoint-teardown-debt fn2-checkpoint-publication)))
  (mv (and blocked kept whole (eq transferred :transferred)
       (= (fn2-checkpoint-publication-cold-pending-mask 0 fn2-checkpoint-publication) 0)
       (= (fn2-checkpoint-publication-cold-retired-mask 0 fn2-checkpoint-publication) 1)
       (fn2-checkpoint-bank-obligations-excludedp 0 1 1 1 fn2-checkpoint-publication)
       (= (fn2-checkpoint-teardown-debt-phase 0 fn2-checkpoint-teardown-debt) *fn2-checkpoint-teardown-debt-phase-held*)
       (= (fn2-checkpoint-teardown-debt-anchor-mask 0 fn2-checkpoint-teardown-debt) 1)
       (= (fn2-checkpoint-publication-bank1-valid 0 fn2-checkpoint-publication) 1))
      fn2-checkpoint-teardown-debt fn2-checkpoint-publication)))
(defun fn2-cbt-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoint-teardown-debt
  (mv-let (answer fn2-checkpoint-teardown-debt)
   (with-local-stobj fn2-checkpoint-publication
    (mv-let (answer fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
     (fn2-cbt-body fn2-checkpoint-teardown-debt fn2-checkpoint-publication)
     (mv answer fn2-checkpoint-teardown-debt)))
   answer)))
(assert-event (fn2-cbt-test))

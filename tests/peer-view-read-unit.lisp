; One private journal member materialized with the POST writer's row codecs.
; This starts at the retained reader's verified-leaf boundary. It exercises
; filtering, pair identity, revision restart and the real output span, with
; caller-supplied lease and scope; it does not authenticate a connection.
(in-package "ACL2")
(include-book "../books/peer-view-read")
(include-book "../books/commit-format")
(include-book "../books/xfnc-batch-codec")
(local (in-theory (disable fn2-peer-view-read-step)))

(defmacro fn2-pvu-record (rkind layout encoder values at)
 `(b* (((mv hc body fn2-fields fn2-pool)
        (fn2-commit-pack-txn-header ,rkind 1 0 src sg ,at scratch gg 9 0 1 1 2 3 fn2-fields fn2-pool))
       ((mv vc & fn2-fields fn2-pool)
        (fn2-run-load-values ,layout ,values 0 scratch gg 0 9 0 1 fn2-fields fn2-pool))
       ((mv ec next fn2-pool) (,encoder 0 src sg body 9 0 1 fn2-fields fn2-pool)))
   (mv (and (eq hc :ok) (eq vc :ok) (eq ec :ok)) body next fn2-fields fn2-pool)))

(defun fn2-pvu-drive (fuel stream auth fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool)
                 :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv '(:fuel) fn2-event-read fn2-fields)
  (mv-let (code hs he es ee fn2-event-read fn2-fields)
   (fn2-peer-view-read-step 1 8 stream auth 9 0 1 fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool)
   (if (eq code :more) (fn2-pvu-drive (- fuel 1) stream auth fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool)
     (mv (list code hs he es ee) fn2-event-read fn2-fields)))))

(defun fn2-pvu-batch (src sg hs he es ee tx tg fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* (((mv reset fn2-pool) (fn2-pool-reset tx tg 9 0 1 fn2-pool))
      ((mv chain fn2-pool) (fn2-run-zero 32 tx tg 0 9 0 1 fn2-pool))
      ((mv cursor cs cn fn2-fields fn2-pool)
       (fn2-cns-put-query-cursor 0 6 8 5 7 12 1 3 1 3 tx tg 9 0 1 fn2-fields fn2-pool))
      ((mv header start n fn2-fields fn2-pool)
       (fn2-xfnc-put-batch-header 0 5 7 1 0 12 3 3 3 0 1 cs cn tx tg 9 0 1 fn2-fields fn2-pool))
      (at (+ start n))
      ((mv wrote end fn2-fields fn2-pool)
       (fn2-xfnc-put-batch-item 0 src sg hs he es ee 3 tx tg at 9 0 1 fn2-fields fn2-pool))
      ((mv scope & fn2-fields)
       (fn2-xfnc-get-batch-header 0 128 start end 9 6 1 1 5 7 12 3 2 tx tg 9 0 1 fn2-fields fn2-pool))
      ((mv parsed off fn2-fields)
       (fn2-xfnc-get-batch-header 0 128 start end 8 6 1 1 5 7 12 3 2 tx tg 9 0 1 fn2-fields fn2-pool))
      (chain-n (fn2-fields-ref-len *fn2-xfnc-batch-header-field-chain* fn2-fields))
      ((mv read next left pos h0 h1 e0 e1 fn2-fields)
       (fn2-xfnc-get-batch-item 128 off end 1 2 3 tx tg 9 0 1 fn2-fields fn2-pool))
      ((mv hcode hcmp &)
       (fn2-pool-compare src sg hs 9 0 1 tx tg h0 9 0 1 (- he hs) fn2-pool))
      ((mv ecode ecmp &)
       (fn2-pool-compare src sg es 9 0 1 tx tg e0 9 0 1 (- ee es) fn2-pool))
      ((mv byte fn2-pool) (fn2-pool-write tx tg end 0 9 0 1 fn2-pool))
      ((mv trailing & & & & & & & fn2-fields)
       (fn2-xfnc-get-batch-item 128 off (+ 1 end) 1 2 3 tx tg 9 0 1 fn2-fields fn2-pool)))
   (mv (and (eq reset :ok) (eq chain :ok) (eq cursor :ok) (eq header :ok) (eq wrote :ok)
            (eq scope :scope) (eq parsed :ok) (equal chain-n 32) (equal off at)
            (eq read :ok) (equal next end) (equal left 0) (equal pos 3)
            (equal (- h1 h0) (- he hs)) (equal (- e1 e0) (- ee es))
            (eq hcode :ok) (eq hcmp :equal) (eq ecode :ok) (eq ecmp :equal)
            (eq byte :ok) (eq trailing :frame))
       fn2-fields fn2-pool)))

(defun fn2-pvu-run (fault fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-event-read (fn2-event-read-init 1 fn2-event-read))
      (fn2-journal-lease (fn2-journal-lease-init 1 fn2-journal-lease))
      (fn2-journal-members (fn2-journal-members-init 1 fn2-journal-members))
      (fn2-fields (fn2-fields-init 256 fn2-fields))
      (fn2-pool (fn2-pool-init '((2 . 4096)) 1 100 fn2-pool))
      ((mv rc src sg fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv gc scratch gg fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv init fn2-pool) (fn2-run-zero 4096 scratch gg 0 9 0 1 fn2-pool))
      (digest (cons 1 (make-list 32 :initial-element 42)))
      (key (list 1 '(60 120 64 121 62) 1 1 digest 1 2 3 1))
      ((mv pc & pnext fn2-fields fn2-pool)
       (fn2-pvu-record *record-kind-allocation* *fn2-format-allocation* fn2-format-allocation-encode '(7 9 1 3 4) 0))
      ((mv hc hs he fn2-fields fn2-pool)
       (fn2-pvu-record *record-kind-identity-history* *fn2-identity-history-entry* fn2-identity-history-entry-encode
        (append key '(1 1)) pnext))
      ((mv ac & anext fn2-fields fn2-pool)
       (fn2-pvu-record *record-kind-addr* *fn2-addr-entry* fn2-addr-entry-encode '(8 1 1 99 1) he))
      (ekey (if (eq fault :mismatch) (update-nth 4 (cons 1 (make-list 32 :initial-element 43)) key) key))
      ((mv ec es ee fn2-fields fn2-pool)
       (if (eq fault :missing) (mv t anext anext fn2-fields fn2-pool)
        (fn2-pvu-record *record-kind-identity-evidence* *fn2-identity-evidence-entry* fn2-identity-evidence-entry-encode
        (append ekey '(0 7)) anext)))
      ((mv oc & end fn2-fields fn2-pool)
       (fn2-pvu-record *record-kind-overview* *fn2-overview-entry* fn2-overview-entry-encode
        '(12 4 1 1 (80 82 73 86 65 84 69)) ee))
      (fn2-journal-lease (fn2-journal-lease-put 0 (phase *fn2-journal-lease-phase-ready*)
               (token 1) (kind 9) (owner 0) (generation 1) (cut-commit 1) (cut-event 1)))
      (fn2-event-read (fn2-event-read-put 0 (phase *fn2-event-read-phase-members*)
               (token 1) (owner-kind 9) (owner-slot 0) (owner-gen 1) (cut-commit 1) (cut-event 1)
               (slot src) (gen sg) (field-base 0) (commit 1) (first 1) (members 1)))
      (fn2-journal-members (fn2-journal-members-put 0 (phase *fn2-journal-members-phase-leaf*) (hash-phase 3)
               (event 1) (start 0) (leaf-end end) (slot src) (gen sg) (owner-kind 9) (owner-slot 0) (owner-gen 1)))
      ((mv begin & & & & fn2-event-read fn2-fields)
       (fn2-peer-view-read-step 1 8 12 2 9 0 1 fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool))
      ((mv part & & & & fn2-event-read fn2-fields)
       (fn2-peer-view-read-step 1 8 12 2 9 0 1 fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool))
      (was (fn2-event-read-view-off 0 fn2-event-read))
      ((mv restart & & & & fn2-event-read fn2-fields)
       (fn2-peer-view-read-step 1 8 12 3 9 0 1 fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool))
      (rewound (fn2-event-read-view-off 0 fn2-event-read))
      ((mv yes fn2-event-read fn2-fields)
       (fn2-pvu-drive 9 12 3 fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool))
      ((mv wrong fn2-event-read fn2-fields)
       (fn2-pvu-drive 9 99 3 fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool))
      ((mv stale a b c d fn2-event-read fn2-fields)
       (fn2-peer-view-read-step 2 8 12 3 9 0 1 fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool))
      ((mv batch fn2-fields fn2-pool)
       (if fault (mv t fn2-fields fn2-pool)
         (fn2-pvu-batch src sg hs he es ee scratch gg fn2-fields fn2-pool))))
  (mv (or (and (eq rc :ok) (eq gc :ok) (eq init :ok) pc hc ac ec oc batch
               (eq begin :more) (eq part :more) (eq restart :more) (posp was) (equal rewound 0)
               (equal yes (case fault (:missing '(:dependency 0 0 0 0)) (:mismatch '(:identity 0 0 0 0))
                                (otherwise (list :item hs he es ee))))
               (equal wrong '(:hidden 0 0 0 0)) (equal (list stale a b c d) '(:source 0 0 0 0)))
          (cw "Projection ~x0 returned ~x1, expected bounds ~x2 (writers ~x3).~%"
              fault (list begin part was rewound yes wrong stale a b c d)
              (list hs he es ee) (list rc gc init pc hc ac ec oc batch)))
   fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool)))

(defun fn2-pvu-test (fault)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool)
  (fn2-pvu-run fault fn2-event-read fn2-journal-lease fn2-journal-members fn2-fields fn2-pool)))

(assert-event (fn2-pvu-test nil))
(assert-event (fn2-pvu-test :mismatch))
(assert-event (fn2-pvu-test :missing))

; Copy-kernel boundary only: verifier-owned phase/source is an explicit premise.
; Real generated body/header encoders supply bytes; no authentication claim.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/event-read-witness")
(include-book "../books/runs-page")
(defun fn2-erwu-snapshot (fn2-event-read fn2-pool)
 (declare (xargs :stobjs (fn2-event-read fn2-pool) :verify-guards nil))
 (list (fn2-event-read-copy fn2-event-read) (fn2-pool-copy fn2-pool)))
(defun fn2-erwu-drive (fuel budget target fn2-event-read fn2-pool)
 (declare (xargs :stobjs (fn2-event-read fn2-pool) :verify-guards nil :measure (nfix fuel)))
 (b* (((when (equal (fn2-event-read-phase 0 fn2-event-read) target)) (mv :copied fn2-event-read fn2-pool))
      ((when (zp fuel)) (mv :fuel fn2-event-read fn2-pool))
      (cursor (fn2-event-read-witness-cursor 0 fn2-event-read))
      (phase (fn2-event-read-phase 0 fn2-event-read))
      (length (if (equal phase *fn2-event-read-phase-witness-seal*)
                  (fn2-event-read-witness-seal-length 0 fn2-event-read) (fn2-event-read-witness-header-length 0 fn2-event-read)))
      ((mv code fn2-event-read fn2-pool) (fn2-event-read-witness-copy-step budget fn2-event-read fn2-pool))
      ((unless (eq code :more)) (mv code fn2-event-read fn2-pool))
      (next (if (equal (fn2-event-read-phase 0 fn2-event-read) target) length (fn2-event-read-witness-cursor 0 fn2-event-read)))
      ((unless (and (<= cursor next) (<= (- next cursor) budget))) (mv :over-budget fn2-event-read fn2-pool)))
  (fn2-erwu-drive (- fuel 1) budget target fn2-event-read fn2-pool)))
(defun fn2-erwu-body (budget fault fn2-event-read fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-event-read fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-event-read (fn2-event-read-init 1 fn2-event-read))
      (fn2-fields (fn2-fields-init *fn2-format-sealed-batch-num-fields* fn2-fields))
      (fn2-pool (fn2-pool-init '((2 . 4096)) 1 100 fn2-pool))
      ((mv a slot gen fn2-pool) (fn2-pool-reserve 0 7 0 1 fn2-pool))
      ((mv b dst dg fn2-pool) (fn2-pool-reserve 0 7 0 1 fn2-pool))
      ((mv zero fn2-pool) (fn2-run-zero 4096 slot gen 0 7 0 1 fn2-pool))
      ((mv dzero fn2-pool) (fn2-run-zero *fn2-event-witness-work-bytes* dst dg 0 7 0 1 fn2-pool))
      (off *fn2-format-frame-header-max-size*)
      ((mv packed end fn2-fields fn2-pool)
       (fn2-commit-pack :seal 2 0 slot gen off dst dg 1 2 3 1 1 1 7 0 1 1 2 3 4 5 fn2-fields fn2-pool))
      (length (- end off))
      (setup (and (eq a :ok) (eq b :ok) (eq zero :ok) (eq dzero :ok) (eq packed :ok)
                  (posp length) (<= length *fn2-format-sealed-batch-max-size*)))
      (body (fn2-pool-logical-octets length (+ (fn2-pool-base slot fn2-pool) off) fn2-pool))
      (fn2-event-read (fn2-event-read-put 0
       (phase *fn2-event-read-phase-witness-seal*) (token 19) (owner-kind 7) (owner-slot 0) (owner-gen 1)
       (commit 1) (first 1) (members 1) (slot slot) (gen gen) (body-off off) (body-len length)
       (witness-enabled 1) (witness-token 19) (witness-slot dst) (witness-gen dg)
       (witness-phase *fn2-event-witness-phase-seal*) (witness-commit 1) (witness-first 1) (witness-members 1)
       (witness-seal-length length) (witness-cursor 0)))
      (before (fn2-erwu-snapshot fn2-event-read fn2-pool))
      ((mv zcode fn2-event-read fn2-pool) (fn2-event-read-witness-copy-step 0 fn2-event-read fn2-pool))
      (zero-unchanged (and (eq zcode :more) (equal before (fn2-erwu-snapshot fn2-event-read fn2-pool))))
      (fn2-event-read (cond ((eq fault :token) (fn2-event-read-set-witness-token 0 20 fn2-event-read))
                           ((eq fault :handle) (fn2-event-read-set-witness-gen 0 (+ 1 dg) fn2-event-read)) (t fn2-event-read)))
      (before (fn2-erwu-snapshot fn2-event-read fn2-pool))
      ((mv copied fn2-event-read fn2-pool) (fn2-erwu-drive 4096 budget *fn2-event-read-phase-read-records* fn2-event-read fn2-pool))
      ((when fault) (mv (and setup zero-unchanged (eq copied :source)
                       (equal before (fn2-erwu-snapshot fn2-event-read fn2-pool))) fn2-event-read fn2-fields fn2-pool))
      (body-preserved (equal body (fn2-pool-logical-octets length (+ (fn2-pool-base dst fn2-pool) *fn2-event-witness-seal-offset*) fn2-pool)))
      ; The actual caller issues the records read only after this body capture.
      ((mv reset fn2-pool) (fn2-run-zero 4096 slot gen 0 7 0 1 fn2-pool))
      ((mv header hend fn2-fields fn2-pool)
       (fn2-commit-pack :frame 1 0 slot gen 0 dst dg 1 2 3 1 1 1 7 0 1 1 2 3 4 5 fn2-fields fn2-pool))
      (head (fn2-pool-logical-octets hend (fn2-pool-base slot fn2-pool) fn2-pool))
      (fn2-event-read (fn2-event-read-put 0 (phase *fn2-event-read-phase-witness-header*)
       (body-off hend) (body-len 3900) (witness-header-length hend)))
      ((mv hcopied fn2-event-read fn2-pool) (fn2-erwu-drive 4096 budget *fn2-event-read-phase-members* fn2-event-read fn2-pool))
      ((mv prefix fn2-pool) (fn2-pool-write dst dg 0 99 7 0 1 fn2-pool)))
  (mv (and setup
           zero-unchanged (eq copied :copied) body-preserved (eq reset :ok) (eq header :ok)
           (eq hcopied :copied) (eq prefix :ok)
           (equal (fn2-event-read-witness-phase 0 fn2-event-read) *fn2-event-witness-phase-ready*)
           (equal body (fn2-pool-logical-octets length (+ (fn2-pool-base dst fn2-pool) *fn2-event-witness-seal-offset*) fn2-pool))
           (equal head (fn2-pool-logical-octets hend (+ (fn2-pool-base dst fn2-pool) *fn2-event-witness-header-offset*) fn2-pool)))
      fn2-event-read fn2-fields fn2-pool)))
(defun fn2-erwu-test (budget fault)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-event-read
  (mv-let (answer fn2-event-read)
   (with-local-stobj fn2-fields
    (mv-let (answer fn2-event-read fn2-fields)
     (with-local-stobj fn2-pool
      (mv-let (answer fn2-event-read fn2-fields fn2-pool) (fn2-erwu-body budget fault fn2-event-read fn2-fields fn2-pool)
       (mv answer fn2-event-read fn2-fields))) (mv answer fn2-event-read))) answer)))
(assert-event (fn2-erwu-test 1 nil))
(assert-event (fn2-erwu-test 4096 nil))
(assert-event (fn2-erwu-test 1 :token))
(assert-event (fn2-erwu-test 1 :handle))

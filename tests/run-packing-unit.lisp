; Prepared source controls only. No ACL2 execution/certification is claimed.
; Exercise actual production schema codecs, overlay index replacement, Ref
; sizing, and the served room/close primitives. Writer prefixes below are
; explicit synthetic packing premises, not complete page/physical witnesses.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/runs-served")

(defun fn2-rpu-body (fn2-run-writers fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-run-writers fn2-overlays fn2-overlay-index fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-run-writers (fn2-run-writers-init 1 fn2-run-writers))
      (fn2-overlays (fn2-overlays-init 1 fn2-overlays))
      (fn2-overlay-index (fn2-overlay-index-init 4 fn2-overlay-index))
      (fn2-fields (fn2-fields-init 300 fn2-fields))
      (fn2-pool (fn2-pool-init '((1 . 65536) (1 . 256)) 1 100 fn2-pool))
      ((mv arena-code arena agen fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv name-code name ngen fn2-pool) (fn2-pool-reserve 1 9 0 1 fn2-pool))
      ((mv zero-code fn2-pool) (fn2-run-zero 32 name ngen 0 9 0 1 fn2-pool))
      ((mv byte-code fn2-pool) (fn2-pool-write name ngen 0 97 9 0 1 fn2-pool))
      ((mv opened fn2-overlays fn2-pool) (fn2-ov-start 0 8 arena agen 0 4 9 0 1 0 fn2-overlays fn2-overlay-index fn2-pool))
      (fn2-fields (fn2-fields-put *fn2-groups-entry-field-name* (ref-slot name) (ref-gen ngen) (ref-off 0) (ref-len 1)))
      (fn2-fields (fn2-fields-set-value *fn2-groups-entry-field-group* 127 fn2-fields))
      (old-size (fn2-run-layout-size 8 0 0 fn2-fields))
      ((mv inserted fn2-overlays fn2-overlay-index fn2-pool) (fn2-ov-write 0 0 0 nil fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-set-value *fn2-groups-entry-field-group* 128 fn2-fields))
      (new-size (fn2-run-layout-size 8 0 0 fn2-fields))
      ((mv replaced fn2-overlays fn2-overlay-index fn2-pool) (fn2-ov-write 0 0 0 t fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ((mv decoded end fn2-fields) (fn2-ov-entry 0 0 100 fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (current-size (fn2-run-layout-size 8 0 100 fn2-fields))
      ; A deliberate tight packing prefix distinguishes the live indexed row
      ; from old replacement bytes that remain in overlay arena FILL.
      (fn2-run-writers (fn2-run-writers-put 0 (phase *fn2-run-writer-phase-open*)
       (cursor *fn2-run-entries-base*) (entries 0) (restarts 0)
       (limit (+ *fn2-run-entries-base* new-size *fn2-run-restart-bytes*))))
      ((unless (and (eq arena-code :ok) (eq name-code :ok) (eq zero-code :ok) (eq byte-code :ok)
                     (eq opened :ok) (eq inserted :ok) (eq replaced :ok) (eq decoded :ok)
                     (equal new-size (+ old-size 1)) (equal current-size new-size)
                     (equal (fn2-fields-value (+ 100 *fn2-groups-entry-field-group*) fn2-fields) 128)
                     (equal (fn2-overlays-count 0 fn2-overlays) 1)
                     (equal (fn2-overlays-fill 0 fn2-overlays) (+ old-size new-size))
                     (equal end (+ old-size new-size)) (equal (fn2-overlay-index-off 0 fn2-overlay-index) old-size)
                     (fn2-run-roomp 0 current-size fn2-run-writers)
                     (not (fn2-run-roomp 0 (fn2-overlays-fill 0 fn2-overlays) fn2-run-writers))))
       (mv nil fn2-run-writers fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ; Actual generated Ref sizing changes at allocation127→128; no guessed
      ; byte width or maximum-size estimate supplies the packing decision.
      (fn2-fields (fn2-fields-set-value (+ 200 *fn2-format-ref-field-physical-unit*) 16 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 200 *fn2-format-ref-field-writer-epoch*) 1 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 200 *fn2-format-ref-field-allocation*) 127 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 200 *fn2-format-ref-field-page-kind*) *page-kind-run-index* fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 200 *fn2-format-ref-field-encoded-length*) *fn2-run-page-size* fn2-fields))
      (fn2-fields (fn2-fields-put (+ 200 *fn2-format-ref-field-expected-hash*) (ref-slot name) (ref-gen ngen) (ref-off 0) (ref-len 32)))
      (small (fn2-format-ref-size 200 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ 200 *fn2-format-ref-field-allocation*) 128 fn2-fields))
      (large (fn2-format-ref-size 200 fn2-fields))
      (cursor (- *fn2-run-page-size* small *fn2-run-restart-bytes*))
      (fn2-run-writers (fn2-run-writers-put 0 (cursor cursor) (entries 15) (restarts 1) (limit *fn2-run-page-size*)))
      ((mv fits15 end15 restarts15) (fn2-run-pack-bound small cursor 15 1 *fn2-run-page-size*))
      ((mv fits16 end16 restarts16) (fn2-run-pack-bound small cursor 16 1 *fn2-run-page-size*))
      ((unless (and (equal large (+ small 1)) fits15 (not fits16)
                     (equal end15 *fn2-run-page-size*) (equal restarts15 1)
                     (equal end16 (+ *fn2-run-page-size* *fn2-run-restart-bytes*)) (equal restarts16 2)
                     (fn2-run-roomp 0 small fn2-run-writers) (not (fn2-run-roomp 0 large fn2-run-writers))))
       (mv nil fn2-run-writers fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (fn2-run-writers (fn2-run-writers-put 0 (entries 16) (limit (+ 100 *fn2-run-page-size*))))
      ((unless (not (fn2-run-roomp 0 small fn2-run-writers)))
       (mv nil fn2-run-writers fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ; Actual full-page handling remains terminal for an empty writer and
      ; closes only a nonempty writer. No retry silently consumes the entry.
      (fn2-run-writers (fn2-run-writers-put 0 (entries 0) (phase *fn2-run-writer-phase-open*)))
      ((unless (not (fn2-run-roomp 0 large fn2-run-writers)))
       (mv nil fn2-run-writers fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ((mv empty fn2-run-writers) (fn2-run-close-full 0 fn2-run-writers))
      ((unless (and (eq empty :length) (equal (fn2-run-writers-phase 0 fn2-run-writers) *fn2-run-writer-phase-open*)))
       (mv nil fn2-run-writers fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (fn2-run-writers (fn2-run-writers-set-entries 0 1 fn2-run-writers))
      ((mv nonempty fn2-run-writers) (fn2-run-close-full 0 fn2-run-writers)))
  (mv (and (eq nonempty :more) (equal (fn2-run-writers-phase 0 fn2-run-writers) *fn2-run-writer-phase-closing*)
           (fn2-run-writers-wfp fn2-run-writers) (fn2-overlays-wfp fn2-overlays)
           (fn2-overlay-index-wfp fn2-overlay-index) (fn2-fields-wfp fn2-fields) (fn2-pool-wfp fn2-pool))
      fn2-run-writers fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
(defun fn2-rpu-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-run-writers (mv-let (answer fn2-run-writers)
  (with-local-stobj fn2-overlays (mv-let (answer fn2-run-writers fn2-overlays)
   (with-local-stobj fn2-overlay-index (mv-let (answer fn2-run-writers fn2-overlays fn2-overlay-index)
    (with-local-stobj fn2-fields (mv-let (answer fn2-run-writers fn2-overlays fn2-overlay-index fn2-fields)
     (with-local-stobj fn2-pool (mv-let (answer fn2-run-writers fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
      (fn2-rpu-body fn2-run-writers fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
      (mv answer fn2-run-writers fn2-overlays fn2-overlay-index fn2-fields)))
     (mv answer fn2-run-writers fn2-overlays fn2-overlay-index)))
    (mv answer fn2-run-writers fn2-overlays)))
   (mv answer fn2-run-writers))) answer)))
(assert-event (fn2-rpu-run))

;;; Actual offline administrative entry adapters retain primary failures.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defun source-definition (path kind name)
  (with-open-file (stream path)
    (let* ((text (make-string (file-length stream)))
           (prefix (format nil "(~a ~a " kind name)))
      (read-sequence text stream)
      (let ((start (search prefix text)))
        (unless start (error "missing definition ~a" name))
        (read-from-string text nil nil :start start)))))
(defparameter +fnn-exit-ok+ 0)
(defvar *mode* nil)
(defvar *closed* 0)
(defvar *fnn-stdout* nil)
(defun fnn-err (&rest args) (declare (ignore args)))
(defun fnn-out (&rest args) (declare (ignore args)))
(defun fnn-admin-plan-acceptedp (plan) (declare (ignore plan)) t)
(defun fnn-admin-plan-reason (plan) (declare (ignore plan)) nil)
(defun fnn-refuse (&rest args) (error "refused ~a" args))
(defun fnn-fault (&rest args) (error "fault ~a" args))
(defun fnn-open-live-store (&rest args)
  (declare (ignore args))
  (when (eq *mode* :open-fault) (error "open-fault"))
  (values :store 0))
(defun fnn-store-close (store)
  (assert (eq store :store)) (incf *closed*)
  (when (member *mode* '(:close-fault :both-fault)) (error "close-fault")))
(defun body-observation ()
  (when (member *mode* '(:body-fault :both-fault)) (error "body-fault")))
(defun fnn-core-state (&rest args) (declare (ignore args)) (body-observation) nil)
(defun fnn-octet-list-p (value) (listp value))
(defun fnn-octets (value) value)
(defun fnn-require-writer (store) (assert (eq store :store)) (body-observation))
(defun fnn-lim-plan-p (plan) (eq plan :limit))
(defun fnn-admin-execute-limit (&rest args) (declare (ignore args)) 7)
(defun fnn-admin-clock-plan () :clock)
(defun fnn-admin-reconfigure (&rest args) (declare (ignore args)) (values :record nil))
(defun fnn-admin-publish-record (&rest args) (declare (ignore args)) (values 1 "record" :verified))
(eval (source-definition (or (sb-ext:posix-getenv "FN_CLEANUP_HOST_SOURCE") "host/native/io.lisp")
                         "defmacro" "fnn-unwind-cleanups"))
(dolist (name '(fnn-admin-query fnn-admin-execute))
  (eval (source-definition (or (sb-ext:posix-getenv "FN_ADMIN_HOST_SOURCE") "host/native/admin.lisp")
                           "defun" (string-downcase name)))
  (dolist (mode '(:success :open-fault :body-fault :close-fault :both-fault))
    (let ((*mode* mode) (*closed* 0) (*fnn-stdout* (make-string-output-stream)))
      (let ((answer (handler-case (funcall name "/store" :plan)
                      (error (e) (princ-to-string e)))))
        (assert (= *closed* (if (eq mode :open-fault) 0 1)))
        (assert (equal answer (case mode
                              (:success 0) (:open-fault "open-fault")
                              ((:body-fault :both-fault) "body-fault")
                              (:close-fault "close-fault"))))))))
(let ((*mode* :success) (*closed* 0))
  (assert (= (fnn-admin-execute "/store" :limit) 7))
  (assert (= *closed* 1)))
(format t "Administrative cleanup passed (11 paths)~%")

; Source-prepared actual-entry controls. Construction premises are synthetic;
; no persisted acceptance or admission/certification result is claimed here.
(in-package "ACL2")
(include-book "../sim/commit-proof-step")
(defun fn2-cac-seed (complete fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
             (fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core)))
  (code e fn2-extents fn2-checkpoint-construction)
  (b* (((mv code & e ep al fn2-extents) (fn2-alloc-reserve fn2-extents))
       ((unless (eq code :ok)) (mv code 0 fn2-extents fn2-checkpoint-construction))
       (fn2-checkpoint-construction (fn2-checkpoint-construction-put e
        (live 1) (token 7) (owner-kind 1) (owner-slot 2) (owner-gen 3)
        (role 0) (epoch ep) (counter al) (intended-bytes 128) (completed-bytes complete))))
   (mv :ok e fn2-extents fn2-checkpoint-construction))
  (mv code e fn2-core)))
(defun fn2-cac-scan (left fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :horizon fn2-core)
  (mv-let (code fn2-core) (fn2-checkpoint-allocation-step fn2-core)
   (if (eq code :more) (fn2-cac-scan (- left 1) fn2-core) (mv code fn2-core)))))
(defun fn2-cac-token (token fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (fn2-extents)
  (update-fn2-alloc-freeze-token token fn2-extents) fn2-core))
(defun fn2-cac-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init (fn2-b-test-profile *fn2-profile-tiny* 0) fn2-core))
      ((mv premature fn2-core) (fn2-checkpoint-allocation-begin 1 2 3 fn2-core))
      ((mv begun fn2-core) (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv a first fn2-core) (fn2-cac-seed 128 fn2-core))
      ((mv b second fn2-core) (fn2-cac-seed 127 fn2-core))
      (fn2-core (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (fn2-extents)
        (let* ((fn2-extents (update-fn2-alloc-freeze-phase 2 fn2-extents))
               (fn2-extents (update-fn2-alloc-freeze-token 7 fn2-extents))
               (fn2-extents (update-fn2-alloc-freeze-owner-kind 1 fn2-extents))
               (fn2-extents (update-fn2-alloc-freeze-owner-slot 2 fn2-extents)))
         (update-fn2-alloc-freeze-owner-gen 3 fn2-extents)) fn2-core))
      ((mv wrong-owner fn2-core) (fn2-checkpoint-allocation-begin 1 2 4 fn2-core))
      ((mv start fn2-core) (fn2-checkpoint-allocation-begin 1 2 3 fn2-core))
      ((mv busy fn2-core) (fn2-checkpoint-allocation-begin 1 2 3 fn2-core))
      (fn2-core (fn2-cac-token 8 fn2-core))
      ((mv stale-pack fn2-core) (fn2-checkpoint-allocation-step fn2-core))
      (fn2-core (fn2-cac-token 7 fn2-core))
      ((mv one fn2-core) (fn2-checkpoint-allocation-step fn2-core))
      ((mv incomplete fn2-core) (fn2-checkpoint-allocation-step fn2-core))
      (retained (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))) (ok)
        (and (= (fn2-retirement-control-count 0 fn2-retirement-control) 1)
             (= (fn2-retirement-control-scan 0 fn2-retirement-control) second)
             (= (fn2-retirement-control-extent 1 fn2-retirement-control) first)) ok))
      (fn2-core (stobj-let ((fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core)))
        (fn2-checkpoint-construction)
        (fn2-checkpoint-construction-set-completed-bytes second 128 fn2-checkpoint-construction) fn2-core))
      ((mv staged fn2-core) (fn2-cac-scan 32 fn2-core))
      (fn2-core (fn2-cac-token 8 fn2-core))
      ((mv stale-submit & & fn2-core) (fn2-checkpoint-allocation-submit fn2-core))
      (fn2-core (fn2-cac-token 7 fn2-core))
      ((mv no-persist & & fn2-core) (fn2-commit-lifecycle-step 0 0 0 fn2-core))
      ; Wrong batch is rejected before opening the allocation decoder, even
      ; with a caller-supplied record offset and an actual staged workspace.
      ((mv unbound fn2-core)
       (fn2-checkpoint-allocation-install-member 0 0 0 0 0 0 0 99 99 1 2 3 fn2-core))
      ((mv slot gen len)
       (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))) (slot gen len)
        (mv (fn2-retirement-control-slot 0 fn2-retirement-control)
            (fn2-retirement-control-gen 0 fn2-retirement-control)
            (fn2-retirement-control-bytes 0 fn2-retirement-control)) (mv slot gen len)))
      ((mv frame & bytes next fn2-core) (fn2-commit-txn-frame 0 slot gen 0 len 1 2 3 fn2-core))
      ; Synthetic waiting control isolates the token gate. This is not a
      ; witness of persisted installation; the public dispatch rejects above.
      (fn2-core (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))) (fn2-retirement-control)
        (fn2-retirement-control-put 0 (state *fn2-retirement-state-waiting*) (batch 1) (event 1)) fn2-core))
      (fn2-core (fn2-cac-token 8 fn2-core))
      ((mv stale-install fn2-core)
       (fn2-checkpoint-allocation-install-member 0 slot gen 0 next bytes len 1 1 1 2 3 fn2-core))
      (unchanged (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                             (fn2-retirement-control (fn2-core-retirement-control fn2-core))) (ok)
        (and (= (fn2-extents-state first fn2-extents) *fn2-extent-state-reserved*)
             (= (fn2-extents-state second fn2-extents) *fn2-extent-state-reserved*)
             (= (fn2-retirement-control-count 0 fn2-retirement-control) 2)
             (= (fn2-retirement-control-installed 0 fn2-retirement-control) 0)
             (= (fn2-retirement-control-extent 2 fn2-retirement-control) second)) ok)))
  (mv (and (eq premature :busy) (eq begun :ok) (eq a :ok) (eq b :ok)
           (eq wrong-owner :busy) (eq start :ok) (eq busy :busy) (eq one :more)
           (eq stale-pack :invalid) (eq stale-submit :invalid) (eq stale-install :invalid) (eq frame :ok)
           (eq incomplete :pending) retained (eq staged :staged)
           (eq no-persist :invalid) (eq unbound :invalid) unchanged) fn2-core)))
(defun fn2-cac-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-cac-body fn2-core) ok)))
(assert-event (fn2-cac-run))

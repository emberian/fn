;;; Actual startup functions with resource-opening functions replaced by controls.
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(with-open-file (source "host/adapter.lisp")
  (loop for form = (read source nil nil) while form
        when (and (consp form) (eq (car form) 'defun)
                  (eq (cadr form) 'fn2-n-control-numbers)) do (eval form)))
(load "host/native-serve-raw.lisp")
(assert (= (fn2-nserve-kill-at nil) 0))
(assert (= (fn2-nserve-kill-at "0") 0))
(assert (= (fn2-nserve-kill-at "17") 17))
(assert (= (fn2-nserve-kill-at (write-to-string most-positive-fixnum)) most-positive-fixnum))
(dolist (text (list "" "-1" "+1" " 1" "1 " "1/2" "#.(error 1)"
                    (make-string 21 :initial-element #\1)
                    (write-to-string (1+ most-positive-fixnum))))
  (assert (null (fn2-nserve-kill-at text))))
(defvar *opened* nil)
(defvar *destroyed* nil)
(defun fn2-nserve-profile () nil)
(defun %fn2-native-getpid () 1)
(defun fn2-host-listener-bind (profile) (declare (ignore profile)) (values :ok 0 0))
(defun fn2-core-profilep (profile) (declare (ignore profile)) t)
(defun fn2-image-profile (profile) profile)
(defun fn2-profile-storage-fault-model (profile) (declare (ignore profile)) "broad")
(defun fn2-n-make-host (profile &rest options)
  (declare (ignore profile)) (setf *opened* options) :host)
(defun fn2-n-destroy (host) (assert (eq host :host)) (setf *destroyed* t))
(let ((expected (fn2-nserve-kill-at (sb-ext:posix-getenv "FN2_KILL_AT"))))
  (assert (= (fn2-nserve-main) (if expected 0 2)))
  (if expected
      (progn (assert (= (getf *opened* :kill-at) expected))
             (assert (equal (getf *opened* :device-path) "test-only.img"))
             (assert *destroyed*))
    (progn (assert (null *opened*)) (assert (null *destroyed*)))))
(format t "Native death injection startup controls passed.~%")

;; Execute the real abrupt-exit callback in this disposable subprocess.
(when (sb-ext:posix-getenv "FN2_TEST_BOUNDARY")
  (defstruct fn2-nhost (boundaries 0) (kill-at 2)
             (boundary-lock (sb-thread:make-mutex)))
  (with-open-file (source "host/adapter.lisp")
    (loop for form = (read source nil nil) while form
          when (and (consp form) (eq (car form) 'defun)
                    (eq (cadr form) 'fn2-n-boundary)) do (eval form)))
  (let ((host (make-fn2-nhost)))
    (fn2-n-boundary host "take")
    (assert (= (fn2-nhost-boundaries host) 1))
    (fn2-n-boundary host "ack")
    (error "Death boundary returned")))

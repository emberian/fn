(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "commit-txn-unit")
(include-book "../books/journal-members")

(defun fn2-jmu-drive (fuel count first-size fn2-journal-members fn2-core)
 (declare (xargs :stobjs (fn2-journal-members fn2-core) :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel count first-size fn2-journal-members fn2-core)
  (b* (((mv code fn2-journal-members fn2-core)
        (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
         (code fn2-journal-members fn2-fields)
         (fn2-journal-members-step 256 fn2-journal-members fn2-fields fn2-pool)
         (mv code fn2-journal-members fn2-core)))
       ((when (eq code :leaf))
        (b* ((size (- (fn2-journal-members-leaf-end 0 fn2-journal-members)
                       (fn2-journal-members-start 0 fn2-journal-members)))
             ((mv consumed fn2-journal-members) (fn2-journal-members-consumed fn2-journal-members)))
         (if (eq consumed :ok)
             (fn2-jmu-drive (- fuel 1) (+ 1 count) (if (= count 0) size first-size) fn2-journal-members fn2-core)
           (mv :consume count first-size fn2-journal-members fn2-core))))
       ((unless (eq code :more)) (mv code count first-size fn2-journal-members fn2-core)))
   (fn2-jmu-drive (- fuel 1) count first-size fn2-journal-members fn2-core))))

; Construct two actual admitted members, each with two schema records, and
; let the served commit sealer emit their canonical record stream. Controls
; corrupt that output in place; the scanner is not a second writer/model.
(defun fn2-jmu-body (fault fn2-journal-members fn2-core)
 (declare (xargs :stobjs (fn2-journal-members fn2-core) :verify-guards nil))
 (b* ((profile (fn2-b-test-profile *fn2-profile-tiny* 0))
      (fn2-core (fn2-core-init profile fn2-core))
      (fn2-journal-members (fn2-journal-members-init 1 fn2-journal-members))
      ((mv begun fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv reserved ws wg fn2-core) (fn2-core-reserve (fn2-scribe-window-class fn2-core) 9 3 5 fn2-core))
      (bytes (append *fn2-ctu-record* *fn2-ctu-record*))
      ((mv filled fn2-core) (fn2-ctu-fill bytes ws wg 0 fn2-core))
      ((mv a batch first fn2-core) (fn2-commit-admit-txn ws wg (len bytes) 9 3 5 fn2-core))
      ((mv b same second fn2-core) (fn2-commit-admit-txn ws wg (len bytes) 9 3 5 fn2-core))
      (id (fn2-machine-kind-base *fn2-commit-kind* fn2-core))
      (fn2-core (fn2-ctu-loop 600 0 id (+ 1 id) fn2-core))
      (ogen (fn2-machine-generation id fn2-core))
      (scratch (fn2-machine-pool-slot id fn2-core)) (sg (fn2-machine-pool-gen id fn2-core))
      ((mv & & & slot gen) (fn2-commit-resource id 1 fn2-core))
      ((mv framed roff rend second-end fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
        (code roff rend second-end fn2-fields)
        (b* (((mv code roff fn2-fields)
              (fn2-format-frame-header-decode 256 slot gen 0 4096 *fn2-commit-kind* id ogen fn2-fields fn2-pool))
             (rend (+ roff (fn2-fields-value (+ 256 *fn2-format-frame-header-field-payload-length*) fn2-fields)))
             ((mv one end1 & & fn2-fields) (fn2-journal-record-next 256 slot gen roff rend *fn2-commit-kind* id ogen fn2-fields fn2-pool))
             ((mv two end2 & & fn2-fields) (fn2-journal-record-next 256 slot gen end1 rend *fn2-commit-kind* id ogen fn2-fields fn2-pool)))
         (mv (if (and (eq code :ok) (eq one :record) (eq two :record)) :ok :format) roff rend end2 fn2-fields))
        (mv code roff rend second-end fn2-core)))
      ((unless (and (eq begun :ok) (eq reserved :ok) (eq filled :ok) (eq a :ok) (eq b :ok)
                    (= batch same) (= second (+ 1 first)) (eq framed :ok)
                    (= (fn2-machine-phase id fn2-core) *fn2-commit-state-dependencies*)))
       (mv nil fn2-journal-members fn2-core))
      ((mv edited fn2-core)
       (if (member-eq fault '(:gap :reordered))
           (b* (((mv record next & & fn2-core)
                 (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
                  (code next event kind fn2-fields)
                  (fn2-journal-record-next 256 slot gen second-end rend *fn2-commit-kind* id ogen fn2-fields fn2-pool)
                  (mv code next event kind fn2-core)))
                ((unless (eq record :record)) (mv :record fn2-core))
                (at (if (eq fault :gap) second-end next)))
            (mv-let (code end fn2-core)
             (fn2-commit-txn-header *record-kind-article-acceptance*
              (if (eq fault :gap) (+ 2 first) first) 256 slot gen at scratch sg id ogen fn2-core)
             (mv (if (and (eq code :ok) (natp end)) :ok :format) fn2-core)))
         (if (eq fault :padding)
             (fn2-core-write slot gen (- rend 1) 1 *fn2-commit-kind* id ogen fn2-core)
           (mv :ok fn2-core))))
      ((mv start fn2-journal-members)
       (fn2-journal-members-begin first (if (eq fault :missing-member) 3 2) roff rend
         slot gen *fn2-commit-kind* id ogen fn2-journal-members))
      ((mv result count size fn2-journal-members fn2-core)
       (fn2-jmu-drive 30 0 0 fn2-journal-members fn2-core)))
  (mv (and (eq edited :ok) (eq start :ok)
           (if fault (eq result :invalid)
             (and (eq result :done) (= count 2) (= size (- second-end roff)))))
      fn2-journal-members fn2-core)))
(defun fn2-jmu-test (fault)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-journal-members
  (mv-let (answer fn2-journal-members)
   (with-local-stobj fn2-core
    (mv-let (answer fn2-journal-members fn2-core) (fn2-jmu-body fault fn2-journal-members fn2-core)
     (mv answer fn2-journal-members))) answer)))
(assert-event (fn2-jmu-test nil))
(assert-event (fn2-jmu-test :gap))
(assert-event (fn2-jmu-test :reordered))
(assert-event (fn2-jmu-test :missing-member))
(assert-event (fn2-jmu-test :padding))

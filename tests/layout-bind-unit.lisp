; The actual generator binds concrete rows; encoding/source authority is separate.
(in-package "ACL2")
(include-book "../books/layout-bind")
(deflayout fn2-lbu-record
 '((a :u60) (b :u8) (c :bool) (d (:id commit))
   (e :digest) (f (:octets 8)) (g :u32) (h (:zero 4))))
(deflayout-binder fn2-lbu-bind fn2-lbu-record)
(defun fn2-lbu-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (answer fn2-fields)
   (b* ((fn2-fields (fn2-fields-init *fn2-lbu-record-num-fields* fn2-fields))
        (fn2-fields (fn2-lbu-bind 0 11 2 1 3 9 5 4 8 6 2 4 77 fn2-fields)))
    (mv (and (= (fn2-fields-value *fn2-lbu-record-field-a* fn2-fields) 11)
             (= (fn2-fields-value *fn2-lbu-record-field-d* fn2-fields) 3)
             (= (fn2-fields-value *fn2-lbu-record-field-g* fn2-fields) 77)
             (= (fn2-fields-ref-slot *fn2-lbu-record-field-e* fn2-fields) 9)
             (= (fn2-fields-ref-gen *fn2-lbu-record-field-e* fn2-fields) 5)
             (= (fn2-fields-ref-off *fn2-lbu-record-field-e* fn2-fields) 4)
             (= (fn2-fields-ref-len *fn2-lbu-record-field-e* fn2-fields) 32)
             (= (fn2-fields-ref-len *fn2-lbu-record-field-f* fn2-fields) 4)
             (= (fn2-fields-value *fn2-lbu-record-field-h* fn2-fields) 0)
             (= (fn2-fields-ref-len *fn2-lbu-record-field-h* fn2-fields) 0)) fn2-fields)) answer)))
(assert-event (fn2-lbu-test))

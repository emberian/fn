;;; Actual Web startup, connection finish and pipe close receipt consumers.
(require :sb-posix)
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")

;;; ---- derived stubs: BEGIN (python3 tools/harness_check.py --write-stubs; do not edit) ----
(define-condition harness-stub-reached (serious-condition)
  ((name :initarg :name :reader harness-stub-reached-name)
   (source :initarg :source :reader harness-stub-reached-source))
  (:report (lambda (c s)
             (format s "harness: host function ~(~a~) (~a) was reached; this harness neither stubs nor extracts it"
                     (harness-stub-reached-name c) (harness-stub-reached-source c)))))
(defun harness-stub-reached (name source)
  (format *error-output* "harness: host function ~(~a~) (~a) was reached; this harness neither stubs nor extracts it~%"
          name source)
  (finish-output *error-output*)
  (error 'harness-stub-reached :name name :source source))
(defun fnn-tls-close-channel (channel)
  (declare (ignorable channel))
  (harness-stub-reached 'fnn-tls-close-channel "host/native/tls.lisp"))
(defun fnn-web-semantic-body (face)
  (declare (ignorable face))
  (harness-stub-reached 'fnn-web-semantic-body "host/native/web-host.lisp"))
;;; ---- derived stubs: END ----
(defun source-form (path prefix)
  (with-open-file (stream path)
    (let ((text (make-string (file-length stream))))
      (read-sequence text stream)
      (read-from-string text nil nil :start (or (search prefix text) (error "missing ~a" prefix))))))
(defvar *fnn-web-face* nil)
(defvar *the-live-state* nil)
(defvar *fnn-sigterm-requested* nil)
(defvar *mode* nil)
(defvar *listened* 0)
(defvar *sockets-closed* 0)
(defvar *pipe-closes* nil)
(defvar *joined* 0)
(declaim (notinline sb-posix:close))
(defparameter *system-close* (symbol-function 'sb-posix:close))
(defun fnn-err (&rest args) (declare (ignore args)))
(defun fnn-out (&rest args) (declare (ignore args)))
(defun fnn-fault (&rest args) (error (apply #'format nil args)))
(defun fnn-indeterminate (&rest args) (error (apply #'format nil args)))
(defun fnn-octet-list-p (x) (listp x))
(defun fnn-owner-serialized (service cid thunk &optional class)
  (declare (ignore service cid class)) (funcall thunk))
(defun fnn-call (&rest args) (declare (ignore args)) '(16))
(defun fnn-core (name &rest args)
  (declare (ignore args))
  (case name (fn-web-host-plan-port 8080) (fn-web-host-plan-family :inet)
    (fn-web-host-plan-address '(127 0 0 1)) (fn-web-host-plan-config :config)
    (fn-web-host-connection-limit
     (when (eq *mode* :capacity-fault) (error "capacity-fault")) 2)
    (otherwise nil)))
(defun fnn-listen (&rest args) (declare (ignore args)) (incf *listened*) (values :listener 8080))
(defun fnn-set-nonblocking (fd) fd)
(defun fnn-owner-service-stopping (service) (declare (ignore service)) nil)
(defun fnn-web-iterate (face) (declare (ignore face)) (error "actor-body-fault"))
(defun fnn-web-spawn-semantic (&rest args) (declare (ignore args)) :semantic-thread)
(defun fnn-web-spawn (&rest args) (declare (ignore args)) (error "actor-fault"))
(defun fnn-owner-actor-join (&rest args) (declare (ignore args)) (incf *joined*))
(defun fnn-owner-thread-escape (&rest args) (declare (ignore args)))
(defun fnn-socket-shut (socket)
  (declare (ignore socket)) (incf *sockets-closed*)
  (if (eq *mode* :socket-unobserved)
      (values nil :unobserved (make-condition 'simple-error :format-control "socket-close-fault"))
    (values nil :closed nil)))
(defun fnn-web-dispose-semantic (face conn)
  (declare (ignore face)) (setf (fnn-web-conn-semantic-ended conn) t))
(eval (source-form (or (sb-ext:posix-getenv "FN_CLEANUP_HOST_SOURCE") "host/native/io.lisp")
                   "(defmacro fnn-unwind-cleanups "))
(let ((path (or (sb-ext:posix-getenv "FN_WEB_HOST_SOURCE") "host/native/web-host.lisp")))
  (dolist (prefix '("(defstruct (fnn-web-reactor-face " "(defstruct (fnn-web-reactor-conn "
                    "(defstruct (fnn-web-job " "(defun fnn-web-cleanup " "(defun fnn-web-finish "
                    "(defun fnn-web-close-wakes-locked " "(defun fnn-web-start "
                    "(defun fnn-web-close-listener " "(defun fnn-web-face-drained-p " "(defun fnn-web-actor-body "))
    (eval (source-form (if (equal prefix "(defun fnn-web-close-wakes-locked ")
                           (or (sb-ext:posix-getenv "FN_WEB_RECEIPT_HELPER_SOURCE") path) path)
                       prefix))))
(let ((*mode* :capacity-fault) (*listened* 0))
  (assert (equal (handler-case (fnn-web-start :service :plan nil)
                   (error (e) (princ-to-string e))) "capacity-fault"))
  (assert (= *listened* 0)))
(unwind-protect
     (progn
       (sb-ext:without-package-locks
         (setf (symbol-function 'sb-posix:close)
               (lambda (fd)
                 (funcall *system-close* fd)
                 (push fd *pipe-closes*)
                 (when (and (eq *mode* :pipe-close-fault) (= (length *pipe-closes*) 1))
                   (error "pipe-close-fault")))))
       (dolist (mode '(:success :pipe-close-fault))
         (multiple-value-bind (r w) (sb-posix:pipe)
           (let* ((*mode* mode) (*pipe-closes* nil)
                  (face (%make-fnn-web-face :wake-read r :wake-write w :jobs-closed t)))
             (handler-case
                 (sb-thread:with-mutex ((fnn-web-face-lock face)) (fnn-web-close-wakes-locked face))
               (error (e) (assert (equal (princ-to-string e) "pipe-close-fault"))))
             (assert (= (length *pipe-closes*) 2))
             (assert (eq (fnn-web-face-wake-write-close face) :returned))
             (if (eq mode :success) (assert (fnn-web-face-drained-p face))
               (progn (assert (not (fnn-web-face-drained-p face)))
                      (assert (eq (fnn-web-face-wake-read-close face) :unobserved))
                      (assert (= (third (first (fnn-web-face-cleanup-debts face))) r))
                      (ignore-errors (sb-thread:with-mutex ((fnn-web-face-lock face))
                                       (fnn-web-close-wakes-locked face)))
                      (assert (= (length *pipe-closes*) 2)))))))
       (dolist (mode '(:actor-body-fault :pipe-close-fault))
         (multiple-value-bind (r w) (sb-posix:pipe)
           (let ((*mode* mode) (*pipe-closes* nil))
             (let ((face (%make-fnn-web-face :wake-read r :wake-write w :service :service)))
               (assert (equal (handler-case (fnn-web-actor-body face)
                                (error (e) (princ-to-string e))) "actor-body-fault"))
               (assert (= (length *pipe-closes*) 2))))))
       (dolist (mode '(:actor-fault :pipe-close-fault))
         (let ((*mode* mode) (*pipe-closes* nil) (*joined* 0) (*sockets-closed* 0) (*fnn-web-face* nil))
           (assert (equal (handler-case (fnn-web-start :service :plan nil)
                            (error (e) (princ-to-string e))) "actor-fault"))
           (assert (= *joined* 1)) (assert (= (length *pipe-closes*) 2))
           (assert (= *sockets-closed* 1)))))
  (sb-ext:without-package-locks (setf (symbol-function 'sb-posix:close) *system-close*)))
(dolist (mode '(:socket-closed :socket-unobserved))
  (let* ((*mode* mode) (*sockets-closed* 0)
         (face (%make-fnn-web-face :jobs-closed t :wake-closed t :wake-read-close :returned :wake-write-close :returned))
         (conn (%make-fnn-web-conn :socket :socket)))
    (setf (fnn-web-face-conns face) (list conn))
    (fnn-web-finish face conn) (fnn-web-finish face conn)
    (assert (= *sockets-closed* 1))
    (assert (eql (not (null (fnn-web-face-drained-p face))) (eq mode :socket-closed)))))
(format t "Web physical receipt/startup custody passed (9 paths)~%")

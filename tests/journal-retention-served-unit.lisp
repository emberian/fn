; The simulator adapter retains the actual journal written by two POSTs.
; The second POST may publish while the first cut is retained. Close while
; its seal read is still outstanding, then drain the exact terminal result.
(in-package "ACL2")
(include-book "c-snapshot-unit")

(defun fn2-jrs-cut (fuel token kind owner gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel 0 0 fn2-core)
  (mv-let (code cut event fn2-core) (fn2-csnapshot-poll token kind owner gen fn2-core)
   (if (eq code :more)
       (fn2-jrs-cut (- fuel 1) token kind owner gen fn2-core)
     (mv code cut event fn2-core)))))

(defun fn2-jrs-collect (fuel token kind owner gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-retained-journal-collect token kind owner gen fn2-core)
   (if (eq code :more)
       (fn2-jrs-collect (- fuel 1) token kind owner gen fn2-core)
     (mv code fn2-core)))))

(defun fn2-jrs-close (fuel token kind owner gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-retained-journal-close token kind owner gen fn2-core)
   (if (eq code :more)
       (fn2-jrs-close (- fuel 1) token kind owner gen fn2-core)
     (mv code fn2-core)))))

(defun fn2-jrs-promised (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))
             (fn2-extents (fn2-core-extents fn2-core))) (pins)
  (fn2-extents-promised-read (fn2-event-read-extent 0 fn2-event-read) fn2-extents)
  pins))

(defun fn2-jrs-reader-phase (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))) (phase)
  (fn2-event-read-phase 0 fn2-event-read) phase))

(defun fn2-jrs-format (fuel goal token kind owner gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond ((= goal (fn2-jrs-reader-phase fn2-core)) (mv :ok fn2-core))
       ((zp fuel) (mv :fuel fn2-core))
       (t (mv-let (code fn2-core) (fn2-retained-journal-format token kind owner gen 4096 fn2-core)
           (if (member-eq code '(:ok :more))
               (fn2-jrs-format (- fuel 1) goal token kind owner gen fn2-core)
             (mv code fn2-core))))))

(defun fn2-jrs-member (fuel token kind owner gen dst dg fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel 0 0 fn2-core)
  (mv-let (code event length fn2-core) (fn2-retained-journal-member token dst dg 0 kind owner gen fn2-core)
   (if (eq code :more)
       (fn2-jrs-member (- fuel 1) token kind owner gen dst dg fn2-core)
     (mv code event length fn2-core)))))

(defun fn2-jrs-verify-first (token kind owner gen accepted clients store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv & clients store fn2-core) (fn2-cw-loop 2000 0 accepted clients store fn2-core))
      ((mv seal fn2-core) (fn2-jrs-format 300 *fn2-event-read-phase-read-records* token kind owner gen fn2-core))
      ((mv issued fn2-core) (fn2-retained-journal-issue token kind owner gen fn2-core))
      ((mv & & & fn2-core) (fn2-cw-loop 2000 0 accepted clients store fn2-core))
      ((mv records fn2-core) (fn2-jrs-format 300 *fn2-event-read-phase-members* token kind owner gen fn2-core))
      ((mv reserved dst dg fn2-core) (fn2-core-reserve 2 kind owner gen fn2-core))
      ((mv member event length fn2-core) (fn2-jrs-member 300 token kind owner gen dst dg fn2-core))
      ((mv released fn2-core) (fn2-core-release dst dg kind owner gen fn2-core)))
   (mv (and (eq seal :ok) (eq issued :ok) (eq records :ok) (eq reserved :ok)
            (eq member :member) (= event 1) (posp length) (eq released :ok))
       fn2-core)))

(defun fn2-jrs-body (drain fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (put-assoc-equal :history-id 257
                 (put-assoc-equal :history-incarnation 65537 *fn2-uslt-profile*)))
      (fn2-core (fn2-init-executor profile :echo nil fn2-core))
      ((mv epoch fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      (post (fn2-cw-crlf-octets
             (append '("POST") *fn2-uslt-source* '("." "POST")
                     '("From: a@example.invalid" "Subject: later" "Newsgroups: local.test" "" "Later.")
                     '("." "QUIT"))))
      (clients (fn2-cw-clients (list (list post (list (len post))))))
      ((mv bound accepted clients store fn2-core)
       (fn2-csu-drive 200000 *fn2-succ-phase-bound* 0 clients nil fn2-core))
      (kind *fn2-scribe-kind*)
      (owner (fn2-machine-kind-base kind fn2-core))
      (gen (fn2-machine-generation owner fn2-core))
      ((mv begin token fn2-core) (fn2-retained-journal-acquire kind owner gen fn2-core))
      ((mv settled accepted clients store fn2-core)
       (fn2-csu-drive 200000 *fn2-succ-phase-idle* accepted clients store fn2-core))
      ; No adapter turn intervenes while the first stable cut is acquired.
      ((mv held cut event fn2-core)
       (fn2-jrs-cut 200 token kind owner gen fn2-core))
      ((mv began fn2-core) (fn2-retained-journal-begin token kind owner gen fn2-core))
      ((mv ready fn2-core) (fn2-jrs-collect 200 token kind owner gen fn2-core))
      ((mv competing & fn2-core) (fn2-retained-journal-acquire kind owner gen fn2-core))
      (reopened (not (fn2-storage-checkpoint-active fn2-core)))
      ((mv & clients store fn2-core) (fn2-cw-loop 200000 0 accepted clients store fn2-core))
      (published (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (cut)
                   (fn2-commit-root-published 0 fn2-commit-root) cut))
      ((mv buffer slot sgen fn2-core) (fn2-core-reserve 2 kind owner gen fn2-core))
      ((mv opened fn2-core) (fn2-retained-journal-open token kind owner gen slot sgen fn2-core))
      (retained (fn2-jrs-promised fn2-core))
      ((mv source seal previous) (fn2-retained-journal-seals token kind owner gen fn2-core))
      ((mv issued fn2-core) (fn2-retained-journal-issue token kind owner gen fn2-core))
      ((mv checked fn2-core)
       (if drain
           (b* (((mv draining fn2-core) (fn2-retained-journal-close token kind owner gen fn2-core))
                ((mv refused fn2-core) (fn2-retained-journal-issue token kind owner gen fn2-core))
                ((mv & & & fn2-core) (fn2-cw-loop 2000 0 accepted clients store fn2-core)))
            (mv (and (eq draining :drain) (eq refused :owner)
                     (= (fn2-jrs-reader-phase fn2-core) *fn2-event-read-phase-frame-seal*))
                fn2-core))
         (fn2-jrs-verify-first token kind owner gen accepted clients store fn2-core)))
      ((mv closed fn2-core) (fn2-jrs-close 200 token kind owner gen fn2-core))
      (unpinned (fn2-jrs-promised fn2-core))
      ((mv unavailable & &) (fn2-retained-journal-seals token kind owner gen fn2-core))
      ((mv returned fn2-core) (fn2-core-release slot sgen kind owner gen fn2-core)))
   (mv (and (eq epoch :ok) (eq bound :ok) (eq begin :ok) (eq settled :ok)
            (eq held :held) (= cut 1) (= event 1) (eq began :ok) (eq ready :ready)
            (eq competing :busy) reopened (= published 2) (eq buffer :ok) (eq opened :ok)
            (= retained 1) (= unpinned 0)
            (eq source :ok) (= seal (+ previous 1)) (eq issued :ok) checked
            (eq closed :done) (eq unavailable :owner) (eq returned :ok)
            (not (fn2-core-stopped-p fn2-core)))
       fn2-core)))

(assert-event
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-jrs-body nil fn2-core) ok)))
(assert-event
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-jrs-body t fn2-core) ok)))

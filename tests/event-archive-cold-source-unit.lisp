; Synthetic immutable candidate subject for the actual private source predicate.
; This is not a witness of physical header authentication or archive completion.
(in-package "ACL2")
(include-book "../books/event-archive-cold-source")
(defun fn2-eacsu-body (fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
 (declare (xargs :stobjs (fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes) :verify-guards nil))
 (b* ((fn2-event-archive (fn2-event-archive-init 2 fn2-event-archive))
      (fn2-checkpoints (fn2-checkpoints-init 1 fn2-checkpoints))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-init 6 fn2-checkpoint-refs))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-init 192 fn2-checkpoint-bytes))
      (empty (not (fn2-event-archive-cold-source-p fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)))
      (fn2-checkpoints (fn2-checkpoints-put 0 (state *fn2-checkpoint-state-checked*) (anchor-mask 1) (builder-token 0)
       (checkpoint 9) (cut-commit 7) (cut-event 11) (history 123) (incarnation 456)))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-put 3 (storage-domain 0) (physical-unit 16) (writer-epoch 2)
       (allocation 4) (page-kind *page-kind-manifest*) (encoded-length *fn2-format-page-size*)))
      (fn2-event-archive (fn2-event-archive-put 1 (phase *fn2-event-archive-phase-cold-header*) (origin *fn2-event-archive-origin-cold*)
       (candidate 0) (checkpoint 9) (cut-commit 7) (cut-event 11) (history 123) (incarnation 456)
       (header-unit 16) (header-epoch 2) (header-allocation 4)))
      (current (fn2-event-archive-cold-source-p fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-set-value 0 1 fn2-checkpoint-bytes))
      (stale (not (fn2-event-archive-cold-source-p fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-set-value 0 0 fn2-checkpoint-bytes))
      (fn2-checkpoints (fn2-checkpoints-set-incarnation 0 457 fn2-checkpoints))
      (foreign (not (fn2-event-archive-cold-source-p fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)))
      (fn2-checkpoints (fn2-checkpoints-set-incarnation 0 456 fn2-checkpoints))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-set-allocation 3 5 fn2-checkpoint-refs))
      (reused (not (fn2-event-archive-cold-source-p fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-set-allocation 3 4 fn2-checkpoint-refs))
      (fn2-event-archive (fn2-event-archive-set-phase 1 *fn2-event-archive-phase-complete* fn2-event-archive)))
  (mv (and empty current stale foreign reused
           (not (fn2-event-archive-cold-source-p fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)))
      fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)))
(defun fn2-eacsu-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-event-archive
  (mv-let (answer fn2-event-archive)
   (with-local-stobj fn2-checkpoints
    (mv-let (answer fn2-event-archive fn2-checkpoints)
     (with-local-stobj fn2-checkpoint-refs
      (mv-let (answer fn2-event-archive fn2-checkpoints fn2-checkpoint-refs)
       (with-local-stobj fn2-checkpoint-bytes
        (mv-let (answer fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
         (fn2-eacsu-body fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
         (mv answer fn2-event-archive fn2-checkpoints fn2-checkpoint-refs)))
       (mv answer fn2-event-archive fn2-checkpoints)))
     (mv answer fn2-event-archive))) answer)))
(assert-event (fn2-eacsu-test))

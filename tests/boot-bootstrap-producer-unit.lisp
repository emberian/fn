; Lower-producer controls over real generated bytes, not a persisted BOOT claim.
; The complete machine/read-completion/genesis chain is a separate fixture.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/boot-bootstrap-verify")
(include-book "../books/boot-bootstrap-receipt")

; Full test snapshots come from the actual registered schemas, including
; scalar fields and extra arrays. There is no partial carrier oracle.
(defun fn2-bbp-reference-events (names world)
 (declare (xargs :verify-guards nil))
 (if (atom names) nil
  (let* ((name (car names)) (schema (cdr (assoc-eq name (fn2-decl-rows :columns world))))
         (fields (append (fn2-columns-fields name (fn2-decl-get :columns schema))
                   (list (list (fn2-columns-sym name "-ROWS") :type
                         (list 'integer 0 (- (fn2-decl-get :rows-bound schema) 1)) :initially 0))
                   (fn2-decl-get :extra-fields schema))))
   (append (fn2-columns-reference-events name (fn2-columns-sym name "-REF") fields)
           (fn2-bbp-reference-events (cdr names) world)))))
(make-event
 (value (cons 'progn (fn2-bbp-reference-events
  '(fn2-boot-config fn2-origin fn2-fields fn2-digests fn2-b3 fn2-pool) (w state)))))

(defun fn2-bbp-geometry-matches (i fn2-boot-config fn2-pool)
 (declare (xargs :stobjs (fn2-boot-config fn2-pool) :verify-guards nil :measure (nfix (- 32 (nfix i)))))
 (if (or (not (natp i)) (>= i 32)) t
  (and (equal (fn2-boot-config-geometryi i fn2-boot-config)
              (fn2-pool-datai (+ *fn2-format-sector-size* i) fn2-pool))
       (fn2-bbp-geometry-matches (+ i 1) fn2-boot-config fn2-pool))))

(defun fn2-bbp-rx-bytes (left at fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix left)))
 (if (zp left) nil
  (cons (fn2-pool-datai (+ *fn2-format-page-size* at) fn2-pool)
        (fn2-bbp-rx-bytes (- left 1) (+ at 1) fn2-pool))))

(defun fn2-bbp-geometry-zero-p (i fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- 32 (nfix i)))))
 (if (or (not (natp i)) (>= i 32)) t
  (and (equal (fn2-pool-datai (+ *fn2-format-sector-size* i) fn2-pool) 0)
       (fn2-bbp-geometry-zero-p (+ i 1) fn2-pool))))

(defun fn2-bbp-run (mode fn2-boot-config fn2-origin fn2-fields fn2-digests fn2-b3 fn2-pool)
 (declare (xargs :stobjs (fn2-boot-config fn2-origin fn2-fields fn2-digests fn2-b3 fn2-pool) :verify-guards nil))
 (b* ((fn2-boot-config (fn2-boot-config-empty 0 fn2-boot-config))
      (fn2-boot-config (update-fn2-boot-config-extents 16 fn2-boot-config))
      (fn2-origin (fn2-origin-empty 0 fn2-origin))
      (fn2-origin (update-fn2-origin-lineage 11 fn2-origin))
      (fn2-origin (update-fn2-origin-domain 12 fn2-origin))
      (fn2-origin (update-fn2-origin-incarnation 13 fn2-origin))
      (fn2-origin (update-fn2-origin-history 14 fn2-origin))
      (fn2-origin (update-fn2-origin-history-incarnation 15 fn2-origin))
      (fn2-fields (fn2-fields-init (+ 256 *fn2-format-sealed-batch-num-fields*) fn2-fields))
      (fn2-digests (fn2-digests-init (* 3 *fn2-digest-stride*) fn2-digests))
      (fn2-b3 (fn2-b3-table-init 3 fn2-b3))
      (fn2-pool (fn2-pool-columns-init 2 fn2-pool))
      (fn2-pool (resize-fn2-pool-data (+ *fn2-format-page-size* *fn2-format-sector-size*) fn2-pool))
      (fn2-pool (fn2-pool-put 0 (gen 1) (base 0) (cap *fn2-format-page-size*)
                  (state *fn2-pool-state-workspace*) (owner-kind 1) (owner-slot 0) (owner-gen 1)))
      (fn2-pool (fn2-pool-put 1 (gen 1) (base *fn2-format-page-size*) (cap *fn2-format-sector-size*)
                  (state *fn2-pool-state-workspace*) (owner-kind 1) (owner-slot 0) (owner-gen 1)))
      (unminted (fn2-boot-config-copy fn2-boot-config))
      ((mv packed fn2-fields fn2-digests fn2-b3 fn2-pool)
       (fn2-boot-bootstrap-pack-pool 33554432 0 1 1 0 1 fn2-boot-config fn2-fields fn2-digests fn2-b3 fn2-pool))
      (pack-unminted (and (eq packed :ok) (equal unminted (fn2-boot-config-copy fn2-boot-config))
                          (not (fn2-boot-bootstrap-receipt-p 1 0 1 fn2-boot-config fn2-origin))
                          (not (fn2-bbp-geometry-zero-p 0 fn2-pool))))
      ((mv copied fn2-pool) (fn2-pool-copy-range 0 1 0 1 1 0 *fn2-format-sector-size* 1 0 1 fn2-pool))
      ; These are component inputs, never fabricated I/O completion or phase.
      ((mv altered fn2-pool)
       (case mode
        (:corrupt (fn2-pool-write 1 1 0 255 1 0 1 fn2-pool))
        (:tail (fn2-pool-write 1 1 (- *fn2-format-sector-size* 1) 1 1 0 1 fn2-pool))
        (:alias (mv :ok (fn2-pool-set-base 1 0 fn2-pool)))
        (:short (mv :ok (fn2-pool-set-fill 1 12 fn2-pool)))
        (otherwise (mv :ok fn2-pool))))
      (whole-h (and (fn2-boot-configp fn2-boot-config) (fn2-boot-config-wfp fn2-boot-config)
                    (fn2-originp fn2-origin) (fn2-origin-wfp fn2-origin)
                    (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)
                    (fn2-digestsp fn2-digests) (fn2-digests-wfp fn2-digests)
                    (fn2-b3p fn2-b3) (fn2-b3-wfp fn2-b3)
                    (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)))
      (before-cfg (fn2-boot-config-copy fn2-boot-config))
      (before-origin (fn2-origin-copy fn2-origin))
      (before-fields (fn2-fields-copy fn2-fields))
      (before-digests (fn2-digests-copy fn2-digests))
      (before-b3 (fn2-b3-copy fn2-b3))
      (before-pool (fn2-pool-copy fn2-pool))
      (before-rx (fn2-bbp-rx-bytes *fn2-format-sector-size* 0 fn2-pool))
      ((mv code fn2-boot-config fn2-fields fn2-digests fn2-b3 fn2-pool)
       (fn2-boot-bootstrap-verify-pool 33554432 0 1 1 1 1 (if (eq mode :owner) 1 0) 1
        fn2-boot-config fn2-origin fn2-fields fn2-digests fn2-b3 fn2-pool))
      (readonly (and (equal before-origin (fn2-origin-copy fn2-origin))
                     (equal before-rx (fn2-bbp-rx-bytes *fn2-format-sector-size* 0 fn2-pool))))
      (unchanged (and (equal before-cfg (fn2-boot-config-copy fn2-boot-config))
                     (equal before-fields (fn2-fields-copy fn2-fields))
                     (equal before-digests (fn2-digests-copy fn2-digests))
                     (equal before-b3 (fn2-b3-copy fn2-b3))
                     (equal before-pool (fn2-pool-copy fn2-pool))))
      (answer (and pack-unminted whole-h readonly (eq copied :ok) (eq altered :ok)
        (case mode
         (:positive (and (eq code :ok) (fn2-boot-bootstrap-receipt-p 1 0 1 fn2-boot-config fn2-origin)
                         (equal (fn2-boot-config-image-size fn2-boot-config) 33554432)
                         (fn2-bbp-geometry-matches 0 fn2-boot-config fn2-pool)))
         (:alias (and (eq code :alias) unchanged))
         (:owner (and (eq code :owner) unchanged))
         (:short (and (eq code :bounds) unchanged))
         (otherwise (and (eq code :different) (equal before-cfg (fn2-boot-config-copy fn2-boot-config))
                         (not (fn2-boot-bootstrap-receipt-p 1 0 1 fn2-boot-config fn2-origin))))))))
  (mv answer fn2-boot-config fn2-origin fn2-fields fn2-digests fn2-b3 fn2-pool)))

(defun fn2-bbp-check (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-boot-config
 (mv-let (answer fn2-boot-config)
  (with-local-stobj fn2-origin
 (mv-let (answer fn2-boot-config fn2-origin)
  (with-local-stobj fn2-fields
 (mv-let (answer fn2-boot-config fn2-origin fn2-fields)
  (with-local-stobj fn2-digests
 (mv-let (answer fn2-boot-config fn2-origin fn2-fields fn2-digests)
  (with-local-stobj fn2-b3
 (mv-let (answer fn2-boot-config fn2-origin fn2-fields fn2-digests fn2-b3)
  (with-local-stobj fn2-pool
 (mv-let (answer fn2-boot-config fn2-origin fn2-fields fn2-digests fn2-b3 fn2-pool)
  (fn2-bbp-run mode fn2-boot-config fn2-origin fn2-fields fn2-digests fn2-b3 fn2-pool)
  (mv answer fn2-boot-config fn2-origin fn2-fields fn2-digests fn2-b3)))
  (mv answer fn2-boot-config fn2-origin fn2-fields fn2-digests)))
  (mv answer fn2-boot-config fn2-origin fn2-fields)))
  (mv answer fn2-boot-config fn2-origin)))
  (mv answer fn2-boot-config)))
  answer)))

(assert-event (fn2-bbp-check :positive))
(assert-event (fn2-bbp-check :corrupt))
(assert-event (fn2-bbp-check :tail))
(assert-event (fn2-bbp-check :alias))
(assert-event (fn2-bbp-check :owner))
(assert-event (fn2-bbp-check :short))

; Actual frame producer -> actual evidence start step. Checked candidate and
; physical investigation ownership are explicit synthetic premises. This tests
; tentative namespace capture only; no seal/hash/IO authentication is claimed.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/commit-format")
(include-book "../books/checkpoint-recovery-evidence")
(include-book "../books/runs-page")

(defun fn2-ceo-body (mode fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)

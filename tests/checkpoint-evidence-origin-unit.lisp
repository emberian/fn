 (b* ((fn2-origin (fn2-origin-prepare '((:origin-lineage . 101) (:origin-domain . 103) (:origin-incarnation . 107) (:history-id . 37) (:history-incarnation . 41)) fn2-origin))
      (fn2-checkpoints (fn2-checkpoints-init 1 fn2-checkpoints))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-init 6 fn2-checkpoint-refs))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-init 192 fn2-checkpoint-bytes))
      (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-init 5 fn2-checkpoint-recovery-evidence))
      (fn2-fc (fn2-fc-init 3 fn2-fc)) (fn2-fc-context (fn2-fc-context-init 3 fn2-fc-context))
      (fn2-b3 (fn2-b3-table-init 3 fn2-b3)) (fn2-digests (fn2-digests-init 432 fn2-digests))
      (fn2-fields (fn2-fields-init 1024 fn2-fields))
      (fn2-pool (fn2-pool-init '((2 . 16384)) 1 100 fn2-pool))
      ((mv a slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv b scratch sgen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ; Initialized zero bytes stand for the caller's already-owned read window.
      (fn2-pool (fn2-pool-set-fill slot 12288 fn2-pool))
      (fn2-pool (fn2-pool-set-fill scratch 4096 fn2-pool))
      ((mv packed packed-end fn2-fields fn2-pool)
       (fn2-commit-pack :frame 2 0 slot gen 8192 scratch sgen 7 3 5 12 21 1 1 0 1 101 103 107 29 31 fn2-fields fn2-pool))
      ((mv decoded decoded-end fn2-fields)
       (fn2-format-frame-header-decode 0 slot gen 8192 12288 1 0 1 fn2-fields fn2-pool))
      (fn2-fields (if (eq mode :zero-history) (fn2-fields-set-value *fn2-format-frame-header-field-history* 0 fn2-fields) fn2-fields))
      ((mv rewritten rewritten-end fn2-pool)
       (if (eq mode :zero-history) (fn2-format-frame-header-encode 0 slot gen 8192 1 0 1 fn2-fields fn2-pool)
        (mv :ok packed-end fn2-pool)))
      ; The actual body producer must agree with the tentative frame pair;
      ; the current anchor pair must fail this same body identity check.
      ((mv sealed seal-end fn2-fields fn2-pool)
       (fn2-commit-pack :seal 0 0 slot gen 0 scratch sgen 7 3 5 12 21 1 1 0 1 101 103 107 29 31 fn2-fields fn2-pool))
      ((mv body body-end fn2-fields)
       (fn2-format-sealed-batch-decode *fn2-rec-field-base* slot gen 0 seal-end 1 0 1 fn2-fields fn2-pool))
      ((mv body-ok first last) (fn2-rec-seal-check 7 12 3 5 29 31 fn2-fields))
      ((mv current-ok current-first current-last) (fn2-rec-seal-check 7 12 3 5 37 41 fn2-fields))
      (fn2-checkpoints (fn2-checkpoints-put 0 (state *fn2-checkpoint-state-checked*) (checkpoint 500)
       (history (if (eq mode :anchor) 39 37)) (incarnation 41) (cut-commit 11) (cut-event 20)))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-put 0 (storage-domain 0) (physical-unit 16)
       (writer-epoch 3) (allocation 5) (page-kind *page-kind-checkpoint-descriptor*) (encoded-length 4096)))
      (fn2-checkpoint-recovery-evidence (fn2-checkpoint-recovery-evidence-put 0
       (phase *fn2-checkpoint-recovery-evidence-phase-frame*) (candidate 0) (checkpoint 500) (cut-commit 11) (cut-event 20)
       (descriptor-domain 0) (descriptor-unit 16) (descriptor-epoch 3) (descriptor-allocation 5)
       (descriptor-kind *page-kind-checkpoint-descriptor*) (descriptor-length 4096)
       (slot slot) (gen gen) (owner-kind 1) (owner-slot 0) (owner-gen 1) (extent 7) (epoch 3) (allocation 5)))
      (premise (and (eq sealed :ok) (eq body :ok) (= body-end seal-end) body-ok (not current-ok)
       (= first current-first) (= last current-last) (= first 21) (= last 21)
       (eq a :ok) (eq b :ok) (eq packed :ok) (eq decoded :ok) (= packed-end decoded-end)
       (eq rewritten :ok) (= rewritten-end packed-end)
       (fn2-b3-ready *fn2-rec-checker-row* fn2-b3 fn2-digests)
       (fn2-checkpoint-recovery-evidence-bound-candidate-p fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence)))
      ((mv code fn2-checkpoint-recovery-evidence fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
       (fn2-checkpoint-recovery-evidence-physical 0 fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence
        fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-origin fn2-digests)))

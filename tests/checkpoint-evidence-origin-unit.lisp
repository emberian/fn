       (if mode (and (eq code (if (eq mode :anchor) :state :skip)) (= (fn2-checkpoint-recovery-evidence-started 0 fn2-checkpoint-recovery-evidence) 0))
        (and (eq code :more) (= (fn2-checkpoint-recovery-evidence-started 0 fn2-checkpoint-recovery-evidence) 1)
         (= (fn2-checkpoint-recovery-evidence-journal-history 0 fn2-checkpoint-recovery-evidence) 29)
         (= (fn2-checkpoint-recovery-evidence-journal-incarnation 0 fn2-checkpoint-recovery-evidence) 31)
         (= (fn2-fc-context-history *fn2-rec-checker-row* fn2-fc-context) 29)
         (= (fn2-fc-context-incarnation *fn2-rec-checker-row* fn2-fc-context) 31)
         (= (fn2-checkpoint-recovery-evidence-ready 1 fn2-checkpoint-recovery-evidence) 0))))
      fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)))
(defun fn2-ceo-run (mode)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)
  (fn2-ceo-body mode fn2-origin fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-recovery-evidence fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)))
(assert-event (fn2-ceo-run nil))
(assert-event (fn2-ceo-run :zero-history))
(assert-event (fn2-ceo-run :anchor))

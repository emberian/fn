; UNEXECUTED source fixture. Actual create/ordinary commit/maintenance writes
; and Fences establish the source; no selected or published flags are seeded.
; This minimal producer has zero C sources. It exercises genuine post-Fence
; authority and extent-scan progress, not a nonempty live adoption witness.
(in-package "ACL2")
(include-book "checkpoint-cold-path-producer-support")
(include-book "column-snapshot-support")
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-checkpoint-summary (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-checkpoint-summary-sources (w state))))
(make-event (cons 'progn (fn2-arms-op-face-events 'fn2-checkpoint-live-catalog-begin-op 'fn2-checkpoint-live-catalog-begin (w state))))
(make-event (cons 'progn (fn2-arms-op-face-events 'fn2-checkpoint-live-catalog-step-op 'fn2-checkpoint-live-catalog-step (w state))))
(make-event (cons 'progn (fn2-arms-op-face-events 'fn2-checkpoint-live-cbase-step-op 'fn2-checkpoint-live-cbase-step (w state))))

(defun fn2-clc-published-held-p (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((id (fn2-machine-kind-base *fn2-checkpoint-master-kind* fn2-core)))
  (and (eq (fn2-checkpoint-master-snapshot-read-code id fn2-core) :ok)
       (= (fn2-machine-phase id fn2-core) *fn2-checkpoint-master-state-summary-authority-begin*)
       (stobj-let ((fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core))) (complete)
        (= (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication) *fn2-checkpoint-publication-phase-complete*) complete))))
(defun fn2-clc-drive-published-held (fuel fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (cond ((fn2-clc-published-held-p fn2-core) (mv :held fn2-core fn2-sim fn2-own))
       ((zp fuel) (mv :fuel fn2-core fn2-sim fn2-own))
       ((fn2-core-stopped-p fn2-core) (mv :failed fn2-core fn2-sim fn2-own))
       (t (b* (((mv code fn2-core fn2-sim fn2-own) (fn2-ccp-pump fn2-core fn2-sim fn2-own)))
        (if (eq code :failed) (mv code fn2-core fn2-sim fn2-own)
         (fn2-clc-drive-published-held (- fuel 1) fn2-core fn2-sim fn2-own))))))
(defun fn2-clc-drain (fuel progress fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel progress fn2-core)
  (b* (((mv code fn2-core) (fn2-checkpoint-live-catalog-step-op fn2-core)))
   (if (eq code :more) (fn2-clc-drain (- fuel 1) (+ 1 (nfix progress)) fn2-core)
    (mv code progress fn2-core)))))
(defun fn2-clc-cbase-drain (fuel progress fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel progress fn2-core)
  (b* (((mv code fn2-core) (fn2-checkpoint-live-cbase-step-op fn2-core)))
   (if (eq code :more) (fn2-clc-cbase-drain (- fuel 1) (+ 1 (nfix progress)) fn2-core)
    (mv code progress fn2-core)))))
(defun fn2-clc-body (mode fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-ccp-profile* :null nil fn2-core))
      (fn2-sim (fn2-sim-init 1 :none "live-catalog" *fn2-ccp-profile* fn2-sim))
      (fn2-own (fn2-own-init *fn2-ccp-profile* fn2-own))
      ((mv started fn2-core) (fn2-boot-start t *fn2-ccp-image-size* fn2-core))
      ((mv created fn2-core fn2-sim fn2-own) (fn2-ccp-drive 200000 nil fn2-core fn2-sim fn2-own))
      ((unless (and (eq started :ok) (eq created :ready))) (mv nil fn2-core fn2-sim fn2-own))
      (summary-before (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))) (snap)
        (fn2-test-table-snapshot-fn2-checkpoint-summary fn2-checkpoint-summary) snap))
      ((when (eq mode :unpublished))
       (b* (((mv code fn2-core) (fn2-checkpoint-live-catalog-begin-op fn2-core))
            (same (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))) (snap)
              (equal summary-before (fn2-test-table-snapshot-fn2-checkpoint-summary fn2-checkpoint-summary)) snap)))
        (mv (and (eq code :source) same) fn2-core fn2-sim fn2-own)))
      ((mv admitted writer batch & fn2-core) (fn2-commit-admit-keyed 1 0 0 0 0 fn2-core))
      ((unless (eq admitted :ok)) (mv nil fn2-core fn2-sim fn2-own))
      (fn2-core (fn2-exec-wake writer fn2-core))
      ((mv committed fn2-core fn2-sim fn2-own) (fn2-ccp-live-drive 200000 nil batch fn2-core fn2-sim fn2-own))
      ((unless (eq committed :complete)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv entered fn2-core) (fn2-ccp-maintenance-entry fn2-core))
      ((unless (eq entered :ok)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv held fn2-core fn2-sim fn2-own) (fn2-clc-drive-published-held 400000 fn2-core fn2-sim fn2-own))
      ((unless (and (eq held :held) (fn2-clc-published-held-p fn2-core))) (mv nil fn2-core fn2-sim fn2-own))
      ((mv begun fn2-core) (fn2-checkpoint-live-catalog-begin-op fn2-core))
      ((unless (eq begun :more)) (mv nil fn2-core fn2-sim fn2-own))
      ((when (eq mode :stale))
       (b* ((fn2-core
             (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))) (fn2-checkpoint-summary)
              (fn2-checkpoint-summary-set-generation 1 (+ 1 (fn2-checkpoint-summary-generation 1 fn2-checkpoint-summary)) fn2-checkpoint-summary) fn2-core))
            (before (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
                               (fn2-checkpoint-summary-sources (fn2-core-checkpoint-summary-sources fn2-core))) (snap)
              (list (fn2-test-table-snapshot-fn2-checkpoint-summary fn2-checkpoint-summary)
                    (fn2-test-table-snapshot-fn2-checkpoint-summary-sources fn2-checkpoint-summary-sources)) snap))
            ((mv code fn2-core) (fn2-checkpoint-live-catalog-step-op fn2-core))
            (same (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
                             (fn2-checkpoint-summary-sources (fn2-core-checkpoint-summary-sources fn2-core))) (snap)
              (equal before (list (fn2-test-table-snapshot-fn2-checkpoint-summary fn2-checkpoint-summary)
                                  (fn2-test-table-snapshot-fn2-checkpoint-summary-sources fn2-checkpoint-summary-sources))) snap)))
        (mv (and (eq code :source) same) fn2-core fn2-sim fn2-own)))
      ((mv code progress fn2-core) (fn2-clc-drain 100000 0 fn2-core))
      (closed (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
                         (fn2-checkpoint-metadata-manifest (fn2-core-checkpoint-metadata-manifest fn2-core))) (ok)
       (and (= (fn2-checkpoint-summary-phase 1 fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-captured*)
            (= (fn2-checkpoint-summary-count 1 fn2-checkpoint-summary) (fn2-checkpoint-metadata-manifest-entries 0 fn2-checkpoint-metadata-manifest))
            (= (fn2-checkpoint-summary-installed 1 fn2-checkpoint-summary) 0)
            (= (fn2-checkpoint-summary-lease-count 1 fn2-checkpoint-summary) 0)) ok))
      ((unless (and (eq code :captured) (posp progress) closed)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv hold-code hold-progress fn2-core) (fn2-clc-cbase-drain 100000 0 fn2-core))
      (promised (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
                           (fn2-checkpoint-cbase-holds (fn2-core-checkpoint-cbase-holds fn2-core))) (ok)
       (fn2-checkpoint-cbase-row-promised-p 1 fn2-checkpoint-summary fn2-checkpoint-cbase-holds) ok)))
  (mv (and (eq hold-code :held) (posp hold-progress) promised) fn2-core fn2-sim fn2-own)))
(defun fn2-clc-test (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (with-local-stobj fn2-sim
   (with-local-stobj fn2-own
    (mv-let (ok fn2-core fn2-sim fn2-own) (fn2-clc-body mode fn2-core fn2-sim fn2-own) ok)))))
(assert-event (fn2-clc-test :unpublished))
(assert-event (fn2-clc-test :positive))
(assert-event (fn2-clc-test :stale))

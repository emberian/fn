;;; Actual native allocator/retention routing, with recording ACL2 boundaries.
;;; This tests transport/order, not the logical identity grant predicate.
(require :sb-posix)
(require :sb-bsd-sockets)
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defun load-deployed (path names)
  (with-open-file (in path)
    (loop for form = (read in nil :eof) until (eq form :eof)
      when (and (consp form) (member (car form) '(defun defvar))
                (member (cadr form) names)) do (eval form))))
(define-condition refusal (error) ())
(define-condition fault (error) ())
(defun fnn-refuse (&rest args) (declare (ignore args)) (error 'refusal))
(defun fnn-fault (&rest args) (declare (ignore args)) (error 'fault))
(defun fnn-indeterminate (&rest args) (declare (ignore args)) (error 'fault))
(defstruct fnn-store frontier log fenced)
(defstruct fnn-log kernel reserved)
(defstruct fnn-owner-service store)
(defvar *calls* nil)
(defvar *gate-result* 8)
(defvar *grant* nil)
(defvar *expected-event* '(:undertake "obligation" "subject" "evidence" 3))
(defvar *fnn-observe-callback* nil)
(defvar *fnn-finish-callback* nil)
(defun fnn-require-writer (store) (declare (ignore store)))
(defun fnn-store-logp (store) (declare (ignore store)) t)
(defmacro fnn-log-with-kernel ((log) &body body) (declare (ignore log)) `(progn ,@body))
(defun fnn-core (name &rest args)
  (assert (eq name 'fn-lgc-consume-to)) (push :kernel *calls*) (first args))
(defun fnn-metadata-frontier-next (current) (assert (= current 7)) 8)
(defun fnn-owner-identity-reservation (operation)
  (push (list :gate operation) *calls*)
  (setq *grant* (and (integerp *gate-result*) operation))
  *gate-result*)
(defun fnn-observe (store event)
  (declare (ignore store)) (assert (eq event :log-reserve))
  (push :reserve *calls*) :reserved)
(defun fnn-at (store event) (declare (ignore store event)))
(defun fnn-nat (x) x)
(defun fnn-octet-list (x) (coerce x 'list))
(defun fnn-string-octets (x) (map 'vector #'char-code x))
(defun fnn-owner-observe (&rest args) (declare (ignore args)))
(defun fnn-owner-finish () :durable)
(defun fnn-owner-core (name &rest args)
  (declare (ignore args)) (assert (eq name 'fn-owner-next-txid)) 7)
(defun fnn-owner-preflight-publication (service kind)
  (declare (ignore service kind)) :admissible)
(defun fnn-owner-action (name &rest args)
  (assert (eq name 'fn-owner-prepare-retention))
  (assert (equal *grant* *expected-event*))
  (assert (eq (first args) :undertake))
  (push :prepare *calls*) (setq *grant* nil) :prepared)
(defun fnn-owner-publish-prepared (service label)
  (declare (ignore service label)) (push :publish *calls*) :durable)
(load-deployed "host/native/io.lisp"
 '(fnn-advance-frontier fnn-log-reserve *fnn-identity-reservation-callback*))
(load-deployed "host/native/owner.lisp" '(fnn-owner-retention-commit))
(defun fresh-store () (make-fnn-store :frontier 7 :log (make-fnn-log :kernel :old)))
(let* ((store (fresh-store)) (service (make-fnn-owner-service :store store)))
  (setq *calls* nil *gate-result* 8)
  (fnn-owner-retention-commit service *expected-event*)
  (assert (equal (reverse *calls*)
                 (list (list :gate *expected-event*) :kernel :reserve :prepare :publish)))
  (assert (= (fnn-store-frontier store) 8))
  (assert (null *grant*)))
;; Both ordinary reservations and denied retention operations reach the gate.
(dolist (operation (list nil *expected-event*))
  (let ((store (fresh-store)) (*fnn-identity-reservation-callback* #'fnn-owner-identity-reservation))
    (setq *calls* nil *gate-result* :identity-reserve)
    (assert (handler-case (progn (fnn-advance-frontier store 7 operation) nil)
              (refusal () t)))
    (assert (equal *calls* (list (list :gate operation))))
    (assert (= (fnn-store-frontier store) 7))
    (assert (eq (fnn-log-kernel (fnn-store-log store)) :old))
    (assert (null (fnn-log-reserved (fnn-store-log store))))))
;; Malformed/core faults remain faults before any mutation, never refusal.
(dolist (result '("bad" (8) :unknown-result))
  (let ((store (fresh-store)) (*fnn-identity-reservation-callback* #'fnn-owner-identity-reservation))
    (setq *calls* nil *gate-result* result)
    (assert (handler-case (progn (fnn-advance-frontier store 7) nil) (fault () t)))
    (assert (= (fnn-store-frontier store) 7))
    (assert (eq (fnn-log-kernel (fnn-store-log store)) :old))))
(let ((store (fresh-store)) (*fnn-identity-reservation-callback* nil))
  (setq *calls* nil)
  (assert (= (fnn-advance-frontier store 7) 8))
  (assert (equal (reverse *calls*) '(:kernel :reserve))))
(format t "RETENTION-IDENTITY-ROUTE PASS~%")

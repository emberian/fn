; Actual configuration primitive controls. Two B rows with six I/O rows are
; explicit synthetic initialized-child geometry, not a complete core witness.
(in-package "ACL2")
(include-book "../books/checkpoint-working-credit")
(include-book "pool-protected-floor-unit")
(defconst *fn2-cwc-profile*
 (put-assoc-equal :identity-arena-bytes 4096
  (put-assoc-equal :groups '(("service.group" . 1))
   (put-assoc-equal :authority 1 *fn2-profile-concrete*))))
(defconst *fn2-cwc-rows* 2)
(defconst *fn2-cwc-io-rows* (* 3 *fn2-cwc-rows*))
(defun fn2-cwc-unconfigured-view (fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (list (fn2-pfu-slots 0 fn2-pool)
       (fn2-pool-class-countsi 0 fn2-pool) (fn2-pool-class-headsi 0 fn2-pool)
       (fn2-pool-class-countsi 1 fn2-pool) (fn2-pool-class-headsi 1 fn2-pool)
       (fn2-pool-credit-configured fn2-pool) (fn2-pool-credit-group-count fn2-pool)
       (fn2-pool-credit-protected-length fn2-pool)
       (fn2-pool-credit-purpose-length fn2-pool) (fn2-pool-credit-phase-length fn2-pool)
       (fn2-pool-credit-group-nonce-length fn2-pool)
       (fn2-pool-credit-group-owner-kind-length fn2-pool)
       (fn2-pool-credit-group-owner-slot-length fn2-pool)
       (fn2-pool-credit-group-owner-gen-length fn2-pool)
       (fn2-pool-credit-demand-length fn2-pool) (fn2-pool-credit-available-length fn2-pool)))
(defun fn2-cwc-body (fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (b* ((fn2-pool (fn2-pool-init '((1 . 4096) (1 . 65536)) 1 100 fn2-pool))
      (working (fn2-checkpoint-working-credit-vector 0 fn2-pool))
      (journal-class (fn2-pool-class-for *fn2-format-sector-bytes* fn2-pool))
      (drain (fn2-checkpoint-drain-credit-vector 0 journal-class
              (+ 1 (floor *fn2-cwc-io-rows* *fn2-cwc-rows*)) fn2-pool))
      ((mv service-code service) (fn2-checkpoint-service-demand-vector *fn2-cwc-profile* fn2-pool))
      ((unless (and (eq service-code :ok) (posp (nth 0 service)) (posp (nth 1 service))
                    (equal (+ (nth 0 working) (nth 1 working)) *fn2-checkpoint-working-window-count*)))
       (mv nil fn2-pool))
      (p0 (+ (nth 0 working) (* *fn2-cwc-rows* (nth 0 drain))))
      (p1 (+ (nth 1 working) (* *fn2-cwc-rows* (nth 1 drain))))
      (fn2-pool (fn2-pool-init (list (cons p0 4096) (cons p1 65536)) 1 100 fn2-pool))
      (before (fn2-cwc-unconfigured-view fn2-pool))
      ((mv protected-only fn2-pool) (fn2-checkpoint-working-credit-configure
                                    *fn2-cwc-profile* *fn2-cwc-rows* *fn2-cwc-io-rows* fn2-pool))
      ((unless (and (eq protected-only :exhausted) (equal before (fn2-cwc-unconfigured-view fn2-pool))))
       (mv nil fn2-pool))
      (fn2-pool (fn2-pool-init (list (cons (+ p0 (nth 0 service)) 4096)
                                   (cons (+ p1 (nth 1 service)) 65536)) 1 100 fn2-pool))
      (before (fn2-cwc-unconfigured-view fn2-pool))
      ((mv malformed fn2-pool) (fn2-checkpoint-working-credit-configure
                               *fn2-cwc-profile* *fn2-cwc-rows* (+ 1 *fn2-cwc-io-rows*) fn2-pool))
      ((unless (and (eq malformed :geometry) (equal before (fn2-cwc-unconfigured-view fn2-pool))))
       (mv nil fn2-pool))
      ((mv configured fn2-pool) (fn2-checkpoint-working-credit-configure
                                *fn2-cwc-profile* *fn2-cwc-rows* *fn2-cwc-io-rows* fn2-pool)))
  (mv (and (eq configured :ok) (fn2-pool-wfp fn2-pool)
           (equal (fn2-pool-credit-group-count fn2-pool) (+ 1 *fn2-cwc-rows*))
           (equal (fn2-pool-credit-protectedi 0 fn2-pool) p0)
           (equal (fn2-pool-credit-protectedi 1 fn2-pool) p1)
           (equal (fn2-pool-reservable-count 0 fn2-pool) (nth 0 service))
           (equal (fn2-pool-reservable-count 1 fn2-pool) (nth 1 service))) fn2-pool)))
(defun fn2-cwc-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool (mv-let (ok fn2-pool) (fn2-cwc-body fn2-pool) ok)))
(assert-event (fn2-cwc-run))

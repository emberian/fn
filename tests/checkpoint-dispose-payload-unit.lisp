; Hypothesis-removal witness: the same stale-generation request would mutate
; the current claim through an unguarded ordinary drop; the actual gate refuses.
(assert-event
 (let ((actual (fn2-cdp-run :stale-generation nil))
       (unguarded (fn2-cdp-run :stale-generation :bypass)))
  (and (car actual) (eq (caddr actual) :state)
       (eq (caddr unguarded) :ok)
       (not (equal (cadr actual) (cadr unguarded))))))

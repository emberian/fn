; Actual POST constructor argument control at a real nonzero reserved extent.
; Typed digest inputs are synthetic, so this is not a source-hash, Write/Fence,
; complete APPEND or C-stage witness. No record/model constructor substitutes
; for fn2-txn-put-post-for, and no allocator or successor row is seeded.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "upload-stored-source-unit")
(defconst *fn2-tupl-header*
 (append (fn2-cw-chars (coerce "From: a" 'list)) '(13 10)
         (fn2-cw-chars (coerce "Subject: b" 'list)) '(13 10)
         (fn2-cw-chars (coerce "Date: c" 'list)) '(13 10 13 10)))
(defun fn2-tupl-arg (field fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-fc (fn2-core-fc fn2-core))
             (fn2-id-decides (fn2-core-id-decides fn2-core))
             (fn2-fields (fn2-core-fields fn2-core))) (code value slot gen off len)
  (mv-let (code base) (fn2-idc-stripe 0 (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields)
   (let ((row (+ base (* *fn2-succ-block* *fn2-txn-slot-article*) *fn2-succ-raw* field)))
    (if (and (eq code :ok) (natp row) (< row (fn2-fields-rows fn2-fields)))
     (mv :ok (fn2-fields-value row fn2-fields) (fn2-fields-ref-slot row fn2-fields)
         (fn2-fields-ref-gen row fn2-fields) (fn2-fields-ref-off row fn2-fields) (fn2-fields-ref-len row fn2-fields))
     (mv :bounds 0 0 0 0 0)))) (mv code value slot gen off len)))
(defun fn2-tupl-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-txn-posting-profile* fn2-core))
      ((mv epoch fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv first first-e & & fn2-core) (fn2-upload-payload-reserve fn2-core))
      ((mv reserved e ep allocation fn2-core) (fn2-upload-payload-reserve fn2-core))
      ((mv p0 c0 g0 fn2-core) (fn2-core-reserve 1 *fn2-upload-kind* 0 1 fn2-core))
      ((mv p1 c1 g1 fn2-core) (fn2-core-reserve 1 *fn2-upload-kind* 0 1 fn2-core))
      ((mv pm ms mg fn2-core) (fn2-core-reserve 1 *fn2-upload-kind* 0 1 fn2-core))
      ((mv ps ss sg fn2-core) (fn2-core-reserve 1 *fn2-upload-kind* 0 1 fn2-core))
      (source (append *fn2-tupl-header* '(120 13 10)))
      ((mv wrote fn2-core) (fn2-uss-write (append source (make-list 32 :initial-element 7)) c0 g0 0 fn2-core))
      ((mv mid fn2-core) (fn2-uss-write '(60 97 64 98 62) ms mg 0 fn2-core))
      ((mv digests fn2-core) (fn2-uss-write (append (make-list 32 :initial-element 9)
                                                                (make-list 32 :initial-element 11)) ss sg 0 fn2-core))
      ((unless (and (eq epoch :ok) (eq first :ok) (eq reserved :ok) (> e first-e) (posp e)
                    (eq p0 :ok) (eq p1 :ok) (eq pm :ok) (eq ps :ok)
                    (eq wrote :ok) (eq mid :ok) (eq digests :ok)
                    (fn2-core-wfp fn2-core))) (mv nil fn2-core))
      ((mv produced fn2-core)
       (fn2-txn-put-post-for 0 ms mg 0 5 c0 g0 (len *fn2-tupl-header*) (len source)
                            0 :ok ss sg 32 0 0 1 1 e ep allocation ss sg 0 32 32 0 *fn2-upload-kind* 0 1 fn2-core))
      ((mv code unit & & & &) (fn2-tupl-arg *fn2-article-entry-field-location-unit* fn2-core))
      ((mv epoch-code got-epoch & & & &) (fn2-tupl-arg *fn2-article-entry-field-location-epoch* fn2-core))
      ((mv alloc-code got-allocation & & & &) (fn2-tupl-arg *fn2-article-entry-field-location-allocation* fn2-core))
      ((mv hash-code & hash-slot hash-gen hash-off hash-len)
       (fn2-tupl-arg *fn2-article-entry-field-location-hashes* fn2-core)))
  (mv (and (eq produced :ok) (eq code :ok) (eq epoch-code :ok) (eq alloc-code :ok) (eq hash-code :ok)
           (= (* unit *fn2-commit-unit-bytes*) (* e *fn2-commit-extent-bytes*))
           (not (= unit (* e *fn2-commit-write-resources*)))
           (= got-epoch ep) (= got-allocation allocation)
           (= *fn2-commit-write-resources* 3)
           (= *fn2-article-location-hashes-max* (* 32 *fn2-commit-write-resources*))
           (= hash-slot ss) (= hash-gen sg) (= hash-off 32) (= hash-len 32)
           (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))) fn2-core)))
(defun fn2-tupl-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-tupl-body fn2-core) ok)))
(assert-event (fn2-tupl-run))

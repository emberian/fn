; PREPARED, UNEXECUTED allocator primitive control. Real credit configuration
; protects two windows. Raw free space still fits the complete query recipe,
; but actual ordinary reserve cannot spend those credits. No counts are seeded.
(in-package "ACL2")
(include-book "../books/run-physical-park-region")
(include-book "../books/pool-credit")
(include-book "column-snapshot-support")
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-pool (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-run-loads (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-run-cursors (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-checkpoint-summary (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-checkpoint-summary-leases (w state))))
(defun fn2-rlr-view (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool) :verify-guards nil))
 (list (fn2-test-table-snapshot-fn2-run-loads fn2-run-loads)
       (fn2-test-table-snapshot-fn2-run-cursors fn2-run-cursors)
       (fn2-test-table-snapshot-fn2-checkpoint-summary fn2-checkpoint-summary)
       (fn2-test-table-snapshot-fn2-checkpoint-summary-leases fn2-checkpoint-summary-leases)
       (fn2-test-table-snapshot-fn2-pool fn2-pool)))
(defun fn2-rlr-body (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
 (declare (xargs :stobjs (fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool) :verify-guards nil))
 (b* ((jobs *fn2-b-query-loader-jobs*) (slots (+ 2 (* 2 jobs)))
      (fn2-run-loads (fn2-run-loads-init jobs fn2-run-loads))
      (fn2-run-cursors (fn2-run-cursors-init jobs fn2-run-cursors))
      (fn2-checkpoint-summary (fn2-checkpoint-summary-init 2 fn2-checkpoint-summary))
      (fn2-checkpoint-summary-leases (fn2-checkpoint-summary-leases-init jobs fn2-checkpoint-summary-leases))
      ; Both requested classes intentionally alias the real 64KiB class.
      (fn2-pool (fn2-pool-init (list (cons slots *fn2-format-page-size*)) 1 100 fn2-pool))
      ((mv configured fn2-pool) (fn2-pool-credit-configure (list (list *fn2-pool-credit-working* 2)) fn2-pool))
      ((mv taken held hgen fn2-pool) (fn2-pool-reserve 0 7 8 1 fn2-pool))
      (H (and (eq configured :ok) (eq taken :ok)
              (<= (* 2 jobs) (fn2-pool-class-countsi 0 fn2-pool))
              (not (fn2-run-load-roomp jobs fn2-pool))))
      (before (fn2-rlr-view fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      ((mv refused complete fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
       (fn2-run-load-region-reserve 0 jobs 0 0 0 0 7 8 1 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      (after-refusal (fn2-rlr-view fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      ((mv returned fn2-pool) (fn2-pool-release held hgen 7 8 1 fn2-pool))
      (available (fn2-run-load-roomp jobs fn2-pool))
      ((mv reserved all fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
       (fn2-run-load-region-reserve 0 jobs 0 0 0 0 7 8 1 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool))
      ((mv cleaned fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
       (fn2-run-load-region-clean 0 0 jobs 0 0 0 0 7 8 1 fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))
  (mv (and H (eq refused :exhausted) (equal complete 0) (equal before after-refusal)
           (eq returned :ok) available (eq reserved :ok) (equal all 1) (eq cleaned :ok)
           (equal (fn2-pool-class-countsi 0 fn2-pool) slots)
           (equal (fn2-pool-credit-protectedi 0 fn2-pool) 2)
           (equal (fn2-pool-reservable-count 0 fn2-pool) (* 2 jobs)))
   fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)))
(assert-event
 (with-local-stobj fn2-run-loads (with-local-stobj fn2-run-cursors
 (with-local-stobj fn2-checkpoint-summary (with-local-stobj fn2-checkpoint-summary-leases (with-local-stobj fn2-pool
 (mv-let (good fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool)
  (fn2-rlr-body fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool) good)))))))

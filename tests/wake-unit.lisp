(in-package "ACL2")
(include-book "../books/executor")
(include-book "../sim/sim")

(defun fn2-wake-test-ops (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
    (snapshot) (fn2-ops-snapshot fn2-ops) snapshot))
(defun fn2-wake-test-payload (slot fn2-core)
  (declare (xargs :stobjs fn2-core :guard (fn2-core-wfp fn2-core)))
  (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
    (code deadline generation)
    (if (fn2-op-slotp slot fn2-ops)
        (mv-let (deadline generation) (fn2-op-wake slot fn2-ops)
          (mv :ok deadline generation))
      (mv :bounds nil nil))
    (mv code deadline generation)))

(defun fn2-wake-unit-run (fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       (fn2-sim (fn2-sim-init 1 :none "wake-unit" *fn2-profile-tiny* fn2-sim))
       (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
       (before (fn2-wake-test-ops fn2-core))
       ((mv code & & fn2-core) (fn2-issue-arm-wake -1 1 fn2-core))
       ((unless (and (eq code :bounds) (equal before (fn2-wake-test-ops fn2-core))))
        (mv :bad-deadline fn2-core fn2-sim fn2-own))
       ((mv code & & fn2-core) (fn2-issue-arm-wake 100 #x1000000000000000 fn2-core))
       ((unless (and (eq code :bounds) (equal before (fn2-wake-test-ops fn2-core))))
        (mv :bad-observation-generation fn2-core fn2-sim fn2-own))
       (fn2-core (fn2-request-wake 100 fn2-core))
       (fn2-core (fn2-request-wake 200 fn2-core))
       ((unless (= (fn2-core-idle-deadline fn2-core) 100))
        (mv :earliest fn2-core fn2-sim fn2-own))
       ((mv actions fn2-core) (fn2-exec-arm fn2-core))
       ((unless (= actions 1)) (mv :arm fn2-core fn2-sim fn2-own))
       ((mv payload-code deadline generation) (fn2-wake-test-payload 0 fn2-core))
       ((unless (and (eq payload-code :ok) (= deadline 100) (= generation 0)))
        (mv :descriptor-payload fn2-core fn2-sim fn2-own))
       ((mv actions fn2-core) (fn2-exec-arm fn2-core))
       ((unless (= actions 0)) (mv :coalesced fn2-core fn2-sim fn2-own))
       ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
       ((unless (and (= taken 1) (= (fn2-sim-wake-pending fn2-sim) 1)
                     (= (fn2-sim-wake-deadline fn2-sim) 100)))
        (mv :adapter-wake fn2-core fn2-sim fn2-own))
       (fn2-core (fn2-request-wake 25 fn2-core))
       ((mv actions fn2-core) (fn2-exec-arm fn2-core))
       ((unless (= actions 1)) (mv :earlier-arm fn2-core fn2-sim fn2-own))
       ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
       ((unless (and (= taken 1) (= (fn2-sim-wake-deadline fn2-sim) 25)))
        (mv :earlier-replacement fn2-core fn2-sim fn2-own))
       ((mv progressed fn2-core fn2-sim fn2-own) (fn2-sim-advance fn2-core fn2-sim fn2-own))
       ((unless (and progressed (= (fn2-sim-now fn2-sim) 25)
                     (= (fn2-sim-wake-pending fn2-sim) 0)))
        (mv :deadline-advance fn2-core fn2-sim fn2-own))
       (fn2-core (fn2-exec-clock 25 fn2-core))
       ((unless (and (= (fn2-core-idle-deadline fn2-core) *fn2-no-deadline*)
                     (= (fn2-exec-wake-generation fn2-core) 1)))
        (mv :observed-deadline fn2-core fn2-sim fn2-own))
       (fn2-core (fn2-request-wake 250 fn2-core))
       ((mv actions fn2-core) (fn2-exec-arm fn2-core))
       ((unless (= actions 1)) (mv :new-view-arm fn2-core fn2-sim fn2-own))
       ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
       ((unless (and (= taken 1) (= (fn2-sim-wake-deadline fn2-sim) 250)
                     (= (fn2-sim-wake-observation-gen fn2-sim) 1)))
        (mv :new-view-payload fn2-core fn2-sim fn2-own))
       (fn2-sim (fn2-sim-arm-wake 500 0 fn2-sim))
       ((unless (= (fn2-sim-wake-deadline fn2-sim) 250))
        (mv :stale-request fn2-core fn2-sim fn2-own))
       (fn2-core (fn2-exec-set-wake-generation *fn2-u60-max* fn2-core))
       (fn2-core (fn2-exec-clock 26 fn2-core)))
    (mv (if (= (fn2-exec-stop fn2-core) 1) t :generation-wrap)
        fn2-core fn2-sim fn2-own)))

(defun fn2-wake-unit ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (result fn2-core)
      (with-local-stobj fn2-sim
        (mv-let (result fn2-core fn2-sim)
          (with-local-stobj fn2-own
            (mv-let (result fn2-core fn2-sim fn2-own)
              (fn2-wake-unit-run fn2-core fn2-sim fn2-own)
              (mv result fn2-core fn2-sim)))
          (mv result fn2-core)))
      result)))
(assert-event (equal (fn2-wake-unit) t))

(defun fn2-wake-test-fill-outbox (left fn2-core)
  (declare (xargs :stobjs fn2-core :measure (nfix left) :verify-guards nil))
  (if (zp left) (mv t fn2-core)
    (mv-let (code slot gen fn2-core) (fn2-issue-arm-wake 100 0 fn2-core)
      (declare (ignore slot gen))
      (if (eq code :ok) (fn2-wake-test-fill-outbox (- left 1) fn2-core)
        (mv nil fn2-core)))))
(defun fn2-wake-credit-unit ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (answer fn2-core)
      (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
           ((mv filled fn2-core) (fn2-wake-test-fill-outbox (fn2-profile-qa *fn2-profile-tiny*) fn2-core))
           ((unless filled) (mv :fill fn2-core))
           (before (fn2-wake-test-ops fn2-core))
           ((mv code & & fn2-core) (fn2-issue-arm-wake 50 0 fn2-core))
           ((unless (and (eq code :exhausted)
                         (equal before (fn2-wake-test-ops fn2-core))))
            (mv :exhaustion-mutated fn2-core))
           (fn2-core (fn2-request-wake 50 fn2-core))
           ((mv count fn2-core) (fn2-exec-arm fn2-core)))
        (mv (and (= count 0) (= (fn2-core-idle-deadline fn2-core) 50)
                 (= (fn2-exec-armed-deadline fn2-core) *fn2-no-deadline*)) fn2-core))
      answer)))
(assert-event (equal (fn2-wake-credit-unit) t))

; Draining an outbox changes eligibility. The host must re-read status before
; waiting, otherwise a newly affordable earlier ArmWake can be missed.
(defun fn2-wake-drain-unit-run (fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       (fn2-sim (fn2-sim-init 1 :none "wake-drain-unit" *fn2-profile-tiny* fn2-sim))
       (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
       (capacity (fn2-profile-qa *fn2-profile-tiny*))
       ((mv filled fn2-core) (fn2-wake-test-fill-outbox capacity fn2-core))
       ((unless filled) (mv :fill fn2-core fn2-sim fn2-own))
       (fn2-core (fn2-request-wake 50 fn2-core))
       ((mv status & & actions fn2-core) (fn2-turn fn2-core))
       ((unless (and (eq status :idle) (= actions 0)))
        (mv :credit-wait fn2-core fn2-sim fn2-own))
       ((mv taken fn2-core fn2-sim fn2-own)
        (fn2-sim-take-prefix capacity 0 fn2-core fn2-sim fn2-own))
       ((unless (and (= taken capacity) (= (fn2-sim-wake-deadline fn2-sim) 100)
                     (eq (fn2-turn-status fn2-core) :more)))
        (mv :drain-must-resume fn2-core fn2-sim fn2-own))
       ((mv status & & actions fn2-core) (fn2-turn fn2-core))
       ((unless (and (eq status :idle) (= actions 1)))
        (mv :resumed-arm fn2-core fn2-sim fn2-own))
       ((mv taken fn2-core fn2-sim fn2-own)
        (fn2-sim-take-prefix capacity 0 fn2-core fn2-sim fn2-own))
       ((unless (and (= taken 1) (= (fn2-sim-wake-deadline fn2-sim) 50)
                     (eq (fn2-turn-status fn2-core) :idle)))
        (mv :earliest-installed fn2-core fn2-sim fn2-own))
       ((mv progressed fn2-core fn2-sim fn2-own)
        (fn2-sim-advance fn2-core fn2-sim fn2-own)))
    (mv (and progressed (= (fn2-sim-now fn2-sim) 50)) fn2-core fn2-sim fn2-own)))
(defun fn2-wake-drain-unit ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (result fn2-core)
      (with-local-stobj fn2-sim
        (mv-let (result fn2-core fn2-sim)
          (with-local-stobj fn2-own
            (mv-let (result fn2-core fn2-sim fn2-own)
              (fn2-wake-drain-unit-run fn2-core fn2-sim fn2-own)
              (mv result fn2-core fn2-sim)))
          (mv result fn2-core)))
      result)))
(assert-event (equal (fn2-wake-drain-unit) t))

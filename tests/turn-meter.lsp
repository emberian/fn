; Common Lisp session instrumentation, loaded only after ACL2's :q.
; No logical definition is altered; restore the raw fdefinition on exit.
(in-package "ACL2")
(defvar *fn2-meter-original* nil)
(defvar *fn2-meter-calls* 0)
(defvar *fn2-meter-ticks* 0)
(defvar *fn2-meter-max* 0)
(defvar *fn2-meter-bytes* 0)
(defvar *fn2-meter-warmup* 64)

(defun fn2-meter-reset ()
  (setf *fn2-meter-calls* 0 *fn2-meter-ticks* 0
        *fn2-meter-max* 0 *fn2-meter-bytes* 0))
(defun fn2-meter-install ()
  (assert (null *fn2-meter-original*))
  (setf *fn2-meter-original* (symbol-function 'fn2-turn))
  (setf (symbol-function 'fn2-turn)
        (lambda (core)
          (let ((bytes (sb-ext:get-bytes-consed))
                (start (get-internal-run-time)))
            (multiple-value-prog1 (funcall *fn2-meter-original* core)
              (let ((ticks (- (get-internal-run-time) start))
                    (consed (- (sb-ext:get-bytes-consed) bytes)))
                (incf *fn2-meter-calls*)
                (when (> *fn2-meter-calls* *fn2-meter-warmup*)
                  (incf *fn2-meter-ticks* ticks)
                  (incf *fn2-meter-bytes* consed)
                  (setf *fn2-meter-max* (max *fn2-meter-max* ticks))))))))
  (fn2-meter-reset))
(defun fn2-meter-restore ()
  (when *fn2-meter-original*
    (setf (symbol-function 'fn2-turn) *fn2-meter-original*
          *fn2-meter-original* nil)))
(defun fn2-meter-control ()
  (fn2-meter-reset)
  (let ((*fn2-meter-original* (lambda (core) (values :idle 0 0 0 core))))
    (dotimes (i (+ 10000 *fn2-meter-warmup*))
      (funcall (symbol-function 'fn2-turn) nil)))
  (format t "TURN METER CONTROL measured=10000 bytes-total=~D~%" *fn2-meter-bytes*)
  (assert (= *fn2-meter-calls* (+ 10000 *fn2-meter-warmup*)))
  (assert (zerop *fn2-meter-bytes*))
  (fn2-meter-reset))
(defun fn2-meter-report (label)
  (let ((n (- *fn2-meter-calls* *fn2-meter-warmup*)))
    (assert (> n 0))
    (format t "~A turns=~D mean-us=~,3F max-us=~,3F bytes-total=~D bytes-per-turn=~,6F warmup=~D~%"
            label n
            (* 1000000d0 (/ *fn2-meter-ticks* n internal-time-units-per-second))
            (* 1000000d0 (/ *fn2-meter-max* internal-time-units-per-second))
            *fn2-meter-bytes* (/ *fn2-meter-bytes* n) *fn2-meter-warmup*)))

; Actual ordinary admission must not consume the closed maintenance arena.
; The phase2 ledger is an explicit synthetic premise, not served construction.
; The included final-producer control separately exercises its real B admission.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-installation-coordinator-unit")
(defun fn2-cfa-values (layout)
 (declare (xargs :verify-guards nil :measure (len layout)))
 (if (atom layout) nil
  (let ((kind (cadar layout)))
   (cons (cond ((eq kind :digest) (cons 1 (make-list 32 :initial-element 7)))
               ((and (consp kind) (eq (car kind) :octets)) '(60 97 64 98 62))
               ((and (consp kind) (eq (car kind) :enum)) 0) (t 1))
         (fn2-cfa-values (cdr layout))))))
(defconst *fn2-cfa-body*
 (fn2-layout-octets *fn2-format-article-acceptance* (fn2-cfa-values *fn2-format-article-acceptance*)))
(defconst *fn2-cfa-member*
 (append (fn2-layout-octets *fn2-format-txn-record*
           (list *record-kind-article-acceptance* (len *fn2-cfa-body*))) *fn2-cfa-body*))
(defun fn2-cfa-fill (bytes slot gen at fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (len bytes)))
 (if (atom bytes) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen at (car bytes) 1 2 3 fn2-core)
   (if (eq code :ok) (fn2-cfa-fill (cdr bytes) slot gen (+ 1 at) fn2-core) (mv code fn2-core)))))
(defun fn2-cfa-geometry (ticket fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
             (fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core))
             (fn2-commit-root (fn2-core-commit-root fn2-core))) (view)
  (list (fn2-construction-ticket-scan fn2-checkpoint-construction)
        (fn2-construction-next-ticket fn2-checkpoint-construction)
        (fn2-checkpoint-construction-ticket-claimed ticket fn2-checkpoint-construction)
        (fn2-checkpoint-construction-ticket-batch ticket fn2-checkpoint-construction)
        (fn2-alloc-next-counter fn2-extents) (fn2-alloc-free-head fn2-extents)
        (fn2-alloc-total-free fn2-extents) (fn2-alloc-total-reserved fn2-extents)
        (fn2-alloc-total-allocated fn2-extents) (fn2-extents-state ticket fn2-extents)
        (fn2-commit-root-proposed 0 fn2-commit-root) (fn2-commit-root-first-key 0 fn2-commit-root)) view))
(defun fn2-cfa-case (phase keyed fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init (fn2-b-test-profile *fn2-profile-tiny* 0) fn2-core))
      ((mv epoch fn2-core) (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv seeded ticket fn2-core) (fn2-cac-seed 0 fn2-core))
      (fn2-core (stobj-let ((fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core)))
        (fn2-checkpoint-construction)
        (fn2-checkpoint-construction-put ticket (role 6) (ordinal 0)
          (intended-bytes (* *fn2-commit-write-resources* *fn2-commit-unit-bytes*))) fn2-core))
      ((mv reserved slot gen fn2-core) (fn2-core-reserve (fn2-scribe-window-class fn2-core) 1 2 3 fn2-core))
      ((mv filled fn2-core) (fn2-cfa-fill *fn2-cfa-member* slot gen 0 fn2-core))
      ; Establish the complete generic decoder antecedent before freezing.
      ((mv decoded records need fn2-core)
       (fn2-commit-txn-scan *fn2-commit-txn-records-max* 0 slot gen 0 (len *fn2-cfa-member*) 1 2 3 0 0 fn2-core))
      (fn2-core (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (fn2-extents)
        (let* ((fn2-extents (update-fn2-alloc-freeze-phase phase fn2-extents))
               (fn2-extents (update-fn2-alloc-freeze-token 7 fn2-extents))
               (fn2-extents (update-fn2-alloc-freeze-owner-kind 1 fn2-extents))
               (fn2-extents (update-fn2-alloc-freeze-owner-slot 2 fn2-extents)))
         (update-fn2-alloc-freeze-owner-gen 3 fn2-extents)) fn2-core))
      (eligible (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                            (fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core))) (ok)
        (and (fn2-checkpoint-construction-ownerp ticket fn2-checkpoint-construction fn2-extents)
             (= (fn2-checkpoint-construction-role ticket fn2-checkpoint-construction) 6)
             (= (fn2-checkpoint-construction-ordinal ticket fn2-checkpoint-construction)
                (fn2-construction-next-ticket fn2-checkpoint-construction))
             (= (fn2-checkpoint-construction-ticket-claimed ticket fn2-checkpoint-construction) 0)
             (= (fn2-extents-state ticket fn2-extents) *fn2-extent-state-reserved*)) ok))
      ((mv pick id partner) (fn2-commit-pick fn2-core))
      (planner (and (eq pick :open) (fn2-commit-idp id fn2-core) (fn2-commit-idp partner fn2-core)
                    (fn2-commit-settled-room 1 fn2-core)))
      (before (fn2-cfa-geometry ticket fn2-core))
      ((mv code fn2-core)
       (if keyed
           (mv-let (code id batch event fn2-core) (fn2-commit-admit-keyed 1 0 1 2 3 fn2-core)
            (declare (ignore id batch event)) (mv code fn2-core))
         (mv-let (code batch event fn2-core) (fn2-commit-admit-txn slot gen (len *fn2-cfa-member*) 1 2 3 fn2-core)
          (declare (ignore batch event)) (mv code fn2-core))))
      (after (fn2-cfa-geometry ticket fn2-core)))
  (mv (and (eq epoch :ok) (eq seeded :ok) (eq reserved :ok) (eq filled :ok)
           (eq decoded :ok) eligible planner (= records 1) (<= need *fn2-commit-records-room*)
           (if (= phase 0) (eq code :ok)
             (and (eq code :exhausted) (equal before after) (= (fn2-core-stop-reason fn2-core) 0)))) fn2-core)))
(defun fn2-cfa-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (ok fn2-core)
   (b* (((mv a fn2-core) (fn2-cfa-case 0 nil fn2-core))
        ((mv b fn2-core) (fn2-cfa-case 0 t fn2-core))
        ((mv c fn2-core) (fn2-cfa-case 1 nil fn2-core))
        ((mv d fn2-core) (fn2-cfa-case 1 t fn2-core))
        ((mv e fn2-core) (fn2-cfa-case 2 nil fn2-core))
        ((mv f fn2-core) (fn2-cfa-case 2 t fn2-core)))
    (mv (and a b c d e f) fn2-core)) ok)))
(assert-event (fn2-cfa-run))
; Includes actual checked-candidate production, ledger barrier and retained
; final-ticket admission through the private validated path; provenance is
; explicitly synthetic in that fixture, and no persisted success is claimed.
(assert-event (fn2-cic-run))

; Real nonempty upgrade descriptor through physical stage/save/post.
(in-package "ACL2")
(include-book "../sim/sim")
(include-book "../books/assembly-init")
(defun fn2-compress-stage-control (fault fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
      (fn2-sim (fn2-sim-init 7 :friendly "compress-stage" *fn2-profile-tiny* fn2-sim))
      ((mv code nonce fn2-sim)
       (stobj-let ((fn2-sim-network (fn2-sim-net fn2-sim))) (code nonce fn2-sim-network)
        (fn2-network-accept 0 fn2-sim-network) (mv code nonce fn2-sim)))
      ((unless (eq code :ok)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv code range rg fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
      ((unless (eq code :ok)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv code fn2-core) (fn2-core-write range rg 0 17 1 0 1 fn2-core))
      (fn2-own (fn2-own-observe-core-write range rg 0 code 17 fn2-core fn2-own))
      ((unless (eq code :ok)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv code op & fn2-core) (fn2-issue-compress-start 0 nonce range rg 0 1 1 0 1 0 fn2-core))
      ((unless (eq code :ok)) (mv nil fn2-core fn2-sim fn2-own))
      (fn2-own (fn2-own-observe-issue op fn2-core fn2-own))
      ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
      ((unless (= taken 1)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv status packet fn2-core fn2-sim fn2-own)
       (fn2-sim-native-stage op fault 0 fn2-core fn2-sim fn2-own))
      (reset (equal fault *fn2-fault-reset*))
      ((unless (and (eq status :returned) (fn2-sim-ready fn2-sim)
                    (fn2-sim-native-packetp packet fn2-sim)
                    (equal packet (fn2-sim-saved-return op fn2-sim))
                    (equal (nth 5 packet) (if reset :io :ok))
                    (= (nth 6 packet) (if reset 0 1))))
       (mv nil fn2-core fn2-sim fn2-own))
      ((mv posted fn2-core fn2-sim fn2-own) (fn2-sim-native-post packet fn2-core fn2-sim fn2-own))
      (terminal (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (yes)
                 (and (= (fn2-ops-c0-posted op fn2-ops) 1)
                      (= (fn2-ops-c0-outcome op fn2-ops) (if reset *fn2-outcome-failed* *fn2-outcome-done*))
                      (= (fn2-ops-c0-reason op fn2-ops) (if reset *fn2-reason-io* *fn2-reason-none*))
                      (= (fn2-ops-c0-count op fn2-ops) (if reset 0 1))) yes)))
  (mv (and posted terminal) fn2-core fn2-sim fn2-own)))
(defun fn2-compress-stage-test (fault)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (ok fn2-core)
   (with-local-stobj fn2-sim
    (mv-let (ok fn2-core fn2-sim)
     (with-local-stobj fn2-own
      (mv-let (ok fn2-core fn2-sim fn2-own)
       (fn2-compress-stage-control fault fn2-core fn2-sim fn2-own)
       (mv ok fn2-core fn2-sim)))
     (mv ok fn2-core))) ok)))
(assert-event (fn2-compress-stage-test *fn2-fault-none*))
(assert-event (fn2-compress-stage-test *fn2-fault-reset*))

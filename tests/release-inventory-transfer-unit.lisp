(defun fn2-ritu-kept-fields (fields excluded)
 (declare (xargs :verify-guards nil))
 (if (atom fields) nil
  (if (member-eq (caar fields) excluded) (fn2-ritu-kept-fields (cdr fields) excluded)
   (cons (car fields) (fn2-ritu-kept-fields (cdr fields) excluded)))))
(defun fn2-ritu-frame-event (name child excluded world)
 (declare (xargs :verify-guards nil))
 (let* ((all (fn2-test-snapshot-fields child world))
        (fields (fn2-ritu-kept-fields all excluded))
        (renames (fn2-test-snapshot-renames all)))
  `(defun ,name (,child)
    (declare (xargs :stobjs ,child :verify-guards nil))
    (list ,@(sublis renames (fn2-columns-snapshot-calls child fields))))))

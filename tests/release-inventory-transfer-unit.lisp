(defun fn2-ritu-array-frame (at allowed before after)
 (declare (xargs :verify-guards nil :measure (acl2-count before)))
 (if (atom before) (equal before after)
  (and (consp after) (or (member-equal at allowed) (equal (car before) (car after)))
       (fn2-ritu-array-frame (+ 1 (nfix at)) allowed (cdr before) (cdr after)))))
(defun fn2-ritu-edges-frame (allowed before after)
 (declare (xargs :verify-guards nil :measure (acl2-count before)))
 (if (atom before) (equal before after)
  (and (consp after)
       (if (consp (car before)) (fn2-ritu-array-frame 0 allowed (car before) (car after))
        (equal (car before) (car after)))
       (fn2-ritu-edges-frame allowed (cdr before) (cdr after)))))

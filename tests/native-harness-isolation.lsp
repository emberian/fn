;;; Trusted-source raw controls: image creation needs no seed/replay definitions.
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(defvar *calls* nil)
(defun fn2-n-live-core () :core)
(defun fn2-image-profile (profile) (list :image profile))
(defun fn2-init-executor (profile echo-key echo core)
  (assert (and (eq echo-key :echo) (null echo) (eq core :core)))
  (push (list :init profile) *calls*))
(defun fn2-n-open-host (profile core &rest options)
  (assert (eq core :core))
  (push (list :open profile options) *calls*)
  :host)
(with-open-file (source "host/adapter.lisp")
  (loop for form = (read source nil nil) while form
        when (and (consp form) (eq (car form) 'defun)
                  (eq (cadr form) 'fn2-n-make-host)) do (eval form)))
(assert (not (fboundp 'fn2-cs-seed-all)))
(assert (eq (fn2-n-make-host :profile :device-path "own.img" :kill-at 17) :host))
(assert (equal (cadr *calls*) '(:init (:image :profile))))
(assert (equal (cadar *calls*) '(:image :profile)))
(assert (= (getf (caddar *calls*) :kill-at) 17))
(assert (equal (getf (caddar *calls*) :device-path) "own.img"))
(assert (not (fboundp 'fn2-cs-seed-all)))

;; The harness explicitly provides its own seed function and memory writes.
(defun fn2-cs-seed-all (seeds first core)
  (assert (and (equal seeds '(:seed)) (= first 1) (eq core :core)))
  (push '(:seed) *calls*)
  (values :ok '((0 1 2 3))))
(load "host/native-seed-fixture.lisp")
(setf *calls* nil)
(assert (eq (fn2-n-make-seeded-host :profile '(:seed) :control-fd 0) :host))
(assert (equal (reverse (cdr *calls*)) '((:init :profile) (:seed))))
(assert (equal (getf (caddar *calls*) :memory-store) '((0 1 2 3))))
(assert (equal *fn2-n-seed-store* '((0 1 2 3))))
(format t "Native image/harness isolation controls passed.~%")

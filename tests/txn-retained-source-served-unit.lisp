; Actual POST producer reaches a sealed upload and a linked transaction.
; Before sealing, the same consumer ref is unavailable; after sealing, it
; names the original SOURCE digest in the upload's held page.
(in-package "ACL2")
(include-book "upload-source-lifetime-unit")
(defun fn2-trss-await-sealed (fuel accepted clients store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (let ((id (fn2-machine-kind-base *fn2-upload-kind* fn2-core)))
  (cond ((and (eq (fn2-upload-snapshot-read-code id fn2-core) :ok)
              (equal (fn2-upload-row-phase id fn2-core) *fn2-upload-state-sealed*))
         (mv :sealed accepted clients store fn2-core))
        ((zp fuel) (mv :fuel accepted clients store fn2-core))
        ((not (equal (fn2-core-stop-reason fn2-core) 0))
         (mv :stop accepted clients store fn2-core))
        (t (b* (((mv & & & & fn2-core) (fn2-turn fn2-core))
                 ((mv & accepted clients store fn2-core)
                  (fn2-cw-adapter-one accepted clients store fn2-core)))
             (fn2-trss-await-sealed (- fuel 1) accepted clients store fn2-core))))))
(defun fn2-trss-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-uslt-profile* :echo nil fn2-core))
      ((mv epoch fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      (source (fn2-cw-crlf-octets *fn2-uslt-source*))
      (post (fn2-cw-crlf-octets (append '("POST") *fn2-uslt-source* '("." "QUIT"))))
      ((mv source-cut accepted clients store fn2-core)
       (fn2-uslt-await 200000 :source 0 (fn2-cw-clients (list (list post (list (len post))))) nil fn2-core))
      ((mv premature & & &) (fn2-txn-source-digest-ref 0 fn2-core))
      ((mv sealed & & & fn2-core)
       (fn2-trss-await-sealed 200000 accepted clients store fn2-core))
      ((mv code slot gen off) (fn2-txn-source-digest-ref 0 fn2-core))
      (id (fn2-machine-kind-base *fn2-upload-kind* fn2-core))
      (ugen (fn2-machine-generation id fn2-core))
      (original (fn2-uslt-read 32 slot gen off id ugen fn2-core))
      (txid (fn2-machine-kind-base *fn2-txn-kind* fn2-core))
      (old-link-gen (fn2-txn-row-upload-gen txid fn2-core))
      (valid (and (eq sealed :sealed) (eq code :ok)
                  (eq (fn2-upload-snapshot-read-code id fn2-core) :ok)
                  (= ugen old-link-gen)
                  (= (fn2-upload-row-lease id fn2-core) *fn2-upload-lease-held*)
                  (= (fn2-upload-row-word id fn2-core) 0)
                  (= (fn2-upload-row-stored-hashed id fn2-core)
                     (+ (fn2-upload-row-ilen id fn2-core)
                        (fn2-upload-row-hashed id fn2-core)))))
      ;; Remove only the generation match from the otherwise real sealed row.
      (fn2-core (fn2-txn-put-core txid (upload-gen (+ 1 old-link-gen)) fn2-core))
      ((mv stale & & &) (fn2-txn-source-digest-ref 0 fn2-core)))
  (mv (and (eq epoch :ok) (eq source-cut :cut) (eq premature :bounds)
           valid (eq stale :bounds)
           (= (fn2-txn-row-upload-gen txid fn2-core) (+ 1 old-link-gen))
           (= (fn2-machine-generation id fn2-core) ugen)
           (= (fn2-upload-row-lease id fn2-core) *fn2-upload-lease-held*)
           (= (fn2-upload-row-word id fn2-core) 0)
           (= slot (fn2-upload-row-lslot id fn2-core))
           (= gen (fn2-upload-row-lgen id fn2-core))
           (= off *fn2-upload-page-source*)
           (equal original (fn-blake3 source))
           (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core)))
      fn2-core)))
(assert-event
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-trss-body fn2-core) ok)))

; Source fixture; execution requires the composed qualified world. This tests
; the real fixed-slot codec/reader, not a second allocator recovery model.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "c-snapshot-unit")
(include-book "../books/checkpoint-restore")
(include-book "../books/checkpoint-map-pack")

(defun fn2-cru-entry (state slot gen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* ((base 256) (off *fn2-checkpoint-map-entries-start*)
      ((mv prefix fn2-pool) (fn2-checkpoint-map-zero *fn2-checkpoint-map-entries-start* 0 slot gen 7 0 1 fn2-pool))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-extent*) 0 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-state*) state fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-owner-kind*) 9 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-owner*) 777 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-writer-epoch*) 4 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-allocation*) 31 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-retirement-commit*) 23 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-next-retired*) *fn2-alloc-none* fn2-fields))
      ((mv packed end fn2-pool) (fn2-format-allocation-map-entry-encode base slot gen off 7 0 1 fn2-fields fn2-pool))
      ((mv padded fn2-pool) (fn2-checkpoint-map-zero (- (+ off *fn2-checkpoint-map-entry-width*) end) end slot gen 7 0 1 fn2-pool))
      ((mv decoded fn2-fields) (fn2-checkpoint-restore-entry 2 0 base slot gen 7 0 1 fn2-fields fn2-pool))
      (exact (and (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-state*) fn2-fields) state)
                  (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-owner-kind*) fn2-fields) 9)
                  (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-owner*) fn2-fields) 777)
                  (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-writer-epoch*) fn2-fields) 4)
                  (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-allocation*) fn2-fields) 31)
                  (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-retirement-commit*) fn2-fields) 23)
                  (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-next-retired*) fn2-fields) *fn2-alloc-none*)))
      ; A different page ordinal must not accept the same encoded extent0.
      ((mv wrong fn2-fields) (fn2-checkpoint-restore-entry 2 *fn2-checkpoint-map-slots* base slot gen 7 0 1 fn2-fields fn2-pool))
      ; Change an actual padding byte after decoding once successfully.
      ((mv changed fn2-pool) (fn2-pool-write slot gen end 173 7 0 1 fn2-pool))
      ((mv corrupt fn2-fields) (fn2-checkpoint-restore-entry 2 0 base slot gen 7 0 1 fn2-fields fn2-pool)))
  (mv (and (eq prefix :ok) (eq packed :ok) (eq padded :ok) (eq decoded :entry) exact
           (eq wrong :identity) (< end (+ off *fn2-checkpoint-map-entry-width*))
           (eq changed :ok) (eq corrupt :padding)) fn2-fields fn2-pool)))

(defun fn2-cru-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-csu-profile* fn2-core))
      ((mv reserved slot gen fn2-core) (fn2-core-reserve 3 7 0 1 fn2-core))
      ((mv free reserved-state allocated retired fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
        (a b c d fn2-fields fn2-pool)
        (b* (((mv a fn2-fields fn2-pool) (fn2-cru-entry 0 slot gen fn2-fields fn2-pool))
             ((mv b fn2-fields fn2-pool) (fn2-cru-entry 1 slot gen fn2-fields fn2-pool))
             ((mv c fn2-fields fn2-pool) (fn2-cru-entry 2 slot gen fn2-fields fn2-pool))
             ((mv d fn2-fields fn2-pool) (fn2-cru-entry 3 slot gen fn2-fields fn2-pool)))
         (mv a b c d fn2-fields fn2-pool))
        (mv a b c d fn2-core))))
  (mv (and (eq reserved :ok) free reserved-state allocated retired) fn2-core)))
(defun fn2-cru-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core) (fn2-cru-body fn2-core) answer)))
(assert-event (fn2-cru-test))

; Admission must account for every physical anchor even if a profile requests
; fewer active publication candidates. Failure precedes window acquisition.
(defun fn2-cru-small-profile ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core)
   (b* ((profile (put-assoc-equal :checkpoint-candidates 3 (fn2-image-profile *fn2-csu-profile*)))
        (fn2-core (fn2-core-init profile fn2-core))
        (id (fn2-machine-kind-base *fn2-boot-kind* fn2-core))
        ((mv code fn2-core) (fn2-boot-start nil 33554432 fn2-core)))
    (mv (and (eq code :geometry)
             (equal (fn2-machine-phase id fn2-core) *fn2-boot-state-free*)) fn2-core))
   answer)))
(assert-event (fn2-cru-small-profile))

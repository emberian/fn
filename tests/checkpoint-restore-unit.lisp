; Source fixture; execution requires the composed qualified world. This tests
; the real fixed-slot codec/reader, not a second allocator recovery model.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "c-snapshot-unit")
(include-book "../books/checkpoint-restore")
(include-book "../books/checkpoint-restore-map")
(include-book "../books/checkpoint-map-pack")

(defun fn2-cru-entry (state slot gen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* ((base 256) (off *fn2-checkpoint-map-entries-start*)
      (expected (case state
        (0 '(0 0 0 0 0)) (1 '(0 0 4 31 0))
        (2 '(9 777 4 31 0)) (otherwise '(9 777 4 31 23))))
      ((mv prefix fn2-pool) (fn2-checkpoint-map-zero *fn2-checkpoint-map-entries-start* 0 slot gen 7 0 1 fn2-pool))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-extent*) 0 fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-state*) state fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-owner-kind*) (nth 0 expected) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-owner*) (nth 1 expected) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-writer-epoch*) (nth 2 expected) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-allocation*) (nth 3 expected) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-retirement-commit*) (nth 4 expected) fn2-fields))
      (fn2-fields (fn2-fields-set-value (+ base *fn2-format-allocation-map-entry-field-next-retired*) *fn2-alloc-none* fn2-fields))
      ((mv packed end fn2-pool) (fn2-format-allocation-map-entry-encode base slot gen off 7 0 1 fn2-fields fn2-pool))
      ((mv padded fn2-pool) (fn2-checkpoint-map-zero (- (+ off *fn2-checkpoint-map-entry-width*) end) end slot gen 7 0 1 fn2-pool))
      ((mv decoded fn2-fields) (fn2-checkpoint-restore-entry 2 0 base slot gen 7 0 1 fn2-fields fn2-pool))
      (exact (and (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-state*) fn2-fields) state)
                  (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-owner-kind*) fn2-fields) (nth 0 expected))
                  (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-owner*) fn2-fields) (nth 1 expected))
                  (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-writer-epoch*) fn2-fields) (nth 2 expected))
                  (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-allocation*) fn2-fields) (nth 3 expected))
                  (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-retirement-commit*) fn2-fields) (nth 4 expected))
                  (equal (fn2-fields-value (+ base *fn2-format-allocation-map-entry-field-next-retired*) fn2-fields) *fn2-alloc-none*)))
      ; A different page ordinal must not accept the same encoded extent0.
      ((mv wrong fn2-fields) (fn2-checkpoint-restore-entry 2 *fn2-checkpoint-map-slots* base slot gen 7 0 1 fn2-fields fn2-pool))
      ; Change an actual padding byte after decoding once successfully.
      ((mv changed fn2-pool) (fn2-pool-write slot gen end 173 7 0 1 fn2-pool))
      ((mv corrupt fn2-fields) (fn2-checkpoint-restore-entry 2 0 base slot gen 7 0 1 fn2-fields fn2-pool)))
  (mv (and (eq prefix :ok) (eq packed :ok) (eq padded :ok) (eq decoded :entry) exact
           (eq wrong :identity) (< end (+ off *fn2-checkpoint-map-entry-width*))
           (eq changed :ok) (eq corrupt :padding)) fn2-fields fn2-pool)))

(defun fn2-cru-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-csu-profile* fn2-core))
      ((mv reserved slot gen fn2-core) (fn2-core-reserve 3 7 0 1 fn2-core))
      ((mv free reserved-state allocated retired fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
        (a b c d fn2-fields fn2-pool)
        (b* (((mv a fn2-fields fn2-pool) (fn2-cru-entry 0 slot gen fn2-fields fn2-pool))
             ((mv b fn2-fields fn2-pool) (fn2-cru-entry 1 slot gen fn2-fields fn2-pool))
             ((mv c fn2-fields fn2-pool) (fn2-cru-entry 2 slot gen fn2-fields fn2-pool))
             ((mv d fn2-fields fn2-pool) (fn2-cru-entry 3 slot gen fn2-fields fn2-pool)))
         (mv a b c d fn2-fields fn2-pool))
        (mv a b c d fn2-core))))
  (mv (and (eq reserved :ok) free reserved-state allocated retired) fn2-core)))
(defun fn2-cru-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core) (fn2-cru-body fn2-core) answer)))
(assert-event (fn2-cru-test))

; Admission must account for every physical anchor even if a profile requests
; fewer active publication candidates. Failure precedes window acquisition.
(defun fn2-cru-small-profile ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core)
   (b* ((profile (put-assoc-equal :checkpoint-candidates 3 (fn2-image-profile *fn2-csu-profile*)))
        (fn2-core (fn2-core-init profile fn2-core))
        (id (fn2-machine-kind-base *fn2-boot-kind* fn2-core))
        ((mv code fn2-core) (fn2-boot-start nil 33554432 fn2-core)))
    (mv (and (eq code :geometry)
             (equal (fn2-machine-phase id fn2-core) *fn2-boot-state-free*)) fn2-core))
   answer)))
(assert-event (fn2-cru-small-profile))

; The following controls assume a synthetic authenticated-reader header/phase.
; They do NOT witness the page checker or persisted boot origin. Every ledger
; row is nevertheless produced by the actual wire encoder→reader→map consume;
; no test sets map completion or writes a ledger row directly.
(defun fn2-cru-map-pack (e mode slot gen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* ((state (cond ((equal e 1) 1) ((equal e 2) 2) ((member-equal e '(3 4)) 3) (t 0)))
      (off (+ *fn2-checkpoint-map-entries-start* (* e *fn2-checkpoint-map-entry-width*)))
      (retirement (cond ((equal e 3) 10) ((equal e 4) (if (eq mode :nonmonotone) 9 11)) (t 0)))
      (next (cond ((equal e 3) (if (eq mode :short) *fn2-alloc-none* 4))
                  ((and (equal e 4) (eq mode :cycle)) 3) (t *fn2-alloc-none*)))
      (fn2-fields (fn2-fields-set-value *fn2-format-allocation-map-entry-field-extent* e fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-allocation-map-entry-field-state* state fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-allocation-map-entry-field-owner-kind* (if (< state 2) 0 9) fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-allocation-map-entry-field-owner* (if (< state 2) 0 777) fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-allocation-map-entry-field-writer-epoch* (if (equal state 0) 0 4) fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-allocation-map-entry-field-allocation* (if (equal state 0) 0 (+ 30 e)) fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-allocation-map-entry-field-retirement-commit* retirement fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-allocation-map-entry-field-next-retired* next fn2-fields))
      ((mv code end fn2-pool) (fn2-format-allocation-map-entry-encode 0 slot gen off 7 0 1 fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields fn2-pool))
      ((mv code fn2-pool) (fn2-checkpoint-map-zero (- (+ off *fn2-checkpoint-map-entry-width*) end) end slot gen 7 0 1 fn2-pool)))
  (mv code fn2-fields fn2-pool)))
(defun fn2-cru-map-pack-all (e mode slot gen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil :measure (nfix (- 6 (nfix e)))))
 (if (or (not (natp e)) (>= e 6)) (mv :ok fn2-fields fn2-pool)
  (mv-let (code fn2-fields fn2-pool) (fn2-cru-map-pack e mode slot gen fn2-fields fn2-pool)
   (if (not (eq code :ok)) (mv code fn2-fields fn2-pool)
    (fn2-cru-map-pack-all (+ e 1) mode slot gen fn2-fields fn2-pool)))))
(defun fn2-cru-map-fingerprint (e fn2-checkpoint-restore-map)
 (declare (xargs :stobjs fn2-checkpoint-restore-map :verify-guards nil :measure (nfix (- 6 (nfix e)))))
 (if (or (not (natp e)) (>= e 6)) nil
  (cons (list (fn2-checkpoint-restore-map-present e fn2-checkpoint-restore-map)
              (fn2-checkpoint-restore-map-state e fn2-checkpoint-restore-map)
              (fn2-checkpoint-restore-map-owner-kind e fn2-checkpoint-restore-map)
              (fn2-checkpoint-restore-map-owner e fn2-checkpoint-restore-map)
              (fn2-checkpoint-restore-map-epoch e fn2-checkpoint-restore-map)
              (fn2-checkpoint-restore-map-allocation e fn2-checkpoint-restore-map)
              (fn2-checkpoint-restore-map-retirement e fn2-checkpoint-restore-map)
              (fn2-checkpoint-restore-map-next-retired e fn2-checkpoint-restore-map)
              (fn2-checkpoint-restore-map-visited e fn2-checkpoint-restore-map))
        (fn2-cru-map-fingerprint (+ e 1) fn2-checkpoint-restore-map))))
(defun fn2-cru-map-collect (n fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool) :verify-guards nil :measure (nfix n)))
 (if (zp n) (mv :ok fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields)
  (mv-let (code fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields)
   (fn2-checkpoint-restore-map-consume fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool)
   (if (not (eq code :entry)) (mv code fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields)
    (fn2-cru-map-collect (- n 1) fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool)))))
(defun fn2-cru-map-padding (fuel fn2-checkpoint-restore-reader fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-restore-reader fn2-pool) :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-checkpoint-restore-reader)
  (mv-let (code fn2-checkpoint-restore-reader) (fn2-checkpoint-restore-reader-padding-step fn2-checkpoint-restore-reader fn2-pool)
   (if (eq code :more) (fn2-cru-map-padding (- fuel 1) fn2-checkpoint-restore-reader fn2-pool)
    (mv code fn2-checkpoint-restore-reader)))))
(defun fn2-cru-map-fifo (fuel fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control)
 (declare (xargs :stobjs (fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control) :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control)
  (mv-let (code fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control)
   (fn2-checkpoint-restore-map-check fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control)
   (if (eq code :more) (fn2-cru-map-fifo (- fuel 1) fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control)
    (mv code fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control)))))

(defun fn2-cru-map-body (mode fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-checkpoint-restore-reader (fn2-checkpoint-restore-reader-init 1 fn2-checkpoint-restore-reader))
      (fn2-checkpoint-restore-map (fn2-checkpoint-restore-map-init 6 fn2-checkpoint-restore-map))
      (fn2-checkpoint-restore-map-control (fn2-checkpoint-restore-map-control-init 1 fn2-checkpoint-restore-map-control))
      (fn2-fields (fn2-fields-init 64 fn2-fields)) (fn2-pool (fn2-pool-init '((1 . 65536)) 1 100 fn2-pool))
      ((mv reserved slot gen fn2-pool) (fn2-pool-reserve 0 7 0 1 fn2-pool))
      ((mv zeroed fn2-pool) (fn2-run-zero 65536 slot gen 0 7 0 1 fn2-pool))
      ((mv packed fn2-fields fn2-pool) (fn2-cru-map-pack-all 0 mode slot gen fn2-fields fn2-pool))
      (fn2-checkpoint-restore-reader (fn2-checkpoint-restore-reader-put 0
        (phase *fn2-checkpoint-restore-reader-phase-entries*) (candidate 0) (role 2) (ordinal 0) (entry-ordinal 0)
        (total 6) (total-known 1) (first 0) (count 6) (retired-head 3) (retired-count 2)
        (padding (+ *fn2-checkpoint-map-entries-start* (* 6 *fn2-checkpoint-map-entry-width*)))
        (slot slot) (gen gen) (owner-kind 7) (owner-slot 0) (owner-gen 1) (field-base 0) (has-next 0)))
      ((mv first fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields)
       (fn2-checkpoint-restore-map-consume fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool))
      (before (fn2-cru-map-fingerprint 0 fn2-checkpoint-restore-map))
      (fn2-checkpoint-restore-reader (fn2-checkpoint-restore-reader-set-candidate 0 1 fn2-checkpoint-restore-reader))
      ((mv stale fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields)
       (fn2-checkpoint-restore-map-consume fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool))
      (stale-frame (and (equal before (fn2-cru-map-fingerprint 0 fn2-checkpoint-restore-map))
                        (equal (fn2-checkpoint-restore-reader-entry-ordinal 0 fn2-checkpoint-restore-reader) 1)
                        (equal (fn2-checkpoint-restore-map-control-cursor 0 fn2-checkpoint-restore-map-control) 1)))
      (fn2-checkpoint-restore-reader (fn2-checkpoint-restore-reader-put 0 (candidate 0) (entry-ordinal 2)))
      ((mv skipped fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields)
       (fn2-checkpoint-restore-map-consume fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool))
      (skip-frame (and (equal before (fn2-cru-map-fingerprint 0 fn2-checkpoint-restore-map))
                       (equal (fn2-checkpoint-restore-reader-entry-ordinal 0 fn2-checkpoint-restore-reader) 2)
                       (equal (fn2-checkpoint-restore-map-control-cursor 0 fn2-checkpoint-restore-map-control) 1)))
      ((mv early fn2-checkpoint-restore-map-control) (fn2-checkpoint-restore-map-finish fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control))
      (fn2-checkpoint-restore-reader (fn2-checkpoint-restore-reader-set-entry-ordinal 0 1 fn2-checkpoint-restore-reader))
      ((mv collected fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields)
       (fn2-cru-map-collect 5 fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool))
      ((mv not-terminal fn2-checkpoint-restore-map-control) (fn2-checkpoint-restore-map-finish fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control))
      ((mv padded fn2-checkpoint-restore-reader) (fn2-cru-map-padding 18 fn2-checkpoint-restore-reader fn2-pool))
      ((mv terminal fn2-checkpoint-restore-reader fn2-pool) (fn2-checkpoint-restore-reader-next-page fn2-checkpoint-restore-reader fn2-pool))
      ((mv finished fn2-checkpoint-restore-map-control) (fn2-checkpoint-restore-map-finish fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control))
      ((mv checked fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control) (fn2-cru-map-fifo 8 fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control)))
  (mv (and (eq reserved :ok) (eq zeroed :ok) (eq packed :ok) (eq first :entry)
           (eq stale :coverage) stale-frame (eq skipped :coverage) skip-frame (eq early :coverage)
           (eq collected :ok) (eq not-terminal :coverage) (eq padded :page-end) (eq terminal :done) (eq finished :map-ready)
           (equal (fn2-checkpoint-restore-map-state 0 fn2-checkpoint-restore-map) 0)
           (equal (fn2-checkpoint-restore-map-state 1 fn2-checkpoint-restore-map) 1)
           (equal (fn2-checkpoint-restore-map-owner 1 fn2-checkpoint-restore-map) 0)
           (equal (fn2-checkpoint-restore-map-epoch 1 fn2-checkpoint-restore-map) 4)
           (equal (fn2-checkpoint-restore-map-state 2 fn2-checkpoint-restore-map) 2)
           (equal (fn2-checkpoint-restore-map-owner 2 fn2-checkpoint-restore-map) 777)
           (equal (fn2-checkpoint-restore-map-state 3 fn2-checkpoint-restore-map) 3)
           (eq checked (if mode :chain :fifo-ready)))
      fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool)))
(defun fn2-cru-map-test (mode)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool)
  (fn2-cru-map-body mode fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool)))
(assert-event (fn2-cru-map-test nil))
(assert-event (fn2-cru-map-test :cycle))
(assert-event (fn2-cru-map-test :nonmonotone))
(assert-event (fn2-cru-map-test :short))

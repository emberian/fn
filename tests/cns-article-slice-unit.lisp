; Accepted actor-input controls around actual admitted rows and writer-created
; runs. Request metadata is constructed explicitly; this is not an authenticated
; client or ordinary-sealer ancestry witness. XL raw interference is excluded.
(in-package "ACL2")
(include-book "../books/assembly")
(include-book "cns-tall-runs-support")
(include-book "core-snapshot-support")
(defun fn2-cas-setup (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (put-assoc-equal :p 8 *fn2-cns-tall-profile*))
      (supported (fn2-core-profilep profile))
      (fn2-core (fn2-core-init profile fn2-core))
      ((mv built fn2-core) (fn2-cns-tall-runs-fixture fn2-core))
      ((mv taken id gen fn2-core)
       (fn2-machine-take-fn2-cns *fn2-none* *fn2-none* 0 1 0 0 4 *fn2-none* 0 fn2-core))
      ((mv mapped x) (fn2-cns-read-row id fn2-core))
      ((unless (and supported (eq built :ok) (eq taken :ok) (eq mapped :ok)))
       (mv nil id gen x fn2-core))
      ; No extra untracked pool loan: output-drop controls use this admitted
      ; actor's real workspace as a frame range and never send its contents.
      (slot (fn2-cns-row-ws-slot id fn2-core)) (sgen (fn2-cns-row-ws-gen id fn2-core))
      (fn2-core (fn2-cns-put-core id (phase *fn2-cns-state-page*) (xrow x)
                  (principal-slot 7) (ipos 99) (pub-frontier 101) (page-limit 1)
                  (verb *fn2-cns-verb-read*) (outcome *fn2-cns-outcome-accepted*)
                  (tx-slot slot) (tx-gen sgen) (ctl 0))))
  (mv t id gen x fn2-core)))
(defun fn2-cas-to-phase (fuel id phase fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond ((equal (fn2-cns-row-phase id fn2-core) phase) (mv t fn2-core))
       ((or (zp fuel) (fn2-core-stopped-p fn2-core)) (mv nil fn2-core))
       (t (mv-let (b s d runnable fn2-core) (fn2-cns-run id 4 fn2-core)
            (declare (ignore b s d runnable))
            (fn2-cas-to-phase (1- fuel) id phase fn2-core)))))
(defun fn2-cas-read-heldp (id gen x fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-reads (fn2-core-reads fn2-core))
             (fn2-succ-txns (fn2-core-succ-txns fn2-core))
             (fn2-id-decides (fn2-core-id-decides fn2-core))) (yes)
  (and (equal (fn2-reads-op x fn2-reads) *fn2-read-op-lookup*)
       (equal (fn2-reads-sid x fn2-reads) *fn2-article-sid*)
       (fn2-cns-range-ownerp x id gen fn2-reads)
       (not (equal (fn2-succ-txns-lphase (+ (fn2-id-decides-rows fn2-id-decides) x) fn2-succ-txns)
                   *fn2-succ-lookup-idle*))) yes))
(defun fn2-cas-read-idlep (x fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-reads (fn2-core-reads fn2-core))
             (fn2-succ-txns (fn2-core-succ-txns fn2-core))
             (fn2-id-decides (fn2-core-id-decides fn2-core))) (yes)
  (and (equal (fn2-reads-op x fn2-reads) *fn2-read-op-idle*)
       (equal (fn2-reads-qset x fn2-reads) 0)
       (equal (fn2-succ-txns-lphase (+ (fn2-id-decides-rows fn2-id-decides) x) fn2-succ-txns)
              *fn2-succ-lookup-idle*)) yes))
(defun fn2-cas-negative-call (mode id gen x fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((before (fn2-test-core-snapshot fn2-core)))
  (mv-let (code p a st ty by u e al fn2-core)
   (fn2-cns-article-next
    (if (eq mode :principal) 6 7) (if (eq mode :position) 98 99) (if (eq mode :frontier) 102 101)
    (if (eq mode :length) 1 (fn2-cns-row-ilen id fn2-core)) (if (eq mode :fetch) 1 0)
    (if (eq mode :tx-slot) *fn2-none* (fn2-cns-row-tx-slot id fn2-core)) x
    (if (eq mode :held) t nil)
    (if (eq mode :lease-slot) 0 (fn2-cns-row-lslot id fn2-core))
    (if (eq mode :lease-gen) 1 (fn2-cns-row-lgen id fn2-core))
    *fn2-cns-kind* id (if (eq mode :generation) (1+ gen) gen) fn2-core)
   (declare (ignore p a st ty by u e al))
   (mv (and (eq code :fault) (equal before (fn2-test-core-snapshot fn2-core))) fn2-core))))
(defun fn2-cas-body (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv setup id gen x fn2-core) (fn2-cas-setup fn2-core))
      ((unless setup) (mv nil fn2-core))
      ((mv selected fn2-core) (fn2-cas-to-phase 300 id *fn2-cns-state-article* fn2-core))
      (selection (and selected (equal (fn2-cns-row-npos id fn2-core) 100)
                      (equal (fn2-cns-row-art id fn2-core) 1000)
                      (equal (fn2-cns-row-istream id fn2-core) 3)
                      (equal (fn2-cns-row-ipos id fn2-core) 99)
                      (equal (fn2-cns-row-count id fn2-core) 0)
                      (fn2-cas-read-idlep x fn2-core)))
      ; Zero is an admitted u60 primary key. This separate direct-API
      ; control changes request input before claiming XL, not while held.
      (fn2-core (cond ((eq mode :zero) (fn2-cns-put-core id (art 0)))
                      ; Make PF agree even for the offered wrong FETCH mode,
                      ; so rejection depends on the actual verb binding.
                      ((eq mode :fetch) (fn2-cns-put-core id (to 101)))
                      (t fn2-core)))
      ((mv b s d runnable fn2-core) (fn2-cns-run id 4 fn2-core))
      (yielded (and selection (equal b *fn2-cns-article-next-pool-work-bound*)
                    (equal s *fn2-work-transition*) (equal d 0) runnable
                    (equal (fn2-cns-row-phase id fn2-core) *fn2-cns-state-article*)
                    (equal (fn2-cns-row-more id fn2-core) 0)
                    (equal (fn2-cns-row-npos id fn2-core) 100)
                    (equal (fn2-cns-row-art id fn2-core) (if (eq mode :zero) 0 1000))
                    (fn2-cas-read-heldp id gen x fn2-core)))
      ((unless yielded) (mv nil fn2-core)))
  (cond
   ((member-eq mode '(:complete :zero))
    (b* (((mv item fn2-core) (fn2-cas-to-phase 16 id *fn2-cns-state-item* fn2-core))
         (lslot (fn2-cns-row-lslot id fn2-core)) (lgen (fn2-cns-row-lgen id fn2-core))
         (item-boundary (and item (fn2-cas-read-idlep x fn2-core)
                             (equal (fn2-cns-row-ipos id fn2-core) 99)
                             (equal (fn2-cns-row-count id fn2-core) 0)
                             (equal (fn2-cns-row-itype id fn2-core) *fn2-fnct-item-gap*)
                             (equal (fn2-cns-row-lease id fn2-core) *fn2-cns-lease-held*)))
         ; The ordinary ITEM output call reports dropped for the absent CTL;
         ; it runs on this later turn, then its real pool loan is returned.
         ((mv & & & & fn2-core) (fn2-cns-run id 4 fn2-core))
         (output-later (and (equal (fn2-cns-row-phase id fn2-core) *fn2-cns-state-page*)
                            (equal (fn2-cns-row-ctl id fn2-core) *fn2-none*)))
         ((mv drained fn2-core) (fn2-cas-to-phase 4 id *fn2-cns-state-draining* fn2-core))
         ((mv write fn2-core) (fn2-core-write lslot lgen 0 1 *fn2-cns-kind* id gen fn2-core)))
     (mv (and item-boundary output-later drained (not (eq write :ok))
              (equal (fn2-cns-row-lease id fn2-core) *fn2-cns-lease-none*)
              (not (fn2-core-stopped-p fn2-core))) fn2-core)))
   ((member-eq mode '(:cancel :refuse :reuse))
    (b* ((fn2-core (if (eq mode :refuse) (fn2-cns-put-core id (outcome *fn2-cns-outcome-refused*))
                    (fn2-cns-put-core id (ctl *fn2-none*))))
         ((mv drained fn2-core) (fn2-cas-to-phase 4 id *fn2-cns-state-draining* fn2-core))
         (released (and drained (fn2-cas-read-idlep x fn2-core) (not (fn2-core-stopped-p fn2-core)))))
     (if (not (eq mode :reuse)) (mv released fn2-core)
      (b* (((mv freed fn2-core) (fn2-cas-to-phase 4 id *fn2-cns-state-free* fn2-core))
           ((mv take2 id2 gen2 fn2-core)
            (fn2-machine-take-fn2-cns *fn2-none* *fn2-none* 0 2 0 0 4 *fn2-none* 0 fn2-core))
           (before (fn2-test-core-snapshot fn2-core))
           ((mv code & & & & & & & & fn2-core)
            (fn2-cns-article-next 7 99 101 0 0 *fn2-none* x nil *fn2-none* 0 *fn2-cns-kind* id gen fn2-core)))
       (mv (and released freed (eq take2 :ok) (equal id2 id) (> gen2 gen)
                (eq code :fault) (equal before (fn2-test-core-snapshot fn2-core))) fn2-core)))))
   ((eq mode :key)
    (let* ((fn2-core
            (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-reads (fn2-core-reads fn2-core))
                        (fn2-id-decides (fn2-core-id-decides fn2-core)) (fn2-fc (fn2-core-fc fn2-core))) (fn2-fields)
             (mv-let (code base) (fn2-read-stripe x (fn2-fc-rows fn2-fc) fn2-reads fn2-id-decides fn2-fields)
              (if (eq code :ok)
                  (fn2-fields-set-value (+ base *fn2-read-lo* *fn2-article-entry-field-article*) 1001 fn2-fields)
                fn2-fields)) fn2-core))
           (before (fn2-test-core-snapshot fn2-core)))
     (mv-let (code fn2-core) (fn2-cns-article-ready 1000 x id gen fn2-core)
      (mv (and (eq code :state) (equal before (fn2-test-core-snapshot fn2-core))) fn2-core))))
   (t (fn2-cas-negative-call mode id gen x fn2-core)))))
(defun fn2-cns-article-slice-control (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (yes fn2-core) (fn2-cas-body mode fn2-core) yes)))
(assert-event (and (fn2-cns-article-slice-control :complete)
                   (fn2-cns-article-slice-control :zero)
                   (fn2-cns-article-slice-control :cancel)
                   (fn2-cns-article-slice-control :refuse)
                   (fn2-cns-article-slice-control :reuse)
                   (fn2-cns-article-slice-control :key)))
(assert-event (and (fn2-cns-article-slice-control :generation)
                   (fn2-cns-article-slice-control :principal)
                   (fn2-cns-article-slice-control :position)
                   (fn2-cns-article-slice-control :frontier)
                   (fn2-cns-article-slice-control :length)
                   (fn2-cns-article-slice-control :fetch)
                   (fn2-cns-article-slice-control :tx-slot)
                   (fn2-cns-article-slice-control :held)
                   (fn2-cns-article-slice-control :lease-slot)
                   (fn2-cns-article-slice-control :lease-gen)))

(defparameter *fn2-cns-right-consume* 0)
(defparameter *fn2-cns-scope-stream* 1)
(defparameter *fn2-cns-scope-own-consumers* 0)
(loop for field in '(member-stream member-first member-count member-phase member-ordinal member-head
                      xstep xhead xgrant xrow art)
      for key = (intern (symbol-name field) "KEYWORD")
      do (eval `(defun ,(intern (format nil "FN2-CNS-ROW-~a" field)) (id core)
                   (declare (ignore id)) (getf core ,key 0)))
         (eval `(defun ,(intern (format nil "FN2-MACHINE-WRITE-~a" field)) (id value core)
                   (declare (ignore id)) (list* ,key value core))))
(defun fn2-cns-read-contextp (id gen x core)
 (and (= id 5) (= gen 7) (= x 8) (= (getf core :art) 77)))
(defun fn2-read-release (x core) (assert (= x 8)) (mv :ok core))
(defparameter *member-rights* nil)
(defparameter *member-revision* 80)
(defparameter *member-consume* t)
(defparameter *member-attempts* nil)
(defun fn2-cns-authority-allows (id gen right scope target step head grant budget core)
 (declare (ignore step head grant))
 (assert (and (= id 5) (= gen 7) (= budget 4096)))
 (push (list right target) *member-attempts*)
 (let ((allowed (if (= right *fn2-cns-right-read*)
                    (and (= scope *fn2-cns-scope-stream*) (member target *member-rights*))
                  (and (= scope *fn2-cns-scope-own-consumers*) (= target 0) *member-consume*))))
  (mv (if allowed :ok :access) 0 *member-revision* 0 core)))
(defun fn2-cns-membership-lookup (article ordinal budget x step core)
 (assert (and (= article 77) (= ordinal 1) (= budget 4096) (= x 8)))
 (if (= step 0) (mv :more 0 core) (mv :ok 42 core)))
(dolist (name '(fn2-cns-membership-reset fn2-cns-membership-allows))
 (with-open-file (in "books/cns.lisp")
  (loop for form = (read in nil :end) until (eq form :end)
        for def = (source-find-defun name form) when def do (eval def))))
(defparameter *member-core* '(:xrow 8 :art 77 :member-count 1 :member-first 41 :member-stream 41))
(defun complete-membership (core handoff)
 (loop repeat 16
       do (multiple-value-bind (code stream head next) (fn2-cns-membership-allows 5 7 handoff core)
            (setf core next)
            (unless (eq code :more) (return-from complete-membership (values code stream head)))))
 (error "Membership walk made no progress"))
(dolist (case '(((42) :ok 42 ((1 41) (1 42)))
               ((41) :ok 41 ((1 41)))
               (() :unavailable 0 ((1 41) (1 42)))
               ((41 42) :ok 41 ((1 41)))))
 (destructuring-bind (rights expected stream attempts) case
  (let ((*member-rights* rights) (*member-attempts* nil))
   (multiple-value-bind (code result head) (complete-membership *member-core* nil)
    (assert (and (eq code expected) (= stream result) (= head *member-revision*)))
    (assert (equal (reverse *member-attempts*) attempts))))))
;; The primary was readable when checked. Replace it with secondary READ at
;; the exact freeze step. A new authority head must retry and choose 42.
(let ((*member-rights* '(41)) (*member-attempts* nil))
 (multiple-value-bind (code stream head core) (fn2-cns-membership-allows 5 7 t *member-core*)
  (declare (ignore stream head))
  (assert (eq code :more))
  (let ((*member-revision* 81) (*member-rights* '(42)))
   (multiple-value-bind (code stream head) (complete-membership core t)
    (assert (and (eq code :ok) (= stream 42) (= head 81)))))
  (let ((*member-revision* 81) (*member-consume* nil))
   (assert (eq (complete-membership core t) :access)))))
(format t "CNS MEMBERSHIP SOURCE CONTROLS PASS: one choice per occurrence, hidden memberships, changed head and consume refusal~%")


(defparameter *fn2-ctl-state-stream-reply* 10)
(defparameter *fn2-ctl-state-closing* 11)
(defparameter *fn2-cns-source-phase-bad* 14)
(defun source-find-defun (name form)
 (cond ((atom form) nil)
       ((and (eq (car form) 'defun) (eq (second form) name)) form)
       (t (or (source-find-defun name (car form)) (source-find-defun name (cdr form))))))
(with-open-file (in "books/cns-source-core.lisp")
 (loop for f = (read in nil :end) until (eq f :end)
  for found = (source-find-defun 'fn2-cns-stream-source-abort f)
  when found do (eval found)))
(let* ((before '(:bound t :status :active :ctl-phase 10 :ordinary-wake 31))
       (after (fn2-cns-stream-source-abort 5 7 20 9 11 before)))
 (assert (= (getf after :ctl-phase) 11))
 (assert (= (getf after :queued) 20))
 (assert (= (getf after :recorded) 20))
 (assert (= (getf after :ordinary-wake) 31)))
(let ((before '(:bound nil :status :active :ctl-phase 10 :ordinary-wake 31)))
 (assert (equal before (fn2-cns-stream-source-abort 5 7 20 9 11 before))))
(format t "CNS ACTUAL ABORT SOURCE CONTROL PASS: parked CTL enqueued, ordinary wake preserved, stale whole-frame refusal~%")
; A pre-prefix refusal also creates a real HANDOFF receipt before the
; workspace is returned; a bare RELEASED phase cannot clear ownership.
(let ((*results* '((fn2-cns-stream-source-step :released)
                   (fn2-cns-stream-source-finish :ok))))
 (multiple-value-bind (effects vars) (run-source *source-arm* (acons 'row-stream 0 *source-vars*))
  (assert (= (cdr (assoc 'row-lease vars)) 1))
  (assert (member 'fn2-cns-stream-source-finish (source-calls effects)))
  (assert (not (member 'fn2-cns-lease-release (source-calls effects))))))
(format t "CNS PREHEADER ARM SOURCE CONTROL PASS: receipt before own workspace release~%")

; Exercise ITEM on both retained source states and the actual single-frame
; handoff on a currently authorized, suspended, or now-denied withdrawal.
(defparameter *handoff-vars*
 (append *source-vars* '((id . 5) (row-ctl-gen . 9) (row-verb . 8)
                         (*fn2-cns-verb-fetch* . 8)
                         (*fn2-cns-outcome-refused* . 2)
                         (*fn2-cns-reason-withdrawn* . 11)
                         (*fn2-cns-reason-unavailable* . 1))))
(let ((arm (cdddr (assoc :item (getf (cdddr *cns*) :arms)))))
 (dolist (bound '(nil t))
  (let ((*source-bound* bound))
   (multiple-value-bind (effects vars)
    (run-source arm (acons 'row-outcome 0 *handoff-vars*))
    (assert (not (assoc :issue effects)))
    (if bound
        (assert (member '(:next :source) effects :test #'equal))
        (progn
          (assert (member '(:goto page-fail) effects :test #'equal))
          (assert (= (cdr (assoc 'row-reason vars)) 1))
          (assert (= (cdr (assoc 'row-outcome vars)) 2))))))))
(let ((hand (cdddr (assoc 'hand (getf (cdddr *cns*) :subarms))))
      (authorize (cdddr (assoc :fetch-authorize (getf (cdddr *cns*) :arms))))
      (vars (append '((row-outcome . 2) (row-reason . 11) (row-lease . 0) (row-istream . 41) (*fn2-cns-reason-access* . 2)) *handoff-vars*)))
 (assert hand)
 (dolist (status '(:ok :more :access :unavailable :state))
  (let ((*results* `((fn2-cns-membership-allows ,status 41 8) (fn2-cns-post-reply :ok))))
   (multiple-value-bind (effects result) (run-source hand vars)
    (assert (equal (reverse (source-calls effects))
                   (if (eq status :more) '(fn2-cns-membership-allows)
                     '(fn2-cns-membership-allows fn2-cns-post-reply))))
    (if (eq status :more)
        (progn
          (assert (not (assoc :posted-reason effects)))
          (assert (= (cdr (assoc 'row-reason result)) 11))
          (assert (= (cdr (assoc 'row-verb result)) 8))
          (assert (= (cdr (assoc 'row-istream result)) 41))
          (assert (= (cdr (assoc 'row-outcome result)) 2))
          (assert (member '(:next :fetch-authorize) effects :test #'equal))
          (assert (member '(:goto hand) (run-source authorize result) :test #'equal)))
        (progn
          (assert (equal (assoc :posted-reason effects)
                         (list :posted-reason (case status (:ok 11) (:access 2) (otherwise 1)))))
          (assert (member '(:next :draining) effects :test #'equal)))))))
 ;; An existing access refusal posts directly without rechecking read rights.
 (let ((*results* '((fn2-cns-post-reply :ok))))
  (dolist (ordinary (list (acons 'row-reason 2 vars)
                          ;; APPEND's header-octets reason has the same code.
                          (acons 'row-verb 7 vars)))
   (let ((effects (run-source hand ordinary)))
    (assert (equal (source-calls effects) '(fn2-cns-post-reply)))
    (assert (equal (assoc :posted-reason effects)
                   (list :posted-reason (cdr (assoc 'row-reason ordinary)))))))))
(format t "CNS FETCH HANDOFF SOURCE CONTROLS PASS: source binding required, withdrawn checked before reply~%")

(defmacro mv-let (vars computation &body body)
 `(multiple-value-bind ,vars ,computation ,@body))
; Execute the real bounded choice and freeze code under explicit storage and
; authority observations. These controls do not certify the leaf callbacks.
(defmacro b* (bindings &body body)
 (if (endp bindings) `(progn ,@body)
   (destructuring-bind (pattern expression) (first bindings)
    (let ((tail `(b* ,(rest bindings) ,@body)))
      (cond ((symbolp pattern) `(let ((,pattern ,expression)) ,tail))
            ((eq (car pattern) 'mv) `(multiple-value-bind ,(cdr pattern) ,expression ,tail))
            ((eq (car pattern) 'when) `(if ,(second pattern) ,expression ,tail))
            ((eq (car pattern) 'unless) `(if ,(second pattern) ,tail ,expression))
            (t (error "Unsupported b* binding ~s" pattern)))))))
(defun posp (n) (and (integerp n) (< 0 n)))
(defun member-eq (x xs) (member x xs :test #'eq))
(defparameter *fn2-cns-member-read* 0)
(defparameter *fn2-cns-member-lookup* 1)
(defparameter *fn2-cns-member-consume* 2)
(defparameter *fn2-cns-member-consume-denied* 3)

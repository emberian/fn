; Execute the actual declarative CNS source arm with explicit leaf results.
; This refutes source control/order mistakes, not ACL2 guards or real I/O.
(load "tests/ctl-output-arm-controls.lsp")
(in-package "ACL2")
(defparameter *fn2-cns-source-unit-work-bytes* 16384)
(defparameter *fn2-cns-source-next-cost* 2048)
(defparameter *fn2-cns-lease-held* 1)
(defparameter *fn2-cns-lease-none* 0)
(defparameter *fn2-none* 4294967295)
(defparameter *fn2-work-transition* 1)
(defparameter *fn2-work-poll* 1)
(defparameter *fn2-work-state* 1)
(setf (symbol-function 'source-base-execute-steps) (symbol-function 'execute-steps))
(defun execute-steps (steps)
 (dolist (step steps)
  (case (car step)
   (:do
    (source-base-execute-steps (list step))
    (let* ((options (cdddr step)) (branches (getf options :case))
           (accepted (getf options :accept))
           (code (and (second step) (cdr (assoc (car (second step)) *vars*)))))
     (when (and branches (not (member code accepted :test #'equal)))
      (let ((clause (find-if (lambda (clause)
                      (or (eq (car clause) :otherwise)
                          (member code (car clause) :test #'equal))) branches)))
       (assert clause) (execute-steps (cdr clause))
       (throw 'source-route-terminal nil)))))
   (:case
    (let* ((value (expression (second step)))
           (clause (find-if (lambda (clause)
                     (or (eq (car clause) :otherwise)
                         (member value (car clause) :test #'equal))) (cddr step))))
     (assert clause) (execute-steps (cdr clause))))
   (:goto (push step *effects*))
   (otherwise (source-base-execute-steps (list step))))))
(defun run (steps vars)
 (let ((*vars* vars) (*effects* nil))
  (catch 'source-route-terminal (execute-steps steps))
  (values *effects* *vars*)))
(defparameter *cns*
 (with-open-file (in "books/cns.lisp")
  (loop for f = (read in nil :end) until (eq f :end)
        when (and (consp f) (eq (car f) 'defmachine-arms) (eq (second f) 'fn2-cns)) return f)))
(defparameter *source-arm* (cdddr (assoc :source (getf (cdddr *cns*) :arms))))
(defparameter *source-vars* '((row-stream . 1) (row-lease . 1) (row-ctl . 20)
                             (row-generation . 7) (row-request . 11)))
(defun source-calls (effects) (mapcar #'second (remove-if-not (lambda (e) (eq (car e) :call)) effects)))
; Transport/pending wait and uncertainty cannot read, emit a prefix, drop
; claims, or return the workspace. A stopped source retains its evidence.
(dolist (status '(:wait :uncertain :stale))
 (let ((*results* `((fn2-cns-stream-source-step ,status))))
  (multiple-value-bind (effects vars) (run *source-arm* *source-vars*)
   (dolist (entry *source-vars*) (assert (equal (cdr (assoc (car entry) vars)) (cdr entry))))
   (assert (equal (source-calls effects) '(fn2-cns-stream-source-step)))
   (assert (eq (not (null (assoc :stop effects))) (not (eq status :wait)))))))
; A read is a separate descriptor-bounded callback, not hidden inside STEP/NEXT.
(let ((*results* '((fn2-cns-stream-source-step :need-read)
                   (fn2-cns-stream-source-issue :ok 3 8))))
 (multiple-value-bind (effects vars) (run *source-arm* *source-vars*)
  (declare (ignore vars))
  (assert (equal (reverse (source-calls effects))
                 '(fn2-cns-stream-source-step fn2-cns-stream-source-issue)))
  (assert (= (getf (cdr (assoc :charge effects)) :descriptors) 1))))
; The producer's completed coverage result alone permits the MID/prefix gate.
; Refusal never changes STREAM to started, and routes through owned cleanup.
(let ((*results* '((fn2-cns-stream-source-step :covered)
                   (fn2-cns-stream-source-open :bad) (fn2-cns-stream-source-abort))))
 (multiple-value-bind (effects vars) (run *source-arm* (acons 'row-stream 0 *source-vars*))
  (assert (= (cdr (assoc 'row-stream vars)) 0))
  (assert (not (member 'fn2-cns-lease-release (source-calls effects))))))
; Ready data wakes output without issuing another read or freeing the source.
(let ((*results* '((fn2-cns-stream-source-step :ready))))
 (multiple-value-bind (effects vars) (run *source-arm* *source-vars*)
  (declare (ignore vars))
  (assert (= (count :wake-row effects :key #'car) 1))
  (assert (equal (source-calls effects) '(fn2-cns-stream-source-step)))))
; Normal final Send cleanup waits for CTL to acknowledge; even RELEASED
; cannot bypass the HANDOFF phase or free the actor's workspace.
(let ((*results* '((fn2-cns-stream-source-step :released)
                   (fn2-ctl-stream-reply-status :handback))))
 (multiple-value-bind (effects vars) (run *source-arm* *source-vars*)
  (assert (= (cdr (assoc 'row-lease vars)) 1))
  (assert (not (member 'fn2-cns-lease-release (source-calls effects))))))
; Closing is not cancellation permission. Only the checked terminal cancelled
; status permits acknowledgement; workspace release remains a later actor step.
(let ((*results* '((fn2-cns-stream-source-step :released)
                   (fn2-ctl-stream-reply-status :cancelled)
                   (fn2-cns-stream-source-finish :ok))))
 (multiple-value-bind (effects vars) (run *source-arm* *source-vars*)
  (assert (= (cdr (assoc 'row-lease vars)) 1))
  (assert (member 'fn2-cns-stream-source-finish (source-calls effects)))
  (assert (not (member 'fn2-cns-lease-release (source-calls effects))))))
; HANDOFF retains identity across the actual declared lease release. Clearing
; the source and entering draining occur on the next actor step, not before.
(let ((*results* '((fn2-cns-stream-source-step :handoff) (fn2-cns-lease-release :ok))))
 (multiple-value-bind (effects vars) (run *source-arm* *source-vars*)
  (assert (= (cdr (assoc 'row-lease vars)) 0))
  (assert (not (member 'fn2-cns-stream-source-clear (source-calls effects))))))
(let ((*results* '((fn2-cns-stream-source-step :handoff) (fn2-cns-stream-source-clear :ok))))
 (multiple-value-bind (effects vars) (run *source-arm* (acons 'row-lease 0 *source-vars*))
  (declare (ignore vars))
  (assert (member '(:next :draining) effects :test #'equal))
  (assert (not (member 'fn2-cns-post-reply (source-calls effects))))))
(format t "CNS ACTUAL SOURCE ARM CONTROLS PASS: bounded read, coverage gate, stop retention, final Send/cancel handoff~%")
; Execute the actual abort definition. A parked CTL must be scheduled here:
; relying on a caller's ordinary wake loses the issue-refusal branch.
(defmacro stobj-let (bindings names computation &body body)
 `(let ,bindings (multiple-value-bind ,names ,computation ,@body)))
(defun fn2-cns-source-boundp (cns cg ctl tg request core)
 (and (= cns 5) (= cg 7) (= ctl 20) (= tg 9) (= request 11) (getf core :bound)))
(defun fn2-machine-slot (id core) (declare (ignore id core)) 0)
(defun fn2-core-cns-sources (core) core)
(defun fn2-cns-sources-set-phase (s phase sources) (declare (ignore s)) (list* :source-phase phase sources))
(defun fn2-ctl-stream-reply-status (ctl tg request cns cg core)
 (declare (ignore ctl tg request cns cg)) (getf core :status))
(defun fn2-ctl-row-phase (ctl core) (declare (ignore ctl)) (getf core :ctl-phase))
(defun fn2-machine-write-phase (ctl phase core) (declare (ignore ctl)) (list* :ctl-phase phase core))
(defun fn2-core-scheduler-wake (ctl core) (list* :queued ctl core))
(defun fn2-core-record-enqueue (ctl core) (list* :recorded ctl core))
(defparameter *fn2-ctl-state-stream-reply* 10)
(defparameter *fn2-ctl-state-closing* 11)
(defparameter *fn2-cns-source-phase-bad* 14)
(defun source-find-defun (name form)
 (cond ((atom form) nil)
       ((and (eq (car form) 'defun) (eq (second form) name)) form)
       (t (or (source-find-defun name (car form)) (source-find-defun name (cdr form))))))
(with-open-file (in "books/cns-source-core.lisp")
 (loop for f = (read in nil :end) until (eq f :end)
  for found = (source-find-defun 'fn2-cns-stream-source-abort f)
  when found do (eval found)))
(let* ((before '(:bound t :status :active :ctl-phase 10 :ordinary-wake 31))
       (after (fn2-cns-stream-source-abort 5 7 20 9 11 before)))
 (assert (= (getf after :ctl-phase) 11))
 (assert (= (getf after :queued) 20))
 (assert (= (getf after :recorded) 20))
 (assert (= (getf after :ordinary-wake) 31)))
(let ((before '(:bound nil :status :active :ctl-phase 10 :ordinary-wake 31)))
 (assert (equal before (fn2-cns-stream-source-abort 5 7 20 9 11 before))))
(format t "CNS ACTUAL ABORT SOURCE CONTROL PASS: parked CTL enqueued, ordinary wake preserved, stale whole-frame refusal~%")
; A pre-prefix refusal also creates a real HANDOFF receipt before the
; workspace is returned; a bare RELEASED phase cannot clear ownership.
(let ((*results* '((fn2-cns-stream-source-step :released)
                   (fn2-cns-stream-source-finish :ok))))
 (multiple-value-bind (effects vars) (run *source-arm* (acons 'row-stream 0 *source-vars*))
  (assert (= (cdr (assoc 'row-lease vars)) 1))
  (assert (member 'fn2-cns-stream-source-finish (source-calls effects)))
  (assert (not (member 'fn2-cns-lease-release (source-calls effects))))))
(format t "CNS PREHEADER ARM SOURCE CONTROL PASS: receipt before own workspace release~%")

; The real DSL routes stale finish receipts to a terminal fault, never the
; continuation after an accepted OK/WAIT. Exercise that inline case here.
(let ((*results* '((fn2-cns-stream-source-step :released)
                   (fn2-ctl-stream-reply-status :cancelled)
                   (fn2-cns-stream-source-finish :stale))))
 (multiple-value-bind (effects vars) (run *source-arm* *source-vars*)
  (declare (ignore vars))
  (assert (member '(:stop :machine-phase) effects :test #'equal))
  (assert (not (assoc :charge effects)))))
(format t "CNS INLINE STATUS SOURCE CONTROL PASS: stale finish stops before continuation~%")

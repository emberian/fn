; Actual failed-open/rollback/close-debt/terminal-settlement composition.
; Physical calls are recorded; no live disk durability claim is inferred.
(load "tests/native_owner_install_cleanup_source.lisp")
(in-package "ACL2")
(declaim (declaration xargs))
(defvar *fnn-owner-retained-service* nil)
(defvar *fnn-owner-retained-settlement* :held)
(defvar *fnn-owner-reserving-thread* nil)
(defvar *fnn-owner-log-fd* nil)
(defvar *fnn-log-queue-mutex* (sb-thread:make-mutex))
(defvar *fnn-log-writer* nil)
(defun source-forms (path names)
  (with-open-file (input path)
    (loop for form = (read input nil :eof) until (eq form :eof)
          when (and (consp form) (eq (car form) 'defun) (member (second form) names))
          do (progn (eval form) (setf names (remove (second form) names)))
          finally (assert (null names)))))
(source-forms "books/owner-retire-settlement.lisp"
 '(fn-ort-store-close-action fn-ort-service-settlement-action fn-ort-service-claim-action))
(defun fnn-core (name &rest args) (apply name args))
(source-forms "host/native/owner.lisp"
 '(fnn-owner-retain-run-authority fnn-owner-claim-run-authority))
(source-forms (or (second sb-ext:*posix-argv*) "host/native/owner.lisp")
 '(fnn-owner-store-settlement))
(dolist (mode '(:pre-return-close-error :rollback-close-error :definite-rollback-close))
  (let* ((*startup-store* (make-fnn-store :lock-fd :lock))
         (*calls* nil)
         (*failures* (unless (eq mode :definite-rollback-close) '(:lock)))
         (*pre-return-failure* (eq mode :pre-return-close-error))
         (*fnn-owner-retained-service* nil)
         (*fnn-owner-reserving-thread* nil)
         (caught nil))
    (fnn-owner-claim-run-authority)
    (handler-case (fnn-owner-install "/unused" 1) (error (e) (setq caught e)))
    (assert (eq caught *body-condition*))
    (if (eq mode :definite-rollback-close)
        (progn
          (assert (eq (fnn-owner-store-settlement nil :joined) :joined))
          (assert (null *fnn-owner-retained-service*)))
      (let ((carrier *fnn-owner-retained-service*) (physical-before (copy-list *calls*)))
        (assert (fnn-owner-service-p carrier))
        (assert (eq (fnn-owner-service-store carrier) *startup-store*))
        (assert (fnn-store-close-debt *startup-store*))
        (assert (eq (fnn-owner-store-settlement nil :joined) :held))
        (assert (eq *fnn-owner-retained-service* carrier))
        ;; Sticky close debt is an unknown outcome, never a new close retry.
        (assert (equal physical-before *calls*))))
    (format t "~a physical=~s retained=~s~%" mode (reverse *calls*)
            (and *fnn-owner-retained-service* t))))
(format t "PASS composed startup close-debt authority~%")

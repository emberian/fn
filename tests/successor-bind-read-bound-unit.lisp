; Primitive actual encoder/index/decoder consumption control, UNEXECUTED.
; One assembly in this fixture; no actual B acceptance or whole node claim.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/runs-schema")
(include-book "../books/runs-assemble")
(defrunschema fn2-sbr-tiny :id 1 :key ((key :u8)) :value ((payload (:octets 1))) :merge :unique)
(fn2-run-assemble)
(defun fn2-sbr-repeat (n pos slot gen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix n)))
 (if (zp n) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen pos 128 9 0 1 fn2-pool)
   (if (eq code :ok) (fn2-sbr-repeat (- n 1) (+ pos 1) slot gen fn2-pool)
    (mv code fn2-pool)))))
(defun fn2-sbr-body (fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-overlays fn2-overlay-index fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-overlays (fn2-overlays-init 1 fn2-overlays))
      (fn2-overlay-index (fn2-overlay-index-init 2 fn2-overlay-index))
      (fn2-fields (fn2-fields-init (* 2 *fn2-run-entry-rows*) fn2-fields))
      (fn2-pool (fn2-pool-init '((2 . 4096)) 1 100 fn2-pool))
      ((mv a source sg fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv b arena ag fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv filled fn2-pool) (fn2-pool-write source sg 0 66 9 0 1 fn2-pool))
      ((mv started fn2-overlays fn2-pool) (fn2-ov-start 0 1 arena ag 0 2 9 0 1 1 fn2-overlays fn2-overlay-index fn2-pool))
      (fn2-fields (fn2-fields-put 0 (value 7)))
      (fn2-fields (fn2-fields-put 1 (ref-slot source) (ref-gen sg) (ref-off 0) (ref-len 1)))
      ((mv inserted fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
       (fn2-ov-insert 0 0 *fn2-run-entry-rows* fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ((mv valid end fn2-fields) (fn2-ov-entry 0 0 *fn2-run-entry-rows* fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (whole-valid (and (eq a :ok) (eq b :ok) (eq filled :ok) (eq started :ok) (eq inserted :ok) (eq valid :ok)
       (= end (fn2-overlays-fill 0 fn2-overlays)) (<= end (fn2-run-layout-max-size 1 0))
       (= (fn2-fields-value *fn2-run-entry-rows* fn2-fields) 7)
       (= (fn2-fields-ref-len (+ 1 *fn2-run-entry-rows*) fn2-fields) 1)))
      ; Malformed length prefix follows the same real key in the same arena.
      ((mv reset fn2-pool) (fn2-pool-reset arena ag 9 0 1 fn2-pool))
      ((mv key fn2-pool) (fn2-pool-write arena ag 0 7 9 0 1 fn2-pool))
      ((mv malformed fn2-pool) (fn2-sbr-repeat 10 1 arena ag fn2-pool))
      (fn2-overlays (fn2-overlays-set-fill 0 (fn2-pool-fill arena fn2-pool) fn2-overlays))
      ((mv guarded bounded-next fn2-fields) (fn2-ov-entry 0 0 *fn2-run-entry-rows* fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      ; Removed end cap: the SAME real decoder can consume beyond the entry's
      ; declared maximum before rejecting the malformed varint.
      ((mv raw raw-next fn2-fields) (fn2-run-layout-decode 1 0 *fn2-run-entry-rows* arena ag 0
        (fn2-overlays-fill 0 fn2-overlays) 9 0 1 fn2-fields fn2-pool)))
  (mv (and whole-valid (eq reset :ok) (eq key :ok) (eq malformed :ok)
       (eq guarded :truncated) (<= bounded-next (fn2-run-layout-max-size 1 0))
       (not (eq raw :ok)) (> raw-next (fn2-run-layout-max-size 1 0)))
      fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
(defun fn2-sbr-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-overlays
  (mv-let (ok fn2-overlays)
   (with-local-stobj fn2-overlay-index
    (mv-let (ok fn2-overlays fn2-overlay-index)
     (with-local-stobj fn2-fields
      (mv-let (ok fn2-overlays fn2-overlay-index fn2-fields)
       (with-local-stobj fn2-pool
        (mv-let (ok fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
         (fn2-sbr-body fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
         (mv ok fn2-overlays fn2-overlay-index fn2-fields)))
       (mv ok fn2-overlays fn2-overlay-index)))
     (mv ok fn2-overlays)))
   ok)))
(assert-event (fn2-sbr-test))

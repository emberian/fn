; Interpret the actual declarative CTL arms, not a parallel state machine.
; This source control does not establish generated ACL2 guard/composition proofs.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defun unsigned-byte-p (bits x) (typep x `(unsigned-byte ,bits)))
(defun member-equal (x xs) (member x xs :test #'equal))
(defparameter *vars* nil)
(defparameter *effects* nil)
(defun expression (x)
 (eval `(let ,(mapcar (lambda (entry) `(,(car entry) (quote ,(cdr entry)))) *vars*) ,x)))
(defun execute-steps (steps)
 (dolist (step steps)
  (case (car step)
   (:if (execute-steps (if (expression (second step)) (third step) (fourth step))))
   (:cond (let ((clause (find-if (lambda (clause) (expression (car clause))) (cdr step))))
            (assert clause) (execute-steps (cdr clause))))
   (:set (dolist (field (cdr step))
           (push (cons (intern (concatenate 'string "ROW-" (symbol-name (car field))))
                       (expression (cadr field))) *vars*)))
   ((:next :wake-row :wake :charge :stop)
    (push step *effects*))
   (otherwise (error "Unexpected executed instruction ~s" step)))))
(defparameter *ctl*
 (with-open-file (in "books/cns.lisp")
  (loop for f = (read in nil :end) until (eq f :end)
        when (and (consp f) (eq (car f) 'defmachine-arms) (eq (second f) 'fn2-ctl)) return f)))
(defun run (steps vars)
 (let ((*vars* vars) (*effects* nil)) (execute-steps steps) (values *effects* *vars*)))
(let* ((arms (getf (cdddr *ctl*) :arms))
       (observes (getf (cdddr *ctl*) :observes))
       (receive (cdddr (assoc :receive-result observes)))
       (constants '((*fn2-outcome-done* . 1) (*fn2-outcome-short* . 2)
                    (*fn2-ctl-stream-bad* . 7) (*fn2-ctl-stream-none* . 0)
                    (*fn2-ctl-stream-cancelled* . 8)))
       (closing (cdr (assoc :closing arms))))
 ;; EOF and errors at both physical positions must enter cancellation.
 (dolist (position '(:body :trailer))
  (dolist (outcome '(1 3))
   (multiple-value-bind (effects vars)
    (run receive (append constants `((outcome . ,outcome) (count . 0) (row-fill . 2048)
                                     (row-sphase . ,position))))
    (assert (member '(:next :closing) effects :test #'equal))
    (assert (member '(:wake) effects :test #'equal))
    (assert (= (cdr (assoc 'row-sphase vars)) 7)))))
 ;; Every stream closing entry, including consumer refusal, notifies child
 ;; exactly once; CTL remains runnable to issue its own Close afterwards.
 (dolist (phase '(1 2 3 4 7))
  (multiple-value-bind (effects vars)
   (run closing (append constants `((row-sphase . ,phase))))
   (assert (= (count :wake-row effects :key #'car) 1))
   (assert (= (cdr (assoc 'row-sphase vars)) 8))
   (assert (getf (cdr (find :charge effects :key #'car)) :runnable)))))
(format t "CTL ACTUAL ARM SOURCE CONTROLS PASS: body/trailer EOF/error, closing cancellation~%")
(declaim (declaration xargs))
(defmacro mv (&rest xs) `(values ,@xs))
(defparameter *fn2-ctl-stream-feed* 2)
(defun fn2-ctl-stream-live-p (ctl gen request core)
 (and (= ctl 1) (= gen 2) (= request 3) core))
(defun fn2-ctl-row-sphase (ctl core) (declare (ignore ctl)) (getf core :phase))
(defun fn2-ctl-row-swindow (ctl core) (declare (ignore ctl)) (getf core :seq))
(defun fn2-ctl-row-send (ctl core) (declare (ignore ctl)) (getf core :end))
(defun fn2-ctl-row-sack (ctl core) (declare (ignore ctl)) (getf core :ack))
(defun fn2-core-scheduler-wake (ctl core) (declare (ignore ctl)) (list* :wake t core))
(defun fn2-core-stopped-p (core) (declare (ignore core)) nil)
(defun fn2-core-record-enqueue (ctl core) (declare (ignore ctl)) (list* :enqueue t core))
(defun fn2-machine-write-sack (ctl value core) (declare (ignore ctl)) (list* :ack value core))
(with-open-file (in "books/ctl-stream-events.lisp")
 (loop for form = (read in nil :end) until (eq form :end) do
  (when (and (consp form) (eq (car form) 'defmacro))
   (let* ((body (second (fourth form)))
          (definition (find 'fn2-ctl-stream-consumed (cdr body) :key (lambda (f) (and (consp f) (cadr f))))))
    (assert definition) (eval definition)))))
(let ((core '(:phase 2 :seq 8 :end 4096 :ack 0)))
 ;; Identical offset in the next loan cannot authorize the old acknowledgement.
 (multiple-value-bind (code after) (fn2-ctl-stream-consumed 1 2 3 7 4096 core)
  (assert (eq code :stale)) (assert (equal after core)))
 (multiple-value-bind (code after) (fn2-ctl-stream-consumed 1 2 3 8 4096 core)
  (assert (eq code :ok)) (assert (getf after :wake)) (assert (getf after :enqueue))
  (assert (= (getf after :ack) 1))
  (assert (eq (fn2-ctl-stream-consumed 1 2 3 8 4096 after) :stale))))
(format t "CTL ACTUAL ACK SOURCE CONTROLS PASS: stale sequence, current enqueue, duplicate refusal~%")

; Execute the actual bounded decimal parser, no ACL2 admission claim.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun nfix (x) (if (and (integerp x) (<= 0 x)) x 0))
(defun unsigned-byte-p (n x) (typep x `(unsigned-byte ,n)))
(with-open-file (in "books/article-limit-config.lisp")
 (loop for form = (read in nil :end) until (eq form :end)
       when (and (consp form) (eq (car form) 'defun)
                 (member (second form) '(fn2-article-limit-decimal fn2-article-limit-decimal-aux)))
       do (eval form)))
(assert (= (fn2-article-limit-decimal "00098304") 98304))
(assert (= (fn2-article-limit-decimal "4294967295") 4294967295))
(assert (= (fn2-article-limit-decimal "0") 0))
(dolist (text '(nil 123 "" "-1" "+1" "98 304" "4294967296" "00000098304" "#.(anything)"))
 (assert (null (fn2-article-limit-decimal text))))
(format t "ARTICLE LIMIT ACTUAL TEXT SOURCE CONTROLS PASS~%")

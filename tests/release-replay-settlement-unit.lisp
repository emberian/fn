(defun fn2-rrsu-snapshot-events (children world)
 (declare (xargs :verify-guards nil))
 (if (atom children) nil
  (append (fn2-test-column-snapshot-events (car children) world)
          (fn2-rrsu-snapshot-events (cdr children) world))))
(make-event (cons 'progn (fn2-rrsu-snapshot-events *fn2-release-replay-settlement-children* (w state))))
(defun fn2-rrsu-snapshot-calls (children)
 (declare (xargs :verify-guards nil))
 (if (atom children) nil
  (cons (list (fn2-columns-sym 'fn2-test-table-snapshot- (symbol-name (car children))) (car children))
        (fn2-rrsu-snapshot-calls (cdr children)))))
(defmacro fn2-rrsu-snapshot ()
 `(list ,@(fn2-rrsu-snapshot-calls *fn2-release-replay-settlement-children*)))
(defmacro fn2-rrsu-typed ()
 `(and ,@(fn2-release-replay-settlement-hyps *fn2-release-replay-settlement-children*)))
(defun fn2-rrsu-array-frame (at row before after)
 (declare (xargs :verify-guards nil :measure (acl2-count before)))
 (if (atom before) (equal before after)
  (and (consp after) (or (= at row) (equal (car before) (car after)))
       (fn2-rrsu-array-frame (+ 1 (nfix at)) row (cdr before) (cdr after)))))
(defun fn2-rrsu-one-field-checks (fields i allowed)
 (declare (xargs :verify-guards nil))
 (if (atom fields) nil
  (cons (if (eq (caar fields) allowed)
         `(fn2-rrsu-array-frame 0 row (nth ,i before) (nth ,i after))
         `(equal (nth ,i before) (nth ,i after)))
        (fn2-rrsu-one-field-checks (cdr fields) (+ 1 i) allowed))))
(defun fn2-rrsu-one-field-event (name column world)
 (declare (xargs :verify-guards nil))
 (let* ((fields (fn2-test-snapshot-fields name world))
        (allowed (fn2-columns-sym name (concatenate 'string "-" (symbol-name column))))
        (fn (fn2-columns-sym name "-SETTLEMENT-FRAME")))
  `(defun ,fn (row before after)
   (declare (xargs :verify-guards nil))
   (and (equal (len before) ,(len fields)) (equal (len after) ,(len fields))
        ,@(fn2-rrsu-one-field-checks fields 0 allowed)))))
(make-event (cons 'progn (list (fn2-rrsu-one-field-event 'fn2-release-evidence 'phase (w state))
                              (fn2-rrsu-one-field-event 'fn2-checkpoint-construction 'live (w state)))))
(defun fn2-rrsu-allocate (at fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil :measure (nfix (- 5 (nfix at)))))
 (if (>= (nfix at) 5) (mv t fn2-extents)
  (b* (((mv adopted fn2-extents) (fn2-aiu-adopt at (+ 4 at) (+ 4 at) fn2-extents))
       ((mv committed fn2-extents) (fn2-alloc-commit-allocation-transition at (+ 4 at) (+ 4 at) 17 (+ 40 at) fn2-extents))
       ((unless (and adopted (eq committed :ok))) (mv nil fn2-extents)))
   (fn2-rrsu-allocate (+ 1 (nfix at)) fn2-extents))))
(defmacro fn2-rrsu-progress ()
 `(if (eq mode :kind0)
   (fn2-release-target-settlement-progress ,@*fn2-release-replay-settlement-children*)
   (fn2-release-replay-settlement-progress ,@*fn2-release-replay-settlement-children*)))
(defmacro fn2-rrsu-drive-function ()
 `(defun fn2-rrsu-drive (fuel mode ,@*fn2-release-replay-settlement-children*)
   (declare (xargs :stobjs ,*fn2-release-replay-settlement-children* :verify-guards nil :measure (nfix fuel)))
   (if (zp fuel) (fn2-release-replay-settlement-mv :fuel 0)
    (b* (((mv code next fn2-allocation-release fn2-release-evidence fn2-checkpoint-construction fn2-extents) (fn2-rrsu-progress)))
     (if (eq code :more)
      (fn2-rrsu-drive (- fuel 1) mode ,@*fn2-release-replay-settlement-children*)
      (fn2-release-replay-settlement-mv code next))))))
(fn2-rrsu-drive-function)

; Concrete allocator + mapped directory preflight controls. The published bank,
; descriptor and HELD source cut are explicit synthetic antecedents, not a Fence,
; selected-summary, crypto or C-adoption witness. No directory base can advance.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-directory-rebase")
(include-book "../books/runs-page")
(defun fn2-dru-body (mode fn2-directory-rebase fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-bytes
                         fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests)
 (declare (xargs :stobjs (fn2-directory-rebase fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-bytes
                        fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests) :verify-guards nil))
 (b* ((fn2-directory-rebase (fn2-directory-rebase-init 1 fn2-directory-rebase))
      (fn2-csnapshot (fn2-csnapshot-init 1 fn2-csnapshot))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-init 1 fn2-checkpoint-publication))
      (fn2-checkpoints (fn2-checkpoints-init 1 fn2-checkpoints))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-init 192 fn2-checkpoint-bytes))
      (fn2-commit-root (fn2-commit-root-init 3 fn2-commit-root))
      (fn2-extents (fn2-alloc-init 1 fn2-extents)) (fn2-alloc-edges (fn2-alloc-edges-init 10 fn2-alloc-edges))
      (fn2-fc (fn2-fc-init 3 fn2-fc)) (fn2-digests (fn2-digests-init (+ (* *fn2-digest-stride* 3) 4) fn2-digests))
      ((mv epoch fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv reserve & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv commit fn2-extents) (fn2-alloc-commit-allocation 0 1 0 *fn2-commit-kind* 1 fn2-extents))
      ((mv pin fn2-extents fn2-alloc-edges) (fn2-alloc-edge-add 7 1 0 1 0 :installed-root fn2-extents fn2-alloc-edges))
      (fn2-commit-root (fn2-commit-root-put 0 (installed 2) (published 2) (proposed 2)))
      (fn2-commit-root (fn2-commit-root-put 1 (parent 0) (extent 0) (first-key 1) (members 1) (seal-ready 1)))
      (fn2-csnapshot (fn2-csnapshot-put 0 (phase *fn2-csnapshot-phase-held*) (token 9) (owner-kind 7) (owner-slot 0) (owner-gen 1)
       (cut-commit 2) (cut-event 2)))
      (fn2-checkpoints (fn2-checkpoints-put 0 (state *fn2-checkpoint-state-promoted*) (checkpoint 9) (history 37) (incarnation 41)
       (cut-commit 1) (cut-event 1) (installation-commit 2)))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-put 0 (has-base 1) (active-bank 0)
       (base-checkpoint 9) (base-history 37) (base-incarnation 41) (bank0-valid 1) (bank0-candidate 0)
       (bank0-checkpoint 9) (bank0-history 37) (bank0-incarnation 41)))
      (fn2-digests (fn2-digest-set-word (+ (* *fn2-digest-stride* 3) 1) 0 123 fn2-digests))
      ((mv begin fn2-directory-rebase) (fn2-directory-rebase-begin 9 7 0 1 fn2-directory-rebase fn2-csnapshot
       fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-bytes fn2-commit-root))
      (before (fn2-directory-rebase-row-snapshot 0 fn2-directory-rebase))
      (fn2-csnapshot (if (eq mode :owner) (fn2-csnapshot-put 0 (owner-gen 2)) fn2-csnapshot))
      (fn2-commit-root (if (eq mode :tag) (fn2-commit-root-put 1 (parent 2)) fn2-commit-root))
      (fn2-extents (if (eq mode :allocation) (fn2-extents-put 0 (counter 1)) fn2-extents))
      ((mv step fn2-directory-rebase) (fn2-directory-rebase-step fn2-directory-rebase fn2-csnapshot fn2-checkpoint-publication
       fn2-checkpoints fn2-checkpoint-bytes fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests))
      (result (and (eq epoch :ok) (eq reserve :ok) (eq commit :ok) (eq pin :ok) (eq begin :ok)
       (= (fn2-commit-root-base-batch 0 fn2-commit-root) 0) (= (fn2-commit-root-base-ready 0 fn2-commit-root) 0)
       (if mode
        (and (eq step (case mode (:owner :owner) (:tag :directory) (otherwise :physical-source)))
         (equal before (fn2-directory-rebase-row-snapshot 0 fn2-directory-rebase))
         (= (fn2-directory-rebase-seal-wordsi 0 fn2-directory-rebase) 0))
        (and (eq step :await-evidence) (= (fn2-directory-rebase-phase 0 fn2-directory-rebase) *fn2-directory-rebase-phase-source-scanned*)
         (= (fn2-directory-rebase-target 0 fn2-directory-rebase) 1) (= (fn2-directory-rebase-target-event 0 fn2-directory-rebase) 1)
         (= (fn2-directory-rebase-last-event 0 fn2-directory-rebase) 1) (= (fn2-directory-rebase-scanned 0 fn2-directory-rebase) 1)
         (= (fn2-directory-rebase-source-epoch 0 fn2-directory-rebase) 1) (= (fn2-directory-rebase-source-allocation 0 fn2-directory-rebase) 0)
         (= (fn2-directory-rebase-seal-wordsi 0 fn2-directory-rebase) 123))))))
  (mv result fn2-directory-rebase fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-bytes
      fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests)))
(defun fn2-dru-run (mode)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-directory-rebase fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-bytes
                     fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests)
  (fn2-dru-body mode fn2-directory-rebase fn2-csnapshot fn2-checkpoint-publication fn2-checkpoints fn2-checkpoint-bytes
               fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests)))
(assert-event (fn2-dru-run nil))
(assert-event (fn2-dru-run :owner))
(assert-event (fn2-dru-run :tag))
(assert-event (fn2-dru-run :allocation))

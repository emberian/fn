 '((defun fnn-owner-ready-plan-step) (defun fnn-owner-render-next-quantum)))
(dolist (mode '(:warm :cursor :cold))
  (let* ((*range-cursor* (not (eq mode :warm)))
         (*range-cold* (and (eq mode :cold) :exact-read))
         (result (multiple-value-list
                  (fnn-owner-render-next-quantum nil 7 :plan :reader nil t))))
    (assert (eq (second result) :plan))
    (assert (eq (fifth result) *range-cold*))
    (assert (= (sixth result) (if *range-cold* 0 3)))))

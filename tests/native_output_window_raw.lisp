;;; Real mux/transport range code; OS, compression and plan production are
;;; controlled boundary observations. Not an ACL2 or full-image claim.
(require :sb-posix)
(require :sb-bsd-sockets)
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defun load-range-forms (path names)
  (let ((missing (copy-list names)))
    (with-open-file (s path)
      (loop for f = (read s nil :eof) until (eq f :eof)
            when (member (list (car f) (cadr f)) names :test #'equal)
              do (eval f) (setf missing (remove (list (car f) (cadr f)) missing :test #'equal))))
    (assert (null missing))))
(load-range-forms "host/native/mux.lisp"
 '((defstruct (fnn-mux-loop (:constructor %make-fnn-mux-loop)))
   (defstruct (fnn-mux-conn (:constructor %make-fnn-mux-conn)))
   (defun fnn-mux-output-window) (defun fnn-mux-write-now)
   (defun fnn-mux-flush) (defun fnn-mux-z-out)))
(defvar *fnn-write-syscall* nil)
(load-range-forms "host/native/io.lisp" '((deftype fnn-octets) (defun fnn-make-octets) (defun fnn-transport-write-now)))
(defparameter +fnn-mux-send-seconds+ 10)
(defvar *range-writes* nil)
(defvar *range-block* nil)
(defvar *range-next* nil)
(defvar *range-after* nil)
(defvar *range-compress-input* nil)
(defun fnn-fault (&rest xs) (error "fault ~s" xs))
(defun fnn-write-progress (thunk remaining label deadline nowp)
  (declare (ignore remaining label deadline nowp)) (funcall thunk))
(defun fnn-tls-write-now-range (channel data at end)
  (assert (eq channel :tls)) (funcall *fnn-write-syscall* 1 data at (- end at)))
(defun fnn-mux-service (loop) (fnn-mux-loop-service loop))
(defun fnn-owner-connection-call (service op thunk)
  (declare (ignore service op)) (funcall thunk))
(defun fnn-core (subject plan)
  (declare (ignore plan)) (assert (eq subject 'fn-asto-plan-cursorp)) nil)
(defun fnn-mux-ticks (seconds) seconds)
(defun fnn-mux-after (loop conn after)
  (declare (ignore loop conn)) (setf *range-after* after))
(defun fnn-mux-render-next (loop conn plan)
  (declare (ignore loop))
  (assert (eq plan :next))
  ;; The previous range must be fully consumed before its vector is mutated.
  (assert (= (fnn-mux-conn-out-at conn) (fnn-mux-conn-out-end conn)))
  (setf *range-next* t)
  (let ((buffer (fnn-mux-conn-out conn)))
    (setf (aref buffer 0) 7 (aref buffer 1) 8)
    (values buffer nil t nil nil 2)))
(defun fnn-zout-sync (z octets)
  (assert (eq z :compressed))
  (setf *range-compress-input* (coerce octets 'list))
  (concatenate 'vector #(99) octets))
(setf *fnn-write-syscall*
      (lambda (fd data at n)
        (declare (ignore fd))
        (if *range-block* (progn (setf *range-block* nil) :would-block)
          (let ((count (min n 2)))
            (loop for i from at below (+ at count) do (push (aref data i) *range-writes*))
            (setf *range-block* t)
            count))))
(dolist (channel '(nil :tls))
  (let* ((buffer (vector 1 2 3 222 223 224))
         (conn (%make-fnn-mux-conn :fd 1 :channel channel :plan :next :after :finished))
         (loop (%make-fnn-mux-loop))
         (*range-writes* nil) (*range-block* nil) (*range-next* nil) (*range-after* nil))
    (fnn-mux-output-window conn buffer 3)
    (assert (eq buffer (fnn-mux-conn-out conn)))
    (fnn-mux-flush loop conn)
    (assert (equal (reverse *range-writes*) '(1 2)))
    (assert (not *range-next*))
    (assert (= (fnn-mux-conn-out-at conn) 2))
    (fnn-mux-flush loop conn)
    (assert *range-next*)
    (assert (equal (reverse *range-writes*) '(1 2 3)))
    (fnn-mux-flush loop conn)
    (assert (equal (reverse *range-writes*) '(1 2 3 7 8)))
    (assert (eq *range-after* :finished))
    (assert (null (fnn-mux-conn-out conn)))
    (assert (null (fnn-mux-conn-out-end conn)))))
(let ((conn (%make-fnn-mux-conn :zout :compressed)))
  (fnn-mux-output-window conn #(1 2 3 222 223) 3)
  (assert (equal *range-compress-input* '(1 2 3)))
  (assert (equalp (fnn-mux-conn-out conn) #(99 1 2 3)))
  (assert (= (fnn-mux-conn-out-end conn) 4)))
(format t "native_output_window_raw: PASS partial/wait/reuse/valid END/plain/TLS dispatch/compression prefix~%")

;;; Actual wrapper preserves the established COLD-READ position while carrying
;;; the new END through warm, suspended and resumed cursor paths.
(defvar *range-cursor* nil)
(defvar *range-cold* nil)
(defun fnn-owner-render-next (plan &optional compressedp borrowp)
  (declare (ignore compressedp))
  (assert borrowp)
  (values #(1 2 3 222) plan nil *range-cursor* 3))
(defun fnn-owner-cursor-step (service cid plan class)
  (declare (ignore service cid class))
  (setf *range-cursor* nil)
  (values plan *range-cold*))
(defun fnn-developer-selector (key) (declare (ignore key)) nil)
(load-range-forms "host/native/owner.lisp" '((defun fnn-owner-render-next-quantum)))
(dolist (mode '(:warm :cursor :cold))
  (let* ((*range-cursor* (not (eq mode :warm)))
         (*range-cold* (and (eq mode :cold) :exact-read))
         (result (multiple-value-list
                  (fnn-owner-render-next-quantum nil 7 :plan :reader nil t))))
    (assert (eq (second result) :plan))
    (assert (eq (fifth result) *range-cold*))
    (assert (= (sixth result) (if *range-cold* 0 3)))))
(format t "native_output_window_raw: PASS actual wrapper COLD fifth/END sixth warm/cursor/cold~%")

;;; Actual wrapper preserves the established COLD-READ position while carrying
;;; the new END through warm, suspended and resumed cursor paths.
(defvar *range-cursor* nil)
(defvar *range-cold* nil)
(defun fnn-owner-render-next (plan &optional compressedp borrowp)
  (declare (ignore compressedp))
  (assert borrowp)
  (values #(1 2 3 222) plan nil *range-cursor* 3))
(defun fnn-owner-cursor-step (service cid plan class)
  (declare (ignore service cid class))
  (setf *range-cursor* nil)
  (values plan *range-cold*))

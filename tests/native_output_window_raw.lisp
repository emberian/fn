(defun fnn-mux-render-next (loop conn plan)
  (declare (ignore loop))
  (assert (eq plan :next))
  ;; The previous range must be fully consumed before its vector is mutated.
  (assert (= (fnn-mux-conn-out-at conn) (fnn-mux-conn-out-end conn)))
  (setf *range-next* t)
  (let ((buffer (fnn-mux-conn-out conn)))
    (setf (aref buffer 0) 7 (aref buffer 1) 8)
    (values buffer nil t nil nil 2)))
(defun fnn-zout-sync (z octets)
  (assert (eq z :compressed))
  (setf *range-compress-input* (coerce octets 'list))
  (concatenate 'vector #(99) octets))
(setf *fnn-write-syscall*
      (lambda (fd data at n)
        (declare (ignore fd))
        (if *range-block* (progn (setf *range-block* nil) :would-block)
          (let ((count (min n 2)))
            (loop for i from at below (+ at count) do (push (aref data i) *range-writes*))
            (setf *range-block* t)
            count))))
(dolist (channel '(nil :tls))
  (let* ((buffer (vector 1 2 3 222 223 224))
         (conn (%make-fnn-mux-conn :fd 1 :channel channel :plan :next :after :finished))
         (loop (%make-fnn-mux-loop))
         (*range-writes* nil) (*range-block* nil) (*range-next* nil) (*range-after* nil))
    (fnn-mux-output-window conn buffer 3)
    (assert (eq buffer (fnn-mux-conn-out conn)))
    (fnn-mux-flush loop conn)
    (assert (equal (reverse *range-writes*) '(1 2)))
    (assert (not *range-next*))
    (assert (= (fnn-mux-conn-out-at conn) 2))
    (fnn-mux-flush loop conn)
    (assert *range-next*)
    (assert (equal (reverse *range-writes*) '(1 2 3)))
    (fnn-mux-flush loop conn)
    (assert (equal (reverse *range-writes*) '(1 2 3 7 8)))
    (assert (eq *range-after* :finished))
    (assert (null (fnn-mux-conn-out conn)))
    (assert (null (fnn-mux-conn-out-end conn)))))
(let ((conn (%make-fnn-mux-conn :zout :compressed)))
  (fnn-mux-output-window conn #(1 2 3 222 223) 3)
  (assert (equal *range-compress-input* '(1 2 3)))
  (assert (equalp (fnn-mux-conn-out conn) #(99 1 2 3)))
  (assert (= (fnn-mux-conn-out-end conn) 4)))

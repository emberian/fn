; Actual persisted POST, discovery, physical reread, shared authentication,
; and continued recovery. No expected hash or authorization flag is seeded.
; Fault injection changes the completed reread window before authentication,
; or releases/reuses its real pool slot after authentication. These are finite
; integrity/refusal controls, not a cryptographic collision theorem.
; Source-only: execution awaits the repaired current recovery closure.
(in-package "ACL2")
(include-book "../books/owed-cursor")
(include-book "../books/assembly-attach")
(include-book "core-snapshot-support")
(include-book "std/util/bstar" :dir :system)
(defconst *fn2-rri-profile* (put-assoc-equal :aturn 1 *fn2-cursor-profile*))

(defun fn2-rri-substitute (id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((p (fn2-machine-rc-pos id fn2-core)) (commit (fn2-machine-rc-commit id fn2-core))
      (slot (fn2-machine-pool-slot id fn2-core)) (gen (fn2-machine-pool-gen id fn2-core))
      (ogen (fn2-machine-generation id fn2-core))
      ((mv before roff rend fn2-core) (fn2-recovery-records-open p commit slot gen id ogen fn2-core))
      ((unless (and (eq before :ok) (< roff rend))) (mv nil fn2-core))
      ((mv read byte) (fn2-core-read slot gen (- rend 1) *fn2-recovery-machine-kind* id ogen fn2-core))
      ((mv wrote fn2-core) (fn2-core-write slot gen (- rend 1) (logxor byte 1)
                              *fn2-recovery-machine-kind* id ogen fn2-core))
      ;; The old header-only gate still accepts the same stream extent.
      ((mv after roff2 rend2 fn2-core) (fn2-recovery-records-open p commit slot gen id ogen fn2-core)))
  (mv (and (eq read :ok) (eq wrote :ok) (eq after :ok) (= roff roff2) (= rend rend2)) fn2-core)))
(defun fn2-rri-stale (id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((slot (fn2-machine-pool-slot id fn2-core)) (gen (fn2-machine-pool-gen id fn2-core))
      (ogen (fn2-machine-generation id fn2-core))
      (class (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (class)
               (fn2-pool-class slot fn2-pool) class))
      ((mv released fn2-core) (fn2-core-release slot gen *fn2-recovery-machine-kind* id ogen fn2-core))
      ((mv reserved new-slot new-gen fn2-core)
       (fn2-core-reserve class *fn2-recovery-machine-kind* id ogen fn2-core)))
  (mv (and (eq released :ok) (eq reserved :ok) (= slot new-slot) (not (= gen new-gen))
           ;; Neither the saved row tuple nor its auth flag was rewritten.
           (= (fn2-machine-pool-gen id fn2-core) gen)
           (= (fn2-machine-rc-auth id fn2-core) 1)
           (not (fn2-rp-current-unit-auth-p id ogen fn2-core))) fn2-core)))

 ; Change only a resumed scanner locator after actual authenticated begin.
; The actual frontier helper must refuse with the COMPLETE core unchanged.
(defun fn2-rri-scanner-drift (id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core
        (stobj-let ((fn2-journal-members (fn2-core-journal-members fn2-core))) (fn2-journal-members)
         (fn2-journal-members-set-gen 0 (+ 1 (fn2-journal-members-gen 0 fn2-journal-members)) fn2-journal-members)
         fn2-core))
      (before (fn2-test-core-snapshot fn2-core))
      ((mv code fn2-core) (fn2-recovery-frontier-step id fn2-core)))
  (mv (and (eq code :state) (equal before (fn2-test-core-snapshot fn2-core))) fn2-core)))

(defun fn2-rri-drive (fuel id control injected stages store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (b* ((mode (fn2-machine-rc-mode id fn2-core))
      (verify (= (fn2-machine-phase id fn2-core) *fn2-recovery-machine-state-verify*))
      (target (if (eq control :payload-swap) *fn2-rec-mode-payload* *fn2-rec-mode-replay*))
      (stage (fn2-machine-rc-stage id fn2-core))
      (observed (and verify (= mode target) (= (fn2-machine-rc-role id fn2-core) 1)
                     (= (fn2-machine-rc-filled id fn2-core) *fn2-commit-unit-bytes*)))
      (stages (if (and observed (<= stage 2)) (logior stages (ash 1 stage)) stages))
      (scanner (and observed (= stage 4)))
      (started (fn2-machine-rc-frontier-started id fn2-core))
      (hash-phase
       (stobj-let ((fn2-journal-members (fn2-core-journal-members fn2-core))) (hp)
        (if (= (fn2-journal-members-phase 0 fn2-journal-members) *fn2-journal-members-phase-leaf*)
            (fn2-journal-members-hash-phase 0 fn2-journal-members) 4) hp))
      (stages (if (and scanner (= started 0)) (logior stages 8) stages))
      (stages (if (and scanner (= started 1) (< hash-phase 4))
                  (logior stages (ash 1 (+ 4 hash-phase))) stages))
      (drift (and scanner (= started 1) (not injected) (eq control :scanner-generation)))
      (swap (and observed (not injected) (= stage 0)
                 (member-eq control '(:payload-swap :replay-swap))))
      (stale (and observed (not injected) (eq control :stale-generation)
                  (= (fn2-machine-rc-auth id fn2-core) 1)))
      ((mv fault-ok fn2-core)
       (cond (swap (fn2-rri-substitute id fn2-core))
             (stale (fn2-rri-stale id fn2-core))
             (drift (fn2-rri-scanner-drift id fn2-core)) (t (mv t fn2-core))))
      ((unless fault-ok) (mv (list :injection-failed control stage) fn2-core))
      (injected (or injected swap stale drift))
      ;; Freeze the useful positive boundary before any ordinary member
      ;; dispatch: verified reread and completed semantic frontier, no claim
      ;; that every later boot/adoption stage succeeds.
      (last-event (fn2-machine-rc-frontier-last id fn2-core))
      (boundary (and observed (= stage 0) (= started 1)
                     (= (fn2-machine-rc-auth id fn2-core) 1)
                     (stobj-let ((fn2-mk (fn2-core-mk fn2-core))) (exact)
                      (= (fn2-mk-size 0 fn2-mk) last-event) exact)))
      ((when (or boundary (zp fuel) (fn2-core-stopped-p fn2-core)
                  (= (fn2-machine-phase id fn2-core) *fn2-recovery-machine-state-done*)))
       (mv (list (if boundary :boundary :result) injected stages (fn2-core-stop-reason fn2-core)
                 (= (fn2-machine-phase id fn2-core) *fn2-recovery-machine-state-done*)
                 (fn2-machine-rc-ambiguous id fn2-core)
                 (fn2-machine-rc-roff id fn2-core) (fn2-machine-rc-wlen id fn2-core)
                 (fn2-machine-rc-auth-roff id fn2-core)) fn2-core))
      ;; Actual scheduler and adapter; no duplicate recovery scanner.
      ((mv & & & & fn2-core) (fn2-turn fn2-core))
      ((mv & & & store fn2-core) (fn2-cw-adapter-one 0 nil store fn2-core)))
  (fn2-rri-drive (- fuel 1) id control injected stages store fn2-core)))
(defun fn2-rri-recover (control store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-rri-profile* :echo nil fn2-core))
      (id (fn2-machine-global-id *fn2-recovery-machine-kind* 0 *fn2-rri-profile*))
      ((mv code fn2-core) (fn2-recovery-start id 2 0 fn2-core))
      ((unless (eq code :ok)) (mv (list :start code) fn2-core)))
  (fn2-rri-drive 400000 id control nil 0 store fn2-core)))
(defun fn2-rri-controls (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-rri-profile* :echo nil fn2-core))
      ((mv epoch fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      (post (fn2-cw-crlf-octets '("POST" "From: a@example.invalid" "Subject: reread"
              "Newsgroups: local.test" "Message-ID: <reread@example.invalid>" "" "body" "." "QUIT")))
      ((mv status clients store fn2-core)
       (fn2-cw-loop 40000 0 0 (fn2-cw-clients (list (list post (list (len post))))) nil fn2-core))
      ((unless (and (eq epoch :ok) (eq status :quiet)
                    (equal (fn2-cw-results clients)
                     (list (list (fn2-cw-crlf-octets '("200 fn-nntp experimental server ready"
                      "340 send article to be posted" "240 article received OK" "205 closing connection")) t)))))
       (mv (list :posting epoch status) fn2-core))
      ((mv clean fn2-core) (fn2-rri-recover :clean store fn2-core))
      ((mv changed fn2-core) (fn2-rri-recover :replay-swap store fn2-core))
      ((mv payload fn2-core) (fn2-rri-recover :payload-swap store fn2-core))
      ((mv stale fn2-core) (fn2-rri-recover :stale-generation store fn2-core))
      ((mv drift fn2-core) (fn2-rri-recover :scanner-generation store fn2-core)))
  (mv (if (and (equal (take 6 clean) '(:boundary nil 255 0 nil 0))
               (equal (nth 6 clean) (nth 8 clean)) (equal (nth 7 clean) 0)
               (eq (car changed) :result) (nth 1 changed) (not (equal (nth 3 changed) 0))
               (equal (nth 6 changed) 0) (equal (nth 7 changed) 0)
               (eq (car payload) :result) (nth 1 payload)
               (or (not (equal (nth 3 payload) 0)) (equal (nth 5 payload) 1))
               (eq (car stale) :result) (nth 1 stale) (not (equal (nth 3 stale) 0))
               (equal (nth 6 stale) (nth 8 stale)) (equal (nth 7 stale) 0)
               (eq (car drift) :result) (nth 1 drift) (not (equal (nth 3 drift) 0))
               (equal (nth 6 drift) (nth 8 drift)) (equal (nth 7 drift) 0))
          :ok (list :controls clean changed payload stale drift)) fn2-core)))
(assert-event
 (with-local-stobj fn2-core
  (mv-let (result fn2-core) (fn2-rri-controls fn2-core) (equal result :ok))))

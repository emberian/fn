; Prepared controls over the actual lower endpoint operations, UNEXECUTED.
; Row0 is a synthetic READ endpoint, row1 a distinct nested successor endpoint,
; row2 another admitted endpoint. Writer ML/cut provenance is synthetic here;
; actual source/adoption constructors establish that provenance in composition.
(in-package "ACL2")
(include-book "../books/c-source-observer")
(include-book "../books/runs-page")

(defun fn2-c-source-endpoint-unit-body (fn2-c-source-control fn2-c-source-readers)
 (declare (xargs :stobjs (fn2-c-source-control fn2-c-source-readers) :verify-guards nil))
 (b* ((fn2-c-source-control (fn2-c-source-control-init 1 fn2-c-source-control))
      (fn2-c-source-readers (fn2-c-source-readers-init 3 fn2-c-source-readers))
      ((mv read r fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire 0 0 fn2-c-source-control fn2-c-source-readers))
      ((mv successor s fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire 1 0 fn2-c-source-control fn2-c-source-readers))
      ((mv unowned zero fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire 0 0 fn2-c-source-control fn2-c-source-readers))
      ((mv begin fn2-c-source-control) (fn2-c-source-writer-begin 7 40 11 31 51 61 fn2-c-source-control))
      ((mv blocked & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire 2 0 fn2-c-source-control fn2-c-source-readers))
      ((mv resume same fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire 0 r fn2-c-source-control fn2-c-source-readers))
      ((unless (and (eq read :ok) (eq successor :ok) (equal r 1) (equal s 2)
                    (eq unowned :stale) (equal zero 0) (eq begin :waiting) (eq blocked :busy)
                    (eq resume :ok) (equal same r)
                    (fn2-c-source-count-invariant-p fn2-c-source-control fn2-c-source-readers)
                    (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 2)))
       (mv nil fn2-c-source-control fn2-c-source-readers))
      ((mv wrong-cut fn2-c-source-control) (fn2-c-source-writer-poll 7 40 11 31 51 62 fn2-c-source-control))
      ((mv wrong-gen fn2-c-source-control) (fn2-c-source-writer-abort-pending 7 40 12 31 51 61 fn2-c-source-control))
      ((mv released target targetgen fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release 0 r fn2-c-source-control fn2-c-source-readers))
      ((mv partial fn2-c-source-control) (fn2-c-source-writer-poll 7 40 11 31 51 61 fn2-c-source-control))
      ((unless (and (eq wrong-cut :owner) (eq wrong-gen :owner) (eq released :ok)
                    (equal target *fn2-none*) (equal targetgen 0) (eq partial :waiting)
                    (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 1)
                    (fn2-c-source-reader-current-p 1 s fn2-c-source-readers)))
       (mv nil fn2-c-source-control fn2-c-source-readers))
      ((mv last wake wakegen fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release 1 s fn2-c-source-control fn2-c-source-readers))
      ((unless (and (eq last :ok) (equal wake 40) (equal wakegen 11)
                    (equal (fn2-c-source-control-wake-pending 0 fn2-c-source-control) 1)))
       (mv nil fn2-c-source-control fn2-c-source-readers))
      ((mv exclusive fn2-c-source-control) (fn2-c-source-writer-poll 7 40 11 31 51 61 fn2-c-source-control))
      ((mv too-late fn2-c-source-control) (fn2-c-source-writer-abort-pending 7 40 11 31 51 61 fn2-c-source-control))
      ((mv stale & & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release 1 s fn2-c-source-control fn2-c-source-readers)))
  (mv (and (fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control)
           (fn2-c-source-readersp fn2-c-source-readers) (fn2-c-source-readers-wfp fn2-c-source-readers)
           (fn2-c-source-count-invariant-p fn2-c-source-control fn2-c-source-readers)
           (natp 0) (< 0 (fn2-c-source-readers-rows fn2-c-source-readers))
           (equal (fn2-c-source-readers-live 0 fn2-c-source-readers) 0)
           (eq exclusive :exclusive) (eq too-late :owner) (eq stale :stale)
           (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 0)
           (equal (fn2-c-source-control-wake-pending 0 fn2-c-source-control) 0)
           (fn2-c-source-writer-exclusive-p 7 40 11 31 51 61 fn2-c-source-control)
           (not (fn2-c-source-writer-exclusive-p 7 40 11 32 51 61 fn2-c-source-control)))
      fn2-c-source-control fn2-c-source-readers)))

(assert-event
 (fn2-run-with-local (fn2-c-source-control fn2-c-source-readers)
  (fn2-c-source-endpoint-unit-body fn2-c-source-control fn2-c-source-readers)))

(defun fn2-c-source-endpoint-reuse-body (fn2-c-source-control fn2-c-source-readers)
 (declare (xargs :stobjs (fn2-c-source-control fn2-c-source-readers) :verify-guards nil))
 (b* ((fn2-c-source-control (fn2-c-source-control-init 1 fn2-c-source-control))
      (fn2-c-source-readers (fn2-c-source-readers-init 1 fn2-c-source-readers))
      ((mv a old fn2-c-source-control fn2-c-source-readers) (fn2-c-source-reader-acquire 0 0 fn2-c-source-control fn2-c-source-readers))
      ((mv begin fn2-c-source-control) (fn2-c-source-writer-begin 7 40 11 31 51 61 fn2-c-source-control))
      ((mv abort fn2-c-source-control) (fn2-c-source-writer-abort-pending 7 40 11 31 51 61 fn2-c-source-control))
      ((unless (and (eq a :ok) (eq begin :waiting) (eq abort :aborted)
                    (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 1)
                    (fn2-c-source-reader-current-p 0 old fn2-c-source-readers)))
       (mv nil fn2-c-source-control fn2-c-source-readers))
      ((mv release & & fn2-c-source-control fn2-c-source-readers) (fn2-c-source-reader-release 0 old fn2-c-source-control fn2-c-source-readers))
      ((mv b fresh fn2-c-source-control fn2-c-source-readers) (fn2-c-source-reader-acquire 0 0 fn2-c-source-control fn2-c-source-readers))
      ((mv stale & & fn2-c-source-control fn2-c-source-readers) (fn2-c-source-reader-release 0 old fn2-c-source-control fn2-c-source-readers))
      ((unless (and (eq release :ok) (eq b :ok) (< old fresh) (eq stale :stale)
                    (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 1)
                    (fn2-c-source-reader-current-p 0 fresh fn2-c-source-readers)))
       (mv nil fn2-c-source-control fn2-c-source-readers))
      ((mv final & & fn2-c-source-control fn2-c-source-readers) (fn2-c-source-reader-release 0 fresh fn2-c-source-control fn2-c-source-readers))
      ; Explicit synthetic exhaustion premise, not a reachable-loop witness.
      (fn2-c-source-control (fn2-c-source-control-put 0
        (next-receipt (- (expt 2 60) 1))))
      ((mv exhausted zero fn2-c-source-control fn2-c-source-readers) (fn2-c-source-reader-acquire 0 0 fn2-c-source-control fn2-c-source-readers)))
  (mv (and (eq final :ok) (eq exhausted :exhausted) (equal zero 0)
           (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 0)
           (equal (fn2-c-source-readers-live 0 fn2-c-source-readers) 0))
      fn2-c-source-control fn2-c-source-readers)))

(assert-event
 (fn2-run-with-local (fn2-c-source-control fn2-c-source-readers)
  (fn2-c-source-endpoint-reuse-body fn2-c-source-control fn2-c-source-readers)))

; Hypothesis-removal control for exclusive-has-no-live-endpoint: WFP alone
; admits a synthetic count0/live1 forgery. This deliberately removes the
; aggregate initialization/transition invariant; it is not a reachable state.
(defun fn2-c-source-count-hypothesis-removal-body (fn2-c-source-control fn2-c-source-readers)
 (declare (xargs :stobjs (fn2-c-source-control fn2-c-source-readers) :verify-guards nil))
 (b* ((fn2-c-source-control (fn2-c-source-control-init 1 fn2-c-source-control))
      (fn2-c-source-readers (fn2-c-source-readers-init 1 fn2-c-source-readers))
      (fn2-c-source-readers (fn2-c-source-readers-put 0
        (live 1)
        (serial 1)))
      ((mv begin fn2-c-source-control) (fn2-c-source-writer-begin 7 40 11 31 51 61 fn2-c-source-control)))
  (mv (and (fn2-c-source-controlp fn2-c-source-control) (fn2-c-source-control-wfp fn2-c-source-control)
           (fn2-c-source-readersp fn2-c-source-readers) (fn2-c-source-readers-wfp fn2-c-source-readers)
           (natp 0) (< 0 (fn2-c-source-readers-rows fn2-c-source-readers))
           (eq begin :exclusive)
           (fn2-c-source-writer-exclusive-p 7 40 11 31 51 61 fn2-c-source-control)
           (not (fn2-c-source-count-invariant-p fn2-c-source-control fn2-c-source-readers))
           (not (equal (fn2-c-source-readers-live 0 fn2-c-source-readers) 0)))
      fn2-c-source-control fn2-c-source-readers)))
(assert-event
 (fn2-run-with-local (fn2-c-source-control fn2-c-source-readers)
  (fn2-c-source-count-hypothesis-removal-body fn2-c-source-control fn2-c-source-readers)))

; Actual lower lineage transitions. The request/READ interpretation of rows is
; synthetic; this does not execute a response-prefix or physical I/O consumer.
(defun fn2-c-source-endpoint-lineage-body (fn2-c-source-control fn2-c-source-readers)
 (declare (xargs :stobjs (fn2-c-source-control fn2-c-source-readers) :verify-guards nil))
 (b* ((fn2-c-source-control (fn2-c-source-control-init 1 fn2-c-source-control))
      (fn2-c-source-readers (fn2-c-source-readers-init 3 fn2-c-source-readers))
      ((mv request parent fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire 0 0 fn2-c-source-control fn2-c-source-readers))
      ((mv waiting fn2-c-source-control) (fn2-c-source-writer-begin 7 40 11 31 51 61 fn2-c-source-control))
      ((mv blocked & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire 2 0 fn2-c-source-control fn2-c-source-readers))
      ((mv forged & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire-under 1 0 0 (+ parent 1) fn2-c-source-control fn2-c-source-readers))
      ((mv self & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire-under 0 0 0 parent fn2-c-source-control fn2-c-source-readers))
      ((mv nested child fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire-under 1 0 0 parent fn2-c-source-control fn2-c-source-readers))
      ((mv resume same fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire-under 1 child 0 parent fn2-c-source-control fn2-c-source-readers))
      ((unless (and (eq request :ok) (eq waiting :waiting) (eq blocked :busy)
                    (eq forged :parent) (eq self :parent) (eq nested :ok) (eq resume :ok)
                    (equal same child) (< parent child)
                    (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 2)
                    (fn2-c-source-count-invariant-p fn2-c-source-control fn2-c-source-readers)))
       (mv nil fn2-c-source-control fn2-c-source-readers))
      ((mv childdone & & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release 1 child fn2-c-source-control fn2-c-source-readers))
      ((mv again newer fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire-under 1 0 0 parent fn2-c-source-control fn2-c-source-readers))
      ((mv oldchild & & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release 1 child fn2-c-source-control fn2-c-source-readers))
      ((mv finishchild & & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release 1 newer fn2-c-source-control fn2-c-source-readers))
      ((mv stillwaiting fn2-c-source-control) (fn2-c-source-writer-poll 7 40 11 31 51 61 fn2-c-source-control))
      ((mv finishrequest wake wakegen fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release 0 parent fn2-c-source-control fn2-c-source-readers))
      ((mv exclusive fn2-c-source-control) (fn2-c-source-writer-poll 7 40 11 31 51 61 fn2-c-source-control))
      ((mv deadparent & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire-under 1 0 0 parent fn2-c-source-control fn2-c-source-readers)))
  (mv (and (eq childdone :ok) (eq again :ok) (< child newer) (eq oldchild :stale)
           (eq finishchild :ok) (eq stillwaiting :waiting) (eq finishrequest :ok)
           (equal wake 40) (equal wakegen 11) (eq exclusive :exclusive) (eq deadparent :parent)
           (fn2-c-source-count-invariant-p fn2-c-source-control fn2-c-source-readers)
           (fn2-c-source-writer-exclusive-p 7 40 11 31 51 61 fn2-c-source-control))
      fn2-c-source-control fn2-c-source-readers)))
(assert-event

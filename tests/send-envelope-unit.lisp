; Actual issued Send -> native normalization -> replay -> observed peer bytes.
(in-package "ACL2")
(include-book "input-prefix-unit")
(defun fn2-send-envelope-run (status peer bad-source fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv ready & & taken caps fn2-core) (fn2-input-prefix-fixture fn2-core))
      ((unless ready) (mv nil fn2-core))
      ((mv code rs rg fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
      ((unless (eq code :ok)) (mv nil fn2-core))
      ((mv w0 fn2-core) (fn2-core-write rs rg 0 70 1 0 1 fn2-core))
      ((mv w1 fn2-core) (fn2-core-write rs rg 1 71 1 0 1 fn2-core))
      ((unless (and (eq w0 :ok) (eq w1 :ok))) (mv nil fn2-core))
      ((mv code op gen fn2-core) (fn2-issue-send 1 1 rs rg 0 2 0 1 0 1 0 fn2-core))
      ((unless (eq code :ok)) (mv nil fn2-core))
      ((mv verdict taken caps fn2-core) (fn2-input-prefix-take op gen taken caps fn2-core))
      ((unless (eq verdict :pass)) (mv nil fn2-core))
      ((mv outcome reason count aux0 aux1) (fn2-host-result *fn2-action-send* status 2 0 2 nil))
      (octets (if (eq status :cancelled) nil (if bad-source '(70 99) '(70 71))))
      (post (list :post 0 op gen *fn2-event-send-result* outcome reason count aux0 aux1
                   *fn2-peer-family-none* '(0 0 0 0 0) octets))
      ((mv verdict taken caps fn2-core) (fn2-envelope-prefix (list post) 0 t taken caps fn2-core))
      (- taken)
      ((when bad-source) (mv (equal verdict '(:send-bytes 0)) fn2-core))
      (cap (fn2-envelope-get '(1 . 1) caps))
      (actual-peer (list (list '(1 . 1) nil peer nil 119)))
      (result (fn2-envelope-bytes caps actual-peer))
      (expected (if (eq status :ok) (equal peer '(70 71))
                  (member-equal peer '(nil (70) (70 71))))))
  (mv (and (eq verdict :pass) (= count 2)
           (= outcome (cond ((eq status :ok) *fn2-outcome-done*)
                            ((eq status :cancelled) *fn2-outcome-cancelled*)
                            (t *fn2-outcome-failed*)))
           (equal (reverse (nth 3 cap)) '(70 71))
           (equal (nth 8 cap) (list (cons (if (eq status :ok) :exact :prefix) '(70 71))))
           (if expected (eq result :pass) (equal result '(:send-not-client 119)))) fn2-core)))
(defun fn2-send-envelope-check (status peer bad-source)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (ok fn2-core) (fn2-send-envelope-run status peer bad-source fn2-core) ok)))
(assert-event
 (and (fn2-send-envelope-check :failed nil nil)
      (fn2-send-envelope-check :failed '(70) nil)
      (fn2-send-envelope-check :failed '(70 71) nil)
      (fn2-send-envelope-check :failed '(71) nil)
      (fn2-send-envelope-check :failed '(70 71 72) nil)
      (fn2-send-envelope-check :failed '(70) t)))
(assert-event
 (and (fn2-send-envelope-check :cancelled nil nil)
      (fn2-send-envelope-check :cancelled '(70) nil)
      (fn2-send-envelope-check :cancelled '(70 71) nil)
      (fn2-send-envelope-check :cancelled '(71) nil)
      (fn2-send-envelope-check :ok '(70 71) nil)
      (fn2-send-envelope-check :ok '(70) nil)))

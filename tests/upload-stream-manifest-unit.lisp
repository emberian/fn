; Actual codec bridge only. Digest/CV octets are typed synthetic inputs; this
; is not a hash, allocator, controller, IO or complete APPEND witness.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/upload-stream-manifest")
(include-book "column-snapshot-support")
(make-event (value (cons 'progn
 (append (fn2-test-column-snapshot-events 'fn2-fields (w state))
         (fn2-test-column-snapshot-events 'fn2-pool (w state))))))

(defun fn2-usm-fill (i end slot gen bytes fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- (nfix end) (nfix i)))))
 (if (>= (nfix i) (nfix end)) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen i (if bytes (mod (nfix i) 256) 0) 7 2 5 fn2-pool)
   (if (eq code :ok) (fn2-usm-fill (+ 1 (nfix i)) end slot gen bytes fn2-pool) (mv code fn2-pool)))))
(defun fn2-usm-read (n slot gen off fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix n)))
 (if (zp n) (mv t nil)
  (mv-let (code byte) (fn2-pool-read slot gen off 7 2 5 fn2-pool)
   (mv-let (ok rest) (fn2-usm-read (- n 1) slot gen (+ 1 (nfix off)) fn2-pool)
    (mv (and (eq code :ok) ok) (cons byte rest))))))
(defun fn2-usm-physical (left row fn2-fields)
 (declare (xargs :stobjs fn2-fields :verify-guards nil :measure (nfix left)))
 (if (zp left) nil
  (cons (list (fn2-fields-value row fn2-fields) (fn2-fields-status row fn2-fields)
              (fn2-fields-ref-slot row fn2-fields) (fn2-fields-ref-gen row fn2-fields)
              (fn2-fields-ref-off row fn2-fields) (fn2-fields-ref-len row fn2-fields))
        (fn2-usm-physical (- left 1) (+ 1 (nfix row)) fn2-fields))))
(defun fn2-usm-semantic (left row fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv t nil)
  (b* (((mv ok bytes) (fn2-usm-read (fn2-fields-ref-len row fn2-fields)
           (fn2-fields-ref-slot row fn2-fields) (fn2-fields-ref-gen row fn2-fields)
           (fn2-fields-ref-off row fn2-fields) fn2-pool))
       ((mv tail-ok tail) (fn2-usm-semantic (- left 1) (+ 1 (nfix row)) fn2-fields fn2-pool)))
   (mv (and ok tail-ok)
    (cons (list (fn2-fields-value row fn2-fields) (fn2-fields-status row fn2-fields)
                (fn2-fields-ref-len row fn2-fields) bytes) tail)))))

(defun fn2-usm-body (fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init 128 fn2-fields))
      (fn2-pool (fn2-pool-init '((2 . 4096)) 1 100 fn2-pool))
      ((mv p page pg fn2-pool) (fn2-pool-reserve 0 7 2 5 fn2-pool))
      ((mv h hashes hg fn2-pool) (fn2-pool-reserve 0 7 2 5 fn2-pool))
      ((mv zero fn2-pool) (fn2-usm-fill 0 1024 page pg nil fn2-pool))
      ((mv filled fn2-pool) (fn2-usm-fill 0 64 hashes hg t fn2-pool))
      ((mv first first-end fn2-fields fn2-pool)
       (fn2-am-put-entry 0 15 4096 47 37 41 hashes hg 0 page pg 512 7 2 5 fn2-fields fn2-pool))
      ((mv second source-end fn2-fields fn2-pool)
       (fn2-am-put-entry 0 16 97 48 37 42 hashes hg 0 page pg first-end 7 2 5 fn2-fields fn2-pool))
      (whole (and (equal (list p h zero filled first second) (make-list 6 :initial-element :ok))
       (fn2-fieldsp fn2-fields) (fn2-fields-wfp fn2-fields)
       (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool) (fn2-pool-semanticp fn2-pool)
       (= *fn2-am-entry-max* *fn2-format-source-manifest-entry-max-size*)
       (<= (+ 64 *fn2-am-entry-max*) 512) (< 512 first-end) (< first-end source-end)
       (eq (fn2-pool-workspace-code page pg 7 2 5 fn2-pool) :ok)))
      ((mv before-ok before) (fn2-usm-read (- source-end 512) page pg 512 fn2-pool))
      ((mv copied next end fn2-fields fn2-pool)
       (fn2-upload-repack-entry-children 0 page pg 512 source-end page pg 64 7 2 5 fn2-fields fn2-pool))
      (held-refs (fn2-usm-physical *fn2-am-entry-fields* 0 fn2-fields))
      ((mv src next2 & & & & & fn2-fields)
       (fn2-am-get-entry 32 page pg 512 source-end 7 2 5 fn2-fields fn2-pool))
      ((mv dst end2 & & & & & fn2-fields)
       (fn2-am-get-entry 64 page pg 64 end 7 2 5 fn2-fields fn2-pool))
      ((mv source-ok source-values) (fn2-usm-semantic *fn2-am-entry-fields* 32 fn2-fields fn2-pool))
      ((mv dest-ok dest-values) (fn2-usm-semantic *fn2-am-entry-fields* 64 fn2-fields fn2-pool))
      ((mv after-ok after) (fn2-usm-read (- source-end 512) page pg 512 fn2-pool))
      ((mv canonical-ok canonical) (fn2-usm-read (- end 64) page pg 64 fn2-pool))
      ((mv original-ok original) (fn2-usm-read (- first-end 512) page pg 512 fn2-pool))
      (preserved (and before-ok after-ok canonical-ok original-ok (equal before after)
        (equal canonical original) (equal held-refs (fn2-usm-physical *fn2-am-entry-fields* 32 fn2-fields))
        source-ok dest-ok (equal source-values dest-values)))
      (snapshot (list (fn2-test-table-snapshot-fn2-fields fn2-fields)
                      (fn2-test-table-snapshot-fn2-pool fn2-pool)))
      ((mv owner no ne fn2-fields fn2-pool)
       (fn2-upload-repack-entry-children 0 page pg 512 source-end page pg 64 7 3 5 fn2-fields fn2-pool))
      (owner-kept (equal snapshot (list (fn2-test-table-snapshot-fn2-fields fn2-fields)
                                       (fn2-test-table-snapshot-fn2-pool fn2-pool))))
      ; This overlaps the FUTURE provisional entry, beyond the current
      ; digest/CV refs: the encoder's current-ref alias check cannot replace
      ; protection of the complete remaining input span.
      ((mv overlap oo oe fn2-fields fn2-pool)
       (fn2-upload-repack-entry-children 0 page pg 512 source-end page pg (+ first-end 1) 7 2 5 fn2-fields fn2-pool))
      (overlap-kept (equal snapshot (list (fn2-test-table-snapshot-fn2-fields fn2-fields)
                                         (fn2-test-table-snapshot-fn2-pool fn2-pool))))
      ((mv bounds bo be fn2-fields fn2-pool)
       (fn2-upload-repack-entry-children 0 page pg -1 source-end page pg 64 7 2 5 fn2-fields fn2-pool)))
  (mv (and whole (eq copied :ok) (= next first-end) (< next source-end)
       (= (- end 64) (- first-end 512)) (eq src :ok) (= next2 first-end) (eq dst :ok) (= end2 end) preserved
       (eq owner :owner) (= no 0) (= ne 0) owner-kept
       (eq overlap :overlap) (= oo 0) (= oe 0) overlap-kept
       (eq bounds :bounds) (= bo 0) (= be 0)
       (equal snapshot (list (fn2-test-table-snapshot-fn2-fields fn2-fields)
                             (fn2-test-table-snapshot-fn2-pool fn2-pool)))) fn2-fields fn2-pool)))

(defun fn2-usm-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (answer fn2-fields)
   (with-local-stobj fn2-pool
    (mv-let (answer fn2-fields fn2-pool) (fn2-usm-body fn2-fields fn2-pool)
     (mv answer fn2-fields))) answer)))

(assert-event (fn2-usm-run))

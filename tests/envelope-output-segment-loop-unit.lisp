(in-package "ACL2")
(include-book "../sim/envelope-output-segment-loop")
(defun fn2-eo-segment-loop-witness (mode bytes peer rest following corrupt-suffix)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-envelope-output-state
  (mv-let (ok fn2-envelope-output-state)
   (let* ((suffix (fn2-eo-language-row following peer))
          (expected (fn2-eo-language-row
                     (cons (cons mode (revappend bytes rest)) following) peer))
          (fn2-envelope-output-state (update-fn2-eo-phase 7 fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-peer peer fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-bytes bytes fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-prefix (eq mode :prefix) fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-segments '((:exact 9)) fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-suffix (if corrupt-suffix nil suffix) fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-row (fn2-eo-language-row (cons (cons mode rest) following) peer) fn2-envelope-output-state))
          (antecedent
           (and (equal (fn2-eo-phase fn2-envelope-output-state) 7)
                t
                (fn2-eo-octets-p (fn2-eo-bytes fn2-envelope-output-state))
                (fn2-eo-octets-p (fn2-eo-peer fn2-envelope-output-state))
                (fn2-eo-octets-p rest) (fn2-eo-segments-p following)
                (equal (fn2-eo-suffix fn2-envelope-output-state)
                       (fn2-eo-language-row following (fn2-eo-peer fn2-envelope-output-state)))
                (equal (fn2-eo-row fn2-envelope-output-state)
                       (fn2-eo-language-row
                        (cons (cons (if (fn2-eo-prefix fn2-envelope-output-state) :prefix :exact) rest) following)
                        (fn2-eo-peer fn2-envelope-output-state)))))
          (fn2-envelope-output-state (fn2-envelope-output-run (+ 1 (* (len bytes) (+ 4 (len peer) (len peer)))) fn2-envelope-output-state)))
    (mv (and (equal (fn2-eo-phase fn2-envelope-output-state) 5)
             (equal (fn2-eo-bytes fn2-envelope-output-state) nil)
             (equal (fn2-eo-peer fn2-envelope-output-state) peer)
             (equal (fn2-eo-prefix fn2-envelope-output-state) (eq mode :prefix))
             (equal (fn2-eo-segments fn2-envelope-output-state) '((:exact 9)))
             (equal (fn2-eo-suffix fn2-envelope-output-state) (if corrupt-suffix nil suffix))
             (if corrupt-suffix
                 (and (not antecedent) (not (equal (fn2-eo-row fn2-envelope-output-state) expected)))
               (and antecedent (equal (fn2-eo-row fn2-envelope-output-state) expected))))
        fn2-envelope-output-state)) ok)))

(assert-event
 (and (fn2-eo-segment-loop-witness :exact '(2 1) '(1 2 3) nil '((:exact 3)) nil)
      (fn2-eo-segment-loop-witness :prefix '(1 3) '(2) nil '((:exact 2)) nil)
      (fn2-eo-segment-loop-witness :exact nil '(2) nil '((:exact 2)) nil)
      (fn2-eo-segment-loop-witness :prefix '(1) nil nil nil nil)
      (fn2-eo-segment-loop-witness :exact '(1) nil nil nil nil)))
(assert-event (fn2-eo-segment-loop-witness :prefix '(1) '(2) nil '((:exact 2)) t))

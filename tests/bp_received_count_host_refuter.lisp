; Actual native callback selector, recording core only; no network/disk/grant.
(require :sb-posix)
(require :sb-bsd-sockets)
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(defvar *count-answer* '(:counted 7 3))
(defvar *calls* nil)
(defun fnn-core (subject &rest args)
 (push (cons subject args) *calls*)
 (case subject
  (fn-tcl-final-held-count *count-answer*)
  (fn-tcl-final-count-ready-p (eq (car (first args)) :counted))
  (fn-tcl-final-count-value (third (first args)))
  (otherwise (error "unexpected recording core subject ~s" subject))))
(defun fnn-fault (&rest args) (error "fault ~s" args))
(defun fnn-register-verb (&rest ignored) (declare (ignore ignored)) nil)
(load "host/native/tcpcl.lisp")
(let* ((conn (make-fnn-tcl-conn :held '((:xfer-ack 3 7 3))))
       (bytes (list 65)) (seen nil)
       (*fnn-tcl-deliver* (lambda (&rest ignored)
          (declare (ignore ignored)) (error "old callback must not select")))
       (*fnn-tcl-deliver-counted*
        (lambda (actual id input count)
          (assert (eq actual conn)) (assert (= id 7))
          (assert (eq input bytes)) (assert (= count 3))
          (setf seen t) '(:refused :recording-only))))
 ;; A cyclic source deliberately cannot be measured by LENGTH. Caller must
 ;; preserve its exact reference and take count solely from the core result.
 (setf (cdr bytes) bytes)
 (assert (equal (fnn-tcl-deliver-transfer conn 7 bytes) '(:refused :recording-only)))
 (assert seen)
 (setf seen nil)
 (let ((*count-answer* '(:refused :complete-count-unavailable)))
  (assert (handler-case (progn (fnn-tcl-deliver-transfer conn 7 bytes) nil)
            (error () t))))
 (assert (not seen))
 (let ((*fnn-tcl-deliver-counted* nil)
       (*fnn-tcl-deliver* (lambda (actual id input)
         (assert (eq actual conn)) (assert (= id 7)) (assert (eq input bytes))
         '(:refused :old-recording)))
       (*calls* nil))
  (assert (equal (fnn-tcl-deliver-transfer conn 7 bytes) '(:refused :old-recording)))
  (assert (null *calls*))))
(format t "PASS actual counted callback/no source scan/refusal/legacy selector recording~%")

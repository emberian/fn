; Shared two-span envelope controls, separate from codec-specific status policy.
(in-package "ACL2")
(include-book "../books/codec-transport")
(include-book "std/testing/must-fail" :dir :system)
(include-book "std/util/bstar" :dir :system)

(assert-event (fn2-codec-span-p 7 3 10 4))
(assert-event (not (fn2-codec-span-p 7 4 10 4)))
(assert-event (not (fn2-codec-span-p 0 5 10 4)))
(assert-event (not (fn2-codec-span-p #xffffffff 1 #xffffffff 4)))
(assert-event (fn2-codec-transfer-counts-p 3 7 4 8))
(assert-event (not (fn2-codec-transfer-counts-p 5 7 4 8)))
(assert-event (not (fn2-codec-transfer-counts-p 3 9 4 8)))
(assert-event (not (fn2-codec-transfer-counts-p -1 0 4 8)))

(defcodec-transport fn2-codec-probe ((mode :u8) (quantum :u32)))
(defcodec-transport-operations fn2-codec-probe)
(defcodec-transport-lifecycle fn2-codec-probe)
(defun fn2-codec-probe-control (fn2-codec-probe)
 (declare (xargs :stobjs fn2-codec-probe :verify-guards nil))
 (let* ((fn2-codec-probe (fn2-codec-probe-init 1 fn2-codec-probe))
        (fn2-codec-probe (fn2-codec-probe-put 0
          (cap 7) (nonce 17) (slot 3) (generation 9) (serial 11) (pending 2))))
  (let* ((matched (and (fn2-codec-probe-match-p 7 17 3 9 11 fn2-codec-probe)
                       (not (fn2-codec-probe-match-p 8 17 3 9 11 fn2-codec-probe))
                       (not (fn2-codec-probe-match-p 7 18 3 9 11 fn2-codec-probe))
                       (not (fn2-codec-probe-match-p 7 17 4 9 11 fn2-codec-probe))
                       (not (fn2-codec-probe-match-p 7 17 3 10 11 fn2-codec-probe))
                       (not (fn2-codec-probe-match-p 7 17 3 9 10 fn2-codec-probe))))
         (fn2-codec-probe (fn2-codec-probe-put 0 (pending 0))))
   (mv (and matched (not (fn2-codec-probe-match-p 7 17 3 9 11 fn2-codec-probe))) fn2-codec-probe))))

(defun fn2-codec-probe-check ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-codec-probe
  (mv-let (ok fn2-codec-probe) (fn2-codec-probe-control fn2-codec-probe) ok)))
(assert-event (fn2-codec-probe-check))
(must-fail (defcodec-transport fn2-codec-bad ((cap :u32))))

(defun fn2-codec-probe-transfer (fn2-codec-probe)
 (declare (xargs :stobjs fn2-codec-probe :verify-guards nil))
 (let* ((fn2-codec-probe (fn2-codec-probe-init 1 fn2-codec-probe))
        (fn2-codec-probe (fn2-codec-probe-put 0
          (cap 7) (nonce 17) (alive 1) (handle-id 4096) (cleanup-credit 1)
          (terminal 3) (mode 7) (quantum 4) (input-length 4) (input-offset 1))))
  (mv-let (selected serial fn2-codec-probe)
   (fn2-codec-probe-select 7 17 3 9 10 2 1 3 4 3 0 4 4 fn2-codec-probe)
   (mv-let (too-many fn2-codec-probe)
    (fn2-codec-probe-observe-spans 7 17 3 9 serial 0 4 3 0 fn2-codec-probe)
    (let ((refused (and (eq selected :ok) (eq too-many :bounds)
                       (= (fn2-codec-probe-pending 0 fn2-codec-probe) 10)
                       (= (fn2-codec-probe-input-offset 0 fn2-codec-probe) 1)
                       (= (fn2-codec-probe-output-length 0 fn2-codec-probe) 0)
                       (= (fn2-codec-probe-raw-used 0 fn2-codec-probe) 4))))
     (mv-let (observed fn2-codec-probe)
      (fn2-codec-probe-observe-spans 7 17 3 9 serial 0 2 3 0 fn2-codec-probe)
      (mv-let (duplicate fn2-codec-probe)
       (fn2-codec-probe-observe-spans 7 17 3 9 serial 0 2 3 0 fn2-codec-probe)
       (mv (and refused (eq observed :ok) (eq duplicate :stale)
                (= (fn2-codec-probe-mode 0 fn2-codec-probe) 7)
                (= (fn2-codec-probe-pending 0 fn2-codec-probe) 0)
                (= (fn2-codec-probe-input-offset 0 fn2-codec-probe) 3)
                (= (fn2-codec-probe-output-length 0 fn2-codec-probe) 3)
                (= (fn2-codec-probe-output-offset 0 fn2-codec-probe) 0)
                (fn2-codec-probe-wfp fn2-codec-probe)) fn2-codec-probe))))))))
(defun fn2-codec-probe-transfer-check ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-codec-probe
  (mv-let (ok fn2-codec-probe) (fn2-codec-probe-transfer fn2-codec-probe) ok)))
(assert-event (fn2-codec-probe-transfer-check))

(defun fn2-codec-probe-begin-control (fn2-codec-probe)
 (declare (xargs :stobjs fn2-codec-probe :verify-guards nil))
 (mv-let (begun fn2-codec-probe)
  (fn2-codec-probe-begin 7 17 3 9 #xffffffff #xffffffff 1 1 512 4294967297 fn2-codec-probe)
  (let* ((admitted (and (eq begun :ok) (= (fn2-codec-probe-budget 0 fn2-codec-probe) 4294967297)
                        (= (fn2-codec-probe-seed-total 0 fn2-codec-probe) #xffffffff)))
         (fn2-codec-probe (fn2-codec-probe-put 0 (pending 8))))
   (mv-let (rebound fn2-codec-probe)
    (fn2-codec-probe-begin 7 18 4 10 0 8 1 1 512 2 fn2-codec-probe)
    (mv (and admitted (eq rebound :state)
             (= (fn2-codec-probe-pending 0 fn2-codec-probe) 8)
             (= (fn2-codec-probe-nonce 0 fn2-codec-probe) 17)
             (= (fn2-codec-probe-alive 0 fn2-codec-probe) 0)) fn2-codec-probe)))))
(defun fn2-codec-probe-begin-check ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-codec-probe
  (mv-let (ok fn2-codec-probe) (fn2-codec-probe-begin-control fn2-codec-probe) ok)))
(assert-event (fn2-codec-probe-begin-check))

(defcodec-operation fn2-codec-op-probe ((policy-status :u8)))
(defun fn2-codec-op-progress-control (fn2-codec-op-probe)
 (declare (xargs :stobjs fn2-codec-op-probe :verify-guards nil))
 (b* (((mv bind fn2-codec-op-probe) (fn2-codec-op-probe-bind 7 17 3 9 10 fn2-codec-op-probe))
      ((mv selected fn2-codec-op-probe) (fn2-codec-op-probe-request 1 13 4 0 fn2-codec-op-probe))
      ((mv stale fn2-codec-op-probe) (fn2-codec-op-probe-observe 2 4 0 fn2-codec-op-probe))
      (unchanged (and (= (fn2-codec-op-probe-source-progress 0 fn2-codec-op-probe) 0)
                      (= (fn2-codec-op-probe-pending-serial 0 fn2-codec-op-probe) 1)))
      ((mv oversized fn2-codec-op-probe) (fn2-codec-op-probe-observe 1 5 0 fn2-codec-op-probe))
      ((mv observed fn2-codec-op-probe) (fn2-codec-op-probe-observe 1 3 0 fn2-codec-op-probe))
      ((mv duplicate fn2-codec-op-probe) (fn2-codec-op-probe-observe 1 3 0 fn2-codec-op-probe))
      ; Immediate duplicate refusal is insufficient: an old serial must not
      ; reserve a fresh request after the first request has been observed.
      ((mv replay-request fn2-codec-op-probe) (fn2-codec-op-probe-request 1 13 4 0 fn2-codec-op-probe))
      ((mv rebound fn2-codec-op-probe) (fn2-codec-op-probe-bind 7 17 3 9 10 fn2-codec-op-probe))
      (retained (= (fn2-codec-op-probe-source-progress 0 fn2-codec-op-probe) 3))
      ((mv next fn2-codec-op-probe) (fn2-codec-op-probe-request 2 13 4 0 fn2-codec-op-probe))
      ((mv replay-completion fn2-codec-op-probe) (fn2-codec-op-probe-observe 1 3 0 fn2-codec-op-probe))
      (new-request-retained (and (= (fn2-codec-op-probe-source-progress 0 fn2-codec-op-probe) 3)
                                 (= (fn2-codec-op-probe-pending-serial 0 fn2-codec-op-probe) 2)))
      ((mv finish fn2-codec-op-probe) (fn2-codec-op-probe-observe 2 4 0 fn2-codec-op-probe))
      ((mv overflow fn2-codec-op-probe) (fn2-codec-op-probe-request 3 13 4 0 fn2-codec-op-probe))
      ((mv wrong-generation fn2-codec-op-probe) (fn2-codec-op-probe-bind 7 17 3 10 10 fn2-codec-op-probe)))
  (mv (and (eq bind :ok) (eq selected :ok) (eq stale :bounds) unchanged
           (eq oversized :bounds) (eq observed :ok) (eq duplicate :bounds)
           (eq replay-request :bounds) (eq rebound :ok) retained (eq next :ok) (eq replay-completion :bounds) new-request-retained (eq finish :ok)
           (eq overflow :bounds) (eq wrong-generation :stale)
           (= (fn2-codec-op-probe-source-progress 0 fn2-codec-op-probe) 7)
           (= (fn2-codec-op-probe-sink-progress 0 fn2-codec-op-probe) 0)
           (= (fn2-codec-op-probe-pending-serial 0 fn2-codec-op-probe) 0))
      fn2-codec-op-probe)))
(defun fn2-codec-op-progress-check ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-codec-op-probe
  (mv-let (ok fn2-codec-op-probe) (fn2-codec-op-progress-control fn2-codec-op-probe) ok)))
(assert-event (fn2-codec-op-progress-check))

; A no-handshake codec uses the SAME generated allocation/copy/free machine.
(defcodec-transport-upgrade fn2-codec-probe fn2-codec-copy-plan :status-field nil)
(defun fn2-codec-upgrade-control (fn2-codec-probe)
 (declare (xargs :stobjs fn2-codec-probe :verify-guards nil))
 (b* (((mv bind fn2-codec-probe) (fn2-codec-probe-begin 7 17 3 9 5 5 4 4 512 3 fn2-codec-probe))
      ((mv alloc action off count serial fn2-codec-probe) (fn2-codec-probe-next 0 0 fn2-codec-probe))
      (allocation (and (eq alloc :act) (equal (list action off count) '(8 512 0))))
      ((mv observed & fn2-codec-probe) (fn2-codec-probe-observe-lifecycle 7 17 3 9 serial 4096 0 0 fn2-codec-probe))
      ((mv copy1 action off count serial fn2-codec-probe) (fn2-codec-probe-next 0 0 fn2-codec-probe))
      (first (and (eq copy1 :act) (equal (list action off count) '(1 0 4))))
      ((mv observed1 & fn2-codec-probe) (fn2-codec-probe-observe-lifecycle 7 17 3 9 serial 4 0 0 fn2-codec-probe))
      ((mv copy2 action off count serial fn2-codec-probe) (fn2-codec-probe-next 0 0 fn2-codec-probe))
      (second (and (eq copy2 :act) (equal (list action off count) '(1 4 1))))
      ((mv observed2 & fn2-codec-probe) (fn2-codec-probe-observe-lifecycle 7 17 3 9 serial 1 0 0 fn2-codec-probe))
      ((mv done & & & & fn2-codec-probe) (fn2-codec-probe-next 0 0 fn2-codec-probe))
      ((mv handed copied fed il io ol oo fn2-codec-probe) (fn2-codec-probe-handoff 7 17 3 9 fn2-codec-probe))
      (handoff (and (eq done :done) (eq handed :ok) (= copied 5) (= fed 0) (= il io) (= ol oo)))
      ((mv closing fn2-codec-probe) (fn2-codec-probe-retire 7 17 fn2-codec-probe))
      ((mv free action off count serial fn2-codec-probe) (fn2-codec-probe-next 0 0 fn2-codec-probe))
      (cleanup (and (eq closing :closing) (eq free :cleanup) (equal (list action off count) '(9 0 0))
                    (= (fn2-codec-probe-budget 0 fn2-codec-probe) 0)))
      ((mv freed & fn2-codec-probe) (fn2-codec-probe-observe-lifecycle 7 17 3 9 serial 0 0 0 fn2-codec-probe))
      ((mv retired & & & & fn2-codec-probe) (fn2-codec-probe-next 0 0 fn2-codec-probe)))
  (mv (and (eq bind :ok) allocation (eq observed :ok) first (eq observed1 :ok)
           second (eq observed2 :ok) handoff cleanup (eq freed :ok) (eq retired :retired)
           (= (fn2-codec-probe-alive 0 fn2-codec-probe) 0)) fn2-codec-probe)))
(defun fn2-codec-upgrade-check ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-codec-probe
  (mv-let (ok fn2-codec-probe) (fn2-codec-upgrade-control fn2-codec-probe) ok)))
(assert-event (fn2-codec-upgrade-check))


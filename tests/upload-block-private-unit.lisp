; Actual shared CHILDREN bodies, typed owned pool, partial B3 contexts.
; No actor phase is seeded; core wrapper phase gates and rolling remain unrun.
(in-package "ACL2")
(include-book "upload-dual-hash-unit")
(include-book "../books/upload-block-private")
(defun fn2-ubp-context (source scratch fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((all (fn2-udh-snapshot scratch fn2-core)))
  (append (take 5 all)
   (list (fn2-udh-trim-columns (fn2-digest-slot source *fn2-fc-result*) 1 (nth 5 all))))))
(defun fn2-ubp-keep (row source ls lg off len fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-b3 (fn2-core-b3 fn2-core)) (fn2-digests (fn2-core-digests fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
  (code fn2-b3 fn2-digests)
  (fn2-upload-hash-private-children row source ls lg off len *fn2-upload-kind* 0 1 fn2-b3 fn2-digests fn2-pool)
  (mv code fn2-core)))
(defun fn2-ubp-overwrite (scratch slot lease len fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-b3 (fn2-core-b3 fn2-core)) (fn2-digests (fn2-core-digests fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
  (code fn2-b3 fn2-digests)
  (fn2-block-hash-into scratch slot lease 0 len *fn2-upload-kind* 0 1 fn2-b3 fn2-digests fn2-pool)
  (mv code fn2-core)))
(defun fn2-ubp-store (source ls lg target fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
  (code fn2-pool)
  (fn2-digest-store 32 (fn2-digest-slot source *fn2-fc-result*) ls lg target *fn2-upload-kind* 0 1 fn2-digests fn2-pool)
  (mv code fn2-core)))
(defun fn2-ubp-private (source fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-digests (fn2-core-digests fn2-core))) (words)
  (fn2-digest-list (fn2-digest-slot source *fn2-fc-result*) fn2-digests) words))
(defun fn2-ubp-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-txn-posting-profile* fn2-core))
      (source (fn2-b-upload-source-hash-row 0)) (stored (fn2-b-upload-stored-hash-row 0))
      (scratch (fn2-b-block-read-row (fn2-b-format-slots *fn2-txn-posting-profile*)))
      (original (repeat 700 65)) (wire (repeat 800 66)) (block (repeat 4096 67))
      ((mv a os og fn2-core) (fn2-core-reserve 2 *fn2-upload-kind* 0 1 fn2-core))
      ((mv b ss sg fn2-core) (fn2-core-reserve 2 *fn2-upload-kind* 0 1 fn2-core))
      ((mv c ls lg fn2-core) (fn2-core-reserve 2 *fn2-upload-kind* 0 1 fn2-core))
      ((mv aw fn2-core) (fn2-udh-write original os og 0 fn2-core))
      ((mv bw fn2-core) (fn2-udh-write wire ss sg 0 fn2-core))
      ((mv zero fn2-core) (fn2-udh-zero (+ 2 (ceiling *fn2-upload-page-manifest* 4096))
                             (+ *fn2-upload-page-manifest* 4096) ls lg fn2-core))
      ((mv cw fn2-core) (fn2-udh-write block ls lg *fn2-upload-page-stage* fn2-core))
      (whole (and (fn2-core-wfp fn2-core) (< source stored) (< stored scratch)
       (not (= os ss)) (not (= os ls)) (not (= ss ls))
       (= *fn2-fc-result* 125) (= *fn2-b3-result* 57)
       (= *fn2-storage-extent-units* 16) (= *fn2-commit-write-resources* 3)
       (equal (list a b c aw bw zero cw) (repeat 7 :ok))
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (owned)
        (and (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool) (fn2-pool-semanticp fn2-pool)
         (eq (fn2-pool-workspace-code os og *fn2-upload-kind* 0 1 fn2-pool) :ok)
         (eq (fn2-pool-workspace-code ss sg *fn2-upload-kind* 0 1 fn2-pool) :ok)
         (eq (fn2-pool-workspace-code ls lg *fn2-upload-kind* 0 1 fn2-pool) :ok)) owned)))
      ((mv start fn2-core) (fn2-upload-hash-begin source fn2-core))
      ((mv prefix used fn2-core) (fn2-upload-hash-step source os og 0 111 0 1 fn2-core))
      ((mv storedprefix fn2-core) (fn2-upload-stored-hash stored ss sg 0 0 173 nil ls lg *fn2-upload-kind* 0 1 fn2-core))
      (before (fn2-ubp-context source scratch fn2-core))
      ((mv keep fn2-core) (fn2-ubp-keep scratch source ls lg *fn2-upload-page-stage* 4096 fn2-core))
      (kept (fn2-ubp-private source fn2-core))
      ((mv overwrite fn2-core) (fn2-ubp-overwrite scratch os og 700 fn2-core))
      (private-kept (equal kept (fn2-ubp-private source fn2-core)))
      ((mv save fn2-core) (fn2-ubp-store source ls lg *fn2-upload-page-hash* fn2-core))
      (hash-ok (equal (fn2-udh-read 32 ls lg *fn2-upload-page-hash* fn2-core) (fn-blake3 block)))
      ; Hypothesis removal: using shared F-2 after the same interleaving loses
      ; the block hash. This is a real digest-store, not an invented result.
      ((mv old fn2-core)
       (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
        (fn2-digest-store 32 (fn2-digest-slot scratch *fn2-b3-result*) ls lg 64 *fn2-upload-kind* 0 1 fn2-digests fn2-pool)
        (mv code fn2-core)))
      (old-lost (not (equal (fn2-udh-read 32 ls lg 64 fn2-core) (fn-blake3 block))))
      ((mv cv fn2-core)
       (stobj-let ((fn2-digests (fn2-core-digests fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (code fn2-digests)
        (fn2-upload-cv-private-children source ls lg 1 *fn2-upload-kind* 0 1 fn2-digests fn2-pool) (mv code fn2-core)))
      (cvkept (fn2-ubp-private source fn2-core))
      ((mv overwrite2 fn2-core) (fn2-ubp-overwrite scratch ss sg 800 fn2-core))
      ((mv savecv fn2-core) (fn2-ubp-store source ls lg (+ 32 *fn2-upload-page-hash*) fn2-core))
      (cv-ok (equal (fn2-udh-read 32 ls lg (+ 32 *fn2-upload-page-hash*) fn2-core)
                    (fn-b3-words-octets (fn-b3-output-cv (fn-b3-node *fn2-b3-iv* block 4 0)))))
      (contexts-kept (equal before (fn2-ubp-context source scratch fn2-core)))
      ((mv resumed used2 fn2-core) (fn2-upload-hash-step source os og 111 589 0 1 fn2-core))
      (private-update-kept (equal cvkept (fn2-ubp-private source fn2-core)))
      ((mv ended fn2-core) (fn2-upload-hash-end source fn2-core))
      ((mv savedsource fn2-core) (fn2-upload-digest-store source ls lg 0 0 1 fn2-core))
      ((mv storedend fn2-core) (fn2-upload-stored-hash stored ss sg 173 173 627 t ls lg *fn2-upload-kind* 0 1 fn2-core))
      (streams-ok (and (equal (fn2-udh-read 32 ls lg 0 fn2-core) (fn-blake3 original))
       (equal (fn2-udh-read 32 ls lg *fn2-upload-page-stored-source* fn2-core) (fn-blake3 wire))))
      ; Original SOURCE is complete; the root operation may now reuse it.
      ((mv rootkeep fn2-core) (fn2-ubp-keep source source ls lg *fn2-upload-page-manifest* 4096 fn2-core))
      ((mv overwrite3 fn2-core) (fn2-ubp-overwrite scratch os og 700 fn2-core))
      ((mv rootsave fn2-core) (fn2-ubp-store source ls lg *fn2-upload-page-location-hashes* fn2-core)))
  (mv (and whole private-kept hash-ok old-lost cv-ok contexts-kept private-update-kept streams-ok
       (= used 111) (= used2 589)
       (equal (list start prefix storedprefix keep overwrite save old cv overwrite2 savecv resumed ended
                    savedsource storedend rootkeep overwrite3 rootsave) (repeat 17 :ok))
       (equal (fn2-udh-read 32 ls lg *fn2-upload-page-location-hashes* fn2-core) (fn-blake3 (repeat 4096 0)))
       (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))) fn2-core)))
(assert-event (with-local-stobj fn2-core
 (mv-let (ok fn2-core) (fn2-ubp-body fn2-core) ok)))

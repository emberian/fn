; Actual fresh NAME owner over the canonical served core. Boot phases here
; are explicit logical fixtures; physical image IO/recovery is not simulated.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "startup-genesis-unit")
(include-book "../books/executor")
(defconst *fn2-snu-profile*
 (put-assoc-equal :image-boot t
  (put-assoc-equal :groups '(("startup.alpha" . 1) ("startup.beta" . 2)) *fn2-sgu-profile*)))
(defun fn2-snu-drive (left id generation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :timeout nil fn2-core)
  (b* (((mv phase role cursor seq)
        (stobj-let ((fn2-genesis-names (fn2-core-genesis-names fn2-core))
                    (fn2-id-engine (fn2-core-id-engine fn2-core))) (phase role cursor seq)
         (mv (fn2-genesis-names-phase 0 fn2-genesis-names) (fn2-genesis-names-role 0 fn2-genesis-names)
             (fn2-genesis-names-cursor 0 fn2-genesis-names) (fn2-id-engine-seq 0 fn2-id-engine))
         (mv phase role cursor seq)))
       ((mv code fn2-core) (fn2-startup-name-step id generation fn2-core))
       (one-step (stobj-let ((fn2-genesis-names (fn2-core-genesis-names fn2-core))
                             (fn2-id-engine (fn2-core-id-engine fn2-core))) (one)
         (if (= phase *fn2-genesis-name-phase-inserting*)
             (and (= (fn2-genesis-names-role 0 fn2-genesis-names) role)
                  (= (fn2-genesis-names-cursor 0 fn2-genesis-names) (+ 1 cursor))
                  (= (fn2-id-engine-seq 0 fn2-id-engine) seq))
           (= (fn2-id-engine-seq 0 fn2-id-engine)
              (if (= phase *fn2-genesis-name-phase-closing*) (+ 1 seq) seq))) one))
       ((unless (and one-step (member-eq code '(:more :complete)))) (mv code nil fn2-core))
       ((when (eq code :complete)) (mv code t fn2-core))
       ((mv done ok fn2-core) (fn2-snu-drive (- left 1) id generation fn2-core)))
   (mv done ok fn2-core))))
(defun fn2-snu-body (bad fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-snu-profile* :echo nil fn2-core))
      (empty (fn2-sgu-name-state fn2-core))
      (id (fn2-machine-kind-base *fn2-boot-kind* fn2-core))
      (generation (fn2-machine-generation id fn2-core))
      (accounts (stobj-let ((fn2-accounts (fn2-core-accounts fn2-core))) (copy) (fn2-accounts-copy fn2-accounts) copy))
      (captured (stobj-let ((fn2-genesis-names (fn2-core-genesis-names fn2-core))) (capture)
                   (equal (fn2-genesis-names-groups fn2-genesis-names) (fn2-profile-get :groups *fn2-snu-profile*)) capture))
      ; Consume the real independent immutable-config cursor first. C's
      ; capture must remain intact until the actual fresh branch begins it.
      ((mv pop0 fn2-core) (fn2-boot-pop-config 0 fn2-core))
      ((mv pop1 fn2-core) (fn2-boot-pop-config 1 fn2-core))
      ((mv pop2 fn2-core) (fn2-boot-pop-config 2 fn2-core))
      (independent (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core))
                               (fn2-genesis-names (fn2-core-genesis-names fn2-core))) (independent)
         (and (null (fn2-boot-config-groups fn2-boot-config))
              (equal (fn2-genesis-names-groups fn2-genesis-names) (fn2-profile-get :groups *fn2-snu-profile*))) independent))
      ((unless (and captured independent (eq pop0 :ok) (eq pop1 :ok) (eq pop2 :ok)
                     (eq (fn2-boot-snapshot-read-code id fn2-core) :ok) (not (fn2-core-stopped-p fn2-core))
                     (equal empty (fn2-sgu-name-state fn2-core))))
       (mv nil fn2-core))
      (fn2-core (fn2-boot-put-core id (phase *fn2-boot-state-genesis-begin*) (stopped 0)))
      ((mv begun fn2-core) (fn2-startup-name-begin id generation fn2-core))
      ((unless (eq begun :ok)) (mv nil fn2-core))
      (horizon (stobj-let ((fn2-genesis-names (fn2-core-genesis-names fn2-core))) (n)
                  (+ (fn2-genesis-names-group-count fn2-genesis-names)
                     (len (fn2-genesis-names-principals fn2-genesis-names)) (* 2 2)) n))
      (fn2-core (fn2-boot-put-core id (phase *fn2-boot-state-genesis-step*)))
      ((mv opened fn2-core)
       (if (member-eq bad '(:actor-change :lease-change)) (fn2-startup-name-step id generation fn2-core) (mv :unused fn2-core)))
      ((unless (or (not (member-eq bad '(:actor-change :lease-change))) (eq opened :more))) (mv nil fn2-core))
      (fn2-core
       (cond ((eq bad :actor-change)
              (stobj-let ((fn2-accounts (fn2-core-accounts fn2-core))) (code fn2-accounts)
               (fn2-account-rebind 2 fn2-accounts)
               (if (eq code :ok) fn2-core (fn2-core-stop *fn2-stop-reason-engine-genesis* fn2-core))))
             ((eq bad :lease-change)
              (stobj-let ((fn2-genesis-names (fn2-core-genesis-names fn2-core))) (fn2-genesis-names)
               (fn2-genesis-names-set-gen 0 (+ 1 (fn2-genesis-names-gen 0 fn2-genesis-names)) fn2-genesis-names) fn2-core))
             (t fn2-core)))
      (before (fn2-sgu-full-state fn2-core))
      (before-names (fn2-sgu-name-state fn2-core))
      ((mv code one-step fn2-core)
       (if bad
           (mv-let (code fn2-core) (fn2-startup-name-step id (if (eq bad :generation) (+ 1 generation) generation) fn2-core)
            (mv code t fn2-core))
         (fn2-snu-drive horizon id generation fn2-core)))
      (after (fn2-sgu-full-state fn2-core))
      (after-names (fn2-sgu-name-state fn2-core))
      (finished (stobj-let ((fn2-genesis-names (fn2-core-genesis-names fn2-core))
                            (fn2-id-engine (fn2-core-id-engine fn2-core))
                            (fn2-overlays (fn2-core-overlays fn2-core))) (finished)
         (let* ((n (fn2-overlays-rows fn2-overlays))
                (g (fn2-idc-find-overlay n 0 *fn2-overlay-phase-frozen* *fn2-groups-sid* fn2-overlays))
                (p (fn2-idc-find-overlay n 0 *fn2-overlay-phase-frozen* *fn2-principals-sid* fn2-overlays)))
          (and (fn2-genesis-names-completep fn2-genesis-names)
               (= (fn2-genesis-names-phase 0 fn2-genesis-names) *fn2-genesis-name-phase-complete*)
               (null (fn2-genesis-names-groups fn2-genesis-names)) (null (fn2-genesis-names-principals fn2-genesis-names))
               (< g n) (< p n) (not (= g p)) (= (fn2-overlays-count g fn2-overlays) 2)
               (= (fn2-overlays-count p fn2-overlays) 2)
               (= (fn2-overlays-seq g fn2-overlays) 1) (= (fn2-overlays-seq p fn2-overlays) 2)
               (= (fn2-id-engine-seq 0 fn2-id-engine) 2))) finished))
      (same-accounts (stobj-let ((fn2-accounts (fn2-core-accounts fn2-core))) (same)
                       (equal accounts (fn2-accounts-copy fn2-accounts)) same))
      (uncertain (stobj-let ((fn2-genesis-names (fn2-core-genesis-names fn2-core))) (uncertain)
                     (= (fn2-genesis-names-phase 0 fn2-genesis-names) *fn2-genesis-name-phase-uncertain*) uncertain)))
  (mv (and one-step (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))
           (cond ((eq bad :lease-change) (and (eq code :uncertain) uncertain (equal before-names after-names) same-accounts))
                 (bad (and (eq code :owner) (equal before after)))
                 (t (and (eq code :complete) finished same-accounts (not (fn2-sealer-ready fn2-core)))))) fn2-core)))
(defun fn2-snu-run (bad)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-snu-body bad fn2-core) ok)))
(assert-event (fn2-snu-run nil))
(assert-event (fn2-snu-run :generation))
(assert-event (fn2-snu-run :actor-change))
(assert-event (fn2-snu-run :lease-change))
(defun fn2-snu-empty-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (put-assoc-equal :authority 0 (put-assoc-equal :groups nil *fn2-snu-profile*)))
      (fn2-core (fn2-init-executor profile :echo nil fn2-core))
      (id (fn2-machine-kind-base *fn2-boot-kind* fn2-core))
      (generation (fn2-machine-generation id fn2-core))
      (before (fn2-sgu-name-state fn2-core))
      (fn2-core (fn2-boot-put-core id (phase *fn2-boot-state-genesis-begin*) (stopped 0)))
      ((mv begun fn2-core) (fn2-startup-name-begin id generation fn2-core))
      (fn2-core (fn2-boot-put-core id (phase *fn2-boot-state-genesis-step*)))
      ((mv code one-step fn2-core) (fn2-snu-drive (* 2 2) id generation fn2-core))
      (after (fn2-sgu-name-state fn2-core))
      (complete (stobj-let ((fn2-genesis-names (fn2-core-genesis-names fn2-core))) (complete)
                  (fn2-genesis-names-completep fn2-genesis-names) complete)))
  (mv (and (eq begun :ok) (eq code :complete) one-step complete (equal before after)
           (not (fn2-core-stopped-p fn2-core)) (fn2-core-wfp fn2-core)) fn2-core)))
(defun fn2-snu-empty-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-snu-empty-body fn2-core) ok)))
(assert-event (fn2-snu-empty-run))

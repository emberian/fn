; Ephemeral raw-Lisp adversary, loaded after :q in a tools/acl2 batch.
; The production function is restored even if a control signals.
(in-package "ACL2")
(let* ((clear (symbol-function 'fn2-cns-clear-wait-timer))
       (setup (symbol-function 'fn2-cns-drain-setup))
       (q1 (symbol-function 'fn2-cns-drain-q1-run))
       (mode :off) (sibling nil) (reference nil) (counts (list 0 0)) (records nil))
  (unwind-protect
      (progn
        (setf (symbol-function 'fn2-cns-drain-setup)
              (lambda (held core)
                (multiple-value-bind (ok id other core) (funcall setup held core)
                  (setf sibling other)
                  (values ok id other core))))
        (setf (symbol-function 'fn2-cns-drain-q1-run)
              (lambda (core ref)
                (let ((old reference))
                  (setf reference ref)
                  (unwind-protect (funcall q1 core ref) (setf reference old)))))
        (setf (symbol-function 'fn2-cns-clear-wait-timer)
              (lambda (id core)
                (multiple-value-bind (code core) (funcall clear id core)
                  (when (and (eq code :ok) sibling (not (eql id sibling))
                             (or (eq mode :shared)
                                 (and (eq mode :concrete-only) (not (eq core reference)))))
                    ; Keep the target result/charges unchanged; clobber only
                    ; a protected sibling's semantic timer state.
                    (multiple-value-bind (other sched)
                        (fn2-sched-clear-deadline sibling (fn2-core-sched core))
                      (declare (ignore sched))
                      (assert (eq other :ok)))
                    (if (eq core reference) (incf (second counts)) (incf (first counts))))
                  (values code core))))
        (dolist (phase '(:baseline :shared :concrete-only :restored))
          (setf mode (if (member phase '(:shared :concrete-only)) phase :off)
                counts (list 0 0))
          (let* ((oracle (if (fn2-cns-drain-positive) :pass :fail))
                 (q1-result (fn2-cns-drain-q1-control))
                 (trace (if (and (first q1-result) (eq (second q1-result) :pass)
                                 (plusp (third q1-result))) :pass :fail)))
            (push (list phase trace oracle (first counts) (second counts)) records)
            (format t "CNS-INDEPENDENT ~S~%" (car records))))
        (setf records (reverse records))
        (assert (equal (first records) '(:baseline :pass :pass 0 0)))
        (assert (equal (fourth records) '(:restored :pass :pass 0 0)))
        (assert (and (equal (subseq (second records) 0 3) '(:shared :pass :fail))
                     (plusp (fourth (second records))) (plusp (fifth (second records)))))
        (assert (and (equal (subseq (third records) 0 3) '(:concrete-only :fail :fail))
                     (plusp (fourth (third records))) (zerop (fifth (third records)))))
        (format t "CNS-INDEPENDENT-CONTROLS PASS ~S~%" records))
    (setf (symbol-function 'fn2-cns-clear-wait-timer) clear
          (symbol-function 'fn2-cns-drain-setup) setup
          (symbol-function 'fn2-cns-drain-q1-run) q1)))

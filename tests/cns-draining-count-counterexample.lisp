; Executed refutation of the uncounted draft, not an initialized-state bug.
; The counted replacement retains the maintained pool-semanticp invariant.
(in-package "ACL2")
(include-book "cns-draining-contract-unit")
(defun fn2-cns-drain-count-counterexample-run (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (b* (((mv setup id & fn2-core) (fn2-cns-drain-setup nil fn2-core))
       (original-semantic (fn2-cns-drain-pool-semanticp fn2-core))
       (fn2-core
        (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (fn2-pool)
          (update-fn2-pool-class-countsi 0 (- (fn2-pool-rows fn2-pool) 1) fn2-pool) fn2-core))
       (semantic (fn2-cns-drain-pool-semanticp fn2-core))
       (before (fn2-test-core-snapshot fn2-core))
       (pre (and setup (fn2-corep fn2-core) (fn2-core-wfp fn2-core) (natp 4)
                 (fn2-cns-draining-reservedp before)
                 (fn2-cns-draining-domainp id before)))
       ((mv b s d r fn2-core) (fn2-cns-run id 4 fn2-core))
       (after (fn2-test-core-snapshot fn2-core))
       (post (fn2-cns-draining-resultp id before b s d r after)))
    (mv (list pre (not post) original-semantic (not semantic)
              (fn2-core-stop-reason fn2-core) (fn2-cns-row-phase id fn2-core)
              (fn2-cns-drain-cell 'fn2-pool-class-counts 0 (fn2-cns-drain-child 'fn2-pool before))
              (fn2-cns-drain-cell 'fn2-pool-class-counts 0 (fn2-cns-drain-child 'fn2-pool after)))
        fn2-core)))
(defun fn2-cns-drain-count-counterexample ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (result fn2-core) (fn2-cns-drain-count-counterexample-run fn2-core) result)))
(defun fn2-cns-drain-without-pool-accounting ()
  (declare (xargs :verify-guards nil))
  (let ((r (fn2-cns-drain-count-counterexample)))
    (and (equal (take 4 r) '(t t t t))
         (equal (nth 4 r) *fn2-stop-reason-pool-release*)
         (equal (nth 5 r) *fn2-cns-state-draining*)
         (equal (nth 6 r) 15) (equal (nth 7 r) 16))))
(assert-event (fn2-cns-drain-without-pool-accounting))

; Removing the reservation inequality permits a typed but impossible refund
; counter. Resource cleanup completes before the guarded credit write stops.
(defun fn2-cns-drain-credit-counterexample-run (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (b* (((mv setup id & fn2-core) (fn2-cns-drain-setup nil fn2-core))
       (original (fn2-cns-draining-reservedp (fn2-test-core-snapshot fn2-core)))
       (fn2-core
        (stobj-let ((fn2-machines (fn2-core-machines fn2-core))) (fn2-machines)
          (update-fn2-machines-admission-creditsi *fn2-cns-admission-ordinal*
                                                (- (expt 2 32) 1) fn2-machines) fn2-core))
       (before (fn2-test-core-snapshot fn2-core))
       (pre (and setup (fn2-corep fn2-core) (fn2-core-wfp fn2-core) (natp 4)
                 (fn2-cns-draining-domainp id before)
                 (fn2-cns-drain-pool-semanticp fn2-core)
                 (not (fn2-cns-draining-reservedp before))))
       ((mv b s d r fn2-core) (fn2-cns-run id 4 fn2-core))
       (after (fn2-test-core-snapshot fn2-core)))
    (mv (and original pre
             (not (fn2-cns-draining-resultp id before b s d r after))
             (equal (fn2-core-stop-reason fn2-core) *fn2-stop-reason-machine-write*)
             (equal (fn2-cns-row-phase id fn2-core) *fn2-cns-state-free*)) fn2-core)))
(defun fn2-cns-drain-without-reservation ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (ok fn2-core) (fn2-cns-drain-credit-counterexample-run fn2-core) ok)))
(assert-event (fn2-cns-drain-without-reservation))
(fn2-assert-owed-teeth fn2-cns-draining-counted-independent)

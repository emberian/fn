; Consumed Send input cannot turn a failed codec drain into success.
(in-package "ACL2")
(include-book "../books/host-result")
(include-book "../books/tls-record")

(assert-event
 (and
  (equal (mv-list 5 (fn2-host-result *fn2-action-send* :failed 4 0 4 nil))
         (list *fn2-outcome-failed* *fn2-reason-closed* 4 0 0))
  (equal (mv-list 5 (fn2-host-result *fn2-action-send* :failed 2 0 4 nil))
         (list *fn2-outcome-failed* *fn2-reason-closed* 2 0 0))
  (equal (mv-list 5 (fn2-host-result *fn2-action-send* :reset 2 0 4 nil))
         (list *fn2-outcome-failed* *fn2-reason-reset* 2 0 0))
  (equal (mv-list 5 (fn2-host-result *fn2-action-send* :eof 4 0 4 nil))
         (list *fn2-outcome-failed* *fn2-reason-closed* 4 0 0))
  (equal (mv-list 5 (fn2-host-result *fn2-action-send* :ok 4 0 4 nil))
         (list *fn2-outcome-done* *fn2-reason-none* 4 0 0))
  (equal (mv-list 5 (fn2-host-result *fn2-action-send* :ok 2 0 4 nil))
         (list *fn2-outcome-short* *fn2-reason-none* 2 0 0))
  (equal (mv-list 5 (fn2-host-result *fn2-action-send* :cancelled 2 0 4 nil))
         (list *fn2-outcome-cancelled* *fn2-reason-none* 2 0 0))
  ; Productive Receive still delivers its bytes before the sticky close.
  (equal (mv-list 5 (fn2-host-result *fn2-action-receive* :failed 2 0 4 nil))
         (list *fn2-outcome-done* *fn2-reason-none* 2 0 0))
  (equal (mv-list 5 (fn2-host-result *fn2-action-receive* :failed 0 0 4 nil))
         (list *fn2-outcome-failed* *fn2-reason-closed* 0 0 0))
  ; Simulator release accounting is orthogonal to terminal failure.
  (equal (mv-list 5 (fn2-sim-terminal-values *fn2-action-send* :failed 4 0 4 t nil))
         (list *fn2-outcome-failed* *fn2-reason-closed* 4 1 0))))

; Same controller/native-boundary composition as fn2-n-tls-ready. The
; primitive schedule consumes app input, drains BIO output, then either
; completes the socket write or fails it. No terminal/progress setter is
; used to manufacture the failure being tested.
(defun fn2-send-drain-run (progress failp fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-tls-transport fn2-tls-record) :verify-guards nil))
 (b* ((fn2-tls-transport (fn2-tls-transport-init 1 fn2-tls-transport))
      (fn2-tls-transport (fn2-tls-transport-put 0 (cap 7) (nonce 17) (alive 1)
                         (handle-id 4096) (cleanup-credit 1) (terminal 3) (quantum 4)))
      ((mv bound fn2-tls-record) (fn2-tls-record-start 7 17 3 9 4 0 t fn2-tls-record))
      ((mv a1 k1 o1 n1 s1 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r1 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s1 0 progress 0 fn2-tls-transport fn2-tls-record))
      ((mv a2 k2 o2 n2 s2 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 3 fn2-tls-transport fn2-tls-record))
      ((mv r2 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s2 3 0 0 fn2-tls-transport fn2-tls-record))
      ((mv a3 k3 o3 n3 s3 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r3 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s3 (if failp -1 3) 0 (if failp 32 0)
                                    fn2-tls-transport fn2-tls-record))
      ((mv status & & count & fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      (posted (mv-list 5 (fn2-host-result *fn2-action-send* (if (eq status :done) :ok status) count 0 4 nil))))
  (mv (and (eq bound :ok)
           (equal (list a1 k1 o1 n1 a2 k2 o2 n2 a3 k3 o3 n3)
                  '(:act 13 0 4 :act 4 0 3 :act 5 0 3))
           (equal (list r1 r2 r3) '(:ok :ok :ok))
           (equal status (if failp :failed :done)) (= count progress)
           (equal posted (list (if failp *fn2-outcome-failed* *fn2-outcome-done*)
                               (if failp *fn2-reason-closed* *fn2-reason-none*) progress 0 0))
           (= (fn2-tls-record-source-progress 0 fn2-tls-record) progress)
           (= (fn2-tls-record-terminal 0 fn2-tls-record) 1)
           (= (fn2-tls-transport-terminal 0 fn2-tls-transport) (if failp 2 3))
           (= (fn2-tls-transport-output-offset 0 fn2-tls-transport) (if failp 0 3)))
      fn2-tls-transport fn2-tls-record)))
(defun fn2-send-drain-check (progress failp)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-tls-transport
  (mv-let (ok fn2-tls-transport)
   (with-local-stobj fn2-tls-record
    (mv-let (ok fn2-tls-transport fn2-tls-record)
     (fn2-send-drain-run progress failp fn2-tls-transport fn2-tls-record)
     (mv ok fn2-tls-transport)))
   ok)))
(assert-event (fn2-send-drain-check 4 t))
(assert-event (fn2-send-drain-check 2 t))
(assert-event (fn2-send-drain-check 4 nil))

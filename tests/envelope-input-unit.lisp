(in-package "ACL2")
(include-book "../sim/envelope-input")
(include-book "std/util/bstar" :dir :system)

; Every physical-input classification used by the replay is explicit.
(assert-event
 (and (fn2-envelope-input-effect-p *fn2-action-read* *fn2-outcome-short*)
      (fn2-envelope-input-effect-p *fn2-action-read* *fn2-outcome-done*)
      (fn2-envelope-input-effect-p *fn2-action-receive* *fn2-outcome-done*)
      (not (fn2-envelope-input-effect-p *fn2-action-read* *fn2-outcome-failed*))
      (not (fn2-envelope-input-effect-p *fn2-action-write* *fn2-outcome-short*))))

(defun fn2-envelope-input-test-run (fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (b* ((fn2-pool (fn2-pool-init '((2 . 64)) 5 20 fn2-pool))
       ((mv code slot gen fn2-pool) (fn2-pool-reserve 0 1 10 3 fn2-pool))
       ((unless (and (eq code :ok) (equal slot 0) (equal gen 5))) (mv nil fn2-pool))
       ((mv code fn2-pool) (fn2-pool-write slot gen 0 11 1 10 3 fn2-pool))
       ((unless (eq code :ok)) (mv nil fn2-pool))
       ((mv code fn2-pool) (fn2-pool-write slot gen 1 12 1 10 3 fn2-pool))
       ((unless (eq code :ok)) (mv nil fn2-pool))
       ; Old bytes outside the returned prefix, including an unrelated row.
       (fn2-pool (update-fn2-pool-datai 5 91 fn2-pool))
       (fn2-pool (update-fn2-pool-datai 64 93 fn2-pool))
       ((mv code off fn2-pool) (fn2-pool-lease-in slot gen 8 7 9 1 10 3 fn2-pool))
       ((unless (and (eq code :ok) (equal off 2) (fn2-pool-wfp fn2-pool)
                     (fn2-poolp fn2-pool) (natp off)
                     (natp (fn2-pool-base slot fn2-pool)))) (mv nil fn2-pool))
       (before (fn2-pool-logical-octets 128 0 fn2-pool))
       ((mv code fn2-pool)
        (fn2-envelope-input *fn2-action-read* *fn2-outcome-short* 2 '(70 71)
          off slot gen 7 9 fn2-pool))
       (after (fn2-pool-logical-octets 128 0 fn2-pool))
       ((unless (and (eq code :ok)
                     (equal after (append (take 2 before) '(70 71) (nthcdr 4 before)))
                     (not (equal before after))
                     (equal (fn2-pool-state slot fn2-pool) *fn2-pool-state-leased-in*)
                     (equal (fn2-pool-lease-off slot fn2-pool) 2)
                     (equal (fn2-pool-lease-len slot fn2-pool) 8)
                     (equal (fn2-pool-fill slot fn2-pool) 2))) (mv nil fn2-pool))
       ; Count mismatch refuses before any byte write.
       ((mv code fn2-pool)
        (fn2-envelope-input *fn2-action-read* *fn2-outcome-short* 3 '(80 81)
          off slot gen 7 9 fn2-pool))
       ((unless (and (eq code :receive-count)
                     (equal after (fn2-pool-logical-octets 128 0 fn2-pool)))) (mv nil fn2-pool))
       ; A stale operation generation cannot borrow the same live range.
       ((mv code fn2-pool)
        (fn2-envelope-input *fn2-action-read* *fn2-outcome-short* 2 '(80 81)
          off slot gen 7 10 fn2-pool))
       ((unless (and (eq code :owner)
                     (equal after (fn2-pool-logical-octets 128 0 fn2-pool)))) (mv nil fn2-pool)))
    (mv t fn2-pool)))
(defun fn2-envelope-input-test ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-pool
    (mv-let (ok fn2-pool) (fn2-envelope-input-test-run fn2-pool) ok)))
(assert-event (fn2-envelope-input-test))

; Remove only the successful-validation hypothesis from the exact-prefix
; contract. A short Read claims three bytes but supplies two: its kind/status
; is permitted by the outer relation, while this physical-effect record is
; refused here. Every other antecedent holds and the proposed byte is wrong.
(defun fn2-envelope-input-negative-run (fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (b* ((fn2-pool (fn2-pool-init '((1 . 64)) 5 20 fn2-pool))
       ((mv code slot gen fn2-pool) (fn2-pool-reserve 0 1 10 3 fn2-pool))
       ((unless (eq code :ok)) (mv nil fn2-pool))
       ((mv code off fn2-pool) (fn2-pool-lease-in slot gen 8 7 9 1 10 3 fn2-pool))
       ((unless (and (eq code :ok) (equal off 0) (fn2-poolp fn2-pool)
                     (fn2-pool-wfp fn2-pool) (natp off)
                     (natp (fn2-pool-base slot fn2-pool)))) (mv nil fn2-pool))
       (address (+ (fn2-pool-base slot fn2-pool) off))
       (before (fn2-pool-datai address fn2-pool))
       ((mv code fn2-pool)
        (fn2-envelope-input *fn2-action-read* *fn2-outcome-short* 3 '(70 71)
          off slot gen 7 9 fn2-pool)))
    (mv (and (natp address) (eq code :receive-count)
             (fn2-envelope-input-effect-p *fn2-action-read* *fn2-outcome-short*)
             (equal (fn2-pool-datai address fn2-pool) before)
             (not (equal (fn2-pool-datai address fn2-pool)
                         (fn2-envelope-prefix-byte address address '(70 71) before))))
        fn2-pool)))
(defun fn2-envelope-input-negative-test ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-pool
    (mv-let (ok fn2-pool) (fn2-envelope-input-negative-run fn2-pool) ok)))
(assert-event (fn2-envelope-input-negative-test))

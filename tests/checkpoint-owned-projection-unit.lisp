; Actual map producer/reader and selected projection wrapper. Selection and
; validation are explicit synthetic antecedents inherited from CPU fixtures.
; This does not exercise journal persistence, cold selection or physical FREE.
(in-package "ACL2")
(include-book "checkpoint-projection-unit")
(include-book "../books/checkpoint-owned-projection")
(defun fn2-cpou-body (mode fn2-checkpoint-projection fn2-core)
 (declare (xargs :stobjs (fn2-checkpoint-projection fn2-core) :verify-guards nil))
 (b* ((fn2-core (fn2-core-init (put-assoc-equal :extent-slots 6 *fn2-profile-tiny*) fn2-core))
      (fn2-checkpoint-projection (fn2-checkpoint-projection-init 1 fn2-checkpoint-projection))
      ((mv selected fn2-core) (fn2-cpu-select fn2-core))
      ((mv decoded fn2-core) (fn2-cpu-map fn2-core)))
 (stobj-let ((fn2-checkpoint-selected-source (fn2-core-checkpoint-selected-source fn2-core)) (fn2-boot-config (fn2-core-boot-config fn2-core)) (fn2-checkpoints (fn2-core-checkpoints fn2-core)) (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core)) (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core)) (fn2-origin (fn2-core-origin fn2-core)) (fn2-checkpoint-recovery-evidence (fn2-core-checkpoint-recovery-evidence fn2-core)) (fn2-checkpoint-recovery-census (fn2-core-checkpoint-recovery-census fn2-core)) (fn2-checkpoint-restore-map (fn2-core-checkpoint-restore-map fn2-core)) (fn2-checkpoint-restore-map-control (fn2-core-checkpoint-restore-map-control fn2-core)) (fn2-checkpoint-restore-reach-control (fn2-core-checkpoint-restore-reach-control fn2-core)) (fn2-checkpoint-restore-reach (fn2-core-checkpoint-restore-reach fn2-core)) (fn2-ops (fn2-core-ops fn2-core)) (fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)) (fn2-checkpoint-construction (fn2-core-checkpoint-construction fn2-core)))
  (answer fn2-checkpoint-projection fn2-checkpoint-selected-source fn2-extents fn2-alloc-edges fn2-checkpoint-construction)
  (b* ((fn2-checkpoint-selected-source (fn2-checkpoint-selected-source-put 0
        (phase *fn2-checkpoint-selected-source-phase-validated*)
        (generation (fn2-checkpoint-restore-reach-control-generation 0 fn2-checkpoint-restore-reach-control))))
       (fn2-extents (fn2-alloc-init 6 fn2-extents))
       (fn2-alloc-edges (fn2-alloc-edges-init 128 fn2-alloc-edges))
       (fn2-checkpoint-construction (fn2-checkpoint-construction-init 6 fn2-checkpoint-construction))
       ((mv begin fn2-checkpoint-projection fn2-checkpoint-selected-source fn2-extents)
        (fn2-checkpoint-projection-begin fn2-checkpoint-selected-source fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-reach-control fn2-checkpoint-projection fn2-extents fn2-ops fn2-alloc-edges))
       ; Occupancy controls precede actual wrapper admission.
       (fn2-checkpoint-construction
        (cond ((eq mode :native) (fn2-checkpoint-construction-put 0 (live 1) (role 1) (epoch 4) (counter 100)))
              ((eq mode :mismatch) (fn2-checkpoint-construction-put 0 (live 1) (role *fn2-checkpoint-owned-restored-role*) (epoch 4) (counter 101)))
              (t fn2-checkpoint-construction)))
       (fn2-checkpoint-construction (fn2-checkpoint-construction-put 5 (live 1) (token 999)))
       ((mv code fn2-checkpoint-projection fn2-checkpoint-selected-source fn2-extents fn2-alloc-edges fn2-checkpoint-construction)
        (fn2-checkpoint-projection-owned-step 4 fn2-checkpoint-selected-source fn2-boot-config fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-origin fn2-checkpoint-recovery-evidence fn2-checkpoint-recovery-census fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-reach-control fn2-checkpoint-projection fn2-extents fn2-ops fn2-alloc-edges fn2-checkpoint-restore-reach fn2-checkpoint-construction)))
   (mv (and selected decoded (eq begin :more)
            (= (fn2-checkpoint-construction-token 5 fn2-checkpoint-construction) 999)
            (if mode
             (and (eq code :ownership) (= (fn2-checkpoint-projection-cursor 0 fn2-checkpoint-projection) 0)
                  (= (fn2-extents-state 0 fn2-extents) *fn2-extent-state-free*)
                  (= (fn2-checkpoint-construction-live 0 fn2-checkpoint-construction) 1))
             (and (eq code :more) (= (fn2-checkpoint-projection-cursor 0 fn2-checkpoint-projection) 1)
                  (= (fn2-checkpoint-construction-role 0 fn2-checkpoint-construction) *fn2-checkpoint-owned-restored-role*)
                  (= (fn2-checkpoint-construction-epoch 0 fn2-checkpoint-construction) (fn2-checkpoint-restore-map-epoch 0 fn2-checkpoint-restore-map))
                  (= (fn2-checkpoint-construction-counter 0 fn2-checkpoint-construction) (fn2-checkpoint-restore-map-allocation 0 fn2-checkpoint-restore-map))
                  (= (fn2-checkpoint-construction-token 0 fn2-checkpoint-construction) 0)
                  (= (fn2-checkpoint-construction-intended-bytes 0 fn2-checkpoint-construction) 0)
                  (= (fn2-checkpoint-construction-completed-bytes 0 fn2-checkpoint-construction) 0)
                  (not (fn2-checkpoint-construction-native-p 0 fn2-checkpoint-construction)))))
       fn2-checkpoint-projection fn2-checkpoint-selected-source fn2-extents fn2-alloc-edges fn2-checkpoint-construction))
  (mv answer fn2-checkpoint-projection fn2-core))))
(defun fn2-cpou-run (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core)
   (with-local-stobj fn2-checkpoint-projection
    (mv-let (answer fn2-checkpoint-projection fn2-core)
     (fn2-cpou-body mode fn2-checkpoint-projection fn2-core)
     (mv answer fn2-core))) answer)))
(assert-event (fn2-cpou-run nil))
(assert-event (fn2-cpou-run :native))
(assert-event (fn2-cpou-run :mismatch))

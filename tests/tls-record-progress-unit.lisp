; Actual NEXT/OBSERVE/WAIT composition: SSL epoch and readiness epoch differ.
(in-package "ACL2")
(include-book "../books/tls-record")
(include-book "std/util/bstar" :dir :system)

(defun fn2-tls-record-progress-run (writep fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-tls-transport fn2-tls-record) :verify-guards nil))
 (b* ((fn2-tls-transport (fn2-tls-transport-init 1 fn2-tls-transport))
      (fn2-tls-transport (fn2-tls-transport-put 0 (cap 7) (nonce 17) (alive 1)
                         (terminal 3) (quantum 4)))
      ((mv bound fn2-tls-record) (fn2-tls-record-start 7 17 3 9 3 0 writep fn2-tls-record))
      ((mv a1 k1 o1 n1 s1 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r1 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s1 1 0 0 fn2-tls-transport fn2-tls-record))
      ; WANT_READ first needs a socket receive; EAGAIN settles but does not progress.
      ((mv a2 k2 o2 n2 s2 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r2 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s2 -1 0 11 fn2-tls-transport fn2-tls-record))
      ((mv read-interest read-kick) (fn2-tls-record-wait fn2-tls-transport fn2-tls-record))
      (read-blocked (and (= read-interest 1) (not read-kick)
                         (= (fn2-tls-transport-progress-serial 0 fn2-tls-transport) s1)
                         (= (fn2-tls-record-ssl-progress 0 fn2-tls-record) s1)
                         (= (fn2-tls-record-pending-serial 0 fn2-tls-record) 0)
                         (= (fn2-tls-transport-pending 0 fn2-tls-transport) 0)))
      ; A readiness wake retries the receive. Feed the ciphertext in two steps.
      ((mv a3 k3 o3 n3 s3 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r3 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s3 4 0 0 fn2-tls-transport fn2-tls-record))
      ((mv a4 k4 o4 n4 s4 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r4 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s4 2 0 0 fn2-tls-transport fn2-tls-record))
      ((mv a5 k5 o5 n5 s5 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r5 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s5 2 0 0 fn2-tls-transport fn2-tls-record))
      ((mv & feed-kick) (fn2-tls-record-wait fn2-tls-transport fn2-tls-record))
      (epochs (and feed-kick
                   (= (fn2-tls-record-ssl-progress 0 fn2-tls-record) s1)
                   (= (fn2-tls-record-seen-progress 0 fn2-tls-record) s5)
                   (= (fn2-tls-transport-progress-serial 0 fn2-tls-transport) s5)
                   (= (fn2-tls-transport-input-offset 0 fn2-tls-transport) 4)
                   (= (fn2-tls-record-source-progress 0 fn2-tls-record) 0)
                   (= (fn2-tls-record-sink-progress 0 fn2-tls-record) 0)))
      ; This must retry SSL, despite seen-progress equalling transport progress.
      ((mv a6 k6 o6 n6 s6 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r6 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s6 0 3 0 fn2-tls-transport fn2-tls-record))
      ; Both read and write SSL calls can leave ciphertext pending in the BIO.
      ((mv a7 k7 o7 n7 s7 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 3 fn2-tls-transport fn2-tls-record))
      ((mv r7 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s7 3 0 0 fn2-tls-transport fn2-tls-record))
      ((mv a8 k8 o8 n8 s8 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r8 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s8 -1 0 11 fn2-tls-transport fn2-tls-record))
      ((mv write-interest write-kick) (fn2-tls-record-wait fn2-tls-transport fn2-tls-record))
      (write-blocked (and (= write-interest 4) (not write-kick)
                          (= (fn2-tls-record-ssl-progress 0 fn2-tls-record) s6)
                          (= (fn2-tls-record-seen-progress 0 fn2-tls-record) s7)
                          (= (fn2-tls-transport-progress-serial 0 fn2-tls-transport) s7)))
      ((mv a9 k9 o9 n9 s9 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv r9 fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe s9 3 0 0 fn2-tls-transport fn2-tls-record))
      ((mv done & & count & fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record)))
  (mv (and (eq bound :ok) read-blocked epochs write-blocked
           (equal (list a1 k1 o1 n1 a6 k6 o6 n6)
                  (list :act (if writep 13 12) 0 3 :act (if writep 13 12) 0 3))
           (equal (list a2 k2 o2 n2 a3 k3 o3 n3 a4 k4 o4 n4 a5 k5 o5 n5)
                  '(:act 6 0 4 :act 6 0 4 :act 3 0 4 :act 3 2 2))
           (equal (list a7 k7 o7 n7 a8 k8 o8 n8 a9 k9 o9 n9)
                  '(:act 4 0 3 :act 5 0 3 :act 5 0 3))
           (equal (list r1 r2 r3 r4 r5 r6 r7 r8 r9)
                  '(:ok :blocked :ok :ok :ok :ok :ok :blocked :ok))
           (< s1 s2) (< s2 s3) (< s3 s4) (< s4 s5) (< s5 s6)
           (< s6 s7) (< s7 s8) (< s8 s9)
           (eq done :done) (= count 3)
           (= (fn2-tls-record-terminal 0 fn2-tls-record) 1)
           (= (fn2-tls-record-source-progress 0 fn2-tls-record) (if writep 3 0))
           (= (fn2-tls-record-sink-progress 0 fn2-tls-record) (if writep 0 3))
           (= (fn2-tls-transport-output-offset 0 fn2-tls-transport) 3))
      fn2-tls-transport fn2-tls-record)))

(defun fn2-tls-record-progress-check (writep)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-tls-transport
  (mv-let (ok fn2-tls-transport)
   (with-local-stobj fn2-tls-record
    (mv-let (ok fn2-tls-transport fn2-tls-record)
     (fn2-tls-record-progress-run writep fn2-tls-transport fn2-tls-record)
     (mv ok fn2-tls-transport)))
   ok)))
(assert-event (fn2-tls-record-progress-check nil))
(assert-event (fn2-tls-record-progress-check t))

;;; Real held-plan and statement driver; replace only physical effects and
;;; section admission with a mutex fixture. No image or durable store is built.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defmacro mv (&rest xs) `(values ,@xs))
(defmacro mv-let (vars form &body body) `(multiple-value-bind ,vars ,form ,@body))
(defun nfix (x) (if (and (integerp x) (<= 0 x)) x 0))
(defun member-eq (x xs) (member x xs :test #'eq))
(defun member-equal (x xs) (member x xs :test #'equal))
(defun source-form (path kind name)
  (with-open-file (stream path)
    (let ((text (make-string (file-length stream))))
      (read-sequence text stream)
      (read-from-string text nil nil
                       :start (or (search (format nil "(~a ~a " kind name) text)
                                  (error "missing ~a" name))))))
(defun load-model (book names)
  (dolist (name names)
    (let ((form (source-form book "defun" (string-downcase name))))
      ;; Remove only ACL2's admission declaration, preserving the body.
      (eval (append (subseq form 0 3)
                    (remove-if (lambda (x) (and (consp x) (eq (car x) 'declare)))
                               (nthcdr 3 form)))))))
(load-model "books/owner-commit-steps.lisp"
            '(fn-ocs-in-flight-p fn-ocs-commit-step fn-ocs-ocm fn-ocs-phase fn-ocs-lasti fn-ocs-make))
(load-model "books/owner-commit-pipeline.lisp"
            '(fn-ocp-ocs fn-ocp-open-next fn-ocp-passes fn-ocp-make fn-ocp-commit-step))
(load-model "books/owner-time-model.lisp"
            '(fn-otm-ocp fn-otm-disk fn-otm-clock fn-otm-held fn-otm-make))
(load-model "books/owner-queued-work.lisp"
            '(fn-oqw-phases fn-oqw-terminalp fn-oqw-after fn-oqw-start fn-oqw-step fn-oqw-outcome-of-final))
(load-model "books/owner-commit-held.lisp"
            '(fn-och-step fn-och-off fn-och-action-effects fn-och-caller-answer))
(load-model "books/owner-time-held.lisp"
            '(fn-otm-phase-of fn-otm-next-of fn-otm-with-step fn-otm-held-event fn-otm-held-plan))
(defstruct fnn-owner-gate mutex sched)
(defstruct fnn-owner-service lock gate store commit-lock commit-ready stopping space-need)
(defstruct fnn-store log)
(defstruct (fnn-owner-job (:constructor %make-fnn-owner-job)) kind plan effects)
(define-condition fnn-store-refusal (error) ())
(define-condition fnn-store-fault (error) ((message :initarg :message)))
(define-condition fnn-store-indeterminate (error) ((message :initarg :message)))
(defun fnn-fault (fmt &rest args)
  (error 'fnn-store-fault :message (apply #'format nil fmt args)))
(defun fnn-indeterminate (fmt &rest args)
  (error 'fnn-store-indeterminate :message (apply #'format nil fmt args)))
(defun fnn-refuse (fmt &rest args) (declare (ignore fmt args)) (error 'fnn-store-refusal))
(defun fnn-core (name &rest args) (apply (symbol-function name) args))
(defun fnn-call (name &rest args) (multiple-value-list (apply (symbol-function name) args)))
(defun fnn-owner-core (name)
  (case name
    (fn-owner-barrier-limits '(5000 30000 1000))
    (fn-owner-space-need 0)
    (otherwise (error "unexpected owner observation ~a" name))))
(defvar *service*)
(defvar *events*)
(defvar *failure*)
(defvar *sections*)
(defvar *fnn-log-batch* nil)
(defvar *fnn-owner-deferred* nil)
(defun fnn-log-line (line)
  (assert (equal line '(65))) (assert (under-owner-p)) (push :line *events*))
(defun under-owner-p () (sb-thread:holding-mutex-p (fnn-owner-service-lock *service*)))
(defun section (service cid thunk &optional class)
  (declare (ignore cid class))
  (incf *sections*)
  (when (and (eq *failure* :second-entry) (= *sections* 2)) (error 'fnn-store-refusal))
  (sb-thread:with-mutex ((fnn-owner-service-lock service)) (funcall thunk)))
(defmacro fnn-owner-gated ((service class) &body body)
  `(section ,service nil (lambda () ,@body) ,class))
(defun fnn-owner-reader-capture (what)
  (assert (under-owner-p)) (push what *events*))
(defun fnn-log-seal-capture (store)
  (assert (eq store (fnn-owner-service-store *service*)))
  (assert (under-owner-p)) (push :capture *events*) :plan)
(defun fnn-owner-batch-effect (service job phase)
  (assert (eq service *service*))
  (assert (eq (fnn-owner-job-plan job) :plan))
  (assert (not (under-owner-p)))
  (assert (fn-otm-held (fnn-owner-gate-sched (fnn-owner-service-gate service))))
  ;; Another owner reader can enter while this physical phase is stalled.
  (let ((lock (fnn-owner-service-lock service)))
    (assert (sb-thread:join-thread
             (sb-thread:make-thread
              (lambda () (when (sb-thread:grab-mutex lock :waitp nil)
                           (sb-thread:release-mutex lock) t))))))
  (push phase *events*)
  (when (and (eq *failure* :crash) (eq phase :append)) (throw 'physical-escape :lost))
  (when (and (eq *failure* :stopping) (eq phase :resolutions))
    (setf (fnn-owner-service-stopping service) t))
  (if (eq phase *failure*) (values :uncertain nil) :ok))
(defun fnn-log-sync-collected (log)
  (assert (eq log :log)) (assert (under-owner-p)) (push :collected *events*))
(defun fnn-log-batch-finish (store)
  (assert (eq store (fnn-owner-service-store *service*)))
  (assert (under-owner-p)) (push :ack *events*))
(defun fnn-owner-held-wait (service pending)
  ;; The established syncer lifecycle is tested by the native scheduler
  ;; suite. This source fixture executes the actual labelled batch runner.
  (assert (not (under-owner-p)))
  (destructuring-bind (members deferred job limits need) pending
    (assert (null members)) (assert (null deferred))
    (assert (equal limits '(5000 30000 1000))) (assert (eql need 0))
    (when (eq *failure* :bad-label)
      (setf (fnn-owner-job-effects job) '((:owner . :intents))))
    ;; Control: the established queued jobs have no extra label slot.
    (when (eq *failure* :legacy-job) (setf (fnn-owner-job-effects job) nil))
    (multiple-value-bind (final condition) (fnn-owner-batch-job service job)
      (list nil nil (if (eq (fn-oqw-outcome-of-final final) :fenced) :fenced :failed)
            condition))))
(dolist (name '(fnn-owner-held-event fnn-owner-run-job fnn-owner-batch-job fnn-owner-held-statement-start
                fnn-owner-held-statement-wait fnn-owner-held-statement-complete))
  (eval (source-form "host/native/owner.lisp" "defun" (string-downcase name))))
(eval (source-form "host/native/owner.lisp" "defmacro" "fnn-owner-held-statement"))
(dolist (failure '(nil :intents :extend :append :fence :resolutions
                   :crash :bad-label :stopping :second-entry :legacy-job))
  (let* ((*service* (make-fnn-owner-service
                    :lock (sb-thread:make-mutex) :store (make-fnn-store :log :log)
                    :gate (make-fnn-owner-gate :mutex (sb-thread:make-mutex)
                           :sched (fn-otm-make (fn-ocp-make (fn-ocs-make nil :idle nil) nil 0) nil nil))
                    :commit-lock (sb-thread:make-mutex)
                    :commit-ready (sb-thread:make-waitqueue)))
         (*events* nil) (*failure* failure) (*sections* 0)
         (answer (catch 'physical-escape (handler-case
                  (fnn-owner-held-statement (section *service* nil captured)
                    (progn (assert (under-owner-p)) (assert *fnn-log-batch*)
                           (push :prepare *events*)
                           (push (cons :log '(65)) (cdr *fnn-owner-deferred*))
                           (values 7 9))
                    (assert (under-owner-p)) (assert (equal captured '(7 9)))
                    (push :resume *events*) :returned)
                   (fnn-store-indeterminate () :uncertain)
                   (fnn-store-fault () :fault)
                   (fnn-store-refusal () :refused)))))
    (assert (not (fn-otm-held (fnn-owner-gate-sched (fnn-owner-service-gate *service*)))))
    (if (and failure (not (eq failure :legacy-job)))
        (progn
          (assert (eq answer (case failure (:bad-label :fault)
                              ((:stopping :second-entry) :refused) (t :uncertain))))
          (assert (not (member :resume *events*)))
          (if (member failure '(:stopping :second-entry))
              (assert (member :ack *events*))
            (progn (assert (not (member :ack *events*)))
                   (assert (member :drop *events*))))
          (when (eq failure :bad-label) (assert (not (member :intents *events*)))))
      (progn (assert (eq answer :returned))
             (assert (equal (reverse *events*)
                            '(:start :prepare :capture :intents :extend :append :fence
                              :resolutions :collected :ack :line :complete :resume)))))))
(format t "held statement: real plan, off-O effects, reader entry, fenced resume, five failed phases~%")

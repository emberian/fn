; Publication-race fixture, not an authorization or identity-immutability claim.
; Two manifest-backed articles are actually posted. Between the first
; article's scalar read and commitment copy, C publishes one replacement
; article row containing the second article's location and commitments.
; The cursor must restart and serve the replacement row as one coherent row.
; Source-authored control: execution/certification remain separate gates.
(in-package "ACL2")
(include-book "manifest-binding-served-unit")
(include-book "../books/owed-cursor")

; One machine visit per actual turn exposes the art-lookup/art-bind cut.
(defconst *fn2-mpu-profile*
 (put-assoc-equal :x 1 (put-assoc-equal :k 1 *fn2-mbs-profile*)))
(defun fn2-mpu-await (fuel step clients store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond ((and (equal (fn2-cursor-row-phase (fn2-machine-kind-base *fn2-cursor-kind* fn2-core) fn2-core) *fn2-cursor-state-render*)
             (equal (fn2-cursor-row-step (fn2-machine-kind-base *fn2-cursor-kind* fn2-core) fn2-core) step))
        (mv :cut clients store fn2-core))
       ((zp fuel) (mv :fuel clients store fn2-core))
       ((not (equal (fn2-core-stop-reason fn2-core) 0)) (mv :stop clients store fn2-core))
       (t (b* (((mv & & & & fn2-core) (fn2-turn fn2-core))
                ((mv & & clients store fn2-core) (fn2-cw-adapter-one 1 clients store fn2-core)))
            (fn2-mpu-await (- fuel 1) step clients store fn2-core)))))
(defun fn2-mpu-leave-cut (fuel clients store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond ((not (equal (fn2-cursor-row-step (fn2-machine-kind-base *fn2-cursor-kind* fn2-core) fn2-core) 27)) (mv :left clients store fn2-core))
       ((zp fuel) (mv :fuel clients store fn2-core))
       (t (b* (((mv & & & & fn2-core) (fn2-turn fn2-core))
                ((mv & & clients store fn2-core) (fn2-cw-adapter-one 1 clients store fn2-core)))
            (fn2-mpu-leave-cut (- fuel 1) clients store fn2-core)))))
(defun fn2-mpu-copy-field (field off slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (mv-let (code copied left fn2-core) (fn2-read-octets 1 field 0 *fn2-article-location-hashes-max* slot gen off 200 0 1 fn2-core)
  (mv (if (and (eq code :ok) (equal left 0)) :ok :copy) copied fn2-core)))
(defun fn2-mpu-snapshot (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv c slot gen fn2-core) (fn2-core-reserve 0 200 0 1 fn2-core))
      ((unless (eq c :ok)) (mv :reserve nil fn2-core))
      ((mv c1 n1 fn2-core) (fn2-mpu-copy-field *fn2-article-entry-field-source* 0 slot gen fn2-core))
      ((mv c2 n2 fn2-core) (fn2-mpu-copy-field *fn2-article-entry-field-stored-source* 32 slot gen fn2-core))
      ((mv c3 n3 fn2-core) (fn2-mpu-copy-field *fn2-article-entry-field-location-hashes* 64 slot gen fn2-core))
      ((mv c4 lines) (fn2-read-value 1 *fn2-article-entry-field-lines* fn2-core)))
  (mv (if (and (eq c1 :ok) (eq c2 :ok) (eq c3 :ok) (eq c4 :ok)
               (equal n1 32) (equal n2 32) (posp n3)) :ok :snapshot)
      (list slot gen n3 lines (fn2-cursor-row-lunit (fn2-machine-kind-base *fn2-cursor-kind* fn2-core) fn2-core)
            (fn2-cursor-row-lepoch (fn2-machine-kind-base *fn2-cursor-kind* fn2-core) fn2-core) (fn2-cursor-row-lalloc (fn2-machine-kind-base *fn2-cursor-kind* fn2-core) fn2-core)
            (fn2-cursor-row-alen (fn2-machine-kind-base *fn2-cursor-kind* fn2-core) fn2-core)) fn2-core)))
(defun fn2-mpu-publish (snapshot fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv c0 old-batch) (fn2-successor-published fn2-core))
      (batch (+ 1 (nfix old-batch)))
      ((mv cb birth) (fn2-read-value 1 *fn2-article-entry-field-birth* fn2-core))
      (article (fn2-cursor-row-art (fn2-machine-kind-base *fn2-cursor-kind* fn2-core) fn2-core))
      (slot (nth 0 snapshot)) (gen (nth 1 snapshot))
      ((mv c1 fn2-core)
       (fn2-article-put 0 0 (article article) (birth birth) (state *fn2-txn-article-live*)
         (version batch) (source slot gen 0) (stored-source slot gen 32) (submitter 0) (placement-principal 0)
         (bytes (nth 7 snapshot)) (lines (nth 3 snapshot))
         (location-unit (nth 4 snapshot)) (location-epoch (nth 5 snapshot))
         (location-allocation (nth 6 snapshot)) (location-kind *fn2-txn-location-source-manifest*)
         (location-hashes slot gen 64 (nth 2 snapshot)) :owner (200 0 1) fn2-core))
      ((unless (and (eq c0 :ok) (eq cb :ok) (eq c1 :ok))) (mv (list :put c0 cb c1) fn2-core))
      ((mv c2 fn2-core) (fn2-cs-resolve 400 0 fn2-core))
      ((mv c3 & fn2-core) (fn2-successor-stage 0 fn2-core))
      ((mv c4 fn2-core) (fn2-successor-bind 0 batch batch fn2-core))
      ((mv c5 fn2-core) (fn2-successor-publish batch fn2-core))
      ((mv c6 fn2-core) (fn2-successor-release 0 fn2-core)))
  (mv (if (and (eq c2 :ok) (eq c3 :ok) (eq c4 :ok) (eq c5 :ok) (eq c6 :ok)) :ok
        (list :publish c2 c3 c4 c5 c6)) fn2-core)))
(defun fn2-mpu-check (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-mpu-profile* :echo nil fn2-core))
      ((mv ec fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      (post (fn2-cw-crlf-octets (append '("POST") *fn2-mbs-a* '("." "POST") *fn2-mbs-b* '("." "QUIT"))))
      ((mv status clients store fn2-core)
       (fn2-cw-loop 200000 0 0 (fn2-cw-clients (list (list post (list (len post))))) nil fn2-core))
      (posted (fn2-cw-crlf-octets '("200 fn-nntp experimental server ready"
                  "340 send article to be posted" "240 article received OK"
                  "340 send article to be posted" "240 article received OK" "205 closing connection")))
      ((unless (and (eq ec :ok) (eq status :quiet)
                    (equal (fn2-cw-results clients) (list (list posted t)))))
       (mv (list :setup ec status (fn2-cw-results clients)) fn2-core))
      (read (fn2-cw-crlf-octets '("BODY <b@example.invalid>" "BODY <a@example.invalid>" "QUIT")))
      (clients (fn2-cw-clients (list (list read (list (len read))))))
      (acc (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (acc)
             (fn2-mbs-pending-accept (fn2-ops-rows fn2-ops) 0 fn2-ops) acc))
      ((unless acc) (mv '(:no-accept) fn2-core))
      (fn2-core (fn2-cw-post-accept (car acc) (cadr acc) 0 77 nil fn2-core))
      ((mv cut clients store fn2-core) (fn2-mpu-await 200000 27 clients store fn2-core))
      ((unless (and (eq cut :cut) (equal (fn2-cursor-row-mkind (fn2-machine-kind-base *fn2-cursor-kind* fn2-core) fn2-core) 1)))
       (mv (list :b-cut cut) fn2-core))
      ((mv code snapshot fn2-core) (fn2-mpu-snapshot fn2-core))
      ((unless (eq code :ok)) (mv code fn2-core))
      ;; Advance beyond B's bind before seeking A's same phase.
      ((mv left clients store fn2-core) (fn2-mpu-leave-cut 200000 clients store fn2-core))
      ((unless (eq left :left)) (mv (list :b-bind left) fn2-core))
      ((mv cut clients store fn2-core) (fn2-mpu-await 200000 27 clients store fn2-core))
      ((unless (and (eq cut :cut) (equal (fn2-cursor-row-said (fn2-machine-kind-base *fn2-cursor-kind* fn2-core) fn2-core) 0)
                    (not (equal (fn2-cursor-row-lunit (fn2-machine-kind-base *fn2-cursor-kind* fn2-core) fn2-core) (nth 4 snapshot)))))
       (mv (list :a-cut cut) fn2-core))
      ((mv code fn2-core) (fn2-mpu-publish snapshot fn2-core))
      ((unless (eq code :ok)) (mv code fn2-core))
      ((mv cut clients store fn2-core) (fn2-mpu-await 200000 20 clients store fn2-core))
      ((unless (and (eq cut :cut) (equal (fn2-cursor-row-said (fn2-machine-kind-base *fn2-cursor-kind* fn2-core) fn2-core) 0)))
       (mv (list :stale-restart cut) fn2-core))
      ((mv status clients & fn2-core) (fn2-cw-loop 200000 0 1 clients store fn2-core))
      (expected (fn2-cw-crlf-octets
                 (append '("200 fn-nntp experimental server ready" "222 0 <b@example.invalid> body follows")
                  (make-list 220 :initial-element *fn2-mbs-b-line*) '("." "222 0 <a@example.invalid> body follows")
                  (make-list 220 :initial-element *fn2-mbs-b-line*) '("." "205 closing connection"))))
      ((mv release fn2-core) (fn2-core-release (nth 0 snapshot) (nth 1 snapshot) 200 0 1 fn2-core)))
  (mv (if (and (eq status :quiet) (eq release :ok) (equal (fn2-core-stop-reason fn2-core) 0)
               (equal (fn2-cw-results clients) (list (list expected t)))) t
        (list :read status release (fn2-core-stop-reason fn2-core) (fn2-cw-results clients))) fn2-core)))
(defun fn2-mpu-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (r fn2-core) (fn2-mpu-check fn2-core) r)))
(assert-event (equal (fn2-mpu-run) t))

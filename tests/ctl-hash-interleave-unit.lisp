; Actual incremental BLAKE3 state: pause CTL, run the event verifier, resume
; CTL. The old selector deliberately aliases that verifier and loses state.
(in-package "ACL2")
(include-book "fnct-stream-unit")
(include-book "../books/machines-b")

(defun fn2-chi-run (old fn2-digests fn2-b3 fn2-pool)
 (declare (xargs :stobjs (fn2-digests fn2-b3 fn2-pool) :verify-guards nil))
 (b* ((rows 32) (connections 2) (sources 2)
      (ctl (if old (+ (- rows connections) -1)
              (fn2-b-ctl-runtime-row 0 connections sources rows)))
      (other (fn2-b-event-row rows))
      (fn2-digests (fn2-digests-init (* rows *fn2-digest-stride*) fn2-digests))
      (fn2-b3 (fn2-b3-table-init rows fn2-b3))
      (fn2-pool (fn2-pool-init '((1 . 4096)) 1 100 fn2-pool))
      ((mv reserve slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv a fn2-digests fn2-b3) (fn2-fnct-stream-start ctl fn2-digests fn2-b3))
      (fn2-pool (fn2-stream-unit-fill 0 4096 0 fn2-pool))
      ((mv b n1 fn2-digests fn2-b3)
       (fn2-fnct-stream-update ctl slot gen 0 4096 1 0 1 fn2-digests fn2-b3 fn2-pool))
      ((mv c fn2-digests fn2-b3) (fn2-fnct-stream-start other fn2-digests fn2-b3))
      ((mv d n2 fn2-digests fn2-b3)
       (fn2-fnct-stream-update other slot gen 0 1024 1 0 1 fn2-digests fn2-b3 fn2-pool))
      ((mv e fn2-digests fn2-b3) (fn2-fnct-stream-finish other fn2-digests fn2-b3))
      (other-ok (equal (fn2-digest-list (fn2-digest-slot other *fn2-b3-result*) fn2-digests)
                      '(960962882 111449584 3733191923 1249151416 838340032 1437208001 308124440 4149904668)))
      ((mv reset fn2-pool) (fn2-pool-reset slot gen 1 0 1 fn2-pool))
      (fn2-pool (fn2-stream-unit-fill 0 2048 4096 fn2-pool))
      ((mv f n3 fn2-digests fn2-b3)
       (fn2-fnct-stream-update ctl slot gen 0 2048 1 0 1 fn2-digests fn2-b3 fn2-pool))
      ((mv g fn2-digests fn2-b3) (fn2-fnct-stream-finish ctl fn2-digests fn2-b3)))
  (mv (list (and (eq reserve :ok) (eq reset :ok) (eq a :ok) (eq b :ok) (eq c :ok)
                 (eq d :ok) (eq e :ok) (eq f :ok) (eq g :ok)
                 (equal n1 4096) (equal n2 1024) (equal n3 2048) other-ok)
            (equal (fn2-digest-list (fn2-digest-slot ctl *fn2-b3-result*) fn2-digests)
                   '(1952132670 2918402272 2854212310 2755328179 2015509325 2151397551 1683080115 94563563)))
      fn2-digests fn2-b3 fn2-pool)))
(defun fn2-chi (old)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-digests
  (mv-let (result fn2-digests)
   (with-local-stobj fn2-b3
    (mv-let (result fn2-digests fn2-b3)
     (with-local-stobj fn2-pool
      (mv-let (result fn2-digests fn2-b3 fn2-pool)
       (fn2-chi-run old fn2-digests fn2-b3 fn2-pool)
       (mv result fn2-digests fn2-b3)))
     (mv result fn2-digests)))
   result)))
(assert-event (equal (fn2-chi nil) '(t t)))
(assert-event (equal (fn2-chi t) '(t nil)))

; Exercise the actual macro constructors, never a replacement implementation.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun intern-in-package-of-symbol (name sym) (intern name (symbol-package sym)))
(defun selected-form (path name)
 (with-open-file (in path)
  (loop for form = (read in nil :eof) until (eq form :eof)
        when (and (consp form) (eq (cadr form) name)) return form)))
(eval (selected-form "books/columns.lisp" 'fn2-columns-sym))
(eval (selected-form "books/format-check.lisp" 'fn2-fc-shape-claims))
(eval (selected-form "books/format-check.lisp" 'fn2-fc-shape))
(defun emitted (path)
 (eval (selected-form path 'fn2-ra-shape))
 (loop for name in '(fn2-ra-page-events fn2-ra-build-events fn2-ra-lookup-events) append
  (progn (eval (selected-form path name))
   (mapcar (lambda (form)
             (if (and (consp form) (member (car form) '(fn2-ra-shape fn2-fc-shape)))
                 (macroexpand-1 form) form))
           (cdr (macroexpand-1 (list name)))))))
(defun strip-proof-options (x)
 (cond ((atom x) x)
       ((eq (car x) 'defthm)
        (append (subseq x 0 3)
                (loop for (k v) on (cdddr x) by #'cddr
                      unless (eq k :hints) append (list k v))))
       ((eq (car x) 'xargs)
        (cons 'xargs (loop for (k v) on (cdr x) by #'cddr
                          unless (eq k :guard-hints) append (list k v))))
       (t (mapcar #'strip-proof-options x))))
(defparameter *baseline* (sb-ext:posix-getenv "FN_RA_BASELINE"))
(defparameter *old* (emitted *baseline*))
(defparameter *legacy-call* '(fn2-ra-shape legacy (subject x fields)
                             (hyp fields) ((fields 1)) (fields-rows)))
(defparameter *legacy* (macroexpand-1 *legacy-call*))
(defparameter *new* (emitted (or (sb-ext:posix-getenv "FN_RA_CANDIDATE")
                               "books/runs-assemble.lisp")))
(assert (equal *legacy* (macroexpand-1 *legacy-call*)))
(assert (equal (mapcar #'strip-proof-options *old*)
               (mapcar #'strip-proof-options *new*)))
(let ((changed (loop for a in *old* for b in *new* unless (equal a b) collect (cadr b))))
 (assert (equal changed '(fn2-run-add-ready fn2-run-add-write-shape fn2-run-build-promote fn2-run-step-child-shape fn2-run-step-up-shape))))
(let ((nil-event (macroexpand-1 (append *legacy-call* '(nil))))
      (custom '(("Goal" :use actual-frame))))
 (assert (null (getf (cdddr nil-event) :hints)))
 (assert (equal (getf (cdddr (macroexpand-1 (append *legacy-call* (list custom)))) :hints)
                custom)))
; Do not allow the hint-only comparison to erase a runtime mutation.
(let ((changed (copy-tree *new*)))
 (setf (car changed) '(defun changed-runtime () nil))
 (assert (not (equal (mapcar #'strip-proof-options *old*)
                     (mapcar #'strip-proof-options changed)))))
(format t "RUN HOT GUARD CONTROLS PASS~%")

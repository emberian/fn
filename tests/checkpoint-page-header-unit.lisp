(in-package "ACL2")
(include-book "c-snapshot-unit")
(include-book "../books/checkpoint-page-header")
(include-book "../books/checkpoint-construction-owner")

(defun fn2-cph-pack (token extent epoch allocation kind ownergen length payload slot gen fn2-checkpoint-construction fn2-core)
 (declare (xargs :stobjs (fn2-checkpoint-construction fn2-core) :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-fields (fn2-core-fields fn2-core))
             (fn2-pool (fn2-core-pool fn2-core))) (code fn2-fields fn2-pool)
  (fn2-checkpoint-page-pack-header token 7 0 ownergen 3 0 extent epoch allocation kind 1 1 length payload 256 slot gen
    fn2-checkpoint-construction fn2-extents fn2-fields fn2-pool) (mv code fn2-core)))

(defun fn2-cph-body (fn2-checkpoint-construction fn2-core)
 (declare (xargs :stobjs (fn2-checkpoint-construction fn2-core) :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-csu-profile* fn2-core))
      (rows (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (n) (fn2-extents-rows fn2-extents) n))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-init rows fn2-checkpoint-construction))
      ((mv epoch-begun fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ; Consume extent0 with the real allocator so the encoded header must
      ; discriminate physical stride16 at a nonzero construction extent.
      ((mv first dummy & & fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-control (fn2-core-control fn2-core)))
        (code e ep al fn2-extents fn2-control) (fn2-storage-reserve-children fn2-extents fn2-control)
        (mv code e ep al fn2-core)))
      ((mv begun token fn2-core) (fn2-csnapshot-begin 7 0 1 fn2-core))
      ((mv held & & fn2-core) (fn2-csu-poll 30 token fn2-core))
      ((mv reserved extent epoch allocation fn2-checkpoint-construction fn2-core)
       (stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core)) (fn2-extents (fn2-core-extents fn2-core))
                   (fn2-control (fn2-core-control fn2-core)))
        (code e ep al fn2-checkpoint-construction fn2-extents fn2-control)
        (fn2-checkpoint-construction-reserve token 7 0 1 3 0 *fn2-format-page-size*
          fn2-csnapshot fn2-checkpoint-construction fn2-extents fn2-control)
        (mv code e ep al fn2-checkpoint-construction fn2-core)))
      ((mv pool slot gen fn2-core) (fn2-core-reserve 3 7 0 1 fn2-core))
      ((mv zeroed fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
        (fn2-run-zero 128 slot gen 0 7 0 1 fn2-pool) (mv code fn2-core)))
      ((mv marker fn2-core) (fn2-core-write slot gen *fn2-checkpoint-page-header-area* 173 7 0 1 fn2-core))
      ((unless (and (eq epoch-begun :ok) (eq first :ok) (= dummy 0) (eq begun :ok) (eq held :held)
                    (eq reserved :ok) (= extent 1) (eq pool :ok) (eq zeroed :ok) (eq marker :ok)))
       (mv nil fn2-checkpoint-construction fn2-core))
      ((mv packed fn2-core) (fn2-cph-pack token extent epoch allocation *page-kind-manifest* 1 *fn2-format-page-size* 32 slot gen fn2-checkpoint-construction fn2-core))
      ((mv decoded bytes fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
        (answer bytes fn2-fields)
        (b* (((mv code next fn2-fields) (fn2-format-page-header-decode 256 slot gen 0 *fn2-checkpoint-page-header-area* 7 0 1 fn2-fields fn2-pool)))
         (mv (and (eq code :ok) (<= next *fn2-checkpoint-page-header-area*)
                  (= (fn2-fields-value (+ 256 *fn2-format-page-header-field-physical-unit*) fn2-fields) 16)
                  (= (fn2-fields-value (+ 256 *fn2-format-page-header-field-writer-epoch*) fn2-fields) epoch)
                  (= (fn2-fields-value (+ 256 *fn2-format-page-header-field-allocation*) fn2-fields) allocation)
                  (= (fn2-fields-value (+ 256 *fn2-format-page-header-field-page-kind*) fn2-fields) *page-kind-manifest*)
                  (= (fn2-fields-value (+ 256 *fn2-format-page-header-field-header-length*) fn2-fields) *fn2-checkpoint-page-header-area*)
                  (= (fn2-fields-value (+ 256 *fn2-format-page-header-field-payload-length*) fn2-fields) 32))
             (fn2-pool-logical-octets 128 (fn2-pool-base slot fn2-pool) fn2-pool) fn2-fields))
        (mv answer bytes fn2-core)))
      ((mv stale fn2-core) (fn2-cph-pack token extent epoch (+ allocation 1) *page-kind-manifest* 1 *fn2-format-page-size* 32 slot gen fn2-checkpoint-construction fn2-core))
      ((mv kind fn2-core) (fn2-cph-pack token extent epoch allocation *page-kind-merkle-node* 1 *fn2-format-page-size* 32 slot gen fn2-checkpoint-construction fn2-core))
      ((mv owner fn2-core) (fn2-cph-pack token extent epoch allocation *page-kind-manifest* 2 *fn2-format-page-size* 32 slot gen fn2-checkpoint-construction fn2-core))
      ((mv length fn2-core) (fn2-cph-pack token extent epoch allocation *page-kind-manifest* 1 4096 32 slot gen fn2-checkpoint-construction fn2-core))
      ((mv overflow fn2-core) (fn2-cph-pack token extent epoch allocation *page-kind-manifest* 1 *fn2-format-page-size* *fn2-format-page-size* slot gen fn2-checkpoint-construction fn2-core))
      (unchanged (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (p)
                   (and (equal bytes (fn2-pool-logical-octets 128 (fn2-pool-base slot fn2-pool) fn2-pool))
                        (= (fn2-pool-datai (+ (fn2-pool-base slot fn2-pool) *fn2-checkpoint-page-header-area*) fn2-pool) 173)) p)))
  (mv (and (eq packed :ok) decoded (eq stale :identity) (eq kind :identity) (eq owner :identity)
           (eq length :identity) (eq overflow :identity) unchanged) fn2-checkpoint-construction fn2-core)))
(defun fn2-cph-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoint-construction
  (mv-let (answer fn2-checkpoint-construction)
   (with-local-stobj fn2-core
    (mv-let (answer fn2-checkpoint-construction fn2-core) (fn2-cph-body fn2-checkpoint-construction fn2-core)
     (mv answer fn2-checkpoint-construction))) answer)))
(assert-event (fn2-cph-test))

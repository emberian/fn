(in-package "ACL2")
(include-book "../books/checkpoint-build")

; Synthetic eligible job metadata isolates the leaf descriptor-budget gate.
; It is not a C-cut/root-construction witness or a generated-worker control.
(defun fn2-checkpoint-budget-roots (role fn2-checkpoint-refs)
 (declare (xargs :stobjs fn2-checkpoint-refs :verify-guards nil :measure (nfix (- 6 (nfix role)))))
 (if (>= (nfix role) 6) fn2-checkpoint-refs
  (let ((fn2-checkpoint-refs (fn2-checkpoint-refs-put role (encoded-length 4096)
          (root-build-token 9) (root-source-complete 1) (root-intended-bytes 4096) (root-completed-bytes 4096))))
   (fn2-checkpoint-budget-roots (+ 1 role) fn2-checkpoint-refs))))
(defun fn2-checkpoint-budget-fill (left at slot gen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-write slot gen at 0 1 0 1 fn2-pool)
   (if (eq code :ok) (fn2-checkpoint-budget-fill (- left 1) (+ 1 at) slot gen fn2-pool) (mv code fn2-pool)))))

(defun fn2-checkpoint-budget-test-body (fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control)
 (declare (xargs :stobjs (fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control)
                 :verify-guards nil))
 (b* ((fn2-checkpoint-build (fn2-checkpoint-build-init 1 fn2-checkpoint-build))
      (fn2-csnapshot (fn2-csnapshot-init 1 fn2-csnapshot))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-init 6 fn2-checkpoint-refs))
      (fn2-extents (fn2-alloc-init 1 fn2-extents))
      (fn2-ops (fn2-ops-init *fn2-profile-tiny* fn2-ops))
      (fn2-alloc-edges (fn2-alloc-edges-init (+ 8 (fn2-ops-rows fn2-ops)) fn2-alloc-edges))
      (fn2-pool (fn2-pool-init '((1 . 4096)) 1 100 fn2-pool))
      (fn2-control (fn2-control-columns-init 0 fn2-control))
      ((mv begun fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv reserved e epoch counter fn2-extents fn2-control) (fn2-storage-reserve-children fn2-extents fn2-control))
      ((mv window slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv filled fn2-pool) (fn2-checkpoint-budget-fill 4096 0 slot gen fn2-pool))
      (fn2-csnapshot (fn2-csnapshot-put 0 (phase *fn2-csnapshot-phase-held*) (token 9)
        (owner-kind 1) (owner-slot 0) (owner-gen 1) (cut-commit 0) (cut-event 0) (complete 1)))
      (fn2-checkpoint-refs (fn2-checkpoint-budget-roots 1 fn2-checkpoint-refs))
      (fn2-checkpoint-build (fn2-checkpoint-build-put 0 (phase *fn2-checkpoint-build-phase-write*)
        (owner-kind 1) (owner-slot 0) (owner-gen 1) (snapshot-token 9) (cut-commit 0) (cut-event 0)
        (candidate 0) (extent e) (epoch epoch) (allocation counter) (slot slot) (gen gen) (pending 0)))
      (free (fn2-ops-free-count fn2-ops)) (queued (fn2-ops-queued fn2-ops))
      (borrows (fn2-pool-out-count slot fn2-pool)) (pins (fn2-extents-outstanding-io e fn2-extents))
      (antecedent (and (eq begun :ok) (eq reserved :ok) (eq window :ok) (eq filled :ok)
                       (posp free) (equal queued 0) (equal borrows 0) (equal pins 0)
                       (fn2-checkpoint-build-ownerp 9 1 0 1 fn2-checkpoint-build fn2-csnapshot)
                       (fn2-checkpoint-built-roots-p 1 0 9 fn2-checkpoint-refs)
                       (fn2-alloc-ownership-invp fn2-extents fn2-alloc-edges)))
      ((mv zero fn2-checkpoint-build fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges)
       (fn2-checkpoint-build-issue 0 fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control))
      (unchanged (and (eq zero :yield) (equal free (fn2-ops-free-count fn2-ops))
                      (equal queued (fn2-ops-queued fn2-ops)) (equal borrows (fn2-pool-out-count slot fn2-pool))
                      (equal pins (fn2-extents-outstanding-io e fn2-extents))
                      (equal (fn2-checkpoint-build-pending 0 fn2-checkpoint-build) 0)
                      (equal (fn2-checkpoint-build-phase 0 fn2-checkpoint-build) *fn2-checkpoint-build-phase-write*)))
      ; Removal/control: the same real reserved handle/window with budget1
      ; queues the physical operation and acquires its pin/borrow.
      ((mv positive fn2-checkpoint-build fn2-pool fn2-ops fn2-control fn2-extents fn2-alloc-edges)
       (fn2-checkpoint-build-issue 1 fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control)))
  (mv (and antecedent unchanged (eq positive :issued)
           (equal (fn2-ops-free-count fn2-ops) (- free 1)) (equal (fn2-ops-queued fn2-ops) (+ queued 1))
           (equal (fn2-pool-out-count slot fn2-pool) (+ borrows 1))
           (equal (fn2-extents-outstanding-io e fn2-extents) (+ pins 1))
           (equal (fn2-checkpoint-build-pending 0 fn2-checkpoint-build) 1))
      fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control)))

(defun fn2-checkpoint-budget-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoint-build
 (mv-let (answer fn2-checkpoint-build)
  (with-local-stobj fn2-csnapshot
 (mv-let (answer fn2-checkpoint-build fn2-csnapshot)
  (with-local-stobj fn2-checkpoint-refs
 (mv-let (answer fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs)
  (with-local-stobj fn2-extents
 (mv-let (answer fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents)
  (with-local-stobj fn2-alloc-edges
 (mv-let (answer fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges)
  (with-local-stobj fn2-pool
 (mv-let (answer fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges fn2-pool)
  (with-local-stobj fn2-ops
 (mv-let (answer fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges fn2-pool fn2-ops)
  (with-local-stobj fn2-control
 (mv-let (answer fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control)
  (fn2-checkpoint-budget-test-body fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control)
  (mv answer fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges fn2-pool fn2-ops)))
  (mv answer fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges fn2-pool)))
  (mv answer fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents fn2-alloc-edges)))
  (mv answer fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs fn2-extents)))
  (mv answer fn2-checkpoint-build fn2-csnapshot fn2-checkpoint-refs)))
  (mv answer fn2-checkpoint-build fn2-csnapshot)))
  (mv answer fn2-checkpoint-build)))
  answer)))
(assert-event (fn2-checkpoint-budget-test))

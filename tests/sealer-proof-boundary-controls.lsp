; Execute the actual wrapper, preserving canonical factory inputs and modes.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defmacro defconst (name value) `(defparameter ,name ,value))
(defun load-wrapper (path)
 (with-open-file (in path)
  (loop for form = (read in nil :eof) until (eq form :eof) do
   (when (or (and (eq (car form) 'defconst) (eq (cadr form) '*fn2-seal-rows-folded*))
             (and (eq (car form) 'defmacro) (eq (cadr form) 'fn2-seal-shape)))
    (eval form)))))
(let* ((calls (with-open-file (in "books/sealer.lisp")
               (loop for form = (read in nil :eof) until (eq form :eof)
                     when (eq (car form) 'fn2-seal-shape) collect form)))
       (controls '((fn2-seal-shape subject (table) (table) (table))
                   (fn2-seal-shape subject (table) (table) (table) nil (explicit-reader))
                   (fn2-seal-shape subject (table) (table) (table) :min (explicit-reader))
                   (fn2-seal-shape subject (table) (table) (table) t (explicit-reader))))
       (all (append calls controls)))
 (assert (> (length calls) 10))
 (load-wrapper (second sb-ext:*posix-argv*))
 (let ((before (mapcar #'macroexpand-1 all)))
  (load-wrapper "books/sealer.lisp")
  (loop for call in all for old in before for new = (macroexpand-1 call) do
   (assert (equal (butlast new) (butlast old)))
   (assert (eq (car new) 'fn2-idc-fn-shape))
   (if (eq (sixth new) t)
       (assert (equal (car (last new)) (append (car (last old)) '(min nfix unsigned-byte-p))))
     (assert (equal old new))))))
(format t "SEALER CANONICAL WRAPPER SOURCE CONTROLS PASS~%")

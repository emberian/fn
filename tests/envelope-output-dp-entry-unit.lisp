(in-package "ACL2")
(include-book "../sim/envelope-output-dp-entry")
(defun fn2-eo-dp-entry-witness (segments peer corrupt-order)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-envelope-output-state
  (mv-let (ok fn2-envelope-output-state)
   (let* ((fn2-envelope-output-state (update-fn2-eo-phase 3 fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-peer peer fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-segments segments fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-ordered (if corrupt-order '((:exact 9)) nil) fn2-envelope-output-state))
          (antecedent (and (equal (fn2-eo-phase fn2-envelope-output-state) 3)
                           (equal (fn2-eo-ordered fn2-envelope-output-state) nil)
                           (fn2-eo-segments-p (fn2-eo-segments fn2-envelope-output-state))
                           (fn2-eo-octets-p (fn2-eo-peer fn2-envelope-output-state))))
          (reversed (revappend segments nil))
          (size (fn2-envelope-output-source-size reversed))
          (fuel (+ (+ 1 (len segments)) (+ 1 (len peer))
                   (+ 1 (* 3 (len reversed)) size (* size (+ 4 (len peer) (len peer))))))
          (expected (fn2-envelope-output-language-p segments peer))
          (fn2-envelope-output-state (fn2-envelope-output-run fuel fn2-envelope-output-state)))
    (mv (let ((conclusion (and (equal (fn2-eo-phase fn2-envelope-output-state) 10)
                               (equal (fn2-eo-peer fn2-envelope-output-state) peer)
                               (equal (fn2-eo-result fn2-envelope-output-state) expected))))
          (if corrupt-order (and (not antecedent) (not conclusion))
            (and antecedent conclusion)))
        fn2-envelope-output-state)) ok)))
(assert-event
 (and (fn2-eo-dp-entry-witness '((:prefix 1) (:exact 2)) '(2) nil)
      (fn2-eo-dp-entry-witness '((:prefix 1) (:exact 2)) '(1 2) nil)
      (fn2-eo-dp-entry-witness '((:prefix 1) (:exact 2)) '(3) nil)
      (fn2-eo-dp-entry-witness '((:prefix 1) (:exact 1)) '(1) nil)
      (fn2-eo-dp-entry-witness nil nil nil)
      (fn2-eo-dp-entry-witness nil '(1) nil)))
; Removing the empty order accumulator changes the language, even with no
; source segments. Keep the theorem fuel unchanged and test its whole conclusion.
(assert-event (fn2-eo-dp-entry-witness nil '(9) t))

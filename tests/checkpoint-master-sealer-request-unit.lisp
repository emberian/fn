; PREPARED / UNEXECUTED source fixture. Actual image + signed client APPEND
; produce the sealer request. Shared SIM pumps drive real callbacks, IO and
; publication. Activation remains NIL: the existing test-only CATALOG entry
; is explicit, so this is not an automatic activation/qualification witness.
; No adopted-source, inventory, page-ready or persistence result is seeded.
(in-package "ACL2")
(include-book "checkpoint-second-adoption-support")

(defun fn2-msrq-requested-drive (fuel fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (cond ((mv-nth 1 (fn2-sealer-checkpoint-pending-op fn2-core))
        (mv :requested fn2-core fn2-sim fn2-own))
       ((fn2-core-stopped-p fn2-core) (mv :stopped fn2-core fn2-sim fn2-own))
       ((zp fuel) (mv :fuel fn2-core fn2-sim fn2-own))
       (t (mv-let (code fn2-core fn2-sim fn2-own) (fn2-cln-pump nil 1 fn2-core fn2-sim fn2-own)
           (if (eq code :failed) (mv code fn2-core fn2-sim fn2-own)
            (fn2-msrq-requested-drive (- fuel 1) fn2-core fn2-sim fn2-own))))))

(defun fn2-msrq-returned-p (tag fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((id (fn2-machine-kind-base *fn2-sealer-kind* fn2-core)))
  (and (eq (fn2-sealer-snapshot-read-code id fn2-core) :ok)
       (= (fn2-machine-phase id fn2-core) *fn2-sealer-state-sealing*)
       (= (fn2-machine-stopped id fn2-core) 0)
       (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
                   (fn2-checkpoint-predecessor-control (fn2-core-checkpoint-predecessor-control fn2-core))
                   (fn2-seals (fn2-core-seals fn2-core)) (fn2-csnapshot (fn2-core-csnapshot fn2-core))) (yes)
        (and (< tag (fn2-checkpoint-summary-tag 0 fn2-checkpoint-summary))
             (= (fn2-checkpoint-summary-phase 0 fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-applied*)
             (= (fn2-checkpoint-predecessor-control-phase 0 fn2-checkpoint-predecessor-control) *fn2-checkpoint-predecessor-phase-done*)
             (= (fn2-checkpoint-predecessor-control-token 0 fn2-checkpoint-predecessor-control)
                (fn2-checkpoint-summary-generation 0 fn2-checkpoint-summary))
             (= (fn2-checkpoint-predecessor-control-completed-originals 0 fn2-checkpoint-predecessor-control)
                (fn2-checkpoint-predecessor-control-count 0 fn2-checkpoint-predecessor-control))
             (= (fn2-seals-source-receipt 0 fn2-seals) 0)
             (= (fn2-csnapshot-phase 0 fn2-csnapshot) *fn2-csnapshot-phase-idle*)) yes))))

(defun fn2-msrq-returned-drive (fuel tag fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (cond ((fn2-msrq-returned-p tag fn2-core) (mv :resumed fn2-core fn2-sim fn2-own))
       ((fn2-core-stopped-p fn2-core) (mv :stopped fn2-core fn2-sim fn2-own))
       ((zp fuel) (mv :fuel fn2-core fn2-sim fn2-own))
       (t (mv-let (code fn2-core fn2-sim fn2-own) (fn2-cln-pump nil 1 fn2-core fn2-sim fn2-own)
           (if (eq code :failed) (mv code fn2-core fn2-sim fn2-own)
            (fn2-msrq-returned-drive (- fuel 1) tag fn2-core fn2-sim fn2-own))))))

(defun fn2-msrq-body (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((mv created fn2-core fn2-sim fn2-own) (fn2-sad-create fn2-core fn2-sim fn2-own))
      ((unless (eq created :created)) (mv (list :create created) fn2-core fn2-sim fn2-own))
      ((mv appended cursor batch nonce fn2-core fn2-sim fn2-own)
       (fn2-cln-register-append 1 0 61 71 *fn2-sad-article* fn2-core fn2-sim fn2-own))
      ((unless (and (eq appended :complete) (consp cursor) (posp batch) (natp nonce)))
       (mv (list :append appended cursor batch nonce) fn2-core fn2-sim fn2-own))
      ((mv requested fn2-core fn2-sim fn2-own) (fn2-msrq-requested-drive 200000 fn2-core fn2-sim fn2-own))
      ((unless (eq requested :requested)) (mv (list :request requested) fn2-core fn2-sim fn2-own))
      (tag (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))) (tag)
             (fn2-checkpoint-summary-tag 0 fn2-checkpoint-summary) tag))
      ((mv premature fn2-core) (fn2-sealer-checkpoint-resume fn2-core))
      ((mv notified target) (fn2-sealer-checkpoint-wake-target fn2-core))
      ; The common admission check must still succeed for this supported
      ; fixture; a request alone is not a permission or resource reservation.
      ((mv pressure needed frontier) (fn2-checkpoint-master-pressure-op 0 (if (mv-nth 1 (fn2-sealer-checkpoint-pending-op fn2-core)) t nil) fn2-core))
      ((unless (and (eq premature :wait) (eq notified :absent) (= target *fn2-none*)
                    (eq pressure :ok) needed (natp frontier)))
       (mv (list :premature premature notified target pressure needed) fn2-core fn2-sim fn2-own))
      ((mv entered fn2-core) (fn2-ccp-maintenance-entry fn2-core))
      ((unless (eq entered :ok)) (mv (list :entry entered) fn2-core fn2-sim fn2-own))
      ((mv adopted fn2-core fn2-sim fn2-own) (fn2-sad-adopt 1000000 fn2-core fn2-sim fn2-own))
      ((unless (eq adopted :complete)) (mv (list :adopt adopted) fn2-core fn2-sim fn2-own))
      ((mv resumed fn2-core fn2-sim fn2-own) (fn2-msrq-returned-drive 200000 tag fn2-core fn2-sim fn2-own)))
  (mv (list resumed premature notified needed (fn2-msrq-returned-p tag fn2-core)) fn2-core fn2-sim fn2-own)))
(defun fn2-msrq-control ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-core fn2-sim fn2-own) (fn2-msrq-body fn2-core fn2-sim fn2-own)))
(assert-event (equal (fn2-msrq-control) '(:resumed :wait :absent t t)))

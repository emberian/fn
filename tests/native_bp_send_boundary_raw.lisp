;;; Actual BP send/fragment observation boundary; sockets/session answers recorded.
;;; The actual ACL2 fragment normalization executes. No TCPCL/image claim.
(load "tests/native_section_envelope_raw.lisp")
(in-package "ACL2")
(load-deployed-forms "books/bp-fragment-send.lisp" '((defun fn-bpfs-fragment-outcome)))
(load-deployed-forms "host/native/bp-service.lisp" '((defstruct fnn-bps)))
(load-deployed-forms "host/native/tcpcl.lisp"
 '((defstruct (fnn-tcl-conn (:conc-name fnn-tclc-)))))
;; New custody helper is absent on the defect base, whose old function does
;; not call it. Read the trusted source's optional literal definition only.
(with-open-file (stream "host/native/bp-service.lisp")
  (loop for form = (read stream nil :eof) until (eq form :eof)
        when (and (consp form) (equal (subseq form 0 (min 2 (length form)))
                                     '(defmacro fnn-bps-with-send-socket))) do (eval form)))
(load-deployed-forms "host/native/bp-service.lisp" '((defun fnn-bps-send-effect-next)))
(defvar *mode* (second sb-ext:*posix-argv*))
(defvar *connects* 0)
(defvar *sessions* 0)
(defvar *closed* nil)
(defvar *opened* nil)
(defvar *results* nil)
(defvar *normalizations* nil)
(define-condition unknown-store-condition (fnn-store-error) ())
(defun send-check (test message)
  (unless test
    (format t "~&BP_SEND_ASSERTION:~a~%" message) (finish-output)
    (error "BP send assertion: ~a" message)))
(defun fnn-developer-selector (variable) (declare (ignore variable)) nil)
(defun fnn-bps-route-host (route) (declare (ignore route)) "host")
(defun fnn-bps-route-port (route) (declare (ignore route)) 1234)
(defun fnn-bps-route-node (route) (declare (ignore route)) "peer")
(defun fnn-bps-route-keepalive (route) (declare (ignore route)) 10)
(defun fnn-bps-route-segment-mru (route) (declare (ignore route)) 100)
(defun fnn-bps-route-transfer-mru (route) (declare (ignore route)) 1000)
(defun fnn-tcl-params (&rest args) (declare (ignore args)) :params)
(defun fnn-socket-fd (socket) socket)
(defun fnn-out (&rest args) (declare (ignore args)) nil)
(defun fnn-core (subject &rest args)
  (case subject
    (fn-bpnj-attempt-token :attempt)
    (fn-tcl-session-negotiated :negotiated)
    (fn-tcl-negotiated-transfer-mtu 2)
    (fn-bpfs-plan (if (equal *mode* "whole") '(:whole) '(:fragments #(1) #(2) #(3))))
    (fn-bpfs-fragment-outcome
     (push args *normalizations*) (apply #'fn-bpfs-fragment-outcome args))
    (otherwise (error "unexpected core subject ~s" subject))))
(defun fnn-tcl-connect (host port)
  (declare (ignore host port)) (incf *connects*)
  (cond ((and (= *connects* 1) (equal *mode* "first-connect"))
         (error 'fnn-os-error :errno sb-posix:econnrefused))
        ((and (= *connects* 2) (equal *mode* "later-connect"))
         (error 'fnn-os-error :errno sb-posix:econnrefused))
        (t (push *connects* *opened*) *connects*)))
(defun fnn-socket-shut (socket)
  (push socket *closed*)
  (when (or (equal *mode* "indeterminate-cleanup")
            (and (= socket 2) (equal *mode* "later-indeterminate-cleanup")))
    (error 'fnn-os-error :errno sb-posix:eio)))
(defun fnn-tcl-session (fd role params tag root &key bundle expect refuse-inbound on-ready)
  (declare (ignore fd role params tag root bundle expect refuse-inbound))
  (incf *sessions*)
  (let ((conn (make-fnn-tcl-conn :outcome :accepted :session :session)))
    (when on-ready (funcall on-ready conn))
    (cond
      ((and (= *sessions* 1)
            (member *mode* '("indeterminate" "indeterminate-cleanup") :test #'equal))
       (fnn-indeterminate "ambiguous inbound staging"))
      ((and (= *sessions* 2)
            (member *mode* '("later-indeterminate" "later-indeterminate-cleanup") :test #'equal))
       (fnn-indeterminate "ambiguous later staging"))
      ((and (= *sessions* 2) (equal *mode* "later-refusal"))
       (fnn-refuse "session machine refused parameters"))
      ((and (= *sessions* 2) (equal *mode* "unknown"))
       (error 'unknown-store-condition :message "unknown Store class"))
      ((equal *mode* "fault") (fnn-fault "core fault")))
    conn))
(defun fnn-bps-foundation-step (service event)
  (declare (ignore service)) (push event *results*) event)
(let* ((service (make-fnn-bps :root "root" :state :state))
       (outcome (handler-case
                  (progn (fnn-bps-send-effect-next service '(:cl-send :route :peer :job #(1 2 3)))
                         :returned)
                  (fnn-store-indeterminate () :indeterminate)
                  (fnn-store-fault () :fault)
                  (unknown-store-condition () :unknown))))
  (cond
    ((member *mode* '("indeterminate" "indeterminate-cleanup" "later-indeterminate"
                     "later-indeterminate-cleanup") :test #'equal)
     (send-check (eq outcome :indeterminate) "ambiguous Store publication must retain its exact class")
     (send-check (null *results*) "ambiguous Store publication must publish no transport result"))
    ((equal *mode* "unknown")
     (send-check (eq outcome :unknown) "unknown subclass must retain its exact class")
     (send-check (null *results*) "unknown subclass publishes no transport result"))
    ((equal *mode* "fault")
     (send-check (eq outcome :fault) "core fault retains its class")
     (send-check (null *results*) "core fault publishes no transport result"))
    (t
     (send-check (eq outcome :returned) "transport observation returns")
     (let ((expected (cond ((equal *mode* "first-connect") :failed)
                           ((member *mode* '("later-refusal" "later-connect") :test #'equal) :uncertain)
                           (t :accepted))))
       (send-check (eq (fnn-bps-transfer service) expected)
                   "accepted fragment prefix cannot become definitely failed")
       (send-check (equal (car *results*) (list :job-result :job :attempt expected))
                   "job result retains durable attempt token"))
     (when (member *mode* '("later-refusal" "later-connect") :test #'equal)
       (send-check (find 2 *normalizations* :key #'car)
                   "actual ACL2 fragment normalization consumes later failure"))))
  (dolist (socket *opened*)
    (send-check (member socket *closed*) "every opened socket custody released"))
  (format t "~&BP_SEND_BOUNDARY_PASS ~a~%" *mode*))

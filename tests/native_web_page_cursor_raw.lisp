;;; Native consumer + deployed ACL2 cursor bodies, over the existing segment
;;; reference. This raw witness is not guard verification or saved-image use.
(load "tests/native_web_reactor_raw.lisp")
(in-package "ACL2")
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun nfix (x) (if (natp x) x 0))
(defun zp (x) (not (and (integerp x) (> x 0))))
(defun len (x) (length x))
(defun true-listp (x) (and (listp x) (null (cdr (last x)))))
(defmacro mv (&rest xs) `(values ,@xs))
(defmacro mv-let (names value &body body) `(multiple-value-bind ,names ,value ,@body))
(defmacro mbe (&key logic exec) (declare (ignore logic)) exec)
(defun fn-wrq-oct (s) (map 'list #'char-code s))
(defun fn-wrq-true (x) (if (true-listp x) x nil))
(defun fn-wrq-nth (n x) (nth n x))
(defun fn-ag-rev-onto (xs acc) (revappend xs acc))
(defun fn-cbor-octetp (x) (typep x '(unsigned-byte 8)))
(defun fn-cbor-octet-listp (xs) (and (true-listp xs) (every #'fn-cbor-octetp xs)))
(defun take (n x) (loop for i below n collect (nth i x)))
(defun fn-octets-get (at in) (aref (svref in 0) at))
(defun fn-octets-len (in) (svref in 1))
(defun fn-oct-slice-list (s e in) (coerce (fnn-web-slice in s e) 'list))
(defun load-page-forms (path &optional wanted)
  (with-open-file (stream path)
    (loop for f = (read stream nil :eof) until (eq f :eof)
          when (and (consp f) (member (car f) '(defun defconst))
                    (or (null wanted) (member (second f) wanted))) do
          (eval (if (eq (car f) 'defconst) (cons 'defparameter (cdr f))
                  (destructuring-bind (name args &rest body) (cdr f)
                    `(defun ,name ,args ,@(remove-if
                      (lambda (x) (and (consp x) (eq (car x) 'declare)
                                       (consp (cadr x)) (eq (caadr x) 'xargs))) body))))))))
(load-page-forms "books/octet-text.lisp"
 '(fn-ot-digitp fn-ot-upperp fn-ot-lowerp fn-ot-alphap fn-ot-hex-value
   fn-ot-hex-digit-upper fn-ot-downcase-octet))
(defun fn-ot-downcase (xs) (mapcar #'fn-ot-downcase-octet xs))
(load-page-forms "books/web-2047.lisp")
(load-page-forms "books/web-render.lisp"
 '(fn-wr-escape-octet fn-wr-escape fn-wr-unreservedp fn-wr-pct-encode-loop
   fn-wr-pct-encode fn-wr-unstuff fn-wr-piece fn-wr-seq))
(load-page-forms "books/web-page-cursor.lisp")
(load-page-forms "host/web-host.lisp" '(fn-web-host-page-cursor fn-web-host-page-step))
(defun page-reference (segs xs) (fn-wr-seq segs xs))
(defun drive-page (segs in fuel emitp)
  (loop with cursor = (fn-wpc-cursor segs) with count = 0 with chunks = nil
        for rounds from 1 to 200000 do
        (multiple-value-bind (bytes next total done)
            (fn-wpc-drive fuel cursor count emitp nil in)
          (assert (<= (length bytes) fuel))
          (when (not emitp) (assert (null bytes)))
          (setf cursor next count total)
          (push bytes chunks)
          (when done (return (values (apply #'append (nreverse chunks)) count rounds))))))
(let* ((prefix (append (fn-wrq-oct "..first<&") '(13 10) (fn-wrq-oct "..second'") '(13 10)))
       (word (fn-wrq-oct "=?UTF-8?Q?caf=C3=A9_&?="))
       (long (make-list 10003 :initial-element 38))
       (xs (append prefix word long))
       (in (create-fn-octets$c))
       (segs (list (cons :m '(60 112 62)) (cons :t '(60 34 38 39))
                   (cons :u '(32 255 47 65)) (cons :s (cons 0 (length prefix)))
                   (cons :d (cons 0 (length prefix)))
                   (cons :w (cons (length prefix) (+ (length prefix) (length word))))
                   (cons :w (cons (+ (length prefix) (length word)) (length xs)))
                   (cons :m '(60 47 112 62)))))
  (fnn-web-fill in (fnn-octets xs))
  (let ((reference (page-reference segs xs)))
    (dolist (fuel '(1 2 7 4096))
      (multiple-value-bind (out count rounds) (drive-page segs in fuel t)
        (assert (equal out reference)) (assert (= count (length reference)))
        (assert (> rounds 1)))
      (multiple-value-bind (out count rounds) (drive-page segs in fuel nil)
        (declare (ignore rounds)) (assert (null out)) (assert (= count (length reference)))))
    ;; The actual native count/emit caller never materializes HTML in OUT.
    (let* ((conn (fixture-conn 31 :page-count))
           (face (%make-fnn-web-face :service :service :conns (list conn)))
           (saved-call (symbol-function 'fnn-call)) (saved-core (symbol-function 'fnn-core))
           (observed-length nil))
      (setf (fnn-web-conn-in conn) in (fnn-web-conn-pagep conn) t
            (fnn-web-conn-page-segs conn) segs (fnn-web-conn-page-cursor conn) (fn-wpc-cursor segs)
            (fnn-web-conn-page-response conn) '(200 nil t))
      (unwind-protect
        (progn
          (setf (symbol-function 'fnn-call)
                (lambda (name &rest args)
                  (if (eq name 'fn-web-host-page-step)
                      (multiple-value-list (apply #'fn-web-host-page-step args))
                    (apply saved-call name args))))
          (setf (symbol-function 'fnn-core)
                (lambda (name &rest args)
                  (case name
                    (fn-web-host-page-cursor (apply #'fn-web-host-page-cursor args))
                    (fn-web-host-head (setf observed-length (third args)) '(72 69 65 68))
                    (otherwise (apply saved-core name args)))))
          (loop while (eq (fnn-web-conn-phase conn) :page-count) do
            (fnn-web-page-step face conn) (assert (zerop (fnn-web-len (fnn-web-conn-out conn)))))
          (assert (= observed-length (length reference)))
          (loop until (fnn-web-conn-closedp conn) do
            (if (eq (fnn-web-conn-phase conn) :write) (fnn-web-write-ready face conn)
              (fnn-web-page-step face conn))
            (assert (<= (length (fnn-web-conn-wire conn)) 4096))
            (assert (zerop (fnn-web-len (fnn-web-conn-out conn)))))
          (assert (equal (wire-for 31) (append '(72 69 65 68) reference))))
        (setf (symbol-function 'fnn-call) saved-call (symbol-function 'fnn-core) saved-core)))))
(format t "NATIVE WEB PAGE CURSOR RAW PASS: exact mixed segments/count/windows; no HTML OUT~%")
;;; Exact core classifier reaches private construction on the fixed worker;
;;; stateful/BEGIN/gone events never take this seam.
(load-page-forms "books/web-session.lisp" '(fn-wss-f-route fn-web-private-reply-p))
(load-page-forms "host/web-host.lisp" '(fn-web-host-private-reply-p))
(dolist (route '(:groups :group :article :post :remove))
  (assert (fn-web-host-private-reply-p (list route) '(:reply)))
  (dolist (event '((:begin) (:gone) (:opened 7) (:closed)))
    (assert (not (fn-web-host-private-reply-p (list route) event)))))
(dolist (route '(:signin :redeem :expire :health :signout))
  (assert (not (fn-web-host-private-reply-p (list route) '(:reply)))))
(let* ((reply (fixture-conn 34 :event 44))
       (face (%make-fnn-web-face :service :service :wake-closed t :conns (list reply)))
       (saved-core (symbol-function 'fnn-core)) (saved-call (symbol-function 'fnn-call))
       (saved-owner (symbol-function 'fnn-owner-serialized)))
  (setf (fnn-web-conn-flow reply) '(:groups :list nil nil)
        (fnn-web-conn-event reply) '(:reply) (fnn-web-conn-leased reply) t)
  (unwind-protect
    (progn
      (setf (symbol-function 'fnn-core)
            (lambda (name &rest args)
              (if (eq name 'fn-web-host-private-reply-p)
                  (apply #'fn-web-host-private-reply-p args) (apply saved-core name args))))
      (setf (symbol-function 'fnn-call)
            (lambda (name &rest args)
              (if (eq name 'fn-web-host-private-reply-step)
                  (progn (fnn-web-fill (fifth args) (fnn-octets '(65 66 67)))
                         (list '(:respond 200 nil t))) (apply saved-call name args))))
      (setf (symbol-function 'fnn-owner-serialized)
            (lambda (&rest args) (declare (ignore args)) (error "private reply entered O")))
      (fnn-web-advance face reply)
      (assert (fnn-web-conn-job reply))
      (assert (eq (fnn-web-job-kind (fnn-web-conn-job reply)) :private-reply))
      (setf (fnn-web-face-jobs-closed face) t)
      (let ((worker (sb-thread:make-thread (lambda () (fnn-web-semantic-body face)))))
        (sb-thread:join-thread worker))
      (assert (eq (fnn-web-conn-phase reply) :write))
      (assert (null *faults*)))
    (setf (symbol-function 'fnn-core) saved-core (symbol-function 'fnn-call) saved-call
          (symbol-function 'fnn-owner-serialized) saved-owner)))
(format t "NATIVE WEB PRIVATE REPLY RAW PASS: exact classifier/fixed worker; no owner admission~%")

(in-package "ACL2")
(include-book "../books/compress-policy")
(defconst *fn2-compress-profile-probe*
 '((:compress-enabled . t) (:compress-input-quantum . 128)
   (:compress-output-quantum . 256) (:compress-expansion-ratio . 8)
   (:compress-expansion-burst . 1024)))
(assert-event (fn2-compress-profilep nil))
(assert-event (fn2-compress-profilep *fn2-compress-profile-probe*))
(assert-event (equal (fn2-compress-admit t nil t *fn2-compress-profile-probe*) :started))
(assert-event (equal (fn2-compress-admit nil nil t *fn2-compress-profile-probe*) :auth-required))
(assert-event (equal (fn2-compress-admit t t t *fn2-compress-profile-probe*) :running))
(assert-event (equal (fn2-compress-admit t nil nil *fn2-compress-profile-probe*) :algorithm))
(assert-event (equal (fn2-compress-admit t nil t nil) :algorithm))
(assert-event (not (fn2-compress-profilep
 (put-assoc-equal :compress-input-quantum #x100000000 *fn2-compress-profile-probe*))))
(assert-event (not (fn2-compress-profilep
 (put-assoc-equal :compress-output-quantum 1025 *fn2-compress-profile-probe*))))
(assert-event (not (fn2-compress-profilep
 (put-assoc-equal :compress-expansion-ratio 0 *fn2-compress-profile-probe*))))
(assert-event (equal (mv-let (status input output) (fn2-compress-plan 128 256 128 256 0) (declare (ignore input output)) status) :limit))
(assert-event (equal (mv-let (status input output) (fn2-compress-plan 128 256 128 256 11) (declare (ignore status input)) output) 11))
; Positive witness includes the entire successful observation and conclusion.
(defun fn2-compress-credit-positive ()
 (declare (xargs :guard t))
 (mv-let (status next) (fn2-compress-observe 0 3 11 128 11 20 8 1024)
  (and (not (equal status :bounds)) (equal status :need-output)
       (natp next) (equal next 33) (<= next 1024)
       (<= (+ next 11) (+ 20 (* 8 3))))))
; Removing observed-prefix/output-credit admission admits an impossible count;
; the real policy refuses and preserves credit instead of granting an advance.
(defun fn2-compress-credit-negative ()
 (declare (xargs :guard t))
 (mv-let (status next) (fn2-compress-observe 0 0 21 128 21 20 8 1024)
  (and (equal status :bounds) (equal next 20)
       (not (<= (+ next 21) (+ 20 (* 8 0)))))))
(assert-event (fn2-compress-credit-positive))
(assert-event (fn2-compress-credit-negative))
(assert-event (equal (mv-let (status credit) (fn2-compress-observe 1 2 0 2 8 20 8 1024) (declare (ignore credit)) status) :final))
(assert-event (equal (mv-let (status credit) (fn2-compress-observe -1 1 0 2 8 20 8 1024) (declare (ignore credit)) status) :failed))
(assert-event (equal (mv-let (status credit) (fn2-compress-observe 0 0 0 2 8 20 8 1024) (declare (ignore credit)) status) :need-input))
(assert-event (equal (mv-let (status credit) (fn2-compress-observe 0 128 1 128 8 20 8 1024) (declare (ignore status)) credit) 1024))

(defun fn2-compress-plan-positive ()
 (declare (xargs :guard t))
 (mv-let (status input output) (fn2-compress-plan 17 19 8 9 7)
  (and (equal status :transform) (equal input 8) (equal output 7)
       (natp input) (natp output) (<= input 17) (<= input 8)
       (<= output 19) (<= output 9) (<= output 7))))
(defun fn2-compress-plan-negative ()
 (declare (xargs :guard t))
 (mv-let (status input output) (fn2-compress-plan -1 19 8 9 7)
  (declare (ignore output))
  (and (equal status :bounds) (not (<= input -1)))))
; Exact exhaustion cannot spin waiting for a zero-capacity primitive call.
(assert-event (mv-let (status credit) (fn2-compress-observe 0 0 20 8 20 20 8 1024)
 (and (equal status :need-output) (equal credit 0)
      (equal (mv-let (status input output) (fn2-compress-plan 8 256 128 256 credit) (declare (ignore input output)) status) :limit))))
(fn2-assert-owed-teeth fn2-compress-plan-bounded fn2-compress-observe-credit-bounded)

;;; Reader-pool hazard controls for host/device.lisp. Run by
;;; tests/test_device_concurrent_reads.py: sbcl --script from the repository
;;; root, one scenario per process, on a fresh image FN2_DEVICE_IMAGE.
;;; FN2_DEVICE_MUTANT weakens exactly one rule; its control must then fail.
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(load "host/ffi.lisp")
(load "host/device.lisp")

(defparameter *image* (or (sb-ext:posix-getenv "FN2_DEVICE_IMAGE") (error "FN2_DEVICE_IMAGE missing")))
(defparameter *scenario* (sb-ext:posix-getenv "FN2_DEVICE_SCENARIO"))
(defparameter *mutant* (sb-ext:posix-getenv "FN2_DEVICE_MUTANT"))
(defparameter *page* 4096)
(defvar *wake* (sb-thread:make-semaphore :name "test wake"))
(defvar *log-lock* (sb-thread:make-mutex :name "test boundary log"))
(defvar *boundaries* nil)               ; (label slot thread-name), newest first
(defvar *t0* 0)

(defun ms ()
  (/ (* 1000.0 (- (get-internal-real-time) *t0*)) internal-time-units-per-second))
(defun pattern (seed)
  (let ((v (make-array *page* :element-type '(unsigned-byte 8))))
    (dotimes (i *page* v) (setf (aref v i) (mod (+ seed (* 31 i)) 256)))))
(defun page (bytes k) (subseq bytes (* k *page*) (* (1+ k) *page*)))
(defun job (slot kind bytes page offset)
  (make-fn2-device-job :slot slot :gen 1 :kind kind :bytes bytes :address (* page *page*)
                       :length (if (eq kind :fence) 0 *page*) :offset offset))
(defun slot-of (completion) (fn2-device-job-slot (car completion)))

(defun record (label job)
  (sb-thread:with-mutex (*log-lock*)
    (push (list label (fn2-device-job-slot job) (sb-thread:thread-name sb-thread:*current-thread*))
          *boundaries*)))
(defun start (fd size backend)
  (fn2-device-start fd size backend 16 (lambda () (sb-thread:signal-semaphore *wake*))
                    (lambda (label job) (record label job))))
(defun create-image ()
  (fn2-device-open *image* :create-size (* 16 *page*)))

(defun take (device n)
  "N completions as (job . ms), in the order the device posted them."
  (loop repeat n
        collect (progn
                  (assert (sb-thread:wait-on-semaphore *wake* :timeout 5) () "completion timed out")
                  (let ((job (fn2-device-take-completion device)))
                    (assert job () "wake without a completion")
                    (cons job (ms))))))

(defun check-boundaries (kinds)
  "KINDS: (slot . kind) of every job performed. Each crossed its pair once,
on one thread: a Read on the pool, a Write or Fence on the writer."
  (let ((seen (reverse *boundaries*)))
    (assert (= (length seen) (* 2 (length kinds))) () "boundary count ~d" (length seen))
    (loop for (slot . kind) in kinds
          for mine = (remove-if-not (lambda (b) (eql (second b) slot)) seen)
          do (assert (equal (mapcar #'first mine) '("device-syscall" "device-syscall-return"))
                     () "slot ~d boundaries ~s" slot mine)
             (assert (equal (third (first mine)) (third (second mine))) () "slot ~d changed thread" slot)
             (assert (string= (third (first mine)) (if (eq kind :read) "fn2 storage read" "fn2 storage"))
                     () "slot ~d ran on ~s" slot (third (first mine))))))

(defun delay (name seconds &optional entered)
  "Sleep before each call of NAME; return the original definition."
  (let ((original (symbol-function name)))
    (setf (symbol-function name)
          (lambda (&rest args)
            (when entered (sb-thread:signal-semaphore entered))
            (sleep seconds)
            (apply original args)))
    original))

(defun storage-threads ()
  (remove-if-not (lambda (thread)
                   (let ((name (sb-thread:thread-name thread)))
                     (and name (search "fn2 storage" name))))
                 (sb-thread:list-all-threads)))

;;; (a) A Fence blocks the writer for 200 ms. Reads submitted before it began
;;; and while it runs all return the Write's bytes without waiting for it.
(defun fence-bypass ()
  (let* ((bytes (make-array (* 5 *page*) :element-type '(unsigned-byte 8) :initial-element 0))
         (a (pattern 1))
         (entered (sb-thread:make-semaphore))
         (finished nil)
         (fence (symbol-function 'fn2-device-fence)))
    (replace bytes a)
    (multiple-value-bind (fd size backend) (create-image)
      ;; After creation, whose own Fence is not under test.
      (setf (symbol-function 'fn2-device-fence)
            (lambda (fd)
              (sb-thread:signal-semaphore entered)
              (sleep 0.2)
              (prog1 (funcall fence fd) (setf finished t))))
      (let ((device (start fd size backend)))
        (unwind-protect
             (let (reads)
               (setf *t0* (get-internal-real-time))
               (fn2-device-submit device (job 0 :write bytes 0 0))
               (fn2-device-submit device (job 1 :fence bytes 0 0))
               (fn2-device-submit device (job 2 :read bytes 1 0))
               (fn2-device-submit device (job 3 :read bytes 2 0))
               (assert (sb-thread:wait-on-semaphore entered :timeout 5) () "the Fence never began")
               (fn2-device-submit device (job 4 :read bytes 3 0))
               (fn2-device-submit device (job 5 :read bytes 4 0))
               (let ((early (take device 5)))
                 (assert (not finished) () "Reads waited for the Fence: ~s"
                         (mapcar #'slot-of early))
                 (assert (= 0 (slot-of (first early))) () "a Read passed the Write before it")
                 (assert (equal (sort (mapcar #'slot-of early) #'<) '(0 2 3 4 5))
                         () "the Fence completed before the Reads")
                 (setf reads (cdr (car (last early))))
                 (assert (< reads 80) () "Reads took ~,1f ms" reads)
                 (dolist (c (rest early))
                   (assert (= *page* (fn2-device-job-result (car c))) () "short Read")
                   (assert (equalp a (page bytes (1- (slot-of c)))) () "a Read returned other bytes")))
               (let ((c (first (take device 1))))
                 (assert (= 1 (slot-of c)))
                 (assert (zerop (fn2-device-job-result (car c))) () "Fence failed")
                 (assert finished)
                 (check-boundaries '((0 . :write) (1 . :fence) (2 . :read) (3 . :read) (4 . :read) (5 . :read)))
                 (format t "PASS fence-bypass reads=~,1fms fence=~,1fms~%" reads (cdr c))))
          (fn2-device-stop device)
          (setf (symbol-function 'fn2-device-fence) fence))))))

;;; (b) Read after Write: the Write's pwrite is held 80 ms; a Read of the same
;;; range submitted right after it returns the new bytes, never the old zeros.
(defun raw ()
  (let ((bytes (make-array (* 2 *page*) :element-type '(unsigned-byte 8) :initial-element 0))
        (b (pattern 2)))
    (replace bytes b)
    (multiple-value-bind (fd size backend) (create-image)
      (let* ((device (start fd size backend))
             (pwrite (delay '%fn2-device-pwrite 0.08)))
        (unwind-protect
             (progn
               (setf *t0* (get-internal-real-time))
               (fn2-device-submit device (job 0 :write bytes 0 *page*))
               (fn2-device-submit device (job 1 :read bytes 1 *page*))
               (let ((done (take device 2)))
                 (assert (equal '(0 1) (mapcar #'slot-of done)) () "the Read returned before the Write it follows")
                 (assert (= *page* (fn2-device-job-result (car (second done)))) () "short Read")
                 (assert (equalp b (page bytes 1)) () "the Read saw bytes older than the Write")
                 (check-boundaries '((0 . :write) (1 . :read)))
                 (format t "PASS raw read=~,1fms~%" (cdr (second done)))))
          (fn2-device-stop device)
          (setf (symbol-function '%fn2-device-pwrite) pwrite))))))

;;; (c) Write after Read: the Read's pread is held 80 ms; a Write to the same
;;; range submitted right after it cannot change what that Read returns.
(defun war ()
  (let ((bytes (make-array (* 4 *page*) :element-type '(unsigned-byte 8) :initial-element 0))
        (a (pattern 1))
        (c (pattern 3)))
    (replace bytes a)
    (replace bytes c :start1 (* 2 *page*))
    (multiple-value-bind (fd size backend) (create-image)
      (let ((device (start fd size backend)) (pread nil))
        (unwind-protect
             (progn
               (fn2-device-submit device (job 0 :write bytes 0 0))
               (assert (= *page* (fn2-device-job-result (car (first (take device 1))))))
               (setf pread (delay '%fn2-device-pread 0.08))
               (setf *t0* (get-internal-real-time))
               (fn2-device-submit device (job 1 :read bytes 1 0))
               (fn2-device-submit device (job 2 :write bytes 2 0))
               (let ((done (take device 2)))
                 (assert (equal '(1 2) (mapcar #'slot-of done)) () "the Write overtook an earlier Read")
                 (assert (equalp a (page bytes 1)) () "the Read saw a later Write's bytes")
                 (fn2-device-submit device (job 3 :read bytes 3 0))
                 (take device 1)
                 (assert (equalp c (page bytes 3)) () "the later Write did not land")
                 (check-boundaries '((0 . :write) (1 . :read) (2 . :write) (3 . :read)))
                 (format t "PASS war write=~,1fms~%" (cdr (second done)))))
          (fn2-device-stop device)
          (when pread (setf (symbol-function '%fn2-device-pread) pread)))))))

;;; (d) Stop during an 150 ms pread: it joins all five workers, the pread ran
;;; on an open fd, the fd is then closed once (a second stop closes nothing),
;;; and no thread or completion outlives it. The image then reopens under a
;;; positional READ-WORKERS of 2.
(defun stop-joins ()
  (assert (null (storage-threads)) () "storage threads before start")
  (let ((bytes (make-array *page* :element-type '(unsigned-byte 8) :initial-element 0))
        (entered (sb-thread:make-semaphore))
        (in-flight nil))
    (multiple-value-bind (fd size backend) (create-image)
      (let* ((device (fn2-device-start fd size backend 16 (lambda () (sb-thread:signal-semaphore *wake*))))
             (workers (cons (fn2-device-thread device) (fn2-device-read-threads device)))
             (pread (symbol-function '%fn2-device-pread)))
        (assert (equal (sort (mapcar #'sb-thread:thread-name (storage-threads)) #'string<)
                       '("fn2 storage" "fn2 storage read" "fn2 storage read" "fn2 storage read" "fn2 storage read"))
                () "workers: ~s" (storage-threads))
        (assert (null (set-exclusive-or workers (storage-threads))))
        (setf (symbol-function '%fn2-device-pread)
              (lambda (fd sap count offset)
                (sb-thread:signal-semaphore entered)
                (sleep 0.15)
                (let ((n (funcall pread fd sap count offset)))
                  (setf in-flight (list n (if (minusp n) (fn2-native-errno) 0)))
                  n)))
        (fn2-device-submit device (job 0 :read bytes 0 0))
        (assert (sb-thread:wait-on-semaphore entered :timeout 5) () "the Read never began")
        (setf *t0* (get-internal-real-time))
        (fn2-device-stop device)
        (let ((stopped (ms)))
          (setf (symbol-function '%fn2-device-pread) pread)
          (assert (equal in-flight (list *page* 0)) () "the fd was closed under an in-flight pread: ~s" in-flight)
          (assert (notany #'sb-thread:thread-alive-p workers) () "a worker outlived stop")
          (assert (null (storage-threads)) () "leaked threads: ~s" (storage-threads))
          (assert (null (fn2-device-take-completion device)) () "a completion was posted after stop")
          (assert (= -1 (%fn2-native-fcntl fd 1 0)) () "stop left the fd open")
          (assert (= 9 (fn2-native-errno)))
          ;; Put a live descriptor at the same number: a repeated stop must not close it.
          (let ((other (fn2-device-open-fd *image* 0)))
            (assert (= fd (sb-alien:alien-funcall
                           (sb-alien:extern-alien "dup2" (function sb-alien:int sb-alien:int sb-alien:int))
                           other fd)))
            (fn2-device-stop device)
            (assert (/= -1 (%fn2-native-fcntl fd 1 0)) () "a second stop closed a reused descriptor")
            (fn2-native-close fd)
            (fn2-native-close other))
          ;; The exclusive flock was released with the descriptor.
          (multiple-value-bind (fd2 size2 backend2) (fn2-device-open *image*)
            (let ((device2 (fn2-device-start fd2 size2 backend2 16
                                             (lambda () (sb-thread:signal-semaphore *wake*))
                                             (lambda (label job) (record label job)) 2)))
              (assert (= 3 (length (storage-threads))) () "READ-WORKERS 2 gave ~s" (storage-threads))
              (fn2-device-submit device2 (job 1 :read bytes 0 0))
              (assert (= *page* (fn2-device-job-result (car (first (take device2 1))))))
              (fn2-device-stop device2)
              (assert (null (storage-threads)) () "leaked threads: ~s" (storage-threads))
              (assert (= -1 (%fn2-native-fcntl fd2 1 0)) () "stop left the fd open")))
          (format t "PASS stop stop=~,1fms~%" stopped))))))

;;; Test-only weakenings, each of one rule.
(let ((read-ready (symbol-function 'fn2-device-read-ready-p))
      (write-ready (symbol-function 'fn2-device-write-ready-p))
      (finish (symbol-function 'fn2-device-finish))
      (stop (symbol-function 'fn2-device-stop)))
  (cond ((null *mutant*))
        ((string= *mutant* "fence-gate")
         ;; The coupling this pool removes: a Read also waits out a Fence.
         (setf (symbol-function 'fn2-device-read-ready-p)
               (lambda (device job)
                 (and (not (fn2-device-active-fence device)) (funcall read-ready device job)))
               (symbol-function 'fn2-device-finish)
               (lambda (device job)
                 (prog1 (funcall finish device job)
                   (sb-thread:with-mutex ((fn2-device-lock device))
                     (sb-thread:condition-broadcast (fn2-device-readable device)))))))
        ((string= *mutant* "no-raw")
         (setf (symbol-function 'fn2-device-read-ready-p)
               (lambda (device job) (declare (ignore device job)) t)))
        ((string= *mutant* "no-war")
         (setf (symbol-function 'fn2-device-write-ready-p)
               (lambda (device job) (declare (ignore device job)) t)))
        ((string= *mutant* "close-first")
         (setf (symbol-function 'fn2-device-stop)
               (lambda (device)
                 (%fn2-native-close (fn2-device-fd device))
                 (funcall stop device))))
        (t (error "unknown mutant ~s" *mutant*))))

(handler-case
    (progn
      (funcall (cond ((equal *scenario* "fence-bypass") #'fence-bypass)
                     ((equal *scenario* "raw") #'raw)
                     ((equal *scenario* "war") #'war)
                     ((equal *scenario* "stop") #'stop-joins)
                     (t (error "unknown scenario ~s" *scenario*))))
      (finish-output))
  (error (condition)
    (let ((*print-pretty* nil))
      (format t "FAIL ~a: ~a~%" *scenario* condition))
    (finish-output)
    (sb-ext:exit :code 1 :abort t)))

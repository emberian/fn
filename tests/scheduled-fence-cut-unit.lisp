; The actual seeded advance now exposes a physical Fence return. The packet
; produced there is replayed through ENVELOPE, before any terminal post.
(in-package "ACL2")
(include-book "native-cut-program-unit")
(include-book "../sim/envelope-prefix")

(defun fn2-scheduled-fence-fixture (fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* (((mv ready fn2-core fn2-sim fn2-own)
        (fn2-native-cut-write-control :finish fn2-core fn2-sim fn2-own))
       ((mv code op gen fn2-core) (fn2-issue-fence 1 0 1 0 fn2-core))
       (fn2-own (fn2-own-observe-issue op fn2-core fn2-own)))
    (mv (and ready (eq code :ok)) op gen fn2-core fn2-sim fn2-own)))

(defun fn2-scheduled-fence-cut-run (crashp mutation fn2-core fn2-sim fn2-own)
  (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
  (b* (((mv ready op gen fn2-core fn2-sim fn2-own)
        (fn2-scheduled-fence-fixture fn2-core fn2-sim fn2-own))
       (descriptor (fn2-envelope-descriptor op fn2-core))
       (prefix (list (append (list :take op gen) descriptor) '(:ack 1)))
       ((mv taken fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own))
       (fn2-sim (update-fn2-sim-fault-budget 0 fn2-sim))
       ((mv advanced fn2-core fn2-sim fn2-own) (fn2-sim-advance fn2-core fn2-sim fn2-own))
       (packet (fn2-sim-saved-return op fn2-sim))
       (unposted (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
                   (yes) (= (fn2-ops-c0-posted op fn2-ops) 0) yes))
       (durable (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim)))
                  (byte) (fn2-sim-storage-durable 0 fn2-sim-storage) byte))
       (stage-ok (and ready (= taken 1) advanced unposted (= durable 17)
                      (= (fn2-sim-active op fn2-sim) *fn2-sim-native-returned*)
                      (equal (take 8 packet) (list op gen *fn2-action-fence* *fn2-event-fence-result* 0 :ok 0 0))
                      (fn2-sim-native-packetp packet fn2-sim)))
       (stamp (fn2-sim-stamp fn2-sim))
       (fn2-sim (if crashp (update-fn2-sim-fault-budget 1 fn2-sim) fn2-sim))
       (fn2-sim (if crashp (fn2-sim-force-fault *fn2-fault-crash* fn2-sim) fn2-sim))
       ((mv resumed fn2-core fn2-sim fn2-own) (fn2-sim-advance fn2-core fn2-sim fn2-own))
       (durable-after (stobj-let ((fn2-sim-storage (fn2-sim-disk fn2-sim)))
                        (byte) (fn2-sim-storage-durable 0 fn2-sim-storage) byte))
       (closed (and resumed (= (fn2-sim-stamp fn2-sim) stamp) (= durable-after 17)
                    (= (fn2-sim-active op fn2-sim) 0)
                    (= (fn2-sim-deaths fn2-sim) (if crashp 1 0))))
       ; Reconstruct the same issued descriptor in a fresh concrete core. The
       ; packet being replayed is the actual prior simulator return, not a
       ; hand-written success or a second implementation of Fence effects.
       ((mv ready again again-gen fn2-core fn2-sim fn2-own)
        (fn2-scheduled-fence-fixture fn2-core fn2-sim fn2-own))
       ((unless (and stage-ok closed ready (= again op) (= again-gen gen)
                     (equal descriptor (fn2-envelope-descriptor again fn2-core))))
        (mv nil fn2-core fn2-sim fn2-own))
       ((mv verdict entries caps fn2-core)
        (fn2-envelope-prefix prefix 0 t nil nil fn2-core))
       ((unless (eq verdict :pass)) (mv nil fn2-core fn2-sim fn2-own))
       (recorded (if (eq mutation :generation) (update-nth 1 (+ 1 gen) packet) packet))
       ((mv verdict entries caps fn2-core)
        (fn2-envelope-prefix (list (list :physical-return recorded)) 2 t entries caps fn2-core))
       ((when (eq mutation :generation))
        (mv (equal verdict '(:physical-return-descriptor 2)) fn2-core fn2-sim fn2-own))
       ((unless (and (eq verdict :pass) (equal (nth 13 (fn2-envelope-get op entries)) packet)
                     (not (nth 10 (fn2-envelope-get op entries)))))
        (mv nil fn2-core fn2-sim fn2-own))
       ((when crashp)
        ; The trace deliberately ends at the real unposted physical prefix.
        (mv t fn2-core fn2-sim fn2-own))
       ((mv outcome reason count aux0 aux1)
        (fn2-host-result (nth 2 packet) (nth 5 packet) (nth 6 packet) (nth 7 packet) (nth 4 packet) nil))
       (post (list :post 0 op gen (nth 3 packet)
                    (if (eq mutation :outcome) *fn2-outcome-failed* outcome)
                    reason count aux0 aux1 *fn2-peer-family-none* '(0 0 0 0 0) nil))
       ((mv verdict entries caps fn2-core)
        (fn2-envelope-prefix (list post) 3 t entries caps fn2-core))
       (- caps))
    (mv (if (eq mutation :outcome) (equal verdict '(:physical-return-post 3))
          (and (eq verdict :pass) (not (nth 13 (fn2-envelope-get op entries)))
               (nth 10 (fn2-envelope-get op entries))))
        fn2-core fn2-sim fn2-own)))

(defun fn2-scheduled-fence-cut-test (crashp mutation)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (ok fn2-core)
      (with-local-stobj fn2-sim
        (mv-let (ok fn2-core fn2-sim)
          (with-local-stobj fn2-own
            (mv-let (ok fn2-core fn2-sim fn2-own)
              (fn2-scheduled-fence-cut-run crashp mutation fn2-core fn2-sim fn2-own)
              (mv ok fn2-core fn2-sim)))
          (mv ok fn2-core)))
      ok)))

(assert-event (and (fn2-scheduled-fence-cut-test t nil)
                   (fn2-scheduled-fence-cut-test nil nil)
                   (fn2-scheduled-fence-cut-test nil :generation)
                   (fn2-scheduled-fence-cut-test nil :outcome)))

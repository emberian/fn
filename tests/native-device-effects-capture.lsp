;;; Test-only device evidence. No storage syscall is added, retried or fenced.
;;; A submit/begin without a return is retained as a potentially effectful cut.
;;; The evidence mutex protects records only: never hold it across device I/O.
(in-package "ACL2")
(defvar *fn2-device-evidence-stream*
  (open (or (sb-ext:posix-getenv "FN2_TEST_DEVICE_EFFECTS")
            (error "device evidence path missing"))
        :direction :output :if-exists :error :if-does-not-exist :create))
(defvar *fn2-device-evidence-lock* (sb-thread:make-mutex :name "device evidence"))
(defvar *fn2-device-evidence-jobs* (make-hash-table :test 'eq))
(defvar *fn2-device-evidence-next* 0)
(defun fn2-device-evidence-record-locked (record)
  (let ((*print-readably* t) (*print-pretty* nil) (*print-length* nil) (*print-level* nil))
    (write record :stream *fn2-device-evidence-stream*)
    (terpri *fn2-device-evidence-stream*)
    (finish-output *fn2-device-evidence-stream*)))
(defun fn2-device-evidence-descriptor (device job)
  ;; Copy the submitted loan before the physical call. Reads have no output
  ;; span; their returned bytes remain separate from Write effect evidence.
  (let ((kind (fn2-device-job-kind job))
        (bytes (fn2-device-job-bytes job))
        (address (fn2-device-job-address job))
        (length (fn2-device-job-length job)))
    (list (fn2-device-fd device) (fn2-device-job-slot job)
          (fn2-device-job-gen job) kind (fn2-device-job-offset job) length
          (if (eq kind :write)
              (loop for i from address below (+ address length) collect (aref bytes i))
            nil))))
(defun fn2-device-evidence-register (device job source)
  (sb-thread:with-mutex (*fn2-device-evidence-lock*)
    (when (gethash job *fn2-device-evidence-jobs*)
      (error "device job submitted twice"))
    (let* ((id (incf *fn2-device-evidence-next*))
           (descriptor (fn2-device-evidence-descriptor device job)))
      (setf (gethash job *fn2-device-evidence-jobs*) (list id descriptor))
      (fn2-device-evidence-record-locked (list source id descriptor))
      id)))
(let ((original (symbol-function 'fn2-device-submit)))
  (setf (symbol-function 'fn2-device-submit)
    (lambda (device job)
      (fn2-device-evidence-register device job :submit)
      (funcall original device job))))
(let ((original (symbol-function 'fn2-device-perform)))
  (setf (symbol-function 'fn2-device-perform)
    (lambda (device job)
      ;; Seed setup may call perform directly before a queue exists.
      (unless (sb-thread:with-mutex (*fn2-device-evidence-lock*)
                (gethash job *fn2-device-evidence-jobs*))
        (fn2-device-evidence-register device job :direct))
      (let ((entry (sb-thread:with-mutex (*fn2-device-evidence-lock*)
                     (gethash job *fn2-device-evidence-jobs*))))
        (sb-thread:with-mutex (*fn2-device-evidence-lock*)
          (unless (equal (cadr entry) (fn2-device-evidence-descriptor device job))
            (error "submitted device descriptor or Write bytes changed"))
          (fn2-device-evidence-record-locked (list :begin (car entry))))
        (multiple-value-prog1 (funcall original device job)
          (sb-thread:with-mutex (*fn2-device-evidence-lock*)
            (fn2-device-evidence-record-locked
             (list :return (car entry) (fn2-device-job-result job)
                   (fn2-device-job-errno job)))))))))

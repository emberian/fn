; PREPARED, UNEXECUTED actual-generator gate. Inspect the SAME emitted core
; face in its real ACL2 world; never define a parallel runtime callback.
(in-package "ACL2")
(include-book "../books/assembly-callbacks-c-prepare")
(include-book "../books/checkpoint-directory-consume")
(include-book "../books/checkpoint-directory-consume-work")
(include-book "../books/checkpoint-master-state")
(make-event
 (let* ((child 'fn2-directory-rebase-consume)
        (world (w state))
        (events (fn2-arms-op-face-events 'fn2-checkpoint-directory-rebase-consume-op child world))
        (definition (car events))
        (body (car (last definition)))
        (bindings (cadr body))
        (ins (fn2-arms-stobjs-of (getpropc child 'stobjs-in nil world)))
        (outs (getpropc child 'stobjs-out nil world))
        (mutable (fn2-arms-stobjs-of outs))
        (budget (fn2-machine-property 'fn2-checkpoint-master :budget world))
        (ceiling (fn2-machine-work-ceiling 'fn2-checkpoint-master world)))
  (if (and (eq (car definition) 'defun)
           (eq (cadr definition) 'fn2-checkpoint-directory-rebase-consume-op)
           (eq (car body) 'stobj-let)
           (equal (strip-cars bindings) ins)
           (equal (len bindings) *fn2-directory-consume-core-get-steps*)
           (equal (len mutable) *fn2-directory-consume-core-store-steps*)
           (equal mutable '(fn2-directory-rebase fn2-checkpoint-summary-authority fn2-commit-root fn2-digests))
           (equal (len (getpropc child 'formals nil world)) 17)
           (equal (len outs) 5)
           (equal (len (caddr body)) (len outs))
           (equal (car (cadddr body)) child)
           (equal (cdr (cadddr body)) (getpropc child 'formals nil world))
           ; Independent dimensions plus the actual kernel's combined modeled
           ; work check. No unrelated external quantum/cap is substituted.
           (<= *fn2-directory-rebase-consume-bytes* (nfix (fn2-arm-get :bytes budget)))
           (<= *fn2-directory-rebase-consume-steps* (nfix (fn2-arm-get :steps budget)))
           (fn2-run-quantitiesp *fn2-directory-rebase-consume-bytes* *fn2-directory-rebase-consume-steps* 0 0 ceiling)
           (<= ceiling (max 1 (fn2-machine-registry-quantity-max (fn2-machine-names world) t world))))
      (value '(value-triple :actual-directory-consume-core-face-shape))
    (er soft 'directory-consume-face-source-unit "Actual emitted consume face changed its input/mutable/result geometry."))))

; Remove ONLY the supported per-B-row quota equality from the canonical input.
; These are valid synthetic credit schedules, not supported profile geometry:
; 3 journal windows fail during actual partial redemption; 5 reach actual END
; with one quota unredeemed. No interleaving is inserted into atomic START.
; No physical IO, persisted member, configured C working29 or service claim.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "ordinary-drain-credit-canonical-unit")

(defun fn2-odcq-configure (windows fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-commit (fn2-commit-table fn2-core))
             (fn2-commit-io (fn2-core-commit-io fn2-core))
             (fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
  (let* ((rows (fn2-commit-rows fn2-commit))
         (io (fn2-commit-io-rows fn2-commit-io))
         (journal (fn2-pool-class-for *fn2-commit-unit-bytes* fn2-pool)))
   (if (or (zp rows) (not (= io (* *fn2-commit-write-resources* rows)))
           (not (fn2-checkpoint-future-roomp 0 fn2-pool))) (mv :geometry fn2-pool)
    (fn2-pool-credit-configure
     (cons (cons *fn2-pool-credit-working* (fn2-odcc-vector 0 journal 0 t fn2-pool))
           (fn2-odcc-drain-groups rows (fn2-odcc-vector 0 journal windows nil fn2-pool))) fn2-pool)))
  (mv code fn2-core)))
(defun fn2-odcq-extents (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (view)
  (fn2-extents-copy fn2-extents) view))
(defun fn2-odcq-gens (i fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- (fn2-pool-rows fn2-pool) (nfix i)))))
 (if (not (and (natp i) (< i (fn2-pool-rows fn2-pool)))) nil
  (cons (fn2-pool-gen i fn2-pool) (fn2-odcq-gens (+ 1 i) fn2-pool))))
; Snapshot delta only: every changed generation must advance exactly once.
(defun fn2-odcq-generation-advances (before after)
 (declare (xargs :verify-guards nil :measure (len before)))
 (if (atom before) (if (atom after) 0 :length)
  (if (atom after) :length
   (let ((rest (fn2-odcq-generation-advances (cdr before) (cdr after))))
    (if (not (and (natp rest)
                  (or (= (car before) (car after)) (= (+ 1 (car before)) (car after))))) :changed
     (+ rest (if (= (car before) (car after)) 0 1)))))))
(defun fn2-odcq-no-issue-p (id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (and (= (fn2-machine-pending id fn2-core) 0)
      (= (fn2-machine-cb-issued id fn2-core) 0)
      (= (fn2-machine-cb-wrote id fn2-core) 0)
      (= (fn2-machine-cb-fence-live id fn2-core) 0)
      (= (fn2-machine-cb-fence-ok id fn2-core) 0)
      (= (fn2-machine-batch-no id fn2-core) 0)
      (= (fn2-machine-phase id fn2-core) *fn2-commit-state-free*)))
(defun fn2-odcq-held-windows (left id generation group nonce extent epoch allocation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) t
  (b* ((role (- left 1))
       ((mv e ep a slot gen) (fn2-commit-resource id (if (= role *fn2-commit-write-resources*) 0 role) fn2-core))
       (slot (if (= role *fn2-commit-write-resources*) (fn2-machine-pool-slot id fn2-core) slot))
       (gen (if (= role *fn2-commit-write-resources*) (fn2-machine-pool-gen id fn2-core) gen))
       (held (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (yes)
         (and (posp gen)
              (eq (fn2-pool-workspace-code slot gen *fn2-commit-kind* id generation fn2-pool) :ok)
              (= (fn2-pool-credit-group slot fn2-pool) group)
              (= (fn2-pool-credit-nonce slot fn2-pool) nonce)
              (= (fn2-pool-credit-owner-kind slot fn2-pool) *fn2-commit-kind*)
              (= (fn2-pool-credit-owner-slot slot fn2-pool) id)
              (= (fn2-pool-credit-owner-gen slot fn2-pool) generation)) yes)))
   (and held (= e extent) (= ep epoch) (= a allocation)
        (fn2-odcq-held-windows (- left 1) id generation group nonce extent epoch allocation fn2-core)))))
(defun fn2-odcq-held-slots (id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv & & & s0 &) (fn2-commit-resource id 0 fn2-core))
      ((mv & & & s1 &) (fn2-commit-resource id 1 fn2-core))
      ((mv & & & s2 &) (fn2-commit-resource id 2 fn2-core)))
  (list s0 s1 s2 (fn2-machine-pool-slot id fn2-core))))
(defun fn2-odcq-body (windows fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-odcc-profile* fn2-core))
      ((mv epoch-start fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv configured fn2-core) (fn2-odcq-configure windows fn2-core))
      (id (fn2-machine-kind-base *fn2-commit-kind* fn2-core)) (partner (+ 1 id))
      (generation (fn2-machine-generation id fn2-core))
      (group (+ 1 (fn2-commit-row id fn2-core)))
      (other (+ 1 (fn2-commit-row partner fn2-core)))
      (class (fn2-scribe-window-class fn2-core))
      ((mv nonce key & mode) (fn2-commit-frontier fn2-core))
      (antecedent
       (stobj-let ((fn2-commit (fn2-commit-table fn2-core))
                   (fn2-commit-io (fn2-core-commit-io fn2-core))
                   (fn2-pool (fn2-core-pool fn2-core))) (yes)
        (and (posp (fn2-commit-rows fn2-commit))
             (= (+ 1 (floor (fn2-commit-io-rows fn2-commit-io) (fn2-commit-rows fn2-commit)))
                (+ 1 *fn2-commit-write-resources*))
             (not (= windows (+ 1 *fn2-commit-write-resources*)))
             (member-equal windows '(3 5))
             (fn2-pool-credit-shapep fn2-pool)
             (= (fn2-pool-credit-configured fn2-pool) 1)
             (= (fn2-pool-credit-demandi (+ (* group (fn2-pool-nclasses fn2-pool)) class) fn2-pool) windows)
             (fn2-pool-credit-fullp 0 0 fn2-pool)
             (fn2-pool-credit-fullp group 0 fn2-pool)
             (fn2-pool-credit-fullp other 0 fn2-pool)) yes))
      (before-extents (fn2-odcq-extents fn2-core))
      (before-queued (fn2-odcc-queued fn2-core))
      (free-before (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (free)
                    (fn2-odcc-free-counts 0 fn2-pool) free))
      (gens-before (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (gens)
                    (fn2-odcq-gens 0 fn2-pool) gens))
      (initial-free (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (n)
                     (fn2-alloc-total-free fn2-extents) n))
      ((unless (and (eq epoch-start :ok) (eq configured :ok) antecedent
                    (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))
                    (posp initial-free) (fn2-odcq-no-issue-p id fn2-core))) (mv nil fn2-core))
      ; One actual nonyielding START. No callback, hook or carrier mutation
      ; occurs between credit redemption, extent reservation and END.
      ((mv started fn2-core) (fn2-commit-start id 1 key mode partner fn2-core))
      (unchanged-queue (equal before-queued (fn2-odcc-queued fn2-core)))
      ((when (= windows 3))
       (b* ((restored (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (yes)
              (and (fn2-pool-credit-ownerp group nonce *fn2-commit-kind* id generation fn2-pool)
                   (= (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-aborted-empty*)
                   (fn2-pool-credit-fullp group 0 fn2-pool)
                   (fn2-pool-credit-fullp 0 0 fn2-pool)
                   (fn2-pool-credit-fullp other 0 fn2-pool)
                   (equal free-before (fn2-odcc-free-counts 0 fn2-pool))
                   (= (fn2-odcq-generation-advances gens-before (fn2-odcq-gens 0 fn2-pool)) windows)) yes))
            ((mv & & & & g0) (fn2-commit-resource id 0 fn2-core))
            ((mv & & & & g1) (fn2-commit-resource id 1 fn2-core))
            ((mv & & & & g2) (fn2-commit-resource id 2 fn2-core)))
        (mv (and (eq started :exhausted) restored unchanged-queue
                 (fn2-odcq-no-issue-p id fn2-core)
                 (= g0 0) (= g1 0) (= g2 0) (= (fn2-machine-pool-gen id fn2-core) 0)
                 (equal before-extents (fn2-odcq-extents fn2-core))
                 (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))) fn2-core)))
      ((mv e ep a & &) (fn2-commit-resource id 0 fn2-core))
      (retained (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                            (fn2-pool (fn2-core-pool fn2-core))) (yes)
        (and (eq (fn2-alloc-handle-code e ep a fn2-extents) :ok)
             (= (fn2-extents-state e fn2-extents) *fn2-extent-state-reserved*)
             (= (fn2-extents-reservation e fn2-extents) 1)
             (= (fn2-alloc-total-reserved fn2-extents) 1)
             (= (fn2-alloc-total-free fn2-extents) (- initial-free 1))
             (fn2-pool-credit-ownerp group nonce *fn2-commit-kind* id generation fn2-pool)
             (= (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-redeeming*)
             (= (fn2-pool-credit-availablei (+ (* group (fn2-pool-nclasses fn2-pool)) class) fn2-pool) 1)
             (fn2-pool-credit-fullp 0 0 fn2-pool)
             (fn2-pool-credit-fullp other 0 fn2-pool)) yes))
      ((unless (and (eq started :uncertain) retained unchanged-queue
                    (fn2-odcq-no-issue-p id fn2-core)
                    (= (fn2-core-stop-reason fn2-core) *fn2-stop-reason-commit-resource*)
                    (fn2-core-stopped-p fn2-core) (fn2-core-wfp fn2-core)
                    (fn2-odcq-held-windows (+ 1 *fn2-commit-write-resources*) id generation group nonce e ep a fn2-core)
                    (= (len (remove-duplicates-equal (fn2-odcq-held-slots id fn2-core)))
                       (+ 1 *fn2-commit-write-resources*))))
       (mv nil fn2-core))
      ; After START has returned uncertain, actual abort/rearm APIs refuse.
      ; These are sequential refusal checks, not an invented START interleave.
      (leases-before (fn2-odcc-leases fn2-core))
      (extents-before (fn2-odcq-extents fn2-core))
      ((mv aborted fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
        (fn2-pool-credit-abort-empty group nonce *fn2-commit-kind* id generation fn2-pool) (mv code fn2-core)))
      ((mv rearmed fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
        (fn2-pool-credit-begin group *fn2-pool-credit-drain* nonce *fn2-commit-kind* id generation fn2-pool)
        (mv code fn2-core))))
  (mv (and (eq aborted :pending) (eq rearmed :owner)
           (equal leases-before (fn2-odcc-leases fn2-core))
           (equal extents-before (fn2-odcq-extents fn2-core))
           (equal before-queued (fn2-odcc-queued fn2-core))
           (fn2-odcq-no-issue-p id fn2-core) (fn2-core-stopped-p fn2-core)) fn2-core)))
(defun fn2-odcq-run (windows)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-odcq-body windows fn2-core) ok)))
(assert-event (fn2-odcq-run 3))
(assert-event (fn2-odcq-run 5))

; Exact-ticket primitive controls. The synthetic closed-job token is an
; explicit fixture premise, not proof of the actual construction/C-cut closure.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-tickets")
(defun fn2-ticket-control (fn2-extents fn2-checkpoint-construction)
 (declare (xargs :stobjs (fn2-extents fn2-checkpoint-construction) :verify-guards nil))
 (b* ((fn2-extents (fn2-alloc-init 4 fn2-extents))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-init 4 fn2-checkpoint-construction))
      ((mv epcode fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv a & e0 ep0 al0 fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv b & e1 ep1 al1 fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((unless (and (eq epcode :ok) (eq a :ok) (eq b :ok))) (mv nil fn2-extents fn2-checkpoint-construction))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-put e0
       (live 1) (token 7) (owner-kind 1) (owner-slot 2) (owner-gen 3)
       (role 6) (ordinal 1) (epoch ep0) (counter al0) (intended-bytes 12288)))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-put e1
       (live 1) (token 7) (owner-kind 1) (owner-slot 2) (owner-gen 3)
       (role 6) (ordinal 0) (epoch ep1) (counter al1) (intended-bytes 12288)))
      (fn2-extents (update-fn2-alloc-freeze-phase 1 fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-token 7 fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-owner-kind 1 fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-owner-slot 2 fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-owner-gen 3 fn2-extents))
      ((mv copy-code & & & fn2-checkpoint-construction) (fn2-checkpoint-ticket-take 11 fn2-checkpoint-construction fn2-extents))
      ((unless (and (eq copy-code :exhausted) (= (fn2-construction-ticket-scan fn2-checkpoint-construction) 0)))
       (mv nil fn2-extents fn2-checkpoint-construction))
      (fn2-extents (update-fn2-alloc-freeze-phase 2 fn2-extents))
      (head (fn2-alloc-free-head fn2-extents))
      ((mv first & & & fn2-checkpoint-construction) (fn2-checkpoint-ticket-take 11 fn2-checkpoint-construction fn2-extents))
      ((mv second e ep al fn2-checkpoint-construction) (fn2-checkpoint-ticket-take 11 fn2-checkpoint-construction fn2-extents))
      ((unless (and (eq first :more) (eq second :ok) (= e e1) (= ep ep1) (= al al1)
                     (= (fn2-alloc-free-head fn2-extents) head)))
       (mv nil fn2-extents fn2-checkpoint-construction))
      ((mv wrong fn2-extents) (fn2-checkpoint-ticket-install e ep al 12 1 fn2-checkpoint-construction fn2-extents))
      ((unless (and (eq wrong :frozen) (= (fn2-extents-state e fn2-extents) *fn2-extent-state-reserved*)
                     (= (fn2-alloc-freeze-phase fn2-extents) 2)))
       (mv nil fn2-extents fn2-checkpoint-construction))
      ((mv right fn2-extents) (fn2-checkpoint-ticket-install e ep al 11 1 fn2-checkpoint-construction fn2-extents))
      ((mv third te tep tal fn2-checkpoint-construction) (fn2-checkpoint-ticket-take 12 fn2-checkpoint-construction fn2-extents)))
  (mv (and (eq right :ok) (= (fn2-extents-state e1 fn2-extents) *fn2-extent-state-allocated*)
           (= (fn2-extents-owner-id e1 fn2-extents) 11) (= (fn2-alloc-freeze-phase fn2-extents) 2)
           (eq third :ok) (= te e0) (= tep ep0) (= tal al0)
           (= (fn2-alloc-free-head fn2-extents) head)) fn2-extents fn2-checkpoint-construction)))
(defun fn2-ticket-control-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-extents
  (mv-let (ok fn2-extents)
   (with-local-stobj fn2-checkpoint-construction
    (mv-let (ok fn2-extents fn2-checkpoint-construction)
     (fn2-ticket-control fn2-extents fn2-checkpoint-construction)
     (mv ok fn2-extents))) ok)))
(assert-event (fn2-ticket-control-run))

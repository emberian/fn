(in-package "ACL2")
(include-book "../books/checkpoint-descriptor")

; Local external-read provenance control. The old metadata facts are synthetic
; antecedent data, not a claim that root construction or a C cut executed.
; Reading an identical physical Ref must still clear its old construction token.
(defun fn2-checkpoint-provenance-test-body (fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-checkpoint-refs (fn2-checkpoint-refs-init 6 fn2-checkpoint-refs))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-init 192 fn2-checkpoint-bytes))
      (fn2-fields (fn2-fields-init 128 fn2-fields))
      (fn2-pool (fn2-pool-init '((1 . 256)) 1 100 fn2-pool))
      ((mv reserved slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((unless (eq reserved :ok)) (mv nil fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-put 1 (storage-domain 0) (physical-unit 16)
        (writer-epoch 1) (allocation 1) (page-kind *page-kind-manifest*) (encoded-length 65536)
        (root-build-token 7) (root-source-complete 1) (root-intended-bytes 65536) (root-completed-bytes 65536)))
      (antecedent (and (equal (fn2-checkpoint-refs-root-build-token 1 fn2-checkpoint-refs) 7)
                       (equal (fn2-checkpoint-refs-root-source-complete 1 fn2-checkpoint-refs) 1)
                       (equal (fn2-checkpoint-refs-root-intended-bytes 1 fn2-checkpoint-refs) 65536)
                       (equal (fn2-checkpoint-refs-root-completed-bytes 1 fn2-checkpoint-refs) 65536)))
      ((mv encoded fn2-fields fn2-pool)
       (fn2-checkpoint-descriptor-root 0 0 0 slot gen 1 0 1 fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool))
      ((unless (eq encoded :ok)) (mv nil fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool))
      ((mv copied fn2-checkpoint-refs fn2-checkpoint-bytes)
       (fn2-checkpoint-capture-root 0 0 0 slot gen 1 0 1 fn2-fields fn2-pool fn2-checkpoint-refs fn2-checkpoint-bytes)))
  (mv (and antecedent (eq copied :ok)
           (equal (fn2-checkpoint-refs-physical-unit 1 fn2-checkpoint-refs) 16)
           (equal (fn2-checkpoint-refs-writer-epoch 1 fn2-checkpoint-refs) 1)
           (equal (fn2-checkpoint-refs-allocation 1 fn2-checkpoint-refs) 1)
           (equal (fn2-checkpoint-refs-encoded-length 1 fn2-checkpoint-refs) 65536)
           (fn2-checkpoint-pool-hash-matchesp 32 32 0 slot gen 1 0 1 fn2-pool fn2-checkpoint-bytes)
           (equal (fn2-checkpoint-refs-root-build-token 1 fn2-checkpoint-refs) 0)
           (equal (fn2-checkpoint-refs-root-source-complete 1 fn2-checkpoint-refs) 0)
           (equal (fn2-checkpoint-refs-root-intended-bytes 1 fn2-checkpoint-refs) 0)
           (equal (fn2-checkpoint-refs-root-completed-bytes 1 fn2-checkpoint-refs) 0))
      fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)))

(defun fn2-checkpoint-provenance-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoint-refs
 (mv-let (answer fn2-checkpoint-refs)
  (with-local-stobj fn2-checkpoint-bytes
 (mv-let (answer fn2-checkpoint-refs fn2-checkpoint-bytes)
  (with-local-stobj fn2-fields
 (mv-let (answer fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields)
  (with-local-stobj fn2-pool
 (mv-let (answer fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
  (fn2-checkpoint-provenance-test-body fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
  (mv answer fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields)))
  (mv answer fn2-checkpoint-refs fn2-checkpoint-bytes)))
  (mv answer fn2-checkpoint-refs)))
  answer)))
(assert-event (fn2-checkpoint-provenance-test))

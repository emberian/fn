; Actual generated upload TAKE and arm cleanup. Assertions are source-prepared,
; not executed. Ordinary/unconfigured mode is explicit; image init is covered
; by root-working-credit-init-unit with this SAME three-range declaration.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/node-profile")
(defun fn2-upt-noio-view (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-machines (fn2-core-machines fn2-core))
             (fn2-upload (fn2-upload-table fn2-core))
             (fn2-ops (fn2-core-ops fn2-core))
             (fn2-control (fn2-core-control fn2-core))
             (fn2-extents (fn2-core-extents fn2-core))) (view)
  (list (fn2-machines-view fn2-machines) (fn2-upload-view fn2-upload)
        (fn2-ops-view fn2-ops) (fn2-control-view fn2-control) (fn2-extents-view fn2-extents)) view))
(defun fn2-upt-free (i fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil
  :measure (nfix (- (nfix (fn2-pool-nclasses fn2-pool)) (nfix i)))))
 (if (not (and (natp i) (< i (nfix (fn2-pool-nclasses fn2-pool))))) nil
  (cons (fn2-pool-free-count i fn2-pool) (fn2-upt-free (+ i 1) fn2-pool))))
(defun fn2-upt-leave-one (fuel class fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix fuel)))
 (if (or (zp fuel) (<= (fn2-pool-reservable-count class fn2-pool) 1)) fn2-pool
  (mv-let (code slot gen fn2-pool) (fn2-pool-reserve class 200 0 1 fn2-pool)
   (declare (ignore slot gen))
   (if (eq code :ok) (fn2-upt-leave-one (- fuel 1) class fn2-pool) fn2-pool))))
(defun fn2-upt-owned (id gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((c0 (fn2-upload-row-c0-slot id fn2-core)) (g0 (fn2-upload-row-c0-gen id fn2-core))
       (c1 (fn2-upload-row-c1-slot id fn2-core)) (g1 (fn2-upload-row-c1-gen id fn2-core))
       (ls (fn2-upload-row-lslot id fn2-core)) (lg (fn2-upload-row-lgen id fn2-core)))
  (and (not (equal c0 c1)) (not (equal c0 ls)) (not (equal c1 ls))
       (equal (fn2-upload-row-lease id fn2-core) *fn2-upload-lease-held*)
       (equal (fn2-upload-row-stream-active id fn2-core) 0)
       (stobj-let ((fn2-input-config (fn2-core-input-config fn2-core))
                   (fn2-pool (fn2-core-pool fn2-core))) (yes)
        (and (eq (fn2-pool-workspace-code c0 g0 *fn2-upload-kind* id gen fn2-pool) :ok)
             (eq (fn2-pool-workspace-code c1 g1 *fn2-upload-kind* id gen fn2-pool) :ok)
             (eq (fn2-pool-workspace-code ls lg *fn2-upload-kind* id gen fn2-pool) :ok)
             (<= (fn2-upload-stream-request-bytes fn2-input-config) (fn2-pool-cap ls fn2-pool))) yes))))
(defun fn2-upt-run (fuel id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (or (zp fuel) (equal (fn2-upload-row-phase id fn2-core) *fn2-upload-state-free*)) fn2-core
  (mv-let (code observed visited actions fn2-core) (fn2-turn fn2-core)
   (declare (ignore code observed visited actions))
   (fn2-upt-run (- fuel 1) id fn2-core))))
(defun fn2-upt-body (short alias fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((base (put-assoc-equal :image-boot nil
                (put-assoc-equal :article-max 32768 *fn2-node-profile*)))
      (classes (fn2-profile-pool-classes base))
      (profile (if alias (put-assoc-equal :pool-classes
                           (list (cons (+ (caar classes) (caadr classes)) (cdadr classes))) base) base))
      ((unless (and (fn2-profilep profile) (fn2-core-profilep profile))) (mv nil fn2-core))
      (fn2-core (fn2-init-executor profile :null nil fn2-core))
      ((unless (not (fn2-core-stopped-p fn2-core))) (mv nil fn2-core))
      (page-class (fn2-upload-stream-class fn2-core))
      (head-class (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (class)
                    (fn2-pool-class-for *fn2-upload-header-workspace-bytes* fn2-pool) class))
      ((unless (and (natp page-class) (equal page-class head-class))) (mv nil fn2-core))
      (fn2-core (if short
        (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (fn2-pool)
         (fn2-upt-leave-one (fn2-pool-nslots fn2-pool) page-class fn2-pool) fn2-core) fn2-core))
      (before (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (counts) (fn2-upt-free 0 fn2-pool) counts))
      (noio (fn2-upt-noio-view fn2-core))
      (first (fn2-machine-free-head *fn2-upload-admission-ordinal* fn2-core))
      (ready (fn2-machine-pool-has-p
               (fn2-machine-partition-runtime-classes *fn2-upload-admission-ordinal* fn2-core) fn2-core))
      ((mv code id gen fn2-core)
       (fn2-machine-take-fn2-upload *fn2-none* *fn2-none* 0 0 *fn2-upload-rule-post* 0 0 fn2-core)))
  (if short
    (mv (and (equal noio (fn2-upt-noio-view fn2-core)) (not ready) (eq code :pool) (equal id *fn2-none*) (equal gen 0)
             (equal (fn2-machine-free-head *fn2-upload-admission-ordinal* fn2-core) first)
             (equal (fn2-upload-row-phase first fn2-core) *fn2-upload-state-free*)
             (equal before (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (counts)
                              (fn2-upt-free 0 fn2-pool) counts))) fn2-core)
   (b* ((owned (and ready (eq code :ok) (equal id first) (fn2-upt-owned id gen fn2-core)))
        ; No linked feeder exists: actual HEAD->ABORTING->DRAINING must return
        ; the uninitialized page before C1/C0, without touching source extents.
        (fn2-core (fn2-upt-run (* 8 (fn2-machine-index-count profile)) id fn2-core)))
    (mv (and owned (not (fn2-core-stopped-p fn2-core))
             (equal (fn2-upload-row-phase id fn2-core) *fn2-upload-state-free*)
             (equal (fn2-upload-row-lease id fn2-core) *fn2-upload-lease-none*)
             (equal before (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (counts)
                              (fn2-upt-free 0 fn2-pool) counts))) fn2-core)))))
(defun fn2-upt-case (short alias)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (yes fn2-core) (fn2-upt-body short alias fn2-core) yes)))
(assert-event (fn2-upt-case nil nil))
(assert-event (fn2-upt-case t nil))
(assert-event (fn2-upt-case nil t))
(assert-event (fn2-upt-case t t))

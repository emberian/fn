(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun member-eq (x xs) (member x xs :test #'eq))
(defun intern-in-package-of-symbol (name sym) (intern name (symbol-package sym)))
(defun book-forms (path)
 (with-open-file (in path) (loop for x = (read in nil :eof) until (eq x :eof) collect x)))
(defun selected-form (path name)
 (find name (book-forms path) :key (lambda (x) (and (consp x) (cadr x)))))
(eval (selected-form "books/declare.lisp" 'fn2-decl-get))
(dolist (name '(fn2-columns-sym fn2-columns-pre fn2-columns-preservation-facts
               fn2-columns-forward-facts fn2-columns-preserves fn2-columns-preserves-macro))
 (eval (selected-form "books/columns.lisp" name)))
(eval (fn2-columns-preserves-macro 'fn2-id-decides))
(defparameter *old* (book-forms (sb-ext:posix-getenv "FN_BIND_BASELINE")))
(defparameter *new* (book-forms "books/machines-c-bind.lisp"))
(defparameter *added* (remove-if-not
 (lambda (x) (and (consp x) (eq (car x) 'local)
  (consp (cadr x))
  (member (cadadr x) '(fn2-id-query-mask-natp fn2-id-query-mask-bound
                      fn2-id-decides-set-qmask fn2-id-decides-set-qwake)))) *new*))
(assert (= (length *added*) 4))
(defparameter *calls* (mapcar #'cadr (cddr *added*)))
(defun checked-hyps (width)
 `((fn2-id-decidesp fn2-id-decides) (fn2-id-decides-wfp fn2-id-decides)
   (natp tx) (< tx (fn2-id-decides-rows fn2-id-decides))
   (unsigned-byte-p ,width v)))
(let ((mutation (sb-ext:posix-getenv "FN_BIND_MUTATION")))
 (cond ((equal mutation "runtime")
        (let ((fn (find 'fn2-id-query-release *new* :key #'cadr)))
         (setf (car (last fn)) nil)))
       ((equal mutation "hyps")
        (setf (getf (cdddr (first *calls*)) :hyps) (butlast (checked-hyps 8))))
       ((equal mutation "wake-width")
        (setf (getf (cdddr (second *calls*)) :hyps) (checked-hyps 8)))
       ((equal mutation "forward") (setf (getf (cdddr (first *calls*)) :forward) nil))))
(assert (string= (prin1-to-string *old*)
 (prin1-to-string (remove-if (lambda (x) (member x *added* :test #'eq)) *new*))))
(loop for call in *calls* for width in '(8 1)
      for fn in '(fn2-id-decides-set-qmask fn2-id-decides-set-qwake) do
 (assert (equal (getf (cdddr call) :hyps) (checked-hyps width)))
 (assert (eq (getf (cdddr call) :forward) t))
 (assert (eq (getf (cdddr call) :wfp-type) t))
 (assert (null (getf (cdddr call) :position)))
 (let* ((write (list fn 'tx 'v 'fn2-id-decides))
        (events (cdr (macroexpand-1 call))))
  (assert (= (length events) 4))
  (assert (equal (mapcar #'caddr (subseq events 0 3))
   `((implies (and ,@(checked-hyps width)) (fn2-id-decidesp ,write))
     (implies (and ,@(checked-hyps width)) (fn2-id-decides-wfp ,write))
     (equal (fn2-id-decides-rows ,write) (fn2-id-decides-rows fn2-id-decides)))))
  (dolist (event (subseq events 0 3))
   (assert (equal (getf (cdddr event) :rule-classes)
    `(:rewrite (:forward-chaining :trigger-terms (,write))))))))
(format t "QUERY MASK FORWARD CONTROLS PASS~%")

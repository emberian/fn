(defun m24-test-state (capacity bank)
 (let ((state (make-hash-table)))
  (setf (gethash 'fn-owner state) '(1 nil)
        (gethash 'fn-owner-memory-capacity state) capacity
        (gethash 'fn-owner-memory-held-bank state) bank)
  state))
(let* ((held (fn-adm-hh-close (fn-adm-hh-open (fn-adm-hh-initial) 0 t) 0))
       (state (m24-test-state 1 held)))
 ;; A new replacement at the held bound is refused on every served path.
 (dolist (call (list (lambda () (fn-owner-open state))
                    (lambda () (fn-owner-open-peer '(112) state))
                    (lambda () (fn-owner-exposure-open :inet '(127 0 0 1) nil state))))
  (multiple-value-bind (erp id next) (funcall call)
   (assert (null erp)) (assert (null id))
   (assert (equal (fn-owner-memory-held-bank next) held))
   (assert (equal (fn-owner-ocfg next) '(1 nil)))))
 ;; Zero differs from absent; the peer/control paths cannot bypass it.
 (dolist (capacity '(0 nil))
  (let ((state (m24-test-state capacity (fn-adm-hh-initial))))
   (multiple-value-bind (erp id next) (fn-owner-open-peer '(112) state)
    (assert (null erp))
    (if capacity (progn (assert (null id)) (assert (= (fn-adm-admission-held
       (list nil nil (fn-owner-memory-held-bank next))) 0)))
     (progn (assert (= id 1)) (assert (= (fn-adm-hh-count (fn-owner-memory-held-bank next)) 1)))))))
 (let ((state (m24-test-state 0 (fn-adm-hh-initial))))
  (multiple-value-bind (erp id next) (fn-owner-open state)
   (assert (null erp)) (assert (null id))
   (assert (= (fn-owner-memory-capacity-read next) 0))
   (assert (= (fn-adm-hh-count (fn-owner-memory-held-bank next)) 0))))
 ;; Rearm at saturation transfers custody, with no transient second identity.
 (dolist (peer '(nil t))
  (let ((state (m24-test-state 1 held)))
   (multiple-value-bind (erp id next)
    (if peer (fn-owner-peer-rearm '(112) 0 state)
     (fn-owner-exposure-rearm :inet '(127 0 0 1) nil 0 state))
    (assert (null erp)) (assert (= id 1))
    (assert (= (fn-adm-hh-count (fn-owner-memory-held-bank next)) 1))
    (assert (null (fn-exp-lookup 0 (fn-adm-hh-rows (fn-owner-memory-held-bank next)))))
    (assert (equal (fn-exp-at 2 (fn-exp-lookup 1 (fn-adm-hh-rows (fn-owner-memory-held-bank next)))) t)))))
 ;; Another physically held identity makes the transfer refuse unchanged.
 (let* ((bank (fn-adm-hh-open held 99 t)) (state (m24-test-state 1 bank)))
  (multiple-value-bind (erp id next) (fn-owner-peer-rearm '(112) 0 state)
   (assert (null erp)) (assert (null id))
   (assert (equal (fn-owner-memory-held-bank next) bank)))))
(format t "SOURCE HELD ADMISSION PASSED~%")


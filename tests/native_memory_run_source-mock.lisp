(defun fn-owner-memory-recapacity (fn-hist state)
 (incf *refreshes*) (setf (gethash 'fn-owner-memory-capacity state) 2)
 (values fn-hist state))
(let ((state (make-hash-table)))
 (setf (gethash 'fn-owner-memory-run state) (copy-list '(nil 1000 0 0 nil nil nil nil nil 0 1 nil)))
 (assert (= (first (second (fn-owner-memory-gate state))) 33))
 ;; A carried natural operator id occupies the already-counted private row.
 (setf (nth 11 (gethash 'fn-owner-memory-run state)) 0)
 (assert (= (first (second (fn-owner-memory-gate state))) 32))
 (setf (nth 11 (gethash 'fn-owner-memory-run state)) nil)
 (setf (nth 10 (gethash 'fn-owner-memory-run state)) 2
       (gethash 'fn-owner-memory-capacity state) 2)
 (assert (= (first (second (fn-owner-memory-gate state))) 33))
 ;; The policy bound falls further; it must continue charging actual held.
 (setf *configured* 1)
 (assert (= (first (second (fn-owner-memory-gate state))) 33))
 (setf (gethash 'fn-owner-memory-capacity state) 0)
 (assert (= (fn-owner-memory-max-conns state) 0))
 (let ((limits (fn-owner-callback-exposure-limits state)))
  (assert (= (fn-exp-lim-total limits) 0))
  (assert (eq (car (fn-exp-admit-decision nil limits 0 nil 0)) :refuse)))
 (assert (= (fn-adm-installed-capacity nil nil '(32) 1000 nil) 0))
 (assert (search "refused memory-cannot-hold-the-store capacity=0 of 32"
                 (fn-adm-installed-capacity-line nil nil '(32) 1000 nil)))
 (multiple-value-bind (erp word hist next) (fn-owner-memory-reclaim-complete :synced state)
  (assert (null erp)) (assert (eq word :refreshed)) (assert (eq hist :synced))
  (assert (= *refreshes* 1)) (assert (= (gethash 'fn-owner-memory-capacity next) 2))))

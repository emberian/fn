(defun fnn-fault (text) (error "~a" text))
(dolist (mode '(nil :socket-unobserved :semantic-failed))
 (let* ((*pull-mode* mode) (*physical-returns* nil)
        (flight (%make-fnn-pull-flight :socket :socket :cid 7 :cids '((1 . 8))
                                      :physical-cids '((0 . 7) (1 . 8)))))
  (let ((failed (handler-case (progn (fnn-pull-flight-dispose flight) nil) (error () t))))
   (assert (eq failed (not (null mode))))
   (assert (equal (sort (copy-list *physical-returns*) #'<) (if mode nil '(7 8))))
   (fnn-pull-flight-dispose flight)
   (assert (equal (sort (copy-list *physical-returns*) #'<) (if mode nil '(7 8)))))))
(let* ((*pull-mode* :semantic-failed) (*physical-returns* nil)
       (flight (%make-fnn-pull-flight :socket :socket :cid 7 :physical-cids '((nil . 7)))))
 ;; A prior :reopen-local failure cannot be forgotten by final disposal.
 (assert (handler-case (progn (fnn-pull-flight-close-local flight) nil) (error () t)))
 (assert (fnn-pull-flight-cleanup-debt flight))
 (setf *pull-mode* nil)
 (assert (handler-case (progn (fnn-pull-flight-dispose flight) nil) (error () t)))
 (assert (null *physical-returns*)))

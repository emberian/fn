(defun fn2-compress-record-socket-control (cancelp fn2-compress-operation fn2-compress-transport)
 (declare (xargs :stobjs (fn2-compress-operation fn2-compress-transport) :verify-guards nil))
 (b* (((mv code fn2-compress-transport) (fn2-compress-ready-control fn2-compress-transport))
      ((unless (eq code :ok)) (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv code serial fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-next 4 5 6 7 0 4 fn2-compress-operation fn2-compress-transport))
      ((unless (eq code :ok)) (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv code fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-observe 4 5 6 7 serial 0 4 8 0 fn2-compress-operation fn2-compress-transport))
      ((unless (eq code :progress)) (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv code & fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-next 4 5 6 7 0 4 fn2-compress-operation fn2-compress-transport))
      ((unless (and (eq code :ok) (= (fn2-compress-transport-pending 0 fn2-compress-transport) 5)))
       (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv code fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-socket-observe 1 0 fn2-compress-operation fn2-compress-transport))
      ((unless (and (eq code :progress)
                    (= (fn2-compress-transport-output-offset 0 fn2-compress-transport) 1)
                    (= (fn2-compress-operation-source-progress 0 fn2-compress-operation) 4)))
       (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv code serial fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-next 4 5 6 7 0 4 fn2-compress-operation fn2-compress-transport))
      ((unless (eq code :ok)) (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv code fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-socket-observe -1 11 fn2-compress-operation fn2-compress-transport))
      ((unless (and (eq code :blocked)
                    (= (fn2-compress-operation-pending-serial 0 fn2-compress-operation) 0)
                    (= (fn2-compress-transport-pending 0 fn2-compress-transport) 0)
                    (= (fn2-compress-transport-output-offset 0 fn2-compress-transport) 1)
                    (= (fn2-compress-operation-source-progress 0 fn2-compress-operation) 4)
                    (= (fn2-compress-transport-raw-negative 0 fn2-compress-transport) 1)
                    (= (fn2-compress-transport-raw-code 0 fn2-compress-transport) 1)
                    (= (fn2-compress-transport-raw-errno 0 fn2-compress-transport) 11)
                    (= (fn2-compress-operation-kick 0 fn2-compress-operation) 0)
                    (= (fn2-compress-operation-interest 0 fn2-compress-operation) 4)))
       (mv nil fn2-compress-operation fn2-compress-transport))
      ; Close after the observed syscall can retire/free the carrier. Cancel
      ; then recovers the application prefix without a live capability.
      ((when cancelp)
       (b* (((mv code fn2-compress-transport)
             (fn2-compress-transport-retire 4 5 fn2-compress-transport))
            ((unless (eq code :closing)) (mv nil fn2-compress-operation fn2-compress-transport))
            ((mv code action & & cleanup-serial fn2-compress-transport)
             (fn2-compress-transport-next 0 0 fn2-compress-transport))
            ((unless (and (eq code :cleanup) (= action 9)))
             (mv nil fn2-compress-operation fn2-compress-transport))
            ((mv code & fn2-compress-transport)
             (fn2-compress-transport-observe-lifecycle 4 5 6 7 cleanup-serial 0 0 0 fn2-compress-transport))
            ((unless (eq code :ok)) (mv nil fn2-compress-operation fn2-compress-transport))
            ((mv code fn2-compress-operation)
             (fn2-compress-operation-mark-carrier-closed 4 5 6 7 4 fn2-compress-transport fn2-compress-operation))
            ((unless (eq code :ok)) (mv nil fn2-compress-operation fn2-compress-transport))
            ((mv code terminal-code completed won fn2-compress-operation)
             (fn2-compress-operation-cancel nil fn2-compress-operation)))
        (mv (and (eq code :cancelled) (eq terminal-code :cancelled) won (= completed 4)
                 (= (fn2-compress-transport-alive 0 fn2-compress-transport) 0))
            fn2-compress-operation fn2-compress-transport)))
      ((mv code resumed fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-next 4 5 6 7 0 4 fn2-compress-operation fn2-compress-transport))
      ((unless (and (eq code :ok) (< serial resumed)))
       (mv nil fn2-compress-operation fn2-compress-transport))
      (before-op (list (fn2-compress-operation-rows fn2-compress-operation) (fn2-compress-operation-row-snapshot 0 fn2-compress-operation)))
      (before-cap (list (fn2-compress-transport-rows fn2-compress-transport) (fn2-compress-transport-row-snapshot 0 fn2-compress-transport)))
      ((mv code fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-observe 4 5 6 7 serial 1 1 0 0 fn2-compress-operation fn2-compress-transport))
      ((unless (and (eq code :stale)
                    (equal before-op (list (fn2-compress-operation-rows fn2-compress-operation) (fn2-compress-operation-row-snapshot 0 fn2-compress-operation)))
                    (equal before-cap (list (fn2-compress-transport-rows fn2-compress-transport) (fn2-compress-transport-row-snapshot 0 fn2-compress-transport)))))
       (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv code fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-socket-observe -1 32 fn2-compress-operation fn2-compress-transport))
      ((unless (eq code :failed)) (mv nil fn2-compress-operation fn2-compress-transport))
      ((mv code completed fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-next 4 5 6 7 0 4 fn2-compress-operation fn2-compress-transport))
      ((mv outcome reason count a0 a1)
       (fn2-host-result *fn2-action-send* :failed completed 0 4 nil)))
  (mv (and (eq code :failed) (= completed 4)
           (= (fn2-compress-transport-terminal 0 fn2-compress-transport) 2)
           (equal (list outcome reason count a0 a1)
                  (list *fn2-outcome-failed* *fn2-reason-closed* 4 0 0)))
      fn2-compress-operation fn2-compress-transport)))
(defun fn2-compress-record-socket-test (cancelp)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-compress-operation
  (mv-let (ok fn2-compress-operation)
   (with-local-stobj fn2-compress-transport
    (mv-let (ok fn2-compress-operation fn2-compress-transport)
     (fn2-compress-record-socket-control cancelp fn2-compress-operation fn2-compress-transport)
     (mv ok fn2-compress-operation))) ok)))
(assert-event (fn2-compress-record-socket-test nil))
(assert-event (fn2-compress-record-socket-test t))

; The helper creates a genuine second instance of the actual operation type;
; the caller's owner record remains live and unchanged across this check.
(defun fn2-compress-sibling-wait-run
 (blocked fn2-compress-operation fn2-compress-transport fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-compress-operation fn2-compress-transport fn2-tls-transport fn2-tls-record)
                 :verify-guards nil))
 (b* (((mv initial-interest initial-kick)
       (fn2-compress-record-stack-wait fn2-compress-operation fn2-compress-transport fn2-tls-transport fn2-tls-record))
      ((mv code result fn2-compress-operation fn2-compress-transport)
       (if blocked
           (fn2-compress-record-next 4 5 3 9 1 4 fn2-compress-operation fn2-compress-transport)
         (mv-let (code fn2-compress-operation)
          (fn2-compress-operation-bind 4 5 3 9 4 fn2-compress-operation)
          (mv code 0 fn2-compress-operation fn2-compress-transport))))
      ((mv interest kick)
       (fn2-compress-record-stack-wait fn2-compress-operation fn2-compress-transport fn2-tls-transport fn2-tls-record)))
  (mv (and (eq code (if blocked :pending :ok)) (= result 0)
           (equal (list initial-interest initial-kick interest kick)
                  (if blocked '(0 nil 0 nil) '(1 t 1 t)))
           (= (fn2-compress-operation-rows fn2-compress-operation) 1)
           (= (fn2-compress-operation-slot 0 fn2-compress-operation) 3)
           (= (fn2-compress-operation-generation 0 fn2-compress-operation) 9)
           (= (fn2-compress-operation-last-serial 0 fn2-compress-operation) 0))
      fn2-compress-operation fn2-compress-transport)))
(defun fn2-compress-sibling-wait-check
 (blocked fn2-compress-transport fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-compress-transport fn2-tls-transport fn2-tls-record) :verify-guards nil))
 (with-local-stobj fn2-compress-operation
  (mv-let (ok fn2-compress-operation fn2-compress-transport)
   (fn2-compress-sibling-wait-run blocked fn2-compress-operation fn2-compress-transport fn2-tls-transport fn2-tls-record)
   (mv ok fn2-compress-transport))))

(defun fn2-compress-sibling-owner-run
 (fn2-compress-operation fn2-compress-transport fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-compress-operation fn2-compress-transport fn2-tls-transport fn2-tls-record)
                 :verify-guards nil))
 (b* (((mv ready fn2-compress-transport) (fn2-compress-ready-control fn2-compress-transport))
      ((mv selected serial fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-next 4 5 6 7 0 4 fn2-compress-operation fn2-compress-transport))
      ((mv encoded fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-observe 4 5 6 7 serial 0 4 8 0 fn2-compress-operation fn2-compress-transport))
      ((mv parent parent-serial fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-next 4 5 6 7 0 4 fn2-compress-operation fn2-compress-transport))
      ((mv bridge channel base extent epoch) (fn2-compress-tls-parent 4 5 6 7 fn2-compress-transport))
      (fn2-tls-transport (fn2-tls-transport-init 1 fn2-tls-transport))
      ; Explicit ready-carrier witness, as in the actual TLS record fixture.
      (fn2-tls-transport (fn2-tls-transport-put 0 (cap 4) (nonce 5) (alive 1)
                         (handle-id 4096) (cleanup-credit 1) (terminal 3) (quantum 4)))
      ((mv bound fn2-tls-record) (fn2-tls-record-start 4 5 6 7 extent epoch t fn2-tls-record))
      ((mv ssl action & count serial fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv accepted fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe serial 0 4 0 fn2-tls-transport fn2-tls-record))
      ((mv bio bio-action & & serial fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 3 fn2-tls-transport fn2-tls-record))
      ((mv drained fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe serial 3 0 0 fn2-tls-transport fn2-tls-record))
      ((mv send send-action & & serial fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv blocked fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe serial -1 0 11 fn2-tls-transport fn2-tls-record))
      ((mv owner-interest owner-kick)
       (fn2-compress-record-stack-wait fn2-compress-operation fn2-compress-transport fn2-tls-transport fn2-tls-record))
      ((mv sibling-blocked fn2-compress-transport)
       (fn2-compress-sibling-wait-check t fn2-compress-transport fn2-tls-transport fn2-tls-record))
      ((mv owner-after-interest owner-after-kick)
       (fn2-compress-record-stack-wait fn2-compress-operation fn2-compress-transport fn2-tls-transport fn2-tls-record))
      (retained (and (= (fn2-compress-transport-pending 0 fn2-compress-transport) 5)
                     (= (fn2-compress-transport-serial 0 fn2-compress-transport) parent-serial)
                     (= (fn2-compress-operation-pending-serial 0 fn2-compress-operation) parent-serial)))
      ((mv retry retry-action & & serial fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv sent fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe serial 3 0 0 fn2-tls-transport fn2-tls-record))
      ((mv done & & completed & fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv settled fn2-compress-operation fn2-compress-transport)
       (fn2-compress-record-carrier-observe done completed fn2-compress-operation fn2-compress-transport))
      ((mv sibling-runnable fn2-compress-transport)
       (fn2-compress-sibling-wait-check nil fn2-compress-transport fn2-tls-transport fn2-tls-record)))
  (mv (and (equal (list ready selected encoded parent bridge bound ssl accepted bio drained send blocked)
                   '(:ok :ok :progress :ok :ok :ok :act :ok :act :ok :act :blocked))
           (= channel 3) (= base 0) (= extent 4) (= epoch parent-serial)
           (= action 13) (= count 4) (= bio-action 4) (= send-action 5)
           (equal (list owner-interest owner-kick owner-after-interest owner-after-kick) '(4 nil 4 nil))
           retained sibling-blocked sibling-runnable
           (eq retry :act) (= retry-action 5) (eq sent :ok) (eq done :done) (= completed 4)
           (eq settled :progress) (= (fn2-compress-transport-pending 0 fn2-compress-transport) 0)
           (= (fn2-compress-operation-source-progress 0 fn2-compress-operation) 4))
      fn2-compress-operation fn2-compress-transport fn2-tls-transport fn2-tls-record)))
(defun fn2-compress-sibling-owner-check ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-compress-operation
  (mv-let (ok fn2-compress-operation)
   (with-local-stobj fn2-compress-transport
    (mv-let (ok fn2-compress-operation fn2-compress-transport)
     (with-local-stobj fn2-tls-transport
      (mv-let (ok fn2-compress-operation fn2-compress-transport fn2-tls-transport)
       (with-local-stobj fn2-tls-record
        (mv-let (ok fn2-compress-operation fn2-compress-transport fn2-tls-transport fn2-tls-record)
         (fn2-compress-sibling-owner-run fn2-compress-operation fn2-compress-transport fn2-tls-transport fn2-tls-record)
         (mv ok fn2-compress-operation fn2-compress-transport fn2-tls-transport)))
       (mv ok fn2-compress-operation fn2-compress-transport)))
     (mv ok fn2-compress-operation)))
   ok)))
(assert-event (fn2-compress-sibling-owner-check))

(in-package "ACL2")
(include-book "../sim/envelope-output-complete")
(defun fn2-eo-matching-witness (segments peer extra)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-envelope-output-state
  (mv-let (ok fn2-envelope-output-state)
   (let* ((fn2-envelope-output-state (update-fn2-eo-phase 1 fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-segments segments fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-peer peer fn2-envelope-output-state))
          (fuel (+ extra (fn2-eo-matching-fuel segments peer)))
          (antecedent
           (and (natp fuel)
                (<= (fn2-eo-matching-fuel (fn2-eo-segments fn2-envelope-output-state)
                                         (fn2-eo-peer fn2-envelope-output-state)) fuel)
                (equal (fn2-eo-phase fn2-envelope-output-state) 1)
                (fn2-eo-segments-p (fn2-eo-segments fn2-envelope-output-state))
                (fn2-eo-octets-p (fn2-eo-peer fn2-envelope-output-state))))
          (fn2-envelope-output-state (fn2-envelope-output-run fuel fn2-envelope-output-state)))
    (mv (and antecedent (equal (fn2-eo-phase fn2-envelope-output-state) 10)
             (equal (fn2-eo-result fn2-envelope-output-state)
                    (fn2-envelope-output-language-p segments peer)))
        fn2-envelope-output-state)) ok)))
(assert-event
 (and (fn2-eo-matching-witness '((:exact 1 2) (:exact) (:exact 3)) '(1 2 3) 0)
      (fn2-eo-matching-witness '((:exact 1 2) (:exact 3)) '(1 2 4) 0)
      (fn2-eo-matching-witness '((:exact 1) (:prefix 2 3)) '(1 2) 0)
      (fn2-eo-matching-witness '((:exact 1) (:prefix 2) (:exact 3)) '(1 3) 0)
      (fn2-eo-matching-witness '((:exact 1) (:prefix 2) (:exact 3)) '(1 2 3) 7)
      (fn2-eo-matching-witness '((:prefix 1) (:exact 1)) '(1) 0)
      (fn2-eo-matching-witness nil nil 0)
      (fn2-eo-matching-witness nil '(1) 0)))

(defun fn2-eo-public-witness (segments peer)
 (declare (xargs :verify-guards nil))
 (equal (fn2-envelope-output-matches-p segments peer)
        (and (fn2-eo-segments-p segments) (fn2-eo-octets-p peer)
             (fn2-envelope-output-language-p (revappend segments nil) peer))))
(assert-event
 (and (fn2-eo-public-witness '((:exact 3) (:exact 1 2)) '(1 2 3))
      (fn2-eo-public-witness '((:prefix 2 3) (:exact 1)) '(1 2))
      (fn2-eo-public-witness '((:exact 3) (:prefix 2) (:exact 1)) '(1 3))
      (fn2-eo-public-witness '((:exact 1) (:prefix 1)) '(1))
      (fn2-eo-public-witness '((:exact 3) (:prefix 2) (:exact 1)) '(1 4))
      (fn2-eo-public-witness nil nil)
      (fn2-eo-public-witness nil '(1))
      (fn2-eo-public-witness '((:exact 2) (:prefix 1)) '(1 2 . bad))
      (fn2-eo-public-witness '((:exact 1 . bad)) '(1))
      (fn2-eo-public-witness '((:exact 1) . bad) '(1))
      (fn2-eo-public-witness '((:exact 300)) '(300))))
; Removing the ORIGINAL-domain conjunct accepts these malformed observations.
; This is a specification-conjunct removal witness, not a removed theorem
; hypothesis: the public correspondence theorem is unconditional.
(defthm fn2-eo-original-domain-removal-witness
 (and (not (fn2-eo-segments-p '((:exact 1) . bad)))
      (fn2-envelope-output-language-p (revappend '((:exact 1) . bad) nil) '(1))
      (not (fn2-envelope-output-matches-p '((:exact 1) . bad) '(1)))
      (not (fn2-eo-segments-p '((:prefix . bad))))
      (fn2-envelope-output-language-p '((:prefix . bad)) nil)
      (not (fn2-envelope-output-matches-p '((:prefix . bad)) nil))
      (not (fn2-eo-octets-p '(300)))
      (fn2-envelope-output-language-p '((:exact 300)) '(300))
      (not (fn2-envelope-output-matches-p '((:exact 300)) '(300))))
 :rule-classes nil)

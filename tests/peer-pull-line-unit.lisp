; Exercise finite input leases and password clearing at the pool boundary.
(in-package "ACL2")
(include-book "../books/peer-pull-line")

(defun fn2-ppl-adapter-put (bytes offset slot gen op fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (if (atom bytes) (mv :ok fn2-pool)
    (b* (((mv code fn2-pool) (fn2-pool-adapter-write slot gen op 7 offset (car bytes) fn2-pool))
         ((unless (eq code :ok)) (mv code fn2-pool)))
      (fn2-ppl-adapter-put (cdr bytes) (+ 1 (nfix offset)) slot gen op fn2-pool))))

(defun fn2-ppl-receive (bytes slot gen op fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (b* (((mv code off fn2-pool) (fn2-pool-lease-in slot gen (len bytes) op 7 1 2 3 fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-pool))
       ((mv code fn2-pool) (fn2-ppl-adapter-put bytes off slot gen op fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-pool)))
    (fn2-pool-complete-in slot gen op 7 (len bytes) fn2-pool)))

(defun fn2-ppl-octets-p (bytes at slot gen fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (if (atom bytes) (equal at (fn2-pool-fill-value slot fn2-pool))
    (mv-let (code byte) (fn2-pool-read slot gen at 1 2 3 fn2-pool)
      (and (eq code :ok) (equal byte (car bytes))
           (fn2-ppl-octets-p (cdr bytes) (+ 1 (nfix at)) slot gen fn2-pool)))))

(defun fn2-ppl-check-line (malformed fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (b* ((fn2-pool (fn2-pool-init '((1 . 1024)) 1 100 fn2-pool))
       ((mv reserved slot gen fn2-pool) (fn2-pool-reserve 0 1 2 3 fn2-pool))
       ((mv first fn2-pool) (fn2-ppl-receive '(51 56 50 32 71 111 13) slot gen 11 fn2-pool))
       ((mv pending pos status) (fn2-peer-pull-line 0 0 slot gen 1 2 3 fn2-pool))
       (tls '(22 3 3 0 5 10 255))
       ((mv second fn2-pool)
        (fn2-ppl-receive (cons (if malformed 0 10) (if malformed '(10) tls)) slot gen 12 fn2-pool))
       ((mv code next reply) (fn2-peer-pull-line 0 pos slot gen 1 2 3 fn2-pool)))
    (mv (and (eq reserved :ok) (eq first :ok) (eq second :ok)
             (eq pending :need-more) (equal pos 7) (equal status 0)
             (if malformed
                 (and (eq code :frame) (equal next 9) (equal reply 0))
               (and (eq code :ok) (equal next 8) (equal reply 382)
                    (fn2-ppl-octets-p tls next slot gen fn2-pool))))
        fn2-pool)))

(defun fn2-ppl-raw-zero-p (left at fn2-pool)
  (declare (xargs :stobjs fn2-pool :measure (nfix left) :verify-guards nil))
  (or (zp left)
      (and (equal 0 (fn2-pool-datai at fn2-pool))
           (fn2-ppl-raw-zero-p (- left 1) (+ 1 (nfix at)) fn2-pool))))

(defun fn2-ppl-check-wipe (fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (b* ((fn2-pool (fn2-pool-init '((3 . 1024)) 1 100 fn2-pool))
       ((mv rs source sg fn2-pool) (fn2-pool-reserve 0 1 2 3 fn2-pool))
       ((mv rc secret cg fn2-pool) (fn2-pool-reserve 0 1 2 3 fn2-pool))
       ((mv rt tx tg fn2-pool) (fn2-pool-reserve 0 1 2 3 fn2-pool))
       (name '(112 101 101 114))
       (login '(117))
       (token '(120 121 122))
       ((mv received fn2-pool) (fn2-ppl-receive (append name '(32) login '(32) token) source sg 11 fn2-pool))
       ((mv copied fn2-pool)
        (fn2-peer-pull-copy-credentials source sg 1 2 3 0 4 5 1 7 3 secret cg 1 2 3 fn2-pool))
       ((mv unprotected fn2-pool)
        (fn2-peer-pull-format-command :pass 0 secret cg 4 1 3 tx tg 1 2 3 fn2-pool))
       (empty-before (equal 0 (fn2-pool-fill-value tx fn2-pool)))
       ((mv formatted fn2-pool)
        (fn2-peer-pull-format-command :pass 1 secret cg 4 1 3 tx tg 1 2 3 fn2-pool))
       (txlen (fn2-pool-fill-value tx fn2-pool))
       (wire (append '(65 85 84 72 73 78 70 79 32 80 65 83 83 32) token '(13 10)))
       (matched (and (fn2-ppl-octets-p wire 0 tx tg fn2-pool)
                     (fn2-ppl-octets-p (append name login token) 0 secret cg fn2-pool)))
       ((mv leased fn2-pool) (fn2-pool-lease-out tx tg 0 txlen 1 2 3 fn2-pool))
       ((mv too-early fn2-pool) (fn2-peer-pull-wipe tx tg 0 512 1 2 3 fn2-pool))
       (intact (fn2-ppl-octets-p wire 0 tx tg fn2-pool))
       ((mv returned fn2-pool) (fn2-pool-release-out tx tg fn2-pool))
       ((mv tx-wiped fn2-pool) (fn2-peer-pull-wipe tx tg 0 512 1 2 3 fn2-pool))
       ((mv secret-wiped fn2-pool) (fn2-peer-pull-wipe secret cg 4 1024 1 2 3 fn2-pool)))
    (mv (and (eq rs :ok) (eq rc :ok) (eq rt :ok) (eq received :ok)
             (eq copied :ok) (eq unprotected :access) empty-before
             (eq formatted :ok) matched
             (eq leased :ok) (eq too-early :state) intact (eq returned :ok)
             (eq tx-wiped :ok) (eq secret-wiped :ok)
             (equal 0 (fn2-pool-fill-value tx fn2-pool))
             (fn2-ppl-octets-p name 0 secret cg fn2-pool)
             (fn2-ppl-raw-zero-p txlen (fn2-pool-base tx fn2-pool) fn2-pool)
             (fn2-ppl-raw-zero-p 4 (+ 4 (fn2-pool-base secret fn2-pool)) fn2-pool))
        fn2-pool)))

(defun fn2-ppl-test (case)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-pool
    (mv-let (ok fn2-pool)
      (case case
        (:wipe (fn2-ppl-check-wipe fn2-pool))
        (otherwise (fn2-ppl-check-line (eq case :malformed) fn2-pool)))
      ok)))

(assert-event (fn2-ppl-test :segmented))
(assert-event (fn2-ppl-test :malformed))
(assert-event (fn2-ppl-test :wipe))

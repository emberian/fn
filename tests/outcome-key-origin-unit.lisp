; Reopen the encoded schema-9 entries for a caller-supplied operation and
; an assigned event with the same number. Their generated key order must
; distinguish them even when principal and numerical operation coincide.
; The stored verb and MID survive encode/decode without changing that key.
(in-package "ACL2")
(include-book "../books/ordered")
(include-book "../books/pool-block")
(include-book "std/util/bstar" :dir :system)

(defun fn2-outcome-fixture-bytes-p (i off expected slot gen fn2-pool)
  (declare (xargs :stobjs fn2-pool :measure (nfix (- (length expected) (nfix i)))
                  :verify-guards nil))
  (if (>= (nfix i) (length expected))
      t
    (mv-let (code byte) (fn2-pool-read slot gen (+ off (nfix i)) 1 0 1 fn2-pool)
      (and (eq code :ok)
           (equal byte (char-code (char expected (nfix i))))
           (fn2-outcome-fixture-bytes-p (+ 1 (nfix i)) off expected slot gen fn2-pool)))))

(defun fn2-outcome-fixture-field-p (row expected slot gen fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (and (equal (fn2-fields-ref-slot row fn2-fields) slot)
       (equal (fn2-fields-ref-gen row fn2-fields) gen)
       (equal (fn2-fields-ref-len row fn2-fields) (length expected))
       (fn2-outcome-fixture-bytes-p 0 (fn2-fields-ref-off row fn2-fields)
                                    expected slot gen fn2-pool)))

(defun fn2-outcome-key-codec-check (fn2-fields fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
  (b* ((stride *fn2-outcome-entry-num-fields*)
       (assigned stride)
       (accepted (* 2 stride))
       (grant-set (* 3 stride))
       (conflict (* 4 stride))
       (digest "0123456789abcdef0123456789abcdef")
       (conflict-digest "fedcba9876543210fedcba9876543210")
       (message-id "<a@b>")
       (fn2-fields (fn2-fields-init (* 5 stride) fn2-fields))
       (fn2-pool (fn2-pool-init '((2 . 512)) 1 100 fn2-pool))
       ((mv a ds dg fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
       ((mv b ws wg fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
       ((mv c fn2-pool)
        (fn2-pool-append-text 0 digest ds dg 1 0 1 fn2-pool))
       ((mv cm fn2-pool) (fn2-pool-append-text 0 message-id ds dg 1 0 1 fn2-pool))
       (conflict-off (fn2-pool-fill-value ds fn2-pool))
       ((mv cd fn2-pool) (fn2-pool-append-text 0 conflict-digest ds dg 1 0 1 fn2-pool))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-principal* 4294967297 fn2-fields))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-operation* 41 fn2-fields))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-id-source* *fn2-outcome-id-source-assigned* fn2-fields))
       (fn2-fields (fn2-layout-store *fn2-outcome-entry-field-request* 1 ds dg 0 32 0 fn2-fields))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-outcome* 1 fn2-fields))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-event* 41 fn2-fields))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-verb* *fn2-outcome-verb-append* fn2-fields))
       (fn2-fields (fn2-layout-store *fn2-outcome-entry-field-mid* 0 ds dg 32 5 0 fn2-fields))
       ((mv e0 n0 fn2-pool) (fn2-outcome-entry-encode 0 ws wg 0 1 0 1 fn2-fields fn2-pool))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-id-source* *fn2-outcome-id-source-supplied* fn2-fields))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-event* 42 fn2-fields))
       ((mv e1 n1 fn2-pool) (fn2-outcome-entry-encode 0 ws wg n0 1 0 1 fn2-fields fn2-pool))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-verb* *fn2-outcome-verb-grant-set* fn2-fields))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-event* 43 fn2-fields))
       (fn2-fields (fn2-layout-store *fn2-outcome-entry-field-mid* 0 ds dg 0 0 0 fn2-fields))
       ((mv e2 n2 fn2-pool) (fn2-outcome-entry-encode 0 ws wg n1 1 0 1 fn2-fields fn2-pool))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-operation* 44 fn2-fields))
       (fn2-fields (fn2-layout-store *fn2-outcome-entry-field-request* 1 ds dg conflict-off 32 0 fn2-fields))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-outcome* 2 fn2-fields))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-event* 44 fn2-fields))
       (fn2-fields (fn2-fields-set-value *fn2-outcome-entry-field-verb* *fn2-outcome-verb-append* fn2-fields))
       (fn2-fields (fn2-layout-store *fn2-outcome-entry-field-mid* 0 ds dg 32 5 0 fn2-fields))
       ((mv e3 n3 fn2-pool) (fn2-outcome-entry-encode 0 ws wg n2 1 0 1 fn2-fields fn2-pool))
       ((mv d0 p0 fn2-fields) (fn2-outcome-entry-decode assigned ws wg 0 n0 1 0 1 fn2-fields fn2-pool))
       ((mv d1 p1 fn2-fields) (fn2-outcome-entry-decode accepted ws wg n0 n1 1 0 1 fn2-fields fn2-pool))
       ((mv d2 p2 fn2-fields) (fn2-outcome-entry-decode grant-set ws wg n1 n2 1 0 1 fn2-fields fn2-pool))
       ((mv d3 p3 fn2-fields) (fn2-outcome-entry-decode conflict ws wg n2 n3 1 0 1 fn2-fields fn2-pool))
       ((mv c01 order01) (fn2-outcome-compare assigned accepted 1 0 1 1 0 1 fn2-fields fn2-pool))
       ((mv c11 order11) (fn2-outcome-compare grant-set accepted 1 0 1 1 0 1 fn2-fields fn2-pool)))
    (mv (and (not (remove-eq :ok (list a b c cm cd e0 e1 e2 e3 d0 d1 d2 d3 c01 c11)))
             (< 0 n0) (< n0 n1) (< n1 n2) (< n2 n3)
             (equal p0 n0) (equal p1 n1) (equal p2 n2) (equal p3 n3)
             (equal (fn2-fields-value (+ assigned *fn2-outcome-entry-field-event*) fn2-fields) 41)
             (equal (fn2-fields-value (+ accepted *fn2-outcome-entry-field-event*) fn2-fields) 42)
             (equal (fn2-fields-value (+ grant-set *fn2-outcome-entry-field-event*) fn2-fields) 43)
             (equal (fn2-fields-value (+ conflict *fn2-outcome-entry-field-event*) fn2-fields) 44)
             (equal (fn2-fields-value (+ accepted *fn2-outcome-entry-field-outcome*) fn2-fields) 1)
             (equal (fn2-fields-value (+ conflict *fn2-outcome-entry-field-outcome*) fn2-fields) 2)
             (equal (fn2-fields-value (+ accepted *fn2-outcome-entry-field-verb*) fn2-fields)
                    *fn2-outcome-verb-append*)
             (equal (fn2-fields-value (+ grant-set *fn2-outcome-entry-field-verb*) fn2-fields)
                    *fn2-outcome-verb-grant-set*)
             (equal (fn2-fields-value (+ conflict *fn2-outcome-entry-field-verb*) fn2-fields)
                    *fn2-outcome-verb-append*)
             (fn2-outcome-fixture-field-p (+ accepted *fn2-outcome-entry-field-request*) digest
                                          ws wg fn2-fields fn2-pool)
             (fn2-outcome-fixture-field-p (+ conflict *fn2-outcome-entry-field-request*) conflict-digest
                                          ws wg fn2-fields fn2-pool)
             (fn2-outcome-fixture-field-p (+ accepted *fn2-outcome-entry-field-mid*) message-id
                                          ws wg fn2-fields fn2-pool)
             (fn2-outcome-fixture-field-p (+ conflict *fn2-outcome-entry-field-mid*) message-id
                                          ws wg fn2-fields fn2-pool)
             (equal (fn2-fields-ref-len (+ grant-set *fn2-outcome-entry-field-mid*) fn2-fields) 0)
             (eq order01 :lt) (eq order11 :eq))
        fn2-fields fn2-pool)))

(defun fn2-outcome-key-codec-run ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-fields
    (mv-let (ok fn2-fields)
      (with-local-stobj fn2-pool
        (mv-let (ok fn2-fields fn2-pool) (fn2-outcome-key-codec-check fn2-fields fn2-pool)
          (mv ok fn2-fields)))
      ok)))
(assert-event (fn2-outcome-key-codec-run))

(define-condition fnn-os-error (error) ())
(define-condition fnn-tls-error (error) ())
(require :sb-bsd-sockets)
(dolist (prefix '("(defstruct (fnn-web-reactor-face " "(defstruct (fnn-web-reactor-conn "
                  "(defun fnn-web-begin " "(defun fnn-web-advance "
                  "(defun fnn-web-send-check " "(defun fnn-web-ready-step "
                  "(defun fnn-web-render-step " "(defun fnn-web-replay-step "))
  (eval (source-form (or (sb-ext:posix-getenv "FN_WEB_PROGRESS_SOURCE") "host/native/web-host.lisp") prefix)))
(let* ((face (%make-fnn-web-face))
       (conn (%make-fnn-web-conn :deadline 15 :phase :body)))
  (fnn-web-begin face conn)
  ;; A complete request remains live after 15 seconds of server work.
  (let ((*now* 30)) (fnn-web-advance face conn))
  (assert (= *events* 1)) (assert (not (fnn-web-conn-closedp conn)))
  ;; An incomplete request still expires at its original deadline.
  (let ((slow (%make-fnn-web-conn :deadline 15)) (*now* 15))
    (fnn-web-advance face slow) (assert (fnn-web-conn-closedp slow)))
  ;; Exact same ACL2 progress verdict as NNTP, including an unwritable socket.
  (setf (fnn-web-conn-phase conn) :write)
  (assert (fnn-web-send-check face conn))
  (let ((*now* 9)) (assert (fnn-web-send-check face conn)))
  (let ((*now* 10)) (assert (not (fnn-web-send-check face conn))))
  (assert (fnn-web-conn-closedp conn))
  (let ((moving (%make-fnn-web-conn :phase :write)))
    (assert (fnn-web-send-check face moving))
    (loop for second from 1 to 20 do
      (let ((*now* second) (*outq* (- 200000 (* second 8192))))
        (assert (fnn-web-send-check face moving))))
    (assert (not (fnn-web-conn-closedp moving))))
  ;; Miss/retry retains the quantum's age; a completed quantum clears it.
  (dolist (step '(fnn-web-ready-step fnn-web-render-step fnn-web-replay-step))
    (dolist (miss '(t nil))
      (let ((c (%make-fnn-web-conn :plan :plan :replay-plan :plan :line-since 123))
            (*cold* (and miss :read)))
        (funcall step face c)
        (assert (eql (fnn-web-conn-line-since c) (and miss 123)))))))
(format t "web progress: intake deadline, slow rendering, stalled/draining writer, quantum reset passed~%")

(defun source-form (path prefix)
  (with-open-file (stream path)
    (let ((text (make-string (file-length stream))))
      (read-sequence text stream)
      (read-from-string text nil nil :start (or (search prefix text) (error "missing ~a" prefix))))))
(defun natp (n) (and (integerp n) (<= 0 n)))
(defun nfix (n) (if (natp n) n 0))
(defun len (xs) (length xs))
(defun true-listp (xs) (or (null xs) (and (consp xs) (true-listp (cdr xs)))))
;; Execute the book's decision bodies, dropping only ACL2 declarations.
(with-open-file (in "books/send-progress.lisp")
  (loop for form = (read in nil nil) while form do
    (when (and (consp form) (eq (car form) 'defun)
               (not (member (cadr form) '(fn-send-reader-trace fn-send-progress-run))))
      (eval (append (subseq form 0 3)
                    (remove-if (lambda (x) (and (consp x) (eq (car x) 'declare))) (cdddr form)))))))
(defparameter *fn-send-stall-seconds* 10)
(defparameter *fn-send-min-octets-per-second* 1024)
(defvar *now* 0)
(defvar *outq* 200000)
(defvar *events* 0)
(defvar *cold* nil)
(defvar *logs* nil)
(defun fnn-core (name &rest args)
  (case name
    (fn-web-host-request-end 10)
    (fn-web-host-private-reply-p nil)
    (fn-splan-cursor-resume-ms 0)
    (otherwise (apply name args))))

(in-package "ACL2")
(include-book "../sim/commit-proof-step")
(include-book "read-pins-unit")

; The public turn and existing simulated adapter drive the actual writer,
; fence, install and notification phases. The bound is a fixture horizon.
(defun fn2-retirement-live-drive (left fault fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv fn2-core fn2-sim fn2-own)
  (b* (((mv & & & & fn2-core) (fn2-turn fn2-core))
       ((mv & fn2-core fn2-sim fn2-own)
        (if (consp (fn2-b-outbox fn2-core))
            (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own)
          (mv nil fn2-core fn2-sim fn2-own)))
       (flight (fn2-commit-proof-flight (fn2-sim-rows fn2-sim) fn2-sim))
       ((mv & fn2-core fn2-sim fn2-own)
        (if flight
            (let* ((fn2-sim (fn2-sim-clock (fn2-sim-due flight fn2-sim) 26 fn2-sim))
                   (fn2-sim (fn2-sim-environment flight fault 1 fn2-sim)))
             (fn2-sim-complete flight fault 1 fn2-core fn2-sim fn2-own))
          (mv nil fn2-core fn2-sim fn2-own))))
   (fn2-retirement-live-drive (- left 1) fault fn2-core fn2-sim fn2-own))))

(defun fn2-retirement-live-target (batch fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))
             (fn2-extents (fn2-core-extents fn2-core)))
  (extent epoch allocation)
  (let ((e (fn2-commit-root-extent batch fn2-commit-root)))
   (mv e (fn2-extents-epoch e fn2-extents) (fn2-extents-counter e fn2-extents)))
  (mv extent epoch allocation)))
(defun fn2-retirement-live-state (extent fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (phase retired)
  (mv (fn2-extents-state extent fn2-extents) (fn2-extents-retirement extent fn2-extents))
  (mv phase retired)))

(defun fn2-retirement-live-workspace (okind oslot ogen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))
             (fn2-pool (fn2-core-pool fn2-core)))
  (phase slot gen code)
  (let ((slot (fn2-retirement-control-slot 0 fn2-retirement-control))
        (gen (fn2-retirement-control-gen 0 fn2-retirement-control)))
   (mv (fn2-retirement-control-state 0 fn2-retirement-control) slot gen
       (fn2-pool-workspace-code slot gen okind oslot ogen fn2-pool)))
  (mv phase slot gen code)))

(defun fn2-retirement-live-body (fault joinp fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((profile (fn2-b-test-profile *fn2-profile-tiny* 0))
      (fn2-core (fn2-core-init profile fn2-core))
      (fn2-sim (fn2-sim-init 1 :none "retirement-live" profile fn2-sim))
      (fn2-own (fn2-own-init profile fn2-own))
      (owner (fn2-machine-kind-base *fn2-scribe-kind* fn2-core))
      (ogen (fn2-machine-generation owner fn2-core))
      ((mv begun fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (begun fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv begun fn2-core)))
      ((unless (eq begun :ok)) (mv nil fn2-core fn2-sim fn2-own))
      ; Establish the target with the real persisted writer first, rather
      ; than planting an allocated row whose bytes never reached storage.
      ((mv started & old-batch & fn2-core)
       (fn2-commit-admit-keyed 1 0 *fn2-scribe-kind* owner ogen fn2-core))
      ((unless (eq started :ok)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv fn2-core fn2-sim fn2-own) (fn2-retirement-live-drive 600 26 fn2-core fn2-sim fn2-own))
      ; Leave the earlier settlement queued under the same owner. Retirement
      ; polling must not consume it, even while its own member is pending.
      ((mv extent epoch allocation) (fn2-retirement-live-target old-batch fn2-core))
      ; With no intervening turn, this real member leaves its collector open.
      ; The retirement producer must join it and encode that same batch.
      ((mv joined & join-batch join-event fn2-core)
       (if joinp
           (fn2-commit-admit-keyed 1 0 *fn2-scribe-kind* owner ogen fn2-core)
         (mv :ok 0 0 0 fn2-core)))
      ((mv pick & &) (fn2-commit-pick fn2-core))
      ((unless (and (eq joined :ok) (or (not joinp) (eq pick :join))))
       (mv nil fn2-core fn2-sim fn2-own))
      ((mv submitted batch event fn2-core)
       (fn2-retirement-submit extent epoch allocation *fn2-scribe-kind* owner ogen fn2-core))
      ((unless (and (eq submitted :ok) (posp batch) (posp event)
                    (or (not joinp) (and (= batch join-batch) (= event (+ 1 join-event))))))
       (mv nil fn2-core fn2-sim fn2-own))
      ((mv held-phase held-slot held-gen held-code)
       (fn2-retirement-live-workspace *fn2-scribe-kind* owner ogen fn2-core))
      ((mv pending & & fn2-core) (fn2-retirement-poll *fn2-scribe-kind* owner ogen fn2-core))
      ((mv busy & & fn2-core)
       (fn2-retirement-submit extent epoch allocation *fn2-scribe-kind* owner ogen fn2-core))
      ((mv before invariant) (fn2-read-pin-test-release-code extent epoch allocation fn2-core))
      ((mv before-state &) (fn2-retirement-live-state extent fn2-core))
      (first (fn2-machine-kind-base *fn2-commit-kind* fn2-core))
      (active (if (= (fn2-machine-batch-no first fn2-core) batch) first (+ 1 first)))
      ; A caller cannot invoke persisted installation during collection.
      ((mv early & & fn2-core)
       (fn2-commit-lifecycle-step active 0 0 fn2-core))
      ((unless (and (= held-phase *fn2-retirement-state-waiting*) (eq held-code :ok)
                    (eq pending :pending) (eq busy :busy) (eq before :state)
                    (= before-state *fn2-extent-state-allocated*)
                    (= (fn2-machine-batch-no active fn2-core) batch)
                    invariant (eq early :invalid)))
       (mv nil fn2-core fn2-sim fn2-own))
      ((mv fn2-core fn2-sim fn2-own) (fn2-retirement-live-drive 600 fault fn2-core fn2-sim fn2-own))
      ((mv settled got-batch got-event fn2-core)
       (fn2-retirement-poll *fn2-scribe-kind* owner ogen fn2-core))
      ((mv retained-phase retained-slot retained-gen retained-code)
       (fn2-retirement-live-workspace *fn2-scribe-kind* owner ogen fn2-core))
      ((mv old-code got-old-batch & old-outcome fn2-core)
       (fn2-commit-take *fn2-scribe-kind* owner ogen fn2-core))
      ((mv after invariant) (fn2-read-pin-test-release-code extent epoch allocation fn2-core))
      ((mv after-state retirement) (fn2-retirement-live-state extent fn2-core)))
  (mv (and (eq old-code :ok) (= got-old-batch old-batch)
           (= old-outcome *fn2-commit-outcome-accepted*)
           invariant (= batch got-batch) (= event got-event)
           (if (= fault 26)
               (and (eq settled :accepted) (eq after :installed-root)
                    (= after-state *fn2-extent-state-retire-pending*) (= retirement batch)
                    (not (fn2-core-stopped-p fn2-core)))
             (and (eq settled :uncertain) (eq after :state)
                  (member-equal retained-phase (list *fn2-retirement-state-waiting*
                                                     *fn2-retirement-state-uncertain*))
                  (= retained-slot held-slot) (= retained-gen held-gen) (eq retained-code :ok)
                  (= after-state *fn2-extent-state-allocated*))))
      fn2-core fn2-sim fn2-own)))

(defun fn2-retirement-live-test (fault joinp)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core)
   (with-local-stobj fn2-sim
    (mv-let (answer fn2-core fn2-sim)
     (with-local-stobj fn2-own
      (mv-let (answer fn2-core fn2-sim fn2-own)
       (fn2-retirement-live-body fault joinp fn2-core fn2-sim fn2-own)
       (mv answer fn2-core fn2-sim)))
     (mv answer fn2-core)))
   answer)))
(assert-event (fn2-retirement-live-test 26 nil))
(assert-event (fn2-retirement-live-test 12 nil))
(assert-event (fn2-retirement-live-test 26 t))
(assert-event (fn2-retirement-live-test 12 t))

; Exact settlement consumption preserves an earlier unrelated outcome owned
; by the same checkpoint coordinator, both before and after ours settles.
(defun fn2-retirement-settlement-test-body (fn2-commit-settled)
 (declare (xargs :stobjs fn2-commit-settled :verify-guards nil))
 (b* ((fn2-commit-settled (fn2-commit-settled-init 3 fn2-commit-settled))
      ((mv a ra fn2-commit-settled) (fn2-cs-reserve 7 0 1 fn2-commit-settled))
      ((mv b rb fn2-commit-settled) (fn2-cs-reserve 7 0 1 fn2-commit-settled))
      ((mv sa fn2-commit-settled)
       (fn2-cs-settle ra 1 10 *fn2-commit-outcome-accepted* 0 1 fn2-commit-settled))
      ((mv pending & & & fn2-commit-settled) (fn2-cs-take-exact 7 0 1 2 20 fn2-commit-settled))
      ((unless (and (eq a :ok) (eq b :ok) (eq sa :ok) (eq pending :pending)
                    (= (fn2-commit-settled-state ra fn2-commit-settled) *fn2-commit-settled-state-settled*)))
       (mv nil fn2-commit-settled))
      ((mv sb fn2-commit-settled)
       (fn2-cs-settle rb 2 20 *fn2-commit-outcome-accepted* 0 2 fn2-commit-settled))
      ((mv stale & & & fn2-commit-settled) (fn2-cs-take-exact 7 0 2 2 20 fn2-commit-settled))
      ((mv exact batch event outcome fn2-commit-settled)
       (fn2-cs-take-exact 7 0 1 2 20 fn2-commit-settled))
      ((mv other other-batch other-event other-outcome fn2-commit-settled)
       (fn2-cs-take 7 0 1 fn2-commit-settled)))
  (mv (and (eq sb :ok) (eq stale :none) (eq exact :ok) (= batch 2) (= event 20)
           (= outcome *fn2-commit-outcome-accepted*) (eq other :ok)
           (= other-batch 1) (= other-event 10) (= other-outcome *fn2-commit-outcome-accepted*))
      fn2-commit-settled)))
(defun fn2-retirement-settlement-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-commit-settled
  (mv-let (answer fn2-commit-settled)
   (fn2-retirement-settlement-test-body fn2-commit-settled) answer)))
(assert-event (fn2-retirement-settlement-test))

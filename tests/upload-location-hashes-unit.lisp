; Exact raw location-unit hashes, including the generated prefix and short tail.
; Source-only fixture: execute in the composed certified world.
(in-package "ACL2")
(include-book "upload-stored-source-unit")
(defun fn2-ulh-units (unit total prefix source ls lg c0 g0 c1 g1 fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil
                  :measure (nfix (- total (* unit 4096)))) )
  (if (<= total (* unit 4096)) (mv t fn2-core)
    (b* (((mv code n fn2-core)
          (fn2-upload-stage ls lg (len prefix) c0 g0 c1 g1 (* unit 4096) (len source)
                            *fn2-upload-kind* 0 1 fn2-core))
         ((unless (eq code :ok)) (mv nil fn2-core))
         ((mv code fn2-core) (fn2-upload-location-hash 3 ls lg *fn2-upload-page-stage* n unit
                                                     *fn2-upload-kind* 0 1 fn2-core))
         (got (fn2-uss-read 32 ls lg (+ *fn2-upload-page-location-hashes* (* 32 unit)) fn2-core))
         (expected (fn-blake3 (take n (nthcdr (* unit 4096) (append prefix source)))))
         ((unless (and (eq code :ok) (equal got expected))) (mv nil fn2-core)))
      (fn2-ulh-units (+ 1 unit) total prefix source ls lg c0 g0 c1 g1 fn2-core))))
(defun fn2-ulh-fixture (prefix source fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-txn-posting-profile* fn2-core))
       ((mv a ls lg fn2-core) (fn2-core-reserve 2 *fn2-upload-kind* 0 1 fn2-core))
       ((mv b c0 g0 fn2-core) (fn2-core-reserve 2 *fn2-upload-kind* 0 1 fn2-core))
       ((mv c c1 g1 fn2-core) (fn2-core-reserve 2 *fn2-upload-kind* 0 1 fn2-core))
       ((unless (and (eq a :ok) (eq b :ok) (eq c :ok))) (mv nil fn2-core))
       ((mv a fn2-core) (fn2-uss-write prefix ls lg 0 fn2-core))
       ((mv b fn2-core) (fn2-uss-write source c0 g0 0 fn2-core))
       ((unless (and (eq a :ok) (eq b :ok))) (mv nil fn2-core))
       ((mv z fn2-core) (fn2-upload-page-zero-to *fn2-upload-page-stage* ls lg *fn2-upload-kind* 0 1 fn2-core))
       ((unless (eq z :ok)) (mv nil fn2-core))
       ((mv ok fn2-core) (fn2-ulh-units 0 (+ (len prefix) (len source)) prefix source ls lg c0 g0 c1 g1 fn2-core)))
    (mv (and ok (equal prefix (fn2-uss-read (len prefix) ls lg 0 fn2-core))) fn2-core)))
(defun fn2-ulh-controls ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (answer fn2-core)
      (b* (((mv a fn2-core) (fn2-ulh-fixture nil (make-list 17 :initial-element 65) fn2-core))
           ((mv b fn2-core) (fn2-ulh-fixture '(77 73 68 13 10) (make-list 4097 :initial-element 66) fn2-core))
           ((mv c fn2-core) (fn2-ulh-fixture '(77 73 69 13 10) (make-list 8192 :initial-element 66) fn2-core)))
        (mv (and a b c) fn2-core)) answer)))
(assert-event (fn2-ulh-controls))

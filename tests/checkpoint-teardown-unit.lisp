; Primitive eligibility controls, unexecuted. Candidate/ledger ownership is an
; explicit synthetic premise; physical identities and every edge use the actual
; allocator. This is not a publication, intent barrier or retirement witness.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-teardown")
(defun fn2-ctu-body (fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges) :verify-guards nil))
 (b* ((fn2-checkpoints (fn2-checkpoints-init 1 fn2-checkpoints))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-init 1 fn2-checkpoint-construction))
      (fn2-extents (fn2-alloc-init 1 fn2-extents))
      (fn2-ops (fn2-ops-columns-init 0 fn2-ops))
      (fn2-alloc-edges (fn2-alloc-edges-init 20 fn2-alloc-edges))
      ((mv epoch-code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv code & e epoch counter fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((unless (and (eq epoch-code :ok) (eq code :ok) (equal e 0)))
       (mv nil fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges))
      ((mv committed fn2-extents) (fn2-alloc-commit-allocation e epoch counter 1 9 fn2-extents))
      (fn2-checkpoints (fn2-checkpoints-put 0 (state *fn2-checkpoint-state-installed*)
        (checkpoint 7) (builder-token 9) (builder-owner-kind 1) (builder-owner-slot 2) (builder-owner-gen 3)))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-put e
        (live 1) (token 9) (owner-kind 1) (owner-slot 2) (owner-gen 3)
        (role 1) (epoch epoch) (counter counter)))
      (source (fn2-checkpoint-source-edge 0 e fn2-extents fn2-ops fn2-checkpoints))
      ((mv claimed fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add source 7 e epoch counter :selectable-checkpoint fn2-extents fn2-alloc-edges))
      ((unless (and (eq committed :ok) (eq claimed :ok)
                     (fn2-checkpoint-teardown-eligiblep 0 e fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges)))
       (mv nil fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges))
      ; A physical pin is preserved and does not prohibit durable retirement.
      ((mv pinned fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 17 99 e epoch counter :outstanding-io fn2-extents fn2-alloc-edges))
      ((unless (and (eq pinned :ok)
                     (fn2-checkpoint-teardown-eligiblep 0 e fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges)
                     (equal (fn2-extents-outstanding-io e fn2-extents) 1)))
       (mv nil fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges))
      ((mv protected fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 18 99 e epoch counter :recovery-base fn2-extents fn2-alloc-edges))
      ((unless (and (eq protected :ok)
                     (not (fn2-checkpoint-teardown-eligiblep 0 e fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges))))
       (mv nil fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges))
      ((mv dropped fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-drop 18 99 e epoch counter :recovery-base fn2-extents fn2-alloc-edges))
      ((mv shared fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 19 8 e epoch counter :selectable-checkpoint fn2-extents fn2-alloc-edges))
      ((unless (and (eq dropped :ok) (eq shared :ok)
                     (not (fn2-checkpoint-teardown-eligiblep 0 e fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges))))
       (mv nil fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges))
      ((mv dropped fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-drop 19 8 e epoch counter :selectable-checkpoint fn2-extents fn2-alloc-edges))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-set-role e 6 fn2-checkpoint-construction))
      ((unless (and (eq dropped :ok)
                     (not (fn2-checkpoint-teardown-eligiblep 0 e fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges))))
       (mv nil fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges))
      (fn2-checkpoint-construction (fn2-checkpoint-construction-put e (role 1) (token 10))))
  (mv (and (not (fn2-checkpoint-teardown-eligiblep 0 e fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges))
           (equal (fn2-extents-outstanding-io e fn2-extents) 1)
           (fn2-alloc-edge-matchesp source 7 e epoch counter :selectable-checkpoint fn2-alloc-edges))
      fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges)))
(defun fn2-ctu ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoints
  (mv-let (answer fn2-checkpoints)
   (with-local-stobj fn2-checkpoint-construction
    (mv-let (answer fn2-checkpoints fn2-checkpoint-construction)
     (with-local-stobj fn2-extents
      (mv-let (answer fn2-checkpoints fn2-checkpoint-construction fn2-extents)
       (with-local-stobj fn2-ops
        (mv-let (answer fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops)
         (with-local-stobj fn2-alloc-edges
          (mv-let (answer fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges)
           (fn2-ctu-body fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops fn2-alloc-edges)
           (mv answer fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-ops)))
         (mv answer fn2-checkpoints fn2-checkpoint-construction fn2-extents)))
       (mv answer fn2-checkpoints fn2-checkpoint-construction)))
     (mv answer fn2-checkpoints))) answer)))
(assert-event (fn2-ctu))

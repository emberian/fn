; Test-only actual persisted publication constructor shared by catalog/Q1 controls.
; All Write/Fence outcomes use the real simulator pump. No published, selected,
; HELD or evidence state is assigned. Maintenance entry remains test-only and
; activation NIL; this does not claim automatic scheduler reachability.
(in-package "ACL2")
(include-book "checkpoint-cold-path-producer-support")

(defun fn2-clc-published-held-p (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((id (fn2-machine-kind-base *fn2-checkpoint-master-kind* fn2-core)))
  (and (eq (fn2-checkpoint-master-snapshot-read-code id fn2-core) :ok)
       (= (fn2-machine-phase id fn2-core) *fn2-checkpoint-master-state-summary-authority-begin*)
       (stobj-let ((fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core))) (complete)
        (= (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication) *fn2-checkpoint-publication-phase-complete*) complete))))

(defun fn2-clc-drive-published-held (fuel fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (cond ((fn2-clc-published-held-p fn2-core) (mv :held fn2-core fn2-sim fn2-own))
       ((zp fuel) (mv :fuel fn2-core fn2-sim fn2-own))
       ((fn2-core-stopped-p fn2-core) (mv :failed fn2-core fn2-sim fn2-own))
       (t (b* (((mv code fn2-core fn2-sim fn2-own) (fn2-ccp-pump fn2-core fn2-sim fn2-own)))
        (if (eq code :failed) (mv code fn2-core fn2-sim fn2-own)
         (fn2-clc-drive-published-held (- fuel 1) fn2-core fn2-sim fn2-own))))))

(defun fn2-clc-full-live-source-p (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-checkpoint-summary-authority (fn2-core-checkpoint-summary-authority fn2-core))
             (fn2-checkpoint-source (fn2-core-checkpoint-source fn2-core))
             (fn2-checkpoint-metadata-manifest (fn2-core-checkpoint-metadata-manifest fn2-core))
             (fn2-checkpoint-build (fn2-core-checkpoint-build fn2-core))
             (fn2-checkpoint-publication (fn2-core-checkpoint-publication fn2-core))
             (fn2-csnapshot (fn2-core-csnapshot fn2-core))
             (fn2-run-builds (fn2-core-run-builds fn2-core))
             (fn2-run-writers (fn2-core-run-writers fn2-core))
             (fn2-event-build (fn2-core-event-build fn2-core))
             (fn2-event-read (fn2-core-event-read fn2-core))
             (fn2-checkpoints (fn2-core-checkpoints fn2-core))
             (fn2-checkpoint-refs (fn2-core-checkpoint-refs fn2-core))
             (fn2-checkpoint-bytes (fn2-core-checkpoint-bytes fn2-core))
             (fn2-commit-root (fn2-core-commit-root fn2-core))
             (fn2-mk (fn2-core-mk fn2-core))
             (fn2-fc (fn2-core-fc fn2-core))
             (fn2-digests (fn2-core-digests fn2-core))
             (fn2-checkpoint-lifecycle (fn2-core-checkpoint-lifecycle fn2-core))
             (fn2-checkpoint-writer (fn2-core-checkpoint-writer fn2-core))
             (fn2-machines (fn2-core-machines fn2-core))) (ok)
  (fn2-checkpoint-summary-authority-live-source-p fn2-checkpoint-summary-authority fn2-checkpoint-source fn2-checkpoint-metadata-manifest fn2-checkpoint-build fn2-checkpoint-publication fn2-csnapshot fn2-run-builds fn2-run-writers fn2-event-build fn2-event-read fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-commit-root fn2-mk fn2-fc fn2-digests fn2-checkpoint-lifecycle fn2-checkpoint-writer fn2-machines) ok))
; Accept an already created store, allowing a caller to first commit an actual
; article/payload prefix. This adds an ordinary commit and real maintenance.
(defun fn2-clc-prefix-to-held (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((mv admitted writer batch & fn2-core) (fn2-commit-admit-keyed 1 0 0 0 0 fn2-core))
      ((unless (eq admitted :ok)) (mv admitted fn2-core fn2-sim fn2-own))
      (fn2-core (fn2-exec-wake writer fn2-core))
      ((mv committed fn2-core fn2-sim fn2-own) (fn2-ccp-live-drive 200000 nil batch fn2-core fn2-sim fn2-own))
      ((unless (eq committed :complete)) (mv committed fn2-core fn2-sim fn2-own))
      ((mv entered fn2-core) (fn2-ccp-maintenance-entry fn2-core))
      ((unless (eq entered :ok)) (mv entered fn2-core fn2-sim fn2-own))
      ((mv held fn2-core fn2-sim fn2-own) (fn2-clc-drive-published-held 400000 fn2-core fn2-sim fn2-own)))
  (mv (if (and (eq held :held) (fn2-clc-published-held-p fn2-core) (fn2-clc-full-live-source-p fn2-core)) :held
       (if (eq held :held) :source held)) fn2-core fn2-sim fn2-own)))
(defun fn2-clc-produce-held (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-ccp-profile* :null nil fn2-core))
      (fn2-sim (fn2-sim-init 1 :none "live-publication" *fn2-ccp-profile* fn2-sim))
      (fn2-own (fn2-own-init *fn2-ccp-profile* fn2-own))
      ((mv started fn2-core) (fn2-boot-start t *fn2-ccp-image-size* fn2-core))
      ((mv created fn2-core fn2-sim fn2-own) (fn2-ccp-drive 200000 nil fn2-core fn2-sim fn2-own))
      ((unless (and (eq started :ok) (eq created :ready))) (mv :create fn2-core fn2-sim fn2-own)))
  (fn2-clc-prefix-to-held fn2-core fn2-sim fn2-own)))

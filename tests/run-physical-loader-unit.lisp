 (stobj-let ((fn2-run-loads (fn2-core-run-loads fn2-core)) (fn2-run-cursors (fn2-core-run-cursors fn2-core))
             (fn2-fc (fn2-core-fc fn2-core))) (yes)
  (and (= (fn2-run-loads-sector 0 fn2-run-loads) *fn2-storage-extent-units*)
       (= (fn2-run-loads-pending 0 fn2-run-loads) 0)
       (= (fn2-run-loads-phase 0 fn2-run-loads) *fn2-run-load-phase-ready*)
       (= (fn2-run-cursors-phase 0 fn2-run-cursors) *fn2-run-cursor-phase-header*)
       (= (fn2-fc-phase (fn2-run-loads-checker 0 fn2-run-loads) fn2-fc) *fn2-fc-phase-idle*)) yes))

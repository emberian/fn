 (if (equal kind 0)
  (mv-let (code & fn2-core) (fn2-csnapshot-overlay-entry token 9 0 1 row position 200 fn2-core) (mv code fn2-core))
  (b* ((unit (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core))) (u) (fn2-run-installed-unit row fn2-run-installed) u))
       ((mv code slot gen sk ss sg & & & fn2-core) (fn2-csnapshot-run-page token 9 0 1 row unit 0 4096 fn2-core))
       ((unless (eq code :ok)) (mv code fn2-core)))
   (fn2-rpl-copy-held-row slot gen position sk ss sg fn2-core))))
(defun fn2-rpl-rebuild (token kind row rank count fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv alloc e ep al fn2-core) (fn2-rpl-allocate fn2-core))
      ((mv reserved slot gen fn2-core) (fn2-core-reserve 3 9 0 1 fn2-core))
      ((unless (and (eq alloc :ok) (eq reserved :ok))) (mv nil nil fn2-core))
      ((mv opened fn2-core) (fn2-rpl-open slot gen (* e *fn2-storage-extent-units*) ep al rank fn2-core))
      ((mv entry fn2-core) (fn2-rpl-held-entry token kind row 0 fn2-core))
      ((mv added fn2-core) (fn2-rpl-add fn2-core))
      ((mv entry2 fn2-core) (if (equal count 2) (fn2-rpl-held-entry token kind row 1 fn2-core) (mv :ok fn2-core)))
      ((mv added2 fn2-core) (if (equal count 2) (fn2-rpl-add fn2-core) (mv :ok fn2-core)))
      ((mv closing fn2-core) (fn2-rpl-close-begin fn2-core))
      ((mv closed fn2-core) (fn2-rpl-producer-drive 64 nil fn2-core))
      ((mv headed fn2-core) (fn2-rpl-head fn2-core))
      ((mv context fn2-core) (fn2-rpl-context fn2-core))
      ((mv sealed fn2-core) (fn2-rpl-producer-drive 128 t fn2-core))
      ((mv checked fn2-core) (fn2-rpl-check slot gen fn2-core))
      ((unless (and (eq opened :ok) (eq entry :ok) (eq added :ok) (eq entry2 :ok) (eq added2 :ok)
                    (eq closing :ok) (eq closed :ok) (eq headed :ok) (eq context :ok) (eq sealed :ok) (eq checked :ok)))
       (mv nil nil fn2-core))
      ((mv recorded fn2-core) (fn2-rpl-record-page nil 0 rank slot gen (* e *fn2-storage-extent-units*) ep al count fn2-core)))
  (mv (eq recorded :ok) (list (* e *fn2-storage-extent-units*) slot gen) fn2-core)))


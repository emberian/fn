 (if (zp fuel) (mv :fuel reads saw-header fn2-core)
  (b* ((phase (stobj-let ((fn2-run-loads (fn2-core-run-loads fn2-core))) (p) (fn2-run-loads-phase 0 fn2-run-loads) p))
       (saw-header (or saw-header (equal phase *fn2-run-load-phase-header*)))
       ((mv code fn2-core) (fn2-rpl-load-step fn2-core)))
   (cond ((eq code :ready) (mv (if (and saw-header (fn2-rpl-loadedp fn2-core)) :ready :incomplete) reads saw-header fn2-core))
         ((eq code :need-read)
          (b* (((mv issued op gen fn2-core) (fn2-rpl-load-read fn2-core))
               ((unless (eq issued :ok)) (mv issued reads saw-header fn2-core))
               ((mv done fn2-core) (fn2-rpl-complete-read op gen disks corrupt fn2-core))
               ((unless done) (mv :completion reads saw-header fn2-core)))
           (fn2-rpl-load-drive (- fuel 1) disks corrupt (+ reads 1) saw-header fn2-core)))
         ((eq code :more) (fn2-rpl-load-drive (- fuel 1) disks corrupt reads saw-header fn2-core))
         (t (mv code reads saw-header fn2-core))))))

; One source selector step scans one actual held row. The test consumes the
; selected source fully, then uses the same SCAN rearm as the source actor.
(defun fn2-rpl-select-step (fn2-checkpoint-source fn2-core)
 (declare (xargs :stobjs (fn2-checkpoint-source fn2-core) :verify-guards nil))
 (stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core)) (fn2-overlays (fn2-core-overlays fn2-core))
             (fn2-run-installed (fn2-core-run-installed fn2-core))) (code fn2-checkpoint-source)
  (fn2-checkpoint-source-step 1 fn2-checkpoint-source fn2-csnapshot fn2-overlays fn2-run-installed)
  (mv code fn2-checkpoint-source fn2-core)))
(defun fn2-rpl-select-drive (fuel fn2-checkpoint-source fn2-core)
 (declare (xargs :stobjs (fn2-checkpoint-source fn2-core) :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-checkpoint-source fn2-core)
  (mv-let (code fn2-checkpoint-source fn2-core) (fn2-rpl-select-step fn2-checkpoint-source fn2-core)
   (if (eq code :more) (fn2-rpl-select-drive (- fuel 1) fn2-checkpoint-source fn2-core)
    (mv code fn2-checkpoint-source fn2-core)))))
(defun fn2-rpl-capture (fuel token disks order fn2-checkpoint-source fn2-core)
 (declare (xargs :stobjs (fn2-checkpoint-source fn2-core) :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv nil disks order fn2-checkpoint-source fn2-core)
  (b* (((mv code fn2-checkpoint-source fn2-core) (fn2-rpl-select-drive 256 fn2-checkpoint-source fn2-core))
       ((when (eq code :done)) (mv t disks (reverse order) fn2-checkpoint-source fn2-core))
       ((unless (eq code :source)) (mv nil disks order fn2-checkpoint-source fn2-core))
       (kind (fn2-checkpoint-source-kind 0 fn2-checkpoint-source)) (row (fn2-checkpoint-source-row 0 fn2-checkpoint-source))
       (rank (fn2-checkpoint-source-rank 0 fn2-checkpoint-source))
       ((unless (equal (fn2-checkpoint-source-schema 0 fn2-checkpoint-source) 3))
        (mv nil disks order fn2-checkpoint-source fn2-core))
       (count (stobj-let ((fn2-overlays (fn2-core-overlays fn2-core)) (fn2-run-installed (fn2-core-run-installed fn2-core))) (n)
               (if (equal kind 0) (fn2-overlays-count row fn2-overlays) (fn2-run-installed-entries row fn2-run-installed)) n))
       ; This finite fixture expects two entries in each resident source and
       ; one in its overlay. Refuse a changed fixture instead of dropping rows.
       ((unless (equal count (if (equal kind 0) 1 2))) (mv nil disks order fn2-checkpoint-source fn2-core))
       ((mv good disk fn2-core) (fn2-rpl-rebuild token kind row rank count fn2-core))
       ((unless good) (mv nil disks order fn2-checkpoint-source fn2-core))
       (fn2-checkpoint-source (fn2-checkpoint-source-put 0 (phase *fn2-checkpoint-source-phase-scan*)
        (scan-kind 0) (scan-row 0) (found 0))))
   (fn2-rpl-capture (- fuel 1) token (cons disk disks) (cons (list rank kind row) order) fn2-checkpoint-source fn2-core))))


; Capture the producer's actual checker hash. This is the explicitly scoped
; synthetic catalog-intake seam, not an arbitrary expected digest supplied
; by Python or the test's caller.
(fn2-rpl-wrapper fn2-rpl-record-page (resident row rank slot gen unit epoch allocation count)
 (fn2-run-installed fn2-run-cache fn2-checkpoint-summary-sources fn2-digests)
 (fn2-run-installed fn2-run-cache fn2-checkpoint-summary-sources) (code)
 (if resident
  (b* (((mv code fn2-run-cache) (fn2-run-cache-install unit allocation slot gen fn2-run-cache))
       ((unless (eq code :ok)) (mv code fn2-run-installed fn2-run-cache fn2-checkpoint-summary-sources))
       ((mv code fn2-run-installed) (fn2-run-install row 3 rank 0 slot gen unit allocation count 9 0 1 fn2-run-installed))
       ((unless (eq code :ok)) (mv code fn2-run-installed fn2-run-cache fn2-checkpoint-summary-sources))
       ((mv code fn2-run-installed) (fn2-run-install-units row unit unit fn2-run-installed)))
   (mv code fn2-run-installed fn2-run-cache fn2-checkpoint-summary-sources))
  (let ((fn2-checkpoint-summary-sources
         (fn2-checkpoint-summary-sources-put (floor unit *fn2-storage-extent-units*)
          (tag 1) (schema 3) (rank rank) (top 0) (entries count) (unit unit) (epoch epoch) (allocation allocation)
          (hash-0 (fn2-digest-word (fn2-digest-slot 0 *fn2-fc-hash*) 0 fn2-digests))
          (hash-1 (fn2-digest-word (fn2-digest-slot 0 *fn2-fc-hash*) 1 fn2-digests))
          (hash-2 (fn2-digest-word (fn2-digest-slot 0 *fn2-fc-hash*) 2 fn2-digests))
          (hash-3 (fn2-digest-word (fn2-digest-slot 0 *fn2-fc-hash*) 3 fn2-digests))
          (hash-4 (fn2-digest-word (fn2-digest-slot 0 *fn2-fc-hash*) 4 fn2-digests))
          (hash-5 (fn2-digest-word (fn2-digest-slot 0 *fn2-fc-hash*) 5 fn2-digests))
          (hash-6 (fn2-digest-word (fn2-digest-slot 0 *fn2-fc-hash*) 6 fn2-digests))
          (hash-7 (fn2-digest-word (fn2-digest-slot 0 *fn2-fc-hash*) 7 fn2-digests))
         )))
   (mv :ok fn2-run-installed fn2-run-cache fn2-checkpoint-summary-sources))))

(defun fn2-rpl-produce (resident row rank first second src sgen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv alloc e ep al fn2-core) (fn2-rpl-allocate fn2-core))
      ((mv reserved slot gen fn2-core) (fn2-core-reserve 3 9 0 1 fn2-core))
      ((unless (and (eq alloc :ok) (eq reserved :ok))) (mv nil nil fn2-core))
      ((mv opened fn2-core) (fn2-rpl-open slot gen (* e *fn2-storage-extent-units*) ep al rank fn2-core))
      ((mv entry fn2-core) (fn2-rpl-entry 1 first src sgen fn2-core))
      ((mv added fn2-core) (fn2-rpl-add fn2-core))
      ((mv entry2 fn2-core) (if second (fn2-rpl-entry 2 second src sgen fn2-core) (mv :ok fn2-core)))
      ((mv added2 fn2-core) (if second (fn2-rpl-add fn2-core) (mv :ok fn2-core)))
      ((mv closing fn2-core) (fn2-rpl-close-begin fn2-core))
      ((mv closed fn2-core) (fn2-rpl-producer-drive 64 nil fn2-core))
      ((mv headed fn2-core) (fn2-rpl-head fn2-core))
      ((mv context fn2-core) (fn2-rpl-context fn2-core))
      ((mv sealed fn2-core) (fn2-rpl-producer-drive 128 t fn2-core))
      ((mv checked fn2-core) (fn2-rpl-check slot gen fn2-core))
      ((unless (and (eq opened :ok) (eq entry :ok) (eq added :ok) (eq entry2 :ok) (eq added2 :ok)
                    (eq closing :ok) (eq closed :ok) (eq headed :ok) (eq context :ok) (eq sealed :ok) (eq checked :ok)))
       (mv nil nil fn2-core))
      ((mv recorded fn2-core) (fn2-rpl-record-page resident row rank slot gen (* e *fn2-storage-extent-units*) ep al
                              (if second 2 1) fn2-core)))
  (mv (eq recorded :ok) (list (* e *fn2-storage-extent-units*) slot gen) fn2-core)))

; Use the actual held source APIs and generated NTH codec. The producer and
; held pages have the same explicit fixture owner, so referenced LINE bytes
; need no authority change or unchecked owner substitution here.
(fn2-rpl-wrapper fn2-rpl-copy-held-row (slot gen position sk ss sg)
 (fn2-fields fn2-pool) (fn2-fields) (code)
 (b* (((mv code fn2-fields) (fn2-run-read-header slot gen 256 sk ss sg fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields))
      ((mv code & fn2-fields) (fn2-run-nth 3 0 position slot gen 256 sk ss sg fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields))
      (fn2-fields (fn2-run-copy-row (+ 256 *fn2-run-reader-entry* *fn2-overview-entry-field-group*) (+ 200 *fn2-overview-entry-field-group*) fn2-fields))
      (fn2-fields (fn2-run-copy-row (+ 256 *fn2-run-reader-entry* *fn2-overview-entry-field-number*) (+ 200 *fn2-overview-entry-field-number*) fn2-fields))
      (fn2-fields (fn2-run-copy-row (+ 256 *fn2-run-reader-entry* *fn2-overview-entry-field-article*) (+ 200 *fn2-overview-entry-field-article*) fn2-fields))
      (fn2-fields (fn2-run-copy-row (+ 256 *fn2-run-reader-entry* *fn2-overview-entry-field-position*) (+ 200 *fn2-overview-entry-field-position*) fn2-fields))
      (fn2-fields (fn2-run-copy-row (+ 256 *fn2-run-reader-entry* *fn2-overview-entry-field-line*) (+ 200 *fn2-overview-entry-field-line*) fn2-fields)))
  (mv :ok fn2-fields)))
(defun fn2-rpl-held-entry (token kind row position fn2-core)

(defun fn2-rpl-bindings (names)
 (declare (xargs :verify-guards nil))
 (if (atom names) nil
  (cons (list (car names)
         (list (intern-in-package-of-symbol
                (concatenate 'string "FN2-CORE-" (subseq (symbol-name (car names)) 4 nil)) 'fn2-core) 'fn2-core))
        (fn2-rpl-bindings (cdr names)))))
(defmacro fn2-rpl-wrapper (name args inputs outputs scalars call)
 `(defun ,name ,(append args '(fn2-core))
   (declare (xargs :stobjs fn2-core :verify-guards nil))
   (stobj-let ,(fn2-rpl-bindings inputs) ,(append scalars outputs)
    ,call (mv ,@scalars fn2-core))))


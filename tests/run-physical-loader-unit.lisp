(defun fn2-rpl-body (corrupt fn2-checkpoint-source fn2-core)
 (declare (xargs :stobjs (fn2-checkpoint-source fn2-core) :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-rpl-profile* fn2-core))
      (fn2-checkpoint-source (fn2-checkpoint-source-init 1 fn2-checkpoint-source))
      ((mv env fn2-core) (fn2-rpl-init-environment fn2-core))
      ((mv reserved src sgen fn2-core) (fn2-core-reserve 0 9 0 1 fn2-core))
      ((mv written fn2-core) (fn2-core-write src sgen 0 65 9 0 1 fn2-core))
      ((unless (and (eq env :ok) (eq reserved :ok) (eq written :ok))) (mv nil fn2-checkpoint-source fn2-core))
      ; Tied run identifiers: row0 must beat row1 for key2. Overlay key1
      ; must beat both resident runs independently of run identifier7.
      ((mv made0 & fn2-core) (fn2-rpl-produce t 0 7 101 111 src sgen fn2-core))
      ((mv made1 & fn2-core) (fn2-rpl-produce t 1 7 202 222 src sgen fn2-core))
      ((mv entry fn2-core) (fn2-rpl-entry 1 303 src sgen fn2-core))
      ((mv overlay fn2-core) (fn2-rpl-overlay fn2-core))
      ((unless (and made0 made1 (eq entry :ok) (eq overlay :ok))) (mv nil fn2-checkpoint-source fn2-core))
      ((mv before1 value1 reads1 fn2-core) (fn2-rpl-query 1 nil nil fn2-core))
      ((mv before2 value2 reads2 fn2-core) (fn2-rpl-query 2 nil nil fn2-core))
      ((unless (and (eq before1 :ok) (equal value1 '(1 1 303 1 65)) (= reads1 0) (eq before2 :ok) (equal value2 '(1 2 111 2 65)) (= reads2 0)))
       (mv nil fn2-checkpoint-source fn2-core))
      ((mv begin token fn2-core) (fn2-csnapshot-begin 9 0 1 fn2-core))
      ((mv held fn2-core) (fn2-rpl-held 256 token fn2-core))
      ((mv selected fn2-checkpoint-source fn2-core) (fn2-rpl-source-begin token fn2-checkpoint-source fn2-core))
      ((unless (and (eq begin :ok) (eq held :held) (eq selected :ok))) (mv nil fn2-checkpoint-source fn2-core))
      ; The actual selector derives increasing priority ranks from the held
      ; rows. Rebuild decodes those same entries, rather than reauthoring values.
      ((mv captured disks order fn2-checkpoint-source fn2-core) (fn2-rpl-capture 4 token nil nil fn2-checkpoint-source fn2-core))
      ((unless (and captured (equal order '((1 1 1) (2 1 0) (3 0 0))) (= (len disks) 3)))
       (mv nil fn2-checkpoint-source fn2-core))
      ((mv released fn2-core) (fn2-csnapshot-release token 9 0 1 fn2-core))
      ((mv cold fn2-core) (fn2-rpl-cold-admission fn2-core))
      ((mv applied fn2-core) (fn2-rpl-apply 32 fn2-core))
      ((unless (and (eq released :ok) (eq cold :ok) (eq applied :applied) (fn2-rpl-cache-emptyp fn2-core)))
       (mv nil fn2-checkpoint-source fn2-core))
      ((mv after1 again1 physical1 fn2-core) (fn2-rpl-query 1 disks corrupt fn2-core))
      ((when corrupt)
       (mv (and (not (eq after1 :ok)) (= again1 0) (= physical1 16)
                (fn2-rpl-never-exposed-p fn2-core) (fn2-rpl-cache-emptyp fn2-core)) fn2-checkpoint-source fn2-core))
      ((mv after2 again2 physical2 fn2-core) (fn2-rpl-query 2 disks nil fn2-core)))
  (mv (and (eq after1 :ok) (equal value1 again1) (equal again1 '(1 1 303 1 65)) (= physical1 16)
           (eq after2 :ok) (equal value2 again2) (equal again2 '(1 2 111 2 65)) (= physical2 32)
           (fn2-rpl-cache-emptyp fn2-core) (not (fn2-core-stopped-p fn2-core))) fn2-checkpoint-source fn2-core)))

; The disk environment returns only bytes from the actual sealed source page.
; Address selection comes from the queued operation, not from the expected
; hash or the loader's cursor. Every adapter write uses the actual op tuple.
(defun fn2-rpl-disk-page (unit disks)
 (declare (xargs :verify-guards nil))
 (if (atom disks) nil
  (if (and (<= (caar disks) unit) (< unit (+ (caar disks) *fn2-storage-extent-units*)))
      (car disks) (fn2-rpl-disk-page unit (cdr disks)))))
(defun fn2-rpl-input-copy (n at source sgen soff slot gen op ogen corrupt fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix n)))
 (if (zp n) (mv :ok fn2-pool)
  (b* (((mv code byte) (fn2-pool-read source sgen (+ soff at) 9 0 1 fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-pool))
       ((mv code fn2-pool) (fn2-pool-adapter-write slot gen op ogen at
        (if (and corrupt (equal (+ soff at) 1000)) (logxor 1 byte) byte) fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-pool)))
   (fn2-rpl-input-copy (- n 1) (+ at 1) source sgen soff slot gen op ogen corrupt fn2-pool))))
(defun fn2-rpl-complete-read (op gen disks corrupt fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv queued qop qgen) (fn2-host-outbox-peek 0 fn2-core))
      ((mv action kind & & slot sgen off count storage & & & & & &) (fn2-host-action op fn2-core))
      (unit (floor storage *fn2-commit-unit-bytes*))
      (page (fn2-rpl-disk-page unit disks))
      ((unless (and (eq queued :ok) (= qop op) (= qgen gen) (eq action :ok)
                    (= kind *fn2-action-read*) (= off 0) (= count *fn2-commit-unit-bytes*)
                    (= (mod storage *fn2-commit-unit-bytes*) 0) page)) (mv nil fn2-core))
      ((mv copied fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
        (fn2-rpl-input-copy count 0 (cadr page) (caddr page) (* (- unit (car page)) *fn2-commit-unit-bytes*) slot sgen op gen corrupt fn2-pool)
        (mv code fn2-core)))
      ((unless (eq copied :ok)) (mv nil fn2-core))
      ((mv ack fn2-core)
       (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (code fn2-ops)
        (fn2-outbox-ack 1 fn2-ops) (mv code fn2-core)))
      (fn2-core (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (fn2-ops)
                 (fn2-post-result 0 op gen *fn2-event-read-result* *fn2-outcome-done* *fn2-reason-none* count 0 0 fn2-ops) fn2-core))
      ((mv done hop hgen cell ev outcome reason bytes & & fn2-core) (fn2-harvest-one fn2-core)))
  (mv (and (eq ack :ok) done (= hop op) (= hgen gen) (= cell 0) (= ev *fn2-event-read-result*)
           (= outcome *fn2-outcome-done*) (= reason *fn2-reason-none*) (= bytes *fn2-commit-unit-bytes*)) fn2-core)))

; READY must follow all 16 actual physical completions and the verifier's
; HEADER phase. This witness is inspected, never written by the fixture.
(defun fn2-rpl-loadedp (fn2-core)

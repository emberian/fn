; Actual C EMIT -> typed B membership -> actual current bind -> exact complete.
; This is a source-prepared claim/gate control, not persisted IO/Accept proof.
; The current atomic binder will be replaced by the same retained C kernel;
; this fixture must follow that served ABI before final qualification.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "ordinary-drain-credit-canonical-unit")
(make-event (cons 'progn (fn2-riud-projection-events '(fn2-succ-txns) (w state))))
(defconst *fn2-csbu-profile* (put-assoc-equal :identity-arena-bytes 4096 *fn2-odcc-profile*))
(defun fn2-csbu-view (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-commit (fn2-commit-table fn2-core))
             (fn2-commit-member (fn2-core-commit-members fn2-core))
             (fn2-succ-txns (fn2-core-succ-txns fn2-core))) (view)
  (list (fn2-commit-cb-bind-pending 0 fn2-commit)
        (fn2-commit-member-copy fn2-commit-member) (fn2-succ-txns-copy fn2-succ-txns)) view))
(defun fn2-csbu-args (left fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-successor-arg 0 0 (- left 1) :value 1 fn2-core)
   (if (eq code :ok) (fn2-csbu-args (- left 1) fn2-core) (mv code fn2-core)))))
(defun fn2-csbu-resolve (left fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-successor-resolve 0 4096 fn2-core)
   (if (eq code :more) (fn2-csbu-resolve (- left 1) fn2-core) (mv code fn2-core)))))
(defun fn2-csbu-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-csbu-profile* fn2-core))
      ((mv epoch fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv configured fn2-core) (fn2-odcc-configure fn2-core))
      (kind *fn2-scribe-kind*) (owner (fn2-machine-kind-base kind fn2-core))
      (ogen (fn2-machine-generation owner fn2-core))
      ((mv reserved slot gen fn2-core) (fn2-core-reserve (fn2-scribe-window-class fn2-core) kind owner ogen fn2-core))
      ((mv put fn2-core) (fn2-successor-put 0 0 *fn2-succ-addr-sid* :insert fn2-core))
      ((mv args fn2-core) (fn2-csbu-args 5 fn2-core))
      ((mv resolved fn2-core) (fn2-csbu-resolve 40 fn2-core))
      ((mv staged & fn2-core) (fn2-successor-stage 0 fn2-core))
      ((mv emitted len fn2-core) (fn2-successor-emit 0 slot gen 0 4096 kind owner ogen fn2-core))
      (txgen (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (n)
               (fn2-succ-txns-generation 0 fn2-succ-txns) n))
      ((unless (and (eq epoch :ok) (eq configured :ok) (eq reserved :ok) (eq put :ok)
                    (eq args :ok) (eq resolved :ok) (eq staged :ok) (eq emitted :ok)
                    (posp txgen) (posp len))) (mv nil fn2-core))
      (before (fn2-csbu-view fn2-core))
      ((mv generic gb ge fn2-core) (fn2-commit-admit-txn slot gen len kind owner ogen fn2-core))
      ((mv stale sb se fn2-core) (fn2-commit-admit-successor 0 (+ 1 txgen) slot gen len kind owner ogen fn2-core))
      ((unless (and (eq generic :admission) (= gb 0) (= ge 0) (eq stale :admission) (= sb 0) (= se 0)
                    (equal before (fn2-csbu-view fn2-core)))) (mv nil fn2-core))
      ((mv admitted batch event fn2-core) (fn2-commit-admit-successor 0 txgen slot gen len kind owner ogen fn2-core))
      (id (fn2-machine-kind-base *fn2-commit-kind* fn2-core))
      (pending (stobj-let ((fn2-commit (fn2-commit-table fn2-core))
                           (fn2-commit-member (fn2-core-commit-members fn2-core))) (yes)
                 (fn2-commit-successor-bind-pending-p batch event 0 txgen slot gen len kind owner ogen fn2-commit fn2-commit-member) yes))
      ((unless (and (eq admitted :ok) pending (= (fn2-machine-cb-bind-pending id fn2-core) 1))) (mv nil fn2-core))
      (before (fn2-csbu-view fn2-core))
      ((mv premature fn2-core) (fn2-commit-successor-bind-complete batch event 0 txgen slot gen len kind owner ogen fn2-core))
      ((mv swapped fn2-core) (fn2-commit-root-swap id nil fn2-core))
      ((unless (and (eq premature :owner) (not swapped) (equal before (fn2-csbu-view fn2-core)))) (mv nil fn2-core))
      ((mv bound fn2-core) (fn2-successor-bind 0 batch event fn2-core))
      (before (fn2-csbu-view fn2-core))
      ((mv changed-length fn2-core) (fn2-commit-successor-bind-complete batch event 0 txgen slot gen (+ len 1) kind owner ogen fn2-core))
      ((unless (and (eq bound :ok) (eq changed-length :owner) (equal before (fn2-csbu-view fn2-core)))) (mv nil fn2-core))
      ((mv completed fn2-core) (fn2-commit-successor-bind-complete batch event 0 txgen slot gen len kind owner ogen fn2-core))
      (before (fn2-csbu-view fn2-core))
      ((mv repeated fn2-core) (fn2-commit-successor-bind-complete batch event 0 txgen slot gen len kind owner ogen fn2-core)))
  (mv (and (eq completed :ok) (= (fn2-machine-cb-bind-pending id fn2-core) 0)
           (eq repeated :already) (equal before (fn2-csbu-view fn2-core))
           (not (fn2-core-stopped-p fn2-core))) fn2-core)))
(defun fn2-csbu-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-csbu-body fn2-core) ok)))
(assert-event (fn2-csbu-run))

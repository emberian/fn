; Prepared actual declaration-work gate. No ACL2 execution in the source lane.
(in-package "ACL2")
(include-book "../books/assembly-index")
(defun fn2-c-read-budget-kinds-p (kinds world)
 (declare (xargs :verify-guards nil))
 (or (atom kinds)
  (and (unsigned-byte-p 32 (fn2-arm-get :bytes (fn2-machine-property (car kinds) :budget world)))
       (< *fn2-c-read-callback-bytes* (fn2-arm-get :bytes (fn2-machine-property (car kinds) :budget world)))
       (fn2-c-read-budget-kinds-p (cdr kinds) world))))
(make-event
 (if (and (posp *fn2-run-layout-max-entry-bytes*)
          (posp *fn2-c-read-step-bytes*)
          (< *fn2-c-read-step-bytes* *fn2-c-read-callback-bytes*)
          (fn2-c-read-budget-kinds-p '(fn2-cursor fn2-txn fn2-auth fn2-cns fn2-sealer fn2-checkpoint-master) (w state))
          (equal (fn2-cost-value '(:cost fn2-read-next :bytes) (w state)) *fn2-c-read-step-bytes*)
          (equal (fn2-cost-value '(:cost fn2-read-scan-next :bytes) (w state)) *fn2-c-read-step-bytes*)
          (equal (fn2-cost-value '(:cost fn2-sealer-step :bytes) (w state)) *fn2-c-read-callback-bytes*)
          (equal (fn2-cost-value '(:cost fn2-checkpoint-root1-step-op :bytes) (w state)) *fn2-c-read-callback-bytes*))
  (value '(value-triple :actual-codec-work-and-kind-quanta))
  (er soft 'c-read-work-budget-unit "Actual C read costs or scheduler quanta lack their generated work bound.")))

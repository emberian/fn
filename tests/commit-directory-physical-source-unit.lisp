; Exact source getter controls. Journal construction/authentication are separate
; actual producers; these typed rows are explicit synthetic source premises.
(in-package "ACL2")
(include-book "../books/commit-directory")
(defun fn2-cdps-body (fn2-commit-root)
 (declare (xargs :stobjs fn2-commit-root :verify-guards nil))
 (b* ((fn2-commit-root (fn2-commit-root-init 8 fn2-commit-root))
      (fn2-commit-root (fn2-commit-root-put 0 (installed 5) (published 5) (proposed 5)))
      (fn2-commit-root (fn2-commit-root-put 5 (parent 4) (extent 2) (seal-ready 1)
         (physical-history 37) (physical-incarnation 41)))
      (typed (and (fn2-commit-rootp fn2-commit-root) (fn2-commit-root-wfp fn2-commit-root)))
      ((mv ok e h i) (fn2-commit-directory-physical-source 5 fn2-commit-root))
      (fn2-commit-root (fn2-commit-root-set-parent 5 3 fn2-commit-root))
      ((mv stale & & &) (fn2-commit-directory-physical-source 5 fn2-commit-root))
      (fn2-commit-root (fn2-commit-root-set-parent 5 4 fn2-commit-root))
      (fn2-commit-root (fn2-commit-root-set-physical-incarnation 5 0 fn2-commit-root))
      ((mv missing & & &) (fn2-commit-directory-physical-source 5 fn2-commit-root))
      (fn2-commit-root (fn2-commit-root-set-physical-incarnation 5 41 fn2-commit-root))
      (fn2-commit-root (fn2-commit-root-put 0 (base-batch 5) (base-ready 1)
         (physical-history 101) (physical-incarnation 103)))
      ((mv base & & &) (fn2-commit-directory-physical-source 5 fn2-commit-root)))
  (mv (and typed (eq ok :ok) (= e 2) (= h 37) (= i 41)
           (eq stale :stale) (eq missing :physical-source) (eq base :base)) fn2-commit-root)))
(defun fn2-cdps-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-commit-root
  (mv-let (answer fn2-commit-root) (fn2-cdps-body fn2-commit-root) answer)))
(assert-event (fn2-cdps-test))

; Evaluate the actual owner-run terminal conjunction, not a copied predicate.
(require :sb-posix)
(require :sb-bsd-sockets)
(defpackage "ACL2" (:use "COMMON-LISP"))
(defpackage "ACL2_*1*_ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(defstruct fnn-owner-service snapshot-jobs peer-flight-bank workers cold-head committer)
(defmacro fnn-with-roster ((service) &body body) (declare (ignore service)) `(progn ,@body))
(defvar *fnn-cold-workers* nil)
(defun fnn-cold-worker-thread (slot) slot)
(defun fnn-mux-drained-p (service) (declare (ignore service)) t)
(defun fnn-owner-syncer-drained-p (service) (declare (ignore service)) t)
(defun fnn-owner-output-drained-p (service) (declare (ignore service)) t)
(defun fnn-extent-executor-drained-p () t)
(defun fnn-peer-flight-bank-drained (bank) (not bank))
(defun terminal-conjunction (form)
 (when (consp form)
  (if (and (eq (car form) 'when)
           (member '(fnn-owner-feed-close-all service) (cddr form) :test #'equal))
      (second form)
    (loop for item in form thereis (terminal-conjunction item)))))
(defparameter *terminal* nil)
(with-open-file (in "host/native/owner.lisp")
 (loop for form = (read in nil :eof) until (eq form :eof)
  when (and (consp form) (eq (car form) 'defun)) do
   (case (second form)
    (fnn-owner-snapshot-jobs-drained-p (eval form))
    (fnn-owner-run (setf *terminal* (terminal-conjunction form))))))
(assert *terminal*)
; The conjunction must consume the actual snapshot observer and peer bank.
(assert (member '(fnn-owner-snapshot-jobs-drained-p service) *terminal* :test #'equal))
(assert (member '(fnn-peer-flight-bank-drained (fnn-owner-service-peer-flight-bank service)) *terminal* :test #'equal))
(setf (symbol-function 'terminal-joined-p)
 (eval `(lambda (service modules-joined) ,*terminal*)))
(let ((service (make-fnn-owner-service)))
 (assert (terminal-joined-p service t))
 (setf (fnn-owner-service-snapshot-jobs service) '(:released-but-not-joined))
 (assert (not (terminal-joined-p service t)))
 (setf (fnn-owner-service-snapshot-jobs service) '(:joined-pin-return-uncertain))
 (assert (not (terminal-joined-p service t)))
 (setf (fnn-owner-service-snapshot-jobs service) nil
       (fnn-owner-service-peer-flight-bank service) :bank-debt)
 (assert (not (terminal-joined-p service t)))
 (setf (fnn-owner-service-peer-flight-bank service) nil)
 (assert (terminal-joined-p service t))
 (assert (not (terminal-joined-p service nil))))
(format t "SOURCE OWNER TERMINAL COHORTS PASSED~%")

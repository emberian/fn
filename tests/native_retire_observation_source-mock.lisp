; SCN-1095: execute the actual operator function and actual ACL2 decisions in
; SBCL with clock, scheduling, owner and stat observations supplied explicitly.
; No saved-image or filesystem durability qualification is claimed here.
(require :sb-posix)
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(declaim (declaration xargs))
(defmacro defconst (name value) `(defparameter ,name ,value))
(defmacro include-book (&rest args) (declare (ignore args)) nil)
(defmacro local (&rest args) (declare (ignore args)) nil)
(defmacro defthm (&rest args) (declare (ignore args)) nil)
(defmacro in-theory (&rest args) (declare (ignore args)) nil)
(defun natp (n) (and (integerp n) (<= 0 n)))
(defun posp (n) (and (integerp n) (< 0 n)))
(defun nfix (n) (if (natp n) n 0))
(defun true-listp (xs) (or (null xs) (and (consp xs) (true-listp (cdr xs)))))
(defun len (xs) (if (consp xs) (1+ (len (cdr xs))) 0))
(defun member-equal (x xs) (member x xs :test #'equal))
(defun fn-record-string-octets (s) (map 'list #'char-code s))
(load "books/native-retire.lisp")

(defun source-forms (path names)
  (with-open-file (in path)
    (loop for form = (read in nil :eof) until (eq form :eof)
          when (and (consp form) (member (car form) '(defun defstruct))
                    (member (if (consp (second form)) (caadr form) (second form)) names))
          do (progn (eval form)
                    (setf names (remove (if (consp (second form)) (caadr form) (second form)) names))
                    (when (null names) (return)))
          finally (assert (null names)))))

(defparameter +fnn-exit-ok+ 0)
(defparameter +fnn-exit-refused+ 1)
(defparameter +fnn-exit-uncertain+ 3)
(defparameter *fnn-operator-live-owner* nil)
(defparameter *fnn-retire-pause* nil)
(defparameter *fnn-monotonic-ticks* nil)
(defparameter *fnn-stdout* nil)
(defparameter *report-identities* nil)
(defparameter *report-path* nil)
(defun fnn-retire-report-path (root) (declare (ignore root)) *report-path*)
(defun fnn-retire-report-identity (path)
  (declare (ignore path)) (pop *report-identities*))
(defun fnn-core (name &rest args)
  (case name
    (fn-native-operator-host-result-retire-control-path-octets '(47 99))
    (fn-native-operator-host-result-retire-argv (fn-nret-request-argv (first args)))
    (t (apply name args))))
(defun fnn-octet-list-p (xs) (and (true-listp xs) (every (lambda (x) (and (natp x) (< x 256))) xs)))
(defun fnn-octets (xs) (coerce xs '(vector (unsigned-byte 8))))
(defun fnn-octets-string (xs) (map 'string #'code-char xs))
(defun fnn-out (control &rest args) (apply #'format *fnn-stdout* control args))
(defun fnn-emit (out text) (write-string text out))
(define-condition fixture-fault (error) ())
(defun fnn-fault (control &rest args)
  (apply #'fnn-out control args) (error 'fixture-fault))

(source-forms (or (third sb-ext:*posix-argv*) "host/native/operator.lisp")
              '(fnn-operator-live-owner fnn-operator-execute-owner-request
                fnn-operator-execute-retire))
(source-forms "host/native/io.lisp" '(fnn-now))

(defun run-case (label observations seconds identities expected text)
  (let* ((offlinep (eq (first observations) :offline))
         (ticks 0) (polls 0) (requests 0) (observes 0)
         (*fnn-stdout* (make-string-output-stream))
         (*report-identities* (copy-list identities))
         (*fnn-monotonic-ticks* (lambda () ticks))
         (*fnn-retire-pause*
          (lambda (delay)
            (assert (= delay 1))
            (incf polls)
            (when (> polls 71) (error "unbounded retire observation"))
            (incf ticks (* delay internal-time-units-per-second))))
         (*fnn-operator-live-owner*
          (make-fnn-operator-live-owner
           :admin-observe (lambda (&rest args)
                            (declare (ignore args)) (incf observes)
                            (if (cdr observations) (pop observations) (car observations)))
           :request (lambda (&rest args) (declare (ignore args)) (incf requests) 0)
           :admin (lambda (&rest args) (declare (ignore args)) (values 1 nil)))))
    (assert (= (handler-case (fnn-operator-execute-retire seconds "/private-fixture")
                 (fixture-fault () 4)) expected))
    (let ((output (get-output-stream-string *fnn-stdout*)))
      (assert (search text output)))
    (assert (= requests (if offlinep 0 1)))
    (when (search "expiry" label)
      (assert (= ticks (* (+ seconds 60) internal-time-units-per-second)))
      (assert (equal *report-identities* (cdr identities))))
    (format t "~a elapsed=~d polls=~d observes=~d requests=~d~%"
            label (/ ticks internal-time-units-per-second) polls observes requests)))

(setf *report-path* (second sb-ext:*posix-argv*))
(run-case "live-expiry" '(:live) 0 '(nil (9 9)) 3 "observation-deadline")
(run-case "held-expiry" '(:live :held) 0 '(nil (9 9)) 3 "observation-deadline")
(run-case "drain-plus-allowance-expiry" '(:live) 10 '(nil (9 9)) 3 "observation-deadline")
(run-case "offline-refusal" '(:offline) 0 '(nil nil) 1 "not-running")
(run-case "fresh-report" '(:live :offline) 0 '(nil (9 9)) 0 "fixture-retire-report")
(run-case "stale-report" '(:live :offline) 0 '((9 9) (9 9)) 3 "no-report")
(run-case "stale-socket-fresh-report" '(:live :stale) 0 '(nil (9 9)) 0 "fixture-retire-report")
(run-case "unknown-observation" '(:live :unexpected) 0 '(nil (9 9)) 4 "invalid-observation")
(format t "SOURCE RETIRE OBSERVATION PASSED~%")

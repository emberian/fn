  (if *raw-escape* (throw 'pipeline-test-escape :escaped)
    (error "committer observation escaped")))

(dolist (final '(:done :uncertain :fault))
 (dolist (physical-first '(nil t))
  (dolist (raw-escape '(nil t))
   (let* ((s (funded-service)) (*result-final* final)
          (*physical-first* physical-first) (*raw-escape* raw-escape)
          (*child-started* (sb-thread:make-semaphore :count 0))
          (*child-release* (sb-thread:make-semaphore :count 0)) (*fences* 0)
          ;; SBCL does not inherit special bindings into a new thread.
          (*fnn-actor-thread-maker*
            (let ((final final) (started *child-started*) (release *child-release*))
              (lambda (thunk &rest args)
                (apply #'sb-thread:make-thread
                 (lambda ()
                   (let ((*result-final* final) (*child-started* started)
                         (*child-release* release)) (funcall thunk))) args)))))
     (check (eq :escaped
                (catch 'pipeline-test-escape
                  (handler-case (fnn-owner-commit-pipeline s)
                    (error (e)
                      (check (search "committer observation escaped" (princ-to-string e))
                             "fixture reaches intended post-launch escape") :escaped)))) "original pipeline escape propagates")
     (unless physical-first
       (check (fnn-owner-service-syncer-grants s) "live actor retains funding after parent escape")
       (sb-thread:signal-semaphore *child-release*)
       (fnn-owner-actor-join s (first (fnn-owner-service-workers s))))
     (check (null (fnn-owner-service-syncer-grants s))
            "escaped pipeline consumes actual operation after physical return")
     (check (= *fences* (if (eq final :uncertain) 1 0))
            "actual uncertainty fences; completed or fault result is not rewritten")))))
(format t "native_syncer_pipeline_escape_raw: PASS 12 post-launch escape schedules~%")

;; Once consumption begins it may mutate before escaping. Cleanup must not
;; retry either fn-oqw or its typed receipt; unresolved custody stays visible.
(defparameter *operation-core* (symbol-function 'fnn-core))
(defvar *consumption-calls* 0)
(defun fnn-core (subject &rest args)
  (if (eq subject 'fn-oqw-receipt)
      (progn (incf *consumption-calls*) (error "operation consumption torn"))
    (apply *operation-core* subject args)))
(defun fnn-owner-commit-wake (&rest args) (declare (ignore args)) :collect)
(defun fnn-owner-disk-event (service event &rest args)
  (declare (ignore service args))
  (when (eq event :issue)
    (wait-label *child-started*) (sb-thread:signal-semaphore *child-release*)))
(let* ((s (funded-service)) (*consumption-calls* 0)
       (*child-started* (sb-thread:make-semaphore :count 0))
       (*child-release* (sb-thread:make-semaphore :count 0))
       (*fnn-actor-thread-maker*
         (let ((started *child-started*) (release *child-release*))
           (lambda (thunk &rest args)
             (apply #'sb-thread:make-thread
              (lambda () (let ((*result-final* :done) (*child-started* started)
                               (*child-release* release)) (funcall thunk))) args)))))
  (handler-case (fnn-owner-commit-pipeline s) (error () nil))
  (check (= *consumption-calls* 1) "torn completion is attempted exactly once")
  (check (and (null (fnn-owner-service-actors s))
              (fnn-owner-service-syncer-grants s)
              (test-ledger-physical (fnn-owner-service-syncer-ledger s))
              (not (test-ledger-outcome (fnn-owner-service-syncer-ledger s))))
         "torn outcome retains custody despite definite physical termination"))
(format t "native_syncer_pipeline_escape_raw: PASS torn-consumption custody/no retry~%")

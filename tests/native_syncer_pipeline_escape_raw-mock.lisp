(defun fnn-owner-disk-event (service event &rest args)
  (declare (ignore args))
  (check (eq event :issue) "escape after successful syncer launch")
  (wait-label *child-started*)
  (when *physical-first*
    (sb-thread:signal-semaphore *child-release*)

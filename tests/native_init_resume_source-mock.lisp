(defun run-case (label groups profile expected &key (record #(3)) (history '("00000001.cfg" "00000002.cfg")) (config t) decision reason)
  (let* ((*effects* nil) (*output* nil) (*fixture-record* record) (*fault-text* nil)
         (*fixture-history* history) (*config-present* config) (*injected-decision* decision)
         (code (handler-case (fnn-command-init "/fixture" groups profile)
                 (fixture-refusal () 1) (fixture-fault () 4))))
    (assert (= code expected))
    ;; A named fault is ACL2's resume decision (fn-nir-resume-line), never
    ;; the namespace observation's generic one.
    (when reason (assert (search reason *fault-text*)))
    (if (zerop code)
        (progn (assert (member :genesis *effects*)) (assert (member :secret *effects*))
               (assert (search "initialized" *output*)))
      (progn (assert (null *effects*)) (assert (null *output*))))
    (format t "~a code=~d effects=~s~%" label code (reverse *effects*))))


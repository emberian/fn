;; The live-limits overlay observes the WHOLE history; like the real
;; observation (fnn-bridge-config-observation) it faults generically on a
;; record ACL2 cannot decode.
(defun fnn-load-config-overlay (store sealed)
  (declare (ignore sealed))
  (when (fixture-corrupt-record-p)
    (fnn-fault "ACL2 refused configuration namespace observation"))
  (setf (fnn-store-config store) :later-live-limit-overlay))

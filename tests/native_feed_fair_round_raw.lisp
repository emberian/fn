;;; Actual push adapter and kernel sockets; owner publication/peer outcomes
;;; recorded. This does not claim saved-image framing, durability or funding.
(load "tests/native_section_envelope_raw.lisp")
(in-package "ACL2")
(defun nfix (x) (if (and (integerp x) (>= x 0)) x 0))
(defun natp (x) (and (integerp x) (>= x 0)))
(defun posp (x) (and (integerp x) (> x 0)))
(defparameter *fn-feed-wire-input-max-chunk-octets* 512)
(defconstant +fnn-max-read+ 65536)
(load-deployed-forms "host/native/io.lisp"
 '((defmacro fnn-posix) (deftype fnn-octets) (defun fnn-make-octets) (defun fnn-octets)
   (defun fnn-octet-list) (defun fnn-string-octets) (defun fnn-octets-string)
   (defvar *fnn-read-syscall*) (defvar *fnn-write-syscall*)
   (defun fnn-eintr-p) (defun fnn-would-block-p) (defun fnn-socket-fd)
   (defun fnn-socket-shut) (defun fnn-set-nonblocking)
   (defun fnn-socket-read-now) (defun fnn-socket-write-now)
   (define-condition fnn-peer-dial-error)))
(define-condition fnn-tls-error (error) ())
(define-condition fnn-tls-handshake-error (fnn-tls-error) ())
(load-deployed-forms "host/native/owner.lisp"
 '((defvar *fnn-actors*) (defun fnn-actor-declare) (defmacro def-actor)))
(load-deployed-forms "host/owner-host.lisp"
 '((defconst *fn-owner-feed-send-quantum-octets*) (defconst *fn-owner-feed-send-quantum-seconds*)
   (defun fn-owner-feed-send-quantum)))
(with-open-file (stream "books/peer-round-driver.lisp")
  (loop for form = (read stream nil :eof) until (eq form :eof)
        when (and (consp form) (eq (car form) 'defun))
          do (load-deployed-forms "books/peer-round-driver.lisp" (list (list 'defun (cadr form))))))
(defun fnn-core (name &rest args) (apply (symbol-function name) args))
(load "host/native/feed-service.lisp")
(defun check (value message)
  (unless value (format t "~&FEED_FAIR_ASSERTION:~a~%" message) (error "~a" message)))
(defun pair ()
  (let ((listener (make-instance 'sb-bsd-sockets:inet-socket :type :stream :protocol :tcp))
        (client nil) (server nil))
    (unwind-protect
         (progn
           (sb-bsd-sockets:socket-bind listener #(127 0 0 1) 0)
           (sb-bsd-sockets:socket-listen listener 1)
           (multiple-value-bind (address port) (sb-bsd-sockets:socket-name listener)
             (setq client (make-instance 'sb-bsd-sockets:inet-socket :type :stream :protocol :tcp))
             (sb-bsd-sockets:socket-connect client address port))
           (setq server (sb-bsd-sockets:socket-accept listener))
           (fnn-set-nonblocking (fnn-socket-fd client)) (values client server))
      (sb-bsd-sockets:socket-close listener))))
(defun fair-fixture (mode)
  (multiple-value-bind (slow slow-reader) (pair)
    (multiple-value-bind (healthy healthy-reader) (pair)
      (let* ((slow-link (%make-fnn-feed-link :peer "slow" :peer-octets '(83) :socket slow :fd (fnn-socket-fd slow)))
             (good-link (%make-fnn-feed-link :peer "healthy" :peer-octets '(72) :socket healthy :fd (fnn-socket-fd healthy)))
             (runtime (%make-fnn-feed-runtime :service :recorded :links (list slow-link good-link)
                                             :lock (sb-thread:make-mutex) :limit 65536))
             (payload (fnn-octets (loop for i below 2000 collect (mod i 251))))
             (blocked nil) (polls 0) (clock 0))
        (unwind-protect
             (progn
               (setf (symbol-function 'fnn-feed-refresh-links) (lambda (runtime) (declare (ignore runtime)))
                     (symbol-function 'fnn-feed-commits-seen) (lambda (runtime) (declare (ignore runtime)) 0)
                     (symbol-function 'fnn-feed-idle-wait)
                     (lambda (runtime &rest args) (declare (ignore args))
                       (check (fnn-feed-runtime-stopping runtime)
                              "pending handshake/output must retain busy cadence"))
                     (symbol-function 'fnn-tls-close-channel) (lambda (&rest args) (declare (ignore args)))
                     (symbol-function 'fnn-tls-close-context) (lambda (&rest args) (declare (ignore args)))
                     (symbol-function 'fnn-feed-now)
                     (lambda ()
                       (incf clock)
                       (when (and (> clock 2) (null (fnn-feed-link-output good-link)))
                         (check (if (equal mode "write")
                                    (and blocked (eq (fnn-feed-link-output slow-link) blocked)
                                         (< (fnn-feed-link-output-offset slow-link) (length blocked)))
                                  (plusp polls)) "healthy output must drain while slow peer retains pending state")
                         (setf (fnn-feed-runtime-stopping runtime) t))
                       clock))
               (cond ((equal mode "write")
                      ;; Fill an actual kernel send queue without consuming it.
                      (let ((fill (fnn-octets (make-list 65536 :initial-element 90))))
                        (loop while (integerp (fnn-socket-write-now (fnn-feed-link-fd slow-link) fill 0 (length fill)))))
                      (fnn-feed-send slow-link (fnn-octets (make-list 65536 :initial-element 81)))
                      (setq blocked (fnn-feed-link-output slow-link)))
                     ((equal mode "connect")
                      (setf (fnn-feed-link-phase slow-link) :connect
                            (fnn-feed-link-deadline slow-link) 10000
                            (symbol-function 'fnn-connect-poll)
                            (lambda (socket) (declare (ignore socket)) (incf polls) :wait)))
                     (t
                      (setf (fnn-feed-link-phase slow-link) :tls
                            (fnn-feed-link-tls-channel slow-link) :pending-tls
                            (fnn-feed-link-tls-name slow-link) "slow"
                            (fnn-feed-link-deadline slow-link) 10000
                            (symbol-function 'fnn-tls-client-step)
                            (lambda (&rest args) (declare (ignore args)) (incf polls) :output))))
               (fnn-feed-send good-link payload)
               (fnn-feed-worker-loop runtime)
               (let ((received (fnn-make-octets 2000)) (used 0))
                 (loop while (< used 2000) do
                   (multiple-value-bind (part count) (sb-bsd-sockets:socket-receive healthy-reader (fnn-make-octets (- 2000 used)) (- 2000 used))
                     (check (plusp count) "healthy physical close must follow complete output")
                     (replace received part :start1 used :end2 count)
                     (incf used count)))
                 (check (equalp received payload) "healthy output bytes must be exact across yielded ranges"))
               (format t "~&FEED_FAIR_PASS ~a~%" mode))
          (dolist (socket (list slow slow-reader healthy healthy-reader))
            (ignore-errors (sb-bsd-sockets:socket-close socket))))))))
(defun retained-fixture ()
  (let* ((link (%make-fnn-feed-link :peer "tls" :fd 9 :tls-channel :recorded))
         (data (fnn-octets (make-list 1200 :initial-element 65)))
         (calls nil) (clock 100) (attempt 0))
    (setf (symbol-function 'fnn-feed-now) (lambda () clock)
          (symbol-function 'fnn-tls-write-now-range)
          (lambda (channel held offset end)
            (declare (ignore channel))
            (push (list held offset end) calls)
            (case (incf attempt) (1 :output) (2 100) (t (- end offset)))))
    (let ((*fn-owner-feed-send-quantum-octets* 600)) (fnn-feed-send link data))
    (let ((held (fnn-feed-link-output link)) (deadline (fnn-feed-link-deadline link)))
      (fnn-feed-write-step link 200) ; WANT: exact vector/range retained
      (fnn-feed-write-step link 300) ; short prefix, timer retained
      (check (and (eq (first (first calls)) held) (= (fnn-feed-link-output-offset link) 100)
                  (= (fnn-feed-link-output-end link) 512) (= (fnn-feed-link-deadline link) deadline))
             "TLS WANT/short prefix must retain exact range and progress deadline")
      (fnn-feed-write-step link 400) ; range ends512, next range ends600
      (check (= (fnn-feed-link-output-end link) 600) "physical range cannot cross original progress window")
      (fnn-feed-write-step link 500) ; old window drained, new timer
      (check (and (= (fnn-feed-link-output-offset link) 600)
                  (= (fnn-feed-link-deadline link) 10500)) "only complete progress window resets deadline")
      (loop while (fnn-feed-link-output link) do (fnn-feed-write-step link 600))
      (check (every (lambda (call) (eq (first call) held)) calls) "all retries retain exact output vector"))
    (format t "~&FEED_FAIR_PASS retained~%")))
(defun reply-fixture ()
  (let* ((link (%make-fnn-feed-link :peer "reply" :peer-octets '(82) :socket :recorded :fd 9))
         (runtime (%make-fnn-feed-runtime :service :recorded :links (list link)
                                         :lock (sb-thread:make-mutex) :limit 512))
         (words '(:mode :ready :send :need-input)) (inputs nil) (order nil) (dropped nil))
    (setf (symbol-function 'fnn-owner-transit-serialized)
          (lambda (service cid thunk) (declare (ignore service cid)) (funcall thunk))
          (symbol-function 'fnn-owner-feed-arena-step)
          (lambda (name peer input now) (declare (ignore name peer now))
            (push input inputs) (list (pop words) #(65 66)))
          (symbol-function 'fnn-owner-feed-word) #'first
          (symbol-function 'fnn-owner-feed-command) #'second
          (symbol-function 'fnn-owner-feed-flush)
          (lambda (&rest args) (declare (ignore args)) (push :flushed order))
          (symbol-function 'fnn-owner-feed-log) (lambda (&rest args) (declare (ignore args)))
          (symbol-function 'fnn-developer-selector) (lambda (&rest args) (declare (ignore args)) nil)
          (symbol-function 'fnn-feed-link-became-ready)
          (lambda (link) (setf (fnn-feed-link-ready link) t))
          (symbol-function 'fnn-socket-write-now)
          (lambda (fd held offset end) (declare (ignore fd held))
            (push :written order) (- end offset))
          (symbol-function 'fnn-feed-loss-backoff) (lambda (&rest args) (declare (ignore args)) 0)
          (symbol-function 'fnn-feed-drop-link)
          (lambda (runtime link now base cause) (declare (ignore runtime link now base)) (setq dropped cause))
          (symbol-function 'fnn-feed-now) (lambda () 0))
    (fnn-feed-consume runtime link #(50 48 48 13 10) t 0)
    (check (and (= (length words) 3) (fnn-feed-link-eof link) (null dropped))
           "coalesced EOF must retain one-event suffix before next peer turn")
    (fnn-feed-pump-link runtime link 0) ; write MODE before retained reply
    (fnn-feed-pump-link runtime link 0) ; one :ready reply
    (check (and (= (length words) 2) (null dropped)) "EOF cannot discard retained reply suffix")
    (fnn-feed-pump-link runtime link 0) ; durable :send, retained output
    (check (and (fnn-feed-link-output link) (eq (first order) :flushed))
           "FNFD publication must precede retained article output")
    (fnn-feed-pump-link runtime link 0) ; write article
    (fnn-feed-pump-link runtime link 0) ; :need-input permits EOF loss
    (check (and (eq dropped :eof) (null words)
                (equal (nreverse inputs) '((50 48 48 13 10) nil nil nil))
                (equal (nreverse order) '(:written :flushed :written)))
           "each retained reply consumed once before EOF loss")
    ;; Unknown stopping fault must escape, never become peer loss.
    (setf (fnn-feed-link-drain link) nil (fnn-feed-link-ready link) nil
          (symbol-function 'fnn-socket-read-now)
          (lambda (&rest args) (declare (ignore args)) (fnn-fault "recorded stopping read fault")))
    (check (handler-case (progn (fnn-feed-pump-link runtime link 0) nil)
             (fnn-store-fault () t)) "push stopping fault must escape peer loss handling")
    (format t "~&FEED_FAIR_PASS reply~%")))
(let ((mode (second sb-ext:*posix-argv*)))
  (cond ((equal mode "retained") (retained-fixture))
        ((equal mode "reply") (reply-fixture)) (t (fair-fixture mode))))

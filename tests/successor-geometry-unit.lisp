; Actual schema decoder footprint control, prepared source only, UNEXECUTED.
; The generic80-row dispatcher guard does not write80 rows. The real article
; decoder writes all13 fields, which the old12-row entry reservation overlaps.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/machines-c-successor")
(defun fn2-sg-body (fn2-fields fn2-pool fn2-succ-txns fn2-succ-slots)
 (declare (xargs :stobjs (fn2-fields fn2-pool fn2-succ-txns fn2-succ-slots) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init *fn2-idc-stride* fn2-fields))
      (fn2-succ-txns (fn2-succ-txns-init 1 fn2-succ-txns))
      (fn2-succ-slots (fn2-succ-slots-init *fn2-succ-slots* fn2-succ-slots))
      (fn2-pool (fn2-pool-init '((2 . 4096)) 1 100 fn2-pool))
      ((mv a source sgen fn2-pool) (fn2-pool-reserve 0 1 1 1 fn2-pool))
      ((mv b encoded egen fn2-pool) (fn2-pool-reserve 0 1 1 1 fn2-pool))
      ((mv filled fn2-pool) (fn2-run-zero 96 source sgen 0 1 1 1 fn2-pool))
      ((mv declared fn2-succ-txns fn2-succ-slots) (fn2-succ-put 0 0 2 :insert fn2-succ-txns fn2-succ-slots))
      ((mv argument fn2-succ-txns fn2-succ-slots fn2-fields)
       (fn2-succ-arg-octets 0 0 *fn2-article-entry-field-location-hashes* source sgen 64 32 1 1 1 0 fn2-succ-txns fn2-succ-slots fn2-fields))
      (base *fn2-idc-eb*)
      (nf (fn2-run-layout-fields 2 0))
      (fn2-fields (fn2-succ-zero-rows nf base fn2-fields))
      (fn2-fields (fn2-fields-put (+ base *fn2-article-entry-field-source*)
       (value 1) (ref-slot source) (ref-gen sgen) (ref-off 0) (ref-len 32)))
      (fn2-fields (fn2-fields-put (+ base *fn2-article-entry-field-stored-source*)
       (value 1) (ref-slot source) (ref-gen sgen) (ref-off 32) (ref-len 32)))
      (fn2-fields (fn2-fields-put (+ base *fn2-article-entry-field-location-hashes*)
       (ref-slot source) (ref-gen sgen) (ref-off 64) (ref-len 32)))
      ((mv ec end fn2-pool) (fn2-run-layout-encode 2 0 base encoded egen 0 1 1 1 fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-set-value *fn2-succ-raw* 777 fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-succ-block* 999 fn2-fields))
      ; This historical index is the counterexample's removed reservation.
      (fn2-fields (fn2-fields-set-value 12 555 fn2-fields))
      ((mv dc next fn2-fields) (fn2-run-layout-decode 2 0 0 encoded egen 0 end 1 1 1 fn2-fields fn2-pool)))
  (mv (and (eq a :ok) (eq b :ok) (eq filled :ok) (eq declared :ok) (eq argument :ok) (eq ec :ok) (eq dc :ok) (= next end)
       (= nf *fn2-article-entry-num-fields*) (<= nf *fn2-succ-fields-max*)
       (= (fn2-fields-ref-len *fn2-article-entry-field-location-hashes* fn2-fields) 32)
       (= (fn2-fields-ref-len (+ *fn2-succ-raw* *fn2-article-entry-field-location-hashes*) fn2-fields) 32)
       (= (fn2-fields-value *fn2-succ-raw* fn2-fields) 777)
       (= (fn2-fields-value *fn2-succ-block* fn2-fields) 999)
       (not (= (fn2-fields-value 12 fn2-fields) 555))
       (<= *fn2-idc-required-fields* *fn2-idc-stride*)
       (<= *fn2-succ-octets-max* *fn2-idc-scratch-bytes*)
       (= *fn2-succ-eval* (+ *fn2-succ-raw* *fn2-succ-fields-max*))
       (= *fn2-succ-res* (+ *fn2-succ-eval* *fn2-succ-fields-max*))
       (= *fn2-succ-fresh* (+ *fn2-succ-res* *fn2-succ-values-max*))
       (= *fn2-succ-block* (+ *fn2-succ-fresh* 1))) fn2-fields fn2-pool fn2-succ-txns fn2-succ-slots)))
(defun fn2-sg-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (ok fn2-fields)
   (with-local-stobj fn2-pool
    (mv-let (ok fn2-fields fn2-pool)
     (with-local-stobj fn2-succ-txns
      (mv-let (ok fn2-fields fn2-pool fn2-succ-txns)
       (with-local-stobj fn2-succ-slots
        (mv-let (ok fn2-fields fn2-pool fn2-succ-txns fn2-succ-slots)
         (fn2-sg-body fn2-fields fn2-pool fn2-succ-txns fn2-succ-slots)
         (mv ok fn2-fields fn2-pool fn2-succ-txns)))
       (mv ok fn2-fields fn2-pool)))
     (mv ok fn2-fields)))
   ok)))
(assert-event (fn2-sg-test))

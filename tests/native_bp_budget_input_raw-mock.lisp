;;; Actual bounded-file caller plus actual ACL2 octet parser definitions.
;;; No native saved image or filesystem symlink qualification claim.
(require :sb-posix)
(require :sb-bsd-sockets)
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defun len (xs) (length xs))
(with-open-file (stream "books/bp-node-budget-input.lisp")
 (loop for form = (read stream nil :eof) until (eq form :eof) do
  (when (and (consp form) (eq (car form) 'defun))
   ;; Only ACL2 declaration syntax is removed; the executed body is exact.
   (eval (append (subseq form 0 3)
                 (remove-if (lambda (x) (and (consp x) (eq (car x) 'declare)))
                            (cdddr form)))))))
(defvar *bytes* nil)
(defvar *present* nil)
(defvar *read-count* 0)
(defun fnn-join (a b) (concatenate 'string a "/" b))
(defun fnn-check-regular (path) (assert (equal path "/journal/bp-node-budgets")) *present*)
(defun fnn-read-regular-bounded (path bound)
 (assert (equal path "/journal/bp-node-budgets")) (assert (= bound 256))
 (incf *read-count*) *bytes*)
(defun fnn-octet-list (x) x)
(defun fnn-out (&rest x) (declare (ignore x)))
(defun fnn-refuse (&rest x) (declare (ignore x)) (throw 'refused :refused))
(defun fnn-core (name &rest args)
 (case name
  (fn-bpnb-read (apply #'fn-bpnb-read args))
  (fn-bpnp-configured-budgets
   (list :bpnp-budgets (or (first args) 5000) (or (second args) 3)))
  (otherwise (error "unexpected core ~s" name))))
(with-open-file (stream "host/native/bp-node.lisp")
 (loop for form = (read stream nil :eof)
       when (eq form :eof) do (error "budget caller missing")
       when (and (consp form) (eq (car form) 'defun) (eq (second form) 'fnn-bpnode-read-budgets))
       do (eval form) (return)))
(defun test-input (text present want)
 (let ((*present* present) (*bytes* (map 'list #'char-code text)) (*read-count* 0))
  (assert (equal (catch 'refused (fnn-bpnode-read-budgets "/journal")) want))
  (assert (= *read-count* (if present 1 0)))))
(test-input "" nil '(:bpnp-budgets 5000 3))
(test-input "owner-backoff 500" t '(:bpnp-budgets 500 3))
(test-input (format nil "retry-budget 7~%owner-backoff 5~%") t '(:bpnp-budgets 5 7))
(test-input (format nil "owner-backoff 5~%owner-backoff 9~%") t :refused)
(test-input (format nil "retry-budget 3~%retry-budget 3~%") t :refused)
(test-input "owner-backoff ٥" t :refused)
(test-input "unknown 5" t :refused)
(test-input "owner-backoff -1" t :refused)
(format t "PASS actual BP bounded-file caller/ACL2 parser: defaults, ASCII values, duplicate/Unicode/unknown/negative refusal.~%")

; Actual arm -> queued raw descriptor -> interleaving -> input/harvest protocol.
; Candidate/manifest subject is synthetic; no physical header-auth claim.
; Runnable but unexecuted under the source-only grant.
(in-package "ACL2")
(include-book "../books/executor")
(include-book "../books/event-archive-cold-read")

(defun fn2-eari-bindings (names)
 (declare (xargs :verify-guards nil))
 (if (atom names) nil
  (cons (list (car names) (list (intern-in-package-of-symbol
          (concatenate 'string "FN2-CORE-" (subseq (symbol-name (car names)) 4 nil)) 'fn2-core) 'fn2-core))
        (fn2-eari-bindings (cdr names)))))
(defmacro fn2-eari-view (children results form final)
 `(stobj-let ,(fn2-eari-bindings children) ,results ,form ,final))
(defun fn2-eari-setup (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (fn2-eari-view (fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool)
  (answer fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool)
  (b* ((fn2-pool (fn2-pool-init '((1 . 65536) (2 . 4096)) 1 100 fn2-pool))
       ((mv a page pg fn2-pool) (fn2-pool-reserve 0 1 2 3 fn2-pool))
       ((mv b scratch sg fn2-pool) (fn2-pool-reserve 1 1 2 3 fn2-pool))
      ((mv ar accumulator agen fn2-pool) (fn2-pool-reserve 1 1 2 3 fn2-pool))
       (c (fn2-b-event-archive-cursor-from-rows (fn2-run-loads-rows fn2-run-loads)))
       (fn2-checkpoints (fn2-checkpoints-put 0 (state *fn2-checkpoint-state-checked*) (anchor-mask 1) (builder-token 0)
        (checkpoint 9) (cut-commit 7) (cut-event 11) (history 123) (incarnation 456)))
       (fn2-checkpoint-refs (fn2-checkpoint-refs-put 3 (storage-domain 0) (physical-unit 16) (writer-epoch 2)
        (allocation 4) (page-kind *page-kind-manifest*) (encoded-length *fn2-format-page-size*)))
       (fn2-event-archive (fn2-event-archive-put 1 (phase *fn2-event-archive-phase-cold-manifest*) (origin *fn2-event-archive-origin-cold*)
        (candidate 0) (checkpoint 9) (cut-commit 7) (cut-event 11) (history 123) (incarnation 456)
        (owner-kind 1) (owner-slot 2) (owner-gen 3) (header-slot page) (header-gen pg) (accumulator-slot accumulator) (accumulator-gen agen) (header-unit 16) (header-epoch 2) (header-allocation 4)))
       (fn2-run-loads (fn2-run-loads-put c (phase *fn2-run-load-phase-read*) (lease-mode *fn2-run-load-lease-mode-candidate-borrowed*)
        (borrow-token 3) (kind 1) (owner 2) (generation 3) (windows 2) (page page) (page-gen pg) (scratch scratch) (scratch-gen sg)
        (source 0) (tag 0) (unit 32) (epoch 2) (allocation 5) (schema 10) (run 9) (level 0) (history 123) (incarnation 456) (hash-0 77)))
       (fn2-run-cursors (fn2-run-cursors-put c (phase *fn2-run-cursor-phase-miss*) (physical 1) (source-row 0) (catalog-tag 0)
        (unit 32) (epoch 2) (counter 5) (schema 10) (run 9) (level 0) (rb (* 128 (fn2-run-loads-checker c fn2-run-loads)))
        (okind 1) (oslot 2) (ogen 3) (hash-0 77))))
   (mv (and (eq a :ok) (eq b :ok) (eq ar :ok)) fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool))
  (mv answer fn2-core)))
(defun fn2-eari-issue (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (fn2-eari-view (fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool fn2-ops fn2-control)
  (answer op og fn2-event-archive fn2-pool fn2-ops fn2-control)
  (b* (((mv arm fn2-event-archive offset) (fn2-event-archive-cold-read-arm fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool))
       (c (fn2-b-event-archive-cursor-from-rows (fn2-run-loads-rows fn2-run-loads)))
       ((mv issue op og fn2-pool fn2-ops fn2-control)
        (fn2-issue-read-children offset (fn2-run-loads-scratch c fn2-run-loads) (fn2-run-loads-scratch-gen c fn2-run-loads) 4096 1 2 3 0 fn2-pool fn2-ops fn2-control)))
   (mv (and (eq arm :read) (eq issue :ok)
            (= (fn2-ops-storage-offset op fn2-ops) (fn2-event-archive-read-offset 1 fn2-event-archive)))
       op og fn2-event-archive fn2-pool fn2-ops fn2-control)) (mv answer op og fn2-core)))
(defun fn2-eari-mutate (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (fn2-eari-view (fn2-event-archive fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors)
  (fn2-event-archive fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors)
  (b* ((c (fn2-b-event-archive-cursor-from-rows (fn2-run-loads-rows fn2-run-loads)))
       (fn2-run-loads (cond ((eq mode :sector) (fn2-run-loads-set-sector c 1 fn2-run-loads))
                          ((eq mode :unit) (fn2-run-loads-set-unit c 48 fn2-run-loads))
                          ((eq mode :hash) (fn2-run-loads-set-hash-0 c 88 fn2-run-loads)) (t fn2-run-loads)))
       (fn2-run-cursors (cond ((eq mode :unit) (fn2-run-cursors-set-unit c 48 fn2-run-cursors))
                            ((eq mode :hash) (fn2-run-cursors-set-hash-0 c 88 fn2-run-cursors)) (t fn2-run-cursors)))
       (fn2-event-archive (if (eq mode :descriptor) (update-fn2-event-archive-descriptori 32 1 fn2-event-archive) fn2-event-archive))
       (fn2-event-archive (cond
        ((eq mode :accumulator-alias) (fn2-event-archive-set-accumulator-slot 1 (fn2-run-loads-scratch c fn2-run-loads) fn2-event-archive))
        ((eq mode :accumulator-generation) (fn2-event-archive-set-accumulator-gen 1 (+ 1 (fn2-event-archive-accumulator-gen 1 fn2-event-archive)) fn2-event-archive))
        (t fn2-event-archive)))
       (fn2-checkpoint-bytes (if (eq mode :descriptor) (fn2-checkpoint-bytes-set-value 0 1 fn2-checkpoint-bytes) fn2-checkpoint-bytes)))
   (mv fn2-event-archive fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors)) fn2-core))
(defun fn2-eari-fill (left at slot gen op og fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :ok fn2-pool)
  (mv-let (code fn2-pool) (fn2-pool-adapter-write slot gen op og at 0 fn2-pool)
   (if (eq code :ok) (fn2-eari-fill (- left 1) (+ at 1) slot gen op og fn2-pool) (mv code fn2-pool)))))
(defun fn2-eari-complete (op og fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv action kind & & slot gen off count & & & & & & &) (fn2-host-action op fn2-core))
      ((unless (and (eq action :ok) (= kind *fn2-action-read*) (= off 0) (= count 4096))) (mv nil fn2-core))
      ((mv copied fn2-core) (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
                             (fn2-eari-fill 4096 0 slot gen op og fn2-pool) (mv code fn2-core)))
      ((mv ack fn2-core) (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (code fn2-ops) (fn2-outbox-ack 1 fn2-ops) (mv code fn2-core)))
      (fn2-core (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (fn2-ops)
                 (fn2-post-result 0 op og *fn2-event-read-result* *fn2-outcome-done* *fn2-reason-none* 4096 0 0 fn2-ops) fn2-core))
      ((mv done actual actual-gen cell ev outcome reason count & & fn2-core) (fn2-harvest-one fn2-core)))
  (mv (and (eq copied :ok) (eq ack :ok) done (= actual op) (= actual-gen og) (= cell 0)
           (= ev *fn2-event-read-result*) (= outcome *fn2-outcome-done*) (= reason *fn2-reason-none*) (= count 4096)) fn2-core)))
(defun fn2-eari-current (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (fn2-eari-view (fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool)
  (answer) (fn2-event-archive-cold-read-current-p fn2-event-archive fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-run-loads fn2-run-cursors fn2-pool) answer))
(defun fn2-eari-body (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      ((mv setup fn2-core) (fn2-eari-setup fn2-core))
      ((mv issued op og fn2-core) (fn2-eari-issue fn2-core))
      (fn2-core (fn2-eari-mutate mode fn2-core))
      ((mv completed fn2-core) (fn2-eari-complete op og fn2-core)))
  (mv (and setup issued completed (if (eq mode :current) (fn2-eari-current fn2-core) (not (fn2-eari-current fn2-core)))) fn2-core)))
(defun fn2-eari-test (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (answer fn2-core) (fn2-eari-body mode fn2-core) answer)))
(assert-event (fn2-eari-test :current))
(assert-event (fn2-eari-test :sector))
(assert-event (fn2-eari-test :unit))
(assert-event (fn2-eari-test :hash))
(assert-event (fn2-eari-test :descriptor))

(assert-event (fn2-eari-test :accumulator-alias))
(assert-event (fn2-eari-test :accumulator-generation))

(make-event (value (cons 'progn (fn2-machine-stub-one-events 'fn2-echo (w state)))))
(make-event (value (cons 'progn (fn2-machine-observe-handlers 'fn2-machine-observe '(fn2-echo) (w state)))))
(make-event (value (cons 'progn (fn2-dc-forms (fn2-dc-todo '(fn2-echo-run fn2-machine-observe-fn2-echo) 'fn2-echo (w state) nil 64) 'fn2-echo))))
(make-event (value (fn2-dc-frame-check 'fn2-echo-run-stub 'fn2-echo-run 'fn2-echo (fn2-dispatch-frame-children 'fn2-echo (w state)) (w state))))
(make-event (value (fn2-dc-frame-check 'fn2-machine-observe-fn2-echo-stub 'fn2-machine-observe-fn2-echo 'fn2-echo (fn2-dispatch-frame-children 'fn2-echo (w state)) (w state))))
(make-event (value (fn2-dispatch-ops-pool-form 'fn2-machine-observe-fn2-echo-stub 'fn2-machine-observe-fn2-echo 'fn2-echo (fn2-dispatch-frame-children 'fn2-echo (w state)) (w state))))
(make-event (value (cons 'progn (fn2-ctf-dir-forms (fn2-ctf-postorder-new '(fn2-echo-run fn2-machine-observe-fn2-echo) (w state)) 'fn2-echo))))
(make-event (value (fn2-dc-frame-kids 'fn2-echo-run 4 '(id budget fn2-core) (fn2-dispatch-frame-children 'fn2-echo (w state)) 'fn2-echo "-DISPATCH-KIDS" (w state))))
(make-event (value (fn2-dc-frame-kids 'fn2-machine-observe-fn2-echo 1 '(id event outcome reason count aux0 aux1 fn2-core) (fn2-dispatch-frame-children 'fn2-echo (w state)) 'fn2-echo "-DISPATCH-KIDS" (w state))))
(defattach (fn2-echo-run-stub fn2-echo-run)
 (fn2-machine-observe-fn2-echo-stub fn2-machine-observe-fn2-echo)
 (fn2-echo-arm-charge-ok-p-stub fn2-echo-arm-charge-ok-p)
 (fn2-echo-arm-bound-stub fn2-echo-arm-bound)
 :hints (("Goal" :use fn2-echo-run-success-charge)))

; Removing residual safety admits the first countermodel. Removing effects
; admits the second even though its numeric and phase-charge claims hold.
(defun fn2-budget-core-overreport (id budget fn2-core)
 (declare (xargs :stobjs fn2-core :guard (and (fn2-core-wfp fn2-core)
   (fn2-machine-idp id fn2-core) (equal (fn2-machine-kind id fn2-core) *fn2-echo-kind*))) (ignore id))
 (mv 0 0 (+ 1 (nfix budget)) nil fn2-core))
(defun fn2-budget-core-underreport (id budget fn2-core)
 (declare (xargs :stobjs fn2-core :guard (and (fn2-core-wfp fn2-core)
   (fn2-machine-idp id fn2-core) (equal (fn2-machine-kind id fn2-core) *fn2-echo-kind*))))
 (mv-let (bytes steps descriptors runnable fn2-core) (fn2-echo-run id budget fn2-core)
  (declare (ignore bytes steps descriptors))
  (mv 0 1 0 runnable fn2-core)))
(defthm fn2-budget-core-underreport-quantities
 (fn2-run-quantitiesp (car (fn2-budget-core-underreport id budget fn2-core))
   (mv-nth 1 (fn2-budget-core-underreport id budget fn2-core))
   (mv-nth 2 (fn2-budget-core-underreport id budget fn2-core)) budget 4128)
 :hints (("Goal" :in-theory (enable fn2-budget-core-underreport fn2-run-quantitiesp))))
(defthm fn2-budget-echo-charge-admits-empty
 (implies (fn2-echo-arm-charge-ok-p phase bytes steps descriptors)
          (fn2-echo-arm-charge-ok-p phase 0 1 0))
 :hints (("Goal" :in-theory (enable fn2-echo-arm-charge-ok-p))))
(defthm fn2-budget-core-underreport-success-charge
 (implies (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
               (fn2-machine-idp id fn2-core) (equal (fn2-machine-kind id fn2-core) *fn2-echo-kind*)
               (fn2-core-success-p (mv-nth 4 (fn2-budget-core-underreport id budget fn2-core))))
          (fn2-echo-arm-charge-ok-p (fn2-machine-phase id fn2-core)
            (car (fn2-budget-core-underreport id budget fn2-core))
            (mv-nth 1 (fn2-budget-core-underreport id budget fn2-core))
            (mv-nth 2 (fn2-budget-core-underreport id budget fn2-core))))
 :hints (("Goal" :use (fn2-echo-run-success-charge
                 (:instance fn2-budget-echo-charge-admits-empty
                   (phase (fn2-machine-phase id fn2-core)) (bytes (car (fn2-echo-run id budget fn2-core)))
                   (steps (mv-nth 1 (fn2-echo-run id budget fn2-core)))
                   (descriptors (mv-nth 2 (fn2-echo-run id budget fn2-core)))))
   :in-theory (e/d (fn2-budget-core-underreport) (fn2-echo-arm-charge-ok-p fn2-core-success-p)))))
(defun fn2-budget-core-attack-run (underreport-p budget fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      (id (fn2-machine-global-id *fn2-echo-kind* 0 *fn2-profile-tiny*))
      (fn2-core (fn2-echo-put-core id (phase *fn2-echo-state-closing*) (cap-index 7) (cap-nonce 9)))
      (hyps (and (natp budget) (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
                 (fn2-machine-idp id fn2-core) (equal (fn2-machine-kind id fn2-core) *fn2-echo-kind*)))
      (phase (fn2-machine-phase id fn2-core))
      ((mv bytes steps descriptors ?runnable fn2-core)
       (if underreport-p (fn2-budget-core-underreport id budget fn2-core)
         (fn2-budget-core-overreport id budget fn2-core)))
      (queued (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (q) (fn2-ops-queued fn2-ops) q)))
  (mv (list hyps (fn2-run-quantitiesp bytes steps descriptors budget 4128)
            (fn2-run-effects-p descriptors 0 queued)
            (fn2-echo-arm-charge-ok-p phase bytes steps descriptors)
            queued descriptors) fn2-core)))
(defun fn2-budget-core-attack (underreport-p budget)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (answer fn2-core)
   (fn2-budget-core-attack-run underreport-p budget fn2-core) answer)))
(assert-event (equal (fn2-budget-core-attack nil 0) '(t nil nil t 0 1)))
(assert-event (equal (fn2-budget-core-attack t 1) '(t t nil t 1 0)))
(must-fail
 (defattach (fn2-echo-run-stub fn2-budget-core-overreport)
  (fn2-machine-observe-fn2-echo-stub fn2-machine-observe-fn2-echo)
  (fn2-echo-arm-charge-ok-p-stub fn2-echo-arm-charge-ok-p)
  (fn2-echo-arm-bound-stub fn2-echo-arm-bound)
  :hints (("Goal" :in-theory (enable fn2-budget-core-overreport)))))
(must-fail
 (defattach (fn2-echo-run-stub fn2-budget-core-underreport)
  (fn2-machine-observe-fn2-echo-stub fn2-machine-observe-fn2-echo)
  (fn2-echo-arm-charge-ok-p-stub fn2-echo-arm-charge-ok-p)
  (fn2-echo-arm-bound-stub fn2-echo-arm-bound)
  :hints (("Goal" :use (fn2-budget-core-underreport-quantities fn2-budget-core-underreport-success-charge)
                 :in-theory (enable fn2-budget-core-underreport)))))

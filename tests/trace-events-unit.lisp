; Independent whole-result FIFO projection of actual-order trace events.
(in-package "ACL2")
(include-book "../books/trace-events")
(include-book "../sim/check-work")
(defun fn2-teu-record (kind id principal position wake wake-principal runnable)
 (declare (xargs :verify-guards nil))
 (append (list kind id principal position 0 0 0 runnable wake wake-principal 0)
         '(0 0 0 0 0 0 0 0)))
(defconst *fn2-teu-start* (fn2-teu-record *fn2-trace-kind-machine-start* 7 0 0 *fn2-none* 0 0))
(defconst *fn2-teu-enqueue* (fn2-teu-record *fn2-trace-kind-enqueue* 10 1 0 *fn2-none* 0 0))
(defconst *fn2-teu-end* (fn2-teu-record *fn2-trace-kind-machine* 7 0 0 11 0 1))
(defconst *fn2-teu-calendar* '((:principal 0) (:principal 1) (:service 0)))
(defconst *fn2-teu-queues* '((0 7 8) (1 9)))
(defconst *fn2-teu-trace*
 (list *fn2-teu-start* *fn2-teu-enqueue* *fn2-teu-end*
       (fn2-teu-record *fn2-trace-kind-machine-start* 9 1 1 *fn2-none* 0 0)
       ; A completed enqueue of an already queued row is idempotent.
       (fn2-teu-record *fn2-trace-kind-enqueue* 8 0 0 *fn2-none* 0 0)
       (fn2-teu-record *fn2-trace-kind-machine* 9 1 1 *fn2-none* 0 0)
       (fn2-teu-record *fn2-trace-kind-service* *fn2-none* 0 2 12 1 0)))
(assert-event
 (and (fn2-trace-events-completep *fn2-teu-trace*)
      (equal (fn2-trace-replay *fn2-teu-trace* 0 *fn2-teu-calendar* 0 *fn2-teu-queues*)
             '(:ok 0 ((0 8 11 7) (1 10 12))))
      (equal (fn2-trace-replay (list *fn2-teu-enqueue*) 0 *fn2-teu-calendar* 0 *fn2-teu-queues*)
             '(:ok 0 ((0 7 8) (1 9 10))))
      (not (eq (car (fn2-trace-replay *fn2-teu-trace* 1 *fn2-teu-calendar* 0 *fn2-teu-queues*)) :ok))
      (not (eq (car (fn2-trace-replay nil 0 *fn2-teu-calendar* 0 '((0 7) (1 7)))) :ok))
      (not (eq (car (fn2-trace-replay nil 0 '((:principal bad)) 0 nil)) :ok))
      (not (fn2-trace-events-completep (list *fn2-teu-end*)))
      (not (fn2-trace-events-completep (list *fn2-teu-start*)))
      (not (fn2-trace-events-completep (list *fn2-teu-start* *fn2-teu-start* *fn2-teu-end*)))
      (not (fn2-trace-events-completep (list *fn2-teu-start* (update-nth 1 8 *fn2-teu-end*))))
      (not (fn2-trace-events-completep (list (update-nth 4 1 *fn2-teu-enqueue*))))
      (equal (fn2-check-work (list *fn2-teu-end*) 0 0 1 0 *fn2-profile-tiny*)
             '(:fail :work-incomplete-trace))))
; Hypothesis removals: omit the extra enqueue or reverse ordinary wake and
; self-tail. Both produce a different complete final queue result.
(assert-event
 (and (not (equal (fn2-trace-replay (list *fn2-teu-start* *fn2-teu-end*)
                                   0 *fn2-teu-calendar* 0 *fn2-teu-queues*)
                  '(:ok 1 ((0 8 11 7) (1 9 10)))))
      (not (equal '(:ok 1 ((0 8 7 11) (1 9 10)))
                  (fn2-trace-replay (list *fn2-teu-start* *fn2-teu-enqueue* *fn2-teu-end*)
                                    0 *fn2-teu-calendar* 0 *fn2-teu-queues*)))))
(defun fn2-teu-ring ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-trace
  (mv-let (answer fn2-trace)
   (let* ((fn2-trace (fn2-trace-init 1 t fn2-trace))
          (fn2-trace (fn2-trace-append *fn2-trace-kind-machine-start* 7 0 0 0 0 0 nil *fn2-none* 0 0 fn2-trace))
          (fn2-trace (fn2-trace-append *fn2-trace-kind-enqueue* 10 1 0 0 0 0 nil *fn2-none* 0 0 fn2-trace))
          (fn2-trace (fn2-trace-append *fn2-trace-kind-machine* 7 0 0 0 0 0 t 11 0 0 fn2-trace))
          (records (fn2-trace-records fn2-trace)) (lost (fn2-trace-lost fn2-trace)))
    (mv (and (equal lost 2) (equal (len records) 1)
             (not (fn2-trace-events-completep records))
             (equal (fn2-trace-replay records lost *fn2-teu-calendar* 0 *fn2-teu-queues*)
                    '(:fail :lost-or-calendar))) fn2-trace)) answer)))
(assert-event (fn2-teu-ring))

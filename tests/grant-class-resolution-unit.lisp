; The actual grant helper resolves the registered upload byte requests against
; this pool, sums aliases, and observes the pool's protected floor.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "core-child-assembly-access")
(include-book "../books/pool-credit")

(defun fn2-gcr-control ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (ok fn2-core)
   (b* ((profile *fn2-profile-concrete*)
        (fn2-core (fn2-core-init profile fn2-core))
        ((mv configured fn2-core)
         (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
           (fn2-pool-credit-configure '((1 0 79)) fn2-pool)
           (mv code fn2-core)))
        (declared (fn2-machine-partition-classes *fn2-upload-admission-ordinal*))
        (positive (fn2-machine-pool-has-p '(((:bytes 17440) . 1) (0 . 1)) fn2-core))
        (alias-refused (not (fn2-machine-pool-has-p
                             '(((:bytes 17440) . 1) ((:bytes 20000) . 1)) fn2-core)))
        (one-lease (fn2-machine-pool-has-p '(((:bytes 17440) . 1)) fn2-core))
        (protected (not (fn2-machine-pool-has-p '((1 . 2)) fn2-core)))
        (invalid (and (not (fn2-machine-pool-has-p '(((:bytes 65537) . 1)) fn2-core))
                      (not (fn2-machine-pool-has-p '(((:bytes bad) . 1)) fn2-core))
                      (not (fn2-machine-pool-has-p '((2 . 1)) fn2-core))))
        ((mv reserved slot gen fn2-core) (fn2-core-reserve 1 9 0 1 fn2-core))
        (exhausted (not (fn2-machine-pool-has-p '(((:bytes 17440) . 1)) fn2-core)))
        ((mv released fn2-core) (fn2-core-release slot gen 9 0 1 fn2-core)))
    (mv (and (fn2-core-profilep profile) (eq configured :ok)
             (equal (len declared) 2)
             (member-equal (cons (list :bytes *fn2-upload-header-workspace-bytes*) 1) declared)
             (member-equal (cons (list :bytes *fn2-upload-body-window-bytes*) 1) declared)
             positive alias-refused one-lease protected invalid
             (eq reserved :ok) exhausted (eq released :ok)
             (fn2-machine-pool-has-p '(((:bytes 17440) . 1)) fn2-core)
             (fn2-core-wfp fn2-core)) fn2-core))
   ok)))
(assert-event (fn2-gcr-control))

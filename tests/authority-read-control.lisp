; Served read authorization probe. This is a diagnostic, not a proof or a
; security assertion: inspect setup replies before interpreting the read.
(in-package "ACL2")
(include-book "authority-served")

(defun fn2-authority-read-control-run (allow-read)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (answer fn2-core)
      (b* ((m *fn2-as-mini-id*)
           (fn2-core (fn2-init-executor *fn2-as-append-profile* :echo nil fn2-core))
           ((mv & fn2-core)
            (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
              (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
           ((mv stream fn2-core) (fn2-as-group "dregg.fn.e1" fn2-core))
           ((unless (posp stream)) (mv (list :group stream) fn2-core))
           ((mv & create clients fn2-core)
            (fn2-as-round 0 (list (fn2-as-frame 'principal-create (list (fn2-as-o "mini")))) nil fn2-core))
           ((mv & grants clients fn2-core)
            (fn2-as-round 1 (list (fn2-as-set m *fn2-as-c* *fn2-as-own* 0 1 0 1)) clients fn2-core))
           (consume (car (fn2-as-set-grants grants 1)))
           ((unless (posp consume)) (mv (list :consume create grants) fn2-core))
           ((mv & append-grant clients fn2-core)
            (fn2-as-round 2 (list (fn2-as-set m *fn2-as-a* *fn2-as-st* stream 1 consume 2)) clients fn2-core))
           (append-id (car (fn2-as-set-grants append-grant 1)))
           ((unless (posp append-id)) (mv (list :append-grant append-grant) fn2-core))
           ; Both experiments publish a read grant row. Only ENABLED differs.
           ((mv & read-grant clients fn2-core)
            (fn2-as-round 3 (list (fn2-as-set m *fn2-as-r* *fn2-as-st* stream
                                            (if allow-read 1 0) append-id 3)) clients fn2-core))
           (read-id (car (fn2-as-set-grants read-grant 1)))
           ((unless (posp read-id)) (mv (list :read-grant read-grant) fn2-core))
           ((mv & input clients fn2-core)
            (fn2-as-round 4 (list (fn2-as-bind "mini") (fnc-register 1 1)
                                  (fn2-as-append 101 "<read@authority.invalid>" "read-control")) clients fn2-core))
           ((mv & rest) (fnca-unseal input))
           (setup (fnc-replies '(register append) rest))
           (cursor (fnc-reply-cursor 'register rest))
           ((unless (and (equal (caar setup) :accepted)
                         (equal (caadr setup) :accepted) cursor))
            (mv (list :input setup) fn2-core))
           ((mv status output & fn2-core)
            (fn2-as-round 5 (list (fn2-as-bind "mini") (fnc-read cursor 8)) clients fn2-core))
           ((mv & page) (fnca-unseal output)))
        (mv (list :allow-read allow-read :stream stream
                  :grants (list consume append-id read-id)
                  :setup setup :read (fnc-reply 'read page)
                  :end status (fn2-core-stop-reason fn2-core)) fn2-core))
      answer)))

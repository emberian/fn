; Served read authorization probe. This is a diagnostic, not a proof or a
; security assertion: inspect setup replies before interpreting the read.
(in-package "ACL2")
(include-book "authority-served")

(defun fn2-authority-item-control-run (fetch allow-consume allow-read)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (answer fn2-core)
      (b* ((m *fn2-as-mini-id*)
           (fn2-core (fn2-init-executor *fn2-as-append-profile* :echo nil fn2-core))
           ((mv & fn2-core)
            (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
              (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
           ((mv stream fn2-core) (fn2-as-group "dregg.fn.e1" fn2-core))
           ((unless (posp stream)) (mv (list :group stream) fn2-core))
           ((mv & create clients store fn2-core)
            (fn2-as-round-stored 0 (list (fn2-as-frame 'principal-create (list (fn2-as-o "mini")))) nil nil fn2-core))
           ((unless (equal create (fn2-as-accepted 'principal-create (list m))))
            (mv (list :create create) fn2-core))
           ((mv & grants clients store fn2-core)
            (fn2-as-round-stored 1 (list (fn2-as-set m *fn2-as-c* *fn2-as-own* 0 (if allow-consume 1 0) 0 1)) clients store fn2-core))
           (consume (car (fn2-as-set-grants grants 1)))
           ((unless (posp consume)) (mv (list :consume create grants) fn2-core))
           ((mv & append-grant clients store fn2-core)
            (fn2-as-round-stored 2 (list (fn2-as-set m *fn2-as-a* *fn2-as-st* stream 1 consume 2)) clients store fn2-core))
           (append-id (car (fn2-as-set-grants append-grant 1)))
           ((unless (posp append-id)) (mv (list :append-grant append-grant) fn2-core))
           ; Both experiments publish a read grant row. Only ENABLED differs.
           ((mv & read-grant clients store fn2-core)
            (fn2-as-round-stored 3 (list (fn2-as-set m *fn2-as-r* *fn2-as-st* stream
                                            (if allow-read 1 0) append-id 3)
                                  (fn2-as-get m *fn2-as-r* *fn2-as-st* stream)
                                  (fn2-as-get m *fn2-as-c* *fn2-as-own* 0)) clients store fn2-core))
           ((mv read-id read-head lookup) (fnca-set-reply read-grant))
           ((unless (and (posp read-id) (equal read-id read-head)
                         (equal lookup
                           (append
                             (fn2-as-reply 'grant-get :accepted nil (list 1 read-id)
                               (list read-id *fn2-as-owner-id* (if allow-read 1 0) append-id))
                             (fn2-as-reply 'grant-get :accepted nil (list 1 read-id)
                               (list consume *fn2-as-owner-id* (if allow-consume 1 0) 0))))))
            (mv (list :read-grant read-grant) fn2-core))
           ((mv & input clients store fn2-core)
            (fn2-as-round-stored 4 (append (list (fn2-as-bind "mini"))
                                    (if fetch nil (list (fnc-register 1 1)))
                                    (list (fn2-as-append 101 "<read@authority.invalid>" "read-control"))) clients store fn2-core))
           ((unless (equal (fnc-frame-extent input)
                           (fn2-as-accepted 'principal-bind (list m read-id))))
            (mv (list :input-bind input) fn2-core))
           ((mv & rest) (fnca-unseal input))
           (setup (fnc-replies (if fetch '(append) '(register append)) rest))
           (append-reply (if fetch (car setup) (cadr setup)))
           (position (car (nth 2 append-reply)))
           (cursor (and (not fetch) (fnc-reply-cursor 'register rest)))
           ((unless (and (equal (caar setup) :accepted)
                         (equal (car append-reply) :accepted) (posp position)
                         (or fetch cursor)))
            (mv (list :input setup) fn2-core))
           ((mv status output & store fn2-core)
            (fn2-as-round-stored 5 (list (fn2-as-bind "mini")
                                  (if fetch (fnc-fetch (fn2-as-o "<read@authority.invalid>") position)
                                    (fnc-read cursor 8))) clients store fn2-core))
           ((unless (equal (fnc-frame-extent output)
                           (fn2-as-accepted 'principal-bind (list m read-id))))
            (mv (list :read-bind output) fn2-core))
           ((mv & page) (fnca-unseal output)))
        (mv (list :fetch fetch :allow-consume allow-consume :allow-read allow-read :stream stream
                  :grants (list consume append-id read-id)
                  :read-enabled (if allow-read 1 0)
                  :device-written (consp store)
                  :core-domain (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core))
                  :setup setup :reply (fnc-reply (if fetch 'fetch 'read) page)
                  :end status (fn2-core-stop-reason fn2-core)) fn2-core))
      answer)))

; Invoke the read pair with consume allowed; invoke the fetch quartet to
; distinguish both omitted admission rights. No result is asserted until run.
(defun fn2-authority-read-control-run (allow-read)
  (declare (xargs :verify-guards nil))
  (fn2-authority-item-control-run nil t allow-read))
(defun fn2-authority-fetch-control-run (allow-consume allow-read)
  (declare (xargs :verify-guards nil))
  (fn2-authority-item-control-run t allow-consume allow-read))

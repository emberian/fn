; Actual generated served publish arm, without simulator or new runtime arms.
; IO/installed flags are explicit logical persisted fixture premises.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/assembly-callbacks-r2")
(include-book "../sim/commit-test-profile")
(include-book "retirement-state-projections")
(make-event
 (cons 'progn (fn2-riud-projection-events
  '(fn2-extents fn2-retirement-control fn2-alloc-edges fn2-commit-member
    fn2-commit-settled fn2-commit-root fn2-pool fn2-fields fn2-ops fn2-id-engine)
  (w state))))
; Use the actual registered arm budget rather than a fixture-owned horizon.
(make-event
 (value `(defconst *fn2-riup-budget*
           ,(nfix (fn2-arm-get :steps (fn2-machine-property 'fn2-commit :budget (w state)))))))
; This frame includes RETIREMENT-CONTROL, not global execution CONTROL.
; The arm must change global stop/stop-reason; those are checked separately.
(defun fn2-riup-source (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
             (fn2-retirement-control (fn2-core-retirement-control fn2-core))
             (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))
             (fn2-commit-member (fn2-core-commit-members fn2-core))
             (fn2-commit-settled (fn2-core-commit-settled fn2-core))
             (fn2-commit-root (fn2-core-commit-root fn2-core))
             (fn2-pool (fn2-core-pool fn2-core))
             (fn2-fields (fn2-core-fields fn2-core))
             (fn2-ops (fn2-core-ops fn2-core))
             (fn2-id-engine (fn2-core-id-engine fn2-core))) (source)
  (list (fn2-extents-copy fn2-extents)
        (fn2-retirement-control-copy fn2-retirement-control)
        (fn2-alloc-edges-copy fn2-alloc-edges)
        (fn2-commit-member-copy fn2-commit-member)
        (fn2-commit-settled-copy fn2-commit-settled)
        (fn2-commit-root-copy fn2-commit-root)
        (fn2-pool-copy fn2-pool) (fn2-fields-copy fn2-fields)
        (fn2-ops-copy fn2-ops) (fn2-id-engine-copy fn2-id-engine)) source))
(defun fn2-riup-body (bad fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init (fn2-b-test-profile *fn2-profile-tiny* 0) fn2-core))
      (owner (fn2-machine-kind-base *fn2-scribe-kind* fn2-core))
      (ogen (fn2-machine-generation owner fn2-core))
      ((mv reserved target epoch allocation fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)))
        (ok target epoch allocation fn2-extents)
        (b* (((mv begun fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
             ((mv held & target epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
             ((mv committed fn2-extents) (fn2-alloc-commit-allocation target epoch allocation 1 100 fn2-extents)))
         (mv (and (eq begun :ok) (eq held :ok) (eq committed :ok)) target epoch allocation fn2-extents))
        (mv ok target epoch allocation fn2-core)))
      ((mv protected fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                   (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
        (code fn2-extents fn2-alloc-edges)
        (fn2-alloc-edge-add 0 50 target epoch allocation :obligation fn2-extents fn2-alloc-edges)
        (mv code fn2-core)))
      ((mv submitted batch event fn2-core)
       (fn2-retirement-submit target epoch allocation *fn2-scribe-kind* owner ogen fn2-core))
      ((mv pick id &) (fn2-commit-pick fn2-core))
      ((unless (and reserved (eq protected :ok) (eq submitted :ok) (eq pick :join)
                     (fn2-commit-idp id fn2-core) (posp batch) (posp event)
                     (= (fn2-machine-member-count id fn2-core) 1)
                     (= (fn2-machine-batch-no id fn2-core) batch)
                     (= (fn2-machine-first-key id fn2-core) event)
                     (eq (fn2-commit-partner-state batch (fn2-machine-partner id fn2-core) fn2-core) :ok)))
       (mv nil fn2-core))
      (row (* *fn2-commit-members-per-batch* (fn2-commit-row id fn2-core)))
      (base (* 128 (fn2-commit-row id fn2-core)))
      ((mv found kind slot gen len okind oslot actual-ogen) (fn2-commit-member-ws row fn2-core))
      ((unless (and found (= kind *fn2-commit-member-kind-txn*) (posp len)
                     (= okind *fn2-scribe-kind*) (= oslot owner) (= actual-ogen ogen)))
       (mv nil fn2-core))
      ((mv framed rkind bytes next fn2-core)
       (fn2-commit-txn-frame base slot gen 0 len okind oslot actual-ogen fn2-core))
      ((unless (and (eq framed :ok) (= rkind *record-kind-retirement*)
                     (posp bytes) (< 0 next) (= (+ next bytes) len)))
       (mv nil fn2-core))
      ; The persisted envelope is logical fixture state, not a simulated or
      ; physical write/fence receipt. Only the cursor/count is malformed.
      (fn2-core (fn2-commit-put-core id (phase *fn2-commit-state-publish*)
                 (cb-deps-ok 1) (cb-log-ok 1) (cb-fence-ok 1) (cb-failed 0)
                 (cb-published 0) (cb-acks 0) (cb-life-member 0) (cb-life-off 0)))
      (fn2-core (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (fn2-commit-root)
                  (fn2-commit-root-set-installed 0 batch fn2-commit-root) fn2-core))
      (fn2-core
       (case bad
        (:count-over (fn2-commit-put-core id (member-count (+ 1 *fn2-commit-members-per-batch*))))
        (:partition-cross (fn2-commit-put-core id (member-count (+ 1 *fn2-commit-members-per-batch*))
                            (cb-life-member *fn2-commit-members-per-batch*)))
        (:member-over (fn2-commit-put-core id (cb-life-member (+ 1 (fn2-machine-member-count id fn2-core)))))
        (:terminal-off (fn2-commit-put-core id (cb-life-member (fn2-machine-member-count id fn2-core)) (cb-life-off 1)))
        (otherwise fn2-core)))
      (count (fn2-machine-member-count id fn2-core))
      (member (fn2-machine-cb-life-member id fn2-core))
      (off (fn2-machine-cb-life-off id fn2-core))
      (bound-source (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                                (fn2-retirement-control (fn2-core-retirement-control fn2-core))
                                (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (bound)
        (and (eq (fn2-alloc-handle-code target epoch allocation fn2-extents) :ok)
             (= (fn2-extents-state target fn2-extents) *fn2-extent-state-allocated*)
             (= (fn2-extents-obligation target fn2-extents) 1)
             (fn2-alloc-edge-matchesp 0 50 target epoch allocation :obligation fn2-alloc-edges)
             (fn2-alloc-retirement-intentp target epoch allocation fn2-extents)
             (= (fn2-alloc-retirement-intent-batch fn2-extents) batch)
             (= (fn2-retirement-control-state 0 fn2-retirement-control) *fn2-retirement-state-waiting*)
             (= (fn2-retirement-control-batch 0 fn2-retirement-control) batch)
             (= (fn2-retirement-control-event 0 fn2-retirement-control) event)
             (= (fn2-retirement-control-slot 0 fn2-retirement-control) slot)
             (= (fn2-retirement-control-gen 0 fn2-retirement-control) gen)) bound))
      ((unless (and (posp *fn2-riup-budget*) bound-source (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))
                     (not (fn2-commit-lifecycle-cursorp count member off))))
       (mv nil fn2-core))
      (before (fn2-riup-source fn2-core))
      ((mv & & descriptors & fn2-core) (fn2-commit-run-publish id *fn2-riup-budget* fn2-core))
      (after (fn2-riup-source fn2-core)))
  (mv (and (fn2-core-wfp fn2-core) (fn2-core-stopped-p fn2-core)
           (= (fn2-core-stop-reason fn2-core) *fn2-stop-reason-commit-publish*)
           (= descriptors 0) (equal before after)
           (= (fn2-machine-phase id fn2-core) *fn2-commit-state-publish*)
           (= (fn2-machine-cb-published id fn2-core) 0) (= (fn2-machine-cb-acks id fn2-core) 0)
           (= (fn2-machine-member-count id fn2-core) count)
           (= (fn2-machine-cb-life-member id fn2-core) member)
           (= (fn2-machine-cb-life-off id fn2-core) off)) fn2-core)))
(defun fn2-riup-run (bad)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-riup-body bad fn2-core) ok)))
(assert-event (fn2-riup-run :count-over))
(assert-event (fn2-riup-run :partition-cross))
(assert-event (fn2-riup-run :member-over))
(assert-event (fn2-riup-run :terminal-off))

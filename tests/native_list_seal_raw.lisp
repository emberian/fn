;;; Actual list/buffer seal adapters: calls use a concrete mutable byte buffer.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(deftype fnn-octets () '(simple-array (unsigned-byte 8) (*)))
(defun source-function (path name)
  (with-open-file (stream path)
    (let* ((text (make-string (file-length stream)))
           (prefix (format nil "(defun ~a " name)))
      (read-sequence text stream)
      (let ((start (search prefix text)))
        (unless start (error "missing source function ~a" name))
        (read-from-string text nil nil :start start)))))
(defvar *fnn-staged-handle* nil)
(defvar *buffer* (vector (make-array 0 :element-type '(unsigned-byte 8)) 0))
(defvar *count* 0)
(defvar *staged* nil)
(defvar *calls* nil)
(defstruct fnn-log members inflight extent-path path extent-file)
(defun fnn-extent-register (path) (declare (ignore path)) 7)
(defun fnn-core (name &rest args)
  ;; Place decoding is the admitted logical seam; this fixture checks the
  ;; actual physical member routing without asserting a codec proof.
  (case name
    (fn-arx-list-places (loop repeat (third args) collect '(0 64 8 3 99)))
    (fn-arx-attach-trailers (first args))
    (otherwise (error "unexpected member call ~a" name))))
(defun fnn-live-octets () *buffer*)
(defun fnn-live-arena () :arena)
(defun fn-octets$c-reserve (n st)
  (when (< (length (svref st 0)) n)
    (setf (svref st 0) (make-array n :element-type '(unsigned-byte 8)))))
(defun fnn-call (name &rest args)
  (push name *calls*)
  (case name
    (fn-arena-count (assert (equal args '(:arena))) (list *count*))
    (fn-arena-seal-buffer
     (assert (eq (first args) *buffer*))
     (assert (eq (second args) :arena))
     (push (subseq (svref *buffer* 0) 0 (svref *buffer* 1)) *staged*)
     (incf *count*) (list :arena))
    (fn-arena-seal-list (error "list seal creates permanent resident payload"))
    (otherwise (error "unexpected arena call ~a" name))))
(let ((source (or (sb-ext:posix-getenv "FN_SEAL_HOST_SOURCE") "host/native/io.lisp")))
  (dolist (name '("fnn-octets-fill" "fnn-seal-live-buffer" "fnn-seal-octets" "fnn-log-members-in-flight"))
    (eval (source-function source name))))
(dolist (payload '((0 255 13 10) nil (77)))
  (let ((expected *count*))
    (assert (eq (fnn-seal-octets payload) t))
    (assert (eql *fnn-staged-handle* expected))
    (assert (equalp (first *staged*) (coerce payload 'vector)))
    (assert (= *count* (1+ expected)))
    (let ((log (make-fnn-log :members (list (cons *fnn-staged-handle* payload))
                            :path "/segment")))
      (fnn-log-members-in-flight log '(1 2 3) 0 64)
      (assert (null (fnn-log-members log)))
      (assert (equal (first (fnn-log-inflight log))
                     (list expected 7 '(0 64 8 3 99) payload))))))
(assert (equal (reverse *calls*)
               '(fn-arena-count fn-arena-seal-buffer
                 fn-arena-count fn-arena-seal-buffer
                 fn-arena-count fn-arena-seal-buffer)))
(format t "list seal uses releasable stage and ACL2-derived handle (3 payloads)~%")

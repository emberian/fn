; UNEXECUTED actual resident-start reuse control. The initial physical tuple
; is synthetic metadata, not source authority or an I/O/durability witness.
(in-package "ACL2")
(include-book "../books/runs")
(defun fn2-rbc-zero-words (i fn2-run-cursors)
 (declare (xargs :stobjs fn2-run-cursors :verify-guards nil :measure (nfix (- 8 (nfix i)))))
 (and (natp i)
      (or (>= i 8)
          (and (equal (fn2-run-cursor-hash-word 0 i fn2-run-cursors) 0)
               (fn2-rbc-zero-words (+ i 1) fn2-run-cursors)))))
(defun fn2-rbc-body (fn2-run-cursors)
 (declare (xargs :stobjs fn2-run-cursors :verify-guards nil))
 (b* ((fn2-run-cursors (fn2-run-cursors-init 1 fn2-run-cursors))
      (fn2-run-cursors (fn2-run-cursors-put 0 (phase *fn2-run-cursor-phase-miss*)
       (physical 1) (source-row 23) (catalog-tag 17) (epoch 5) (run 12) (resume-child 1)
       (hash-0 11) (hash-1 22) (hash-2 33) (hash-3 44) (hash-4 55) (hash-5 66) (hash-6 77) (hash-7 88)))
      ((mv code fn2-run-cursors) (fn2-run-cursor-start 0 3 0 4 1 16 7 0 9 0 1 fn2-run-cursors)))
  (mv (and (eq code :ok) (equal (fn2-run-cursors-phase 0 fn2-run-cursors) *fn2-run-cursor-phase-header*)
           (equal (fn2-run-cursors-physical 0 fn2-run-cursors) 0)
           (equal (fn2-run-cursors-source-row 0 fn2-run-cursors) *fn2-none*)
           (equal (fn2-run-cursors-catalog-tag 0 fn2-run-cursors) 0)
           (equal (fn2-run-cursors-epoch 0 fn2-run-cursors) 0)
           (equal (fn2-run-cursors-run 0 fn2-run-cursors) 0)
           (equal (fn2-run-cursors-resume-child 0 fn2-run-cursors) 0)
           (fn2-rbc-zero-words 0 fn2-run-cursors)
           (equal (list (fn2-run-cursors-schema 0 fn2-run-cursors) (fn2-run-cursors-level 0 fn2-run-cursors)
                        (fn2-run-cursors-slot 0 fn2-run-cursors) (fn2-run-cursors-gen 0 fn2-run-cursors)
                        (fn2-run-cursors-unit 0 fn2-run-cursors) (fn2-run-cursors-counter 0 fn2-run-cursors)
                        (fn2-run-cursors-okind 0 fn2-run-cursors) (fn2-run-cursors-oslot 0 fn2-run-cursors)
                        (fn2-run-cursors-ogen 0 fn2-run-cursors)) '(3 0 4 1 16 7 9 0 1))) fn2-run-cursors)))
(defun fn2-rbc-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-run-cursors
  (mv-let (answer fn2-run-cursors) (fn2-rbc-body fn2-run-cursors) answer)))
(assert-event (fn2-rbc-test))

(in-package "ACL2")
(include-book "../books/pool-release-admission")
(include-book "std/util/bstar" :dir :system)

; Fill a class with two real workspace reservations. The second release
; needs the accounting invariant preserved by the first release.
(defun fn2-release-admission-pair (retire fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (b* ((fn2-pool (fn2-pool-init '((2 . 8)) 1 (if retire 1 5) fn2-pool))
       ((mv c0 s0 g0 fn2-pool) (fn2-pool-reserve 0 1 10 1 fn2-pool))
       ((mv c1 s1 g1 fn2-pool) (fn2-pool-reserve 0 1 11 1 fn2-pool))
       ((mv written fn2-pool) (fn2-pool-write s1 g1 0 99 1 11 1 fn2-pool))
       (sibling (fn2-pool-row-snapshot s1 fn2-pool))
       (h0 (and (eq c0 :ok) (eq c1 :ok) (eq written :ok) (not (equal s0 s1))
                (fn2-pool-semanticp fn2-pool)
                (fn2-pool-logical-slotp s0 fn2-pool)
                (equal (fn2-pool-state s0 fn2-pool) *fn2-pool-state-workspace*)))
       (c0 (fn2-pool-release-countp s0 fn2-pool))
       ((mv r0 fn2-pool) (fn2-pool-release s0 g0 1 10 1 fn2-pool))
       ((mv read-code byte) (fn2-pool-read s1 g1 0 1 11 1 fn2-pool))
       (h1 (and (equal sibling (fn2-pool-row-snapshot s1 fn2-pool))
                (eq read-code :ok) (equal byte 99) (fn2-pool-semanticp fn2-pool)
                (fn2-pool-logical-slotp s1 fn2-pool)
                (equal (fn2-pool-state s1 fn2-pool) *fn2-pool-state-workspace*)))
       (c1 (fn2-pool-release-countp s1 fn2-pool))
       ((mv r1 fn2-pool) (fn2-pool-release s1 g1 1 11 1 fn2-pool)))
    (mv (and h0 c0 h1 c1
             (eq r0 (if retire :retired :ok)) (eq r1 r0)
             (fn2-pool-semanticp fn2-pool)
             (equal (fn2-pool-retired-count fn2-pool) (if retire 2 0))
             (equal (fn2-pool-class-countsi 0 fn2-pool) (if retire 0 2))) fn2-pool)))

; A typed but false count breaks accounting and falsifies the guard. All
; remaining hypotheses of semantic-workspace-admits-release still hold.
(defun fn2-release-admission-without-accounting (fn2-pool)
  (declare (xargs :stobjs fn2-pool :verify-guards nil))
  (b* ((fn2-pool (fn2-pool-init '((2 . 8)) 1 5 fn2-pool))
       ((mv code slot & fn2-pool) (fn2-pool-reserve 0 1 10 1 fn2-pool))
       (healthy (fn2-pool-semanticp fn2-pool))
       (fn2-pool (update-fn2-pool-class-countsi 0 2 fn2-pool)))
    (mv (and (eq code :ok) healthy (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool)
             (fn2-pool-logical-slotp slot fn2-pool)
             (equal (fn2-pool-state slot fn2-pool) *fn2-pool-state-workspace*)
             (not (fn2-pool-semanticp fn2-pool))
             (not (fn2-pool-release-countp slot fn2-pool))) fn2-pool)))
(defun fn2-release-admission-controls ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-pool
    (mv-let (ok fn2-pool)
      (b* (((mv ordinary fn2-pool) (fn2-release-admission-pair nil fn2-pool))
           ((mv retirement fn2-pool) (fn2-release-admission-pair t fn2-pool))
           ((mv removal fn2-pool) (fn2-release-admission-without-accounting fn2-pool)))
        (mv (and ordinary retirement removal) fn2-pool)) ok)))
(assert-event (fn2-release-admission-controls))

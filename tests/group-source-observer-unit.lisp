; UNEXECUTED direct public lookup controls. The writer's actual HELD-cut
; authority is an explicit SYNTHETIC premise for the lower writer leaf;
; no EXCLUSIVE/H-complete state is seeded. Core initialization, genesis,
; lookups, receipt acquire/release and writer pending/poll are actual calls.
(in-package "ACL2")
(include-book "../books/assembly-callbacks-c")
(defconst *fn2-gobs-profile*
 (put-assoc-equal :groups '(("alt.test" . 9))
  (put-assoc-equal :identity-arena-bytes 4096
   (put-assoc-equal :pool-classes '((8 . 64) (8 . 256) (16 . 4096)) *fn2-profile-tiny*))))
; Enumerate ALL rows through the generator's concrete row-snapshot accessor,
; rather than a hand-maintained subset of source columns.
(defmacro fn2-gobs-table-snapshot (name child)
 `(defun ,name (i ,child)
   (declare (xargs :stobjs ,child :verify-guards nil
    :measure (nfix (- (nfix (,(fn2-columns-sym child "-ROWS") ,child)) (nfix i)))))
   (if (>= (nfix i) (nfix (,(fn2-columns-sym child "-ROWS") ,child))) nil
    (cons (,(fn2-columns-sym child "-ROW-SNAPSHOT") (nfix i) ,child) (,name (+ 1 (nfix i)) ,child)))))
(fn2-gobs-table-snapshot fn2-gobs-overlays fn2-overlays)
(fn2-gobs-table-snapshot fn2-gobs-index fn2-overlay-index)
(fn2-gobs-table-snapshot fn2-gobs-installed fn2-run-installed)
(fn2-gobs-table-snapshot fn2-gobs-cache fn2-run-cache)
(fn2-gobs-table-snapshot fn2-gobs-pool-rows fn2-pool)
(fn2-gobs-table-snapshot fn2-gobs-engine fn2-id-engine)
(defun fn2-gobs-pool-bytes (i fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- (fn2-pool-data-length fn2-pool) (nfix i)))))
 (if (>= (nfix i) (fn2-pool-data-length fn2-pool)) nil
  (cons (fn2-pool-datai (nfix i) fn2-pool) (fn2-gobs-pool-bytes (+ 1 (nfix i)) fn2-pool))))
(defun fn2-gobs-whole-h (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-overlays (fn2-core-overlays fn2-core)) (fn2-overlay-index (fn2-core-overlay-index fn2-core))
             (fn2-run-installed (fn2-core-run-installed fn2-core)) (fn2-run-cache (fn2-core-run-cache fn2-core))
             (fn2-pool (fn2-core-pool fn2-core)) (fn2-id-engine (fn2-core-id-engine fn2-core))) (snapshot)
  (list (fn2-gobs-overlays 0 fn2-overlays) (fn2-gobs-index 0 fn2-overlay-index)
        (fn2-gobs-installed 0 fn2-run-installed) (fn2-gobs-cache 0 fn2-run-cache)
        (fn2-gobs-engine 0 fn2-id-engine) (fn2-gobs-pool-rows 0 fn2-pool) (fn2-gobs-pool-bytes 0 fn2-pool)) snapshot))
(defun fn2-gobs-write (bytes slot gen off fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (len bytes)))
 (if (atom bytes) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen off (car bytes) 5 1 1 fn2-core)
   (if (eq code :ok) (fn2-gobs-write (cdr bytes) slot gen (+ 1 off) fn2-core) (mv code fn2-core)))))
(defun fn2-gobs-receipt (tx fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (receipt)
  (fn2-succ-txns-source-receipt tx fn2-succ-txns) receipt))
(defun fn2-gobs-count (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-c-source-control (fn2-core-c-source-control fn2-core))) (count)
  (fn2-c-source-control-readers 0 fn2-c-source-control) count))
(defun fn2-gobs-writer (begin fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-c-source-control (fn2-core-c-source-control fn2-core))) (code fn2-c-source-control)
  (if begin (fn2-c-source-writer-begin 9 17 19 23 29 31 fn2-c-source-control)
            (fn2-c-source-writer-poll 9 17 19 23 29 31 fn2-c-source-control)) (mv code fn2-core)))
(defun fn2-gobs-wrong-release (receipt fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-reads (fn2-core-reads fn2-core)) (fn2-c-source-control (fn2-core-c-source-control fn2-core))
             (fn2-c-source-readers (fn2-core-c-source-readers fn2-core))) (code target gen fn2-c-source-control fn2-c-source-readers)
  (fn2-c-source-reader-release (fn2-c-source-successor-endpoint (fn2-reads-rows fn2-reads) 0) (+ 1 receipt) fn2-c-source-control fn2-c-source-readers)
  (mv code target gen fn2-core)))
(defun fn2-gobs-call (mode tx slot gen len fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (case mode
  (:identity (mv-let (code fn2-core) (fn2-identity-decide tx 4096 fn2-core) (mv code 0 fn2-core)))
  (:principal (fn2-principal-lookup tx slot gen 0 len 5 1 1 4096 fn2-core))
  (otherwise (fn2-group-lookup tx slot gen 0 len 5 1 1 4096 fn2-core))))
(defun fn2-gobs-drive (fuel mode slot gen len fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel 0 fn2-core)
  (mv-let (code value fn2-core) (fn2-gobs-call mode 0 slot gen len fn2-core)
   (if (member-eq code '(:more :miss)) (fn2-gobs-drive (- fuel 1) mode slot gen len fn2-core) (mv code value fn2-core)))))
(defun fn2-gobs-refs-clear (n at fn2-fields)
 (declare (xargs :stobjs fn2-fields :verify-guards nil :measure (nfix n)))
 (or (zp n) (and (equal (fn2-fields-ref-slot at fn2-fields) 0) (equal (fn2-fields-ref-gen at fn2-fields) 0)
                  (equal (fn2-fields-ref-off at fn2-fields) 0) (equal (fn2-fields-ref-len at fn2-fields) 0)
                  (fn2-gobs-refs-clear (- n 1) (+ at 1) fn2-fields))))
(defun fn2-gobs-cleared (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-id-decides (fn2-core-id-decides fn2-core)) (fn2-fc (fn2-core-fc fn2-core))
             (fn2-fields (fn2-core-fields fn2-core)) (fn2-run-cursors (fn2-core-run-cursors fn2-core))
             (fn2-succ-txns (fn2-core-succ-txns fn2-core))) (yes)
  (mv-let (code base) (fn2-idc-stripe 0 (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields)
   (and (eq code :ok) (fn2-gobs-refs-clear *fn2-run-reader-fields* (+ base *fn2-idc-rb*) fn2-fields)
        (equal (fn2-run-cursors-phase 0 fn2-run-cursors) *fn2-run-cursor-phase-idle*)
        (equal (fn2-succ-txns-lphase 0 fn2-succ-txns) *fn2-succ-lookup-idle*)
        (equal (fn2-succ-txns-lbound 0 fn2-succ-txns) 0)
        (equal (fn2-succ-txns-lrow 0 fn2-succ-txns) 0)
        (equal (fn2-succ-txns-lver 0 fn2-succ-txns) 0))) yes))
(defun fn2-gobs-wake-pending (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-c-source-control (fn2-core-c-source-control fn2-core))) (wake)
  (fn2-c-source-control-wake-pending 0 fn2-c-source-control) wake))
(defun fn2-gobs-exclusive (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-c-source-control (fn2-core-c-source-control fn2-core))) (yes)
  (fn2-c-source-writer-exclusive-p 9 17 19 23 29 31 fn2-c-source-control) yes))
(defun fn2-gobs-body (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-gobs-profile* fn2-core))
      ((mv genesis fn2-core) (fn2-groups-genesis *fn2-gobs-profile* fn2-core))
      ((mv a slot gen fn2-core) (fn2-core-reserve 1 5 1 1 fn2-core))
      ((mv b digest dgen fn2-core) (fn2-core-reserve 1 5 1 1 fn2-core))
      ((mv c mid mgen fn2-core) (fn2-core-reserve 1 5 1 1 fn2-core))
      ((mv mwritten fn2-core) (fn2-gobs-write '(60 97 64 120 62) mid mgen 0 fn2-core))
      (bytes (if (eq mode :identity) '(60 97 64 120 62) '(97 108 116 46 116 101 115 116)))
      ((mv written fn2-core) (fn2-gobs-write bytes slot gen 0 fn2-core))
      ((mv dwritten fn2-core) (fn2-gobs-write (make-list 32 :initial-element 7) digest dgen 0 fn2-core))
      ((mv started fn2-core) (if (eq mode :identity)
       (fn2-identity-decide-start 0 mid mgen 0 5 digest dgen 0 5 1 1 fn2-core) (mv :ok fn2-core)))
      (h (fn2-gobs-whole-h fn2-core))
      ((mv first & fn2-core) (fn2-gobs-call mode 0 slot gen (len bytes) fn2-core))
      (receipt (fn2-gobs-receipt 0 fn2-core))
      ((unless (and (eq genesis :ok) (eq a :ok) (eq b :ok) (eq c :ok) (eq mwritten :ok) (eq written :ok) (eq dwritten :ok) (eq started :ok)
                    (eq first :more) (posp receipt) (equal (fn2-gobs-count fn2-core) 1)
                    (equal h (fn2-gobs-whole-h fn2-core)))) (mv nil fn2-core))
      ((mv pending fn2-core) (fn2-gobs-writer t fn2-core))
      ((mv foreign-resolve fn2-core) (fn2-successor-resolve 0 4096 fn2-core))
      ((mv stale & & fn2-core) (fn2-gobs-wrong-release receipt fn2-core))
      ((mv restart fn2-core) (fn2-identity-decide-start 0 mid mgen 0 5 digest dgen 0 5 1 1 fn2-core))
      ((mv other-start fn2-core) (if (eq mode :identity)
       (fn2-identity-decide-start 1 mid mgen 0 5 digest dgen 0 5 1 1 fn2-core) (mv :ok fn2-core)))
      ((mv blocked & fn2-core) (fn2-gobs-call mode 1 slot gen (len bytes) fn2-core))
      ((unless (and (eq pending :more) (eq foreign-resolve :state) (eq stale :stale) (eq restart :state) (eq other-start :ok) (eq blocked :more)
                    (equal (fn2-gobs-receipt 0 fn2-core) receipt) (equal (fn2-gobs-receipt 1 fn2-core) 0)
                    (equal (fn2-gobs-count fn2-core) 1) (not (fn2-gobs-exclusive fn2-core))
                    (equal h (fn2-gobs-whole-h fn2-core)))) (mv nil fn2-core))
      ((mv answer value fn2-core) (if (eq mode :error)
       (fn2-group-lookup 0 slot gen 0 (len bytes) 5 1 1 4097 fn2-core)
       (fn2-gobs-drive 64 mode slot gen (len bytes) fn2-core)))
      (expected (case mode (:identity :stored) (:principal :absent) (:error :bounds) (otherwise :ok)))
      ((unless (and (eq answer expected) (if (eq mode :group) (equal value 9) (equal value 0))
                    (equal (fn2-gobs-receipt 0 fn2-core) 0) (equal (fn2-gobs-count fn2-core) 0)
                    (equal (fn2-gobs-wake-pending fn2-core) 1) (fn2-gobs-cleared fn2-core)
                    (equal h (fn2-gobs-whole-h fn2-core)))) (mv nil fn2-core))
      ((mv polled fn2-core) (fn2-gobs-writer nil fn2-core))
      ; A cached identity verdict is scalar and can answer under EXCLUSIVE
      ; without admitting another source reader or disturbing the new H gate.
      ((mv cached fn2-core) (if (eq mode :identity) (fn2-identity-decide 0 4096 fn2-core) (mv :stored fn2-core))))
  (mv (and (eq polled :ok) (fn2-gobs-exclusive fn2-core) (eq cached :stored)
           (equal (fn2-gobs-count fn2-core) 0) (equal h (fn2-gobs-whole-h fn2-core))) fn2-core)))
(defun fn2-gobs-test (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (answer fn2-core) (fn2-gobs-body mode fn2-core) answer)))
(assert-event (fn2-core-profilep *fn2-gobs-profile*))
(assert-event (fn2-gobs-test :group))
(assert-event (fn2-gobs-test :principal))
(assert-event (fn2-gobs-test :identity))
(assert-event (fn2-gobs-test :error))

; Inverse foreign-domain control: open a real successor slot after the empty
; first slot, so actual resolution returns MORE at RI=1/FRESH with a hold.
; Neither direct directory API may attach to or drop that resolver receipt.
(defun fn2-gobs-resolver-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-gobs-profile* fn2-core))
      ((mv genesis fn2-core) (fn2-groups-genesis *fn2-gobs-profile* fn2-core))
      ((mv reserved slot gen fn2-core) (fn2-core-reserve 1 5 1 1 fn2-core))
      ((mv written fn2-core) (fn2-gobs-write '(97 108 116 46 116 101 115 116) slot gen 0 fn2-core))
      ((mv put fn2-core) (fn2-successor-put 0 1 *fn2-groups-sid* :insert fn2-core))
      (h (fn2-gobs-whole-h fn2-core))
      ((mv resolving fn2-core) (fn2-successor-resolve 0 4096 fn2-core))
      (receipt (fn2-gobs-receipt 0 fn2-core))
      ((mv pending fn2-core) (fn2-gobs-writer t fn2-core))
      ((mv group & fn2-core) (fn2-group-lookup 0 slot gen 0 8 5 1 1 4096 fn2-core))
      ((mv principal & fn2-core) (fn2-principal-lookup 0 slot gen 0 8 5 1 1 4096 fn2-core))
      (kept (and (eq genesis :ok) (eq reserved :ok) (eq written :ok) (eq put :ok) (eq resolving :more)
                 (posp receipt) (eq pending :more) (eq group :state) (eq principal :state)
                 (equal (fn2-gobs-receipt 0 fn2-core) receipt) (equal (fn2-gobs-count fn2-core) 1)
                 (equal h (fn2-gobs-whole-h fn2-core))))
      ((mv cancelled fn2-core) (fn2-successor-release 0 fn2-core))
      ((mv polled fn2-core) (fn2-gobs-writer nil fn2-core)))
  (mv (and kept (eq cancelled :ok) (eq polled :ok) (fn2-gobs-exclusive fn2-core)
           (equal (fn2-gobs-count fn2-core) 0) (equal (fn2-gobs-receipt 0 fn2-core) 0)
           (fn2-gobs-cleared fn2-core) (equal h (fn2-gobs-whole-h fn2-core))) fn2-core)))
(defun fn2-gobs-resolver-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (answer fn2-core) (fn2-gobs-resolver-body fn2-core) answer)))
(assert-event (fn2-gobs-resolver-test))

;;; ABI routing evidence over the actual native wrappers. The recording world
;;; and arguments test dispatch, not the owner invariant or ACL2 admission.
(require :sb-posix)
(require :sb-bsd-sockets)
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")

(defvar *the-live-state* (list :live-state))
(defvar *fnn-arena* (list :arena))
(defvar *fnn-cat* (list :catalog))
(defvar *fnn-hist* (list :history))
(defvar *bindings* nil)
(defvar *signatures* (make-hash-table))
(defvar *observed-call* nil)
(defvar *fnn-trailing-stobjs* (make-hash-table :test 'eq))
(defun w (state) (declare (ignore state)) :recording-world)
(defun stobjs-in (name world)
  (declare (ignore world)) (gethash name *signatures*))
(defun user-stobj-alist (state) (declare (ignore state)) *bindings*)
(defun fnn-call (name &rest args)
  (setf *observed-call* (cons name args))
  (list nil :observed :unchanged-stobjs))
(defun check (claim label) (unless claim (error "~a" label)))

;; Load exact production bodies. Refuse missing definitions instead of
;; silently testing a fixture's imitation of a native wrapper.
(let ((wanted '(fnn-live-arena fnn-live-cat fnn-live-hist fnn-live-owner-st
                fnn-trailing-kind fnn-live-stobj fnn-arena-then-state
                fnn-core-state fnn-core-arena-state fnn-fault))
      (conditions '(fnn-store-error fnn-store-fault)))
  (with-open-file (stream "host/native/io.lisp")
    (loop for form = (read stream nil :eof) until (eq form :eof)
          when (and (consp form)
                    (or (and (eq (car form) 'defun) (member (cadr form) wanted))
                        (and (eq (car form) 'define-condition)
                             (member (cadr form) conditions))))
            do (eval form)
               (setf wanted (remove (cadr form) wanted)
                     conditions (remove (cadr form) conditions))))
  (check (not (or wanted conditions)) "all production dispatch definitions loaded"))

(setf (gethash 'old-state-entry *signatures*) '(nil state)
      (gethash 'owner-entry *signatures*) '(nil fn-owner-st state)
      (gethash 'mixed-entry *signatures*) '(nil fn-arena fn-cat fn-hist fn-owner-st state)
      (gethash 'interrupted-entry *signatures*) '(fn-arena nil fn-owner-st state)
      (gethash 'non-state-entry *signatures*) '(fn-owner-st))
(check (null (fnn-trailing-kind 'old-state-entry)) "legacy state-only ABI preserved")
(check (equal (fnn-trailing-kind 'mixed-entry) '(fn-arena fn-cat fn-hist fn-owner-st))
       "all live stobjs retain declared order")
(check (equal (fnn-trailing-kind 'interrupted-entry) '(fn-owner-st))
       "scalar breaks trailing run")
(check (null (fnn-trailing-kind 'non-state-entry)) "only trailing-state entries qualify")
(check (handler-case (progn (fnn-core-state 'owner-entry :argument) nil)
         (fnn-store-fault () t))
       "missing owner binding faults before calling an entry")
(check (null *observed-call*) "no entry received old globals as a carrier substitute")

(let ((first (list :first-owner)) (replacement (list :replacement-owner)))
  (setf *bindings* (list (cons 'fn-owner-st first)))
  (check (eq (fnn-core-state 'owner-entry :argument) :observed) "owner entry result preserved")
  (check (equal *observed-call* (list 'owner-entry :argument first *the-live-state*))
         "state wrapper passes actual owner binding before state")
  (check (eq (fnn-core-arena-state 'mixed-entry :argument) :observed) "mixed entry result preserved")
  (check (equal *observed-call*
                (list 'mixed-entry :argument *fnn-arena* *fnn-cat* *fnn-hist*
                      first *the-live-state*))
         "existing arena wrapper passes complete declared ABI")
  (setf *bindings* (list (cons 'fn-owner-st replacement)))
  (fnn-core-state 'owner-entry :argument)
  (check (eq (third *observed-call*) replacement) "replacement binding has one authority")
  (setf *bindings* nil)
  (check (handler-case (progn (fnn-live-owner-st) nil) (fnn-store-fault () t))
         "removed binding cannot remain in a native cache"))
(fnn-core-state 'old-state-entry :argument)
(check (equal *observed-call* (list 'old-state-entry :argument *the-live-state*))
       "legacy caller remains unchanged")
(format t "native_owner_carrier_dispatch: PASS actual wrappers, ordered ABI and authoritative binding refusal~%")

; Actual receive helper and actual frame-arm branch; decoder/carriers are stubbed.
; No generated-machine, ACL2 guard, hash or socket integration claim.
(load "tests/ctl-stream-arm-controls.lsp")
(in-package "ACL2")
(defun natp (x) (and (integerp x) (<= 0 x)))
(defmacro mv-let (names value &body body) `(multiple-value-bind ,names ,value ,@body))
(defmacro stobj-let (bindings outputs value &body body)
 `(let ,bindings (multiple-value-bind ,outputs ,value ,@body)))
(defmacro b* (bindings &body body)
 (if (null bindings) `(progn ,@body)
  (let ((lhs (caar bindings)) (rhs (cadar bindings)))
   (cond ((atom lhs) `(let ((,lhs ,rhs)) (b* ,(cdr bindings) ,@body)))
         ((eq (car lhs) 'mv) `(mv-let ,(cdr lhs) ,rhs (b* ,(cdr bindings) ,@body)))
         ((eq (car lhs) 'unless) `(if ,(cadr lhs) (b* ,(cdr bindings) ,@body) ,rhs))
         ((eq (car lhs) 'when) `(if ,(cadr lhs) ,rhs (b* ,(cdr bindings) ,@body)))
         (t (error "Unknown binder ~s" lhs))))))
(defparameter *fn2-ctl-io-bytes* 4096)
(defparameter *fn2-fnct-header-octets* 10)
(defparameter *fn2-fnct-trailer-octets* 32)
(defparameter *fn2-ctl-kind* 1)
(defun fn2-ctl-fc-row (ctl core) (declare (ignore ctl core)) (values :ok 0))
(defun fn2-core-fields (core) (declare (ignore core)) nil)
(defun fn2-core-pool (core) core)
(defun fn2-fnct-cap (slot pool) (declare (ignore slot pool)) 4096)
(defun fn2-pool-fill-value (slot pool) (declare (ignore slot)) (getf pool :fill))
(defun fn2-fnct-stream-head (base slot sgen kind ctl gen fields pool)
 (declare (ignore base slot sgen kind ctl gen))
 (values (if (getf pool :bad) :frame :ok) 4 (getf pool :length) fields))
(with-open-file (in "books/ctl-stream-events.lisp")
 (loop for f = (read in nil :end) until (eq f :end) do
  (when (and (consp f) (eq (car f) 'defmacro))
   (let ((definition (find 'fn2-ctl-receive-cap (cdr (second (fourth f)))
                           :key (lambda (x) (and (consp x) (second x))))))
    (assert definition) (eval definition)))))
(defun cap-at (fill length &optional bad)
 (fn2-ctl-receive-cap 1 2 3 4 fill (list :fill fill :length length :bad bad)))
;; Execute the actual final frame branch through helper and issue arguments.
(let* ((arms (getf (cdddr *ctl*) :arms))
       (branch (car (last (cdr (second (assoc :frame arms))))))
       (call (third (second branch)))
       (decision (third branch)))
 (assert (eq (car call) 'fn2-ctl-receive-cap))
 (dolist (fill '(0 2 9 10 21))
  (let* ((*vars* `((id . 1) (row-generation . 2) (row-rx-slot . 3) (row-rx-gen . 4)
                   (row-fill . ,fill) (row-cap-index . 5) (row-cap-nonce . 6)
                   (row-principal-slot . 7)))
         (core (list :fill fill :length 19)))
   (multiple-value-bind (rcode cap) (apply (car call) (append (mapcar #'expression (cdr call)) (list core)))
    (push (cons 'rcode rcode) *vars*) (push (cons 'cap cap) *vars*)
    (assert (expression (second decision)))
    (let* ((issue (car (third decision))) (args (second issue)))
     (assert (eq (car args) 'fn2-issue-receive))
     (assert (= (expression (sixth args)) (if (< fill 10) (- 10 fill) (- 61 fill)))))))))
;; A coalesced 61-byte registration + following APPEND is consumed as 10+51;
;; the next frame's entire suffix remains available to the next request.
(let ((socket (append (make-list 61 :initial-element :register)
                      (make-list 6200 :initial-element :append))) (fill 0))
 (dotimes (i 2)
  (multiple-value-bind (code cap) (cap-at fill 19)
   (assert (eq code :ok)) (incf fill cap) (setf socket (nthcdr cap socket))))
 (assert (= fill 61)) (assert (= (length socket) 6200)) (assert (every (lambda (x) (eq x :append)) socket)))
(assert (eq (cap-at 61 19) :bounds))
(assert (eq (cap-at 10 19 t) :frame))
(multiple-value-bind (code cap) (cap-at 10 6152) (assert (eq code :ok)) (assert (= cap 4086)))
;; EOF mid-header/body uses actual receive observer already exercised above.
(let* ((receive (cdddr (assoc :receive-result (getf (cdddr *ctl*) :observes)))))
 (dolist (fill '(2 10 21))
  (multiple-value-bind (effects vars)
   (run receive `((*fn2-outcome-done* . 1) (*fn2-outcome-short* . 2)
                  (outcome . 1) (count . 0) (row-fill . ,fill)
                  (*fn2-ctl-stream-bad* . 7)))
   (declare (ignore vars)) (assert (member '(:next :closing) effects :test #'equal)))))
(format t "CTL FRAME RECEIVE SOURCE CONTROLS PASS: coalesced suffix, short header, exact extent, truncation, large-frame cap~%")

(in-package "ACL2")
(include-book "../sim/envelope-output-linear")
(defun fn2-eo-prefix-witness (bytes peer)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-envelope-output-state
  (mv-let (ok fn2-envelope-output-state)
   (let* ((fn2-envelope-output-state (update-fn2-eo-phase 2 fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-bytes bytes fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-peer peer fn2-envelope-output-state))
          (fuel (+ 1 (len peer)))
          (antecedent (and (natp fuel) (equal fuel (+ 1 (len (fn2-eo-peer fn2-envelope-output-state))))
                           (equal (fn2-eo-phase fn2-envelope-output-state) 2)
                           (fn2-eo-octets-p (fn2-eo-peer fn2-envelope-output-state))
                           (fn2-eo-octets-p (fn2-eo-bytes fn2-envelope-output-state))))
          (fn2-envelope-output-state (fn2-envelope-output-run fuel fn2-envelope-output-state)))
    (mv (and antecedent (equal (fn2-eo-phase fn2-envelope-output-state) 10)
             (equal (fn2-eo-result fn2-envelope-output-state)
                    (fn2-envelope-output-language-p (list (cons :prefix bytes)) peer)))
        fn2-envelope-output-state)) ok)))
(assert-event (and (fn2-eo-prefix-witness '(1 2 3) '(1 2))
                   (fn2-eo-prefix-witness '(1 2) '(1 2 3))
                   (fn2-eo-prefix-witness '(1 2) '(1 3))
                   (fn2-eo-prefix-witness '(1) nil)
                   (fn2-eo-prefix-witness nil '(1))
                   (fn2-eo-prefix-witness nil nil)))

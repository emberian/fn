(load "tests/native_store_cleanup_source.lisp")
(in-package "ACL2")
(defstruct (fnn-owner-service (:constructor %make-fnn-owner-service)) store)
(defvar *retained* nil)
(defvar *startup-store* nil)
(defvar *body-condition* (make-condition 'simple-error :format-control "initialization failed"))
(defun fnn-open-live-store (&rest ignored) (declare (ignore ignored)) (values *startup-store* 0))
(defun fnn-check-filesystem-identity (&rest ignored) (declare (ignore ignored)) (error *body-condition*))
(defun fnn-owner-retain-run-authority (service) (setq *retained* service))
(with-open-file (input "host/native/owner.lisp")
  (loop for form = (read input nil :eof) until (eq form :eof) do
    (when (and (consp form) (eq (car form) 'defun) (eq (second form) 'fnn-owner-install))
      (eval form))))
(dolist (failure '(nil :lock))
  (let ((*startup-store* (make-fnn-store :lock-fd :lock))
        (*failures* (list failure)) (*retained* nil) (caught nil))
    (handler-case (fnn-owner-install "/unused" 1) (error (e) (setq caught e)))
    (assert (eq caught *body-condition*))
    (if failure
        (progn (assert (fnn-owner-service-p *retained*))
               (assert (eq (fnn-owner-service-store *retained*) *startup-store*))
               (assert (fnn-store-close-debt *startup-store*)))
      (assert (null *retained*)))))
(format t "PASS actual owner install rollback: primary preserved; uncertain Store carrier retained.~%")

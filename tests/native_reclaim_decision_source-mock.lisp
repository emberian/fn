; Actual stopped-Store reclaim driver, with I/O and ACL2 decisions supplied.
(require :sb-posix)
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(defparameter *events* nil)
(defparameter *decision* nil)
(defparameter *malformed* nil)
(defparameter *history* '((1 2) (3 4) (5 6)))
(defparameter *cleared* nil)
(define-condition refused (error) ())
(defun note (x) (push x *events*))
(defun fnn-refuse (&rest args) (declare (ignore args)) (error 'refused))
(defun fnn-fault (&rest args) (declare (ignore args)) (error "fixture fault"))
(defun fnn-store-prepare-observation () 99)
(defun fnn-store-config (store) (declare (ignore store)) nil)
(defun fnn-config-records (store) (declare (ignore store)) nil)
(defun fnn-octet-list (record) record)
(defun fnn-octet-list-p (record) (listp record))
(defun fnn-octets (record) (coerce record 'vector))
(defun fnn-core-state (name &rest args)
  (declare (ignore args))
  (case name
    ((fn-store-reclaim-context fn-store-reclaim-context-recorded) :context)
    (fn-store-reclaim-ctx-classes '(0 2 0 0 0 0))
    ((fn-store-log-reclaim-decide-stream fn-store-log-reclaim-decide-recorded)
     (note :decision) *decision*)
    (fn-store-sco-clear (note :clear) (setq *cleared* t))
    (otherwise (error "unexpected state call ~s" name))))
(defun fnn-core (name &rest args)
  (case name
    (fn-store-reclaim-init nil)
    (fn-store-reclaim-step (note :fold) (cons (second args) (first args)))
    (fn-store-log-reclaim-event
     (note :rewrite)
     (when *malformed* (return-from fnn-core :malformed))
     (append (first args) '(9)))
    (otherwise (error "unexpected call ~s" name))))
(defun fnn-log-history-each (store consumer)
  (declare (ignore store))
  (assert (not *cleared*))
  (note :scan)
  (mapc consumer *history*))
(defun fnn-reclaim-counts-line (counts) (declare (ignore counts)) "counts")
(defun fnn-checkpoint-require-mutation-ready (store) (declare (ignore store)) (note :ready))
(defun fnn-reclaim-record-instant (store clock) (declare (ignore store clock)) (note :instant) "instant")
(defun fnn-bridge-reset () (note :reset))
(defun fnn-recover-log-replay (store history config)
  (declare (ignore store config))
  (assert *cleared*)
  (assert (equalp history '(#(1 2 9) #(3 4 9) #(5 6 9))))
  (note :replay))
(defun fnn-state-checkpoint-publish-steps (store count)
  (declare (ignore store)) (assert (= count 3)) (note :publish) "published")
(defparameter *mode* nil)
(defun fnn-store-open-mode (store) (declare (ignore store)) *mode*)
(defun (setf fnn-store-open-mode) (value store) (declare (ignore store)) (setq *mode* value))
(with-open-file (in "host/native/checkpoint.lisp")
  (loop for form = (read in nil :eof) until (eq form :eof)
        when (and (consp form) (eq (car form) 'defun)
                  (eq (second form) 'fnn-log-reclaim-steps)) do (eval form)))
(dolist (mode '(:reclaim :recorded :dry-run))
  (dolist (decision '((:none nil) (:refused :funding) (:dry-run ("id") 0 nil)))
    (let ((*events* nil) (*decision* decision) (*cleared* nil))
      (handler-case (fnn-log-reclaim-steps :store mode) (refused () nil))
      (assert (equal (reverse *events*) '(:scan :fold :fold :fold :decision))))))
(dolist (mode '(:reclaim :recorded))
  (let ((*events* nil) (*decision* '(:reclaim ("id") 6 nil)) (*cleared* nil))
    (fnn-log-reclaim-steps :store mode)
    (assert (equal (reverse *events*)
                   (append '(:scan :fold :fold :fold :decision :scan :rewrite :rewrite :rewrite :ready)
                           (unless (eq mode :recorded) '(:instant))
                           '(:clear :reset :replay :publish))))))
(let ((*events* nil) (*decision* '(:reclaim ("id") 6 nil)) (*malformed* t) (*cleared* nil))
  (handler-case (progn (fnn-log-reclaim-steps :store :reclaim) (error "must fault"))
    (error () (assert (not *cleared*))))
  (assert (not (member :instant *events*))))
(format t "RECLAIM DECISION SOURCE PASSED~%")

; A retired child settles private prefixes, never outer application prefixes.
(in-package "ACL2")
(include-book "../books/codec-stack")
(include-book "std/util/bstar" :dir :system)
(defcodec-transport fn2-child-upper ((quantum :u32)))
(defcodec-transport-operations fn2-child-upper)
(defcodec-transport fn2-child-lower ((quantum :u32)))
(defcodec-transport-operations fn2-child-lower)
(defcodec-transport-lifecycle fn2-child-lower)
(defcodec-transport-upgrade fn2-child-lower fn2-codec-copy-plan :status-field nil)
(defcodec-operation fn2-child-operation ())
(defcodec-stack-bridge fn2-child-bridge fn2-child-upper fn2-child-lower fn2-child-operation
 :input-quantum-field quantum :output-quantum-field quantum)
(defun fn2-child-close-run (writep fn2-child-upper fn2-child-lower fn2-child-operation)
 (declare (xargs :stobjs (fn2-child-upper fn2-child-lower fn2-child-operation) :verify-guards nil))
 (b* ((fn2-child-upper (fn2-child-upper-init 1 fn2-child-upper))
      (fn2-child-upper (fn2-child-upper-put 0 (cap 7) (nonce 17) (alive 1) (terminal 3)
                        (quantum 4) (output-length (if writep 4 0)) (raw-code 37)))
      ((mv parent-selected epoch fn2-child-upper)
       (fn2-child-upper-select 7 17 3 9 (if writep 5 6)
        (if writep 3 0) 0 (if writep 4 0) (if writep 4 0)
        (if writep 0 2) 0 (if writep 0 4) (if writep 0 4) fn2-child-upper))
      ((mv begun fn2-child-lower) (fn2-child-lower-begin 7 17 3 9 0 0 4 4 1 1 fn2-child-lower))
      ((mv allocated & & & serial fn2-child-lower) (fn2-child-lower-next 0 0 fn2-child-lower))
      ((mv allocation-observed & fn2-child-lower)
       (fn2-child-lower-observe-lifecycle 7 17 3 9 serial 4096 0 0 fn2-child-lower))
      ((mv ready & & & & fn2-child-lower) (fn2-child-lower-next 0 0 fn2-child-lower))
      ((mv handed & & & & & & fn2-child-lower) (fn2-child-lower-handoff 7 17 3 9 fn2-child-lower))
      ((mv bound fn2-child-operation) (fn2-child-operation-bind-child 7 17 3 9 4 epoch fn2-child-operation))
      ((mv selected serial fn2-child-lower)
       (fn2-child-lower-select 7 17 3 9 (if writep 13 12)
        (if writep 4 0) 0 (if writep 4 0) (if writep 4 0)
        (if writep 0 5) 0 (if writep 0 4) (if writep 0 4) fn2-child-lower))
      ((mv requested fn2-child-operation)
       (fn2-child-operation-request serial (if writep 13 12) (if writep 4 0) (if writep 0 4) fn2-child-operation))
      ((mv pending & & & &) (fn2-child-bridge-closed-child 7 17 3 9 fn2-child-upper fn2-child-lower fn2-child-operation))
      ((mv physical fn2-child-lower)
       (fn2-child-lower-observe-spans 7 17 3 9 serial 0 (if writep 2 0) (if writep 0 2) 0 fn2-child-lower))
      ((mv observed fn2-child-operation)
       (fn2-child-operation-observe serial (if writep 2 0) (if writep 0 2) fn2-child-operation))
      ((mv private-effect & &) (fn2-child-operation-input-prefix serial (if writep 13 12) 12 0 2 fn2-child-operation))
      ((mv live & & & &) (fn2-child-bridge-closed-child 7 17 3 9 fn2-child-upper fn2-child-lower fn2-child-operation))
      ((mv retiring fn2-child-lower) (fn2-child-lower-retire 7 17 fn2-child-lower))
      ((mv cleanup & & & serial fn2-child-lower) (fn2-child-lower-next 0 0 fn2-child-lower))
      ((mv free-pending & & & &) (fn2-child-bridge-closed-child 7 17 3 9 fn2-child-upper fn2-child-lower fn2-child-operation))
      ((mv freed & fn2-child-lower) (fn2-child-lower-observe-lifecycle 7 17 3 9 serial 0 0 0 fn2-child-lower))
      ((mv retired fn2-child-lower) (fn2-child-lower-retire 7 17 fn2-child-lower))
      ((mv stale & & & &) (fn2-child-bridge-closed-child 7 18 3 9 fn2-child-upper fn2-child-lower fn2-child-operation))
      ((mv closed parent-serial action used made)
       (fn2-child-bridge-closed-child 7 17 3 9 fn2-child-upper fn2-child-lower fn2-child-operation))
      (still-pending (= (fn2-child-upper-pending 0 fn2-child-upper) (if writep 5 6)))
      ((mv settled fn2-child-upper) (fn2-child-upper-advance-spans 7 17 3 9 parent-serial used made fn2-child-upper))
      ((mv duplicate & & & &) (fn2-child-bridge-closed-child 7 17 3 9 fn2-child-upper fn2-child-lower fn2-child-operation)))
  (mv (and (equal (list parent-selected begun allocation-observed handed bound selected requested physical observed freed closed settled)
                   '(:ok :ok :ok :ok :ok :ok :ok :ok :ok :ok :ok :ok))
           (eq private-effect :none) (eq allocated :act) (eq ready :done) (eq pending :pending) (eq live :live)
           (eq retiring :closing) (eq cleanup :cleanup) (eq free-pending :pending) (eq retired :done)
           (eq stale :stale) (= parent-serial epoch) (= action (if writep 5 6))
           (= used (if writep 2 0)) (= made (if writep 0 2)) still-pending
           (= (fn2-child-upper-pending 0 fn2-child-upper) 0)
           (= (fn2-child-upper-raw-code 0 fn2-child-upper) 37)
           (= (if writep (fn2-child-upper-output-offset 0 fn2-child-upper)
                        (fn2-child-upper-input-length 0 fn2-child-upper)) 2)
           (eq duplicate :stale))
      fn2-child-upper fn2-child-lower fn2-child-operation)))
(defun fn2-child-close-check (writep)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-child-upper
  (mv-let (ok fn2-child-upper)
   (with-local-stobj fn2-child-lower
    (mv-let (ok fn2-child-upper fn2-child-lower)
     (with-local-stobj fn2-child-operation
      (mv-let (ok fn2-child-upper fn2-child-lower fn2-child-operation)
       (fn2-child-close-run writep fn2-child-upper fn2-child-lower fn2-child-operation)
       (mv ok fn2-child-upper fn2-child-lower)))
     (mv ok fn2-child-upper)))
   ok)))
(assert-event (fn2-child-close-check t))
(assert-event (fn2-child-close-check nil))

; A retired child settles private prefixes, never outer application prefixes.
(in-package "ACL2")
(include-book "../books/tls-stack")
(defcodec-transport-operations fn2-compress-transport :input-quantum-field input-quantum :output-quantum-field output-quantum)
(include-book "std/util/bstar" :dir :system)

(defun fn2-child-close-run (writep fn2-compress-transport fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-compress-transport fn2-tls-transport fn2-tls-record) :verify-guards nil))
 (b* ((fn2-compress-transport (fn2-compress-transport-init 1 fn2-compress-transport))
      (fn2-compress-transport (fn2-compress-transport-put 0 (cap 7) (nonce 17) (alive 1) (terminal 3)
                        (input-quantum 8) (output-quantum 8) (output-length (if writep 4 0)) (raw-code 37)))
      ((mv parent-selected epoch fn2-compress-transport)
       (fn2-compress-transport-select 7 17 3 9 (if writep 5 6)
        (if writep 3 0) 0 (if writep 4 0) (if writep 4 0)
        (if writep 0 2) 0 (if writep 0 8) (if writep 0 8) fn2-compress-transport))
      ((mv begun fn2-tls-transport) (fn2-tls-transport-start 7 17 3 9 0 0 4 3 1 fn2-tls-transport))
      ((mv allocated & & & serial fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv allocation-observed & fn2-tls-transport)
       (fn2-tls-transport-observe 7 17 3 9 serial 4096 0 0 fn2-tls-transport))
      ((mv handshake handshake-action & & handshake-serial fn2-tls-transport)
       (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv handshake-observed & fn2-tls-transport)
       (fn2-tls-transport-observe 7 17 3 9 handshake-serial 0 0 0 fn2-tls-transport))
      ((mv ready & & & & fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv handed & & & & & & fn2-tls-transport) (fn2-tls-transport-handoff 7 17 3 9 fn2-tls-transport))
      ((mv bound fn2-tls-record) (fn2-tls-record-start 7 17 3 9 (if writep 4 8) epoch writep fn2-tls-record))
      ((mv selected serial fn2-tls-transport)
       (fn2-tls-transport-select 7 17 3 9 (if writep 13 12)
        (if writep 4 0) 0 (if writep 4 0) (if writep 4 0)
        (if writep 0 5) 0 (if writep 0 4) (if writep 0 8) fn2-tls-transport))
      ((mv requested fn2-tls-record)
       (fn2-tls-record-request serial (if writep 13 12) (if writep 4 0) (if writep 0 4) fn2-tls-record))
      ((mv pending & & & &) (fn2-compress-tls-closed-child 7 17 3 9 fn2-compress-transport fn2-tls-transport fn2-tls-record))
      ((mv physical fn2-tls-transport)
       (fn2-tls-transport-observe-spans 7 17 3 9 serial 0 (if writep 2 0) (if writep 0 2) 0 fn2-tls-transport))
      ((mv observed fn2-tls-record)
       (fn2-tls-record-observe serial (if writep 2 0) (if writep 0 2) fn2-tls-record))
      ((mv private-effect & &) (fn2-tls-record-input-prefix serial (if writep 13 12) 12 0 2 fn2-tls-record))
      ((mv live & & & &) (fn2-compress-tls-closed-child 7 17 3 9 fn2-compress-transport fn2-tls-transport fn2-tls-record))
      ((mv retiring fn2-tls-transport) (fn2-tls-transport-retire 7 17 fn2-tls-transport))
      ((mv cleanup & & & serial fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv free-pending & & & &) (fn2-compress-tls-closed-child 7 17 3 9 fn2-compress-transport fn2-tls-transport fn2-tls-record))
      ((mv freed & fn2-tls-transport) (fn2-tls-transport-observe 7 17 3 9 serial 0 0 0 fn2-tls-transport))
      ((mv retired fn2-tls-transport) (fn2-tls-transport-retire 7 17 fn2-tls-transport))
      ((mv stale & & & &) (fn2-compress-tls-closed-child 7 18 3 9 fn2-compress-transport fn2-tls-transport fn2-tls-record))
      ((mv closed parent-serial action used made)
       (fn2-compress-tls-closed-child 7 17 3 9 fn2-compress-transport fn2-tls-transport fn2-tls-record))
      (still-pending (= (fn2-compress-transport-pending 0 fn2-compress-transport) (if writep 5 6)))
      ((mv settled fn2-compress-transport) (fn2-compress-transport-advance-spans 7 17 3 9 parent-serial used made fn2-compress-transport))
      ((mv duplicate & & & &) (fn2-compress-tls-closed-child 7 17 3 9 fn2-compress-transport fn2-tls-transport fn2-tls-record)))
  (mv (and (equal (list parent-selected begun allocation-observed handed bound selected requested physical observed freed closed settled)
                   '(:ok :ok :ok :ok :ok :ok :ok :ok :ok :ok :ok :ok))
           (eq private-effect :none) (eq handshake :act) (= handshake-action 7) (eq handshake-observed :ok)
           (eq allocated :act) (eq ready :done) (eq pending :pending) (eq live :live)
           (eq retiring :closing) (eq cleanup :cleanup) (eq free-pending :pending) (eq retired :done)
           (eq stale :stale) (= parent-serial epoch) (= action (if writep 5 6))
           (= used (if writep 2 0)) (= made (if writep 0 2)) still-pending
           (= (fn2-compress-transport-pending 0 fn2-compress-transport) 0)
           (= (fn2-compress-transport-raw-code 0 fn2-compress-transport) 37)
           (= (if writep (fn2-compress-transport-output-offset 0 fn2-compress-transport)
                        (fn2-compress-transport-input-length 0 fn2-compress-transport)) 2)
           (eq duplicate :stale))
      fn2-compress-transport fn2-tls-transport fn2-tls-record)))
(defun fn2-child-close-check (writep)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-compress-transport
  (mv-let (ok fn2-compress-transport)
   (with-local-stobj fn2-tls-transport
    (mv-let (ok fn2-compress-transport fn2-tls-transport)
     (with-local-stobj fn2-tls-record
      (mv-let (ok fn2-compress-transport fn2-tls-transport fn2-tls-record)
       (fn2-child-close-run writep fn2-compress-transport fn2-tls-transport fn2-tls-record)
       (mv ok fn2-compress-transport fn2-tls-transport)))
     (mv ok fn2-compress-transport)))
   ok)))
(assert-event (fn2-child-close-check t))
(assert-event (fn2-child-close-check nil))

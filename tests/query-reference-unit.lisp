; Actual core identity queries hold their name/digest windows across yields.
; Counts below are literal independent oracles. DONE keeps scalar facts,
; while completion/cancellation consumes the actual ACTIVE references.
(in-package "ACL2")
(include-book "../books/assembly")
(include-book "std/util/bstar" :dir :system)
(defconst *fn2-qru-profile*
 (put-assoc-equal :identity-overlays 24
  (put-assoc-equal :identity-arena-bytes 4096
   (put-assoc-equal :pool-classes '((8 . 64) (4 . 256) (40 . 4096)) *fn2-profile-tiny*))))
(defun fn2-qru-fill (n byte slot gen off kind owner fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix n)))
 (if (zp n) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen off byte kind owner 1 fn2-core)
   (if (eq code :ok) (fn2-qru-fill (- n 1) byte slot gen (+ off 1) kind owner fn2-core)
    (mv code fn2-core)))))
(defun fn2-qru-source (kind owner fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv reserve slot gen fn2-core) (fn2-core-reserve 0 kind owner 1 fn2-core))
      ((mv name fn2-core) (fn2-qru-fill 1 109 slot gen 0 kind owner fn2-core))
      ((mv digest fn2-core) (fn2-qru-fill 32 7 slot gen 1 kind owner fn2-core)))
  (mv (list reserve name digest) slot gen fn2-core)))
(defun fn2-qru-start (tx slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (fn2-identity-decide-start tx slot gen 0 1 slot gen 1 5 1 1 fn2-core))
(defun fn2-qru-drive (fuel tx fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-identity-decide tx 4096 fn2-core)
   (if (eq code :more) (fn2-qru-drive (- fuel 1) tx fn2-core) (mv code fn2-core)))))
(defun fn2-qru-count (slot fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (count)
  (fn2-pool-query-ref-count slot fn2-pool) count))
(defun fn2-qru-facts (tx fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (mv-let (code verdict selection h evidence coverage) (fn2-identity-facts tx fn2-core)
  (list code verdict selection h evidence coverage)))
; Capture every decision column and all five current scratch field tuples.
; The stable key coordinates in the decision row are included separately
; from those scratch fields, which the ACTIVE worker rebuilds each step.
(defmacro fn2-qru-row (tx)
 `(list
   (fn2-id-decides-phase ,tx fn2-id-decides)
   (fn2-id-decides-query-incarnation ,tx fn2-id-decides)
   (fn2-id-decides-qk ,tx fn2-id-decides)
   (fn2-id-decides-qs ,tx fn2-id-decides)
   (fn2-id-decides-qg ,tx fn2-id-decides)
   (fn2-id-decides-qmask ,tx fn2-id-decides)
   (fn2-id-decides-qwake ,tx fn2-id-decides)
   (fn2-id-decides-q1slot ,tx fn2-id-decides)
   (fn2-id-decides-q1gen ,tx fn2-id-decides)
   (fn2-id-decides-q1off ,tx fn2-id-decides)
   (fn2-id-decides-q1len ,tx fn2-id-decides)
   (fn2-id-decides-q2slot ,tx fn2-id-decides)
   (fn2-id-decides-q2gen ,tx fn2-id-decides)
   (fn2-id-decides-q2off ,tx fn2-id-decides)
   (fn2-id-decides-q2len ,tx fn2-id-decides)
   (fn2-id-decides-qnamespace ,tx fn2-id-decides)
   (fn2-id-decides-qprofile ,tx fn2-id-decides)
   (fn2-id-decides-qalgorithm ,tx fn2-id-decides)
   (fn2-id-decides-sfound ,tx fn2-id-decides)
   (fn2-id-decides-selected ,tx fn2-id-decides)
   (fn2-id-decides-candidates ,tx fn2-id-decides)
   (fn2-id-decides-gaps ,tx fn2-id-decides)
   (fn2-id-decides-cfound ,tx fn2-id-decides)
   (fn2-id-decides-h ,tx fn2-id-decides)
   (fn2-id-decides-evidence ,tx fn2-id-decides)
   (fn2-id-decides-qualified ,tx fn2-id-decides)
   (fn2-id-decides-local ,tx fn2-id-decides)
   ))
(defun fn2-qru-image (tx fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-id-decides (fn2-core-id-decides fn2-core)) (fn2-fields (fn2-core-fields fn2-core))
             (fn2-fc (fn2-core-fc fn2-core))) (image)
  (mv-let (code b0) (fn2-idc-stripe tx (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields)
   (if (not (eq code :ok)) (list code)
    (list (fn2-qru-row tx)
     (list
      (fn2-fields-value (+ b0 *fn2-idc-eb* 0) fn2-fields)
      (fn2-fields-ref-slot (+ b0 *fn2-idc-eb* 0) fn2-fields)
      (fn2-fields-ref-gen (+ b0 *fn2-idc-eb* 0) fn2-fields)
      (fn2-fields-ref-off (+ b0 *fn2-idc-eb* 0) fn2-fields)
      (fn2-fields-ref-len (+ b0 *fn2-idc-eb* 0) fn2-fields)
     )
     (list
      (fn2-fields-value (+ b0 *fn2-idc-eb* 1) fn2-fields)
      (fn2-fields-ref-slot (+ b0 *fn2-idc-eb* 1) fn2-fields)
      (fn2-fields-ref-gen (+ b0 *fn2-idc-eb* 1) fn2-fields)
      (fn2-fields-ref-off (+ b0 *fn2-idc-eb* 1) fn2-fields)
      (fn2-fields-ref-len (+ b0 *fn2-idc-eb* 1) fn2-fields)
     )
     (list
      (fn2-fields-value (+ b0 *fn2-idc-eb* 2) fn2-fields)
      (fn2-fields-ref-slot (+ b0 *fn2-idc-eb* 2) fn2-fields)
      (fn2-fields-ref-gen (+ b0 *fn2-idc-eb* 2) fn2-fields)
      (fn2-fields-ref-off (+ b0 *fn2-idc-eb* 2) fn2-fields)
      (fn2-fields-ref-len (+ b0 *fn2-idc-eb* 2) fn2-fields)
     )
     (list
      (fn2-fields-value (+ b0 *fn2-idc-eb* 3) fn2-fields)
      (fn2-fields-ref-slot (+ b0 *fn2-idc-eb* 3) fn2-fields)
      (fn2-fields-ref-gen (+ b0 *fn2-idc-eb* 3) fn2-fields)
      (fn2-fields-ref-off (+ b0 *fn2-idc-eb* 3) fn2-fields)
      (fn2-fields-ref-len (+ b0 *fn2-idc-eb* 3) fn2-fields)
     )
     (list
      (fn2-fields-value (+ b0 *fn2-idc-eb* 4) fn2-fields)
      (fn2-fields-ref-slot (+ b0 *fn2-idc-eb* 4) fn2-fields)
      (fn2-fields-ref-gen (+ b0 *fn2-idc-eb* 4) fn2-fields)
      (fn2-fields-ref-off (+ b0 *fn2-idc-eb* 4) fn2-fields)
      (fn2-fields-ref-len (+ b0 *fn2-idc-eb* 4) fn2-fields)
     )
    ))) image))

; One taking is both windows for each of two real transaction rows: the
; independent expected reference counts are 2, 4, 2, 0. No synthetic OpRef.
(defun fn2-qru-shared (cancel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-qru-profile* fn2-core))
      ((mv setup slot gen fn2-core) (fn2-qru-source 5 1 fn2-core))
      ((mv start0 fn2-core) (fn2-qru-start 0 slot gen fn2-core))
      (two (fn2-qru-count slot fn2-core))
      ((mv start1 fn2-core) (fn2-qru-start 1 slot gen fn2-core))
      (four (fn2-qru-count slot fn2-core))
      (active-before (fn2-qru-image 0 fn2-core))
      ((mv busy fn2-core) (fn2-qru-start 0 slot gen fn2-core))
      (busy-preserved (and (equal active-before (fn2-qru-image 0 fn2-core))
                            (equal (fn2-qru-count slot fn2-core) 4)))
      ((mv write4 fn2-core) (fn2-core-write slot gen 0 110 5 1 1 fn2-core))
      ((mv release4 fn2-core) (fn2-core-release slot gen 5 1 1 fn2-core))
      ((mv finish0 fn2-core)
       (if cancel (fn2-successor-release 0 fn2-core) (fn2-qru-drive 100 0 fn2-core)))
      (remaining (fn2-qru-count slot fn2-core))
      ((mv write2 fn2-core) (fn2-core-write slot gen 0 110 5 1 1 fn2-core))
      ((mv release2 fn2-core) (fn2-core-release slot gen 5 1 1 fn2-core))
      ((mv nc namebyte) (fn2-core-read slot gen 0 5 1 1 fn2-core))
      ((mv dc digestbyte) (fn2-core-read slot gen 1 5 1 1 fn2-core))
      (stable-bytes (equal (list nc namebyte dc digestbyte) '(:ok 109 :ok 7)))
      ((mv finish1 fn2-core)
       (if cancel (fn2-successor-release 1 fn2-core) (fn2-qru-drive 100 1 fn2-core)))
      (zero (fn2-qru-count slot fn2-core))
      (facts0 (fn2-qru-facts 0 fn2-core)) (facts1 (fn2-qru-facts 1 fn2-core))
      ((mv write0 fn2-core) (fn2-core-write slot gen 0 110 5 1 1 fn2-core))
      ((mv released fn2-core) (fn2-core-release slot gen 5 1 1 fn2-core))
      ((mv reused newslot newgen fn2-core) (fn2-core-reserve 0 5 1 1 fn2-core))
      ((mv rewrite fn2-core) (fn2-qru-fill 33 255 newslot newgen 0 5 1 fn2-core))
      (facts-preserved (and (equal facts0 (fn2-qru-facts 0 fn2-core))
                            (equal facts1 (fn2-qru-facts 1 fn2-core))))
      ((mv repeat0 fn2-core) (fn2-identity-decide 0 4096 fn2-core))
      ((mv repeat1 fn2-core) (fn2-identity-decide 1 4096 fn2-core))
      ((mv restart fn2-core) (fn2-qru-start 0 newslot newgen fn2-core))
      (restart-count (fn2-qru-count newslot fn2-core))
      ((mv recancel fn2-core) (fn2-successor-release 0 fn2-core)))
  (mv (list setup start0 two start1 four busy busy-preserved write4 release4 finish0 remaining write2 release2 stable-bytes finish1 zero
            facts0 facts1 write0 released reused (equal newslot slot) (equal newgen (+ 1 gen)) rewrite
            facts-preserved repeat0 repeat1 restart restart-count recancel (fn2-qru-count newslot fn2-core)) fn2-core)))

; A failed second acquire must roll back only its just-acquired first
; reference, leaving another ACTIVE row's two holds and the old DONE query
; and incarnation intact. OVERFLOW is an explicit hypothesis removal: only
; the second source's counter is raised to its representable maximum.
(defun fn2-qru-rollback (failure fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-qru-profile* fn2-core))
      ((mv setup slot gen fn2-core) (fn2-qru-source 5 1 fn2-core))
      ((mv other ds dg fn2-core) (fn2-qru-source (if (eq failure :owner) 6 5) (if (eq failure :owner) 2 1) fn2-core))
      ((mv old-start fn2-core) (fn2-qru-start 1 slot gen fn2-core))
      ((mv old-done fn2-core) (fn2-qru-drive 100 1 fn2-core))
      ((mv active fn2-core) (fn2-qru-start 0 slot gen fn2-core))
      (fn2-core
       (if (eq failure :overflow)
           (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (fn2-pool)
            (fn2-pool-set-query-ref-count ds 1152921504606846975 fn2-pool) fn2-core)
         fn2-core))
      (before (fn2-qru-image 1 fn2-core)) (active-before (fn2-qru-image 0 fn2-core))
      (count-before (fn2-qru-count slot fn2-core)) (other-before (fn2-qru-count ds fn2-core))
      ((mv refused fn2-core)
       (fn2-identity-decide-start 1 slot gen 0 1 ds (if (eq failure :stale) (+ 1 dg) dg)
        (if (eq failure :bounds) 2 1) 5 1 1 fn2-core))
      (preserved (and (equal before (fn2-qru-image 1 fn2-core))
                       (equal active-before (fn2-qru-image 0 fn2-core))))
      (counts-preserved (and (equal count-before (fn2-qru-count slot fn2-core))
                             (equal other-before (fn2-qru-count ds fn2-core))))
      ((mv cancelled fn2-core) (fn2-successor-release 0 fn2-core)))
  (mv (list setup other old-start old-done active count-before other-before refused preserved counts-preserved
            cancelled (fn2-qru-count slot fn2-core) (fn2-qru-facts 1 fn2-core)) fn2-core)))

; Incarnation exhaustion is tested by the existing named hypothesis removal
; at its exact scalar bound. It must refuse before acquiring either source.
(defun fn2-qru-exhaustion (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-qru-profile* fn2-core))
      ((mv setup slot gen fn2-core) (fn2-qru-source 5 1 fn2-core))
      ((mv start fn2-core) (fn2-qru-start 0 slot gen fn2-core))
      ((mv done fn2-core) (fn2-qru-drive 100 0 fn2-core))
      ; Hypothesis removal: reaching this counter naturally is not a
      ; bounded fixture. No phase, query bytes or reference count is forged.
      (fn2-core (stobj-let ((fn2-id-decides (fn2-core-id-decides fn2-core))) (fn2-id-decides)
                  (fn2-id-decides-set-query-incarnation 0 1152921504606846975 fn2-id-decides) fn2-core))
      (before (fn2-qru-image 0 fn2-core))
      ((mv refused fn2-core) (fn2-qru-start 0 slot gen fn2-core))
      (preserved (equal before (fn2-qru-image 0 fn2-core)))
      ((mv release fn2-core) (fn2-core-release slot gen 5 1 1 fn2-core)))
  (mv (list setup start done refused preserved (fn2-qru-count slot fn2-core) release) fn2-core)))
(defmacro fn2-qru-result (name args call)
 `(defun ,name ,args
   (declare (xargs :verify-guards nil))
   (with-local-stobj fn2-core (mv-let (result fn2-core) ,call result))))
(fn2-qru-result fn2-qru-shared-result (cancel) (fn2-qru-shared cancel fn2-core))
(fn2-qru-result fn2-qru-rollback-result (failure) (fn2-qru-rollback failure fn2-core))
(fn2-qru-result fn2-qru-exhaustion-result nil (fn2-qru-exhaustion fn2-core))
(assert-event
 (equal (fn2-qru-shared-result nil)
  '((:ok :ok :ok) :ok 2 :ok 4 :state t :held :held :stored 2 :held :held t :stored 0
    (:ok :stored :none 0 :none :complete) (:ok :stored :none 0 :none :complete)
    :ok :ok :ok t t :ok t :stored :stored :ok 2 :ok 0)))
(assert-event
 (equal (fn2-qru-shared-result t)
  '((:ok :ok :ok) :ok 2 :ok 4 :state t :held :held :ok 2 :held :held t :ok 0
    (:state nil nil 0 nil nil) (:state nil nil 0 nil nil)
    :ok :ok :ok t t :ok t :state :state :ok 2 :ok 0)))
(assert-event
 (and
  (equal (fn2-qru-rollback-result :stale)
   '((:ok :ok :ok) (:ok :ok :ok) :ok :stored :ok 2 0 :stale t t :ok 0 (:ok :stored :none 0 :none :complete)))
  (equal (fn2-qru-rollback-result :bounds)
   '((:ok :ok :ok) (:ok :ok :ok) :ok :stored :ok 2 0 :bounds t t :ok 0 (:ok :stored :none 0 :none :complete)))
  (equal (fn2-qru-rollback-result :owner)
   '((:ok :ok :ok) (:ok :ok :ok) :ok :stored :ok 2 0 :owner t t :ok 0 (:ok :stored :none 0 :none :complete)))
  (equal (fn2-qru-rollback-result :overflow)
   '((:ok :ok :ok) (:ok :ok :ok) :ok :stored :ok 2 1152921504606846975 :exhausted t t :ok 0
     (:ok :stored :none 0 :none :complete)))))
(assert-event
 (equal (fn2-qru-exhaustion-result)
  '((:ok :ok :ok) :ok :stored :exhausted t 0 :ok)))

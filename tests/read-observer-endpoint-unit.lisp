; Prepared, unexecuted controls of the actual READ endpoint and key child.
; Source enumeration/actor ownership and whole-response admission are excluded.
(in-package "ACL2")
(include-book "../books/machines-c-read")
(include-book "std/util/bstar" :dir :system)
(defconst *fn2-rdo-stobjs*
 '(fn2-reads fn2-id-decides fn2-fields fn2-fc fn2-c-source-control fn2-c-source-readers))
(defmacro fn2-rdo-mv (answer) `(mv ,answer ,@*fn2-rdo-stobjs*))
(defun fn2-rdo-nest (n body)
 (declare (xargs :verify-guards nil :measure (nfix n)))
 (if (zp n) body
  (fn2-rdo-nest (- n 1)
   `(with-local-stobj ,(nth (- n 1) *fn2-rdo-stobjs*)
     (mv-let (answer ,@(take n *fn2-rdo-stobjs*)) ,body
      ,(if (equal n 1) 'answer `(mv answer ,@(take (- n 1) *fn2-rdo-stobjs*))))))))
(defmacro fn2-rdo-with (body) (fn2-rdo-nest (len *fn2-rdo-stobjs*) body))
(defun fn2-rdo-body (fn2-reads fn2-id-decides fn2-fields fn2-fc fn2-c-source-control fn2-c-source-readers)
 (declare (xargs :stobjs (fn2-reads fn2-id-decides fn2-fields fn2-fc fn2-c-source-control fn2-c-source-readers) :verify-guards nil))
 (b* ((fn2-reads (fn2-reads-init 2 fn2-reads))
      (fn2-id-decides (fn2-id-decides-init 1 fn2-id-decides))
      (fn2-fields (fn2-fields-init (+ *fn2-idc-stride* *fn2-b-seal-field-rows* (* 2 *fn2-b-read-stride*)) fn2-fields))
      (fn2-fc (fn2-fc-init 0 fn2-fc))
      (fn2-c-source-control (fn2-c-source-control-init 1 fn2-c-source-control))
      (fn2-c-source-readers (fn2-c-source-readers-init 2 fn2-c-source-readers))
      ((mv first fn2-reads fn2-c-source-control fn2-c-source-readers)
       (fn2-read-observer-enter 0 t fn2-reads fn2-c-source-control fn2-c-source-readers))
      (old (fn2-reads-observer-serial 0 fn2-reads))
      ((mv waiting fn2-c-source-control) (fn2-c-source-writer-begin 1 0 1 7 11 13 fn2-c-source-control))
      ((mv resume fn2-reads fn2-c-source-control fn2-c-source-readers)
       (fn2-read-observer-enter 0 nil fn2-reads fn2-c-source-control fn2-c-source-readers))
      ((mv blocked fn2-reads fn2-c-source-control fn2-c-source-readers)
       (fn2-read-observer-enter 1 t fn2-reads fn2-c-source-control fn2-c-source-readers))
      (held (and (eq first :ok) (posp old) (eq waiting :waiting) (eq resume :ok) (eq blocked :more)
                 (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 1)
                 (equal (fn2-reads-observer-serial 0 fn2-reads) old)
                 (equal (fn2-reads-observer-serial 1 fn2-reads) 0)))
      ; Actual successful scalar key restart releases its retained READ receipt.
      ((mv key fn2-reads fn2-fields fn2-c-source-control fn2-c-source-readers)
       (fn2-read-key-children 0 :lo 0 42 fn2-reads fn2-id-decides fn2-fields fn2-fc fn2-c-source-control fn2-c-source-readers))
      (closed (and (eq key :ok) (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 0)
                   (equal (fn2-c-source-control-wake-pending 0 fn2-c-source-control) 1)
                   (equal (fn2-reads-observer-serial 0 fn2-reads) 0)))
      ((mv abort fn2-c-source-control) (fn2-c-source-writer-abort-pending 1 0 1 7 11 13 fn2-c-source-control))
      ((mv again fn2-reads fn2-c-source-control fn2-c-source-readers)
       (fn2-read-observer-enter 0 t fn2-reads fn2-c-source-control fn2-c-source-readers))
      (new (fn2-reads-observer-serial 0 fn2-reads))
      ; Saved OLD lower receipt, not a lookup of the latest row receipt.
      ((mv stale & & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release 0 old fn2-c-source-control fn2-c-source-readers)))
  (fn2-rdo-mv (and held closed (eq abort :aborted) (eq again :ok) (< old new)
                   (eq stale :stale) (fn2-read-observer-current-p 0 fn2-reads fn2-c-source-readers)
                   (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 1)))))
(assert-event (fn2-rdo-with (fn2-rdo-body fn2-reads fn2-id-decides fn2-fields fn2-fc fn2-c-source-control fn2-c-source-readers)))

; An admitted request can construct both actual READ endpoints while a writer
; is pending. The atomic pair cannot clear while either child remains live.
(defun fn2-rdo-parent-body (fn2-reads fn2-id-decides fn2-fields fn2-fc fn2-c-source-control fn2-c-source-readers)
 (declare (xargs :stobjs (fn2-reads fn2-id-decides fn2-fields fn2-fc fn2-c-source-control fn2-c-source-readers) :verify-guards nil))
 (b* ((fn2-reads (fn2-reads-init 2 fn2-reads))
      (fn2-c-source-control (fn2-c-source-control-init 1 fn2-c-source-control))
      (fn2-c-source-readers (fn2-c-source-readers-init 3 fn2-c-source-readers))
      ((mv root receipt fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire 2 0 fn2-c-source-control fn2-c-source-readers))
      ((mv pair fn2-reads) (fn2-read-parent-bind-pair 0 1 2 receipt fn2-reads fn2-c-source-readers))
      ((mv waiting fn2-c-source-control) (fn2-c-source-writer-begin 1 0 1 7 11 13 fn2-c-source-control))
      ((mv first fn2-reads fn2-c-source-control fn2-c-source-readers)
       (fn2-read-observer-enter 0 t fn2-reads fn2-c-source-control fn2-c-source-readers))
      ((mv second fn2-reads fn2-c-source-control fn2-c-source-readers)
       (fn2-read-observer-enter 1 t fn2-reads fn2-c-source-control fn2-c-source-readers))
      ((mv refused fn2-reads) (fn2-read-parent-clear-pair 0 1 2 receipt fn2-reads fn2-c-source-readers))
      (nested (and (eq root :ok) (eq pair :ok) (eq waiting :waiting) (eq first :ok) (eq second :ok)
                   (eq refused :state) (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 3)
                   (fn2-read-observer-current-p 0 fn2-reads fn2-c-source-readers)
                   (fn2-read-observer-current-p 1 fn2-reads fn2-c-source-readers)))
      ((mv c0 fn2-reads fn2-c-source-control fn2-c-source-readers)
       (fn2-read-observer-release 0 fn2-reads fn2-c-source-control fn2-c-source-readers))
      ((mv c1 fn2-reads fn2-c-source-control fn2-c-source-readers)
       (fn2-read-observer-release 1 fn2-reads fn2-c-source-control fn2-c-source-readers))
      ((mv clear fn2-reads) (fn2-read-parent-clear-pair 0 1 2 receipt fn2-reads fn2-c-source-readers))
      ((mv final & & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release 2 receipt fn2-c-source-control fn2-c-source-readers))
      ((mv exclusive fn2-c-source-control) (fn2-c-source-writer-poll 1 0 1 7 11 13 fn2-c-source-control)))
  (fn2-rdo-mv (and nested (eq c0 :ok) (eq c1 :ok) (eq clear :ok) (eq final :ok)
                   (eq exclusive :exclusive) (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 0)
                   (equal (fn2-reads-observer-parent-serial 0 fn2-reads) 0)
                   (equal (fn2-reads-observer-parent-serial 1 fn2-reads) 0)))))
(assert-event (fn2-rdo-with (fn2-rdo-parent-body fn2-reads fn2-id-decides fn2-fields fn2-fc fn2-c-source-control fn2-c-source-readers)))

; CNS uses one actual READ row. The same shared row preflight as the cursor
; pair refuses parent clear until the child has released its references.
(defun fn2-rdo-single-parent-body (fn2-reads fn2-id-decides fn2-fields fn2-fc fn2-c-source-control fn2-c-source-readers)
 (declare (xargs :stobjs (fn2-reads fn2-id-decides fn2-fields fn2-fc fn2-c-source-control fn2-c-source-readers)
  :guard (and (fn2-reads-wfp fn2-reads) (fn2-id-decides-wfp fn2-id-decides)
              (fn2-fields-wfp fn2-fields) (fn2-fc-wfp fn2-fc)
              (fn2-c-source-control-wfp fn2-c-source-control) (fn2-c-source-readers-wfp fn2-c-source-readers))))
 (b* ((fn2-reads (fn2-reads-init 1 fn2-reads))
      (fn2-c-source-control (fn2-c-source-control-init 1 fn2-c-source-control))
      (fn2-c-source-readers (fn2-c-source-readers-init 2 fn2-c-source-readers))
      ((mv parent receipt fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire 1 0 fn2-c-source-control fn2-c-source-readers))
      ((mv bound fn2-reads) (fn2-read-parent-bind-one 0 1 receipt fn2-reads fn2-c-source-readers))
      ((mv waiting fn2-c-source-control) (fn2-c-source-writer-begin 1 0 1 7 11 13 fn2-c-source-control))
      ((mv child fn2-reads fn2-c-source-control fn2-c-source-readers)
       (fn2-read-observer-enter 0 t fn2-reads fn2-c-source-control fn2-c-source-readers))
      ((mv refused fn2-reads) (fn2-read-parent-clear-one 0 1 receipt fn2-reads fn2-c-source-readers))
      (held (and (eq parent :ok) (eq bound :ok) (eq waiting :waiting) (eq child :ok) (eq refused :state)
                 (equal (fn2-c-source-control-readers 0 fn2-c-source-control) 2)))
      ((mv closed fn2-reads fn2-c-source-control fn2-c-source-readers)
       (fn2-read-observer-release 0 fn2-reads fn2-c-source-control fn2-c-source-readers))
      ((mv clear fn2-reads) (fn2-read-parent-clear-one 0 1 receipt fn2-reads fn2-c-source-readers))
      ((mv done & & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release 1 receipt fn2-c-source-control fn2-c-source-readers))
      ((mv stale fn2-reads) (fn2-read-parent-bind-one 0 1 receipt fn2-reads fn2-c-source-readers))
      ((mv exclusive fn2-c-source-control) (fn2-c-source-writer-poll 1 0 1 7 11 13 fn2-c-source-control)))
  (fn2-rdo-mv (and held (eq closed :ok) (eq clear :ok) (eq done :ok) (eq stale :state)
                   (eq exclusive :exclusive) (equal (fn2-reads-observer-parent-serial 0 fn2-reads) 0)))))
(assert-event (fn2-rdo-with (fn2-rdo-single-parent-body fn2-reads fn2-id-decides fn2-fields fn2-fc fn2-c-source-control fn2-c-source-readers)))

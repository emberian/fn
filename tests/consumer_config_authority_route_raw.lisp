;;; Execute the exact selected ACL2 host prepare body against recording I/O
;;; stubs. This is routing/order evidence, not a logical/world/native proof.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defvar *calls* nil)
(defvar *approved* '(:ok :approved-next-cp nil))
(defvar *ordinary-reason* nil)
(defvar *stage-result* :actual-staged-record)
(defun fn-owner-ocfg (state) (getf state :ocfg))
(defun fn-ocfg-owner (oc) (getf oc :owner))
(defun fn-own-store (owner) (getf owner :store))
(defun fn-sn-consumer (store) (getf store :cp))
(defun fn-ocfg-staged (oc) (getf oc :staged))
(defun fn-ocfg-reconfig-refusal (oc id deltas)
  (declare (ignore oc id deltas)) *ordinary-reason*)
(defun fn-cp-nth (n x) (nth n x))
(defun fn-cca-preflight (cp metadata)
  (push (list :preflight cp metadata) *calls*) *approved*)
(defun fn-owner-step (request arena state)
  (declare (ignore arena))
  (push (list :stage request) *calls*)
  (list :epoch 8 :ocfg (list :owner (fn-ocfg-owner (fn-owner-ocfg state))
                            :staged *stage-result*)))
(defun fn-owner-canonical-epoch (state) (getf state :epoch))
(defun fn-owner-authority-proposal-capture (epoch cp staged approved state)
  (push (list :capture epoch cp staged approved) *calls*) state)
(defun fn-owner-authority-proposal-clear (state) (push :clear *calls*) state)
(defun fn-ores-config-refused (reason) (list :config-result :refused nil reason))
(defun fn-ores-config-staged-result (staged reason)
  (if staged (list :config-result :staged staged nil)
    (fn-ores-config-refused reason)))
(defmacro value (result) `(values nil ,result state))

(let ((form (with-open-file
                (s "planning/evidence/consumer-config-authority-source-2026-09-30/owner-host-preflight-current-hunk.lisp")
              (read s))))
  (unless (and (eq (car form) 'defun)
               (eq (cadr form) 'fn-owner-reconfigure-deltas-admitted))
    (error "actual selected preflight hunk absent"))
  ; Only ACL2 declaration syntax is removed; actual routing body is unchanged.
  (setf (cdddr form)
        (remove-if (lambda (x) (and (consp x) (eq (car x) 'declare))) (cdddr form)))
  (eval form))
(defun check (yes description) (unless yes (error "~a" description)))
(defparameter *state* '(:epoch 7 :ocfg (:owner (:store (:cp :captured-cp)) :staged nil)))

(setf *approved* '(:refused :authority-revision-exhausted) *calls* nil)
(multiple-value-bind (erp value state)
    (fn-owner-reconfigure-deltas-admitted 5 '(:delta) :arena *state*)
  (check (and (null erp) (eq state *state*)
              (equal value '(:config-result :refused nil :authority-revision-exhausted))
              (equal (reverse *calls*) '((:preflight :captured-cp nil))))
         "exhaustion staged/wrote/captured or changed the refused state"))

(setf *approved* '(:ok :approved-next-cp nil) *calls* nil)
(multiple-value-bind (erp value state)
    (fn-owner-reconfigure-deltas-admitted 5 '(:delta) :arena *state*)
  (check (and (null erp) (= (getf state :epoch) 8)
              (equal value '(:config-result :staged :actual-staged-record nil))
              (equal (reverse *calls*)
                     '((:preflight :captured-cp nil)
                       (:stage (:reconfigure 5 (:delta)))
                       (:capture 8 :captured-cp :actual-staged-record (:ok :approved-next-cp nil)))))
         "proposal did not capture the exact approved result and poststage epoch"))

(setf *ordinary-reason* :staged *calls* nil)
(fn-owner-reconfigure-deltas-admitted 5 '(:delta) :arena *state*)
(check (equal (reverse *calls*) '((:stage (:reconfigure 5 (:delta)))))
       "ordinary refusal erased or replaced an older in-flight proposal")
(setf *ordinary-reason* nil *stage-result* nil *calls* nil)
(fn-owner-reconfigure-deltas-admitted 5 '(:delta) :arena *state*)
(check (equal (reverse *calls*) '((:preflight :captured-cp nil)
                                (:stage (:reconfigure 5 (:delta))) :clear))
       "failed stage retained a newly-created proposal")
(format t "config authority prewrite routing: four boundaries passed~%")

;;; Run with sbcl --script. Exercise the actual raw socket/capability transfer
;;; functions. The test ends at the physical observation before normalization.
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(load "host/ffi.lisp")
(with-open-file (source "host/adapter.lisp")
  (loop for form = (read source nil nil) while form
        when (and (consp form)
                  (or (and (eq (car form) 'defstruct)
                           (member (second form) '(fn2-nop fn2-ncap fn2-nhost)))
                      (and (eq (car form) 'defun)
                           (member (second form) '(fn2-n-cap fn2-n-new-cap fn2-n-connect-index
                                                  fn2-n-connect-detach fn2-n-connect-terminal)))))
          do (eval form)))

(let* ((mux (make-fn2-native-mux 4))
       (caps (vector (make-fn2-ncap) (make-fn2-ncap) (make-fn2-ncap)))
       (op (make-fn2-nop :family :inet :w0 #x7f000001 :tls-record nil))
       (host (make-fn2-nhost :ops (vector op) :caps caps :outbound-first 2 :mux mux))
       (listener -1))
  (unwind-protect
       (multiple-value-bind (lfd port) (fn2-native-listen 0)
         (setf listener lfd (fn2-nop-port op) port)
         (flet ((start ()
                  (multiple-value-bind (status fd) (fn2-native-connect-start :inet port #x7f000001 0 0 0)
                    (assert (member status '(:waiting :connected)))
                    (setf (fn2-nop-connect-fd op) fd)
                    (fn2-native-mux-interest mux (fn2-n-connect-index host 0) fd 4)
                    fd))
                (finish ()
                  (fn2-native-mux-wait mux 1000)
                  (assert (fn2-native-mux-ready-p mux (fn2-n-connect-index host 0) 4))
                  (assert (eq :connected (fn2-native-connect-finish (fn2-nop-connect-fd op))))
                  (multiple-value-list (fn2-n-connect-terminal host 0 :connected))))
           (let ((fd (start)))
             (assert (equal '(:cancelled 0 0) (multiple-value-list (fn2-n-connect-terminal host 0 :cancelled))))
             (assert (= (fn2-nop-connect-fd op) -1))
             (assert (minusp (%fn2-native-fcntl fd 3 0)))
             (assert (every (lambda (cap) (= -1 (fn2-ncap-fd cap))) caps)))
           (start)
           (assert (equal (finish) '(:ok 2 1)))
           (let ((cap (aref caps 2)))
             (assert (and (= (fn2-ncap-index cap) 2) (fn2-ncap-outbound-p cap))))
           (let ((fd (start)))
             (assert (equal (finish) '(:failed 0 0)))
             (assert (minusp (%fn2-native-fcntl fd 3 0)))
             (assert (= -1 (fn2-ncap-fd (aref caps 1)))))
           ;; A released slot gets a distinct nonce, so the saved handle
           ;; cannot resolve the newly established socket.
           (fn2-native-close (fn2-ncap-fd (aref caps 2)))
           (setf (fn2-ncap-fd (aref caps 2)) -1)
           (start)
           (assert (equal (finish) '(:ok 2 2)))
           (setf (fn2-nop-cap op) 2 (fn2-nop-nonce op) 1)
           (assert (null (fn2-n-cap host op)))
           (setf (fn2-nop-nonce op) 2)
           (assert (eq (fn2-n-cap host op) (aref caps 2)))))
    (when (>= listener 0) (fn2-native-close listener))
    (loop for cap across caps when (>= (fn2-ncap-fd cap) 0) do (fn2-native-close (fn2-ncap-fd cap)))
    (fn2-native-mux-destroy mux)))
(format t "PASS native Connect cancellation, cap partition, nonce reuse and stale handle~%")

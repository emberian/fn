(defun fn2-ripu-array-frame (at first count before after)
 (declare (xargs :verify-guards nil :measure (acl2-count before)))
 (if (atom before) (equal before after)
  (and (consp after) (or (and (<= first at) (< at (+ first count))) (equal (car before) (car after)))
       (fn2-ripu-array-frame (+ 1 (nfix at)) first count (cdr before) (cdr after)))))
(defun fn2-ripu-edge-frame (first count before after)
 (declare (xargs :verify-guards nil :measure (acl2-count before)))
 (if (atom before) (equal before after)
  (and (consp after)
       (if (consp (car before)) (fn2-ripu-array-frame 0 first count (car before) (car after))
        (equal (car before) (car after)))
       (fn2-ripu-edge-frame first count (cdr before) (cdr after)))))

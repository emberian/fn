; Actual PAGE/READ under the persisted-publication writer barrier. The test
; holds the actual master continuation at its returned publication boundary;
; this is a controlled schedule, not an automatic-scheduler reachability claim.
; Every article, cursor, READ, pin and completion below has an actual producer.
(in-package "ACL2")
(include-book "checkpoint-live-network-prefix-support")
(include-book "../books/cns-request-observer")

(defun fn2-cmp-next-flight (left heldop heldgen fn2-sim)
 (declare (xargs :stobjs fn2-sim :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv nil 0)
  (let ((i (- left 1)))
   (if (and (< 0 (fn2-sim-active i fn2-sim))
            (not (and (equal i heldop) (equal (fn2-sim-gen i fn2-sim) heldgen))))
    (mv t i) (fn2-cmp-next-flight i heldop heldgen fn2-sim)))))

; Rotate only the already paused master. Every other calendar visit calls
; the production principal/service function, and actual harvest routes results.
(defun fn2-cmp-step (accept cap heldop heldgen fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((when (fn2-core-stopped-p fn2-core)) (mv :stop fn2-core fn2-sim fn2-own))
      ((when (fn2-core-posted-p fn2-core))
       (mv-let (& & & & & fn2-core) (fn2-exec-harvest fn2-core) (mv :more fn2-core fn2-sim fn2-own)))
      ((when (consp (fn2-b-outbox fn2-core)))
       (mv-let (& fn2-core fn2-sim fn2-own) (fn2-sim-take-prefix 1 0 fn2-core fn2-sim fn2-own)
        (mv :more fn2-core fn2-sim fn2-own)))
      ((mv found flight) (fn2-cmp-next-flight (fn2-sim-rows fn2-sim) heldop heldgen fn2-sim))
      ((when (or found (= (fn2-sim-wake-pending fn2-sim) 1)))
       (mv-let (& fn2-core fn2-sim fn2-own)
        (fn2-sim-advance-selected nil accept found flight *fn2-fault-none* cap fn2-core fn2-sim fn2-own)
        (mv :more fn2-core fn2-sim fn2-own)))
      ((when (fn2-exec-observation-p fn2-core))
       (mv-let (& & & & & fn2-core) (fn2-exec-mailbox fn2-core) (mv :more fn2-core fn2-sim fn2-own)))
      ((unless (fn2-exec-eligible-p fn2-core)) (mv :idle fn2-core fn2-sim fn2-own))
      ((mv kind principal position fn2-core) (fn2-exec-visit fn2-core))
      (master (fn2-machine-kind-base *fn2-checkpoint-master-kind* fn2-core))
      (head (stobj-let ((fn2-sched (fn2-core-sched fn2-core))) (head)
             (if (< principal (fn2-sched-nprincipals fn2-sched)) (fn2-sched-headsi principal fn2-sched) *fn2-none*) head))
      ((when (and (= kind *fn2-visit-principal*) (= head master)))
       (b* (((mv popped id fn2-core) (fn2-exec-pop principal fn2-core))
            (fn2-core (if (eq popped :ok) (fn2-exec-wake id fn2-core) fn2-core)))
        (mv :more fn2-core fn2-sim fn2-own)))
      ((mv & & & & & fn2-core)
       (if (= kind *fn2-visit-principal*)
        (fn2-exec-principal principal position (fn2-exec-aturn fn2-core) fn2-core)
        (fn2-exec-service (nfix (- kind *fn2-visit-commit*)) position (fn2-exec-aturn fn2-core) fn2-core))))
  (mv :more fn2-core fn2-sim fn2-own)))

(defun fn2-cmp-feed-one (cap nonce request fn2-sim)
 (declare (xargs :stobjs fn2-sim :verify-guards nil))
 (stobj-let ((fn2-sim-network (fn2-sim-net fn2-sim))) (rest actual fn2-sim-network)
  (b* ((actual (if (< cap (fn2-sim-network-rows fn2-sim-network)) (fn2-sim-network-nonce cap fn2-sim-network) 0))
       ((mv code fn2-sim-network)
        (if (and (posp actual) (or (equal nonce 0) (equal nonce actual)) (consp request))
         (fn2-network-client-byte cap actual (car request) fn2-sim-network) (mv :would-block fn2-sim-network))))
   (mv (if (eq code :ok) (cdr request) request) actual fn2-sim-network))
  (mv rest actual fn2-sim)))

(defun fn2-cmp-request (left cap nonce phase fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) *fn2-none*
  (b* ((id (+ (fn2-machine-kind-base *fn2-cns-kind* fn2-core) (- left 1)))
       (ctl (fn2-cns-row-ctl id fn2-core))
       ((mv rc x) (fn2-cns-read-row id fn2-core)))
   (if (and (eq (fn2-cns-snapshot-read-code id fn2-core) :ok)
            (= (fn2-machine-phase id fn2-core) phase)
            (eq (fn2-ctl-snapshot-read-code ctl fn2-core) :ok)
            (= (fn2-ctl-row-cap-index ctl fn2-core) cap) (= (fn2-ctl-row-cap-nonce ctl fn2-core) nonce)
            (eq rc :ok) (= x (fn2-cns-row-xrow id fn2-core))) id
    (fn2-cmp-request (- left 1) cap nonce phase fn2-core)))))
(defun fn2-cmp-cns-rows (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-cns (fn2-cns-table fn2-core))) (n) (fn2-cns-rows fn2-cns) n))

(defun fn2-cmp-read-op (left id gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv *fn2-none* 0)
  (let ((i (- left 1)))
   (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (slot opgen)
    (if (and (= (fn2-ops-kind i fn2-ops) *fn2-action-read*)
             (member-equal (fn2-ops-phase i fn2-ops) (list *fn2-op-phase-queued* *fn2-op-phase-submitted*))
             (= (fn2-ops-owner-kind i fn2-ops) *fn2-cns-kind*)
             (= (fn2-ops-owner-slot i fn2-ops) id) (= (fn2-ops-owner-gen i fn2-ops) gen))
     (mv i (fn2-ops-gen i fn2-ops)) (mv *fn2-none* 0))
    (if (not (= slot *fn2-none*)) (mv slot opgen) (fn2-cmp-read-op i id gen fn2-core))))))
(defun fn2-cmp-op-rows (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (n) (fn2-ops-rows fn2-ops) n))
(defun fn2-cmp-parent-current-p (id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((x (fn2-cns-row-xrow id fn2-core)) (receipt (fn2-cns-row-observer-serial id fn2-core))
       (slot (fn2-machine-slot id fn2-core)))
  (stobj-let ((fn2-reads (fn2-core-reads fn2-core)) (fn2-succ-txns (fn2-core-succ-txns fn2-core))
              (fn2-cursor-table (fn2-cursor-table fn2-core))
              (fn2-c-source-readers (fn2-core-c-source-readers fn2-core))) (yes)
   (fn2-read-parent-binding-current-p x
    (fn2-c-source-cns-endpoint (fn2-reads-rows fn2-reads) (fn2-succ-txns-rows fn2-succ-txns)
                             (fn2-cursor-rows fn2-cursor-table) slot)
    receipt fn2-reads fn2-c-source-readers) yes)))

(defun fn2-cmp-page-input-held-p (id op opgen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((slot (fn2-cns-row-lslot id fn2-core)) (gen (fn2-cns-row-lgen id fn2-core))
      (length (fn2-cns-row-alen id fn2-core)) (owner-gen (fn2-machine-generation id fn2-core)) (unit (fn2-cns-row-lunit id fn2-core))
      (epoch (fn2-cns-row-lepoch id fn2-core)) (allocation (fn2-cns-row-lalloc id fn2-core)))
  (and (fn2-corep fn2-core) (fn2-core-wfp fn2-core) (fn2-clc-published-held-p fn2-core)
       (fn2-clc-full-live-source-p fn2-core) (eq (fn2-cns-snapshot-read-code id fn2-core) :ok)
       (= (fn2-machine-phase id fn2-core) *fn2-cns-state-fetch*)
       (= (fn2-cns-row-verb id fn2-core) *fn2-cns-verb-read*)
       (= (fn2-cns-row-lease id fn2-core) *fn2-cns-lease-held*)
       (posp (fn2-cns-row-observer-serial id fn2-core)) (fn2-cmp-parent-current-p id fn2-core)
       (stobj-let ((fn2-ops (fn2-core-ops fn2-core)) (fn2-extents (fn2-core-extents fn2-core))
                  (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (yes)
        (and (fn2-op-slotp op fn2-ops) (= (fn2-op-gen op fn2-ops) opgen)
             (= (fn2-ops-kind op fn2-ops) *fn2-action-read*)
             (= (fn2-ops-owner-kind op fn2-ops) *fn2-cns-kind*) (= (fn2-ops-owner-slot op fn2-ops) id)
             (= (fn2-ops-owner-gen op fn2-ops) owner-gen)
             (member-equal (fn2-ops-phase op fn2-ops) (list *fn2-op-phase-queued* *fn2-op-phase-submitted*))
             (= (fn2-ops-range-slot op fn2-ops) slot) (= (fn2-ops-range-gen op fn2-ops) gen)
             (= (fn2-ops-range-len op fn2-ops) length)
             (= (fn2-ops-storage-offset op fn2-ops) (* *fn2-commit-unit-bytes* unit))
             (= (fn2-alloc-freeze-phase fn2-extents) 2)
             (let ((edge (fn2-b-read-pin-edge op fn2-extents)))
              (and (fn2-alloc-edge-slotp edge fn2-alloc-edges)
                   (= (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-live*)
                   (= (fn2-alloc-edges-kind edge fn2-alloc-edges) *fn2-alloc-edge-kind-outstanding-io*)
                   (= (fn2-alloc-edges-holder edge fn2-alloc-edges) opgen)
                   (= (fn2-alloc-edges-extent edge fn2-alloc-edges) (floor unit *fn2-storage-extent-units*))
                   (= (fn2-alloc-edges-epoch edge fn2-alloc-edges) epoch)
                   (= (fn2-alloc-edges-counter edge fn2-alloc-edges) allocation)))) yes))))

(defun fn2-cmp-await-read (fuel cap nonce request fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (b* ((id (fn2-cmp-request (fn2-cmp-cns-rows fn2-core) cap nonce *fn2-cns-state-fetch* fn2-core))
      ((mv op gen) (if (= id *fn2-none*) (mv *fn2-none* 0)
                    (fn2-cmp-read-op (fn2-cmp-op-rows fn2-core) id (fn2-machine-generation id fn2-core) fn2-core)))
      ((when (not (= op *fn2-none*))) (mv :read id op gen fn2-core fn2-sim fn2-own))
      ((when (zp fuel)) (mv :fuel id op gen fn2-core fn2-sim fn2-own))
      ((mv request & fn2-sim) (fn2-cmp-feed-one cap nonce request fn2-sim))
      ((mv code fn2-core fn2-sim fn2-own) (fn2-cmp-step nil cap *fn2-none* 0 fn2-core fn2-sim fn2-own)))
  (if (eq code :stop) (mv code id op gen fn2-core fn2-sim fn2-own)
   (fn2-cmp-await-read (- fuel 1) cap nonce request fn2-core fn2-sim fn2-own))))

(defun fn2-cmp-writer (begin fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let* ((id (fn2-machine-kind-base *fn2-checkpoint-master-kind* fn2-core))
        (gen (fn2-machine-generation id fn2-core)) (token (fn2-checkpoint-master-row-token id fn2-core))
        (published (fn2-clc-published-held-p fn2-core)))
  (stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core))
              (fn2-c-source-control (fn2-core-c-source-control fn2-core))) (code fn2-c-source-control)
   (if (not (and published (fn2-csnapshot-ownerp token *fn2-checkpoint-master-kind* id gen fn2-csnapshot)))
    (mv :source fn2-c-source-control)
    (if begin (fn2-c-source-writer-begin *fn2-checkpoint-master-kind* id gen token
                 (fn2-csnapshot-cut-commit 0 fn2-csnapshot) (fn2-csnapshot-cut-event 0 fn2-csnapshot) fn2-c-source-control)
     (fn2-c-source-writer-poll *fn2-checkpoint-master-kind* id gen token
                 (fn2-csnapshot-cut-commit 0 fn2-csnapshot) (fn2-csnapshot-cut-event 0 fn2-csnapshot) fn2-c-source-control)))
   (mv code fn2-core))))

; No END/ready flag: the second actual connection is only allowed to reach
; DECODE. Its exact callback must refuse fresh META while the first owns it.
(defun fn2-cmp-new-request (fuel cap nonce request heldop heldgen fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (b* ((id (fn2-cmp-request (fn2-cmp-cns-rows fn2-core) cap nonce *fn2-cns-state-decode* fn2-core))
      ((when (not (= id *fn2-none*)))
       (mv-let (code receipt fn2-core) (fn2-cns-request-acquire id (fn2-machine-generation id fn2-core) fn2-core)
        (mv (if (and (eq code :admission) (= receipt 0) (= (fn2-cns-row-observer-serial id fn2-core) 0)) :blocked :entered)
            id nonce fn2-core fn2-sim fn2-own)))
      ((when (zp fuel)) (mv :fuel id nonce fn2-core fn2-sim fn2-own))
      ((mv request actual fn2-sim) (fn2-cmp-feed-one cap nonce request fn2-sim))
      ((mv code fn2-core fn2-sim fn2-own)
       (fn2-cmp-step (zp actual) cap heldop heldgen fn2-core fn2-sim fn2-own)))
  (if (eq code :stop) (mv code id actual fn2-core fn2-sim fn2-own)
   (fn2-cmp-new-request (- fuel 1) cap actual request heldop heldgen fn2-core fn2-sim fn2-own))))

(defun fn2-cmp-send-live-p (left cap fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) nil
  (let* ((i (- left 1))
         (yes (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (yes)
               (and (= (fn2-ops-kind i fn2-ops) *fn2-action-send*)
                    (= (fn2-ops-cap-index i fn2-ops) cap)
                    (member-equal (fn2-ops-phase i fn2-ops)
                     (list *fn2-op-phase-queued* *fn2-op-phase-submitted*))) yes)))
   (or yes (fn2-cmp-send-live-p i cap fn2-core)))))

(defun fn2-cmp-row-key (id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (list id (fn2-machine-generation id fn2-core)
  (fn2-cns-row-ctl id fn2-core) (fn2-cns-row-ctl-gen id fn2-core) (fn2-cns-row-request id fn2-core)
  (fn2-cns-row-tx-slot id fn2-core) (fn2-cns-row-tx-gen id fn2-core)
  (fn2-cns-row-consumer id fn2-core) (fn2-cns-row-principal-slot id fn2-core)
  (fn2-cns-row-version id fn2-core) (fn2-cns-row-epoch id fn2-core) (fn2-cns-row-cpos id fn2-core)))
(defun fn2-cmp-octets (left at slot gen ctl ctlgen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :ok nil)
  (b* (((mv code byte) (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code byte)
                        (fn2-pool-read slot gen at *fn2-ctl-kind* ctl ctlgen fn2-pool) (mv code byte)))
       ((unless (eq code :ok)) (mv code nil))
       ((mv rest bytes) (fn2-cmp-octets (- left 1) (+ at 1) slot gen ctl ctlgen fn2-core)))
   (mv rest (cons byte bytes)))))
(defun fn2-cmp-owned-output-p (key cursor position article fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((id (nth 0 key)) (ctl (nth 2 key)) (ctlgen (nth 3 key))
      ((unless (and (equal key (fn2-cmp-row-key id fn2-core))
                    (eq (fn2-ctl-snapshot-read-code ctl fn2-core) :ok)
                    (= (fn2-machine-generation ctl fn2-core) ctlgen)
                    (= (fn2-ctl-row-request ctl fn2-core) (nth 4 key))
                    (= (fn2-ctl-row-cns ctl fn2-core) id)
                    (= (fn2-ctl-row-cns-gen ctl fn2-core) (nth 1 key))
                    (equal cursor (fnc-issued (nth 7 key) (nth 8 key) (nth 9 key) (nth 10 key) (nth 11 key)))
                    (= (fn2-cns-row-observer-serial id fn2-core) 0)
                    (= (fn2-cns-row-count id fn2-core) 1)
                    (= (fn2-cns-row-ipos id fn2-core) position)
                    (posp (fn2-cns-row-ilen id fn2-core)))) nil)
      ((mv code bytes)
       (fn2-cmp-octets (fn2-cns-row-ilen id fn2-core) (fn2-cns-row-ioff id fn2-core)
                      (nth 5 key) (nth 6 key) ctl ctlgen fn2-core)))
  (and (eq code :ok)
       (equal (fnc-items bytes (len bytes))
              (list (list :record position "<metadata-pending@example.test>" article))))))

(defun fn2-cmp-await-owned (fuel key cursor cap position article fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (b* ((id (nth 0 key))
      ((unless (equal key (fn2-cmp-row-key id fn2-core))) (mv :changed fn2-core fn2-sim fn2-own))
      ((when (and (posp (fn2-cns-row-observer-serial id fn2-core))
                  (fn2-cmp-send-live-p (fn2-cmp-op-rows fn2-core) cap fn2-core)))
       (mv :early-send fn2-core fn2-sim fn2-own))
      ((when (fn2-cmp-owned-output-p key cursor position article fn2-core))
       (mv :owned fn2-core fn2-sim fn2-own))
      ((when (zp fuel)) (mv :fuel fn2-core fn2-sim fn2-own))
      ((mv code fn2-core fn2-sim fn2-own)
       (fn2-cmp-step nil cap *fn2-none* 0 fn2-core fn2-sim fn2-own)))
  (if (eq code :stop) (mv code fn2-core fn2-sim fn2-own)
   (fn2-cmp-await-owned (- fuel 1) key cursor cap position article fn2-core fn2-sim fn2-own))))

(defun fn2-cmp-positive ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (with-local-stobj fn2-sim
   (with-local-stobj fn2-own
    (mv-let (result fn2-core fn2-sim fn2-own)
     (b* ((fn2-core (fn2-init-executor *fn2-ccp-profile* :node nil fn2-core))
          (fn2-sim (fn2-sim-init 1 :none "cns-metadata-pending" *fn2-ccp-profile* fn2-sim))
          (fn2-own (fn2-own-init *fn2-ccp-profile* fn2-own))
          ((mv started fn2-core) (fn2-boot-start t *fn2-ccp-image-size* fn2-core))
          ((mv created fn2-core fn2-sim fn2-own) (fn2-ccp-drive 200000 nil fn2-core fn2-sim fn2-own))
          ((unless (and (eq started :ok) (eq created :ready))) (mv :create fn2-core fn2-sim fn2-own))
          (article (append (fnc-asc "From: c@example.test") '(13 10)
                           (fnc-asc "Newsgroups: local.test") '(13 10)
                           (fnc-asc "Message-ID: <metadata-pending@example.test>") '(13 10)
                           (fnc-asc "Subject: metadata") '(13 10 13 10)
                           (fnc-asc "body") '(13 10)))
          ((mv held cursor position nonce fn2-core fn2-sim fn2-own)
           (fn2-cln-prefix-to-held 1 0 91 19 article fn2-core fn2-sim fn2-own))
          ((unless (eq held :held)) (mv (list :prefix held) fn2-core fn2-sim fn2-own))
          ((mv paused id op gen fn2-core fn2-sim fn2-own)
           (fn2-cmp-await-read 400000 1 nonce (fnc-read cursor 1) fn2-core fn2-sim fn2-own))
          ((unless (and (eq paused :read) (fn2-cmp-page-input-held-p id op gen fn2-core)))
           (mv (list :page-input paused) fn2-core fn2-sim fn2-own))
          (key (fn2-cmp-row-key id fn2-core))
          ((mv pending fn2-core) (fn2-cmp-writer t fn2-core))
          ((unless (eq pending :waiting)) (mv (list :writer pending) fn2-core fn2-sim fn2-own))
          ((mv peer fn2-sim)
           (stobj-let ((fn2-sim-network (fn2-sim-net fn2-sim))) (peer fn2-sim-network)
            (fn2-network-set-peer 2 *fn2-peer-family-local* 0 0 fn2-sim-network) (mv peer fn2-sim)))
          ((unless (eq peer :ok)) (mv :peer fn2-core fn2-sim fn2-own))
          ((mv blocked second & fn2-core fn2-sim fn2-own)
           (fn2-cmp-new-request 400000 2 0 (fnc-read cursor 1) op gen fn2-core fn2-sim fn2-own))
          ((unless (and (eq blocked :blocked) (not (= id second)) (fn2-cmp-page-input-held-p id op gen fn2-core)))
           (mv (list :new-request blocked) fn2-core fn2-sim fn2-own))
          ((mv owned fn2-core fn2-sim fn2-own) (fn2-cmp-await-owned 400000 key cursor 1 position article fn2-core fn2-sim fn2-own))
          ((mv exclusive fn2-core) (fn2-cmp-writer nil fn2-core)))
      (mv (if (and (eq owned :owned) (eq exclusive :exclusive)
                   (fn2-cmp-owned-output-p key cursor position article fn2-core) (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
                   (not (fn2-core-stopped-p fn2-core)) (fn2-clc-full-live-source-p fn2-core)
                   (not (fn2-cmp-send-live-p (fn2-cmp-op-rows fn2-core) 1 fn2-core))
                   (= (fn2-cns-row-observer-serial id fn2-core) 0)
                   (= (fn2-cns-row-observer-serial second fn2-core) 0)) :pass (list :finish owned exclusive))
          fn2-core fn2-sim fn2-own)) result)))))
(assert-event (equal (fn2-cmp-positive) :pass))

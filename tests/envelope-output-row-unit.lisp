(in-package "ACL2")
(include-book "../sim/envelope-output-row")
(defun fn2-eo-whole-row-witness (mode peer byte rest following short-fuel)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-envelope-output-state
  (mv-let (ok fn2-envelope-output-state)
   (let* ((expected (fn2-eo-language-row (cons (cons mode (cons byte rest)) following) peer))
          (oldrow (fn2-eo-language-row (cons (cons mode rest) following) peer))
          (fn2-envelope-output-state (update-fn2-eo-phase 8 fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-scan peer fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-byte byte fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-prefix (eq mode :prefix) fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-shifted (cdr oldrow) fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-suffix-scan (fn2-eo-language-row following peer) fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-acc nil fn2-envelope-output-state))
          (antecedent
           (and (equal (fn2-eo-acc fn2-envelope-output-state) nil)
                (equal (fn2-eo-phase fn2-envelope-output-state) 8)
                (fn2-eo-octets-p (fn2-eo-scan fn2-envelope-output-state))
                (unsigned-byte-p 8 (fn2-eo-byte fn2-envelope-output-state))
                (fn2-eo-octets-p rest) (fn2-eo-segments-p following)
                (equal (fn2-eo-suffix-scan fn2-envelope-output-state)
                       (fn2-eo-language-row following (fn2-eo-scan fn2-envelope-output-state)))
                (equal (fn2-eo-shifted fn2-envelope-output-state)
                       (cdr (fn2-eo-language-row
                             (cons (cons (if (fn2-eo-prefix fn2-envelope-output-state) :prefix :exact) rest) following)
                             (fn2-eo-scan fn2-envelope-output-state))))))
          (fuel (+ (* 2 (len peer)) (if short-fuel 2 3)))
          (fn2-envelope-output-state (fn2-envelope-output-run fuel fn2-envelope-output-state)))
    (mv (and antecedent (if short-fuel
            (and (equal (fn2-eo-phase fn2-envelope-output-state) 9)
                 (not (equal (fn2-eo-phase fn2-envelope-output-state) 7)))
          (and (equal (fn2-eo-phase fn2-envelope-output-state) 7)
               (equal (fn2-eo-row fn2-envelope-output-state) expected)
               (equal (len (fn2-eo-row fn2-envelope-output-state)) (+ 1 (len peer))))))
        fn2-envelope-output-state)) ok)))
(assert-event
 (and (fn2-eo-whole-row-witness :exact '(1 2 1 2) 1 nil '((:exact 2)) nil)
      (fn2-eo-whole-row-witness :prefix '(1 2 1 2) 1 nil '((:exact 2)) nil)
      (fn2-eo-whole-row-witness :exact nil 1 nil nil nil)
      (fn2-eo-whole-row-witness :prefix nil 1 nil nil nil)))
(assert-event
 (and (fn2-eo-whole-row-witness :exact '(1 2) 1 nil '((:exact 2)) t)
      (fn2-eo-whole-row-witness :prefix nil 1 nil nil t)))

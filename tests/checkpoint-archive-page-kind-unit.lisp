(include-book "../books/checkpoint-page-header")
(assert-event (and (fn2-checkpoint-page-role-kind-p 3 *page-kind-manifest*)
                  (fn2-checkpoint-page-role-kind-p 3 *page-kind-run-data*)
                  (fn2-checkpoint-page-role-kind-p 3 *page-kind-run-index*)
                  (not (fn2-checkpoint-page-role-kind-p 3 *page-kind-checkpoint-descriptor*))
                  (not (fn2-checkpoint-page-role-kind-p 3 *page-kind-allocation-map*))
                  (not (fn2-checkpoint-page-role-kind-p 2 *page-kind-run-data*))
                  (fn2-checkpoint-page-role-kind-p 1 *page-kind-merkle-node*)
                  (fn2-checkpoint-page-role-kind-p 0 *page-kind-checkpoint-descriptor*)
                  (not (fn2-checkpoint-page-role-kind-p 0 *page-kind-manifest*))
                  (fn2-checkpoint-page-role-kind-p 4 *page-kind-merkle-node*)
                  (fn2-checkpoint-page-role-kind-p 5 *page-kind-recovery-arena*)))

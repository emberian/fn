; Actual Close issuance survives host acknowledgment in the proof measure.
(in-package "ACL2")
(include-book "machine-budget-core-fixture")

(defun fn2-budget-issued-history-run (budget fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      (id (fn2-machine-global-id *fn2-echo-kind* 0 *fn2-profile-tiny*))
      (fn2-core (fn2-echo-put-core id (phase *fn2-echo-state-closing*) (cap-index 7) (cap-nonce 9)))
      (hyps (and (natp budget) (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
                 (fn2-machine-idp id fn2-core) (equal (fn2-machine-kind id fn2-core) *fn2-echo-kind*)))
      ((mv rows before) (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
        (rows total) (mv (fn2-ops-rows fn2-ops) (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops))
        (mv rows total)))
      ((mv bytes steps descriptors ?runnable fn2-core) (fn2-echo-run id budget fn2-core))
      ((mv issued queued) (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
        (total queued) (mv (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops) (fn2-ops-queued fn2-ops))
        (mv total queued)))
      ((mv ack fn2-core) (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
        (code fn2-ops) (fn2-outbox-ack descriptors fn2-ops) (mv code fn2-core)))
      ((mv after final-queued same-rows) (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
        (total queued same) (mv (fn2-ops-issued-count (fn2-ops-rows fn2-ops) fn2-ops)
                               (fn2-ops-queued fn2-ops) (equal rows (fn2-ops-rows fn2-ops)))
        (mv total queued same))))
  (mv (list hyps (fn2-corep fn2-core) (fn2-core-wfp fn2-core)
            (fn2-run-quantitiesp bytes steps descriptors budget 4128)
            descriptors (- issued before) queued ack (- after before) final-queued same-rows
            ; A report of zero passes a net-queue test after acknowledgment,
            ; but fails issued-history accounting for the successful Close.
            (fn2-run-effects-p 0 0 final-queued) (equal after before)) fn2-core)))
(defun fn2-budget-issued-history (budget)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (answer fn2-core)
   (fn2-budget-issued-history-run budget fn2-core) answer)))
(assert-event (equal (fn2-budget-issued-history 0) '(t t t t 0 0 0 :ok 0 0 t t t)))
(assert-event (equal (fn2-budget-issued-history 1) '(t t t t 1 1 1 :ok 1 0 t t nil)))

; In-place owner-reset control from typed warm evidence. Warm reader validity
; is explicit here; this is not an authenticated image/host crash witness.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-bank-cold")
(include-book "../books/checkpoint-bank-closure-state")
(defun fn2-cbr-warm-publication (i fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :verify-guards nil :measure (nfix (- 48 (nfix i)))))
 (if (>= (nfix i) 48) fn2-checkpoint-publication
  (b* ((word (case i (0 333) (8 111) (16 222) (24 55) (32 444) (40 777) (otherwise 0)))
       (runtime (case i (0 1) (1 0) (2 9) (3 37) (4 41) (5 1) (6 1) (7 3) (8 8) (otherwise 0)))
       (cold (case i (0 2) (1 0) (2 9) (3 37) (4 41) (5 1) (6 1) (7 3) (8 8) (9 1) (10 1) (11 48) (otherwise 0)))
       (fn2-checkpoint-publication (if (< i 9) (update-fn2-checkpoint-publication-evidence-metai i runtime fn2-checkpoint-publication) fn2-checkpoint-publication))
       (fn2-checkpoint-publication (if (< i 12) (update-fn2-checkpoint-publication-cold-metai i cold fn2-checkpoint-publication) fn2-checkpoint-publication))
       (fn2-checkpoint-publication (if (< i 40) (update-fn2-checkpoint-publication-evidence-wordsi i word fn2-checkpoint-publication) fn2-checkpoint-publication))
       (fn2-checkpoint-publication (update-fn2-checkpoint-publication-cold-wordsi i word fn2-checkpoint-publication)))
   (fn2-cbr-warm-publication (+ i 1) fn2-checkpoint-publication))))
(defun fn2-cbr-warm-closure (i fn2-checkpoint-bank-closures)
 (declare (xargs :stobjs fn2-checkpoint-bank-closures :verify-guards nil :measure (nfix (- 16 (nfix i)))))
 (if (>= (nfix i) 16)
  (b* ((fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-capture-phasei 0 2 fn2-checkpoint-bank-closures))
       (fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-capture-cursori 0 1 fn2-checkpoint-bank-closures))
       (fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-capture-generationi 0 1 fn2-checkpoint-bank-closures))
       (fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-capture-tagi 0 1 fn2-checkpoint-bank-closures))
       (fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-capture-seeni 0 1 fn2-checkpoint-bank-closures))
       (fn2-checkpoint-bank-closures (fn2-checkpoint-bank-closures-put 0 (generation 1) (evidence-tag 1)
        (present 1) (epoch 3) (allocation 99) (role-bits 1))))
   fn2-checkpoint-bank-closures)
  (let ((fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-identityi i (case i (0 444) (8 777) (otherwise 0)) fn2-checkpoint-bank-closures)))
   (fn2-cbr-warm-closure (+ i 1) fn2-checkpoint-bank-closures))))
(defun fn2-cbr-reset-body (fn2-checkpoint-publication fn2-checkpoint-bank-closures)
 (declare (xargs :stobjs (fn2-checkpoint-publication fn2-checkpoint-bank-closures) :verify-guards nil))
 (b* ((fn2-checkpoint-publication (fn2-checkpoint-publication-init 1 fn2-checkpoint-publication))
      (fn2-checkpoint-bank-closures (fn2-checkpoint-bank-closures-init 1 fn2-checkpoint-bank-closures))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-put 0 (bank0-valid 1) (bank0-candidate 0)
       (bank0-checkpoint 9) (bank0-history 37) (bank0-incarnation 41) (bank0-hash-0 444)))
      (fn2-checkpoint-publication (fn2-cbr-warm-publication 0 fn2-checkpoint-publication))
      (fn2-checkpoint-bank-closures (fn2-cbr-warm-closure 0 fn2-checkpoint-bank-closures))
      (whole (and (fn2-checkpoint-bank-evidence-current-p 0 fn2-checkpoint-publication)
                  (fn2-checkpoint-bank-cold-ready-p 0 fn2-checkpoint-publication)
                  (fn2-checkpoint-bank-closure-ready-p 0 fn2-checkpoint-bank-closures fn2-checkpoint-publication)))
      ; Omit the owner reset using the actual generic initializers. Fixed-array
      ; READY/cursors survive despite the generation's ordinary rows resetting.
      (fn2-checkpoint-publication (fn2-checkpoint-publication-columns-init 1 fn2-checkpoint-publication))
      (fn2-checkpoint-bank-closures (fn2-checkpoint-bank-closures-columns-init 4 fn2-checkpoint-bank-closures))
      (fn2-checkpoint-bank-closures (update-fn2-checkpoint-bank-closures-extents 1 fn2-checkpoint-bank-closures))
      (omitted (and (fn2-checkpoint-bank-cold-ready-p 0 fn2-checkpoint-publication)
                    (fn2-checkpoint-bank-closure-ready-p 0 fn2-checkpoint-bank-closures fn2-checkpoint-publication)
                    (= (fn2-checkpoint-publication-evidence-metai 0 fn2-checkpoint-publication) 1)))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-init 1 fn2-checkpoint-publication))
      (fn2-checkpoint-bank-closures (fn2-checkpoint-bank-closures-init 1 fn2-checkpoint-bank-closures)))
  (mv (and whole omitted
       (not (fn2-checkpoint-bank-cold-ready-p 0 fn2-checkpoint-publication))
       (not (fn2-checkpoint-bank-evidence-current-p 0 fn2-checkpoint-publication))
       (not (fn2-checkpoint-bank-closure-ready-p 0 fn2-checkpoint-bank-closures fn2-checkpoint-publication))
       (= (fn2-checkpoint-publication-evidence-metai 0 fn2-checkpoint-publication) 0)
       (= (fn2-checkpoint-publication-cold-metai 0 fn2-checkpoint-publication) 0)
       (= (fn2-checkpoint-bank-closures-capture-phasei 0 fn2-checkpoint-bank-closures) 0)
       ; Data may remain only behind invalidated ownership/READY metadata.
       (= (fn2-checkpoint-publication-cold-wordsi 32 fn2-checkpoint-publication) 444))
      fn2-checkpoint-publication fn2-checkpoint-bank-closures)))
(defun fn2-cbr-reset-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoint-publication
  (mv-let (answer fn2-checkpoint-publication)
   (with-local-stobj fn2-checkpoint-bank-closures
    (mv-let (answer fn2-checkpoint-publication fn2-checkpoint-bank-closures)
     (fn2-cbr-reset-body fn2-checkpoint-publication fn2-checkpoint-bank-closures)
     (mv answer fn2-checkpoint-publication)))
   answer)))
(assert-event (fn2-cbr-reset-test))

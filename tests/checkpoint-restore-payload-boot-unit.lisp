; Actual generated-core callback refusal controls. The resumed boot/semantic
; binding below is synthetic; no authenticated descriptor or successful cold
; bootstrap is claimed. Real pool windows carry sentinels before the callback.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/assembly-rows-b")
(include-book "../books/checkpoint-restore-payload-boot")
; Materialize the exact production callback macro over the sole registered
; core, without unrelated continuation/dispatch attachment qualification.
(fn2-boot-checkpoint-payload-operations)

(defun fn2-crpbu-observe (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))
             (fn2-checkpoint-payload (fn2-core-checkpoint-payload fn2-core))) (result)
  (list (fn2-pool-fill 0 fn2-pool) (fn2-pool-fill 1 fn2-pool) (fn2-pool-fill 2 fn2-pool)
        (fn2-checkpoint-payload-mode 0 fn2-checkpoint-payload)
        (fn2-checkpoint-payload-phase 0 fn2-checkpoint-payload)
        (fn2-checkpoint-payload-pending 0 fn2-checkpoint-payload)
        (fn2-checkpoint-payload-manifest-slot 0 fn2-checkpoint-payload)
        (fn2-checkpoint-payload-manifest-gen 0 fn2-checkpoint-payload)
        (fn2-checkpoint-payload-data-slot 0 fn2-checkpoint-payload)
        (fn2-checkpoint-payload-data-gen 0 fn2-checkpoint-payload)
        (fn2-checkpoint-payload-owner-gen 0 fn2-checkpoint-payload)) result))

(defun fn2-crpbu-body (variant fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (put-assoc-equal :image-boot t *fn2-profile-tiny*))
      (fn2-core (fn2-core-init profile fn2-core))
      (id (fn2-machine-kind-base *fn2-boot-kind* fn2-core))
      (ogen (fn2-machine-generation id fn2-core))
      ((mv root rgen manifest mgen data dgen fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
        (root rgen manifest mgen data dgen fn2-pool)
        (b* ((fn2-pool (fn2-pool-init '((3 . 4096)) 1 100 fn2-pool))
             ((mv & root rgen fn2-pool) (fn2-pool-reserve 0 *fn2-boot-kind* id ogen fn2-pool))
             ((mv & manifest mgen fn2-pool) (fn2-pool-reserve 0 *fn2-boot-kind* id ogen fn2-pool))
             ((mv & data dgen fn2-pool) (fn2-pool-reserve 0 *fn2-boot-kind* id ogen fn2-pool))
             ((mv & fn2-pool) (fn2-pool-write root rgen 0 71 *fn2-boot-kind* id ogen fn2-pool))
             ((mv & fn2-pool) (fn2-pool-write manifest mgen 0 72 *fn2-boot-kind* id ogen fn2-pool))
             ((mv & fn2-pool) (fn2-pool-write data dgen 0 73 *fn2-boot-kind* id ogen fn2-pool)))
         (mv root rgen manifest mgen data dgen fn2-pool))
        (mv root rgen manifest mgen data dgen fn2-core)))
      (fn2-core (fn2-boot-put-core id (phase *fn2-boot-state-checkpoint-payload-copy*)
        (checkpoint-index 0) (root-slot root) (root-gen rgen) (pool-slot manifest) (pool-gen mgen)
        (rx-slot data) (rx-gen dgen) (event-ready 1) (outcome *fn2-outcome-done*) (count 4096) (read-length 4096)))
      (fn2-core
       (stobj-let ((fn2-checkpoint-restore-semantic (fn2-core-checkpoint-restore-semantic fn2-core))
                   (fn2-checkpoint-payload (fn2-core-checkpoint-payload fn2-core)))
        (fn2-checkpoint-restore-semantic fn2-checkpoint-payload)
        (b* ((fn2-checkpoint-restore-semantic (fn2-checkpoint-restore-semantic-put 0
               (candidate 0) (slot root) (gen rgen) (owner-kind *fn2-boot-kind*) (owner-slot id) (owner-gen ogen)))
             (fn2-checkpoint-payload (fn2-checkpoint-payload-put 0
               (mode *fn2-checkpoint-payload-mode-cold*) (phase *fn2-checkpoint-payload-phase-wait-manifest*)
               (pending 1) (manifest-slot manifest) (manifest-gen mgen) (data-slot data) (data-gen dgen)
               (owner-kind *fn2-boot-kind*) (owner-slot id) (owner-gen ogen))))
         (mv fn2-checkpoint-restore-semantic fn2-checkpoint-payload)) fn2-core))
      (positive (fn2-boot-checkpoint-payload-bound-p id ogen *fn2-boot-state-checkpoint-payload-copy* fn2-core))
      ; Change one resumed identity component, leaving pending I/O explicit.
      (fn2-core (cond
        ((eq variant :manifest-generation) (fn2-boot-put-core id (pool-gen (+ 1 mgen))))
        ((eq variant :data-generation) (fn2-boot-put-core id (rx-gen (+ 1 dgen))))
        (t (stobj-let ((fn2-checkpoint-payload (fn2-core-checkpoint-payload fn2-core))) (fn2-checkpoint-payload)
             (fn2-checkpoint-payload-set-owner-gen 0 (+ 1 ogen) fn2-checkpoint-payload) fn2-core))))
      (before (fn2-crpbu-observe fn2-core))
      ((mv code fn2-core) (fn2-boot-checkpoint-payload-loaded id ogen fn2-core))
      ((mv mr mb) (fn2-core-read manifest mgen 0 *fn2-boot-kind* id ogen fn2-core))
      ((mv dr db) (fn2-core-read data dgen 0 *fn2-boot-kind* id ogen fn2-core)))
  (mv (and positive (eq code :state) (equal before (fn2-crpbu-observe fn2-core))
           (eq mr :ok) (equal mb 72) (eq dr :ok) (equal db 73)) fn2-core)))
(defun fn2-crpbu-test (variant)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (result fn2-core) (fn2-crpbu-body variant fn2-core) result)))
(assert-event (fn2-crpbu-test :manifest-generation))
(assert-event (fn2-crpbu-test :data-generation))
(assert-event (fn2-crpbu-test :owner-generation))

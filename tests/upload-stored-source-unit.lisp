; Actual upload B3 operations over the shared storage span selector.
; Source-only authored fixture; run in the composed certified world.
(in-package "ACL2")
(include-book "../books/owed-txn")

(defun fn2-uss-write (bytes slot gen off fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (if (atom bytes) (mv :ok fn2-core)
    (mv-let (code fn2-core) (fn2-core-write slot gen off (car bytes) *fn2-upload-kind* 0 1 fn2-core)
      (if (eq code :ok) (fn2-uss-write (cdr bytes) slot gen (+ 1 off) fn2-core) (mv code fn2-core)))))
(defun fn2-uss-read (n slot gen off fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (if (zp n) nil
    (cons (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (b)
            (mv-let (ok b) (fn2-gram-read slot gen off *fn2-upload-kind* 0 1 fn2-pool)
              (declare (ignore ok)) b) b)
          (fn2-uss-read (- n 1) slot gen (+ 1 off) fn2-core))))
(defun fn2-uss-drive (fuel done total ls lg ilen c0 g0 c1 g1 hashed fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (if (equal done total) (mv :ok fn2-core)
    (if (zp fuel) (mv :fuel fn2-core)
      (b* (((mv s g o n) (fn2-upload-store-span ls lg ilen c0 g0 c1 g1 done hashed fn2-core))
           ((unless (and (posp n) (<= n 4096) (<= (+ done n) total))) (mv :span fn2-core))
           ((mv code fn2-core) (fn2-upload-stored-hash 3 s g o done n (equal (+ done n) total)
                                                     ls lg *fn2-upload-kind* 0 1 fn2-core))
           ((unless (eq code :ok)) (mv code fn2-core)))
        (fn2-uss-drive (- fuel 1) (+ done n) total ls lg ilen c0 g0 c1 g1 hashed fn2-core)))))
(defun fn2-uss-fixture (prefix source fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-txn-posting-profile* fn2-core))
       ((mv a ls lg fn2-core) (fn2-core-reserve 1 *fn2-upload-kind* 0 1 fn2-core))
       ((mv b c0 g0 fn2-core) (fn2-core-reserve 1 *fn2-upload-kind* 0 1 fn2-core))
       ((mv c c1 g1 fn2-core) (fn2-core-reserve 1 *fn2-upload-kind* 0 1 fn2-core))
       ((unless (and (eq a :ok) (eq b :ok) (eq c :ok))) (mv :reserve fn2-core))
       (cap (fn2-upload-chunk-cap c0 fn2-core))
       ((mv a fn2-core) (fn2-uss-write prefix ls lg 0 fn2-core))
       ((mv b fn2-core) (fn2-uss-write (take (min cap (len source)) source) c0 g0 0 fn2-core))
       ((mv c fn2-core) (fn2-uss-write (nthcdr cap source) c1 g1 0 fn2-core))
       ((unless (and (eq a :ok) (eq b :ok) (eq c :ok))) (mv :write fn2-core))
       ((mv code fn2-core) (fn2-uss-drive 8 0 (+ (len prefix) (len source)) ls lg (len prefix)
                                            c0 g0 c1 g1 (len source) fn2-core))
       (got (fn2-uss-read 32 ls lg *fn2-upload-page-stored-source* fn2-core)))
    (mv (and (eq code :ok)
             (equal got (fn-blake3 (append prefix source)))
             (if (consp prefix) (not (equal got (fn-blake3 source))) t)) fn2-core)))
(defun fn2-uss-controls ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (answer fn2-core)
      (b* (((mv a fn2-core) (fn2-uss-fixture nil (make-list 17 :initial-element 65) fn2-core))
           ((mv b fn2-core) (fn2-uss-fixture '(77 73 68 13 10) (make-list 4097 :initial-element 66) fn2-core))
           ((mv c fn2-core) (fn2-uss-fixture '(77 73 69 13 10) (make-list 4097 :initial-element 66) fn2-core)))
        (mv (and a b c) fn2-core)) answer)))
(assert-event (fn2-uss-controls))

(defun fn2-cns-tall-read-drive (fuel calls fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel calls 0 fn2-core)
  (mv-let (code fn2-core) (fn2-read-next 0 256 fn2-core)
   (cond ((eq code :more) (fn2-cns-tall-read-drive (- fuel 1) (+ 1 (nfix calls)) fn2-core))
         ((eq code :entry)
          (mv-let (vc article) (fn2-read-value 0 *fn2-addr-entry-field-article* fn2-core)
           (mv (if (eq vc :ok) :entry vc) (+ 1 (nfix calls)) article fn2-core)))
         (t (mv code (+ 1 (nfix calls)) 0 fn2-core))))))
(defun fn2-cns-tall-runs-unit-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-cns-tall-profile* fn2-core))
      ((mv setup fn2-core) (fn2-cns-tall-runs-fixture fn2-core))
      ((unless (eq setup :ok)) (mv nil fn2-core))
      ((mv k0 fn2-core) (fn2-read-key 0 :lo *fn2-addr-entry-field-principal* 7 fn2-core))
      ((mv k1 fn2-core) (fn2-read-key 0 :lo *fn2-addr-entry-field-position* 100 fn2-core))
      ((mv k2 fn2-core) (fn2-read-key 0 :hi *fn2-addr-entry-field-principal* 7 fn2-core))
      ((mv k3 fn2-core) (fn2-read-key 0 :hi *fn2-addr-entry-field-position* 101 fn2-core))
      ((mv range fn2-core) (fn2-read-range 0 *fn2-addr-sid* *fn2-addr-entry-field-position* 101 fn2-core))
      ((mv first calls0 article0 fn2-core) (fn2-cns-tall-read-drive 64 0 fn2-core))
      ((mv next calls1 article1 fn2-core) (fn2-cns-tall-read-drive 8 64 fn2-core)))
  (mv (and (eq k0 :ok) (eq k1 :ok) (eq k2 :ok) (eq k3 :ok) (eq range :ok)
           (eq first :fuel) (equal calls0 64) (equal article0 0)
           (eq next :entry) (equal calls1 69) (equal article1 1000)) fn2-core)))
(defun fn2-cns-tall-runs-unit ()
 (with-local-stobj fn2-core
  (mv-let (good fn2-core) (fn2-cns-tall-runs-unit-body fn2-core) good)))
(assert-event (fn2-cns-tall-runs-unit))

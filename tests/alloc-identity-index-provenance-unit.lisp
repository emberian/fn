; Actual prepare/probe/adopt paths and explicit hypothesis removal. FORGED
; deliberately skips the actual probe; it is not an admitted recovery path.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/alloc-identity-index-invariant")
(include-book "alloc-identity-index-unit")
(defun fn2-aip-live-pair-p (i j fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (and (fn2-alloc-slotp i fn2-extents) (fn2-alloc-slotp j fn2-extents)
      (not (= (fn2-extents-state i fn2-extents) *fn2-extent-state-free*))
      (not (= (fn2-extents-state j fn2-extents) *fn2-extent-state-free*))
      (= (fn2-extents-epoch i fn2-extents) (fn2-extents-epoch j fn2-extents))
      (= (fn2-extents-counter i fn2-extents) (fn2-extents-counter j fn2-extents))))
(defun fn2-aip-body (forged fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (b* (((mv start fn2-extents) (fn2-aiu-start 2 fn2-extents))
      ((mv first fn2-extents) (fn2-aiu-adopt 0 0 0 fn2-extents))
      (idle (fn2-alloc-identity-maintained-p fn2-extents))
      ((mv prepared fn2-extents) (fn2-alloc-identity-prepare-adopt 7 2 3 4 1 *fn2-alloc-none*
                                  (if forged 0 1) (if forged 0 1) fn2-extents))
      (captured (fn2-alloc-identity-maintained-p fn2-extents)))
  (if forged
   (b* ((fn2-extents (fn2-alloc-identity-ready 1 fn2-extents))
        (before (and (fn2-alloc-identity-refines-p fn2-extents)
                     (not (fn2-alloc-identity-maintained-p fn2-extents))))
        ((mv code fn2-extents) (fn2-alloc-identity-commit-adopt 7 2 3 4 fn2-extents)))
    (mv (and start first idle (eq prepared :more) captured before (eq code :ok)
             (fn2-extentsp fn2-extents) (fn2-extents-wfp fn2-extents)
             (fn2-aip-live-pair-p 0 1 fn2-extents) (not (= 0 1))
             (not (fn2-alloc-identity-refines-p fn2-extents))
             (not (fn2-alloc-invp fn2-extents))) fn2-extents))
   (b* (((mv probed1 fn2-extents) (fn2-alloc-identity-step 7 2 3 4 fn2-extents))
        (prefix (fn2-alloc-identity-maintained-p fn2-extents))
        ((mv probed2 fn2-extents) (fn2-alloc-identity-step 7 2 3 4 fn2-extents))
        (ready (fn2-alloc-identity-maintained-p fn2-extents))
        ((mv code fn2-extents) (fn2-alloc-identity-commit-adopt 7 2 3 4 fn2-extents)))
    (mv (and start first idle (eq prepared :more) captured (eq probed1 :more) prefix
             (eq probed2 :ready) ready (eq code :ok) (fn2-alloc-identity-maintained-p fn2-extents)
             ; Whole injectivity antecedent/conclusion for a legal same-row alias.
             (fn2-alloc-identity-refines-p fn2-extents) (fn2-aip-live-pair-p 1 1 fn2-extents)
             (= 1 1) (fn2-alloc-invp fn2-extents)) fn2-extents)))))
(defun fn2-aip-run (forged)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-extents
  (mv-let (answer fn2-extents) (fn2-aip-body forged fn2-extents) answer)))
(assert-event (fn2-aip-run nil))
(assert-event (fn2-aip-run t))

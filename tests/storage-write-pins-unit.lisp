(in-package "ACL2")
(include-book "read-pins-unit")

(defun fn2-write-pin-test-reserve (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core)))
  (ok extent epoch allocation fn2-extents)
  (b* (((mv begin fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
       ((mv reserved & extent epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents)))
   (mv (and (eq begin :ok) (eq reserved :ok)) extent epoch allocation fn2-extents))
  (mv ok extent epoch allocation fn2-core)))
(defun fn2-write-pin-test-fill (left at slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen at 0 1 0 1 fn2-core)
   (if (eq code :ok)
       (fn2-write-pin-test-fill (- left 1) (+ at 1) slot gen fn2-core)
     (mv code fn2-core)))))
(defun fn2-write-pin-test-cancel (extent epoch allocation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
             (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
  (code invariant fn2-extents)
  (mv-let (code fn2-extents) (fn2-alloc-cancel-reservation extent epoch allocation fn2-extents)
   (mv code (fn2-alloc-ownership-invp fn2-extents fn2-alloc-edges) fn2-extents))
  (mv code invariant fn2-core)))
(defun fn2-write-pin-test-post (op gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (fn2-ops)
  (fn2-post-result 0 op gen *fn2-event-write-result* *fn2-outcome-failed* *fn2-reason-io* 0 0 0 fn2-ops)
  fn2-core))

; The actual reserved-unit write must block cancellation through ACK and stale
; completion. A matching failed completion excludes physical access and allows
; cancellation; neither success nor failure is a journal durability assertion.
(defun fn2-write-pin-test-body (omit allocatedp fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      ((mv ready extent epoch allocation fn2-core)
       (if allocatedp (fn2-read-pin-test-allocate fn2-core) (fn2-write-pin-test-reserve fn2-core)))
      ((unless ready) (mv nil fn2-core))
      (class (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (class)
               (fn2-pool-class-for 4096 fn2-pool) class))
      ((unless class) (mv nil fn2-core))
      ((mv pool slot gen fn2-core) (fn2-core-reserve class 1 0 1 fn2-core))
      ((unless (eq pool :ok)) (mv nil fn2-core))
      ((mv filled fn2-core) (fn2-write-pin-test-fill 4096 0 slot gen fn2-core))
      ((unless (eq filled :ok)) (mv nil fn2-core))
      ((mv issued op og fn2-core)
       (fn2-block-write (* extent *fn2-commit-write-resources*) epoch allocation 0 4096 slot gen 0 1 0 1 0 fn2-core))
      ((when allocatedp)
       (mv (and (eq issued :bounds) (not (fn2-core-stopped-p fn2-core))
                (equal (fn2-b-outbox fn2-core) nil)) fn2-core))
      ((unless (eq issued :ok)) (mv nil fn2-core))
      ((mv blocked invariant fn2-core) (fn2-write-pin-test-cancel extent epoch allocation fn2-core))
      ((unless (and invariant (eq blocked :outstanding-io))) (mv nil fn2-core))
      ((when omit)
       (b* (((mv removed fn2-core)
             (fn2-core-alloc-edges-harvest op og 0 *fn2-event-write-result*
               *fn2-outcome-failed* *fn2-reason-io* 0 0 0 fn2-core))
            ((mv cancelled invariant fn2-core) (fn2-write-pin-test-cancel extent epoch allocation fn2-core)))
        (mv (and (eq removed :ok) invariant (eq cancelled :ok)) fn2-core)))
      ((mv ack fn2-core) (fn2-read-pin-test-ack fn2-core))
      ((mv blocked invariant fn2-core) (fn2-write-pin-test-cancel extent epoch allocation fn2-core))
      ((unless (and (eq ack :ok) invariant (eq blocked :outstanding-io))) (mv nil fn2-core))
      (fn2-core (fn2-write-pin-test-post op (+ 1 og) fn2-core))
      ((mv stray & & & & & & & & & fn2-core) (fn2-harvest-one fn2-core))
      ((mv blocked invariant fn2-core) (fn2-write-pin-test-cancel extent epoch allocation fn2-core))
      ((unless (and (not stray) invariant (eq blocked :outstanding-io))) (mv nil fn2-core))
      (fn2-core (fn2-write-pin-test-post op og fn2-core))
      ((mv delivered & & & & & & & & & fn2-core) (fn2-harvest-one fn2-core))
      ((mv cancelled invariant fn2-core) (fn2-write-pin-test-cancel extent epoch allocation fn2-core)))
  (mv (and delivered invariant (eq cancelled :ok) (not (fn2-core-stopped-p fn2-core))) fn2-core)))
(defun fn2-write-pin-test (omit allocatedp)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core) (fn2-write-pin-test-body omit allocatedp fn2-core) answer)))
(assert-event (fn2-write-pin-test nil nil))
(assert-event (fn2-write-pin-test t nil))
(assert-event (fn2-write-pin-test nil t))

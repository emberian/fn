; Exact mapped-row metadata controls. These prepared rows are synthetic source
; premises, not publication/rebase evidence. No base advance or reuse is enabled.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/commit-directory")
(defun fn2-cdu-body (fn2-commit-root)
 (declare (xargs :stobjs fn2-commit-root :verify-guards nil))
 (b* ((fn2-commit-root (fn2-commit-root-init 3 fn2-commit-root))
      (fn2-commit-root (fn2-commit-root-put 0 (installed 5) (published 5) (proposed 5)))
      ; Batch5 aliases batch1's physical row. Only its actual tag is admitted.
      (fn2-commit-root (fn2-commit-root-put 1 (parent 4) (seal-ready 1) (extent 7) (first-key 101) (members 3)))
      ((mv ok row) (fn2-commit-directory-lookup 5 fn2-commit-root))
      ((mv seal digest) (fn2-commit-directory-seal-slot 5 9 fn2-commit-root))
      ((mv stale stale-row) (fn2-commit-directory-lookup 1 fn2-commit-root))
      ((mv absent absent-row) (fn2-commit-directory-lookup 6 fn2-commit-root))
      ((mv genesis genesis-row) (fn2-commit-directory-lookup 0 fn2-commit-root))
      (fn2-commit-root (fn2-commit-root-put 1 (seal-ready 0)))
      ((mv unready unready-row) (fn2-commit-directory-lookup 5 fn2-commit-root))
      (fn2-commit-root (fn2-commit-root-put 0 (base-batch 3) (base-event 100)))
      ((mv unproved unproved-row) (fn2-commit-directory-lookup 3 fn2-commit-root)))
  (mv (and (eq ok :ok) (= row 1) (eq seal :ok) (= digest (+ (* *fn2-digest-stride* 9) row))
       (eq stale :stale) (= stale-row 0) (eq absent :absent) (= absent-row 0)
       (eq genesis :base) (= genesis-row 0) (eq unready :stale) (= unready-row 0)
       (eq unproved :state) (= unproved-row 0)) fn2-commit-root)))
(defun fn2-cdu-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-commit-root (mv-let (ok fn2-commit-root) (fn2-cdu-body fn2-commit-root) ok)))
(assert-event (fn2-cdu-run))

; Absolute C may greatly exceed the runtime directory's physical row count.
(defun fn2-cdu-terminal-body (fn2-commit-root)
 (declare (xargs :stobjs fn2-commit-root :verify-guards nil))
 (b* ((fn2-commit-root (fn2-commit-root-init 4 fn2-commit-root))
      (genesis (fn2-commit-directory-recovery-terminal-p 0 fn2-commit-root))
      (fn2-commit-root (fn2-commit-root-put 0 (base-batch 120) (base-ready 1)
       (installed 120) (published 120) (proposed 122)))
      (fn2-commit-root (fn2-commit-root-put 2 (parent 121) (members 1) (seal-ready 1)))
      (suffix (fn2-commit-directory-recovery-terminal-p 122 fn2-commit-root))
      (moving (not (fn2-commit-directory-recovery-terminal-p 123 fn2-commit-root)))
      (fn2-commit-root (fn2-commit-root-put 2 (parent 118)))
      (stale (not (fn2-commit-directory-recovery-terminal-p 122 fn2-commit-root)))
      (fn2-commit-root (fn2-commit-root-put 0 (proposed 124)))
      (window (not (fn2-commit-directory-recovery-terminal-p 124 fn2-commit-root))))
  (mv (and genesis suffix moving stale window) fn2-commit-root)))
(defun fn2-cdu-terminal ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-commit-root) (fn2-cdu-terminal-body fn2-commit-root)))
(assert-event (fn2-cdu-terminal))

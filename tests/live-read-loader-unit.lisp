; Prepared, unexecuted selector controls. Cursor MISS/source provenance is a
; synthetic post-constructor premise; no disk, catalog or serving claim follows.
(in-package "ACL2")
(include-book "../books/machines-c-read-loader")
(include-book "std/util/bstar" :dir :system)
(defconst *fn2-lrl-stobjs*
 '(fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors fn2-c-source-control fn2-c-source-readers))
(defmacro fn2-lrl-mv (answer) `(mv ,answer ,@*fn2-lrl-stobjs*))
(defun fn2-lrl-nest (n body)
 (declare (xargs :verify-guards nil :measure (nfix n)))
 (if (zp n) body
  (fn2-lrl-nest (- n 1)
   `(with-local-stobj ,(nth (- n 1) *fn2-lrl-stobjs*)
     (mv-let (answer ,@(take n *fn2-lrl-stobjs*)) ,body
      ,(if (equal n 1) 'answer `(mv answer ,@(take (- n 1) *fn2-lrl-stobjs*))))))))
(defmacro fn2-lrl-with (body) (fn2-lrl-nest (len *fn2-lrl-stobjs*) body))
(defun fn2-lrl-body (fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors fn2-c-source-control fn2-c-source-readers)
 (declare (xargs :stobjs (fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors fn2-c-source-control fn2-c-source-readers) :verify-guards nil))
 (b* ((fn2-reads (fn2-reads-init 1 fn2-reads))
      (fn2-id-decides (fn2-id-decides-init 1 fn2-id-decides))
      (fn2-succ-txns (fn2-succ-txns-init 2 fn2-succ-txns))
      (fn2-ranges (fn2-ranges-init 1 fn2-ranges))
      (fn2-range-sources (fn2-range-sources-init *fn2-read-sources* fn2-range-sources))
      (fn2-run-cursors (fn2-run-cursors-init (+ 2 *fn2-read-sources*) fn2-run-cursors))
      (fn2-c-source-control (fn2-c-source-control-init 1 fn2-c-source-control))
      (fn2-c-source-readers (fn2-c-source-readers-init 1 fn2-c-source-readers))
      ((mv admission receipt fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-acquire 0 0 fn2-c-source-control fn2-c-source-readers))
      (fn2-reads (fn2-reads-put 0 (observer-serial receipt) (op *fn2-read-op-lookup*) (sid 3)))
      (fn2-succ-txns (fn2-succ-txns-put 1 (lphase *fn2-succ-lookup-scan*) (lrow 4)))
      (fn2-run-cursors (fn2-run-cursors-put 1 (physical 1) (phase *fn2-run-cursor-phase-miss*) (schema 3) (source-row 4)))
      ((mv lookup c0) (fn2-read-loader-selected 0 fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors fn2-c-source-readers))
      (fn2-run-cursors (fn2-run-cursors-set-source-row 1 5 fn2-run-cursors))
      ((mv mismatch &) (fn2-read-loader-selected 0 fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors fn2-c-source-readers))
      (fn2-reads (fn2-reads-set-op 0 *fn2-read-op-range* fn2-reads))
      (fn2-ranges (fn2-ranges-put 0 (phase *fn2-range-phase-seek*) (schema 3) (sbase 0) (cbase 2) (scount 1)))
      (fn2-range-sources (fn2-range-sources-put 0 (kind *fn2-range-kind-run*) (cursor 2) (src 6)))
      (fn2-run-cursors (fn2-run-cursors-put 2 (physical 1) (phase *fn2-run-cursor-phase-miss*) (schema 3) (source-row 6)))
      ((mv range c1) (fn2-read-loader-selected 0 fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors fn2-c-source-readers))
      ((mv released & & fn2-c-source-control fn2-c-source-readers)
       (fn2-c-source-reader-release 0 receipt fn2-c-source-control fn2-c-source-readers))
      ((mv expired &) (fn2-read-loader-selected 0 fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors fn2-c-source-readers)))
  (fn2-lrl-mv (and (eq admission :ok) (eq lookup :ok) (equal c0 1) (eq mismatch :source)
                   (eq range :ok) (equal c1 2) (eq released :ok) (eq expired :bounds)))))
(assert-event (fn2-lrl-with (fn2-lrl-body fn2-reads fn2-id-decides fn2-succ-txns fn2-ranges fn2-range-sources fn2-run-cursors fn2-c-source-control fn2-c-source-readers)))

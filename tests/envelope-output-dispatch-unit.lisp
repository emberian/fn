(in-package "ACL2")
(include-book "../sim/envelope-output-dispatch")
(defun fn2-eo-dispatch-witness (segment peer following corrupt-row)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-envelope-output-state
  (mv-let (ok fn2-envelope-output-state)
   (let* ((segments (list segment '(:exact 9)))
          (row (fn2-eo-language-row following peer))
          (expected (fn2-eo-language-row (cons segment following) peer))
          (fn2-envelope-output-state (update-fn2-eo-phase 5 fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-peer peer fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-segments segments fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-row (if corrupt-row nil row) fn2-envelope-output-state))
          (antecedent
           (and (equal (fn2-eo-phase fn2-envelope-output-state) 5)
                (consp (fn2-eo-segments fn2-envelope-output-state))
                (fn2-eo-segments-p (fn2-eo-segments fn2-envelope-output-state))
                (fn2-eo-octets-p (fn2-eo-peer fn2-envelope-output-state))
                (fn2-eo-segments-p following)
                (equal (fn2-eo-row fn2-envelope-output-state)
                       (fn2-eo-language-row following (fn2-eo-peer fn2-envelope-output-state)))))
          (fuel (+ 1 (+ 1 (len (cdr segment)))
                     (+ 1 (* (len (cdr segment)) (+ 4 (len peer) (len peer))))))
          (fn2-envelope-output-state (fn2-envelope-output-run fuel fn2-envelope-output-state)))
    (mv (and (equal (fn2-eo-phase fn2-envelope-output-state) 5)
             (equal (fn2-eo-segments fn2-envelope-output-state) (cdr segments))
             (equal (fn2-eo-peer fn2-envelope-output-state) peer)
             (if corrupt-row
                 (and (not antecedent) (not (equal (fn2-eo-row fn2-envelope-output-state) expected)))
               (and antecedent (equal (fn2-eo-row fn2-envelope-output-state) expected))))
        fn2-envelope-output-state)) ok)))
(assert-event
 (and (fn2-eo-dispatch-witness '(:exact 1 2) '(1 2 3) '((:exact 3)) nil)
      (fn2-eo-dispatch-witness '(:prefix 1) '(2) '((:exact 2)) nil)
      (fn2-eo-dispatch-witness '(:exact) '(3) '((:exact 3)) nil)
      (fn2-eo-dispatch-witness '(:prefix) nil nil nil)
      (fn2-eo-dispatch-witness '(:exact 1) nil nil nil)))
(assert-event (fn2-eo-dispatch-witness '(:prefix 1) '(2) '((:exact 2)) t))

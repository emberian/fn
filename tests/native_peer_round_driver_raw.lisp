(defun local-fixture ()
  (let* ((runtime (%make-fnn-pull-runtime :service :recorded :lock (sb-thread:make-mutex)))
         (flight (%make-fnn-pull-flight :runtime runtime :cid 9 :input (fnn-octets '(1 2 3))
                                       :io :local))
         (steps 0) (polls 0) (renders 0) (callback nil) (unpins 0) (abandoned nil))
    (setf (symbol-function 'fnn-owner-peer-read-class) (lambda (service) (declare (ignore service)) :transit)
          (symbol-function 'fnn-owner-handle-chunk-step)
          (lambda (&rest args)
            (declare (ignore args))
            (case (incf steps) (1 (values :cold :page))
              (2 (values :await :step :redeem nil nil 2))
              (3 (values nil nil nil 1 nil))
              (t (error "unexpected local input replay"))))
          (symbol-function 'fnn-owner-cold-poll)
          (lambda (&rest args) (declare (ignore args))
            (if (= (incf polls) 1) (values '(:wait 10) 1 2 nil)
              (values :serve 1 3 nil)))
          (symbol-function 'fnn-owner-await-register)
          (lambda (service cid deliver socket) (declare (ignore service cid socket))
            (setq callback deliver) nil)
          (symbol-function 'fnn-owner-render-next-quantum)
          (lambda (&rest args) (declare (ignore args))
            (if (= (incf renders) 1) (values (fnn-octets '(82)) :rest nil nil)
              (values (fnn-octets '(83)) nil t nil)))
          (symbol-function 'fnn-owner-response-unpin)
          (lambda (&rest args) (declare (ignore args)) (incf unpins))
          (symbol-function 'fnn-owner-await-abandon)
          (lambda (&rest args) (declare (ignore args)) (setq abandoned t))
          (symbol-function 'fnn-owner-action) (lambda (&rest args) (declare (ignore args)) nil))
    (fnn-pull-flight-local-step flight) ; cold issue, input untouched
    (fnn-pull-flight-local-step flight) ; readiness wait, input untouched
    (driver-check (equal (fnn-octet-list (fnn-pull-flight-input flight)) '(1 2 3))
                  "cold readiness must retain exact input")
    (fnn-pull-flight-local-step flight) ; cold ready
    (fnn-pull-flight-local-step flight) ; submit, consumes prefix
    (driver-check (and (fnn-pull-flight-await flight)
                       (equal (fnn-octet-list (fnn-pull-flight-input flight)) '(3)))
                  "submitted prefix must not consume or replay the suffix")
    (driver-check (eq (fnn-pull-flight-local-step flight) :wait) "commit wait must yield")
    (funcall callback '(78))
    (fnn-pull-flight-local-step flight) ; completion -> actual ACL2 plan leaf
    (fnn-pull-flight-local-step flight) ; first render quantum
    (driver-check (and (= renders 1) (fnn-pull-flight-render flight)) "render must retain continuation")
    (fnn-pull-flight-local-step flight) ; last render
    (fnn-pull-flight-local-step flight) ; consume suffix once
    (fnn-pull-flight-local-step flight) ; publish ordered local reply
    (driver-check (and (= steps 3) (= renders 2) (= unpins 2)
                       (equal (fnn-pull-flight-events flight) '((:local 82 83)))
                       (null (fnn-pull-flight-io flight)))
                  "local continuation must preserve ordered bytes and release response pin")
    ;; Reopened flight rejects a callback captured for the retired await.
    (setf (fnn-pull-flight-await flight) (list :next :redeem))
    (fnn-pull-flight-close-local flight)
    (funcall callback '(99))
    (driver-check (and abandoned (null (fnn-pull-flight-completion flight)))
                  "abandoned callback must not publish into a later local connection")
    (format t "~&PEER_ROUND_DRIVER_PASS local~%")))
(defun io-fixture ()
  (let ((listener (make-instance 'sb-bsd-sockets:inet-socket :type :stream :protocol :tcp))
        (client nil) (server nil) (refused nil))
    (unwind-protect
         (progn
           (sb-bsd-sockets:socket-bind listener #(127 0 0 1) 0)
           (sb-bsd-sockets:socket-listen listener 1)
           (multiple-value-bind (address port) (sb-bsd-sockets:socket-name listener)
             (multiple-value-bind (socket word) (fnn-connect-start address port)
               (setq client socket)
               (unless (eq word :connected)
                 (loop repeat 100 until (eq (fnn-connect-poll client) :connected) do (sleep .001))))
             (setq server (sb-bsd-sockets:socket-accept listener))
             (let* ((fd (fnn-socket-fd client)) (sfd (fnn-socket-fd server))
                    (data (fnn-octets (loop for i below 2000 collect (mod i 256))))
                    (offset 0) (got nil))
               (driver-check (eq (fnn-socket-read-now fd 512) :wait) "idle read must yield without EOF")
               (loop while (< offset (length data)) do
                 (let* ((end (fn-prd-write-end offset (length data)))
                        (written (fnn-socket-write-now fd data offset end)))
                   (driver-check (integerp written) "loopback write made no progress")
                   (incf offset written)
                   (loop while (< (length got) offset) do
                     (unless (sb-sys:wait-until-fd-usable sfd :input 1)
                       (error "kernel loopback readiness was unavailable"))
                     (let ((part (fnn-socket-read-now sfd 512)))
                       (when (vectorp part)
                         (driver-check (plusp (length part)) "loopback closed before all bytes arrived")
                         (setq got (append got (fnn-octet-list part))))))))
               (driver-check (equal got (fnn-octet-list data)) "bounded writes must preserve all octets")
               (let ((*fnn-read-syscall* (lambda (&rest args) (declare (ignore args))
                                          (values nil sb-posix:eintr))))
                 (driver-check (eq (fnn-socket-read-now fd 512) :wait) "interrupted read must yield once")))
             (fnn-socket-shut listener)
             (multiple-value-bind (socket word) (fnn-connect-start address port)
               (declare (ignore word)) (setq refused socket)
               (driver-check (loop repeat 100 thereis
                              (handler-case (progn (fnn-connect-poll refused) (sleep .001) nil)
                                (fnn-os-error () t)))
                             "refused connect must retain a named OS failure")))
           (format t "~&PEER_ROUND_DRIVER_PASS io~%"))
      (dolist (socket (list client server refused listener)) (when socket (fnn-socket-shut socket))))))
(defun cleanup-fixture ()
  (let* ((runtime (%make-fnn-pull-runtime :service :recorded :lock (sb-thread:make-mutex)))
         (flight (%make-fnn-pull-flight :runtime runtime :cid 9 :cold (list :page nil 1)
                                       :await (list :step :redeem)))
         (awaited nil) (unpinned nil) (closed nil))
    (setf (symbol-function 'fnn-owner-cold-abandon)
          (lambda (read) (declare (ignore read)) (fnn-indeterminate "late cold escape"))
          (symbol-function 'fnn-owner-await-abandon)
          (lambda (&rest args) (declare (ignore args)) (setq awaited t))
          (symbol-function 'fnn-owner-response-unpin)
          (lambda (&rest args) (declare (ignore args)) (setq unpinned t) (fnn-fault "unpin escape"))
          (symbol-function 'fnn-owner-action)
          (lambda (&rest args) (declare (ignore args)) (setq closed t)))
    (driver-check (handler-case (progn (fnn-pull-flight-dispose flight) nil)
                    (fnn-store-indeterminate () t))

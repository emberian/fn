(defun driver-check (test message)
  (unless test (format t "~&ROUND_DRIVER_ASSERTION:~a~%" message) (finish-output)
    (error "driver assertion: ~a" message)))
(defun fnn-pull-monotonic ()
  (floor (* 1000 (get-internal-real-time)) internal-time-units-per-second))
(defun fnn-pull-stoppingp (runtime)
  (declare (ignore runtime))
  (> (- (get-internal-real-time) *started*) (/ internal-time-units-per-second 2)))
(defun fnn-owner-transit-serialized (service cid thunk)

      (tag (fn2-checkpoint-restore-arena-control-tag 0 fn2-checkpoint-restore-arena-control))
      ((mv reset fn2-pool) (fn2-pool-reset slot gen 7 0 1 fn2-pool))
      ((mv zeroed fn2-pool) (fn2-run-zero 65536 slot gen 0 7 0 1 fn2-pool))
      ((mv packed fn2-fields fn2-pool) (fn2-crau-pack 0 (if (eq mode :allocated) 2 1)
        (if (eq mode :epoch) 5 4) (cond ((eq mode :allocation) 99) ((eq mode :allocated) 32) (t 31)) (eq mode :malformed) slot gen fn2-fields fn2-pool))
      ((mv second-packed fn2-fields fn2-pool)
       (if (eq mode :duplicate) (fn2-crau-pack 1 1 4 31 nil slot gen fn2-fields fn2-pool) (mv :ok fn2-fields fn2-pool)))
      (total (if (eq mode :duplicate) 2 1))
      (fn2-checkpoint-restore-reader (fn2-checkpoint-restore-reader-init 1 fn2-checkpoint-restore-reader))
      (fn2-checkpoint-restore-reader (fn2-checkpoint-restore-reader-put 0
        (phase *fn2-checkpoint-restore-reader-phase-entries*) (candidate (if (eq mode :candidate) 1 0))
        (role 5) (ordinal 0) (entry-ordinal 0) (total total) (total-known 1) (first 0) (count total)
        (retired-head *fn2-alloc-none*) (retired-count 0)
        (padding (+ *fn2-checkpoint-map-entries-start* (* total *fn2-checkpoint-arena-entry-width*)))
        (slot slot) (gen gen) (owner-kind 7) (owner-slot 0) (owner-gen 1) (field-base 0) (has-next 0)))
      ((mv early fn2-checkpoint-restore-arena-control)
       (fn2-checkpoint-restore-arena-finish fn2-checkpoint-restore-reader fn2-checkpoint-restore-map-control fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-control))
      ((mv first fn2-checkpoint-restore-reader fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control fn2-fields)
       (fn2-checkpoint-restore-arena-consume fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control fn2-fields fn2-pool))
      ((mv last fn2-checkpoint-restore-reader fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control fn2-fields)
       (if (eq mode :duplicate)
        (fn2-checkpoint-restore-arena-consume fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control fn2-fields fn2-pool)
        (mv first fn2-checkpoint-restore-reader fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control fn2-fields)))
      (prefix (and map-ready (eq stale-map :map) begin-frame (eq begun :ok) (posp tag)
                   (eq reset :ok) (eq zeroed :ok) (eq packed :ok) (eq second-packed :ok) (eq early :coverage)))
      ((when mode)
       (mv (and prefix (eq last (case mode (:candidate :coverage) (:malformed :format) (otherwise :identity)))
                (if (eq mode :duplicate) (eq first :entry) t)
                (equal (fn2-checkpoint-restore-reader-entry-ordinal 0 fn2-checkpoint-restore-reader) (if (eq mode :duplicate) 1 0))
                (equal (fn2-checkpoint-restore-arena-control-cursor 0 fn2-checkpoint-restore-arena-control) (if (eq mode :duplicate) 1 0))
                (equal (fn2-checkpoint-restore-arena-tag 0 fn2-checkpoint-restore-arena) (if (eq mode :duplicate) tag 0))
                (equal (fn2-checkpoint-restore-arena-tag 1 fn2-checkpoint-restore-arena) 0))
           fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control fn2-fields fn2-pool))
      ((mv padded fn2-checkpoint-restore-reader) (fn2-cru-map-padding 18 fn2-checkpoint-restore-reader fn2-pool))
      ((mv terminal fn2-checkpoint-restore-reader fn2-pool) (fn2-checkpoint-restore-reader-next-page fn2-checkpoint-restore-reader fn2-pool))
      ((mv finished fn2-checkpoint-restore-arena-control) (fn2-checkpoint-restore-arena-finish fn2-checkpoint-restore-reader fn2-checkpoint-restore-map-control fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-control))
      ((mv target extent epoch allocation) (fn2-checkpoint-restore-arena-target 0 0 fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-control fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control))
      ((mv end & & &) (fn2-checkpoint-restore-arena-target 0 1 fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-control fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control))
      ((mv beyond & & &) (fn2-checkpoint-restore-arena-target 0 2 fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-control fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control))
      ((mv wrong & & &) (fn2-checkpoint-restore-arena-target 1 0 fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-control fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control))

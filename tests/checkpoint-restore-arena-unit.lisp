(defun fn2-crau-pack (ordinal extent epoch allocation malformed slot gen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (b* ((off (+ *fn2-checkpoint-map-entries-start* (* ordinal *fn2-checkpoint-arena-entry-width*)))
      (fn2-fields (fn2-fields-set-value *fn2-format-recovery-arena-entry-field-extent-physical-unit* (* extent *fn2-storage-extent-units*) fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-recovery-arena-entry-field-writer-epoch* epoch fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-recovery-arena-entry-field-allocation* allocation fn2-fields))
      ((mv code end fn2-pool) (fn2-format-recovery-arena-entry-encode 0 slot gen off 7 0 1 fn2-fields fn2-pool))
      ((unless (eq code :ok)) (mv code fn2-fields fn2-pool))
      ((mv code fn2-pool) (if malformed (fn2-pool-write slot gen end 173 7 0 1 fn2-pool) (mv :ok fn2-pool))))
  (mv code fn2-fields fn2-pool)))

(defun fn2-crau-body (mode fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control
                     fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control
                          fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control fn2-fields fn2-pool) :verify-guards nil))
 (b* (((mv map-ready fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool)
       (fn2-cru-map-body nil fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-fields fn2-pool))
      (fn2-checkpoint-restore-arena (fn2-checkpoint-restore-arena-init 6 fn2-checkpoint-restore-arena))
      (fn2-checkpoint-restore-arena-marks (fn2-checkpoint-restore-arena-marks-init 6 fn2-checkpoint-restore-arena-marks))
      (fn2-checkpoint-restore-arena-control (fn2-checkpoint-restore-arena-control-init 1 fn2-checkpoint-restore-arena-control))
      ((mv stale-map fn2-checkpoint-restore-arena-control)
       (fn2-checkpoint-restore-arena-begin 1 fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control))
      (begin-frame (equal (fn2-checkpoint-restore-arena-control-tag 0 fn2-checkpoint-restore-arena-control) 0))
      ((mv begun fn2-checkpoint-restore-arena-control)
       (fn2-checkpoint-restore-arena-begin 0 fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control))
      (slot (fn2-checkpoint-restore-reader-slot 0 fn2-checkpoint-restore-reader))

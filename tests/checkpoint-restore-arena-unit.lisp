      ((mv stale-tag & & &) (fn2-checkpoint-restore-arena-target 0 0 fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-control fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control)))
  (mv (and prefix (eq first :entry) (eq last :entry) (eq padded :page-end) (eq terminal :done) (eq finished :arena-ready)
           (eq target :target) (equal extent 1) (equal epoch 4) (equal allocation 31)
           (eq end :end) (eq beyond :state) (eq wrong :state) (eq stale-tag :state))
      fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control fn2-fields fn2-pool)))
(defun fn2-crau-test (mode)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control
                      fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control fn2-fields fn2-pool)
  (fn2-crau-body mode fn2-checkpoint-restore-reader fn2-checkpoint-restore-map fn2-checkpoint-restore-map-control
    fn2-checkpoint-restore-arena fn2-checkpoint-restore-arena-marks fn2-checkpoint-restore-arena-control fn2-fields fn2-pool)))

;;; Run with sbcl --script tests/native-control-parser.lisp from repo root.
;;; Load only the actual control functions; no ACL2 world or sockets needed.
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(defstruct fn2-nhost (control-text "") sync stop)
(with-open-file (source "host/adapter.lisp")
  (loop for form = (read source nil nil) while form
        when (and (consp form) (eq (car form) 'defun)
                  (member (cadr form) '(fn2-n-control-numbers fn2-n-control-line fn2-n-control-octet)))
          do (eval form)))
(defun feed (host text)
  (map nil (lambda (c) (fn2-n-control-octet host (char-code c))) text))
(defun refused (thunk)
  (handler-case (progn (funcall thunk) nil) (error () t)))
(let ((host (make-fn2-nhost)))
  (feed host "sy")
  (feed host "nc 12345 1234567890 0")
  (assert (null (fn2-nhost-sync host)))
  (feed host (format nil "~C~%open 54321~%" #\Return))
  (assert (equal (fn2-nhost-sync host) '(54321 0 0 t)))
  (feed host (format nil "sync 123 42 1~%"))
  (assert (equal (fn2-nhost-sync host) '(123 42 1 nil)))
  (feed host (format nil "stop~%"))
  (assert (fn2-nhost-stop host)))
(defvar *executed* nil)
(dolist (text '("open #.(setf *executed* t)" "open (123)" "open 123 456"
                "sync 1 2" "sync 1 2 3 4" "open -1" "open +1" "open 1/2"
                "open 123456789012345678901"))
  (assert (refused (lambda () (feed (make-fn2-nhost) (format nil "~A~%" text))))))
(assert (not *executed*))
(let ((host (make-fn2-nhost)))
  (feed host (make-string 96 :initial-element #\Space))
  (assert (refused (lambda () (feed host "x"))))
  (assert (= (length (fn2-nhost-control-text host)) 96)))
(format t "Native control: fragmented/multiline inputs, reader syntax and bounds controls passed.~%")

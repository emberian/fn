(assert-event
 (equal (fn2-piu-mutation-result :receipt-evidence)
  '(:ok :stored :state t :inconsistent t t t
    (:ok :end :ok) (:ok :end :ok) (:ok :end :ok) (:ok :end :ok))))
(assert-event

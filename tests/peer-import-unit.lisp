(defconst *fn2-piu-profile*
 (put-assoc-equal :identity-overlays 24
  (put-assoc-equal :identity-arena-bytes 4096
   (put-assoc-equal :pool-classes '((8 . 64) (4 . 256) (40 . 4096)) *fn2-profile-tiny*))))
(defun fn2-piu-write (n byte slot gen off fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (if (zp n) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen off byte 5 1 1 fn2-core)
   (if (eq code :ok) (fn2-piu-write (- n 1) byte slot gen (+ off 1) fn2-core) (mv code fn2-core)))))

   (fn2-fields (fn2-fields-put 20 (value 1) (ref-slot ds) (ref-gen dg) (ref-off 0) (ref-len 32)))
   (fn2-fields (fn2-fields-put 21 (value 91) (ref-len 0)))
   (fn2-fields (fn2-fields-put 22 (value 92) (ref-len 0)))

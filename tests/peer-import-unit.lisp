(assert-event
 (equal (fn2-piu-mutation-result :domain)
  '(:ok :stored :state t :state t t t
    (:ok :end :ok) (:ok :end :ok) (:ok :end :ok) (:ok :end :ok))))
(assert-event
 (equal (fn2-piu-mutation-result :incarnation)
  '(:ok :stored :state t :state t t t
    (:ok :end :ok) (:ok :end :ok) (:ok :end :ok) (:ok :end :ok))))
(assert-event
 (equal (fn2-piu-mutation-result :occurrence)
  '(:ok :stored :state t :state t t t

; Actual generator expansion controls; no ACL2 process or generated code execution.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(setf sb-ext:*evaluator-mode* :interpret)
(defun len (x) (length x))
(defun nfix (x) (if (and (integerp x) (<= 0 x)) x 0))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun posp (x) (and (integerp x) (< 0 x)))
(defun zp (x) (<= (nfix x) 0))
(defun true-listp (x) (or (null x) (and (consp x) (true-listp (cdr x)))))
(defun member-eq (x xs) (member x xs))
(defun member-equal (x xs) (member x xs :test #'equal))
(defun assoc-eq (key xs) (assoc key xs))
(defun strip-cars (xs) (mapcar #'car xs))
(defun strip-cdrs (xs) (mapcar #'cdr xs))
(defun no-duplicatesp-eq (xs) (= (length xs) (length (remove-duplicates xs))))
(defun intern-in-package-of-symbol (name symbol) (intern name (symbol-package symbol)))
(defun fn2-decl-get (key xs) (getf xs key))
(defun fn2-columns-sym (name suffix)
 (intern-in-package-of-symbol (concatenate 'string (symbol-name name) suffix) name))
(defun fn2-columns-pre (prefix name)
 (intern-in-package-of-symbol (concatenate 'string prefix (symbol-name name)) name))
(defparameter state nil)
(defparameter *layouts* nil)
(defun w (s) (declare (ignore s)) *layouts*)
(defun table-alist (name world) (assert (eq name 'fn2-layouts)) world)
(defun value (event) event)
(defmacro er (&rest args) `(error "Declaration refusal: ~S" ',args))
(with-open-file (in "books/columns.lisp")
 (loop for form = (read in nil :eof) until (eq form :eof) do
  (when (eq (car form) 'defun) (eval form))))
(with-open-file (in "books/layout.lisp")
 (loop for form = (read in nil :eof) until (eq form :eof) do
  (when (eq (car form) 'defun) (eval form))))
(defparameter *declarations* nil)
(with-open-file (in "books/consumer-codec.lisp")
 (loop for form = (read in nil :eof) until (eq form :eof) do
  (cond ((and (eq (car form) 'defconst) (eq (cadr form) '*fn2-fnct-codes*))
         (eval `(defparameter ,(cadr form) ,(caddr form))))
        ((and (eq (car form) 'defun)
              (member (cadr form) '(fn2-fnct-deflayout-forms fn2-fnct-word-row fn2-fnct-layouts-presentp)))
         (eval form))
        ((and (eq (car form) 'defmacro) (eq (cadr form) 'fn2-fnct-deflayout)) (eval form))
        ((eq (car form) 'fn2-fnct-deflayout) (push form *declarations*)))))
(setf *declarations* (reverse *declarations*))
(defun refused (form)
 (let ((caught nil))
  (handler-case (eval (cadr (macroexpand-1 form)))
   (error () (setf caught t)))
  (assert caught)))
(let* ((old (fn2-fnct-deflayout-forms *fn2-fnct-codes*))
       (new nil) (old-generated nil) (new-generated nil))
 (assert (= (length old) 19))
 (assert (equal (mapcar #'cadr *declarations*) (mapcar #'cadr *fn2-fnct-codes*)))
 (dolist (declaration *declarations*)
  (let* ((event (eval (cadr (macroexpand-1 declaration))))
         (generated (fn2-codec-events (cadr event) (cadr (caddr event)) 60))
         (table (car (last generated))))
   (push event new)
   (push generated new-generated)
   ; Actual generated table payload, including exact layout/phase/export facts.
   (push (cons (cadr (caddr table)) (cadr (cadddr table))) *layouts*)))
 (setf new (reverse new) new-generated (reverse new-generated))
 (dolist (event old)
  (push (fn2-codec-events (cadr event) (cadr (caddr event)) 60) old-generated))
 (assert (equal new old))
 ; Complete actual generated definitions, declarations, guards, theorems and rows.
 (assert (equal new-generated (reverse old-generated)))
 (assert (fn2-fnct-layouts-presentp *fn2-fnct-codes* *layouts*))
 ; Missing accepted declaration fails the final inventory.
 (assert (not (fn2-fnct-layouts-presentp *fn2-fnct-codes* (cdr *layouts*))))
 ; New schema added to the owner table cannot silently go undeclared.
 (assert (not (fn2-fnct-layouts-presentp
               (append *fn2-fnct-codes* '((19 :future ((v :u8)) nil))) *layouts*)))
 ; Matching names with the wrong field layout cannot satisfy inventory.
 (let ((wrong (copy-tree *layouts*)))
  (setf (getf (cdar wrong) :layout) '((corrupt :u8)))
  (assert (not (fn2-fnct-layouts-presentp *fn2-fnct-codes* wrong))))
 ; Existing lookup behavior and row order remain unchanged for every schema.
 (dolist (row *fn2-fnct-codes*)
  (assert (equal (fn2-fnct-word-row (cadr row) *fn2-fnct-codes*) row)))
 (assert (null (fn2-fnct-word-row :not-a-schema *fn2-fnct-codes*)))
 ; A duplicate original declaration and an unknown schema are refused.
 (refused (car *declarations*))
 (refused '(fn2-fnct-deflayout :not-a-schema))
 (format t "FNCT LAYOUT CONTROLS PASS: 19 declarations, ~D complete generated events~%"
         (reduce #'+ (mapcar #'length new-generated))))

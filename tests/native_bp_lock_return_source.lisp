(require :sb-posix)
(require :sb-bsd-sockets)
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defconstant +fnn-lock-un+ 8)
(defconstant +fnn-lock-ex+ 2)
(defconstant +fnn-lock-nb+ 4)
(defconstant +fnn-o-nofollow+ 0)
(define-condition fnn-os-error (error) ())
(define-condition fnn-store-indeterminate (error) ())
(defvar *calls* nil)
(defvar *fail* nil)
(defvar *body-failure* nil)
(defvar *inspect-failure* nil)
(defvar *primary* (make-condition 'simple-error :format-control "recovery fault"))
(defun fnn-err (&rest args) (declare (ignore args)))
(defun fnn-indeterminate (&rest args) (declare (ignore args)) (error 'fnn-store-indeterminate))
(defun fnn-fault (&rest args) (error "~a" args))
(defun fnn-close (fd)
  (push (list :close fd) *calls*)
  (when (equal *fail* (list :close fd)) (error "close unobserved")))
(defun fnn-flock (fd op)
  (push (list :unlock fd) *calls*)
  (when (and (= op +fnn-lock-un+) (equal *fail* (list :unlock fd))) (error "unlock unobserved")))
(defun fnn-safe-directory (&rest args) (declare (ignore args)))
(defun fnn-fsync-dir (&rest args) (declare (ignore args)))
(defun fnn-parent (x) x)
(defun fnn-join (&rest args) (declare (ignore args)) "/lock")
(defun fnn-open (&rest args) (declare (ignore args)) 11)
(defun fnn-fstat (&rest args) (declare (ignore args)) (when *inspect-failure* (error *primary*)) :regular)
(defun fnn-regular-p (&rest args) (declare (ignore args)) t)
(defun fnn-tcl-spool-recover (&rest args)
  (declare (ignore args)) (when *body-failure* (error *primary*)))
(defconstant +fnn-tcl-spool-lock+ "owner.lock")
(defun fixture-read (file names)
  (with-open-file (in file)
    (loop for f = (read in nil :eof) until (eq f :eof) do
      (when (and (consp f) (member (car f) '(defun defmacro defvar defstruct))
                 (member (if (consp (second f)) (car (second f)) (second f)) names))
        (eval f)))))
(fixture-read "host/native/io.lisp" '(fnn-unwind-cleanups))
(fixture-read "host/native/tcpcl.lisp"
 '(fnn-tcl-spool-acquire fnn-tcl-spool-release fnn-tcl-spool-close-observation *fnn-tcl-spool-close-debts*))
(fixture-read "host/native/bp-service.lisp"
 '(fnn-bps fnn-bps-lock fnn-bps-release fnn-bps-release-observation *fnn-bps-release-debts*))
(dolist (failure '((:unlock 10) (:close 10) (:unlock 11) (:close 11)))
  (let ((service (make-fnn-bps :root "/root" :lock-fd 10 :spool-lock 11))
        (*fnn-bps-release-debts* nil) (*fnn-tcl-spool-close-debts* nil)
        (*fail* failure) (*calls* nil))
    (handler-case (progn (fnn-bps-release service) (error "false success"))
      (fnn-store-indeterminate () nil))
    (assert (equal (reverse *calls*) '((:unlock 10) (:close 10) (:unlock 11) (:close 11))))
    (assert (null (fnn-bps-lock-fd service)))
    (assert (null (fnn-bps-spool-lock service)))
    (assert (eq (car *fnn-bps-release-debts*) service))
    (assert (equal (subseq (fnn-bps-release-debt service) 0 2) '(10 11)))
    (assert (eq (fnn-bps-release-observation) :uncertain))
    (let ((before (copy-list *calls*)))
      (handler-case (fnn-bps-release service) (fnn-store-indeterminate () nil))
      (assert (equal *calls* before)))))
(let ((*fnn-bps-release-debts* nil) (*fnn-tcl-spool-close-debts* nil) (*calls* nil) (*fail* nil))
  (fnn-bps-release (make-fnn-bps :lock-fd 10 :spool-lock 11))
  (assert (eq (fnn-bps-release-observation) :closed)))
(let ((*fnn-tcl-spool-close-debts* nil) (*calls* nil) (*fail* '(:close 11)) (*body-failure* t))
  (handler-case (progn (fnn-tcl-spool-acquire "/root") (error "false open"))
    (simple-error (condition) (assert (eq condition *primary*))))
  (assert (eq (fnn-tcl-spool-close-observation) :uncertain))
  (assert (= 11 (caar *fnn-tcl-spool-close-debts*)))
  (let ((before (copy-list *calls*)))
    (handler-case (fnn-tcl-spool-acquire "/root") (fnn-store-indeterminate () nil))
    (handler-case (fnn-tcl-spool-release 11) (fnn-store-indeterminate () nil))
    (assert (equal *calls* before))))
(format t "native BP lock physical return source PASS~%")

(let ((*fnn-bps-release-debts* nil) (*fnn-tcl-spool-close-debts* nil)
      (*inspect-failure* t) (*fail* '(:close 11)) (*calls* nil))
  (handler-case (fnn-bps-lock "/root")
    (simple-error (condition) (assert (eq condition *primary*))))
  (assert (eq (fnn-bps-release-observation) :uncertain))
  (assert (equal (reverse *calls*) '((:unlock 11) (:close 11))))
  (assert (equal (subseq (fnn-bps-release-debt (car *fnn-bps-release-debts*)) 0 2) '(11 nil))))
(format t "native lifecycle lock acquisition custody source PASS~%")

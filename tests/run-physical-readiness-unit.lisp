; UNEXECUTED actual-initializer capability controls. The selected tuple is a
; synthetic resource-scan owner, not selected-descriptor/adoption authority.
; Actual profile init, per-row scans, and reserve serial invalidation are used.
(in-package "ACL2")
(include-book "../books/executor")
(include-book "../books/run-physical-readiness")
(include-book "std/util/bstar" :dir :system)
(defconst *fn2-rly-profile*
 (put-assoc-equal :large-upload-windows 1
  (put-assoc-equal :pool-classes
   (list (cons 2 64) (cons 2 256) (cons (+ 1 *fn2-b-query-loader-jobs*) 4096)
         (cons (+ 1 *fn2-b-query-loader-jobs*) 65536)) *fn2-profile-tiny*)))
(defconst *fn2-rly-children*
 '(fn2-run-load-readiness fn2-run-load-geometry fn2-id-decides fn2-reads fn2-run-loads fn2-run-cursors
   fn2-checkpoint-summary-leases fn2-run-load-ops fn2-ops fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-digests fn2-pool))
(defun fn2-rly-bindings (names)
 (declare (xargs :verify-guards nil))
 (if (atom names) nil
  (cons (list (car names) (list (intern-in-package-of-symbol
         (concatenate 'string "FN2-CORE-" (subseq (symbol-name (car names)) 4 nil)) 'fn2-core) 'fn2-core))
        (fn2-rly-bindings (cdr names)))))
(defmacro fn2-rly-defop (name args call)
 `(defun ,name ,(append args '(fn2-core))
   (declare (xargs :stobjs fn2-core :verify-guards nil))
   (stobj-let ,(fn2-rly-bindings *fn2-rly-children*) (code fn2-run-load-readiness)
    (,@call ,@*fn2-rly-children*) (mv code fn2-core))))
(fn2-rly-defop fn2-rly-begin () (fn2-run-load-readiness-begin 1 2 0 9 0 1))
(fn2-rly-defop fn2-rly-step (budget) (fn2-run-load-readiness-step budget))
(defmacro fn2-rly-current-call (tag)
 `(stobj-let ,(fn2-rly-bindings *fn2-rly-children*) (answer)
   (fn2-run-load-readiness-complete-current-p ,tag 2 0 9 0 1 ,@*fn2-rly-children*) answer))
(defun fn2-rly-current (tag fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (fn2-rly-current-call tag))
(defun fn2-rly-stamp (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-run-loads (fn2-core-run-loads fn2-core))) (stamp)
  (fn2-run-loads-admissions fn2-run-loads) stamp))
(defun fn2-rly-roomp (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core)) (fn2-ops (fn2-core-ops fn2-core))) (room)
  (fn2-run-load-readiness-roomp fn2-pool fn2-ops) room))
(defun fn2-rly-scan-fuel (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-run-loads (fn2-core-run-loads fn2-core)) (fn2-run-load-ops (fn2-core-run-load-ops fn2-core))) (fuel)
  (+ 3 (fn2-run-loads-rows fn2-run-loads) (fn2-run-load-ops-rows fn2-run-load-ops)) fuel))
(defun fn2-rly-drive (fuel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-rly-step 1 fn2-core)
   (if (eq code :more) (fn2-rly-drive (- fuel 1) fn2-core) (mv code fn2-core)))))
(defun fn2-rly-wrong-checker (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-run-loads (fn2-core-run-loads fn2-core))) (fn2-run-loads)
  (fn2-run-loads-set-checker 0 (+ 1 (fn2-run-loads-checker 0 fn2-run-loads)) fn2-run-loads) fn2-core))
(defun fn2-rly-reserve (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-run-loads (fn2-core-run-loads fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
  (code fn2-run-loads fn2-pool) (fn2-run-load-reserve 0 9 0 1 fn2-run-loads fn2-pool) (mv code fn2-core)))
(defun fn2-rly-body (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-rly-profile* fn2-core))
      (fn2-core (if (eq mode :row) (fn2-rly-wrong-checker fn2-core) fn2-core))
      ((mv begin fn2-core) (fn2-rly-begin fn2-core))
      ((unless (eq begin :more)) (mv nil fn2-core))
      ((mv yielded fn2-core) (fn2-rly-step 0 fn2-core))
      ((unless (and (eq yielded :yield) (not (fn2-rly-current 1 fn2-core)))) (mv nil fn2-core))
      ((when (eq mode :partial)) (mv t fn2-core))
      ((mv scanned fn2-core) (fn2-rly-drive (fn2-rly-scan-fuel fn2-core) fn2-core))
      ((when (eq mode :row)) (mv (and (eq scanned :row) (not (fn2-rly-current 1 fn2-core))) fn2-core))
      ((unless (and (eq scanned :complete) (fn2-rly-current 1 fn2-core))) (mv nil fn2-core))
      ((when (eq mode :complete)) (mv t fn2-core))
      ((when (eq mode :foreign)) (mv (not (fn2-rly-current 2 fn2-core)) fn2-core))
      (stamp (fn2-rly-stamp fn2-core))
      ((mv reserved fn2-core) (fn2-rly-reserve fn2-core)))
  ; The spare pair leaves a complete request bundle available. Thus rejection
  ; after reserve is not explained by reduced capacity: the serial changed.
  (mv (and (eq mode :serial) (eq reserved :ok) (equal (fn2-rly-stamp fn2-core) (+ 1 stamp))
           (fn2-rly-roomp fn2-core) (not (fn2-rly-current 1 fn2-core))) fn2-core)))
(defun fn2-rly-test (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core) (fn2-rly-body mode fn2-core) answer)))
(assert-event (fn2-core-profilep *fn2-rly-profile*))
(assert-event (fn2-rly-test :complete))
(assert-event (fn2-rly-test :partial))
(assert-event (fn2-rly-test :row))
(assert-event (fn2-rly-test :foreign))
(assert-event (fn2-rly-test :serial))

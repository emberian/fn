; Actual persisted writer/cut/authenticated producer prepares the root3 body.
; This exercises its real header/fixed-slot decoder, not physical page sealing
; or cold bootstrap origin; the source page is still bound pending its worker.
(in-package "ACL2")
(include-book "event-producer-unit")
(include-book "../books/checkpoint-restore-read")
(defun fn2-cel-body (fn2-event-build fn2-checkpoint-build fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-checkpoint-page-verified fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-event-build fn2-checkpoint-build fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-checkpoint-page-verified fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((mv produced fn2-event-build fn2-checkpoint-build fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-checkpoint-page-verified fn2-core fn2-sim fn2-own)
       (fn2-epp-body nil fn2-event-build fn2-checkpoint-build fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-checkpoint-page-verified fn2-core fn2-sim fn2-own))
      (slot (fn2-event-build-slot 0 fn2-event-build)) (gen (fn2-event-build-gen 0 fn2-event-build))
      ((mv decoded fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (answer fn2-fields)
        (b* (((mv header fn2-fields) (fn2-checkpoint-restore-header 3 1 1 1 0 0 slot gen 7 0 1 fn2-fields fn2-pool))
             ((mv entry fn2-fields) (fn2-checkpoint-restore-entry 3 0 0 slot gen 7 0 1 fn2-fields fn2-pool))
             (exact (and (eq entry :entry)
              (= (fn2-fields-value *fn2-event-proof-entry-field-commit* fn2-fields) 1)
              (= (fn2-fields-value *fn2-event-proof-entry-field-event-first* fn2-fields) 1)
              (= (fn2-fields-value *fn2-event-proof-entry-field-members* fn2-fields) 1)
              (= (fn2-fields-value *fn2-event-proof-entry-field-semantic-seal* fn2-fields) 1)
              (= (fn2-fields-ref-len *fn2-event-proof-entry-field-semantic-seal* fn2-fields) 32)))
             ((mv wrong-role fn2-fields) (fn2-checkpoint-restore-header 2 1 1 1 0 0 slot gen 7 0 1 fn2-fields fn2-pool))
             ((mv wrong-ordinal fn2-fields) (fn2-checkpoint-restore-entry 3 1 0 slot gen 7 0 1 fn2-fields fn2-pool)))
         (mv (and (eq header :ok) exact (eq wrong-role :coverage) (not (eq wrong-ordinal :entry))) fn2-fields))
        (mv answer fn2-core))))
  (mv (and produced decoded (= (fn2-event-build-phase 0 fn2-event-build) *fn2-event-build-phase-bound*))
      fn2-event-build fn2-checkpoint-build fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-checkpoint-page-verified fn2-core fn2-sim fn2-own)))
(defun fn2-cel-test ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-event-build fn2-checkpoint-build fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-checkpoint-page-verified fn2-core fn2-sim fn2-own)
  (fn2-cel-body fn2-event-build fn2-checkpoint-build fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-checkpoint-construction fn2-checkpoint-page fn2-checkpoint-page-verified fn2-core fn2-sim fn2-own)))
(assert-event (fn2-cel-test))

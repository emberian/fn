; Source-executed generator controls: no ACL2, proof, or cache process.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun len (x) (length x))
(defun nfix (x) (if (and (integerp x) (<= 0 x)) x 0))
(defun posp (x) (and (integerp x) (< 0 x)))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun zp (x) (<= (nfix x) 0))
(defun member-equal (x xs) (member x xs :test #'equal))
(defun member-eq (x xs) (member x xs))
(defun no-duplicatesp-eq (xs) (= (length xs) (length (remove-duplicates xs))))
(defun strip-cars (xs) (mapcar #'car xs))
(defun strip-cdrs (xs) (mapcar #'cdr xs))
(defun take (n xs) (subseq xs 0 n))
(defun intern-in-package-of-symbol (name symbol) (intern name (symbol-package symbol)))
(defconstant *fn2-none* 4294967295)
(defmacro er (severity context message &rest args)
  (declare (ignore severity context message))
  `(error "Generator refusal: ~S" (list ,@args)))
; The declaration registry is the boundary under test: retain its exact inputs.
(defun fn2-declare (&rest args) args)
(defun fn2-decl-get (key xs) (getf xs key))
(with-open-file (in "books/columns.lisp")
 (loop for form = (read in nil :eof) until (eq form :eof) do
  (case (car form)
   (defun (eval form))
   (mutual-recursion (mapc #'eval (cdr form))))))

; Actual factory outputs before and after the local-theory selection change.
(defun numeric-theory-read-functions (path)
 (with-open-file (in path)
  (loop for form = (read in nil :eof) until (eq form :eof) do
   (case (car form)
    (defun (eval form))
    (mutual-recursion (mapc #'eval (cdr form)))))))
(defun theory-events (extras)
 (fn2-columns-events 'fn2-theory-target '((value :u60)) 8 extras nil nil))
(defun factory-without-first-local-theory (factory)
 (append (subseq factory 0 3) (list (cdr (fourth factory)))))
(defparameter *numeric-extras*
 '((fn2-theory-count :type (unsigned-byte 60) :initially 0 :why "Numeric scalar.")
   (fn2-theory-fixed :type (array (unsigned-byte 8) (2)) :initially 0 :why "Fixed numeric array.")
   (fn2-theory-dynamic :type (array (unsigned-byte 32) (0)) :initially 0 :resizable t :why "Resizable numeric array.")))
(defparameter *raw-extras*
 '((fn2-theory-child :type foreign-child :why "External nested-stobj constructor.")))
(defparameter *mixed-extras* (append *numeric-extras* *raw-extras*))
(defparameter *cases* (list nil *numeric-extras* *raw-extras* *mixed-extras*))
(numeric-theory-read-functions (sb-ext:posix-getenv "FN_COLUMNS_BASELINE"))
(defparameter *before* (mapcar #'theory-events *cases*))
(numeric-theory-read-functions "books/columns.lisp")
(assert (fn2-columns-all-numeric-fieldsp nil))
(assert (fn2-columns-all-numeric-fieldsp (fn2-columns-extra-specs *numeric-extras*)))
(assert (not (fn2-columns-all-numeric-fieldsp (fn2-columns-extra-specs *raw-extras*))))
(assert (not (fn2-columns-all-numeric-fieldsp (fn2-columns-extra-specs *mixed-extras*))))
(loop for extras in *cases* for before in *before* do
 (let ((after (theory-events extras)))
  (if (equal extras *numeric-extras*)
      (progn
       (assert (equal (car (fourth after))
                      '(local (in-theory (theory 'fn2-columns-proof-theory)))))
       ; This checks all actual runtime definitions, guards, full theorem H/C
       ; and proof hints verbatim: only one local theory event is inserted.
       (assert (string= (prin1-to-string before)
                        (prin1-to-string (factory-without-first-local-theory after)))))
    (assert (string= (prin1-to-string before) (prin1-to-string after))))))
; The raw row frame uses the public theorem without rewriting it away.
(let* ((events (fn2-columns-preserves 'table 'producer '(i v table)
                3 nil nil "-PRESERVES" t t nil t t nil nil nil))
       (raw (nth 4 events))
       (hint (car (fn2-decl-get :hints (cdddr raw))))
       (theory (fn2-decl-get :in-theory (cdr hint))))
 (assert (equal (caddr theory) '(producer producer-preserves-rows)))
 (assert (eq (fn2-decl-get :use (cdr hint)) 'producer-preserves-rows)))
(format t "COLUMNS NUMERIC THEORY CONTROLS PASS~%")

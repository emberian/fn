;;; Actual condition-to-literal boundary. Extent result/job semantics are
;;; recording boundaries here; this is not a whole direct-read replay.
(load "tests/native_actor_envelope_raw.lisp")
(in-package "ACL2")

;;; ---- derived stubs: BEGIN (python3 tools/harness_check.py --write-stubs; do not edit) ----
(define-condition harness-stub-reached (serious-condition)
  ((name :initarg :name :reader harness-stub-reached-name)
   (source :initarg :source :reader harness-stub-reached-source))
  (:report (lambda (c s)
             (format s "harness: host function ~(~a~) (~a) was reached; this harness neither stubs nor extracts it"
                     (harness-stub-reached-name c) (harness-stub-reached-source c)))))
(defun harness-stub-reached (name source)
  (format *error-output* "harness: host function ~(~a~) (~a) was reached; this harness neither stubs nor extracts it~%"
          name source)
  (finish-output *error-output*)
  (error 'harness-stub-reached :name name :source source))
(defun fnn-concat (&rest strings)
  (declare (ignorable strings))
  (harness-stub-reached 'fnn-concat "host/native/io.lisp"))
(defun fnn-emit (stream text)
  (declare (ignorable stream text))
  (harness-stub-reached 'fnn-emit "host/native/io.lisp"))
(defun fnn-extent-executor-observe-returned (worker)
  (declare (ignorable worker))
  (harness-stub-reached 'fnn-extent-executor-observe-returned "host/native/extent.lisp"))
(defun fnn-log-offer (destination octets)
  (declare (ignorable destination octets))
  (harness-stub-reached 'fnn-log-offer "host/native/io.lisp"))
(defun fnn-owner-output-maybe-physical-locked (service grant)
  (declare (ignorable service grant))
  (harness-stub-reached 'fnn-owner-output-maybe-physical-locked "host/native/owner.lisp"))
(defun fnn-owner-syncer-physical (service grant receipt)
  (declare (ignorable service grant receipt))
  (harness-stub-reached 'fnn-owner-syncer-physical "host/native/owner.lisp"))
(defun fnn-string-octets (string)
  (declare (ignorable string))
  (harness-stub-reached 'fnn-string-octets "host/native/io.lisp"))
;;; ---- derived stubs: END ----
(unless (find-package "ACL2_*1*_ACL2") (make-package "ACL2_*1*_ACL2" :use nil))
(load-deployed-forms "host/native/extent.lisp"
 '((defstruct (fnn-cold-worker (:constructor %make-fnn-cold-worker)))))
(load-deployed-forms "host/native/owner.lisp"
 '((defstruct (fnn-owner-cold-read (:constructor %make-fnn-owner-cold-read)))
   (defun fnn-owner-cold-transfer-result-locked)
   (defun fnn-owner-output-observe-returned)
   (defun fnn-owner-output-dependency-consumed)))
(defvar *cold-settle-observed* nil)
(defun fnn-extent-direct-settle (worker token verdict)
  (declare (ignore worker))
  (setf *cold-settle-observed* (list token verdict))
  (values :discard nil))
(defun fnn-extent-complete-read (token verdict)
  (setf *cold-settle-observed* (list token verdict)) (values :discard nil))
(defun fnn-extent-cache-store (&rest args) (declare (ignore args)) (error "unexpected publish"))
(dolist (case '(:condition :literal :no-token))
  (let* ((token (unless (eq case :no-token) '(2 7 11 0 8 "trailer")))
         (condition (make-condition 'simple-error :format-control "stored actual worker condition"))
         (worker (%make-fnn-cold-worker :result (if (eq case :literal) '(:read nil) condition)))
         (read (%make-fnn-owner-cold-read :token token :directp (and token t) :worker worker))
         (*fnn-native-observer* (fnn-native-observation-create 8))
         (*fnn-native-actor-identity* (fnn-native-observation-current-identity))
         (*cold-settle-observed* nil))
    (let ((values (multiple-value-list (fnn-owner-cold-transfer-result-locked read))))
      (multiple-value-bind (status events reason)
          (fnn-native-observation-events *fnn-native-observer*)
        (check (and (eq status :complete) (null reason)) "literal observation collector complete")
        (check (equal events (if (eq case :condition)
                                  (list (list :job-result *fnn-native-actor-identity* token :error)) nil))
               "only actual direct condition conversion emits literal job-result, no duplicate or fabricated no-request label")
        (when (eq case :condition)
          (check (and (equal *cold-settle-observed* (list token :error))
                      (eq (fifth values) condition))
                 "same literal reaches actual settle call and original condition remains distinct"))))))
(format t "native_owner_cold_result_observation_raw: PASS actual condition/literal/no-token boundary~%")

;; Actual owner transfer acquires E around conversion and settlement; no hidden
;; condition-wait occurs in this region. Other O/P/wait sites remain unavailable.
(defvar *fnn-extent-lock* (sb-thread:make-mutex :name "actual transfer E"))
(defvar *fnn-owner-last-fault* nil)
(defvar *fnn-extent-stats* (list 0 0 0))
(define-condition fnn-extent-fault (serious-condition) ((message :initarg :message)))
(defun fnn-owner-cold-remove-locked (service read) (declare (ignore service read)) nil)
(defun fnn-extent-executor-commit (&rest xs) (declare (ignore xs)) (error "unexpected pooled transfer"))
(defun fnn-extent-cache-release (evicted) (check (null evicted) "no retained evictions"))
(defun fnn-owner-release-pending-extents-locked (service) (declare (ignore service)) nil)
(defun fnn-err (&rest xs) (declare (ignore xs)) nil)
(load-deployed-forms "host/native/owner.lisp" '((defun fnn-owner-cold-result-locked)))
(let* ((s (%make-fnn-owner-service))
       (condition (make-condition 'simple-error :format-control "returned worker condition"))
       (token '(2 7 11 0 8 "trailer"))
       (worker (%make-fnn-cold-worker :result condition))
       (read (%make-fnn-owner-cold-read :token token :directp t :worker worker))
       (*fnn-native-observer* (fnn-native-observation-create 8))
       (*fnn-native-actor-identity* (fnn-native-observation-current-identity))
       (*fnn-owner-last-fault* nil))
  (check (eq condition (handler-case (fnn-owner-cold-result-locked s read)
                         (serious-condition (c) c))) "original condition rethrown after actual settlement")
  (multiple-value-bind (status events reason) (fnn-native-observation-events *fnn-native-observer*)
    (check (and (eq status :complete) (null reason)) "owner E primitive packet complete")
    (check (equal events (list (list :acquire *fnn-native-actor-identity* :extent)
                              (list :job-result *fnn-native-actor-identity* token :error)
                              (list :release *fnn-native-actor-identity* :extent)))
           "literal classification between actual E acquire/release"))
  (check (and (fnn-owner-cold-read-settledp read) (null (fnn-owner-cold-read-worker read)))
         "actual transfer clears worker before observation receipt ends"))
(format t "native_owner_cold_result_observation_raw: PASS actual owner E transfer/classification/release~%")

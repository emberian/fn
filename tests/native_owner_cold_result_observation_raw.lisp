(let* ((s (%make-fnn-owner-service))
       (condition (make-condition 'simple-error :format-control "returned worker condition"))
       (token '(2 7 11 0 8 "trailer"))
       (worker (%make-fnn-cold-worker :result condition))
       (read (%make-fnn-owner-cold-read :token token :directp t :worker worker))
       (*fnn-native-observer* (fnn-native-observation-create 8))
       (*fnn-native-actor-identity* (fnn-native-observation-current-identity))
       (*fnn-owner-last-fault* nil))
  (check (eq condition (handler-case (fnn-owner-cold-result-locked s read)
                         (serious-condition (c) c))) "original condition rethrown after actual settlement")
  (multiple-value-bind (status events reason) (fnn-native-observation-events *fnn-native-observer*)
    (check (and (eq status :complete) (null reason)) "owner E primitive packet complete")
    (check (equal events (list (list :acquire *fnn-native-actor-identity* :extent)
                              (list :job-result *fnn-native-actor-identity* token :error)
                              (list :release *fnn-native-actor-identity* :extent)))
           "literal classification between actual E acquire/release"))
  (check (and (fnn-owner-cold-read-settledp read) (null (fnn-owner-cold-read-worker read)))
         "actual transfer clears worker before observation receipt ends"))

; Prepared continuation control, UNEXECUTED. Reuses the actual sealed-page,
; held-source rebuild, synthetic cold catalog opener, and physical ReadResult
; environment from run-physical-loader-unit. The catalog/boot/B-holder opener
; is SYNTHETIC; this is not descriptor publication/recovery qualification.
; The next root1 BEGIN/selection/physical source read/held-entry rehome are
; actual functions. No cache readiness, checker completion, or digest is seeded.
(in-package "ACL2")
(include-book "run-physical-loader-unit")
(include-book "../books/checkpoint-metadata-driver")

(defconst *fn2-rsr-profile*
 (put-assoc-equal :history-id 1
  (put-assoc-equal :history-incarnation 1
   (put-assoc-equal :pool-classes '((8 . 64) (4 . 256) (64 . 4096) (64 . 65536)) *fn2-rpl-profile*))))
; Project the SAME actual operation declaration into a core wrapper. All
; readonly child inputs remain inputs; output count is the operation's exact
; mutable subset, never one value per input table.
(defmacro fn2-rsr-root1-op (name target args scalars)
 (let ((outputs (cdr (assoc-eq target *fn2-checkpoint-root1-outputs*))))
  `(fn2-rpl-wrapper ,name ,args ,*fn2-checkpoint-root1-children* ,outputs ,scalars
    (,target ,@args ,@*fn2-checkpoint-root1-children*))))
(fn2-rsr-root1-op fn2-rsr-begin fn2-checkpoint-root1-begin (token kind owner gen) (code))
(fn2-rsr-root1-op fn2-rsr-step fn2-checkpoint-root1-step (budget kind owner gen) (code))
(fn2-rsr-root1-op fn2-rsr-bind fn2-checkpoint-root1-bind (kind owner gen) (code))
(fn2-rsr-root1-op fn2-rsr-consume fn2-checkpoint-root1-consume (budget kind owner gen) (code))
(fn2-rsr-root1-op fn2-rsr-read fn2-checkpoint-root1-read (budget kind owner gen) (code op ogen))

(fn2-rpl-wrapper fn2-rsr-one-source () (fn2-checkpoint-summary) (fn2-checkpoint-summary) (code)
 (let ((fn2-checkpoint-summary (fn2-checkpoint-summary-set-count 0 1 fn2-checkpoint-summary)))
  (mv :ok fn2-checkpoint-summary)))
(fn2-rpl-wrapper fn2-rsr-reserve (token kind owner gen)
 (fn2-checkpoint-root1 fn2-checkpoint-windows fn2-checkpoint-future fn2-checkpoint-future-windows fn2-csnapshot fn2-pool)
 (fn2-checkpoint-root1 fn2-checkpoint-windows fn2-checkpoint-future fn2-checkpoint-future-windows fn2-pool) (code)
 (fn2-checkpoint-root1-reserve 0 token kind owner gen fn2-checkpoint-root1 fn2-checkpoint-windows fn2-checkpoint-future fn2-checkpoint-future-windows fn2-csnapshot fn2-pool))
(fn2-rpl-wrapper fn2-rsr-descriptor-begin (token kind owner gen)
 (fn2-checkpoint-build fn2-csnapshot fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-fc fn2-checkpoint-construction fn2-extents fn2-pool fn2-origin fn2-control fn2-checkpoint-windows)
 (fn2-checkpoint-build fn2-checkpoints fn2-checkpoint-construction fn2-extents fn2-control) (code)
 (fn2-checkpoint-build-begin 1 0 token
  (fn2-checkpoint-windows-slot 16 fn2-checkpoint-windows) (fn2-checkpoint-windows-generation 16 fn2-checkpoint-windows)
  (fn2-checkpoint-windows-slot 14 fn2-checkpoint-windows) (fn2-checkpoint-windows-generation 14 fn2-checkpoint-windows)
  kind owner gen fn2-checkpoint-build fn2-csnapshot fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-fc fn2-checkpoint-construction fn2-extents fn2-pool fn2-origin fn2-control))

(defun fn2-rsr-attached (token pending kind owner gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-checkpoint-root1 (fn2-core-checkpoint-root1 fn2-core)) (fn2-checkpoint-windows (fn2-core-checkpoint-windows fn2-core))
             (fn2-csnapshot (fn2-core-csnapshot fn2-core)) (fn2-run-loads (fn2-core-run-loads fn2-core))
             (fn2-run-cursors (fn2-core-run-cursors fn2-core)) (fn2-checkpoint-summary-leases (fn2-core-checkpoint-summary-leases fn2-core))) (yes)
  (let ((c (fn2-b-checkpoint-source-cursor-from-rows (fn2-run-loads-rows fn2-run-loads))))
   (and (fn2-checkpoint-source-reader-attachedp token kind owner gen fn2-checkpoint-root1 fn2-checkpoint-windows fn2-csnapshot fn2-run-loads fn2-run-cursors)
        (equal (fn2-run-loads-pending c fn2-run-loads) pending)
        (equal (fn2-checkpoint-summary-leases-live c fn2-checkpoint-summary-leases) 1)
        (equal (fn2-run-loads-page c fn2-run-loads) (fn2-checkpoint-windows-slot *fn2-checkpoint-source-page-window* fn2-checkpoint-windows)))) yes))
(defun fn2-rsr-entry-view (erow kind owner gen fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-pool) :verify-guards nil))
 (let ((line (+ erow *fn2-overview-entry-field-line*)))
  (mv-let (code byte)
   (fn2-pool-read (fn2-fields-ref-slot line fn2-fields) (fn2-fields-ref-gen line fn2-fields)
    (fn2-fields-ref-off line fn2-fields) kind owner gen fn2-pool)
   (and (eq code :ok) (equal (fn2-fields-ref-len line fn2-fields) 1)
    (list (fn2-fields-value (+ erow *fn2-overview-entry-field-group*) fn2-fields)
          (fn2-fields-value (+ erow *fn2-overview-entry-field-number*) fn2-fields)
          (fn2-fields-value (+ erow *fn2-overview-entry-field-article*) fn2-fields)
          (fn2-fields-value (+ erow *fn2-overview-entry-field-position*) fn2-fields) byte)))))
(defun fn2-rsr-held (fuel token kind owner gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code & & fn2-core) (fn2-csnapshot-poll token kind owner gen fn2-core)
   (if (eq code :more) (fn2-rsr-held (- fuel 1) token kind owner gen fn2-core) (mv code fn2-core)))))

(defun fn2-rsr-held-value (kind owner gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-checkpoint-root1 (fn2-core-checkpoint-root1 fn2-core)) (fn2-checkpoint-metadata (fn2-core-checkpoint-metadata fn2-core))
             (fn2-run-loads (fn2-core-run-loads fn2-core)) (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (value)
  (and (equal (fn2-checkpoint-root1-phase 0 fn2-checkpoint-root1) *fn2-checkpoint-root1-phase-retention*)
       (equal (fn2-checkpoint-metadata-held 0 fn2-checkpoint-metadata) 1)
       (equal (fn2-checkpoint-metadata-copy-field 0 fn2-checkpoint-metadata) (fn2-run-layout-fields 3 0))
       (not (equal (fn2-checkpoint-metadata-scratch 0 fn2-checkpoint-metadata)
                   (fn2-run-loads-page (fn2-b-checkpoint-source-cursor-from-rows (fn2-run-loads-rows fn2-run-loads)) fn2-run-loads)))
       (fn2-rsr-entry-view (fn2-checkpoint-metadata-entry-base 0 fn2-checkpoint-metadata) kind owner gen fn2-fields fn2-pool)) value))

; Every queued read is completed through the same actual host adapter and
; global exact-op harvest as the ordinary physical loader control. A zero
; budget callback between queue and completion must leave the retained cut,
; catalog lease, windows and pending operation intact.
(defun fn2-rsr-drive (fuel token kind owner gen disks reads corrupt fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel nil reads fn2-core)
  (b* ((value (fn2-rsr-held-value kind owner gen fn2-core))
       ((when value) (mv :held value reads fn2-core))
       ((mv code fn2-core) (fn2-rsr-step 4096 kind owner gen fn2-core)))
   (cond ((eq code :more) (fn2-rsr-drive (- fuel 1) token kind owner gen disks reads corrupt fn2-core))
         ((eq code :need-read)
          (b* (((mv issued op ogen fn2-core) (fn2-rsr-read 1 kind owner gen fn2-core))
               ((unless (and (eq issued :ok) (fn2-rsr-attached token 1 kind owner gen fn2-core))) (mv :issue nil reads fn2-core))
               ((mv yielded fn2-core) (fn2-rsr-step 0 kind owner gen fn2-core))
               ((unless (and (eq yielded :yield) (fn2-rsr-attached token 1 kind owner gen fn2-core))) (mv :yield-state nil reads fn2-core))
               ((mv completed fn2-core) (fn2-rpl-complete-read op ogen disks corrupt fn2-core))
               ((unless (and completed (fn2-rsr-attached token 0 kind owner gen fn2-core))) (mv :completion nil reads fn2-core)))
           (fn2-rsr-drive (- fuel 1) token kind owner gen disks (+ reads 1) corrupt fn2-core)))
         (t (mv code nil reads fn2-core))))))

; Complete the actual physical-page worker's queued write. The environment
; acknowledges the exact output action only; ledger completion and handback
; are still decided by actual harvest/worker/source callbacks.
(defun fn2-rsr-complete-write (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv queued op gen) (fn2-host-outbox-peek 0 fn2-core))
      ((unless (eq queued :ok)) (mv nil fn2-core))
      ((mv action kind & & & & off count storage & & & & & &) (fn2-host-action op fn2-core))
      ((unless (and (eq action :ok) (= kind *fn2-action-write*) (= off 0)
                    (= count *fn2-commit-unit-bytes*) (= (mod storage *fn2-commit-unit-bytes*) 0)))
       (mv nil fn2-core))
      ((mv ack fn2-core)
       (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (code fn2-ops)
        (fn2-outbox-ack 1 fn2-ops) (mv code fn2-core)))
      (fn2-core (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (fn2-ops)
       (fn2-post-result 0 op gen *fn2-event-write-result* *fn2-outcome-done* *fn2-reason-none* count 0 0 fn2-ops) fn2-core))
      ((mv done hop hgen cell event outcome reason bytes & & fn2-core) (fn2-harvest-one fn2-core)))
  (mv (and (eq ack :ok) done (= hop op) (= hgen gen) (= cell 0) (= event *fn2-event-write-result*)
           (= outcome *fn2-outcome-done*) (= reason *fn2-reason-none*) (= bytes count)) fn2-core)))
(defun fn2-rsr-page-returned-p (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-checkpoint-page (fn2-core-checkpoint-page fn2-core))) (yes)
  (equal (fn2-checkpoint-page-handoff 0 fn2-checkpoint-page) *fn2-checkpoint-page-handoff-to-source*) yes))
(defun fn2-rsr-page-drive (fuel target writes fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond ((zp fuel) (mv :fuel writes fn2-core))
       ((fn2-rsr-page-returned-p fn2-core) (mv :returned writes fn2-core))
       (t (b* (((mv & & & & fn2-core) (fn2-checkpoint-page-worker-run target 4096 fn2-core))
               ((mv queued & &) (fn2-host-outbox-peek 0 fn2-core))
               ((mv complete fn2-core) (if (eq queued :ok) (fn2-rsr-complete-write fn2-core) (mv t fn2-core)))
               ((unless complete) (mv :write-completion writes fn2-core)))
            (fn2-rsr-page-drive (- fuel 1) target (+ writes (if (eq queued :ok) 1 0)) fn2-core)))))
(defun fn2-rsr-terminal-p (token fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-checkpoint-root1 (fn2-core-checkpoint-root1 fn2-core))
             (fn2-checkpoint-metadata-manifest (fn2-core-checkpoint-metadata-manifest fn2-core))
             (fn2-checkpoint-source (fn2-core-checkpoint-source fn2-core))
             (fn2-run-loads (fn2-core-run-loads fn2-core)) (fn2-run-cursors (fn2-core-run-cursors fn2-core))
             (fn2-checkpoint-summary-leases (fn2-core-checkpoint-summary-leases fn2-core))
             (fn2-csnapshot (fn2-core-csnapshot fn2-core))) (yes)
  (and (equal (fn2-checkpoint-root1-token 0 fn2-checkpoint-root1) token)
       (equal (fn2-checkpoint-root1-phase 0 fn2-checkpoint-root1) *fn2-checkpoint-root1-phase-complete*)
       (equal (fn2-checkpoint-metadata-manifest-phase 0 fn2-checkpoint-metadata-manifest) *fn2-checkpoint-metadata-manifest-phase-complete*)
       (equal (fn2-checkpoint-source-phase 0 fn2-checkpoint-source) *fn2-checkpoint-source-phase-done*)
       (equal (fn2-csnapshot-complete 0 fn2-csnapshot) 1)
       (fn2-checkpoint-source-reader-detachedp fn2-run-loads fn2-run-cursors fn2-checkpoint-summary-leases)) yes))
(defun fn2-rsr-terminal-drive (fuel token kind owner gen writes fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel writes fn2-core)
  (b* (((mv code fn2-core) (fn2-rsr-step 4096 kind owner gen fn2-core)))
   (cond ((eq code :done) (mv (if (fn2-rsr-terminal-p token fn2-core) :done :false-terminal) writes fn2-core))
         ((eq code :more) (fn2-rsr-terminal-drive (- fuel 1) token kind owner gen writes fn2-core))
         ((eq code :page)
          (b* (((mv bound fn2-core) (fn2-rsr-bind kind owner gen fn2-core))
               ((mv taken target & fn2-core) (fn2-checkpoint-page-take fn2-core))
               ((unless (and (eq bound :ok) (eq taken :ok))) (mv :take writes fn2-core))
               ((mv returned n fn2-core) (fn2-rsr-page-drive 512 target 0 fn2-core))
               ((unless (eq returned :returned)) (mv returned (+ writes n) fn2-core))
               ((mv accepted fn2-core) (fn2-checkpoint-page-accept-return kind owner gen fn2-core))
               ((mv consumed fn2-core) (fn2-rsr-consume 4096 kind owner gen fn2-core))
               ((unless (and (eq accepted :ok) (eq consumed :more))) (mv :consume (+ writes n) fn2-core)))
           (fn2-rsr-terminal-drive (- fuel 1) token kind owner gen (+ writes n) fn2-core)))
         (t (mv code writes fn2-core))))))

(defun fn2-rsr-body (corrupt fn2-checkpoint-source fn2-core)
 (declare (xargs :stobjs (fn2-checkpoint-source fn2-core) :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-rsr-profile* fn2-core))
      (fn2-checkpoint-source (fn2-checkpoint-source-init 1 fn2-checkpoint-source))
      ((mv env fn2-core) (fn2-rpl-init-environment fn2-core))
      ((mv reserved src sgen fn2-core) (fn2-core-reserve 0 9 0 1 fn2-core))
      ((mv written fn2-core) (fn2-core-write src sgen 0 65 9 0 1 fn2-core))
      ((mv made & fn2-core) (fn2-rpl-produce t 0 7 101 111 src sgen fn2-core))
      ((mv begin token fn2-core) (fn2-csnapshot-begin 9 0 1 fn2-core))
      ((mv held fn2-core) (fn2-rpl-held 256 token fn2-core))
      ((mv selected fn2-checkpoint-source fn2-core) (fn2-rpl-source-begin token fn2-checkpoint-source fn2-core))
      ((mv found fn2-checkpoint-source fn2-core) (fn2-rpl-select-drive 256 fn2-checkpoint-source fn2-core))
      ((unless (and (eq env :ok) (eq reserved :ok) (eq written :ok) made (eq begin :ok) (eq held :held)
                    (eq selected :ok) (eq found :source) (equal (fn2-checkpoint-source-kind 0 fn2-checkpoint-source) 1)
                    (equal (fn2-checkpoint-source-row 0 fn2-checkpoint-source) 0) (equal (fn2-checkpoint-source-rank 0 fn2-checkpoint-source) 1)))
       (mv nil fn2-checkpoint-source fn2-core))
      ((mv rebuilt disk fn2-core) (fn2-rpl-rebuild token 1 0 1 2 fn2-core))
      ((mv released fn2-core) (fn2-csnapshot-release token 9 0 1 fn2-core))
      ((mv cold fn2-core) (fn2-rpl-cold-admission fn2-core))
      ((mv one fn2-core) (fn2-rsr-one-source fn2-core))
      ((mv applied fn2-core) (fn2-rpl-apply 32 fn2-core))
      ((unless (and rebuilt (eq released :ok) (eq cold :ok) (eq one :ok) (eq applied :applied) (fn2-rpl-cache-emptyp fn2-core)))
       (mv nil fn2-checkpoint-source fn2-core))
      (kind *fn2-checkpoint-master-kind*)
      (owner (fn2-machine-kind-base kind fn2-core))
      (gen (fn2-checkpoint-master-row-generation owner fn2-core))
      (fn2-core (fn2-exec-genesis-row owner fn2-core))
      ((mv next next-token fn2-core) (fn2-csnapshot-begin kind owner gen fn2-core))
      ((mv next-held fn2-core) (fn2-rsr-held 256 next-token kind owner gen fn2-core))
      ((mv bundle fn2-core) (fn2-rsr-reserve next-token kind owner gen fn2-core))
      ((mv descriptor fn2-core) (fn2-rsr-descriptor-begin next-token kind owner gen fn2-core))
      ((mv root1 fn2-core) (fn2-rsr-begin next-token kind owner gen fn2-core))
      ((unless (and (eq next :ok) (< token next-token) (eq next-held :held) (eq bundle :ok) (eq descriptor :ok) (eq root1 :more)))
       (mv nil fn2-checkpoint-source fn2-core))
      ((mv result value reads fn2-core) (fn2-rsr-drive 512 next-token kind owner gen (list disk) 0 corrupt fn2-core))
      ((when corrupt) (mv (and (equal reads *fn2-storage-extent-units*) (not (eq result :held)) (not value)
                               (fn2-rpl-cache-emptyp fn2-core)) fn2-checkpoint-source fn2-core))
      ((unless (and (eq result :held) (equal reads *fn2-storage-extent-units*) (equal value '(1 1 101 1 65))
                    (fn2-rsr-attached next-token 0 kind owner gen fn2-core)))
       (mv nil fn2-checkpoint-source fn2-core))
      ((mv terminal writes fn2-core) (fn2-rsr-terminal-drive 1024 next-token kind owner gen 0 fn2-core)))
  (mv (and (eq terminal :done) (equal writes (* 2 *fn2-storage-extent-units*))
           (fn2-rsr-terminal-p next-token fn2-core) (fn2-rpl-cache-emptyp fn2-core)
           (not (fn2-core-stopped-p fn2-core))) fn2-checkpoint-source fn2-core)))
(defun fn2-rsr-test (corrupt)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoint-source
  (mv-let (answer fn2-checkpoint-source)
   (with-local-stobj fn2-core
    (mv-let (answer fn2-checkpoint-source fn2-core) (fn2-rsr-body corrupt fn2-checkpoint-source fn2-core)
     (mv answer fn2-checkpoint-source))) answer)))
(assert-event (fn2-core-profilep *fn2-rsr-profile*))
(assert-event (fn2-rsr-test nil))
(assert-event (fn2-rsr-test t))

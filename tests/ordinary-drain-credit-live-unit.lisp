; Complete the same actual STAGED producer through the existing simulated
; adapter and public turn. Source-prepared; no physical IO or executed gate.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "ordinary-drain-credit-unit")
(include-book "retirement-live-unit")
(defun fn2-odcl-body (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((mv prepared fn2-core) (fn2-odc-body nil fn2-core))
      (fn2-sim (fn2-sim-init 1 :none "ordinary-drain-credit" *fn2-odc-profile* fn2-sim))
      (fn2-own (fn2-own-init *fn2-odc-profile* fn2-own))
      (id (fn2-machine-kind-base *fn2-commit-kind* fn2-core))
      (owner (fn2-machine-kind-base *fn2-scribe-kind* fn2-core))
      (generation (fn2-machine-generation owner fn2-core))
      (batch (fn2-machine-batch-no id fn2-core))
      ((unless (and prepared (posp batch) (fn2-odc-group-fullp 0 fn2-core)))
       (mv nil fn2-core fn2-sim fn2-own))
      ((mv fn2-core fn2-sim fn2-own) (fn2-retirement-live-drive 600 26 fn2-core fn2-sim fn2-own))
      ((mv taken got-batch event outcome fn2-core)
       (fn2-commit-take *fn2-scribe-kind* owner generation fn2-core)))
  (mv (and (eq taken :ok) (= got-batch batch) (posp event)
           (= outcome *fn2-commit-outcome-accepted*)
           (= (fn2-machine-phase id fn2-core) *fn2-commit-state-free*)
           (fn2-odc-group-fullp 0 fn2-core) (fn2-odc-group-fullp 1 fn2-core)
           (fn2-odc-group-fullp 2 fn2-core) (fn2-core-wfp fn2-core)
           (not (fn2-core-stopped-p fn2-core))) fn2-core fn2-sim fn2-own)))
(defun fn2-odcl-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (ok fn2-core)
   (with-local-stobj fn2-sim
    (mv-let (ok fn2-core fn2-sim)
     (with-local-stobj fn2-own
      (mv-let (ok fn2-core fn2-sim fn2-own) (fn2-odcl-body fn2-core fn2-sim fn2-own)
       (mv ok fn2-core fn2-sim))) (mv ok fn2-core))) ok)))
(assert-event (fn2-odcl-run))

; Narrow resource controls over actual core release and real pool loans.
; Completed Fence/recovery/consumer/capture states are synthetic premises:
; this is NOT a persisted selected-base or full cold-boot success witness.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/assembly-rows-c")
(include-book "../books/boot-root-release")
(fn2-boot-root-release-events)

; Generate the identical terminal root binding for each concrete consumer.
(defmacro fn2-brru-terminal (carrier phase slot gen id ogen)
 `(,(fn2-columns-sym carrier "-PUT") 0 (phase ,phase) (slot ,slot) (gen ,gen)
   (owner-kind *fn2-boot-kind*) (owner-slot ,id) (owner-gen ,ogen)))

(defun fn2-brru-pool (id ogen recovery rogen mode fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (b* ((fn2-pool (fn2-pool-init '((4 . 4096) (1 . 65536)) 1 (if (eq mode :retired) 1 10) fn2-pool))
      ((mv a root gen fn2-pool) (fn2-pool-reserve 1 *fn2-boot-kind* (if (eq mode :foreign) (+ 1 id) id) ogen fn2-pool))
      ((mv b rslot rgen fn2-pool) (fn2-pool-reserve 0 *fn2-recovery-machine-kind* recovery rogen fn2-pool))
      ((mv c wslot wgen fn2-pool) (fn2-pool-reserve 0 *fn2-recovery-machine-kind* recovery rogen fn2-pool))
      ((mv d fn2-pool) (if (eq mode :recovery-window) (mv :ok fn2-pool)
        (fn2-pool-release rslot rgen *fn2-recovery-machine-kind* recovery rogen fn2-pool)))
      ((mv e fn2-pool) (fn2-pool-release wslot wgen *fn2-recovery-machine-kind* recovery rogen fn2-pool))
      ((mv f bslot bgen fn2-pool) (fn2-pool-reserve 0 *fn2-boot-kind* id ogen fn2-pool))
      ((mv g dslot dgen fn2-pool) (fn2-pool-reserve 0 *fn2-boot-kind* id ogen fn2-pool))
      ((mv h fn2-pool) (fn2-pool-write root gen 0 68 *fn2-boot-kind* (if (eq mode :foreign) (+ 1 id) id) ogen fn2-pool))
      ((mv borrowed fn2-pool) (if (eq mode :borrowed) (fn2-pool-lease-out root gen 0 1 *fn2-boot-kind* id ogen fn2-pool) (mv :ok fn2-pool))))
  (mv (and (eq a :ok) (eq b :ok) (eq c :ok) (member-eq d '(:ok :retired)) (member-eq e '(:ok :retired))
           (eq f :ok) (eq g :ok) (eq h :ok) (eq borrowed :ok)) root gen rslot rgen wslot wgen bslot bgen dslot dgen fn2-pool)))

(defun fn2-brru-capture (id ogen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-checkpoints (fn2-core-checkpoints fn2-core))
             (fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
             (fn2-checkpoint-summary-authority (fn2-core-checkpoint-summary-authority fn2-core))
             (fn2-checkpoint-cbase-holds (fn2-core-checkpoint-cbase-holds fn2-core)))
  (fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds)
  (b* ((fn2-checkpoints (fn2-checkpoints-put 0 (state *fn2-checkpoint-state-checked*) (checkpoint 1) (history 1) (incarnation 1)))
       (fn2-checkpoint-summary (fn2-checkpoint-summary-put 0 (phase *fn2-checkpoint-summary-phase-applied*)
        (tag 1) (candidate 0) (checkpoint 1) (history 1) (incarnation 1) (generation 1)
        (owner-kind *fn2-boot-kind*) (owner-slot id) (owner-gen ogen)))
       (fn2-checkpoint-summary-authority (fn2-checkpoint-summary-authority-put 0
        (phase *fn2-checkpoint-summary-authority-phase-complete*) (origin *fn2-checkpoint-summary-authority-origin-cold*)
        (tag 1) (catalog-tag 1) (candidate 0) (checkpoint 1) (history 1) (incarnation 1) (generation 1) (cursor 488)
        (owner-kind *fn2-boot-kind*) (owner-slot id) (owner-gen ogen)))
       (fn2-checkpoint-cbase-holds (fn2-checkpoint-cbase-holds-put 0 (phase *fn2-checkpoint-cbase-phase-held*)
        (tag 1) (checkpoint 1) (history 1) (incarnation 1) (generation 1) (limit 1) (cursor 1) (seen 1)
        (owner-kind *fn2-boot-kind*) (owner-slot id) (owner-gen ogen))))
   (mv fn2-checkpoints fn2-checkpoint-summary fn2-checkpoint-summary-authority fn2-checkpoint-cbase-holds)) fn2-core))

(defun fn2-brru-observe (id root fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((identity (list (fn2-machine-root-slot id fn2-core) (fn2-machine-root-gen id fn2-core)
                       (fn2-machine-root-cursor id fn2-core) (fn2-machine-root-role id fn2-core))))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (result)
   (list identity (fn2-pool-state root fn2-pool) (fn2-pool-gen root fn2-pool)
         (fn2-pool-fill root fn2-pool) (fn2-pool-out-count root fn2-pool)
         (fn2-pool-owner-kind root fn2-pool) (fn2-pool-owner-slot root fn2-pool) (fn2-pool-owner-gen root fn2-pool)
         (fn2-pool-lease-op-slot root fn2-pool) (fn2-pool-lease-op-gen root fn2-pool)
         (fn2-pool-lease-off root fn2-pool) (fn2-pool-lease-len root fn2-pool)
         (fn2-pool-datai (fn2-pool-base root fn2-pool) fn2-pool)) result)))

(defun fn2-brru-body (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init (put-assoc-equal :image-boot t *fn2-profile-tiny*) fn2-core))
      (id (fn2-machine-kind-base *fn2-boot-kind* fn2-core)) (ogen (fn2-machine-generation id fn2-core))
      (recovery (fn2-machine-kind-base *fn2-recovery-machine-kind* fn2-core)) (rogen (fn2-machine-generation recovery fn2-core))
      ((mv prepared root gen rslot rgen wslot wgen bslot bgen dslot dgen fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
        (prepared root gen rslot rgen wslot wgen bslot bgen dslot dgen fn2-pool)
        (fn2-brru-pool id ogen recovery rogen mode fn2-pool)
        (mv prepared root gen rslot rgen wslot wgen bslot bgen dslot dgen fn2-core)))
      (claimed-gen (if (eq mode :stale) (+ 1 gen) gen))
      (fn2-core (fn2-boot-put-core id (phase *fn2-boot-state-epoch-result*) (stage 3) (stopped 0)
        (event-ready 1) (outcome *fn2-outcome-done*) (pending 0) (root-slot root) (root-gen claimed-gen) (root-cursor 65536) (root-role 4)
        (pool-slot bslot) (pool-gen bgen) (rx-slot dslot) (rx-gen dgen)))
      (fn2-core (fn2-recovery-machine-put-core recovery (phase *fn2-recovery-machine-state-done*) (stopped 1) (pending 0)
        (rc-class *fn2-rec-class-intact*) (pool-slot rslot) (pool-gen rgen) (rc-wslot wslot) (rc-wgen wgen)))
      (fn2-core (stobj-let (
       (fn2-checkpoint-restore-reader (fn2-core-checkpoint-restore-reader fn2-core))
       (fn2-checkpoint-restore-semantic (fn2-core-checkpoint-restore-semantic fn2-core))
       (fn2-checkpoint-restore-events (fn2-core-checkpoint-restore-events fn2-core))
       (fn2-checkpoint-recovery-evidence (fn2-core-checkpoint-recovery-evidence fn2-core)))
       (fn2-checkpoint-restore-reader fn2-checkpoint-restore-semantic fn2-checkpoint-restore-events fn2-checkpoint-recovery-evidence)
       (b* ((fn2-checkpoint-restore-reader (fn2-brru-terminal fn2-checkpoint-restore-reader *fn2-checkpoint-restore-reader-phase-done* root claimed-gen id ogen))
            (fn2-checkpoint-restore-semantic (fn2-brru-terminal fn2-checkpoint-restore-semantic *fn2-checkpoint-restore-semantic-phase-complete* root claimed-gen id ogen))
            (fn2-checkpoint-restore-events (fn2-brru-terminal fn2-checkpoint-restore-events *fn2-checkpoint-restore-events-phase-complete* root claimed-gen id ogen))
            (fn2-checkpoint-recovery-evidence (fn2-brru-terminal fn2-checkpoint-recovery-evidence *fn2-checkpoint-recovery-evidence-phase-complete* root claimed-gen id ogen)))
        (mv fn2-checkpoint-restore-reader fn2-checkpoint-restore-semantic fn2-checkpoint-restore-events fn2-checkpoint-recovery-evidence)) fn2-core))
      (fn2-core (fn2-brru-capture id ogen fn2-core))
      (fn2-core (if (eq mode :consumer)
       (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))) (fn2-event-read)
        (fn2-event-read-set-phase 0 *fn2-event-read-phase-members* fn2-event-read) fn2-core) fn2-core))
      ((mv issued & & fn2-core) (if (eq mode :io)
        (fn2-issue-read 0 root gen 1 *fn2-boot-kind* id ogen 0 fn2-core) (mv :ok 0 0 fn2-core)))
      (before (fn2-brru-observe id root fn2-core))
      ((mv code fn2-core) (fn2-boot-release-root-window id (if (eq mode :owner) (+ 1 ogen) ogen) fn2-core))
      (after (fn2-brru-observe id root fn2-core)))
  (mv (and prepared (eq issued :ok)
       (cond ((member-eq mode '(:ok :retired))
              (and (eq code (if (eq mode :retired) :retired :ok)) (equal (car after) '(0 0 0 0))
                   (equal (cadr after) (if (eq mode :retired) *fn2-pool-state-retired* *fn2-pool-state-free*))))
             (t (and (not (member-eq code '(:ok :retired))) (equal before after))))) fn2-core)))

(defun fn2-brru-test (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (result fn2-core) (fn2-brru-body mode fn2-core) result)))
(assert-event (fn2-brru-test :ok))
(assert-event (fn2-brru-test :retired))
(assert-event (fn2-brru-test :stale))
(assert-event (fn2-brru-test :foreign))
(assert-event (fn2-brru-test :borrowed))
(assert-event (fn2-brru-test :io))
(assert-event (fn2-brru-test :consumer))
(assert-event (fn2-brru-test :recovery-window))
(assert-event (fn2-brru-test :owner))

; Fresh creation or an actual all-empty scan may have no root allocation.
; An absent generation on a nonempty scan is not permission to skip cleanup.
(defun fn2-brru-absent-body (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init (put-assoc-equal :image-boot t *fn2-profile-tiny*) fn2-core))
      (id (fn2-machine-kind-base *fn2-boot-kind* fn2-core)) (ogen (fn2-machine-generation id fn2-core))
      (fn2-core (fn2-boot-put-core id (phase *fn2-boot-state-epoch-result*) (stage 3) (stopped 0)
       (event-ready 1) (outcome *fn2-outcome-done*) (pending 0) (create (if (eq mode :create) 1 0))
       (root-slot 0) (root-gen 0) (root-cursor 0)))
      (fn2-core (stobj-let ((fn2-boot-config (fn2-core-boot-config fn2-core))) (fn2-boot-config)
       (let* ((fn2-boot-config (update-fn2-boot-config-anchor-empty-mask 15 fn2-boot-config))
              (fn2-boot-config (update-fn2-boot-config-anchor-checked-mask (if (eq mode :nonempty) 1 0) fn2-boot-config)))
        fn2-boot-config) fn2-core))
      (before (fn2-brru-observe id 0 fn2-core))
      ((mv code fn2-core) (fn2-boot-release-root-window id ogen fn2-core)))
  (mv (and (eq code (if (eq mode :nonempty) :state :ok)) (equal before (fn2-brru-observe id 0 fn2-core))) fn2-core)))
(defun fn2-brru-absent-test (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (result fn2-core) (fn2-brru-absent-body mode fn2-core) result)))
(assert-event (fn2-brru-absent-test :create))
(assert-event (fn2-brru-absent-test :empty))
(assert-event (fn2-brru-absent-test :nonempty))

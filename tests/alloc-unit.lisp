; Deliberate internal-corruption witnesses. A broken free or pending link is
; named (:links, asserted below; the commit kind stops the core with
; :alloc-links); the raw driver expects accounting underflow to signal a hard
; error. Returning pressure/:ok would absorb an allocator correctness bug.
(defun fn2-alloc-test-corruption (kind)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-extents
    (mv-let (code fn2-extents)
      (let* ((fn2-extents (fn2-alloc-init 1 fn2-extents))
             (fn2-extents
              (case kind
                (:free-link (update-fn2-alloc-free-head 17 fn2-extents))
                (:pending-link (update-fn2-alloc-pending 17 fn2-extents))
                (otherwise (update-fn2-alloc-total-free 0 fn2-extents)))))
        (mv-let (code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents)
          (assert$ (eq code :ok)
            (if (eq kind :pending-link)
                (fn2-alloc-checkpoint-advance 0 1 fn2-extents)
              (mv-let (code reason i epoch counter fn2-extents) (fn2-alloc-reserve fn2-extents)
                (declare (ignore reason i epoch counter))
                (mv code fn2-extents))))))
      code)))
(assert-event (equal (fn2-alloc-test-corruption :free-link) :links))
(assert-event (equal (fn2-alloc-test-corruption :pending-link) :links))
(defun fn2-alloc-test-edge-corruption (kind)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-extents
    (mv-let (code fn2-extents)
      (with-local-stobj fn2-alloc-edges
        (mv-let (code fn2-extents fn2-alloc-edges)
          (b* ((fn2-extents (fn2-alloc-init 1 fn2-extents))
               (fn2-alloc-edges (fn2-alloc-edges-init 1 fn2-alloc-edges))
               ((mv code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
               (- (assert$ (eq code :ok) nil))
               ((mv code & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
               (- (assert$ (eq code :ok) nil))
               ((when (eq kind :saturated))
                (let ((fn2-extents (fn2-extents-set-borrow 0 *fn2-alloc-edge-count-max* fn2-extents)))
                  (fn2-alloc-edge-add 0 101 0 1 0 :borrow fn2-extents fn2-alloc-edges)))
               ((mv code fn2-extents fn2-alloc-edges)
                (fn2-alloc-edge-add 0 101 0 1 0 :borrow fn2-extents fn2-alloc-edges))

(assert-event (equal (fn2-check-reclaim
                       '((:reserve 0 (1 0)) (:edge-add 0 :borrow :reservation 1)))
                     '(1 (:edge-add 0 :borrow :reservation 1) :edge-bounds)))
(assert-event (equal (fn2-check-reclaim
                       '((:reserve 0 (1 0)) (:edge-add 0 :borrow)))
                     '(1 (:edge-add 0 :borrow) :edge-bounds)))

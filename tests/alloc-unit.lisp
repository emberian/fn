  (eq (symbol-class 'fn2-alloc-cancel-reservation (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-relocate (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-pressure (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-releasablep (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-begin-epoch (w state)) :common-lisp-compliant)
  (eq (symbol-class 'fn2-alloc-checkpoint-advance (w state)) :common-lisp-compliant)
))
(defun fn2-alloc-pressure-teeth ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-extents
    (mv-let (ok fn2-extents)
      (with-local-stobj fn2-alloc-edges
        (mv-let (ok fn2-extents fn2-alloc-edges)
          (let ((fn2-alloc-edges (fn2-alloc-edges-init 640 fn2-alloc-edges)))
            (b* ((fn2-extents (fn2-alloc-init 1 fn2-extents))
           ((mv setup-code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
           (- (assert$ (eq setup-code :ok) nil))
           ((mv setup-code & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
           (- (assert$ (eq setup-code :ok) nil))
           ((mv code reason & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
           (live (and (eq code :no-space) (eq reason :all-live)))
           ((mv setup-code fn2-extents) (fn2-alloc-commit-allocation 0 1 0 1 1 fn2-extents))
           (- (assert$ (eq setup-code :ok) nil))
           ((mv setup-code fn2-extents) (fn2-alloc-retire 0 1 0 1 fn2-extents))
           (- (assert$ (eq setup-code :ok) nil))
           (blocked (eq (fn2-alloc-pressure fn2-extents) :checkpoint-blocked))
           ((mv setup-code fn2-extents fn2-alloc-edges) (fn2-alloc-edge-add (fn2-alloc-test-edge 0 :recovery-candidate) 0 0 1 0 :recovery-candidate fn2-extents fn2-alloc-edges))
           (- (assert$ (eq setup-code :ok) nil))
           (quarantine (eq (fn2-alloc-pressure fn2-extents) :quarantine))
           ((mv setup-code fn2-extents fn2-alloc-edges) (fn2-alloc-edge-drop (fn2-alloc-test-edge 0 :recovery-candidate) 0 0 1 0 :recovery-candidate fn2-extents fn2-alloc-edges))
           (- (assert$ (eq setup-code :ok) nil))
           ((mv setup-code fn2-extents) (fn2-alloc-checkpoint-advance 1 1 fn2-extents))
           (- (assert$ (eq setup-code :ok) nil)))
        (mv (and live blocked quarantine (eq (fn2-alloc-pressure fn2-extents) :ok)
                 (fn2-alloc-invp fn2-extents)) fn2-extents fn2-alloc-edges)))
          (mv ok fn2-extents)))
      ok)))
(assert-event (fn2-alloc-pressure-teeth))

; Two simultaneous holders of the same kind: neither can discharge the other.
(defun fn2-alloc-holder-tooth (kind)
  (declare (xargs :verify-guards nil))
  (equal (fn2-alloc-test-run
    (list '(:reserve 0 nil 0 :ok) '(:commit 0 nil 0 :ok)
          (list :edge-add 0 kind '(101 600) :ok)
          (list :edge-add 0 kind '(102 601) :ok)
          '(:retire 0 nil 0 :ok)
          (list :edge-drop 0 kind '(102 600) :edge-holder)
          (list :release 0 nil 0 kind)
          (list :edge-drop 0 kind '(101 600) :ok)
          (list :release 0 nil 0 kind)
          (list :edge-drop 0 kind '(101 601) :edge-holder)
          (list :release 0 nil 0 kind)
          (list :edge-drop 0 kind '(102 601) :ok)
          '(:release 0 nil 0 :ok))) t))
(assert-event (fn2-alloc-holder-tooth :borrow))
(assert-event (fn2-alloc-holder-tooth :promised-read))
(assert-event
 (equal (fn2-check-reclaim
   '((:reserve 0 (1 0)) (:commit 0) (:edge-add 0 :borrow 600 101)
     (:retire 0 0) (:edge-drop 0 :borrow 600 102) (:release 0)))
   '(4 (:edge-drop 0 :borrow 600 102) :edge-holder)))
(assert-event
 (equal (fn2-check-reclaim
   '((:reserve 0 (1 0)) (:commit 0) (:edge-add 0 :promised-read 601 102)
     (:retire 0 0) (:edge-drop 0 :promised-read 601 101) (:release 0)))
   '(4 (:edge-drop 0 :promised-read 601 101) :edge-holder)))
; The new ownership theorem's whole antecedent/conclusion and the concrete
; counterexample after removing its successful-result hypothesis.
(defun fn2-alloc-holder-keystone-tooth ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-extents
    (mv-let (answer fn2-extents)
      (with-local-stobj fn2-alloc-edges
        (mv-let (answer fn2-extents fn2-alloc-edges)
          (b* ((fn2-extents (fn2-alloc-init 1 fn2-extents))
               (fn2-alloc-edges (fn2-alloc-edges-init 1 fn2-alloc-edges))
               ((mv code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
               (- (assert$ (eq code :ok) nil))
               ((mv code & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
               (- (assert$ (eq code :ok) nil))
               ((mv code fn2-extents fn2-alloc-edges)
                (fn2-alloc-edge-add 0 101 0 1 0 :borrow fn2-extents fn2-alloc-edges))
               (- (assert$ (eq code :ok) nil))
               (positive-conclusion (fn2-alloc-edge-matchesp 0 101 0 1 0 :borrow fn2-alloc-edges))
               (removed-hyp-conclusion (fn2-alloc-edge-matchesp 0 102 0 1 0 :borrow fn2-alloc-edges))
               ((mv outsider-code fn2-extents fn2-alloc-edges)
                (fn2-alloc-edge-drop 0 102 0 1 0 :borrow fn2-extents fn2-alloc-edges))
               (protected (and (equal (fn2-extents-borrow 0 fn2-extents) 1)
                               (equal (fn2-alloc-edges-holder 0 fn2-alloc-edges) 101)))
               ((mv owner-code fn2-extents fn2-alloc-edges)
                (fn2-alloc-edge-drop 0 101 0 1 0 :borrow fn2-extents fn2-alloc-edges)))
            (mv (and (equal owner-code :ok) positive-conclusion
                     (not (equal outsider-code :ok)) (not removed-hyp-conclusion)
                     protected (fn2-alloc-ownership-invp fn2-extents fn2-alloc-edges)) fn2-extents fn2-alloc-edges))
          (mv answer fn2-extents)))
      answer)))
(assert-event (fn2-alloc-holder-keystone-tooth))

; Malformed evidence cannot turn a missing/negative checkpoint into cut zero.
(assert-event (equal (fn2-check-reclaim '((:checkpoint-installed -1)))
                     '(0 (:checkpoint-installed -1) :checkpoint-order)))
(assert-event (equal (fn2-check-reclaim '((:checkpoint-installed nil)))
                     '(0 (:checkpoint-installed nil) :checkpoint-order)))

(defun fn2-alloc-test-op (op i kind arg fn2-extents fn2-alloc-edges)
  (declare (xargs :stobjs (fn2-extents fn2-alloc-edges) :verify-guards nil))
  (let ((epoch (if (fn2-alloc-slotp i fn2-extents) (fn2-extents-epoch i fn2-extents) 0))
        (counter (if (fn2-alloc-slotp i fn2-extents) (fn2-extents-counter i fn2-extents) 0)))
    (case op
      (:reserve (mv-let (code reason j e c fn2-extents) (fn2-alloc-reserve fn2-extents)
        (declare (ignore reason)) (mv code (and (eq code :ok) (list :reserve j (list e c))) fn2-extents fn2-alloc-edges)))
      (:commit (mv-let (code fn2-extents) (fn2-alloc-commit-allocation i epoch counter 1 1 fn2-extents)
        (mv code (and (eq code :ok) (list :commit i)) fn2-extents fn2-alloc-edges)))
      (:retire (mv-let (code fn2-extents) (fn2-alloc-retire i epoch counter arg fn2-extents)
        (mv code (and (eq code :ok) (list :retire i arg)) fn2-extents fn2-alloc-edges)))
      (:release (mv-let (code fn2-extents) (fn2-alloc-release i epoch counter fn2-extents)
        (mv code (and (eq code :ok) (list :release i)) fn2-extents fn2-alloc-edges)))
      (:cancel (mv-let (code fn2-extents) (fn2-alloc-cancel-reservation i epoch counter fn2-extents)
        (mv code (and (eq code :ok) (list :cancel i)) fn2-extents fn2-alloc-edges)))
      (:edge-add (mv-let (code fn2-extents fn2-alloc-edges) (fn2-alloc-edge-add (if (consp arg) (cadr arg) (fn2-alloc-test-edge i kind))
          (if (consp arg) (car arg) arg) i epoch counter kind fn2-extents fn2-alloc-edges)
        (mv code (and (eq code :ok) (list :edge-add i kind (if (consp arg) (cadr arg) (fn2-alloc-test-edge i kind))
              (if (consp arg) (car arg) arg))) fn2-extents fn2-alloc-edges)))
      (:edge-drop (mv-let (code fn2-extents fn2-alloc-edges) (fn2-alloc-edge-drop (if (consp arg) (cadr arg) (fn2-alloc-test-edge i kind))
          (if (consp arg) (car arg) arg) i epoch counter kind fn2-extents fn2-alloc-edges)
        (mv code (and (eq code :ok) (list :edge-drop i kind (if (consp arg) (cadr arg) (fn2-alloc-test-edge i kind))
              (if (consp arg) (car arg) arg))) fn2-extents fn2-alloc-edges)))
      (:checkpoint-advance (mv-let (code fn2-extents) (fn2-alloc-checkpoint-advance arg kind fn2-extents)
        (mv code (and (eq code :ok) (list :checkpoint-installed (fn2-alloc-cut fn2-extents))) fn2-extents fn2-alloc-edges)))
      (:begin-epoch (mv-let (code fn2-extents) (fn2-alloc-begin-epoch arg fn2-extents)
        (mv code nil fn2-extents fn2-alloc-edges)))
      (:relocate (let ((j (mod (+ i 1) (max 1 (fn2-extents-rows fn2-extents)))))
        (mv-let (code fn2-extents fn2-alloc-edges) (fn2-alloc-relocate (fn2-alloc-test-edge i :installed-root) 0 i epoch counter j
          (fn2-extents-epoch j fn2-extents) (fn2-extents-counter j fn2-extents) t fn2-extents fn2-alloc-edges)
          (mv code (and (eq code :ok) (list :relocate i j (fn2-alloc-test-edge i :installed-root) 0)) fn2-extents fn2-alloc-edges))))
      (otherwise (mv :unknown nil fn2-extents fn2-alloc-edges)))))

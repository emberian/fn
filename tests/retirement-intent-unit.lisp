; Actual allocator/coordinator entry controls. No independent retirement model.
; Source prepared only: physical writer/fence execution remains a separate gate.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../sim/commit-proof-step")

(defun fn2-riu-leaf-body (fn2-fields fn2-extents fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-fields fn2-extents fn2-alloc-edges) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init 16 fn2-fields))
      (fn2-extents (fn2-alloc-init 4 fn2-extents))
      (fn2-alloc-edges (fn2-alloc-edges-init 12 fn2-alloc-edges))
      ((mv epoch-begun fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv a & target epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv ac fn2-extents) (fn2-alloc-commit-allocation target epoch allocation 1 100 fn2-extents))
      ((mv b & other other-epoch other-allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv bc fn2-extents) (fn2-alloc-commit-allocation other other-epoch other-allocation 1 100 fn2-extents))
      ((mv spare-held & spare spare-epoch spare-allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv spare-committed fn2-extents) (fn2-alloc-commit-allocation spare spare-epoch spare-allocation 1 100 fn2-extents))
      ((mv old-protector fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 0 50 target epoch allocation :obligation fn2-extents fn2-alloc-edges))
      ((mv other-protector fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 1 60 other other-epoch other-allocation :selectable-checkpoint fn2-extents fn2-alloc-edges))
      ((mv intent fn2-extents) (fn2-alloc-retirement-intent-begin target epoch allocation 10 fn2-extents))
      (before-refusal (fn2-alloc-view fn2-extents))
      ((mv closed fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 2 99 target epoch allocation :installed-root fn2-extents fn2-alloc-edges))
      (refusal-exact (and (eq closed :retirement-pending) (equal before-refusal (fn2-alloc-view fn2-extents))
        (= (fn2-alloc-edges-state 2 fn2-alloc-edges) *fn2-alloc-edge-state-free*)
        (fn2-alloc-retirement-intentp target epoch allocation fn2-extents)
        (= (fn2-alloc-retirement-intent-batch fn2-extents) 10)))
      ((mv pin fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 3 70 target epoch allocation :promised-read fn2-extents fn2-alloc-edges))
      ; Intent for TARGET cannot close an unrelated allocation's publication.
      ((mv unrelated fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 7 80 other other-epoch other-allocation :installed-root fn2-extents fn2-alloc-edges))
      (other-view (assoc-equal other (fn2-alloc-view fn2-extents)))
      (before-relocate (fn2-alloc-view fn2-extents))
      ((mv closed-move fn2-extents fn2-alloc-edges)
       (fn2-alloc-relocate 7 80 other other-epoch other-allocation target epoch allocation t fn2-extents fn2-alloc-edges))
      (move-refusal-exact (and (eq closed-move :retirement-pending) (equal before-relocate (fn2-alloc-view fn2-extents))
        (fn2-alloc-edge-matchesp 7 80 other other-epoch other-allocation :installed-root fn2-alloc-edges)))
      (fn2-extents (update-fn2-alloc-freeze-phase 1 fn2-extents))
      ((mv frozen-move fn2-extents fn2-alloc-edges)
       (fn2-alloc-relocate 7 80 other other-epoch other-allocation spare spare-epoch spare-allocation t fn2-extents fn2-alloc-edges))
      (freeze-refusal-exact (and (eq frozen-move :frozen) (equal before-relocate (fn2-alloc-view fn2-extents))
        (fn2-alloc-edge-matchesp 7 80 other other-epoch other-allocation :installed-root fn2-alloc-edges)))
      (fn2-extents (update-fn2-alloc-freeze-phase 0 fn2-extents))
      ((mv unrelated-move fn2-extents fn2-alloc-edges)
       (fn2-alloc-relocate 7 80 other other-epoch other-allocation spare spare-epoch spare-allocation t fn2-extents fn2-alloc-edges))
      ((mv move-back fn2-extents fn2-alloc-edges)
       (fn2-alloc-relocate 7 80 spare spare-epoch spare-allocation other other-epoch other-allocation t fn2-extents fn2-alloc-edges))
      (before-cancel (fn2-alloc-view fn2-extents))
      ((mv stale-epoch fn2-extents) (fn2-alloc-retirement-intent-cancel target (+ 1 epoch) allocation 10 fn2-extents))
      (stale-epoch-exact (and (eq stale-epoch :intent) (equal before-cancel (fn2-alloc-view fn2-extents))
        (fn2-alloc-retirement-intentp target epoch allocation fn2-extents)
        (= (fn2-alloc-retirement-intent-batch fn2-extents) 10)))
      ((mv wrong-cancel fn2-extents) (fn2-alloc-retirement-intent-cancel target epoch allocation 11 fn2-extents))
      (wrong-cancel-exact (and (eq wrong-cancel :intent) (equal before-cancel (fn2-alloc-view fn2-extents))
        (fn2-alloc-retirement-intentp target epoch allocation fn2-extents)
        (= (fn2-alloc-retirement-intent-batch fn2-extents) 10)))
      ((mv cancelled fn2-extents) (fn2-alloc-retirement-intent-cancel target epoch allocation 10 fn2-extents))
      ((mv reopened fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 2 99 target epoch allocation :installed-root fn2-extents fn2-alloc-edges))
      ((mv dropped fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-drop 2 99 target epoch allocation :installed-root fn2-extents fn2-alloc-edges))
      ((mv intent-again fn2-extents) (fn2-alloc-retirement-intent-begin target epoch allocation 12 fn2-extents))
      (fn2-fields (fn2-fields-set-value *fn2-format-retirement-field-extent* target fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-retirement-field-writer-epoch* epoch fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-retirement-field-allocation* allocation fn2-fields))
      (fn2-fields (fn2-fields-set-value *fn2-format-retirement-field-retirement-commit* 13 fn2-fields))
      (before-install (fn2-alloc-view fn2-extents))
      ((mv wrong-install fn2-extents) (fn2-retirement-install 13 0 fn2-fields fn2-extents))
      (wrong-install-exact (and (eq wrong-install :intent) (equal before-install (fn2-alloc-view fn2-extents))
        (fn2-alloc-retirement-intentp target epoch allocation fn2-extents)
        (= (fn2-alloc-retirement-intent-batch fn2-extents) 12)))
      (fn2-fields (fn2-fields-set-value *fn2-format-retirement-field-retirement-commit* 12 fn2-fields))
      ((mv installed fn2-extents) (fn2-retirement-install 12 0 fn2-fields fn2-extents))
      ((mv closed-after fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 2 99 target epoch allocation :installed-root fn2-extents fn2-alloc-edges))
      ((mv io-pin fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add 5 71 target epoch allocation :outstanding-io fn2-extents fn2-alloc-edges))
      ((mv too-late fn2-extents) (fn2-alloc-retirement-intent-cancel target epoch allocation 12 fn2-extents)))
  (mv (and (eq epoch-begun :ok) (eq a :ok) (eq ac :ok) (eq b :ok) (eq bc :ok)
           (eq spare-held :ok) (eq spare-committed :ok) (eq old-protector :ok) (eq other-protector :ok) (eq intent :ok) refusal-exact
           (eq pin :ok) (eq unrelated :ok) move-refusal-exact freeze-refusal-exact
           (eq unrelated-move :ok) (eq move-back :ok) stale-epoch-exact wrong-cancel-exact (eq cancelled :ok)
           (eq reopened :ok) (eq dropped :ok) (eq intent-again :ok) wrong-install-exact
           (eq installed :ok) (eq closed-after :retirement-pending) (eq io-pin :ok) (eq too-late :intent)
           (= (fn2-extents-state target fn2-extents) *fn2-extent-state-retire-pending*)
           (= (fn2-extents-retirement target fn2-extents) 12)
           (= (fn2-alloc-retirement-intent-batch fn2-extents) 0)
           (= (fn2-extents-obligation target fn2-extents) 1)
           (= (fn2-extents-promised-read target fn2-extents) 1)
           (= (fn2-extents-outstanding-io target fn2-extents) 1)
           (= (fn2-extents-installed-root target fn2-extents) 0)
           (= (fn2-alloc-edges-state 2 fn2-alloc-edges) *fn2-alloc-edge-state-free*)
           (fn2-alloc-edge-matchesp 0 50 target epoch allocation :obligation fn2-alloc-edges)
           (fn2-alloc-edge-matchesp 1 60 other other-epoch other-allocation :selectable-checkpoint fn2-alloc-edges)
           (fn2-alloc-edge-matchesp 7 80 other other-epoch other-allocation :installed-root fn2-alloc-edges)
           (equal other-view (assoc-equal other (fn2-alloc-view fn2-extents)))
           (fn2-alloc-invp fn2-extents) (fn2-alloc-ownership-invp fn2-extents fn2-alloc-edges))
      fn2-fields fn2-extents fn2-alloc-edges)))
(defun fn2-riu-leaf-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (ok fn2-fields)
   (with-local-stobj fn2-extents
    (mv-let (ok fn2-fields fn2-extents)
     (with-local-stobj fn2-alloc-edges
      (mv-let (ok fn2-fields fn2-extents fn2-alloc-edges)
       (fn2-riu-leaf-body fn2-fields fn2-extents fn2-alloc-edges) (mv ok fn2-fields fn2-extents)))
     (mv ok fn2-fields))) ok)))
(assert-event (fn2-riu-leaf-run))

; Actual SUBMIT and POLL, with an explicitly synthetic settlement injection.
; REFUSED exercises exact cancellation. ACCEPTED without a persisted retirement
; must become uncertain and retain its barrier/workspace; it is not an acceptance
; witness or execution of the physical journal writer/fence/install sequence.
(defun fn2-riu-submit-poll-body (acceptedp fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init (fn2-b-test-profile *fn2-profile-tiny* 0) fn2-core))
      (owner (fn2-machine-kind-base *fn2-scribe-kind* fn2-core))
      (ogen (fn2-machine-generation owner fn2-core))
      ((mv reserved target epoch allocation other other-epoch other-allocation fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)))
        (code target epoch allocation other other-epoch other-allocation fn2-extents)
        (b* (((mv begun fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
             ((mv held & target epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
             ((mv committed fn2-extents) (fn2-alloc-commit-allocation target epoch allocation 1 100 fn2-extents))
             ((mv other-held & other other-epoch other-allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
             ((mv other-committed fn2-extents) (fn2-alloc-commit-allocation other other-epoch other-allocation 1 100 fn2-extents)))
         (mv (and (eq begun :ok) (eq held :ok) (eq committed :ok) (eq other-held :ok) (eq other-committed :ok))
             target epoch allocation other other-epoch other-allocation fn2-extents))
        (mv code target epoch allocation other other-epoch other-allocation fn2-core)))
      ((mv spare-held spare spare-epoch spare-allocation fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code spare spare-epoch spare-allocation fn2-extents)
        (b* (((mv held & spare spare-epoch spare-allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
             ((mv committed fn2-extents) (fn2-alloc-commit-allocation spare spare-epoch spare-allocation 1 100 fn2-extents)))
         (mv (and (eq held :ok) (eq committed :ok)) spare spare-epoch spare-allocation fn2-extents))
        (mv code spare spare-epoch spare-allocation fn2-core)))
      ((mv protected fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
        (code fn2-extents fn2-alloc-edges)
        (fn2-alloc-edge-add 3 50 target epoch allocation :obligation fn2-extents fn2-alloc-edges) (mv code fn2-core)))
      ((mv submitted batch event fn2-core)
       (fn2-retirement-submit target epoch allocation *fn2-scribe-kind* owner ogen fn2-core))
      ((mv pending & & fn2-core) (fn2-retirement-poll *fn2-scribe-kind* owner ogen fn2-core))
      ((mv closed fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
        (code fn2-extents fn2-alloc-edges)
        (fn2-alloc-edge-add 0 99 target epoch allocation :installed-root fn2-extents fn2-alloc-edges) (mv code fn2-core)))
      ((mv pin fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
        (code fn2-extents fn2-alloc-edges)
        (fn2-alloc-edge-add 1 70 target epoch allocation :promised-read fn2-extents fn2-alloc-edges) (mv code fn2-core)))
      ((mv unrelated fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
        (code fn2-extents fn2-alloc-edges)
        (fn2-alloc-edge-add 2 60 other other-epoch other-allocation :installed-root fn2-extents fn2-alloc-edges) (mv code fn2-core)))
      (other-view (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (view)
                    (assoc-equal other (fn2-alloc-view fn2-extents)) view))
      ((mv move-closed fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
        (code fn2-extents fn2-alloc-edges)
        (fn2-alloc-relocate 2 60 other other-epoch other-allocation target epoch allocation t fn2-extents fn2-alloc-edges) (mv code fn2-core)))
      (move-source-retained (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                                       (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (same)
        (and (equal other-view (assoc-equal other (fn2-alloc-view fn2-extents)))
             (fn2-alloc-edge-matchesp 2 60 other other-epoch other-allocation :installed-root fn2-alloc-edges)) same))
      ((mv move-other fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
        (code fn2-extents fn2-alloc-edges)
        (fn2-alloc-relocate 2 60 other other-epoch other-allocation spare spare-epoch spare-allocation t fn2-extents fn2-alloc-edges) (mv code fn2-core)))
      ((mv move-back fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
        (code fn2-extents fn2-alloc-edges)
        (fn2-alloc-relocate 2 60 spare spare-epoch spare-allocation other other-epoch other-allocation t fn2-extents fn2-alloc-edges) (mv code fn2-core)))
      ((mv slot gen)
       (stobj-let ((fn2-retirement-control (fn2-core-retirement-control fn2-core))) (slot gen)
        (mv (fn2-retirement-control-slot 0 fn2-retirement-control) (fn2-retirement-control-gen 0 fn2-retirement-control)) (mv slot gen)))
      ((mv pick id &) (fn2-commit-pick fn2-core))
      ; The actual submit left this one-member collector open without a turn.
      ((unless (and reserved spare-held (eq submitted :ok) (posp batch) (posp event) (eq pending :pending)
                     (eq protected :ok) (eq move-closed :retirement-pending) move-source-retained (eq move-other :ok) (eq move-back :ok)
                     (eq closed :retirement-pending) (eq pin :ok) (eq unrelated :ok) (eq pick :join) (= (fn2-machine-batch-no id fn2-core) batch)))
       (mv nil fn2-core))
      (fn2-core (if (eq acceptedp :stop) (fn2-core-stop *fn2-stop-reason-commit-settle* fn2-core)
        (fn2-commit-settle-member id 0
         (if acceptedp *fn2-commit-outcome-accepted* *fn2-commit-outcome-refused*) (if acceptedp batch 0) fn2-core)))
      ((mv outcome actual-batch actual-event fn2-core) (fn2-retirement-poll *fn2-scribe-kind* owner ogen fn2-core))
      ((mv edge fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
        (code fn2-extents fn2-alloc-edges)
        (fn2-alloc-edge-add 0 99 target epoch allocation :installed-root fn2-extents fn2-alloc-edges) (mv code fn2-core)))
      (retained (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                            (fn2-retirement-control (fn2-core-retirement-control fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))
                            (fn2-pool (fn2-core-pool fn2-core))) (ok)
        (and (= (fn2-extents-state target fn2-extents) *fn2-extent-state-allocated*)
             (= (fn2-extents-promised-read target fn2-extents) 1) (= (fn2-extents-obligation target fn2-extents) 1)
             (fn2-alloc-edge-matchesp 1 70 target epoch allocation :promised-read fn2-alloc-edges)
             (fn2-alloc-edge-matchesp 3 50 target epoch allocation :obligation fn2-alloc-edges)
             (fn2-alloc-edge-matchesp 2 60 other other-epoch other-allocation :installed-root fn2-alloc-edges)
             (equal other-view (assoc-equal other (fn2-alloc-view fn2-extents)))
             (if acceptedp
              (and (fn2-alloc-retirement-intentp target epoch allocation fn2-extents)
                   (= (fn2-alloc-retirement-intent-batch fn2-extents) batch)
                   (= (fn2-retirement-control-state 0 fn2-retirement-control)
                      (if (eq acceptedp :stop) *fn2-retirement-state-waiting* *fn2-retirement-state-uncertain*))
                   (eq (fn2-pool-workspace-code slot gen *fn2-scribe-kind* owner ogen fn2-pool) :ok))
              (and (= (fn2-alloc-retirement-intent-batch fn2-extents) 0)
                   (= (fn2-retirement-control-state 0 fn2-retirement-control) *fn2-retirement-state-idle*)
                   (not (eq (fn2-pool-workspace-code slot gen *fn2-scribe-kind* owner ogen fn2-pool) :ok))))) ok)))
  (mv (and (= actual-batch batch) (= actual-event event) retained
           (if acceptedp (and (eq outcome :uncertain) (eq edge :retirement-pending) (fn2-core-stopped-p fn2-core))
             (and (eq outcome :refused) (eq edge :ok) (not (fn2-core-stopped-p fn2-core))))) fn2-core)))
(defun fn2-riu-submit-poll-run (acceptedp)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-riu-submit-poll-body acceptedp fn2-core) ok)))
(assert-event (fn2-riu-submit-poll-run nil))
(assert-event (fn2-riu-submit-poll-run t))
; A stopped core is ambiguity, not a refused or accepted settlement. POLL
; leaves the pending intent/workspace and existing protections intact.
(assert-event (fn2-riu-submit-poll-run :stop))

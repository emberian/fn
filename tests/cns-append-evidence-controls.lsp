; Run the actual APPEND reply projection and result selection. Stub the
; core readers, pool and generated codecs at their interfaces. The recorded
; fields are codec inputs, not an independent serialization.
; Run: sbcl --script tests/cns-append-evidence-controls.lsp [source-root]
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))

(defparameter *source-root* (or (second sb-ext:*posix-argv*) "."))
(defun source-forms (name)
 (with-open-file (in (concatenate 'string *source-root* "/" name))
  (loop for form = (read in nil :end) until (eq form :end) collect form)))
(defun source-form (head name tree)
 (when (consp tree)
  (if (and (eq (car tree) head) (consp (cdr tree)) (eq (cadr tree) name))
      tree
    (or (source-form head name (car tree)) (source-form head name (cdr tree))))))

(defmacro mv (&rest values) `(values ,@values))
(defmacro mv-let (vars computation &body body) `(multiple-value-bind ,vars ,computation ,@body))
(defmacro stobj-let (bindings vars computation &body body)
 `(let ,bindings (multiple-value-bind ,vars ,computation ,@body)))
(defmacro b* (bindings &body body)
 (if (endp bindings) `(progn ,@body)
   (destructuring-bind (pattern expression) (first bindings)
    (let ((tail `(b* ,(rest bindings) ,@body)))
      (cond ((symbolp pattern) `(let ((,pattern ,expression)) ,tail))
            ((eq (car pattern) 'mv) `(multiple-value-bind ,(cdr pattern) ,expression ,tail))
            ((eq (car pattern) 'when) `(if ,(second pattern) ,expression ,tail))
            ((eq (car pattern) 'unless) `(if ,(second pattern) ,tail ,expression))
            (t (error "Unsupported b* pattern ~s" pattern)))))))
(defun len (value) (length value))
(defun nfix (value) (if (typep value '(integer 0)) value 0))
(defun posp (value) (typep value '(integer 1)))
(defun unsigned-byte-p (width value) (typep value `(unsigned-byte ,width)))
(defun member-equal (value values) (member value values :test #'equal))

(defun define-enum (name values)
 (loop for word in values for i from 0 do
  (eval `(defparameter ,(intern (format nil "*~a-~a*" name (symbol-name word))) ,i))))
(let* ((machine (source-form 'defmachine 'fn2-cns (source-forms "books/cns-kind.lisp")))
       (fields (getf (cddr machine) :fields)))
 (dolist (field '(verb outcome posted))
  (destructuring-bind (kind name values) (second (assoc field fields))
   (assert (eq kind :enum))
   (define-enum name values))))
(let* ((codecs (source-forms "books/consumer-codec.lisp"))
       (results (second (third (source-form 'defconst '*fn2-fnct-results* codecs))))
       (append-fields (second (assoc 'append results)))
       (evidence (second (assoc 'evidence append-fields))))
 (assert (eq (first evidence) :enum))
 (define-enum (second evidence) (third evidence)))
(defparameter *upload-words*
  (second (third (source-form 'defconst '*fn2-upload-words* (source-forms "books/upload-kind.lisp")))))
(define-enum 'fn2-upload-word *upload-words*)
(defparameter *fn2-ctl-state-waiting* :waiting)
(defparameter *fn2-ctl-kind* 2)
(defparameter *fn2-format-message-id-max* 250)

(defun fn2-ctl-snapshot-read-code (id core) (declare (ignore id core)) :ok)
(defun fn2-cns-snapshot-read-code (id core) (declare (ignore id core)) :ok)
(defun fn2-machine-generation (id core) (declare (ignore id core)) 3)
(defun fn2-ctl-row-request (ctl core) (declare (ignore ctl core)) 5)
(defun fn2-ctl-row-phase (ctl core) (declare (ignore ctl core)) :waiting)
(defun fn2-ctl-row-cns (ctl core) (declare (ignore ctl core)) 2)
(defun fn2-ctl-row-cns-gen (ctl core) (declare (ignore ctl core)) 4)
(defun fn2-ctl-row-rx-slot (ctl core) (declare (ignore ctl core)) 12)
(defun fn2-ctl-row-rx-gen (ctl core) (declare (ignore ctl core)) 6)
(defun fn2-ctl-row-principal (ctl core) (declare (ignore ctl core)) 7)
(defun fn2-ctl-fc-row (ctl core) (declare (ignore ctl core)) (mv :ok 8))
(defun fn2-cns-row-posted (cns core) (declare (ignore cns)) (getf core :posted))
(defun fn2-core-history-values (core) (declare (ignore core)) (mv 1 1))
(defun fn2-core-fields (core) (declare (ignore core)) nil)
(defun fn2-core-b3 (core) (declare (ignore core)) nil)
(defun fn2-core-digests (core) (declare (ignore core)) nil)
(defun fn2-core-pool (core) (getf core :pool))
(defun fn2-machine-write-tx-off (ctl off core) (declare (ignore ctl off)) core)
(defun fn2-machine-write-tx-len (ctl len core) (declare (ignore ctl len)) core)

(defvar *codec-input*)
(defvar *append-result*)
(defun fn2-cns-stage-append-result (ctl ctl-gen tx-slot tx-gen cns cgen ns ngen mlen core)
 (declare (ignore ctl ctl-gen tx-slot tx-gen cns cgen ns ngen))
 (assert (= mlen 3))
 (mv :ok (list* :pool "<a>" core)))
(defun fn2-pool-fill-value (slot pool) (declare (ignore slot)) (length pool))
(defun fn2-pool-append-text (off text slot gen kind owner owner-gen pool)
 (declare (ignore off slot gen kind owner owner-gen))
 (mv :ok (concatenate 'string pool text)))
(defun fn2-cns-put-append (base off len position evidence slot gen kind owner owner-gen fields pool)
 (declare (ignore base slot gen kind owner owner-gen))
 (setf *append-result* (list (subseq pool off (+ off len)) position evidence))
 (mv :ok (length pool) 1 fields (concatenate 'string pool "@")))
(defun fn2-fnct-put-k28 (base row class roff rlen qoff qlen slot gen kind owner owner-gen fields digests b3 pool)
 (declare (ignore base row qoff slot gen kind owner owner-gen))
 (setf *codec-input* (list class (subseq pool roff (+ roff rlen)) qlen *append-result*))
 (mv :ok 0 1 fields digests b3 pool))

(defvar *fn2-cns-reason-words*)
(defvar *fn2-cns-upload-word-strings*)
(let ((forms (source-forms "books/cns.lisp")))
 (handler-bind ((style-warning #'muffle-warning))
  (dolist (name '(fn2-cns-word-strings fn2-cns-reason-word fn2-cns-reply-class
                  fn2-cns-put-result fn2-cns-reply-pool fn2-cns-post-reply))
   (when (eq name 'fn2-cns-reason-word)
    (set '*fn2-cns-reason-words* (second (third (source-form 'defconst '*fn2-cns-reason-words* forms))))
    (set '*fn2-cns-upload-word-strings* (fn2-cns-word-strings *upload-words*)))
   (eval (or (source-form 'defun name forms) (error "Missing source function ~s" name))))))

(defun projection (posted position &optional (reason *fn2-upload-word-conflict*))
 (let ((*codec-input* nil) (*append-result* nil))
  (let ((code (fn2-cns-post-reply 1 3 5 *fn2-cns-verb-append* *fn2-cns-outcome-refused* reason
                 0 0 0 position 0 0 0 0 0 0 12 6 2 4 13 8 3 (list :posted posted :pool ""))))
   (list code *codec-input*))))

(assert (equal (list *fn2-fnct-evidence-committed* *fn2-fnct-evidence-uncertain*
                     *fn2-fnct-evidence-refused*) '(1 2 3)))
(assert (equal (projection *fn2-cns-posted-accepted* 17)
               `(:ok (1 "conflict" 1 ("<a>" 17 ,*fn2-fnct-evidence-committed*)))))
(assert (equal (projection *fn2-cns-posted-uncertain* 0)
               `(:ok (1 "conflict" 1 ("<a>" 0 ,*fn2-fnct-evidence-uncertain*)))))
(assert (equal (projection *fn2-cns-posted-refused* 0)
               `(:ok (1 "conflict" 1 ("<a>" 0 ,*fn2-fnct-evidence-refused*)))))
(dolist (case (list (list *fn2-cns-posted-accepted* 0)
                    (list *fn2-cns-posted-uncertain* 17)
                    (list *fn2-cns-posted-refused* 17)
                    (list *fn2-cns-posted-none* 0)))
 (assert (equal (apply #'projection case) '(:fault nil))))
(assert (equal (projection *fn2-cns-posted-refused* 0 *fn2-upload-word-refused*)
               '(:ok (1 "refused" 0 nil))))
(format t "CNS APPEND EVIDENCE SOURCE CONTROLS PASS: three conflict outcomes, event checks, empty generic refusal~%")

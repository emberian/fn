;;; Actual native nonblocking TCP and readiness backend, without a node image.
;;; sbcl --script tests/native-connect-ffi.lsp
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(load "host/ffi.lisp")

(defun check-connect (port mux)
  (multiple-value-bind (status fd) (fn2-native-connect-start :inet port #x7f000001 0 0 0)
    (when (eq status :waiting)
      (fn2-native-mux-interest mux 0 fd 4)
      (loop repeat 3
            do (fn2-native-mux-wait mux 1000)
            when (fn2-native-mux-ready-p mux 0 4)
              do (setf status (fn2-native-connect-finish fd))
            until (not (eq status :waiting)))
      (fn2-native-mux-interest mux 0 fd 0))
    (values status fd)))

(let ((mux (make-fn2-native-mux 1)) (listener -1) (client -1) (accepted -1))
  (unwind-protect
       (multiple-value-bind (lfd port) (fn2-native-listen 0)
         (setf listener lfd)
         (multiple-value-bind (status fd) (check-connect port mux)
           (setf client fd)
           (assert (eq status :connected)))
         (setf accepted (fn2-native-accept listener))
         (assert (>= accepted 0))
         (sb-alien:with-alien ((byte sb-alien:unsigned-char 42))
           (let ((sap (sb-alien:alien-sap (sb-alien:addr byte))))
             (assert (= 1 (fn2-native-send client sap 1)))
             (fn2-native-mux-interest mux 0 accepted 1)
             (fn2-native-mux-wait mux 1000)
             (assert (fn2-native-mux-ready-p mux 0 1))
             (fn2-native-mux-interest mux 0 accepted 0)
             (setf byte 0)
             (assert (= 1 (fn2-native-recv accepted sap 1)))
             (assert (= byte 42))))
         (fn2-native-close listener)
         (setf listener -1)
         (multiple-value-bind (status fd) (check-connect port mux)
           (unwind-protect (assert (eq status :failed))
             (when (>= fd 0) (fn2-native-close fd)))))
    (dolist (fd (list accepted client listener)) (when (>= fd 0) (fn2-native-close fd)))
    (fn2-native-mux-destroy mux)))
(format t "PASS native Connect loopback byte transfer and refused target~%")

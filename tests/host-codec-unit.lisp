; Actual core loan authorization at the codec record call, not native mirrors.
(in-package "ACL2")
(include-book "../books/host-codec")
(include-book "tls-transport-unit")

(defun fn2-host-codec-test-loan (kind queued posted nonce fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-ops (fn2-core-ops fn2-core))
             (fn2-pool (fn2-core-pool fn2-core)))
  (code op gen fn2-ops fn2-pool)
  (b* ((fn2-ops (fn2-ops-init *fn2-profile-tiny* fn2-ops))
       (fn2-pool (fn2-pool-init '((2 . 64)) 5 20 fn2-pool))
       ((mv code slot rgen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
       ((unless (eq code :ok)) (mv code 0 0 fn2-ops fn2-pool))
       ((mv code op gen fn2-ops) (fn2-op-reserve kind 1 0 1 0 0 fn2-ops))
       ((unless (eq code :ok)) (mv code 0 0 fn2-ops fn2-pool))
       (sendp (equal kind *fn2-action-send*))
       (len (if sendp 1 8))
       ((mv code fn2-pool)
        (if sendp (fn2-pool-write slot rgen 0 71 1 0 1 fn2-pool) (mv :ok fn2-pool)))
       ((unless (eq code :ok)) (mv code op gen fn2-ops fn2-pool))
       ((mv code off fn2-pool)
        (if sendp
            (mv-let (code fn2-pool) (fn2-pool-lease-out slot rgen 0 len 1 0 1 fn2-pool)
             (mv code 0 fn2-pool))
          (fn2-pool-lease-in slot rgen len op gen 1 0 1 fn2-pool)))
       ((unless (eq code :ok)) (mv code op gen fn2-ops fn2-pool))
       ((mv code fn2-ops) (fn2-op-set-range op gen slot rgen off len fn2-ops))
       ((unless (eq code :ok)) (mv code op gen fn2-ops fn2-pool))
       ((mv code fn2-ops) (fn2-op-set-capability op gen 7 nonce fn2-ops))
       ((unless (eq code :ok)) (mv code op gen fn2-ops fn2-pool))
       ((mv code fn2-ops) (fn2-op-enqueue op gen fn2-ops))
       ((unless (eq code :ok)) (mv code op gen fn2-ops fn2-pool))
       ((mv code fn2-ops) (if queued (mv :ok fn2-ops) (fn2-outbox-ack 1 fn2-ops)))
       ; Deliberate already-posted control: no further physical selection.
       (fn2-ops (if posted (fn2-ops-put op (c0-posted 1)) fn2-ops)))
   (mv code op gen fn2-ops fn2-pool))
  (mv code op gen fn2-core)))

(defun fn2-host-codec-test-run (kind queued posted stopped nonce stale fn2-core fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-core fn2-tls-transport fn2-tls-record) :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      ((mv setup op gen fn2-core) (fn2-host-codec-test-loan kind queued posted nonce fn2-core))
      (fn2-core (if stopped (fn2-core-kind-stop 1 1 fn2-core) fn2-core))
      ((mv opened fn2-tls-transport) (fn2-tls-transport-unit-open 0 8 4 20 fn2-tls-transport))
      ((mv status action offset count serial fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((unless (and (eq setup :ok) (eq opened :ok) (eq status :act)
                    (equal (list action offset count) '(7 0 0))))
       (mv :setup fn2-core fn2-tls-transport fn2-tls-record))
      ((mv observed kick fn2-tls-transport) (fn2-tls-transport-observe 7 17 3 9 serial 0 0 0 fn2-tls-transport))
      ((mv done & & & & fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv handed & & & & & & fn2-tls-transport) (fn2-tls-transport-handoff 7 17 3 9 fn2-tls-transport))
      ((unless (and (eq observed :ok) kick (eq done :done) (eq handed :ok)
                    (fn2-core-wfp fn2-core) (fn2-tls-transport-wfp fn2-tls-transport)
                    (equal (fn2-core-stopped-p fn2-core) stopped)))
       (mv :antecedent fn2-core fn2-tls-transport fn2-tls-record))
      (before (fn2-tls-transport-serial 0 fn2-tls-transport))
      ((mv code selected address offset selected-count selected-serial fn2-tls-transport fn2-tls-record)
       (fn2-host-tls-record-next op (if stale (+ gen 1) gen) 8 0 fn2-tls-transport fn2-tls-record fn2-core)))
  (mv (if (eq code :act)
          (list code selected address selected-count (and (= offset 0) (= selected-serial (+ before 1))))
        (list code (= before (fn2-tls-transport-serial 0 fn2-tls-transport))
                   (= (fn2-tls-transport-pending 0 fn2-tls-transport) 0)))
      fn2-core fn2-tls-transport fn2-tls-record)))
(defun fn2-host-codec-test (kind queued posted stopped nonce stale)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (result fn2-core)
   (with-local-stobj fn2-tls-transport
    (mv-let (result fn2-core fn2-tls-transport)
     (with-local-stobj fn2-tls-record
      (mv-let (result fn2-core fn2-tls-transport fn2-tls-record)
       (fn2-host-codec-test-run kind queued posted stopped nonce stale fn2-core fn2-tls-transport fn2-tls-record)
       (mv result fn2-core fn2-tls-transport)))
     (mv result fn2-core)))
   result)))
(assert-event (equal (fn2-host-codec-test *fn2-action-receive* nil nil nil 17 nil) '(:act 12 0 4 t)))
(assert-event (equal (fn2-host-codec-test *fn2-action-send* nil nil nil 17 nil) '(:act 13 0 1 t)))
(assert-event (equal (fn2-host-codec-test *fn2-action-receive* nil nil t 17 nil) '(:act 12 0 4 t)))
(assert-event (equal (fn2-host-codec-test *fn2-action-receive* t nil nil 17 nil) '(:state t t)))
(assert-event (equal (fn2-host-codec-test *fn2-action-receive* nil t nil 17 nil) '(:state t t)))
(assert-event (equal (fn2-host-codec-test *fn2-action-receive* nil nil nil 18 nil) '(:stale t t)))
(assert-event (equal (fn2-host-codec-test *fn2-action-receive* nil nil nil 17 t) '(:stale t t)))
(assert-event (equal (fn2-host-codec-test *fn2-action-read* nil nil nil 17 nil) '(:kind t t)))

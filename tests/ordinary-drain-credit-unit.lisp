; Actual C STAGED/emit -> ordinary B admission with protected working credits.
; No IO is performed. The draining phase in return controls is an explicit
; no-IO logical premise; these are not durability or completion witnesses.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/assembly-callbacks-r2")
(include-book "../books/checkpoint-working-credit")
(include-book "../sim/commit-test-profile")
(include-book "retirement-state-projections")
(make-event
 (cons 'progn (fn2-riud-projection-events
 '(fn2-pool fn2-ops fn2-commit-root fn2-succ-txns fn2-commit-io) (w state))))
(defconst *fn2-odc-profile*
 (fn2-b-test-profile
  (put-assoc-equal :identity-arena-bytes 4096
   (put-assoc-equal :pool-classes
    (list (cons 16 64) (cons 8 256) (cons 48 *fn2-format-sector-bytes*)
          (cons *fn2-checkpoint-window-count* *fn2-run-page-size*)) *fn2-profile-tiny*)) 0))
(defun fn2-odc-pool (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))
             (fn2-commit-io (fn2-core-commit-io fn2-core))) (copy)
  (list (fn2-pool-copy fn2-pool) (fn2-commit-io-copy fn2-commit-io)) copy))
(defun fn2-odc-noio (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-ops (fn2-core-ops fn2-core))
             (fn2-commit-root (fn2-core-commit-root fn2-core))
             (fn2-succ-txns (fn2-core-succ-txns fn2-core))) (copy)
  (list (fn2-ops-copy fn2-ops) (fn2-commit-root-copy fn2-commit-root)
        (fn2-succ-txns-copy fn2-succ-txns)) copy))
(defun fn2-odc-args (left fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-successor-arg 0 0 (- left 1) :value 1 fn2-core)
   (if (eq code :ok) (fn2-odc-args (- left 1) fn2-core) (mv code fn2-core)))))
(defun fn2-odc-resolve (left fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-successor-resolve 0 4096 fn2-core)
   (if (eq code :more) (fn2-odc-resolve (- left 1) fn2-core) (mv code fn2-core)))))
(defun fn2-odc-exhaust-pool (left class fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :fuel fn2-core)
  (mv-let (code slot gen fn2-core) (fn2-core-reserve class 200 1 1 fn2-core)
   (declare (ignore slot gen))
   (if (eq code :ok) (fn2-odc-exhaust-pool (- left 1) class fn2-core) (mv code fn2-core)))))
(defun fn2-odc-exhaust-extents (left fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :fuel nil fn2-core)
  (b* (((mv code e epoch allocation fn2-core)
        (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code e epoch allocation fn2-extents)
         (mv-let (code pressure e epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents)
          (declare (ignore pressure)) (mv code e epoch allocation fn2-extents))
         (mv code e epoch allocation fn2-core)))
       ((unless (eq code :ok)) (mv code nil fn2-core))
       ((mv done rest fn2-core) (fn2-odc-exhaust-extents (- left 1) fn2-core)))
   (mv done (cons (list e epoch allocation) rest) fn2-core))))
(defun fn2-odc-configure (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-commit (fn2-commit-table fn2-core))
             (fn2-commit-io (fn2-core-commit-io fn2-core))
             (fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
  (fn2-checkpoint-working-credit-configure (fn2-commit-rows fn2-commit)
     (fn2-commit-io-rows fn2-commit-io) fn2-pool) (mv code fn2-core)))
(defun fn2-odc-group-fullp (group fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (full)
  (fn2-pool-credit-fullp group 0 fn2-pool) full))
(defun fn2-odc-body (refuse fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-odc-profile* fn2-core))
      ((mv epoch fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv configured fn2-core) (fn2-odc-configure fn2-core))
      (owner (fn2-machine-kind-base *fn2-scribe-kind* fn2-core))
      (ogen (fn2-machine-generation owner fn2-core))
      (class (fn2-scribe-window-class fn2-core))
      ((mv pool ws wg fn2-core) (fn2-core-reserve class *fn2-scribe-kind* owner ogen fn2-core))
      ((mv put fn2-core) (fn2-successor-put 0 0 *fn2-succ-addr-sid* :insert fn2-core))
      ((mv args fn2-core) (fn2-odc-args 5 fn2-core))
      ((mv resolved fn2-core) (fn2-odc-resolve 40 fn2-core))
      ((mv staged & fn2-core) (fn2-successor-stage 0 fn2-core))
      ((mv emitted len fn2-core) (fn2-successor-emit 0 ws wg 0 4096 *fn2-scribe-kind* owner ogen fn2-core))
      (actual-staged (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (yes)
                      (= (fn2-succ-txns-phase 0 fn2-succ-txns) *fn2-succ-phase-staged*) yes))
      (poolrows (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (n) (fn2-pool-rows fn2-pool) n))
      ((mv exhausted fn2-core) (fn2-odc-exhaust-pool (+ 1 poolrows) class fn2-core))
      (extrows (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (n) (fn2-extents-rows fn2-extents) n))
      ((mv extcode reservations fn2-core)
       (if refuse (fn2-odc-exhaust-extents (+ 1 extrows) fn2-core) (mv :unused nil fn2-core)))
      ((unless (and (eq epoch :ok) (eq pool :ok) (eq put :ok) (eq args :ok) (eq resolved :ok)
                     (eq staged :ok) (eq emitted :ok) actual-staged (eq configured :ok) (eq exhausted :exhausted)
                     (fn2-odc-group-fullp 0 fn2-core) (fn2-odc-group-fullp 1 fn2-core)
                     (or (not refuse) (and (eq extcode :no-space) (consp reservations)))))
       (mv nil fn2-core))
      ((mv nonce & & &) (fn2-commit-frontier fn2-core))
      (before (fn2-odc-noio fn2-core))
      ((mv admitted batch event fn2-core) (fn2-commit-admit-txn ws wg len *fn2-scribe-kind* owner ogen fn2-core))
      (after (fn2-odc-noio fn2-core))
      (aborted (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (yes)
                 (= (fn2-pool-credit-phasei 1 fn2-pool) *fn2-pool-credit-aborted-empty*) yes))
      ((unless (or (not refuse) (and (eq admitted :admission) (= batch 0) (= event 0)
                         (equal before after) aborted (fn2-odc-group-fullp 1 fn2-core)
                         (not (fn2-core-stopped-p fn2-core))))) (mv nil fn2-core))
      ((mv cancelled fn2-core)
       (if refuse
           (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
            (fn2-alloc-cancel-reservation (caar reservations) (cadar reservations) (caddar reservations) fn2-extents)
            (mv code fn2-core)) (mv :unused fn2-core)))
      ((mv admitted batch event fn2-core)
       (if refuse (fn2-commit-admit-txn ws wg len *fn2-scribe-kind* owner ogen fn2-core)
         (mv admitted batch event fn2-core)))
      (held (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (yes)
              (and (= (fn2-pool-credit-phasei 1 fn2-pool) *fn2-pool-credit-held*)
                   (fn2-pool-credit-emptyp 1 0 fn2-pool)) yes))
      ((mv bound fn2-core) (fn2-successor-bind 0 batch event fn2-core)))
  (mv (and (eq admitted :ok) (= batch nonce) (posp event) (eq bound :ok) held
           (or (not refuse) (eq cancelled :ok)) (fn2-odc-group-fullp 0 fn2-core)
           (fn2-odc-group-fullp 2 fn2-core) (fn2-core-wfp fn2-core)
           (not (fn2-core-stopped-p fn2-core))) fn2-core)))
(defun fn2-odc-run (refuse)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-odc-body refuse fn2-core) ok)))
(assert-event (fn2-odc-run nil))
(assert-event (fn2-odc-run t))
; Actual START acquires these handles. Only the no-IO draining phase is
; installed as a fixture premise; no sealed/persisted outcome is asserted.
(defun fn2-odc-return-body (retire fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (if retire (put-assoc-equal :generation-limit 1 *fn2-odc-profile*) *fn2-odc-profile*))
      (fn2-core (fn2-core-init profile fn2-core))
      ((mv epoch fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv configured fn2-core) (fn2-odc-configure fn2-core))
      (id (fn2-machine-kind-base *fn2-commit-kind* fn2-core))
      (partner (+ 1 id)) (generation (fn2-machine-generation id fn2-core))
      ((mv started fn2-core) (fn2-commit-start id 1 1 0 partner fn2-core))
      ((unless (and (eq epoch :ok) (eq configured :ok) (eq started :ok)
                     (= (fn2-machine-cb-issued id fn2-core) 0)
                     (= (fn2-machine-cb-wrote id fn2-core) 0))) (mv nil fn2-core))
      ((mv & & & slot gen) (fn2-commit-resource id 0 fn2-core))
      (fn2-core (fn2-commit-put-core id (phase *fn2-commit-state-draining*)))
      (before (fn2-odc-pool fn2-core))
      ((mv stale fn2-core) (fn2-commit-release-pool id 0 (+ 1 generation) fn2-core))
      ((unless (and (eq stale :owner) (equal before (fn2-odc-pool fn2-core)))) (mv nil fn2-core))
      ((mv handed fn2-core)
       (if retire (mv :unused fn2-core)
         (fn2-core-hand slot gen *fn2-commit-kind* id generation 200 2 1 fn2-core)))
      ((mv accepted fn2-core)
       (if retire (mv :unused fn2-core) (fn2-core-accept-hand slot gen 200 2 1 fn2-core)))
      (before (fn2-odc-pool fn2-core))
      ((mv loan fn2-core)
       (if retire (mv :unused fn2-core) (fn2-commit-release-pool id 0 generation fn2-core)))
      ((unless (or retire (and (eq handed :ok) (eq accepted :ok) (eq loan :owner)
                               (equal before (fn2-odc-pool fn2-core))))) (mv nil fn2-core))
      ((mv handback fn2-core)
       (if retire (mv :unused fn2-core)
         (fn2-core-hand slot gen 200 2 1 *fn2-commit-kind* id generation fn2-core)))
      ((mv received fn2-core)
       (if retire (mv :unused fn2-core)
         (fn2-core-accept-hand slot gen *fn2-commit-kind* id generation fn2-core)))
      ((mv returned fn2-core) (fn2-commit-release-pool id 0 generation fn2-core))
      (before (fn2-odc-pool fn2-core))
      ((mv repeated fn2-core) (fn2-commit-return-ordinary-pool id generation slot gen fn2-core))
      (after (fn2-odc-pool fn2-core))
      (depleted (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (yes)
                  (and (= (fn2-pool-credit-phasei 1 fn2-pool) *fn2-pool-credit-depleted*)
                       (fn2-pool-credit-emptyp 1 0 fn2-pool)) yes)))
  (mv (and (equal before after) (not (eq repeated :ok))
           (if retire (and (eq returned :retired) depleted)
             (and (eq handback :ok) (eq received :ok) (eq returned :ok)))
           (fn2-odc-group-fullp 0 fn2-core) (fn2-odc-group-fullp 2 fn2-core)
           (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))) fn2-core)))
(defun fn2-odc-return-run (retire)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-odc-return-body retire fn2-core) ok)))
(assert-event (fn2-odc-return-run nil))
(assert-event (fn2-odc-return-run t))

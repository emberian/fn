; Actual public C stage, with real resolve and resource constructors.
; These no-IO controls do not promise NEW-upload or sealer completion.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/assembly-callbacks-r2")
(include-book "retirement-state-projections")
(make-event
 (cons 'progn (fn2-riud-projection-events
  '(fn2-id-engine fn2-overlays fn2-overlay-index fn2-pool) (w state))))
(make-event
 (value `(defconst *fn2-csp-cursor-sid*
           ,(fn2-decl-get :id (fn2-decl-row '(:schema fn2-consumer-cursor) (w state))))))
(defun fn2-csp-resources (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-id-engine (fn2-core-id-engine fn2-core))
             (fn2-overlays (fn2-core-overlays fn2-core))
             (fn2-overlay-index (fn2-core-overlay-index fn2-core))
             (fn2-pool (fn2-core-pool fn2-core))) (copy)
  (list (fn2-id-engine-copy fn2-id-engine) (fn2-overlays-copy fn2-overlays)
        (fn2-overlay-index-copy fn2-overlay-index) (fn2-pool-copy fn2-pool)) copy))
(defun fn2-csp-args (left slot fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-successor-arg 0 slot (- left 1) :value 1 fn2-core)
   (if (eq code :ok) (fn2-csp-args (- left 1) slot fn2-core) (mv code fn2-core)))))
(defun fn2-csp-resolve (left fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-successor-resolve 0 4096 fn2-core)
   (if (eq code :more) (fn2-csp-resolve (- left 1) fn2-core) (mv code fn2-core)))))
(defun fn2-csp-prepare-resource (mode profile fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (cond
  ((eq mode :existing-spare)
   (stobj-let ((fn2-id-engine (fn2-core-id-engine fn2-core))
               (fn2-overlays (fn2-core-overlays fn2-core))
               (fn2-overlay-index (fn2-core-overlay-index fn2-core))
               (fn2-pool (fn2-core-pool fn2-core))) (code fn2-overlays fn2-pool)
    (fn2-idc-add-spare fn2-id-engine fn2-overlays fn2-overlay-index fn2-pool) (mv code fn2-core)))
  ((eq mode :existing-scratch)
   (stobj-let ((fn2-id-engine (fn2-core-id-engine fn2-core))
               (fn2-pool (fn2-core-pool fn2-core))) (code fn2-id-engine fn2-pool)
    (fn2-idc-scratch fn2-id-engine fn2-pool) (mv code fn2-core)))
  ((eq mode :protected-short)
   (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
    (fn2-pool-credit-configure '((1 1 0)) fn2-pool) (mv code fn2-core)))
  ((member-eq mode '(:arena-short :query-held))
   (b* (((mv code slot gen fn2-core) (fn2-core-reserve 1 200 0 1 fn2-core))
        ((unless (eq code :ok)) (mv code fn2-core)))
    (if (not (eq mode :query-held)) (mv :ok fn2-core)
     (mv-let (written fn2-core) (fn2-core-write slot gen 0 7 200 0 1 fn2-core)
      (if (not (eq written :ok)) (mv written fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
        (fn2-pool-query-acquire slot gen 0 1 200 0 1 fn2-pool) (mv code fn2-core)))))))
  ((eq mode :free-row-short)
   ; A real nonempty frozen NAME overlay leaves only one row for two
   ; requested write schemas. Pool capacity itself remains sufficient.
   (fn2-groups-genesis profile fn2-core))
  (t (mv :ok fn2-core))))
(defun fn2-csp-body (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((arena (if (member-eq mode '(:arena-short :query-held)) 65536 4096))
      (count (cond ((eq mode :joint-short) 1) ((eq mode :free-row-short) 5) (t 2)))
      (profile (put-assoc-equal :identity-arena-bytes arena
                 (put-assoc-equal :identity-overlays (if (eq mode :free-row-short) 2 4)
                  (put-assoc-equal :pool-classes (list (cons count 4096) (cons 1 65536)) *fn2-profile-tiny*))))
      (profile (if (eq mode :free-row-short)
                   (put-assoc-equal :groups '(("old.group" . 1)) profile) profile))
      (fn2-core (fn2-core-init profile fn2-core))
      ((mv prepared fn2-core) (fn2-csp-prepare-resource mode profile fn2-core))
      ((mv put fn2-core) (fn2-successor-put 0 0 *fn2-succ-addr-sid* :insert fn2-core))
      ((mv args fn2-core) (fn2-csp-args 5 0 fn2-core))
      ((mv put2 fn2-core)
       (if (eq mode :free-row-short)
           (fn2-successor-put 0 1 *fn2-csp-cursor-sid* :rebase fn2-core) (mv :ok fn2-core)))
      ((mv args2 fn2-core)
       (if (eq mode :free-row-short) (fn2-csp-args 4 1 fn2-core) (mv :ok fn2-core)))
      ((mv resolved fn2-core) (fn2-csp-resolve 40 fn2-core))
      ((unless (and (eq prepared :ok) (eq put :ok) (eq args :ok) (eq put2 :ok) (eq args2 :ok) (eq resolved :ok)
                     (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))
                     (= (mv-nth 0 (fn2-csnapshot-state fn2-core)) *fn2-csnapshot-phase-idle*))) (mv nil fn2-core))
      (before (fn2-csp-resources fn2-core))
      ((mv code i fn2-core) (fn2-successor-stage 0 fn2-core))
      (after (fn2-csp-resources fn2-core))
      ((mv room requested preflight)
       (stobj-let ((fn2-succ-slots (fn2-core-succ-slots fn2-core))
                   (fn2-overlays (fn2-core-overlays fn2-core))
                   (fn2-id-engine (fn2-core-id-engine fn2-core))
                   (fn2-overlay-index (fn2-core-overlay-index fn2-core))
                   (fn2-pool (fn2-core-pool fn2-core))) (room requested preflight)
        (mv-let (room requested)
         (fn2-succ-room *fn2-succ-slots* 0 0 (fn2-id-engine-arena 0 fn2-id-engine)
          (floor (fn2-overlay-index-rows fn2-overlay-index) (fn2-overlays-rows fn2-overlays))
          0 fn2-succ-slots fn2-overlays)
         (mv room requested (fn2-idc-stage-pool-preflight requested fn2-id-engine fn2-overlays fn2-pool)))
        (mv room requested preflight)))
      (success (member-eq mode '(:enough :existing-spare :existing-scratch)))
      (staged (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (yes)
                 (= (fn2-succ-txns-phase 0 fn2-succ-txns) *fn2-succ-phase-staged*) yes))
      (held (stobj-let ((fn2-id-engine (fn2-core-id-engine fn2-core))
                        (fn2-overlays (fn2-core-overlays fn2-core))) (yes)
               (and (= (fn2-id-engine-scratch 0 fn2-id-engine) 1)
                    (= (fn2-idc-count-overlays (fn2-overlays-rows fn2-overlays) 0 *fn2-overlay-phase-spare* fn2-overlays) 1)) yes)))
  (mv (and (= i 0) (eq room :ok) (= requested (if (eq mode :free-row-short) 2 1))
           (eq preflight (if success :ok :full))
           (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))
           (if success (and (eq code :ok) staged held)
             (and (eq code :full) (not staged) (equal before after)))) fn2-core)))
(defun fn2-csp-run (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-csp-body mode fn2-core) ok)))
(assert-event (fn2-csp-run :joint-short))
(assert-event (fn2-csp-run :enough))
(assert-event (fn2-csp-run :existing-spare))
(assert-event (fn2-csp-run :existing-scratch))
(assert-event (fn2-csp-run :arena-short))
(assert-event (fn2-csp-run :query-held))
(assert-event (fn2-csp-run :protected-short))
(assert-event (fn2-csp-run :free-row-short))

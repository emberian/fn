; Concrete private-window authorization, including pending parent retirement.
(in-package "ACL2")
(include-book "../books/tls-stack")
(include-book "std/util/bstar" :dir :system)
(defun fn2-tls-stack-run (writep fn2-compress-transport fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-compress-transport fn2-tls-transport fn2-tls-record) :verify-guards nil))
 (b* ((fn2-compress-transport (fn2-compress-transport-init 1 fn2-compress-transport))
      (fn2-compress-transport
       (fn2-compress-transport-put 0 (cap 7) (nonce 17) (slot 3) (generation 9)
        (alive 1) (terminal 3) (serial 11) (pending (if writep 5 6))
        (input-quantum 8) (output-quantum 8) (output-length 7) (output-offset 2)
        (request-in-channel (if writep 3 0)) (request-in-offset (if writep 2 0))
        (request-in-count (if writep 5 0)) (request-in-extent (if writep 7 0))
        (request-out-channel (if writep 0 2)) (request-out-count (if writep 0 8))
        (request-out-extent (if writep 0 8))))
      ((mv parent channel base extent epoch) (fn2-compress-tls-parent 7 17 3 9 fn2-compress-transport))
      (fn2-tls-transport (fn2-tls-transport-init 1 fn2-tls-transport))
      (fn2-tls-transport (fn2-tls-transport-put 0 (cap 7) (nonce 17) (alive 1) (terminal 3) (quantum 4)))
      ((mv bound fn2-tls-record) (fn2-tls-record-start 7 17 3 9 extent epoch writep fn2-tls-record))
      ((mv selected action offset count serial fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-next 8 0 fn2-tls-transport fn2-tls-record))
      ((mv span private-channel private-offset private-count)
       (fn2-compress-tls-span 7 17 3 9 serial action offset count
        fn2-compress-transport fn2-tls-transport fn2-tls-record))
      ((mv stale-nonce & & &)
       (fn2-compress-tls-span 7 18 3 9 serial action offset count
        fn2-compress-transport fn2-tls-transport fn2-tls-record))
      ((mv wrong-offset & & &)
       (fn2-compress-tls-span 7 17 3 9 serial action (+ 1 offset) count
        fn2-compress-transport fn2-tls-transport fn2-tls-record))
      (fn2-compress-transport (fn2-compress-transport-put 0 (serial 12)))
      ((mv replaced & & &)
       (fn2-compress-tls-span 7 17 3 9 serial action offset count
        fn2-compress-transport fn2-tls-transport fn2-tls-record))
      (fn2-compress-transport (fn2-compress-transport-put 0 (serial 11) (pending 0)))
      ((mv retired & & &)
       (fn2-compress-tls-span 7 17 3 9 serial action offset count
        fn2-compress-transport fn2-tls-transport fn2-tls-record)))
  (mv (and (eq parent :ok) (= channel (if writep 3 2)) (= base (if writep 2 0))
           (eq bound :ok) (eq selected :act) (= action (if writep 13 12))
           (eq span :ok) (= private-channel channel) (= private-offset base) (= private-count 4)
           (equal (list stale-nonce wrong-offset replaced retired) '(:stale :stale :stale :stale))
           (= (fn2-tls-record-source-progress 0 fn2-tls-record) 0)
           (= (fn2-tls-record-sink-progress 0 fn2-tls-record) 0))
      fn2-compress-transport fn2-tls-transport fn2-tls-record)))
(defun fn2-tls-stack-check (writep)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-compress-transport
  (mv-let (ok fn2-compress-transport)
   (with-local-stobj fn2-tls-transport
    (mv-let (ok fn2-compress-transport fn2-tls-transport)
     (with-local-stobj fn2-tls-record
      (mv-let (ok fn2-compress-transport fn2-tls-transport fn2-tls-record)
       (fn2-tls-stack-run writep fn2-compress-transport fn2-tls-transport fn2-tls-record)
       (mv ok fn2-compress-transport fn2-tls-transport)))
     (mv ok fn2-compress-transport)))
   ok)))
(assert-event (fn2-tls-stack-check t))
(assert-event (fn2-tls-stack-check nil))

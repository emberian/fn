; Test projection is exactly the literal proof antecedent for this fixture.
(defthm atst-two-slot-count-check-is-correspondence
 (implies (equal (fn-ats-phases-length slots) 2)
          (equal (atst-count-check slots pool) (fn-ats-correspondencep slots pool)))
 :hints (("Goal" :in-theory (disable fn-ats-live-phasep)
           :expand ((nth 1 (nth 4 slots)) (nth 0 (cdr (nth 4 slots)))
                    (fn-ats-owned-count (nth 4 slots))
                    (fn-ats-owned-count (cdr (nth 4 slots)))
                    (fn-ats-owned-count (cddr (nth 4 slots)))))))


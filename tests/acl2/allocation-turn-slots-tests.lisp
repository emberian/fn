     (mv-let (constructed fn-allocation-turn-slots fn-page-read-pool)
      (atst-init *ats-ledger* 20 fn-allocation-turn-slots fn-page-read-pool)
      (declare (ignore constructed))
      (mv-let (entry nonce fn-allocation-turn-slots fn-page-read-pool)
       (fn-ats-enter-internal 0 :connection-start fn-allocation-turn-slots fn-page-read-pool)
       (declare (ignore entry))
       (let* ((fn-page-read-pool (update-fn-prp-alloc-active-turns 2 fn-page-read-pool))
              (omitted (not (atst-count-check fn-allocation-turn-slots fn-page-read-pool))))
        (mv-let (word fn-allocation-turn-slots fn-page-read-pool)
         (cond ((eq operation :finish)
                (fn-ats-finish-owned 0 nonce fn-allocation-turn-slots fn-page-read-pool))
               ((eq operation :body)
                (fn-ats-prepay-body-internal 0 nonce 40 fn-allocation-turn-slots fn-page-read-pool))
               (t
                (mv-let (word issued fn-allocation-turn-slots fn-page-read-pool)
                 (fn-ats-enter-internal 1 :read-completion fn-allocation-turn-slots fn-page-read-pool)
                 (declare (ignore issued))
                 (mv word fn-allocation-turn-slots fn-page-read-pool))))
         (declare (ignore word))
         (mv (and omitted (not (atst-count-check fn-allocation-turn-slots fn-page-read-pool)))
             fn-allocation-turn-slots fn-page-read-pool)))))
     (mv ok fn-page-read-pool)))
   ok)))
(assert-event (atst-correspondence-removal :finish))
(assert-event (atst-correspondence-removal :body))
(assert-event (atst-correspondence-removal :entry))

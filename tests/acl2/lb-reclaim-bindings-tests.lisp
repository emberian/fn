; Real-source reclaim control: fresh tombstone plus retained payload.
(in-package "ACL2")
(include-book "../../books/lb-log-reclaim-properties")
(with-prover-time-limit 60
(defun fn-lb-reclaim-seal-control ()
 (declare (xargs :guard t))
 (with-local-stobj fn-arena
  (mv-let (checked fn-arena)
   (let* ((p0 '(72 58 32 120 13 10 13 10 46 13 10))
          (p1 '(75 58 32 121 13 10 13 10 107 101 101 112 13 10))
          (w0 (fn-record-make 0 1 0 "<lb0@fn.test>" p0 '("fn.test") "o" "s" "e" 1 5))
          (w1 (fn-record-make 1 2 0 "<lb1@fn.test>" p1 '("fn.test") "o" "s" "e" 1 3))
          (ws (list w0 w1)))
    (if (not (and (fn-lb-open-records-guardp ws nil 0 0) (fn-rcl-payload-profilep p0)))
     (mv nil fn-arena)
     (let ((old-log (fn-lb-log-model-open-events ws nil 0 0 7 nil)))
      (mv-let (old-rows fn-arena) (fn-intern-events ws nil 0 fn-arena)
       (if (not (consp (cdr old-rows))) (mv nil fn-arena)
        (let* ((tomb (fn-rcl-tombstone-of p0 (fn-record-string-octets "<lb0@fn.test>")))
               (wt (fn-record-make 0 1 0 "<lb0@fn.test>" tomb '("fn.test") "o" "s" "e" 1 5))
               (mixed (list wt (cadr old-rows)))
               (base (fn-arena-count fn-arena)))
         (if (not (and (fn-lb-reclaim-records-guardp mixed nil base)
                       (fn-lb-log-append-guardp old-log) (fn-lb-log-entries-guardp old-log)))
          (mv nil fn-arena)
          (let* ((predicted (fn-orcs-predict mixed nil base))
                 (new-rows (car predicted))
                 (new-log (fn-lb-log-model-reclaim-events mixed nil base 9 old-log))
                 (fn-arena (fn-orcs-seal (cadr predicted) fn-arena)))
           (if (not (fn-lb-log-entries-guardp new-log)) (mv nil fn-arena)
           (mv (and (equal base 2) (equal (fn-arena-count fn-arena) 3)
                    (equal (len new-rows) 2)
                    (equal (fn-record-payload (car new-rows)) 2)
                    (equal (fn-record-payload (cadr new-rows)) 1)
                    (fn-rcl-tombstonep tomb)
                    (equal (fn-nntp-payload-bytes 2 fn-arena) tomb)
                    (equal (fn-nntp-payload-bytes 1 fn-arena) p1)
                    (equal (fn-lb-log-payload (car new-rows) new-log) tomb)
                    (fn-lb-arena-is-log fn-arena new-rows new-log)
                    (not (fn-lb-arena-is-log fn-arena new-rows old-log))
                    (fn-lb-log-handles-below new-log 3))
               fn-arena))))))))))
   checked))))
(assert-event (fn-lb-reclaim-seal-control)
 :msg "actual predictor + deferred seal: fresh tombstone handle, kept payload, independent log and missing-MOVE fault")

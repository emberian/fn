       (not (and (fn-psc-source-contextp q *pic-test-stamped* *pic-spt-held*)
        (equal (fn-psc-model-retained-agent q *pic-test-stamped*)
         (fn-pb-path-agent *pic-test-stamped* (fn-record-string-octets (fn-pic-get msgid d)))))))) :rule-classes nil)
(defthm pic-sxt-pooled-entry-phase-removal-pending
 (let* ((c *pic-ajt-start*) (d (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*)))
        (p (fn-pic-parser d)))
  (and (fn-pic-agent-tracep c 0 *pic-test-stamped*)

       (not (and (fn-psc-source-contextp p *pic-test-stamped* *pic-spt-held*)
        (equal (fn-psc-model-retained-agent p *pic-test-stamped*)
               (fn-pb-path-agent *pic-test-stamped* (fn-record-string-octets (fn-pic-get msgid c)))))))) :rule-classes nil)
(defthm pic-sxt-actual-readonly-parser-entry-positive
 (let* ((d (mv-nth 1 (fn-pic-next *pic-ajt-before* 1 *pic-test-stamped*))) (p (fn-pic-parser d)))
  (and (fn-pic-agent-tracep *pic-ajt-before* *pic-ajt-ticks* *pic-test-stamped*)
       (equal (fn-pic-get phase d) :source-incoming)
       (fn-psc-source-contextp p *pic-test-stamped* *pic-spt-held*)
       (equal (fn-psc-model-retained-agent p *pic-test-stamped*)
        (fn-pb-path-agent *pic-test-stamped* (fn-record-string-octets (fn-pic-get msgid d)))))) :rule-classes nil)
(defthm pic-sxt-actual-entry-trace-removal-corrupted-span
 (let* ((p (fn-pic-parser *pic-ajt-before*))
        (c (fn-pic-set parser (fn-psc-set agent-start (+ 1 (fn-psc-get agent-start p)) p) *pic-ajt-before*))
        (d (mv-nth 1 (fn-pic-next c 1 *pic-test-stamped*))) (q (fn-pic-parser d)))
  (and (not (fn-pic-agent-tracep c *pic-ajt-ticks* *pic-test-stamped*))
       (equal (fn-pic-get phase d) :source-incoming)
       (not (and (fn-psc-source-contextp q *pic-test-stamped* *pic-spt-held*)
        (equal (fn-psc-model-retained-agent q *pic-test-stamped*)
         (fn-pb-path-agent *pic-test-stamped* (fn-record-string-octets (fn-pic-get msgid d)))))))) :rule-classes nil)
(defthm pic-sxt-actual-entry-phase-removal-pending
 (let* ((d (mv-nth 1 (fn-pic-next *pic-ajt-start* 1 *pic-test-stamped*))) (p (fn-pic-parser d)))
  (and (fn-pic-agent-tracep *pic-ajt-start* 0 *pic-test-stamped*)
       (not (equal (fn-pic-get phase d) :source-incoming))
       (not (and (fn-psc-source-contextp p *pic-test-stamped* *pic-spt-held*)
        (equal (fn-psc-model-retained-agent p *pic-test-stamped*)
         (fn-pb-path-agent *pic-test-stamped* (fn-record-string-octets (fn-pic-get msgid d)))))))) :rule-classes nil)
(defun pic-sxt-digest-shape-positive ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj pgs-digest-state
  (mv-let (ok pgs-digest-state)
   (let ((c (fn-pic-hash-start nil *pic-ajt-entry*)))
    (mv-let (status d left pgs-digest-state) (fn-pic-digest-next c 2 pgs-digest-state)
     (declare (ignore status left))
     (mv (and (fn-pic-agent-shapep c) (equal (fn-pic-get phase d) :digest-next)
              (fn-pic-agent-shapep d)) pgs-digest-state)))
   ok)))
(assert-event (pic-sxt-digest-shape-positive))
(defthm pic-sxt-digest-shape-removal-corrupted-improper-agent
 (let ((c (fn-pic-hash-start nil *pic-sxt-corrupt*)))
  (and (not (fn-pic-agent-shapep c))
       (not (fn-pic-agent-shapep (mv-nth 1 (fn-pic-digest-next c 1 pgs-digest-state)))))) :rule-classes nil)
(defconst *pic-sxt-pool*
 (list nil :uninitialized
  (fn-ibc-carrier (list :input-backing 4 (len *pic-test-stamped*))
                  (list *pic-test-incoming* :readonly '(0 0 0 0 1)))))
(defthm pic-sxt-pooled-source-entry-positive
 (let* ((c *pic-ajt-before*) (d (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*)))
        (p (fn-pic-parser d)))
  (and (fn-pic-agent-tracep c *pic-ajt-ticks* *pic-test-stamped*)
       (equal (fn-pic-get phase d) :source-incoming)
       (equal (fn-ioh-access (fn-ibc-carrier-row (fn-prp-incoming-slot *pic-sxt-pool*))
                             (fn-pic-get incoming-token c) :read) :holder-readonly)
       (fn-psc-source-contextp p *pic-test-stamped* *pic-spt-held*)
       (equal (fn-psc-model-retained-agent p *pic-test-stamped*)
              (fn-pb-path-agent *pic-test-stamped* (fn-record-string-octets (fn-pic-get msgid d)))))) :rule-classes nil)

; Actual source parser boundary teeth; mutations are logical corruptions.
(in-package "ACL2")
(include-book "../../books/post-identity-captured-source-parser-context")
(include-book "post-identity-captured-source-pair-context-tests")
(defthm pic-sxt-begin-shape-positive
 (and (fn-pic-agent-shapep (pic-ajt-initial *pic-test-stamped*))
      (fn-pic-agent-shapep
       (fn-pic-begin *pic-test-selected* *pic-test-grant* nil *pic-test-incoming*
                    (len *pic-test-stamped*) "<m>" nil nil))) :rule-classes nil)
(defconst *pic-sxt-improper-agent*
 (let ((a (fn-pic-get agent *pic-ajt-entry*)))
  (list* :agent (fn-pic-at 1 a) (fn-pic-at 2 a) 1)))
(defconst *pic-sxt-corrupt* (fn-pic-set agent *pic-sxt-improper-agent* *pic-ajt-entry*))
(defthm pic-sxt-shape-carry-positive
 (let* ((c *pic-ajt-entry*) (obs (pic-ajt-observation c *pic-test-stamped*)))
  (and (fn-pic-agent-shapep c)
       (fn-pic-agent-shapep (mv-nth 1 (fn-pic-feed-funded c obs 1)))
       (fn-pic-agent-shapep (mv-nth 1 (fn-pic-next c 1 *pic-test-stamped*))))) :rule-classes nil)
(defthm pic-sxt-shape-removal-corrupted-improper-agent
 (let ((c *pic-sxt-corrupt*))
  (and (not (fn-pic-agent-shapep c))
       (not (fn-pic-agent-shapep (mv-nth 1 (fn-pic-feed-funded c :control 0))))
       (not (fn-pic-agent-shapep (mv-nth 1 (fn-pic-next c 0 *pic-test-stamped*)))))) :rule-classes nil)
(defthm pic-sxt-source-incoming-start-positive
 (let* ((c *pic-ajt-entry*) (d (fn-pic-start-parser :source-incoming :source-incoming c)) (p (fn-pic-parser d)))
  (and (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*)
       (fn-pic-agent-shapep c) (member-eq :source-incoming '(:source-incoming :source-held))
       (fn-psc-source-contextp p *pic-test-stamped* *pic-spt-held*)
       (equal (fn-psc-model-retained-agent p *pic-test-stamped*)
              (fn-pb-path-agent *pic-test-stamped* (fn-record-string-octets (fn-pic-get msgid c)))))) :rule-classes nil)
(defthm pic-sxt-source-held-start-positive
 (let* ((c *pic-ajt-entry*) (d (fn-pic-start-parser :source-held :source-held c)) (p (fn-pic-parser d)))
  (and (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*)
       (fn-pic-agent-shapep c) (member-eq :source-held '(:source-incoming :source-held))
       (fn-psc-source-contextp p *pic-test-stamped* *pic-spt-held*)
       (equal (fn-psc-model-retained-agent p *pic-test-stamped*)
              (fn-pb-path-agent *pic-test-stamped* (fn-record-string-octets (fn-pic-get msgid c)))))) :rule-classes nil)
(defthm pic-sxt-source-start-shape-removal-improper-agent
 (let* ((c *pic-sxt-corrupt*) (d (fn-pic-start-parser :source-held :source-held c)) (p (fn-pic-parser d)))
  (and (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*)
       (not (fn-pic-agent-shapep c)) (member-eq :source-held '(:source-incoming :source-held))
       (not (and (fn-psc-source-contextp p *pic-test-stamped* *pic-spt-held*)
        (equal (fn-psc-model-retained-agent p *pic-test-stamped*)
               (fn-pb-path-agent *pic-test-stamped* (fn-record-string-octets (fn-pic-get msgid c)))))))) :rule-classes nil)
(defthm pic-sxt-source-start-context-removal-corrupted-held-extent
 (let* ((c (fn-pic-set held-n 146 *pic-ajt-entry*))
        (d (fn-pic-start-parser :source-held :source-held c)) (p (fn-pic-parser d)))
  (and (not (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*))

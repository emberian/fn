       (not (and (fn-psc-source-contextp p *pic-test-stamped* *pic-spt-held*)
        (equal (fn-psc-model-retained-agent p *pic-test-stamped*)
         (fn-pb-path-agent *pic-test-stamped* (fn-record-string-octets (fn-pic-get msgid d)))))))) :rule-classes nil)
(defun pic-sxt-pooled-entry-observation (phase token)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-page-read-pool
  (mv-let (ok fn-page-read-pool)
   (let* ((carrier (fn-ibc-carrier (list :input-backing 4 (len *pic-test-stamped*))
                                  (list token phase '(0 0 0 0 1))))
          (fn-page-read-pool (update-fn-prp-incoming-slot carrier fn-page-read-pool)))
    (mv (with-local-stobj fn-octets
     (mv-let (ok fn-octets)
      (let* ((fn-octets (fn-octets-from-list *pic-test-stamped* fn-octets)) (c *pic-ajt-before*))
       (mv-let (word d left) (fn-pic-held-next c 1 fn-octets fn-page-read-pool)
        (declare (ignore word))
        (let ((access (fn-ioh-access (fn-ibc-carrier-row (fn-prp-incoming-slot fn-page-read-pool))
                                    (fn-pic-get incoming-token c) :read)))
         (mv (and (fn-pic-agent-tracep c *pic-ajt-ticks* *pic-test-stamped*)
                  (equal (fn-octets-list fn-octets) *pic-test-stamped*)
                  (equal (fn-prp-incoming-slot fn-page-read-pool) carrier)
                  (if (equal access :holder-readonly)
                   (and (equal (fn-pic-get phase d) :source-incoming)
                        (fn-psc-source-contextp (fn-pic-parser d) *pic-test-stamped* *pic-spt-held*)
                        (equal (fn-psc-model-retained-agent (fn-pic-parser d) *pic-test-stamped*)
                         (fn-pb-path-agent *pic-test-stamped* (fn-record-string-octets (fn-pic-get msgid d)))))
                   (and (not (equal (fn-pic-get phase d) :source-incoming))
                        (equal d c) (equal left 1)))) fn-octets))))
      ok)) fn-page-read-pool))
   ok)))
(assert-event (pic-sxt-pooled-entry-observation :readonly *pic-test-incoming*))
(assert-event (pic-sxt-pooled-entry-observation :setup *pic-test-incoming*))
(assert-event (pic-sxt-pooled-entry-observation :cancelled *pic-test-incoming*))
(assert-event (pic-sxt-pooled-entry-observation :readonly '(:incoming 5)))
(defthm pic-sxt-pooled-shape-carry-positive
 (let ((c *pic-ajt-entry*))
  (and (fn-pic-agent-shapep c)
       (fn-pic-agent-shapep (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*))))) :rule-classes nil)
(defthm pic-sxt-pooled-shape-removal-corrupted-improper-agent
 (let ((c *pic-sxt-corrupt*))
  (and (not (fn-pic-agent-shapep c))
       (not (fn-pic-agent-shapep (mv-nth 1 (fn-pic-held-next c 0 *pic-test-stamped* *pic-sxt-pool*)))))) :rule-classes nil)

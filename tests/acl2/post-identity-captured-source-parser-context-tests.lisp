; Direct helper domain mutation; :agent is not a source callback mode.
(defthm pic-sxt-source-start-mode-removal-corrupted-call
 (let* ((c *pic-ajt-entry*) (d (fn-pic-start-parser :agent :agent c)) (p (fn-pic-parser d)))
  (and (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*)

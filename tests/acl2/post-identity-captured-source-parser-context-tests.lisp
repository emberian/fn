        (d (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*))) (q (fn-pic-parser d)))
  (and (not (fn-pic-agent-tracep c *pic-ajt-ticks* *pic-test-stamped*))
       (equal (fn-pic-get phase d) :source-incoming)
       (equal (fn-ioh-access (fn-ibc-carrier-row (fn-prp-incoming-slot *pic-sxt-pool*))

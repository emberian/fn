(defconst *pcdt-first-loss* (fn-cu-session-step-triple *pcdt-ready* '(:lost :timeout)))
(assert-event (equal (caddr *pcdt-first-loss*) '("lost-timeout" "reply")))
; A terminal session does not blame a later observation for its failure.
(assert-event (null (caddr (fn-cu-session-step-triple (car *pcdt-first-loss*) '(:lost :eof)))))
; A protocol refusal retains its protocol reason, without inventing a socket loss.
(defconst *pcdt-protocol-refusal*
 (fn-cu-session-step-triple *pcdt-start* (cons :remote (pcdt-line "500 no greeting"))))
(assert-event (equal (fn-cu-r-phase (fn-cu-s-round (car *pcdt-protocol-refusal*))) :failed))
(assert-event (null (caddr *pcdt-protocol-refusal*)))
(assert-event (equal (fn-cu-session-log-line-detail (car *pcdt-protocol-refusal*) nil)
                     (fn-cu-session-log-line (car *pcdt-protocol-refusal*))))

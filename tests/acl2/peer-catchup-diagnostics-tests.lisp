; Actual session traces retain transport loss, not a guessed failure cause.
(in-package "ACL2")
(include-book "../../books/peer-catchup-diagnostics")

(defconst *pcdt-peer* (fn-record-string-octets "A"))
(defconst *pcdt-plan*
 (list *pcdt-peer* (fn-record-string-octets "10.1.2.3") 11119
       (fn-record-string-octets "fn.*") 2000
       (list :tls :starttls "localhost" "/a/anchor.pem")
       (list :authinfo "/b/A.fnauth" nil) *fn-pull-default-unavailable-rounds*))
(defconst *pcdt-begin*
 (fn-cu-session-begin-pair *pcdt-plan* (fn-cu-fresh-cursor *pcdt-peer*)
                         (list (fn-record-string-octets "nodeB")
                               (fn-record-string-octets "s3cret"))))
(defconst *pcdt-start* (car *pcdt-begin*))
(assert-event (equal (fn-pull-plan-verdict *pcdt-plan*) :tls))
(assert-event (not (fn-cu-session-done-p *pcdt-start*)))
(assert-event (not (fn-cu-session-readyp *pcdt-start*)))

(defun pcdt-line (text) (append (fn-record-string-octets text) '(13 10)))
(defun pcdt-drive (s events)
 (declare (xargs :verify-guards nil))
 (if (consp events)
     (pcdt-drive (car (fn-cu-session-step-triple s (car events))) (cdr events))
   s))
(defconst *pcdt-ready*
 (pcdt-drive *pcdt-start*
  (list (cons :remote (pcdt-line "200 A ready"))
        (cons :remote (pcdt-line "382 begin TLS"))
        (list :tls-up)
        (cons :remote (pcdt-line "381 password"))
        (cons :remote (pcdt-line "281 ok")))))
(assert-event (fn-cu-session-readyp *pcdt-ready*))
(assert-event (not (fn-cu-session-done-p *pcdt-ready*)))
(assert-event (equal (fn-cu-r-phase (fn-cu-s-round *pcdt-ready*)) :reply))

(defthm pcdt-preamble-dial-retains-the-actual-loss
 (let* ((event '(:lost :dial))
        (triple (fn-cu-session-step-triple *pcdt-start* event))
        (s2 (car triple))
        (detail (caddr triple)))
  (and (not (fn-cu-session-done-p *pcdt-start*))
       (equal (fn-cu-r-phase (fn-cu-s-round s2)) :failed)
       (equal (take 2 triple) (fn-cu-session-step-pair *pcdt-start* event))
       (equal detail '("lost-dial" "preamble"))
       (equal (fn-cu-session-log-line-detail s2 detail)
              (append (fn-cu-session-log-line s2)
                      (fn-record-string-octets " loss=lost-dial loss-phase=preamble")))))
 :rule-classes nil)


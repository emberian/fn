(defthm fn-psc-source-after-stamp-v1-incoming-literal
 (let* ((xs (append '(97 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48 48) (fn-inj-injection-info-line '(97)))) (incoming xs)
        (held nil)
        (c (fn-psc-set date 0 (fn-psc-begin :source-incoming (len xs) "<a@b>" '(:agent 0 1) (len incoming))))
        (p (fn-pbb-source-after-stamp 31 (fn-psc-model-captured-date c incoming held)
             (fn-psc-model-retained-agent c incoming) (fn-record-string-octets (fn-psc-get msgid c)) xs))
        (d (fn-psc-model-source-after-stamp-complete 31 c incoming held)))
  (and (fn-psc-source-date-contextp c incoming held) (natp 31) (<= 31 (len xs))
       (equal p 50)
       (equal (fn-psc-get phase d) (if p :control :done))
       (implies p (and (equal (fn-psc-get resume d) :source-found)
                       (equal (fn-psc-get pos d) p) (fn-psc-get ok d)))
       (implies (not p) (equal (fn-psc-result d) :no-source))
       (equal d (fn-psc-model-byte-run (fn-psc-model-source-after-stamp-cost 31 c incoming held)
                  (fn-psc-info-compare 31 :source-info-v1 (fn-psc-set k 31 c)) incoming held))))
 :rule-classes nil)


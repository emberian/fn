; Hypothesis removal: only the captured 31-byte Date bound is omitted.
(defthm fn-psc-source-after-stamp-capture-bound-removal-literal
 (let* ((incoming (append (fn-inj-injection-info-line '(97)) (fn-inj-date-line nil)))
        (held nil)
        (c (fn-psc-set date 999 (fn-psc-begin :source-incoming (len incoming) "<a@b>" '(:agent 16 17) (len incoming))))
        (p (fn-pbb-source-after-stamp 0 (fn-psc-model-captured-date c incoming held)
             (fn-psc-model-retained-agent c incoming) (fn-record-string-octets (fn-psc-get msgid c)) incoming))
        (d (fn-psc-model-source-after-stamp-complete 0 c incoming held)))
  (and (fn-psc-source-contextp c incoming held)
       (natp (fn-psc-get date c))
       (not (<= (+ 31 (fn-psc-get date c)) (len (fn-psc-model-source c incoming held))))
       (not (fn-psc-source-date-contextp c incoming held))
       (natp 0) (<= 0 (len incoming)) (equal p nil)
       (not (equal (fn-psc-get phase d) (if p :control :done)))))
 :rule-classes nil)

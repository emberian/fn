; Closed composition counterexample to the unchanged composite-v3 O(K) claim.
; A3 itself holds: every attempted candidate's metadata path is allowed.
; The rejected candidate has 1,031 control pages, beyond one entry's budget.
(in-package "ACL2")
(include-book "../../books/log-checkpoint-open-bound")
(include-book "../../books/log-checkpoint-selection-proof")
(include-book "../../books/log-checkpoint-independent-guards")
(include-book "lc-open-fixtures")
(defun lco-wide-fallback-disk (n)
 (declare (xargs :guard (natp n) :verify-guards nil))
 (let* ((input (lco-id5-input 1)) (disk (fn-lc-at 0 input))
        (image (fn-lc-at 3 (pgs-open disk :lc :eager)))
        (header (fn-lc-head image))
        (control (fn-lc-join (fn-lc-at 5 header) (make-list n :initial-element nil)))
        (wide-header (ec-call (update-nth 5 control header)))
        (wide-image (cons wide-header (fn-lc-join (fn-lc-rest image) (make-list n :initial-element nil))))
        (dirty (ec-call (fn-lc-proof-data-pages wide-image 0)))
        (new-disk (ec-call (pgs-commit disk :lc :eager dirty
                             (ec-call (fn-lc-publication-alloc disk)))))
        (table (fn-lc-selected-page-table new-disk :lc :eager))
        (last-control-address (fn-lc-head (fn-lc-at (1- (len table)) table))))
  (cons (cons (cons last-control-address '(:damaged)) (pgs-pages new-disk))
        (pgs-roots new-disk))))

(defun lco-composite-observe (disk outcome fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((input (lco-id5-input 1)) (segs (fn-lc-at 3 input))
        (beforep (fn-lbc-p fn-lbc))
        (header (fn-lc-adopted-header disk :lc :eager))
        (selection (fn-lc-open-selection disk :lc :eager 0 segs header))
        (k 0) (max (fn-lc-tail-max header)))
  (mv-let (answer fn-lbc after-disk after-segs trace owner)
   (fn-lc-open disk :lc :eager (fn-lc-at 2 input) 8 4 segs outcome fn-lbc)
   (declare (ignore after-disk after-segs owner))
   (let* ((requested (fn-lc-read-octets trace))
          (allowed (+ (* 2 (fn-lc-root-slot-octets))
                    (* (len (fn-lc-directory-path-pages disk :lc :eager)) (fn-lc-page-octets))
                    (* (+ 1 k) (fn-lc-entry-octets-bound max)))))
    (mv (list beforep (fn-lc-segsp segs)
              (equal (car selection) :checkpoint) (natp k)
              (<= (len (ec-call (fn-lc-selection-tail selection))) k)
              answer requested allowed
              (fn-lc-open-bound-limit disk :lc :eager segs :a3)
              (len (fn-lc-directory-path-pages disk :lc :eager))
              (fn-lc-entry-octets-bound max)
              (len (fn-lc-open-metadata-pages disk :lc :eager))
              (fn-lc-cold-only-metadata-requests-p trace (fn-lc-open-metadata-pages disk :lc :eager))
              (fn-lc-first-candidate-selectedp disk :lc :eager)
              max)
        fn-lbc)))))

(defun lco-composite-fixture (widep)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((disk (if widep (lco-wide-fallback-disk 1030) (fn-lc-at 0 (lco-id5-input 1))))
        (outcome (make-list 1100 :initial-element :ok)))
  (with-local-stobj fn-lbc
   (mv-let (result fn-lbc) (lco-composite-observe disk outcome fn-lbc) result))))

(verify-guards lco-wide-fallback-disk)
(verify-guards lco-composite-observe)
(verify-guards lco-composite-fixture)
(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
 ; Whole frozen composite antecedent and conclusion: positive control.
 (assert-event
  (let ((out (lco-composite-fixture nil)))
   (and (fn-lc-at 0 out) (fn-lc-at 1 out) (fn-lc-at 2 out)
        (fn-lc-at 3 out) (fn-lc-at 4 out)
        (equal (fn-lc-at 5 out) :ok)
        (<= (fn-lc-at 6 out) (fn-lc-at 7 out)))))
 ; All FIVE original hypotheses; the exact unchanged conclusion is false.
 (assert-event
  (let ((out (lco-composite-fixture t)))
   (and (fn-lc-at 0 out) (fn-lc-at 1 out) (fn-lc-at 2 out)
        (fn-lc-at 3 out) (fn-lc-at 4 out)
        (equal (fn-lc-at 5 out) :ok)
        (equal (fn-lc-at 6 out) 17088772)
        (equal (fn-lc-at 7 out) 16941358)
        (> (fn-lc-at 6 out) (fn-lc-at 7 out))
        ; Approved A3 still holds, at equality; no column request.
        (equal (fn-lc-at 8 out) (fn-lc-at 6 out))
        (equal (fn-lc-at 9 out) 10)
        (equal (fn-lc-at 10 out) 16777258)
        (equal (fn-lc-at 11 out) 1043)
        (fn-lc-at 12 out) (not (fn-lc-at 13 out))
        (equal (fn-lc-at 14 out) 16777216))))
 (value-triple (list (lco-composite-fixture nil) (lco-composite-fixture t))))

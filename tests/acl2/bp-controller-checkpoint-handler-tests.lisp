; Actual registered handler storage refuter. Raw constructors/ledger are
; explicitly an unsanctioned test factory, not runtime/funding installation.
(in-package "ACL2")
(include-book "../../books/bp-controller-checkpoint-handler")
(set-verify-guards-eagerness 0)
(defun bpckt-seed (fn-bp-controller-registry)
 (declare (xargs :stobjs fn-bp-controller-registry :guard t))
 (let* ((initial (fn-bpnf-initial-state
                  (fn-bpn-config (cons :dtn '(47 47 98 112 45 108 111 99 97 108 47))
                                 3600000 2 32 1048576) 8 1048576))
        (current (fn-bpnf-with-issued initial
                   (fn-bpnf-operation (fn-bpnf-epoch initial) 0 :checkpoint 5 :pending)))
        (ledger (fn-prl-build '(1000000 100000 10 10 100) '(0 0 0 0 0)
                              7 nil '(1000 0 0 0 0)))
        (fn-bp-controller-registry (update-fn-bpcr-highwater 1 fn-bp-controller-registry)))
  (stobj-let ((fn-bpc-node (fn-bpcr-root fn-bp-controller-registry)))
   (token expected current fn-bpc-node)
   (stobj-let ((fn-bpc-segment
                 (fn-bpcn-children-get 'fn-bpc-segment fn-bpc-node (create-fn-bpc-segment))))
    (token expected current fn-bpc-segment)
    (mv-let (installed fn-bpc-segment)
     (fn-bpc-segment-install 2 0 current :unfunded-storage-only fn-bpc-segment)
     (declare (ignore installed))
     (mv-let (reserved token ignored-ledger fn-bpc-segment)
      (fn-bpcc-segment-reserve '(:bp-controller 2 0) 0 '(8192 4096 1 1 1)
                              ledger fn-bpc-segment)
      (declare (ignore reserved ignored-ledger))
      (let* ((job (fn-bpck-begin token (fn-bpco-checkpoint-epoch current) 5
                    (fn-bpnr-depth-budget 8) nil nil 8 0 1048576))
             (payload (fn-bpck-control-make job '(:io-marker) :unfunded-digest-binding nil)))
       (mv-let (updated fn-bpc-segment)
        (fn-bpcc-segment-payload-replace token 0 0 :reserved :running payload fn-bpc-segment)
        (declare (ignore updated))
        (mv token (fn-bpck-census-step job 1) current fn-bpc-segment)))))
    (mv token expected current fn-bpc-node))
   (mv token expected current fn-bp-controller-registry))))
(defun bpckt-observe (token expected current fn-bp-controller-registry)
 (declare (xargs :stobjs fn-bp-controller-registry :guard t))
 (mv-let (unavailable ignored ignored-left fn-bp-controller-registry)
  (fn-owner-bp-checkpoint-turn '(:bp-controller 2 0) token 1 :census 1 4 fn-bp-controller-registry)
  (declare (ignore ignored ignored-left))
  (mv-let (low low-answer low-left fn-bp-controller-registry)
   (fn-bpck-registered-census-turn '(:bp-controller 2 0) token 1 1 1 fn-bp-controller-registry)
   (mv-let (updated answer left fn-bp-controller-registry)
    (fn-bpck-registered-census-turn '(:bp-controller 2 0) token 1 1 4 fn-bp-controller-registry)
    (mv-let (read frozen claim payload phase revision read-left fn-bp-controller-registry)
     (fn-bpcc-directory-payload '(:bp-controller 2 0) token :read nil nil nil nil 4 fn-bp-controller-registry)
     (declare (ignore read-left))
     (mv-let (stale ignored stale-left fn-bp-controller-registry)
      (fn-bpck-registered-census-turn '(:bp-controller 2 0) token 1 1 4 fn-bp-controller-registry)
      (declare (ignore ignored))
      (mv-let (cancel ignored-current ignored-claim ignored-payload ignored-phase ignored-revision cancel-left fn-bp-controller-registry)
       (fn-bpcc-directory-payload '(:bp-controller 2 0) nil :fence-current nil nil nil nil 4 fn-bp-controller-registry)
       (declare (ignore ignored-current ignored-claim ignored-payload ignored-phase ignored-revision cancel-left))
       (mv-let (cancelled ignored cancelled-left fn-bp-controller-registry)
        (fn-bpck-registered-census-turn '(:bp-controller 2 0) token 2 1 4 fn-bp-controller-registry)
        (declare (ignore ignored cancelled-left))
        (mv-let (kept-word kept-current kept-claim kept-payload kept-phase kept-revision kept-left fn-bp-controller-registry)
         (fn-bpcc-directory-payload '(:bp-controller 2 0) token :read nil nil nil nil 4 fn-bp-controller-registry)
         (declare (ignore kept-left))
         (mv (and (equal unavailable :bp-runtime-unavailable)
                  (equal low :yield) (null low-answer) (equal low-left 1)
                  (equal updated :checkpoint-updated) (equal answer '(2 :census))
                  (equal left 2) (equal read :checkpoint-current) (equal revision 2)
                  (equal phase :running) (equal frozen current)
                  (equal (fn-bpck-control-job payload) expected)
                  (equal (fn-bpck-control-io payload) '(:io-marker))
                  (equal (fn-bpck-control-digest payload) :unfunded-digest-binding)
                  (equal stale :stale-checkpoint) (equal stale-left 3)
                  (equal cancel :checkpoint-retained) (equal cancelled :stale-checkpoint)
                  (equal kept-word :checkpoint-current) (equal kept-phase :cancelled)
                  (equal kept-revision 2) (equal kept-payload payload)
                  (equal kept-current frozen) (equal kept-claim claim))
             fn-bp-controller-registry))))))))))
(defun bpckt-local ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-bp-controller-registry
  (mv-let (answer fn-bp-controller-registry)
   (mv-let (token expected current fn-bp-controller-registry)
    (bpckt-seed fn-bp-controller-registry)
    (bpckt-observe token expected current fn-bp-controller-registry)) answer)))
(assert-event (bpckt-local))

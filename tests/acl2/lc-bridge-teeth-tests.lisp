(in-package "ACL2")
(include-book "../../books/log-checkpoint-bridge")
(include-book "../../books/log-checkpoint-publication-witnesses")
(local (defun fn-lc-bridge-tooth-digest (x) (declare (xargs :guard t)) (acl2-count x)))
(local (defattach pgs-digest fn-lc-bridge-tooth-digest))
(defun fn-lc-bridge-tooth-header ()
 (declare (xargs :guard t :verify-guards nil))
 (list :lc-header (list 0 0 0 0 *fn-lg-genesis*) 1 nil nil
       (list (list :lc-tail-policy 1 1024))))
(defun fn-lc-bridge-tooth-terminal-segs ()
 (declare (xargs :guard t)) '((0 (0) nil)))
(defun fn-lc-bridge-tooth-two-move-segs ()
 (declare (xargs :guard t :verify-guards nil))
 (let* ((a (fn-lc-move-frame *fn-lg-genesis* 0 nil nil))
        (b (fn-lc-move-frame (fn-lg-trailer a) 0 nil nil)))
  (list (list 0 (append a b) nil))))
(defun fn-lc-bridge-tooth-disk ()
 (declare (xargs :guard t :verify-guards nil))
 (fn-lc-proof-image-disk (fn-lc-pages nil (fn-lc-bridge-tooth-header))))
(defteeth fn-lc-selected-tail-entry-bridge
 :claim (let ((selection (fn-lc-open-selection disk r mode count segs header)))
  (((selected (equal (car selection) :checkpoint)))
   (and (<= (len (fn-lc-tail-entries disk r mode segs))
            (+ 1 (len (fn-lc-selection-tail selection))))
        (fn-lc-entries-boundedp (fn-lc-tail-entries disk r mode segs)
                               (fn-lc-entry-octets-bound (fn-lc-tail-max header))))))
 :subject fn-lc-tail-entries
 :witness ((disk (fn-lc-bridge-tooth-disk)) (r :lc) (mode :eager) (count 0)
           (segs (fn-lc-bridge-tooth-terminal-segs)) (header (fn-lc-bridge-tooth-header)))
 :breaks ((selected ((count -1) (segs (fn-lc-bridge-tooth-two-move-segs)))
   :logical "invalid count refuses selection but two physical requests remain"))
 :mutations ((omits-terminal
  (:conclusion
   (and (<= (len (fn-lc-tail-entries disk r mode segs))
            (len (fn-lc-selection-tail selection)))
        (fn-lc-entries-boundedp (fn-lc-tail-entries disk r mode segs)
                               (fn-lc-entry-octets-bound (fn-lc-tail-max header)))))
  nil :fault "the terminal probe is omitted from the read count")))
(defteeth-check (fn-lc-selected-tail-entry-bridge))

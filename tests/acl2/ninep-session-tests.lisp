(in-package "ACL2")
(include-book "../../books/ninep-session")

; Explicit INTERNAL custody fixture. These literal fields are not an
; installed runtime or durable publication witness.
(defun-nx ninep-session-fixture ()
 (let* ((s (create-fn-ninep-session))
        (s (fn-9ps-provision-internal 2 2 s))
        (s (update-fn-9ps-msize 64 s))
        (s (update-fn-9ps-phase :base s))
        (s (update-fn-9ps-mount-phase :held s))
        (s (update-fn-9ps-mount-source '(:internal-source 17) s))
        (s (update-fn-9ps-mount-token '(:ninep-mount 0) s)))
  (mv-nth 1 (fn-9ps-fid-bind-owned 0 1 '(:internal-selection 17) s))))

(defun-nx ninep-session-running ()
 (let* ((s (ninep-session-fixture))
        (s (mv-nth 1 (fn-9ps-open-at 1 0 0 s))))
  (mv-nth 1 (fn-9ps-request-register-owned 0 9 '(:internal-read 1) 0 '(:borrow 1) s))))

(defthm ninep-session-flush-complete-positive
 (let* ((s (ninep-session-running))
        (next (mv-nth 1 (fn-9ps-flush-at 11 9 0 s))))
  (and (fn-ninep-sessionp s) (fn-ninep-sessionp next)
       (equal (fn-9ps-request-phasei 0 s) :running)
       (equal (mv-nth 0 (fn-9ps-flush-at 11 9 0 s)) '(:reply (7 0 0 0 109 11 0)))
       (equal (fn-9ps-request-phasei 0 next) :cancelled)
       (equal (fn-9ps-mount-source next) (fn-9ps-mount-source s))
       (equal (fn-9ps-mount-token next) (fn-9ps-mount-token s))
       (equal (nth 7 next) (nth 7 s))
       (equal (nth 10 next) (nth 10 s))
       (equal (nth 12 next) (nth 12 s))))
 :rule-classes nil)

(defthm ninep-session-flush-tag-reuse-and-old-return
 (let* ((s (ninep-session-running))
        (cancelled (mv-nth 1 (fn-9ps-flush-at 11 9 0 s)))
        (reused (mv-nth 1 (fn-9ps-request-register-owned 1 9 '(:internal-read 2) 0 '(:borrow 2) cancelled)))
        (returned (mv-nth 1 (fn-9ps-request-return-owned 0 '(:internal-read 1) reused))))
  (and (equal (mv-nth 0 (fn-9ps-find-tag-step 9 0 cancelled)) :yield)
       (equal (mv-nth 0 (fn-9ps-find-tag-step 9 1 reused)) :found)
       (equal (fn-9ps-fid-borrowsi 0 reused) 2)
       (equal (mv-nth 0 (fn-9ps-request-return-owned 0 '(:internal-read 1) reused)) :discard)
       (equal (fn-9ps-fid-borrowsi 0 returned) 1)
       (equal (fn-9ps-request-phasei 1 returned) :running)
       (equal (fn-9ps-request-receipti 1 returned) '(:internal-read 2))
       (equal (fn-9ps-request-return-owned 0 '(:internal-read 1) returned) (mv :stale returned))))
 :rule-classes nil)

(defthm ninep-session-reused-slot-stale-callback-full-effect
 (let* ((s (ninep-session-running))
        (done (mv-nth 1 (fn-9ps-request-return-owned 0 '(:internal-read 1) s)))
        (reused (mv-nth 1 (fn-9ps-request-register-owned 0 10 '(:internal-read 3) 0 '(:borrow 3) done))))
  (and (fn-ninep-sessionp reused)
       (equal (fn-9ps-request-phasei 0 reused) :running)
       (equal (fn-9ps-request-receipti 0 reused) '(:internal-read 3))
       (not (equal '(:internal-read 1) (fn-9ps-request-receipti 0 reused)))
       (equal (fn-9ps-request-return-owned 0 '(:internal-read 1) reused) (mv :stale reused))
       (equal (fn-9ps-fid-borrowsi 0 reused) 1)))
 :rule-classes nil)

(defthm ninep-session-actual-return-once-complete-positive
 (let* ((s (ninep-session-running))
        (next (mv-nth 1 (fn-9ps-request-return-owned 0 '(:internal-read 1) s))))
  (and (fn-ninep-sessionp s)
       (member-eq (mv-nth 0 (fn-9ps-request-return-owned 0 '(:internal-read 1) s)) '(:publish :discard))
       (equal (mv-nth 0 (fn-9ps-request-return-owned 0 '(:internal-read 1) s)) :publish)
       (equal (fn-9ps-fid-borrowsi 0 next) 0)
       (equal (fn-9ps-request-return-owned 0 '(:internal-read 1) next) (mv :stale next))))
 :rule-classes nil)

(defthm ninep-session-clunk-with-physical-borrow-complete-positive
 (let* ((s (ninep-session-running))
        (closing (mv-nth 1 (fn-9ps-clunk-at 1 0 s)))
        (done (mv-nth 1 (fn-9ps-request-return-owned 0 '(:internal-read 1) closing)))
        (retired (mv-nth 1 (fn-9ps-fid-retire-step 0 done))))
  (and (fn-9ps-fid-slotp 0 closing)
       (equal (fn-9ps-fid-phasei 0 closing) :clunking)
       (not (equal (fn-9ps-fid-borrowsi 0 closing) 0))
       (equal (fn-9ps-fid-retire-step 0 closing) (mv :await-return closing))
       (equal (mv-nth 0 (fn-9ps-fid-retire-step 0 done)) :retired)
       (equal (fn-9ps-selectioni 0 retired) nil)
       (equal (fn-9ps-mount-source retired) (fn-9ps-mount-source s))))
 :rule-classes nil)

(defthm ninep-session-partial-walk-full-effect
 (let ((s (ninep-session-fixture)))
  (and (equal (mv-nth 0 (fn-9ps-walk-finish-owned 0 1 2 2 1 '(:partial) s)) :partial-walk)
       (equal (fn-9ps-walk-finish-owned 0 1 2 2 1 '(:partial) s) (mv :partial-walk s))
       (equal (fn-9ps-fid-phasei 1 s) :idle)))
 :rule-classes nil)

(defthm ninep-session-readonly-open-full-effect
 (let ((s (ninep-session-fixture)))
  (and (fn-9ps-fid-slotp 0 s) (natp 1) (equal 1 (fn-9ps-fidsi 0 s))
       (equal (fn-9ps-phase s) :base) (equal (fn-9ps-fid-phasei 0 s) :walked)
       (not (equal 16 0))
       (equal (fn-9ps-open-at 1 0 16 s) (mv :read-only s))))
 :rule-classes nil)

(defthm ninep-session-readonly-mode-hypothesis-removal
 (let ((s (ninep-session-fixture)))
  (and (fn-9ps-fid-slotp 0 s) (natp 1) (equal 1 (fn-9ps-fidsi 0 s))
       (equal (fn-9ps-phase s) :base) (equal (fn-9ps-fid-phasei 0 s) :walked)
       (equal 0 0)
       (not (equal (fn-9ps-open-at 1 0 0 s) (mv :read-only s)))
       (equal (mv-nth 0 (fn-9ps-open-at 1 0 0 s)) :opened)))
 :rule-classes nil)

(defthm ninep-session-disconnect-retains-unreturned-work
 (let* ((s (ninep-session-running))
        (draining (fn-9ps-drain-begin s))
        (waiting (mv-nth 1 (fn-9ps-quiesce-step draining))))
  (and (equal (mv-nth 0 (fn-9ps-quiesce-step draining)) :await-return)
       (equal (fn-9ps-request-phasei 0 waiting) :cancelled)
       (equal (fn-9ps-drain-index waiting) 0)
       (equal (fn-9ps-mount-source waiting) (fn-9ps-mount-source s))
       (equal (fn-9ps-request-borrowi 0 waiting) (fn-9ps-request-borrowi 0 s))
       (equal (fn-9ps-request-return-owned 0 '(:wrong) waiting) (mv :stale waiting))))
 :rule-classes nil)

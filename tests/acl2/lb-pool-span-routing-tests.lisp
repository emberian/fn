(with-guard-checking-event t
 (assert-event
 (and (equal (fn-lbc-nov-spans '("x") 18446744073709551616) '(0 1))
      (fn-lbc-pool-spans-fitp '("x") nil 18446744073709551615)
      (not (fn-lbc-pool-spans-fitp '("x") nil 18446744073709551616))
      (not (fn-lbc-pool-spans-fitp '("xx" "y") nil 18446744073709551615))
      (not (fn-lbc-pool-spans-fitp '(("fn.test" . 1)) t 18446744073709551616))
      (fn-lbc-nov-pool-fitp (fn-hnov-make nil t "x" "" "" "" "") 0)
      (not (fn-lbc-nov-pool-fitp (fn-hnov-make nil t "x" "" "" "" "") 18446744073709551616)))
 :msg "u64 span routing: normal and exact-boundary positives; wide offset/cross-boundary escaped, never rejected"))

; Real catalog assignment, then compact/wide routing on tiny resident values.
(with-guard-checking-event t
 (assert-event
 (let* ((payload '(72 58 120 13 10 13 10 98 13 10))
        (wire (fn-record-make 0 1 0 "<lb-span@example.invalid>"
                 payload '("fn.test") "o" "s" "e" 1 5))
        (plain (fn-held-plain wire 0))
        (row (car (fn-cat$a-commit plain nil)))
        (render (fn-hnov-of payload))
        (head-length (len (fn-nntp-stuffed-section :head payload)))
        (raw-head-length
          (len (fn-la-payload-wire (fn-nntp-split-head (fn-nntp-split-article payload)))))
        (msgid-length (len (fn-record-string-octets (fn-record-msgid row))))
        (compact (fn-lbc-row-escape-cell row payload render head-length 5 0 msgid-length
                     0 0 0 0 1 raw-head-length t t t t))
        (wide (fn-lbc-row-escape-cell row payload render
                  18446744073709551617 5 18446744073709551618 24
                  0 0 0 0 1 18446744073709551619 nil nil nil nil)))
  (and (fn-cat-rowp row)
       (equal (fn-held-numbers row) '(("fn.test" . 1)))
       (equal compact nil)
       (alistp wide)
       (equal (cdr (assoc-eq :head-length wide)) 18446744073709551617)
       (equal (cdr (assoc-eq :msgid-offset wide)) 18446744073709551618)
       (equal (cdr (assoc-eq :raw-head-length wide)) 18446744073709551619)
       (equal (cdr (assoc-eq :render-nov wide)) render)
       (equal (cdr (assoc-eq :groups wide)) (fn-record-groups row))
       (equal (cdr (assoc-eq :numbers wide)) (fn-held-numbers row))
       (not (assoc-eq :msgid-slot wide))
       (not (equal (cdr (assoc-eq :render-nov
                           (remove-assoc-equal :render-nov wide))) render))))
 :msg "real assigned row: compact stays compact; wide spans/fields remain exact; dropped-render fault detected"))



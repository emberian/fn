; Actual source continuation witnesses; corruptions are not reachable calls.
(in-package "ACL2")
(include-book "../../books/post-identity-captured-source-continuation")
(include-book "post-identity-captured-source-parser-context-tests")
(defthm pic-sct-source-start-positive
 (let ((c *pic-ajt-entry*))
  (and (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*)
       (fn-pic-agent-shapep c)
       (member-eq :source-incoming '(:source-incoming :source-held))
       (member-eq :source-held '(:source-incoming :source-held))
       (fn-pic-source-continuationp (fn-pic-start-parser :source-incoming :source-incoming c)
                                  *pic-test-stamped* *pic-spt-held*)
       (fn-pic-source-continuationp (fn-pic-start-parser :source-held :source-held c)
                                  *pic-test-stamped* *pic-spt-held*))) :rule-classes nil)
(defthm pic-sct-start-shape-removal-corrupted-improper-agent
 (let ((c *pic-sxt-corrupt*))
  (and (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*)
       (not (fn-pic-agent-shapep c)) (member-eq :source-held '(:source-incoming :source-held))
       (not (fn-pic-source-continuationp (fn-pic-start-parser :source-held :source-held c)
                                       *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defthm pic-sct-start-context-removal-corrupted-held-extent
 (let ((c (fn-pic-set held-n 146 *pic-ajt-entry*)))
  (and (not (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*))
       (fn-pic-agent-shapep c) (member-eq :source-held '(:source-incoming :source-held))
       (not (fn-pic-source-continuationp (fn-pic-start-parser :source-held :source-held c)
                                       *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defthm pic-sct-start-mode-removal-corrupted-call
 (let ((c *pic-ajt-entry*))
  (and (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*)
       (fn-pic-agent-shapep c) (not (member-eq :agent '(:source-incoming :source-held)))
       (not (fn-pic-source-continuationp (fn-pic-start-parser :agent :agent c)
                                       *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defthm pic-sct-funded-pending-positive
 (let* ((c *pic-ajt-entry*) (d (mv-nth 1 (fn-pic-feed-funded c :control 1))))
  (and (fn-pic-source-continuationp c *pic-test-stamped* *pic-spt-held*)
       (member-eq (fn-pic-get phase d) '(:source-incoming :source-held))
       (fn-pic-source-continuationp d *pic-test-stamped* *pic-spt-held*)
       (not (equal (fn-pic-parser d) (fn-pic-parser c))))) :rule-classes nil)
(defthm pic-sct-readonly-pending-positive
 (let* ((c *pic-ajt-entry*) (d (mv-nth 1 (fn-pic-next c 1 *pic-test-stamped*))))
  (and (fn-pic-source-continuationp c *pic-test-stamped* *pic-spt-held*)
       (member-eq (fn-pic-get phase d) '(:source-incoming :source-held))
       (fn-pic-source-continuationp d *pic-test-stamped* *pic-spt-held*)
       (not (equal (fn-pic-parser d) (fn-pic-parser c))))) :rule-classes nil)
(defthm pic-sct-pooled-pending-positive
 (let* ((c *pic-ajt-entry*) (d (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*))))
  (and (fn-pic-source-continuationp c *pic-test-stamped* *pic-spt-held*)
       (member-eq (fn-pic-get phase d) '(:source-incoming :source-held))
       (fn-pic-source-continuationp d *pic-test-stamped* *pic-spt-held*)
       (not (equal (fn-pic-parser d) (fn-pic-parser c))))) :rule-classes nil)
(defthm pic-sct-carry-context-removal-corrupted-parser-span
 (let* ((c (fn-pic-set parser (fn-psc-set agent-start (+ 1 (fn-psc-get agent-start (fn-pic-parser *pic-ajt-entry*)))
                                          (fn-pic-parser *pic-ajt-entry*)) *pic-ajt-entry*))
        (a (mv-nth 1 (fn-pic-feed-funded c :control 0)))
        (b (mv-nth 1 (fn-pic-next c 0 *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-held-next c 0 *pic-test-stamped* *pic-sxt-pool*))))
  (and (not (fn-pic-source-continuationp c *pic-test-stamped* *pic-spt-held*))
       (member-eq (fn-pic-get phase a) '(:source-incoming :source-held))
       (member-eq (fn-pic-get phase b) '(:source-incoming :source-held))
       (member-eq (fn-pic-get phase d) '(:source-incoming :source-held))
       (not (fn-pic-source-continuationp a *pic-test-stamped* *pic-spt-held*))
       (not (fn-pic-source-continuationp b *pic-test-stamped* *pic-spt-held*))
       (not (fn-pic-source-continuationp d *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defun pic-sct-before-phase-change (c incoming ticks)
 (declare (xargs :measure (nfix ticks) :verify-guards nil))
 (if (zp ticks) c
  (let ((d (nth 1 (mv-list 3 (fn-pic-feed-funded c (pic-ajt-observation c incoming) 1)))))
   (if (not (equal (fn-pic-get phase d) (fn-pic-get phase c))) c
    (pic-sct-before-phase-change d incoming (1- ticks))))))
(defconst *pic-sct-before-magic* (pic-sct-before-phase-change *pic-ajt-entry* *pic-test-stamped* 2000))
(defthm pic-sct-carry-phase-removal-actual-source-exit
 (let* ((c *pic-sct-before-magic*) (obs (pic-ajt-observation c *pic-test-stamped*))
        (a (mv-nth 1 (fn-pic-feed-funded c obs 1)))
        (b (mv-nth 1 (fn-pic-next c 2 *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-held-next c 2 *pic-test-stamped* *pic-sxt-pool*))))
  (and (fn-pic-source-continuationp c *pic-test-stamped* *pic-spt-held*)
       (equal (fn-pic-get phase a) :magic) (equal (fn-pic-get phase b) :magic) (equal (fn-pic-get phase d) :magic)
       (not (member-eq (fn-pic-get phase a) '(:source-incoming :source-held)))
       (not (member-eq (fn-pic-get phase b) '(:source-incoming :source-held)))
       (not (member-eq (fn-pic-get phase d) '(:source-incoming :source-held)))
       (not (fn-pic-source-continuationp a *pic-test-stamped* *pic-spt-held*))
       (not (fn-pic-source-continuationp b *pic-test-stamped* *pic-spt-held*))
       (not (fn-pic-source-continuationp d *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defconst *pic-sct-short-held* '(97 98 99))
(defconst *pic-sct-short-agent-start*
 (let ((c (pic-ajt-initial *pic-test-stamped*)))
  (nth 1 (mv-list 3 (fn-pic-feed-funded c (update-nth 4 3 (pic-ajt-length c)) 1)))))
(defconst *pic-sct-short-entry*
 (pic-ajt-drive *pic-sct-short-agent-start* *pic-test-stamped* (+ 1 *pic-ajt-ticks*)))
(defconst *pic-sct-before-held*
 (pic-sct-before-phase-change *pic-sct-short-entry* *pic-test-stamped* 2000))
(defthm pic-sct-actual-both-source-switch-positive
 (let* ((c *pic-sct-before-held*) (obs (pic-ajt-observation c *pic-test-stamped*))
        (d (mv-nth 1 (fn-pic-feed-funded c obs 1))))
  (and (fn-pic-source-continuationp c *pic-test-stamped* *pic-sct-short-held*)
       (equal (fn-pic-get phase c) :source-incoming) (equal (fn-pic-get phase d) :source-held)
       (member-eq (fn-pic-get phase d) '(:source-incoming :source-held))
       (fn-pic-source-continuationp d *pic-test-stamped* *pic-sct-short-held*)
       (equal (fn-psc-model-retained-agent (fn-pic-parser c) *pic-test-stamped*) '(97 98 99))
       (equal (fn-psc-model-retained-agent (fn-pic-parser d) *pic-test-stamped*) '(97 98 99)))) :rule-classes nil)
(defthm pic-sct-actual-entry-positive
 (let* ((c *pic-ajt-before*) (d (mv-nth 1 (fn-pic-next c 1 *pic-test-stamped*))))
  (and (fn-pic-source-pair-contextp c *pic-test-stamped* *pic-spt-held*)
       (fn-pic-agent-tracep c *pic-ajt-ticks* *pic-test-stamped*)
       (equal (fn-pic-get phase d) :source-incoming)
       (fn-pic-source-continuationp d *pic-test-stamped* *pic-spt-held*))) :rule-classes nil)
(defthm pic-sct-pooled-entry-positive
 (let* ((c *pic-ajt-before*) (d (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*))))
  (and (fn-pic-source-pair-contextp c *pic-test-stamped* *pic-spt-held*)
       (fn-pic-agent-tracep c *pic-ajt-ticks* *pic-test-stamped*)
       (equal (fn-pic-get phase d) :source-incoming)
       (equal (fn-ioh-access (fn-ibc-carrier-row (fn-prp-incoming-slot *pic-sxt-pool*))
                             (fn-pic-get incoming-token c) :read) :holder-readonly)
       (fn-pic-source-continuationp d *pic-test-stamped* *pic-spt-held*))) :rule-classes nil)
(defthm pic-sct-entry-context-removal-corrupted-held-extent
 (let* ((c (fn-pic-set held-n 146 *pic-ajt-before*))
        (a (mv-nth 1 (fn-pic-next c 1 *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*))))
  (and (not (fn-pic-source-pair-contextp c *pic-test-stamped* *pic-spt-held*))
       (fn-pic-agent-tracep c *pic-ajt-ticks* *pic-test-stamped*)
       (equal (fn-pic-get phase a) :source-incoming) (equal (fn-pic-get phase d) :source-incoming)
       (not (fn-pic-source-continuationp a *pic-test-stamped* *pic-spt-held*))
       (not (fn-pic-source-continuationp d *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defthm pic-sct-entry-trace-removal-corrupted-span
 (let* ((p (fn-pic-parser *pic-ajt-before*))
        (c (fn-pic-set parser (fn-psc-set agent-start (+ 1 (fn-psc-get agent-start p)) p) *pic-ajt-before*))
        (a (mv-nth 1 (fn-pic-next c 1 *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*))))
  (and (fn-pic-source-pair-contextp c *pic-test-stamped* *pic-spt-held*)
       (not (fn-pic-agent-tracep c *pic-ajt-ticks* *pic-test-stamped*))
       (equal (fn-pic-get phase a) :source-incoming) (equal (fn-pic-get phase d) :source-incoming)
       (not (fn-pic-source-continuationp a *pic-test-stamped* *pic-spt-held*))
       (not (fn-pic-source-continuationp d *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defthm pic-sct-entry-phase-removal-pending
 (let* ((c *pic-ajt-start*) (a (mv-nth 1 (fn-pic-next c 1 *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*))))
  (and (fn-pic-source-pair-contextp c *pic-test-stamped* *pic-spt-held*)
       (fn-pic-agent-tracep c 0 *pic-test-stamped*)
       (not (equal (fn-pic-get phase a) :source-incoming)) (not (equal (fn-pic-get phase d) :source-incoming))
       (not (fn-pic-source-continuationp a *pic-test-stamped* *pic-spt-held*))
       (not (fn-pic-source-continuationp d *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defun pic-sct-pooled-byte-resumption-positive ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-page-read-pool
  (mv-let (ok fn-page-read-pool)
   (let* ((carrier (fn-ibc-carrier (list :input-backing 4 (len *pic-test-stamped*))
                                  (list *pic-test-incoming* :readonly '(0 0 0 0 1))))
          (fn-page-read-pool (update-fn-prp-incoming-slot carrier fn-page-read-pool)))
    (mv (with-local-stobj fn-octets
     (mv-let (ok fn-octets)
      (let* ((fn-octets (fn-octets-from-list *pic-test-stamped* fn-octets))
             (c (nth 1 (mv-list 3 (fn-pic-next *pic-ajt-entry* 1 fn-octets)))))
       (mv-let (status d left) (fn-pic-held-next c 2 fn-octets fn-page-read-pool)
        (mv (and (equal (fn-pic-at 0 (fn-pic-demand c)) :incoming)
                 (fn-pic-source-continuationp c *pic-test-stamped* *pic-spt-held*)
                 (equal status :continue) (equal left 0)
                 (member-eq (fn-pic-get phase d) '(:source-incoming :source-held))
                 (fn-pic-source-continuationp d *pic-test-stamped* *pic-spt-held*)
                 (not (equal c d))
                 (equal (fn-octets-list fn-octets) *pic-test-stamped*)
                 (equal (fn-prp-incoming-slot fn-page-read-pool) carrier)) fn-octets)))
      ok)) fn-page-read-pool))
   ok)))
(assert-event (pic-sct-pooled-byte-resumption-positive))

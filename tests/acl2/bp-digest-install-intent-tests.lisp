; Intent storage is not constructor or installed-family authority.
(in-package "ACL2")
(include-book "../../books/bp-digest-install-intent")
(defconst *bpdi-controller* '(:bp-controller 2 0))
(defconst *bpdi-job* '(:bp-job 7 (:bp-controller 2 0) 0 5))
(defconst *bpdi-token* (list :bp-digest 8 *bpdi-controller* *bpdi-job*))
(assert-event
 (let* ((source (list :bp-checkpoint-stage *bpdi-job* 5))
        (claim '(8192 4096 1 1 1))
        (intent (fn-bpdi-make *bpdi-token* :reserved source claim nil))
        (payload (fn-bpck-control-make '(:job-marker) '(:io-marker) nil '(:action-marker)))
        (next (fn-bpdi-with-intent payload intent)))
  (and (fn-bpdi-token-matches-jobp *bpdi-token* *bpdi-controller* *bpdi-job*)
       (equal (fn-bpdi-payload-intent next) intent)
       (equal (fn-bpdi-token intent) *bpdi-token*)
       (equal (fn-bpdi-phase intent) :reserved)
       (equal (fn-bpdi-source intent) source)
       (equal (fn-bpdi-claim intent) claim)
       (null (fn-bpdi-allowance intent))
       (equal (fn-bpck-control-job next) '(:job-marker))
       (equal (fn-bpck-control-io next) '(:io-marker))
       (equal (fn-bpck-control-action next) '(:action-marker)))))
(assert-event
 (and (not (fn-bpdi-token-matches-jobp *bpdi-token* '(:bp-controller 3 0) *bpdi-job*))
      (not (fn-bpdi-token-matches-jobp *bpdi-token* *bpdi-controller*
                                     '(:bp-job 9 (:bp-controller 2 0) 0 5)))
      (not (fn-bpdi-token-matches-jobp (append *bpdi-token* '(extra))
                                     *bpdi-controller* *bpdi-job*))
      (null (fn-bpdi-payload-intent '(:not-checkpoint nil nil nil nil)))))

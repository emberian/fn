; Native guarded whole-antecedent writer controls; per-hypothesis teeth follow.
(in-package "ACL2")
(include-book "lb-writer-binding-fixtures")
(defun fn-lbw-append-positive ()
 (declare (xargs :guard t))
 (with-local-stobj fn-arena
  (mv-let (ok fn-arena)
   (let* ((fn-arena (fn-lbw-arena-good fn-arena))
          (rows (fn-lbw-two-rows)) (row (fn-lbr13-held))
          (log (fn-lbw-two-log))
          (payload (fn-nntp-payload-bytes (fn-record-payload row) fn-arena)))
    (if (and (fn-cat$ap rows) (fn-cat-rowp row)
             (true-listp payload)
             (fn-lb-log-entries-guardp log)
             (fn-lb-log-append-guardp log)
             (fn-lb-value-treep (fn-lb-log-model-homes row)))
     (let ((after (fn-lb-log-model-append row payload 2 log)))
      (if (fn-lb-log-entries-guardp after)
       (mv (and (fn-cat$ap rows)
                (fn-lb-arena-is-log fn-arena rows log)
                (fn-lb-arena-is-log fn-arena rows after)) fn-arena)
       (mv nil fn-arena)))
     (mv nil fn-arena)))
   ok)))

(assert-event (fn-lbw-append-positive)
 :msg "A1 append: native guard-checked two live rows, full antecedent and conclusion")

(defun fn-lbw-withdraw-positive ()
 (declare (xargs :guard t))
 (with-local-stobj fn-arena
  (mv-let (ok fn-arena)
   (let* ((fn-arena (fn-lbw-arena-good fn-arena))
          (rows (fn-lbw-two-rows)) (log (fn-lbw-two-log)))
    (if (and (fn-cat$ap rows) (< 0 (len rows))
             (fn-lb-log-entries-guardp log))
     (mv (and (fn-lb-arena-is-log fn-arena rows log)
              (fn-lb-arena-is-log fn-arena (fn-cat$a-withdraw 0 1 rows) log)) fn-arena)
     (mv nil fn-arena)))
   ok)))

(assert-event (fn-lbw-withdraw-positive) :msg "A1 withdraw: native two-row binding preservation")


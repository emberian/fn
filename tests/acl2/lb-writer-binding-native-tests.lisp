(defun fn-lbw-commit-positive ()
 (declare (xargs :guard t))
 (with-local-stobj fn-arena
  (mv-let (ok fn-arena)
   (let* ((fn-arena (fn-lbw-arena-good fn-arena))
          (rows (fn-lbw-two-rows)) (h (fn-lbw-incoming-held))
          (log (fn-lbw-two-log)) (row (fn-cat-assign h rows)))
    (if (and (fn-cat$ap rows) (fn-held-p h)
             (fn-cat-rowp row)
             (fn-lb-log-entries-guardp log)
             (fn-lb-log-append-guardp log)
             (fn-lb-value-treep (fn-lb-log-model-homes row)))
     (let* ((before-p (fn-arena-p fn-arena))
            (bound (fn-lb-arena-is-log fn-arena rows log))
            (below (fn-scol-handles-below rows (fn-arena-count fn-arena)))
            (allocated (equal (fn-record-payload h) (fn-arena-count fn-arena)))
            (fresh (not (fn-lb-log-model-row-entry h log)))
            (fn-arena (fn-arena-seal-list *fn-lbw-payload-b* fn-arena))
            (after-log (fn-lb-log-model-append row *fn-lbw-payload-b* 2 log)))
      (if (fn-lb-log-entries-guardp after-log)
       (mv (and before-p bound below allocated fresh
                (fn-lb-arena-is-log fn-arena (fn-cat$a-commit h rows) after-log))
           fn-arena)
       (mv nil fn-arena)))
     (mv nil fn-arena)))
   ok)))

(assert-event (fn-lbw-commit-positive) :msg "A1 commit: native full antecedent, fresh seal and matching log append")

(defun fn-lbw-reclaim-positive ()
 (declare (xargs :guard t))
 (with-local-stobj fn-arena
  (mv-let (ok fn-arena)
   (with-local-stobj fn-cat
    (mv-let (ok fn-arena fn-cat)
     (let* ((fn-arena (fn-lbw-arena-good fn-arena))
            (rows (fn-lbw-reclaim-input)) (log (fn-lbw-two-log))
            (base (fn-arena-count fn-arena))
            (kept (fn-lb-open-held-rows rows))
            (prediction (fn-orcs-predict rows nil base)))
      (if (and (fn-lb-log-entries-guardp log)
               (fn-lb-reclaim-records-guardp rows nil base)
               (fn-lb-log-append-guardp log)
               (fn-orcs-payload-listp (cadr prediction))
               (fn-sca-held-rowsp (car prediction)))
       (let* ((arena-p (fn-arena-p fn-arena))
              (allocation (fn-lb-log-handles-below log base))
              (binding (fn-lb-arena-is-log fn-arena kept log))
              (handles (fn-scol-handles-below kept base))
              (no-bad (not (fn-orcs-has-bad rows)))
              (after-log (fn-lb-log-model-reclaim-events rows nil base 2 log))
              ; Availability is loaded using the same pre-swap arena as the host.
              (fn-cat (fn-sca-load-held-rows (car prediction) nil fn-arena fn-cat))
              (fn-arena (fn-orcs-seal (cadr prediction) fn-arena)))
        (if (and (equal (fn-cat-count fn-cat) 2)
                 (fn-lb-log-entries-guardp after-log))
         (mv (and arena-p allocation binding handles no-bad
                  (equal (fn-arena-count fn-arena) 3)
                  (fn-lb-arena-is-log fn-arena
                   (list (fn-cat-at 0 fn-cat) (fn-cat-at 1 fn-cat)) after-log))
             fn-arena fn-cat)
         (mv nil fn-arena fn-cat)))
       (mv nil fn-arena fn-cat)))
     (mv ok fn-arena)))
   ok)))
(assert-event (fn-lbw-reclaim-positive)
 :msg "A1 reclaim: native full antecedent, one tombstone seal, one retained live row and matching LOG")

 (equal (pgs-root-slots :lc nil) nil)
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
  '((:executable-counterpart pgs-root-slots)))))))

(defthm lcu-unlink-payload-shadow-refutes-keystone
 (let* ((rows (list (lct-held 0)))
        (fresh (nth 0 (lcu-input))) (segs (nth 1 (lcu-input)))
        (fn-lbc (fn-lbc-open-rebuild rows fresh (create-fn-lbc)))
        ; Logical constructor expression only: no local FN-ARENA is created.
        (fn-arena (fn-arena-seal-list *lct-payload* (create-fn-arena)))
        (out (fn-lc-unlink 1 nil :lc nil 2 segs '(:ok :ok) fn-lbc)))
  (and (fn-lbc-p fn-lbc) (fn-cat$ap rows) (fn-arena-p fn-arena)
       (fn-lbc-corr fn-lbc rows segs)
       (fn-lc-locators-resolve fn-lbc segs)
       (fn-lb-arena-is-log fn-arena rows segs)
       (not (fn-lc-any-row-names-segment 1 fn-lbc))
       (fn-lc-unlink-allowedp 1 nil :lc nil 2)
       ; The pending directory-count conjunct already holds at this input.
       (equal (len (nth *fn-lbc-directory-store* fn-lbc)) (fn-lbc-count fn-lbc))
       (equal (fn-lbc-count fn-lbc) 1)
       (equal (mv-nth 0 out) :ok)
       (not (fn-lb-arena-is-log fn-arena rows (mv-nth 3 out)))
       (not (fn-lbc-corr (mv-nth 1 out) rows (mv-nth 3 out)))
       (not (fn-lc-locators-resolve (mv-nth 1 out) (mv-nth 3 out)))))
 :rule-classes nil
 :hints (("Goal" :expand ((:free (i fn-lbc) (fn-lbc-escape-cellsp i fn-lbc))

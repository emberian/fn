; Candidate refutation of the frozen unlink/arena statement. Two retained
; copies have the same original sequence and handle. Current LOC0 names 2.
; Only copy 2's typed semantic PAYLOAD observation differs from its bytes.
(in-package "ACL2")
(include-book "lc-bounded-check-tests")
(include-book "../../books/log-cleaning-complete")
(include-book "../../books/log-cleaning-unlink")

(defun lcu-input ()
 (declare (xargs :guard t))
 (let* ((h (ec-call (lct-held 0)))
        (old (ec-call (fn-lb-log-model-append h *lct-payload* 1 nil)))
        (fresh (ec-call (fn-lb-log-model-append h *lct-payload* 2 nil)))
        (segment (fn-lc-head fresh))
        (entry (fn-lc-head (fn-lc-at 2 segment)))
        (bad (ec-call (update-nth 6 '(99) entry)))
        (segs (fn-lc-join old (list (list 2 (fn-lc-at 1 segment) (list bad))))))
  (list fresh segs)))
(defun lcu-control (fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc)))
 (let* ((input (lcu-input)) (fresh (fn-lc-at 0 input)) (segs (fn-lc-at 1 input))
        (h (ec-call (lct-held 0)))
        (fn-lbc (ec-call (fn-lbc-open-rebuild (list h) fresh fn-lbc)))
        (rowcorr (ec-call (fn-lbc-row-corr 0 h 5 fn-lbc segs)))
        (resolves (ec-call (fn-lc-locators-resolve fn-lbc segs)))
        (names (fn-lc-any-row-names-segment 1 fn-lbc))
        (allowed (ec-call (fn-lc-unlink-allowedp 1 nil :lc nil 2)))
        (directory-count
         (stobj-let ((fn-lbc-directory (fn-lbc-directory-store fn-lbc)))
          (n) (fn-lbc-directory-count fn-lbc-directory) n))
        (before-payload (ec-call (fn-lb-log-payload h segs))))
  (mv-let (answer fn-lbc afterdisk aftersegs trace)
   (fn-lc-unlink 1 nil :lc nil 2 segs '(:ok :ok) fn-lbc)
   (declare (ignore afterdisk trace))
   (mv (list (fn-lc-segsp segs) rowcorr resolves (not names) allowed
          (fn-lbc-count fn-lbc) directory-count
          (fn-lbc-word :loc0 0 fn-lbc) answer
          (equal before-payload *lct-payload*)
          (ec-call (fn-lb-log-payload h aftersegs))
          (ec-call (fn-lc-locators-resolve fn-lbc aftersegs))) fn-lbc))))
(defun lcu-control-fixture ()
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-lbc
  (mv-let (out fn-lbc) (lcu-control fn-lbc) out)))
(verify-guards lcu-control-fixture)
(assert-event
 (equal (lcu-control-fixture) '(t t t t t 1 1 2 :ok t (99) nil)))


(local (defun lcu-disable-state-execution (runes)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp runes)
  (let* ((r (car runes)) (sym (cadr r))
         (name (if (symbolp sym) (symbol-name sym) "")))
   (if (and (equal (car r) :executable-counterpart)
            (or (equal (subseq name 0 (min 7 (length name))) "FN-LBC-")
                (equal (subseq name 0 (min 8 (length name))) "FN-DMAP-")
                (equal (subseq name 0 (min 6 (length name))) "FN-LC-")
                (equal (subseq name 0 (min 9 (length name))) "FN-ARENA-")
                (equal sym 'create-fn-arena)
                (equal sym 'create-fn-lbc)))
       (cons r (lcu-disable-state-execution (cdr runes)))
     (lcu-disable-state-execution (cdr runes)))) nil)))

(local (defun lcu-enable-state-definitions (runes)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp runes)
  (let* ((r (car runes)) (sym (cadr r))
         (name (if (symbolp sym) (symbol-name sym) "")))
   (if (and (equal (car r) :definition)
            (or (equal (subseq name 0 (min 7 (length name))) "FN-LBC-")
                (equal (subseq name 0 (min 8 (length name))) "FN-DMAP-")
                (equal (subseq name 0 (min 6 (length name))) "FN-LC-")
                (equal (subseq name 0 (min 9 (length name))) "FN-ARENA-")
                (equal sym 'create-fn-arena)
                (equal sym 'create-fn-lbc)))
       (cons r (lcu-enable-state-definitions (cdr runes)))
     (lcu-enable-state-definitions (cdr runes)))) nil)))


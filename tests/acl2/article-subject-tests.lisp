; PRF-1058: nonempty exact-byte projection witnesses and affirmative
; hypothesis-removal counterexamples. Digest comparisons use attached BLAKE3;
; no cryptographic injectivity is claimed.
(in-package "ACL2")
(include-book "../../books/article-subject")
(include-book "../../books/crypto-attach")
(include-book "must-fail-checked")
(defconst *asjt-base* '(70 114 111 109 58 32 97 64 101 120 97 109 112 108 101 46 105 110 118 97 108 105 100 13 10 83 117 98 106 101 99 116 58 32 101 120 97 99 116 32 112 114 111 116 101 99 116 101 100 32 98 121 116 101 115 13 10 32 102 111 108 100 101 100 32 112 114 111 116 101 99 116 101 100 32 99 111 110 116 105 110 117 97 116 105 111 110 13 10 78 101 119 115 103 114 111 117 112 115 58 32 102 110 46 116 101 115 116 13 10 77 101 115 115 97 103 101 45 73 68 58 32 60 114 101 108 97 121 64 97 114 116 105 99 108 101 46 105 110 118 97 108 105 100 62 13 10 13 10 98 111 100 121 13 10 80 97 116 104 58 32 98 111 100 121 32 116 101 120 116 32 105 115 32 112 114 111 116 101 99 116 101 100 13 10))
(defconst *asjt-trace* '(112 65 116 72 58 32 111 108 100 33 110 111 116 45 102 111 114 45 109 97 105 108 13 10 32 102 111 108 100 101 100 45 112 97 116 104 13 10 88 82 69 70 58 32 111 108 100 32 102 110 46 116 101 115 116 58 55 13 10 9 102 111 108 100 101 100 45 120 114 101 102 13 10))
(defconst *asjt-path* '(80 97 116 104 58 32 97 110 111 116 104 101 114 33 110 111 116 45 102 111 114 45 109 97 105 108 13 10))
(defconst *asjt-xref* '(88 114 101 102 58 32 116 104 105 114 100 32 102 110 46 116 101 115 116 58 49 57 13 10 32 102 111 108 100 101 100 45 120 114 101 102 13 10))
(defconst *asjt-body-change* '(70 114 111 109 58 32 97 64 101 120 97 109 112 108 101 46 105 110 118 97 108 105 100 13 10 83 117 98 106 101 99 116 58 32 101 120 97 99 116 32 112 114 111 116 101 99 116 101 100 32 98 121 116 101 115 13 10 32 102 111 108 100 101 100 32 112 114 111 116 101 99 116 101 100 32 99 111 110 116 105 110 117 97 116 105 111 110 13 10 78 101 119 115 103 114 111 117 112 115 58 32 102 110 46 116 101 115 116 13 10 77 101 115 115 97 103 101 45 73 68 58 32 60 114 101 108 97 121 64 97 114 116 105 99 108 101 46 105 110 118 97 108 105 100 62 13 10 13 10 66 111 100 121 13 10 80 97 116 104 58 32 98 111 100 121 32 116 101 120 116 32 105 115 32 112 114 111 116 101 99 116 101 100 13 10))
(defconst *asjt-header-change* '(70 114 111 109 58 32 97 64 101 120 97 109 112 108 101 46 105 110 118 97 108 105 100 13 10 83 117 98 106 101 99 116 58 32 69 120 97 99 116 32 112 114 111 116 101 99 116 101 100 32 98 121 116 101 115 13 10 32 102 111 108 100 101 100 32 112 114 111 116 101 99 116 101 100 32 99 111 110 116 105 110 117 97 116 105 111 110 13 10 78 101 119 115 103 114 111 117 112 115 58 32 102 110 46 116 101 115 116 13 10 77 101 115 115 97 103 101 45 73 68 58 32 60 114 101 108 97 121 64 97 114 116 105 99 108 101 46 105 110 118 97 108 105 100 62 13 10 13 10 98 111 100 121 13 10 80 97 116 104 58 32 98 111 100 121 32 116 101 120 116 32 105 115 32 112 114 111 116 101 99 116 101 100 13 10))
(defconst *asjt-continuation* '(32 102 111 108 100 101 100 32 112 114 111 116 101 99 116 101 100 13 10 13 10 98 111 100 121 13 10))
(defconst *asjt-not-trace* '(83 117 98 106 101 99 116 58 32 99 104 97 110 103 101 100 13 10))
(defconst *asjt-block* '(80 97 116 104 58 32 102 105 114 115 116 33 110 111 116 45 102 111 114 45 109 97 105 108 13 10 32 102 111 108 100 101 100 45 112 97 116 104 13 10))
(defconst *asjt-wire* (append *asjt-trace* *asjt-base*))
(defconst *asjt-steps* (list (list 0 *asjt-path*) (list 2 *asjt-xref*)))
(defconst *asjt-other* (fn-asj-insert-all *asjt-base* *asjt-steps*))
(assert-event (and (consp *asjt-base*) (true-listp *asjt-wire*)
                  (equal (fn-asj-project *asjt-wire*) *asjt-base*)
                  (fn-asj-subsequencep (fn-pu-strip *asjt-wire* nil) *asjt-wire*)
                  (equal (fn-asj-body (fn-pu-strip *asjt-wire* nil)) (fn-asj-body *asjt-wire*))))
; Complete antecedent/conclusion: finite permitted transform, including the
; original's removal and insertion of folded fields at several boundaries.
(assert-event (and (fn-asj-permitted-relay-transformp *asjt-wire* *asjt-other* *asjt-steps*)
                  (equal (fn-asj-project *asjt-wire*) (fn-asj-project *asjt-other*))
                  (equal (fn-asj-body *asjt-wire*) (fn-asj-body *asjt-other*))))
(assert-event (and (equal (fn-asj-project *asjt-wire*) (fn-asj-project *asjt-other*))
                  (equal (fn-asj-body *asjt-wire*) (fn-asj-body *asjt-other*))
                  (equal (fn-asj-subject *asjt-wire*) (fn-asj-subject *asjt-other*))
                  (not (equal (fn-id-subject-of-payload *asjt-wire*)
                              (fn-id-subject-of-payload *asjt-other*)))))
(assert-event (equal (fn-asj-project (fn-asj-project *asjt-wire*)) (fn-asj-project *asjt-wire*)))
(assert-event (equal (fn-asj-project (fn-pu-relay-article *asjt-wire* '(110 111 100 101) '(111 108 100)))
                     (fn-asj-project *asjt-wire*)))
; Changed body/header bytes are outside the permitted transform.
(assert-event (and (not (equal (fn-asj-project *asjt-wire*) (fn-asj-project *asjt-body-change*)))
                  (not (equal (fn-asj-project *asjt-wire*) (fn-asj-project *asjt-header-change*)))
                  (not (fn-asj-permitted-relay-transformp *asjt-wire* *asjt-body-change* nil))
                  (not (fn-asj-permitted-relay-transformp *asjt-wire* *asjt-header-change* nil))))
; Remove only the trace-block hypothesis: valid boundary retained, invalid
; block affirmatively observed, complete conclusion false.
(assert-event (and (fn-asj-insertion-boundaryp *asjt-base* 0)
                  (not (fn-asj-trace-blockp *asjt-not-trace*))
                  (not (equal (fn-asj-project (fn-asj-insert-at *asjt-base* 0 *asjt-not-trace*))
                              (fn-asj-project *asjt-base*)))))
; Remove only boundary: valid folded trace block retained; insertion before
; a kept continuation would absorb that continuation into the removed block.
(assert-event (and (fn-asj-trace-blockp *asjt-block*)
                  (not (fn-asj-insertion-boundaryp *asjt-continuation* 0))
                  (not (equal (fn-asj-project (fn-asj-insert-at *asjt-continuation* 0 *asjt-block*))
                              (fn-asj-project *asjt-continuation*)))))
(assert-event (and (fn-asj-trace-blockp *asjt-block*)
                  (fn-asj-insertion-boundaryp *asjt-base* 3)
                  (equal (fn-asj-project (fn-asj-insert-at *asjt-base* 3 *asjt-block*))
                         (fn-asj-project *asjt-base*))))
; Remove the proper-list hypothesis from byte order: corrupted model value.
(assert-event (and (not (true-listp 7))
                  (not (fn-asj-subsequencep (fn-pu-strip 7 nil) 7))))
(must-fail-checked (assert-event (equal (fn-asj-project *asjt-wire*) (fn-asj-project *asjt-body-change*))))
(must-fail-checked (assert-event (equal (fn-asj-project *asjt-wire*) (fn-asj-project *asjt-header-change*))))
(must-fail-checked (assert-event (equal (fn-asj-project (fn-asj-insert-at *asjt-continuation* 0 *asjt-block*))
                                     (fn-asj-project *asjt-continuation*))))

(in-package "ACL2")
(include-book "../../books/receiver-capacity-current")
; Unfunded control storage fixture: supplied demand exercises internal issue
; algebra, not constructor adequacy or a sanctioned native installation.
(defun fn-rxcc-test-sequence (fn-rx-capacity-current)
  (declare (xargs :stobjs fn-rx-capacity-current :guard t))
  (let ((initial (fn-prl-build '(1000000 0 0 0 100) '(0 0 0 0 0) 7
                             '((:borrowed . :bindings)) '(1000 0 0 0 0))))
    (mv-let (word token ledger1 fn-rx-capacity-current)
      (fn-rxcc-reserve 3 '(8192 0 0 0 1) initial fn-rx-capacity-current)
      (let ((issued (and (eq word :admitted)
                         (equal token '(:rx-capacity 7 3 4096))
                         (equal (fn-prl-nth 2 ledger1) 8)
                         (equal (fn-prl-nth 1 ledger1) '(8192 0 0 0 1))
                         (equal (fn-prl-nth 3 ledger1) (fn-prl-nth 3 initial))
                         (eq (fn-rxcc-phase fn-rx-capacity-current) :reserved))))
        (mv-let (begin fn-rx-capacity-current)
          (fn-rxcc-allocation-begin token fn-rx-capacity-current)
          (let ((allocating (and (eq begin :allocate)
                                 (eq (fn-rxcc-phase fn-rx-capacity-current) :allocating))))
            (mv-let (repeat fn-rx-capacity-current)
              (fn-rxcc-allocation-begin token fn-rx-capacity-current)
              (mv-let (install ledger2 fn-rx-capacity-current)
                (fn-rxcc-install-prepare token ledger1 fn-rx-capacity-current)
                (let ((promoting (and (eq install :install-pool)
                                      (eq (fn-rxcc-phase fn-rx-capacity-current) :promoting)
                                      (equal (fn-prl-nth 1 ledger2) '(0 0 0 0 1))
                                      (equal (fn-prl-baseline ledger2) '(9192 0 0 0 0))
                                      (equal (fn-prl-nth 2 ledger2) 8)
                                      (equal (fn-prl-nth 3 ledger2) (fn-prl-nth 3 initial))
                                      (equal (fn-iqr-resident-total ledger2)
                                             (fn-iqr-resident-total ledger1)))))
                  (mv-let (again ledger3 fn-rx-capacity-current)
                    (fn-rxcc-install-prepare token ledger2 fn-rx-capacity-current)
                    (mv-let (published fn-rx-capacity-current)
                      (fn-rxcc-installed-publish token fn-rx-capacity-current)
                      (let ((installed (and (eq published :installed)
                                            (eq (fn-rxcc-phase fn-rx-capacity-current) :installed)
                                            (equal (fn-rxcc-claim fn-rx-capacity-current) '(0 0 0 0 1)))))
                        (mv-let (busy ignored ledger4 fn-rx-capacity-current)
                          (fn-rxcc-reserve 4 '(8192 0 0 0 1) ledger3 fn-rx-capacity-current)
                          (declare (ignore ignored))
                          (mv (and issued allocating promoting installed
                                   (eq repeat :stale-capacity)
                                   (eq again :stale-capacity)
                                   (equal ledger3 ledger2)
                                   (eq busy :receiver-capacity-busy)
                                   (equal ledger4 ledger2))
                              fn-rx-capacity-current))))))))))))))
(defun fn-rxcc-test-sequence-local ()
  (declare (xargs :guard t))
  (with-local-stobj fn-rx-capacity-current
    (mv-let (answer fn-rx-capacity-current)
      (fn-rxcc-test-sequence fn-rx-capacity-current)
      answer)))
(assert-event (fn-rxcc-test-sequence-local))
; Mutation witness: a different, well-formed issuer nonce cannot begin work
; against the actual retained reserved row.
(defun fn-rxcc-test-foreign (fn-rx-capacity-current)
  (declare (xargs :stobjs fn-rx-capacity-current :guard t))
  (let ((initial (fn-prl-build '(1000000 0 0 0 100) '(0 0 0 0 0) 7
                             nil '(1000 0 0 0 0))))
    (mv-let (word token ledger fn-rx-capacity-current)
      (fn-rxcc-reserve 3 '(8192 0 0 0 1) initial fn-rx-capacity-current)
      (declare (ignore ledger))
      (let* ((foreign '(:rx-capacity 8 3 4096))
             (antecedent (and (eq word :admitted) (fn-rxcc-capacity-tokenp foreign)
                              (not (fn-rxcc-exactp foreign fn-rx-capacity-current))
                              (eq (fn-rxcc-phase fn-rx-capacity-current) :reserved))))
        (mv-let (refusal fn-rx-capacity-current)
          (fn-rxcc-allocation-begin foreign fn-rx-capacity-current)
          (mv (and antecedent (eq refusal :stale-capacity)
                   (equal (fn-rxcc-token fn-rx-capacity-current) token)
                   (equal (fn-rxcc-claim fn-rx-capacity-current) '(8192 0 0 0 1))
                   (equal (fn-rxcc-instance fn-rx-capacity-current) 3)
                   (eq (fn-rxcc-phase fn-rx-capacity-current) :reserved))
              fn-rx-capacity-current))))))
(defun fn-rxcc-test-foreign-local ()
  (declare (xargs :guard t))
  (with-local-stobj fn-rx-capacity-current
    (mv-let (answer fn-rx-capacity-current)
      (fn-rxcc-test-foreign fn-rx-capacity-current)
      answer)))
(assert-event (fn-rxcc-test-foreign-local))

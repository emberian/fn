(defun fn-lbcct-double-section (i kind fn-lbc log)
 (declare (xargs :stobjs fn-lbc
  :guard (and (natp i) (< i (fn-lbc-count fn-lbc))
              (fn-lb-log-read-guardp log) (alistp (fn-lbc-escape-store-get i fn-lbc)))
  :verify-guards nil))
 (list (fn-lbc-stored-range i kind fn-lbc log)
       (fn-lbc-stored-range i kind fn-lbc log)))
(def-cost fn-lbcct-double-section
 :unaccounted (fn-lb-log-model-read-range fn-lbc-directory-value fn-lbc-flag fn-lbc-value fn-nntp-stuffed-section)
 :calls ((range-requests (fn-lb-log-model-read-range) :stop-at (fn-lb-entry-octets))))
(defthm fn-lbcct-head-bound-whole-witness
 (<= (fn-lbc-stored-range-range-requests 0 :head (fn-lbcc-test-one-state)
       (fn-lb-log-model-append (fn-lbcc-test-decided-row) *fn-lbr13-payload* 1 nil)) 1)
 :rule-classes nil
 :hints (("Goal" :use fn-lbcc-test-head-positive :in-theory (theory 'ground-zero))))
(defthm fn-lbcct-double-section-fault-witness
 (not (<= (fn-lbcct-double-section-range-requests 0 :head (fn-lbcc-test-one-state)
            (fn-lb-log-model-append (fn-lbcc-test-decided-row) *fn-lbr13-payload* 1 nil)) 1))
 :rule-classes nil
 :hints (("Goal" :use fn-lbcc-test-head-positive
  :in-theory (union-theories (theory 'ground-zero) '(fn-lbcct-double-section-range-requests)))))
(defthm fn-lbcct-double-section-whole-fault-witness
 (and (<= (fn-lbc-stored-range-range-requests 0 :head (fn-lbcc-test-one-state)
       (fn-lb-log-model-append (fn-lbcc-test-decided-row) *fn-lbr13-payload* 1 nil)) 1)
      (not (<= (fn-lbcct-double-section-range-requests 0 :head (fn-lbcc-test-one-state)
       (fn-lb-log-model-append (fn-lbcc-test-decided-row) *fn-lbr13-payload* 1 nil)) 1)))
 :rule-classes nil
 :hints (("Goal" :use (fn-lbcct-head-bound-whole-witness fn-lbcct-double-section-fault-witness)
  :in-theory (theory 'ground-zero))))
(defteeth fn-lbc-stored-range-at-most-one-request
 :claim (nil (<= (fn-lbc-stored-range-range-requests i kind fn-lbc-v log) 1))
 :subject fn-lbc-stored-range
 :witness ((i 0) (kind :head) (fn-lbc-v (fn-lbcc-test-one-state))
           (log (fn-lb-log-model-append (fn-lbcc-test-decided-row) *fn-lbr13-payload* 1 nil)))
 :witness-lemma fn-lbcct-head-bound-whole-witness
 :breaks ()
 :mutations ((duplicate-section-read
   (:conclusion (<= (fn-lbcct-double-section-range-requests i kind fn-lbc-v log) 1))
   ((i 0) (kind :head) (fn-lbc-v (fn-lbcc-test-one-state))
    (log (fn-lb-log-model-append (fn-lbcc-test-decided-row) *fn-lbr13-payload* 1 nil)))
   :fault "the section worker issues its actual range request twice"
   :lemma fn-lbcct-double-section-whole-fault-witness)))
(defun fn-lbcct-native-head-control ()
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-lbc
  (mv-let (ok fn-lbc)
   (let* ((row (fn-lbcc-test-decided-row))
          (log (fn-lb-log-model-append row *fn-lbr13-payload* 1 nil))
          (fn-lbc (fn-lbc-open-rebuild (list row) log fn-lbc)))
    (mv (and (equal (fn-lbc-count fn-lbc) 1)
             (equal (fn-lbc-command-row "fn.test" 1 1 fn-lbc) 0)
             (equal (fn-lbc-stored-range 0 :head fn-lbc log)
                    '(83 117 98 106 101 99 116 58 32 97 13 10)))
        fn-lbc))
   ok)))
(with-guard-checking-event t (assert-event (fn-lbcct-native-head-control)))

(with-guard-checking-event t
 (assert-event (equal (fn-lbcc-test-decided-row)
  (car (fn-cat$a-commit (fn-held-with-numbers (fn-lbcc-test-decided-row) nil) nil)))))

(defun fn-lbcct-directory-only-candidate (group number v fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-escape-cellsp 0 fn-lbc) :verify-guards nil))
 (let ((i (fn-lbc-number-get group number fn-lbc)))
  (and (posp number) (<= number *fn-nntp-max-article-number*)
       (natp i) (< i (fn-lbc-count fn-lbc)) (fn-lbc-visiblep i v fn-lbc)
       (fn-ag-less 0 (fn-lbc-directory-value i :nov-length fn-lbc))
       (not (fn-lbc-flag i *fn-lbc-nov-tomb-bit* fn-lbc))
       (fn-nntp-article-idp (fn-lbc-id-article i fn-lbc)) i)))
(defun fn-lbcct-native-escaped-nov-control ()
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-lbc
  (mv-let (ok fn-lbc)
   (let* ((row (fn-lbcc-test-decided-row)) (nov (fn-hf-nov (fn-held-facts row)))
          (log (fn-lb-log-model-append row *fn-lbr13-payload* 1 nil))
          (fn-lbc (fn-lbc-open-rebuild (list row) log fn-lbc))
          (fn-lbc (fn-lbc-escape-store-put 0
                    (acons :nov nov (fn-lbc-escape-store-get 0 fn-lbc)) fn-lbc))
          (fn-lbc (stobj-let ((fn-lbc-directory (fn-lbc-directory-store fn-lbc)))
                    (fn-lbc-directory)
                    (fn-lbc-directory-set-nov-length 0 0 fn-lbc-directory) fn-lbc)))
    (mv (and (equal (fn-lbc-original-nov 0 fn-lbc) nov)
             (null (fn-lbcct-directory-only-candidate "fn.test" 1 1 fn-lbc))
             (equal (fn-lbc-command-row "fn.test" 1 1 fn-lbc) 0)) fn-lbc))
   ok)))
(with-guard-checking-event t (assert-event (fn-lbcct-native-escaped-nov-control)))


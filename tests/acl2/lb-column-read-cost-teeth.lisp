(defun fn-lbcct-withdrawn-rows ()
 (declare (xargs :guard t :verify-guards nil))
 (fn-cat$a-commit (fn-lbcct-second-decided-incoming)
  (fn-cat$a-withdraw 0 1 (list (fn-lbcc-test-decided-row)))))
(defun fn-lbcct-native-withdrawn-pinned-control ()
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-lbc
  (mv-let (ok fn-lbc)
   (let* ((rows (fn-lbcct-withdrawn-rows))
          (log (fn-lb-log-model-append (cadr rows) *fn-lbw-payload-b* 1
                (fn-lb-log-model-append (car rows) *fn-lbr13-payload* 1 nil)))
          (fn-lbc (fn-lbc-open-rebuild rows log fn-lbc)))
    (mv (and (equal (fn-lbc-listgroup-numbers "fn.test" 2 1 2 fn-lbc) '(1 2))
             (equal (fn-lbc-listgroup "fn.test" 2 1 2 fn-lbc) '(2))
             (equal (fn-lbc-listgroup "fn.test" 1 1 2 fn-lbc) '(1))
             (equal (len (fn-lbc-over "fn.test" 2 1 2 fn-lbc)) 1)
             (equal (fn-lbc-group-live "fn.test" fn-lbc) '(1 2 2 3))) fn-lbc))
   ok)))
(with-guard-checking-event t (assert-event (fn-lbcct-native-withdrawn-pinned-control)))

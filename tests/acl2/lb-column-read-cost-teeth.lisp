      (equal (fn-lbc-count (fn-lbcc-test-one-state)) 1)
      (equal (fn-loc-segment (fn-lbc-loc0 0 (fn-lbcc-test-one-state)) (fn-lbc-loc1 0 (fn-lbcc-test-one-state))) 1)
      (equal (fn-loc-offset (fn-lbc-loc0 0 (fn-lbcc-test-one-state)) (fn-lbc-loc1 0 (fn-lbcc-test-one-state))) 6)
      (equal (fn-lbc-stored-range-range-requests 0 :head (fn-lbcc-test-one-state)
        (fn-lb-log-model-append (fn-lbcc-test-decided-row) *fn-lbr13-payload* 1 nil)) 1)
      (equal (fn-loc-len (fn-lbc-loc0 0 (fn-lbcc-test-one-state)) (fn-lbc-loc1 0 (fn-lbcc-test-one-state))) 17)

; Reclaim over the actual predictor, old-arena availability load, deferred seal and log MOVE fold.
(in-package "ACL2")
(include-book "lb-catalog-binding-observation")
(include-book "lb-writer-binding-teeth")
(defun fn-lbwr-reclaim-arena (mode fn-arena)
 (declare (xargs :stobjs fn-arena :guard t))
 (if (equal mode :bad-retained)
  (let* ((fn-arena (fn-arena-clear fn-arena))
         (fn-arena (fn-arena-seal-list *fn-lbr13-payload* fn-arena)))
    (fn-arena-seal-list *fn-lbr13-payload* fn-arena))
  (fn-lbw-arena-good fn-arena)))
(defun fn-lbwr-future-reclaim-input ()
 (declare (xargs :guard t :verify-guards nil))
 (list (fn-lbw-tombstone-record) (update-nth 4 2 (fn-lbw-second-held))))
(defun fn-lbwr-stale-tombstone-log ()
 (declare (xargs :guard t :verify-guards nil))
 (fn-lb-log-model-append (update-nth 4 2 (fn-lbr13-held)) *fn-lbr13-payload* 1 (fn-lbw-two-log)))
(defun fn-lbwr-reclaim-scalar (rows id view-index target log fn-arena fn-cat)
 (declare (xargs :stobjs (fn-arena fn-cat) :verify-guards nil))
 (let* ((base (fn-arena-count fn-arena))
        (prediction (fn-orcs-predict rows id base))
        (post-log (fn-lb-log-model-reclaim-events rows id base target log))
        (fn-cat (fn-sca-load-held-rows (car prediction) view-index fn-arena fn-cat))
        (fn-arena (fn-orcs-seal (cadr prediction) fn-arena)))
  (mv (not (fn-lbw-unbound-catalog-rows 0 fn-arena fn-cat post-log)) fn-arena fn-cat)))
(defun fn-lbwr-reclaim-missing-move-scalar (rows id view-index log fn-arena fn-cat)
 (declare (xargs :stobjs (fn-arena fn-cat) :verify-guards nil))
 (let* ((base (fn-arena-count fn-arena))
        (prediction (fn-orcs-predict rows id base))
        (fn-cat (fn-sca-load-held-rows (car prediction) view-index fn-arena fn-cat))
        (fn-arena (fn-orcs-seal (cadr prediction) fn-arena)))
  (mv (not (fn-lbw-unbound-catalog-rows 0 fn-arena fn-cat log)) fn-arena fn-cat)))

(defteeth fn-lb-arena-is-log-of-reclaim
 :claim (((allocated-log (fn-lb-log-handles-below log (fn-arena-count fn-arena))) (binding (fn-lb-arena-is-log fn-arena (fn-lb-open-held-rows rows) log)) (old-handles (fn-scol-handles-below (fn-lb-open-held-rows rows) (fn-arena-count fn-arena)))) (let* ((base (fn-arena-count fn-arena))
        (prediction (fn-orcs-predict rows id base))
        (post-arena (fn-orcs-seal (cadr prediction) fn-arena))
        (post-log (fn-lb-log-model-reclaim-events rows id base target log)))
  (fn-lb-arena-is-log post-arena
   (fn-sca-load-held-rows (car prediction) view-index fn-arena fn-cat)
   post-log)))
 :subject fn-orcs-seal
 :witness ((arena-mode :good) (rows (fn-lbw-reclaim-input)) (id nil) (view-index nil)
           (target 2) (log (fn-lbw-two-log)))
 :stobjs ((fn-arena (fn-lbwr-reclaim-arena arena-mode fn-arena)) (fn-cat (fn-cat-clear fn-cat)))
 :stobj-checks
 (((let* ((base (fn-arena-count fn-arena))
        (prediction (fn-orcs-predict rows id base))
        (post-arena (fn-orcs-seal (cadr prediction) fn-arena))
        (post-log (fn-lb-log-model-reclaim-events rows id base target log)))
  (fn-lb-arena-is-log post-arena
   (fn-sca-load-held-rows (car prediction) view-index fn-arena fn-cat)
   post-log))
   (fn-lbwr-reclaim-scalar rows id view-index target log fn-arena fn-cat)
   :hints (("Goal" :in-theory (union-theories (theory 'ground-zero)
    '(fn-lbwr-reclaim-scalar fn-lbw-native-catalog-binding-is-model
      fn-lbw-unbound-catalog-rows-iff-not-binding nthcdr)))))
  ((let* ((base (fn-arena-count fn-arena))
        (prediction (fn-orcs-predict rows id base))
        (post-arena (fn-orcs-seal (cadr prediction) fn-arena))
        (post-log log))
  (fn-lb-arena-is-log post-arena
   (fn-sca-load-held-rows (car prediction) view-index fn-arena fn-cat)
   post-log))
   (fn-lbwr-reclaim-missing-move-scalar rows id view-index log fn-arena fn-cat)
   :hints (("Goal" :in-theory (union-theories (theory 'ground-zero)
    '(fn-lbwr-reclaim-missing-move-scalar fn-lbw-native-catalog-binding-is-model
      fn-lbw-unbound-catalog-rows-iff-not-binding nthcdr))))))
 :breaks ((binding ((arena-mode :bad-retained)))
          (allocated-log ((log (fn-lbwr-stale-tombstone-log))))
          (old-handles ((rows (fn-lbwr-future-reclaim-input)) (log nil))))
 :mutations ((missing-tombstone-move (:conclusion (let* ((base (fn-arena-count fn-arena))
        (prediction (fn-orcs-predict rows id base))
        (post-arena (fn-orcs-seal (cadr prediction) fn-arena))
        (post-log log))
  (fn-lb-arena-is-log post-arena
   (fn-sca-load-held-rows (car prediction) view-index fn-arena fn-cat)
   post-log)))
              ((arena-mode :good) (rows (fn-lbw-reclaim-input)) (id nil) (view-index nil)
               (target 2) (log (fn-lbw-two-log)))
              :fault "reclaim seals the tombstone and changes the catalog handle without its log MOVE")))

; Actual private P3 construction/adoption execution. These finite fixture
; budgets bound this test, never stored history or supported profiles.
(in-package "ACL2")
(include-book "../../books/history-root-credit")

(defconst *hprt-held*
  (fn-held-make 0 1 0 "<root@fn>" 0 '("fn.test") "o" "s" "e" 1 5
    (fn-hf-make 100 14 2 nil)
    (fn-hc-make (fn-stx-make-verdict :unverified nil 0) nil 0) nil nil))
(defconst *hprt-rows*
  (list *hprt-held* '(:configuration "origin" 2) '(:receipt 9 "peer")
        '(:lineage 0 1) '(:ack 4) '(:outbox 7 (1 2 3))
        (list :large-event (coerce (make-list 5000 :initial-element #\x) 'string))))

(defun hprt-ticks (fuel verdict cursor fn-hrecs$s)
  (declare (xargs :stobjs fn-hrecs$s :mode :program))
  (cond ((eq verdict :done) (mv :done fn-hrecs$s))
        ((zp fuel) (mv :fixture-fuel fn-hrecs$s))
        ((or (eq verdict :yield)
             (and (consp verdict) (eq (car verdict) :grow-image)))
         (mv-let (v c fn-hrecs$s)
           (if (and (consp verdict) (eq (car verdict) :grow-image))
               (fn-his-row-grow cursor fn-hrecs$s)
             (fn-his-row-step cursor fn-hrecs$s))
           (hprt-ticks (- fuel 1) v c fn-hrecs$s)))
        (t (mv verdict fn-hrecs$s))))
(defun hprt-build (rows fn-hrecs$s)
  (declare (xargs :stobjs fn-hrecs$s :mode :program))
  (if (atom rows) (mv :done fn-hrecs$s)
    (mv-let (v c fn-hrecs$s) (fn-his-row-begin (car rows) fn-hrecs$s)
      (mv-let (word fn-hrecs$s) (hprt-ticks 20000 v c fn-hrecs$s)
        (if (eq word :done) (hprt-build (cdr rows) fn-hrecs$s)
          (mv word fn-hrecs$s))))))
(defun hprt-index (ordinal fuel fn-hist$p)
  (declare (xargs :stobjs fn-hist$p :mode :program))
  (if (zp fuel) (mv :fixture-fuel fn-hist$p)
    (mv-let (v next fn-hist$p) (fn-hist$p-root-index-next ordinal fn-hist$p)
      (if (eq v :yield) (hprt-index next (- fuel 1) fn-hist$p)
        (mv v fn-hist$p)))))
(defun hprt-read-all (ordinal count fn-hist$p)
  (declare (xargs :stobjs fn-hist$p :mode :program))
  (if (< ordinal count)
      (cons (fn-hist$p-read ordinal fn-hist$p)
            (hprt-read-all (+ ordinal 1) count fn-hist$p)) nil))
(defun hprt-live (fn-hrecs$s fn-hist$p)
  (declare (xargs :stobjs (fn-hrecs$s fn-hist$p) :mode :program))
  (let* ((fn-hrecs$s (fn-his-build-begin 17 fn-hrecs$s))
         (fn-hist$p (fn-hist$p-clear 0 fn-hist$p)))
    (mv-let (built fn-hrecs$s) (hprt-build *hprt-rows* fn-hrecs$s)
      (let ((resident (and (eq built :done) (fn-hist$p-root-ready fn-hrecs$s))))
        (mv-let (fn-hrecs$s fn-hist$p) (fn-hist$p-adopt-stage 71 fn-hrecs$s fn-hist$p)
          (mv-let (indexed fn-hist$p) (hprt-index 0 (+ 1 (len *hprt-rows*)) fn-hist$p)
            (let* ((before (hprt-read-all 0 (fn-hist$p-count fn-hist$p) fn-hist$p))
                   (mids (fn-hist$p-msgid-records "<root@fn>" fn-hist$p))
                   (fn-hist$p (fn-hist$p-append '(:tail :appended) fn-hist$p)))
              (mv (and resident (eq indexed :done)
                       (equal before (pairlis$ (make-list (len *hprt-rows*) :initial-element :ok)
                                               (pairlis$ *hprt-rows* nil)))
                       (equal mids (list *hprt-held*))
                       (equal (fn-hist$p-root-generation fn-hist$p) 71)
                       (equal (fn-hist$p-count fn-hist$p) (+ 1 (len *hprt-rows*)))
                       (equal (fn-hist$p-read (len *hprt-rows*) fn-hist$p)
                              '(:ok (:tail :appended)))
                       (equal (fn-hist$p-read (+ 1 (len *hprt-rows*)) fn-hist$p)
                              '(:refused :history-root-ordinal)))
                  fn-hrecs$s fn-hist$p))))))))
(assert-event
 (mv-let (ok fn-hrecs$s fn-hist$p) (hprt-live fn-hrecs$s fn-hist$p)
   (mv ok fn-hrecs$s fn-hist$p))
 :stobjs-out '(nil fn-hrecs$s fn-hist$p))

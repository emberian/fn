; A6: exact cold-header substitution for ID-5. Old-text tooth stays unchanged.
(in-package "ACL2")
(include-book "lc-cold-id5-tests")
(include-book "lc-id6-search-tests")
(defun lca6-id5-observation (disk configs segs outcome fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let ((beforep (fn-lbc-p fn-lbc)))
  (mv-let (answer fn-lbc nextdisk aftersegs trace owner)
   (fn-lc-open disk :lc :eager configs 8 4 segs outcome fn-lbc)
   (declare (ignore nextdisk trace owner))
   (let* ((h (fn-lc-replayed-header disk :lc :eager segs))
          (old (fn-lc-cold-adopted-header disk :lc :eager))
          (old-next (fn-lc-header-next-id old)) (next (fn-lc-header-next-id h)))
    (mv (list beforep (fn-lc-segsp segs) (equal answer :ok)
          (fn-lc-header-ids-coverp h aftersegs nil)
          old-next next
          (mbe :logic (<= old-next next) :exec (not (fn-ag-less next old-next)))
          (fn-lc-at 1 (pgs-open disk :lc :eager))
          (fn-lc-at 1 (fn-lc-cold-select disk :lc :eager))
          (fn-lc-headerp old) (fn-lc-headerp (fn-lc-cold-adopted-header disk :lc :eager))
          (implies (and beforep (fn-lc-segsp segs) (equal answer :ok))
           (and (fn-lc-header-ids-coverp h aftersegs nil)
            (mbe :logic (<= old-next next) :exec (not (fn-ag-less next old-next))))))
        fn-lbc)))))
(defthm lca6-id5-observation-is-the-a6-claim
 (equal (nth 11 (mv-nth 0 (lca6-id5-observation disk configs segs outcome fn-lbc)))
  (let* ((out (fn-lc-open disk :lc :eager configs 8 4 segs outcome fn-lbc))
         (h (fn-lc-replayed-header disk :lc :eager segs)))
   (implies (and (fn-lbc-p fn-lbc) (fn-lc-segsp segs) (equal (mv-nth 0 out) :ok))
    (and (fn-lc-header-ids-coverp h (mv-nth 3 out) nil)
         (<= (fn-lc-header-next-id (fn-lc-cold-adopted-header disk :lc :eager))
             (fn-lc-header-next-id h))))))
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
  '(lca6-id5-observation nth mv-nth fn-lc-at-is-nth car-cons cdr-cons
    (:executable-counterpart zp))))))
(defun lca6-id5-run (disk segs)
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-lbc
  (mv-let (v fn-lbc)
   (lca6-id5-observation disk (list *fn-cfg-default-record*) segs (fn-lc-proof-ok-outcomes 100) fn-lbc) v)))
(defun lca6-id5-check (code)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((i (lct-id6-input code)) (v (lca6-id5-run (fn-lc-at 0 i) (fn-lc-at 3 i))))
  (fn-lc-at 11 v)))
(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
 (with-guard-checking-event :none
  (assert-event (let* ((i (lco-id5-input 1))
                       (v (lca6-id5-run (fn-lc-at 0 i) (fn-lc-at 3 i))))
   (and (fn-lc-at 0 v) (fn-lc-at 1 v) (fn-lc-at 2 v) (fn-lc-at 3 v)
        (equal (fn-lc-at 4 v) 1) (equal (fn-lc-at 5 v) 2) (fn-lc-at 11 v)))))
 (with-guard-checking-event :none
  (assert-event (let* ((i (lco-id5-input 1))
                       (v (lca6-id5-run (lci-cold-pgs-different-root-disk) (fn-lc-at 3 i))))
   (and (fn-lc-at 0 v) (fn-lc-at 1 v) (fn-lc-at 2 v) (fn-lc-at 3 v)
        (equal (fn-lc-at 4 v) 1) (equal (fn-lc-at 5 v) 2) (fn-lc-at 11 v)))))
 ; Omit segment shape: accepted malformed extra ID, allocation cannot cover it.
 (with-guard-checking-event :none
  (assert-event (let ((v (lca6-id5-run (fn-lc-at 0 (lco-id5-input 1))
                                       '((bad nil nil) (0 nil nil) (1 nil nil)))))
   (and (fn-lc-at 0 v) (not (fn-lc-at 1 v)) (fn-lc-at 2 v) (not (fn-lc-at 3 v))))))
 ; DROP control for :ok: a refused empty open still satisfies the conclusion.
 (with-guard-checking-event :none
  (assert-event (let ((v (lca6-id5-run nil nil)))
   (and (fn-lc-at 0 v) (fn-lc-at 1 v) (not (fn-lc-at 2 v)) (fn-lc-at 3 v)))))
 ; Root-only replay mutant at the half-published reservation: N is not < N.
 (with-guard-checking-event :none
  (assert-event (let* ((i (lco-id5-input 1)) (disk (fn-lc-at 0 i)) (segs (fn-lc-at 3 i))
                       (v (lca6-id5-run disk segs)))
   (and (fn-lc-at 0 v) (fn-lc-at 1 v) (fn-lc-at 2 v) (fn-lc-at 11 v)
        (not (fn-lc-header-ids-coverp (fn-lc-cold-adopted-header disk :lc :eager) segs nil)))))))

(verify-guards lca6-id5-observation :hints (("Goal" :in-theory (enable fn-ag-less))))
(verify-guards lca6-id5-run)
(defun lca6-id5-native-check (code)
 (declare (xargs :guard t))
 (let* ((i (lco-id5-input code))
        (disk (if (equal (mod (nfix code) 2) 0) (fn-lc-at 0 i)
                (lci-cold-pgs-different-root-disk)))
        (v (lca6-id5-run disk (fn-lc-at 3 i))))
  (fn-lc-at 11 v)))

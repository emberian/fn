        (fn-cat (list held))
        (range (fn-ovw-cursor "fn.test" k top v nil t))
        (s (fn-obc-make range (obst-token) :bad nil nil 0))
        (seq (fn-cnx-view-seq "fn.test" k v fn-cat))
        (row (and seq (fn-cat-at seq fn-cat))))
  (and (not (equal (nth 2 s) :seek))

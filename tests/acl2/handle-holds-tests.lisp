; Teeth for books/handle-holds (TEETH CONTRACT v1): the two released-handles
; keystones.  Both are stated over (mv-nth K (fn-arpn-step ..)), which defteeth's
; executable witnesses cannot evaluate, so their witnesses are ground theorems
; (:witness-lemma, :lemma on each mutation): lemma debt (TEETH-OWED-MV-CLAIM).
; The claims keep every antecedent inside the implication, so each mutation
; is the statement with one antecedent dropped (false at a witness where that
; antecedent fails) or one conclusion conjunct broken.

(in-package "ACL2")
(include-book "../../books/handle-holds")
(include-book "../../books/defkeystone")

(defconst *hht-w*
  (fn-record-make 0 1 0 "<a@x>" '(83 58 32 97 13 10 13 10) '("fn.test") "o" "s" "e" 1 5))
(defconst *hht-old*
  (list (fn-held-plain *hht-w* 0) (fn-held-plain *hht-w* 1) (fn-held-plain *hht-w* 2)))
(defconst *hht-new*
  (list (fn-held-plain *hht-w* 0) (fn-held-plain *hht-w* 3) (fn-held-plain *hht-w* 2)))
(defconst *hht-named* '(0 3 2))
(defconst *hht-named-bad* '(0 1 2))
; a reader pinned at generation 1; the retirement of handle 1 is pending at
; stamp 0, which the pin does not hold (0 < 1): the release answers it.
(defconst *hht-st* '(2 ((1 . 1)) ((0 (:forget 1)))))
(defconst *hht-st-forget5* '(2 ((1 . 1)) ((0 (:forget 5)))))
(defconst *hht-e* '(0 (:forget 1)))
(defconst *hht-e-absent* '(7 (:forget 1)))

(defthm hht-fixture-positive
  (and (fn-arpn-okp *hht-st*)
       (equal (mv-nth 1 (fn-arpn-step *hht-st* '(:release))) (list *hht-e*))
       (equal (cdr *hht-e*) (fn-arf-tag (fn-arf-changed-handles *hht-old* *hht-new*)))
       (fn-arf-disjointp (fn-arf-changed-handles *hht-old* *hht-new*) *hht-named*)
       (not (fn-arf-disjointp (fn-arf-changed-handles *hht-old* *hht-new*) *hht-named-bad*))
       (equal (fn-arpn-pins-of 1 (second (mv-nth 0 (fn-arpn-step *hht-st* '(:release))))) 1)
       (no-duplicatesp-equal (fn-arf-rows-handles *hht-old*))
       (fn-arf-rewrite-of-p *hht-old* *hht-new* (fn-arf-rows-handles *hht-old*))
       (equal (fn-arf-rows-handles *hht-new*) *hht-named*))
  :rule-classes nil)

(defconst *hht-old-dup* (list (fn-held-plain *hht-w* 1) (fn-held-plain *hht-w* 1)))
(defconst *hht-new-dup* (list (fn-held-plain *hht-w* 3) (fn-held-plain *hht-w* 1)))
(defconst *hht-new-swap*
  (list (fn-held-plain *hht-w* 1) (fn-held-plain *hht-w* 0) (fn-held-plain *hht-w* 2)))
(defconst *hht-st-swap* '(2 ((1 . 1)) ((0 (:forget 0) (:forget 1)))))
(defconst *hht-e-swap* '(0 (:forget 0) (:forget 1)))

(defthm hht-unnamed-witness
  (implies (and (fn-arpn-okp *hht-st*)
                      (member-equal *hht-e* (mv-nth 1 (fn-arpn-step *hht-st* '(:release))))
                      (equal (cdr *hht-e*) (fn-arf-tag (fn-arf-changed-handles *hht-old* *hht-new*)))
                      (fn-arf-disjointp (fn-arf-changed-handles *hht-old* *hht-new*) *hht-named*))
                 (and (member-equal *hht-e* (third *hht-st*))
                      (implies (< 0 (fn-arpn-pins-of 1 (second (mv-nth 0 (fn-arpn-step *hht-st* '(:release))))))
                               (< (car *hht-e*) 1))
                      (equal (fn-arf-items-handles (cdr *hht-e*)) (fn-arf-changed-handles *hht-old* *hht-new*))
                      (implies (member-equal 1 (fn-arf-items-handles (cdr *hht-e*)))
                               (not (member-equal 1 *hht-named*)))))
  :rule-classes nil)


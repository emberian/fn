(defteeth fn-handle-holds-released-handles-are-unnamed-and-postdate-every-pin
  :claim (() (implies (and (fn-arpn-okp st)
                      (member-equal e (mv-nth 1 (fn-arpn-step st '(:release))))
                      (equal (cdr e) (fn-arf-tag (fn-arf-changed-handles old new)))
                      (fn-arf-disjointp (fn-arf-changed-handles old new) named))
                 (and (member-equal e (third st))
                      (implies (< 0 (fn-arpn-pins-of g (second (mv-nth 0 (fn-arpn-step st '(:release))))))
                               (< (car e) g))
                      (equal (fn-arf-items-handles (cdr e)) (fn-arf-changed-handles old new))
                      (implies (member-equal h (fn-arf-items-handles (cdr e)))
                               (not (member-equal h named))))))
  :subject fn-arpn-step
  :witness-lemma hht-unnamed-witness
  :witness ((st *hht-st*) (e *hht-e*) (old *hht-old*) (new *hht-new*) (named *hht-named*) (g 1) (h 1))
  :mutations ((no-disjointness
               (:conclusion (implies (and (fn-arpn-okp st)
                      (member-equal e (mv-nth 1 (fn-arpn-step st '(:release))))
                      (equal (cdr e) (fn-arf-tag (fn-arf-changed-handles old new))))
                 (and (member-equal e (third st))
                      (implies (< 0 (fn-arpn-pins-of g (second (mv-nth 0 (fn-arpn-step st '(:release))))))
                               (< (car e) g))
                      (equal (fn-arf-items-handles (cdr e)) (fn-arf-changed-handles old new))
                      (implies (member-equal h (fn-arf-items-handles (cdr e)))
                               (not (member-equal h named))))))
               ((st *hht-st*) (e *hht-e*) (old *hht-old*) (new *hht-new*) (named *hht-named-bad*) (g 1) (h 1))
               :fault "a statement that does not require the changed handles to be unnamed"
               :lemma hht-unnamed-mut1)
              (no-tag-hypothesis
               (:conclusion (implies (and (fn-arpn-okp st)
                      (member-equal e (mv-nth 1 (fn-arpn-step st '(:release))))
                      (fn-arf-disjointp (fn-arf-changed-handles old new) named))
                 (and (member-equal e (third st))
                      (implies (< 0 (fn-arpn-pins-of g (second (mv-nth 0 (fn-arpn-step st '(:release))))))
                               (< (car e) g))
                      (equal (fn-arf-items-handles (cdr e)) (fn-arf-changed-handles old new))
                      (implies (member-equal h (fn-arf-items-handles (cdr e)))
                               (not (member-equal h named))))))
               ((st *hht-st-forget5*) (e '(0 (:forget 5))) (old *hht-old*) (new *hht-new*) (named *hht-named*) (g 1) (h 1))
               :fault "a statement that does not tie the released items to the changed handles"
               :lemma hht-unnamed-mut2)
              (no-membership-hypothesis
               (:conclusion (implies (and (fn-arpn-okp st)
                      (equal (cdr e) (fn-arf-tag (fn-arf-changed-handles old new)))
                      (fn-arf-disjointp (fn-arf-changed-handles old new) named))
                 (and (member-equal e (third st))
                      (implies (< 0 (fn-arpn-pins-of g (second (mv-nth 0 (fn-arpn-step st '(:release))))))
                               (< (car e) g))
                      (equal (fn-arf-items-handles (cdr e)) (fn-arf-changed-handles old new))
                      (implies (member-equal h (fn-arf-items-handles (cdr e)))
                               (not (member-equal h named))))))
               ((st *hht-st*) (e *hht-e-absent*) (old *hht-old*) (new *hht-new*) (named *hht-named*) (g 1) (h 1))
               :fault "a statement about an item the release never answered"
               :lemma hht-unnamed-mut3)
              (pin-ordering-reversed
               (:conclusion (implies (and (fn-arpn-okp st)
                      (member-equal e (mv-nth 1 (fn-arpn-step st '(:release))))
                      (equal (cdr e) (fn-arf-tag (fn-arf-changed-handles old new)))
                      (fn-arf-disjointp (fn-arf-changed-handles old new) named))
                 (and (member-equal e (third st))
                      (implies (< 0 (fn-arpn-pins-of g (second (mv-nth 0 (fn-arpn-step st '(:release))))))
                               (< g (car e)))
                      (equal (fn-arf-items-handles (cdr e)) (fn-arf-changed-handles old new))
                      (implies (member-equal h (fn-arf-items-handles (cdr e)))
                               (not (member-equal h named))))))
               ((st *hht-st*) (e *hht-e*) (old *hht-old*) (new *hht-new*) (named *hht-named*) (g 1) (h 1))
               :fault "a release that claims it follows the pin it must precede"
               :lemma hht-unnamed-mut4)))

(defthm hht-pairwise-witness
  (implies (and (fn-arpn-okp *hht-st*)
                      (member-equal *hht-e* (mv-nth 1 (fn-arpn-step *hht-st* '(:release))))
                      (equal (cdr *hht-e*) (fn-arf-tag (fn-arf-changed-handles *hht-old* *hht-new*)))
                      (no-duplicatesp-equal (fn-arf-rows-handles *hht-old*))
                      (fn-arf-rewrite-of-p *hht-old* *hht-new* (fn-arf-rows-handles *hht-old*)))
                 (and (member-equal *hht-e* (third *hht-st*))
                      (implies (< 0 (fn-arpn-pins-of 1 (second (mv-nth 0 (fn-arpn-step *hht-st* '(:release))))))
                               (< (car *hht-e*) 1))
                      (equal (fn-arf-items-handles (cdr *hht-e*)) (fn-arf-changed-handles *hht-old* *hht-new*))
                      (implies (member-equal 1 (fn-arf-items-handles (cdr *hht-e*)))
                               (not (member-equal 1 (fn-arf-rows-handles *hht-new*))))))
  :rule-classes nil)


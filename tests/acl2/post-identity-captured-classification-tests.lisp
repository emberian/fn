(in-package "ACL2")
(include-book "../../books/post-identity-captured-classification")
(include-book "post-identity-captured-tests")

(defun pic-clt-until-entry (c held fuel)
 (declare (xargs :measure (nfix fuel) :verify-guards nil))
 (let ((next (pic-test-drive c '(97 98 99) held 1)))
  (if (or (zp fuel) (equal (fn-pic-get phase c) :done)
          (and (equal (fn-pic-get phase c) :source-incoming)
               (member-eq (fn-pic-get phase next) '(:magic :source-held)))) c
   (pic-clt-until-entry next held (1- fuel)))))
(defun pic-clt-before (held)
 (declare (xargs :verify-guards nil))
 (pic-clt-until-entry (pic-test-begin nil nil) held 1000))
(defun pic-clt-start (held)
 (declare (xargs :verify-guards nil))
 (pic-test-drive (pic-clt-before held) '(97 98 99) held 1))
(defconst *pic-clt-held*
 (pic-test-tomb 0 *pic-test-abc-hash* *pic-test-abc-hash* nil))
(defun pic-clt-observation (c byte)
 (list :payload-byte (fn-pic-get selected c) (fn-pic-get grant c) 0
  (fn-pic-at 1 (fn-pic-demand c)) byte))

(defthm pic-clt-entry-read-positive-magic
 (let* ((c (pic-clt-before *pic-clt-held*))
        (next (mv-nth 1 (fn-pic-next c 1 '(97 98 99)))))
  (and (fn-pic-classification-entryp c '(97 98 99) *pic-clt-held*)
       (equal (fn-pic-get phase c) :source-incoming)
       (equal (fn-pic-get phase next) :magic)
       (fn-pic-classification-outcomep next '(97 98 99) *pic-clt-held*)
       (fn-pic-classification-productp next '(97 98 99) *pic-clt-held*)
       (equal (fn-pic-get pos next) 0)))
 :rule-classes nil)
(defthm pic-clt-entry-feedback-positive-short-ordinary
 (let* ((held (take 144 *pic-clt-held*)) (c (pic-clt-before held))
        (next (mv-nth 1 (fn-pic-feed-funded c :control 1))))
  (and (fn-pic-classification-entryp c '(97 98 99) held)
       (equal (fn-pic-get phase c) :source-incoming)
       (equal (fn-pic-get phase next) :source-held)
       (fn-pic-classification-outcomep next '(97 98 99) held)
       (not (fn-rcl-tombstonep held))))
 :rule-classes nil)
(defthm pic-clt-feedback-positive-prefix-resumption
 (let* ((c (pic-clt-start *pic-clt-held*))
        (observation (pic-clt-observation c 0))
        (next (mv-nth 1 (fn-pic-feed-funded c observation 1))))
  (and (fn-pic-classification-productp c '(97 98 99) *pic-clt-held*)
       (fn-pic-classification-observationp c observation *pic-clt-held*)
       (fn-pic-classification-outcomep next '(97 98 99) *pic-clt-held*)
       (fn-pic-classification-productp next '(97 98 99) *pic-clt-held*)
       (equal (fn-pic-get pos next) 1)))
 :rule-classes nil)
(defthm pic-clt-feedback-positive-retired-rcl1-ordinary
 (let* ((held (update-nth 7 49 *pic-clt-held*))
        (c (pic-test-drive (pic-clt-start held) '(97 98 99) held 7))
        (observation (pic-clt-observation c 49))
        (next (mv-nth 1 (fn-pic-feed-funded c observation 1))))
  (and (fn-pic-classification-productp c '(97 98 99) held)
       (fn-pic-classification-observationp c observation held)
       (fn-pic-classification-outcomep next '(97 98 99) held)
       (equal (fn-pic-get phase next) :source-held)
       (not (fn-rcl-tombstonep held))))
 :rule-classes nil)
(defthm pic-clt-read-positive-full-rcl2-header
 (let* ((c (pic-test-drive (pic-clt-start *pic-clt-held*) '(97 98 99) *pic-clt-held* 8))
        (next (mv-nth 1 (fn-pic-next c 1 '(97 98 99)))))
  (and (fn-pic-classification-productp c '(97 98 99) *pic-clt-held*)
       (fn-pic-classification-observationp c :control *pic-clt-held*)
       (fn-pic-classification-outcomep next '(97 98 99) *pic-clt-held*)
       (equal (fn-pic-get phase next) :tomb-flag)
       (fn-rcl-tombstonep *pic-clt-held*)))
 :rule-classes nil)
; Skipping a corrupt header falsifies classification in both entries while
; exact control feedback and readonly incoming extent remain.
(defthm pic-clt-product-removal-corrupted-prefix
 (let* ((held (update-nth 7 49 *pic-clt-held*))
        (c (fn-pic-set pos 8 (pic-clt-start held)))
        (a (mv-nth 1 (fn-pic-feed-funded c :control 1)))
        (b (mv-nth 1 (fn-pic-next c 1 '(97 98 99)))))
  (and (not (fn-pic-classification-productp c '(97 98 99) held))
       (fn-pic-classification-observationp c :control held)
       (not (fn-pic-classification-outcomep a '(97 98 99) held))
       (not (fn-pic-classification-outcomep b '(97 98 99) held))
       (equal (fn-pic-get phase a) :tomb-flag) (equal (fn-pic-get phase b) :tomb-flag)))
 :rule-classes nil)
; Mutated scalar byte passes typed/token validation but falsely routes an
; actual RCL2 payload to ordinary-source parsing.
(defthm pic-clt-observation-removal-mutated-byte
 (let* ((c (pic-clt-start *pic-clt-held*)) (observation (pic-clt-observation c 1))
        (next (mv-nth 1 (fn-pic-feed-funded c observation 1))))
  (and (fn-pic-classification-productp c '(97 98 99) *pic-clt-held*)
       (fn-pic-observation-okp c (fn-pic-demand c) observation)
       (not (fn-pic-classification-observationp c observation *pic-clt-held*))
       (not (fn-pic-classification-outcomep next '(97 98 99) *pic-clt-held*))
       (equal (fn-pic-get phase next) :source-held)))
 :rule-classes nil)
; Mutated retained held extent hides a short payload from both entry checks.
(defthm pic-clt-entry-removal-corrupted-held-extent
 (let* ((held (take 144 *pic-clt-held*))
        (c (fn-pic-set held-n 145 (pic-clt-before held)))
        (a (mv-nth 1 (fn-pic-feed-funded c :control 1)))
        (b (mv-nth 1 (fn-pic-next c 1 '(97 98 99)))))
  (and (not (fn-pic-classification-entryp c '(97 98 99) held))
       (equal (fn-pic-get phase c) :source-incoming)
       (member-eq (fn-pic-get phase a) '(:magic :source-held))
       (member-eq (fn-pic-get phase b) '(:magic :source-held))
       (not (fn-pic-classification-outcomep a '(97 98 99) held))
       (not (fn-pic-classification-outcomep b '(97 98 99) held))))
 :rule-classes nil)
; Full source extent relation remains, but an existing corrupt classifier
; continuation is not reestablished by a zero-fuel call.
(defthm pic-clt-entry-phase-removal-corrupted-existing-prefix
 (let* ((held (update-nth 7 49 *pic-clt-held*))
        (c (fn-pic-set pos 8 (pic-clt-start held)))
        (a (mv-nth 1 (fn-pic-feed-funded c nil 0)))
        (b (mv-nth 1 (fn-pic-next c 0 '(97 98 99)))))
  (and (fn-pic-classification-entryp c '(97 98 99) held)
       (not (equal (fn-pic-get phase c) :source-incoming))
       (member-eq (fn-pic-get phase a) '(:magic :source-held))
       (member-eq (fn-pic-get phase b) '(:magic :source-held))
       (not (fn-pic-classification-outcomep a '(97 98 99) held))
       (not (fn-pic-classification-outcomep b '(97 98 99) held))))
 :rule-classes nil)

(in-package "ACL2")
(include-book "../../books/index-backing-chunk-recycle")

; Complete unconditional boundary: no theorem hypotheses to remove.
(defun-nx recycle-table-witness ()
  (let* ((page (fn-ibp-table-set 3 91 (create-fn-ibp-table-page)))
         (page (fn-ibp-table-set 7 91 page))
         (out (fn-ibp-table-clear-span 2 3 page)))
    (and (equal (fn-ibp-table-sealed page) 0)
         (equal out (update-nth 0 (fn-ibp-clear-span-model 2 3 0 (nth 0 page)) page))
         (equal (nth 3 (nth 0 out)) 0)
         (equal (nth 7 (nth 0 out)) 91)
         (equal (fn-ibp-table-clear-span 2048 0 page) page)
         ; Mutation: clearing one too few leaves the occupied slot.
         (not (equal (fn-ibp-table-clear-span 2 1 page) out)))))
(defthm recycle-table-witness-passed (recycle-table-witness) :rule-classes nil)
(defun-nx recycle-table-stamp-witness ()
  (let* ((init (mv-list 2 (fn-ibp-table-initialize 7 3 (create-fn-ibp-table-page))))
         (page (nth 1 init))
         (seal (mv-list 2 (fn-ibp-table-seal 7 3 page)))
         (page (nth 1 seal))
         (wrong (mv-list 2 (fn-ibp-table-restamp 7 4 8 8 page)))
         (same (mv-list 2 (fn-ibp-table-restamp 7 3 7 8 page)))
         (fresh (mv-list 2 (fn-ibp-table-restamp 7 3 8 8 page))))
    (and (equal (nth 0 init) :initialized) (equal (nth 0 seal) :sealed)
         (equal wrong (list :stale-chunk page))
         (equal same (list :stale-chunk page))
         (equal (nth 0 fresh) :restamped)
         (equal (nth 1 fresh) (list (nth 0 page) 8 8 0)))))
(defthm recycle-table-stamp-witness-passed (recycle-table-stamp-witness) :rule-classes nil)


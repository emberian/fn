; BEGIN reclaimed zero-cost teeth
(defthm fn-lbczt-reclaimed-whole-positive
 (and (fn-lbc-flag (cadr (fn-lbc-select '(t "fn.test" 1 nil) :head nil 1 (fn-lbczt-columns))) *fn-lbc-reclaimed-bit* (fn-lbczt-columns)) (and (equal (fn-lbc-retrieval-range-requests '(t "fn.test" 1 nil) nil nil :head nil nil 1 (fn-lbczt-log) '(nil nil) (list (fn-lbczt-tombstone)) (fn-lbczt-columns)) 0)
       (equal (fn-lbc-retrieval-entry-reads '(t "fn.test" 1 nil) nil nil :head nil nil 1 (fn-lbczt-log) '(nil nil) (list (fn-lbczt-tombstone)) (fn-lbczt-columns)) 0))) :rule-classes nil
 :hints (("Goal" :use (fn-lbczt-reclaimed-selection-positive
  (:instance fn-lbc-retrieval-reclaimed-reads-nothing (session '(t "fn.test" 1 nil)) (archive nil) (arts nil) (kind :head) (args nil) (server nil) (v 1) (log (fn-lbczt-log)) (fn-lb-vmap-v '(nil nil)) (fn-arena-v (list (fn-lbczt-tombstone))) (fn-lbc-v (fn-lbczt-columns))))
  :in-theory (theory 'ground-zero))))
(defthm fn-lbczt-reclaimed-prefetch-whole-positive
 (and (fn-lbc-flag (cadr (fn-lbc-select '(t "fn.test" 1 nil) :head nil 1 (fn-lbczt-columns))) *fn-lbc-reclaimed-bit* (fn-lbczt-columns)) (and (equal (fn-lbc-retrieval-range-requests '(t "fn.test" 1 nil) nil nil :head nil nil 1 (fn-lbczt-log) '(nil nil) (list (fn-lbczt-tombstone)) (fn-lbczt-columns)) 0)
       (equal (fn-lbc-retrieval-entry-reads '(t "fn.test" 1 nil) nil nil :head nil nil 1 (fn-lbczt-log) '(nil nil) (list (fn-lbczt-tombstone)) (fn-lbczt-columns)) 0)) (not (equal (fn-lbzc-prefetch-range-requests '(t "fn.test" 1 nil) :head 1 (fn-lbczt-log) '(nil nil) (list (fn-lbczt-tombstone)) (fn-lbczt-columns)) 0))) :rule-classes nil
 :hints (("Goal" :use fn-lbczt-reclaimed-whole-positive
  :in-theory (union-theories (theory 'ground-zero) '(fn-lbzc-prefetch-range-requests)))))
(defthm fn-lbczt-reclaimed-premise-removal
 (and (not (fn-lbc-flag (cadr (fn-lbc-select '(t "fn.test" 1 nil) :head nil 1 (fn-lbcc-test-one-state))) *fn-lbc-reclaimed-bit* (fn-lbcc-test-one-state))) (not (and (equal (fn-lbc-retrieval-range-requests '(t "fn.test" 1 nil) nil nil :head nil nil 1 (fn-lbzc-log) '(nil nil) (list *fn-lbr13-payload*) (fn-lbcc-test-one-state)) 0)
       (equal (fn-lbc-retrieval-entry-reads '(t "fn.test" 1 nil) nil nil :head nil nil 1 (fn-lbzc-log) '(nil nil) (list *fn-lbr13-payload*) (fn-lbcc-test-one-state)) 0)))) :rule-classes nil
 :hints (("Goal" :use (fn-lbczt-reclaimed-selection-positive fn-lbcct-retrieval-one-request-positive)
  :in-theory (union-theories (theory 'ground-zero) '(fn-lbzc-log)))))
(defteeth fn-lbc-retrieval-reclaimed-reads-nothing
 :claim (((reclaimed (fn-lbc-flag (cadr (fn-lbc-select session kind args v fn-lbc-v)) *fn-lbc-reclaimed-bit* fn-lbc-v))) (and (equal (fn-lbc-retrieval-range-requests session archive arts kind args server v log fn-lb-vmap-v fn-arena-v fn-lbc-v) 0)
       (equal (fn-lbc-retrieval-entry-reads session archive arts kind args server v log fn-lb-vmap-v fn-arena-v fn-lbc-v) 0)))
 :subject fn-lbc-retrieval :witness ((session '(t "fn.test" 1 nil)) (archive nil) (arts nil) (kind :head) (args nil) (server nil) (v 1) (log (fn-lbczt-log)) (fn-lb-vmap-v '(nil nil)) (fn-arena-v (list (fn-lbczt-tombstone))) (fn-lbc-v (fn-lbczt-columns))) :witness-lemma fn-lbczt-reclaimed-whole-positive
 :breaks ((reclaimed ((session '(t "fn.test" 1 nil)) (archive nil) (arts nil) (kind :head) (args nil) (server nil) (v 1) (log (fn-lbzc-log)) (fn-lb-vmap-v '(nil nil)) (fn-arena-v (list *fn-lbr13-payload*)) (fn-lbc-v (fn-lbcc-test-one-state))) :lemma fn-lbczt-reclaimed-premise-removal))
 :mutations ((prefetch-tombstone (:conclusion (equal (fn-lbzc-prefetch-range-requests session kind v log fn-lb-vmap-v fn-arena-v fn-lbc-v) 0)) ((session '(t "fn.test" 1 nil)) (archive nil) (arts nil) (kind :head) (args nil) (server nil) (v 1) (log (fn-lbczt-log)) (fn-lb-vmap-v '(nil nil)) (fn-arena-v (list (fn-lbczt-tombstone))) (fn-lbc-v (fn-lbczt-columns)))
  :fault "Read payload bytes before noticing the reclaimed flag" :lemma fn-lbczt-reclaimed-prefetch-whole-positive)))

(defun fn-lbczt-native-reclaimed-control ()
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-lbc
  (mv-let (ok fn-lbc)
   (with-local-stobj fn-lb-vmap
    (mv-let (ok fn-lb-vmap fn-lbc)
     (with-local-stobj fn-arena
      (mv-let (ok fn-arena fn-lb-vmap fn-lbc)
       (let* ((row (fn-lbczt-reclaimed-row))
              (log (fn-lbczt-log))
              (fn-arena (fn-arena-seal-list (fn-lbczt-tombstone) fn-arena))
              (fn-lbc (fn-lbc-open-rebuild (list row) log fn-lbc))
              (reply (fn-lbc-retrieval '(t "fn.test" 1 nil) nil nil :head nil nil 1
                       log fn-lb-vmap fn-arena fn-lbc))
              (line (fn-ag-car (fn-ag-cdr (fn-ag-car (fn-nntp-result-effects reply))))))
        (mv (equal (take 3 line) '(52 50 51)) fn-arena fn-lb-vmap fn-lbc))
       (mv ok fn-lb-vmap fn-lbc)))
     (mv ok fn-lbc)))
   ok)))
(with-guard-checking-event t (assert-event (fn-lbczt-native-reclaimed-control)))

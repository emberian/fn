; fn: the official BLAKE3 test vectors for books/blake3.lisp.
;
; What this book is evidence FOR and what it is not.  books/blake3.lisp
; proves that `fn-blake3' (and its keyed and derive_key modes) always yields
; 32 octets; it cannot prove that those octets are the ones BLAKE3 specifies,
; because the specification is a document and a reference implementation,
; not an ACL2 term.  The bridge is EVALUATION against the published vectors:
; the BLAKE3 repository's test_vectors/test_vectors.json (tag 1.8.7, the
; version vendored at third_party/blake3; SHA-256 of the file
; dcb91ea8accc77e6d6e632af7cdc1a99a9f3ae78cf648da595c7d064db32f624, unchanged
; since 1.0).  Every case is here: the 35 input lengths, each in the three
; modes, the first 32 octets of each extended output (BLAKE3's default
; output, the length fn uses).  The input of length n is the octets
; 0, 1, ..., 250, 0, 1, ... (i mod 251); the key is the ASCII string
; "whats the Elvish word for friend"; the context string is
; "BLAKE3 2019-12-27 16:29:52 test vectors context".
; A failure here is a defect in the definition; a pass is agreement on these
; inputs (every chunk and block edge up to 8 chunks, 16 and 31 chunks, and
; 100 chunks), which is evidence, not a proof of agreement on all inputs.
;
; Nothing here bears on collision resistance (A-CRYPTO, specs/failures.md).

(in-package "ACL2")
(include-book "../../books/blake3")

(defun fn-b3-t-input-from (i n)
  (declare (xargs :guard (and (natp i) (natp n)) :measure (nfix (- n i))))
  (if (and (natp i) (natp n) (< i n))
      (cons (mod i 251) (fn-b3-t-input-from (+ i 1) n))
    nil))

(defmacro fn-b3-t-input (n) `(fn-b3-t-input-from 0 ,n))

(defconst *fn-b3-t-key*
  '(119 104 97 116 115 32 116 104 101 32 69 108 118 105 115 104 32 119 111 114 100 32 102 111 114 32 102 114 105 101 110 100))

(defconst *fn-b3-t-context*
  '(66 76 65 75 69 51 32 50 48 49 57 45 49 50 45 50 55 32 49 54 58 50 57 58 53 50 32 116 101 115 116 32 118 101 99 116 111 114 115 32 99 111 110 116 101 120 116))

; input_len 0
(assert-event
 (let ((m (fn-b3-t-input 0)))
   (and (equal (fn-blake3 m)
               '(175 19 73 185 245 249 161 166 160 64 77 234 54 220 201 73 155 203 37 201 173 193 18 183 204 154 147 202 228 31 50 98))
        (equal (fn-blake3-keyed *fn-b3-t-key* m)
               '(146 178 183 86 4 237 60 118 31 157 111 98 57 44 138 146 39 173 14 163 240 149 115 231 131 241 73 138 78 214 13 38))
        (equal (fn-blake3-derive-key *fn-b3-t-context* m)

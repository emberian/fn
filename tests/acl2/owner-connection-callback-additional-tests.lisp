; Complete actual callback-family fixtures. Source WIP, no installed selector.
(in-package "ACL2")
(include-book "owner-connection-callback-tests")

(defun ocbt-peer-complete (state)
  (declare (xargs :stobjs state :mode :program))
  (let* ((state (ocbt-initialize state))
         (octets '(112 101 101 114))
         (peer (fn-store-octets->string octets))
         (before (fn-owner-ocfg state))
         (id (fn-own-next-id (fn-owner-core state)))
         (reference (fn-ocfg-open-peer before peer (fn-owner-auth state)))
         (views (fn-owner-reader-views state))
         (credits (f-get-global 'fn-owner-credits state))
         (ledger (fn-rov-owner-ledger state))
         (view (fn-owner-obligation-view state)))
    (mv-let (erp actual-id state) (fn-owner-callback-open-peer octets state)
      (value
       (and (not erp) (equal actual-id id)
            (equal (fn-owner-ocfg state) (cdr reference))
            (equal (f-get-global 'fn-owner-effects state) (car reference))
            (equal (f-get-global 'fn-owner-output state) (fn-served-reply-octets (car reference)))
            (equal (f-get-global 'fn-owner-closep state) (fn-served-closingp (car reference)))
            (equal (f-get-global 'fn-owner-starttlsp state) (if (fn-served-starttlsp (car reference)) t nil))
            (equal (f-get-global 'fn-owner-submittedp state) (if (fn-served-submission (car reference)) t nil))
            (equal (f-get-global 'fn-owner-log-line state)
                   (fn-olog-connection-line (fn-ocfg-owner (cdr reference)) id octets))
            (equal (fn-owner-obligation-view state)
                   (fn-rov-update ledger (fn-rov-oc-ledger (cdr reference)) view))
            (equal (fn-owner-reader-views state) views)
            (equal (f-get-global 'fn-owner-credits state) credits))))))
(assert-event (mv-let (erp checked state) (ocbt-peer-complete state)
                (mv (and (not erp) checked) state)) :stobjs-out '(nil state))

(defun ocbt-exposure-complete (state)
  (declare (xargs :stobjs state :mode :program))
  (let* ((state (ocbt-initialize state))
         (state (f-put-global 'fn-owner-exposure (fn-exp-initial) state))
         (state (f-put-global 'fn-owner-exposure-public nil state))
         (before (fn-owner-ocfg state))
         (antecedent (fn-ocl-relation before))
         (family :inet) (address '(127 0 0 1)) (octets nil)
         (id (fn-own-next-id (fn-owner-core state)))
         (reference (fn-exp-open before (fn-owner-exposure-state state)
                      (fn-owner-callback-exposure-limits state) (fn-owner-auth state)
                      nil (cons family address) (fn-owner-exposure-now state)))
         (effects (fn-exp-open-effects reference))
         (views (fn-owner-reader-views state))
         (credits (f-get-global 'fn-owner-credits state))
         (ledger (fn-rov-owner-ledger state))
         (view (fn-owner-obligation-view state)))
    (mv-let (erp actual-id state) (fn-owner-callback-exposure-open family address octets state)
      (value
       (and antecedent (not erp) (equal actual-id id)
            (equal actual-id (fn-exp-open-id reference))
            (equal (fn-owner-ocfg state) (fn-exp-open-ocfg reference))
            (equal (f-get-global 'fn-owner-exposure state) (fn-exp-open-state reference))
            (equal (f-get-global 'fn-owner-effects state) effects)
            (equal (f-get-global 'fn-owner-output state) (fn-served-reply-octets effects))
            (equal (f-get-global 'fn-owner-closep state) (fn-served-closingp effects))
            (equal (f-get-global 'fn-owner-starttlsp state) (if (fn-served-starttlsp effects) t nil))
            (equal (f-get-global 'fn-owner-submittedp state) (if (fn-served-submission effects) t nil))
            (equal (f-get-global 'fn-owner-log-line state)
                   (fn-olog-connection-line (fn-ocfg-owner (fn-exp-open-ocfg reference)) id nil))
            (equal (fn-owner-obligation-view state)
                   (fn-rov-update ledger (fn-rov-oc-ledger (fn-exp-open-ocfg reference)) view))
            (equal (fn-owner-reader-views state) views)
            (equal (f-get-global 'fn-owner-credits state) credits))))))
(assert-event (mv-let (erp checked state) (ocbt-exposure-complete state)
                (mv (and (not erp) checked) state)) :stobjs-out '(nil state))

; Corrupted-state selected-D hypothesis removal: the WORKING relation holds.
; That fact does not establish the different selected-D relation.
(defun ocbt-selected-d-removal (state)
  (declare (xargs :stobjs state :mode :program))
  (let* ((state (ocbt-initialize state))
         (working (fn-own-view (fn-owner-core state)))
         (bad-d (fn-own-view (fn-ocfg-owner *ocbt-bad-owner*)))
         (state (f-put-global 'fn-owner-reader-views (list bad-d) state))
         (working-related (fn-ocl-relation (fn-owner-ocfg state)))
         (selected (fn-ocfg-at-reader-view (fn-owner-ocfg state) (fn-owner-reader-views state)))
         (omitted (fn-ocl-relation selected))
         (remaining (boundp-global 'fn-owner state))
         (reference (fn-ocfg-open selected (fn-owner-auth state)))
         (expected (fn-ocfg-with-view (cdr reference) working)))
    (mv-let (erp id state) (fn-owner-callback-open state)
      (value (and remaining working-related (not omitted) (not erp) (equal id 0)
                  (not (equal (fn-owner-ocfg state) expected))
                  (equal (fn-own-view (fn-owner-core state)) working))))))
(assert-event (mv-let (erp checked state) (ocbt-selected-d-removal state)
                (mv (and (not erp) checked) state)) :stobjs-out '(nil state))

; Corrupted-state exposure relation removal; its runtime guard still holds.
(defun ocbt-exposure-relation-removal (state)
  (declare (xargs :stobjs state :mode :program))
  (let* ((state (ocbt-initialize state))
         (state (f-put-global 'fn-owner-exposure (fn-exp-initial) state))
         (state (f-put-global 'fn-owner-exposure-public nil state))
         (state (fn-owner-install-ocfg *ocbt-bad-owner* state))
         (before (fn-owner-ocfg state))
         (omitted (fn-ocl-relation before))
         (remaining (and (boundp-global 'fn-owner state) (fn-cbor-octet-listp nil)))
         (family :inet) (address '(127 0 0 1))
         (reference (fn-exp-open before (fn-owner-exposure-state state)
                      (fn-owner-callback-exposure-limits state) (fn-owner-auth state)
                      nil (cons family address) (fn-owner-exposure-now state))))
    (mv-let (erp id state) (fn-owner-callback-exposure-open family address nil state)
      (value (and remaining (not omitted) (not erp) (equal id 0)
                  (not (equal (fn-owner-ocfg state) (fn-exp-open-ocfg reference))))))))
(assert-event (mv-let (erp checked state) (ocbt-exposure-relation-removal state)
                (mv (and (not erp) checked) state)) :stobjs-out '(nil state))

; Two literal hypothesis removals for close's other-global frame.
; First close an actually opened connection whose actual credit ledger was
; resized under its budget. Both rewritten globals then visibly change.
(defun ocbt-close-frame-removals (state)
  (declare (xargs :stobjs state :mode :program))
  (with-local-stobj fn-arena
    (mv-let (checked fn-arena state)
      (let ((state (ocbt-initialize state)))
        (mv-let (open-erp id state) (fn-owner-callback-open state)
          (let* ((decision (fn-mcr-resize (fn-owner-credits state) (fn-mca-conn-key id) 100))
                 (state (fn-owner-put-credits (cadr decision) state))
                 (old-owner (f-get-global 'fn-owner state))
                 (old-credits (f-get-global 'fn-owner-credits state)))
            (mv-let (erp result state) (fn-owner-callback-close id fn-arena state)
              (mv (and (not open-erp) (equal id 0) (equal (car decision) :ok)
                       (not erp) (equal result :closed)
                       ; Omit key!=owner, retain key!=credits.
                       (not (equal 'fn-owner 'fn-owner-credits))
                       (equal 'fn-owner 'fn-owner)
                       (not (equal (f-get-global 'fn-owner state) old-owner))
                       ; Omit key!=credits, retain key!=owner.
                       (not (equal 'fn-owner-credits 'fn-owner))
                       (equal 'fn-owner-credits 'fn-owner-credits)
                       (not (equal (f-get-global 'fn-owner-credits state) old-credits)))
                  fn-arena state)))))
      (value checked))))
(assert-event (mv-let (erp checked state) (ocbt-close-frame-removals state)
                (mv (and (not erp) checked) state)) :stobjs-out '(nil state))

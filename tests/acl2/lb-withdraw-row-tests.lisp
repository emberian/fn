; Resident withdrawal updates: ordinary, escaped, and replacement values.
(in-package "ACL2")
(include-book "../../books/catalog-columns-withdraw-row-frames")
(include-book "lb-column-read-cost-teeth")

(defun fn-lbcwd-native-control ()
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-lbc
  (mv-let (ok fn-lbc)
   (let* ((row (fn-lbcc-test-decided-row))
          (log (fn-lb-log-model-append row *fn-lbr13-payload* 1 nil))
          (fn-lbc (fn-lbc-open-rebuild (list row) log fn-lbc))
          (a (fn-lbc-loc0 0 fn-lbc)) (b (fn-lbc-loc1 0 fn-lbc))
          (fn-lbc (fn-lbc-set-withdrawal 0 1 7 fn-lbc))
          (ordinary (and
             (fn-lbc-rows-corr 0 (list (fn-held-with-withdrawn row '(1 . 7))) 0 fn-lbc log)
             (fn-lc-locators-resolve fn-lbc log)
             (equal (fn-lbc-withdrawn 0 fn-lbc) '(1 . 7))
             (fn-lbc-p fn-lbc) (fn-lbc-escape-cellsp 0 fn-lbc)
             (equal (fn-lbc-count fn-lbc) 1)
             (equal (fn-lbc-loc0 0 fn-lbc) a) (equal (fn-lbc-loc1 0 fn-lbc) b)
             (equal (fn-lbc-stored-range 0 :head fn-lbc log)
                    '(83 117 98 106 101 99 116 58 32 97 13 10))))
          (wide (expt 2 64))
          (fn-lbc (fn-lbc-set-withdrawal 0 wide (+ wide 1) fn-lbc))
          (escaped (and
             (fn-lbc-rows-corr 0 (list (fn-held-with-withdrawn row (cons wide (+ wide 1)))) 0 fn-lbc log)
             (fn-lc-locators-resolve fn-lbc log)
             (equal (fn-lbc-withdrawn 0 fn-lbc) (cons wide (+ wide 1)))
             (fn-lbc-p fn-lbc) (fn-lbc-escape-cellsp 0 fn-lbc)
             (fn-lbc-flag 0 *fn-lbc-escaped-bit* fn-lbc)
             (equal (fn-lbc-word :withdrawal-at 0 fn-lbc) 0)
             (equal (fn-lbc-word :withdrawal-by 0 fn-lbc) 0)))
          (fn-lbc (fn-lbc-set-withdrawal 0 2 9 fn-lbc)))
    (mv (and ordinary escaped (fn-lbc-p fn-lbc)
          (fn-lbc-rows-corr 0 (list (fn-held-with-withdrawn row '(2 . 9))) 0 fn-lbc log)
          (fn-lc-locators-resolve fn-lbc log)
          (fn-lbc-escape-cellsp 0 fn-lbc)
          (equal (fn-lbc-withdrawn 0 fn-lbc) '(2 . 9))
          (not (fn-lbc-escape 0 :withdrawal-at fn-lbc))
          (not (fn-lbc-escape 0 :withdrawal-by fn-lbc))) fn-lbc)) ok)))
(with-guard-checking-event t (assert-event (fn-lbcwd-native-control)))

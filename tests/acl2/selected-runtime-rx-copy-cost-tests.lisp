(in-package "ACL2")
(include-book "../../books/assumptions-selected-runtime-rx-copy-cost")
; MODEL ONLY, not an actual typed-array runtime trajectory.
(encapsulate ()
 (local (defun srxc-t-object (a b c d e)
  (if (fn-srxc-domain-p a b c d e) 0 1)))
 (local (defun srxc-t-stack (a b c d e)
  (if (fn-srxc-domain-p a b c d e) 192 193)))
 (local (assert-event
  (let ((e *fn-srxc-coordinate*))
   (and (fn-srxc-domain-p 0 4096 4096 4096 e)
        (equal (srxc-t-object 0 4096 4096 4096 e) 0)
        (<= (srxc-t-stack 0 4096 4096 4096 e) 192)
        (mv-let (tag object stack)
            (fn-srxc-success-component-request 0 4096 4096 4096 e)
          (and (equal tag :success-component) (equal object 0) (equal stack 192)))))))

 ; Every retained domain clause has an explicit complete model removal.
 (local (defun srxc-t-clauses (a b c d e)
  (list (equal e *fn-srxc-coordinate*) (natp a) (natp b) (<= a b) (<= b 4096)
        (natp c) (< c (expt 2 44)) (natp d) (< d (expt 2 44)) (<= b c) (<= b d))))
 (local (defun srxc-t-only-false (xs index)
  (if (consp xs)
   (and (if (equal index 0) (not (car xs)) (car xs))
        (srxc-t-only-false (cdr xs) (1- index))) t)))
 ; Explicit cases use malformed logical capacities/ranges, never native calls.
 (local (defun srxc-t-cases-p (cases)
  (if (consp cases)
   (let* ((x (car cases)) (i (nth 0 x)) (a (nth 1 x)) (b (nth 2 x))
          (c (nth 3 x)) (d (nth 4 x)) (e (nth 5 x)))
    (and (srxc-t-only-false (srxc-t-clauses a b c d e) i)
         (not (fn-srxc-domain-p a b c d e))
         (not (equal (srxc-t-object a b c d e) 0))
         (not (<= (srxc-t-stack a b c d e) 192))
         (mv-let (tag object stack) (fn-srxc-success-component-request a b c d e)
          (and (equal tag :unavailable) (equal object nil) (equal stack nil)))
         (srxc-t-cases-p (cdr cases)))) t)))
 (local (assert-event
  (srxc-t-cases-p
   (list (list 0 0 1 1 1 :wrong)
         (list 1 -1 0 1 1 *fn-srxc-coordinate*)
         (list 2 0 1/2 1 1 *fn-srxc-coordinate*)
         (list 3 2 1 2 2 *fn-srxc-coordinate*)
         (list 4 0 4097 4097 4097 *fn-srxc-coordinate*)
         (list 5 0 0 1/2 1 *fn-srxc-coordinate*)
         (list 6 0 0 (expt 2 44) 1 *fn-srxc-coordinate*)
         (list 7 0 0 1 1/2 *fn-srxc-coordinate*)
         (list 8 0 0 1 (expt 2 44) *fn-srxc-coordinate*)
         (list 9 0 2 1 2 *fn-srxc-coordinate*)
         (list 10 0 2 2 1 *fn-srxc-coordinate*))))))

; Actual paid source byte trace, with complete retained hypothesis teeth.
(in-package "ACL2")
(include-book "../../books/post-identity-captured-source-trace")
(include-book "post-identity-captured-source-continuation-tests")
(defconst *pic-stt-origin* (fn-pic-parser *pic-ajt-entry*))
(defconst *pic-stt-first* (nth 1 (mv-list 3 (fn-pic-feed-funded *pic-ajt-entry* :control 1))))
(defthm pic-stt-producer-positive
 (let* ((c *pic-ajt-entry*) (a (fn-pic-start-parser :source-incoming :source-incoming c))
        (b (fn-pic-start-parser :source-held :source-held c)))
  (and (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*)
       (fn-pic-agent-shapep c) (member-eq :source-incoming '(:source-incoming :source-held))
       (member-eq :source-held '(:source-incoming :source-held))
       (fn-pic-source-tracep a 0 (fn-pic-parser a) *pic-test-stamped* *pic-spt-held*)
       (fn-pic-source-tracep b 0 (fn-pic-parser b) *pic-test-stamped* *pic-spt-held*))) :rule-classes nil)
(defthm pic-stt-producer-context-removal-corrupted-held-extent
 (let* ((c (fn-pic-set held-n 146 *pic-ajt-entry*)) (d (fn-pic-start-parser :source-held :source-held c)))
  (and (not (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*))
       (fn-pic-agent-shapep c) (member-eq :source-held '(:source-incoming :source-held))
       (not (fn-pic-source-tracep d 0 (fn-pic-parser d) *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defthm pic-stt-producer-shape-removal-corrupted-improper-agent
 (let* ((c *pic-sxt-corrupt*) (d (fn-pic-start-parser :source-held :source-held c)))
  (and (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*)
       (not (fn-pic-agent-shapep c)) (member-eq :source-held '(:source-incoming :source-held))
       (not (fn-pic-source-tracep d 0 (fn-pic-parser d) *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defthm pic-stt-producer-mode-removal-corrupted-call
 (let* ((c *pic-ajt-entry*) (d (fn-pic-start-parser :agent :agent c)))
  (and (fn-pic-source-pair-agent-contextp c *pic-test-stamped* *pic-spt-held*)
       (fn-pic-agent-shapep c) (not (member-eq :agent '(:source-incoming :source-held)))
       (not (fn-pic-source-tracep d 0 (fn-pic-parser d) *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defthm pic-stt-funded-control-positive
 (let* ((c *pic-ajt-entry*) (d (mv-nth 1 (fn-pic-feed-funded c :control 1))))
  (and (fn-pic-source-tracep c 0 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
       (equal (fn-pic-observed-byte (fn-pic-demand c) :control)
              (fn-psc-model-demanded-byte (fn-pic-parser c) *pic-test-stamped* *pic-spt-held*))
       (equal (fn-pic-get phase d) (fn-pic-get phase c))
       (not (fn-pic-source-tracep d 0 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*))
       (fn-pic-source-tracep d 1 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*))) :rule-classes nil)
(defthm pic-stt-funded-byte-positive
 (let* ((c *pic-stt-first*) (obs (pic-ajt-observation c *pic-test-stamped*))
        (d (mv-nth 1 (fn-pic-feed-funded c obs 1))))
  (and (fn-pic-source-tracep c 1 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
       (equal (fn-pic-observed-byte (fn-pic-demand c) obs)
              (fn-psc-model-demanded-byte (fn-pic-parser c) *pic-test-stamped* *pic-spt-held*))
       (equal (fn-pic-get phase d) (fn-pic-get phase c))
       (or (fn-pic-source-tracep d 1 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
           (fn-pic-source-tracep d 2 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*))
       (fn-pic-source-tracep d 2 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*))) :rule-classes nil)
(defthm pic-stt-readonly-and-pooled-byte-positive
 (let* ((c *pic-stt-first*) (a (mv-nth 1 (fn-pic-next c 2 *pic-test-stamped*)))
        (b (mv-nth 1 (fn-pic-held-next c 2 *pic-test-stamped* *pic-sxt-pool*))))
  (and (fn-pic-source-tracep c 1 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
       (equal (fn-pic-get phase a) (fn-pic-get phase c))
       (equal (fn-pic-get phase b) (fn-pic-get phase c))
       (or (fn-pic-source-tracep a 1 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
           (fn-pic-source-tracep a 2 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*))
       (or (fn-pic-source-tracep b 1 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
           (fn-pic-source-tracep b 2 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*))
       (fn-pic-source-tracep a 2 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
       (fn-pic-source-tracep b 2 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*))) :rule-classes nil)
(defthm pic-stt-byte-agreement-removal-mutated-observation
 (let* ((c *pic-stt-first*) (obs (update-nth 3 67 (pic-ajt-observation c *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-feed-funded c obs 1))))
  (and (fn-pic-source-tracep c 1 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
       (fn-pic-observation-okp c (fn-pic-demand c) obs)
       (not (equal (fn-pic-observed-byte (fn-pic-demand c) obs)
                   (fn-psc-model-demanded-byte (fn-pic-parser c) *pic-test-stamped* *pic-spt-held*)))
       (equal (fn-pic-get phase d) (fn-pic-get phase c))
       (not (or (fn-pic-source-tracep d 1 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
                (fn-pic-source-tracep d 2 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*))))) :rule-classes nil)
(defthm pic-stt-trace-removal-corrupted-parser-span
 (let* ((c (fn-pic-set parser (fn-psc-set agent-start (+ 1 (fn-psc-get agent-start *pic-stt-origin*))
                                          *pic-stt-origin*) *pic-ajt-entry*))
        (a (mv-nth 1 (fn-pic-feed-funded c :control 0)))
        (b (mv-nth 1 (fn-pic-next c 0 *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-held-next c 0 *pic-test-stamped* *pic-sxt-pool*))))
  (and (not (fn-pic-source-tracep c 0 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*))
       (equal (fn-pic-observed-byte (fn-pic-demand c) :control)
              (fn-psc-model-demanded-byte (fn-pic-parser c) *pic-test-stamped* *pic-spt-held*))
       (equal (fn-pic-get phase a) (fn-pic-get phase c))
       (equal (fn-pic-get phase b) (fn-pic-get phase c))
       (equal (fn-pic-get phase d) (fn-pic-get phase c))
       (not (or (fn-pic-source-tracep a 0 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
                (fn-pic-source-tracep a 1 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)))
       (not (or (fn-pic-source-tracep b 0 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
                (fn-pic-source-tracep b 1 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)))
       (not (or (fn-pic-source-tracep d 0 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
                (fn-pic-source-tracep d 1 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*))))) :rule-classes nil)
(defun pic-stt-before-change (c incoming ticks count)
 (declare (xargs :measure (nfix ticks) :verify-guards nil))
 (if (zp ticks) (list c count)
  (let ((d (nth 1 (mv-list 3 (fn-pic-feed-funded c (pic-ajt-observation c incoming) 1)))))
   (if (not (equal (fn-pic-get phase d) (fn-pic-get phase c))) (list c count)
    (pic-stt-before-change d incoming (1- ticks) (+ 1 (nfix count)))))))
(defconst *pic-stt-before-held*
 (pic-stt-before-change *pic-sct-short-entry* *pic-test-stamped* 2000 0))
(defthm pic-stt-same-phase-removal-actual-source-switch
 (let* ((c (car *pic-stt-before-held*)) (ticks (cadr *pic-stt-before-held*))
        (origin (fn-pic-parser *pic-sct-short-entry*)) (obs (pic-ajt-observation c *pic-test-stamped*))
        (a (mv-nth 1 (fn-pic-feed-funded c obs 1)))
        (b (mv-nth 1 (fn-pic-next c 2 *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-held-next c 2 *pic-test-stamped* *pic-sxt-pool*))))
  (and (fn-pic-source-tracep c ticks origin *pic-test-stamped* *pic-sct-short-held*)
       (equal (fn-pic-observed-byte (fn-pic-demand c) obs)
              (fn-psc-model-demanded-byte (fn-pic-parser c) *pic-test-stamped* *pic-sct-short-held*))
       (equal (fn-pic-get phase c) :source-incoming)
       (equal (fn-pic-get phase a) :source-held) (equal (fn-pic-get phase b) :source-held)
       (equal (fn-pic-get phase d) :source-held)
       (not (equal (fn-pic-get phase a) (fn-pic-get phase c)))
       (not (equal (fn-pic-get phase b) (fn-pic-get phase c)))
       (not (equal (fn-pic-get phase d) (fn-pic-get phase c)))
       (not (or (fn-pic-source-tracep a ticks origin *pic-test-stamped* *pic-sct-short-held*)
                (fn-pic-source-tracep a (+ 1 ticks) origin *pic-test-stamped* *pic-sct-short-held*)))
       (not (or (fn-pic-source-tracep b ticks origin *pic-test-stamped* *pic-sct-short-held*)
                (fn-pic-source-tracep b (+ 1 ticks) origin *pic-test-stamped* *pic-sct-short-held*)))
       (not (or (fn-pic-source-tracep d ticks origin *pic-test-stamped* *pic-sct-short-held*)
                (fn-pic-source-tracep d (+ 1 ticks) origin *pic-test-stamped* *pic-sct-short-held*))))) :rule-classes nil)
(defthm pic-stt-actual-entry-positive
 (let* ((c *pic-ajt-before*) (a (mv-nth 1 (fn-pic-next c 1 *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*))))
  (and (fn-pic-source-pair-contextp c *pic-test-stamped* *pic-spt-held*)
       (fn-pic-agent-tracep c *pic-ajt-ticks* *pic-test-stamped*)
       (equal (fn-pic-get phase a) :source-incoming) (equal (fn-pic-get phase d) :source-incoming)
       (equal (fn-ioh-access (fn-ibc-carrier-row (fn-prp-incoming-slot *pic-sxt-pool*))
                             (fn-pic-get incoming-token c) :read) :holder-readonly)
       (fn-pic-source-tracep a 0
        (fn-pic-parser (fn-pic-start-parser :source-incoming :source-incoming a)) *pic-test-stamped* *pic-spt-held*)
       (fn-pic-source-tracep d 0
        (fn-pic-parser (fn-pic-start-parser :source-incoming :source-incoming d)) *pic-test-stamped* *pic-spt-held*))) :rule-classes nil)
(defthm pic-stt-entry-context-removal-corrupted-held-extent
 (let* ((c (fn-pic-set held-n 146 *pic-ajt-before*))
        (a (mv-nth 1 (fn-pic-next c 1 *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*))))
  (and (not (fn-pic-source-pair-contextp c *pic-test-stamped* *pic-spt-held*))
       (fn-pic-agent-tracep c *pic-ajt-ticks* *pic-test-stamped*)
       (equal (fn-pic-get phase a) :source-incoming) (equal (fn-pic-get phase d) :source-incoming)
       (equal (fn-ioh-access (fn-ibc-carrier-row (fn-prp-incoming-slot *pic-sxt-pool*))
                             (fn-pic-get incoming-token c) :read) :holder-readonly)
       (not (fn-pic-source-tracep a 0
        (fn-pic-parser (fn-pic-start-parser :source-incoming :source-incoming a)) *pic-test-stamped* *pic-spt-held*))
       (not (fn-pic-source-tracep d 0
        (fn-pic-parser (fn-pic-start-parser :source-incoming :source-incoming d)) *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defthm pic-stt-entry-agent-trace-removal-corrupted-span
 (let* ((p (fn-pic-parser *pic-ajt-before*))
        (c (fn-pic-set parser (fn-psc-set agent-start (+ 1 (fn-psc-get agent-start p)) p) *pic-ajt-before*))
        (a (mv-nth 1 (fn-pic-next c 1 *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*))))
  (and (fn-pic-source-pair-contextp c *pic-test-stamped* *pic-spt-held*)
       (not (fn-pic-agent-tracep c *pic-ajt-ticks* *pic-test-stamped*))
       (equal (fn-pic-get phase a) :source-incoming) (equal (fn-pic-get phase d) :source-incoming)
       (equal (fn-ioh-access (fn-ibc-carrier-row (fn-prp-incoming-slot *pic-sxt-pool*))
                             (fn-pic-get incoming-token c) :read) :holder-readonly)
       (not (fn-pic-source-tracep a 0
        (fn-pic-parser (fn-pic-start-parser :source-incoming :source-incoming a)) *pic-test-stamped* *pic-spt-held*))
       (not (fn-pic-source-tracep d 0
        (fn-pic-parser (fn-pic-start-parser :source-incoming :source-incoming d)) *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defthm pic-stt-entry-phase-removal-pending
 (let* ((c *pic-ajt-start*) (a (mv-nth 1 (fn-pic-next c 1 *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-held-next c 1 *pic-test-stamped* *pic-sxt-pool*))))
  (and (fn-pic-source-pair-contextp c *pic-test-stamped* *pic-spt-held*)
       (fn-pic-agent-tracep c 0 *pic-test-stamped*)
       (not (equal (fn-pic-get phase a) :source-incoming)) (not (equal (fn-pic-get phase d) :source-incoming))
       (equal (fn-ioh-access (fn-ibc-carrier-row (fn-prp-incoming-slot *pic-sxt-pool*))
                             (fn-pic-get incoming-token c) :read) :holder-readonly)
       (not (fn-pic-source-tracep a 0
        (fn-pic-parser (fn-pic-start-parser :source-incoming :source-incoming a)) *pic-test-stamped* *pic-spt-held*))
       (not (fn-pic-source-tracep d 0
        (fn-pic-parser (fn-pic-start-parser :source-incoming :source-incoming d)) *pic-test-stamped* *pic-spt-held*)))) :rule-classes nil)
(defun pic-stt-pooled-byte-resumption-positive ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-page-read-pool
  (mv-let (ok fn-page-read-pool)
   (let* ((carrier (fn-ibc-carrier (list :input-backing 4 (len *pic-test-stamped*))
                                  (list *pic-test-incoming* :readonly '(0 0 0 0 1))))
          (fn-page-read-pool (update-fn-prp-incoming-slot carrier fn-page-read-pool)))
    (mv (with-local-stobj fn-octets
     (mv-let (ok fn-octets)
      (let* ((fn-octets (fn-octets-from-list *pic-test-stamped* fn-octets))
             (c (nth 1 (mv-list 3 (fn-pic-next *pic-ajt-entry* 1 fn-octets)))))
       (mv-let (status d left) (fn-pic-held-next c 2 fn-octets fn-page-read-pool)
        (mv (and (equal (fn-pic-at 0 (fn-pic-demand c)) :incoming)
                 (fn-pic-source-tracep c 1 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
                 (equal status :continue) (equal left 0)
                 (member-eq (fn-pic-get phase d) '(:source-incoming :source-held))
                 (fn-pic-source-tracep d 2 *pic-stt-origin* *pic-test-stamped* *pic-spt-held*)
                 (not (equal c d))
                 (equal (fn-octets-list fn-octets) *pic-test-stamped*)
                 (equal (fn-prp-incoming-slot fn-page-read-pool) carrier)) fn-octets)))
      ok)) fn-page-read-pool))
   ok)))
(assert-event (pic-stt-pooled-byte-resumption-positive))

(in-package "ACL2")
(include-book "../../books/bp-digest-install-stored-plan")
(include-book "bp-controller-checkpoint-payload-directory-tests")
; Unfunded local registered storage only. The workspace intent is deliberately
; seeded; no installed allowance, workspace issuer, persisted prefix, native
; factory permission, or constructor envelope is asserted by this test.
(defun fn-bpdis-storage-observe (fn-bp-controller-registry fn-page-read-pool)
 (declare (xargs :stobjs (fn-bp-controller-registry fn-page-read-pool) :guard t))
 (mv-let (reserved job-token reserve-left fn-bp-controller-registry fn-page-read-pool)
  (fn-owner-bp-checkpoint-reserve '(:bp-controller 2 0) '(8192 4096 1 1 1)
                                 4 fn-bp-controller-registry fn-page-read-pool)
  (declare (ignore reserve-left))
  (let* ((controller '(:bp-controller 2 0))
         (workspace (list :bp-digest 8 controller job-token))
         (job (list :bp-checkpoint-job job-token 0 5 1 nil :digest-finish nil 1 64 15 :private))
         (source (list :bp-checkpoint-stage job-token 5))
         (intent (fn-bpdi-make workspace :reserved source '(512 0 0 0 1) nil))
         (payload (fn-bpck-control-make job '(:digest-start :pending) intent nil))
         (ledger (fn-owner-page-read-ledger fn-page-read-pool)))
   (mv-let (updated current claim kept phase revision update-left fn-bp-controller-registry)
    (fn-bpcc-directory-payload controller job-token :replace 0 :reserved :running
                               payload 4 fn-bp-controller-registry)
    (declare (ignore current claim kept phase revision update-left))
    (mv-let (before before-plan before-left fn-bp-controller-registry)
     (fn-owner-bp-digest-install-plan controller workspace 4 fn-bp-controller-registry)
     (declare (ignore before-left))
     (mv-let (yielded yield-left fn-bp-controller-registry fn-page-read-pool)
      (fn-owner-bp-digest-install-constructing controller workspace 1 fn-bp-controller-registry fn-page-read-pool)
      (mv-let (constructed construct-left fn-bp-controller-registry fn-page-read-pool)
       (fn-owner-bp-digest-install-constructing controller workspace 8 fn-bp-controller-registry fn-page-read-pool)
       (mv-let (word plan left fn-bp-controller-registry)
        (fn-owner-bp-digest-install-plan controller workspace 4 fn-bp-controller-registry)
        (mv-let (repeat repeat-left fn-bp-controller-registry fn-page-read-pool)
         (fn-owner-bp-digest-install-constructing controller workspace 4 fn-bp-controller-registry fn-page-read-pool)
         (declare (ignore repeat-left))
         (mv-let (fenced fence-left fn-bp-controller-registry fn-page-read-pool)
          (fn-owner-bp-checkpoint-payload-fence-current controller 4 fn-bp-controller-registry fn-page-read-pool)
          (declare (ignore fence-left))
          (mv-let (after after-plan after-left fn-bp-controller-registry)
           (fn-owner-bp-digest-install-plan controller workspace 4 fn-bp-controller-registry)
           (declare (ignore after-left))
           (mv (and (eq reserved :checkpoint-reserved)
                    (eq updated :checkpoint-updated)
                    (eq before :stale-install) (not before-plan)
                    (eq yielded :yield) (equal yield-left 0)
                    (eq constructed :constructing) (equal construct-left 5)
                    (eq word :stored-plan) (equal left 2)
                    (equal plan (list :bp-digest-install workspace controller job-token source :constructing 2))
                    (eq repeat :stale-install)
                    (eq fenced :checkpoint-retained)
                    (eq after :stale-install) (not after-plan)
                    (equal ledger (fn-owner-page-read-ledger fn-page-read-pool)))
               fn-bp-controller-registry fn-page-read-pool))))))))))))

(defun fn-bpdis-storage-local ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-bp-controller-registry
  (mv-let (answer fn-bp-controller-registry)
   (with-local-stobj fn-page-read-pool
    (mv-let (answer fn-bp-controller-registry fn-page-read-pool)
     (mv-let (fn-bp-controller-registry fn-page-read-pool)
      (fn-bpcc-payload-directory-test-install fn-bp-controller-registry fn-page-read-pool)
      (fn-bpdis-storage-observe fn-bp-controller-registry fn-page-read-pool))
     (mv answer fn-bp-controller-registry))) answer)))
(assert-event (fn-bpdis-storage-local))

(defun fn-crvp-fixture-5 ()
 (declare (xargs :guard t))
 (with-local-stobj fn-arena
  (mv-let (ok fn-arena)
   (with-local-stobj fn-octets
    (mv-let (ok fn-arena fn-octets)
     (let* ((h (fn-arena-count fn-arena)) (fn-arena (fn-arena-seal-list '(65) fn-arena)))
      (let* ((row (fn-record-make 1 2 3 "<m>" h '("a") "o" "s" "e" 1 0))
             (a (fn-make-article "<m>" h '("a") '(("a" . 1)) t 0))
             (p (list :report-input (list :current-article a) '("a") '(("a" . 1))))
             (start (fn-crvp-begin '(key) :visible p row 1 0 fn-arena))
             (bad (fn-crvp-state '(key) :prepare row '("bad name") '("bad name") 0 0 1 4096 0 0 0 nil nil nil)))
       (mv-let (answer final fn-octets)
        (fn-crvp-test-run (fn-cp-nth 1 start) '(key) 4096 10 fn-arena fn-octets)
        (declare (ignore final))
        (mv (and (equal answer '(:refused :oversize)) (equal (fn-octets-list fn-octets) nil)
                 (equal (fn-crvp-plan bad '(key) 0 4096 fn-arena) '(:refused :remote-visible-group-codec)))
            fn-arena fn-octets))))
     (mv ok fn-arena)))
   ok)))

(assert-event (fn-crvp-fixture-5))

(defun fn-crxs-exec-v4 (accepted state)
 (declare (xargs :stobjs state :mode :program))
(with-local-stobj fn-rx-provider
 (mv-let (result fn-rx-provider state)
 (with-local-stobj fn-receiver-turn
 (mv-let (result fn-rx-provider fn-receiver-turn state)
 (with-local-stobj fn-index-backing
 (mv-let (result fn-rx-provider fn-receiver-turn fn-index-backing state)
 (with-local-stobj fn-page-read-pool
 (mv-let (result fn-rx-provider fn-receiver-turn fn-index-backing fn-page-read-pool state)
 (fn-crxs-chain-v4 accepted fn-rx-provider fn-receiver-turn fn-index-backing fn-page-read-pool state)
 (mv result fn-rx-provider fn-receiver-turn fn-index-backing state)))
 (mv result fn-rx-provider fn-receiver-turn state)))
 (mv result fn-rx-provider state)))
 (mv result state))))

(make-event
 (let ((before (fn-owner-rx-connection-issued state)))
  (mv-let (accepted state) (fn-crxs-exec-v4 t state)
   (mv-let (refused state) (fn-crxs-exec-v4 nil state)
    (let* ((ok (and (equal (take 9 accepted) '(t t t t t t t t t))
                    (equal (take 9 refused) '(t t t t t t t t t))))
           (state (f-put-global 'fn-owner-rx-connection-issued before state)))
     (if ok (value '(value-triple :passed-actual-repin-state-chain))
       (er soft 'fn-crxs-exec-v4 "Actual accepted/refused STATE chain failed.")))))))

(defun pic-sft-before-path-byte (c incoming held budget ticks)
 (declare (xargs :measure (nfix budget) :verify-guards nil))
 (if (or (zp budget)
         (and (equal (fn-psc-get phase (fn-pic-parser c)) :path-scan)
              (equal (fn-psc-get prev (fn-pic-parser c)) :bol)
              (not (fn-psc-get aux (fn-pic-parser c)))
              (equal (fn-pic-at 0 (fn-pic-demand c)) :held))) (list c ticks)
  (pic-sft-before-path-byte
   (nth 1 (mv-list 3 (fn-pic-feed-funded c (pic-sft-observation c incoming held) 1)))
   incoming held (1- budget) (+ 1 (nfix ticks)))))

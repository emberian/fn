        (p (fn-psc-model-byte-run 1 origin *pic-test-stamped* *pic-sct-short-held*))
        (r (fn-psc-result p))
        (e (fn-pic-set incoming-desc (fn-pic-source-result r (fn-pic-get incoming-n c))
                        (fn-pic-set parser p c))))
  (and (equal (fn-ioh-access (fn-ibc-carrier-row (fn-prp-incoming-slot *pic-sxt-pool*))
                             (fn-pic-get incoming-token c) :read) :holder-readonly)
       (fn-pic-source-tracep c 0 origin *pic-test-stamped* *pic-sct-short-held*)
       (equal (fn-pic-get phase c) :source-incoming)
       (not (member-eq (fn-pic-get phase d) '(:source-held :magic)))
       (not (and (not (equal r :pending))
        (equal d (if (< (nfix (fn-pic-get held-n c)) *fn-rcl-tombstone-fixed*)
                     (fn-pic-start-parser :source-held :source-held e)
                   (fn-pic-set phase :magic (fn-pic-set pos 0 e)))))))) :rule-classes nil)

(defconst *pic-sft-magic-before*
 (pic-sft-before-change *pic-ajt-entry* *pic-test-stamped* *pic-spt-held* 2000 0))
(defthm pic-sft-incoming-magic-branch-positive
 (let* ((c (car *pic-sft-magic-before*)) (ticks (cadr *pic-sft-magic-before*))
        (origin (fn-pic-parser *pic-ajt-entry*))
        (a (mv-nth 1 (fn-pic-next c 2 *pic-test-stamped*)))
        (d (mv-nth 1 (fn-pic-held-next c 2 *pic-test-stamped* *pic-sxt-pool*)))
        (p (fn-psc-model-byte-run (+ 1 ticks) origin *pic-test-stamped* *pic-spt-held*))
        (r (fn-psc-result p))
        (e (fn-pic-set incoming-desc (fn-pic-source-result r (fn-pic-get incoming-n c))
                        (fn-pic-set parser p c))))
  (and (fn-pic-source-tracep c ticks origin *pic-test-stamped* *pic-spt-held*)
       (equal (fn-pic-get phase c) :source-incoming)
       (member-eq (fn-pic-get phase a) '(:source-held :magic))
       (member-eq (fn-pic-get phase d) '(:source-held :magic))
       (equal (fn-ioh-access (fn-ibc-carrier-row (fn-prp-incoming-slot *pic-sxt-pool*))
                             (fn-pic-get incoming-token c) :read) :holder-readonly)
       (not (equal r :pending))
       (equal a (if (< (nfix (fn-pic-get held-n c)) *fn-rcl-tombstone-fixed*)
                     (fn-pic-start-parser :source-held :source-held e)
                   (fn-pic-set phase :magic (fn-pic-set pos 0 e))))
       (equal d a) (equal (fn-pic-get phase d) :magic)
       (equal (fn-pic-get incoming-desc d) '(45 45 45)))) :rule-classes nil)
(defun pic-sft-pooled-completion-input-frame-positive ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-page-read-pool
  (mv-let (ok fn-page-read-pool)
   (let* ((carrier (fn-ibc-carrier (list :input-backing 4 (len *pic-test-stamped*))
                                  (list *pic-test-incoming* :readonly '(0 0 0 0 1))))
          (fn-page-read-pool (update-fn-prp-incoming-slot carrier fn-page-read-pool)))
    (mv (with-local-stobj fn-octets
     (mv-let (ok fn-octets)
      (let* ((fn-octets (fn-octets-from-list *pic-test-stamped* fn-octets))
             (incoming-c (car *pic-stt-before-held*)) (held-c (car *pic-sft-held-before*)))
       (mv-let (incoming-status incoming-d incoming-left)
        (fn-pic-held-next incoming-c 2 fn-octets fn-page-read-pool)
        (mv-let (held-status held-d held-left)
         (fn-pic-held-next held-c 2 fn-octets fn-page-read-pool)
         (mv (and (equal incoming-status :continue) (equal held-status :continue)
                  (equal incoming-left 1) (equal held-left 1)
                  (equal (fn-pic-get phase incoming-d) :source-held)
                  (equal (fn-pic-get incoming-desc incoming-d) '(45 45 45))
                  (equal (fn-pic-get phase held-d) :compare-incoming)
                  (equal (fn-pic-get incoming-desc held-d) '(0 0 0))
                  (equal (fn-pic-get held-desc held-d) '(0 0 0))
                  (equal (fn-octets-list fn-octets) *pic-test-stamped*)
                  (equal (fn-prp-incoming-slot fn-page-read-pool) carrier)) fn-octets))))
      ok)) fn-page-read-pool))
   ok)))
(assert-event (pic-sft-pooled-completion-input-frame-positive))

(defthm pic-sft-complete-status-and-shared-fuel-positive
 (let* ((incoming-c (car *pic-stt-before-held*)) (held-c (car *pic-sft-held-before*))
        (conflict-c (car *pic-sft-short-before*))
        (a (mv-nth 1 (fn-pic-next incoming-c 2 *pic-test-stamped*)))
        (b (mv-nth 1 (fn-pic-next held-c 2 *pic-test-stamped*)))

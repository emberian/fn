(defun pic-sft-observation (c incoming held)
 (let* ((d (fn-pic-demand c)) (i (fn-pic-at 1 d)))
  (cond ((equal d :control) :control)
        ((equal (fn-pic-at 0 d) :held)
         (list :payload-byte (fn-pic-get selected c) (fn-pic-get grant c)
          (fn-record-payload (fn-pic-get held c)) i (nth i held)))
        (t (pic-ajt-observation c incoming)))))
(defun pic-sft-before-change (c incoming held budget ticks)
 (declare (xargs :measure (nfix budget) :verify-guards nil))
 (if (zp budget) (list c ticks)
  (let ((d (nth 1 (mv-list 3 (fn-pic-feed-funded c (pic-sft-observation c incoming held) 1)))))
   (if (not (equal (fn-pic-get phase d) (fn-pic-get phase c))) (list c ticks)
    (pic-sft-before-change d incoming held (1- budget) (+ 1 (nfix ticks)))))))
(defconst *pic-sft-held-origin*
 (fn-pic-start-parser :source-held :source-held
  (fn-pic-set held-n (len *pic-test-stamped*) *pic-ajt-entry*)))
(defconst *pic-sft-held-before*
 (pic-sft-before-change *pic-sft-held-origin* *pic-test-stamped* *pic-test-stamped* 2000 0))
(defthm pic-sft-incoming-completion-positive
 (let* ((c (car *pic-stt-before-held*)) (ticks (cadr *pic-stt-before-held*))
        (origin (fn-pic-parser *pic-sct-short-entry*))
        (d (mv-nth 1 (fn-pic-next c 2 *pic-test-stamped*)))
        (p (fn-psc-model-byte-run (+ 1 ticks) origin *pic-test-stamped* *pic-sct-short-held*))
        (r (fn-psc-result p))
        (e (fn-pic-set incoming-desc (fn-pic-source-result r (fn-pic-get incoming-n c))
                        (fn-pic-set parser p c))))
  (and (fn-pic-source-tracep c ticks origin *pic-test-stamped* *pic-sct-short-held*)
       (equal (fn-pic-get phase c) :source-incoming)
       (member-eq (fn-pic-get phase d) '(:source-held :magic))
       (not (equal r :pending))
       (equal d (if (< (nfix (fn-pic-get held-n c)) *fn-rcl-tombstone-fixed*)
                     (fn-pic-start-parser :source-held :source-held e)
                   (fn-pic-set phase :magic (fn-pic-set pos 0 e))))
       (equal (fn-pic-get phase d) :source-held)
       (equal (fn-pic-get incoming-desc d) '(45 45 45)))) :rule-classes nil)
(defthm pic-sft-held-completion-positive-whole-fallback
 (let* ((c (car *pic-sft-held-before*)) (ticks (cadr *pic-sft-held-before*))
        (origin (fn-pic-parser *pic-sft-held-origin*))
        (obs (pic-sft-observation c *pic-test-stamped* *pic-test-stamped*))
        (d (mv-nth 1 (fn-pic-feed-funded c obs 1)))
        (p (fn-psc-model-byte-run (+ 1 ticks) origin *pic-test-stamped* *pic-test-stamped*))
        (r (fn-psc-result p)))
  (and (fn-pic-source-tracep c ticks origin *pic-test-stamped* *pic-test-stamped*)
       (equal (fn-pic-get phase c) :source-held)
       (equal (fn-pic-observed-byte (fn-pic-demand c) obs)
              (fn-psc-model-demanded-byte (fn-pic-parser c) *pic-test-stamped* *pic-test-stamped*))
       (member-eq (fn-pic-get phase d) '(:compare-incoming :done))
       (not (equal (fn-pic-get result d) :refused))
       (not (equal r :pending))
       (equal d (fn-pic-compare-start
                  (fn-pic-set held-desc (fn-pic-source-result r (fn-pic-get held-n c))
                   (fn-pic-set parser p c))))
       (equal (fn-pic-get phase d) :compare-incoming)
       (not (fn-pic-get incoming-desc c))
       (fn-pic-source-result r (fn-pic-get held-n c))
       (equal (fn-pic-get incoming-desc d) '(0 0 0))
       (equal (fn-pic-get held-desc d) '(0 0 0)))) :rule-classes nil)


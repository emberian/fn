(in-package "ACL2")
(include-book "../../books/history-semantic-writer")
(assert-event
 (let* ((token '(:admission-grant 2 7 9 9 91 :article))
        (current (list token nil :reserved nil nil))
        (parent '(:history-installed 3 4 5 6 7)))
   (and (equal (fn-hsw-gate token current parent parent 7) :writer-current)
        (equal (fn-hsw-gate token current parent '(:history-installed 8 4 5 6 7) 7)
               :writer-source-changed)
        (equal (fn-hsw-gate token current parent '(:history-installed 3 4 5 8 7) 7)
               :writer-source-changed)
        (equal (fn-hsw-gate token current parent parent 8) :writer-source-changed)
        (equal (fn-hsw-gate token (list token nil :uncertain nil nil) parent parent 7)
               :recovery-required)
        (equal (fn-hsw-gate token nil parent parent 7) :writer-stale))))

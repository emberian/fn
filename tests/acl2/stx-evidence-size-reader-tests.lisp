(in-package "ACL2")
(include-book "../../books/stx-evidence-size-reader")
(include-book "../../books/statement-attach")
(defconst *stxst-event* (fn-stxe-make 1 2 2 "<a@x>" :unverified '(9) 0 '(1)))
(defconst *stxst-wire* (fn-stxe-encode *stxst-event*))
(defun fn-stxst-positive ()
 (declare (xargs :guard t))
 (mv-let (r sizes) (fn-stxs-decode *stxst-wire*)
  (let ((old (fn-stxe-decode-exact *stxst-wire*)))
   (and (fn-stxe-p *stxst-event*) (fn-stmt-okp r)
        (equal (fn-stmt-okp r) (fn-stmt-okp old))
        (equal (fn-stmt-value r) (fn-stmt-value old))
        (equal (fn-stmt-value r) *stxst-event*)
        (equal sizes '(5 1 1))))))
(assert-event (fn-stxst-positive))
(defun fn-stxst-mutation ()
 (declare (xargs :guard t))
 (mv-let (r sizes) (fn-stxs-decode nil)
  (and (not (fn-stmt-okp r))
       (equal (fn-stmt-okp r) (fn-stmt-okp (fn-stxe-decode-exact nil)))
       (equal sizes nil))))
(assert-event (fn-stxst-mutation))

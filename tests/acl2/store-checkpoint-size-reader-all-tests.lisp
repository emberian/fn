; Literal same-parser consumer-wrapper boundary, not configured recovery authority.
(in-package "ACL2")
(include-book "../../books/store-checkpoint-size-reader-all")
(defun sctall-fixture (fn-octets)
 (declare (xargs :stobjs fn-octets :mode :program))
 (let* ((ctx '(:ok 0 nil nil nil nil))
        (consumer '(:ok ("history" "incarnation" 0 0 0 nil (:authority0 1 nil nil nil))
                       (:account-root :policy nil nil) 0))
        (tables (list (fn-sct-f-row 0 0 "all" nil 0) nil nil
                      (list :distinct-configured-fold ctx consumer nil)))
        (progs (fn-sct-table-programs tables nil))
        (f (nth 0 progs)) (p (nth 1 progs)) (e (nth 2 progs)) (r (nth 3 progs))
        (fb (len f)) (pb (+ fb (len p))) (eb (+ pb (len e))) (rb (+ eb (len r)))
        (fn-octets (fn-octets-clear fn-octets))
        (fn-octets (fn-octets-append-list (append f p e r) fn-octets)))
  (mv-let (result info region consumer-info)
    (fn-sctsr-decode-programs-all 0 fb fb pb pb eb eb rb fn-octets)
   (mv-let (old old-info old-region)
    (fn-sctsr-decode-programs 0 fb fb pb pb eb eb rb fn-octets)
    (mv (and (fn-octets-p fn-octets)
          (natp fb) (natp pb) (natp eb) (natp rb)
          (<= fb pb) (<= pb eb) (<= eb rb) (<= rb (fn-octets-len fn-octets))
          (equal result (list :ok tables))
          (equal result old) (equal info old-info) (equal region old-region)
          (<= (fn-sco-at 1 (fn-sct-tables-f (cadr result))) (1+ *fn-cbor-max-uint*))
          (fn-scsr-info-provenancep info ctx)
          (fn-scsr-info-provenancep consumer-info consumer)
          (fn-scsr-info-provenancep (fn-scsr-info-field 1 consumer-info) (nth 1 consumer))
          (fn-scsr-info-provenancep (fn-scsr-info-field 2 consumer-info) (nth 2 consumer))
          (not (equal consumer :distinct-configured-fold))) fn-octets)))))
(defun sctall-local ()
 (declare (xargs :mode :program))
 (with-local-stobj fn-octets
  (mv-let (ok fn-octets) (sctall-fixture fn-octets) ok)))
(assert-event (sctall-local))
(defun sctall-refusal (fn-octets)
 (declare (xargs :stobjs fn-octets :mode :program))
 (mv-let (result info region consumer-info) (fn-sctsr-load-all nil fn-octets)
  (mv-let (old old-info old-region) (fn-sctsr-load nil fn-octets)
   (mv (and (equal result old) (equal info old-info) (equal region old-region)
            (equal result '(:refused :header)) (null consumer-info)) fn-octets))))
(defun sctall-refusal-local ()
 (declare (xargs :mode :program))
 (with-local-stobj fn-octets
  (mv-let (ok fn-octets) (sctall-refusal fn-octets) ok)))
(assert-event (sctall-refusal-local))

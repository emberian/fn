(in-package "ACL2")
(include-book "../../books/bp-node-checkpoint-digest")

(defun fn-bpck-test-emitted (job quantum acc)
  (declare (xargs :guard t :measure (nfix quantum) :verify-guards nil))
  (if (or (zp (nfix quantum))
          (not (equal (fn-bpn-nth 6 job) :emit))) (list job acc)
    (let ((answer (fn-bpck-emit-step job)))
      (fn-bpck-test-emitted (car answer) (1- (nfix quantum))
                            (append acc (cadr answer))))))

(defun fn-bpck-test-digest-run (job bytes fuel pgs-digest-state)
  (declare (xargs :stobjs pgs-digest-state :measure (nfix fuel)
                  :guard t :verify-guards nil))
  (let ((action (fn-bpck-digest-action job pgs-digest-state)))
    (if (or (zp (nfix fuel)) (equal (car action) :trailer))
        (mv action pgs-digest-state)
      (mv-let (word pgs-digest-state)
        (fn-bpck-digest-step
         job (if (equal (car action) :read)
                 (fn-bpnrc-prefix (fn-bpn-nth 2 action)
                                   (fn-bpnrc-suffix (fn-bpn-nth 1 action) bytes))
               nil) pgs-digest-state)
        (if (member-equal word '(:continue :done))
            (fn-bpck-test-digest-run job bytes (1- (nfix fuel)) pgs-digest-state)
          (mv (list word) pgs-digest-state))))))

(defun fn-bpck-test-digest-example ()
  (declare (xargs :verify-guards nil))
  (let* ((token '(:maintenance 0 7 0))
         (initial (fn-bpck-begin token 7 1 8 nil nil 0 0 10000))
         (counted (fn-bpck-census-step initial 128))
         (emitting (fn-bpck-stage-granted counted (list :grown token)))
         (emitted (fn-bpck-test-emitted emitting 128 nil))
         (job (fn-bpck-stage-observation (car emitted) :created))
         (bytes (cadr emitted)))
    (with-local-stobj pgs-digest-state
      (mv-let (answer pgs-digest-state)
        (mv-let (started pgs-digest-state)
          (fn-bpck-digest-start job pgs-digest-state)
          (mv-let (short pgs-digest-state)
            ; Start has an idle first turn; advance before injecting short read.
            (fn-bpck-digest-step job nil pgs-digest-state)
            (let ((before (pgs-dc-pos pgs-digest-state)))
              (mv-let (missing pgs-digest-state)
                (fn-bpck-digest-step job '(0) pgs-digest-state)
                (let ((unchanged (equal before (pgs-dc-pos pgs-digest-state))))
                  (mv-let (result pgs-digest-state)
                    (fn-bpck-test-digest-run job bytes 128 pgs-digest-state)
                    (mv (and (equal started :started) (equal short :continue)
                             (equal missing :uncertain) unchanged
                             (equal (fn-bpn-nth 6 job) :digest-finish)
                             (equal bytes
                                    (append (fn-bpck-prefix (fn-bpn-nth 8 job))
                                            (fn-bpnr-enc (fn-bpn-nth 5 job) 8)))
                             (equal result (list :trailer (fn-blake3 bytes)))
                             (equal (fn-bpck-digest-action
                                     (fn-bpck-make '(:maintenance 1 7 0) 7 1 8 nil
                                                    :digest-finish nil 0 1000 14 :private)
                                     pgs-digest-state)
                                    '(:uncertain :capture)))
                        pgs-digest-state)))))))
        answer))))

(assert-event (fn-bpck-test-digest-example))

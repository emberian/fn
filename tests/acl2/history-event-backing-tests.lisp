(defun hept-lifecycle (fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :verify-guards nil))
 (mv-let (init fn-history-backing) (hept-init fn-history-backing)
  (let ((preflight (and (eq init :initialized) (fn-hep-offer-currentp *hept-token* fn-history-backing))))
   (mv-let (offer fn-history-backing)
    (fn-hep-offer-produced nil *hept-produced* :context :fields *hept-token* fn-history-backing)
    (mv-let (readout row produced context fields) (fn-hep-builder-readout fn-history-backing)
     (let* ((retained (and preflight (eq offer :offered) (eq readout :candidate)
                           (null row) (equal produced *hept-produced*)
                           (eq context :context) (eq fields :fields)))
            (fn-history-backing (update-fn-hep-producer-receipts
              (list :history-preparation *hept-token* 91 *hept-next* *hept-leaf* 0 :actual-owner-result)
              fn-history-backing))
            (fn-history-backing (update-fn-hep-producer-phase :prepared fn-history-backing))
            (before (hept-view fn-history-backing)))
      (mv-let (wrong fn-history-backing)
       (fn-hep-register-completion-internal '(:history-completion (:history-operation 7) 92)
                                            *hept-token* fn-history-backing)
       (let ((wrong-ok (and retained (eq wrong :unavailable) (equal before (hept-view fn-history-backing)))))
        (mv-let (completed fn-history-backing)
         (fn-hep-register-completion-internal *hept-receipt* *hept-token* fn-history-backing)
         (let ((antecedent (and wrong-ok (eq completed :completed)
                                (fn-hep-completion-matchesp *hept-receipt* *hept-token* fn-history-backing)
                                (eq (fn-hep-producer-phase fn-history-backing) :completed)
                                (equal (fn-hep-completion fn-history-backing) *hept-receipt*)))
               (completed-view (hept-view fn-history-backing)))
          (mv-let (repeat fn-history-backing)
           (fn-hep-register-completion-internal *hept-receipt* *hept-token* fn-history-backing)
           (let ((repeat-ok (and antecedent (eq repeat :already-completed)
                                 (equal completed-view (hept-view fn-history-backing)))))
            (mv-let (published fn-history-backing) (fn-hep-publish-current *hept-receipt* fn-history-backing)
             (let ((publication (and repeat-ok (eq published :published)
                                    (equal (fn-hep-current fn-history-backing) *hept-next*)
                                    (eq (fn-hep-producer-phase fn-history-backing) :published)))
                   (published-view (hept-view fn-history-backing)))
              (mv-let (word row left) (fn-hep-page-read *hept-next* *hept-leaf* 0 1 1 fn-history-backing)
               (let ((row-ok (and publication (eq word :row) (null row) (equal left 0))))
                (mv-let (duplicate fn-history-backing) (fn-hep-publish-current *hept-receipt* fn-history-backing)
                 (mv (and row-ok (eq duplicate :consumed)
                          (equal published-view (hept-view fn-history-backing))) fn-history-backing)))))))))))))))))
)

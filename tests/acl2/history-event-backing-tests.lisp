(defun hept-fence-step (fn-history-backing)
 (declare (xargs :stobjs fn-history-backing :verify-guards nil))
 (mv-let (init fn-history-backing) (hept-init fn-history-backing)
  (mv-let (offer fn-history-backing)
   (fn-hep-offer-produced :event *hept-produced* :context :fields *hept-token* fn-history-backing)
   (let ((before (hept-view fn-history-backing)))
    (mv-let (word fn-history-backing) (fn-hep-fence-current *hept-token* fn-history-backing)
     (let ((after (hept-view fn-history-backing)))

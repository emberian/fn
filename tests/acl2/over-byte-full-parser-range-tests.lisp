(in-package "ACL2")
(include-book "../../books/over-byte-full-parser-range")

(defconst *obfpt-source*
 (append (fn-record-string-octets "Subject: a") '(13 10 32 98 13 10)
         (fn-record-string-octets "From: c") '(13 10)
         (fn-record-string-octets "Date: d") '(13 10)
         (fn-record-string-octets "Message-ID: <e@x>") '(13 10)
         (fn-record-string-octets "References: <r@x>") '(13 10 13 10 122 13 10)))
(defun obfpt-token ()
 (mv-let (owners pins status) (fn-rpin-step nil '(31 nil nil) '(:acquire 7))
  (declare (ignore pins status)) (fn-rpin-token 7 owners)))
(defun obfpt-advance (s steps fn-arena fn-cat)
 (declare (xargs :stobjs (fn-arena fn-cat) :measure (nfix steps) :verify-guards nil))
 (if (zp steps) s
  (mv-let (out next) (fn-obc-one s fn-arena fn-cat)
   (declare (ignore out)) (obfpt-advance next (1- steps) fn-arena fn-cat))))
(defun-nx obfpt-conclusionp (s fn-arena fn-cat)
 (declare (xargs :stobjs (fn-arena fn-cat) :verify-guards nil))
 (let ((r (fn-obc-one s fn-arena fn-cat)))
  (equal (append (mv-nth 0 r)
                 (fn-obc-actual-old-residual (mv-nth 1 r) fn-arena fn-cat))
         (fn-obc-actual-old-residual s fn-arena fn-cat))))

; Actual ONE reachability witness.
(defthm obfpt-positive-terminal
 (let* ((source *obfpt-source*) (fn-arena (list source)) (number 1)
        (top number) (v 1)
        (wire (fn-record-make 0 1 0 "<e@x>" source '("fn.test") "o" "s" "e" 1 5))
        (fn-cat (list (fn-held-with-numbers (fn-held-plain wire 0)
                       (list (cons "fn.test" number)))))
        (range (fn-ovw-cursor "fn.test" number top v nil t))
        (s (obfpt-advance (fn-obc-begin range (obfpt-token)) (len source) fn-arena fn-cat))
        (seq (fn-cnx-view-seq "fn.test" number v fn-cat))
        (row (fn-cat-at seq fn-cat)) (h (fn-record-payload row))
        (bytes (nth (fn-obc-selected-handle s fn-cat) fn-arena)))
  (and (equal (nth 2 s) :parse)
       (fn-obc-parser-prefix-p s fn-arena fn-cat)
       (fn-cbor-octet-listp bytes)
       (posp number)
       (<= number *fn-nntp-max-article-number*)
       (<= number (nfix top))
       seq
       (fn-scat-msgid-idp (fn-record-msgid row))
       (natp h)
       (obfpt-conclusionp s fn-arena fn-cat)))
 :rule-classes nil)


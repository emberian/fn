; Complete multirow execution fixture on a fixed captured catalog.  C=3
; and V=7 are deliberately distinct.  These are source-model witnesses,
; not publication/grant admission or native lifetime claims.
(defun obfpt-run (s fuel fn-arena fn-cat)
 (declare (xargs :stobjs (fn-arena fn-cat) :measure (nfix fuel) :verify-guards nil))
 (if (or (zp fuel) (not s)) (mv nil s)
  (mv-let (out next) (fn-obc-one s fn-arena fn-cat)
   (mv-let (rest final) (obfpt-run next (1- fuel) fn-arena fn-cat)
    (mv (append out rest) final)))))
(defun obfpt-held (id h number source)
 (declare (xargs :verify-guards nil))
 (fn-held-with-numbers
  (fn-held-plain (fn-record-make 0 1 0 id source '("fn.test") "o" "s" "e" 1 5) h)
  (list (cons "fn.test" number))))
(defthm obfpt-complete-multirow-with-invalid-middle
 (let* ((a *obfpt-source*) (bad '(120 13 10))
        (fn-arena (list a bad a))
        (fn-cat (list (obfpt-held "<e@x>" 0 1 a)
                      (obfpt-held "<bad@x>" 1 2 bad)
                      (obfpt-held "<e@x>" 2 4 a)))
        (range (fn-ovw-cursor "fn.test" 1 4 7 nil t))
        (answer (obfpt-run (fn-obc-begin range (obfpt-token)) 1000 fn-arena fn-cat)))
  (and (equal (fn-cat-count fn-cat) 3)
       (not (fn-cnx-view-seq "fn.test" 3 7 fn-cat))
       (equal (len (fn-ovw-lines "fn.test" 1 4 7 fn-arena fn-cat)) 2)
       (not (mv-nth 1 answer))
       (equal (mv-nth 0 answer) (fn-obc-old-range-reply range fn-arena fn-cat))))
 :rule-classes nil)
(defthm obfpt-complete-advanced-owed-state
 (let* ((a *obfpt-source*) (fn-arena (list a a))
        (fn-cat (list (obfpt-held "<e@x>" 0 1 a)
                      (obfpt-held "<e@x>" 1 4 a)))
        (range (fn-ovw-cursor "fn.test" 2 4 7 nil nil))
        (answer (obfpt-run (fn-obc-begin range (obfpt-token)) 1000 fn-arena fn-cat)))
  (and (equal (len (fn-ovw-lines "fn.test" 2 4 7 fn-arena fn-cat)) 1)
       (not (mv-nth 1 answer))
       (equal (mv-nth 0 answer) (fn-obc-old-range-reply range fn-arena fn-cat))))
 :rule-classes nil)
(defthm obfpt-complete-multirow-with-tombstone
 (let* ((a *obfpt-source*)
        (tomb (append *fn-rcl-magic* (make-list 137 :initial-element 0)))
        (fn-arena (list a tomb a))
        (fn-cat (list (obfpt-held "<e@x>" 0 1 a)
                      (obfpt-held "<gone@x>" 1 2 tomb)
                      (obfpt-held "<e@x>" 2 3 a)))
        (range (fn-ovw-cursor "fn.test" 1 3 7 nil t))
        (answer (obfpt-run (fn-obc-begin range (obfpt-token)) 1200 fn-arena fn-cat)))
  (and (fn-rcl-tombstonep tomb)
       (equal (len (fn-ovw-lines "fn.test" 1 3 7 fn-arena fn-cat)) 2)
       (not (mv-nth 1 answer))
       (equal (mv-nth 0 answer) (fn-obc-old-range-reply range fn-arena fn-cat))))
 :rule-classes nil)

; Lifecycle fixture only: the connection reservations use the real kernel,
; but the pre-existing request receipt is synthetic. This is not evidence of
; request admission, owner authority, constructor funding or native activation.
(in-package "ACL2")
(include-book "../../books/index-reader-request")
(include-book "index-connection-repin-tests")
(defun fn-irr-test-prepare-abort (fn-index-backing fn-page-read-pool)
 (declare (xargs :stobjs (fn-index-backing fn-page-read-pool) :guard t
                 :verify-guards nil))
 (mv-let (fn-index-backing fn-page-read-pool)
  (fn-icr-test-setup t fn-index-backing fn-page-read-pool)
  (mv-let (old-ok old fn-index-backing fn-page-read-pool)
   (fn-icr-test-captured-holder t fn-index-backing fn-page-read-pool)
   (mv-let (query-owned ignored-query left-query fn-index-backing)
    (fn-ibp-generation-reference '(:index-generation 9 1 0)
                                 :retain :query nil 1 fn-index-backing)
    (declare (ignore ignored-query))
   (mv-let (new-ok new fn-index-backing fn-page-read-pool)
    (fn-icr-test-captured-holder nil fn-index-backing fn-page-read-pool)
    (let* ((prepared (fn-ibp-connection-pending fn-index-backing))
           (pin (fn-omk-at 7 prepared))
           (request (list :reader-request 7 pin (fn-omk-at 2 pin) nil nil nil 0 old nil))
           (receipt (list :index-request-receipt 18 19 0 '(:new 9)
                          '(0 0 0 0 0) request :source-owned nil nil))
           (fn-index-backing (update-fn-ibp-request-pending receipt fn-index-backing))
           (ledger (fn-owner-page-read-ledger fn-page-read-pool)))
     (mv-let (short ignored left0 fn-index-backing fn-page-read-pool)
      (fn-irr-request-abort-prepared 19 4 fn-index-backing fn-page-read-pool)
      (let ((short-ok (and (eq short :yield) (null ignored) (equal left0 4)
                            (equal receipt (fn-ibp-request-pending fn-index-backing))
                            (equal prepared (fn-ibp-connection-pending fn-index-backing))
                            (equal ledger (fn-owner-page-read-ledger fn-page-read-pool)))))
       (mv-let (word token left1 fn-index-backing fn-page-read-pool)
        (fn-irr-request-abort-prepared 19 5 fn-index-backing fn-page-read-pool)
        (let* ((after (fn-ibp-request-pending fn-index-backing))
               (after-ledger (fn-owner-page-read-ledger fn-page-read-pool))
               (abort-ok (and (eq word :aborted) (equal token new) (natp left1)
                              (eq (fn-omk-at 7 after) :source-aborted)
                              (equal (fn-omk-at 9 after) new)
                              (null (fn-ibp-connection-pending fn-index-backing)))))
         (mv-let (repeat token2 left2 fn-index-backing fn-page-read-pool)
          (fn-irr-request-abort-prepared 19 0 fn-index-backing fn-page-read-pool)
          (mv (list (and old-ok (eq query-owned :retained) (natp left-query)) new-ok short-ok abort-ok
                    (and (eq repeat :aborted) (equal token2 new) (equal left2 0)
                         (equal after (fn-ibp-request-pending fn-index-backing))
                         (equal after-ledger (fn-owner-page-read-ledger fn-page-read-pool))
                         (equal (fn-icr-test-gen-refs '(:index-generation 9 1 0)
                                                    fn-index-backing) '(1 1))))
              fn-index-backing fn-page-read-pool))))))))))))
(defun fn-irr-test-prepare-abort-exec ()
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-index-backing
  (mv-let (result fn-index-backing)
   (with-local-stobj fn-page-read-pool
    (mv-let (result fn-index-backing fn-page-read-pool)
     (fn-irr-test-prepare-abort fn-index-backing fn-page-read-pool)
     (mv result fn-index-backing))) result)))
(assert-event (equal (fn-irr-test-prepare-abort-exec) '(t t t t t)))

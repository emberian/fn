; The mutant expects two acceptance effects for one sealed record.
(defthm lcr-commit-count-mutation-ground
 (let* ((h (lct-held 0))
        (segs (fn-lb-log-model-append h *lct-payload* 1 nil))
        (entry (fn-lb-log-model-row-entry h segs))
        (a 1) (b (+ (* (nth 3 entry) 4294967296) (nth 4 entry)))
        (fn-lbc (create-fn-lbc))
        (out (fn-lc-commit-record h a b fn-lbc segs)))
   (and (fn-lbc-p fn-lbc) (fn-cat$ap nil)

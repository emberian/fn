(local (defun lcr-disable-column-execution (runes)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp runes)
  (let* ((r (car runes)) (sym (cadr r))
         (name (if (symbolp sym) (symbol-name sym) "")))
   (if (and (equal (car r) :executable-counterpart)
            (or (equal (subseq name 0 (min 7 (length name))) "FN-LBC-")
                (equal (subseq name 0 (min 8 (length name))) "FN-DMAP-")
                (equal (subseq name 0 (min 6 (length name))) "FN-LC-")
                (equal sym 'create-fn-lbc)))
       (cons r (lcr-disable-column-execution (cdr runes)))
     (lcr-disable-column-execution (cdr runes)))) nil)))
(local (defun lcr-enable-column-definitions (runes)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp runes)
  (let* ((r (car runes)) (sym (cadr r))
         (name (if (symbolp sym) (symbol-name sym) "")))
   (if (and (equal (car r) :definition)
            (or (equal (subseq name 0 (min 7 (length name))) "FN-LBC-")
                (equal (subseq name 0 (min 8 (length name))) "FN-DMAP-")
                (equal (subseq name 0 (min 6 (length name))) "FN-LC-")
                (equal sym 'create-fn-lbc)))
       (cons r (lcr-enable-column-definitions (cdr runes)))
     (lcr-enable-column-definitions (cdr runes)))) nil)))

(defthm lcr-commit-positive-ground
 (let* ((h (lct-held 0))
        (segs (fn-lb-log-model-append h *lct-payload* 1 nil))
        (entry (fn-lb-log-model-row-entry h segs))
        (a 1) (b (+ (* (nth 3 entry) 4294967296) (nth 4 entry)))
        (fn-lbc (create-fn-lbc))
        (out (fn-lc-commit-record h a b fn-lbc segs)))
   (and (fn-lbc-p fn-lbc) (fn-cat$ap nil)
        (fn-lbc-corr fn-lbc nil segs)
        (fn-lc-locators-resolve fn-lbc segs)
        (fn-lc-fresh-recordp h a b segs)
        (equal (mv-nth 0 out) :ok)
        (fn-lc-locators-resolve (mv-nth 1 out) (mv-nth 2 out))
        (fn-lbc-corr (mv-nth 1 out) (fn-cat$a-commit h nil) (mv-nth 2 out))))

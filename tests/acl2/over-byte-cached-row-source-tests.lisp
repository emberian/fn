(in-package "ACL2")
(include-book "../../books/over-byte-cached-row-source")
(defconst *obcst-source*
 (append (fn-record-string-octets "Subject: a") '(13 10)
         (fn-record-string-octets "From: c") '(13 10)
         (fn-record-string-octets "Date: d") '(13 10)
         (fn-record-string-octets "Message-ID: <e@x>") '(13 10 13 10 122 13 10)))
(defun-nx obcst-conclusionp (article facts fn-arena)
 (declare (xargs :stobjs fn-arena :verify-guards nil))
 (let ((bytes (fn-nntp-article-bytes article fn-arena)))
  (equal (fn-npw-remaining (fn-npw-column-pieces 1 facts (len bytes)) 0 fn-arena)
         (append (fn-nov-line 1 (fn-nov-overview article fn-arena)) '(13 10)))))
(defthm obcst-positive
 (let* ((fn-arena (list *obcst-source*))
        (article (fn-make-article "<e@x>" 0 '("fn.test") nil t 5))
        (bytes (fn-nntp-article-bytes article fn-arena))
        (facts (fn-held-facts-of bytes)))
  (and (equal facts (fn-held-facts-of bytes))
       (fn-hnov-ok (fn-hnov-of bytes))
       (obcst-conclusionp article facts fn-arena)))
 :rule-classes nil)
; Mutation witness: another immutable payload's valid facts are substituted.
(defthm obcst-without-same-source-facts
 (let* ((fn-arena (list *obcst-source*))
        (article (fn-make-article "<e@x>" 0 '("fn.test") nil t 5))
        (bytes (fn-nntp-article-bytes article fn-arena))
        (other (append (fn-record-string-octets "Subject: other") '(13 10)
                 (fn-record-string-octets "From: c") '(13 10)
                 (fn-record-string-octets "Date: d") '(13 10)
                 (fn-record-string-octets "Message-ID: <e@x>") '(13 10 13 10 122 13 10)))
        (facts (fn-held-facts-of other)))
  (and (not (equal facts (fn-held-facts-of bytes)))
       (fn-hnov-ok (fn-hnov-of bytes))
       (not (obcst-conclusionp article facts fn-arena))))
 :rule-classes nil)
; Source-invalid witness: every retained same-source hypothesis holds.
(defthm obcst-without-valid-source
 (let* ((fn-arena (list '(120 13 10)))
        (article (fn-make-article "<e@x>" 0 '("fn.test") nil t 5))
        (bytes (fn-nntp-article-bytes article fn-arena))
        (facts (fn-held-facts-of bytes)))
  (and (equal facts (fn-held-facts-of bytes))
       (not (fn-hnov-ok (fn-hnov-of bytes)))
       (not (obcst-conclusionp article facts fn-arena))))
 :rule-classes nil)

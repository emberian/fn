; First-publication witnesses over the actual executable and BLAKE3 seam.
(in-package "ACL2")
(include-book "../../books/paged-checkpoint-bootstrap")
; Reuse the established real word/record/table digest fixture.
(include-book "pagestore-digest-fixture")
(include-book "must-fail-checked")

(defun pckbt-run ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj pgs-mem
    (mv-let (out pgs-mem)
      (with-local-stobj fn-octets-pg
        (mv-let (out pgs-mem fn-octets-pg)
          (let ((pgs-mem (pgs-x-grow-image 1 pgs-mem)))
            (mv-let (v pgs-mem) (pgs-x-write 0 0 42 pgs-mem)
              (declare (ignore v))
              (let* ((pgs-mem (fn-pck-x-bootstrap-reset pgs-mem))
                     (dirty (pgs-x-abs-dirty '(0) pgs-mem))
                     (shape (pgs-memp pgs-mem)))
                (mv-let (digests fn-octets-pg)
                  (pgs-x-dirty-digests '(0) pgs-mem fn-octets-pg)
                  (mv-let (res pgs-mem fn-octets-pg)
                    (fn-pck-x-bootstrap '(0) pgs-mem fn-octets-pg)
                    (let* ((hyps
                             (and shape (nat-listp '(0)) (equal (car res) :plan)
                                  (equal digests (pgs-dirty-digests dirty))
                                  (equal (nth 9 res)
                                         (pgs-dirty-digests
                                          (pgs-table-dirty '(0) (pgs-chunk (pgs-x-tab 1 pgs-mem)))))
                                  (pgs-rec-valid (nth 1 res))
                                  (equal (pgs-rec-dir-digest (nth 1 res)) (pgs-digest (pgs-x-dir 1 pgs-mem)))))
                           (plan (list :plan (pgs-x-abs-writes '(0) res pgs-mem) 0 (nth 1 res) (nth 7 res)))
                           (model (fn-pck-bootstrap-plan dirty))
                           (image (pgs-crash nil :pck (second plan) nil 0 (fourth plan)))
                           (torn (pgs-crash nil :pck (second plan) nil 0 :torn)))
                      (mv (list hyps (equal plan model)
                                (pgs-lpages-ok (pgs-dirty-lpages dirty) 0 0)
                                (pgs-writes-faithful (second plan) nil)
                                (equal (pgs-view (pgs-open image :pck :eager))
                                       (list 1 (pgs-apply-dirty nil dirty)))
                                (not (pgs-rec-valid :torn))
                                (equal (pgs-view (pgs-open torn :pck :eager)) nil)
                                (equal (pgs-x-abs-dirty '(0) pgs-mem) dirty))
                          pgs-mem fn-octets-pg)))))))
          (mv out pgs-mem)))
      out)))
(assert-event (equal (pckbt-run) '(t t t t t t t t)))
(must-fail-checked (assert-event (not (nth 6 (pckbt-run)))))

(defun pckbt-forged-slot ()
  (declare (xargs :verify-guards nil))
  (let* ((dirty (list (cons 0 (make-list 2048 :initial-element 42))))
         (p (fn-pck-bootstrap-plan dirty))
         (new (fourth p))
         (forged (pgs-make-rec 2 (pgs-rec-dir-addr new)
                              (pgs-rec-npages new) (pgs-rec-dir-digest new)))
         (v (pgs-view (pgs-open (pgs-crash nil :pck (second p) nil 0 forged) :pck :eager))))
    (list (and (pgs-lpages-ok (pgs-dirty-lpages dirty) 0 0)
               (pgs-writes-faithful (second p) nil))
          (or (equal forged new) (not (pgs-rec-valid forged)))
          (or (equal v nil) (equal v (list 1 (pgs-apply-dirty nil dirty)))))))
; Removing the record-outcome premise admits a valid forged transaction.
(assert-event (equal (pckbt-forged-slot) '(t nil nil)))
(must-fail-checked (assert-event (nth 2 (pckbt-forged-slot))))

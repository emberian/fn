(in-package "ACL2")
(include-book "../../books/over-byte-parser-relation")
(include-book "over-byte-cursor-tests")

(defun obcpt-run (s fuel fn-arena fn-cat)
  (declare (xargs :stobjs (fn-arena fn-cat) :measure (nfix fuel) :verify-guards nil))
  (if (or (not s) (zp fuel)) (mv t 0)
    (mv-let (out next) (fn-obc-one s fn-arena fn-cat)
      (declare (ignore out))
      (mv-let (good count) (obcpt-run next (1- fuel) fn-arena fn-cat)
        (if (equal (nth 2 s) :parse)
            (mv-let (parser consumed work verdict) (fn-lpc-tick (nth 3 s) 1 fn-arena)
              (declare (ignore consumed work))
              (let* ((h (fn-obc-selected-handle s fn-cat))
                     (bytes (fn-arena-payload h fn-arena))
                     (terminal (not (equal verdict :yield))))
                (mv (and good (fn-obc-parser-prefix-p s fn-arena fn-cat)
                         (fn-obc-parser-prefix-p next fn-arena fn-cat)
                         (or (not terminal)
                             (and (equal (nth 2 s) :parse)
                                  (not (equal (fn-lpc-verdict parser) :yield))
                                  (equal h 0) (equal (fn-arena-count fn-arena) 1)
                                  (fn-cbor-octet-listp bytes)
                                  (equal parser (fn-lpc-feed bytes (fn-lpc-begin h (len bytes) (nth 1 s))))
                                  (equal (fn-lpc-nov-value parser (list bytes)) (fn-hnov-of bytes))
                                  (equal (fn-lpc-body-lines parser) (fn-hf-body-lines-of bytes)))))
                    (+ count (if terminal 1 0)))))
          (mv (and good (fn-obc-parser-prefix-p s fn-arena fn-cat)
                   (fn-obc-parser-prefix-p next fn-arena fn-cat)) count))))))

(defun obcpt-case (malformed fn-arena fn-cat)
  (declare (xargs :stobjs (fn-arena fn-cat) :verify-guards nil))
  (let* ((fn-arena (fn-arena-clear fn-arena)) (fn-cat (fn-cat-clear fn-cat))
         (bytes (if malformed '(65 13 10 13 10) *obct-source*))
         (wire (fn-record-make 0 1 0 "<e@x>" bytes '("fn.test") "o" "s" "e" 1 5)))
    (mv-let (row fn-arena) (fn-cat-intern-list wire nil 0 fn-arena)
      (let* ((row (fn-held-plain wire (fn-record-payload row)))
             (fn-cat (fn-cat-commit row fn-cat))
             (s (fn-obc-begin (fn-ovw-cursor "fn.test" 1 1 1 nil t) (obct-token))))
        (mv-let (good count) (obcpt-run s 1000 fn-arena fn-cat)
          (mv (and (fn-obc-parser-prefix-p s fn-arena fn-cat) good (equal count 1))
              fn-arena fn-cat))))))

; Reachable positive witnesses affirm prefix premise and conclusion on every
; actual ONE, and all hypotheses/conclusions of each terminal tick theorem
; on the actual tick result inside ONE's parse branch, valid and malformed.
(assert-event (mv-let (good fn-arena fn-cat) (obcpt-case nil fn-arena fn-cat)
                (mv good fn-arena fn-cat)) :stobjs-out '(nil fn-arena fn-cat))
(assert-event (mv-let (good fn-arena fn-cat) (obcpt-case t fn-arena fn-cat)
                (mv good fn-arena fn-cat)) :stobjs-out '(nil fn-arena fn-cat))

(defun obcpt-corrupt-prefix (fn-arena fn-cat)
  (declare (xargs :stobjs (fn-arena fn-cat) :verify-guards nil))
  (let* ((fn-arena (fn-arena-clear fn-arena)) (fn-cat (fn-cat-clear fn-cat))
         (wire (fn-record-make 0 1 0 "<e@x>" *obct-source* '("fn.test") "o" "s" "e" 1 5)))
    (mv-let (row fn-arena) (fn-cat-intern-list wire nil 0 fn-arena)
      (let* ((h (fn-record-payload row))
             (fn-cat (fn-cat-commit (fn-held-plain wire h) fn-cat))
             (s (fn-obc-make (fn-ovw-cursor "fn.test" 1 1 1 nil t) (obct-token) :parse
                   (fn-lpc-begin h (fn-arena-payload-len h fn-arena) '(:response 7 32)) nil 0)))
        (mv-let (out next) (fn-obc-one s fn-arena fn-cat)
          (declare (ignore out))
          (mv (and (fn-obc-statep s fn-arena)
                   (not (fn-obc-parser-prefix-p s fn-arena fn-cat))
                   (equal (nth 2 next) :parse)
                   (not (fn-obc-parser-prefix-p next fn-arena fn-cat)))
              fn-arena fn-cat))))))

; Corrupted-state literal removal for the sole prefix hypothesis in
; fn-obc-one-preserves-parser-prefix: both premise and conclusion fail.
(assert-event (mv-let (good fn-arena fn-cat) (obcpt-corrupt-prefix fn-arena fn-cat)
                (mv good fn-arena fn-cat)) :stobjs-out '(nil fn-arena fn-cat))

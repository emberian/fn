; Actual open/intern/availability-loader binding with native catalog observations.
(in-package "ACL2")
(include-book "lb-catalog-binding-observation")
(include-book "lb-writer-binding-fixtures")
(include-book "../../books/defkeystone")
(defun fn-lbw-open-wire-records ()
 (declare (xargs :guard t))
 (list (fn-record-make 0 1 0 "<lb-open-a@fn.test>" *fn-lbr13-payload* '("fn.test") "o" "s" "e" 1 5)
       (fn-record-make 1 2 0 "<lb-open-b@fn.test>" *fn-lbw-payload-b* '("fn.test") "o" "s" "e" 1 3)))
(defun fn-lbw-open-binding-scalar (ws view-index target fn-arena fn-cat)
 (declare (xargs :stobjs (fn-arena fn-cat) :verify-guards nil))
 (let* ((log (fn-lb-log-model-open-events ws nil 0 0 target nil))
        (fn-arena (fn-arena-clear fn-arena)))
  (mv-let (events fn-arena) (fn-intern-events ws nil 0 fn-arena)
   (let ((fn-cat (fn-sca-load-held-rows events view-index fn-arena fn-cat)))
    (mv (not (fn-lbw-unbound-catalog-rows 0 fn-arena fn-cat log)) fn-arena fn-cat)))))
(defun fn-lbw-open-forget-scalar (ws view-index target fn-arena fn-cat)
 (declare (xargs :stobjs (fn-arena fn-cat) :verify-guards nil))
 (let* ((log (fn-lb-log-model-open-events ws nil 0 0 target nil))
        (fn-arena (fn-arena-clear fn-arena)))
  (mv-let (events fn-arena) (fn-intern-events ws nil 0 fn-arena)
   (let* ((fn-arena (fn-arena-forget 0 fn-arena))
          (fn-cat (fn-sca-load-held-rows events view-index fn-arena fn-cat)))
    (mv (not (fn-lbw-unbound-catalog-rows 0 fn-arena fn-cat log)) fn-arena fn-cat)))))

(defteeth fn-lb-arena-is-log-of-open-rebuild
 :claim (() (let* ((arena0 (fn-arena-clear fn-arena))
        (events (mv-nth 0 (fn-intern-events ws nil 0 arena0)))
        (arena (mv-nth 1 (fn-intern-events ws nil 0 arena0)))
        (log (fn-lb-log-model-open-events ws nil 0 0 target nil)))
 (fn-lb-arena-is-log arena (fn-sca-load-held-rows events view-index arena fn-cat) log)))
 :subject fn-intern-events
 :witness ((ws (fn-lbw-open-wire-records)) (view-index nil) (target 7))
 :stobjs ((fn-arena (fn-arena-clear fn-arena)) (fn-cat (fn-cat-clear fn-cat)))
 :stobj-checks
 (((let* ((arena0 (fn-arena-clear fn-arena))
        (events (mv-nth 0 (fn-intern-events ws nil 0 arena0)))
        (arena (mv-nth 1 (fn-intern-events ws nil 0 arena0)))
        (log (fn-lb-log-model-open-events ws nil 0 0 target nil)))
 (fn-lb-arena-is-log arena (fn-sca-load-held-rows events view-index arena fn-cat) log))
   (fn-lbw-open-binding-scalar ws view-index target fn-arena fn-cat)
   :hints (("Goal" :in-theory (union-theories (theory 'ground-zero)
    '(fn-lbw-open-binding-scalar fn-lbw-native-catalog-binding-is-model fn-lbw-unbound-catalog-rows-iff-not-binding fn-arena-clear-is-nil nthcdr)))))
  ((let* ((arena0 (fn-arena-clear fn-arena))
        (events (mv-nth 0 (fn-intern-events ws nil 0 arena0)))
        (arena (fn-arena-forget 0 (mv-nth 1 (fn-intern-events ws nil 0 arena0))))
        (log (fn-lb-log-model-open-events ws nil 0 0 target nil)))
 (fn-lb-arena-is-log arena (fn-sca-load-held-rows events view-index arena fn-cat) log))
   (fn-lbw-open-forget-scalar ws view-index target fn-arena fn-cat)
   :hints (("Goal" :in-theory (union-theories (theory 'ground-zero)
    '(fn-lbw-open-forget-scalar fn-lbw-native-catalog-binding-is-model fn-lbw-unbound-catalog-rows-iff-not-binding fn-arena-clear-is-nil nthcdr))))))
 :breaks nil
 :mutations ((premature-forget (:conclusion (let* ((arena0 (fn-arena-clear fn-arena))
        (events (mv-nth 0 (fn-intern-events ws nil 0 arena0)))
        (arena (fn-arena-forget 0 (mv-nth 1 (fn-intern-events ws nil 0 arena0))))
        (log (fn-lb-log-model-open-events ws nil 0 0 target nil)))
 (fn-lb-arena-is-log arena (fn-sca-load-held-rows events view-index arena fn-cat) log)))
              ((ws (fn-lbw-open-wire-records)) (view-index nil) (target 7))
              :fault "open releases an interned handle before the catalog stops naming it")))

; Actual adapter lifecycle: a successful framed summary must not survive
; clear or a refused subsequent decode as usable annotation for that load.
(in-package "ACL2")
(include-book "../../host/store-checkpoint-decode-host")
(include-book "../../host/store-statement-replay-size-host")
(defun sccl-frames (octets acc fuel fn-octets)
 (declare (xargs :stobjs fn-octets :mode :program))
 (if (or (zp fuel) (atom octets))
  (mv (if (consp octets) :torn (revappend acc nil)) fn-octets)
  (let* ((hn *fn-scc-segment-header-octets*) (tn *fn-frame-trailer-octets*)
         (header (take hn octets)) (h (fn-scc-parse-header header)))
   (if (or (not h) (< (len octets) (+ hn (nth 2 h) tn)))
    (mv :torn fn-octets)
    (let* ((chunk (take (nth 2 h) (nthcdr hn octets)))
           (trailer (take tn (nthcdr (+ hn (nth 2 h)) octets)))
           (rest (nthcdr (+ hn (nth 2 h) tn) octets))
           (a (fn-octets-len fn-octets))
           (fn-octets (fn-octets-append-list chunk fn-octets)))
     (sccl-frames rest (cons (list header a (+ a (len chunk)) trailer) acc)
                  (1- fuel) fn-octets))))))
(defun sccl-success (plan fn-octets state)
 (declare (xargs :stobjs (fn-octets state) :mode :program))
 (mv-let (erp opened state fn-octets) (fn-store-sco-decode plan fn-octets state)
  (if (or erp (not (eq (car opened) :arena)))
   (mv nil state fn-octets)
   ; The fixture's arena has no payloads, hence no sealing iteration.
   (mv-let (erp result state fn-octets)
           (fn-store-sco-decode-finish (nth 1 opened) (nth 2 opened) fn-octets state)
    (let ((loaded (and (not erp) (eq (car result) :ok))))
     (mv-let (old-erp old-seed state) (fn-store-statement-replay-seed state)
      (mv-let (new-erp sized-seed state) (fn-store-statement-replay-seed-sized state)
       (mv (and loaded (not old-erp) (not new-erp)
             (equal (car sized-seed) old-seed)
             (eq (caddr sized-seed) :carried)
             (fn-scs-correspondsp (cadr sized-seed) (fn-ssr-at 3 old-seed))
             (eq (car (fn-store-sco-original-context-info state)) :summary)
             (eq (car (f-get-global 'fn-store-sco-recovery-source state))
                 :verified-checkpoint))
        state fn-octets))))))))
(defun sccl-finish-invalidates (plan fn-octets state)
 (declare (xargs :stobjs (fn-octets state) :mode :program))
 (mv-let (ok state fn-octets) (sccl-success plan fn-octets state)
  (let ((generation (fn-store-sco-recovery-source-generation-value state)))
   (mv-let (erp result state fn-octets)
           (fn-store-sco-decode-finish 0 0 fn-octets state)
    (mv (and ok (not erp) (eq (car result) :refused)
             (equal generation
                    (fn-store-sco-recovery-source-generation-value state))
             (not (fn-store-sco-recovery-source-value state))
             (equal (fn-store-sco-original-context-info state)
                    '(:unavailable :summary-context)))
        state fn-octets)))))
(defun sccl-lifecycle (fn-octets state)
 (declare (xargs :stobjs (fn-octets state) :mode :program))
 (let* ((capture (fn-sco-capture nil nil))
        (tables (fn-sct-tables-of-capture capture 0 "lifecycle" nil))
        (progs (fn-sct-table-programs tables (fn-sco-event-index capture)))
        (segments (append (fn-scka-run-segments nil nil 0)
                          (fn-sct-file-segments progs 64 0)))
        (file (fn-scc-concat segments))
        (fn-octets (fn-octets-clear fn-octets)))
  (mv-let (plan fn-octets) (sccl-frames file nil (len file) fn-octets)
   (mv-let (finish-cleared state fn-octets)
           (sccl-finish-invalidates plan fn-octets state)
   (mv-let (first state fn-octets) (sccl-success plan fn-octets state)
    (let ((first-generation (fn-store-sco-recovery-source-generation-value state)))
    (mv-let (erp value state) (fn-store-sco-clear state)
     (declare (ignore erp value))
     (let ((cleared (and (natp first-generation)
                        (equal (+ 1 first-generation)
                               (fn-store-sco-recovery-source-generation-value state))
                        (not (fn-store-sco-current state))
                        (equal (fn-store-sco-original-context-info state)
                               '(:unavailable :summary-context))
                        (not (f-get-global 'fn-store-sco-recovery-source state))
                        (not (f-get-global 'fn-store-sco-summary-region state))
                        (not (f-get-global 'fn-store-sco-original-plan state)))))
      (mv-let (second state fn-octets) (sccl-success plan fn-octets state)
       (let ((second-generation (fn-store-sco-recovery-source-generation-value state)))
       (mv-let (erp refused state fn-octets) (fn-store-sco-decode nil fn-octets state)
        (mv (and finish-cleared first cleared second (not erp) (eq (car refused) :refused)
                 (natp second-generation)
                 (equal (+ 1 second-generation)
                        (fn-store-sco-recovery-source-generation-value state))
                 (not (fn-store-sco-current state))
                 (equal (fn-store-sco-original-context-info state)
                        '(:unavailable :summary-context))
                 (not (f-get-global 'fn-store-sco-context-info state))
                 (not (f-get-global 'fn-store-sco-summary-region state))
                 (not (f-get-global 'fn-store-sco-recovery-source state))
                 (not (f-get-global 'fn-store-sco-original-plan state)))
            state fn-octets))))))))))))
(defun sccl-lifecycle-local (state)
 (declare (xargs :stobjs state :mode :program))
 (with-local-stobj fn-octets
  (mv-let (ok state fn-octets) (sccl-lifecycle fn-octets state)
   (mv ok state))))
(make-event
 (mv-let (ok state) (sccl-lifecycle-local state)
  (if ok (mv nil '(value-triple :passed) state)
   (mv "Summary context clear/restart lifecycle failed" nil state))))

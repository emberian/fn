(in-package "ACL2")

(include-book "../../books/resource-bp-session")

(defun bpsgt-run (script grant fn-resource-ledger)
 (declare (xargs :stobjs fn-resource-ledger :verify-guards nil))
 (if (endp script) (mv t fn-resource-ledger)
  (let ((entry (car script)))
   (if (eq (car entry) :return)
    (mv-let (word fn-resource-ledger)
     (fn-bpsg-return (cadr entry) fn-resource-ledger)
     (if (not (eq word :settled)) (mv nil fn-resource-ledger)
      (bpsgt-run (cdr script) grant fn-resource-ledger)))
    (let ((before (fn-rl-bank fn-resource-ledger)))
     (mv-let (word row next fn-resource-ledger)
      (fn-bpsg-acquire-turn grant (car entry) (cadr entry) fn-resource-ledger)
      (if (not (and (equal (list word row next) (caddr entry))
                    (if (eq word :bp-session-yield)
                        (equal before (fn-rl-bank fn-resource-ledger)) t)))
          (mv nil fn-resource-ledger)
       (bpsgt-run (cdr script) grant fn-resource-ledger))))))))

(defun bpsgt-case (grant script fn-resource-ledger)
 (declare (xargs :stobjs fn-resource-ledger :verify-guards nil))
 (mv-let (word fn-resource-ledger) (fn-bpsg-install grant fn-resource-ledger)
  (if (eq word :installed) (bpsgt-run script grant fn-resource-ledger)
   (mv nil fn-resource-ledger))))

(defun bpsgt-execution-1 ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-resource-ledger
  (mv-let (ok fn-resource-ledger)
   (bpsgt-case '(:hold 100000 100 10 3 1 30000)
    '((:incoming nil (:drawn (:bp-session-grant 2 1 :incoming nil nil) 3))
      (:incoming 3 (:drawn (:bp-session-grant 3 1 :incoming nil nil) 4))
      (:incoming 2 (:bp-session-yield nil 3))
      (:incoming 3 (:bp-session-yield nil 4))
      (:incoming 4 (:drawn (:bp-session-grant 4 1 :incoming nil nil) 2))
      (:outgoing 2 (:drawn (:bp-session-grant 5 1 :outgoing nil nil) 5))
      (:incoming 5 (:bp-session-yield nil 3))
      (:return (:bp-session-grant 2 1 :incoming t t))
      (:incoming 2 (:drawn (:bp-session-grant 2 2 :incoming nil nil) 3)))
    fn-resource-ledger) ok)))

(assert-event (bpsgt-execution-1))

(defun bpsgt-execution-2 ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-resource-ledger
  (mv-let (ok fn-resource-ledger)
   (bpsgt-case '(:hold 100000 100 10 0 1 30000)
    '((:incoming nil (:bp-session-capacity nil 2))
      (:outgoing 999 (:drawn (:bp-session-grant 2 1 :outgoing nil nil) 2)))
    fn-resource-ledger) ok)))

(assert-event (bpsgt-execution-2))

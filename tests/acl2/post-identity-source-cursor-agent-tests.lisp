(defconst *fn-psc-agent-test-date* '(65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65 65))

(defthm fn-psc-agent-path-first-literal
 (let* ((text "<a@b>") (incoming (append (fn-inj-path-line '(97 98 99)) (fn-inj-injection-info-line '(100 101 102))))
        (c (fn-psc-begin :agent (len incoming) text '(:agent 0 0) (len incoming)))
        (d (fn-psc-model-agent-complete c incoming)))
  (and (true-listp incoming) (stringp text) (fn-psc-agent-statep c incoming)
       (fn-psc-agent-resultp (fn-psc-result d) (len incoming))
       (equal (fn-pb-path-agent incoming (fn-record-string-octets (fn-psc-get msgid c))) '(97 98 99))
       (equal (fn-psc-model-agent-span-octets d incoming)
              (fn-pb-path-agent incoming (fn-record-string-octets (fn-psc-get msgid c))))
       (equal d (fn-psc-model-byte-run (fn-psc-model-agent-cost c incoming) c incoming nil))))
 :rule-classes nil)


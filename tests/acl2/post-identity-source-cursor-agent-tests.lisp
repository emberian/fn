(defthm fn-psc-agent-source-extent-removal-literal
 (let* ((incoming (fn-inj-injection-info-line '(97 98 99)))
        (c (fn-psc-begin :agent 0 "<a@b>" nil (len incoming)))
        (d (fn-psc-model-agent-complete c incoming)))
  (and (equal (fn-psc-get phase c) :control) (equal (fn-psc-get resume c) :start)
       (true-listp incoming) (equal (fn-psc-get mode c) :agent)
       (true-listp c) (equal (len c) 24) (stringp (fn-psc-get msgid c))
       (not (equal (fn-psc-get n c) (len incoming))) (not (fn-psc-agent-statep c incoming))
       (not (equal (fn-psc-model-agent-span-octets d incoming)
              (fn-pb-path-agent incoming (fn-record-string-octets (fn-psc-get msgid c)))))))
 :rule-classes nil)

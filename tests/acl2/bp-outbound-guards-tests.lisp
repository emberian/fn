; Isolated guard and malformed-input regression evidence.
(in-package "ACL2")
(include-book "../../books/bp-outbound")
(assert-event (equal (symbol-class 'fn-bpo-make-ok (w state)) :common-lisp-compliant))
(assert-event (equal (guard 'fn-bpo-make-ok nil (w state)) ''t))
(assert-event (equal (symbol-class 'fn-bpo-make-error (w state)) :common-lisp-compliant))
(assert-event (equal (guard 'fn-bpo-make-error nil (w state)) ''t))
(assert-event (equal (symbol-class 'fn-bpo-result-okp (w state)) :common-lisp-compliant))
(assert-event (equal (guard 'fn-bpo-result-okp nil (w state)) ''t))
(assert-event (equal (symbol-class 'fn-bpo-result-value (w state)) :common-lisp-compliant))
(assert-event (equal (guard 'fn-bpo-result-value nil (w state)) ''t))
(assert-event (equal (symbol-class 'fn-bpo-current-attemptp (w state)) :common-lisp-compliant))
(assert-event (equal (guard 'fn-bpo-current-attemptp nil (w state)) ''t))
(assert-event (equal (symbol-class 'fn-bpo-request-message (w state)) :common-lisp-compliant))
(assert-event (equal (guard 'fn-bpo-request-message nil (w state)) ''t))
(assert-event (equal (symbol-class 'fn-bpo-request-adu (w state)) :common-lisp-compliant))
(assert-event (equal (guard 'fn-bpo-request-adu nil (w state)) ''t))
(assert-event (equal (symbol-class 'fn-bpo-adu-receipt-to-bp (w state)) :common-lisp-compliant))
(assert-event (equal (guard 'fn-bpo-adu-receipt-to-bp nil (w state)) ''t))
(assert-event (equal (symbol-class 'fn-bpo-decode-receipt (w state)) :common-lisp-compliant))
(assert-event (equal (guard 'fn-bpo-decode-receipt nil (w state)) ''t))
(assert-event (equal (symbol-class 'fn-bpo-make-receipt-intent-record (w state)) :common-lisp-compliant))
(assert-event (equal (guard 'fn-bpo-make-receipt-intent-record nil (w state)) ''t))
(assert-event (equal (symbol-class 'fn-bpo-receipt-intent-record (w state)) :common-lisp-compliant))
(assert-event (equal (guard 'fn-bpo-receipt-intent-record nil (w state)) ''t))

; Malformed/garbage inputs are handled totally: no error.
(assert-event (equal (fn-bpo-result-okp 7) nil))
(assert-event (equal (fn-bpo-result-value 7) nil))
(assert-event (equal (fn-bpo-current-attemptp 7 "a" 0) nil))
(assert-event (equal (fn-bpo-request-message 7 "w" "a" 0) nil))
(assert-event (equal (fn-bpo-decode-receipt '(1 2 3)) nil))
(assert-event (equal (fn-bpo-receipt-intent-record 7 0 0 '(1 2 3) t)
                     (fn-bpo-make-error :receipt-refused)))
(assert-event (equal (fn-bpo-receipt-intent-record 7 0 0 '(1 2 3) nil)
                     (fn-bpo-make-error :policy-refused)))

(in-package "ACL2")
(include-book "../../books/over-held-row-establishment")

(defun ohret-row (h facts)
 (declare (xargs :guard t :verify-guards nil))
 (fn-held-make 0 1 0 "<e@x>" h '("g") "o" "s" "e" 1 5 facts
   (fn-hc-make (fn-stx-make-verdict :absent nil 0) nil 0) '(("g" . 1)) nil))
(defun-nx ohret-conclusion (range row fn-arena)
 (declare (xargs :stobjs fn-arena :verify-guards nil))
 (fn-ohr-carried-p (fn-ohr-selected-row-begin range '(:query-source 17) row fn-arena)
                   fn-arena))

(defthm ohret-positive-actual-selected-cached-row
 (let* ((fn-arena '((120 13 10))) (range '("g" 1 3 7 nil t))
        (facts (fn-hf-make 3 nil 0
          (list nil nil nil (fn-hnov-make nil t "s" "f" "d" "<e@x>" ""))))
        (row (ohret-row 0 facts)))
  (and (true-listp range) (natp (fn-record-payload row))
       (< (fn-record-payload row) (fn-arena-count fn-arena))
       (or (not (fn-hf-nov (fn-held-facts row)))
           (fn-hnov-p (fn-hf-nov (fn-held-facts row))))
       (ohret-conclusion range row fn-arena)
       (eq (nth 2 (fn-ohr-selected-row-begin range '(:query-source 17) row fn-arena))
           :emit)))
 :rule-classes nil)
(defthm ohret-positive-actual-selected-uncached-row
 (let* ((fn-arena '((120 13 10))) (range '("g" 1 3 7 nil t))
        (row (ohret-row 0 (fn-hf-make 3 nil 0 nil))))
  (and (true-listp range) (natp (fn-record-payload row))
       (< (fn-record-payload row) (fn-arena-count fn-arena))
       (or (not (fn-hf-nov (fn-held-facts row)))
           (fn-hnov-p (fn-hf-nov (fn-held-facts row))))
       (ohret-conclusion range row fn-arena)
       (eq (nth 2 (fn-ohr-selected-row-begin range '(:query-source 17) row fn-arena))
           :parse)))
 :rule-classes nil)

; Each corruption affirmatively retains all other literal hypotheses.
(defthm ohret-removal-range-shape
 (let* ((fn-arena '((120 13 10))) (range :bad)
        (row (ohret-row 0 (fn-hf-make 3 nil 0 nil))))
  (and (not (true-listp range)) (natp (fn-record-payload row))
       (< (fn-record-payload row) (fn-arena-count fn-arena))
       (or (not (fn-hf-nov (fn-held-facts row)))
           (fn-hnov-p (fn-hf-nov (fn-held-facts row))))
       (not (ohret-conclusion range row fn-arena))))
 :rule-classes nil)
(defthm ohret-removal-payload-kind
 (let* ((fn-arena '((120 13 10))) (range '("g" 1 3 7 nil t))
        (row (ohret-row :bad (fn-hf-make 3 nil 0 nil))))
  (and (true-listp range) (not (natp (fn-record-payload row)))
       (< (fn-record-payload row) (fn-arena-count fn-arena))
       (or (not (fn-hf-nov (fn-held-facts row)))
           (fn-hnov-p (fn-hf-nov (fn-held-facts row))))
       (not (ohret-conclusion range row fn-arena))))
 :rule-classes nil)
(defthm ohret-removal-current-payload-bound
 (let* ((fn-arena nil) (range '("g" 1 3 7 nil t))
        (row (ohret-row 0 (fn-hf-make 3 nil 0 nil))))
  (and (true-listp range) (natp (fn-record-payload row))
       (not (< (fn-record-payload row) (fn-arena-count fn-arena)))
       (or (not (fn-hf-nov (fn-held-facts row)))
           (fn-hnov-p (fn-hf-nov (fn-held-facts row))))
       (not (ohret-conclusion range row fn-arena))))
 :rule-classes nil)
(defthm ohret-removal-cached-column-shape
 (let* ((fn-arena '((120 13 10))) (range '("g" 1 3 7 nil t))
        (facts (fn-hf-make 3 nil 0 (list nil nil nil '(nil t 300 "" "" "" ""))))
        (row (ohret-row 0 facts)))
  (and (true-listp range) (natp (fn-record-payload row))
       (< (fn-record-payload row) (fn-arena-count fn-arena))
       (not (or (not (fn-hf-nov (fn-held-facts row)))
                (fn-hnov-p (fn-hf-nov (fn-held-facts row)))))
       (not (ohret-conclusion range row fn-arena))))
 :rule-classes nil)

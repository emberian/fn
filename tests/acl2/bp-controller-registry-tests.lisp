(in-package "ACL2")
(include-book "../../books/bp-controller-registry")
; Unfunded source storage fixture, not sanctioned registration/installation.
(defun bpc-fixture-install (fn-bp-controller-registry)
  (declare (xargs :stobjs fn-bp-controller-registry :guard t))
  (let ((fn-bp-controller-registry (update-fn-bpcr-highwater 1 fn-bp-controller-registry)))
    (stobj-let ((fn-bpc-node (fn-bpcr-root fn-bp-controller-registry)))
      (fn-bpc-node)
      (stobj-let ((fn-bpc-segment (fn-bpcn-children-get 'fn-bpc-segment fn-bpc-node (create-fn-bpc-segment))))
        (fn-bpc-segment)
        (update-fn-bpcs-rowsi 0
          '(7 :live (:bpnf-state nil nil nil nil nil (:bpnf-operation 2 3 :checkpoint 9 :pending) nil 2 4 0) :source-fixture nil)
          fn-bpc-segment)
        fn-bpc-node)
      fn-bp-controller-registry)))
(defun bpc-fixture-observe (fn-bp-controller-registry)
  (declare (xargs :stobjs fn-bp-controller-registry :guard t))
  (mv-let (read current left)
    (fn-bpc-current '(:bp-controller 7 0) 4 fn-bp-controller-registry)
    (mv-let (wrong wrong-left fn-bp-controller-registry)
      (fn-bpc-current-replace '(:bp-controller 7 0) 1 (fn-bpnf-issued current) current 4 fn-bp-controller-registry)
      (mv-let (updated update-left fn-bp-controller-registry)
        (fn-bpc-current-replace '(:bp-controller 7 0) 2 (fn-bpnf-issued current)
          (fn-bpnf-state-with-arrival nil nil nil nil nil nil nil 3 5 0) 4 fn-bp-controller-registry)
        (mv-let (stale stale-left fn-bp-controller-registry)
          (fn-bpc-current-replace '(:bp-controller 7 0) 2 (fn-bpnf-issued current) current 4 fn-bp-controller-registry)
          (mv-let (r c f)
            (fn-bpc-current '(:bp-controller 7 0) 4 fn-bp-controller-registry)
            (mv (list read left wrong wrong-left updated update-left stale stale-left r (fn-bpnf-epoch c) f)
                fn-bp-controller-registry)))))))
(defun bpc-fixture ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn-bp-controller-registry
    (mv-let (answer fn-bp-controller-registry)
      (let ((fn-bp-controller-registry (bpc-fixture-install fn-bp-controller-registry)))
        (bpc-fixture-observe fn-bp-controller-registry))
      answer)))
(assert-event (equal (bpc-fixture) '(:current 3 :stale-current 3 :updated 3 :stale-current 3 :current 3 3)))
; The fence deliberately excludes payload-bearing KEY while retaining all
; fixed operation identity/status scalars. Changed operation ID is stale.
(assert-event
 (and (fn-bpc-issued-fencep '(:bpnf-operation 2 3 :deliver (huge-wire old) :pending)
                           '(:bpnf-operation 2 3 :deliver (other-wire) :pending))
      (not (fn-bpc-issued-fencep '(:bpnf-operation 2 3 :deliver (huge-wire old) :pending)
                                '(:bpnf-operation 2 4 :deliver (huge-wire old) :pending)))))

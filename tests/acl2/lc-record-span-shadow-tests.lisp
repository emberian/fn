; Probe whether CORR carries the resident NOV span bounds needed by append.
(in-package "ACL2")
(include-book "lc-record-effect-tests")
(include-book "lc-unlink-payload-counterexample-tests")
(defun lcrs-old-row ()
 (declare (xargs :guard t :verify-guards nil))
 (update-nth 11 (fn-hf-make 24 14 1
    (list nil nil nil (fn-hnov-make nil t "a" "" "" "<a@x>" ""))) (lct-held 0)))
(defun lcrs-log ()
 (declare (xargs :guard t :verify-guards nil))
 (fn-lb-log-model-append (lct-held 1) *lct-payload* 2
  (fn-lb-log-model-append (lcrs-old-row) *lct-payload* 1 nil)))
(defun lcrs-rows ()
 (declare (xargs :guard t :verify-guards nil))
 (fn-cat$a-commit (lcrs-old-row) nil))
(defun lcrs-seed (shadow fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((fn-lbc (fn-lbc-open-rebuild (lcrs-rows) (lcrs-log) fn-lbc))
        (end (fn-lbc-overview-pool-count fn-lbc)))
  (if shadow
   (stobj-let ((fn-lbc-nov (fn-lbc-nov-store fn-lbc)))
    (fn-lbc-nov)
    (let* ((fn-lbc-nov (fn-lbc-nov-set-references-start 0 end fn-lbc-nov))
           (fn-lbc-nov (fn-lbc-nov-set-references-length 0 1 fn-lbc-nov))) fn-lbc-nov)
    fn-lbc)
   fn-lbc)))
(defun lcrs-observe (shadow fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((fn-lbc (lcrs-seed shadow fn-lbc))
        (segs (lcrs-log)) (h (lct-held 1))
        (entry (fn-lb-log-model-row-entry h segs))
        (b (+ (* (fn-lc-at 3 entry) 4294967296) (fn-lc-at 4 entry)))
        (typed (fn-lbc-p fn-lbc)) (old (fn-lbc-original-nov 0 fn-lbc))
        (end (fn-lbc-overview-pool-count fn-lbc))
        (span (list (fn-lbc-nov-field :references-start 0 fn-lbc)
                    (fn-lbc-nov-field :references-length 0 fn-lbc)))
        (fresh (fn-lc-fresh-recordp h 2 b segs))
        (before-resolves (fn-lc-locators-resolve fn-lbc segs)))
  (mv-let (answer fn-lbc after) (fn-lc-commit-record h 2 b fn-lbc segs)
   (mv (list typed (fn-cat$ap (lcrs-rows)) (fn-lc-segsp segs)
             fresh before-resolves answer (fn-lc-locators-resolve fn-lbc after)
             end span (fn-hnov-references old)
             (fn-hnov-references (fn-lbc-original-nov 0 fn-lbc))) fn-lbc))))
(defun lcrs-run (shadow)
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-lbc
  (mv-let (out fn-lbc) (lcrs-observe shadow fn-lbc) out)))
(value-triple (lcrs-run nil))
(value-triple (lcrs-run t))
; FULL-FROZEN-CLAIM-CHECK
(defthm lcrs-record-positive
 (let* ((h (lct-held 1)) (segs (lcrs-log)) (rows (lcrs-rows))
        (entry (fn-lb-log-model-row-entry h segs))
        (loc0 2) (loc1 (+ (* (nth 3 entry) 4294967296) (nth 4 entry)))
        (fn-lbc (lcrs-seed nil (create-fn-lbc)))
        (out (fn-lc-commit-record h loc0 loc1 fn-lbc segs)))
  (and (fn-lbc-p fn-lbc) (fn-cat$ap rows) (fn-lbc-corr fn-lbc rows segs)
       (fn-lc-locators-resolve fn-lbc segs) (fn-lc-fresh-recordp h loc0 loc1 segs)
       (equal (mv-nth 0 out) :ok)
       (and (fn-lc-locators-resolve (mv-nth 1 out) (mv-nth 2 out))
            (fn-lbc-corr (mv-nth 1 out) (fn-cat$a-commit h rows) (mv-nth 2 out)))))

; Exact metadata fixtures, not installed family/BODY authority.
(in-package "ACL2")
(include-book "../../books/bp-digest-workspace-install-readout")
(include-book "bp-digest-workspace-factory-tests")
(include-book "bp-digest-workspace-registered-factory-tests")
(set-verify-guards-eagerness 0)
(defun bpdir-carry-local ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-bpd-workspace-carry
  (mv-let (answer fn-bpd-workspace-carry)
   (let* ((fn-bpd-workspace-carry
           (fn-bpd-factory-initialize-carry *bpdf-plan* fn-bpd-workspace-carry))
          (ready (fn-bpd-carry-install-readout *bpdf-plan* fn-bpd-workspace-carry))
          (wrong-nonce-plan
           (list :bp-digest-install (list :bp-digest 9 *bpdf-controller* *bpdf-job*)
                 *bpdf-controller* *bpdf-job* (fn-bpn-nth 4 *bpdf-plan*) :constructing 7))
          (wrong-source-plan
           (list :bp-digest-install *bpdf-token* *bpdf-controller* *bpdf-job*
                 (list :bp-checkpoint-stage *bpdf-job* 6) :constructing 7))
          (wrong-revision-plan
           (list :bp-digest-install *bpdf-token* *bpdf-controller* *bpdf-job*
                 (fn-bpn-nth 4 *bpdf-plan*) :constructing 8))
          (wrong-nonce (fn-bpd-carry-install-readout wrong-nonce-plan fn-bpd-workspace-carry))
          (wrong-source (fn-bpd-carry-install-readout wrong-source-plan fn-bpd-workspace-carry))
          (wrong-revision (fn-bpd-carry-install-readout wrong-revision-plan fn-bpd-workspace-carry))
          (weaker (fn-bpd-carry-status *bpdf-controller* *bpdf-job* 7 fn-bpd-workspace-carry))
          (fn-bpd-workspace-carry (update-fn-bpd-phase :installed fn-bpd-workspace-carry)))
    (mv (and (eq ready :storage-ready)
             (fn-bpd-install-readout-planp wrong-nonce-plan)
             (eq weaker :workspace-current) (eq wrong-nonce :stale-workspace)
             (eq wrong-source :stale-workspace) (eq wrong-revision :stale-workspace)
             (eq (fn-bpd-carry-install-readout *bpdf-plan* fn-bpd-workspace-carry) :already-installed))
        fn-bpd-workspace-carry)) answer)))
(assert-event (bpdir-carry-local))

(defun bpdir-registered-observe (fn-bp-controller-registry fn-page-read-pool)
 (declare (xargs :stobjs (fn-bp-controller-registry fn-page-read-pool) :guard t))
 (mv-let (setup fn-bp-controller-registry fn-page-read-pool)
  (bpdfr-observe fn-bp-controller-registry fn-page-read-pool)
  (mv-let (word job current claim payload phase revision left)
   (fn-bpcc-pending-capture '(:bp-controller 2 0) 4 fn-bp-controller-registry)
   (declare (ignore job current claim phase revision left))
   (let ((workspace (fn-bpdi-token (fn-bpdi-payload-intent payload))))
    (mv-let (ready ready-left fn-bp-controller-registry)
     (fn-bpd-registered-install-readout '(:bp-controller 2 0) workspace 4 fn-bp-controller-registry)
     (mv-let (stale stale-left fn-bp-controller-registry)
      (fn-bpd-registered-install-readout '(:bp-controller 3 0) workspace 4 fn-bp-controller-registry)
      (declare (ignore stale-left))
      (mv-let (yielded yield-left fn-bp-controller-registry)
       (fn-bpd-registered-install-readout '(:bp-controller 2 0) workspace 0 fn-bp-controller-registry)
       (mv (and setup (eq word :checkpoint-current)
                (eq ready :storage-ready) (equal ready-left 1)
                (eq stale :stale-checkpoint)
                (eq yielded :yield) (equal yield-left 0))
           fn-bp-controller-registry fn-page-read-pool))))))))
(defun bpdir-registered-local ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-bp-controller-registry
  (mv-let (answer fn-bp-controller-registry)
   (with-local-stobj fn-page-read-pool
    (mv-let (answer fn-bp-controller-registry fn-page-read-pool)
     (mv-let (fn-bp-controller-registry fn-page-read-pool)
      (fn-bpcc-payload-directory-test-install fn-bp-controller-registry fn-page-read-pool)
      (bpdir-registered-observe fn-bp-controller-registry fn-page-read-pool))
     (mv answer fn-bp-controller-registry))) answer)))
(assert-event (bpdir-registered-local))

(defun-nx ibrjout2-setup ()
 (let* ((arena '((65 66 67)))
        (token '(:index-query 17 1 0 7))
        (publication (fn-ipub-make 7 nil nil 1 19 7 nil 0 11 nil 0 12 nil 13 nil nil 4 1))
        (range '("g" 1 3 7 nil t))

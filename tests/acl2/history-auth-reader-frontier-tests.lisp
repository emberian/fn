; Deliberately corrupted-state hypothesis removals. Every retained literal
; premise is affirmed, the omitted one fails, and the full conclusion fails.
(defthm fn-hsr-digest-begin-natural-removal
  (let ((nb -1))
    (and (not (natp nb))
         (not (fn-hsr-digest-orderp (pgs-dc-begin 0 0 nb :captured :lease (create-pgs-digest-state))))))
  :hints (("Goal" :expand ((:free (end total cursor) (fn-hsr-digest-end-stackp 4 end total cursor))
                           (:free (end total cursor) (fn-hsr-digest-end-stackp 3 end total cursor))
                           (:free (end total cursor) (fn-hsr-digest-end-stackp 2 end total cursor))
                           (:free (end total cursor) (fn-hsr-digest-end-stackp 1 end total cursor))
                           (:free (end total cursor) (fn-hsr-digest-end-stackp 0 end total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 4 limit total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 3 limit total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 2 limit total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 1 limit total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 0 limit total cursor)))
                  :in-theory (e/d (pgs-dc-begin update-pgs-dc-mode update-pgs-dc-power fn-hsr-digest-orderp fn-hsr-digest-end-stackp fn-hsr-digest-frontier
                                     pgs-dc-framesi fn-b3-nthx
                                   pgs-dcd-domainp pgs-dcd-framesp pgs-dcd-powerp)
                                   ((:executable-counterpart pgs-dc-begin) (:executable-counterpart update-pgs-dc-power)))))
  :rule-classes nil)
(defthm fn-hsr-digest-step-domain-removal
  (let* ((cursor (update-pgs-dc-mode :split
                   (update-pgs-dc-pos 192 (pgs-dc-begin 0 0 32 :captured :lease (create-pgs-digest-state)))))
         (next (mv-nth 1 (pgs-dc-step nil cursor))))
    (and (fn-hsr-digest-orderp cursor) (not (pgs-dcd-domainp 4 cursor))
         (not (fn-hsr-digest-orderp next))))
  :hints (("Goal" :expand ((:free (end total cursor) (fn-hsr-digest-end-stackp 4 end total cursor))
                           (:free (end total cursor) (fn-hsr-digest-end-stackp 3 end total cursor))
                           (:free (end total cursor) (fn-hsr-digest-end-stackp 2 end total cursor))
                           (:free (end total cursor) (fn-hsr-digest-end-stackp 1 end total cursor))
                           (:free (end total cursor) (fn-hsr-digest-end-stackp 0 end total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 4 limit total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 3 limit total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 2 limit total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 1 limit total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 0 limit total cursor)))
                  :in-theory (e/d (pgs-dc-step pgs-dc-begin update-pgs-dc-mode update-pgs-dc-power fn-hsr-digest-orderp fn-hsr-digest-end-stackp fn-hsr-digest-frontier
                                     pgs-dc-framesi fn-b3-nthx
                                   pgs-dcd-domainp pgs-dcd-framesp pgs-dcd-powerp)
                                   ((:executable-counterpart pgs-dc-step) (:executable-counterpart update-pgs-dc-end) (:executable-counterpart update-pgs-dc-framesi) (:executable-counterpart update-pgs-dc-depth) (:executable-counterpart pgs-dc-begin) (:executable-counterpart update-pgs-dc-power)))))
  :rule-classes nil)

(in-package "ACL2")
(include-book "../../books/history-auth-reader-frontier")

; Test-only bounded seeker over actual operations, no invented intermediate
; cursor. The general scheduling theorems use no fuel or source size ceiling.
(defun fn-hsr-digest-test-seek (fuel mode side pgs-digest-state)
  (declare (xargs :stobjs pgs-digest-state :measure (nfix fuel) :verify-guards nil))
  (if (or (zp fuel)
          (and (equal (pgs-dc-mode pgs-digest-state) mode)
               (or (not side)
                   (and (posp (pgs-dc-depth pgs-digest-state))
                        (equal (fn-b3-nthx 0 (pgs-dc-framesi (1- (pgs-dc-depth pgs-digest-state)) pgs-digest-state)) side)))))
      pgs-digest-state
    (mv-let (status pgs-digest-state) (pgs-dc-step nil pgs-digest-state)
      (declare (ignore status))
      (fn-hsr-digest-test-seek (1- fuel) mode side pgs-digest-state))))

(defun-nx fn-hsr-digest-test-state (mode side)
  (fn-hsr-digest-test-seek 500 mode side
    (pgs-dc-begin 0 0 256 :captured :lease (create-pgs-digest-state))))

(defthm fn-hsr-digest-order-begin-positive
  (let ((nb 256))
    (and (natp nb)
         (fn-hsr-digest-orderp (pgs-dc-begin 0 0 nb :captured :lease (create-pgs-digest-state)))))
  :hints (("Goal" :in-theory (enable fn-hsr-digest-orderp fn-hsr-digest-end-stackp)))
  :rule-classes nil)

; One reachable witness per actual scheduling phase, including both kinds of
; frame return. Each asserts the complete literal antecedent and conclusion.
(defthm fn-hsr-digest-order-node-positive
  (let* ((cursor (fn-hsr-digest-test-state :node nil))
         (next (mv-nth 1 (pgs-dc-step nil cursor))))
    (and (equal (pgs-dc-mode cursor) :node)
         (pgs-dcd-domainp 4 cursor) (fn-hsr-digest-orderp cursor)
         (fn-hsr-digest-orderp next)
         (equal (fn-hsr-digest-frontier next)
                (+ (fn-hsr-digest-frontier cursor) (pgs-dc-read-demand cursor)))))
  :hints (("Goal" :expand ((:free (end total cursor) (fn-hsr-digest-end-stackp 4 end total cursor))
                           (:free (end total cursor) (fn-hsr-digest-end-stackp 3 end total cursor))
                           (:free (end total cursor) (fn-hsr-digest-end-stackp 2 end total cursor))
                           (:free (end total cursor) (fn-hsr-digest-end-stackp 1 end total cursor))
                           (:free (end total cursor) (fn-hsr-digest-end-stackp 0 end total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 4 limit total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 3 limit total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 2 limit total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 1 limit total cursor))
                           (:free (limit total cursor) (pgs-dcd-framesp 0 limit total cursor)))
                  :in-theory (enable fn-hsr-digest-orderp fn-hsr-digest-end-stackp fn-hsr-digest-frontier
                                     pgs-dc-framesi fn-b3-nthx
                                   pgs-dcd-domainp pgs-dcd-framesp pgs-dcd-powerp)))
  :rule-classes nil)

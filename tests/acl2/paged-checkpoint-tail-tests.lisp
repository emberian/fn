(in-package "ACL2")
(include-book "../../books/paged-checkpoint-tail")
(include-book "must-fail-checked")
(include-book "std/testing/assert-bang" :dir :system)
(defun pck-tail-test ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj pgs-mem
   (mv-let (out pgs-mem)
    (let* ((pgs-mem (resize-pgs-w 18435 pgs-mem))
           (pgs-mem (update-pgs-wi 18432 19 pgs-mem))
           (pgs-mem (update-pgs-wi 18433 20 pgs-mem))
           (pgs-mem (update-pgs-wi 18434 21 pgs-mem))
           (words (pgs-x-words 0 16384 2051 pgs-mem)))
      (mv (and (natp 2051) (<= (+ 16384 2051) (pgs-x-len 0 pgs-mem))
           (equal words (append (make-list 2048 :initial-element 0) '(19 20 21)))
           (equal (fn-pck-x-tail 2051 pgs-mem)
                  (nthcdr (* 2048 (floor 2051 2048)) words))
           (equal (fn-pck-x-tail 2048 pgs-mem) nil)
           (equal (fn-pck-x-tail 2051 pgs-mem) '(19 20 21))
           (not (equal (fn-pck-x-tail 2050 pgs-mem) '(19 20 21)))) pgs-mem))
    out)))
(assert-event (pck-tail-test))
(defun pck-tail-wrong-cursor ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj pgs-mem
   (mv-let (out pgs-mem)
    (let* ((pgs-mem (resize-pgs-w 18435 pgs-mem))
           (pgs-mem (update-pgs-wi 18432 19 pgs-mem))
           (pgs-mem (update-pgs-wi 18433 20 pgs-mem))
           (pgs-mem (update-pgs-wi 18434 21 pgs-mem)))
      (mv (equal (fn-pck-x-tail 2050 pgs-mem) '(19 20 21)) pgs-mem))
    out)))
(must-fail-checked (assert-event (pck-tail-wrong-cursor)))

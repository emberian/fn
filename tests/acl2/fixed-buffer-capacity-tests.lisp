(in-package "ACL2")
(include-book "../../books/fixed-buffer-capacity")
; Internal algebra fixtures: amounts are not runtime constructor adequacy.
(defconst *bca-base* (fn-prl-build '(16384 0 0 0 8) '(0 0 0 0 0) 0 nil '(512 0 0 0 0)))
(defconst *bca-worker* (mv-list 3 (fn-bca-admit :worker-capacity '(0) '(4096 0 0 0 1) *bca-base*)))
(defconst *bca-rx* (mv-list 3 (fn-bca-admit :rx-capacity '(0 4096) '(4096 0 0 0 1) (nth 2 *bca-worker*))))
(defconst *bca-token* (nth 1 *bca-rx*))
(defconst *bca-held* (nth 2 *bca-rx*))
(assert-event (and (equal (nth 0 *bca-worker*) :admitted)
                   (equal (nth 0 *bca-rx*) :admitted)
                   (equal *bca-token* '(:rx-capacity 1 0 4096))
                   (equal (mv-list 3 (fn-rxc-installed-readout *bca-token* *bca-held*))
                          '(:stale-capacity nil 0))))
(defconst *bca-installed* (mv-list 2 (fn-bca-promote-installed *bca-token* *bca-held*)))
(assert-event (and (equal (nth 0 *bca-installed*) :installed)
                   (equal (mv-list 3 (fn-rxc-installed-readout *bca-token* (nth 1 *bca-installed*)))
                          '(:installed 0 4096))
                   (equal (fn-iqr-resident-total (nth 1 *bca-installed*)) (fn-iqr-resident-total *bca-held*))
                   (equal (mv-list 2 (fn-bca-promote-installed *bca-token* (nth 1 *bca-installed*)))
                          (list :stale-capacity (nth 1 *bca-installed*)))))
(assert-event (and (equal (mv-list 3 (fn-bca-admit :rx-capacity '(0 4096) '(4096 0 0 0 1) *bca-held*))
                          (list :invalid-capacity-request nil *bca-held*))
                   (equal (mv-list 3 (fn-rxc-installed-readout '(:rx-capacity 1 1 4096) (nth 1 *bca-installed*)))
                          '(:stale-capacity nil 0))))

(local (defun b1-disable-column-execution (runes)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp runes)
  (let* ((r (car runes)) (sym (cadr r))
         (name (if (symbolp sym) (symbol-name sym) "")))
   (if (and (equal (car r) :executable-counterpart)
            (or (equal (subseq name 0 (min 7 (length name))) "FN-LBC-")
                (equal (subseq name 0 (min 8 (length name))) "FN-DMAP-")
                (equal sym 'create-fn-lbc)))
       (cons r (b1-disable-column-execution (cdr runes)))
     (b1-disable-column-execution (cdr runes)))) nil)))

(local (defun b1-enable-column-definitions (runes)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp runes)
  (let* ((r (car runes)) (sym (cadr r))
         (name (if (symbolp sym) (symbol-name sym) "")))
   (if (and (equal (car r) :definition)
            (or (equal (subseq name 0 (min 7 (length name))) "FN-LBC-")
                (equal (subseq name 0 (min 8 (length name))) "FN-DMAP-")
                (equal sym 'create-fn-lbc)))
       (cons r (b1-enable-column-definitions (cdr runes)))
     (b1-enable-column-definitions (cdr runes)))) nil)))


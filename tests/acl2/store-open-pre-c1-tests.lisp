(defconst *sopc-cfg1*
  '(70 102 110 45 99 102 103 0 24 28 0 0 1 0 0 0 0 4 1 71 102 110 46 116
    101 115 116 83 102 110 45 112 111 108 105 99 121 45 100 101 102 97 117 108 116 45 49 0
    0 1 78 99 111 110 116 114 111 108 46 99 97 110 99 101 108 83 102 110 45 112 111 108
    105 99 121 45 100 101 102 97 117 108 116 45 49 0 0 3 64 64 26 0 16 0 0 0
    8 75 109 97 120 45 112 97 121 108 111 97 100 64 25 128 0 0))

; The frame's trailer is its digest (the host compares SHA-256 of the
; protected prefix with it; here the stored trailer is passed as observed).
(defun sopc-last32 (xs)
  (declare (xargs :mode :program))
  (nthcdr (- (len xs) 32) xs))

(defun sopc-rec (txn)
  (declare (xargs :mode :program))
  (let* ((frame (fn-frame-store-decode txn (sopc-last32 txn)))
         (decoded (fn-store-event-decode-exact (fn-frame-result-payload frame))))
    (if (and (fn-frame-result-okp frame) (consp decoded) (eq (car decoded) :ok))
        (cadr decoded)
      :bad)))

(defun sopc-r0 () (declare (xargs :mode :program)) (sopc-rec *sopc-txn0*))
(defun sopc-r1 () (declare (xargs :mode :program)) (sopc-rec *sopc-txn1*))
(defun sopc-r2 () (declare (xargs :mode :program)) (sopc-rec *sopc-txn2*))
(defun sopc-configs ()
  (declare (xargs :mode :program))
  (list (cadr (fn-cfg-decode-exact *sopc-cfg1*))))

; The full open of a history, as fn-store-sn-recover builds it.
(defun sopc-open (history)
  (declare (xargs :mode :program))
  (fn-sopc-classified-open
   (fn-sco-extend (fn-sco-capture (sopc-configs) nil) (sopc-configs) history)
   (sopc-configs) 3))

(defun sopc-old-open (history)
  (declare (xargs :mode :program))
  (fn-sco-store-open
   (fn-sco-extend (fn-sco-capture (sopc-configs) nil) (sopc-configs) history)
   (sopc-configs) 3))

; The cancel's composite with its article record's groups replaced
; (a mutation of the witness, labelled where used).
(defun sopc-regroup (event groups)
  (declare (xargs :mode :program))
  (let ((record (fn-sopc-article event)))
    (fn-stxa-make-full (fn-stxa-sequence event) (fn-stxa-txid event)
                       (fn-stxa-generation event)
                       (fn-stxa-keyring-generation event) (fn-stxa-profile event)
                       (fn-stxa-content-subject event)
                       (fn-record-encode (update-nth 5 groups record))
                       (fn-stxa-verdict-event event)
                       (fn-stxa-authored-source event)
                       (fn-stxa-authored-id event))))

(defconst *sopc-refusal*
  '(:refused :pre-c1-control-record 2 "<prec1-cancel@example.invalid>"))

; The witness decodes: three Store events, the cancel a pre-C1 control
; record (schema 1, groups ("fn.test"), filing group ("control.cancel")),
; the target not one.
(assert-event (and (fn-stxk-p (sopc-r0)) (fn-stxa-p (sopc-r1)) (fn-stxa-p (sopc-r2))))
(assert-event (fn-sopc-pre-c1-control-record-p (sopc-r2)))
(assert-event (not (fn-sopc-pre-c1-control-record-p (sopc-r1))))
(assert-event (equal (fn-record-groups (fn-sopc-article (sopc-r2))) '("fn.test")))
(assert-event
 (let* ((source (fn-stxa-authored-source (sopc-r2)))
        (fields (fn-hsig-authored-source-fields source)))
   (equal (fn-hsig-source-filed-groups source fields) '("control.cancel"))))

; What the current replay did before this book: the identity fold stops at
; the cancel (cursor 2) with the generic fault, and the open is an error.
(assert-event
 (let ((ctx (fn-replay-identity (list (sopc-r0) (sopc-r1) (sopc-r2)))))
   (and (equal (fn-stxk-context-kind ctx) :fault)
        (equal (fn-stxk-context-next ctx) 2)
        (equal (fn-stxk-context-tail ctx) :composite-binding))))
(assert-event
 (equal (cadr (sopc-old-open (list (sopc-r0) (sopc-r1) (sopc-r2))))
        '(:error :identity)))

; ---------------------------------------------------------------------------
; fn-replay-identity-step-never-admits-a-pre-c1-control-record
; (one hypothesis: the event is a pre-C1 control record)

; Reachable: the fold of the witness's first two records, then the cancel.
(assert-event
 (let* ((ctx (fn-replay-identity (list (sopc-r0) (sopc-r1))))
        (next (fn-replay-identity-step ctx (sopc-r2))))
   (and (equal (fn-stxk-context-kind ctx) :ok)
        (fn-sopc-pre-c1-control-record-p (sopc-r2))
        (not (equal (fn-stxk-context-kind next) :ok))
        (equal (fn-stxk-context-next next) (fn-stxk-context-next ctx)))))

; Without it: the target, which is not one, is admitted and advances.
(assert-event (not (fn-sopc-pre-c1-control-record-p (sopc-r1))))
(must-fail
 (assert-event
  (let* ((ctx (fn-replay-identity (list (sopc-r0))))
         (next (fn-replay-identity-step ctx (sopc-r1))))
    (and (not (equal (fn-stxk-context-kind next) :ok))
         (equal (fn-stxk-context-next next) (fn-stxk-context-next ctx))))))

; ---------------------------------------------------------------------------
; fn-replay-never-faults-on-a-pre-c1-control-record
; H1 the prefix's identity fold is :ok; H2 the event is a pre-C1 control
; record; H3 its sequence is the prefix's length.

; Reachable: prefix (r0 r1), event r2, rest nil: the witness store itself.
(assert-event
 (and (equal (fn-stxk-context-kind (fn-replay-identity (list (sopc-r0) (sopc-r1)))) :ok)
      (fn-sopc-pre-c1-control-record-p (sopc-r2))
      (equal (fn-store-event-sequence (sopc-r2)) 2)
      (equal (sopc-open (list (sopc-r0) (sopc-r1) (sopc-r2))) *sopc-refusal*)
      (equal (fn-sopc-refusal-text *sopc-refusal*)
             "pre-C1 control record (txid 2, <prec1-cancel@example.invalid>): run store repair-control")))

; Without H1 (mutation, labelled): the target's record regrouped to
; fn.other stops the fold at sequence 1; H2 and H3 hold of the cancel at
; sequence 2; the open is not the refusal (it names nothing it did not
; reach).
(assert-event
 (let ((bad (sopc-regroup (sopc-r1) '("fn.other"))))
   (and (not (equal (fn-stxk-context-kind (fn-replay-identity (list (sopc-r0) bad))) :ok))
        (fn-sopc-pre-c1-control-record-p (sopc-r2))
        (equal (fn-store-event-sequence (sopc-r2)) 2))))
(must-fail
 (assert-event
  (equal (sopc-open (list (sopc-r0) (sopc-regroup (sopc-r1) '("fn.other")) (sopc-r2)))
         *sopc-refusal*)))

; Without H2: the target after the keyring snapshot (H1, H3 hold): it opens.
(assert-event
 (and (equal (fn-stxk-context-kind (fn-replay-identity (list (sopc-r0)))) :ok)
      (not (fn-sopc-pre-c1-control-record-p (sopc-r1)))
      (equal (fn-store-event-sequence (sopc-r1)) 1)
      (equal (fn-sn-open-kind (cadr (sopc-open (list (sopc-r0) (sopc-r1))))) :ok)))
(must-fail
 (assert-event
  (equal (car (sopc-open (list (sopc-r0) (sopc-r1)))) :refused)))

; Without H3: the cancel directly after the snapshot (sequence 2 at
; position 1; H1, H2 hold): the fold stops on the sequence, not on the
; record, and nothing is named; the open stays the error it was.
(assert-event
 (and (equal (fn-stxk-context-kind (fn-replay-identity (list (sopc-r0)))) :ok)
      (fn-sopc-pre-c1-control-record-p (sopc-r2))
      (not (equal (fn-store-event-sequence (sopc-r2)) 1))))
(must-fail
 (assert-event
  (equal (sopc-open (list (sopc-r0) (sopc-r2))) *sopc-refusal*)))

; The checkpoint open names what the full open names (prefix (r0 r1)
; captured, suffix (r2)).
(assert-event
 (equal (fn-sopc-classified-open
         (fn-sco-extend (fn-sco-capture (sopc-configs) (list (sopc-r0) (sopc-r1)))
                        (sopc-configs) (list (sopc-r2)))
         (sopc-configs) 3)
        *sopc-refusal*))

; ---------------------------------------------------------------------------
; fn-sopc-classified-open-is-the-open-without-a-pre-c1-record
; (one hypothesis: no record of the history is a pre-C1 control record)

; Reachable: the history without the cancel (the ordinary replay's store):
; the classified open is the old open, and it opens.
(assert-event
 (let ((history (list (sopc-r0) (sopc-r1))))
   (and (fn-sopc-free-p history)
        (equal (sopc-open history) (sopc-old-open history))
        (equal (fn-sn-open-kind (cadr (sopc-open history))) :ok))))

; A post-C1 filing of the same cancel (mutation, labelled: the record's
; groups are its filing group control.cancel) is no pre-C1 record, and the
; history opens: the refusal never touches a post-C1 history.
(assert-event
 (let ((history (list (sopc-r0) (sopc-r1)
                      (sopc-regroup (sopc-r2) '("control.cancel")))))
   (and (fn-sopc-free-p history)
        (equal (sopc-open history) (sopc-old-open history))
        (equal (fn-sn-open-kind (cadr (sopc-open history))) :ok))))
(must-fail
 (assert-event
  (equal (car (sopc-open (list (sopc-r0) (sopc-r1)
                               (sopc-regroup (sopc-r2) '("control.cancel")))))
         :refused)))

; Without the hypothesis: the witness history; the classified open is not
; the old open.
(assert-event (not (fn-sopc-free-p (list (sopc-r0) (sopc-r1) (sopc-r2)))))
(must-fail
 (assert-event
  (let ((history (list (sopc-r0) (sopc-r1) (sopc-r2))))
    (equal (sopc-open history) (sopc-old-open history)))))

; Corrupted state (labelled): a cancel record listing neither its
; Newsgroups nor its filing group ("fn.test" "control.cancel") is not a
; pre-C1 filing; the open is not refused by name and stays the identity
; error it is.
(assert-event
 (let ((odd (sopc-regroup (sopc-r2) '("fn.test" "control.cancel"))))
   (and (not (fn-sopc-pre-c1-control-record-p odd))
        (equal (cadr (sopc-open (list (sopc-r0) (sopc-r1) odd)))
               '(:error :identity)))))

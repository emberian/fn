; Exact PRE-change bodies retained as current-model mutants under the ID-6 ruling.
(defun lct-id6-current-replayed-header (disk r mode segs)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((header (fn-lc-cold-adopted-header disk r mode))
        (allocated (ec-call (fn-lc-allocation-header header segs)))
        (next (fn-lc-header-next-id allocated))
        (exhausted (fn-lc-header-exhaustedp allocated))
        (scan (fn-lc-tail-scan segs header))
        (tail (fn-lc-tail-history segs header))
        (ordered (fn-lc-ordered-segments segs))
        (last-id (if (consp ordered) (fn-lc-last-segment-id ordered)
                   (fn-lc-at 0 (fn-lc-header-S header))))
        (last-seg (fn-lc-assoc last-id segs))
        (S (if (consp tail)
               (list last-id (len (fn-lc-at 1 last-seg))
                     (+ (fn-lc-header-sequence header) (len tail))
                     (fn-lc-at 3 (fn-lc-header-S header)) (fn-lc-at 3 scan))
             (fn-lc-header-S header))))
   (list :lc-header S next exhausted (fn-lc-at 4 header) (fn-lc-at 5 header))))
(defun lct-id6-current-open (disk r mode configs frontier max-conns segs outcome fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((program (fn-lc-open-program disk r mode segs))
        (cut (fn-lc-outcome-ok-count outcome (len program)))
        (trace (fn-lc-take (min (+ 1 cut) (len program)) program))
        (header (fn-lc-cold-adopted-header disk r mode)))
   (if (not (equal cut (len program))) (mv :uncertain fn-lbc disk segs trace :fault)
    (mv-let (answer fn-lbc adopted-disk adopted-segs adopted-trace)
      (fn-lc-adopt disk r mode segs fn-lbc)
      (declare (ignore adopted-trace))
      (if (or (not (equal answer :ok)) (not (fn-lc-segs-retain segs header)))
          (mv :checkpoint-image fn-lbc adopted-disk adopted-segs trace :fault)
        (let* ((rows (fn-lc-prefix-rows 0 (fn-lbc-count fn-lbc) segs fn-lbc))
               (tail (fn-lc-tail-history segs header))
               (seed (fn-lc-owner-seed (fn-lc-selected-control disk r mode) rows))
               (owner (fn-lc-owner-from-seed seed configs frontier
                                            (fn-lc-acceptance-tail tail) max-conns)))
          (if (equal owner :fault) (mv :owner-replay fn-lbc disk segs trace :fault)
            (mv-let (answer fn-lbc replayed-segs)
              (fn-lc-replay-positioned-tail (fn-lc-positioned-tail segs header) segs fn-lbc)
              (mv answer fn-lbc disk replayed-segs trace
                  (if (equal answer :ok) owner :fault))))))))))

; Finite code = candidate-bit + 2*damage + 16*old-index + 80*new-index
;   + 400*old-exhausted + 800*new-exhausted + 1600*segs-index + 6400*mode.
; 12800 cases. IDs: 0,1,2,100,u64-max. Segs from lco-id5-input 0,1,2,7.
; damage 0 none,1 directory,2 table,3 header,4 control,5 column-digest,
;        6 torn root (invalid slot is not examined),7 malformed layout.
(defun lct-id6-id (i)
 (declare (xargs :guard t :verify-guards nil))
 (fn-lc-at (mod (nfix i) 5) '(0 1 2 100 18446744073709551615)))
(defun lct-id6-disk (two damage old-next new-next old-ex new-ex)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((base (fn-lc-at 0 (lco-id5-input 1)))
        (columns (fn-lc-cold-adopted-columns base :lc :eager))
        (h (fn-lc-cold-adopted-header base :lc :eager))
        (oh (update-nth 3 old-ex (update-nth 2 old-next h)))
        (nh (update-nth 3 new-ex (update-nth 2 new-next h)))
        (nh (if (equal damage 7) (update-nth 4 nil nh) nh))
        (old (fn-lc-proof-image-disk (fn-lc-pages columns oh)))
        (disk (if two (pgs-commit old :lc :eager
                    (fn-lc-proof-data-pages (fn-lc-pages columns nh) 0)
                    (fn-lc-publication-alloc old)) old))
        (slot (if two 1 0)) (slots (pgs-root-slots :lc disk))
        (rec (pgs-slot slot slots)) (other (pgs-slot (- 1 slot) slots))
        (pages (pgs-pages disk)) (dir (pgs-lookup (pgs-rec-dir-addr rec) pages))
        (table (pgs-flatten (pgs-contents dir pages)))
        (address (case damage (1 (pgs-rec-dir-addr rec))
                   (2 (fn-lc-head (fn-lc-head dir)))
                   (3 (fn-lc-head (fn-lc-head table)))
                   (otherwise (fn-lc-head (fn-lc-at 3 table))))))
  (cond ((equal damage 6)
          (cons pages (list (cons :lc (if two (cons other '(:torn)) (cons '(:torn) other))))))
        ((member-equal damage '(1 2 3 4))
          (cons (cons (cons address '(:damaged)) pages) (pgs-roots disk)))
        ((equal damage 5)
          (let* ((entry (fn-lc-at 1 table))
                 (table (update-nth 1 (update-nth 2 (+ 1 (nfix (fn-lc-at 2 entry))) entry) table))
                 (dir (cons (update-nth 2 (pgs-digest table) (fn-lc-head dir)) (fn-lc-rest dir)))
                 (rec (pgs-make-rec (pgs-rec-txid rec) (pgs-rec-dir-addr rec)
                                     (pgs-rec-npages rec) (pgs-digest dir)))
                 (pages (cons (cons (fn-lc-head (fn-lc-head dir)) table)
                              (cons (cons (pgs-rec-dir-addr rec) dir) pages))))
            (cons pages (list (cons :lc (if two (cons other rec) (cons rec other)))))))
        (t disk))))
(defun lct-id6-input (code)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((c (mod (nfix code) 12800))
        (seed (lco-id5-input (fn-lc-at (mod (floor c 1600) 4) '(0 1 2 7)))))
  (list (lct-id6-disk (equal (mod c 2) 1) (mod (floor c 2) 8)
                    (lct-id6-id (floor c 16)) (lct-id6-id (floor c 80))
                    (equal (mod (floor c 400) 2) 1) (equal (mod (floor c 800) 2) 1))
        (if (< c 6400) :eager :lazy) (fn-lc-at 2 seed) (fn-lc-at 3 seed)
        (fn-lc-proof-ok-outcomes 100))))

(defun lct-id6-current-observation (disk r mode configs frontier max-conns segs outcome fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (mv-let (answer fn-lbc nextdisk aftersegs trace owner)
  (lct-id6-current-open disk r mode configs frontier max-conns segs outcome fn-lbc)
  (declare (ignore nextdisk aftersegs trace owner))
  (let* ((recs (fn-lc-examined-records disk r)) (pages (pgs-pages disk))
         (h (lct-id6-current-replayed-header disk r mode segs))
         (known (fn-lc-records-next-ids-known-p recs pages))
         (floor (fn-lc-records-max-next-id recs pages))
         (next (fn-lc-header-next-id h))
         (ex (fn-lc-header-exhaustedp h))
         (floorp (<= floor next))
         (exp (implies (fn-lc-records-any-exhausted-p recs pages) ex)))
   (mv (list answer known floor next ex floorp exp
         (implies (equal answer :ok) (and known floorp exp))
         (implies (and (equal (fn-lc-outcome-ok-count outcome (len (fn-lc-open-program disk r mode segs)))
                              (len (fn-lc-open-program disk r mode segs)))
                       (equal (fn-lc-head (fn-lc-cold-select disk r mode)) :ok)
                       (not known))
                  (equal answer :lc-next-id-unverifiable))) fn-lbc))))
(defthm lct-id6-current-7-is-the-claim
 (equal (nth 7 (mv-nth 0 (lct-id6-current-observation disk r mode configs frontier max-conns segs outcome fn-lbc)))
 (let* ((out (lct-id6-current-open disk r mode configs frontier max-conns segs outcome fn-lbc))
        (recs (fn-lc-examined-records disk r))
        (pages (pgs-pages disk))
        (h (lct-id6-current-replayed-header disk r mode segs)))
  (implies (equal (mv-nth 0 out) :ok)
           (and (fn-lc-records-next-ids-known-p recs pages)
                (<= (fn-lc-records-max-next-id recs pages) (fn-lc-header-next-id h))
                (implies (fn-lc-records-any-exhausted-p recs pages)
                         (fn-lc-header-exhaustedp h))))))
 :rule-classes nil
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
  '(lct-id6-current-observation nth mv-nth car-cons cdr-cons (:executable-counterpart zp))))))
(defthm lct-id6-current-8-is-the-claim
 (equal (nth 8 (mv-nth 0 (lct-id6-current-observation disk r mode configs frontier max-conns segs outcome fn-lbc)))
 (let ((out (lct-id6-current-open disk r mode configs frontier max-conns segs outcome fn-lbc)))
  (implies (and (equal (fn-lc-outcome-ok-count outcome (len (fn-lc-open-program disk r mode segs)))
                       (len (fn-lc-open-program disk r mode segs)))
                (equal (fn-lc-head (fn-lc-cold-select disk r mode)) :ok)
                (not (fn-lc-records-next-ids-known-p (fn-lc-examined-records disk r)
                                                     (pgs-pages disk))))
           (equal (mv-nth 0 out) :lc-next-id-unverifiable))))
 :rule-classes nil
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
  '(lct-id6-current-observation nth mv-nth car-cons cdr-cons (:executable-counterpart zp))))))
(defun lct-id6-current-run (code)
 (declare (xargs :guard t :verify-guards nil))
 (let ((i (lct-id6-input code)))
  (with-local-stobj fn-lbc
   (mv-let (v fn-lbc)
    (lct-id6-current-observation (fn-lc-at 0 i) :lc (fn-lc-at 1 i) (fn-lc-at 2 i) 8 4
                             (fn-lc-at 3 i) (fn-lc-at 4 i) fn-lbc) v))))
(defun lct-id6-current-check (code)
 (declare (xargs :guard t :verify-guards nil))
 (let ((v (lct-id6-current-run code))) (and (fn-lc-at 7 v) (fn-lc-at 8 v))))


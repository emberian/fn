; Independent read observer for the reference view, following its PGS verdicts.
(defun lct-id6-view-reads (rec pages)
 (declare (xargs :guard t :verify-guards nil))
 (if (not (pgs-rec-valid rec)) nil
  (let* ((addr (pgs-rec-dir-addr rec)) (dir (pgs-lookup addr pages))
         (txid (pgs-rec-txid rec)))
   (cons addr
    (if (pgs-dir-verdict rec dir (pgs-digest dir)) nil
     (append (fn-lc-pgs-checked-requests dir txid :eager pages)
      (if (pgs-check-pages dir txid :eager pages 0 :table-damaged) nil
       (let* ((cs (pgs-contents dir pages)) (table (pgs-flatten cs)))
        (if (or (pgs-tables-verdict cs (pgs-rec-npages rec) txid 0) (not (consp table))) nil
         (list (fn-lc-head (fn-lc-head table))))))))))))
(defun lct-id6-reads-within-candidates (recs pages)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp recs)
  (and (subsetp-equal (lct-id6-view-reads (car recs) pages)
                     (fn-lc-at 3 (fn-lc-cold-candidate (car recs) pages)))
       (lct-id6-reads-within-candidates (cdr recs) pages)) t))
(defun lct-id6-read-case (code)
 (declare (xargs :guard t :verify-guards nil))
 (let ((disk (fn-lc-at 0 (lct-id6-input code))))
  (lct-id6-reads-within-candidates (fn-lc-examined-records disk :lc) (pgs-pages disk))))
(defun lct-id6-read-sweep (n)
 (declare (xargs :guard t :verify-guards nil :measure (nfix n)))
 (if (zp n) t (and (lct-id6-read-case (1- n)) (lct-id6-read-sweep (1- n)))))
; SAT-1 code 16: one candidate next=1, seg IDs 0,0. SAT-2 code 265:
; two candidates, control damaged, old=1/new=100, seg IDs 0,0 -> current next=1.
; For exact TOOTH-1 replay=2 use segs-index 1, code 1865.
(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
 (with-guard-checking-event :none
  (assert-event (let ((v (lct-id6-m-run 16)))
   (and (equal (fn-lc-at 0 v) :ok) (equal (fn-lc-at 2 v) (fn-lc-at 3 v))
        (fn-lc-at 7 v) (fn-lc-at 8 v)))))
 (with-guard-checking-event :none
  (assert-event (let ((v (lct-id6-m-run 1865)))
   (and (equal (fn-lc-at 0 v) :ok) (equal (fn-lc-at 2 v) 100)
        (<= 100 (fn-lc-at 3 v)) (fn-lc-at 7 v) (fn-lc-at 8 v)))))
 (with-guard-checking-event :none
  (assert-event (let ((v (lct-id6-current-run 1865)))
   (and (equal (fn-lc-at 0 v) :ok) (equal (fn-lc-at 3 v) 2)
        (not (fn-lc-at 5 v)) (not (fn-lc-at 7 v))))))
 (with-guard-checking-event :none
  (assert-event (let ((v (lct-id6-current-run 1863)) (m (lct-id6-m-run 1863)))
   (and (equal (fn-lc-at 0 v) :ok) (not (fn-lc-at 1 v)) (not (fn-lc-at 7 v))
        (equal (fn-lc-at 0 m) :lc-next-id-unverifiable) (fn-lc-at 8 m)))))
 (with-guard-checking-event :none
  (assert-event (let ((v (lct-id6-current-run 2665)) (m (lct-id6-m-run 2665)))
   (and (equal (fn-lc-at 0 v) :ok) (not (fn-lc-at 4 v)) (not (fn-lc-at 6 v))
        (equal (fn-lc-at 0 m) :ok) (fn-lc-at 4 m) (fn-lc-at 7 m)))))
 (with-guard-checking-event :none (assert-event (lct-id6-read-sweep 12800)))
 (with-guard-checking-event :none (value-triple (lct-id6-current-run 1865)))
 (with-guard-checking-event :none (value-triple (lct-id6-m-run 1865))))

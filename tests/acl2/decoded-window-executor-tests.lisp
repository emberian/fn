(in-package "ACL2")
(include-book "decoded-window-lease-tests")
(include-book "../../books/page-window-executor")
(defconst *pwzx-token* (nth 1 *pwz-admitted*))
(defconst *pwzx-acquired* (mv-list 3 (fn-pwx-acquire (nth 2 *pwz-admitted*) (fn-pxe-new 0) *pwzx-token*)))
(defconst *pwzx-worker* (nth 1 *pwzx-acquired*))
(defconst *pwzx-held* (nth 2 *pwzx-acquired*))
; Actual decoded issuer -> shared exact worker branch, not an invented row.
(assert-event (and (fn-pwz-tokenp *pwzx-token*) (fn-pwx-tokenp *pwzx-token*)
  (equal (nth 0 *pwzx-acquired*) :assigned)
  (fn-pwx-boundp *pwzx-held* *pwzx-worker* *pwzx-token* :running)
  (fn-pwx-work-permittedp *pwzx-held* *pwzx-worker* *pwzx-token*)
  (equal (fn-prl-nth 1 *pwzx-held*) (fn-prl-nth 1 (nth 2 *pwz-admitted*)))))
(defconst *pwzx-cancelled* (mv-list 3 (fn-pwx-cancel *pwzx-held* *pwzx-worker* *pwzx-token*)))
; Cancellation never implies physical return or refund.
(assert-event (and (equal (nth 0 *pwzx-cancelled*) :cancelled)
  (not (fn-pwx-work-permittedp (nth 2 *pwzx-cancelled*) (nth 1 *pwzx-cancelled*) *pwzx-token*))
  (equal (fn-prl-nth 1 (nth 2 *pwzx-cancelled*)) (fn-prl-nth 1 *pwzx-held*))
  (equal (nth 0 (mv-list 3 (fn-pwx-settle-cancelled (nth 2 *pwzx-cancelled*) (nth 1 *pwzx-cancelled*) *pwzx-token*))) :stale-job)))
(defconst *pwzx-returned* (mv-list 3 (fn-pwx-return (nth 2 *pwzx-cancelled*) (nth 1 *pwzx-cancelled*) *pwzx-token*)))
(defconst *pwzx-settled* (mv-list 3 (fn-pwx-settle-cancelled (nth 2 *pwzx-returned*) (nth 1 *pwzx-returned*) *pwzx-token*)))
(assert-event (and (equal (nth 0 *pwzx-returned*) :returned)
  (equal (fn-prl-nth 2 (nth 1 *pwzx-returned*)) :cancelled-returned)
  (equal (fn-prl-nth 1 (nth 2 *pwzx-returned*)) (fn-prl-nth 1 *pwzx-held*))
  (equal (nth 0 *pwzx-settled*) :released)
  (equal (fn-prl-nth 1 (nth 2 *pwzx-settled*)) '(64 0 1 0 1))
  (not (fn-pwx-boundp (nth 2 *pwzx-settled*) (nth 1 *pwzx-settled*) *pwzx-token* :running))))
; Changing decoded N is stale full identity, even with identical file/span.
(assert-event (equal (mv-list 3 (fn-pwx-return *pwzx-held* *pwzx-worker* (update-nth 9 251 *pwzx-token*)))
                     (list :stale-job *pwzx-worker* *pwzx-held*)))

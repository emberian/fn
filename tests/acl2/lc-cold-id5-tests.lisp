; ID-5 C2: exercise cold selection separately from eager PGS fallback.
; Both candidates have ordinary empty columns, valid metadata and headers.
; Only the newer column's expected digest is changed; its bytes stay valid.
(in-package "ACL2")
(include-book "lc-open-id-search-tests")
(include-book "../../books/log-checkpoint-independent-guards")
; Frozen ID-5; counterexample below, not admitted as a universal claim.
; (defthm fn-lc-open-establishes-segment-ids-below-next
;   (let* ((out (fn-lc-open disk r mode configs frontier max-conns segs outcome fn-lbc))
;          (h (fn-lc-replayed-header disk r mode segs)))
;     (implies (and (fn-lbc-p fn-lbc) (fn-lc-segsp segs) (equal (mv-nth 0 out) :ok))
;              (and (fn-lc-header-ids-coverp h (mv-nth 3 out) nil)
;                   (<= (fn-lc-header-next-id (fn-lc-adopted-header disk r mode))
;                       (fn-lc-header-next-id h)))))
;   :rule-classes nil)

(defun lci-cold-pgs-different-root-disk ()
 (declare (xargs :guard t :verify-guards nil))
 (let* ((input (lco-id5-input 1)) (base (fn-lc-at 0 input))
        (columns (fn-lc-cold-adopted-columns base :lc :eager))
        (header (fn-lc-cold-adopted-header base :lc :eager))
        (old-header (ec-call (update-nth 2 100 header)))
        (new-header (ec-call (update-nth 2 1 header)))
        (old-disk (ec-call (fn-lc-proof-image-disk (fn-lc-pages columns old-header))))
        (disk (ec-call (pgs-commit old-disk :lc :eager
                        (ec-call (fn-lc-proof-data-pages (fn-lc-pages columns new-header) 0))
                        (ec-call (fn-lc-publication-alloc old-disk)))))
        (table (fn-lc-selected-page-table disk :lc :eager))
        (column (fn-lc-at 1 table))
        (column (ec-call (update-nth 2 (+ 1 (nfix (fn-lc-at 2 column))) column)))
        (table (ec-call (update-nth 1 column table)))
        (slots (pgs-root-slots :lc disk)) (old (pgs-slot 0 slots)) (new (pgs-slot 1 slots))
        (directory (pgs-lookup (pgs-rec-dir-addr new) (pgs-pages disk)))
        (table-address (fn-lc-head (fn-lc-head directory)))
        (directory (cons (ec-call (update-nth 2 (pgs-digest table) (fn-lc-head directory)))
                          (fn-lc-rest directory)))
        (record (pgs-make-rec (pgs-rec-txid new) (pgs-rec-dir-addr new)
                             (pgs-rec-npages new) (pgs-digest directory)))
        (pages (cons (cons table-address table)
                 (cons (cons (pgs-rec-dir-addr new) directory) (pgs-pages disk)))))
  (cons pages (list (cons :lc (cons old record))))))
(verify-guards lci-cold-pgs-different-root-disk)
(defun lci-id5-observation (disk configs segs outcome fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let ((beforep (fn-lbc-p fn-lbc)))
  (mv-let (answer fn-lbc nextdisk aftersegs trace owner)
   (fn-lc-open disk :lc :eager configs 8 4 segs outcome fn-lbc)
   (declare (ignore nextdisk trace owner))
   (let* ((h (fn-lc-replayed-header disk :lc :eager segs))
          (old (fn-lc-adopted-header disk :lc :eager))
          (old-next (fn-lc-header-next-id old)) (next (fn-lc-header-next-id h)))
    (mv (list beforep (fn-lc-segsp segs) (equal answer :ok)
          (fn-lc-header-ids-coverp h aftersegs nil)
          old-next next
          (mbe :logic (<= old-next next) :exec (not (fn-ag-less next old-next)))
          (fn-lc-at 1 (pgs-open disk :lc :eager))
          (fn-lc-at 1 (fn-lc-cold-select disk :lc :eager))
          (fn-lc-headerp old) (fn-lc-headerp (fn-lc-cold-adopted-header disk :lc :eager))
          (implies (and beforep (fn-lc-segsp segs) (equal answer :ok))
           (and (fn-lc-header-ids-coverp h aftersegs nil)
            (mbe :logic (<= old-next next) :exec (not (fn-ag-less next old-next))))))
        fn-lbc)))))
(verify-guards lci-id5-observation :hints (("Goal" :in-theory (enable fn-ag-less))))
(defun lci-id5-control ()
 (declare (xargs :guard t :verify-guards nil))
 (let ((input (lco-id5-input 1)))
  (with-local-stobj fn-lbc
   (mv-let (out fn-lbc)
    (lci-id5-observation (lci-cold-pgs-different-root-disk) (fn-lc-at 2 input)
                        (fn-lc-at 3 input) (fn-lc-at 4 input) fn-lbc) out))))
(verify-guards lci-id5-control)
(defun lci-id5-baseline-control ()
 (declare (xargs :guard t :verify-guards nil))
 (let ((input (lco-id5-input 1)))
  (with-local-stobj fn-lbc
   (mv-let (out fn-lbc)
    (lci-id5-observation (fn-lc-at 0 input) (fn-lc-at 2 input)
                        (fn-lc-at 3 input) (fn-lc-at 4 input) fn-lbc) out))))
(verify-guards lci-id5-baseline-control)
; The scalar is the ENTIRE frozen claim, not just the failing conjunct.
(defthm lci-id5-observation-is-the-frozen-formula-by-definition
 (equal (nth 11 (mv-nth 0 (lci-id5-observation disk configs segs outcome fn-lbc)))
  (let* ((out (fn-lc-open disk :lc :eager configs 8 4 segs outcome fn-lbc))
         (h (fn-lc-replayed-header disk :lc :eager segs)))
   (implies (and (fn-lbc-p fn-lbc) (fn-lc-segsp segs) (equal (mv-nth 0 out) :ok))
    (and (fn-lc-header-ids-coverp h (mv-nth 3 out) nil)
         (<= (fn-lc-header-next-id (fn-lc-adopted-header disk :lc :eager))
             (fn-lc-header-next-id h))))))
 :hints (("Goal" :in-theory (union-theories (theory 'minimal-theory)
  '(lci-id5-observation nth mv-nth fn-lc-at-is-nth car-cons cdr-cons
    (:executable-counterpart zp))))))
(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
 (assert-event (equal (lci-id5-baseline-control) '(t t t t 1 2 t 0 0 t t t)))
 (assert-event (equal (lci-id5-control) '(t t t t 100 2 nil 0 1 t t nil)))
 (assert-event
  (let* ((disk (lci-cold-pgs-different-root-disk))
         (slots (pgs-root-slots :lc disk)) (rec (pgs-slot 1 slots))
         (directory (pgs-lookup (pgs-rec-dir-addr rec) (pgs-pages disk)))
         (table (pgs-flatten (pgs-contents directory (pgs-pages disk))))
         (entry (nth 1 table)))
   (and (pgs-rec-valid (pgs-slot 0 slots)) (pgs-rec-valid rec)
        (equal (pgs-entry-verdict entry (pgs-rec-txid rec) :eager
                 (pgs-digest (pgs-lookup (car entry) (pgs-pages disk)))) :damaged))))
 (value-triple (lci-id5-baseline-control))
 (value-triple (lci-id5-control)))

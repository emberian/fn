; Unfunded registered fixture. This proves no allocator permission.
(in-package "ACL2")
(include-book "../../books/bp-checkpoint-job-bound-driver")
(include-book "bp-checkpoint-prefix-registered-tests")
(set-verify-guards-eagerness 0)
(defun bpjob-bound-run (token current fn-bp-controller-registry)
 (declare (xargs :stobjs fn-bp-controller-registry :guard t))
 (let ((old-token (list :bp-job (+ 1 (fn-bpn-nth 1 token))
                   (fn-bpn-nth 2 token) (fn-bpn-nth 3 token) (fn-bpn-nth 4 token))))
  (mv-let (refused effect left fn-bp-controller-registry)
   (fn-owner-bp-checkpoint-prefix-next-for-job '(:bp-controller 2 0) old-token 6 fn-bp-controller-registry)
   (declare (ignore left))
   (mv-let (read actual-token frozen claim payload phase revision read-left)
    (fn-bpcc-pending-capture '(:bp-controller 2 0) 4 fn-bp-controller-registry)
    (declare (ignore read-left))
    (mv-let (prepared actual-effect actual-left fn-bp-controller-registry)
     (fn-owner-bp-checkpoint-prefix-next-for-job '(:bp-controller 2 0) token 6 fn-bp-controller-registry)
     (mv (and (fn-bpcc-job-tokenp old-token) (not (equal old-token token))
              (eq refused :stale-checkpoint-job) (null effect)
              (eq read :checkpoint-current) (equal actual-token token)
              (equal frozen current) (equal claim '(8192 4096 1 1 1))
              (eq phase :running) (equal revision 1)
              (null (fn-bpck-control-action payload))
              (eq prepared :action-prepared) (equal actual-left 3)
              (equal actual-effect (list :bp-checkpoint-io-action token 2 :open 0 nil)))
         fn-bp-controller-registry))))))
(defun bpjob-bound-local ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-bp-controller-registry
  (mv-let (answer fn-bp-controller-registry)
   (mv-let (token job current fn-bp-controller-registry)
    (bppio-seed fn-bp-controller-registry)
    (declare (ignore job))
    (bpjob-bound-run token current fn-bp-controller-registry)) answer)))
(assert-event (bpjob-bound-local))

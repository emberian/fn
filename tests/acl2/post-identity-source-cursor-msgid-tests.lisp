(in-package "ACL2")
(include-book "../../books/post-identity-source-cursor-msgid")
; Reachable block Message-ID: all literal semantic and paid-trace premises.
(defthm fn-psc-msgid-reachable-positive-literal
 (let* ((text "<a@b>")
        (incoming (append (fn-inj-message-id-line (fn-record-string-octets text))
                          (fn-inj-injection-info-line '(97 98 99))))
        (begin (fn-psc-begin :agent (len incoming) text nil (len incoming)))
        (c (fn-psc-model-byte-run 9 begin incoming nil)) (pos 0) (resume :agent-msgid)
        (d (fn-psc-model-msgid-complete pos resume c incoming nil))
        (ok (not (equal (fn-inj-strip (fn-inj-message-id-line (fn-record-string-octets (fn-psc-get msgid c)))
                                    (nthcdr pos incoming)) :no))))
  (and (true-listp c) (equal (len c) 24) (natp pos) (stringp (fn-psc-get msgid c))
       (true-listp (fn-psc-model-source c incoming nil))
       (equal (fn-psc-get n c) (len (fn-psc-model-source c incoming nil)))
       (equal (fn-psc-get phase c) :control) (equal (fn-psc-get resume c) :agent-stamp)
       (not (fn-psc-get ok c))
       (equal (fn-psc-step c nil) (fn-psc-msgid-compare pos resume c))
       (equal (fn-psc-get phase d) :control) (equal (fn-psc-get resume d) resume)
       (equal (if (fn-psc-get ok d) t nil) ok)
       (equal (fn-psc-get k d) pos) (equal (fn-psc-get aux d) resume)
       (equal (fn-psc-get msgid d) (fn-psc-get msgid c))
       (equal (fn-psc-get n d) (fn-psc-get n c)) (equal (fn-psc-get mode d) (fn-psc-get mode c))
       (implies ok (equal (fn-psc-get pos d) (+ pos 14 (length (fn-psc-get msgid c)))))
       (equal d (fn-psc-model-byte-run (fn-psc-model-msgid-cost pos resume c incoming nil)
                                     (fn-psc-msgid-compare pos resume c) incoming nil)) ok))
 :rule-classes nil)

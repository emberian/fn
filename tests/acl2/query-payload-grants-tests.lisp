(in-package "ACL2")
(include-book "../../books/query-payload-grants")
(defun-nx qpgtest-live ()
  (let* ((installed (mv-list 2 (fn-qpg-install-segment 11 (create-fn-query-payload-grants))))
         (a (mv-list 3 (fn-qpg-acquire 21 0 3 7 100 '(funded query21) (nth 1 installed))))
         (b (mv-list 3 (fn-qpg-acquire 22 1 3 7 100 '(funded query22) (nth 2 a))))
         (token (nth 1 a)) (pool (nth 2 b))
         (cancelled (mv-list 2 (fn-qpg-cancel token pool)))
         (pending (mv-list 3 (fn-qpg-release token :cancelled (nth 1 cancelled))))
         (released (mv-list 3 (fn-qpg-release token :joined (nth 1 cancelled))))
         (again (mv-list 3 (fn-qpg-acquire 21 0 4 7 100 '(funded reused) (nth 2 released)))))
    (and (equal (nth 0 installed) :installed)
         (equal (nth 0 a) :acquired) (equal (nth 0 b) :acquired)
         (fn-qpg-livep token pool) (fn-qpg-livep (nth 1 b) pool)
         (equal (fn-qpg-active pool) 2)
         (equal (fn-qpg-active (nth 2 a)) 1)
         (equal (fn-qpg-active pool) (+ 1 (fn-qpg-active (nth 2 a))))
         ; Literal cancellation debt equality.
         (equal (fn-qpg-active (nth 1 cancelled)) (fn-qpg-active pool))
         (equal (nth 0 cancelled) :retained)
         (equal (mv-list 2 (fn-qpg-cancel token (nth 1 cancelled)))
                (list :retained (nth 1 cancelled)))
         (not (eq :cancelled :joined))
         (equal (nth 2 pending) (nth 1 cancelled))
         ; Full exact live/join/count antecedent and release conclusion.
         (fn-qpg-livep token (nth 1 cancelled))
         (eq :joined :joined) (not (equal (fn-qpg-active (nth 1 cancelled)) 0))
         (equal (nth 0 released) :released)
         (equal (nth 1 released) '(funded query21))
         (equal (fn-qpg-active (nth 2 released)) 1)
         (equal (fn-qpg-active (nth 2 released))
                (- (fn-qpg-active (nth 1 cancelled)) 1))
         (fn-qpg-livep (nth 1 b) (nth 2 released))
         (not (fn-qpg-livep token (nth 2 released)))
         (equal (nth 0 again) :refused) (equal (nth 2 again) (nth 2 released)))))
(defthm qpgtest-live-witness (qpgtest-live) :rule-classes nil)
(defun-nx qpgtest-stale ()
  (let* ((installed (mv-list 2 (fn-qpg-install-segment 11 (create-fn-query-payload-grants))))
         (a (mv-list 3 (fn-qpg-acquire 21 0 3 7 100 '(funded query21) (nth 1 installed))))
         (wrong '(:query-payload 21 0 3 7 100 12))
         (pool (nth 2 a))
         (answer (mv-list 3 (fn-qpg-release wrong :joined pool))))
    (and (eq :joined :joined) (not (equal (fn-qpg-active pool) 0))
         (not (fn-qpg-livep wrong pool))
         (not (equal (nth 0 answer) :released))
         (equal (nth 2 answer) pool))))
; Hypothesis removal: exact live token fails; joined/nonzero debt retained.
(defthm qpgtest-stale-witness (qpgtest-stale) :rule-classes nil)

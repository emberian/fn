(in-package "ACL2")
(include-book "../../books/history-page-buffer")

(defun hpbt-prefix-tooth ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-hpb
  (mv-let (out fn-hpb)
   (let ((fn-hpb (fn-hpb-begin '(capture 7) '(lease 9) fn-hpb)))
    (mv-let (v1 fn-hpb) (fn-hpb-put 23 fn-hpb)
     (let ((prior (fn-hpb-prefix fn-hpb))
           (antecedent (and (natp (fn-hpb-used fn-hpb))
                            (< (fn-hpb-used fn-hpb) 2048)))
           (well (fn-hpbp fn-hpb)))
      (mv-let (v2 fn-hpb) (fn-hpb-put 42 fn-hpb)
       (mv (and (equal v1 :stored) antecedent well (unsigned-byte-p 64 42)
                (equal v2 :stored)
                (equal (fn-hpb-prefix fn-hpb) (append prior '(42)))
                (not (equal (fn-hpb-prefix fn-hpb) (append prior '(43))))
                (fn-hpbp fn-hpb)
                (equal (fn-hpb-prefix fn-hpb) '(23 42))
                (equal (fn-hpb-epoch fn-hpb) '(capture 7))
                (equal (fn-hpb-lease fn-hpb) '(lease 9))
                (equal (mv-list 2 (fn-hpb-word 1 fn-hpb)) '(:word 42)))
           fn-hpb)))))
   out)))
(assert-event (hpbt-prefix-tooth))

(defun hpbt-reset-tooth ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-hpb
  (mv-let (out fn-hpb)
   (mv-let (v fn-hpb) (fn-hpb-put 99 fn-hpb)
    (let* ((oldword (fn-hpb-wi 0 fn-hpb))
          (fn-hpb (fn-hpb-begin '(capture 8) '(lease 10) fn-hpb)))
     (mv (and (equal v :stored) (equal oldword 99)
              (equal (fn-hpb-wi 0 fn-hpb) 99)
              (<= (fn-hpb-used fn-hpb) 0)
              (equal (mv-list 2 (fn-hpb-word 0 fn-hpb)) '(:unwritten 0))
              (equal (fn-hpb-prefix fn-hpb) nil)
              (equal (fn-hpb-epoch fn-hpb) '(capture 8))
              (equal (fn-hpb-lease fn-hpb) '(lease 10))) fn-hpb)))
   out)))
(assert-event (hpbt-reset-tooth))

(defun hpbt-fill (k fn-hpb)
 (declare (xargs :stobjs fn-hpb :verify-guards nil))
 (if (zp k) fn-hpb
  (mv-let (v fn-hpb) (fn-hpb-put 7 fn-hpb)
   (declare (ignore v))
   (hpbt-fill (1- k) fn-hpb))))

(defun hpbt-full-tooth ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-hpb
  (mv-let (out fn-hpb)
   (let* ((fn-hpb (fn-hpb-begin '(capture 1) '(lease 2) fn-hpb))
          (fn-hpb (hpbt-fill 2048 fn-hpb))
          (ready (fn-hpb-ready fn-hpb))
          (prior (fn-hpb-prefix fn-hpb)))
    (mv-let (v fn-hpb) (fn-hpb-put 88 fn-hpb)
     (mv (and ready (equal v :full) (equal (fn-hpb-used fn-hpb) 2048)
              (equal (fn-hpb-prefix fn-hpb) prior)
              (equal (fn-hpb-epoch fn-hpb) '(capture 1))
              (equal (fn-hpb-lease fn-hpb) '(lease 2))
              (fn-hpbp fn-hpb)
              ; Removing the prefix theorem's capacity premise fails it.
              (natp (fn-hpb-used fn-hpb))
              (not (< (fn-hpb-used fn-hpb) 2048))
              (not (equal (fn-hpb-prefix fn-hpb) (append prior '(88)))))
         fn-hpb)))
   out)))
(assert-event (hpbt-full-tooth))

; Corrupted-state witness in logic: a raw stobj cannot physically hold -1
; in its bounded counter field. This theorem evaluates the invalid logical
; representation and asserts every retained hypothesis and failed result.
(defthm hpbt-negative-counter-witness
 (let ((c '((0) -1 nil nil)))
  (and (not (natp (fn-hpb-used c))) (< (fn-hpb-used c) 2048)
       (not (equal (fn-hpb-prefix (mv-nth 1 (fn-hpb-put 5 c)))
                   (append (fn-hpb-prefix c) '(5))))))
 :hints (("Goal" :in-theory (enable fn-hpb-put fn-hpb-prefix)))
 :rule-classes nil)

(in-package "ACL2")
(include-book "../../books/response-identity")
(assert-event (equal (mv-list 3 (fn-rid-connection 17 0))
                     '(:reserved (:connection 17 1) 1)))
(assert-event (equal (mv-list 3 (fn-rid-connection 17 1))
                     '(:reserved (:connection 17 2) 2)))
(assert-event (equal (mv-list 3 (fn-rid-response '(:connection 17 2) 0))
                     '(:reserved (:response 17 2 1) 1)))
(assert-event (equal (mv-list 3 (fn-rid-response '(:connection 17 2) 1))
                     '(:reserved (:response 17 2 2) 2)))
(assert-event (equal (mv-list 2 (fn-rid-reserve 18446744073709551614))
                     '(:reserved 18446744073709551615)))
(assert-event (equal (mv-list 3 (fn-rid-connection 17 18446744073709551615))
                     '(:exhausted nil 18446744073709551615)))
(assert-event (equal (mv-list 3 (fn-rid-response '(:connection 17 2) 18446744073709551615))
                     '(:exhausted nil 18446744073709551615)))
(assert-event (equal (mv-list 3 (fn-rid-connection 18446744073709551616 0))
                     '(:invalid-connection nil 0)))
(assert-event (equal (mv-list 3 (fn-rid-response '(:connection 17 0) 0))
                     '(:invalid-connection nil 0)))
; Complete literal witnesses of the named statements. Mutation inputs above
; are invalid/refusal cases, not claimed hypothesis-removal counterexamples.
(assert-event
 (mv-let (word next) (fn-rid-reserve 41)
   (and (equal word :reserved) (fn-rid-wordp next) (< 41 next))))
(assert-event
 (mv-let (word identity next) (fn-rid-connection 17 41)
   (declare (ignore next))
   (and (equal word :reserved) (equal (cadr identity) 17)
        (fn-rid-wordp (caddr identity)))))
(assert-event
 (mv-let (word identity next) (fn-rid-response '(:connection 17 2) 41)
   (declare (ignore next))
   (and (equal word :reserved) (equal (cadr identity) 17)
        (equal (caddr identity) 2) (fn-rid-wordp (cadddr identity)))))

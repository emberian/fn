; Component controls over the actual LC MOVE/complete-cleaning models.
; These fixtures do not assert the separate checkpoint/current-column base.
(in-package "ACL2")
(include-book "lc-bounded-check-tests")
(include-book "lc-cleaning-fixture-snapshot")
(include-book "../../books/log-cleaning-move")
(include-book "../../books/log-cleaning-complete")
(include-book "../../books/log-checkpoint-publication-witnesses")

(defun lcm-test-rows (count)
 (declare (xargs :guard t))
 (if (equal count 2)
     (list (ec-call (lct-held 0)) (ec-call (lct-held 1)))
   (list (ec-call (lct-held 0)))))
(defun lcm-test-input (count)
 (declare (xargs :guard t))
 (let* ((old (ec-call (fn-lb-log-model-append (ec-call (lct-held 0)) *lct-payload* 1 nil)))
        (old (if (equal count 2)
               (ec-call (fn-lb-log-model-append (ec-call (lct-held 1)) *lct-payload* 1 old)) old))
        (segs (fn-lc-join old (list (list 2 nil nil))))
        (value (lcm-fixture-snapshot (lcm-test-rows count) segs))
        (control (ec-call (fn-lc-control-of
                           (list (list *fn-cfg-default-record*) (lcm-test-rows count)))))
        (header (fn-lc-snapshot-header-value value
                  (list :lc-header (list 1 (len (fn-lc-at 1 (fn-lc-head old)))
                                  (if (equal count 2) 2 1) 8 *fn-lg-genesis*)
                        3 nil nil nil) control))
        (disk (ec-call (fn-lc-proof-image-disk
                   (fn-lc-pages (ec-call (fn-lc-columns-value value)) header)))))
  (list disk segs header)))

(defun lcm-test-move (count i k outcome fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((input (lcm-test-input count)) (disk (fn-lc-at 0 input))
        (segs (fn-lc-at 1 input)) (header (fn-lc-at 2 input))
        (fn-lbc (ec-call (fn-lbc-open-rebuild (lcm-test-rows count) segs fn-lbc)))
        (move (fn-lc-plan-move i header k :lc :eager segs fn-lbc))
        (valid (fn-lc-move-recordp move fn-lbc segs))
        (before (ec-call (fn-lc-locators-resolve fn-lbc segs)))
        (a (ec-call (fn-lbc-loc0 i fn-lbc))) (b (ec-call (fn-lbc-loc1 i fn-lbc)))
        (wire (ec-call (fn-lc-read-range a b segs)))
        (home (fn-lc-read-suf a b segs)))
  (mv-let (answer fn-lbc afterdisk aftersegs trace)
   (fn-lc-clean move disk segs outcome fn-lbc)
   (mv (list valid before answer (fn-lbc-count fn-lbc)
        (ec-call (fn-lbc-loc0 i fn-lbc)) (ec-call (fn-lbc-loc1 i fn-lbc))
        (equal wire (ec-call (fn-lc-read-range (ec-call (fn-lbc-loc0 i fn-lbc))
                                  (ec-call (fn-lbc-loc1 i fn-lbc)) aftersegs)))
        (equal home (fn-lc-read-suf (ec-call (fn-lbc-loc0 i fn-lbc))
                                  (ec-call (fn-lbc-loc1 i fn-lbc)) aftersegs))
        (ec-call (fn-lc-locators-resolve fn-lbc aftersegs))
        (equal disk afterdisk) (len trace)
        (fn-lc-head (fn-lc-at 4 move)) ; physical ordinal, not original sequence
        (ec-call (fn-lbc-directory-value i :sequence fn-lbc)))
       fn-lbc))))
(defun lcm-test-move-fixture (count i k outcome)
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-lbc
  (mv-let (out fn-lbc) (lcm-test-move count i k outcome fn-lbc) out)))

(defun lcm-test-complete (count quantum k outcome fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((input (lcm-test-input count)) (disk (fn-lc-at 0 input))
        (segs (fn-lc-at 1 input)) (header (fn-lc-at 2 input))
        (fn-lbc (ec-call (fn-lbc-open-rebuild (lcm-test-rows count) segs fn-lbc)))
        (before (ec-call (fn-lc-locators-resolve fn-lbc segs))))
  (mv-let (answer fn-lbc afterdisk aftersegs ledger)
   (fn-lc-clean-segment 1 (list quantum) (list :lc :eager header k)
                          disk segs outcome fn-lbc)
   (mv (list before answer (fn-lbc-count fn-lbc)
         (fn-lc-segment-moves-completep (list answer nil nil nil ledger) 1)
         (not (fn-lc-any-row-names-segment 1 fn-lbc))
         (ec-call (fn-lc-locators-resolve fn-lbc aftersegs))
         (equal disk afterdisk)
         (len (fn-lc-at 1 ledger)) (fn-lc-at 2 ledger))
       fn-lbc))))
(defun lcm-test-complete-fixture (count quantum k outcome)
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-lbc
  (mv-let (out fn-lbc) (lcm-test-complete count quantum k outcome fn-lbc) out)))

(verify-guards lcm-test-move)
(verify-guards lcm-test-move-fixture)
(verify-guards lcm-test-complete)
(verify-guards lcm-test-complete-fixture)

(assert-event
 (equal (lcm-test-move-fixture 1 0 1 '(:ok :ok))
        '(t t :ok 1 2 231928234004 t t t t 2 0 0)))
; Row 1 goes to physical ordinal 0, retaining original sequence 1.
(assert-event
 (equal (lcm-test-move-fixture 2 1 1 '(:ok :ok))
        '(t t :ok 2 2 231928234004 t t t t 2 0 1)))
(assert-event
 (equal (lcm-test-move-fixture 1 0 0 '(:ok :ok))
        '(t t :publication-behind 1 1 25769803796 t t t t 0 0 0)))
(assert-event
 (equal (lcm-test-move-fixture 1 0 1 '(:ok :uncertain))
        '(t t :uncertain 1 1 25769803796 t t t t 2 0 0)))
(assert-event
 (equal (lcm-test-complete-fixture 1 1 1 '(:ok :ok))
        '(t :ok 1 t t t t 1 nil)))
(assert-event
 (equal (lcm-test-complete-fixture 1 0 1 '(:ok :ok))
        '(t :yield 1 nil nil t t 0 (0))))
(assert-event
 (equal (lcm-test-complete-fixture 1 1 1 '(:ok :uncertain))
        '(t :uncertain 1 nil nil t t 0 (0))))
(assert-event
 (equal (lcm-test-complete-fixture 2 1 2 '(:ok :ok :ok :ok))
        '(t :yield 2 nil nil t t 1 (1))))
(assert-event
 (equal (lcm-test-complete-fixture 2 2 2 '(:ok :ok :ok :ok))
        '(t :ok 2 t t t t 2 nil)))
(assert-event
 (equal (lcm-test-complete-fixture 2 2 1 '(:ok :ok :ok :ok))
        '(t :publication-behind 2 nil nil t t 1 (1))))

; Input-validator mutation: byte EOF alone is not parser-directory freshness.
(encapsulate ()
 (local (defun lcm-byte-end-only-move-recordp (move fn-lbc segs)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((i (fn-lc-move-sequence move))
        (header (fn-lc-at 5 move)) (frame (fn-lc-at 3 move))
        (entry (fn-lc-at 4 move)))
  (and (true-listp move) (equal (len move) 9)
       (equal (fn-lc-head move) :lc-move)
       (natp i) (< i (fn-lbc-count fn-lbc))
       (fn-lc-segsp segs) (natp (fn-lc-at 6 move))
       (fn-locp (fn-lc-move-loc0 move) (fn-lc-move-loc1 move))
       (fn-lc-segs-retain segs header)
       (equal (fn-lc-head (fn-lc-tail-scan segs header)) :ok)
       ; Complete original record and source range, not an assumed post-state.
       (let* ((row (ec-call (fn-lc-bound-row i fn-lbc segs)))
              (a (fn-lbc-loc0 i fn-lbc)) (b (fn-lbc-loc1 i fn-lbc))
              (payload (ec-call (fn-lb-log-payload row segs))))
        (and (fn-held-p row) (equal (fn-record-sequence row) i)
             (not (fn-rcl-tombstonep payload))
             (not (equal (ec-call (fn-lc-read-range a b segs)) :bad))
             (not (equal (fn-lc-read-suf a b segs) :bad))
             ; The frame's width-limited PRE must decode to this very row
             ; and range; sealing alone does not establish that binding.
             (equal (fn-lc-move-event frame (fn-lc-tail-max header))
                    (list :move i (ec-call (fn-lc-read-range a b segs))
                          (fn-lc-read-suf a b segs)))
             (equal move (fn-lc-plan-move i header (fn-lc-at 6 move)
                             (fn-lc-at 7 move) (fn-lc-at 8 move) segs fn-lbc))))
       (fn-lb-log-model-entryp entry)
       t
       (fn-lc-move-framep frame (fn-lc-at 3 (fn-lc-tail-scan segs header))
                                (fn-lc-tail-max header))
       ; Width is a locator/segment profile boundary, never a record-count cap.
       (< (+ (nfix (fn-lc-at 1 entry)) (len frame)) 4294967296)))))
 (local (verify-guards lcm-byte-end-only-move-recordp))
 (local (defun lcm-test-shadow (fn-lbc)
  (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
  (let* ((input (lcm-test-input 1)) (disk (fn-lc-at 0 input))
         (header (fn-lc-at 2 input))
         ; Typed metadata outside EOF; not a valid physical layout.
         (future (list 0 0 75 54 20 999 *lct-payload* '(nil nil nil nil nil) 999))
         (segs (list (fn-lc-head (fn-lc-at 1 input)) (list 2 nil (list future))))
         (fn-lbc (ec-call (fn-lbc-open-rebuild (lcm-test-rows 1) segs fn-lbc)))
         (move (fn-lc-plan-move 0 header 1 :lc :eager segs fn-lbc))
         (shape (fn-lc-segsp segs))
         (layout (ec-call (fn-lb-log-layoutp segs)))
         (before (ec-call (fn-lc-locators-resolve fn-lbc segs)))
         (mutant (lcm-byte-end-only-move-recordp move fn-lbc segs))
         (fresh (fn-lc-move-target-freshp move segs))
         (valid (fn-lc-move-recordp move fn-lbc segs)))
   (mv-let (answer fn-lbc afterdisk aftersegs trace)
    (fn-lc-clean move disk segs '(:ok :ok) fn-lbc)
    (mv (list shape layout before mutant fresh valid answer
              (fn-lbc-count fn-lbc) (fn-lbc-word :loc0 0 fn-lbc)
              (ec-call (fn-lc-locators-resolve fn-lbc aftersegs))
              (equal disk afterdisk) (equal segs aftersegs) (len trace))
        fn-lbc)))))
 (local (verify-guards lcm-test-shadow))
 (local (defun lcm-test-shadow-fixture ()
  (declare (xargs :guard t :verify-guards nil))
  (with-local-stobj fn-lbc
   (mv-let (out fn-lbc) (lcm-test-shadow fn-lbc) out))))
 (local (verify-guards lcm-test-shadow-fixture))
 (assert-event
  (equal (lcm-test-shadow-fixture)
         '(t nil t t nil nil :invalid-move 1 1 t t t 0))))

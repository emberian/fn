(defthm fn-sic-empty-literal
 (let* ((xs nil) (fuel 5) (outer 65538) (item 65535)
        (c (fn-sic-begin fuel xs outer item)) (d (fn-sic-run 1000 c))
        (old (fn-stmt-decode-items-bounded-impl fuel xs outer item)))
  (and (natp fuel) (natp outer) (natp item) (equal old '(:ok nil))
       (equal (fn-sic-at 0 d) :done) (not (equal (fn-sic-result d) :pending))
       (equal (fn-sic-result-abstract d) old)
       (equal d (fn-sic-run 983 (fn-sic-run 17 c)))
       (equal (fn-sic-run 0 c) c)))
 :rule-classes nil)


       (equal (fn-sic-at 0 d) :preflight) (equal (fn-sic-at 2 d) '(97))
       (equal (fn-sic-result-abstract (fn-sic-run 19 d)) '(:ok ((:bytes 97))))))
 :rule-classes nil)

(defthm fn-sic-borrowed-five-items-and-lengths-literal
 (let* ((xs '(65 97 1 66 98 99 3 65 100)) (c (fn-sic-begin-legacy 5 xs)) (d (fn-sic-run 100 c)) (items (fn-stmt-value (fn-sic-result d))))
  (and (equal (fn-sic-result c) :pending)
       (equal items '((:bytes 1 1 (97 1 66 98 99 3 65 100)) (:uint . 1)
                     (:bytes 4 2 (98 99 3 65 100)) (:uint . 3) (:bytes 8 1 (100))))
       (equal (fn-sic-at 2 (nth 0 items)) 1) (equal (fn-sic-at 2 (nth 2 items)) 2)
       (equal (fn-sic-at 2 (nth 4 items)) 1)
       (equal (fn-sic-result-abstract d) (fn-stmt-decode-items-impl 5 xs))))
 :rule-classes nil)

(defthm fn-sic-quantum-yields-pending-literal

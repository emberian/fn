; Corrupted-state witness, not an admitted-input counterexample: removing
; the required preflight phase permits a host-invented pending state.
(defthm fn-sic-preflight-phase-removal-corrupted-state
 (let* ((c (fn-sic-put 0 :head (fn-sic-begin 5 '(256) 1 65535)))
        (d (fn-sic-preflight-complete c)))
  (and (natp (fn-sic-at 4 c))
   (not (equal (fn-sic-at 0 c) :preflight))
   (not (fn-sic-at 7 c)) (not (fn-cbor-octet-listp (fn-sic-at 2 c)))
   (not (equal (fn-sic-result d) (fn-stmt-error :malformed)))))
 :rule-classes nil)

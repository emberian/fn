(in-package "ACL2")
(include-book "../../host/receiver-capacity-current-host")
; Unfunded local storage fixture. Supplied model demand and local default
; constructors do not establish supported runtime or installation authority.
(defun fn-rxch-observe (token fn-rx-provider fn-receiver-turn fn-rx-capacity-current fn-page-read-pool)
  (declare (xargs :stobjs (fn-rx-provider fn-receiver-turn fn-rx-capacity-current fn-page-read-pool)))
  (mv-let (word fn-rx-provider fn-receiver-turn fn-rx-capacity-current fn-page-read-pool)
    (fn-owner-rx-current-install token fn-rx-provider fn-receiver-turn fn-rx-capacity-current fn-page-read-pool)
    (mv (list word (fn-rxcc-phase fn-rx-capacity-current)
              (fn-rxcc-claim fn-rx-capacity-current)
              (fn-rxp-token fn-rx-provider) (fn-rxp-instance fn-rx-provider)
              (fn-rxp-capacity fn-rx-provider) (fn-rxt-receipt fn-receiver-turn)
              (fn-owner-page-read-ledger fn-page-read-pool))
        fn-rx-provider fn-receiver-turn fn-rx-capacity-current fn-page-read-pool)))
(defun fn-rxch-factory (token fn-rx-capacity-current fn-page-read-pool)
  (declare (xargs :stobjs (fn-rx-capacity-current fn-page-read-pool) :verify-guards nil))
  (with-local-stobj fn-rx-provider
    (mv-let (answer fn-rx-provider fn-rx-capacity-current fn-page-read-pool)
      (with-local-stobj fn-receiver-turn
        (mv-let (answer fn-rx-provider fn-receiver-turn fn-rx-capacity-current fn-page-read-pool)
          (fn-rxch-observe token fn-rx-provider fn-receiver-turn fn-rx-capacity-current fn-page-read-pool)
          (mv answer fn-rx-provider fn-rx-capacity-current fn-page-read-pool)))
      (mv answer fn-rx-capacity-current fn-page-read-pool))))
(defun fn-rxch-run (fn-rx-capacity-current fn-page-read-pool)
  (declare (xargs :stobjs (fn-rx-capacity-current fn-page-read-pool) :verify-guards nil))
  (let* ((fn-page-read-pool (fn-owner-page-read-keep-ledger
           (fn-prl-build '(1000000 0 0 0 100) '(0 0 0 0 0) 7
                         '((:borrowed . :bindings)) '(1000 0 0 0 0)) fn-page-read-pool))
         (fn-page-read-pool (update-fn-prp-mode :served fn-page-read-pool)))
    (mv-let (word token fn-rx-capacity-current fn-page-read-pool)
      (fn-owner-rx-current-reserve '(8192 0 0 0 1) fn-rx-capacity-current fn-page-read-pool)
      (mv-let (begin fn-rx-capacity-current fn-page-read-pool)
        (fn-owner-rx-current-allocation-begin token fn-rx-capacity-current fn-page-read-pool)
        (mv-let (first fn-rx-capacity-current fn-page-read-pool)
          (fn-rxch-factory token fn-rx-capacity-current fn-page-read-pool)
          (mv-let (second fn-rx-capacity-current fn-page-read-pool)
            (fn-rxch-factory token fn-rx-capacity-current fn-page-read-pool)
            (mv (list word token begin first second)
                fn-rx-capacity-current fn-page-read-pool)))))))
(defun fn-rxch-local ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn-page-read-pool
    (mv-let (answer fn-page-read-pool)
      (with-local-stobj fn-rx-capacity-current
        (mv-let (answer fn-rx-capacity-current fn-page-read-pool)
          (fn-rxch-run fn-rx-capacity-current fn-page-read-pool)
          (mv answer fn-page-read-pool)))
      answer)))
(assert-event
 (let* ((answer (fn-rxch-local)) (first (fn-prl-nth 3 answer))
        (second (fn-prl-nth 4 answer)) (ledger (fn-prl-nth 7 first)))
   (and (eq (fn-prl-nth 0 answer) :admitted)
        (equal (fn-prl-nth 1 answer) '(:rx-capacity 7 7 4096))
        (eq (fn-prl-nth 2 answer) :allocate)
        (eq (fn-prl-nth 0 first) :installed)
        (eq (fn-prl-nth 1 first) :installed)
        (equal (fn-prl-nth 2 first) '(0 0 0 0 1))
        (equal (fn-prl-nth 3 first) '(:rx-capacity 7 7 4096))
        (equal (fn-prl-nth 4 first) 7)
        (equal (fn-prl-nth 5 first) 4096)
        (equal (fn-prl-nth 6 first) '(:receiver-install (:rx-capacity 7 7 4096) 7))
        (equal (fn-prl-nth 1 ledger) '(0 0 0 0 1))
        (equal (fn-prl-nth 2 ledger) 8)
        (equal (fn-prl-nth 3 ledger) '((:borrowed . :bindings)))
        (equal (fn-prl-baseline ledger) '(9192 0 0 0 0))
        (eq (fn-prl-nth 0 second) :stale-capacity)
        (eq (fn-prl-nth 1 second) :installed)
        (equal (fn-prl-nth 2 second) '(0 0 0 0 1))
        (null (fn-prl-nth 3 second)) (null (fn-prl-nth 4 second))
        (null (fn-prl-nth 5 second)) (null (fn-prl-nth 6 second))
        (equal (fn-prl-nth 7 second) ledger))))

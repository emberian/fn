; Probe the unchanged LC3 allowance after a later metadata rejection.
; A real PGS commit gives each of the four pages fresh physical storage;
; only the newer checkpoint's control page is damaged afterward.
(in-package "ACL2")
(include-book "lc-open-read-counterexample-tests")
(defun lcc-late-fallback-disk ()
 (declare (xargs :guard t :verify-guards nil))
 (let* ((input (lco-id5-input 1)) (disk (fn-lc-at 0 input))
        (image (fn-lc-at 3 (pgs-open disk :lc :eager)))
        (dirty (ec-call (fn-lc-proof-data-pages image 0)))
        (new-disk (ec-call (pgs-commit disk :lc :eager dirty
                             (ec-call (fn-lc-publication-alloc disk)))))
        (table (fn-lc-selected-page-table new-disk :lc :eager))
        (control-address (fn-lc-head (fn-lc-at 3 table))))
  (cons (cons (cons control-address '(:damaged)) (pgs-pages new-disk))
        (pgs-roots new-disk))))
(defun lcc-late-fallback-result ()
 (declare (xargs :guard t :verify-guards nil))
 (let* ((disk (lcc-late-fallback-disk))
        (selected (fn-lc-cold-select disk :lc :eager)))
  (with-local-stobj fn-lbc
   (mv-let (result fn-lbc)
     (lco-open-read-observation disk (lco-id5-input 1) fn-lbc)
     (list result (fn-lc-at 1 selected) (fn-lc-at 8 result)
           (fn-lc-directory-path-pages disk :lc :eager)
           (and (pgs-rec-valid (pgs-slot 0 (pgs-root-slots :lc disk)))
                (pgs-rec-valid (pgs-slot 1 (pgs-root-slots :lc disk)))))))))
(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
 (assert-event
  (let* ((out (lcc-late-fallback-result)) (observation (fn-lc-head out)))
   (and (fn-lc-at 0 observation) (fn-lc-at 1 observation)
        (equal (fn-lc-at 2 observation) :ok)
        (equal (fn-lc-at 3 observation) 164100)
        (equal (fn-lc-at 4 observation) 114948)
        (< (fn-lc-at 4 observation) (fn-lc-at 3 observation))
        (not (fn-lc-at 7 observation))
        (equal (fn-lc-at 1 out) 0) (fn-lc-at 4 out)
        (equal (fn-lc-at 2 out)
          '((:pread :root 0 130) (:pread :root 1 130)
            (:pread :page 7 16384) (:pread :page 12 16384)
            (:pread :page 8 16384) (:pread :page 10 16384)
            (:pread :page 11 16384) (:pread :page 6 16384)
            (:pread :page 5 16384) (:pread :page 1 16384)
            (:pread :page 3 16384) (:pread :page 4 16384)))
        (equal (fn-lc-at 3 out) '(7 12 6 5 1 3 4))
        (fn-lc-cold-only-metadata-requests-p (fn-lc-at 2 out)
          (fn-lc-cold-directory-path (lcc-late-fallback-disk) :lc :eager)))))
 (value-triple (lcc-late-fallback-result)))
(verify-guards lcc-late-fallback-disk)
(verify-guards lcc-late-fallback-result)

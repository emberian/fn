; SAT and eager-selector control are authored before any selector theorem.
(in-package "ACL2")
(include-book "../../books/log-checkpoint-cold-candidate")
(include-book "lc-open-id-search-tests")
(include-book "../../books/log-checkpoint-column-read")
(defun lcc-one-candidate-control ()
 (declare (xargs :guard t :verify-guards nil))
 (let* ((input (lco-id5-input 1)) (disk (fn-lc-at 0 input))
        (rec (pgs-slot 0 (pgs-root-slots :lc disk)))
        (out (fn-lc-cold-candidate rec (pgs-pages disk)))
        (bad-pages (cons (cons 2 '(:damaged)) (pgs-pages disk)))
        (damaged (fn-lc-cold-candidate rec bad-pages))
        (read (fn-lc-column-first-read (pgs-rec-txid rec) :map-escape
                     (fn-lc-at 1 (fn-lc-at 1 out)) bad-pages nil))
        (other (fn-lc-column-first-read (pgs-rec-txid rec) :header
                     (fn-lc-at 0 (fn-lc-at 1 out)) bad-pages nil)))
   (and (equal (fn-lc-head (fn-lc-head out)) :ok)
        (equal (fn-lc-at 3 out) '(6 5 1 3 4))
        (equal damaged out)
        (not (equal (append (fn-lc-at 3 out) '(2)) (fn-lc-at 3 out)))
        (equal (fn-lc-head read) :uncertain)
        (equal (fn-lc-read-octets (fn-lc-at 3 read)) (fn-lc-page-octets))
        (equal (fn-lc-head (fn-lc-at 5 read)) :lc-column-page-damaged)
        (equal (fn-lc-head other) :ok))))
(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
 (assert-event (lcc-one-candidate-control)))
(verify-guards lcc-one-candidate-control)

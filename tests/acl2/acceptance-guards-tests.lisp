(assert-event (not (fn-memberships-below-nextsp '(("x" . #c(0 1))) nil)))
(assert-event (fn-pendingp '("fn.test") '(("fn.test" . 1)) #c(0 1)
                           '(0 0 "m" nil ("fn.test") (("fn.test" . 1)) t)))

(defconst *ag-bad-pending* '(("fn.test") (("fn.test" . 1)) nil 0 7 nil))
(defconst *ag-bad-article-tail*
 '(("fn.test") (("fn.test" . 2))
   (("m" nil ("fn.test") (("fn.test" . 1)) t) 7) 0 nil nil))
(assert-event (not (fn-statep *ag-bad-pending*)))
(assert-event (not (fn-statep *ag-bad-article-tail*)))
(assert-event (not (fn-statep 7)))
(assert-event (equal (fn-accept-prepare *ag-bad-pending* 0 "m" nil '("fn.test"))
                     *ag-bad-pending*))
(assert-event (equal (fn-accept-complete *ag-bad-pending* 0 0 :durable)
                     *ag-bad-pending*))
(assert-event (equal (fn-accept-recover *ag-bad-pending* 0 0 :committed)
                     *ag-bad-pending*))
(assert-event (equal (fn-accept-prepare *ag-bad-article-tail* 0 "m" nil '("fn.test"))
                     *ag-bad-article-tail*))
(assert-event (equal (fn-accept-complete 7 0 0 :durable) 7))
(assert-event (equal (fn-accept-recover '(a . b) 0 0 :committed) '(a . b)))

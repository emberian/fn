; Malformed logical inputs.  The wrappers now carry the composed recognizer
; as their guard, so these regressions run under with-guard-checking :none:
; the :logic bodies are total and return the input unchanged.
(assert-event (with-guard-checking :none (equal (fn-sn-groups 7) nil)))
(assert-event (with-guard-checking :none (equal (fn-sn-capacity '(a . 7)) nil)))
(assert-event (with-guard-checking :none (equal (fn-sn-files '(a b . 7)) nil)))
(assert-event (with-guard-checking :none (equal (fn-sn-node #c(1 2)) nil)))
(assert-event (with-guard-checking :none (not (fn-sn-statep '(a b c . 7)))))
(assert-event (with-guard-checking :none (not (fn-sn-record-bindsp 7 7))))
(assert-event (with-guard-checking :none (equal (fn-sn-prepare 7 '(bad . record)) 7)))
(assert-event (with-guard-checking :none (equal (fn-sn-find-record '(nil . nil) '(7 other)) 7)))

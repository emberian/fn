; Permanent pool-span positive regression. The compact repeat term is proved,
; never allocated or run. This must fail before C25 routing and pass after it.
(in-package "ACL2")
(include-book "lc-record-effect-tests")
(local (defun lcs-disable-column-execution (runes)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp runes)
  (let* ((r (car runes)) (sym (cadr r))
         (name (if (symbolp sym) (symbol-name sym) "")))
   (if (and (equal (car r) :executable-counterpart)
            (or (equal (subseq name 0 (min 7 (length name))) "FN-LBC-")
                (equal (subseq name 0 (min 8 (length name))) "FN-DMAP-")
                (equal (subseq name 0 (min 6 (length name))) "FN-LC-")
                (equal sym 'create-fn-lbc)))
       (cons r (lcs-disable-column-execution (cdr runes)))
     (lcs-disable-column-execution (cdr runes)))) nil)))
(local (defun lcs-enable-column-definitions (runes)
 (declare (xargs :guard t :verify-guards nil))
 (if (consp runes)
  (let* ((r (car runes)) (sym (cadr r))
         (name (if (symbolp sym) (symbol-name sym) "")))
   (if (and (equal (car r) :definition)
            (or (equal (subseq name 0 (min 7 (length name))) "FN-LBC-")
                (equal (subseq name 0 (min 8 (length name))) "FN-DMAP-")
                (equal (subseq name 0 (min 6 (length name))) "FN-LC-")
                (equal sym 'create-fn-lbc)))
       (cons r (lcs-enable-column-definitions (cdr runes)))
     (lcs-enable-column-definitions (cdr runes)))) nil)))
(local (defthm lcs-repeat-true-list
 (implies (and (natp n) (true-listp acc))
          (true-listp (make-list-ac n item acc)))
 :hints (("Goal" :induct (make-list-ac n item acc)
   :in-theory (union-theories (theory 'minimal-theory)
     '((:COMPOUND-RECOGNIZER NATP-COMPOUND-RECOGNIZER)
       (:COMPOUND-RECOGNIZER ZP-COMPOUND-RECOGNIZER)
       (:DEFINITION MAKE-LIST-AC)
       (:DEFINITION NATP)
       (:DEFINITION NOT)
       (:EXECUTABLE-COUNTERPART <)
       (:EXECUTABLE-COUNTERPART INTEGERP)
       (:EXECUTABLE-COUNTERPART NOT)
       (:EXECUTABLE-COUNTERPART ZP)
       (:INDUCTION MAKE-LIST-AC)
       (:TYPE-PRESCRIPTION MAKE-LIST-AC)
       (:TYPE-PRESCRIPTION TRUE-LISTP)))))))
(local (defthm lcs-repeat-length
 (implies (natp n)

(local (defthm lcs-repeat-consp
 (implies (and (natp n) (or (posp n) (consp acc)))
          (consp (make-list-ac n item acc)))
 :hints (("Goal" :induct (make-list-ac n item acc)
   :in-theory (union-theories (theory 'minimal-theory)
     '((:COMPOUND-RECOGNIZER NATP-COMPOUND-RECOGNIZER)
       (:COMPOUND-RECOGNIZER POSP-COMPOUND-RECOGNIZER)
       (:COMPOUND-RECOGNIZER ZP-COMPOUND-RECOGNIZER)
       (:DEFINITION MAKE-LIST-AC)
       (:DEFINITION NATP)
       (:DEFINITION NOT)
       (:DEFINITION POSP)
       (:INDUCTION MAKE-LIST-AC)
       (:TYPE-PRESCRIPTION MAKE-LIST-AC)))))))
(local (defthm lcs-repeat-car
 (implies (and (natp n)
              (or (posp n) (and (consp acc) (equal (car acc) item))))
          (equal (car (make-list-ac n item acc)) item))
 :hints (("Goal" :induct (make-list-ac n item acc)
   :in-theory (union-theories (theory 'minimal-theory)
     '((:COMPOUND-RECOGNIZER NATP-COMPOUND-RECOGNIZER)
       (:COMPOUND-RECOGNIZER POSP-COMPOUND-RECOGNIZER)
       (:COMPOUND-RECOGNIZER ZP-COMPOUND-RECOGNIZER)
       (:DEFINITION MAKE-LIST-AC)
       (:DEFINITION NATP)
       (:DEFINITION NOT)
       (:DEFINITION POSP)
       (:EXECUTABLE-COUNTERPART <)
       (:EXECUTABLE-COUNTERPART INTEGERP)
       (:EXECUTABLE-COUNTERPART NOT)
       (:EXECUTABLE-COUNTERPART POSP)
       (:EXECUTABLE-COUNTERPART ZP)
       (:INDUCTION MAKE-LIST-AC)
       (:REWRITE CAR-CONS)))))))
(local (in-theory (disable make-list-ac (:executable-counterpart make-list-ac))))
(local (defthm lcs-repeat-first-after-append
 (implies (posp n)
          (equal (car (append (make-list-ac n item nil) tail)) item))
 :hints (("Goal" :do-not-induct t
                  :use ((:instance lcs-repeat-consp (acc nil))
                        (:instance lcs-repeat-car (acc nil)))
                  :expand ((binary-append (make-list-ac n item nil) tail))
   :in-theory (union-theories (theory 'minimal-theory)
     '((:COMPOUND-RECOGNIZER NATP-COMPOUND-RECOGNIZER)
       (:COMPOUND-RECOGNIZER POSP-COMPOUND-RECOGNIZER)
       (:DEFINITION BINARY-APPEND)
       (:DEFINITION NOT)
       (:DEFINITION POSP)
       (:REWRITE CAR-CONS)
       (:REWRITE LCS-REPEAT-CAR)
       (:REWRITE LCS-REPEAT-CONSP)))))))
(defthm lcs-accepted-record-wide-pool-span-regression
 (let* ((h (lct-held 0))
        (segs (fn-lb-log-model-append h *lct-payload* 1 nil))
        (entry (fn-lb-log-model-row-entry h segs))
        (a 1) (b (+ (* (nth 3 entry) 4294967296) (nth 4 entry)))
        (fn-lbc (update-nth *fn-lbc-overview-store*
                  (make-list-ac 18446744073709551616 '(0) nil) (create-fn-lbc)))
        (out (fn-lc-commit-record h a b fn-lbc segs)))
   (and (fn-lbc-p fn-lbc) (fn-cat$ap nil)
        (fn-lbc-corr fn-lbc nil segs)
        (fn-lc-locators-resolve fn-lbc segs)
        (fn-lc-fresh-recordp h a b segs)
        (equal (mv-nth 0 out) :ok)
        (and (fn-lc-locators-resolve (mv-nth 1 out) (mv-nth 2 out))
             (fn-lbc-corr (mv-nth 1 out) (fn-cat$a-commit h nil) (mv-nth 2 out)))))
 :rule-classes nil

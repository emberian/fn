; Literal current-state algebra, not an installed raw object/funding claim.
(in-package "ACL2")
(include-book "../../books/receiver-turn-controller")
(defconst *fn-rxt-model-provider* '(nil ((:rx-capacity 0 0 4096) 0 4096)))
(defconst *fn-rxt-model-control* '(nil nil :idle nil nil (:receiver-install (:rx-capacity 0 0 4096) 0)))
(defconst *fn-rxt-model-pool*
 (list (list (fn-prl-build '(8192 0 0 0 8) '(0 0 0 0 1) 1 nil '(4608 0 0 0 0))
             nil nil nil nil) :served nil))
(defthm fn-rxt-positive-literal
 (let* ((token '(:rx-capacity 0 0 4096))
        (answer (fn-owner-rx-turn-begin token '(256 0 0 0 1)
                  *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*)))
  (and (fn-rx-providerp *fn-rxt-model-provider*)
       (fn-receiver-turnp *fn-rxt-model-control*)
       (fn-page-read-poolp *fn-rxt-model-pool*)
       (fn-rxp-currentp token *fn-rxt-model-provider*)
       (fn-rxt-issued-demandp '(256 0 0 0 1))
       (fn-rxt-installed-anchor-p token *fn-rxt-model-provider* *fn-rxt-model-control*)
       (equal (mv-nth 0 answer) :admitted)
       (equal (mv-nth 1 answer)
          '((:receiver-turn 1)
            (:receiver-source (:receiver-turn 1) (:rx-capacity 0 0 4096) 0)
            :live (256 0 0 0 1) nil (:receiver-install (:rx-capacity 0 0 4096) 0)))
       (equal (fn-owner-rx-turn-source (mv-nth 1 answer))
          '(:receiver-source (:receiver-turn 1) (:rx-capacity 0 0 4096) 0))
       (equal (fn-owner-page-read-ledger (mv-nth 2 answer))
          (fn-prl-build '(8192 0 0 0 8) '(256 0 0 0 2) 2 nil '(4608 0 0 0 0)))
       (equal (fn-prp-incoming-slot (mv-nth 2 answer)) nil)))
 :rule-classes nil)
(defthm fn-rxt-repeat-busy-literal
 (let* ((token '(:rx-capacity 0 0 4096))
        (first (fn-owner-rx-turn-begin token '(256 0 0 0 1)
                 *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*))
        (again (fn-owner-rx-turn-begin token '(256 0 0 0 1)
                 *fn-rxt-model-provider* (mv-nth 1 first) (mv-nth 2 first))))
  (and (equal (mv-nth 0 first) :admitted)
       (equal (mv-nth 0 again) :receiver-turn-busy)
       (equal (mv-nth 1 again) (mv-nth 1 first))
       (equal (mv-nth 2 again) (mv-nth 2 first))))
 :rule-classes nil)
(defthm fn-rxt-foreign-capacity-literal
 (let ((answer (fn-owner-rx-turn-begin '(:rx-capacity 2 0 4096) '(256 0 0 0 1)
                 *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*)))
  (and (not (fn-rxp-currentp '(:rx-capacity 2 0 4096) *fn-rxt-model-provider*))
       (equal (mv-nth 0 answer) :receiver-unavailable)
       (equal (mv-nth 1 answer) *fn-rxt-model-control*)
       (equal (mv-nth 2 answer) *fn-rxt-model-pool*)))
 :rule-classes nil)
(defthm fn-rxt-missing-installation-receipt-literal
 (let* ((controller '(nil nil :idle nil nil nil))
        (answer (fn-owner-rx-turn-begin '(:rx-capacity 0 0 4096) '(256 0 0 0 1)
                     *fn-rxt-model-provider* controller *fn-rxt-model-pool*)))
  (and (fn-receiver-turnp controller)
       (fn-rxp-currentp '(:rx-capacity 0 0 4096) *fn-rxt-model-provider*)
       (not (fn-rxt-installed-anchor-p '(:rx-capacity 0 0 4096)
                  *fn-rxt-model-provider* controller))
       (equal (mv-nth 0 answer) :receiver-unavailable)
       (equal (mv-nth 1 answer) controller)
       (equal (mv-nth 2 answer) *fn-rxt-model-pool*)))
 :rule-classes nil)

(defthm fn-rxt-range-positive-literal
 (let* ((first (fn-owner-rx-turn-start '(:rx-capacity 0 0 4096) '(256 0 0 0 1)
                *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*))
        (ticket (mv-nth 1 first)) (control (mv-nth 2 first)) (pool (mv-nth 3 first)))
  (and (equal (mv-nth 0 first) :admitted)
       (equal ticket '(:receiver-turn 1))
       (fn-rxt-live-claim-p ticket *fn-rxt-model-provider* control pool)
       (equal (fn-owner-rx-turn-fill-range ticket 16 nil 16
                  *fn-rxt-model-provider* control pool)
              (mv :receive-copy 0 16 0 *fn-rxt-model-provider* control pool))))
 :rule-classes nil)
; Wrong request identity: all other installation/claim state is retained.
(defthm fn-rxt-range-foreign-ticket-literal
 (let* ((first (fn-owner-rx-turn-start '(:rx-capacity 0 0 4096) '(256 0 0 0 1)
                *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*))
        (control (mv-nth 2 first)) (pool (mv-nth 3 first)))
  (and (equal (mv-nth 0 first) :admitted)
       (fn-rxt-live-claim-p '(:receiver-turn 1) *fn-rxt-model-provider* control pool)
       (not (fn-rxt-live-claim-p '(:receiver-turn 0) *fn-rxt-model-provider* control pool))
       (equal (fn-owner-rx-turn-fill-range '(:receiver-turn 0) 16 nil 16
                  *fn-rxt-model-provider* control pool)
              (mv :receiver-unavailable 0 0 16 *fn-rxt-model-provider* control pool))))
 :rule-classes nil)
(defthm fn-rxt-start-busy-does-not-return-held-ticket-literal
 (let* ((first (fn-owner-rx-turn-start '(:rx-capacity 0 0 4096) '(256 0 0 0 1)
                *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*))
        (control (mv-nth 2 first)) (pool (mv-nth 3 first)))
  (and (equal (mv-nth 0 first) :admitted)
       (equal (fn-owner-rx-turn-start '(:rx-capacity 0 0 4096) '(256 0 0 0 1)
                  *fn-rxt-model-provider* control pool)
              (mv :receiver-turn-busy nil control pool))))
 :rule-classes nil)

(defthm fn-rxt-copy-next-readiness-positive-literal
 (let* ((first (fn-owner-rx-turn-start '(:rx-capacity 0 0 4096) '(256 0 0 0 1)
                *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*))
        (ticket (mv-nth 1 first)) (control (mv-nth 2 first)) (pool (mv-nth 3 first))
        (next (fn-owner-rx-turn-copy-next ticket 3 nil 16 *fn-rxt-model-provider* control pool)))
  (and (equal (mv-nth 0 first) :admitted)
       (fn-rxt-live-claim-p ticket *fn-rxt-model-provider* control pool)
       (equal (mv-nth 0 next) :receive-copy)
       (equal next (mv :receive-copy 0 3 13
                       (update-nth 1 (update-nth 2 nil (nth 1 *fn-rxt-model-provider*)) *fn-rxt-model-provider*)
                       (update-nth 2 :copy-issued (update-nth 4 '(:receiver-copy 0 3 13) control)) pool))
       (equal (mv-nth 1 next) 0) (equal (mv-nth 2 next) 3) (equal (mv-nth 3 next) 13)
       (null (fn-rxp-capacity (mv-nth 4 next)))
       (not (fn-rxp-currentp '(:rx-capacity 0 0 4096) (mv-nth 4 next)))
       (equal (fn-rxt-phase (mv-nth 5 next)) :copy-issued)
       (not (fn-owner-rx-turn-consumablep ticket (mv-nth 4 next) (mv-nth 5 next) pool))
       (equal (fn-rxt-job (mv-nth 5 next)) '(:receiver-copy 0 3 13))
       (equal (mv-nth 6 next) pool)
       (equal (fn-owner-rx-turn-copy-next ticket 3 nil 999
                        (mv-nth 4 next) (mv-nth 5 next) pool) next)))
 :rule-classes nil)
(defthm fn-rxt-copy-ack-complete-positive-literal
 (let* ((first (fn-owner-rx-turn-start '(:rx-capacity 0 0 4096) '(256 0 0 0 1)
                *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*))
        (ticket (mv-nth 1 first)) (pool (mv-nth 3 first))
        (next (fn-owner-rx-turn-copy-next ticket 3 nil 16 *fn-rxt-model-provider* (mv-nth 2 first) pool))
        (copied (update-nth 0 '(1 2 3) (mv-nth 4 next)))
        (ack (fn-owner-rx-turn-copy-ack ticket 0 3 :copied copied (mv-nth 5 next) pool)))
  (and (equal (mv-nth 0 next) :receive-copy)
       (null (fn-rxp-capacity copied))
       (equal (fn-rxt-phase (mv-nth 5 next)) :copy-issued)
       (equal (fn-rxt-job (mv-nth 5 next)) '(:receiver-copy 0 3 13))
       (equal (len (nth 0 copied)) 3)
       (equal (mv-nth 0 ack) :receive-recorded)
       (equal (mv-nth 1 ack) (update-nth 0 '(1 2 3) *fn-rxt-model-provider*))
       (equal (nth 0 (mv-nth 1 ack)) '(1 2 3))
       (equal (fn-rxt-phase (mv-nth 2 ack)) :filled)
       (fn-owner-rx-turn-consumablep ticket (mv-nth 1 ack) (mv-nth 2 ack) pool)
       (equal (fn-owner-rx-turn-consumer-source ticket (mv-nth 1 ack) (mv-nth 2 ack) pool)
              '(:receiver-source (:receiver-turn 1) (:rx-capacity 0 0 4096) 0))
       (equal (fn-rxt-demand (mv-nth 2 ack)) '(256 0 0 0 1))
       (equal (fn-rxt-job (mv-nth 2 ack)) '(:receiver-copy 0 3 13))
       (equal (mv-nth 3 ack) pool)
       (equal (fn-owner-rx-turn-copy-ack ticket 0 3 :copied (mv-nth 1 ack) (mv-nth 2 ack) pool)
              (mv :receiver-unavailable (mv-nth 1 ack) (mv-nth 2 ack) pool))))
 :rule-classes nil)

(defthm fn-rxt-copy-uncertain-retains-custody-literal
 (let* ((first (fn-owner-rx-turn-start '(:rx-capacity 0 0 4096) '(256 0 0 0 1)
                *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*))
        (ticket (mv-nth 1 first)) (pool (mv-nth 3 first))
        (next (fn-owner-rx-turn-copy-next ticket 3 nil 16 *fn-rxt-model-provider* (mv-nth 2 first) pool))
        (ack (fn-owner-rx-turn-copy-ack ticket 0 3 :uncertain (mv-nth 4 next) (mv-nth 5 next) pool)))
  (and (equal (mv-nth 0 next) :receive-copy)
       (equal (mv-nth 0 ack) :receive-cancelled)
       (equal (mv-nth 1 ack) (mv-nth 4 next))
       (equal (mv-nth 2 ack) (update-nth 2 :cancelled (mv-nth 5 next)))
       (equal (mv-nth 3 ack) pool)
       (not (fn-owner-rx-turn-consumablep ticket (mv-nth 1 ack) (mv-nth 2 ack) pool))
       (not (fn-rxp-currentp '(:rx-capacity 0 0 4096) (mv-nth 1 ack)))
       (equal (fn-owner-rx-turn-start '(:rx-capacity 0 0 4096) '(256 0 0 0 1)
                       (mv-nth 1 ack) (mv-nth 2 ack) pool)
              (mv :receiver-unavailable nil (mv-nth 2 ack) pool))))
 :rule-classes nil)
; Mutation: an asserted success before actual fill publication is refused.
(defthm fn-rxt-copy-ack-missing-fill-mutation-literal
 (let* ((first (fn-owner-rx-turn-start '(:rx-capacity 0 0 4096) '(256 0 0 0 1)
                *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*))
        (ticket (mv-nth 1 first)) (pool (mv-nth 3 first))
        (next (fn-owner-rx-turn-copy-next ticket 3 nil 16 *fn-rxt-model-provider* (mv-nth 2 first) pool)))
  (and (equal (mv-nth 0 next) :receive-copy)
       (not (equal (len (nth 0 (mv-nth 4 next))) 3))
       (equal (fn-owner-rx-turn-copy-ack ticket 0 3 :copied (mv-nth 4 next) (mv-nth 5 next) pool)
              (mv :receiver-unavailable (mv-nth 4 next) (mv-nth 5 next) pool))))
 :rule-classes nil)

(defthm fn-rxt-copy-next-readiness-copy-hypothesis-removal-literal
 (let ((answer (fn-owner-rx-turn-copy-next '(:receiver-turn 99) 3 nil 16
                 *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*)))
  (and (not (equal (mv-nth 0 answer) :receive-copy))
       (not (null (fn-rxp-capacity (mv-nth 4 answer))))
       (not (equal (fn-rxt-phase (mv-nth 5 answer)) :copy-issued))
       (equal (mv-nth 6 answer) *fn-rxt-model-pool*)))
 :rule-classes nil)

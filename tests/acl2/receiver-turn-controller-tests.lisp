; Literal current-state algebra, not an installed raw object/funding claim.
(in-package "ACL2")
(include-book "../../books/receiver-turn-controller")
(defconst *fn-rxt-model-provider* '(nil ((:rx-capacity 0 0 4096) 0 4096)))
(defconst *fn-rxt-model-control* '(nil nil :idle nil nil (:receiver-install (:rx-capacity 0 0 4096) 0)))
(defconst *fn-rxt-model-pool*
 (list (list (fn-prl-build '(8192 0 0 0 8) '(0 0 0 0 1) 1 nil '(4608 0 0 0 0))
             nil nil nil nil) :served nil))
(defthm fn-rxt-positive-literal
 (let* ((token '(:rx-capacity 0 0 4096))
        (answer (fn-owner-rx-turn-begin token '(256 0 0 0 1)
                  *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*)))
  (and (fn-rx-providerp *fn-rxt-model-provider*)
       (fn-receiver-turnp *fn-rxt-model-control*)
       (fn-page-read-poolp *fn-rxt-model-pool*)
       (fn-rxp-currentp token *fn-rxt-model-provider*)
       (fn-rxt-issued-demandp '(256 0 0 0 1))
       (fn-rxt-installed-anchor-p token *fn-rxt-model-provider* *fn-rxt-model-control*)
       (equal (mv-nth 0 answer) :admitted)
       (equal (mv-nth 1 answer)
          '((:receiver-turn 1)
            (:receiver-source (:receiver-turn 1) (:rx-capacity 0 0 4096) 0)
            :live (256 0 0 0 1) nil (:receiver-install (:rx-capacity 0 0 4096) 0)))
       (equal (fn-owner-rx-turn-source (mv-nth 1 answer))
          '(:receiver-source (:receiver-turn 1) (:rx-capacity 0 0 4096) 0))
       (equal (fn-owner-page-read-ledger (mv-nth 2 answer))
          (fn-prl-build '(8192 0 0 0 8) '(256 0 0 0 2) 2 nil '(4608 0 0 0 0)))
       (equal (fn-prp-incoming-slot (mv-nth 2 answer)) nil)))
 :rule-classes nil)
(defthm fn-rxt-repeat-busy-literal
 (let* ((token '(:rx-capacity 0 0 4096))
        (first (fn-owner-rx-turn-begin token '(256 0 0 0 1)
                 *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*))
        (again (fn-owner-rx-turn-begin token '(256 0 0 0 1)
                 *fn-rxt-model-provider* (mv-nth 1 first) (mv-nth 2 first))))
  (and (equal (mv-nth 0 first) :admitted)
       (equal (mv-nth 0 again) :receiver-turn-busy)
       (equal (mv-nth 1 again) (mv-nth 1 first))
       (equal (mv-nth 2 again) (mv-nth 2 first))))
 :rule-classes nil)
(defthm fn-rxt-foreign-capacity-literal
 (let ((answer (fn-owner-rx-turn-begin '(:rx-capacity 2 0 4096) '(256 0 0 0 1)
                 *fn-rxt-model-provider* *fn-rxt-model-control* *fn-rxt-model-pool*)))
  (and (not (fn-rxp-currentp '(:rx-capacity 2 0 4096) *fn-rxt-model-provider*))
       (equal (mv-nth 0 answer) :receiver-unavailable)
       (equal (mv-nth 1 answer) *fn-rxt-model-control*)
       (equal (mv-nth 2 answer) *fn-rxt-model-pool*)))
 :rule-classes nil)
(defthm fn-rxt-missing-installation-receipt-literal
 (let* ((controller '(nil nil :idle nil nil nil))
        (answer (fn-owner-rx-turn-begin '(:rx-capacity 0 0 4096) '(256 0 0 0 1)
                     *fn-rxt-model-provider* controller *fn-rxt-model-pool*)))
  (and (fn-receiver-turnp controller)
       (fn-rxp-currentp '(:rx-capacity 0 0 4096) *fn-rxt-model-provider*)
       (not (fn-rxt-installed-anchor-p '(:rx-capacity 0 0 4096)
                  *fn-rxt-model-provider* controller))
       (equal (mv-nth 0 answer) :receiver-unavailable)
       (equal (mv-nth 1 answer) controller)
       (equal (mv-nth 2 answer) *fn-rxt-model-pool*)))
 :rule-classes nil)

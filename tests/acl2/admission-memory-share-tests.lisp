; Witness and teeth for books/admission-memory-share.lisp (fn-adm-held-share).  Evaluated
; assertions for now; defteeth forms replace them once the theorems are proved.
(in-package "ACL2")
(include-book "../../books/admission-memory-share")
(include-book "stx-tests")
(include-book "std/testing/assert-bang" :dir :system)
(defun k5-rep (n c) (coerce (make-list n :initial-element c) 'string))
(defun bsb-lines-crlf (strings)
  (if (consp strings) (append (fn-record-string-octets (car strings)) '(13 10) (bsb-lines-crlf (cdr strings))) nil))
(defun k5-toks (n tag) (if (zp n) "" (concatenate 'string (if (equal tag "") "" " ") "sha256:A" (k5-toks (- n 1) " "))))
(defun k5-toklines (name n)
  (if (zp n) nil
      (cons (concatenate 'string name ": " (k5-toks (min n 50) ""))
            (k5-toklines name (- n (min n 50))))))
(defun k5-foldlines (fl w) (if (zp fl) nil (cons (concatenate 'string " " (k5-rep w #\s)) (k5-foldlines (- fl 1) w))))
(defun k5-hdr-strings (subjw folds reflen nkeys nlocks ctl)
  (append (list "From: agent-a@example.invalid" "Newsgroups: fn.test"
                (concatenate 'string "Subject: " (k5-rep subjw #\s)))
          (k5-foldlines folds subjw)
          (list "Message-ID: <a1@example.invalid>" "Date: Wed, 23 Sep 2026 12:00:00 +0000")
          (if (< 0 reflen) (list (concatenate 'string "References: <" (k5-rep reflen #\r) "@x>")) nil)
          (k5-toklines "Cancel-Key" nkeys)
          (k5-toklines "Cancel-Lock" nlocks)
          (if ctl (list "Control: cancel <t@x.invalid>") nil)))
(defun k5-authored-gen (subjw folds reflen nkeys nlocks ctl bodylen)
  (append (bsb-lines-crlf (k5-hdr-strings subjw folds reflen nkeys nlocks ctl))
          '(13 10) (fn-record-string-octets (k5-rep bodylen #\b))))
(defun k5-pick (n k) (nth (mod n (len k)) k))
(defun k5-groups (g) (if (zp g) nil (cons (concatenate 'string (k5-rep 255 #\x) (coerce (explode-nonnegative-integer g 10 nil) 'string)) (k5-groups (- g 1)))))
(defun k5-nums (gs k) (if (consp gs) (cons (cons (car gs) k) (k5-nums (cdr gs) k)) nil))
(defconst *u32* (- (expt 2 32) 1))
(defconst *u64* (- (expt 2 64) 1))
(defun m13-prof (g) (declare (xargs :verify-guards nil))
  (fn-bs-profile-resolve (list :development (list (cons *fn-bs-pf-max-transactions* 128) (cons *fn-bs-pf-max-history-octets* 200000) (cons *fn-bs-pf-max-record-octets* 196608) (cons *fn-bs-pf-max-groups-per-article* g) (cons *fn-bs-pf-max-open-suffix* 128))) nil))
(defun m13-case-bytes (n)
  (let* ((subjw (k5-pick n '(1 8 100 400 900)))
         (folds (k5-pick (floor n 5) '(0 0 1 3 7)))
         (reflen (k5-pick (floor n 25) '(0 0 50 600)))
         (nkeys (k5-pick (floor n 100) '(0 0 1 5 60 200)))
         (nlocks (k5-pick (floor n 600) '(0 0 1 5 60 200)))
         (ctl (evenp (floor n 3600)))
         (bodylen (k5-pick (floor n 7200) '(0 1 30 3000)))
         (a (k5-authored-gen subjw folds reflen nkeys nlocks ctl bodylen)))
    (if (evenp (floor n 50000))
        a
      (let ((s (fn-stmt-sign *stx-sk* *stx-creator* 1 1 nil :article a)))
        (fn-stx-test-received (fn-stx-header-value s) a)))))
(defun m13-w (n gen bytes gs)
  (if (= (mod n 4) 0)
      (fn-record-make *u64* *u64* (if gen *u32* 0) "<a1@example.invalid>" bytes gs "o0" "s0" "e0" 4 1)
    (fn-record-make *u64* *u64* (if gen *u32* 0) (concatenate 'string "<" (k5-rep 248 #\m) ">") bytes gs
                    (k5-rep 256 #\o) (k5-rep 256 #\s) (k5-rep 256 #\e) *u64* *u64*)))
(defun m13-case (n g numbered gen)
  (let* ((bytes (m13-case-bytes n))
         (kr (if (evenp (floor n 50000)) nil *stx-keyring*))
         (ng (if (evenp (floor n 3)) g (min g (1+ (mod n 3)))))
         (gs (k5-groups ng))
         (w (m13-w n gen bytes gs))
         (r (fn-intern-row-at w kr (if gen *u32* 0) *u64*))
         (h (if numbered
                (fn-held-with-withdrawn (fn-held-with-numbers r (k5-nums gs *u64*)) (cons *u64* *u64*))
              r)))
    (list h bytes kr (if gen *u32* 0))))
(defun m13-hyps (h bytes kr gen p)
  (and (fn-bs-profile-admittedp p) (fn-held-p h)
       (fn-record-groups-validp (fn-record-groups h))
       (<= (len (fn-record-groups h)) (nfix (fn-bs-profile-max-groups-per-article p)))
       (equal (fn-held-facts h) (fn-held-facts-of bytes))
       (fn-record-payloadp bytes)
       (equal (fn-held-context h) (fn-held-context-of bytes kr gen))
       (unsigned-byte-p 32 gen)
       (unsigned-byte-p 64 (fn-record-payload h))
       (fn-adm-numbers-domain-p h)))
(defun m13-case (n g numbered gen)
  (let* ((bytes (m13-case-bytes n))
         (kr (if (evenp (floor n 50000)) nil *stx-keyring*))
         (ng (if (evenp (floor n 3)) g (min g (1+ (mod n 3)))))
         (gs (k5-groups ng))
         (w (m13-w n gen bytes gs))
         (r (fn-intern-row-at w kr (if gen *u32* 0) *u64*))
         (h (if numbered
                (fn-held-with-withdrawn (fn-held-with-numbers r (k5-nums gs *u64*)) (cons *u64* *u64*))
              r)))
    (list h bytes kr (if gen *u32* 0))))
(make-event `(defconst *m13-bytes* ',(m13-case-bytes 60001)))
(defconst *m13-p* (m13-prof 2))
(make-event `(defconst *m13-h* ',(car (m13-case 60001 2 nil t))))
(defun m13-with-numbers (h ns) (fn-held-with-numbers h ns))
(defun m13-hyp-tuple (h bytes kr gen p)
  (list (fn-bs-profile-admittedp p) (fn-held-p h)
        (<= (len (fn-record-groups h)) (nfix (fn-bs-profile-max-groups-per-article p)))
        (equal (fn-held-facts h) (fn-held-facts-of bytes))
        (equal (fn-held-context h) (fn-held-context-of bytes kr gen))
        (unsigned-byte-p 64 (fn-record-payload h))
        (fn-adm-numbers-domain-p h)))
(defconst *m13-dup-h* (m13-with-numbers *m13-h* (make-list 1000 :initial-element (cons "fn.test" 1))))
(defconst *m13-wd-h* (fn-held-with-withdrawn *m13-h* (cons (expt 2 2040) 0)))
(defconst *m13-nov-h*
  (let* ((f (fn-held-facts-of *m13-bytes*))
         (big (k5-rep 100000 #\v))
         (ctl (fn-hf-control f))
         (f2 (fn-hf-make (fn-hf-octets f) (fn-hf-body-start f) (fn-hf-body-lines f)
                         (fn-hf-control-with-nov ctl (fn-hnov-make nil t big big big big big)))))
    (fn-held-make (fn-record-sequence *m13-h*) (fn-record-txid *m13-h*) (fn-record-generation *m13-h*)
                  (fn-record-msgid *m13-h*) (fn-record-payload *m13-h*) (fn-record-groups *m13-h*)
                  (fn-record-obligation-id *m13-h*) (fn-record-content-subject *m13-h*)
                  (fn-record-release-evidence *m13-h*) (fn-record-charge *m13-h*) (fn-record-stamp *m13-h*)
                  f2 (fn-held-context *m13-h*) nil nil)))
(assert-event (equal (m13-hyp-tuple *m13-h* *m13-bytes* *stx-keyring* *u32* *m13-p*) '(t t t t t t t)))
(assert-event (fn-adm-row-within-p *m13-h* *m13-p*))
(assert-event (equal (m13-hyp-tuple *m13-dup-h* *m13-bytes* *stx-keyring* *u32* *m13-p*) '(t t t t t t nil)))
(assert-event (not (fn-adm-row-within-p *m13-dup-h* *m13-p*)))
(assert-event (equal (m13-hyp-tuple *m13-wd-h* *m13-bytes* *stx-keyring* *u32* *m13-p*) '(t t t t t t nil)))
(assert-event (not (fn-adm-row-within-p *m13-wd-h* *m13-p*)))
(assert-event (equal (m13-hyp-tuple *m13-nov-h* *m13-bytes* *stx-keyring* *u32* *m13-p*) '(t t t nil t t t)))
(assert-event (not (fn-adm-row-within-p *m13-nov-h* *m13-p*)))
(assert-event (not (fn-stxa-p nil)))

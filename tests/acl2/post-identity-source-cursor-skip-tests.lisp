(defthm fn-psc-skip-source-extent-removal-literal
 (let* ((incoming (append *fn-cll-key-field* '(32 120 10 97)))
        (held nil) (c (fn-psc-begin :agent 0 "<a@b>" nil (len incoming)))
        (d (fn-psc-model-skip-complete c incoming held)))
  (and (true-listp c) (equal (len c) 24)
       (equal (fn-psc-get phase c) :control) (equal (fn-psc-get resume c) :start)
       (true-listp (fn-psc-model-source c incoming held))
       (not (equal (fn-psc-get n c) (len (fn-psc-model-source c incoming held))))
       (not (fn-psc-skip-statep c incoming held))
       (not (equal (fn-psc-get pos d) (fn-pbb-skip-at incoming)))))
 :rule-classes nil)

     (fn-ros-pipeline-physical :append '(:barrier (:resource :owner 2 1)) :terminal fn-resource-ledger)
     (if (and (equal word :stale) (equal before (fn-rl-bank fn-resource-ledger)))
         (mv nil '(value-triple :cross-role-receipt-keeps-custody) state fn-resource-ledger)
       (mv t nil state fn-resource-ledger)))))
(make-event
 (mv-let (word fn-resource-ledger)
   (fn-ros-pipeline-outcome :append '(:append (:resource :owner 2 1)) 7 fn-resource-ledger)
   (if (and (equal word :pending) (not (fn-ros-drainedp fn-resource-ledger)))
       (mv nil '(value-triple :operation-alone-keeps-custody) state fn-resource-ledger)
     (mv t nil state fn-resource-ledger))))
(make-event
 (mv-let (word fn-resource-ledger)
   (fn-ros-pipeline-physical :append '(:append (:resource :owner 2 1)) :terminal fn-resource-ledger)
   (if (and (equal word :settled) (fn-ros-drainedp fn-resource-ledger))
       (mv nil '(value-triple :both-append-receipts-settle) state fn-resource-ledger)
     (mv t nil state fn-resource-ledger))))

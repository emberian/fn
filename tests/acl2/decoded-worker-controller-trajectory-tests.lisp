; Logical actual registered caller fixtures, not a native custody installation.
(in-package "ACL2")
(include-book "../../books/decoded-worker-controller-trajectory")
(defun-nx fn-dwctt-message () (fn-pzd-stored '(65 66 67)))
(defun-nx fn-dwctt-token ()
 (list :decoded-window 23 7 100 8 100 8 1
       (fn-bch-pack (fn-blake3 (fn-dwctt-message))) 3 0))
(defun-nx fn-dwctt-assigned ()
 (let* ((c (create-fn-pww-carry))
        (c (update-fn-pww-token (fn-dwctt-token) c))
        (c (update-fn-pww-phase :assigned c))
        (c (update-fn-pww-borrow-phase :owned c))
        (c (update-fn-pww-root '(logical-captured-fixture) c)))
  (update-fn-pww-source-incarnation 47 c)))
(defun-nx fn-dwctt-begin ()
 (fn-dwc-begin (fn-dwctt-token) (fn-dwctt-assigned)
               (create-pgs-digest-state) (create-fn-zin-st) nil nil nil))
(defun-nx fn-dwctt-first-one ()
 (let ((b (fn-dwctt-begin)))
  (fn-dwc-one (fn-dwctt-token) (nth 1 b) nil (nth 2 b)
              (nth 3 b) (nth 4 b) (nth 5 b) (nth 6 b) (create-fn-ew-buffer))))
(defun-nx fn-dwctt-issued-read ()
 (let ((r (fn-dwctt-first-one)))
  (fn-dwc-one (fn-dwctt-token) (nth 2 r) (nth 3 r) (nth 4 r)
              (nth 5 r) (nth 6 r) (nth 7 r) (nth 8 r) (nth 9 r))))
(defun-nx fn-dwctt-codec-current ()
 (let* ((s (fn-dwctt-issued-read))
        (r (fn-dwc-read-observation (fn-dwctt-token)
             (fn-pww-action-revision (nth 2 s)) :ok (nth 2 s)
             (fn-dwctt-message) (nth 4 s) (nth 9 s))))
  (list :fixture nil (nth 1 r) (nth 2 r) (nth 3 r)
        (nth 5 s) (nth 6 s) (nth 7 s) (nth 8 s) (nth 4 r))))
(defun-nx fn-dwctt-codec-one ()
 (let ((r (fn-dwctt-codec-current)))
  (fn-dwc-one (fn-dwctt-token) (nth 2 r) (nth 3 r) (nth 4 r)
              (nth 5 r) (nth 6 r) (nth 7 r) (nth 8 r) (nth 9 r))))

(local
 (defthm fn-dwctt-digest-codec-positive
  (let* ((s (fn-dwctt-codec-current)) (r (fn-dwctt-codec-one))
         (z (fn-pww-controller (nth 2 s)))
         (next (fn-pww-controller (nth 2 r))) (msg (fn-dwctt-message)))
   (and (pgs-dcs-invariantp 0 (nth 3 (nth 1 z)) msg (nth 4 s))
        (pgs-dcs-invariantp 0 (nth 3 (nth 1 next)) msg (nth 4 r))
        (equal (car z) :codec) (equal (car next) :decoded)
        (equal (fn-zin-tout (nth 5 r)) 3)
        (equal (take 2 (nth 0 (nth 9 r))) '(66 67))))
  :hints (("Goal" :in-theory (enable pgs-dcs-invariantp pgs-dbd-domainp pgs-dcd-domainp
                         pgs-dcs-counterp pgs-dcs-counter-framesp pgs-dbd-framesp pgs-dcd-framesp
                         pgs-dcs-phasep pgs-dcs-blockp pgs-dcr-denote pgs-dcr-current pgs-dcr-span)
                   :expand ((:free (out msg cursor) (pgs-dcr-fold 0 out msg cursor)))))
  :rule-classes nil))

; Every selected-prefix hypothesis except the produced-position equality.
(defun-nx fn-dwctt-selected-retained-hypotheses (s prefix j)
 (let* ((c (nth 2 s)) (z (fn-pww-controller c)) (token (fn-dwctt-token)))
  (and (fn-pwz-tokenp token) (equal token (fn-pww-token c))
       (eq (fn-pww-phase c) :running) (eq (fn-pww-borrow-phase c) :owned)
       (null (fn-pww-pending-action c)) (true-listp z) (true-listp (nth 1 z))
       (equal (car (fn-ewz-next-action z (nth 4 s))) :codec)
       (natp (nth 6 z)) (natp (nth 7 z)) (<= (nth 6 z) (nth 7 z))
       (<= (- (nth 7 z) (nth 6 z)) 64)
       (<= (nth 7 z) (fn-octets-len (nth 3 s)))
       (natp (nth 3 z)) (natp (nth 4 z)) (<= (nth 4 z) 16384) (natp j)
       (equal (len (nth 6 s)) *fn-zin-win-octets*)
       (equal (len (nth 7 s)) *fn-zin-tab-octets*)
       (implies (and (< j (nth 4 z)) (< (+ (nth 3 z) j) (len prefix)))
                (equal (nth j (nth 0 (nth 9 s))) (nth (+ (nth 3 z) j) prefix))))))
(defun-nx fn-dwctt-selected-conclusion (s prefix j)
 (let* ((z (fn-pww-controller (nth 2 s)))
        (scratch (mv-nth 6 (fn-pzw-stored-chunk 1024 (nth 5 z) (nth 6 z) (nth 7 z)
                  (nth 12 (nth 1 z)) (nth 2 z) (nth 5 s) (nth 3 s) (nth 6 s) (nth 7 s) (nth 8 s))))
        (model (append prefix scratch))
        (r (fn-dwc-one (fn-dwctt-token) (nth 2 s) (nth 3 s) (nth 4 s)
                       (nth 5 s) (nth 6 s) (nth 7 s) (nth 8 s) (nth 9 s))))
  (and (equal (fn-zin-tout (nth 5 r)) (len model))
       (implies (and (< j (nth 4 z)) (< (+ (nth 3 z) j) (len model)))
                (equal (nth j (nth 0 (nth 9 r))) (nth (+ (nth 3 z) j) model))))))
(local
 (defthm fn-dwctt-selected-codec-positive
  (let ((s (fn-dwctt-codec-current)))
   (and (fn-dwctt-selected-retained-hypotheses s nil 0)
        (equal (fn-zin-tout (nth 5 s)) (len nil))
        (fn-dwctt-selected-conclusion s nil 0)))
  :rule-classes nil))
(local
 (defthm fn-dwctt-selected-position-removal
  (let ((s (fn-dwctt-codec-current)))
   (and (fn-dwctt-selected-retained-hypotheses s '(9) 0)
        (not (equal (fn-zin-tout (nth 5 s)) (len '(9))))
        (not (fn-dwctt-selected-conclusion s '(9) 0))))
  :rule-classes nil))
(local
 (defthm fn-dwctt-budget-read-issue-positive
  (let* ((s (fn-dwctt-first-one)) (r (fn-dwctt-issued-read))
         (z (fn-pww-controller (nth 2 s))) (next (fn-pww-controller (nth 2 r))))
   (and (fn-pwz-budget-carryp (nth 12 (nth 1 z)) (nth 2 z) (nth 5 z) (nth 5 s))
        (not (consp (nth 8 next)))
        (fn-pwz-budget-carryp (nth 12 (nth 1 next)) (nth 2 next) (nth 5 next) (nth 5 r))
        (equal (car r) :read) (equal (fn-pww-phase (nth 2 r)) :running)))
  :rule-classes nil))

(local
 (defthm fn-dwctt-digest-carry-removal-corrupted-state
  (let* ((s (fn-dwctt-codec-current)) (z (fn-pww-controller (nth 2 s)))
         (h (update-pgs-dc-output nil (nth 4 s)))
         (r (fn-dwc-one (fn-dwctt-token) (nth 2 s) (nth 3 s) h
                        (nth 5 s) (nth 6 s) (nth 7 s) (nth 8 s) (nth 9 s)))
         (next (fn-pww-controller (nth 2 r))) (msg (fn-dwctt-message)))
   (and (not (pgs-dcs-invariantp 0 (nth 3 (nth 1 z)) msg h))
        (not (pgs-dcs-invariantp 0 (nth 3 (nth 1 next)) msg (nth 4 r)))
        (equal (car z) :codec) (equal (car next) :decoded)))
  :hints (("Goal" :in-theory (enable pgs-dcs-invariantp pgs-dbd-domainp pgs-dcd-domainp
                         pgs-dcs-counterp pgs-dcs-counter-framesp pgs-dbd-framesp pgs-dcd-framesp
                         pgs-dcs-phasep pgs-dcs-blockp pgs-dcr-denote pgs-dcr-current pgs-dcr-span)
                   :expand ((:free (out msg cursor) (pgs-dcr-fold 0 out msg cursor)))))
  :rule-classes nil))
(local
 (defthm fn-dwctt-budget-carry-removal-corrupted-state
  (let* ((s (fn-dwctt-codec-current))
         (z (update-nth 5 0 (fn-pww-controller (nth 2 s))))
         (c (update-fn-pww-controller z (nth 2 s)))
         (r (fn-dwc-one (fn-dwctt-token) c (nth 3 s) (nth 4 s)
                        (nth 5 s) (nth 6 s) (nth 7 s) (nth 8 s) (nth 9 s)))
         (next (fn-pww-controller (nth 2 r))))
   (and (not (fn-pwz-budget-carryp (nth 12 (nth 1 z)) (nth 2 z) (nth 5 z) (nth 5 s)))
        (not (consp (nth 8 next)))
        (not (fn-pwz-budget-carryp (nth 12 (nth 1 next)) (nth 2 next) (nth 5 next) (nth 5 r)))
        (equal (nth 5 next) 0) (equal (fn-zin-tout (nth 5 r)) 0)))
  :rule-classes nil))
(local
 (defthm fn-dwctt-read-digest-positive
  (let* ((s (fn-dwctt-issued-read)) (c (nth 2 s)) (z (fn-pww-controller c))
         (msg (fn-dwctt-message))
         (r (fn-dwc-read-observation (fn-dwctt-token) (fn-pww-action-revision c)
                                     :ok c msg (nth 4 s) (nth 9 s)))
         (next (fn-pww-controller (nth 1 r))))
   (and (pgs-dcs-invariantp 0 (nth 3 (nth 1 z)) msg (nth 4 s))
        (implies (equal (nth 0 (nth 1 z)) :scan)
                 (equal msg (fn-shr-win (nth 7 (nth 1 z)) (fn-ewp-demand (nth 1 z)) msg)))
        (pgs-dcs-invariantp 0 (nth 3 (nth 1 next)) msg (nth 3 r))
        (equal (car r) :continue) (equal (car next) :codec)
        (null (fn-pww-pending-action (nth 1 r)))))
  :hints (("Goal" :in-theory (enable pgs-dcs-invariantp pgs-dbd-domainp pgs-dcd-domainp
                         pgs-dcs-counterp pgs-dcs-counter-framesp pgs-dbd-framesp pgs-dcd-framesp
                         pgs-dcs-phasep pgs-dcs-blockp pgs-dcr-denote pgs-dcr-current pgs-dcr-span)
                   :expand ((:free (out msg cursor) (pgs-dcr-fold 0 out msg cursor)))))
  :rule-classes nil))
(local
 (defthm fn-dwctt-read-source-removal
  (let* ((s (fn-dwctt-issued-read)) (c (nth 2 s)) (z (fn-pww-controller c))
         (msg (fn-dwctt-message)) (input (update-nth 7 68 msg))
         (r (fn-dwc-read-observation (fn-dwctt-token) (fn-pww-action-revision c)
                                     :ok c input (nth 4 s) (nth 9 s)))
         (next (fn-pww-controller (nth 1 r))))
   (and (pgs-dcs-invariantp 0 (nth 3 (nth 1 z)) msg (nth 4 s))
        (not (implies (equal (nth 0 (nth 1 z)) :scan)
                      (equal input (fn-shr-win (nth 7 (nth 1 z)) (fn-ewp-demand (nth 1 z)) msg))))
        (not (pgs-dcs-invariantp 0 (nth 3 (nth 1 next)) msg (nth 3 r)))
        (equal (car r) :continue) (equal (car next) :codec)))
  :hints (("Goal" :in-theory (enable pgs-dcs-invariantp pgs-dbd-domainp pgs-dcd-domainp
                         pgs-dcs-counterp pgs-dcs-counter-framesp pgs-dbd-framesp pgs-dcd-framesp
                         pgs-dcs-phasep pgs-dcs-blockp pgs-dcr-denote pgs-dcr-current pgs-dcr-span)
                   :expand ((:free (out msg cursor) (pgs-dcr-fold 0 out msg cursor)))))
  :rule-classes nil))

; Structural source-cursor fixture, not a typed Store/authenticated parse witness.
(in-package "ACL2")
(thm
 (let* ((field (fn-sl-of '(:first :second)))
        (c0 (fn-osrc-begin field (fn-sfr-count field) 7 11))
        (r1 (fn-osrc-tick c0 nil)) (c1 (cadr r1))
        (r2 (fn-osrc-tick c1 nil)) (c2 (cadr r2))
        (r3 (fn-osrc-tick c2 nil)) (c3 (cadr r3))
        (r4 (fn-osrc-tick c3 nil)) (c4 (cadr r4))
        (r5 (fn-osrc-tick c4 nil)) (c5 (fn-osrc-at 4 r5))
        (r6 (fn-osrc-tick c5 nil)) (c6 (fn-osrc-at 4 r6)))
  (and (fn-sfr-canonp field)
       (equal (fn-sfr-count field) 2)
       (fn-rccos-cursor-invariantp c0)
       (equal (list (car r1) (car r2) (car r3) (car r4))
              '(:yield :yield :yield :yield))
       (fn-rccos-cursor-invariantp c1) (fn-rccos-cursor-invariantp c2)
       (fn-rccos-cursor-invariantp c3) (fn-rccos-cursor-invariantp c4)
       (equal (car r5) :row) (equal (fn-osrc-at 2 r5) '(:resident :first))
       (member-equal (fn-osrc-at 1 (fn-osrc-at 2 r5)) (fn-sfr-list field))
       (fn-rccos-cursor-invariantp c5)
       (equal (car r6) :row) (equal (fn-osrc-at 2 r6) '(:resident :second))
       (member-equal (fn-osrc-at 1 (fn-osrc-at 2 r6)) (fn-sfr-list field))
       (fn-rccos-cursor-invariantp c6)
       (equal (fn-osrc-tick c6 nil) '(:done (7 11 0 2)))))
 :hints (("Goal" :in-theory (enable fn-rccos-cursor-invariantp fn-rccos-base fn-rccos-suffix))))
(thm
 (let ((c (fn-osrc-begin (fn-sl-of nil) 0 7 11)))
  (and (fn-rccos-cursor-invariantp c)
       (not (fn-rccos-cursor-invariantp (update-nth 3 1 c)))))
 :hints (("Goal" :in-theory (enable fn-rccos-cursor-invariantp fn-rccos-base fn-rccos-suffix))))

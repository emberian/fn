(in-package "ACL2")
(include-book "../../books/consumer-account-index-shape")
(assert-event (let* ((name '(0 255)) (trie (fn-cai-put-octets name '(row 7) nil)))
 (and (fn-cbor-octet-listp name) (fn-cais-triep nil)
      (fn-cais-triep trie) (equal (fn-cai-get-octets name trie) '(row 7))
      (<= (len trie) 257)
      (<= (fn-cais-get-visits name trie) (* 257 (1+ (len name))))
      (<= (fn-cais-put-conses name trie) (* 259 (1+ (len name))))
      (<= (fn-cais-put-visits name trie) (* 514 (1+ (len name)))))))
; Distinctness is necessary: duplicate members exceed the alphabet cardinality.
(assert-event (and (subsetp-equal '(a a) '(a))
                   (not (no-duplicatesp-equal '(a a)))
                   (not (<= (len '(a a)) (len '(a))))))
; Alphabet membership is necessary, retaining distinctness.
(assert-event (and (no-duplicatesp-equal '(a b))
                   (not (subsetp-equal '(a b) '(a)))
                   (not (<= (len '(a b)) (len '(a))))))
(assert-event (let ((trie (fn-cai-put-octets '(255) 'terminal nil)))
 (and (fn-cais-triep trie)
      (fn-cais-triep (fn-cai-put-octets '(255 0) 'child trie))
      (equal (fn-cai-get-octets '(255)
               (fn-cai-put-octets '(255 0) 'child trie)) 'terminal))))
(defun fn-cais-test-duplicate-branches (n)
 (declare (xargs :guard (natp n)))
 (if (zp n) nil (cons (cons (code-char 0) nil)
                     (fn-cais-test-duplicate-branches (1- n)))))
; Corrupted-state removal: alphabet retained, uniqueness removed; all three
; advertised path ceilings fail on the actual separate terminal traversal.
(assert-event (let ((trie (fn-cais-test-duplicate-branches 258)))
 (and (fn-cais-alphabet-triep trie)
      (not (fn-midx-unique-branchesp trie)) (not (fn-cais-triep trie))
      (not (<= (len trie) 257))
      (not (<= (fn-cais-get-visits nil trie) (* 257 (1+ (len nil)))))
      (not (<= (fn-cais-put-conses nil trie) (* 259 (1+ (len nil))))))))

(assert-event (let ((trie (fn-cais-test-duplicate-branches 515))) (and (fn-cais-alphabet-triep trie) (not (fn-midx-unique-branchesp trie)) (not (<= (fn-cais-put-visits nil trie) (* 514 (1+ (len nil))))))))

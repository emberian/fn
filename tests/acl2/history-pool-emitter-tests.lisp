(in-package "ACL2")
(include-book "../../books/history-pool-emitter")
(include-book "../../books/history-pages-row")

(defun hpet-run (fuel c fn-hpb)
  (declare (xargs :stobjs fn-hpb :verify-guards nil))
  (if (zp fuel) (mv :fuel nil c fn-hpb)
    (mv-let (v summary next fn-hpb) (fn-hpe-tick c fn-hpb)
      (if (eq v :continue) (hpet-run (1- fuel) next fn-hpb)
        (mv v summary next fn-hpb)))))

(defun hpet-row (row)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn-hpb
    (mv-let (ok fn-hpb)
      (let* ((fn-hpb (fn-hpb-begin 'epoch 'lease fn-hpb))
             (c (fn-hpe-begin (list :resident row) 'epoch 'lease)))
        (mv-let (v bytes next fn-hpb) (hpet-run 200 c fn-hpb)
          (mv (and (fn-hrcur-tree-domainp row)
                   (< (len (fn-scc-encode row)) 18446744073709551616)
                   (fn-hpe-invariantp c)
                   (equal (fn-hpe-total c) (len (fn-scc-encode row)))
                   (equal v :prepared) (equal bytes (len (fn-scc-encode row)))
                   (fn-hpe-invariantp next) (fn-hpbp fn-hpb)
                   (equal (fn-hpb-prefix fn-hpb)
                          (fn-hp-pack8 (ceiling (len (fn-hp-pe row)) 8) (fn-hp-pe row)))
                   (equal (fn-hpb-epoch fn-hpb) 'epoch)
                   (equal (fn-hpb-lease fn-hpb) 'lease)) fn-hpb)))
      ok)))
(assert-event (hpet-row '(1 2 3)))
(assert-event (hpet-row "hello"))
(assert-event (hpet-row '("hello" . 256)))

(defun hpet-page-resume ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn-hpb
    (mv-let (ok fn-hpb)
      (let* ((row (make-list 16400 :initial-element 42))
             (fn-hpb (fn-hpb-begin 'epoch 'lease fn-hpb))
             (c (fn-hpe-begin (list :resident row) 'epoch 'lease)))
        (mv-let (v ignored next fn-hpb) (hpet-run 50000 c fn-hpb)
          (declare (ignore ignored))
          (let ((first (fn-hpb-prefix fn-hpb))
                (antecedent (and (fn-hpe-shapep next)
                                 (member-eq (fn-hrcur-field 0 next) '(:codec :finish))
                                 (fn-hpb-ready fn-hpb))))
            (mv-let (again ignored held fn-hpb) (fn-hpe-tick next fn-hpb)
              (declare (ignore ignored))
              (let* ((same (and antecedent (equal again :page-full) (equal held next)
                                (equal (fn-hpb-prefix fn-hpb) first)))
                     (fn-hpb (fn-hpb-begin 'epoch 'lease fn-hpb)))
                (mv-let (done bytes final fn-hpb) (hpet-run 50000 held fn-hpb)
                  (mv (and (equal v :page-full) same (equal done :prepared)
                           (equal bytes (len (fn-scc-encode row)))
                           (fn-hpe-invariantp final)
                           (equal (append first (fn-hpb-prefix fn-hpb))
                                  (fn-hp-pack8 (ceiling (len (fn-hp-pe row)) 8)
                                               (fn-hp-pe row)))) fn-hpb)))))))
      ok)))
(assert-event (hpet-page-resume))

(defun hpet-before-boundary (fuel finish c fn-hpb)
  (declare (xargs :stobjs fn-hpb :verify-guards nil))
  (if (or (zp fuel)
          (if finish (equal (fn-hrcur-field 0 c) :finish)
            (and (equal (fn-hrcur-field 0 c) :codec)
                 (equal (fn-hrcur-field 2 c) 7)
                 (equal (car (mv-list 3 (fn-hrcur-byte-tick (fn-hrcur-field 1 c)))) :emit))))
      (mv c fn-hpb)
    (mv-let (v summary next fn-hpb) (fn-hpe-tick c fn-hpb)
      (declare (ignore v summary))
      (hpet-before-boundary (1- fuel) finish next fn-hpb))))

(defun hpet-boundary (finish row)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn-hpb
    (mv-let (ok fn-hpb)
      (let ((fn-hpb (fn-hpb-begin 'epoch 'lease fn-hpb)))
        (mv-let (c fn-hpb)
          (hpet-before-boundary 200 finish (fn-hpe-begin (list :resident row) 'epoch 'lease) fn-hpb)
          (let* ((k (fn-hrcur-field 2 c))
                 (prefix (take k (fn-scc-encode row)))
                 (prior (fn-hpb-prefix fn-hpb))
                 (byte-result (mv-list 3 (fn-hrcur-byte-tick (fn-hrcur-field 1 c))))
                 (antecedent
                  (and (fn-hpe-shapep c)
                       (equal (fn-hrcur-field 0 c) (if finish :finish :codec))
                       (natp (fn-hpb-used fn-hpb)) (< (fn-hpb-used fn-hpb) 2048)
                       (equal k (len prefix))
                       (equal (fn-hrcur-field 3 c) (adt-unle k prefix))
                       (if finish (< 0 k)
                         (and (equal k 7) (equal (car byte-result) :emit)
                              (fn-scc-octetp (nth 1 byte-result))
                              (< (+ 1 (fn-hrcur-field 4 c)) 18446744073709551616)))))
                 (wrong-prefix (cons (+ 1 (car prefix)) (cdr prefix)))
                 (wrong-word
                  (car (fn-hp-pack8 1 (append wrong-prefix
                       (if finish (adt-zeros (- 8 k)) (list (nth 1 byte-result)))))))
                 (expected
                  (car (fn-hp-pack8 1 (append prefix
                       (if finish (adt-zeros (- 8 k)) (list (nth 1 byte-result))))))))
            (mv-let (v summary next fn-hpb) (fn-hpe-tick c fn-hpb)
              (declare (ignore summary next))
              (mv (and antecedent (equal v (if finish :prepared :continue))
                       (equal (fn-hpb-prefix fn-hpb) (append prior (list expected)))
                       ; Source-attribution removal: same retained phase, byte,
                       ; capacity and prefix length; accumulator premise fails.
                       (equal (len wrong-prefix) k)
                       (not (equal (fn-hrcur-field 3 c) (adt-unle k wrong-prefix)))
                       (not (equal (fn-hpb-prefix fn-hpb) (append prior (list wrong-word))))) fn-hpb)))))
      ok)))
(assert-event (hpet-boundary nil "hello"))
(assert-event (hpet-boundary t '(1 2 3)))

; Corrupted terminal state: the sole total-preservation premise is false,
; and the actual prepared result is not its unconsumed logical byte total.
(defthm hpet-total-invariant-removal
  (let* ((codec (fn-hrcur-byte-begin '(:resident t) 'epoch 'lease))
         (c (list :prepared codec 0 0 0 'epoch 'lease))
         (s (create-fn-hpb)))
    (and (not (fn-hpe-invariantp c))
         (equal (mv-nth 0 (fn-hpe-tick c s)) :prepared)
         (not (equal (mv-nth 1 (fn-hpe-tick c s)) (fn-hpe-total c)))))
  :rule-classes nil)

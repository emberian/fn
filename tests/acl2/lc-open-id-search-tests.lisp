; ID-5 runs through the model's real adoption and tail/owner entry point.
; The finite family covers half-published rollover ids, both PGS modes,
; allocator exhaustion, and read-outcome prefixes.
(in-package "ACL2")
(include-book "lc-open-fixtures")
(include-book "../../books/log-checkpoint-open")
(include-book "../../books/log-checkpoint-publication-witnesses")
(include-book "../../books/log-checkpoint-selection-proof")

(defun lco-id5-grounded-check (code fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((input (lco-id5-input code)) (disk (fn-lc-at 0 input))
        (mode (fn-lc-at 1 input)) (configs (fn-lc-at 2 input)) (segs (fn-lc-at 3 input))
        (beforep (fn-lbc-p fn-lbc)))
   (mv-let (answer fn-lbc after-disk after-segs trace owner)
     (fn-lc-open disk :lc mode configs 8 4 segs (fn-lc-at 4 input) fn-lbc)
     (declare (ignore after-disk trace owner))
     (let ((h (fn-lc-replayed-header disk :lc mode segs)))
      (mv (implies (and beforep (fn-lc-segsp segs) (equal answer :ok))
             (and (fn-lc-header-ids-coverp h after-segs nil)
                  (mbe :logic (<= (fn-lc-header-next-id (fn-lc-adopted-header disk :lc mode))
                                 (fn-lc-header-next-id h))
                       :exec (not (fn-ag-less (fn-lc-header-next-id h)
                                  (fn-lc-header-next-id (fn-lc-adopted-header disk :lc mode))))))) fn-lbc)))))
(defthm lco-id5-check-is-the-claim
 (equal (mv-nth 0 (lco-id5-grounded-check code fn-lbc))
  (let* ((input (lco-id5-input code)) (disk (nth 0 input))
         (mode (nth 1 input)) (configs (nth 2 input)) (segs (nth 3 input))
         (out (fn-lc-open disk :lc mode configs 8 4 segs (nth 4 input) fn-lbc))
         (h (fn-lc-replayed-header disk :lc mode segs)))
   (implies (and (fn-lbc-p fn-lbc) (fn-lc-segsp segs) (equal (mv-nth 0 out) :ok))
    (and (fn-lc-header-ids-coverp h (mv-nth 3 out) nil)
         (<= (fn-lc-header-next-id (fn-lc-adopted-header disk :lc mode))
             (fn-lc-header-next-id h))))))
 :hints (("Goal" :in-theory
   (union-theories (theory 'minimal-theory)
     '((:DEFINITION LCO-ID5-GROUNDED-CHECK)
       (:DEFINITION MV-NTH)
       (:DEFINITION NOT)
       (:DEFINITION NTH)
       (:EXECUTABLE-COUNTERPART EQUAL)
       (:EXECUTABLE-COUNTERPART ZP)
       (:REWRITE CAR-CONS)
       (:REWRITE FN-LC-AT-IS-NTH)
       (:TYPE-PRESCRIPTION FN-LC-OPEN)
       (:TYPE-PRESCRIPTION LCO-ID5-INPUT))))))

(defun lco-id5-search (code)
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-lbc
  (mv-let (result fn-lbc) (lco-id5-grounded-check code fn-lbc) result)))
(defun lco-id5-half-published-control (fn-lbc)
 (declare (xargs :stobjs fn-lbc :guard (fn-lbc-p fn-lbc) :verify-guards nil))
 (let* ((input (lco-id5-input 1)) (disk (fn-lc-at 0 input))
        (segs (fn-lc-at 3 input)) (beforep (fn-lbc-p fn-lbc)))
  (mv-let (answer fn-lbc after-disk after-segs trace owner)
    (fn-lc-open disk :lc :eager (fn-lc-at 2 input) 8 4 segs (fn-lc-at 4 input) fn-lbc)
    (declare (ignore after-disk trace owner))
    (let ((h (fn-lc-replayed-header disk :lc :eager segs))
          (old (fn-lc-adopted-header disk :lc :eager)))
     (mv (and beforep (fn-lc-segsp segs) (equal answer :ok)
              (fn-lc-header-ids-coverp h after-segs nil)
              (equal (fn-lc-header-next-id h) 2)
              (equal (fn-lc-header-next-id old) 1)
              (not (fn-lc-header-ids-coverp old after-segs nil))) fn-lbc)))))
(defun lco-id5-half-published-run ()
 (declare (xargs :guard t :verify-guards nil))
 (with-local-stobj fn-lbc
  (mv-let (result fn-lbc) (lco-id5-half-published-control fn-lbc) result)))
(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
 (assert-event (lco-id5-half-published-run)))

(verify-guards lco-id5-grounded-check :hints (("Goal" :in-theory (enable fn-ag-less))))
(verify-guards lco-id5-search)
(verify-guards lco-id5-half-published-control)

(verify-guards lco-id5-half-published-run)

(in-package "ACL2")
(include-book "substrate-commit-profile-codec-tests")
(include-book "crypto-seam-tests")
(include-book "../../books/codec-attach")
(include-book "../../books/substrate-profile-entry")
(defun fn-stpet-call (cursor)
 (declare (xargs :guard t))
 (mv-let (w c e u) (fn-stpe-resume cursor) (list w c e u)))
; Toy statement attachment supplies a literal carrier; no signature claim.
(make-event (list 'defconst '*stpet-statement*
 (list 'quote (fn-stmt-sign (make-list 32 :initial-element 11)
                          (make-list 32 :initial-element 2) 0 1 nil :policy *stcpt-wire*))))
(make-event (list 'defconst '*stpet-start*
 (list 'quote (fn-stpe-start *stcpt-profile* "fn.test" *stpet-statement*))))
(defun fn-stpet-finish (cursor fuel)
 (declare (xargs :guard (natp fuel) :measure (nfix fuel)))
 (mv-let (word next envelope used) (fn-stpe-resume cursor)
  (if (or (zp fuel) (not (equal word :yield)))
      (list word next envelope used)
    (fn-stpet-finish next (1- fuel)))))
(assert-event
 (and (fn-stmt-p *stpet-statement*)
      (equal (fn-stmt-payload *stpet-statement*) *stcpt-wire*)
      (mv-let (w c e u) (fn-stpe-resume *stpet-start*)
       (mv-let (wm cm em um) (fn-stpe-resume-model *stpet-start*)
        (equal (list w c e u) (list wm cm em um))))
      (equal (nth 0 (fn-stpet-call *stpet-start*)) :yield)
      (equal (nth 3 (fn-stpet-call *stpet-start*)) 17)))
(assert-event
 (let* ((r (fn-stpet-finish *stpet-start* 100)) (c (nth 1 r)))
  (and (equal (car r) :done)
       (equal (nth 2 r)
              (list :fn-stpe-envelope *stcpt-profile* "fn.test"
                    *stpet-statement* *stcpt-commit*))
       (equal (fn-stcp-at 3 c) *stpet-statement*)
       (equal (nth 0 (fn-stpet-call c)) :done)
       (equal (nth 2 (fn-stpet-call c)) (nth 2 r))
       (equal (nth 3 (fn-stpet-call c)) 0))))
(assert-event
 (let* ((start (fn-stpe-start (fn-stcp-profile 585 513 17)
                            "fn.test" *stpet-statement*))
        (r (fn-stpet-finish start 100)))
  (and (equal (car r) :refused)
       (equal (nth 2 r) (fn-stmt-error :profile-limit))
       (equal (fn-stcp-at 3 (nth 1 r)) *stpet-statement*))))
(make-event (list 'defconst '*stpet-article*
 (list 'quote (fn-stmt-sign (make-list 32 :initial-element 11)
                          (make-list 32 :initial-element 2)
                          0 1 nil :article *stcpt-wire*))))
(assert-event
 (let* ((start (fn-stpe-start *stcpt-profile* "fn.test" *stpet-article*))
        (r (fn-stpet-call start)))
  (and (fn-stmt-p *stpet-article*)
       (equal (car r) :refused)
       (equal (nth 2 r) (fn-stmt-error :not-policy))
       (equal (nth 3 r) 0)
       (equal (fn-stcp-at 3 (nth 1 r)) *stpet-article*))))
(assert-event
 (let* ((start (fn-stpe-start (fn-stcp-profile 586 513 0)
                            "fn.test" *stpet-statement*))
        (r (fn-stpet-call start)))
  (and (equal (car r) :refused)
       (equal (nth 2 r) (fn-stmt-error :invalid-quantum))
       (equal (nth 3 r) 0)
       (equal (fn-stcp-at 3 (nth 1 r)) *stpet-statement*))))

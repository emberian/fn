; Reuse the explicitly unfunded registered source fixture, not a native grant.
(in-package "ACL2")
(include-book "bp-checkpoint-prefix-registered-tests")
(include-book "../../books/bp-checkpoint-prefix-registered-driver")
(set-verify-guards-eagerness 0)
(defun bppiod-local ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-bp-controller-registry
  (mv-let (answer fn-bp-controller-registry)
   (mv-let (token job current fn-bp-controller-registry)
    (bppio-seed fn-bp-controller-registry)
    (declare (ignore job))
    (mv-let (low ignored low-left fn-bp-controller-registry)
     (fn-owner-bp-checkpoint-prefix-next '(:bp-controller 2 0) 2 fn-bp-controller-registry)
     (declare (ignore ignored))
     (mv-let (prepared action left fn-bp-controller-registry)
      (fn-owner-bp-checkpoint-prefix-next '(:bp-controller 2 0) 6 fn-bp-controller-registry)
      (mv-let (busy busy-action busy-left fn-bp-controller-registry)
       (fn-owner-bp-checkpoint-prefix-next '(:bp-controller 2 0) 6 fn-bp-controller-registry)
       (declare (ignore busy-left))
       (mv-let (read actual-token frozen claim payload phase revision remaining)
        (fn-bpcc-pending-capture '(:bp-controller 2 0) 4 fn-bp-controller-registry)
        (declare (ignore phase remaining))
        (mv (and (equal low :yield) (equal low-left 2)
                 (equal prepared :action-prepared) (equal left 3)
                 (equal action (list :bp-checkpoint-io-action token 2 :open 0 nil))
                 (equal busy :busy) (null busy-action)
                 (equal read :checkpoint-current) (equal actual-token token)
                 (equal frozen current) (equal claim '(8192 4096 1 1 1))
                 (equal revision 2) (equal (fn-bpck-control-action payload) action))
            fn-bp-controller-registry)))))) answer)))
(assert-event (bppiod-local))

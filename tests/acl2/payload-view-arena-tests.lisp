(in-package "ACL2")
(include-book "../../books/payload-view-arena")
(defun pvla-fixture ()
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn-arena
    (mv-let (evidence fn-arena)
      (let* ((fn-arena (fn-arena-seal-list '(1 2 3) fn-arena))
             (old (fn-arena-payload 0 fn-arena))
             (a (fn-pvl-acquire (fn-pvl-seed) (fn-arena-count fn-arena) 0 '(:maintenance 0 0 0)))
             (token (fn-omk-at 1 a)) (live (fn-omk-at 2 a)))
        (mv-let (refusal fn-arena) (fn-pvl-clear live fn-arena)
          (let* ((kept (and (equal (fn-arena-count fn-arena) 1)
                            (equal old (fn-arena-payload 0 fn-arena))))
                 (fn-arena (fn-arena-seal-list '(4 5) fn-arena))
                 (append-kept (and (equal (fn-arena-count fn-arena) 2)
                                  (equal old (fn-arena-payload 0 fn-arena))))
                 (quiet (fn-omk-at 2 (fn-pvl-release live token :joined))))
            (mv-let (reset fn-arena) (fn-pvl-clear quiet fn-arena)
              (mv (list (eq (car (fn-pvl-reset live)) :reset)
                        kept (not (equal old nil))
                        (eq (car (fn-pvl-reset quiet)) :reset)
                        (not append-kept) (equal (fn-arena-count fn-arena) 0)
                        (eq (car refusal) :refused) (eq (car reset) :reset)
                        append-kept) fn-arena)))))
      evidence)))
(defconst *pvla-result* (pvla-fixture))
; Finite concrete arena witness: unchanged count and every captured payload.
(assert-event (and (not (nth 0 *pvla-result*)) (nth 1 *pvla-result*)
                   (nth 6 *pvla-result*)))
; Actual accepted clear has zero payloads after the previously nonempty arena.
(assert-event (and (nth 3 *pvla-result*) (nth 5 *pvla-result*)
                   (nth 7 *pvla-result*)))
; Literal removal of refusal premise: reset allowed and old arena changes.
(assert-event (and (nth 3 *pvla-result*) (not (nth 4 *pvla-result*))
                   (nth 5 *pvla-result*)))
; Literal removal of accepted-reset premise: live view keeps nonempty arena.
(assert-event (and (not (nth 0 *pvla-result*)) (nth 1 *pvla-result*)
                   (nth 2 *pvla-result*)))
; Actual append between capture and cleanup preserves captured payload0.
(assert-event (nth 8 *pvla-result*))

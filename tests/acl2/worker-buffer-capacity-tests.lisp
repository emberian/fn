(in-package "ACL2")
(include-book "../../books/worker-buffer-capacity")
(defconst *wbc-base* (fn-prl-build '(8192 0 0 0 8) '(0 0 0 0 0) 0 nil '(512 0 0 0 0)))
(defconst *wbc-issued* (mv-list 3 (fn-wbc-admit 0 '(4096 0 0 0 1) *wbc-base*)))
(defconst *wbc-token* (nth 1 *wbc-issued*))
(defconst *wbc-held* (nth 2 *wbc-issued*))
(assert-event (and (equal (nth 0 *wbc-issued*) :admitted)
                   (fn-wbc-tokenp *wbc-token*)
                   (equal (fn-prl-nth 1 *wbc-held*) '(4096 0 0 0 1))
                   (equal (fn-prl-baseline *wbc-held*) '(512 0 0 0 0))
                   (equal (mv-list 3 (fn-wbc-admit 0 '(4096 0 0 0 1) *wbc-held*))
                          (list :invalid-capacity-request nil *wbc-held*))))
(defconst *wbc-promoted* (mv-list 2 (fn-wbc-promote-installed *wbc-token* *wbc-held*)))
(defconst *wbc-installed* (nth 1 *wbc-promoted*))
(assert-event (and (equal (nth 0 *wbc-promoted*) :installed)
                   (fn-iqr-resident-promotion-domainp *wbc-held* '(4096 0 0 0 0))
                   (equal (fn-prl-baseline *wbc-installed*) '(4608 0 0 0 0))
                   (equal (fn-prl-nth 1 *wbc-installed*) '(0 0 0 0 1))
                   (equal (fn-iqr-resident-total *wbc-installed*) (fn-iqr-resident-total *wbc-held*))
                   (equal (fn-prl-nth 2 *wbc-installed*) 1)
                   (fn-wbc-slot-heldp 0 (fn-prl-nth 3 *wbc-installed*))))
(assert-event (and (equal (mv-list 2 (fn-wbc-promote-installed *wbc-token* *wbc-installed*))
                          (list :stale-capacity *wbc-installed*))
                   (equal (mv-list 2 (fn-wbc-promote-installed '(:worker-capacity 0 1) *wbc-held*))
                          (list :stale-capacity *wbc-held*))
                   (equal (mv-list 3 (fn-wbc-admit 1 '(4096 0 0 0 1) *wbc-installed*))
                          (list :read-resources-unavailable nil *wbc-installed*))))
(assert-event (and (equal (mv-list 2 (fn-prl-settle *wbc-held* *wbc-token* nil))
                          (list :stale *wbc-held*))
                   (equal (mv-list 2 (fn-prl-settle *wbc-installed* *wbc-token* nil))
                          (list :stale *wbc-installed*))
                   (equal (mv-list 2 (fn-prl-evict *wbc-installed* *wbc-token*))
                          (list :stale *wbc-installed*))))

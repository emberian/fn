(defthm fn-psc-source-date-capture-bound-removal-literal
 (let* ((incoming (fn-inj-date-line nil)) (held nil)
        (c (fn-psc-set date 8 (fn-psc-begin :source-incoming 8 "<a@b>" '(:agent 0 0) 8)))
        (d (fn-psc-model-source-date-complete 0 :source-optional-date c incoming held))
        (p (fn-pbb-strip-at (fn-inj-date-line (fn-psc-model-captured-date c incoming held)) 0 incoming)))
  (and (fn-psc-source-contextp c incoming held) (natp (fn-psc-get date c))
       (natp 0) (<= 0 (len incoming))
       (not (<= (+ 31 (fn-psc-get date c)) (len incoming)))
       (not (fn-psc-source-date-contextp c incoming held))
       (equal p 8) (not (fn-psc-get ok d))
       (not (iff (fn-psc-get ok d) (not (equal p :no))))))
 :rule-classes nil)

; A single physical journal frame exposes the serving range and home suffix.
(in-package "ACL2")
(include-book "lc-bounded-check-tests")
(include-book "../../books/log-checkpoint-record-frame")
(defun lcf-record-frame-control ()
 (declare (xargs :guard t :verify-guards nil))
 (let* ((h (lct-held 0))
        (frame (fn-lc-record-frame *fn-lg-genesis* h *lct-payload*))
        (off (fn-lc-record-frame-served-offset frame))
        (n (fn-lc-record-frame-served-length frame)))
   (and (fn-held-p h)
        (fn-lc-record-framep frame *fn-lg-genesis* *fn-lg-batch-payload-max*)
        (equal (fn-lc-record-frame-row frame *fn-lg-batch-payload-max*) h)
        (equal (fn-lc-take n (fn-lc-drop off frame))
               (ec-call (fn-lc-expected-range *lct-payload*)))
        (equal (fn-lc-take (- (len frame) (+ off n 32))
                         (fn-lc-drop (+ off n) frame))
               (ec-call (fn-lc-expected-home-frame h)))
        (fn-arx-entry-ok frame (- (len frame) 32)))))
(assert-event (lcf-record-frame-control))

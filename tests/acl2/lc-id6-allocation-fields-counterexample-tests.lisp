; Exact ground refutation of an existing LC local theorem after ruled M1.
(in-package "ACL2")
(include-book "lc-open-fixtures")
(include-book "../../books/log-checkpoint-open")
(include-book "../../books/log-checkpoint-independent-guards")
(defun lc17-id6-disk (two damage old-next new-next old-ex new-ex)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((base (fn-lc-at 0 (lco-id5-input 1)))
        (columns (fn-lc-cold-adopted-columns base :lc :eager))
        (h (fn-lc-cold-adopted-header base :lc :eager))
        (oh (update-nth 3 old-ex (update-nth 2 old-next h)))
        (nh (update-nth 3 new-ex (update-nth 2 new-next h)))
        (nh (if (equal damage 7) (update-nth 4 nil nh) nh))
        (old (fn-lc-proof-image-disk (fn-lc-pages columns oh)))
        (disk (if two (pgs-commit old :lc :eager
                    (fn-lc-proof-data-pages (fn-lc-pages columns nh) 0)
                    (fn-lc-publication-alloc old)) old))
        (slot (if two 1 0)) (slots (pgs-root-slots :lc disk))
        (rec (pgs-slot slot slots)) (other (pgs-slot (- 1 slot) slots))
        (pages (pgs-pages disk)) (dir (pgs-lookup (pgs-rec-dir-addr rec) pages))
        (table (pgs-flatten (pgs-contents dir pages)))
        (address (case damage (1 (pgs-rec-dir-addr rec))
                   (2 (fn-lc-head (fn-lc-head dir)))
                   (3 (fn-lc-head (fn-lc-head table)))
                   (otherwise (fn-lc-head (fn-lc-at 3 table))))))
  (cond ((equal damage 6)
          (cons pages (list (cons :lc (if two (cons other '(:torn)) (cons '(:torn) other))))))
        ((member-equal damage '(1 2 3 4))
          (cons (cons (cons address '(:damaged)) pages) (pgs-roots disk)))
        ((equal damage 5)
          (let* ((entry (fn-lc-at 1 table))
                 (table (update-nth 1 (update-nth 2 (+ 1 (nfix (fn-lc-at 2 entry))) entry) table))
                 (dir (cons (update-nth 2 (pgs-digest table) (fn-lc-head dir)) (fn-lc-rest dir)))
                 (rec (pgs-make-rec (pgs-rec-txid rec) (pgs-rec-dir-addr rec)
                                     (pgs-rec-npages rec) (pgs-digest dir)))
                 (pages (cons (cons (fn-lc-head (fn-lc-head dir)) table)
                              (cons (cons (pgs-rec-dir-addr rec) dir) pages))))
            (cons pages (list (cons :lc (if two (cons other rec) (cons rec other)))))))
        (t disk))))
(defun lc17-allocation-fields-statement (disk r mode segs)
 (declare (xargs :guard t :verify-guards nil))
 (and (equal (fn-lc-header-next-id (fn-lc-replayed-header disk r mode segs))
             (fn-lc-header-next-id (fn-lc-allocation-header (fn-lc-cold-adopted-header disk r mode) segs)))
      (equal (fn-lc-header-exhaustedp (fn-lc-replayed-header disk r mode segs))
             (fn-lc-header-exhaustedp (fn-lc-allocation-header (fn-lc-cold-adopted-header disk r mode) segs)))))
(defun lc17-allocation-fields-observation (damage old-next new-next old-ex new-ex)
 (declare (xargs :guard t :verify-guards nil))
 (let* ((disk (lc17-id6-disk t damage old-next new-next old-ex new-ex))
        (r :lc) (mode :eager) (segs (fn-lc-at 3 (lco-id5-input 1)))
        (cold (fn-lc-cold-adopted-header disk r mode))
        (allocated (fn-lc-allocation-header cold segs))
        (replayed (fn-lc-replayed-header disk r mode segs))
        (recs (fn-lc-examined-records disk r)) (pages (pgs-pages disk)))
  (list (fn-lc-at 1 (fn-lc-cold-select disk r mode))
        (fn-lc-header-next-id cold) (fn-lc-header-next-id allocated)
        (fn-lc-records-max-next-id recs pages) (fn-lc-header-next-id replayed)
        (fn-lc-header-exhaustedp allocated) (fn-lc-header-exhaustedp replayed)
        (fn-lc-records-next-ids-known-p recs pages)
        (lc17-allocation-fields-statement disk r mode segs))))
(encapsulate ()
 (local (defattach pgs-digest fn-lc-proof-digest))
 ; Positive control: no rejected candidate's allocation floor exceeds reconciliation.
 (with-guard-checking-event :none
  (assert-event (equal (lc17-allocation-fields-observation 0 1 1 nil nil)
                      '(1 1 2 1 2 nil nil t t))))
 ; Required SAT-2 fixture: old1/new100, new control damaged, physical IDs 0/1.
 ; This falsifies the EXACT old local theorem, not an edited claim.
 (with-guard-checking-event :none
  (assert-event (equal (lc17-allocation-fields-observation 4 1 100 nil nil)
                      '(0 1 2 100 100 nil nil t nil))))
 ; Exhaustion is independently false even when the next-id equality holds.
 (with-guard-checking-event :none
  (assert-event (equal (lc17-allocation-fields-observation 4 18446744073709551615
                         18446744073709551615 nil t)
                      '(0 18446744073709551615 18446744073709551615
                          18446744073709551615 18446744073709551615 nil t t nil))))
 (with-guard-checking-event :none
  (value-triple (lc17-allocation-fields-observation 4 1 100 nil nil)))
 (with-guard-checking-event :none
  (value-triple (lc17-allocation-fields-observation 4 18446744073709551615
                         18446744073709551615 nil t))))

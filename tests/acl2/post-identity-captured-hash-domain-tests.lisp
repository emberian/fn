; mutated-logical-octet: every other domain, entry/product and exact control premise remains.
(defthm pic-hdt-domain-removal-mutated-logical-octet
 (let* ((incoming (update-nth (1- (len *pic-test-stamped*)) 256 *pic-test-stamped*)) (held *pic-cht-held*) (limit 0)
        (c (pic-hdt-source incoming held))
        (a (mv-nth 1 (fn-pic-feed-funded c :control 1)))
        (b (mv-nth 1 (fn-pic-next c 1 incoming))))
  (and (pic-hdt-entryp c incoming held) (fn-pic-choice-productp c incoming held)
       (fn-pic-choice-observationp c :control incoming held)
       (not (fn-b3-octet-listp incoming))
       (natp limit)
       (<= limit 63)
       (<= (pgs-dcb-word-count (len incoming)) (* 128 (expt 2 limit)))
       (equal (fn-pic-get phase a) :digest-begin) (equal (fn-pic-get phase b) :digest-begin)
       (not (pic-hdt-outcomep limit a incoming held)) (not (pic-hdt-outcomep limit b incoming held))))
 :rule-classes nil :hints (("Goal" :in-theory (enable pic-hdt-outcomep fn-pic-digest-trajectoryp))))

; negative-limit: every other domain, entry/product and exact control premise remains.
(defthm pic-hdt-domain-removal-negative-limit
 (let* ((incoming *pic-test-stamped*) (held *pic-cht-held*) (limit -1)
        (c (pic-hdt-source incoming held))
        (a (mv-nth 1 (fn-pic-feed-funded c :control 1)))
        (b (mv-nth 1 (fn-pic-next c 1 incoming))))
  (and (pic-hdt-entryp c incoming held) (fn-pic-choice-productp c incoming held)
       (fn-pic-choice-observationp c :control incoming held)
       (fn-b3-octet-listp incoming)
       (not (natp limit))
       (<= limit 63)
       (<= (pgs-dcb-word-count (len incoming)) (* 128 (expt 2 limit)))
       (equal (fn-pic-get phase a) :digest-begin) (equal (fn-pic-get phase b) :digest-begin)
       (not (pic-hdt-outcomep limit a incoming held)) (not (pic-hdt-outcomep limit b incoming held))))
 :rule-classes nil :hints (("Goal" :in-theory (enable pic-hdt-outcomep fn-pic-digest-trajectoryp))))


(in-package "ACL2")
(include-book "../../books/post-identity-captured-hash-domain")
(include-book "post-identity-captured-hash-choice-tests")
(defun pic-hdt-source (incoming held)
 (declare (xargs :verify-guards nil))
 (pic-test-drive (pic-cht-start incoming held) incoming held 6))
(defun pic-hdt-entryp (c incoming held)
 (or (and (fn-pic-choice-contextp c incoming held) (equal (fn-pic-get phase c) :tomb-flag))
     (fn-pic-choice-productp c incoming held)))
(defun-nx pic-hdt-outcomep (limit c incoming held)
 (and (fn-pic-choice-outcomep c incoming held)
      (fn-pic-digest-trajectoryp limit c incoming (create-pgs-digest-state))))
(defthm pic-hdt-feedback-whole-positive
 (let* ((incoming *pic-test-stamped*) (held (update-nth 8 0 *pic-cht-held*)) (limit 0)
        (c (pic-cht-flag incoming held))
        (obs (pic-cht-observation c 0))
        (next (mv-nth 1 (fn-pic-feed-funded c obs 1))))
  (and (pic-hdt-entryp c incoming held)
       (fn-pic-choice-observationp c obs incoming held)
       (fn-b3-octet-listp incoming)
       (natp limit)
       (<= limit 63)
       (<= (pgs-dcb-word-count (len incoming)) (* 128 (expt 2 limit)))
       (equal (fn-pic-get phase next) :digest-begin)
       (pic-hdt-outcomep limit next incoming held)
       (equal (fn-pic-get digest-base next) 9))) :rule-classes nil
 :hints (("Goal" :in-theory (enable pic-hdt-outcomep fn-pic-digest-trajectoryp))))

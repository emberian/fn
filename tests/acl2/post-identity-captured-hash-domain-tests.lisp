; unsupported-whole-extent: every other domain, entry/product and exact control premise remains.
(defthm pic-hdt-domain-removal-unsupported-whole-extent
 (let* ((incoming (append *pic-test-stamped* (make-list 1025 :initial-element 97))) (held *pic-cht-held*) (limit 0)
        (c (pic-hdt-source incoming held))
        (a (mv-nth 1 (fn-pic-feed-funded c :control 1)))
        (b (mv-nth 1 (fn-pic-next c 1 incoming))))
  (and (pic-hdt-entryp c incoming held) (fn-pic-choice-productp c incoming held)
       (fn-pic-choice-observationp c :control incoming held)
       (fn-b3-octet-listp incoming)
       (natp limit)
       (<= limit 63)
       (not (<= (pgs-dcb-word-count (len incoming)) (* 128 (expt 2 limit))))
       (equal (fn-pic-get phase a) :digest-begin) (equal (fn-pic-get phase b) :digest-begin)
       (not (pic-hdt-outcomep limit a incoming held)) (not (pic-hdt-outcomep limit b incoming held))))
 :rule-classes nil :hints (("Goal" :in-theory (enable pic-hdt-outcomep fn-pic-digest-trajectoryp))))

; Corrupted skipped mismatch falsifies both carried entry predicates with all domains retained.
(defthm pic-hdt-product-removal-corrupted-skipped-prefix
 (let* ((incoming *pic-test-stamped*) (held (update-nth 147 100 *pic-cht-held*)) (limit 0)
        (c (fn-pic-set pos 3 (pic-cht-start incoming held)))
        (a (mv-nth 1 (fn-pic-feed-funded c :control 1))) (b (mv-nth 1 (fn-pic-next c 1 incoming))))
  (and (not (pic-hdt-entryp c incoming held)) (not (fn-pic-choice-productp c incoming held))
       (fn-pic-choice-observationp c :control incoming held)
       (fn-b3-octet-listp incoming) (natp limit) (<= limit 63)
       (<= (pgs-dcb-word-count (len incoming)) (* 128 (expt 2 limit)))
       (equal (fn-pic-get phase a) :digest-begin) (equal (fn-pic-get phase b) :digest-begin)
       (not (pic-hdt-outcomep limit a incoming held)) (not (pic-hdt-outcomep limit b incoming held))))
 :rule-classes nil :hints (("Goal" :in-theory (enable pic-hdt-outcomep fn-pic-digest-trajectoryp))))
; Mutated incoming observation keeps typed/token validity and full carried product/domain.
(defthm pic-hdt-observation-removal-mutated-agent-byte
 (let* ((incoming *pic-test-stamped*) (held *pic-cht-held*) (limit 0)
        (c (pic-test-drive (pic-cht-start incoming held) incoming held 5))
        (obs (list :incoming-byte (fn-pic-get incoming-token c) (fn-pic-at 1 (fn-pic-demand c)) 100))
        (next (mv-nth 1 (fn-pic-feed-funded c obs 1))))
  (and (pic-hdt-entryp c incoming held) (fn-pic-observation-okp c (fn-pic-demand c) obs)
       (not (fn-pic-choice-observationp c obs incoming held))
       (fn-b3-octet-listp incoming) (natp limit) (<= limit 63)
       (<= (pgs-dcb-word-count (len incoming)) (* 128 (expt 2 limit)))
       (equal (fn-pic-get phase next) :digest-begin) (not (pic-hdt-outcomep limit next incoming held))))
 :rule-classes nil :hints (("Goal" :in-theory (enable pic-hdt-outcomep fn-pic-digest-trajectoryp))))

; Actual directory metadata phase, not a native qualification witness.
(in-package "ACL2")
(include-book "../../books/history-image-canonical-refinement")
(include-book "history-image-writer-refinement-tests")

(local (defun hpic-test-until-directory (fuel stop c observation ledger pages spools rows source pool key
                    fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
  (declare (xargs :stobjs (fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
                  :verify-guards nil :measure (nfix fuel)
                  :hints (("Goal" :in-theory (disable fn-hpi-tick fn-hpi-offer
                     fn-omk-at hpi-test-buffer pgs-words-le-octets)))))
  (if (zp fuel)
      (mv (list :fuel c pages spools rows) fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
    (mv-let (v effect next ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
      (fn-hpi-tick c observation ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
      (let ((tag (fn-omk-at 0 effect)))
        (cond
         ((and (eq tag stop) (or (not (eq tag :read-spool)) (eq (fn-omk-at 4 effect) :table)))
          (mv (list :stopped v effect next ledger pages spools rows)
              fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state))
         ((eq v :prepared)
          (mv (list :prepared next pages spools rows) fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state))
         ((eq v :need-row)
          (mv-let (offered next)
            (fn-hpi-offer next rows source (fn-omk-at 1 effect) key)
            (if (not (eq offered :started))
                (mv (list :offer-refused offered next) fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
              (hpic-test-until-directory (1- fuel) stop next nil ledger pages spools rows source pool key
                            fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state))))
         ((member-eq v '(:funded :continue :written :row-done :need-byte :write :io))
          (let* ((rows (if (eq v :row-done) (+ 1 rows) rows))
                 (pages (if (eq tag :write-page)
                            (acons (fn-omk-at 6 effect)
                                   (hpi-test-buffer (fn-omk-at 0 (fn-omk-at 17 next))
                                                    fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb)
                                   pages) pages))
                 (spools (if (eq tag :write-spool)
                             (acons (cons (fn-omk-at 4 effect) (fn-omk-at 5 effect))
                                    (fn-omk-at 9 effect) spools) spools))
                 (obs
                   (cond
                    ((eq v :need-byte)
                     (list :supply (fn-omk-at 1 effect) (nth (fn-omk-at 1 effect) pool)))
                    ((eq tag :write-page)
                     (list :written (fn-omk-at 1 effect) (fn-omk-at 2 effect)
                           (fn-omk-at 3 effect) (fn-omk-at 9 effect) :ok))
                    ((eq tag :write-spool)
                     (list :spool-written (fn-omk-at 1 effect) (fn-omk-at 2 effect)
                           (fn-omk-at 3 effect) (fn-omk-at 4 effect) (fn-omk-at 5 effect)
                           (fn-omk-at 8 effect) :ok))
                    ((member-eq tag '(:read-stage :read-spool))
                     (let* ((offset (fn-omk-at 6 effect))
                            (bytes (if (eq tag :read-stage)
                                       (pgs-words-le-octets
                                         (cdr (assoc-equal (floor (- offset 16384) 16384) pages)))
                                     (cdr (assoc-equal (cons (fn-omk-at 4 effect)
                                                            (fn-omk-at 5 effect)) spools))))
                            (offset (if (eq tag :read-stage) (mod offset 16384) 0)))
                       (list (if (eq tag :read-stage) :image-read :spool-read)
                             (fn-omk-at 1 effect) (fn-omk-at 2 effect)
                             (fn-omk-at 3 effect) (fn-omk-at 4 effect) (fn-omk-at 5 effect)
                             (fn-omk-at 8 effect) :ok
                             (take (fn-omk-at 7 effect) (nthcdr offset bytes)))))
                    (t nil))))
            (hpic-test-until-directory (1- fuel) stop next obs ledger pages spools rows source pool key
                          fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)))
         (t (mv (list :unexpected v next effect) fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state))))))))

(local (defun hpic-test-more-directory (fuel c ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
 (declare (xargs :stobjs (fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
                 :verify-guards nil :measure (nfix fuel)
                 :hints (("Goal" :in-theory (disable fn-hpi-tick)))))
 (if (zp fuel)
  (mv :continue c ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
  (mv-let (v e c ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
   (fn-hpi-tick c nil ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
   (declare (ignore e))
   (if (eq v :continue)
    (hpic-test-more-directory (1- fuel) c ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
    (mv v c ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state))))))

(local (defun hpic-test-directory-point (mode fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
 (declare (xargs :stobjs (fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state) :verify-guards nil))
 (mv-let (admitted maintenance ledger)
  (fn-pmn-admit (fn-prl-make '(10000000 10000000 4 1 10)) 7 1 '(1000000 16384 3 1 1))
  (let ((initial (fn-hpi-begin 1 8 1 1 '(7 (9 1) 0 0) maintenance (fn-omk-at 1 maintenance)
                  10000000 "node" 17 "trail")))
   (mv-let (r fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
    (hpic-test-until-directory 50000 :read-spool initial nil ledger nil nil 0
      '(:decoded (:span 3 0 1 3)) '(0 65 66 67) (fn-hp-mkey "ABC" 17)
      fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
    (let* ((effect (nth 2 r)) (c (nth 3 r)) (ledger (nth 4 r))
           (bytes (cdr (assoc-equal (cons :table 0) (nth 6 r))))
           (digests (list (pgs-octets-be-nat bytes)))
           (observation (fn-hie-observation c effect (fn-omk-at 3 c) ledger 32 :ok bytes)))
     (mv-let (read-status read-effect c ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
      (fn-hpi-tick c observation ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
      (declare (ignore read-effect))
      (mv-let (a ae c ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
       (fn-hpi-tick c nil ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
       (declare (ignore ae))
       (mv-let (b be c ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
        (fn-hpi-tick c nil ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
        (declare (ignore be))
        (mv-let (more c ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
         (hpic-test-more-directory (if (eq mode :padding) 4 0) c ledger
            fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
        (let* ((original c)
               (c (case mode (:invariant (fn-hpi-set 21 (list :digest 0 0) c))
                             (:status (fn-hpi-set 21 nil c))
                             (:padding (fn-hpi-set 21 (list :digest 1 17) c)) (otherwise c)))
               (inv (fn-hpic-directory-invariantp c digests fn-hpb))
               (old-prefix (fn-hpb-prefix fn-hpb)) (old-used (fn-hpb-used fn-hpb))
               (target (fn-hpic-directory-model c digests))
               (word (nth (+ (* 6 (fn-hpic-meta-field 1 c)) (fn-hpic-meta-field 2 c)) target))
               (old-model (hpiw-test-full-model fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state))
               (old-ledger ledger))
         (mv-let (v e next ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
          (fn-hpi-tick c nil ledger fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state)
          (declare (ignore e))
          (let* ((next-model (hpiw-test-full-model fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state))
                 (law (and (equal (fn-hpb-prefix fn-hpb) (append old-prefix (list word)))
                           (equal ledger old-ledger)
                           (equal (take 4 next-model) (take 4 old-model))
                           (equal (nth 5 next-model) (nth 5 old-model))))
                 (next-inv (fn-hpic-directory-invariantp next digests fn-hpb))
                 (prefix-law (equal (fn-hpb-prefix fn-hpb)
                   (take (+ 1 old-used) (nthcdr (* 2048 (fn-hpic-meta-field 6 c)) target)))))
           (mv (and (eq admitted :admitted) (eq (car r) :stopped)
                    (eq (fn-omk-at 0 effect) :read-spool) (eq (fn-omk-at 4 effect) :table)
                    (eq read-status :continue) (eq a :continue) (eq b :continue) (eq more :continue)
                    (equal (fn-omk-at 0 original) :metadata)
                    (equal (fn-hpic-meta-field 0 original) :directory)
                    (equal (fn-hpic-meta-field 1 original) (if (eq mode :padding) 1 0))
                    (equal (fn-hpic-meta-field 2 original) (if (eq mode :padding) 0 2))
                    (equal old-used (if (eq mode :padding) 6 2))
                    (if (eq mode :padding)
                     (and (equal word 0)
                          (equal (fn-omk-at 1 (fn-omk-at 21 c)) (fn-hpic-meta-field 1 c))
                          (not (equal (fn-omk-at 2 (fn-omk-at 21 c)) (nth (fn-hpic-meta-field 1 c) digests))))
                     (not (equal word 0)))
                    (equal (list (if inv t nil) (equal v :continue))
                      (case mode (:invariant '(nil t)) (:status '(t nil)) (otherwise '(t t))))
                    (equal law (if (member-eq mode '(:positive :padding)) t nil))
                    (equal prefix-law (if (member-eq mode '(:positive :padding)) t nil))
                    (equal (if next-inv t nil) (if (member-eq mode '(:positive :padding)) t nil)))
               fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state))))))))))))))

(local (defun hpic-test-local-directory-point (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-hpq0 (mv-let (result fn-hpq0) (with-local-stobj fn-hpq1 (mv-let (result fn-hpq0 fn-hpq1) (with-local-stobj fn-hpq2 (mv-let (result fn-hpq0 fn-hpq1 fn-hpq2) (with-local-stobj fn-hpq3 (mv-let (result fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3) (with-local-stobj fn-hpb (mv-let (result fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb) (with-local-stobj pgs-digest-state (mv-let (result fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state) (hpic-test-directory-point mode fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb pgs-digest-state) (mv result fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3 fn-hpb))) (mv result fn-hpq0 fn-hpq1 fn-hpq2 fn-hpq3))) (mv result fn-hpq0 fn-hpq1 fn-hpq2))) (mv result fn-hpq0 fn-hpq1))) (mv result fn-hpq0))) result))))

; Actual reachable complete directory-word/prefix positive.
(local (assert-event (hpic-test-local-directory-point :positive)))

; Corrupt only current cached digest; continuation remains true.
(local (assert-event (hpic-test-local-directory-point :invariant)))

; Remove cached availability: actual query yields IO, canonical invariant remains true.
(local (assert-event (hpic-test-local-directory-point :status)))

; Labelled padding-cache mutation: a matching irrelevant cached ordinal
; disagrees with nth beyond the active digest list. The weakened carried
; invariant and complete actual continuation conclusion both remain true.
(local (assert-event (hpic-test-local-directory-point :padding)))

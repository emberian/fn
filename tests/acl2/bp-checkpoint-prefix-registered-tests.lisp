; Actual registered I/O continuation refuter. Raw storage/claim setup is
; explicitly unfunded and cannot authorize native factory or stage effects.
(in-package "ACL2")
(include-book "../../books/bp-checkpoint-prefix-registered")
(set-verify-guards-eagerness 0)
(defun bppio-seed (fn-bp-controller-registry)
 (declare (xargs :stobjs fn-bp-controller-registry :guard t))
 (let* ((initial (fn-bpnf-initial-state
                  (fn-bpn-config (cons :dtn '(47 47 98 112 45 108 111 99 97 108 47))
                                 3600000 2 32 1048576) 8 1048576))
        (current (fn-bpnf-with-issued initial
                   (fn-bpnf-operation (fn-bpnf-epoch initial) 0 :checkpoint 5 :pending)))
        (ledger (fn-prl-build '(1000000 100000 10 10 100) '(0 0 0 0 0)
                              7 nil '(1000 0 0 0 0)))
        (fn-bp-controller-registry (update-fn-bpcr-highwater 1 fn-bp-controller-registry)))
  (stobj-let ((fn-bpc-node (fn-bpcr-root fn-bp-controller-registry)))
   (token expected current fn-bpc-node)
   (stobj-let ((fn-bpc-segment
                 (fn-bpcn-children-get 'fn-bpc-segment fn-bpc-node (create-fn-bpc-segment))))
    (token expected current fn-bpc-segment)
    (mv-let (installed fn-bpc-segment)
     (fn-bpc-segment-install 2 0 current :unfunded-storage-only fn-bpc-segment)
     (declare (ignore installed))
     (mv-let (reserved token ignored-ledger fn-bpc-segment)
      (fn-bpcc-segment-reserve '(:bp-controller 2 0) 0 '(8192 4096 1 1 1)
                              ledger fn-bpc-segment)
      (declare (ignore reserved ignored-ledger))
      (let* ((initial-job (fn-bpck-begin token (fn-bpco-checkpoint-epoch current) 5
                    (fn-bpnr-depth-budget 8) nil nil 8 0 1048576))
             (job (fn-bpck-stage-granted (fn-bpck-census-step initial-job 10000) (list :grown token)))
             (payload (fn-bpck-control-make job (fn-bpck-io-begin job) :unfunded-digest-binding nil)))
       (mv-let (updated fn-bpc-segment)
        (fn-bpcc-segment-payload-replace token 0 0 :reserved :running payload fn-bpc-segment)
        (declare (ignore updated))
        (mv token job current fn-bpc-segment)))))
    (mv token expected current fn-bpc-node))
   (mv token expected current fn-bp-controller-registry))))

(defun bppio-run (token job current fn-bp-controller-registry)
 (declare (xargs :stobjs fn-bp-controller-registry :guard t))
 (mv-let (prepared open left fn-bp-controller-registry)
  (fn-bpck-registered-prefix-next '(:bp-controller 2 0) 1 4 fn-bp-controller-registry)
  (mv-let (stale stale-left fn-bp-controller-registry)
   (fn-bpck-registered-prefix-observe '(:bp-controller 2 0) token 1 :ok 4 fn-bp-controller-registry)
   (declare (ignore stale-left))
   (mv-let (observed obs-left fn-bp-controller-registry)
    (fn-bpck-registered-prefix-observe '(:bp-controller 2 0) token 2 :ok 4 fn-bp-controller-registry)
    (declare (ignore obs-left))
    (mv-let (emitted emit emit-left fn-bp-controller-registry)
     (fn-bpck-registered-prefix-next '(:bp-controller 2 0) 3 4 fn-bp-controller-registry)
     (declare (ignore emit-left))
     (mv-let (uncertain unknown-left fn-bp-controller-registry)
      (fn-bpck-registered-prefix-observe '(:bp-controller 2 0) token 4 :unknown 4 fn-bp-controller-registry)
      (declare (ignore unknown-left))
      (mv-let (read actual-token frozen claim payload phase revision read-left)
       (fn-bpcc-pending-capture '(:bp-controller 2 0) 4 fn-bp-controller-registry)
       (declare (ignore phase read-left))
       (mv (and (equal prepared :action-prepared) (equal left 2)
                (equal open (list :bp-checkpoint-io-action token 2 :open 0 nil))
                (equal stale :stale-checkpoint-observation) (equal observed :observed)
                (equal emitted :action-prepared)
                (equal (fn-bpn-nth 3 emit) :emit)
                (equal (fn-bpn-nth 2 emit) 4)
                (equal (fn-bpn-nth 5 emit) (fn-bpn-nth 1 (fn-bpck-emit-step job)))
                (<= (len (fn-bpn-nth 5 emit)) 9)
                (equal uncertain :uncertain) (equal revision 5)
                (equal read :checkpoint-current) (equal actual-token token)
                (equal frozen current) (equal claim '(8192 4096 1 1 1))
                (equal (fn-bpn-nth 11 (fn-bpck-control-job payload)) :uncertain)
                (equal (fn-bpck-control-io payload) '(:close :uncertain))
                (null (fn-bpck-control-action payload))) fn-bp-controller-registry))))))))
(defun bppio-local ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn-bp-controller-registry
  (mv-let (answer fn-bp-controller-registry)
   (mv-let (token job current fn-bp-controller-registry)
    (bppio-seed fn-bp-controller-registry)
    (bppio-run token job current fn-bp-controller-registry)) answer)))
(assert-event (bppio-local))

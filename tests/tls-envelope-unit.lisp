; The actual native result wrapper and post checker agree on a nonempty seed.
(in-package "ACL2")
(include-book "../sim/check-envelope")
(include-book "../books/assembly-init")

(defun fn2-tls-envelope-run (status mutant fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      ((mv code rs rg fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
      ((unless (eq code :ok)) (mv :reserve fn2-core))
      ((mv ?w0 fn2-core) (fn2-core-write rs rg 0 9 1 0 1 fn2-core))
      ((mv ?w1 fn2-core) (fn2-core-write rs rg 1 10 1 0 1 fn2-core))
      ((mv ?w2 fn2-core) (fn2-core-write rs rg 2 11 1 0 1 fn2-core))
      ((mv code op og fn2-core) (fn2-issue-tls-start 0 1 rs rg 0 3 1 0 1 0 fn2-core))
      ((unless (eq code :ok)) (mv :issue fn2-core))
      (descriptor (fn2-envelope-descriptor op fn2-core))
      ((mv verdict taken caps fn2-core)
       (fn2-envelope-prefix (list (append (list :take op og) descriptor) '(:ack 1))
                            0 t nil nil fn2-core))
      ((unless (eq verdict :pass)) (mv :take-ack fn2-core))
      (success (eq status :success))
      (cancelled (eq status :cancelled))
      ; Native handoff uses :ok/LEN and :failed/0. The simulator's reset
      ; abstraction uses :handshake/0. Test both raw failure observations.
      (raw (case status (:success :ok) (:cancelled :cancelled)
                        (:native-failed :failed) (otherwise :handshake)))
      ((mv outcome reason count a0 a1)
       (fn2-host-result *fn2-action-tls-start* raw (if success 3 0) 0 3 cancelled))
      ((unless (and (equal outcome (cond (success *fn2-outcome-done*)
                                        (cancelled *fn2-outcome-cancelled*)
                                        (t *fn2-outcome-failed*)))
                    (equal reason (if (or success cancelled) *fn2-reason-none* *fn2-reason-handshake*))
                    (equal count (if success 3 0)) (equal a0 0) (equal a1 0)))
       (mv :normalizer-abi fn2-core))
      (pool-before (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (snap)
                     (fn2-pool-copy fn2-pool) snap))
      (posted-count (case mutant (:old-zero 0) (:short 2) (:excess 4) (otherwise count)))
      (post (list :post 0 op og *fn2-event-tls-result* outcome reason posted-count a0 a1
                         *fn2-peer-family-none* '(0 0 0 0 0) nil))
      ((mv verdict taken after-caps fn2-core)
       (fn2-envelope-prefix (list post) 2 t taken caps fn2-core))
      (- taken)
      (pool-after (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (snap)
                    (fn2-pool-copy fn2-pool) snap)))
  (mv (and (equal pool-before pool-after) (equal caps after-caps)
           (if mutant (equal verdict '(:post-not-allowed 2)) (eq verdict :pass))) fn2-core)))

(defun fn2-tls-envelope-control (status mutant)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (ok fn2-core) (fn2-tls-envelope-run status mutant fn2-core) ok)))
(assert-event (fn2-tls-envelope-control :success nil))
(assert-event (fn2-tls-envelope-control :native-failed nil))
(assert-event (fn2-tls-envelope-control :sim-reset nil))
(assert-event (fn2-tls-envelope-control :cancelled nil))
; The former simulator's count0 is an explicit rejected success mutant.
(assert-event (fn2-tls-envelope-control :success :old-zero))
(assert-event (fn2-tls-envelope-control :success :short))
(assert-event (fn2-tls-envelope-control :success :excess))

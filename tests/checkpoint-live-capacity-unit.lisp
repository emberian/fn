; UNEXECUTED actual metadata-operation controls. N64/source36 is constructed
; through canonical run-install, with registered schemas and size-tier plans.
; Root bytes are not populated: no served-page, NNTP-prefix, compaction-output
; or unbounded-storage completion claim follows from this capacity witness.
; The source cut itself is obtained by actual snapshot BEGIN/POLL, never seeded.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/node-profile")
(include-book "../books/checkpoint-live-capacity")
(include-book "column-snapshot-support")
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-run-installed (w state))))
(defconst *fn2-lcf-profile*
 (put-assoc-equal :identity-runs 48
  (put-assoc-equal :extent-slots 16
   (put-assoc-equal :groups nil (put-assoc-equal :authority 0 *fn2-node-profile*)))))
(assert-event (fn2-core-profilep *fn2-lcf-profile*))
(defun fn2-lcf-install (i fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix (- 36 (nfix i)))))
 (if (>= (nfix i) 36) (mv :ok fn2-core)
  (b* ((sid (+ 1 (floor i 4))) (entries (nth (mod i 4) '(27 9 3 1)))
       ((mv code fn2-core)
        (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (code fn2-run-installed)
         (mv-let (k rlo) (fn2-seal-plan sid entries fn2-run-installed fn2-pool)
          (declare (ignore rlo))
          (if (not (and (= k 0) (posp (fn2-run-layout-fields sid 0)))) (mv :plan fn2-run-installed)
           (fn2-run-install i sid (+ 1 i) 0 0 1 (+ 1 i) (+ 1 i) entries 7 0 1 fn2-run-installed)))
         (mv code fn2-core))))
   (if (not (eq code :ok)) (mv code fn2-core) (fn2-lcf-install (+ 1 i) fn2-core)))))
(defun fn2-lcf-held (fuel token kind owner generation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (b* (((mv code & & fn2-core) (fn2-csnapshot-poll token kind owner generation fn2-core)))
   (if (eq code :more) (fn2-lcf-held (- fuel 1) token kind owner generation fn2-core) (mv code fn2-core)))))
(defun fn2-lcf-scan (fuel token kind owner generation section row sources free fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel sources free fn2-core)
  (b* (((mv code next sources free fn2-core)
        (stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core)) (fn2-overlays (fn2-core-overlays fn2-core))
                    (fn2-run-installed (fn2-core-run-installed fn2-core))) (code next sources free fn2-run-installed)
         (fn2-checkpoint-live-fit-step token kind owner generation section row sources free fn2-csnapshot fn2-overlays fn2-run-installed)
         (mv code next sources free fn2-core))))
   (cond ((eq code :more) (fn2-lcf-scan (- fuel 1) token kind owner generation section next sources free fn2-core))
         ((eq code :runs) (fn2-lcf-scan (- fuel 1) token kind owner generation 1 0 sources free fn2-core))
         (t (mv code sources free fn2-core))))))
(defun fn2-lcf-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-lcf-profile* :null nil fn2-core))
      ((mv installed fn2-core) (fn2-lcf-install 0 fn2-core))
      ((unless (eq installed :ok)) (mv nil fn2-core))
      (before (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core))) (snap)
       (fn2-test-table-snapshot-fn2-run-installed fn2-run-installed) snap))
      (old (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (old)
       (mv-let (sid k rlo) (fn2-seal-compact-target fn2-run-installed fn2-pool)
        (declare (ignore sid rlo))
        (and (= (fn2-run-installed-rows fn2-run-installed) 64)
             (= (fn2-seal-free-rows 64 0 fn2-run-installed) 28)
             (not (fn2-seal-pressured-p fn2-run-installed fn2-pool)) (= k 0))) old))
      (owner (fn2-machine-kind-base *fn2-checkpoint-master-kind* fn2-core))
      (generation (fn2-machine-generation owner fn2-core))
      ((mv begun token fn2-core) (fn2-csnapshot-begin *fn2-checkpoint-master-kind* owner generation fn2-core))
      ((mv held fn2-core) (fn2-lcf-held 1000 token *fn2-checkpoint-master-kind* owner generation fn2-core))
      ((unless (and old (eq begun :ok) (eq held :held))) (mv nil fn2-core))
      ((mv code sources free fn2-core) (fn2-lcf-scan 1000 token *fn2-checkpoint-master-kind* owner generation 0 0 0 0 fn2-core))
      (after (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core))) (snap)
       (fn2-test-table-snapshot-fn2-run-installed fn2-run-installed) snap))
      ; ADOPTION-DEMAND is the last generated scalar; all actual row arrays
      ; and the physical count remain byte-for-byte in the snapshot prefix.
      (same-rows (equal (butlast before 1) (butlast after 1)))
      (pressure (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core)) (fn2-pool (fn2-core-pool fn2-core))) (yes)
       (mv-let (sid k rlo) (fn2-seal-compact-target fn2-run-installed fn2-pool)
        (declare (ignore rlo))
        (and (= (fn2-run-installed-adoption-demand fn2-run-installed) 36)
             (fn2-seal-pressured-p fn2-run-installed fn2-pool) (= sid 1) (= k 4))) yes))
      (blocked (not (fn2-sealer-ready fn2-core)))
      ((mv released fn2-core) (fn2-csnapshot-release token *fn2-checkpoint-master-kind* owner generation fn2-core))
      (grantable (fn2-sealer-ready fn2-core))
      ((mv target fn2-core) (fn2-sealer-grant fn2-core)))
  (mv (and (eq code :no-space) (= sources 36) (= free 28) same-rows pressure blocked
           (eq released :ok) grantable (= target (fn2-machine-kind-base *fn2-sealer-kind* fn2-core))) fn2-core)))
(defun fn2-lcf-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-lcf-body fn2-core) ok)))
(assert-event (fn2-lcf-test))

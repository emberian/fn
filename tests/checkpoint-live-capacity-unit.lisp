; UNEXECUTED metadata-operation control. Canonical row constructors fill R;
; bytes are not populated and no whole served/full-R publication is claimed.
; Actual snapshot BEGIN/POLL produces HELD. Canonical bank BEGIN/STEP scans
; the real inactive E rows; readonly FIT refuses before EOF and accepts only
; the retained complete receipt. Wrong-generation refusal preserves both rows
; and receipt. Requires complete bank provider/configured core prerequisites.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/node-profile")
(include-book "../books/checkpoint-live-capacity")
(include-book "column-snapshot-support")
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-run-installed (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-checkpoint-bank-admission (w state))))
(defconst *fn2-lcf-profile*
 (put-assoc-equal :identity-runs 48
  (put-assoc-equal :extent-slots 16
   (put-assoc-equal :groups nil (put-assoc-equal :authority 0 *fn2-node-profile*)))))
(defun fn2-lcf-install (i fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix (- 48 (nfix i)))))
 (if (>= (nfix i) 48) (mv :ok fn2-core)
  (b* (((mv code fn2-core)
        (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core))) (code fn2-run-installed)
         (fn2-run-install i 2 (+ 1 i) 0 0 1 (+ 1 i) (+ 1 i) 1 7 0 1 fn2-run-installed)
         (mv code fn2-core))))
   (if (eq code :ok) (fn2-lcf-install (+ 1 i) fn2-core) (mv code fn2-core)))))
(defun fn2-lcf-held (fuel token kind owner generation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (b* (((mv code & & fn2-core) (fn2-csnapshot-poll token kind owner generation fn2-core)))
   (if (eq code :more) (fn2-lcf-held (- fuel 1) token kind owner generation fn2-core) (mv code fn2-core)))))
(defun fn2-lcf-snapshot (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core))
             (fn2-checkpoint-bank-admission (fn2-core-checkpoint-bank-admission fn2-core))) (snapshot)
  (list (fn2-test-table-snapshot-fn2-run-installed fn2-run-installed)
        (fn2-test-table-snapshot-fn2-checkpoint-bank-admission fn2-checkpoint-bank-admission)) snapshot))
(defun fn2-lcf-fit (token kind owner generation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core))
             (fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
             (fn2-run-installed (fn2-core-run-installed fn2-core))
             (fn2-checkpoint-bank-admission (fn2-core-checkpoint-bank-admission fn2-core))) (fit)
  (fn2-checkpoint-live-fit-step token kind owner generation fn2-csnapshot fn2-checkpoint-summary fn2-run-installed fn2-checkpoint-bank-admission) fit))
(defun fn2-lcf-bank-op (begin token kind owner generation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core))
             (fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
             (fn2-run-installed (fn2-core-run-installed fn2-core))
             (fn2-checkpoint-bank-admission (fn2-core-checkpoint-bank-admission fn2-core))) (code fn2-checkpoint-bank-admission)
  (if begin
   (fn2-checkpoint-bank-admission-begin token kind owner generation fn2-csnapshot fn2-checkpoint-summary fn2-run-installed fn2-checkpoint-bank-admission)
   (fn2-checkpoint-bank-admission-step token kind owner generation fn2-csnapshot fn2-checkpoint-summary fn2-run-installed fn2-checkpoint-bank-admission))
  (mv code fn2-core)))
(defun fn2-lcf-scan (fuel progress token kind owner generation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel progress fn2-core)
  (b* (((mv code fn2-core) (fn2-lcf-bank-op nil token kind owner generation fn2-core)))
   (if (eq code :more) (fn2-lcf-scan (- fuel 1) (+ 1 progress) token kind owner generation fn2-core)
    (mv code progress fn2-core)))))
(defun fn2-lcf-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-lcf-profile* :null nil fn2-core))
      ((mv installed fn2-core) (fn2-lcf-install 0 fn2-core))
      ((unless (eq installed :ok)) (mv nil fn2-core))
      (rows-before (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core))) (rows)
                    (fn2-test-table-snapshot-fn2-run-installed fn2-run-installed) rows))
      (owner (fn2-machine-kind-base *fn2-checkpoint-master-kind* fn2-core))
      (generation (fn2-machine-generation owner fn2-core))
      ((mv begun token fn2-core) (fn2-csnapshot-begin *fn2-checkpoint-master-kind* owner generation fn2-core))
      ((mv held fn2-core) (fn2-lcf-held 1000 token *fn2-checkpoint-master-kind* owner generation fn2-core))
      ((unless (and (eq begun :ok) (eq held :held))) (mv nil fn2-core))
      (premature (fn2-lcf-fit token *fn2-checkpoint-master-kind* owner generation fn2-core))
      ((mv bank fn2-core) (fn2-lcf-bank-op t token *fn2-checkpoint-master-kind* owner generation fn2-core))
      (before (fn2-lcf-snapshot fn2-core))
      ((mv wrong fn2-core) (fn2-lcf-bank-op nil token *fn2-checkpoint-master-kind* owner (+ 1 generation) fn2-core))
      ((unless (and (eq wrong :source) (equal before (fn2-lcf-snapshot fn2-core)))) (mv nil fn2-core))
      ((mv ready progress fn2-core) (fn2-lcf-scan 1000 0 token *fn2-checkpoint-master-kind* owner generation fn2-core))
      (fit (fn2-lcf-fit token *fn2-checkpoint-master-kind* owner generation fn2-core))
      (same-rows (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core))) (same)
                  (equal rows-before (fn2-test-table-snapshot-fn2-run-installed fn2-run-installed)) same))
      ((mv released fn2-core) (fn2-csnapshot-release token *fn2-checkpoint-master-kind* owner generation fn2-core)))
  (mv (and (eq premature :resources) (eq bank :more) (eq ready :ready)
           (= progress 16) (eq fit :fit) same-rows (eq released :ok)) fn2-core)))
(defun fn2-lcf-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-lcf-body fn2-core) ok)))
(assert-event (fn2-lcf-test))

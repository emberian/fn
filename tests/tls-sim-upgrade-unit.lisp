; TLS seed carriage must not enter the generic simulated storage writer.
(in-package "ACL2")
(include-book "../sim/sim-adapter-base")
(include-book "../books/terminal-values")
(include-book "../books/assembly-init")

(defun fn2-tls-sim-upgrade-probe (fault corrupt fn2-core fn2-sim-network fn2-sim-storage fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim-network fn2-sim-storage fn2-own) :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      (fn2-own (fn2-own-init *fn2-profile-tiny* fn2-own))
      (fn2-sim-network (fn2-network-init 1 8 fn2-sim-network))
      (fn2-sim-storage (fn2-storage-init 1 1 fn2-sim-storage))
      ((mv ?sc fn2-sim-storage) (fn2-storage-write-byte 0 0 17 1 t nil fn2-sim-storage))
      ((mv ?fc fn2-sim-storage) (fn2-storage-fence-capture 0 fn2-sim-storage))
      ((mv ?nc nonce fn2-sim-network) (fn2-network-accept 0 fn2-sim-network))
      ((mv ?rx fn2-sim-network) (fn2-network-client-byte 0 nonce 37 fn2-sim-network))
      ((mv ?tx fn2-sim-network) (fn2-network-send-byte 0 nonce 41 fn2-sim-network))
      ((mv code rs rg fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
      ((unless (eq code :ok)) (mv :reserve fn2-core fn2-sim-network fn2-sim-storage fn2-own))
      ((mv ?w0 fn2-core) (fn2-core-write rs rg 0 9 1 0 1 fn2-core))
      ((mv ?w1 fn2-core) (fn2-core-write rs rg 1 10 1 0 1 fn2-core))
      ((mv ?w2 fn2-core) (fn2-core-write rs rg 2 11 1 0 1 fn2-core))
      ((mv code op og fn2-core) (fn2-issue-tls-start 0 nonce rs rg 0 3 1 0 1 0 fn2-core))
      ((unless (eq code :ok)) (mv :issue fn2-core fn2-sim-network fn2-sim-storage fn2-own))
      (fn2-core (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (fn2-ops)
                  (mv-let (code fn2-ops) (fn2-outbox-ack 1 fn2-ops)
                    (declare (ignore code)) fn2-ops) fn2-core))
      (fn2-own (stobj-let ((fn2-pool (fn2-core-pool fn2-core))
                          (fn2-ops (fn2-core-ops fn2-core))) (fn2-own)
                 (fn2-own-observe-issue-parts op fn2-pool fn2-ops fn2-own) fn2-own))
      ; Generated snapshots include all media/pipe bytes AND all metadata,
      ; including the staged storage columns of the current simulator.
      (disk-before (fn2-sim-storage-copy fn2-sim-storage))
      (net-before (fn2-sim-network-copy fn2-sim-network))
      (own-before (fn2-own-copy fn2-own))
      ((mv code count aux fn2-core fn2-sim-network fn2-sim-storage fn2-own)
       (fn2-sim-physical-act *fn2-action-tls-start* 0 nonce rs rg 0 3 3 1 0 1 op
         (if corrupt (+ 1 og) og) 0 2 nil fault 0 nil
         fn2-core fn2-sim-network fn2-sim-storage fn2-own))
      ((mv outcome reason observed a0 a1)
       (fn2-sim-terminal-values *fn2-action-tls-start* code count aux 3 nil nil)))
  (mv (and (equal code (if (equal fault *fn2-fault-reset*) :handshake :ok))
           (equal count (if (equal fault *fn2-fault-reset*) 0 3)) (equal aux 0)
           (equal outcome (if (equal fault *fn2-fault-reset*) *fn2-outcome-failed* *fn2-outcome-done*))
           (equal reason (if (equal fault *fn2-fault-reset*) *fn2-reason-handshake* *fn2-reason-none*))
           (equal observed (if (equal fault *fn2-fault-reset*) 0 3)) (equal a0 0) (equal a1 0)
           (equal disk-before (fn2-sim-storage-copy fn2-sim-storage))
           (equal net-before (fn2-sim-network-copy fn2-sim-network))
           (if corrupt
               (and (not (equal own-before (fn2-own-copy fn2-own))) (equal (fn2-own-error fn2-own) 1))
             (and (equal own-before (fn2-own-copy fn2-own)) (equal (fn2-own-error fn2-own) 0))))
      fn2-core fn2-sim-network fn2-sim-storage fn2-own)))

(defun fn2-tls-sim-upgrade-control (fault corrupt)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (ok fn2-core)
   (with-local-stobj fn2-sim-network
    (mv-let (ok fn2-core fn2-sim-network)
     (with-local-stobj fn2-sim-storage
      (mv-let (ok fn2-core fn2-sim-network fn2-sim-storage)
       (with-local-stobj fn2-own
        (mv-let (ok fn2-core fn2-sim-network fn2-sim-storage fn2-own)
         (fn2-tls-sim-upgrade-probe fault corrupt fn2-core fn2-sim-network fn2-sim-storage fn2-own)
         (mv ok fn2-core fn2-sim-network fn2-sim-storage)))
       (mv ok fn2-core fn2-sim-network)))
     (mv ok fn2-core)))
   ok)))
(assert-event (fn2-tls-sim-upgrade-control *fn2-fault-none* nil))
(assert-event (fn2-tls-sim-upgrade-control *fn2-fault-reset* nil))
(assert-event (fn2-tls-sim-upgrade-control *fn2-fault-none* t))
(assert-event (member-equal *fn2-fault-reset* (fn2-sim-flight-classes *fn2-action-tls-start* 1 0)))

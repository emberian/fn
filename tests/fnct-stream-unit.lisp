(in-package "ACL2")
(include-book "../books/fnct-stream")

; Official BLAKE3 6144-byte vector, fed through ONE recycled 4096-byte
; physical pool slot. The input pattern is global-position modulo 251.
(defun fn2-stream-unit-fill (i n base fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- (nfix n) (nfix i)))))
 (if (or (not (natp i)) (not (natp n)) (>= i n)) fn2-pool
  (mv-let (code fn2-pool) (fn2-pool-write 0 1 i (mod (+ base i) 251) 1 0 1 fn2-pool)
   (declare (ignore code)) (fn2-stream-unit-fill (+ i 1) n base fn2-pool))))

(defun fn2-stream-unit-trailer-fill (i fn2-digests fn2-pool)
 (declare (xargs :stobjs (fn2-digests fn2-pool) :verify-guards nil :measure (nfix (- 32 (nfix i)))))
 (if (or (not (natp i)) (>= i 32)) fn2-pool
  (mv-let (code fn2-pool)
   (fn2-pool-write 0 1 i (fn2-fc-word-byte (fn2-digest-word 137 (floor i 4) fn2-digests) (mod i 4))
                   1 0 1 fn2-pool)
   (declare (ignore code)) (fn2-stream-unit-trailer-fill (+ i 1) fn2-digests fn2-pool))))

(defun fn2-stream-unit-run (fn2-digests fn2-b3 fn2-pool)
 (declare (xargs :stobjs (fn2-digests fn2-b3 fn2-pool) :verify-guards nil))
 (b* ((fn2-digests (fn2-digests-init 144 fn2-digests))
      (fn2-b3 (fn2-b3-table-init 1 fn2-b3))
      (fn2-pool (fn2-pool-init '((1 . 4096)) 1 100 fn2-pool))
      ((mv reserve slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((mv start fn2-digests fn2-b3) (fn2-fnct-stream-start 0 fn2-digests fn2-b3))
      (fn2-pool (fn2-stream-unit-fill 0 4096 0 fn2-pool))
      ((mv first n1 fn2-digests fn2-b3)
       (fn2-fnct-stream-update 0 0 1 0 4096 1 0 1 fn2-digests fn2-b3 fn2-pool))
      ((mv reset fn2-pool) (fn2-pool-reset 0 1 1 0 1 fn2-pool))
      (fn2-pool (fn2-stream-unit-fill 0 2048 4096 fn2-pool))
      ((mv second n2 fn2-digests fn2-b3)
       (fn2-fnct-stream-update 0 0 1 0 2048 1 0 1 fn2-digests fn2-b3 fn2-pool))
      ((mv finish fn2-digests fn2-b3) (fn2-fnct-stream-finish 0 fn2-digests fn2-b3))
      ((mv reset2 fn2-pool) (fn2-pool-reset 0 1 1 0 1 fn2-pool))
      (fn2-pool (fn2-stream-unit-trailer-fill 0 fn2-digests fn2-pool))
      ((mv partial pc) (fn2-fnct-stream-trailer 0 0 0 1 0 17 1 0 1 fn2-digests fn2-pool))
      ((mv verified vc) (fn2-fnct-stream-trailer 0 17 0 1 17 32 1 0 1 fn2-digests fn2-pool))
      ((mv corrupt fn2-pool) (fn2-pool-write 0 1 31 0 1 0 1 fn2-pool))
      ((mv rejected rc) (fn2-fnct-stream-trailer 0 17 0 1 17 32 1 0 1 fn2-digests fn2-pool)))
  (mv (and (eq reserve :ok) (equal slot 0) (equal gen 1)
           (eq start :ok) (eq first :ok) (equal n1 4096) (eq reset :ok)
           (eq second :ok) (equal n2 2048) (eq finish :ok)
           (eq reset2 :ok) (eq partial :more) (equal pc 17)
           (eq verified :verified) (equal vc 15) (eq corrupt :ok)
           (eq rejected :frame) (equal rc 0)
           (equal (fn2-digest-list 137 fn2-digests)
            '(1952132670 2918402272 2854212310 2755328179 2015509325 2151397551 1683080115 94563563))) fn2-digests fn2-b3 fn2-pool)))

(defun fn2-stream-unit ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-digests
  (mv-let (ok fn2-digests)
   (with-local-stobj fn2-b3
    (mv-let (ok fn2-digests fn2-b3)
     (with-local-stobj fn2-pool
      (mv-let (ok fn2-digests fn2-b3 fn2-pool)
       (fn2-stream-unit-run fn2-digests fn2-b3 fn2-pool)
       (mv ok fn2-digests fn2-b3)))
     (mv ok fn2-digests)))
   ok)))
(assert-event (fn2-stream-unit))

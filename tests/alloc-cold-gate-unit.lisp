; Actual ordinary allocator controls for the cold gate. The phase4 owner here
; is a synthetic antecedent, not selected-source or recovery-completion evidence.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/alloc")
(defun fn2-acg-body (fn2-extents fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-extents fn2-alloc-edges) :verify-guards nil))
 (b* ((fn2-extents (fn2-alloc-init 1 fn2-extents)) (fn2-alloc-edges (fn2-alloc-edges-init 2 fn2-alloc-edges))
      ((mv epoch fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv reserved & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv committed fn2-extents) (fn2-alloc-commit-allocation 0 1 0 1 1 fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-phase 4 fn2-extents))
      (before (fn2-extents-row-snapshot 0 fn2-extents))
      (edge-before (fn2-alloc-edges-row-snapshot 0 fn2-alloc-edges))
      ((mv durable fn2-extents fn2-alloc-edges) (fn2-alloc-edge-add 0 9 0 1 0 :recovery-base fn2-extents fn2-alloc-edges))
      (refused (and (eq durable :cold-recovery) (equal before (fn2-extents-row-snapshot 0 fn2-extents))
       (equal edge-before (fn2-alloc-edges-row-snapshot 0 fn2-alloc-edges))))
      ((mv transient fn2-extents fn2-alloc-edges) (fn2-alloc-edge-add 1 10 0 1 0 :borrow fn2-extents fn2-alloc-edges))
      ((mv dropped fn2-extents fn2-alloc-edges) (fn2-alloc-edge-drop 1 10 0 1 0 :borrow fn2-extents fn2-alloc-edges))
      (fn2-extents (update-fn2-alloc-freeze-phase 0 fn2-extents))
      ((mv retired fn2-extents) (fn2-alloc-retire 0 1 0 0 fn2-extents))
      ((mv prepared fn2-extents) (fn2-alloc-release-prepare 0 1 0 fn2-extents))
      (fn2-extents (update-fn2-alloc-freeze-phase 4 fn2-extents))
      ((mv marker fn2-extents fn2-alloc-edges) (fn2-alloc-edge-add 0 9 0 1 0 :recovery-base fn2-extents fn2-alloc-edges)))
  (mv (and (eq epoch :ok) (eq reserved :ok) (eq committed :ok) refused
       (eq transient :ok) (eq dropped :ok) (eq retired :ok) (eq prepared :ok)
       (eq marker :release-pending) (= (fn2-alloc-freeze-phase fn2-extents) 4)) fn2-extents fn2-alloc-edges)))
(defun fn2-acg-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-extents
  (mv-let (ok fn2-extents)
   (with-local-stobj fn2-alloc-edges
    (mv-let (ok fn2-extents fn2-alloc-edges) (fn2-acg-body fn2-extents fn2-alloc-edges) (mv ok fn2-extents))) ok)))
(assert-event (fn2-acg-run))

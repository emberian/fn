(in-package "ACL2")
(include-book "../books/checkpoint-member")

(defun fn2-checkpoint-member-test-hash (i fn2-checkpoint-bytes)
 (declare (xargs :stobjs fn2-checkpoint-bytes :verify-guards nil :measure (nfix (- 32 (nfix i)))))
 (if (>= (nfix i) 32) fn2-checkpoint-bytes
  (let ((fn2-checkpoint-bytes (fn2-checkpoint-bytes-set-value i (+ 1 i) fn2-checkpoint-bytes)))
   (fn2-checkpoint-member-test-hash (+ 1 i) fn2-checkpoint-bytes))))

; Source-only codec/overlap fixture, not a production builder or installation
; witness. Distinct digest bytes detect copy direction/staging mistakes.
(defun fn2-checkpoint-member-test-body (fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-checkpoints (fn2-checkpoints-init 1 fn2-checkpoints))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-init 6 fn2-checkpoint-refs))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-init 192 fn2-checkpoint-bytes))
      (fn2-fields (fn2-fields-init 128 fn2-fields))
      (fn2-pool (fn2-pool-init '((1 . 256)) 1 100 fn2-pool))
      ((mv reserved slot gen fn2-pool) (fn2-pool-reserve 0 1 0 1 fn2-pool))
      ((unless (eq reserved :ok)) (mv nil fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool))
      (fn2-checkpoints (fn2-checkpoints-put 0 (state *fn2-checkpoint-state-checked*) (checkpoint 500)))
      (fn2-checkpoint-refs (fn2-checkpoint-refs-put 0 (storage-domain 0) (physical-unit 3)
                             (writer-epoch 2) (allocation 7) (page-kind *page-kind-checkpoint-descriptor*) (encoded-length 4096)))
      (fn2-checkpoint-bytes (fn2-checkpoint-member-test-hash 0 fn2-checkpoint-bytes))
      ((mv packed len fn2-fields fn2-pool)
       (fn2-checkpoint-installation-pack-member 0 0 slot gen 1 0 1 fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool))
      ((unless (and (eq packed :ok) (equal (fn2-pool-fill slot fn2-pool) len)))
       (mv nil fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool))
      ((mv header next fn2-fields) (fn2-format-txn-record-decode 32 slot gen 0 len 1 0 1 fn2-fields fn2-pool))
      ((unless (and (eq header :ok)
                     (equal (fn2-fields-value (+ 32 *fn2-format-txn-record-field-record-kind*) fn2-fields) *record-kind-checkpoint-installation*)
                     (equal (fn2-fields-value (+ 32 *fn2-format-txn-record-field-length*) fn2-fields) (- len next))))
       (mv nil fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool))
      ((mv body end fn2-fields) (fn2-format-checkpoint-installation-decode 48 slot gen next len 1 0 1 fn2-fields fn2-pool))
      (f (+ 48 *fn2-format-checkpoint-installation-field-descriptor-storage-domain*))
      (hoff (fn2-fields-ref-off (+ f 6) fn2-fields))
      (valid (and (eq body :ok) (equal end len)
                  (equal (fn2-fields-value (+ 48 *fn2-format-checkpoint-installation-field-checkpoint*) fn2-fields) 500)
                  (equal (fn2-fields-value f fn2-fields) 0)
                  (equal (fn2-fields-value (+ f 1) fn2-fields) 3)
                  (equal (fn2-fields-value (+ f 2) fn2-fields) 2)
                  (equal (fn2-fields-value (+ f 3) fn2-fields) 7)
                  (equal (fn2-fields-value (+ f 4) fn2-fields) *page-kind-checkpoint-descriptor*)
                  (equal (fn2-fields-value (+ f 5) fn2-fields) 4096)
                  (fn2-checkpoint-pool-hash-matchesp 32 0 hoff slot gen 1 0 1 fn2-pool fn2-checkpoint-bytes)))
      ((mv truncated & fn2-fields) (fn2-format-checkpoint-installation-decode 48 slot gen next (- len 1) 1 0 1 fn2-fields fn2-pool))
      ((mv corrupted fn2-pool) (fn2-pool-write slot gen hoff 255 1 0 1 fn2-pool))
      (detected (not (fn2-checkpoint-pool-hash-matchesp 32 0 hoff slot gen 1 0 1 fn2-pool fn2-checkpoint-bytes))))
  (mv (and valid (not (eq truncated :ok)) (eq corrupted :ok) detected)
      fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)))

(defun fn2-checkpoint-member-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoints
 (mv-let (answer fn2-checkpoints)
  (with-local-stobj fn2-checkpoint-refs
 (mv-let (answer fn2-checkpoints fn2-checkpoint-refs)
  (with-local-stobj fn2-checkpoint-bytes
 (mv-let (answer fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)
  (with-local-stobj fn2-fields
 (mv-let (answer fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields)
  (with-local-stobj fn2-pool
 (mv-let (answer fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
  (fn2-checkpoint-member-test-body fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields fn2-pool)
  (mv answer fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes fn2-fields)))
  (mv answer fn2-checkpoints fn2-checkpoint-refs fn2-checkpoint-bytes)))
  (mv answer fn2-checkpoints fn2-checkpoint-refs)))
  (mv answer fn2-checkpoints)))
  answer)))
(assert-event (fn2-checkpoint-member-test))

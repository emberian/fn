; Consumer packet for a codec-generated persisted history. The caller must
; obtain its input by actual selected boot/discovery/authentication. This book
; neither constructs authorization flags nor calls the release worker directly.
; A missing antecedent is an explicit failure, never a passing implication.
(in-package "ACL2")
(include-book "../books/owed-conn")
(include-book "../books/assembly-attach")
(include-book "std/util/bstar" :dir :system)

(defun fn2-rrd-journal (id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((slot (fn2-machine-pool-slot id fn2-core)))
  (list (fn2-machine-rc-roff id fn2-core) (fn2-machine-rc-rend id fn2-core)
        slot (fn2-machine-pool-gen id fn2-core)
        (fn2-machine-rc-filled id fn2-core) (fn2-machine-rc-count id fn2-core)
        (fn2-machine-rc-pos id fn2-core) (fn2-machine-rc-commit id fn2-core)
        (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (octets)
         (fn2-cw-read-range 0 4096 slot fn2-pool) octets))))

(defun fn2-rrd-release-state (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-allocation-release (fn2-core-allocation-release fn2-core))) (state)
  (list (fn2-allocation-release-phase 0 fn2-allocation-release)
        (fn2-allocation-release-read-phase 0 fn2-allocation-release)
        (fn2-allocation-release-read-pending 0 fn2-allocation-release)
        (fn2-allocation-release-read-op-slot 0 fn2-allocation-release)
        (fn2-allocation-release-read-op-gen 0 fn2-allocation-release)
        (fn2-allocation-release-checker-stage 0 fn2-allocation-release)) state))

; Fault injection occurs at the real adapter boundary, after actual issue.
; The loan write uses the actual operation's lease. Only its notification
; generation/count is changed; no checker, auth, pending or stage is seeded.
(defun fn2-rrd-fault-read (fault store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv code op opgen slot gen off length storage fn2-core)
       (stobj-let ((fn2-ops (fn2-core-ops fn2-core)))
        (code op opgen slot gen off length storage fn2-ops)
        (b* (((mv code op opgen) (fn2-outbox-peek 0 fn2-ops))
             ((unless (and (eq code :ok) (= (fn2-ops-kind op fn2-ops) *fn2-action-read*)))
              (mv :absent 0 0 0 0 0 0 0 fn2-ops))
             ((mv slot gen off length) (fn2-op-range op fn2-ops))
             ((mv storage &) (fn2-op-storage op fn2-ops))
             ((mv ack fn2-ops) (fn2-outbox-ack 1 fn2-ops)))
         (mv ack op opgen slot gen off length storage fn2-ops))
        (mv code op opgen slot gen off length storage fn2-core)))
      ((unless (and (eq code :ok) (= length 4096))) (mv nil fn2-core))
      (bytes (fn2-cw-store-read storage length store))
      (fn2-core (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (fn2-pool)
                  (fn2-cw-write-loan off bytes slot gen op opgen fn2-pool) fn2-core))
      (fn2-core (fn2-cw-post 0 op (if (eq fault :wrong-opgen) (+ 1 opgen) opgen)
                   *fn2-event-read-result* *fn2-outcome-done*
                   (if (eq fault :short) (- length 1) length) 0 0 fn2-core)))
  (mv t fn2-core)))

(defun fn2-rrd-stale-source (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-checkpoint-selected-source (fn2-core-checkpoint-selected-source fn2-core)))
  (fn2-checkpoint-selected-source)
  (fn2-checkpoint-selected-source-set-generation 0
    (+ 1 (fn2-checkpoint-selected-source-generation 0 fn2-checkpoint-selected-source))
    fn2-checkpoint-selected-source) fn2-core))

; MASK records actual dispatcher milestones:11 issue-ready,12 outstanding,
; 13 hook/observer complete with generic pending decrement,14 checker progressed.
; No direct worker, hook, kind observer or generic decrement calls occur here.
(defun fn2-rrd-drive (fuel id ogen fault injected mask journal store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (b* ((stage (fn2-machine-rc-stage id fn2-core))
      (pending (fn2-machine-pending id fn2-core))
      (release (fn2-rrd-release-state fn2-core))
      (same (equal journal (fn2-rrd-journal id fn2-core)))
      (mask (if (= stage 11) (logior mask 1) mask))
      (mask (if (and (= stage 12) (= pending 1)) (logior mask 2) mask))
      (completed (and (= stage 13) (= pending 0)
                     (= (nth 1 release) *fn2-allocation-release-read-phase-loaded*)
                     (= (nth 2 release) 0)
                     (fn2-rp-current-unit-auth-p id ogen fn2-core)
                     (fn2-rp-release-current-p id ogen fn2-core)))
      (mask (if completed (logior mask 4) mask))
      (checked (and completed (> (nth 5 release) 0)))
      (mask (if checked (logior mask 8) mask))
      ((when (or (not same) checked (fn2-core-stopped-p fn2-core) (zp fuel)))
       (mv (list :packet mask injected same (fn2-core-stop-reason fn2-core)
                 stage pending release) store fn2-core))
      ((mv & & & & fn2-core) (fn2-turn fn2-core))
      (issued (and (= (fn2-machine-rc-stage id fn2-core) 12)
                   (= (fn2-machine-pending id fn2-core) 1)))
      (stale (and issued (not injected) (eq fault :stale-source)))
      (fn2-core (if stale (fn2-rrd-stale-source fn2-core) fn2-core))
      ((mv faulted fn2-core)
       (if (and issued (not injected) (member-eq fault '(:wrong-opgen :short)))
           (fn2-rrd-fault-read fault store fn2-core) (mv nil fn2-core)))
      (injected (or injected stale faulted))
      ((mv & & & store fn2-core)
       (if (or faulted (and injected (member-eq fault '(:wrong-opgen :short))))
           (mv nil 0 nil store fn2-core)
         (fn2-cw-adapter-one 0 nil store fn2-core))))
  (fn2-rrd-drive (- fuel 1) id ogen fault injected mask journal store fn2-core)))

(defun fn2-rrd-packet (fuel id fault store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((ogen (fn2-machine-generation id fn2-core))
      ((unless (and (fn2-recovery-idp id fn2-core)
             (= (fn2-machine-phase id fn2-core) *fn2-recovery-machine-state-verify*)
             (= (fn2-machine-rc-stage id fn2-core) 0)
             (= (fn2-machine-rc-mode id fn2-core) *fn2-rec-mode-replay*)
             (= (fn2-machine-rc-wlen id fn2-core) 0)
             (fn2-recovery-selected-current-p id fn2-core)
             (fn2-rp-current-unit-auth-p id ogen fn2-core)))
       (mv '(:missing-antecedent) store fn2-core))
      (journal (fn2-rrd-journal id fn2-core)))
  (fn2-rrd-drive fuel id ogen fault nil 0 journal store fn2-core)))

(defun fn2-rrd-result-p (fault result)
 ; A positive packet requires every observed milestone, not merely no STOP.
 ; Wrong-generation notification may remain pending rather than STOP: it must
 ; still retain ownership and must never reach the successful observer arm.
 (and (eq (car result) :packet) (nth 3 result)
  (= (car (nth 7 result)) *fn2-allocation-release-phase-replaying*)
  (if (eq fault :clean)
      (and (= (nth 1 result) 15) (not (nth 2 result)) (= (nth 4 result) 0)
           (= (nth 5 result) 13) (= (nth 6 result) 0))
    (and (member-eq fault '(:wrong-opgen :short :stale-source))
         (nth 2 result) (= (logand 4 (nth 1 result)) 0)
         (or (not (= (nth 4 result) 0))
             (and (eq fault :wrong-opgen) (= (nth 5 result) 12)
                  (= (nth 6 result) 1)
                  (= (nth 1 (nth 7 result)) *fn2-allocation-release-read-phase-wait*)
                  (= (nth 2 (nth 7 result)) 1)))))))

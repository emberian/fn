; Typed callback controls only: not a real issued Write/Write/Fence witness.
(in-package "ACL2")
(include-book "checkpoint-bank-fixture")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-publication")

(defun fn2-checkpoint-bank-test-attempt (bank candidate id hash fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :verify-guards nil))
 (fn2-checkpoint-publication-put 0
  (phase *fn2-checkpoint-publication-phase-wait-fence*) (op-slot 5) (op-gen 7)
  (bank bank) (candidate candidate) (attempt-checkpoint id)
  (attempt-history 41) (attempt-incarnation 43)
  (attempt-hash-0 hash) (attempt-hash-7 (+ 7 hash))))

(defun fn2-checkpoint-bank-test-body (fn2-checkpoint-publication)
 (declare (xargs :stobjs fn2-checkpoint-publication :verify-guards nil))
 (b* ((fn2-checkpoint-publication (fn2-checkpoint-test-empty-publication fn2-checkpoint-publication))
      (fn2-checkpoint-publication (fn2-checkpoint-bank-test-attempt 0 0 1 100 fn2-checkpoint-publication))
      ((mv & fn2-checkpoint-publication)
       (fn2-checkpoint-publication-harvest 5 6 0 *fn2-event-fence-result* *fn2-outcome-done* 0 0 0 0 fn2-checkpoint-publication))
      ((unless (equal (fn2-checkpoint-publication-bank0-valid 0 fn2-checkpoint-publication) 0))
       (mv nil fn2-checkpoint-publication))
      ((mv & fn2-checkpoint-publication)
       (fn2-checkpoint-publication-harvest 5 7 0 *fn2-event-fence-result* *fn2-outcome-done* 0 0 0 0 fn2-checkpoint-publication))
      ((unless (and (equal (fn2-checkpoint-publication-bank0-checkpoint 0 fn2-checkpoint-publication) 1)
                     (equal (fn2-checkpoint-publication-bank0-hash-7 0 fn2-checkpoint-publication) 107)
                     (equal (fn2-checkpoint-publication-debt-valid 0 fn2-checkpoint-publication) 0)))
       (mv nil fn2-checkpoint-publication))
      ; Filling the other bank cannot displace the first one.
      (fn2-checkpoint-publication (fn2-checkpoint-bank-test-attempt 1 1 2 200 fn2-checkpoint-publication))
      ((mv & fn2-checkpoint-publication)
       (fn2-checkpoint-publication-harvest 5 7 0 *fn2-event-fence-result* *fn2-outcome-done* 0 0 0 0 fn2-checkpoint-publication))
      ((unless (and (equal (fn2-checkpoint-publication-bank1-checkpoint 0 fn2-checkpoint-publication) 2)
                     (equal (fn2-checkpoint-publication-bank0-checkpoint 0 fn2-checkpoint-publication) 1)
                     (equal (fn2-checkpoint-publication-debt-valid 0 fn2-checkpoint-publication) 0)))
       (mv nil fn2-checkpoint-publication))
      ; A failed overwrite retains old occupants and the attempted new identity.
      (fn2-checkpoint-publication (fn2-checkpoint-bank-test-attempt 0 2 3 300 fn2-checkpoint-publication))
      ((mv & fn2-checkpoint-publication)
       (fn2-checkpoint-publication-harvest 5 7 0 *fn2-event-fence-result* *fn2-outcome-done* 0 1 0 0 fn2-checkpoint-publication))
      ((unless (and (equal (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication) *fn2-checkpoint-publication-phase-uncertain*)
                     (equal (fn2-checkpoint-publication-bank0-checkpoint 0 fn2-checkpoint-publication) 1)
                     (equal (fn2-checkpoint-publication-attempt-hash-0 0 fn2-checkpoint-publication) 300)))
       (mv nil fn2-checkpoint-publication))
      ; Fixture resumes at a new exact callback state; this is not retry authority.
      (fn2-checkpoint-publication (fn2-checkpoint-bank-test-attempt 0 2 3 300 fn2-checkpoint-publication))
      ((mv & fn2-checkpoint-publication)
       (fn2-checkpoint-publication-harvest 5 7 0 *fn2-event-fence-result* *fn2-outcome-done* 0 0 0 0 fn2-checkpoint-publication))
      ((unless (and (equal (fn2-checkpoint-publication-debt-valid 0 fn2-checkpoint-publication) 1)
                     (equal (fn2-checkpoint-publication-debt-candidate 0 fn2-checkpoint-publication) 0)
                     (equal (fn2-checkpoint-publication-debt-checkpoint 0 fn2-checkpoint-publication) 1)
                     (equal (fn2-checkpoint-publication-debt-hash-0 0 fn2-checkpoint-publication) 100)
                     (equal (fn2-checkpoint-publication-debt-hash-7 0 fn2-checkpoint-publication) 107)
                     (equal (fn2-checkpoint-publication-bank0-checkpoint 0 fn2-checkpoint-publication) 3)
                     (equal (fn2-checkpoint-publication-bank1-checkpoint 0 fn2-checkpoint-publication) 2)))
       (mv nil fn2-checkpoint-publication))
      ; Even an injected exact callback cannot overwrite outstanding debt.
      (fn2-checkpoint-publication (fn2-checkpoint-bank-test-attempt 1 3 4 400 fn2-checkpoint-publication))
      ((mv & fn2-checkpoint-publication)
       (fn2-checkpoint-publication-harvest 5 7 0 *fn2-event-fence-result* *fn2-outcome-done* 0 0 0 0 fn2-checkpoint-publication)))
  (mv (and (equal (fn2-checkpoint-publication-phase 0 fn2-checkpoint-publication) *fn2-checkpoint-publication-phase-uncertain*)
           (equal (fn2-checkpoint-publication-debt-checkpoint 0 fn2-checkpoint-publication) 1)
           (equal (fn2-checkpoint-publication-bank1-checkpoint 0 fn2-checkpoint-publication) 2)) fn2-checkpoint-publication)))
(defun fn2-checkpoint-bank-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoint-publication
  (mv-let (answer fn2-checkpoint-publication)
   (fn2-checkpoint-bank-test-body fn2-checkpoint-publication) answer)))
(assert-event (fn2-checkpoint-bank-test))

; Empty concrete carriers are in the universal shape contract domain even
; though real publication requires a row. Capture must not grow such a table.
(defun fn2-checkpoint-bank-empty-control ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoint-publication
  (let* ((fn2-checkpoint-publication (fn2-checkpoint-publication-init 0 fn2-checkpoint-publication))
         (fn2-checkpoint-publication (fn2-checkpoint-publication-record-bank fn2-checkpoint-publication)))
   (equal (fn2-checkpoint-publication-rows fn2-checkpoint-publication) 0))))
(assert-event (fn2-checkpoint-bank-empty-control))

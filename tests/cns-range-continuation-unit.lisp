; Accepted READ API-domain controls, not normal-sealer or authenticated-client
; reachability. Pages come only from the actual writer/seal/check/install
; fixture. Request metadata below deliberately constructs a direct API input
; around a real admitted CNS row; no :more result or READ cursor is seeded.
(in-package "ACL2")
(include-book "../books/assembly")
(include-book "cns-tall-runs-support")
(include-book "core-snapshot-support")

(defun fn2-cns-range-test-idle (x fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-reads (fn2-core-reads fn2-core))
             (fn2-ranges (fn2-core-ranges fn2-core))
             (fn2-seeks (fn2-core-seeks fn2-core))) (yes)
  (and (equal (fn2-reads-op x fn2-reads) *fn2-read-op-idle*)
       (equal (fn2-reads-qset x fn2-reads) 0)
       (equal (fn2-ranges-phase x fn2-ranges) *fn2-range-phase-idle*)
       (equal (fn2-seeks-phase x fn2-seeks) *fn2-seek-phase-idle*)) yes))
(defun fn2-cns-range-test-next (id gen x slot slotgen principal pf kind fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil) (ignorable slotgen))
 (fn2-cns-item-next principal (fn2-cns-row-ipos id fn2-core) pf 0 0 slot x nil *fn2-none* 0 kind id gen fn2-core))
(defun fn2-cns-range-test-drive (fuel calls endp id gen x slot slotgen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (declare (ignorable slotgen))
 (if (zp fuel) (mv nil calls fn2-core)
  (mv-let (code pos art stream type bytes unit epoch allocation fn2-core)
   (fn2-cns-range-test-next id gen x slot slotgen 7 101 *fn2-cns-kind* fn2-core)
   (declare (ignore bytes unit epoch allocation))
   (if (eq code :yield)
       (fn2-cns-range-test-drive (1- fuel) (1+ calls) endp id gen x slot slotgen fn2-core)
    (mv (and (if endp (and (eq code :end) (equal (1+ calls) 93))
               (and (eq code :found) (equal pos 100) (equal art 1000)
                    (equal stream 3) (equal type *fn2-fnct-item-gap*)
                    (equal (1+ calls) 69)))
             (fn2-cns-range-test-idle x fn2-core))
        (1+ calls) fn2-core)))))

(defun fn2-cns-range-test-body (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (put-assoc-equal :p 8 *fn2-cns-tall-profile*))
      (supported (fn2-core-profilep profile))
      (fn2-core (fn2-core-init profile fn2-core))
      ((mv built fn2-core) (fn2-cns-tall-runs-fixture fn2-core))
      ((mv taken id gen fn2-core)
       (fn2-machine-take-fn2-cns *fn2-none* *fn2-none* 0 1 0 0 4 *fn2-none* 0 fn2-core))
      ((mv mapped x) (fn2-cns-read-row id fn2-core))
      ((mv reserved slot slotgen fn2-core) (fn2-core-reserve 0 *fn2-cns-kind* id gen fn2-core))
      ((unless (and supported (eq built :ok) (eq taken :ok) (eq mapped :ok) (eq reserved :ok)))
       (mv nil fn2-core))
      ; Direct API request metadata; not an authentication or client witness.
      (fn2-core (fn2-cns-put-core id (phase *fn2-cns-state-page*) (xrow x)
                  (principal-slot 7) (ipos (if (eq mode :end) 100 99)) (pub-frontier 101) (page-limit 1)
                  (verb *fn2-cns-verb-read*) (outcome *fn2-cns-outcome-accepted*)
                  (tx-slot slot) (tx-gen slotgen) (ctl 0))))
  (cond
   ((eq mode :partial-start)
    (let* ((fn2-core (stobj-let ((fn2-fields (fn2-core-fields fn2-core))) (fn2-fields)
                      (fn2-fields-init 1 fn2-fields) fn2-core))
           (before (fn2-test-core-snapshot fn2-core)))
     (mv-let (code fn2-core) (fn2-cns-range-ready 7 99 101 x id gen fn2-core)
      (mv (and (eq code :state) (fn2-cns-range-test-idle x fn2-core)
               (equal before (fn2-test-core-snapshot fn2-core))) fn2-core))))
   ((member-eq mode '(:seek-busy :lookup-busy))
    (let* ((fn2-core
            (if (eq mode :seek-busy)
                (stobj-let ((fn2-seeks (fn2-core-seeks fn2-core))) (fn2-seeks)
                 (fn2-seeks-set-phase x *fn2-seek-phase-probe* fn2-seeks) fn2-core)
              (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))
                          (fn2-id-decides (fn2-core-id-decides fn2-core))) (fn2-succ-txns)
               (fn2-succ-txns-set-lphase (+ (fn2-id-decides-rows fn2-id-decides) x)
                                         *fn2-succ-lookup-overlays* fn2-succ-txns) fn2-core)))
           (before (fn2-test-core-snapshot fn2-core)))
     (mv-let (code fn2-core) (fn2-cns-range-ready 7 99 101 x id gen fn2-core)
      (mv (and (eq code :state) (equal before (fn2-test-core-snapshot fn2-core))) fn2-core))))
   ((eq mode :u60)
    (let* ((fn2-core (fn2-cns-put-core id (ipos (1- *fn2-u60-max*)) (pub-frontier *fn2-u60-max*))))
     (mv-let (code fn2-core)
      (fn2-cns-range-ready 7 (1- *fn2-u60-max*) *fn2-u60-max* x id gen fn2-core)
      (mv-let (released fn2-core) (fn2-cns-range-release id gen x fn2-core)
       (mv (and (eq code :ok) (eq released :ok) (fn2-cns-range-test-idle x fn2-core)) fn2-core)))))
   (t
    (mv-let (first pos art stream type bytes unit epoch allocation fn2-core)
     (fn2-cns-range-test-next id gen x slot slotgen 7 101 *fn2-cns-kind* fn2-core)
     (declare (ignore pos art stream type bytes unit epoch allocation))
     (if (not (eq first :yield)) (mv nil fn2-core)
      (cond
       ((member-eq mode '(:complete :end))
        (mv-let (yes calls fn2-core)
         (fn2-cns-range-test-drive 100 1 (eq mode :end) id gen x slot slotgen fn2-core)
         (mv (and yes (equal calls (if (eq mode :end) 93 69))) fn2-core)))
       ((member-eq mode '(:cancel :refuse))
        (let ((fn2-core (if (eq mode :cancel) (fn2-cns-put-core id (ctl *fn2-none*))
                         (fn2-cns-put-core id (outcome *fn2-cns-outcome-refused*)))) )
         (mv-let (b s d runnable fn2-core) (fn2-cns-run id 4 fn2-core)
          (declare (ignore b s d runnable))
          (mv (and (fn2-cns-range-test-idle x fn2-core)
                   (not (fn2-core-stopped-p fn2-core))) fn2-core))))
       ((member-eq mode '(:foreign-read :foreign-range))
        (let* ((fn2-core
                (if (eq mode :foreign-read)
                    (stobj-let ((fn2-reads (fn2-core-reads fn2-core))) (fn2-reads)
                     (fn2-reads-set-qg x (1+ gen) fn2-reads) fn2-core)
                  (stobj-let ((fn2-ranges (fn2-core-ranges fn2-core))) (fn2-ranges)
                   (fn2-ranges-set-qg x (1+ gen) fn2-ranges) fn2-core)))
               (before (fn2-test-core-snapshot fn2-core)))
         (mv-let (code fn2-core) (fn2-cns-range-release id gen x fn2-core)
          (mv (and (eq code :state) (equal before (fn2-test-core-snapshot fn2-core))) fn2-core))))
       (t
        (let ((before (fn2-test-core-snapshot fn2-core)))
         (mv-let (code p a sm ty by u e al fn2-core)
          (fn2-cns-range-test-next id (if (eq mode :generation) (1+ gen) gen) x slot slotgen
            (if (eq mode :principal) 6 7) (if (eq mode :frontier) 102 101)
            (if (eq mode :kind) 0 *fn2-cns-kind*) fn2-core)
          (declare (ignore p a sm ty by u e al))
          (mv (and (eq code :fault) (equal before (fn2-test-core-snapshot fn2-core))) fn2-core)))))))))))
(defun fn2-cns-range-continuation-control (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (yes fn2-core) (fn2-cns-range-test-body mode fn2-core) yes)))
(assert-event (and (fn2-cns-range-continuation-control :complete)
                   (fn2-cns-range-continuation-control :end)
                   (fn2-cns-range-continuation-control :cancel)
                   (fn2-cns-range-continuation-control :refuse)
                   (fn2-cns-range-continuation-control :partial-start)
                   (fn2-cns-range-continuation-control :u60)))
(assert-event (and (fn2-cns-range-continuation-control :foreign-read)
                   (fn2-cns-range-continuation-control :foreign-range)
                   (fn2-cns-range-continuation-control :generation)
                   (fn2-cns-range-continuation-control :principal)
                   (fn2-cns-range-continuation-control :frontier)
                   (fn2-cns-range-continuation-control :kind)
                   (fn2-cns-range-continuation-control :seek-busy)
                   (fn2-cns-range-continuation-control :lookup-busy)))

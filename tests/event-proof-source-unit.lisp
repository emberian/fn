(in-package "ACL2")
(include-book "retirement-live-unit")
(include-book "c-snapshot-unit")
(include-book "../books/event-proof-source")

(defun fn2-eps-pack (token ordinal off slot gen scratch sgen ownergen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-csnapshot (fn2-core-csnapshot fn2-core)) (fn2-commit-root (fn2-core-commit-root fn2-core))
             (fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))
             (fn2-fc (fn2-core-fc fn2-core)) (fn2-digests (fn2-core-digests fn2-core))
             (fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
  (code end fn2-fields fn2-pool)
  (fn2-event-proof-pack-entry token ordinal (* 128 (fn2-b-event-row (fn2-fc-rows fn2-fc)))
   slot gen off scratch sgen 7 0 ownergen
   fn2-csnapshot fn2-commit-root fn2-extents fn2-alloc-edges fn2-fc fn2-digests fn2-fields fn2-pool)
  (mv code end fn2-core)))
(defun fn2-eps-body (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((profile (fn2-b-test-profile *fn2-csu-profile* 0))
      (fn2-core (fn2-core-init profile fn2-core))
      (fn2-sim (fn2-sim-init 1 :none "event-proof-source" profile fn2-sim))
      (fn2-own (fn2-own-init profile fn2-own))
      (owner (fn2-machine-kind-base *fn2-scribe-kind* fn2-core))
      (ogen (fn2-machine-generation owner fn2-core))
      ((mv epoch fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv admitted & batch event fn2-core) (fn2-commit-admit-keyed 1 0 *fn2-scribe-kind* owner ogen fn2-core))
      ((mv fn2-core fn2-sim fn2-own) (fn2-retirement-live-drive 600 26 fn2-core fn2-sim fn2-own))
      ((mv begun token fn2-core) (fn2-csnapshot-begin 7 0 1 fn2-core))
      ((mv held cut events fn2-core) (fn2-csu-poll 30 token fn2-core))
      ((mv page slot gen fn2-core) (fn2-core-reserve 3 7 0 1 fn2-core))
      ((mv scratch-code scratch sgen fn2-core) (fn2-core-reserve 1 7 0 1 fn2-core))
      ((unless (and (eq epoch :ok) (eq admitted :ok) (eq begun :ok) (eq held :held)
                    (= cut batch) (= events event) (= batch 1) (= event 1)
                    (eq page :ok) (eq scratch-code :ok))) (mv nil fn2-core fn2-sim fn2-own))
      ((mv packed end fn2-core) (fn2-eps-pack token 0 *fn2-checkpoint-map-entries-start* slot gen scratch sgen 1 fn2-core))
      ((mv decoded fn2-core)
       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core))
                   (fn2-commit-root (fn2-core-commit-root fn2-core)) (fn2-fc (fn2-core-fc fn2-core))
                   (fn2-digests (fn2-core-digests fn2-core)) (fn2-extents (fn2-core-extents fn2-core)))
        (answer fn2-fields)
        (b* ((base (* 128 (fn2-b-event-row (fn2-fc-rows fn2-fc))))
             (extent (fn2-commit-root-extent batch fn2-commit-root))
             (seal (+ (* *fn2-digest-stride* (fn2-fc-rows fn2-fc)) batch))
             ((mv code next fn2-fields) (fn2-event-proof-entry-decode base slot gen
                  *fn2-checkpoint-map-entries-start* end 7 0 1 fn2-fields fn2-pool))
             (hashfield (+ base *fn2-event-proof-entry-field-semantic-seal*)))
         (mv (and (eq code :ok) (= next end)
                  (= (fn2-fields-value (+ base *fn2-event-proof-entry-field-commit*) fn2-fields) batch)
                  (= (fn2-fields-value (+ base *fn2-event-proof-entry-field-event-first*) fn2-fields) event)
                  (= (fn2-fields-value (+ base *fn2-event-proof-entry-field-members*) fn2-fields) 1)
                  (= (fn2-fields-value (+ base *fn2-event-proof-entry-field-extent*) fn2-fields) extent)
                  (= (fn2-fields-value (+ base *fn2-event-proof-entry-field-writer-epoch*) fn2-fields) (fn2-extents-epoch extent fn2-extents))
                  (= (fn2-fields-value (+ base *fn2-event-proof-entry-field-allocation*) fn2-fields) (fn2-extents-counter extent fn2-extents))
                  (equal (fn2-pool-logical-octets 32 (+ (fn2-pool-base slot fn2-pool) (fn2-fields-ref-off hashfield fn2-fields)) fn2-pool)
                         (fn-b3-words-octets (fn2-digest-list seal fn2-digests)))) fn2-fields)) (mv answer fn2-core)))
      ((mv stale & fn2-core) (fn2-eps-pack token 0 *fn2-checkpoint-map-entries-start* slot gen scratch sgen 2 fn2-core))
      ((mv shifted & fn2-core) (fn2-eps-pack token 0 (+ 1 *fn2-checkpoint-map-entries-start*) slot gen scratch sgen 1 fn2-core))
      ((mv dropped fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))
                   (fn2-commit-root (fn2-core-commit-root fn2-core))) (code fn2-extents fn2-alloc-edges)
        (let ((e (fn2-commit-root-extent batch fn2-commit-root)))
         (fn2-alloc-edge-drop (+ 7 (* 2 e)) batch e (fn2-extents-epoch e fn2-extents)
           (fn2-extents-counter e fn2-extents) :installed-root fn2-extents fn2-alloc-edges)) (mv code fn2-core)))
      ((mv unprotected & fn2-core) (fn2-eps-pack token 0 *fn2-checkpoint-map-entries-start* slot gen scratch sgen 1 fn2-core)))
  (mv (and (eq packed :ok) decoded (eq stale :snapshot) (eq shifted :bounds)
           (eq dropped :ok) (eq unprotected :source)) fn2-core fn2-sim fn2-own)))
(defun fn2-eps-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core)
   (with-local-stobj fn2-sim
    (mv-let (answer fn2-core fn2-sim)
     (with-local-stobj fn2-own
      (mv-let (answer fn2-core fn2-sim fn2-own) (fn2-eps-body fn2-core fn2-sim fn2-own)
       (mv answer fn2-core fn2-sim))) (mv answer fn2-core))) answer)))
(assert-event (fn2-eps-test))

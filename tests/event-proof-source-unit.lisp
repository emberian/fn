       (stobj-let ((fn2-fields (fn2-core-fields fn2-core)) (fn2-pool (fn2-core-pool fn2-core))
                   (fn2-commit-root (fn2-core-commit-root fn2-core)) (fn2-fc (fn2-core-fc fn2-core))
                   (fn2-digests (fn2-core-digests fn2-core)) (fn2-extents (fn2-core-extents fn2-core)))

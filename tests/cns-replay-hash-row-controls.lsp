; Execute the actual shared-row selector and context predicate. Mock child
; readers only. These controls do not exercise generated-core scheduling.
(load "tests/ctl-output-geometry-controls.lsp")
(in-package "ACL2")

(defparameter *fn2-cns-state-append* :append)
(defparameter *fn2-cns-state-replay* :replay)
(defparameter *fn2-cns-verb-append* :append)
(defparameter *fn2-ctl-state-stream* :stream)
(defparameter *fn2-ctl-state-waiting* :waiting)
(defparameter *fn2-cns-source-phase-free* :free)
(defparameter *fn2-cns-source-retention-unclaimed* 0)
(defparameter *fn2-cns-source-retention-released* 4)

(defun fn2-cns-snapshot-read-code (id core)
 (declare (ignore core)) (if (eql id 2) :ok :bounds))
(defun fn2-machine-generation (id core)
 (if (eql id 1) (getf core :ctl-gen 3) (getf core :cns-gen 4)))

(loop for (name key default) in
 '((fn2-cns-row-ctl :ctl 1) (fn2-cns-row-ctl-gen :cns-ctl-gen 3)
   (fn2-cns-row-request :cns-request 5) (fn2-ctl-row-request :ctl-request 5)
   (fn2-cns-row-phase :cns-phase :replay) (fn2-cns-row-verb :verb :append)
   (fn2-ctl-row-cns :child 2) (fn2-ctl-row-cns-gen :child-gen 4)
   (fn2-ctl-row-phase :ctl-phase :stream)
   (fn2-cns-sources-phase :job-phase :free) (fn2-cns-sources-pending :pending 0)
   (fn2-cns-sources-borrow-count :borrows 0) (fn2-cns-sources-uncertain :uncertain 0)
   (fn2-cns-sources-retention-phase :retention 0))
 do (eval `(defun ,name (id core) (declare (ignore id)) (getf core ,key ,default))))

(defun source-definition (file name)
 (with-open-file (in file)
  (find-form (lambda (f) (and (eq (car f) 'defun) (eq (cadr f) name)))
             (loop for form = (read in nil :end) until (eq form :end) collect form))))
(eval (source-definition "books/cns-source-core.lisp" 'fn2-cns-source-contextp))
(eval (source-definition "books/ctl-stream-events.lisp" 'fn2-ctl-stream-live-p))
(eval (find-form (lambda (f) (and (eq (car f) 'defun) (eq (cadr f) 'fn2-cns-replay-row))) *source-forms*))

(defun replay-selection (core &optional (phase :replay))
 (multiple-value-list (fn2-cns-replay-row 2 4 1 3 5 phase core)))

(assert (equal (replay-selection nil) '(:ok 25)))
(assert (equal (replay-selection '(:slot 1 :ctl-phase :waiting :retention 4)) '(:ok 26)))
(assert (equal (replay-selection '(:cns-phase :append) :append) '(:ok 25)))
(assert (equal (replay-selection '(:cns-phase :source) :source) '(:unavailable 0)))
(dolist (core '((:job-phase :raw-hash :job-gen 4)
                (:job-phase :retain :job-gen 2)
                (:job-phase :handoff :job-gen 2)
                (:pending 1) (:borrows 1) (:uncertain 1) (:retention 2)
                (:ctl-phase :closing) (:ctl-request 6) (:cns-request 6)
                (:child-gen 3) (:cns-gen 3) (:ctl-gen 2) (:verb :fetch)
                (:cns-phase :source) (:jobs 3) (:hashers 31) (:fields 3072)))
 (assert (equal (replay-selection core) '(:unavailable 0))))
(format t "CNS REPLAY SOURCE CONTROLS PASS: same-row reuse after handback; busy, stale and mismatched rows refused~%")

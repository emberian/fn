; Use the production first-SEND subarm in the real machine compiler. The
; fixture controls the answer of its authority callback and the owner wake,
; while A supplies descriptor pressure, the loan and the operation FIFO.
(in-package "ACL2")
(include-book "../books/assembly-callbacks-d-conn")

(defmachine fn2-xfs
 :phases (:free :query :reply :closing)
 :fields ((pending :u32) (stopped :bool) (query :link) (query-gen :u60)
          (tx-slot :link) (tx-gen :u60) (tx-off :u32) (cap-index :u32) (cap-nonce :u32)
          (xfnc-verb :u8) (xfnc-answer :u8) (xfnc-reason :u8) (borrows :u8)
          (after :u8) (tls-op :link) (tls-op-gen :u60))
 :budget (:bytes 4096 :steps 32 :descriptors 4)
 :initial ((generation 1) (ready-prev *fn2-none*) (ready-next *fn2-none*))
 :arms ((:free (:idle)) (:query (:idle)) (:reply (:idle)) (:closing (:idle))) :observes ())

; A fixture-owned second range holds the current authorization response.
(defun fn2-xfs-check-children (query generation fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (mv-let (code grant) (fn2-pool-read 1 1 0 7 query generation fn2-pool)
  (mv (if (and (eq code :ok) (equal grant 1)) :ready :access) fn2-pool)))
(defthm fn2-xfs-check-preserves-pool
 (equal (mv-nth 1 (fn2-xfs-check-children query generation fn2-pool)) fn2-pool))
(defcost fn2-xfs-check :child fn2-xfs-check-children :answers t :bytes 2048 :tables (fn2-core-pool)
 :doc "Supply a fixture authorization result at the production check boundary.")
(defun fn2-xfs-fill-children (slot fn2-pool)
 (declare (xargs :stobjs fn2-pool :guard (fn2-pool-wfp fn2-pool)))
 (if (and (natp slot) (< slot (fn2-pool-rows fn2-pool))) (fn2-pool-fill slot fn2-pool) 0))
(defthm fn2-xfs-fill-natp
 (implies (and (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool))
          (natp (fn2-xfs-fill-children slot fn2-pool))) :rule-classes :type-prescription)
(defcost fn2-xfs-fill :child fn2-xfs-fill-children :doc "Read the held fixture TX fill.")
(defun fn2-xfs-cancel-children (query generation fn2-control)
 (declare (ignore query generation) (xargs :stobjs fn2-control :guard t)) fn2-control)
(defun fn2-xfs-wake-children (query fn2-control)
 (declare (ignore query) (xargs :stobjs fn2-control :guard t)) fn2-control)
(defthm fn2-xfs-cancel-preserves-control
 (equal (fn2-xfs-cancel-children query generation fn2-control) fn2-control))
(defthm fn2-xfs-wake-preserves-control
 (equal (fn2-xfs-wake-children query fn2-control) fn2-control))
(defcost fn2-xfs-cancel :child fn2-xfs-cancel-children :tables (fn2-core-control) :doc "Fixture retirement callback.")
(local (in-theory (disable fn2-xfs-check-children fn2-xfs-fill-children)))
(defcost fn2-xfs-wake :child fn2-xfs-wake-children :tables (fn2-core-control) :doc "Fixture wake callback.")

(defun fn2-xfs-callbacks (names form)
 (declare (xargs :verify-guards nil))
 (if (consp form)
     (cons (fn2-xfs-callbacks names (car form)) (fn2-xfs-callbacks names (cdr form)))
   (let ((entry (assoc-eq form names))) (if entry (cdr entry) form))))

(make-event
 (b* ((actual (assoc-eq 'xfnc-first-send (fn2-machine-declared 'fn2-conn :subarms (w state))))
      ((unless actual) (er soft 'fn2-xfs "The served first-SEND subarm is missing."))
      (test (fn2-xfs-callbacks '((fn2-conn-xfnc-first-send-check . fn2-xfs-check)
                      (fn2-conn-fill . fn2-xfs-fill)
                      (fn2-conn-cursor-cancel . fn2-xfs-cancel) (fn2-conn-wake . fn2-xfs-wake))
                    actual))
      ((mv errors & events) (fn2-arms-subs 'fn2-xfs (list test) nil nil nil :children (w state))))
  (if errors (er soft 'fn2-xfs "~x0" errors) (value (cons 'progn events)))))

(defun fn2-xfs-run (approved fn2-xfs fn2-machines fn2-pool fn2-ops fn2-control)
 (declare (xargs :stobjs (fn2-xfs fn2-machines fn2-pool fn2-ops fn2-control) :verify-guards nil))
 (b* ((profile (put-assoc-equal :qa 1 *fn2-profile-tiny*))
      (fn2-xfs (fn2-xfs-init 1 fn2-xfs))
      (fn2-xfs (fn2-xfs-initialize-rows 1 1 0 7 fn2-xfs))
      (fn2-machines (fn2-machines-columns-init 1 fn2-machines))
      (fn2-machines (fn2-machines-put 0 (kind 6) (slot 0)))
      (fn2-pool (fn2-pool-init '((2 . 4096)) 1 100 fn2-pool))
      (fn2-ops (fn2-ops-init profile fn2-ops))
      (fn2-control (fn2-control-init profile fn2-control))
      ((mv tx slot gen fn2-pool) (fn2-pool-reserve 0 6 0 1 fn2-pool))
      ((mv auth who ag fn2-pool) (fn2-pool-reserve 0 7 0 1 fn2-pool))
      ((mv loaned & fn2-pool) (fn2-pool-lease-in slot gen 2050 1 1 6 0 1 fn2-pool))
      ((mv staged fn2-pool) (fn2-pool-complete-in slot gen 1 1 2050 fn2-pool))
      ((mv lit fn2-pool) (fn2-pool-write who ag 0 1 7 0 1 fn2-pool))
      (fn2-xfs (fn2-xfs-put 0 (phase *fn2-xfs-state-query*) (generation 1) (query 0) (query-gen 1)
                 (tx-slot slot) (tx-gen gen) (cap-index 1) (cap-nonce 5) (xfnc-verb 2)))
      ((mv held other og fn2-ops) (fn2-op-reserve *fn2-action-close* 6 0 1 0 0 fn2-ops))
      ((mv first-bytes & first-count & fn2-xfs fn2-machines fn2-pool fn2-ops fn2-control)
       (fn2-xfs-sub-xfnc-first-send-children 0 0 6 0 4 fn2-xfs fn2-machines fn2-pool fn2-ops fn2-control))
      (parked (and (equal first-bytes 2048) (equal first-count 0) (equal (fn2-ops-queued fn2-ops) 0)
                   (equal (fn2-xfs-query 0 fn2-xfs) 0) (equal (fn2-xfs-query-gen 0 fn2-xfs) 1)
                   (equal (fn2-xfs-phase 0 fn2-xfs) *fn2-xfs-state-query*)
                   (equal (fn2-machines-wait-reason 0 fn2-machines) *fn2-wait-operation*)
                   (equal (fn2-pool-out-count slot fn2-pool) 0)))
      ((mv changed fn2-pool) (fn2-pool-write who ag 0 (if approved 1 0) 7 0 1 fn2-pool))
      ((mv freed fn2-ops) (fn2-op-unreserve other og fn2-ops))
      ((mv wake fn2-machines fn2-control) (fn2-machines-grant-op fn2-machines fn2-control))
      ((mv bytes & issued & fn2-xfs fn2-machines fn2-pool fn2-ops fn2-control)
       (fn2-xfs-sub-xfnc-first-send-children 0 0 6 0 4 fn2-xfs fn2-machines fn2-pool fn2-ops fn2-control)))
   (mv (and (eq tx :ok) (eq auth :ok) (equal who 1) (equal ag 1)
            (eq loaned :ok) (eq staged :ok) (eq lit :ok) (eq held :ok) parked (eq changed :ok) (eq freed :ok) (equal wake 0)
            (equal (fn2-control-stop fn2-control) 0)
            (if approved
                (and (equal issued 1) (equal bytes 4096) (equal (fn2-ops-queued fn2-ops) 1)
                     (equal (fn2-ops-kind (fn2-xfs-tls-op 0 fn2-xfs) fn2-ops) *fn2-action-send*)
                     (equal (fn2-ops-range-len (fn2-xfs-tls-op 0 fn2-xfs) fn2-ops) 2048)
                     (equal (fn2-ops-range-off (fn2-xfs-tls-op 0 fn2-xfs) fn2-ops) 0)
                     (equal (fn2-pool-out-count slot fn2-pool) 1)
                     (equal (fn2-xfs-query 0 fn2-xfs) *fn2-none*)
                     (equal (fn2-xfs-phase 0 fn2-xfs) *fn2-xfs-state-reply*))
              (and (equal issued 0) (equal bytes 2048) (equal (fn2-ops-queued fn2-ops) 0)
                   (equal (fn2-pool-out-count slot fn2-pool) 0)
                   (equal (fn2-xfs-query 0 fn2-xfs) 0)
                   (equal (fn2-xfs-xfnc-answer 0 fn2-xfs) *fn2-conn-xfnc-answer-refused*))))
       fn2-xfs fn2-machines fn2-pool fn2-ops fn2-control)))

(defun fn2-xfs-test (approved)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-xfs
  (mv-let (ok fn2-xfs)
   (with-local-stobj fn2-machines
    (mv-let (ok fn2-xfs fn2-machines)
     (with-local-stobj fn2-pool
      (mv-let (ok fn2-xfs fn2-machines fn2-pool)
       (with-local-stobj fn2-ops
        (mv-let (ok fn2-xfs fn2-machines fn2-pool fn2-ops)
         (with-local-stobj fn2-control
          (mv-let (ok fn2-xfs fn2-machines fn2-pool fn2-ops fn2-control)
           (fn2-xfs-run approved fn2-xfs fn2-machines fn2-pool fn2-ops fn2-control)
           (mv ok fn2-xfs fn2-machines fn2-pool fn2-ops)))
         (mv ok fn2-xfs fn2-machines fn2-pool)))
       (mv ok fn2-xfs fn2-machines)))
     (mv ok fn2-xfs)))
   ok)))

(assert-event (fn2-xfs-test t))
(assert-event (fn2-xfs-test nil))

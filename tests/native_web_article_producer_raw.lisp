;;; Actual shared section producer composed with Web scan/replay/count/write.
;;; Arena access and owner/cold/I/O are recording seams, not runtime proofs.
(load "tests/native_web_article_stream_raw.lisp")
(in-package "ACL2")

;;; ---- derived stubs: BEGIN (python3 tools/harness_check.py --write-stubs; do not edit) ----
(define-condition harness-stub-reached (serious-condition)
  ((name :initarg :name :reader harness-stub-reached-name)
   (source :initarg :source :reader harness-stub-reached-source))
  (:report (lambda (c s)
             (format s "harness: host function ~(~a~) (~a) was reached; this harness neither stubs nor extracts it"
                     (harness-stub-reached-name c) (harness-stub-reached-source c)))))
(defun harness-stub-reached (name source)
  (format *error-output* "harness: host function ~(~a~) (~a) was reached; this harness neither stubs nor extracts it~%"
          name source)
  (finish-output *error-output*)
  (error 'harness-stub-reached :name name :source source))
(defun fnn-extent-window-cancel (worker token)
  (declare (ignorable worker token))
  (harness-stub-reached 'fnn-extent-window-cancel "host/native/extent.lisp"))
(defun fnn-owner-cold-window-result-locked (service read)
  (declare (ignorable service read))
  (harness-stub-reached 'fnn-owner-cold-window-result-locked "host/native/owner.lisp"))
;;; ---- derived stubs: END ----
(defun fn-cbor-ag-car (x) (if (consp x) (car x) nil))
(defun fn-cbor-ag-cdr (x) (if (consp x) (cdr x) nil))
(defun fn-octetp (x) (fn-cbor-octetp x))
(defun digit-to-char (n) (digit-char n))
(defun fn-arena-count (arena) (length arena))
(defun fn-arena-payload-len (h arena) (length (nth h arena)))
(defun fn-arena-get (h at arena) (aref (nth h arena) at))
(defun fn-article-payload (article) (second article))
(defun fn-article-msgid (article) (first article))
;; ACL2 primitive the shared article source now calls (books/article-stream.lisp).
(defun member-eq (x l) (member x l :test (function eq)))
(defun fn-nntp-article-bytes (article arena)
  (coerce (nth (fn-article-payload article) arena) 'list))
(defparameter *article-source-root* (or (sb-ext:posix-getenv "FN_WEB_ARTICLE_SOURCE_ROOT") "."))
(defun shared-article-source (relative) (format nil "~a/~a" *article-source-root* relative))
(load-page-forms "books/nov-decimal-window.lisp" '(fn-nbw-decimal-tick))
(load-page-forms "books/nov-piece-window.lisp" '(fn-npw-one))
(load-page-forms "books/nntp-article-pass.lisp" '(fn-nntp-block-rev))
(load-page-forms "books/served-plan-shape.lisp" '(fn-splan-cur fn-splan-rest))
(load-page-forms "books/served-plan.lisp" '(fn-splan-rest-donep))
(load-page-forms (shared-article-source "books/article-stream.lisp"))
(load-page-forms (shared-article-source "books/article-stream-owner.lisp")
                 '(fn-asto-plan-render-step fn-asto-plan-render-window))
(let* ((payload (append (article-octets '("Subject: dense dots &" "From: Wren <wren@fn>"
                                         "Date: now" "Newsgroups: fn.test" "Message-ID: <m@fn>" ""))
                        (loop repeat 5000 append '(46 13 10))))
       (article '("<m@fn>" 0)) (arena (list (fnn-octets payload)))
       (scan (fn-ast-preflight (fn-ast-source article arena)))
       (group (article-octets '("211 1 1 1 fn.test")))
       (status (article-octets '("220 1 <m@fn> article follows")))
       (xs (append group status (revappend (fn-nntp-block-rev payload t nil) '(46 13 10))))
       (login (fn-wrq-oct "wren")) (session (list nil nil login (fn-wrq-oct "csrf")))
       (ctx (append (list (list :request :get)) (make-list 8) (list session :auto)))
       (flow (list :article :article ctx (list (fn-wrq-oct "fn.test"))))
       (config (list :web-config (fn-wrq-oct "fn") nil nil 600 16))
       (in (create-fn-octets$c)))
  (loop until (fn-ast-scan-donep scan) do
    (setf scan (fn-ast-scan-step scan 256 arena)))
  (assert (fn-ast-scan-validp scan))
  (fnn-web-fill in (fnn-octets xs))
  (let* ((view (fn-wss-article-view (+ (length group) (length status)) (- (length xs) 3) login in))
         (reference (fn-wr-seq
                     (fn-wr-frame (fn-wrq-oct "fn.test") (fn-wrq-oct "fn") :auto login
                       (fn-wss-s-csrf session)
                       (fn-wr-article-main (fn-wrq-oct "fn.test") (first view) (second view)
                                           (third view) (fourth view))) xs))
         (ready (fn-ast-ready scan :article 1 article nil nil))
         (plan (cons :fixture-group-prefix (cons nil (list (list :article-cursor ready)))))
         (entry (if (sb-ext:posix-getenv "FN_WEB_ARTICLE_LEGACY_WORK")
                    #'fn-asto-plan-render-step #'fn-asto-plan-render-window)))
    (native-stream-consumer xs flow config reference 63 300
      (lambda (p)
        (if (eq (car p) :fixture-group-prefix)
            (values (fnn-octets group) (cdr p) nil nil nil)
          (multiple-value-bind (word bytes next done) (funcall entry p 4096 arena)
            (assert (eq word :article))
            (assert (<= (length bytes) 4096))
            (values (fnn-octets bytes) next done (and (null bytes) (not done)) nil))))
      plan)))
(format t "NATIVE WEB SHARED ARTICLE PRODUCER RAW PASS: actual dense-dot byte-window through scan/replay/count/partial HTTP drain~%")

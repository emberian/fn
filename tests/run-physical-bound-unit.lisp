; UNEXECUTED narrow shared-engine control over the production stobj types.
; The post-source fullRef/owner binding and boot-layout admission are explicit
; SYNTHETIC premises. Catalog/archive/selected authority, whole-core dispatch,
; persistent write/fence acceptance, and reclamation closure are not subjects.
; The actual writer, B3/format verifier, bound issue/step, pool/ops/pins and
; completion observer are subjects. No alternate core, hash or parser is used.
(in-package "ACL2")
(include-book "../books/run-physical-bound-step")
(include-book "../books/runs-served")
(include-book "std/util/bstar" :dir :system)

(defconst *fn2-rpb-hash-row* (+ 1 *fn2-fc-previous-seal*))
(assert-event (< *fn2-rpb-hash-row* *fn2-digest-stride*))
(defconst *fn2-rpb-stobjs*
 '(fn2-run-loads fn2-run-load-ops fn2-run-cursors fn2-run-writers fn2-run-restarts
   fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-boot-config
   fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-digests))
(defmacro fn2-rpb-defun (name args body)
 `(defun ,name ,(append args *fn2-rpb-stobjs*)
   (declare (xargs :stobjs ,*fn2-rpb-stobjs* :verify-guards nil)) ,body))
(defmacro fn2-rpb-mv (&rest values) `(mv ,@values ,@*fn2-rpb-stobjs*))
(defun fn2-rpb-nest (n stobjs body)
 (declare (xargs :verify-guards nil :measure (nfix n)))
 (if (zp n) body
  (let ((held (take n stobjs)))
   (fn2-rpb-nest (- n 1) stobjs
    `(with-local-stobj ,(nth (- n 1) stobjs)
      (mv-let (answer ,@held) ,body
       ,(if (equal n 1) 'answer `(mv answer ,@(take (- n 1) stobjs)))))))))
(defmacro fn2-rpb-with (body)
 (fn2-rpb-nest (len *fn2-rpb-stobjs*) *fn2-rpb-stobjs* body))

(fn2-rpb-defun fn2-rpb-init ()
 (b* ((fn2-run-loads (fn2-run-loads-init 1 fn2-run-loads))
      (fn2-run-loads (fn2-run-loads-set-checker 0 1 fn2-run-loads))
      (fn2-run-load-ops (fn2-run-load-ops-init (fn2-profile-o *fn2-profile-tiny*) fn2-run-load-ops))
      (fn2-run-cursors (fn2-run-cursors-init 1 fn2-run-cursors))
      (fn2-run-writers (fn2-run-writers-init 1 fn2-run-writers))
      (fn2-run-restarts (fn2-run-restarts-init *fn2-run-restart-capacity* fn2-run-restarts))
      (fn2-extents (fn2-alloc-init 1 fn2-extents))
      (fn2-alloc-edges (fn2-alloc-edges-init (+ 6 2 (fn2-profile-o *fn2-profile-tiny*)) fn2-alloc-edges))
      (fn2-pool (fn2-pool-init '((2 . 64) (3 . 4096) (3 . 65536)) 1 100 fn2-pool))
      (fn2-ops (fn2-ops-init *fn2-profile-tiny* fn2-ops))
      (fn2-control (fn2-control-init *fn2-profile-tiny* fn2-control))
      (fn2-boot-config (fn2-boot-config-empty 0 fn2-boot-config))
      (fn2-boot-config (update-fn2-boot-config-checkpoint-layout-ready 1 fn2-boot-config))
      (fn2-fc (fn2-fc-init 2 fn2-fc)) (fn2-fc-context (fn2-fc-context-init 2 fn2-fc-context))
      (fn2-b3 (fn2-b3-table-init 2 fn2-b3)) (fn2-fields (fn2-fields-init 512 fn2-fields))
      (fn2-digests (fn2-digests-init (* 2 *fn2-digest-stride*) fn2-digests))
      ((mv code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv reserved & e ep al fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv allocated fn2-extents) (fn2-alloc-commit-allocation e ep al 1 1 fn2-extents)))
  (fn2-rpb-mv (and (eq code :ok) (eq reserved :ok) (eq allocated :ok)) e ep al)))

; The page is built and checked by the real production overview codecs.
; The source line and destination page have checked owned windows.
(fn2-rpb-defun fn2-rpb-open (unit epoch allocation)
 (b* (((mv a page gen fn2-pool) (fn2-pool-reserve 2 9 0 1 fn2-pool))
      ((mv b src sgen fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv c fn2-pool) (fn2-pool-write src sgen 0 65 9 0 1 fn2-pool))
      ((unless (and (eq a :ok) (eq b :ok) (eq c :ok))) (fn2-rpb-mv :window 0 0))
      (fn2-fields (fn2-fields-put (+ 200 *fn2-overview-entry-field-group*) (value 1) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ 200 *fn2-overview-entry-field-number*) (value 1) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ 200 *fn2-overview-entry-field-article*) (value 101) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ 200 *fn2-overview-entry-field-position*) (value 1) (ref-len 0)))
      (fn2-fields (fn2-fields-put (+ 200 *fn2-overview-entry-field-line*) (ref-slot src) (ref-gen sgen) (ref-off 0) (ref-len 1)))
      ((mv code fn2-run-writers fn2-pool)
       (fn2-run-open 0 page gen 3 1 0 7 0 *page-kind-run-data* unit epoch allocation 1 1 9 0 1 0 *fn2-run-page-size* fn2-run-writers fn2-pool))
      ((unless (eq code :ok)) (fn2-rpb-mv code page gen))
      ((mv code fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)
       (fn2-run-add 0 3 200 fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
      ((unless (eq code :ok)) (fn2-rpb-mv code page gen))
      ((mv code fn2-run-writers) (fn2-run-close 0 fn2-run-writers)))
  (fn2-rpb-mv code page gen)))
(fn2-rpb-defun fn2-rpb-close-drive (fuel)
 (if (zp fuel) (fn2-rpb-mv :fuel)
  (b* (((mv code fn2-run-writers fn2-fields fn2-pool)
        (fn2-run-close-step 0 4096 fn2-run-writers fn2-run-restarts fn2-fields fn2-pool)))
   (if (eq code :more)
    (fn2-rpb-close-drive (- fuel 1) fn2-run-loads fn2-run-load-ops fn2-run-cursors fn2-run-writers fn2-run-restarts
     fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-boot-config fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-digests)
    (fn2-rpb-mv code)))))
(fn2-rpb-defun fn2-rpb-head ()
 (b* (((mv code fn2-run-writers fn2-fields fn2-pool)
       (fn2-run-head 0 fn2-run-writers fn2-run-restarts fn2-fields fn2-pool))
      (fn2-fc-context (fn2-run-seal-context 0 0 *fn2-rpb-hash-row* fn2-run-writers fn2-fc-context))
      ((mv geometry fn2-digests) (fn2-checkpoint-boot-geometry-load (fn2-digest-slot 0 *fn2-fc-geometry*) fn2-boot-config fn2-digests)))
  (fn2-rpb-mv (if (eq geometry :ok) code geometry))))
(fn2-rpb-defun fn2-rpb-seal-drive (fuel)
 (if (zp fuel) (fn2-rpb-mv :fuel)
  (b* (((mv code fn2-run-writers fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
        (fn2-run-seal-step 0 0 *fn2-rpb-hash-row* 4096 fn2-run-writers fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)))
   (if (eq code :more)
    (fn2-rpb-seal-drive (- fuel 1) fn2-run-loads fn2-run-load-ops fn2-run-cursors fn2-run-writers fn2-run-restarts
     fn2-extents fn2-alloc-edges fn2-pool fn2-ops fn2-control fn2-boot-config fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-digests)
    (fn2-rpb-mv code)))))
(fn2-rpb-defun fn2-rpb-check (page gen)
 (b* (((mv code fn2-fc fn2-b3 fn2-fields fn2-pool fn2-digests)
       (fn2-format-drive (fn2-format-fuel *fn2-run-page-size*) 0 :page nil page gen 0 *fn2-run-page-size* 0 9 0 1 4096
        fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-pool fn2-digests)))
  (fn2-rpb-mv code)))

; Exactly the caller-side post-source binding premise. No checked/complete
; flag is set: both objects begin at READ/MISS and the page is empty.
; A corrupt-hash control changes only the reference hash; the disk page
; remains the canonical page computed by the real producer and verifier.
(fn2-rpb-defun fn2-rpb-synthetic-bind (unit epoch allocation bad-hash)
 (b* (((mv code fn2-run-loads fn2-pool) (fn2-run-load-reserve 0 9 0 1 fn2-run-loads fn2-pool))
      ((unless (eq code :ok)) (fn2-rpb-mv code))
      (fn2-run-loads (fn2-run-loads-put 0 (phase *fn2-run-load-phase-read*) (source 0) (tag 1)
       (unit unit) (epoch epoch) (allocation allocation) (schema 3) (run 7) (level 0) (history 1) (incarnation 1)
       (sector 0) (copied 0) (pending 0)
       (hash-0 (if bad-hash (logxor 1 (fn2-digest-word *fn2-rpb-hash-row* 0 fn2-digests)) (fn2-digest-word *fn2-rpb-hash-row* 0 fn2-digests)))
       (hash-1 (fn2-digest-word *fn2-rpb-hash-row* 1 fn2-digests))
       (hash-2 (fn2-digest-word *fn2-rpb-hash-row* 2 fn2-digests))
       (hash-3 (fn2-digest-word *fn2-rpb-hash-row* 3 fn2-digests))
       (hash-4 (fn2-digest-word *fn2-rpb-hash-row* 4 fn2-digests))
       (hash-5 (fn2-digest-word *fn2-rpb-hash-row* 5 fn2-digests))
       (hash-6 (fn2-digest-word *fn2-rpb-hash-row* 6 fn2-digests))
       (hash-7 (fn2-digest-word *fn2-rpb-hash-row* 7 fn2-digests))
      ))
      (fn2-run-cursors (fn2-run-cursors-put 0 (phase *fn2-run-cursor-phase-miss*) (physical 1) (source-row 0) (catalog-tag 1)
       (unit unit) (epoch epoch) (counter allocation) (schema 3) (run 7) (level 0) (top 0) (slot *fn2-none*) (gen 0)
       (okind 9) (oslot 0) (ogen 1) (rb 256) (resume-child 0)
       (hash-0 (fn2-run-load-word 0 0 fn2-run-loads))
       (hash-1 (fn2-run-load-word 0 1 fn2-run-loads))
       (hash-2 (fn2-run-load-word 0 2 fn2-run-loads))
       (hash-3 (fn2-run-load-word 0 3 fn2-run-loads))
       (hash-4 (fn2-run-load-word 0 4 fn2-run-loads))
       (hash-5 (fn2-run-load-word 0 5 fn2-run-loads))
       (hash-6 (fn2-run-load-word 0 6 fn2-run-loads))
       (hash-7 (fn2-run-load-word 0 7 fn2-run-loads))
      )))
  (fn2-rpb-mv (if (fn2-run-load-boundp 0 fn2-run-loads fn2-run-cursors) :bound :mismatch))))


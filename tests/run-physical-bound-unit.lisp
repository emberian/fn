(defun fn2-rpb-input-copy (n at source sgen source-off slot gen op ogen fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix n)))
 (if (zp n) (mv :ok fn2-pool)
  (b* (((mv code byte) (fn2-pool-read source sgen (+ source-off at) 9 0 1 fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-pool))
       ((mv code fn2-pool) (fn2-pool-adapter-write slot gen op ogen at byte fn2-pool))
       ((unless (eq code :ok)) (mv code fn2-pool)))
   (fn2-rpb-input-copy (- n 1) (+ at 1) source sgen source-off slot gen op ogen fn2-pool))))

; This driver uses the actual lower harvest primitives in the same order
; as FN2-HARVEST-ONE: validation, pool handback, actual hooks, then finish.
; It is not a second core/observer implementation and exports no served API.
(fn2-rpb-defun fn2-rpb-complete (op gen source sgen unit epoch allocation stale)
 (b* (((mv queued qop qgen) (fn2-outbox-peek 0 fn2-ops))
      ((unless (and (eq queued :ok) (= qop op) (= qgen gen) (fn2-op-slotp op fn2-ops))) (fn2-rpb-mv nil))
      ((mv slot pgen off len) (fn2-op-range op fn2-ops))
      ((mv storage fua) (fn2-op-storage op fn2-ops))
      (edge (fn2-b-read-pin-edge op fn2-extents))
      ((unless (and (= (fn2-ops-kind op fn2-ops) *fn2-action-read*) (= off 0) (= len *fn2-commit-unit-bytes*) (= fua 0)
                    (<= (* unit *fn2-commit-unit-bytes*) storage)
                    (<= (+ storage len) (* (+ unit *fn2-storage-extent-units*) *fn2-commit-unit-bytes*))
                    (= (mod storage *fn2-commit-unit-bytes*) 0)
                    (= (fn2-extents-outstanding-io 0 fn2-extents) 1)
                    (fn2-alloc-edge-slotp edge fn2-alloc-edges)
                    (fn2-alloc-edge-matchesp edge gen 0 epoch allocation :outstanding-io fn2-alloc-edges)
                    (= (fn2-run-loads-pending 0 fn2-run-loads) 1))) (fn2-rpb-mv nil))
      ((mv copied fn2-pool) (fn2-rpb-input-copy len 0 source sgen (- storage (* unit *fn2-commit-unit-bytes*))
                             slot pgen op gen fn2-pool))
      ((unless (eq copied :ok)) (fn2-rpb-mv nil))
      ((mv ack fn2-ops) (fn2-outbox-ack 1 fn2-ops))
      ((unless (eq ack :ok)) (fn2-rpb-mv nil))
      ; Stale completion is filtered by the real posted-result path before
      ; either hook runs; the live pin/input loan/pending bit must remain.
      (fn2-ops (if stale (fn2-post-result 0 op (+ gen 1) *fn2-event-read-result* *fn2-outcome-done* *fn2-reason-none* len 0 0 fn2-ops) fn2-ops))
      ((mv stray & & & fn2-ops) (if stale (fn2-harvest-next fn2-ops) (mv nil 0 0 0 fn2-ops)))
      ((unless (and (not stray) (= (fn2-run-loads-pending 0 fn2-run-loads) 1)
                    (= (fn2-extents-outstanding-io 0 fn2-extents) 1)
                    (eq (fn2-pool-input-code slot pgen op gen fn2-pool) :ok))) (fn2-rpb-mv nil))
      (fn2-ops (fn2-post-result 0 op gen *fn2-event-read-result* *fn2-outcome-done* *fn2-reason-none* len 0 0 fn2-ops))
      ((mv found hop hgen cell fn2-ops) (fn2-harvest-next fn2-ops))
      ((unless (and (eq found t) (= hop op) (= hgen gen) (= cell 0))) (fn2-rpb-mv nil))
      ((mv posted harvested ev outcome reason count aux0 aux1) (fn2-op-cell cell hop fn2-ops))
      ((unless (and (= posted 1) (= harvested 1) (= ev *fn2-event-read-result*) (= outcome *fn2-outcome-done*)
                    (= reason *fn2-reason-none*) (= count *fn2-commit-unit-bytes*))) (fn2-rpb-mv nil))
      ((mv returned fn2-pool) (fn2-pool-complete-in slot pgen hop hgen count fn2-pool))
      ((unless (eq returned :ok)) (fn2-rpb-mv nil))
      ((mv unpinned fn2-extents fn2-alloc-edges) (fn2-b-read-pin-harvest hop hgen cell ev outcome reason count aux0 aux1 fn2-extents fn2-alloc-edges))
      ((mv observed fn2-run-loads fn2-run-load-ops) (fn2-run-load-harvest hop hgen cell ev outcome reason count aux0 aux1 fn2-run-loads fn2-run-load-ops))
      ((mv finished fn2-ops) (fn2-op-finish hop hgen fn2-ops)))
  (fn2-rpb-mv (and (eq unpinned :ok) (eq observed :ok) (member-eq finished '(:ok :retired))
                   (= (fn2-extents-outstanding-io 0 fn2-extents) 0)
                   (= (fn2-alloc-edges-state edge fn2-alloc-edges) *fn2-alloc-edge-state-free*)
                   (= (fn2-run-loads-pending 0 fn2-run-loads) 0)
                   (= (fn2-run-loads-phase 0 fn2-run-loads) *fn2-run-load-phase-copy*)
                   (= (fn2-run-load-ops-live hop fn2-run-load-ops) 0)
                   (eq (fn2-pool-workspace-code slot pgen 9 0 1 fn2-pool) :ok)
                   (= (fn2-pool-fill slot fn2-pool) *fn2-commit-unit-bytes*)))))

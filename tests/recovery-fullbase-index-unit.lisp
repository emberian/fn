; Actual full-base install entry. Candidate classification and chain verification
; below are explicit logical fixture premises, NOT persisted bytes/whole boot.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/assembly")
(include-book "../sim/commit-test-profile")
(include-book "core-snapshot-support")
(defun fn2-rfiu-drive (fuel id gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel nil fn2-core)
  (b* ((before (fn2-test-core-snapshot fn2-core))
       ((mv code fn2-core) (fn2-recovery-install-adopt id gen fn2-core)))
   (if (member-eq code '(:more :active))
    (fn2-rfiu-drive (- fuel 1) id gen fn2-core)
    (mv code (equal before (fn2-test-core-snapshot fn2-core)) fn2-core)))))
(defun fn2-rfiu-rows-p (id gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
             (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (ok)
  (and (fn2-alloc-identity-refines-p fn2-extents)
       (fn2-alloc-identity-owner-p *fn2-recovery-machine-kind* id gen gen fn2-extents)
       (= (fn2-alloc-identity-count fn2-extents) 3)
       (= (fn2-alloc-identity-phase fn2-extents) *fn2-alloc-identity-phase-idle*)
       (= (fn2-alloc-epoch-begun fn2-extents) 0)
       (= (fn2-extents-state 0 fn2-extents) *fn2-extent-state-allocated*)
       (= (fn2-extents-owner-kind 0 fn2-extents) *fn2-commit-kind*)
       (= (fn2-extents-owner-id 0 fn2-extents) 1)
       (= (fn2-extents-installed-root 0 fn2-extents) 1)
       (= (fn2-alloc-edges-extent 7 fn2-alloc-edges) 0)
       (= (fn2-extents-state 1 fn2-extents) *fn2-extent-state-allocated*)
       (= (fn2-extents-owner-kind 1 fn2-extents) 6)
       (= (fn2-extents-owner-id 1 fn2-extents) 13)
       (= (fn2-extents-state 2 fn2-extents) *fn2-extent-state-reserved*)
       (= (fn2-extents-epoch 2 fn2-extents) 0)
       (= (fn2-extents-counter 2 fn2-extents) 2)
       (= (fn2-extents-recovery-candidate 2 fn2-extents) 1)
       (= (fn2-alloc-edges-extent 10 fn2-alloc-edges) 2)) ok))
(defun fn2-rfiu-finish (fuel id fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-recovery-install-finish id fn2-core)
   (if (member-eq code '(:more :active)) (fn2-rfiu-finish (- fuel 1) id fn2-core)
    (mv code fn2-core)))))
(defun fn2-rfiu-body (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((profile (fn2-b-test-profile
               (put-assoc-equal :extent-slots 6
                (put-assoc-equal :pool-classes '((32 . 4096) (32 . 65536)) *fn2-profile-tiny*)) 0))
      (fn2-core (fn2-core-init profile fn2-core))
      (id (fn2-machine-kind-base *fn2-recovery-machine-kind* fn2-core))
      (gen (fn2-machine-generation id fn2-core))
      ((mv prepared fn2-core) (fn2-recovery-prepare id 0 0 fn2-core))
      ((unless (and (eq prepared :ok) (fn2-core-wfp fn2-core))) (mv nil fn2-core))
      ((when (eq mode :empty))
       (b* ((fn2-core (fn2-recovery-machine-put-core id
             (phase *fn2-recovery-machine-state-install*) (rc-stage 2) (stopped 0)
             (rc-class *fn2-rec-class-intact*) (rc-found 0) (rc-high 0) (rc-chain 0)
             (rc-base 0) (rc-base-tag 0)))
            ((mv code fn2-core) (fn2-rfiu-finish 32 id fn2-core))
            (retained (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                                  (fn2-commit-root (fn2-core-commit-root fn2-core))) (ok)
             (and (fn2-alloc-identity-owner-p *fn2-recovery-machine-kind* id gen gen fn2-extents)
                  (fn2-alloc-identity-refines-p fn2-extents)
                  (= (fn2-alloc-identity-count fn2-extents) 0)
                  (= (fn2-alloc-epoch-begun fn2-extents) 0)
                  (= (fn2-commit-root-installed 0 fn2-commit-root) 0)
                  (= (fn2-commit-root-proposed 0 fn2-commit-root) 0)) ok)))
        (mv (and (eq code :ok) retained) fn2-core)))
      (fn2-core (stobj-let ((fn2-rec-cand (fn2-core-rec-cand fn2-core))) (fn2-rec-cand)
       (let* ((fn2-rec-cand (fn2-rec-cand-put 0 (status *fn2-rec-status-chained*) (commit 1) (epoch 7) (allocation 9)))
              (fn2-rec-cand (fn2-rec-cand-put 1 (status *fn2-rec-status-payload*) (commit 1)
               (epoch (if (eq mode :zero-collision) 0 7))
               (allocation (cond ((eq mode :duplicate) 9) ((eq mode :zero-collision) 2) (t 10)))
               (owner-kind 6) (owner 13)))
              (fn2-rec-cand (fn2-rec-cand-put 2 (status *fn2-rec-status-invalid*)))) fn2-rec-cand)
       fn2-core))
      (fn2-core (fn2-recovery-machine-put-core id
       (phase *fn2-recovery-machine-state-install*) (rc-stage 2) (stopped 0)
       (rc-class *fn2-rec-class-intact*) (rc-found 0) (rc-high 3) (rc-base 0) (rc-base-tag 0)))
      (before (fn2-test-core-snapshot fn2-core))
      ((when (eq mode :generation))
       (b* (((mv code fn2-core) (fn2-recovery-install-adopt id (+ 1 gen) fn2-core)))
        (mv (and (eq code :state) (equal before (fn2-test-core-snapshot fn2-core))) fn2-core)))
      ((mv first & fn2-core) (fn2-rfiu-drive 32 id gen fn2-core))
      ((unless (eq first :adopted)) (mv nil fn2-core))
      (fn2-core (fn2-recovery-machine-put-core id (rc-found 1)))
      ((when (eq mode :edge))
       (b* (((mv held fn2-core)
             (stobj-let ((fn2-extents (fn2-core-extents fn2-core))
                         (fn2-alloc-edges (fn2-core-alloc-edges fn2-core)))
              (code fn2-extents fn2-alloc-edges)
              (fn2-alloc-edge-add 8 23 0 7 9 :promised-read fn2-extents fn2-alloc-edges)
              (mv code fn2-core)))
            ((unless (eq held :ok)) (mv nil fn2-core))
            ; Make row1 a quarantined candidate to require that occupied edge.
            (fn2-core (stobj-let ((fn2-rec-cand (fn2-core-rec-cand fn2-core))) (fn2-rec-cand)
                       (fn2-rec-cand-set-status 1 *fn2-rec-status-invalid* fn2-rec-cand) fn2-core))
            (before (fn2-test-core-snapshot fn2-core))
            ((mv code fn2-core) (fn2-recovery-install-adopt id gen fn2-core)))
        (mv (and (eq code :bounds) (equal before (fn2-test-core-snapshot fn2-core))) fn2-core)))
      ((mv second same fn2-core) (fn2-rfiu-drive 32 id gen fn2-core))
      ((when (eq mode :duplicate)) (mv (and (eq second :conflict) same) fn2-core))
      ((unless (eq second :adopted)) (mv nil fn2-core))
      (fn2-core (fn2-recovery-machine-put-core id (rc-found 2)))
      ((mv third same fn2-core) (fn2-rfiu-drive 32 id gen fn2-core)))
  (mv (if (eq mode :zero-collision) (and (eq third :conflict) same)
         (and (eq third :adopted) (fn2-core-wfp fn2-core) (fn2-rfiu-rows-p id gen fn2-core))) fn2-core)))
(defun fn2-rfiu-run (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-rfiu-body mode fn2-core) ok)))
(assert-event (fn2-rfiu-run :success))
(assert-event (fn2-rfiu-run :duplicate))
(assert-event (fn2-rfiu-run :zero-collision))
(assert-event (fn2-rfiu-run :generation))
(assert-event (fn2-rfiu-run :edge))

(assert-event (fn2-rfiu-run :empty))

; Actual epoch selection, with explicit synthetic completed-recovery antecedent.
; Persisted anchor evidence is not manufactured by this function-level control.
(defun fn2-rfiu-epoch (mode fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      (rid (fn2-machine-kind-base *fn2-recovery-machine-kind* fn2-core))
      (fn2-core (fn2-recovery-machine-put-core rid
       (phase (if (eq mode :unfinished) *fn2-recovery-machine-state-install* *fn2-recovery-machine-state-done*))
       (rc-class *fn2-rec-class-intact*)
       (rc-epoch (if (eq mode :overflow) (- (expt 2 60) 1) 9))))
      (fn2-core (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (fn2-extents)
       (update-fn2-alloc-current-epoch (if (eq mode :allocator) 11 0) fn2-extents) fn2-core))
      (before (fn2-test-core-snapshot fn2-core))
      ((mv code epoch) (fn2-boot-select-epoch
       (cond ((eq mode :allocator) 10) ((eq mode :ahead) 2) ((eq mode :overflow) (- (expt 2 60) 1)) (t 8))
       (cond ((eq mode :allocator) 11) ((eq mode :ahead) 3) ((eq mode :overflow) (- (expt 2 60) 1)) (t 9)) fn2-core)))
  (mv (and (equal before (fn2-test-core-snapshot fn2-core))
       (if (member-eq mode '(:unfinished :overflow :ahead)) (and (eq code :bounds) (= epoch 0))
        (and (fn2-recovery-idp rid fn2-core) (eq (fn2-boot-recovered fn2-core) :ok)
             (eq code :ok) (= epoch (if (eq mode :allocator) 12 10))))) fn2-core)))
(defun fn2-rfiu-epoch-run (mode)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-rfiu-epoch mode fn2-core) ok)))
(assert-event (fn2-rfiu-epoch-run :recovered))
(assert-event (fn2-rfiu-epoch-run :allocator))
(assert-event (fn2-rfiu-epoch-run :unfinished))
(assert-event (fn2-rfiu-epoch-run :overflow))

(assert-event (fn2-rfiu-epoch-run :ahead))

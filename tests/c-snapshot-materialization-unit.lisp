(in-package "ACL2")
(include-book "retirement-live-unit")
(include-book "c-snapshot-unit")
(include-book "storage-write-pins-unit")

(defun fn2-csm-args (n fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix n)))
 (if (zp n) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-successor-arg 0 0 (- n 1) :value 1 fn2-core)
   (if (not (eq code :ok)) (mv code fn2-core)
    (fn2-csm-args (- n 1) fn2-core)))))
(defun fn2-csm-resolve (fuel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-successor-resolve 0 4096 fn2-core)
   (if (eq code :more) (fn2-csm-resolve (- fuel 1) fn2-core) (mv code fn2-core)))))

; The real B writer publishes a real C member, but its fixture owner delays
; taking the accepted result. No phase, root frontier or readiness flag is
; planted. Materialization uses the same allocation commit and C release as
; txn :batched/:reply; this controls cut readiness, not payload identity proof.
(defun fn2-csm-body (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((profile (fn2-b-test-profile (put-assoc-equal :identity-arena-bytes 4096 *fn2-profile-tiny*) 0))
      (fn2-core (fn2-core-init profile fn2-core))
      (fn2-sim (fn2-sim-init 1 :none "snapshot-materialization" profile fn2-sim))
      (fn2-own (fn2-own-init profile fn2-own))
      (owner (fn2-machine-kind-base *fn2-scribe-kind* fn2-core))
      (ogen (fn2-machine-generation owner fn2-core))
      ((mv reserved extent epoch allocation fn2-core) (fn2-write-pin-test-reserve fn2-core))
      ((mv pool ws wg fn2-core) (fn2-core-reserve 2 *fn2-scribe-kind* owner ogen fn2-core))
      ((mv put fn2-core) (fn2-successor-put 0 0 *fn2-addr-sid* :insert fn2-core))
      ((mv args fn2-core) (fn2-csm-args 5 fn2-core))
      ((mv resolved fn2-core) (fn2-csm-resolve 40 fn2-core))
      ((mv staged & fn2-core) (fn2-successor-stage 0 fn2-core))
      ((mv encoded len fn2-core) (fn2-successor-emit 0 ws wg 0 4096 *fn2-scribe-kind* owner ogen fn2-core))
      ((mv admitted batch event fn2-core)
       (fn2-commit-admit-txn ws wg len *fn2-scribe-kind* owner ogen fn2-core))
      ((mv bound fn2-core) (fn2-successor-bind 0 batch event fn2-core))
      ((unless (and reserved (eq pool :ok) (eq put :ok) (eq args :ok) (eq resolved :ok)
                    (eq staged :ok) (eq encoded :ok) (eq admitted :ok) (eq bound :ok)))
       (mv nil fn2-core fn2-sim fn2-own))
      ((mv begun token fn2-core) (fn2-csnapshot-begin 7 0 1 fn2-core))
      ((mv fn2-core fn2-sim fn2-own) (fn2-retirement-live-drive 600 26 fn2-core fn2-sim fn2-own))
      (published (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (phase)
                   (fn2-succ-txns-phase 0 fn2-succ-txns) phase))
      ((mv waiting & & fn2-core) (fn2-csu-poll 20 token fn2-core))
      ((mv wrong & & fn2-core) (fn2-csnapshot-poll token 7 0 2 fn2-core))
      (still-reserved (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (phase)
                        (= (fn2-extents-state extent fn2-extents) *fn2-extent-state-reserved*) phase))
      ; Consume actual acceptance, then materialize and release exactly as the
      ; transaction owner does before it can disappear on a dropped reply.
      ((mv taken got-batch got-event outcome fn2-core)
       (fn2-commit-take *fn2-scribe-kind* owner ogen fn2-core))
      ((mv materialized fn2-core) (fn2-upload-extent-commit extent epoch allocation event fn2-core))
      ((mv released fn2-core) (fn2-successor-release 0 fn2-core))
      ((mv held cut cut-event fn2-core) (fn2-csu-poll 20 token fn2-core))
      ((mv thawed fn2-core) (fn2-csnapshot-release token 7 0 1 fn2-core))
      ((mv again next-token fn2-core) (fn2-csnapshot-begin 7 0 1 fn2-core))
      (fn2-core (fn2-core-stop *fn2-stop-reason-machine-phase* fn2-core))
      ((mv stopped & & fn2-core) (fn2-csnapshot-poll next-token 7 0 1 fn2-core))
      ((mv cannot-begin & fn2-core) (fn2-csnapshot-begin 7 0 1 fn2-core)))
  (mv (and (eq begun :ok) (= published *fn2-succ-phase-published*)
           (eq waiting :fuel) (eq wrong :owner) still-reserved
           (eq taken :ok) (= got-batch batch) (= got-event event)
           (= outcome *fn2-commit-outcome-accepted*) (eq materialized :ok) (eq released :ok)
           (eq held :held) (= cut batch) (= cut-event event) (eq thawed :ok)
           (eq again :ok) (< token next-token) (eq stopped :stopped) (eq cannot-begin :stopped))
      fn2-core fn2-sim fn2-own)))
(defun fn2-csm-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core)
   (with-local-stobj fn2-sim
    (mv-let (answer fn2-core fn2-sim)
     (with-local-stobj fn2-own
      (mv-let (answer fn2-core fn2-sim fn2-own) (fn2-csm-body fn2-core fn2-sim fn2-own)
       (mv answer fn2-core fn2-sim)))
     (mv answer fn2-core)))
   answer)))
(assert-event (fn2-csm-test))

; Prepared source only, not executed. These are explicit synthetic post-preview
; sizing inputs to the ACTUAL per-turn planner, not a witness that a C source
; produced this many pages. The actual two-pass codec witness is separate.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-planning-schedule")

(defconst *fn2-cpsu-extents*
 (+ (* *fn2-checkpoint-allocation-records-per-ticket* *fn2-checkpoint-arena-slots*) *fn2-checkpoint-arena-slots* 4))
(defconst *fn2-cpsu-maps* (fn2-checkpoint-map-page-count *fn2-cpsu-extents* *fn2-checkpoint-map-slots*))
; base + maps + first arena = exactly R*A. The first ticket update crosses
; the real arena packing boundary; its extra arena forces a second update.
(defconst *fn2-cpsu-root1*
 (- (* *fn2-checkpoint-allocation-records-per-ticket* *fn2-checkpoint-arena-slots*) *fn2-cpsu-maps* 4))

(defun fn2-cpsu-body (fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents fn2-commit-root)
 (declare (xargs :stobjs (fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents fn2-commit-root) :verify-guards nil))
 (b* ((fn2-checkpoint-planning (fn2-checkpoint-planning-init 1 fn2-checkpoint-planning))
      (fn2-checkpoint-recipe (fn2-checkpoint-recipe-init 0 fn2-checkpoint-recipe))
      (fn2-checkpoint-recipe-order (fn2-checkpoint-recipe-order-init 0 fn2-checkpoint-recipe-order))
      (fn2-csnapshot (fn2-csnapshot-init 1 fn2-csnapshot))
      (fn2-extents (fn2-alloc-init *fn2-cpsu-extents* fn2-extents))
      (fn2-commit-root (fn2-commit-root-init (+ *fn2-cpsu-extents* 1) fn2-commit-root))
      ((mv epoch fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv snapshot fn2-extents) (fn2-alloc-snapshot-prepare 7 9 0 1 fn2-extents))
      ((mv descriptor & e ep al fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv begun fn2-extents) (fn2-alloc-planning-begin 7 9 0 1 1 1 1 fn2-extents))
      (fn2-csnapshot (fn2-csnapshot-put 0 (phase *fn2-csnapshot-phase-held*) (token 7) (owner-kind 9) (owner-slot 0) (owner-gen 1)))
      ; Synthetic arithmetic antecedent, no SEALED/completion cursor is set.
      (fn2-checkpoint-planning (fn2-checkpoint-planning-put 0 (phase *fn2-checkpoint-planning-phase-size*)
       (candidate 0) (token 7) (owner-kind 9) (owner-slot 0) (owner-gen 1) (epoch 1)
       (first-free 1) (first-counter 1) (root1-count *fn2-cpsu-root1*) (event-pages 1) (map-pages *fn2-cpsu-maps*) (tickets 1)))
      ((mv first fn2-checkpoint-planning) (fn2-checkpoint-planning-size-step 0 7 9 0 1 fn2-checkpoint-planning fn2-csnapshot fn2-extents fn2-commit-root))
      (tickets1 (fn2-checkpoint-planning-tickets 0 fn2-checkpoint-planning))
      ((mv second fn2-checkpoint-planning) (fn2-checkpoint-planning-size-step 0 7 9 0 1 fn2-checkpoint-planning fn2-csnapshot fn2-extents fn2-commit-root))
      (tickets2 (fn2-checkpoint-planning-tickets 0 fn2-checkpoint-planning))
      ((mv third fn2-checkpoint-planning) (fn2-checkpoint-planning-size-step 0 7 9 0 1 fn2-checkpoint-planning fn2-csnapshot fn2-extents fn2-commit-root))
      ; Explicit invalid unrelated directory mutation premise: the live
      ; phase3 commit paths must refuse it; the planner never trusts it.
      (fn2-commit-root (fn2-commit-root-set-proposed 0 1 fn2-commit-root))
      ((mv changed fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order)
       (fn2-checkpoint-planning-append-step 0 7 9 0 1 fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents fn2-commit-root))
      (fn2-commit-root (fn2-commit-root-init (+ *fn2-checkpoint-arena-slots* 2) fn2-commit-root))
      ((mv short fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order)
       (fn2-checkpoint-planning-append-step 0 7 9 0 1 fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents fn2-commit-root))
      ((mv stale fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order)
       (fn2-checkpoint-planning-append-step 0 7 9 0 2 fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents fn2-commit-root)))
  (mv (and (posp *fn2-cpsu-root1*) (eq epoch :ok) (eq snapshot :ok) (eq descriptor :ok) (equal (list e ep al) '(0 1 0)) (eq begun :ok)
           (eq first :more) (equal tickets1 (+ *fn2-checkpoint-arena-slots* 1))
           (eq second :more) (equal tickets2 (+ *fn2-checkpoint-arena-slots* 2)) (eq third :sized)
           (equal (fn2-checkpoint-planning-arena-pages 0 fn2-checkpoint-planning) 2)
           (eq changed :directory-cut) (eq short :directory-no-space) (eq stale :owner)
           (equal (fn2-checkpoint-planning-phase 0 fn2-checkpoint-planning) *fn2-checkpoint-planning-phase-append*)
           (equal (fn2-alloc-freeze-phase fn2-extents) 3) (equal (fn2-alloc-free-head fn2-extents) 1)
           (equal (fn2-alloc-next-counter fn2-extents) 1) (equal (fn2-alloc-total-reserved fn2-extents) 1)
           (equal (fn2-checkpoint-recipe-rows fn2-checkpoint-recipe) 0) (equal (fn2-checkpoint-recipe-order-rows fn2-checkpoint-recipe-order) 0))
      fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents fn2-commit-root)))
(defun fn2-cpsu-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoint-planning (mv-let (answer fn2-checkpoint-planning)
  (with-local-stobj fn2-checkpoint-recipe (mv-let (answer fn2-checkpoint-planning fn2-checkpoint-recipe)
   (with-local-stobj fn2-checkpoint-recipe-order (mv-let (answer fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order)
    (with-local-stobj fn2-csnapshot (mv-let (answer fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot)
     (with-local-stobj fn2-extents (mv-let (answer fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents)
      (with-local-stobj fn2-commit-root (mv-let (answer fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents fn2-commit-root)
       (fn2-cpsu-body fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents fn2-commit-root)
       (mv answer fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot fn2-extents)))
      (mv answer fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order fn2-csnapshot)))
     (mv answer fn2-checkpoint-planning fn2-checkpoint-recipe fn2-checkpoint-recipe-order)))
    (mv answer fn2-checkpoint-planning fn2-checkpoint-recipe)))
   (mv answer fn2-checkpoint-planning))) answer)))
(assert-event (fn2-cpsu-run))

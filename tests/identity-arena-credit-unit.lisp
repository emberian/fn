; Actual C spare creation and sealer return. Synthetic small prefix quotas
; isolate this C-slot primitive; this is NOT full profile/checkpoint admission.
; FROZEN below is an explicit sealer-eligible premise, not durable publication.
(in-package "ACL2")
(include-book "../books/machines-c-stage")
(include-book "../books/sealer")
(include-book "pool-credit-unit")
(include-book "../books/checkpoint-working-credit")
(make-event (value `(defconst *fn2-iacu-brows* ,(fn2-machine-property 'fn2-commit :capacity (w state)))))
(defun fn2-iacu-exhaust (k fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix k)))
 (if (zp k) fn2-pool
  (mv-let (code slot gen fn2-pool) (fn2-pool-reserve 0 200 0 1 fn2-pool)
   (declare (ignore slot gen))
   (if (eq code :ok) (fn2-iacu-exhaust (- k 1) fn2-pool) fn2-pool))))
(defun fn2-iacu-body (old fn2-id-engine fn2-overlay-index fn2-overlays fn2-pool)
 (declare (xargs :stobjs (fn2-id-engine fn2-overlay-index fn2-overlays fn2-pool) :verify-guards nil))
 (b* ((fn2-pool (fn2-pool-init '((12 . 4096)) 1 3 fn2-pool))
      (fn2-overlays (fn2-overlays-init 2 fn2-overlays))
      (fn2-overlay-index (fn2-overlay-index-init 4 fn2-overlay-index))
      (fn2-id-engine (fn2-id-engine-init-arena 4096 fn2-id-engine))
      (prefix (cons (cons *fn2-pool-credit-working* '(1))
               (append (fn2-idc-arena-credit-groups 0 '(1))
                (append (fn2-checkpoint-drain-credit-groups *fn2-iacu-brows* '(1))
                        (list (cons *fn2-pool-credit-working* '(1)))))))
      (groups (append prefix (if (eq old t) nil (fn2-idc-arena-credit-groups (fn2-overlays-rows fn2-overlays) '(1)))))
      ((mv cc fn2-pool) (fn2-pool-credit-configure groups fn2-pool))
      ((unless (and (eq cc :ok) (fn2-pool-wfp fn2-pool) (fn2-pool-credit-shapep fn2-pool)))
       (mv nil fn2-id-engine fn2-overlay-index fn2-overlays fn2-pool))
      ((when (eq old t))
       (let ((before (fn2-pcu-view fn2-pool)))
        (mv-let (code fn2-overlays fn2-pool)
         (fn2-idc-add-spare *fn2-iacu-brows* fn2-id-engine fn2-overlays fn2-overlay-index fn2-pool)
         (mv (and (eq code :capacity) (equal before (fn2-pcu-view fn2-pool))
                  (= (fn2-overlays-phase 0 fn2-overlays) *fn2-overlay-phase-free*))
             fn2-id-engine fn2-overlay-index fn2-overlays fn2-pool))))
      (group (fn2-idc-arena-credit-group 0 *fn2-iacu-brows*))
      ; Explicit synthetic exhausted monotone nonce premise, not a claim
      ; that this fixture performed 2^60 actual reservation cycles.
      ((when (eq old :nonce-limit))
       (let* ((fn2-pool (update-fn2-pool-credit-group-noncei group *fn2-u60-max* fn2-pool))
              (before (fn2-pcu-view fn2-pool)))
        (mv-let (code fn2-overlays fn2-pool)
         (fn2-idc-arena-start 0 *fn2-iacu-brows* 4096 0 2 *fn2-idc-owner-kind* *fn2-idc-owner-slot* *fn2-idc-owner-gen*
          fn2-overlays fn2-overlay-index fn2-pool)
         (mv (and (eq code :exhausted) (equal before (fn2-pcu-view fn2-pool))
                  (= (fn2-overlays-phase 0 fn2-overlays) *fn2-overlay-phase-free*))
             fn2-id-engine fn2-overlay-index fn2-overlays fn2-pool))))
      (fn2-pool (fn2-iacu-exhaust (fn2-pool-rows fn2-pool) fn2-pool))
      (antecedent (and (fn2-idc-arena-credit-layout-p 0 *fn2-iacu-brows* 0 fn2-overlays fn2-pool)
                      (= (fn2-pool-reservable-count 0 fn2-pool) 0)))
      (free (fn2-pool-free-count 0 fn2-pool))
      ; Actual ov-start bounds refusal AFTER fresh reservation, no issue path.
      ((mv bad fn2-overlays fn2-pool)
       (fn2-idc-arena-start 0 *fn2-iacu-brows* 4096 (+ 1 (fn2-overlay-index-rows fn2-overlay-index)) 1
        *fn2-idc-owner-kind* *fn2-idc-owner-slot* *fn2-idc-owner-gen* fn2-overlays fn2-overlay-index fn2-pool))
      (unwound (and (eq bad :bounds) (= free (fn2-pool-free-count 0 fn2-pool))
                    (= (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-aborted-empty*)
                    (= (fn2-pool-credit-group-noncei group fn2-pool) 1)
                    (fn2-pool-credit-fullp group 0 fn2-pool)
                    (= (fn2-overlays-phase 0 fn2-overlays) *fn2-overlay-phase-free*)))
      ((mv made fn2-overlays fn2-pool)
       (fn2-idc-add-spare *fn2-iacu-brows* fn2-id-engine fn2-overlays fn2-overlay-index fn2-pool))
      (slot (fn2-overlays-slot 0 fn2-overlays)) (gen (fn2-overlays-gen 0 fn2-overlays))
      (created (and (eq made :ok) (= gen 2)
                    (= (fn2-overlays-phase 0 fn2-overlays) *fn2-overlay-phase-spare*)
                    (= (fn2-pool-credit-group slot fn2-pool) group)
                    (= (fn2-pool-credit-group-noncei group fn2-pool) 1)))
      (before (fn2-pcu-view fn2-pool))
      ((mv stale fn2-pool) (fn2-idc-arena-return-handle 0 *fn2-iacu-brows* slot gen
          *fn2-idc-owner-kind* *fn2-idc-owner-slot* (+ 1 *fn2-idc-owner-gen*) fn2-overlays fn2-pool))
      (stale-refused (and (eq stale :owner) (equal before (fn2-pcu-view fn2-pool))))
      ((mv wrong fn2-pool) (fn2-idc-arena-return-handle 1 *fn2-iacu-brows* slot gen
          *fn2-idc-owner-kind* *fn2-idc-owner-slot* *fn2-idc-owner-gen* fn2-overlays fn2-pool))
      (wrong-refused (and (eq wrong :owner) (equal before (fn2-pcu-view fn2-pool))))
      ; Explicit synthetic FROZEN premise exercises real sealer cleanup only.
      ((mv frozen fn2-overlays) (fn2-ov-advance 0 *fn2-overlay-phase-spare* *fn2-overlay-phase-frozen* fn2-overlays))
      ((mv held fn2-pool) (fn2-pool-query-acquire slot gen 0 0
          *fn2-idc-owner-kind* *fn2-idc-owner-slot* *fn2-idc-owner-gen* fn2-pool))
      (before (fn2-pcu-view fn2-pool))
      ((mv waiting fn2-overlays fn2-pool) (fn2-seal-retire *fn2-iacu-brows* 0 fn2-overlays fn2-pool))
      (retained (and (eq frozen :ok) (eq held :ok) (eq waiting :held)
                    (equal before (fn2-pcu-view fn2-pool))
                    (= (fn2-overlays-phase 0 fn2-overlays) *fn2-overlay-phase-frozen*)))
      ((mv qr last fn2-pool) (fn2-pool-query-release slot gen fn2-pool))
      ((mv released fn2-overlays fn2-pool) (fn2-seal-retire *fn2-iacu-brows* 0 fn2-overlays fn2-pool))
      (rearmed (and (eq qr :ok) last (eq released :ok)
                    (fn2-pool-credit-fullp group 0 fn2-pool)
                    (= (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-idle*)))
      ((mv made2 fn2-overlays fn2-pool)
       (fn2-idc-add-spare *fn2-iacu-brows* fn2-id-engine fn2-overlays fn2-overlay-index fn2-pool))
      ((mv frozen2 fn2-overlays) (fn2-ov-advance 0 *fn2-overlay-phase-spare* *fn2-overlay-phase-frozen* fn2-overlays))
      ((mv retired fn2-overlays fn2-pool) (fn2-seal-retire *fn2-iacu-brows* 0 fn2-overlays fn2-pool))
      (depleted (and (eq made2 :ok) (eq frozen2 :ok) (eq retired :retired)
                     (= (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-depleted*)
                     (= (fn2-pool-credit-group-noncei group fn2-pool) 2)
                     (= (fn2-overlays-phase 0 fn2-overlays) *fn2-overlay-phase-free*)))
      (before (fn2-pcu-view fn2-pool))
      ((mv denied fn2-overlays fn2-pool)
       (fn2-idc-arena-start 0 *fn2-iacu-brows* 4096 0 2 *fn2-idc-owner-kind* *fn2-idc-owner-slot* *fn2-idc-owner-gen*
        fn2-overlays fn2-overlay-index fn2-pool))
      (still-depleted (and (eq denied :exhausted) (equal before (fn2-pcu-view fn2-pool))))
      ((mv other fn2-overlays fn2-pool)
       (fn2-idc-add-spare *fn2-iacu-brows* fn2-id-engine fn2-overlays fn2-overlay-index fn2-pool)))
  (mv (and antecedent unwound created stale-refused wrong-refused retained rearmed depleted still-depleted
           (eq other :ok) (= (fn2-overlays-phase 1 fn2-overlays) *fn2-overlay-phase-spare*)
           (= (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-depleted*))
      fn2-id-engine fn2-overlay-index fn2-overlays fn2-pool)))

(defun fn2-iacu-run (old)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool
  (mv-let (yes fn2-pool)
   (with-local-stobj fn2-overlays
    (mv-let (yes fn2-overlays fn2-pool)
     (with-local-stobj fn2-overlay-index
      (mv-let (yes fn2-overlay-index fn2-overlays fn2-pool)
       (with-local-stobj fn2-id-engine
        (mv-let (yes fn2-id-engine fn2-overlay-index fn2-overlays fn2-pool)
         (fn2-iacu-body old fn2-id-engine fn2-overlay-index fn2-overlays fn2-pool)
         (mv yes fn2-overlay-index fn2-overlays fn2-pool)))
       (mv yes fn2-overlays fn2-pool)))
     (mv yes fn2-pool))) yes)))
(assert-event (fn2-iacu-run nil))
(assert-event (fn2-iacu-run t))
(assert-event (fn2-iacu-run :nonce-limit))

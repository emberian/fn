; Compression instantiates the shared lifecycle and enforces codec policy.
(in-package "ACL2")
(include-book "../books/compress-transport-lifecycle")
(include-book "../books/compress-transport-ops")
(include-book "std/util/bstar" :dir :system)

(defun fn2-compress-ready-control (fn2-compress-transport)
 (declare (xargs :stobjs fn2-compress-transport :verify-guards nil))
 (b* (((mv code fn2-compress-transport)
       (fn2-compress-transport-start 4 5 6 7 3 64 4 8 8 32 fn2-compress-transport))
      ((unless (and (eq code :ok) (= (fn2-compress-transport-budget 0 fn2-compress-transport) 18)
                    (= (fn2-compress-transport-credit 0 fn2-compress-transport) 32)))
       (mv :start fn2-compress-transport))
      ((mv code action offset count serial fn2-compress-transport)
       (fn2-compress-transport-next 0 0 fn2-compress-transport))
      ((unless (equal (list code action offset count) '(:act 8 8 0)))
       (mv :allocation-request fn2-compress-transport))
      ((mv code ?kick fn2-compress-transport)
       (fn2-compress-transport-observe-lifecycle 4 5 6 7 serial 7 0 0 fn2-compress-transport))
      ((unless (eq code :ok)) (mv :allocation-observation fn2-compress-transport))
      ((mv code action offset count serial fn2-compress-transport)
       (fn2-compress-transport-next 0 0 fn2-compress-transport))
      ((unless (equal (list code action offset count) '(:act 1 0 3)))
       (mv :copy-request fn2-compress-transport))
      ((mv code ?kick fn2-compress-transport)
       (fn2-compress-transport-observe-lifecycle 4 5 6 7 serial 3 0 0 fn2-compress-transport))
      ((unless (eq code :ok)) (mv :copy-observation fn2-compress-transport))
      ((mv code ?action ?offset ?count ?serial fn2-compress-transport)
       (fn2-compress-transport-next 0 0 fn2-compress-transport))
      ((unless (eq code :done)) (mv :ready fn2-compress-transport))
      ((mv code copied fed il io ol oo fn2-compress-transport)
       (fn2-compress-transport-handoff 4 5 6 7 fn2-compress-transport)))
  (mv (if (equal (list code copied fed il io ol oo) '(:ok 3 0 0 0 0 0)) :ok :handoff)
      fn2-compress-transport)))

(defun fn2-compress-selected-window-control (fn2-compress-transport)
 (declare (xargs :stobjs fn2-compress-transport :verify-guards nil))
 (b* (((mv code fn2-compress-transport) (fn2-compress-ready-control fn2-compress-transport))
      ((unless (eq code :ok)) (mv code fn2-compress-transport))
      ((unless (and (fn2-compress-transportp fn2-compress-transport)
                    (fn2-compress-transport-wfp fn2-compress-transport)
                    (= (fn2-compress-transport-rows fn2-compress-transport) 1)
                    (equal (fn2-compress-transport-output-offset 0 fn2-compress-transport)
                           (fn2-compress-transport-output-length 0 fn2-compress-transport))))
       (mv :antecedent fn2-compress-transport))
      ((mv code serial fn2-compress-transport)
       (fn2-compress-transport-select-encode 4 5 6 7 0 4 0 fn2-compress-transport))
      ((unless (and (eq code :ok)
                    (= (fn2-compress-transport-request-out-channel 0 fn2-compress-transport) 3)
                    (= (fn2-compress-transport-request-out-offset 0 fn2-compress-transport) 0)
                    (= (fn2-compress-transport-request-out-count 0 fn2-compress-transport) 8)
                    (= (fn2-compress-transport-request-out-extent 0 fn2-compress-transport) 8)))
       (mv :encoder-span fn2-compress-transport))
      ((mv code fn2-compress-transport)
       (fn2-compress-transport-observe-spans 4 5 6 7 serial 0 4 8 0 fn2-compress-transport))
      ((unless (eq code :ok)) (mv :observe fn2-compress-transport))
      (before (list (fn2-compress-transport-rows fn2-compress-transport) (fn2-compress-transport-row-snapshot 0 fn2-compress-transport)))
      ((mv code serial fn2-compress-transport)
       (fn2-compress-transport-select-encode 4 5 6 7 4 4 0 fn2-compress-transport))
      ((unless (and (eq code :need-output) (= serial 0)
                    (equal before (list (fn2-compress-transport-rows fn2-compress-transport) (fn2-compress-transport-row-snapshot 0 fn2-compress-transport)))))
       (mv :must-drain-first fn2-compress-transport))
      ; Duplex decode may write a single application octet while the encoded
      ; send buffer waits for the lower carrier. It does not flush the encoder.
      (fn2-compress-transport (fn2-compress-transport-put 0 (credit 1)))
      ((mv code ?decode-serial fn2-compress-transport)
       (fn2-compress-transport-select-decode 4 5 8 9 0 1 fn2-compress-transport)))
  (mv (and (eq code :ok)
           (= (fn2-compress-transport-request-out-channel 0 fn2-compress-transport) 5)
           (= (fn2-compress-transport-request-out-count 0 fn2-compress-transport) 1)
           (= (fn2-compress-transport-output-length 0 fn2-compress-transport) 8)) fn2-compress-transport)))
(defun fn2-compress-selected-window-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-compress-transport
  (mv-let (ok fn2-compress-transport) (fn2-compress-selected-window-control fn2-compress-transport) ok)))
(assert-event (equal (fn2-compress-selected-window-test) t))

(defun fn2-compress-rejected-window-control ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-compress-transport
  (mv-let (ok fn2-compress-transport)
   (b* (((mv code fn2-compress-transport)
         (fn2-compress-transport-start 4 5 6 7 3 64 4 8 8 32 fn2-compress-transport))
        ((unless (eq code :ok)) (mv nil fn2-compress-transport))
        (fn2-compress-transport
         (fn2-compress-transport-put 0 (alive 1) (handle-id 7) (terminal 3) (copied 3) (output-quantum 6)))
        (before (list (fn2-compress-transport-rows fn2-compress-transport) (fn2-compress-transport-row-snapshot 0 fn2-compress-transport)))
        ((mv code serial fn2-compress-transport)
         (fn2-compress-transport-select-encode 4 5 6 7 0 4 0 fn2-compress-transport)))
    (mv (and (fn2-compress-transportp fn2-compress-transport)
             (fn2-compress-transport-wfp fn2-compress-transport)
             (= (fn2-compress-transport-rows fn2-compress-transport) 1)
             (eq code :bounds) (= serial 0)
             (not (<= *fn2-compress-min-output-window*
                      (fn2-compress-transport-request-out-count 0 fn2-compress-transport)))
             (equal before (list (fn2-compress-transport-rows fn2-compress-transport) (fn2-compress-transport-row-snapshot 0 fn2-compress-transport)))) fn2-compress-transport))
   ok)))
(assert-event (fn2-compress-rejected-window-control))

(fn2-assert-owed-teeth fn2-compress-encoder-window-full)

; Same selected parent request is the input to either raw socket or TLS child
; dispatch. A short child completion advances only the encoded prefix.
(defun fn2-compress-drain-prefix-control (fn2-compress-transport)
 (declare (xargs :stobjs fn2-compress-transport :verify-guards nil))
 (b* (((mv code fn2-compress-transport) (fn2-compress-ready-control fn2-compress-transport))
      ((unless (eq code :ok)) (mv nil fn2-compress-transport))
      ((mv code serial fn2-compress-transport)
       (fn2-compress-transport-select-encode 4 5 6 7 0 4 0 fn2-compress-transport))
      ((unless (eq code :ok)) (mv nil fn2-compress-transport))
      ((mv code fn2-compress-transport)
       (fn2-compress-transport-observe-spans 4 5 6 7 serial 0 4 8 0 fn2-compress-transport))
      ((unless (eq code :ok)) (mv nil fn2-compress-transport))
      ((mv code serial fn2-compress-transport)
       (fn2-compress-transport-select-drain 4 5 6 7 fn2-compress-transport))
      ((unless (and (eq code :ok)
                    (= (fn2-compress-transport-pending 0 fn2-compress-transport) 5)
                    (= (fn2-compress-transport-request-in-channel 0 fn2-compress-transport) 3)
                    (= (fn2-compress-transport-request-in-count 0 fn2-compress-transport) 4)))
       (mv nil fn2-compress-transport))
      ((mv code fn2-compress-transport)
       (fn2-compress-transport-observe-spans 4 5 6 7 serial 0 1 0 0 fn2-compress-transport))
      ((unless (and (eq code :ok)
                    (= (fn2-compress-transport-output-offset 0 fn2-compress-transport) 1)
                    (= (fn2-compress-transport-output-length 0 fn2-compress-transport) 8)))
       (mv nil fn2-compress-transport))
      (before (list (fn2-compress-transport-rows fn2-compress-transport) (fn2-compress-transport-row-snapshot 0 fn2-compress-transport)))
      ((mv code fn2-compress-transport)
       (fn2-compress-transport-observe-spans 4 5 6 7 serial 0 1 0 0 fn2-compress-transport))
      ((unless (and (eq code :stale)
                    (equal before (list (fn2-compress-transport-rows fn2-compress-transport) (fn2-compress-transport-row-snapshot 0 fn2-compress-transport)))))
       (mv nil fn2-compress-transport))
      ((mv code ?serial fn2-compress-transport)
       (fn2-compress-transport-select-encode 4 5 6 7 4 4 0 fn2-compress-transport)))
  (mv (and (eq code :need-output)
           (= (fn2-compress-transport-output-offset 0 fn2-compress-transport) 1)
           (= (fn2-compress-transport-output-length 0 fn2-compress-transport) 8))
      fn2-compress-transport)))
(defun fn2-compress-drain-prefix-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-compress-transport
  (mv-let (ok fn2-compress-transport)
   (fn2-compress-drain-prefix-control fn2-compress-transport) ok)))
(assert-event (fn2-compress-drain-prefix-test))

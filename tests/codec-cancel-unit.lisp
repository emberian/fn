; Cancellation uses actual handle cleanup, retained app progress and native ABI.
(in-package "ACL2")
(include-book "../books/codec-close")
(include-book "../books/tls-record")
(defcodec-record-closure fn2-tls-record fn2-tls-transport)
(include-book "../books/host-result")
(include-book "std/util/bstar" :dir :system)

(defun fn2-codec-cancel-run (receivep progress fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-tls-transport fn2-tls-record) :verify-guards nil))
 (b* (((mv begun fn2-tls-transport)
       (fn2-tls-transport-start 7 17 3 9 0 0 4 3 1 fn2-tls-transport))
      ((mv allocated action & & serial fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv observed & fn2-tls-transport)
       (fn2-tls-transport-observe 7 17 3 9 serial 4096 0 0 fn2-tls-transport))
      ((mv handshake handshake-action & & handshake-serial fn2-tls-transport)
       (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv handshake-observed & fn2-tls-transport)
       (fn2-tls-transport-observe 7 17 3 9 handshake-serial 0 0 0 fn2-tls-transport))
      ((mv upgraded & & & & fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv handed & & & & & & fn2-tls-transport) (fn2-tls-transport-handoff 7 17 3 9 fn2-tls-transport))
      ((mv unbound-slot fn2-tls-record)
       (fn2-tls-record-mark-carrier-closed 7 17 4 9 10 fn2-tls-transport fn2-tls-record))
      ((mv unbound-gen fn2-tls-record)
       (fn2-tls-record-mark-carrier-closed 7 17 3 10 10 fn2-tls-transport fn2-tls-record))
      (unbound-preserved (= (fn2-tls-record-rows fn2-tls-record) 0))
      ((mv bound fn2-tls-record) (fn2-tls-record-bind 7 17 3 9 10 fn2-tls-record))
      ((mv mark-live fn2-tls-record)
       (fn2-tls-record-mark-carrier-closed 7 17 3 9 10 fn2-tls-transport fn2-tls-record))
      ((mv selected serial fn2-tls-transport)
       (fn2-tls-transport-select 7 17 3 9 (if receivep 12 13)
        (if receivep 0 4) 0 (if receivep 0 4) (if receivep 0 10)
        (if receivep 5 0) 0 (if receivep 4 0) (if receivep 10 0) fn2-tls-transport))
      ((mv requested fn2-tls-record)
       (fn2-tls-record-request serial (if receivep 12 13) (if receivep 0 4) (if receivep 4 0) fn2-tls-record))
      ; A queued cancel/close cannot free a primitive's pending handle/loan.
      ((mv pending & & & fn2-tls-record) (fn2-tls-record-cancel receivep fn2-tls-record))
      ((mv retire-pending fn2-tls-transport) (fn2-tls-transport-retire 7 17 fn2-tls-transport))
      ((mv mark-pending fn2-tls-record)
       (fn2-tls-record-mark-carrier-closed 7 17 3 9 10 fn2-tls-transport fn2-tls-record))
      (held (and (= (fn2-tls-transport-alive 0 fn2-tls-transport) 1)
                 (= (fn2-tls-transport-handle-id 0 fn2-tls-transport) 4096)
                 (= (fn2-tls-record-carrier-closed 0 fn2-tls-record) 0)))
      ; Settle the actual physical prefix before cancellation can advance.
      ((mv physical fn2-tls-transport)
       (fn2-tls-transport-observe-spans 7 17 3 9 serial 0
        (if receivep 0 progress) (if receivep progress 0) 0 fn2-tls-transport))
      ((mv applied fn2-tls-record)
       (fn2-tls-record-observe serial (if receivep 0 progress) (if receivep progress 0) fn2-tls-record))
      ((mv live & & & fn2-tls-record) (fn2-tls-record-cancel receivep fn2-tls-record))
      ((mv retiring fn2-tls-transport) (fn2-tls-transport-retire 7 17 fn2-tls-transport))
      ((mv cleanup free-action & & free-serial fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv free-pending fn2-tls-record)
       (fn2-tls-record-mark-carrier-closed 7 17 3 9 10 fn2-tls-transport fn2-tls-record))
      ((mv freed & fn2-tls-transport)
       (fn2-tls-transport-observe 7 17 3 9 free-serial 0 0 0 fn2-tls-transport))
      ((mv retired fn2-tls-transport) (fn2-tls-transport-retire 7 17 fn2-tls-transport))
      ((mv stale-cap fn2-tls-record)
       (fn2-tls-record-mark-carrier-closed 8 17 3 9 10 fn2-tls-transport fn2-tls-record))
      ((mv stale-gen fn2-tls-record)
       (fn2-tls-record-mark-carrier-closed 7 17 3 10 10 fn2-tls-transport fn2-tls-record))
      (refusal-preserved
       (and (= (fn2-tls-record-carrier-closed 0 fn2-tls-record) 0)
            (= (fn2-tls-record-generation 0 fn2-tls-record) 9)
            (= (fn2-tls-record-source-progress 0 fn2-tls-record) (if receivep 0 progress))
            (= (fn2-tls-record-sink-progress 0 fn2-tls-record) (if receivep progress 0))
            (fn2-tls-transport-retired-p 7 17 fn2-tls-transport)))
      ((mv marked fn2-tls-record)
       (fn2-tls-record-mark-carrier-closed 7 17 3 9 10 fn2-tls-transport fn2-tls-record))
      (unresolved (= (fn2-tls-record-terminal 0 fn2-tls-record) 0))
      ; The terminal decision needs no live capability/fd: only the marked op.
      ((mv decision code count won fn2-tls-record) (fn2-tls-record-cancel receivep fn2-tls-record))
      ((mv outcome & actual-count & &)
       (fn2-host-result (if receivep *fn2-action-receive* *fn2-action-send*) code count 0 10 nil))
      ((mv cancel-outcome & & & &) (fn2-host-result *fn2-action-cancel* :ok 0 0 0 won))
      ((mv duplicate & & & fn2-tls-record) (fn2-tls-record-cancel receivep fn2-tls-record))
      (productive (and receivep (< 0 progress)))
      ; Even an actually retired matching carrier cannot invent a new loan.
      (fn2-tls-record (fn2-tls-record-init 0 fn2-tls-record))
      ((mv retired-unbound-slot fn2-tls-record)
       (fn2-tls-record-mark-carrier-closed 7 17 4 9 10 fn2-tls-transport fn2-tls-record))
      ((mv retired-unbound-gen fn2-tls-record)
       (fn2-tls-record-mark-carrier-closed 7 17 3 10 10 fn2-tls-transport fn2-tls-record)))
  (mv (and (equal (list begun observed handed bound selected requested physical applied marked) '(:ok :ok :ok :ok :ok :ok :ok :ok :ok))
           (eq unbound-slot :unbound) (eq unbound-gen :unbound) unbound-preserved
           (eq handshake :act) (= handshake-action 7) (eq handshake-observed :ok)
           (eq allocated :act) (= action 8) (eq upgraded :done)
           (eq pending :pending) (eq retire-pending :pending) (eq mark-pending :pending) held
           (eq live :live) (eq mark-live :live) (eq stale-cap :stale) (eq stale-gen :stale) refusal-preserved
           (eq retiring :closing) (eq cleanup :cleanup) (= free-action 9)
           (eq free-pending :pending) (eq freed :ok) (eq retired :done) unresolved
           (equal decision (if productive :productive :cancelled))
           (equal outcome (if productive *fn2-outcome-done* *fn2-outcome-cancelled*))
           (= actual-count progress)
           (= cancel-outcome (if productive *fn2-outcome-not-found* *fn2-outcome-done*))
           (eq duplicate :too-late)
           (eq retired-unbound-slot :unbound) (eq retired-unbound-gen :unbound)
           (= (fn2-tls-record-rows fn2-tls-record) 0))
      fn2-tls-transport fn2-tls-record)))
(defun fn2-codec-cancel-check (receivep progress)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-tls-transport
  (mv-let (ok fn2-tls-transport)
   (with-local-stobj fn2-tls-record
    (mv-let (ok fn2-tls-transport fn2-tls-record)
     (fn2-codec-cancel-run receivep progress fn2-tls-transport fn2-tls-record)
     (mv ok fn2-tls-transport)))
   ok)))
(assert-event (fn2-codec-cancel-check t 2))
(assert-event (fn2-codec-cancel-check nil 2))
(assert-event (fn2-codec-cancel-check t 0))
(assert-event (fn2-codec-cancel-check nil 0))

; No physical free is owed before allocation or after a failed allocation.
; A pending allocation still owns the reservation until its real return.
(defun fn2-codec-unused-cleanup-run (allocatep fn2-tls-transport)
 (declare (xargs :stobjs fn2-tls-transport :verify-guards nil))
 (b* (((mv begun fn2-tls-transport)
       (fn2-tls-transport-start 7 17 3 9 0 0 4 3 1 fn2-tls-transport))
      (reserved (= (fn2-tls-transport-cleanup-credit 0 fn2-tls-transport) 1))
      ((mv allocation-ok fn2-tls-transport)
       (if (not allocatep) (mv t fn2-tls-transport)
        (b* (((mv selected action & & serial fn2-tls-transport)
              (fn2-tls-transport-next 0 0 fn2-tls-transport))
             ((mv held fn2-tls-transport) (fn2-tls-transport-retire 7 17 fn2-tls-transport))
             (preserved (and (= (fn2-tls-transport-pending 0 fn2-tls-transport) 8)
                             (= (fn2-tls-transport-cleanup-credit 0 fn2-tls-transport) 1)
                             (not (fn2-tls-transport-retired-p 7 17 fn2-tls-transport))))
             ((mv failed accepted fn2-tls-transport)
              (fn2-tls-transport-observe 7 17 3 9 serial 0 0 0 fn2-tls-transport)))
         (mv (and (eq selected :act) (= action 8) (eq held :pending) preserved
                  (eq failed :closing) accepted) fn2-tls-transport))))
      ((mv stale fn2-tls-transport) (fn2-tls-transport-retire 7 18 fn2-tls-transport))
      (still-reserved (= (fn2-tls-transport-cleanup-credit 0 fn2-tls-transport) 1))
      ((mv retired fn2-tls-transport) (fn2-tls-transport-retire 7 17 fn2-tls-transport))
      ((mv next action & & & fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport)))
  (mv (and (eq begun :ok) reserved allocation-ok (eq stale :stale) still-reserved
           (eq retired :done) (fn2-tls-transport-retired-p 7 17 fn2-tls-transport)
           (= (fn2-tls-transport-cleanup-credit 0 fn2-tls-transport) 0)
           (eq next :retired) (= action 0)) fn2-tls-transport)))
(defun fn2-codec-unused-cleanup-check (allocatep)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-tls-transport
  (mv-let (ok fn2-tls-transport)
   (fn2-codec-unused-cleanup-run allocatep fn2-tls-transport) ok)))
(assert-event (fn2-codec-unused-cleanup-check nil))
(assert-event (fn2-codec-unused-cleanup-check t))

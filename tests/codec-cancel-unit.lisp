; Cancellation uses actual handle cleanup, retained app progress and native ABI.
(in-package "ACL2")
(include-book "../books/codec-close")
(include-book "../books/host-result")
(include-book "std/util/bstar" :dir :system)
(defcodec-transport fn2-cancel-carrier ((quantum :u32)))
(defcodec-transport-operations fn2-cancel-carrier)
(defcodec-transport-lifecycle fn2-cancel-carrier)
(defcodec-transport-upgrade fn2-cancel-carrier fn2-codec-copy-plan :status-field nil)
(defcodec-operation fn2-cancel-operation ())
(defcodec-record-closure fn2-cancel-operation fn2-cancel-carrier)

(defun fn2-codec-cancel-run (receivep progress fn2-cancel-carrier fn2-cancel-operation)
 (declare (xargs :stobjs (fn2-cancel-carrier fn2-cancel-operation) :verify-guards nil))
 (b* (((mv begun fn2-cancel-carrier)
       (fn2-cancel-carrier-begin 7 17 3 9 0 0 4 4 1 1 fn2-cancel-carrier))
      ((mv allocated action & & serial fn2-cancel-carrier) (fn2-cancel-carrier-next 0 0 fn2-cancel-carrier))
      ((mv observed & fn2-cancel-carrier)
       (fn2-cancel-carrier-observe-lifecycle 7 17 3 9 serial 4096 0 0 fn2-cancel-carrier))
      ((mv upgraded & & & & fn2-cancel-carrier) (fn2-cancel-carrier-next 0 0 fn2-cancel-carrier))
      ((mv handed & & & & & & fn2-cancel-carrier) (fn2-cancel-carrier-handoff 7 17 3 9 fn2-cancel-carrier))
      ((mv unbound-slot fn2-cancel-operation)
       (fn2-cancel-operation-mark-carrier-closed 7 17 4 9 10 fn2-cancel-carrier fn2-cancel-operation))
      ((mv unbound-gen fn2-cancel-operation)
       (fn2-cancel-operation-mark-carrier-closed 7 17 3 10 10 fn2-cancel-carrier fn2-cancel-operation))
      (unbound-preserved (= (fn2-cancel-operation-rows fn2-cancel-operation) 0))
      ((mv bound fn2-cancel-operation) (fn2-cancel-operation-bind 7 17 3 9 10 fn2-cancel-operation))
      ((mv mark-live fn2-cancel-operation)
       (fn2-cancel-operation-mark-carrier-closed 7 17 3 9 10 fn2-cancel-carrier fn2-cancel-operation))
      ((mv selected serial fn2-cancel-carrier)
       (fn2-cancel-carrier-select 7 17 3 9 (if receivep 12 13)
        (if receivep 0 4) 0 (if receivep 0 4) (if receivep 0 10)
        (if receivep 5 0) 0 (if receivep 4 0) (if receivep 10 0) fn2-cancel-carrier))
      ((mv requested fn2-cancel-operation)
       (fn2-cancel-operation-request serial (if receivep 12 13) (if receivep 0 4) (if receivep 4 0) fn2-cancel-operation))
      ; A queued cancel/close cannot free a primitive's pending handle/loan.
      ((mv pending & & & fn2-cancel-operation) (fn2-cancel-operation-cancel receivep fn2-cancel-operation))
      ((mv retire-pending fn2-cancel-carrier) (fn2-cancel-carrier-retire 7 17 fn2-cancel-carrier))
      ((mv mark-pending fn2-cancel-operation)
       (fn2-cancel-operation-mark-carrier-closed 7 17 3 9 10 fn2-cancel-carrier fn2-cancel-operation))
      (held (and (= (fn2-cancel-carrier-alive 0 fn2-cancel-carrier) 1)
                 (= (fn2-cancel-carrier-handle-id 0 fn2-cancel-carrier) 4096)
                 (= (fn2-cancel-operation-carrier-closed 0 fn2-cancel-operation) 0)))
      ; Settle the actual physical prefix before cancellation can advance.
      ((mv physical fn2-cancel-carrier)
       (fn2-cancel-carrier-observe-spans 7 17 3 9 serial 0
        (if receivep 0 progress) (if receivep progress 0) 0 fn2-cancel-carrier))
      ((mv applied fn2-cancel-operation)
       (fn2-cancel-operation-observe serial (if receivep 0 progress) (if receivep progress 0) fn2-cancel-operation))
      ((mv live & & & fn2-cancel-operation) (fn2-cancel-operation-cancel receivep fn2-cancel-operation))
      ((mv retiring fn2-cancel-carrier) (fn2-cancel-carrier-retire 7 17 fn2-cancel-carrier))
      ((mv cleanup free-action & & free-serial fn2-cancel-carrier) (fn2-cancel-carrier-next 0 0 fn2-cancel-carrier))
      ((mv free-pending fn2-cancel-operation)
       (fn2-cancel-operation-mark-carrier-closed 7 17 3 9 10 fn2-cancel-carrier fn2-cancel-operation))
      ((mv freed & fn2-cancel-carrier)
       (fn2-cancel-carrier-observe-lifecycle 7 17 3 9 free-serial 0 0 0 fn2-cancel-carrier))
      ((mv retired fn2-cancel-carrier) (fn2-cancel-carrier-retire 7 17 fn2-cancel-carrier))
      ((mv stale-cap fn2-cancel-operation)
       (fn2-cancel-operation-mark-carrier-closed 8 17 3 9 10 fn2-cancel-carrier fn2-cancel-operation))
      ((mv stale-gen fn2-cancel-operation)
       (fn2-cancel-operation-mark-carrier-closed 7 17 3 10 10 fn2-cancel-carrier fn2-cancel-operation))
      (refusal-preserved
       (and (= (fn2-cancel-operation-carrier-closed 0 fn2-cancel-operation) 0)
            (= (fn2-cancel-operation-generation 0 fn2-cancel-operation) 9)
            (= (fn2-cancel-operation-source-progress 0 fn2-cancel-operation) (if receivep 0 progress))
            (= (fn2-cancel-operation-sink-progress 0 fn2-cancel-operation) (if receivep progress 0))
            (fn2-cancel-carrier-retired-p 7 17 fn2-cancel-carrier)))
      ((mv marked fn2-cancel-operation)
       (fn2-cancel-operation-mark-carrier-closed 7 17 3 9 10 fn2-cancel-carrier fn2-cancel-operation))
      (unresolved (= (fn2-cancel-operation-terminal 0 fn2-cancel-operation) 0))
      ; The terminal decision needs no live capability/fd: only the marked op.
      ((mv decision code count won fn2-cancel-operation) (fn2-cancel-operation-cancel receivep fn2-cancel-operation))
      ((mv outcome & actual-count & &)
       (fn2-host-result (if receivep *fn2-action-receive* *fn2-action-send*) code count 0 10 nil))
      ((mv cancel-outcome & & & &) (fn2-host-result *fn2-action-cancel* :ok 0 0 0 won))
      ((mv duplicate & & & fn2-cancel-operation) (fn2-cancel-operation-cancel receivep fn2-cancel-operation))
      (productive (and receivep (< 0 progress)))
      ; Even an actually retired matching carrier cannot invent a new loan.
      (fn2-cancel-operation (fn2-cancel-operation-init 0 fn2-cancel-operation))
      ((mv retired-unbound-slot fn2-cancel-operation)
       (fn2-cancel-operation-mark-carrier-closed 7 17 4 9 10 fn2-cancel-carrier fn2-cancel-operation))
      ((mv retired-unbound-gen fn2-cancel-operation)
       (fn2-cancel-operation-mark-carrier-closed 7 17 3 10 10 fn2-cancel-carrier fn2-cancel-operation)))
  (mv (and (equal (list begun observed handed bound selected requested physical applied marked) '(:ok :ok :ok :ok :ok :ok :ok :ok :ok))
           (eq unbound-slot :unbound) (eq unbound-gen :unbound) unbound-preserved
           (eq allocated :act) (= action 8) (eq upgraded :done)
           (eq pending :pending) (eq retire-pending :pending) (eq mark-pending :pending) held
           (eq live :live) (eq mark-live :live) (eq stale-cap :stale) (eq stale-gen :stale) refusal-preserved
           (eq retiring :closing) (eq cleanup :cleanup) (= free-action 9)
           (eq free-pending :pending) (eq freed :ok) (eq retired :done) unresolved
           (equal decision (if productive :productive :cancelled))
           (equal outcome (if productive *fn2-outcome-done* *fn2-outcome-cancelled*))
           (= actual-count progress)
           (= cancel-outcome (if productive *fn2-outcome-not-found* *fn2-outcome-done*))
           (eq duplicate :too-late)
           (eq retired-unbound-slot :unbound) (eq retired-unbound-gen :unbound)
           (= (fn2-cancel-operation-rows fn2-cancel-operation) 0))
      fn2-cancel-carrier fn2-cancel-operation)))
(defun fn2-codec-cancel-check (receivep progress)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-cancel-carrier
  (mv-let (ok fn2-cancel-carrier)
   (with-local-stobj fn2-cancel-operation
    (mv-let (ok fn2-cancel-carrier fn2-cancel-operation)
     (fn2-codec-cancel-run receivep progress fn2-cancel-carrier fn2-cancel-operation)
     (mv ok fn2-cancel-carrier)))
   ok)))
(assert-event (fn2-codec-cancel-check t 2))
(assert-event (fn2-codec-cancel-check nil 2))
(assert-event (fn2-codec-cancel-check t 0))
(assert-event (fn2-codec-cancel-check nil 0))

; No physical free is owed before allocation or after a failed allocation.
; A pending allocation still owns the reservation until its real return.
(defun fn2-codec-unused-cleanup-run (allocatep fn2-cancel-carrier)
 (declare (xargs :stobjs fn2-cancel-carrier :verify-guards nil))
 (b* (((mv begun fn2-cancel-carrier)
       (fn2-cancel-carrier-begin 7 17 3 9 0 0 4 4 1 1 fn2-cancel-carrier))
      (reserved (= (fn2-cancel-carrier-cleanup-credit 0 fn2-cancel-carrier) 1))
      ((mv allocation-ok fn2-cancel-carrier)
       (if (not allocatep) (mv t fn2-cancel-carrier)
        (b* (((mv selected action & & serial fn2-cancel-carrier)
              (fn2-cancel-carrier-next 0 0 fn2-cancel-carrier))
             ((mv held fn2-cancel-carrier) (fn2-cancel-carrier-retire 7 17 fn2-cancel-carrier))
             (preserved (and (= (fn2-cancel-carrier-pending 0 fn2-cancel-carrier) 8)
                             (= (fn2-cancel-carrier-cleanup-credit 0 fn2-cancel-carrier) 1)
                             (not (fn2-cancel-carrier-retired-p 7 17 fn2-cancel-carrier))))
             ((mv failed accepted fn2-cancel-carrier)
              (fn2-cancel-carrier-observe-lifecycle 7 17 3 9 serial 0 0 0 fn2-cancel-carrier)))
         (mv (and (eq selected :act) (= action 8) (eq held :pending) preserved
                  (eq failed :closing) accepted) fn2-cancel-carrier))))
      ((mv stale fn2-cancel-carrier) (fn2-cancel-carrier-retire 7 18 fn2-cancel-carrier))
      (still-reserved (= (fn2-cancel-carrier-cleanup-credit 0 fn2-cancel-carrier) 1))
      ((mv retired fn2-cancel-carrier) (fn2-cancel-carrier-retire 7 17 fn2-cancel-carrier))
      ((mv next action & & & fn2-cancel-carrier) (fn2-cancel-carrier-next 0 0 fn2-cancel-carrier)))
  (mv (and (eq begun :ok) reserved allocation-ok (eq stale :stale) still-reserved
           (eq retired :done) (fn2-cancel-carrier-retired-p 7 17 fn2-cancel-carrier)
           (= (fn2-cancel-carrier-cleanup-credit 0 fn2-cancel-carrier) 0)
           (eq next :retired) (= action 0)) fn2-cancel-carrier)))
(defun fn2-codec-unused-cleanup-check (allocatep)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-cancel-carrier
  (mv-let (ok fn2-cancel-carrier)
   (fn2-codec-unused-cleanup-run allocatep fn2-cancel-carrier) ok)))
(assert-event (fn2-codec-unused-cleanup-check nil))
(assert-event (fn2-codec-unused-cleanup-check t))

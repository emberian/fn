; A resident run's digest value belongs to its page until resolve finishes.
; The successor keeps only the scalar decision. A real seal/merge then retires
; the old page before stage checks the run version and restarts.
; The direct C publication exercises ordinary sealer replacement and its
; strict run-version guard, not B durability. Prepared source fixture; no
; ACL2 execution is claimed here.
(in-package "ACL2")
(include-book "../books/executor")
(include-book "std/util/bstar" :dir :system)

(defconst *fn2-ssl-profile*
 (put-assoc-equal :identity-arena-bytes 4096
  (put-assoc-equal :large-upload-windows 1
   (put-assoc-equal :pool-classes '((8 . 64) (4 . 256) (16 . 4096) (8 . 65536)) *fn2-profile-tiny*))))

(defun fn2-ssl-write (n slot gen byte fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix n)))
 (if (zp n) (mv :ok fn2-core)
  (mv-let (code fn2-core) (fn2-core-write slot gen (- n 1) byte 5 1 1 fn2-core)
   (if (eq code :ok) (fn2-ssl-write (- n 1) slot gen byte fn2-core)
    (mv code fn2-core)))))

(defun fn2-ssl-resolve (fuel tx fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-successor-resolve tx 4096 fn2-core)
   (if (eq code :more) (fn2-ssl-resolve (- fuel 1) tx fn2-core)
    (mv code fn2-core)))))

(defun fn2-ssl-foundp (tx fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-succ-slots (fn2-core-succ-slots fn2-core)))
  (found)
  (= (fn2-succ-slots-found (* tx *fn2-succ-slots*) fn2-succ-slots) 1)
  found))

(defun fn2-ssl-resolve-until-found (fuel tx fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-successor-resolve tx 4096 fn2-core)
   (cond ((fn2-ssl-foundp tx fn2-core) (mv code fn2-core))
         ((eq code :more) (fn2-ssl-resolve-until-found (- fuel 1) tx fn2-core))
         (t (mv code fn2-core))))))

(defun fn2-ssl-turns (fuel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) fn2-core
  (mv-let (code & & & fn2-core) (fn2-turn fn2-core)
   (if (eq code :stop) fn2-core (fn2-ssl-turns (- fuel 1) fn2-core)))))

(defun fn2-ssl-seal (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (mv-let (& fn2-core) (fn2-sealer-step 4096 fn2-core)
  (fn2-ssl-turns 400 fn2-core)))

(defun fn2-ssl-outcome (tx operation digest-slot digest-gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* (((mv a fn2-core) (fn2-successor-put tx 0 9 :insert fn2-core))
      ((mv b fn2-core) (fn2-successor-arg tx 0 0 :value 3 fn2-core))
      ((mv c fn2-core) (fn2-successor-arg tx 0 1 :value operation fn2-core))
      ((mv d fn2-core) (fn2-successor-arg-octets tx 0 2 digest-slot digest-gen 0 32 5 1 1 fn2-core))
      ((mv e fn2-core) (fn2-successor-arg tx 0 3 :value 240 fn2-core))
      ((mv f fn2-core) (fn2-successor-arg tx 0 4 :value 42 fn2-core)))
  (mv (and (eq a :ok) (eq b :ok) (eq c :ok) (eq d :ok) (eq e :ok) (eq f :ok)) fn2-core)))

(defun fn2-ssl-resolved-fields (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-id-decides (fn2-core-id-decides fn2-core))
             (fn2-fields (fn2-core-fields fn2-core))
             (fn2-fc (fn2-core-fc fn2-core))
             (fn2-succ-slots (fn2-core-succ-slots fn2-core)))
  (code found key0 key1 slot gen off len)
  (b* (((mv code b0) (fn2-idc-stripe 0 (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields))
       (raw (+ b0 *fn2-succ-raw*))
       (res (+ b0 *fn2-succ-res*)))
   (mv code (fn2-succ-slots-found 0 fn2-succ-slots)
       (fn2-fields-value raw fn2-fields) (fn2-fields-value (+ raw 1) fn2-fields)
       (fn2-fields-ref-slot res fn2-fields) (fn2-fields-ref-gen res fn2-fields)
       (fn2-fields-ref-off res fn2-fields) (fn2-fields-ref-len res fn2-fields)))
  (mv code found key0 key1 slot gen off len)))

(defun fn2-ssl-reader-ref (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-id-decides (fn2-core-id-decides fn2-core))
             (fn2-fields (fn2-core-fields fn2-core))
             (fn2-fc (fn2-core-fc fn2-core)))
  (code slot gen len)
  (b* (((mv code b0) (fn2-idc-stripe 0 (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields))
       (row (+ b0 *fn2-idc-rb* *fn2-run-reader-entry* 2)))
   (mv code (fn2-fields-ref-slot row fn2-fields)
       (fn2-fields-ref-gen row fn2-fields) (fn2-fields-ref-len row fn2-fields)))
  (mv code slot gen len)))

(defun fn2-ssl-run-page (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core)))
  (row slot gen kind owner generation)
  (b* ((rows (fn2-run-installed-rows fn2-run-installed))
       (row (fn2-succ-newest-run rows 0 9 *fn2-u60-max* rows fn2-run-installed)))
   (if (>= row rows) (mv row 0 0 0 0 0)
    (mv row (fn2-run-installed-slot row fn2-run-installed)
        (fn2-run-installed-gen row fn2-run-installed)
        (fn2-run-installed-okind row fn2-run-installed)
        (fn2-run-installed-oslot row fn2-run-installed)
        (fn2-run-installed-ogen row fn2-run-installed))))
  (mv row slot gen kind owner generation)))

(defun fn2-ssl-poison-scratch (slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-id-decides (fn2-core-id-decides fn2-core))
             (fn2-fields (fn2-core-fields fn2-core))
             (fn2-fc (fn2-core-fc fn2-core)))
  (code fn2-fields)
  (b* (((mv code b0) (fn2-idc-stripe 0 (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields))
       (fn2-fields (fn2-fields-put (+ b0 *fn2-idc-eb*)
                     (ref-slot slot) (ref-gen gen) (ref-off 0) (ref-len 1)))
       (fn2-fields (fn2-fields-put (+ b0 11)
                     (ref-slot slot) (ref-gen gen) (ref-off 0) (ref-len 1))))
   (mv code fn2-fields))
  (mv code fn2-core)))

(defun fn2-ssl-scratch-clean (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-id-decides (fn2-core-id-decides fn2-core))
             (fn2-fields (fn2-core-fields fn2-core))
             (fn2-fc (fn2-core-fc fn2-core)))
  (clean)
  (b* (((mv code b0) (fn2-idc-stripe 0 (fn2-fc-rows fn2-fc) fn2-id-decides fn2-fields))
       (eb (+ b0 *fn2-idc-eb*))
       (entry (+ b0 11)))
   (and (eq code :ok)
        (= (fn2-fields-ref-slot eb fn2-fields) 0)
        (= (fn2-fields-ref-gen eb fn2-fields) 0)
        (= (fn2-fields-ref-off eb fn2-fields) 0)
        (= (fn2-fields-ref-len eb fn2-fields) 0)
        (= (fn2-fields-ref-slot entry fn2-fields) 0)
        (= (fn2-fields-ref-gen entry fn2-fields) 0)
        (= (fn2-fields-ref-off entry fn2-fields) 0)
        (= (fn2-fields-ref-len entry fn2-fields) 0)))
  clean))

(defun fn2-ssl-old-freep (slot gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-pool (fn2-core-pool fn2-core)))
  (free)
  (and (< slot (fn2-pool-rows fn2-pool))
       (= (fn2-pool-state slot fn2-pool) *fn2-pool-state-free*)
       (not (= (fn2-pool-gen slot fn2-pool) gen)))
  free))

; Reacquire the released 64 KiB slot through the pool's real free chain,
; then overwrite byte zero under the new generation. Other free slots may
; come first; all are retained until this bounded fixture ends.
(defun fn2-ssl-overwrite-old (fuel oldslot fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (b* (((mv code slot gen fn2-core) (fn2-core-reserve 3 5 1 1 fn2-core))
       ((unless (eq code :ok)) (mv code fn2-core))
       ((when (= slot oldslot))
        (mv-let (written fn2-core) (fn2-core-write slot gen 0 0 5 1 1 fn2-core)
         (mv written fn2-core))))
   (fn2-ssl-overwrite-old (- fuel 1) oldslot fn2-core))))

; Produce independent committed rows through the actual successor and let
; the sealer replace old resident runs. The old slot's generation changes
; only when its page is really released; no fixture mutation of a live page.
(defun fn2-ssl-replace (fuel operation oldslot oldgen dslot dgen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (b* (((when (fn2-ssl-old-freep oldslot oldgen fn2-core)) (mv :released fn2-core))
      ((when (zp fuel)) (mv :fuel fn2-core))
      ((mv declared fn2-core) (fn2-ssl-outcome 1 operation dslot dgen fn2-core))
      ((mv resolved fn2-core) (fn2-ssl-resolve 100 1 fn2-core))
      ((mv staged & fn2-core) (fn2-successor-stage 1 fn2-core))
      ((mv bound fn2-core) (fn2-successor-bind 1 operation (+ 40 operation) fn2-core))
      ((mv published fn2-core) (fn2-successor-publish operation fn2-core))
      ((mv released fn2-core) (fn2-successor-release 1 fn2-core))
      ((unless (and declared (eq resolved :ok) (eq staged :ok) (eq bound :ok)
                    (eq published :ok) (eq released :ok)))
       (mv :failed fn2-core))
      (fn2-core (fn2-ssl-seal fn2-core)))
  (fn2-ssl-replace (- fuel 1) (+ 1 operation) oldslot oldgen dslot dgen fn2-core)))

(defun fn2-ssl-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-ssl-profile* :null nil fn2-core))
      ((mv reserved dslot dgen fn2-core) (fn2-core-reserve 1 5 1 1 fn2-core))
      ((mv written fn2-core) (fn2-ssl-write 32 dslot dgen 7 fn2-core))
      ((mv declared fn2-core) (fn2-ssl-outcome 0 5 dslot dgen fn2-core))
      ((mv resolved fn2-core) (fn2-ssl-resolve 100 0 fn2-core))
      ((mv staged & fn2-core) (fn2-successor-stage 0 fn2-core))
      ((mv bound fn2-core) (fn2-successor-bind 0 1 42 fn2-core))
      ((mv published fn2-core) (fn2-successor-publish 1 fn2-core))
      ((mv released fn2-core) (fn2-successor-release 0 fn2-core))
      (fn2-core (fn2-ssl-seal fn2-core))
      ((mv row page pgen & & &) (fn2-ssl-run-page fn2-core))
      ((mv declared2 fn2-core) (fn2-ssl-outcome 0 5 dslot dgen fn2-core))
      ((mv found-step fn2-core) (fn2-ssl-resolve-until-found 100 0 fn2-core))
      ((mv reader vslot vgen vlen) (fn2-ssl-reader-ref fn2-core))
      ((mv resolved2 fn2-core) (fn2-ssl-resolve 100 0 fn2-core))
      ((mv reader2 vslot2 vgen2 vlen2) (fn2-ssl-reader-ref fn2-core))
      ((mv fields found key0 key1 rslot rgen roff rlen) (fn2-ssl-resolved-fields fn2-core))
      ((mv replaced fn2-core) (fn2-ssl-replace 16 6 page pgen dslot dgen fn2-core))
      ((mv overwritten fn2-core) (fn2-ssl-overwrite-old 8 page fn2-core))
      ((mv poisoned fn2-core) (fn2-ssl-poison-scratch page pgen fn2-core))
      ((mv stale & fn2-core) (fn2-successor-stage 0 fn2-core))
      (clean (fn2-ssl-scratch-clean fn2-core))
      ((mv released2 fn2-core) (fn2-successor-release 0 fn2-core))
      ((mv declared3 fn2-core) (fn2-ssl-outcome 0 5 dslot dgen fn2-core))
      ((mv resolved3 fn2-core) (fn2-ssl-resolve 100 0 fn2-core))
      ((mv staged3 & fn2-core) (fn2-successor-stage 0 fn2-core))
      ((mv fields2 found2 key02 key12 rslot2 rgen2 roff2 rlen2) (fn2-ssl-resolved-fields fn2-core))
      ((mv key-code key-byte fn2-core) (fn2-core-read dslot dgen 0 5 1 1 fn2-core)))
  (mv (and (eq reserved :ok) (eq written :ok) declared (eq resolved :ok)
           (eq staged :ok) (eq bound :ok) (eq published :ok) (eq released :ok)
           (< row (stobj-let ((fn2-run-installed (fn2-core-run-installed fn2-core))) (rows)
                    (fn2-run-installed-rows fn2-run-installed) rows))
           declared2 (eq found-step :more) (eq resolved2 :ok) (eq fields :ok) (= found 1)
           (eq reader :ok) (= vslot page) (= vgen pgen) (= vlen 32)
           (eq reader2 :ok) (= vslot2 0) (= vgen2 0) (= vlen2 0)
           (= key0 3) (= key1 5) (= rslot 0) (= rgen 0) (= roff 0) (= rlen 0)
           (eq replaced :released) (eq overwritten :ok) (eq poisoned :ok)
           (eq stale :stale) clean (eq released2 :ok)
           declared3 (eq resolved3 :ok) (eq staged3 :duplicate)
           (eq fields2 :ok) (= found2 1) (eq key-code :ok) (= key-byte 7)
           (= key02 3) (= key12 5) (= rslot2 0) (= rgen2 0) (= roff2 0) (= rlen2 0))
      fn2-core)))

(defun fn2-ssl-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core) (fn2-ssl-body fn2-core) answer)))
(assert-event (fn2-ssl-run))

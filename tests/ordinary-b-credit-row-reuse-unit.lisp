; Two actual admitted/persisted/drained batches on the same B row. Both use
; real C stage/emit/bind and the existing public-turn/simulated Write/Fence
; adapter. No FREE/DRAINING or callback outcome is injected here.
; Between batches, return ONLY the existing fixture's exact pressure-owner
; leases. This explicit capacity reset is not uninterrupted foreground progress.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "ordinary-drain-credit-live-unit")
(defun fn2-odcr-return-pressure (i n fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix (- (nfix n) (nfix i)))))
 (if (not (and (natp i) (natp n) (< i n))) (mv :ok 0 fn2-core)
  (b* (((mv owned gen ordinary)
        (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (owned gen ordinary)
         (mv (fn2-pool-ownerp i 200 1 1 fn2-pool) (fn2-pool-gen i fn2-pool)
             (= (fn2-pool-credit-group i fn2-pool) *fn2-none*)) (mv owned gen ordinary)))
       ((mv code fn2-core) (if owned
        (if ordinary (fn2-core-release i gen 200 1 1 fn2-core) (mv :credit fn2-core))
        (mv :ok fn2-core)))
       ((unless (member-eq code '(:ok :retired))) (mv code 0 fn2-core))
       ((mv rest count fn2-core) (fn2-odcr-return-pressure (+ 1 i) n fn2-core)))
   (mv rest (+ count (if owned 1 0)) fn2-core))))
(defun fn2-odcr-workspaces (i n owner generation fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil :measure (nfix (- (nfix n) (nfix i)))))
 (if (not (and (natp i) (natp n) (< i n))) nil
  (let* ((gen (fn2-pool-gen i fn2-pool))
         (rest (fn2-odcr-workspaces (+ 1 i) n owner generation fn2-pool)))
   (if (eq (fn2-pool-workspace-code i gen *fn2-scribe-kind* owner generation fn2-pool) :ok)
    (cons (cons i gen) rest) rest))))
(defun fn2-odcr-tx-phase (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (phase)
  (fn2-succ-txns-phase 0 fn2-succ-txns) phase))
(defun fn2-odcr-installed-p (batch fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (installed)
  (mv-let (code row) (fn2-commit-directory-proposal-row batch fn2-commit-root)
   (and (eq code :ok) (posp row)
        (<= batch (fn2-commit-root-installed 0 fn2-commit-root))
        (<= batch (fn2-commit-root-published 0 fn2-commit-root))
        (= (fn2-commit-root-seal-ready row fn2-commit-root) 1))) installed))
(defun fn2-odcr-body (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((mv first fn2-core fn2-sim fn2-own) (fn2-odcl-body fn2-core fn2-sim fn2-own))
      (id (fn2-machine-kind-base *fn2-commit-kind* fn2-core))
      (oldgen (fn2-machine-generation id fn2-core))
      (oldbatch (fn2-machine-batch-no id fn2-core))
      (group (+ 1 (fn2-commit-row id fn2-core)))
      (owner (fn2-machine-kind-base *fn2-scribe-kind* fn2-core))
      (ogen (fn2-machine-generation owner fn2-core))
      (n (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (n) (fn2-pool-rows fn2-pool) n))
      (workspaces (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (found)
                   (fn2-odcr-workspaces 0 n owner ogen fn2-pool) found))
      ((unless (and first (posp oldbatch) (posp oldgen)
                    (= (fn2-machine-phase id fn2-core) *fn2-commit-state-free*)
                    (fn2-odcr-installed-p oldbatch fn2-core)
                    (= (fn2-odcr-tx-phase fn2-core) *fn2-succ-phase-published*)
                    (= (len workspaces) 1)
                    (fn2-odc-group-fullp 0 fn2-core) (fn2-odc-group-fullp group fn2-core)))
       (mv nil fn2-core fn2-sim fn2-own))
      ; Actual cleanup of PUBLISHED C state and fixture-owned pressure leases.
      ((mv released fn2-core) (fn2-successor-release 0 fn2-core))
      ((mv pressure count fn2-core) (fn2-odcr-return-pressure 0 n fn2-core))
      (ws (caar workspaces)) (wg (cdar workspaces))
      ((mv reset fn2-core) (fn2-core-reset ws wg *fn2-scribe-kind* owner ogen fn2-core))
      ((unless (and (eq released :ok) (eq pressure :ok) (posp count) (eq reset :ok)
                    (= (fn2-odcr-tx-phase fn2-core) *fn2-succ-phase-idle*)))
       (mv nil fn2-core fn2-sim fn2-own))
      ((mv put fn2-core) (fn2-successor-put 0 0 *fn2-succ-addr-sid* :insert fn2-core))
      ((mv args fn2-core) (fn2-odc-args 5 fn2-core))
      ; ADDR's second key field is position: (principal1,position2) is fresh.
      ((mv key fn2-core) (fn2-successor-arg 0 0 1 :value 2 fn2-core))
      ((mv resolved fn2-core) (fn2-odc-resolve 40 fn2-core))
      ((mv staged & fn2-core) (fn2-successor-stage 0 fn2-core))
      ((mv emitted len fn2-core) (fn2-successor-emit 0 ws wg 0 4096 *fn2-scribe-kind* owner ogen fn2-core))
      ((mv exhausted fn2-core) (fn2-odc-exhaust-pool (+ 1 n) (fn2-scribe-window-class fn2-core) fn2-core))
      ((mv pick selected partner) (fn2-commit-pick fn2-core))
      ((unless (and (eq put :ok) (eq args :ok) (eq key :ok) (eq resolved :ok)
                    (eq staged :ok) (eq emitted :ok) (posp len) (eq exhausted :exhausted)
                    (eq pick :open) (= selected id) (not (= partner id))
                    (= (fn2-machine-phase id fn2-core) *fn2-commit-state-free*)
                    (= (fn2-machine-generation id fn2-core) oldgen)
                    (fn2-core-wfp fn2-core) (not (fn2-core-stopped-p fn2-core))))
       (mv nil fn2-core fn2-sim fn2-own))
      ((mv admitted batch event fn2-core) (fn2-commit-admit-txn ws wg len *fn2-scribe-kind* owner ogen fn2-core))
      ((mv bound fn2-core) (fn2-successor-bind 0 batch event fn2-core))
      (newgen (fn2-machine-generation id fn2-core))
      ((mv & & & slot gen) (fn2-commit-resource id 0 fn2-core))
      (current-owner
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (yes)
        (and (fn2-pool-credit-ownerp group batch *fn2-commit-kind* id newgen fn2-pool)
             (= (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-held*)
             (fn2-pool-credit-emptyp group 0 fn2-pool)
             (eq (fn2-pool-workspace-code slot gen *fn2-commit-kind* id newgen fn2-pool) :ok)
             (fn2-pool-release-countp slot fn2-pool)
             (= (fn2-pool-credit-group slot fn2-pool) group)
             (= (fn2-pool-credit-nonce slot fn2-pool) batch)
             (= (fn2-pool-credit-owner-kind slot fn2-pool) *fn2-commit-kind*)
             (= (fn2-pool-credit-owner-slot slot fn2-pool) id)
             (= (fn2-pool-credit-owner-gen slot fn2-pool) newgen)) yes))
      ((unless (and (eq admitted :ok) (eq bound :ok) (> batch oldbatch) (posp event)
                    (= (fn2-machine-batch-no id fn2-core) batch)
                    (= newgen (+ 1 oldgen)) current-owner
                    (= (fn2-machine-phase id fn2-core) *fn2-commit-state-collect*)
                    (= (fn2-odcr-tx-phase fn2-core) *fn2-succ-phase-bound*)))
       (mv nil fn2-core fn2-sim fn2-own))
      ; CURRENT new lease slot/gen and nonce; ONLY its B owner generation is
      ; replaced by the previous generation. This is not a stale pool handle.
      (before (fn2-odc-pool fn2-core))
      ((mv old-owner fn2-core)
       (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (code fn2-pool)
        (fn2-pool-release-credit slot gen group batch *fn2-commit-kind* id oldgen fn2-pool)
        (mv code fn2-core)))
      ((unless (and (eq old-owner :owner) (equal before (fn2-odc-pool fn2-core))))
       (mv nil fn2-core fn2-sim fn2-own))
      ((mv fn2-core fn2-sim fn2-own)
       (fn2-retirement-live-drive 600 *fn2-fault-none* fn2-core fn2-sim fn2-own))
      ((mv taken got-batch got-event outcome fn2-core)
       (fn2-commit-take *fn2-scribe-kind* owner ogen fn2-core))
      (restored (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (yes)
        (and (fn2-pool-credit-ownerp group batch *fn2-commit-kind* id newgen fn2-pool)
             (not (fn2-pool-credit-ownerp group batch *fn2-commit-kind* id oldgen fn2-pool))
             (= (fn2-pool-credit-phasei group fn2-pool) *fn2-pool-credit-idle*)
             (fn2-pool-credit-fullp group 0 fn2-pool)) yes)))
  (mv (and (eq taken :ok) (= got-batch batch) (= got-event event)
           (= outcome *fn2-commit-outcome-accepted*)
           (= (fn2-machine-phase id fn2-core) *fn2-commit-state-free*)
           (= (fn2-machine-generation id fn2-core) newgen)
           (fn2-odcr-installed-p oldbatch fn2-core) (fn2-odcr-installed-p batch fn2-core)
           (= (fn2-odcr-tx-phase fn2-core) *fn2-succ-phase-published*) restored
           (fn2-odc-group-fullp 0 fn2-core) (fn2-odc-group-fullp 1 fn2-core)
           (fn2-odc-group-fullp 2 fn2-core) (fn2-core-wfp fn2-core)
           (not (fn2-core-stopped-p fn2-core))) fn2-core fn2-sim fn2-own)))
(defun fn2-odcr-run ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-core fn2-sim fn2-own) (fn2-odcr-body fn2-core fn2-sim fn2-own)))
(assert-event (fn2-odcr-run))

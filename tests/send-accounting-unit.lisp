; Actual served admission, Send completion, callback and principal ledger.
(in-package "ACL2")
(include-book "../books/owed-conn")

; Let the existing adapter accept one real connection. Stop at its first
; Send, before ACK/completion, so the accounting checks drive the real cell.
(defun fn2-send-accounting-await (fuel accepted clients store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv nil fn2-core)
  (b* (((mv & & & & fn2-core) (fn2-turn fn2-core))
       (descriptor
        (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (descriptor)
         (mv-let (code op gen) (fn2-outbox-peek 0 fn2-ops)
          (and (eq code :ok) (= (fn2-ops-kind op fn2-ops) *fn2-action-send*)
               (list op gen (fn2-ops-owner-slot op fn2-ops)
                     (fn2-ops-principal op fn2-ops) (fn2-ops-range-len op fn2-ops)
                     (fn2-ops-may-release op fn2-ops)))) descriptor))
       ((when descriptor) (mv descriptor fn2-core))
       ((mv & accepted clients store fn2-core)
        (fn2-cw-adapter-one accepted clients store fn2-core)))
   (fn2-send-accounting-await (- fuel 1) accepted clients store fn2-core))))

(defun fn2-send-accounting-post (op gen outcome reason count fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (fn2-ops)
  (fn2-post-result 0 op gen *fn2-event-send-result* outcome reason count 1 0 fn2-ops)
  fn2-core))

(defun fn2-send-accounting-run (raw amount fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-conn-wire-profile* :echo nil fn2-core))
      ((mv descriptor fn2-core)
       (fn2-send-accounting-await 80 0 (fn2-cw-clients '((nil nil))) nil fn2-core))
      ((unless (and descriptor (< 2 (nth 4 descriptor)) (= (nth 5 descriptor) 1)))
       (mv nil fn2-core))
      (op (nth 0 descriptor)) (gen (nth 1 descriptor)) (id (nth 2 descriptor))
      (principal (nth 3 descriptor)) (len (nth 4 descriptor))
      (count (if (eq amount :full) len amount))
      (before (fn2-account-core-charged principal *fn2-account-charge-tx* fn2-core))
      (off (fn2-conn-row-tx-off id fn2-core))
      (entry (and (= (fn2-conn-row-phase id fn2-core) *fn2-conn-state-reply*)
                  (= (fn2-conn-row-pending id fn2-core) 1)
                  (= (fn2-conn-row-borrows id fn2-core) 1)))
      ((mv ack fn2-core)
       (stobj-let ((fn2-ops (fn2-core-ops fn2-core))) (ack fn2-ops)
        (fn2-outbox-ack 1 fn2-ops) (mv ack fn2-core)))
      ((mv outcome reason normalized & &)
       (fn2-sim-terminal-values *fn2-action-send* raw count 0 len t nil))
      (fn2-core (fn2-send-accounting-post op gen outcome reason normalized fn2-core))
      ; Duplicate terminal before consumption must not create another cell.
      (fn2-core (fn2-send-accounting-post op gen outcome reason normalized fn2-core))
      ((mv & & & & & fn2-core) (fn2-exec-harvest fn2-core))
      (success (eq raw :ok))
      (after-terminal
       (and (= normalized count)
            (= (fn2-account-core-charged principal *fn2-account-charge-tx* fn2-core) (+ before count))
            (= (fn2-conn-row-tx-off id fn2-core) (if success (+ off count) off))
            (= (fn2-conn-row-phase id fn2-core) (if success *fn2-conn-state-reply* *fn2-conn-state-closing*))
            (= (fn2-conn-row-pending id fn2-core) 0)
            (= (fn2-conn-row-borrows id fn2-core) 1)))
      ; A consumed terminal cannot charge again, even while release is pending.
      (fn2-core (fn2-send-accounting-post op gen outcome reason normalized fn2-core))
      ((mv & & & & & fn2-core) (fn2-exec-harvest fn2-core))
      (after-duplicate (= (fn2-account-core-charged principal *fn2-account-charge-tx* fn2-core) (+ before count)))
      (fn2-core (fn2-cw-post 1 op gen *fn2-event-borrow-released* *fn2-outcome-done* 0 0 0 fn2-core))
      ((mv & & & & & fn2-core) (fn2-exec-harvest fn2-core)))
  (mv (and entry (eq ack :ok) after-terminal after-duplicate
           (= (fn2-account-core-charged principal *fn2-account-charge-tx* fn2-core) (+ before count))
           (= (fn2-conn-row-borrows id fn2-core) 0)
           (= (fn2-core-stop-reason fn2-core) 0)
           (fn2-account-core-conservedp fn2-core)) fn2-core)))
(defun fn2-send-accounting-check (raw amount)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (ok fn2-core) (fn2-send-accounting-run raw amount fn2-core) ok)))
(assert-event (fn2-send-accounting-check :failed :full))
(assert-event (fn2-send-accounting-check :failed 2))
(assert-event (fn2-send-accounting-check :cancelled 2))
(assert-event (fn2-send-accounting-check :failed 0))
(assert-event (fn2-send-accounting-check :ok :full))
(assert-event (fn2-send-accounting-check :ok 2))

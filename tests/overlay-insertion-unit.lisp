; Real codec-produced private entries, bounded index publication controls.
; Source only; no ACL2 execution or durable acceptance claim.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/runs-schema")
(include-book "../books/runs-assemble")
(include-book "../books/overlay-insertion")
(defrunschema fn2-oi-entry :id 1 :key ((key :u8)) :value () :merge :unique)
(fn2-run-assemble)
(defun fn2-oi-body (fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
 (declare (xargs :stobjs (fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool) :verify-guards nil))
 (b* ((fn2-ov-insertion (fn2-ov-insertion-init 1 fn2-ov-insertion))
      (fn2-overlays (fn2-overlays-init 1 fn2-overlays))
      (fn2-overlay-index (fn2-overlay-index-init 4 fn2-overlay-index))
      (fn2-fields (fn2-fields-init (* 2 *fn2-run-entry-rows*) fn2-fields))
      (fn2-pool (fn2-pool-init '((1 . 4096)) 1 100 fn2-pool))
      ((mv r slot gen fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv s fn2-overlays fn2-pool) (fn2-ov-start 0 1 slot gen 0 4 9 0 1 0 fn2-overlays fn2-overlay-index fn2-pool))
      (fn2-overlays (fn2-overlays-put 0 (phase *fn2-overlay-phase-private*) (batch 7) (seq 1)))
      (fn2-fields (fn2-fields-put 0 (value 2)))
      ((mv a fn2-overlays fn2-overlay-index fn2-fields fn2-pool) (fn2-ov-insert 0 0 *fn2-run-entry-rows* fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-put 0 (value 4)))
      ((mv b fn2-overlays fn2-overlay-index fn2-fields fn2-pool) (fn2-ov-insert 0 0 *fn2-run-entry-rows* fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (fn2-fields (fn2-fields-put 0 (value 6)))
      ((mv c fn2-overlays fn2-overlay-index fn2-fields fn2-pool) (fn2-ov-insert 0 0 *fn2-run-entry-rows* fn2-overlays fn2-overlay-index fn2-fields fn2-pool))
      (off (fn2-overlays-fill 0 fn2-overlays))
      (fn2-fields (fn2-fields-put 0 (value 3)))
      ((mv e end fn2-pool) (fn2-run-layout-encode 1 0 0 slot gen off 9 0 1 fn2-fields fn2-pool))
      ((mv begin fn2-ov-insertion) (fn2-ov-insertion-begin 0 1 off end nil fn2-ov-insertion fn2-overlays fn2-overlay-index))
      (whole (and (eq r :ok) (eq s :ok) (eq a :ok) (eq b :ok) (eq c :ok) (eq e :ok) (eq begin :more)
                  (fn2-ov-insertion-current-p fn2-ov-insertion fn2-overlays fn2-overlay-index)))
      (before (list (fn2-ov-insertion-copy fn2-ov-insertion) (fn2-overlays-copy fn2-overlays) (fn2-overlay-index-copy fn2-overlay-index)))
      ((mv zero fn2-ov-insertion fn2-overlays fn2-overlay-index) (fn2-ov-insertion-step 0 fn2-ov-insertion fn2-overlays fn2-overlay-index))
      (frame (equal before (list (fn2-ov-insertion-copy fn2-ov-insertion) (fn2-overlays-copy fn2-overlays) (fn2-overlay-index-copy fn2-overlay-index))))
      (fn2-overlays (fn2-overlays-set-seq 0 2 fn2-overlays))
      (stale-before (list (fn2-ov-insertion-copy fn2-ov-insertion) (fn2-overlays-copy fn2-overlays) (fn2-overlay-index-copy fn2-overlay-index)))
      ((mv stale fn2-ov-insertion fn2-overlays fn2-overlay-index) (fn2-ov-insertion-step 1 fn2-ov-insertion fn2-overlays fn2-overlay-index))
      (stale-frame (and (eq stale :state) (equal stale-before (list (fn2-ov-insertion-copy fn2-ov-insertion) (fn2-overlays-copy fn2-overlays) (fn2-overlay-index-copy fn2-overlay-index)))))
      (fn2-overlays (fn2-overlays-set-seq 0 1 fn2-overlays))
      ((mv one fn2-ov-insertion fn2-overlays fn2-overlay-index) (fn2-ov-insertion-step 1 fn2-ov-insertion fn2-overlays fn2-overlay-index))
      (first (and (eq one :more) (= (fn2-ov-insertion-remaining 0 fn2-ov-insertion) 1)
                  (= (fn2-overlays-count 0 fn2-overlays) 3) (= (fn2-overlays-fill 0 fn2-overlays) off)))
      ((mv two fn2-ov-insertion fn2-overlays fn2-overlay-index) (fn2-ov-insertion-step 1 fn2-ov-insertion fn2-overlays fn2-overlay-index))
      (second (and (eq two :more) (= (fn2-ov-insertion-remaining 0 fn2-ov-insertion) 0)
                   (= (fn2-overlays-count 0 fn2-overlays) 3) (= (fn2-overlays-fill 0 fn2-overlays) off)))
      ((mv done fn2-ov-insertion fn2-overlays fn2-overlay-index) (fn2-ov-insertion-step 1 fn2-ov-insertion fn2-overlays fn2-overlay-index))
      ((mv dcode dend fn2-fields) (fn2-ov-entry 0 1 *fn2-run-entry-rows* fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
  (mv (and whole frame stale-frame (eq zero :yield) first second (eq done :done)
           (= (fn2-overlays-count 0 fn2-overlays) 4) (= (fn2-overlays-fill 0 fn2-overlays) end)
           (= (fn2-overlay-index-off 0 fn2-overlay-index) 0)
           (= (fn2-overlay-index-off 1 fn2-overlay-index) off)
           (= (fn2-overlay-index-off 2 fn2-overlay-index) 1)
           (= (fn2-overlay-index-off 3 fn2-overlay-index) 2)
           (eq dcode :ok) (= dend end) (= (fn2-fields-value *fn2-run-entry-rows* fn2-fields) 3))
      fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)))
(defun fn2-oi-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-ov-insertion
  (mv-let (ok fn2-ov-insertion)
   (with-local-stobj fn2-overlays
    (mv-let (ok fn2-ov-insertion fn2-overlays)
     (with-local-stobj fn2-overlay-index
      (mv-let (ok fn2-ov-insertion fn2-overlays fn2-overlay-index)
       (with-local-stobj fn2-fields
        (mv-let (ok fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields)
         (with-local-stobj fn2-pool
          (mv-let (ok fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
           (fn2-oi-body fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields fn2-pool)
           (mv ok fn2-ov-insertion fn2-overlays fn2-overlay-index fn2-fields)))
         (mv ok fn2-ov-insertion fn2-overlays fn2-overlay-index)))
       (mv ok fn2-ov-insertion fn2-overlays)))
     (mv ok fn2-ov-insertion)))
   ok)))
(assert-event (fn2-oi-test))

;; One OS leaf: reads the same already admitted descriptor, never reopens path.
(defun fnn-read-fd (fd buffer &rest ignored)
  (declare (ignore ignored))
  (sb-sys:with-pinned-objects (buffer)
    (sb-posix:read fd (sb-sys:vector-sap buffer) (length buffer))))

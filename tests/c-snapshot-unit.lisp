; Drive the ordinary POST through the transaction and durable writer while
; the snapshot closes, then check that the held cut excludes new staging.
(in-package "ACL2")
(include-book "upload-source-lifetime-unit")

(defun fn2-csu-row-phase (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (phase)
  (fn2-succ-txns-phase 0 fn2-succ-txns)
  phase))

(defun fn2-csu-drive (fuel target accepted clients store fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (cond ((= (fn2-csu-row-phase fn2-core) target) (mv :ok accepted clients store fn2-core))
       ((or (zp fuel) (fn2-core-stopped-p fn2-core)) (mv :incomplete accepted clients store fn2-core))
       (t (b* (((mv & & & & fn2-core) (fn2-turn fn2-core))
               ((mv & accepted clients store fn2-core)
                (fn2-cw-adapter-one accepted clients store fn2-core)))
           (fn2-csu-drive (- fuel 1) target accepted clients store fn2-core)))))

(defun fn2-csu-poll (fuel token fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :waiting 0 0 fn2-core)
  (mv-let (code cut event fn2-core) (fn2-csnapshot-poll token 7 0 1 fn2-core)
   (if (eq code :more) (fn2-csu-poll (- fuel 1) token fn2-core)
    (mv code cut event fn2-core)))))

(defun fn2-csu-post (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-uslt-profile* :echo nil fn2-core))
      ((mv epoch fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      (post (fn2-cw-crlf-octets (append '("POST") *fn2-uslt-source* '("." "QUIT"))))
      (clients (fn2-cw-clients (list (list post (list (len post))))))
      ((mv bound accepted clients store fn2-core)
       (fn2-csu-drive 200000 *fn2-succ-phase-bound* 0 clients nil fn2-core))
      ((mv began token fn2-core) (fn2-csnapshot-begin 7 0 1 fn2-core))
      ((mv waits-bound & & fn2-core) (fn2-csu-poll 200 token fn2-core))
      ((mv published accepted clients store fn2-core)
       (fn2-csu-drive 200000 *fn2-succ-phase-published* accepted clients store fn2-core))
      ((mv waits-published & & fn2-core) (fn2-csu-poll 200 token fn2-core))
      ((mv materialized & & & fn2-core)
       (fn2-csu-drive 200000 *fn2-succ-phase-idle* accepted clients store fn2-core))
      ((mv held cut event fn2-core) (fn2-csu-poll 200 token fn2-core))
      ((mv declared fn2-core) (fn2-successor-put 0 0 *fn2-groups-sid* :insert fn2-core))
      ((mv blocked & fn2-core) (fn2-successor-stage 0 fn2-core))
      ((mv seal fn2-core) (fn2-sealer-step 4096 fn2-core))
      ((mv wrong fn2-core) (fn2-csnapshot-release token 7 0 2 fn2-core))
      ((mv still-held same-cut same-event fn2-core) (fn2-csu-poll 1 token fn2-core))
      (reserved (fn2-storage-checkpoint-active fn2-core))
      ((mv thawed fn2-core) (fn2-csnapshot-release token 7 0 1 fn2-core))
      (released (not (fn2-storage-checkpoint-active fn2-core)))
      ((mv again next-token fn2-core) (fn2-csnapshot-begin 7 0 1 fn2-core))
      ((mv stale fn2-core) (fn2-csnapshot-release token 7 0 1 fn2-core))
      ((mv final fn2-core) (fn2-csnapshot-release next-token 7 0 1 fn2-core)))
  (mv (and (eq epoch :ok) (eq bound :ok) (eq began :ok) (eq waits-bound :waiting)
           (eq published :ok) (eq waits-published :waiting) (eq materialized :ok)
           (eq held :held) (= cut 1) (= event 1)
           (eq declared :ok) (eq blocked :full) (eq seal :idle) (eq wrong :owner)
           (eq still-held :held) (= same-cut cut) (= same-event event) reserved
           (eq thawed :ok) released (eq again :ok) (< token next-token)
           (eq stale :owner) (eq final :ok) (not (fn2-core-stopped-p fn2-core)))
      fn2-core)))

(assert-event
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-csu-post fn2-core) ok)))

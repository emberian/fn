; UNEXECUTED primitive geometry/ownership control. The duplicate physical-role
; premise and builder claim are typed fixture setup, not an encoded crash or
; authenticated boot witness. Both claims use the actual allocator primitives.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-bank-closure-edges")
(include-book "../books/machines-b")
(defun fn2-cbce-body (disjoint fn2-checkpoints fn2-extents fn2-ops fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-checkpoints fn2-extents fn2-ops fn2-alloc-edges) :verify-guards nil))
 (b* ((profile (list (cons :extent-slots 2) (cons :checkpoint-candidates *fn2-checkpoint-anchor-slots*) (cons :o 0)))
      (fn2-checkpoints (fn2-checkpoints-init (fn2-b-checkpoint-capacity profile) fn2-checkpoints))
      (fn2-extents (fn2-alloc-init (fn2-b-capacity :extent-slots 16 profile) fn2-extents))
      (fn2-ops (fn2-ops-columns-init (fn2-profile-o profile) fn2-ops))
      (fn2-alloc-edges (fn2-alloc-edges-init (fn2-b-alloc-edge-floor profile) fn2-alloc-edges))
      ((mv epoch-code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv reserved & e epoch allocation fn2-extents) (fn2-alloc-reserve fn2-extents))
      ((mv allocated fn2-extents) (fn2-alloc-commit-allocation e epoch allocation 1 7 fn2-extents))
      (cold (if disjoint (fn2-checkpoint-bank-closure-edge 1 e fn2-extents fn2-ops fn2-checkpoints)
              (fn2-checkpoint-source-edge 1 e fn2-extents fn2-ops fn2-checkpoints)))
      (fresh (fn2-checkpoint-source-edge 1 e fn2-extents fn2-ops fn2-checkpoints))
      ((mv retained fn2-extents fn2-alloc-edges) (fn2-alloc-edge-add cold 7 e epoch allocation :recovery-base fn2-extents fn2-alloc-edges))
      (fn2-checkpoints (fn2-checkpoints-put 1 (state *fn2-checkpoint-state-building*) (checkpoint 8)
       (builder-token 9) (builder-owner-kind 1) (builder-owner-slot 0) (builder-owner-gen 1)))
      (before (list (fn2-extents-copy fn2-extents) (fn2-alloc-edges-copy fn2-alloc-edges)))
      ((mv claimed fn2-extents fn2-alloc-edges)
       (fn2-checkpoint-source-claim 1 8 e epoch allocation fn2-extents fn2-alloc-edges fn2-ops fn2-checkpoints))
      (same-after-claim (equal before (list (fn2-extents-copy fn2-extents) (fn2-alloc-edges-copy fn2-alloc-edges))))
      (before-foreign (list (fn2-extents-copy fn2-extents) (fn2-alloc-edges-copy fn2-alloc-edges)))
      ((mv foreign fn2-extents fn2-alloc-edges)
       (fn2-alloc-edge-add cold 8 e epoch allocation :prepared-successor fn2-extents fn2-alloc-edges))
      (n (fn2-extents-rows fn2-extents)) (c (fn2-checkpoints-rows fn2-checkpoints)))
  (mv (and (eq epoch-code :ok) (eq reserved :ok) (eq allocated :ok) (eq retained :ok)
       (fn2-alloc-edge-matchesp cold 7 e epoch allocation :recovery-base fn2-alloc-edges)
       (eq foreign :edge-live)
       (equal before-foreign (list (fn2-extents-copy fn2-extents) (fn2-alloc-edges-copy fn2-alloc-edges)))
       (= (fn2-checkpoint-bank-closure-edge 0 0 fn2-extents fn2-ops fn2-checkpoints)
          (+ 1 (fn2-checkpoint-cbase-edge (- c 1) (- n 1) fn2-extents fn2-ops fn2-checkpoints)))
       (= (fn2-b-alloc-edge-floor profile)
          (+ 1 (fn2-checkpoint-bank-closure-edge (- *fn2-checkpoint-anchor-slots* 1) (- n 1) fn2-extents fn2-ops fn2-checkpoints)))
       (if disjoint
        (and (eq claimed :ok) (not (= cold fresh))
             (fn2-alloc-edge-matchesp fresh 8 e epoch allocation :prepared-successor fn2-alloc-edges)
             (= (fn2-extents-recovery-base e fn2-extents) 1) (= (fn2-extents-prepared-successor e fn2-extents) 1))
        (and (eq claimed :edge-live) same-after-claim (= cold fresh)
             (= (fn2-extents-prepared-successor e fn2-extents) 0))))
      fn2-checkpoints fn2-extents fn2-ops fn2-alloc-edges)))
(defun fn2-cbce-test (disjoint)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-checkpoints
  (mv-let (ok fn2-checkpoints)
   (with-local-stobj fn2-extents
    (mv-let (ok fn2-checkpoints fn2-extents)
     (with-local-stobj fn2-ops
      (mv-let (ok fn2-checkpoints fn2-extents fn2-ops)
       (with-local-stobj fn2-alloc-edges
        (mv-let (ok fn2-checkpoints fn2-extents fn2-ops fn2-alloc-edges)
         (fn2-cbce-body disjoint fn2-checkpoints fn2-extents fn2-ops fn2-alloc-edges)
         (mv ok fn2-checkpoints fn2-extents fn2-ops)))
       (mv ok fn2-checkpoints fn2-extents)))
     (mv ok fn2-checkpoints)))
   ok)))
(assert-event (fn2-cbce-test t))
(assert-event (fn2-cbce-test nil))

; Actual C producer evidence, not a durable B acceptance/policy witness.
(in-package "ACL2")
(include-book "../books/executor")
(include-book "std/util/bstar" :dir :system)
(defconst *fn2-seu-profile*
 (put-assoc-equal :pool-classes '((8 . 64) (4 . 256) (16 . 4096) (8 . 65536)) *fn2-profile-tiny*))
(defun fn2-seu-resolve (fuel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (mv-let (code fn2-core) (fn2-successor-resolve 0 4096 fn2-core)
   (if (eq code :more) (fn2-seu-resolve (- fuel 1) fn2-core) (mv code fn2-core)))))
(defun fn2-seu-emitted-p (slot gen len fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (ok)
  (and (= (fn2-succ-txns-generation 0 fn2-succ-txns) 1)
       (fn2-successor-emit-claim-current-p 0 1 slot gen len 5 1 1 fn2-succ-txns)
       (not (fn2-successor-emit-claim-current-p 0 2 slot gen len 5 1 1 fn2-succ-txns))
       (not (fn2-successor-emit-claim-current-p 0 1 slot (+ 1 gen) len 5 1 1 fn2-succ-txns))
       (not (fn2-successor-emit-claim-current-p 0 1 slot gen (+ 1 len) 5 1 1 fn2-succ-txns))) ok))
(defun fn2-seu-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-seu-profile* fn2-core))
      ((mv r ws wg fn2-core) (fn2-core-reserve 2 5 1 1 fn2-core))
      ((mv p fn2-core) (fn2-successor-put 0 0 4 :insert fn2-core))
      ((mv k fn2-core) (fn2-successor-arg 0 0 0 :value 1 fn2-core))
      ((mv v fn2-core) (fn2-successor-arg 0 0 1 :value 2 fn2-core))
      ((mv v2 fn2-core) (fn2-successor-arg 0 0 2 :value 3 fn2-core))
      ((mv v3 fn2-core) (fn2-successor-arg 0 0 3 :value 4 fn2-core))
      ((mv v4 fn2-core) (fn2-successor-arg 0 0 4 :value 0 fn2-core))
      ((mv resolved fn2-core) (fn2-seu-resolve 200 fn2-core))
      ((mv staged & fn2-core) (fn2-successor-stage 0 fn2-core))
      ((mv emitted len fn2-core) (fn2-successor-emit 0 ws wg 0 4096 5 1 1 fn2-core))
      (whole (and (eq r :ok) (eq p :ok) (eq k :ok) (eq v :ok) (eq v2 :ok) (eq v3 :ok) (eq v4 :ok) (eq resolved :ok)
                  (eq staged :ok) (eq emitted :ok) (fn2-seu-emitted-p ws wg len fn2-core)))
      ((mv changed fn2-core) (fn2-successor-arg 0 0 2 :value 5 fn2-core))
      (invalidated (not (fn2-seu-emitted-p ws wg len fn2-core)))
      ((mv resolved2 fn2-core) (fn2-seu-resolve 200 fn2-core))
      ((mv staged2 & fn2-core) (fn2-successor-stage 0 fn2-core))
      ((mv emitted2 len2 fn2-core) (fn2-successor-emit 0 ws wg 0 4096 5 1 1 fn2-core))
      (again (fn2-seu-emitted-p ws wg len2 fn2-core))
      ((mv bound fn2-core) (fn2-successor-bind 0 1 7 fn2-core))
      (terminal
       (stobj-let ((fn2-succ-txns (fn2-core-succ-txns fn2-core))) (ok)
        (and (fn2-successor-bind-claim-ready-p 0 1 1 7 ws wg 5 1 1 fn2-succ-txns)
             (not (fn2-successor-bind-claim-ready-p 0 2 1 7 ws wg 5 1 1 fn2-succ-txns))
             (not (fn2-successor-bind-claim-ready-p 0 1 1 8 ws wg 5 1 1 fn2-succ-txns))) ok)))
  (mv (and whole (eq changed :ok) invalidated (eq resolved2 :ok) (eq staged2 :ok)
           (eq emitted2 :ok) again (eq bound :ok) terminal) fn2-core)))
(assert-event (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-seu-body fn2-core) ok)))

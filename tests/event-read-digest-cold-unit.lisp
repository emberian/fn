; Actual persisted checkpoint -> crash -> selected semantic verifier -> digest
; continuation and public boot rebind refusal. SOURCE ONLY; ACL2 UNRUN.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "checkpoint-cold-path-producer-support")
(include-book "column-snapshot-support")
(make-event (if (function-symbolp 'fn2-test-table-snapshot-fn2-checkpoint-restore-reader (w state)) (value '(value-triple :invisible)) (cons 'progn (fn2-test-column-snapshot-events 'fn2-checkpoint-restore-reader (w state)))))
(make-event (if (function-symbolp 'fn2-test-table-snapshot-fn2-checkpoint-restore-events (w state)) (value '(value-triple :invisible)) (cons 'progn (fn2-test-column-snapshot-events 'fn2-checkpoint-restore-events (w state)))))
(make-event (if (function-symbolp 'fn2-test-table-snapshot-fn2-event-read (w state)) (value '(value-triple :invisible)) (cons 'progn (fn2-test-column-snapshot-events 'fn2-event-read (w state)))))
(make-event (if (function-symbolp 'fn2-test-table-snapshot-fn2-mk (w state)) (value '(value-triple :invisible)) (cons 'progn (fn2-test-column-snapshot-events 'fn2-mk (w state)))))
(make-event (if (function-symbolp 'fn2-test-table-snapshot-fn2-fc (w state)) (value '(value-triple :invisible)) (cons 'progn (fn2-test-column-snapshot-events 'fn2-fc (w state)))))
(make-event (if (function-symbolp 'fn2-test-table-snapshot-fn2-pool (w state)) (value '(value-triple :invisible)) (cons 'progn (fn2-test-column-snapshot-events 'fn2-pool (w state)))))
(make-event (if (function-symbolp 'fn2-test-table-snapshot-fn2-digests (w state)) (value '(value-triple :invisible)) (cons 'progn (fn2-test-column-snapshot-events 'fn2-digests (w state)))))
(defun fn2-ecd-snapshot (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-checkpoint-restore-reader (fn2-core-checkpoint-restore-reader fn2-core)) (fn2-checkpoint-restore-events (fn2-core-checkpoint-restore-events fn2-core)) (fn2-event-read (fn2-core-event-read fn2-core)) (fn2-mk (fn2-core-mk fn2-core)) (fn2-fc (fn2-core-fc fn2-core)) (fn2-pool (fn2-core-pool fn2-core)) (fn2-digests (fn2-core-digests fn2-core))) (snapshot)
  (list (fn2-test-table-snapshot-fn2-checkpoint-restore-reader fn2-checkpoint-restore-reader) (fn2-test-table-snapshot-fn2-checkpoint-restore-events fn2-checkpoint-restore-events) (fn2-test-table-snapshot-fn2-event-read fn2-event-read) (fn2-test-table-snapshot-fn2-mk fn2-mk) (fn2-test-table-snapshot-fn2-fc fn2-fc) (fn2-test-table-snapshot-fn2-pool fn2-pool) (fn2-test-table-snapshot-fn2-digests fn2-digests)) snapshot))

(defun fn2-ecd-at-fetch-p (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (let ((id (fn2-machine-kind-base *fn2-boot-kind* fn2-core)))
  (and (eq (fn2-boot-snapshot-read-code id fn2-core) :ok)
       (= (fn2-machine-phase id fn2-core) *fn2-boot-state-checkpoint-events-journal-check*)
       (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))
                   (fn2-checkpoint-restore-events (fn2-core-checkpoint-restore-events fn2-core))) (good)
        (and (= (fn2-checkpoint-restore-events-phase 0 fn2-checkpoint-restore-events) *fn2-checkpoint-restore-events-phase-journal*)
             (= (fn2-event-read-phase 0 fn2-event-read) *fn2-event-read-phase-record-digest*)
             (= (fn2-event-read-record-fetch-next 0 fn2-event-read) 0)) good))))

(defun fn2-ecd-hold-fetch (fuel fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil :measure (nfix fuel)))
 (cond ((fn2-ecd-at-fetch-p fn2-core) (mv :held fn2-core fn2-sim fn2-own))
       ((or (zp fuel) (fn2-core-stopped-p fn2-core) (eq (fn2-boot-status fn2-core) :ready)) (mv :missing fn2-core fn2-sim fn2-own))
       (t (b* (((mv & fn2-core fn2-sim fn2-own) (fn2-ccp-pump fn2-core fn2-sim fn2-own)))
           (fn2-ecd-hold-fetch (- fuel 1) fn2-core fn2-sim fn2-own)))))

(defun fn2-ecd-bytes (left fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix left)))
 (if (zp left) (mv t fn2-core)
  (b* ((next (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))) (n)
               (fn2-event-read-record-fetch-next 0 fn2-event-read) n))
       ((mv code fn2-core) (fn2-boot-checkpoint-events-journal-step 1 fn2-core))
       (good (stobj-let ((fn2-event-read (fn2-core-event-read fn2-core))) (good)
        (and (= (fn2-event-read-record-fetch-next 0 fn2-event-read) (+ 1 next))
             (= (fn2-event-read-phase 0 fn2-event-read)
                (if (= (+ 1 next) 32) *fn2-event-read-phase-read-records* *fn2-event-read-phase-record-digest*))) good))
       ((unless (and (eq code :more) good)) (mv nil fn2-core)))
   (fn2-ecd-bytes (- left 1) fn2-core))))

(defun fn2-ecd-body (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((fn2-core (fn2-init-executor *fn2-ccp-profile* :null nil fn2-core))
      (fn2-sim (fn2-sim-init 1 :none "event-digest-cold" *fn2-ccp-profile* fn2-sim))
      (fn2-own (fn2-own-init *fn2-ccp-profile* fn2-own))
      ((mv started fn2-core) (fn2-boot-start t *fn2-ccp-image-size* fn2-core))
      ((mv created fn2-core fn2-sim fn2-own) (fn2-ccp-drive 200000 nil fn2-core fn2-sim fn2-own))
      ((unless (and (eq started :ok) (eq created :ready))) (mv nil fn2-core fn2-sim fn2-own))
      ((mv published & & fn2-core fn2-sim fn2-own) (fn2-ccp-prefix-and-publication fn2-core fn2-sim fn2-own))
      ((unless (eq published :complete)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv restarted fn2-core fn2-sim fn2-own) (fn2-ccp-restart *fn2-ccp-profile* *fn2-ccp-image-size* fn2-core fn2-sim fn2-own))
      ((mv held fn2-core fn2-sim fn2-own) (fn2-ecd-hold-fetch 600000 fn2-core fn2-sim fn2-own))
      ((unless (and (eq restarted :ok) (eq held :held))) (mv nil fn2-core fn2-sim fn2-own))
      (id (fn2-machine-kind-base *fn2-boot-kind* fn2-core)) (generation (fn2-machine-generation id fn2-core))
      (before (fn2-ecd-snapshot fn2-core))
      ((mv rebound fn2-core) (fn2-boot-checkpoint-events-begin id generation fn2-core))
      ((unless (and (eq rebound :state) (equal before (fn2-ecd-snapshot fn2-core)))) (mv nil fn2-core fn2-sim fn2-own))
      ((mv bound fn2-core) (fn2-boot-checkpoint-events-journal-bind fn2-core))
      ((unless (and (eq bound :state) (equal before (fn2-ecd-snapshot fn2-core)))) (mv nil fn2-core fn2-sim fn2-own))
      ((mv zero fn2-core) (fn2-boot-checkpoint-events-journal-step 0 fn2-core))
      ((unless (and (eq zero :yield) (equal before (fn2-ecd-snapshot fn2-core)))) (mv nil fn2-core fn2-sim fn2-own))
      ((mv completed fn2-core) (fn2-ecd-bytes 32 fn2-core)))
  (mv completed fn2-core fn2-sim fn2-own)))
(defun fn2-ecd-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (answer fn2-core)
   (with-local-stobj fn2-sim
    (mv-let (answer fn2-core fn2-sim)
     (with-local-stobj fn2-own
      (mv-let (answer fn2-core fn2-sim fn2-own) (fn2-ecd-body fn2-core fn2-sim fn2-own)
       (mv answer fn2-core fn2-sim))) (mv answer fn2-core))) answer)))
(assert-event (fn2-ecd-test))

; Expand the actual owning macros; no ACL2 process or replacement generator.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun intern-in-package-of-symbol (name sym) (intern name (symbol-package sym)))
(defun selected-form (path name)
 (with-open-file (in path)
  (loop for form = (read in nil :eof) until (eq form :eof)
        when (and (consp form) (eq (cadr form) name)) return form)))
(eval (selected-form "books/columns.lisp" 'fn2-columns-sym))
(eval (selected-form "books/format-check.lisp" 'fn2-fc-shape-claims))
(eval (selected-form "books/runs-assemble.lisp" 'fn2-ra-shape))
(defun page-events (path)
 (eval (selected-form path 'fn2-ra-lookup-events))
 (mapcar (lambda (form)
           (if (and (consp form) (eq (car form) 'fn2-ra-shape))
               (macroexpand-1 form) form))
         (cdr (macroexpand-1 '(fn2-ra-lookup-events)))))
(defun strip-proof-hints (x)
 (cond ((atom x) x)
       ((eq (car x) 'defthm)
        (append (subseq x 0 3)
                (loop for (key value) on (cdddr x) by #'cddr
                      unless (eq key :hints) append (list key value))))
       (t (mapcar #'strip-proof-hints x))))
(defparameter *old* (page-events (sb-ext:posix-getenv "FN_RA_BASELINE")))
(defparameter *new* (page-events (or (sb-ext:posix-getenv "FN_RA_CANDIDATE")
                                   "books/runs-assemble.lisp")))
(assert (equal (mapcar #'strip-proof-hints *old*)
               (mapcar #'strip-proof-hints *new*)))
(let ((changed (loop for a in *old* for b in *new* unless (equal a b) collect b)))
 (assert (= (length changed) 1))
 (let* ((fact (car changed)) (hint (car (getf (cdddr fact) :hints)))
        (theory (getf (cdr hint) :in-theory)))
  (assert (eq (cadr fact) 'fn2-run-step-header-shape))
  (assert (eq (car theory) 'disable))
  (dolist (name '(fn2-run-layout-page-kind fn2-run-header-value
                 fn2-run-readerp fn2-run-cursors-schema))
   (assert (member name (cdr theory))))))
; A runtime mutation must remain visible to the identity check.
(let ((changed (copy-tree *new*)))
 (setf (car changed) '(defun changed-runtime () nil))
 (assert (not (equal (mapcar #'strip-proof-hints *old*)
                     (mapcar #'strip-proof-hints changed)))))
(format t "RUN HEADER SHAPE CONTROLS PASS~%")

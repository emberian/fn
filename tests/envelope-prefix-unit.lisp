(in-package "ACL2")
(include-book "../sim/envelope-prefix")
(include-book "../books/owed-conn")
(include-book "evidence/native-envelope-trace")

(defconst *fn2-envelope-prefix-test-profile*
  (put-assoc-equal :trace nil *fn2-conn-wire-profile*))

; Split immediately after Take, before Ack: TAKEN is essential state, not
; an optional replay statistic. Dropping it makes the very next event illegal.
(defun fn2-envelope-resume-test-run (drop-taken fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (let ((fn2-core (fn2-init-executor *fn2-envelope-prefix-test-profile* :echo nil fn2-core)))
    (mv-let (first taken caps fn2-core)
      (fn2-envelope-prefix (take 3 *fn2-native-trace*) 0 t nil nil fn2-core)
      (let ((antecedent (and (true-listp (take 3 *fn2-native-trace*))
                             (natp 0) (eq first :pass) (consp taken))))
        (mv-let (last taken caps fn2-core)
          (fn2-envelope-prefix (nthcdr 3 *fn2-native-trace*) 3 t
            (if drop-taken nil taken) caps fn2-core)
          (declare (ignore taken))
          (mv (list antecedent last caps) fn2-core))))))
(defun fn2-envelope-resume-test (drop-taken)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (answer fn2-core) (fn2-envelope-resume-test-run drop-taken fn2-core) answer)))

(assert-event
 (let ((whole (fn2-envelope-replay *fn2-native-trace* *fn2-envelope-prefix-test-profile* t))
       (resumed (fn2-envelope-resume-test nil))
       (mutant (fn2-envelope-resume-test t)))
   (and (eq (car whole) :pass)
        (equal resumed (cons t whole))
        (equal (take 2 mutant) '(t (:ack-untaken 3))))))

(defun fn2-envelope-core-bytes (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (bytes)
    (fn2-pool-logical-octets 128 0 fn2-pool) bytes))
(defun fn2-envelope-core-sentinels (fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (stobj-let ((fn2-pool (fn2-core-pool fn2-core))) (fn2-pool)
    (let* ((fn2-pool (update-fn2-pool-datai 5 91 fn2-pool))
           (fn2-pool (update-fn2-pool-datai 64 93 fn2-pool))) fn2-pool)
    fn2-core))

; Exercise the actual prefix interpreter, not only its byte-write helper.
; The descriptor is obtained from a real issued Read and taken/acknowledged
; through the same validator as recorded native traces.
(defun fn2-envelope-short-read-run (bad-count fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       ((mv code slot gen fn2-core) (fn2-core-reserve 0 1 0 1 fn2-core))
       ((unless (and (eq code :ok) (equal slot 0))) (mv nil fn2-core))
       ((mv code fn2-core) (fn2-core-write slot gen 0 11 1 0 1 fn2-core))
       ((unless (eq code :ok)) (mv nil fn2-core))
       ((mv code fn2-core) (fn2-core-write slot gen 1 12 1 0 1 fn2-core))
       ((unless (eq code :ok)) (mv nil fn2-core))
       (fn2-core (fn2-envelope-core-sentinels fn2-core))
       ((mv code op og fn2-core) (fn2-issue-read 0 slot gen 8 1 0 1 0 fn2-core))
       ((unless (eq code :ok)) (mv nil fn2-core))
       (descriptor (fn2-envelope-descriptor op fn2-core))
       ((mv verdict taken caps fn2-core)
        (fn2-envelope-prefix (list (append (list :take op og) descriptor) '(:ack 1))
          0 t nil nil fn2-core))
       ((unless (eq verdict :pass)) (mv nil fn2-core))
       (before (fn2-envelope-core-bytes fn2-core))
       ((mv outcome reason count aux0 aux1)
        (fn2-host-result *fn2-action-read* :ok (if bad-count 3 2) 0 8 nil))
       ((unless (and (equal outcome *fn2-outcome-short*)
                     (fn2-host-result-allowedp *fn2-action-read* outcome reason count aux0 aux1 8 0)))
        (mv nil fn2-core))
       (post (list :post 0 op og *fn2-event-read-result* outcome reason count aux0 aux1
                    *fn2-peer-family-none* '(0 0 0 0 0) '(70 71)))
       ((mv verdict taken caps fn2-core)
        (fn2-envelope-prefix (list post) 2 t taken caps fn2-core))
       (- taken)
       (- caps)
       (after (fn2-envelope-core-bytes fn2-core)))
    (mv (if bad-count
            (and (equal verdict '(:receive-loan 2)) (equal after before))
          (and (eq verdict :pass)
               (equal after (append (take 2 before) '(70 71) (nthcdr 4 before)))
               (not (equal after before))))
        fn2-core)))
(defun fn2-envelope-short-read-test (bad-count)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (ok fn2-core) (fn2-envelope-short-read-run bad-count fn2-core) ok)))
(assert-event (and (fn2-envelope-short-read-test nil)
                   (fn2-envelope-short-read-test t)))

; The real issued Fence establishes the descriptor incarnation. Return-only
; is a legal prefix with a live pending packet and no terminal publication.
(defun fn2-envelope-fence-return-run (mutation fn2-core)
  (declare (xargs :stobjs fn2-core :verify-guards nil))
  (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
       ((mv code op gen fn2-core) (fn2-issue-fence 1 0 1 0 fn2-core))
       ((unless (eq code :ok)) (mv nil fn2-core))
       (descriptor (fn2-envelope-descriptor op fn2-core))
       ((mv verdict taken caps fn2-core)
        (fn2-envelope-prefix (list (append (list :take op gen) descriptor) '(:ack 1))
                             0 t nil nil fn2-core))
       ((unless (eq verdict :pass)) (mv nil fn2-core))
       (packet (list op gen *fn2-action-fence* *fn2-event-fence-result* 0 :ok 0 0 0 0 0))
       (recorded (if (eq mutation :generation) (update-nth 1 (+ 1 gen) packet) packet))
       ((mv verdict taken caps fn2-core)
        (fn2-envelope-prefix (list (list :physical-return recorded (if (eq mutation :raw) -1 0) 0)) 2 t taken caps fn2-core))
       ((when (eq mutation :raw))
        (mv (and (equal verdict '(:physical-return-raw 2))
                 (not (nth 13 (fn2-envelope-get op taken)))) fn2-core))
       ((when (eq mutation :generation))
        (mv (and (equal verdict '(:physical-return-descriptor 2))
                 (not (nth 13 (fn2-envelope-get op taken)))) fn2-core))
       ((unless (and (eq verdict :pass)
                     (equal (nth 13 (fn2-envelope-get op taken)) packet)
                     (not (nth 10 (fn2-envelope-get op taken))))) (mv nil fn2-core))
       (post (list :post 0 op gen *fn2-event-fence-result*
                    (if (eq mutation :outcome) *fn2-outcome-failed* *fn2-outcome-done*)
                    *fn2-reason-none* 0 0 0 *fn2-peer-family-none* '(0 0 0 0 0) nil))
       (next (if (eq mutation :duplicate) (list :physical-return packet) post))
       ((mv verdict taken caps fn2-core)
        (fn2-envelope-prefix (list next) 3 t taken caps fn2-core))
       (- caps)
       (tk (fn2-envelope-get op taken)))
    (mv (cond ((eq mutation :duplicate)
               (and (equal verdict '(:physical-return-twice 3)) (equal (nth 13 tk) packet)))
              ((eq mutation :outcome)
               (and (equal verdict '(:physical-return-post 3)) (equal (nth 13 tk) packet)
                    (not (nth 10 tk))))
              (t (and (eq verdict :pass) (not (nth 13 tk)) (nth 10 tk))))
        fn2-core)))
(defun fn2-envelope-fence-return-test (mutation)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-core
    (mv-let (ok fn2-core) (fn2-envelope-fence-return-run mutation fn2-core) ok)))
(assert-event
 (and (fn2-envelope-fence-return-test nil)
      (fn2-envelope-fence-return-test :generation)
      (fn2-envelope-fence-return-test :duplicate)
      (fn2-envelope-fence-return-test :outcome)
      (fn2-envelope-fence-return-test :raw)))

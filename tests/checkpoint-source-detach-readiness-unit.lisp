; UNEXECUTED connected source control. Real publication drives source-reader
; finish; snapshots include all mutable finish outputs and readonly working
; owner/windows. No detached/readiness/producer phase is assigned here.
(in-package "ACL2")
(include-book "checkpoint-live-publication-support")
(include-book "column-snapshot-support")
(include-book "../books/run-physical-readiness")
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-checkpoint-root1 (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-checkpoint-windows (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-run-loads (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-run-cursors (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-checkpoint-summary (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-checkpoint-summary-leases (w state))))
(defun fn2-cld-snapshot (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let (  (fn2-checkpoint-root1 (fn2-core-checkpoint-root1 fn2-core))
  (fn2-checkpoint-windows (fn2-core-checkpoint-windows fn2-core))
  (fn2-run-loads (fn2-core-run-loads fn2-core))
  (fn2-run-cursors (fn2-core-run-cursors fn2-core))
  (fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
  (fn2-checkpoint-summary-leases (fn2-core-checkpoint-summary-leases fn2-core))) (snapshot)
  (list (fn2-test-table-snapshot-fn2-checkpoint-root1 fn2-checkpoint-root1)
(fn2-test-table-snapshot-fn2-checkpoint-windows fn2-checkpoint-windows)
(fn2-test-table-snapshot-fn2-run-loads fn2-run-loads)
(fn2-test-table-snapshot-fn2-run-cursors fn2-run-cursors)
(fn2-test-table-snapshot-fn2-checkpoint-summary fn2-checkpoint-summary)
(fn2-test-table-snapshot-fn2-checkpoint-summary-leases fn2-checkpoint-summary-leases)) snapshot))
(defun fn2-cld-finish (wrong-gen fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let (  (fn2-checkpoint-root1 (fn2-core-checkpoint-root1 fn2-core))
  (fn2-checkpoint-windows (fn2-core-checkpoint-windows fn2-core))
  (fn2-csnapshot (fn2-core-csnapshot fn2-core))
  (fn2-checkpoint-metadata (fn2-core-checkpoint-metadata fn2-core))
  (fn2-checkpoint-source (fn2-core-checkpoint-source fn2-core))
  (fn2-checkpoint-metadata-manifest (fn2-core-checkpoint-metadata-manifest fn2-core))
  (fn2-run-loads (fn2-core-run-loads fn2-core))
  (fn2-run-cursors (fn2-core-run-cursors fn2-core))
  (fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
  (fn2-checkpoint-summary-leases (fn2-core-checkpoint-summary-leases fn2-core))
  (fn2-pool (fn2-core-pool fn2-core)))
  (code fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases)
  (fn2-checkpoint-source-reader-finish
   (fn2-checkpoint-root1-token 0 fn2-checkpoint-root1)
   (fn2-checkpoint-root1-owner-kind 0 fn2-checkpoint-root1)
   (fn2-checkpoint-root1-owner-slot 0 fn2-checkpoint-root1)
   (+ (if wrong-gen 1 0) (fn2-checkpoint-root1-owner-gen 0 fn2-checkpoint-root1))
   fn2-checkpoint-root1 fn2-checkpoint-windows fn2-csnapshot fn2-checkpoint-metadata fn2-checkpoint-source fn2-checkpoint-metadata-manifest fn2-run-loads fn2-run-cursors fn2-checkpoint-summary fn2-checkpoint-summary-leases fn2-pool) (mv code fn2-core)))
(defun fn2-cld-ready (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let (  (fn2-run-load-geometry (fn2-core-run-load-geometry fn2-core))
  (fn2-run-loads (fn2-core-run-loads fn2-core))
  (fn2-run-cursors (fn2-core-run-cursors fn2-core))
  (fn2-checkpoint-summary-leases (fn2-core-checkpoint-summary-leases fn2-core))
  (fn2-fc (fn2-core-fc fn2-core))
  (fn2-fc-context (fn2-core-fc-context fn2-core))
  (fn2-b3 (fn2-core-b3 fn2-core))
  (fn2-fields (fn2-core-fields fn2-core))
  (fn2-digests (fn2-core-digests fn2-core))) (ready)
  (fn2-run-load-readiness-one-row-p
   (fn2-b-checkpoint-source-cursor-from-rows (fn2-run-loads-rows fn2-run-loads))
   fn2-run-load-geometry fn2-run-loads fn2-run-cursors fn2-checkpoint-summary-leases fn2-fc fn2-fc-context fn2-b3 fn2-fields fn2-digests) ready))
(defun fn2-cld-body (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((mv held fn2-core fn2-sim fn2-own) (fn2-clc-produce-held fn2-core fn2-sim fn2-own))
      ((unless (eq held :held)) (mv nil fn2-core fn2-sim fn2-own))
      (before (fn2-cld-snapshot fn2-core))
      (ready (fn2-cld-ready fn2-core))
      ((mv refused fn2-core) (fn2-cld-finish t fn2-core))
      (unchanged (equal before (fn2-cld-snapshot fn2-core)))
      ((mv accepted fn2-core) (fn2-cld-finish nil fn2-core)))
  (mv (and ready (eq refused :source) unchanged (eq accepted :ok)
           (equal before (fn2-cld-snapshot fn2-core)) (fn2-cld-ready fn2-core))
      fn2-core fn2-sim fn2-own)))
(defun fn2-cld-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (with-local-stobj fn2-sim (with-local-stobj fn2-own
  (mv-let (ok fn2-core fn2-sim fn2-own) (fn2-cld-body fn2-core fn2-sim fn2-own) ok)))))
(assert-event (fn2-cld-test))

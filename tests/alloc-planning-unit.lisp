; Actual allocator planning transitions; the HELD/candidate/recipe coordinator
; remains a separate integration obligation. No synthetic packing model.
(in-package "ACL2")
(include-book "alloc-test-state")
(include-book "std/util/bstar" :dir :system)
(defun fn2-alloc-planning-test-view (fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (list (fn2-extents-copy fn2-extents) (fn2-alloc-free-head fn2-extents)
       (fn2-alloc-current-epoch fn2-extents) (fn2-alloc-next-counter fn2-extents)
       (fn2-alloc-freeze-phase fn2-extents) (fn2-alloc-freeze-token fn2-extents)
       (fn2-alloc-freeze-owner-kind fn2-extents) (fn2-alloc-freeze-owner-slot fn2-extents)
       (fn2-alloc-freeze-owner-gen fn2-extents)
       (fn2-alloc-retirement-intent-batch fn2-extents)))
(defun fn2-alloc-planning-test-body (fn2-extents fn2-alloc-edges)
 (declare (xargs :stobjs (fn2-extents fn2-alloc-edges) :verify-guards nil))
 (b* ((fn2-extents (fn2-alloc-init 2 fn2-extents))
      (fn2-alloc-edges (fn2-alloc-edges-init 1 fn2-alloc-edges))
      ((mv epoch-code fn2-extents) (fn2-alloc-begin-epoch 1 fn2-extents))
      ((mv owner-code fn2-extents) (fn2-alloc-snapshot-prepare 7 3 2 1 fn2-extents))
      (head (fn2-alloc-free-head fn2-extents))
      ((mv begin-code fn2-extents) (fn2-alloc-planning-begin 7 3 2 1 head 1 0 fn2-extents))
      (before (fn2-alloc-planning-test-view fn2-extents))
      ((mv outsider & & & & fn2-extents) (fn2-alloc-reserve fn2-extents))
      (outside-same (equal before (fn2-alloc-planning-test-view fn2-extents)))
      ((mv stale & & & & fn2-extents) (fn2-alloc-planning-reserve 7 3 2 2 head 1 0 fn2-extents))
      (stale-same (equal before (fn2-alloc-planning-test-view fn2-extents)))
      ((mv drift & & & & fn2-extents) (fn2-alloc-planning-reserve 7 3 2 1 head 1 1 fn2-extents))
      (drift-same (equal before (fn2-alloc-planning-test-view fn2-extents)))
      ((mv reserved & extent epoch allocation fn2-extents) (fn2-alloc-planning-reserve 7 3 2 1 head 1 0 fn2-extents))
      ((mv pin fn2-extents fn2-alloc-edges) (fn2-alloc-edge-add 0 19 extent epoch allocation :outstanding-io fn2-extents fn2-alloc-edges))
      ((mv blocked fn2-extents) (fn2-alloc-planning-cancel 7 3 2 1 extent epoch allocation fn2-extents))
      ((mv dropped fn2-extents fn2-alloc-edges) (fn2-alloc-edge-drop 0 19 extent epoch allocation :outstanding-io fn2-extents fn2-alloc-edges))
      ((mv cancelled fn2-extents) (fn2-alloc-planning-cancel 7 3 2 1 extent epoch allocation fn2-extents))
      (after-cancel (fn2-alloc-planning-test-view fn2-extents))
      (now-head (fn2-alloc-free-head fn2-extents))
      (now-counter (fn2-alloc-next-counter fn2-extents))
      ((mv stale-end fn2-extents) (fn2-alloc-planning-end 7 3 2 2 now-head 1 now-counter fn2-extents))
      (still-closed (and (equal after-cancel (fn2-alloc-planning-test-view fn2-extents)) (equal (fn2-alloc-freeze-phase fn2-extents) 3)))
      ((mv ended fn2-extents) (fn2-alloc-planning-end 7 3 2 1 now-head 1 now-counter fn2-extents))
      ((mv ordinary & & & & fn2-extents) (fn2-alloc-reserve fn2-extents)))
  (mv (and (eq epoch-code :ok) (eq owner-code :ok) (eq begin-code :ok)
           (eq outsider :frozen) outside-same (eq stale :planning) stale-same
           (eq drift :planning) drift-same (eq reserved :ok) (eq pin :ok)
           (eq blocked :outstanding-io) (eq dropped :ok) (eq cancelled :ok)
           (eq stale-end :planning) still-closed (eq ended :ok) (eq ordinary :ok))
      fn2-extents fn2-alloc-edges)))
(defun fn2-alloc-planning-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-extents
  (mv-let (answer fn2-extents)
   (with-local-stobj fn2-alloc-edges
    (mv-let (answer fn2-extents fn2-alloc-edges)
     (fn2-alloc-planning-test-body fn2-extents fn2-alloc-edges)
     (mv answer fn2-extents))) answer)))
(assert-event (fn2-alloc-planning-test))

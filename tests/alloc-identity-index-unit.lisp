(defun fn2-aiu-clear (fuel fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-extents)
  (b* (((mv code fn2-extents) (fn2-alloc-identity-clear-step 7 2 3 4 fn2-extents)))
   (if (eq code :more) (fn2-aiu-clear (- fuel 1) fn2-extents) (mv code fn2-extents)))))
(defun fn2-aiu-probe (fuel kind owner ogen source fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-extents)
  (b* (((mv code fn2-extents) (fn2-alloc-identity-step kind owner ogen source fn2-extents)))
   (if (eq code :more) (fn2-aiu-probe (- fuel 1) kind owner ogen source fn2-extents) (mv code fn2-extents)))))
(defun fn2-aiu-start (n fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (b* ((fn2-extents (fn2-alloc-init n fn2-extents))
      (fn2-extents (update-fn2-alloc-current-epoch 3 fn2-extents))
      ((mv code fn2-extents) (fn2-alloc-identity-begin 7 2 3 4 fn2-extents))
      ((unless (eq code :more)) (mv nil fn2-extents))
      ((mv code fn2-extents) (fn2-aiu-clear (+ 1 n) fn2-extents)))
  (mv (and (eq code :active) (fn2-alloc-identity-refines-p fn2-extents)
           (fn2-alloc-invp fn2-extents)) fn2-extents)))
(defun fn2-aiu-adopt (i epoch counter fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (b* (((mv prepared fn2-extents) (fn2-alloc-identity-prepare-adopt 7 2 3 4 i *fn2-alloc-none* epoch counter fn2-extents))
      ((mv probed fn2-extents) (fn2-aiu-probe (+ 1 (fn2-extents-rows fn2-extents)) 7 2 3 4 fn2-extents))
      ((mv code fn2-extents) (fn2-alloc-identity-commit-adopt 7 2 3 4 fn2-extents)))
  (mv (and (eq prepared :more) (eq probed :ready) (eq code :ok)
           (fn2-alloc-identity-refines-p fn2-extents) (fn2-alloc-invp fn2-extents)) fn2-extents)))
(defun fn2-aiu-collisions (fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (b* (((mv start fn2-extents) (fn2-aiu-start 3 fn2-extents))
      ((mv a fn2-extents) (fn2-aiu-adopt 0 0 0 fn2-extents))
      ((mv b fn2-extents) (fn2-aiu-adopt 1 1 1 fn2-extents))
      ((mv c fn2-extents) (fn2-aiu-adopt 2 2 2 fn2-extents))
      (full (and (= (fn2-alloc-identity-count fn2-extents) 3)
                 (= (fn2-alloc-identity-visited fn2-extents) 3)))
      ((mv committed fn2-extents) (fn2-alloc-commit-allocation-transition 0 0 0 6 11 fn2-extents))
      ((mv retired fn2-extents) (fn2-alloc-retire-transition 0 0 0 1 fn2-extents))
      ((mv prepared fn2-extents) (fn2-alloc-identity-prepare-free 7 2 3 4 0 0 0 1 fn2-extents))
      ((mv probed fn2-extents) (fn2-aiu-probe 4 7 2 3 4 fn2-extents))
      (receipt (and (fn2-alloc-identity-free-ready-p 7 2 3 4 0 0 0 1 fn2-extents)
                    (not (fn2-alloc-identity-free-ready-p 7 2 3 4 0 0 0 2 fn2-extents))))
      ((mv freed fn2-extents) (fn2-alloc-identity-commit-free 7 2 3 4 fn2-extents))
      (tomb (and (= (fn2-alloc-identity-statesi 0 fn2-extents) *fn2-alloc-identity-bucket-tombstone*)
                 (fn2-alloc-identity-refines-p fn2-extents) (fn2-alloc-invp fn2-extents)))
      ((mv reused fn2-extents) (fn2-aiu-adopt 0 1 2 fn2-extents)))
  (mv (and start a b c full (eq committed :ok) (eq retired :ok) (eq prepared :more)
           (eq probed :ready) receipt (eq freed :ok) tomb reused
           (= (fn2-alloc-identity-visited fn2-extents) 3)
           (= (fn2-alloc-identity-statesi 0 fn2-extents) *fn2-alloc-identity-bucket-used*)) fn2-extents)))
(defun fn2-aiu-view (fn2-extents)

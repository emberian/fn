(defun fn2-aiu-refusals (fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (b* (((mv start fn2-extents) (fn2-aiu-start 2 fn2-extents))
      ((mv adopted fn2-extents) (fn2-aiu-adopt 0 0 0 fn2-extents))
      ((mv prepared fn2-extents) (fn2-alloc-identity-prepare-adopt 7 2 3 4 1 *fn2-alloc-none* 0 0 fn2-extents))
      (before (fn2-aiu-view fn2-extents))
      ((mv wrong fn2-extents) (fn2-alloc-identity-step 7 2 3 5 fn2-extents))
      (unchanged (equal before (fn2-aiu-view fn2-extents)))
      ((mv transfer fn2-extents) (fn2-alloc-identity-transfer 7 2 3 4 8 5 6 fn2-extents))
      (still (equal before (fn2-aiu-view fn2-extents)))
      ((mv conflict fn2-extents) (fn2-alloc-identity-step 7 2 3 4 fn2-extents))
      ((mv commit fn2-extents) (fn2-alloc-identity-commit-adopt 7 2 3 4 fn2-extents))
      (duplicate-refused (and (eq conflict :conflict) (eq commit :changed)
          (= (fn2-extents-state 1 fn2-extents) *fn2-extent-state-free*)
          (fn2-alloc-identity-refines-p fn2-extents)))
      (fn2-extents (fn2-alloc-init 2 fn2-extents))
      ((mv stale fn2-extents) (fn2-alloc-identity-commit-adopt 7 2 3 4 fn2-extents))
      ((mv restarted fn2-extents) (fn2-aiu-start 0 fn2-extents))
      ((mv moved fn2-extents) (fn2-alloc-identity-transfer 7 2 3 4 8 5 6 fn2-extents))
      ((mv old fn2-extents) (fn2-alloc-identity-prepare-adopt 7 2 3 4 0 *fn2-alloc-none* 0 0 fn2-extents))
      ((mv empty fn2-extents) (fn2-alloc-identity-prepare-adopt 8 5 6 4 0 *fn2-alloc-none* 0 0 fn2-extents)))
  (mv (and start adopted (eq prepared :more) (eq wrong :owner) unchanged
           (eq transfer :owner) still duplicate-refused (eq stale :changed)
           restarted (eq moved :ok) (eq old :owner) (eq empty :bounds)
           (fn2-alloc-identity-refines-p fn2-extents)) fn2-extents)))
(defun fn2-aiu-progress (fn2-extents)
 (declare (xargs :stobjs fn2-extents :verify-guards nil))
 (b* (((mv start fn2-extents) (fn2-aiu-start 1 fn2-extents))
      ((mv prepared fn2-extents) (fn2-alloc-identity-adopt-progress 7 2 3 4 0 *fn2-alloc-none* 0 0 fn2-extents))

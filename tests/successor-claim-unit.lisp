; Typed carrier reservation only; this does not witness journal acceptance.
(in-package "ACL2")
(include-book "../books/successor-claim")
(include-book "std/util/bstar" :dir :system)
(defun fn2-successor-claim-unit (fn2-succ-txns fn2-id-engine)
 (declare (xargs :stobjs (fn2-succ-txns fn2-id-engine) :verify-guards nil))
 (b* ((fn2-succ-txns (fn2-succ-txns-init 2 fn2-succ-txns))
      (fn2-id-engine (fn2-id-engine-init 1 fn2-id-engine))
      (fn2-succ-txns (fn2-succ-txns-put 0
       (phase *fn2-succ-phase-staged*) (generation 7) (emit-valid 1)
       (emit-origin *fn2-succ-emit-origin-live*) (emit-slot 3) (emit-gen 4)
       (emit-off 0) (emit-len 12) (emit-kind 2) (emit-owner 9) (emit-owner-gen 5)))
      (before-tx (fn2-succ-txns-snapshot fn2-succ-txns))
      (before-engine (fn2-id-engine-snapshot fn2-id-engine))
      ((mv stale fn2-succ-txns fn2-id-engine)
       (fn2-successor-bind-claim-reserve 0 6 1 1 3 4 12 2 9 5 fn2-succ-txns fn2-id-engine))
      (stale-ok (and (eq stale :state)
        (equal before-tx (fn2-succ-txns-snapshot fn2-succ-txns))
        (equal before-engine (fn2-id-engine-snapshot fn2-id-engine))))
      ((mv wrong fn2-succ-txns fn2-id-engine)
       (fn2-successor-bind-claim-reserve 0 7 1 1 3 99 12 2 9 5 fn2-succ-txns fn2-id-engine))
      (wrong-ok (and (eq wrong :state)
        (equal before-tx (fn2-succ-txns-snapshot fn2-succ-txns))
        (equal before-engine (fn2-id-engine-snapshot fn2-id-engine))))
      ((mv yes fn2-succ-txns fn2-id-engine)
       (fn2-successor-bind-claim-reserve 0 7 1 1 3 4 12 2 9 5 fn2-succ-txns fn2-id-engine))
      (claimed-tx (fn2-succ-txns-snapshot fn2-succ-txns))
      (claimed-engine (fn2-id-engine-snapshot fn2-id-engine))
      ((mv repeat fn2-succ-txns fn2-id-engine)
       (fn2-successor-bind-claim-reserve 0 7 1 1 3 4 12 2 9 5 fn2-succ-txns fn2-id-engine)))
  (mv (and stale-ok wrong-ok (eq yes :ok) (eq repeat :state)
       (equal claimed-tx (fn2-succ-txns-snapshot fn2-succ-txns))
       (equal claimed-engine (fn2-id-engine-snapshot fn2-id-engine))
       (equal (fn2-id-engine-binding-phase 0 fn2-id-engine) *fn2-succ-binder-phase-admitted*)
       (equal (fn2-id-engine-binding-generation 0 fn2-id-engine) 7)
       (equal (fn2-id-engine-binding-batch 0 fn2-id-engine) 1)
       (equal (fn2-succ-txns-phase 0 fn2-succ-txns) *fn2-succ-phase-binding*)
       (equal (fn2-succ-txns-bind-phase 0 fn2-succ-txns) *fn2-succ-bind-phase-claimed*))
      fn2-succ-txns fn2-id-engine)))
(assert-event
 (with-local-stobj fn2-succ-txns
  (mv-let (ok fn2-succ-txns)
   (with-local-stobj fn2-id-engine
    (mv-let (ok fn2-succ-txns fn2-id-engine)
     (fn2-successor-claim-unit fn2-succ-txns fn2-id-engine)
     (mv ok fn2-succ-txns))) ok)))

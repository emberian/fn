; Execute the actual event producer with explicit metadata/ABI fixtures.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun assoc-eq (x xs) (assoc x xs))
(defun fn2-decl-get (key row) (getf row key))
(defun fn2-decl-row (key world) (cdr (assoc key (getf world :rows) :test #'equal)))
(defun getpropc (name property default world)
 (getf (cdr (assoc name (getf world :properties))) property default))
(defun fn2-columns-sym (name suffix) (intern (concatenate 'string (symbol-name name) suffix) "ACL2"))
(defun fn2-columns-pre (prefix name) (intern (concatenate 'string prefix (symbol-name name)) "ACL2"))
(defun fn2-columns-col-name (table field) (fn2-columns-sym table (concatenate 'string "-" (symbol-name field))))
(defmacro er (mode context message &rest args)
 (declare (ignore mode)) `(error "~S ~S ~S" ',context ,message (list ,@args)))
(with-open-file (in (or (sb-ext:posix-getenv "FRAME_SOURCE") "books/columns-observation-frames.lisp"))
 (loop for form = (read in nil :eof) until (eq form :eof) do
  (when (member (car form) '(defun defmacro)) (eval form))))
(defun fixture-world ()
 (list :rows '(((:columns sources) :columns ((hash-offset :u64) (unit-hashed :u32))))
       :properties
       (list (list 'sources-hash-offset 'unnormalized-body '(sources-hash-offset$ai i sources)
                   'stobjs-in '(nil sources) 'stobjs-out '(nil))
             (list 'sources-set-unit-hashed 'unnormalized-body '(update-sources-unit-hashed$ai i v sources)
                   'stobjs-in '(nil nil sources) 'stobjs-out '(sources))
             (list 'sources-set-unit-hashed-nth 'theorem '(equal x x))
             (list 'sources-set-hash-offset 'unnormalized-body '(update-sources-hash-offset$ai i v sources)
                   'stobjs-in '(nil nil sources) 'stobjs-out '(sources))
             (list 'sources-set-hash-offset-nth 'theorem '(equal x x)))))
(defun produce (world &optional (read-field 'hash-offset) (write-field 'unit-hashed) (table 'sources))
 (fn2-columns-observation-frame-event 'offset-after-hashed table read-field write-field world))
(defun refuses (world &optional (read-field 'hash-offset) (write-field 'unit-hashed) (table 'sources))
 (assert (handler-case (progn (produce world read-field write-field table) nil) (error () t))))
; Exact whole equality is unconditional, retains independent indices and the
; original table, and opens only the observer in this theorem's local proof.
(assert (equal (produce (fixture-world))
 '(defthm offset-after-hashed
    (equal (sources-hash-offset i (sources-set-unit-hashed j v sources))
           (sources-hash-offset i sources))
    :hints (("Goal" :in-theory
             (e/d (sources-hash-offset sources-hash-offset$ai sources-set-unit-hashed-nth)
                  (sources-set-unit-hashed nth)))))))
(refuses (fixture-world) 'hash-offset 'hash-offset)
(refuses (fixture-world) 'missing)
(refuses (fixture-world) 'hash-offset 'missing)
(refuses (fixture-world) 'hash-offset 'unit-hashed 'other)
(dolist (spec '((sources-hash-offset stobjs-in (nil other))
                (sources-hash-offset stobjs-out (sources))
                (sources-set-unit-hashed stobjs-in (nil nil other))
                (sources-set-unit-hashed stobjs-out (other))
                (sources-set-unit-hashed-nth theorem nil)
                (sources-hash-offset unnormalized-body nil)
                (sources-set-unit-hashed symbol-class :program)))
 (let ((world (fixture-world)))
  (setf (getf (cdr (assoc (car spec) (getf world :properties))) (cadr spec)) (caddr spec))
  (refuses world)))
(assert (equal (macroexpand-1 '(defcolumns-observation-frame offset-after-hashed sources hash-offset unit-hashed))
 '(make-event (value (fn2-columns-observation-frame-event
                      'offset-after-hashed 'sources 'hash-offset 'unit-hashed (w state))))))
(format t "COLUMN OBSERVATION FRAME SOURCE CONTROLS PASS~%")

(in-package "ACL2")
(include-book "../sim/envelope-output-validation")
(defun fn2-eo-validation-witness (phase input)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-envelope-output-state
  (mv-let (ok fn2-envelope-output-state)
   (let* ((fn2-envelope-output-state (update-fn2-eo-phase phase fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-peer '(77) fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-segments '((:exact 77)) fn2-envelope-output-state))
          (fn2-envelope-output-state (update-fn2-eo-ordered '((:prefix 78)) fn2-envelope-output-state))
          (fn2-envelope-output-state (if (equal phase 11)
               (update-fn2-eo-bytes input fn2-envelope-output-state)
               (update-fn2-eo-scan input fn2-envelope-output-state)))
          (fuel (+ 1 (len input)))
          (antecedent (and (natp fuel)
                           (equal (fn2-eo-phase fn2-envelope-output-state) phase)
                           (equal fuel (+ 1 (len (if (equal phase 11)
                               (fn2-eo-bytes fn2-envelope-output-state)
                               (fn2-eo-scan fn2-envelope-output-state)))))))
          (fn2-envelope-output-state (fn2-envelope-output-run fuel fn2-envelope-output-state)))
    (mv (and antecedent
             (equal (fn2-eo-peer fn2-envelope-output-state) '(77))
             (equal (fn2-eo-segments fn2-envelope-output-state) '((:exact 77)))
             (equal (fn2-eo-ordered fn2-envelope-output-state) '((:prefix 78)))
             (if (fn2-eo-octets-p input)
                 (and (equal (fn2-eo-phase fn2-envelope-output-state) (if (equal phase 11) 0 1))
                      (equal (if (equal phase 11) (fn2-eo-bytes fn2-envelope-output-state)
                               (fn2-eo-scan fn2-envelope-output-state)) nil))
               (and (equal (fn2-eo-phase fn2-envelope-output-state) 10)
                    (equal (fn2-eo-result fn2-envelope-output-state) nil))))
        fn2-envelope-output-state)) ok)))
(assert-event
 (and (fn2-eo-validation-witness 11 '(0 255))
      (fn2-eo-validation-witness 12 '(0 255))
      (fn2-eo-validation-witness 11 nil)
      (fn2-eo-validation-witness 12 nil)
      (fn2-eo-validation-witness 11 '(1 2 . bad))
      (fn2-eo-validation-witness 12 '(1 2 . bad))
      (fn2-eo-validation-witness 11 '(1 300))
      (fn2-eo-validation-witness 12 '(1 -1))
      (fn2-eo-validation-witness 11 '(1 x))
      (fn2-eo-validation-witness 12 'bad)))

(defun fn2-eo-complete-validation-witness (segments peer)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-envelope-output-state
  (mv-let (ok fn2-envelope-output-state)
   (let* ((fn2-envelope-output-state (fn2-envelope-output-init segments peer fn2-envelope-output-state))
          (antecedent (and (equal (fn2-eo-phase fn2-envelope-output-state) 0)
                           (equal (fn2-eo-ordered fn2-envelope-output-state) nil)))
          (fuel (+ 2 (* 2 (len segments)) (fn2-envelope-output-source-size segments) (len peer)))
          (fn2-envelope-output-state (fn2-envelope-output-run fuel fn2-envelope-output-state)))
    (mv (and antecedent
             (if (and (fn2-eo-segments-p segments) (fn2-eo-octets-p peer))
                 (and (equal (fn2-eo-phase fn2-envelope-output-state) 1)
                      (equal (fn2-eo-segments fn2-envelope-output-state) (revappend segments nil))
                      (equal (fn2-eo-peer fn2-envelope-output-state) peer))
               (and (equal (fn2-eo-phase fn2-envelope-output-state) 10)
                    (equal (fn2-eo-result fn2-envelope-output-state) nil))))
        fn2-envelope-output-state)) ok)))
(assert-event
 (and (fn2-eo-complete-validation-witness '((:exact 2) (:prefix 1)) '(1 2))
      (fn2-eo-complete-validation-witness nil nil)
      (fn2-eo-complete-validation-witness '((:exact 1 . bad)) '(1))
      (fn2-eo-complete-validation-witness '((:exact 1) . bad) '(1))
      (fn2-eo-complete-validation-witness '((:exact 2) (:prefix 1)) '(1 2 . bad))
      (fn2-eo-complete-validation-witness '((:exact 300)) '(300))
      (fn2-eo-complete-validation-witness '((:unknown 1)) '(1))
      (fn2-eo-complete-validation-witness '(bad) nil)
      (fn2-eo-complete-validation-witness 'bad nil)))

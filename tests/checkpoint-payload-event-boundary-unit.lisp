; Actual first-member writer/settlement and actual upload owner assignment.
; Reuses the full-turn fixture driver; this is not a full article publication
; witness, nor permission derived from the numeric owner event alone.
(in-package "ACL2")
(include-book "retirement-live-unit")
(include-book "../books/upload")
(defun fn2-cpebu-owner (e epoch allocation event fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (answer)
  (and (eq (fn2-alloc-handle-code e epoch allocation fn2-extents) :ok)
       (= (fn2-extents-state e fn2-extents) *fn2-extent-state-allocated*)
       (= (fn2-extents-owner-kind e fn2-extents) *fn2-txn-kind*)
       (= (fn2-extents-owner-id e fn2-extents) event)) answer))
(defun fn2-cpebu-body (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* ((profile (fn2-b-test-profile *fn2-profile-tiny* 0))
      (fn2-core (fn2-core-init profile fn2-core))
      (fn2-sim (fn2-sim-init 1 :none "payload-event-boundary" profile fn2-sim))
      (fn2-own (fn2-own-init profile fn2-own))
      (owner (fn2-machine-kind-base *fn2-scribe-kind* fn2-core))
      (ogen (fn2-machine-generation owner fn2-core))
      ((mv begun fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code fn2-extents)
        (fn2-alloc-begin-epoch 1 fn2-extents) (mv code fn2-core)))
      ((mv admitted & batch event fn2-core)
       (fn2-commit-admit-keyed 1 0 *fn2-scribe-kind* owner ogen fn2-core))
      ((mv fn2-core fn2-sim fn2-own) (fn2-retirement-live-drive 600 26 fn2-core fn2-sim fn2-own))
      ((mv settled actual-batch actual-event outcome fn2-core)
       (fn2-commit-take *fn2-scribe-kind* owner ogen fn2-core))
      ((mv reserved & e epoch allocation fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (code work e ep al fn2-extents)
        (fn2-alloc-reserve fn2-extents) (mv code work e ep al fn2-core)))
      ((mv committed fn2-core) (fn2-upload-extent-commit e epoch allocation actual-event fn2-core))
      (owned (fn2-cpebu-owner e epoch allocation actual-event fn2-core)))
  (mv (and (eq begun :ok) (eq admitted :ok) (= batch 1) (= event 1)
           (eq settled :ok) (= actual-batch batch) (= actual-event event)
           (= outcome *fn2-commit-outcome-accepted*)
           (eq reserved :ok) (eq committed :ok) owned)
      fn2-core fn2-sim fn2-own)))
(defun fn2-cpebu-test ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-core fn2-sim fn2-own)
  (fn2-cpebu-body fn2-core fn2-sim fn2-own)))
(assert-event (fn2-cpebu-test))

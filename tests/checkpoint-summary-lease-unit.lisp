; Actual bounded apply/lease/retirement primitives, with an explicitly seeded
; internal APPLYING premise. This does not witness the selected-source opener,
; physical C-page loading, persisted boot, or sufficient-summary theorem.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-summary-apply")
(defun fn2-csl-apply (fuel fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-run-installed fn2-id-engine fn2-seals)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-run-installed fn2-id-engine fn2-seals)
 :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-checkpoint-summary fn2-run-installed fn2-id-engine fn2-seals)
  (mv-let (code fn2-checkpoint-summary fn2-run-installed fn2-id-engine fn2-seals)
   (fn2-checkpoint-summary-apply-step fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-run-installed fn2-id-engine fn2-seals)
   (if (eq code :more)
    (fn2-csl-apply (- fuel 1) fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-run-installed fn2-id-engine fn2-seals)
    (mv code fn2-checkpoint-summary fn2-run-installed fn2-id-engine fn2-seals)))))
(defun fn2-csl-body (fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-summary-leases fn2-run-installed fn2-id-engine fn2-seals)
 (declare (xargs :stobjs (fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-summary-leases fn2-run-installed fn2-id-engine fn2-seals)
 :verify-guards nil))
 (b* ((fn2-checkpoint-summary (fn2-checkpoint-summary-init 1 fn2-checkpoint-summary))
      (fn2-checkpoint-summary-sources (fn2-checkpoint-summary-sources-init 4 fn2-checkpoint-summary-sources))
      (fn2-checkpoint-summary-leases (fn2-checkpoint-summary-leases-init 2 fn2-checkpoint-summary-leases))
      (fn2-run-installed (fn2-run-installed-init 4 fn2-run-installed))
      (fn2-id-engine (fn2-id-engine-init 1 fn2-id-engine)) (fn2-seals (fn2-seals-init 1 fn2-seals))
      (fn2-checkpoint-summary (fn2-checkpoint-summary-put 0 (phase *fn2-checkpoint-summary-phase-applying*) (application-stage 2)
       (tag 7) (count 1) (cut-event 21) (cursor 0) (installed 0)))
      (fn2-checkpoint-summary-sources (fn2-checkpoint-summary-sources-put 1
       (tag 7) (schema 8) (rank 1) (top 0) (entries 1) (unit *fn2-storage-extent-units*) (epoch 4) (allocation 35)))
      ((mv applied fn2-checkpoint-summary fn2-run-installed fn2-id-engine fn2-seals)
       (fn2-csl-apply 8 fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-run-installed fn2-id-engine fn2-seals))
      (fresh (and (eq applied :applied) (= (fn2-id-engine-published 0 fn2-id-engine) 21)
                  (= (fn2-id-engine-seq 0 fn2-id-engine) 1) (= (fn2-seals-runs 0 fn2-seals) 1)))
      ((mv acquired extent fn2-checkpoint-summary fn2-checkpoint-summary-leases)
       (fn2-checkpoint-summary-acquire 0 0 7 9 11 fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-summary-leases fn2-run-installed))
      ((mv wrong fn2-checkpoint-summary fn2-checkpoint-summary-leases)
       (fn2-checkpoint-summary-release 0 7 9 12 fn2-checkpoint-summary fn2-checkpoint-summary-leases))
      ((mv closing fn2-checkpoint-summary) (fn2-checkpoint-summary-retire-begin fn2-checkpoint-summary))
      ((mv blocked & fn2-checkpoint-summary fn2-checkpoint-summary-leases)
       (fn2-checkpoint-summary-acquire 0 1 7 9 11 fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-summary-leases fn2-run-installed))
      ((mv retired fn2-run-installed) (fn2-run-retire 0 fn2-run-installed))
      (retained (fn2-checkpoint-summary-lease-current-p 0 7 9 11 fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-summary-leases fn2-run-installed))
      ((mv freed fn2-run-installed) (fn2-run-retired-next 0 fn2-run-installed))
      ((mv reused fn2-run-installed) (fn2-run-install 0 8 99 0 0 0 100 9 1 7 9 11 fn2-run-installed))
      ((mv again held fn2-checkpoint-summary fn2-checkpoint-summary-leases)
       (fn2-checkpoint-summary-acquire 0 0 7 9 11 fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-summary-leases fn2-run-installed))
      (still-current (fn2-checkpoint-summary-lease-current-p 0 7 9 11 fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-summary-leases fn2-run-installed))
      ((mv released fn2-checkpoint-summary fn2-checkpoint-summary-leases)
       (fn2-checkpoint-summary-release 0 7 9 11 fn2-checkpoint-summary fn2-checkpoint-summary-leases))
      ((mv duplicate fn2-checkpoint-summary fn2-checkpoint-summary-leases)
       (fn2-checkpoint-summary-release 0 7 9 11 fn2-checkpoint-summary fn2-checkpoint-summary-leases)))
  (mv (and fresh (eq acquired :ok) (= extent 1) (eq wrong :owner) (eq closing :retiring) (eq blocked :source)
           (eq retired :ok) retained (eq freed :ok) (eq reused :ok) (eq again :ok) (= held 1) still-current
           (eq released :ok) (eq duplicate :owner) (= (fn2-checkpoint-summary-lease-count 0 fn2-checkpoint-summary) 0))
   fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-summary-leases fn2-run-installed fn2-id-engine fn2-seals)))
(defun fn2-csl-test ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-summary-leases fn2-run-installed fn2-id-engine fn2-seals)
  (fn2-csl-body fn2-checkpoint-summary fn2-checkpoint-summary-sources fn2-checkpoint-summary-leases fn2-run-installed fn2-id-engine fn2-seals)))
(assert-event (fn2-csl-test))

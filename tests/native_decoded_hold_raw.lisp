;;; SCN-1129 physical developer hold seam, not a typed admission witness.
;;; The actual deployed pread/helper operate on a real scratch fd in a real
;;; child. ACL2 controller/admission remain the initialized native consumer.
(load "tests/native_section_envelope_raw.lisp")
(unless (find-package "ACL2_*1*_ACL2") (defpackage "ACL2_*1*_ACL2" (:use "CL")))
(in-package "ACL2")
(load-deployed-forms "host/native/extent.lisp" '((defun fnn-extent-window-pread)))
(load-deployed-forms "host/native/extent-decoded.lisp" '((defun fnn-extent-decoded-window-pread)))
(defvar *decoded-hold-path* nil)
(defvar *decoded-hold-events* nil)
(defvar *decoded-hold-log-lock* (sb-thread:make-mutex :name "fixture observation"))
(defvar *fnn-extent-lock* nil)
(defun fnn-developer-selector (name)
  (and (equal name "FN_NATIVE_PAGE_IO_HOLD") *decoded-hold-path*))
(defun fnn-err (control &rest args)
  (sb-thread:with-mutex (*decoded-hold-log-lock*)
    (push (apply #'format nil control args) *decoded-hold-events*)))
(let* ((path (format nil "/tmp/fn-decoded-hold-~d-~d" (sb-posix:getpid) (random 1000000000)))
       (hold (concatenate 'string path ".release"))
       (bytes (make-array 8 :element-type '(unsigned-byte 8) :initial-contents '(0 1 2 3 127 128 254 255)))
       (input (vector (make-array 64 :element-type '(unsigned-byte 8) :initial-element 99) 0))
       (mutex (sb-thread:make-mutex :name "physical fixture E"))
       (fd nil) (child nil) (result nil))
  (unwind-protect
      (progn
        (with-open-file (out path :direction :output :if-exists :error :element-type '(unsigned-byte 8))
          (write-sequence bytes out))
        (setq fd (sb-posix:open path sb-posix:o-rdonly 0) *decoded-hold-path* hold
              *fnn-extent-lock* mutex)
        (setq child (sb-thread:make-thread
                     (lambda ()
                       (setq result (fnn-extent-decoded-window-pread fd input '(:decoded 17 7) '(:read 7 47 0 0 8))))))
        (loop with deadline = (+ (get-internal-real-time) (* 5 internal-time-units-per-second))
              until (sb-thread:with-mutex (*decoded-hold-log-lock*)
                      (some (lambda (row) (search "DECODED-WINDOW held" row)) *decoded-hold-events*))
              do (assert (< (get-internal-real-time) deadline)) (sleep 0.01))
        (assert (sb-thread:thread-alive-p child))
        ;; An actual contender acquires E while the physical child is held.
        (assert (sb-thread:with-mutex (mutex :wait-p nil) :held-read-off-E))
        (assert (and (null result) (= (svref input 1) 0) (= (aref (svref input 0) 0) 99)))
        (with-open-file (out hold :direction :output :if-exists :error) (write-line "release" out))
        (sb-thread:join-thread child)
        (assert (eq result :ok))
        (assert (= (svref input 1) 8))
        (assert (equalp bytes (subseq (svref input 0) 0 8)))
        (assert (some (lambda (row) (search "DECODED-WINDOW read-return token=(:DECODED 17 7) status=:OK" row))
                      *decoded-hold-events*))
        ;; Inactive developer observation performs the same physical read
        ;; without a hold, emitted event or dependency on a release file.
        (setq *decoded-hold-path* nil)
        (let ((before (length *decoded-hold-events*)))
          (assert (eq :ok (fnn-extent-decoded-window-pread fd input '(:decoded 18 7) '(:read 7 47 0 0 8))))
          (assert (= before (length *decoded-hold-events*)))))
    ;; Always release our child before descriptor/scratch cleanup on failure.
    (when (and child (sb-thread:thread-alive-p child))
      (with-open-file (out hold :direction :output :if-exists :supersede) (write-line "cleanup" out))
      (sb-thread:join-thread child))
    (when fd (sb-posix:close fd))
    (dolist (owned (list path hold)) (when (probe-file owned) (delete-file owned)))))
(format t "native_decoded_hold_raw: PASS actual pending pread/off-lock hold/exact fd bytes/physical return~%")

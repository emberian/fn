;;; Read the actual host adapter and actual logical loss/reply classifiers.
;;; Inject physical send/receive outcomes; no image or durability claim.
(require :sb-bsd-sockets)
(require :sb-posix)
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(deftype fnn-octets () '(simple-array (unsigned-byte 8) (*)))
(define-condition fnn-os-error (error) ())
(define-condition fnn-usage-error (error) ((message :initarg :message)))
(define-condition fnn-tls-io-error (error) ())
(define-condition fnn-tls-verify-error (error) ())
(define-condition fnn-tls-handshake-error (error) ())
(defparameter +fnn-exit-refused+ 1)
(defvar *cut* nil)
(defvar *replies* nil)
(defvar *sent* nil)
(defvar *last-outcome* nil)
(defun source-function (path name)
  (with-open-file (stream path)
    (let* ((text (make-string (file-length stream)))
           (prefix (format nil "(defun ~a " (string-downcase name))))
      (read-sequence text stream)
      (let ((start (search prefix text)))
        (unless start (error "missing source function ~a" name))
        (read-from-string text nil nil :start start)))))
(dolist (name '(fn-redeem-reply-code fn-redeem-step fn-redeem-lost
                fn-redeem-outcome-class))
  (let ((form (source-function "books/peer-host.lisp" name)))
    ;; ACL2's metadata declaration has no host evaluation effect.
    (setf (cdddr form) (remove-if (lambda (x) (and (consp x) (eq (car x) 'declare)))
                                (cdddr form)))
    (eval form)))
(defun true-listp (x) (or (null x) (and (consp x) (true-listp (cdr x)))))
(defun len (x) (length x))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun member-equal (x xs) (member x xs :test #'equal))
(defun fnn-core (name &rest args)
  (case name
    (fn-peer-tls-verification '(:verify "example.invalid" nil :system-roots))
    (fn-redeem-step (apply #'fn-redeem-step args))
    (fn-redeem-lost (apply #'fn-redeem-lost args))
    (fn-redeem-outcome-class (apply #'fn-redeem-outcome-class args))
    (fn-redeem-text (setf *last-outcome* (first args)) nil)
    (fn-outcome-code (case (first args) (:accepted 0) (:refused 1) (:fenced 3)))
    (otherwise (error "unexpected subject ~s" name))))
(defun fnn-redeem-read-password () '(112 97 115 115))
(defun fnn-make-octets (n) (make-array n :element-type '(unsigned-byte 8)))
(defun fnn-string-octets (s) (map 'fnn-octets #'char-code s))
(defun fnn-concat (&rest strings) (apply #'concatenate 'string strings))
(defun fnn-octets (x) x)
(defun fnn-octets-string (x) (map 'string #'code-char x))
(defun fnn-connect (&rest args)
  (declare (ignore args))
  (when (eq *cut* :connect) (error 'fnn-os-error))
  (make-instance 'sb-bsd-sockets:inet-socket :type :stream :protocol :tcp))
(defun fnn-socket-fd (socket) (sb-bsd-sockets:socket-file-descriptor socket))
(defun fnn-send-all (fd bytes seconds)
  (declare (ignore fd seconds))
  (let ((text (map 'string #'code-char bytes)))
    (push text *sent*)
    (when (and (search "XREDEEM PASS " text)
               (member *cut* '(:password-partial-send :password-complete-send)))
      ;; A partial or complete physical write can throw before returning.
      (error 'fnn-os-error))))
(defun fnn-tls-send-all (channel bytes seconds) (fnn-send-all channel bytes seconds))
(defun fnn-tls-open-client-context (&rest args) (declare (ignore args)) :context)
(defun fnn-tls-connect (&rest args) (declare (ignore args)) :channel)
(defun fnn-recv (&rest args) (declare (ignore args)) (error "unexpected plain read"))
(defun fnn-tls-read (&rest args) (declare (ignore args)) (error "unexpected TLS read"))
(defun fnn-redeem-read-line (read pending)
  (declare (ignore read pending))
  (when (null *replies*) (error 'fnn-os-error))
  (values (map 'list #'char-code (pop *replies*)) (fnn-make-octets 0)))
(defun fnn-tls-close-channel (&rest args) (declare (ignore args)))
(defun fnn-tls-close-context (&rest args) (declare (ignore args)))
(defun fnn-out (&rest args) (declare (ignore args)))
(defun fnn-err (&rest args) (declare (ignore args)))
(defun fnn-refuse (&rest args) (error "unexpected refusal ~s" args))
(eval (source-function (or (sb-ext:posix-getenv "FN_REDEEM_HOST_SOURCE") "host/native/io.lisp") 'fnn-command-redeem))
(defun check-redeem (cut replies expected outcome)
  (let ((*cut* cut) (*replies* replies) (*sent* nil) (*last-outcome* nil))
    (let ((code (fnn-command-redeem '("example.invalid" "code" "login" "--tls"))))
      (unless (and (= code expected) (equal *last-outcome* outcome))
        (error "~s => ~s/~s expected ~s/~s; sent ~s"
               cut code *last-outcome* expected outcome *sent*)))))
(check-redeem :connect nil 3 '(:unreachable :connect))
(check-redeem :before-password '("200 hello") 3 '(:unreachable :code))
(check-redeem :password-partial-send '("200 hello" "381 continue") 3 '(:uncertain :password))
(check-redeem :password-complete-send '("200 hello" "381 continue") 3 '(:uncertain :password))
(check-redeem :lost-password-reply '("200 hello" "381 continue") 3 '(:uncertain :password))
(check-redeem :success '("200 hello" "381 continue" "281 ready") 0 '(:done))
(check-redeem :refusal '("200 hello" "381 continue" "482 used") 1 '(:refused :code))
(format t "native redeem send uncertainty boundary passed~%")

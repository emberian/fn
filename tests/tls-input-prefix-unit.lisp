; Logical live-loan selector/observer/projector -> exact replay consumer.
; The explicit pool writer is a primitive-effect witness, not native/C evidence.
(in-package "ACL2")
(include-book "../books/host-codec")
(include-book "input-prefix-unit")
(defun fn2-tls-prefix-write (op gen offset octets fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-ops (fn2-core-ops fn2-core)) (fn2-pool (fn2-core-pool fn2-core)))
  (code fn2-pool)
  (fn2-envelope-write-loan (+ (fn2-ops-range-off op fn2-ops) offset) octets
   (fn2-ops-range-slot op fn2-ops) (fn2-ops-range-gen op fn2-ops) op gen fn2-pool)
  (mv code fn2-core)))
(defun fn2-tls-prefix-logical-producer (fn2-core fn2-tls-transport fn2-tls-record)
 (declare (xargs :stobjs (fn2-core fn2-tls-transport fn2-tls-record) :verify-guards nil))
 (b* (((mv ready op gen & & fn2-core) (fn2-input-prefix-fixture fn2-core))
      ((unless ready) (mv nil fn2-core fn2-tls-transport fn2-tls-record))
      (before (fn2-input-prefix-bytes fn2-core))
      ((mv started fn2-tls-transport) (fn2-tls-transport-start 1 1 op gen 0 8 4 20 1 fn2-tls-transport))
      ((mv allocated & & & serial fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv allocation & fn2-tls-transport)
       (fn2-tls-transport-observe 1 1 op gen serial 4096 0 0 fn2-tls-transport))
      ((mv handshake & & & serial fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv established & fn2-tls-transport) (fn2-tls-transport-observe 1 1 op gen serial 0 0 0 fn2-tls-transport))
      ((mv done & & & & fn2-tls-transport) (fn2-tls-transport-next 0 0 fn2-tls-transport))
      ((mv handed & & & & & & fn2-tls-transport) (fn2-tls-transport-handoff 1 1 op gen fn2-tls-transport))
      ((mv selected action address offset count serial fn2-tls-transport fn2-tls-record)
       (fn2-host-tls-record-next op gen 8 0 fn2-tls-transport fn2-tls-record fn2-core))
      ((unless (and (equal (list started allocation established handed) '(:ok :ok :ok :ok))
                    (eq allocated :act) (eq handshake :act) (eq done :done)
                    (eq selected :act) (= action 12) (= offset 0) (<= 2 count)))
       (mv nil fn2-core fn2-tls-transport fn2-tls-record))
      ; This is the explicit assumed physical effect used by the logical test.
      ((mv written fn2-core) (fn2-tls-prefix-write op gen offset '(70 71) fn2-core))
      ((mv observed fn2-tls-transport fn2-tls-record)
       (fn2-tls-record-step-observe serial 0 2 0 fn2-tls-transport fn2-tls-record))
      ((mv effect relative-offset moved) (fn2-tls-record-public-input-prefix serial action offset 2 fn2-tls-record))
      (after (fn2-input-prefix-bytes fn2-core))
      (octets (take moved (nthcdr address after))))
  (mv (and (eq written :ok) (eq observed :ok) (eq effect :input-prefix)
           (= moved 2) (= relative-offset offset)
           (equal after (append (take address before) '(70 71) (nthcdr (+ address 2) before)))
           (list :input-prefix op gen relative-offset moved octets))
      fn2-core fn2-tls-transport fn2-tls-record)))
(defun fn2-tls-prefix-logical-event ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core
  (mv-let (event fn2-core)
   (with-local-stobj fn2-tls-transport
    (mv-let (event fn2-core fn2-tls-transport)
     (with-local-stobj fn2-tls-record
      (mv-let (event fn2-core fn2-tls-transport fn2-tls-record)
       (fn2-tls-prefix-logical-producer fn2-core fn2-tls-transport fn2-tls-record)
       (mv event fn2-core fn2-tls-transport)))
     (mv event fn2-core)))
   event)))
(assert-event
 (let ((event (fn2-tls-prefix-logical-event)))
  (and event (fn2-input-prefix-replay-control :deferred event)
       (fn2-input-prefix-replay-control :ordinary event)
       (fn2-input-prefix-replay-control :duplicate event)
       (fn2-input-prefix-replay-control :after-close-ack event))))

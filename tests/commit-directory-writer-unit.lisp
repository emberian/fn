; Actual writer/read helper controls on explicit synthetic directory metadata.
; These rows do not assert publication, base adoption, or permission to reuse.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/assembly")
(defun fn2-cdw-body (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (b* ((fn2-core (fn2-core-init *fn2-profile-tiny* fn2-core))
      (fn2-core (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (fn2-commit-root)
       (let* ((fn2-commit-root (fn2-commit-root-init 3 fn2-commit-root))
              (fn2-commit-root (fn2-commit-root-put 0 (installed 1) (published 1) (proposed 2)))
              (fn2-commit-root (fn2-commit-root-put 1 (parent 0) (first-key 11) (members 2) (seal-ready 1))))
        (fn2-commit-root-put 2 (parent 1) (first-key 13) (members 3) (seal-ready 1))) fn2-core))
      ((mv ready first end status) (fn2-commit-notification-range 1 0 fn2-core))
      ((mv caught cursor same-end same-status) (fn2-commit-notification-range 1 13 fn2-core))
      ((mv pending pending-first pending-end pending-status) (fn2-commit-notification-range 2 0 fn2-core))
      (pipeline (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (ok)
       (b* (((mv computed seal) (fn2-commit-directory-predecessor-seal-slot 2 9 fn2-commit-root))
            ((mv installed absent) (fn2-commit-directory-seal-slot 2 9 fn2-commit-root))
            ((mv full no-row) (fn2-commit-directory-new-row 3 fn2-commit-root)))
        (and (eq computed :ok) (= seal (+ (* *fn2-digest-stride* 9) 2))
             (eq installed :absent) (= absent 0) (eq full :no-space) (= no-row 0))) ok))
      (fn2-core (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (fn2-commit-root)
       (fn2-commit-root-put 0 (installed 2)) fn2-core))
      ((mv lag lag-first lag-end lag-status) (fn2-commit-notification-range 2 0 fn2-core))
      (fn2-core (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (fn2-commit-root)
       ; Staged old-row alias: batch3 would share batch1's cell.
       (fn2-commit-root-put 1 (parent 2) (first-key 21) (members 1) (seal-ready 1)) fn2-core))
      ((mv alias alias-first alias-end alias-status) (fn2-commit-notification-range 1 0 fn2-core))
      (stale (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (ok)
       (mv-let (code row) (fn2-commit-directory-predecessor-seal-slot 1 9 fn2-commit-root)
        (and (eq code :stale) (= row 0))) ok))
      (fn2-core (stobj-let ((fn2-commit-root (fn2-core-commit-root fn2-core))) (fn2-commit-root)
       ; Synthetic archived/base metadata tests dispatch only. No production
       ; operation in this milestone can set a positive base-ready value.
       (fn2-commit-root-put 0 (base-batch 2) (base-event 15) (base-ready 1) (installed 3) (published 3) (proposed 3)) fn2-core))
      ((mv archived archived-first archived-end archived-status) (fn2-commit-notification-range 1 0 fn2-core))
      ((mv base base-first base-end base-status) (fn2-commit-notification-range 2 0 fn2-core))
      ((mv absent absent-first absent-end absent-status) (fn2-commit-notification-range 4 0 fn2-core)))
  (mv (and ready caught (= first 11) (= end 13) (= cursor 13) (= same-end 13)
       (eq status :resident) (eq same-status :resident) pipeline stale
       (not pending) (= pending-first 0) (= pending-end 0) (eq pending-status :absent)
       (not lag) (= lag-first 0) (= lag-end 0) (eq lag-status :pending)
       (not alias) (= alias-first 0) (= alias-end 0) (eq alias-status :stale)
       (not archived) (= archived-first 0) (= archived-end 0) (eq archived-status :archived)
       (not base) (= base-first 0) (= base-end 0) (eq base-status :base)
       (not absent) (= absent-first 0) (= absent-end 0) (eq absent-status :absent)) fn2-core)))
(defun fn2-cdw-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (mv-let (ok fn2-core) (fn2-cdw-body fn2-core) ok)))
(assert-event (fn2-cdw-run))

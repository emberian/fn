; Typed capture/Fence callback control with explicitly seeded installed and
; issued-operation premises. This is not a real persisted writer, host Fence,
; authenticated boot, cold-seed or directory-forgetting witness.
(in-package "ACL2")
(include-book "std/util/bstar" :dir :system)
(include-book "../books/checkpoint-publication")
(include-book "../books/runs-page")
(defun fn2-cbe-body (failed fn2-checkpoint-publication fn2-checkpoints fn2-commit-root fn2-fc fn2-checkpoint-bytes fn2-digests)
 (declare (xargs :stobjs (fn2-checkpoint-publication fn2-checkpoints fn2-commit-root fn2-fc fn2-checkpoint-bytes fn2-digests) :verify-guards nil))
 (b* ((fn2-checkpoint-publication (fn2-checkpoint-publication-init 0 fn2-checkpoint-publication))
      (fn2-checkpoint-publication (fn2-checkpoint-bank-evidence-record-fence fn2-checkpoint-publication))
      (empty (equal (fn2-checkpoint-publication-rows fn2-checkpoint-publication) 0))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-init 1 fn2-checkpoint-publication))
      (fn2-checkpoints (fn2-checkpoints-init 1 fn2-checkpoints))
      (fn2-commit-root (fn2-commit-root-init 4 fn2-commit-root))
      (fn2-fc (fn2-fc-init 3 fn2-fc))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-init 288 fn2-checkpoint-bytes))
      (fn2-digests (fn2-digests-init (+ (* *fn2-digest-stride* 3) 4) fn2-digests))
      (fn2-checkpoints (fn2-checkpoints-put 0 (state *fn2-checkpoint-state-installed*)
       (checkpoint 9) (history 37) (incarnation 41) (cut-commit 1) (cut-event 1)
       (installation-commit 3) (installation-event 8)))
      (fn2-commit-root (fn2-commit-root-put 0 (installed 3) (published 3) (proposed 3)))
      (fn2-commit-root (fn2-commit-root-put 1 (parent 0) (first-key 1) (members 3) (seal-ready 1)))
      (fn2-commit-root (fn2-commit-root-put 2 (parent 1) (first-key 4) (members 3) (seal-ready 1)))
      (fn2-commit-root (fn2-commit-root-put 3 (parent 2) (first-key 7) (members 3) (seal-ready 1)))
      (fn2-digests (fn2-digest-set-word (+ (* *fn2-digest-stride* 3) 1) 0 111 fn2-digests))
      (fn2-digests (fn2-digest-set-word (+ (* *fn2-digest-stride* 3) 2) 0 222 fn2-digests))
      (fn2-digests (fn2-digest-set-word (+ (* *fn2-digest-stride* 3) 3) 0 333 fn2-digests))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-set-value 0 188 fn2-checkpoint-bytes))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-set-value 1 1 fn2-checkpoint-bytes))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-set-value 224 55 fn2-checkpoint-bytes))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-put 0
       (phase *fn2-checkpoint-publication-phase-prepare*) (candidate 0) (bank 0)
       (attempt-checkpoint 9) (attempt-history 37) (attempt-incarnation 41) (attempt-hash-0 444)))
      ((mv captured fn2-checkpoint-publication)
       (fn2-checkpoint-bank-evidence-capture 0 fn2-checkpoints fn2-commit-root fn2-fc fn2-checkpoint-bytes fn2-digests fn2-checkpoint-publication))
      ((mv early & & & & & & &) (fn2-checkpoint-bank-evidence-snapshot 0 fn2-checkpoint-publication))
      ((mv attempt & & & & & & &) (fn2-checkpoint-bank-evidence-snapshot 2 fn2-checkpoint-publication))
      ; Reusable storage is deliberately damaged after the exact BEGIN copy.
      (fn2-commit-root (fn2-commit-root-put 3 (parent 99) (first-key 99)))
      (fn2-digests (fn2-digest-set-word (+ (* *fn2-digest-stride* 3) 3) 0 0 fn2-digests))
      (fn2-checkpoint-bytes (fn2-checkpoint-bytes-set-value 0 0 fn2-checkpoint-bytes))
      (fn2-checkpoint-publication (fn2-checkpoint-publication-put 0
       (phase *fn2-checkpoint-publication-phase-wait-fence*) (op-slot 6) (op-gen 9)))
      ((mv stale fn2-checkpoint-publication)
       (fn2-checkpoint-publication-harvest 6 8 0 *fn2-event-fence-result* *fn2-outcome-done* 0 0 0 0 fn2-checkpoint-publication))
      ((mv not-yet & & & & & & &) (fn2-checkpoint-bank-evidence-snapshot 0 fn2-checkpoint-publication))
      ((mv settled fn2-checkpoint-publication)
       (fn2-checkpoint-publication-harvest 6 9 0 *fn2-event-fence-result*
        (if failed *fn2-outcome-failed* *fn2-outcome-done*) 0 0 0 0 fn2-checkpoint-publication))
      ((mv snapshot c checkpoint history incarnation cut cut-event batch) (fn2-checkpoint-bank-evidence-snapshot 0 fn2-checkpoint-publication))
      ((mv ec event) (fn2-checkpoint-bank-evidence-event 0 fn2-checkpoint-publication))
      ((mv jc jword) (fn2-checkpoint-bank-evidence-word 0 :installation-seal 0 fn2-checkpoint-publication))
      ((mv cc cword) (fn2-checkpoint-bank-evidence-word 0 :cut-seal 0 fn2-checkpoint-publication))
      ((mv pc pword) (fn2-checkpoint-bank-evidence-word 0 :installation-predecessor 0 fn2-checkpoint-publication))
      ((mv dc dword) (fn2-checkpoint-bank-evidence-word 0 :previous-descriptor 0 fn2-checkpoint-publication))
      ((mv hc hword) (fn2-checkpoint-bank-evidence-word 0 :descriptor 0 fn2-checkpoint-publication))
      ; Same numbers with a conflicting descriptor hash cannot alias evidence.
      (fn2-checkpoint-publication (fn2-checkpoint-publication-put 0 (bank0-hash-7 1)))
      ((mv alias & & & & & & &) (fn2-checkpoint-bank-evidence-snapshot 0 fn2-checkpoint-publication)))
  (mv (and empty (eq alias :absent) (eq captured :ok) (eq early :absent) (eq attempt :absent) (eq stale :ok) (eq not-yet :absent)
       (if failed (and (eq settled :ok) (eq snapshot :absent) (eq jc :absent))
        (and (eq settled :ok) (eq snapshot :ok) (= c 0) (= checkpoint 9) (= history 37) (= incarnation 41)
             (= cut 1) (= cut-event 1) (= batch 3) (eq ec :ok) (= event 8)
             (eq jc :ok) (= jword 333) (eq cc :ok) (= cword 111) (eq pc :ok) (= pword 222)
             (eq dc :ok) (= dword 55) (eq hc :ok) (= hword 444))))
      fn2-checkpoint-publication fn2-checkpoints fn2-commit-root fn2-fc fn2-checkpoint-bytes fn2-digests)))
(defun fn2-cbe-run (failed)
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-checkpoint-publication fn2-checkpoints fn2-commit-root fn2-fc fn2-checkpoint-bytes fn2-digests)
  (fn2-cbe-body failed fn2-checkpoint-publication fn2-checkpoints fn2-commit-root fn2-fc fn2-checkpoint-bytes fn2-digests)))
(assert-event (fn2-cbe-run nil))
(assert-event (fn2-cbe-run t))

(load "tests/native_web_page_cursor_raw.lisp")
(in-package "ACL2")
(defun update-nth (n v xs)
  (let ((r (append xs (make-list (max 0 (- (1+ n) (length xs)))))))
    (setf (nth n r) v) r))
(defun fn-octets-clear (st) (fnn-web-fill st (fnn-make-octets 0)))
(defun fn-octets-append-list (xs st) (fnn-web-append st (fnn-octets xs)))
(load-page-forms "books/web-session.lisp"
 '(fn-wss-decode-at fn-wss-step-octets fn-wss-step-bol fn-wss-step-pcr fn-wss-emit-body))
(load-page-forms "books/web-post-stream.lisp" '(fn-wps-cursor fn-wps-next fn-wps-window))
(load-page-forms "host/web-host.lisp" '(fn-web-host-post-window))
(let* ((encoded (append (fn-wrq-oct "%2Efirst%0D%0A%0Dnext%0Alast%25bad%2G+")
                        (loop repeat 5000 append (fn-wrq-oct ".%0D%0A"))))
       (head '(70 114 111 109 58 32 120 13 10 13 10))
       (source (create-fn-octets$c)) (ref (create-fn-octets$c)))
  (fnn-web-fill source (fnn-octets encoded))
  (fn-octets-append-list head ref)
  (fn-wss-emit-body 0 (length encoded) t nil source ref)
  (fn-octets-append-list '(46 13 10) ref)
  (let ((expected (coerce (fnn-web-slice ref 0 (fnn-web-len ref)) 'list)))
    (dolist (w '(1 2 7 4096))
      (loop with cursor = (fn-wps-cursor head 0 (length encoded))
            with chunks = nil for rounds below 200000 do
        (multiple-value-bind (bytes next done) (fn-wps-window w cursor nil source)
          (assert (<= (length bytes) w)) (assert (<= (length (nth 5 next)) 5))
          (push bytes chunks) (setf cursor next)
          (when done (assert (equal expected (apply #'append (nreverse chunks)))) (return)))
          finally (error "unfinished POST cursor"))))
  ;; Actual native producer/feed continuation, including partial consumed input.
  (let* ((conn (fixture-conn 71 :post-prepare 77))
         (face (%make-fnn-web-face :service :service :conns (list conn)))
         (old-call (symbol-function 'fnn-call))
         (old-feed (symbol-function 'fnn-owner-handle-chunk-step)) (fed nil))
    (setf (fnn-web-conn-post-source conn) source
          (fnn-web-conn-post-cursor conn) (fn-wps-cursor head 0 (length encoded))
          (fnn-web-conn-post-active conn) t (fnn-web-conn-leased conn) t)
    (unwind-protect
        (progn
          (setf (symbol-function 'fnn-call)
                (lambda (name &rest args)
                  (if (eq name 'fn-web-host-post-window)
                      (multiple-value-list (apply #'fn-web-host-post-window args))
                    (apply old-call name args))))
          (setf (symbol-function 'fnn-owner-handle-chunk-step)
                (lambda (service cid incoming &rest args)
                  (declare (ignore service cid args))
                  (let ((used (min 117 (length incoming))))
                    (push (coerce (subseq incoming 0 used) 'list) fed)
                    (values nil nil nil used))))
          (loop for turns below 200000 until (eq (fnn-web-conn-phase conn) :event) do
            (case (fnn-web-conn-phase conn)
              (:post-prepare (fnn-web-post-prepare face conn))
              (:feed (fnn-web-feed-step face conn))
              (:render (fnn-web-render-step face conn))
              (t (error "unexpected phase")))
            (assert (<= (fnn-web-len (fnn-web-conn-out conn)) 4096))
            (assert (eq source (fnn-web-conn-post-source conn))))
          (assert (fnn-web-conn-post-done conn))
          (assert (equal (apply #'append (nreverse fed))
                         (coerce (fnn-web-slice ref 0 (fnn-web-len ref)) 'list)))
          (assert (equal (fnn-web-conn-event conn) '(:reply))))
      (setf (symbol-function 'fnn-call) old-call
            (symbol-function 'fnn-owner-handle-chunk-step) old-feed))))
(format t "NATIVE WEB POST STREAM RAW PASS: exact decode/CR/dot/reference quantum1/2/7/4096; actual prepare/feed partial117; retained request; OUT<=4096~%")
(load-page-forms "books/web-post-stream.lisp"
 '(fn-wpf-store fn-wpf-step fn-wpf-drive))
(load-page-forms "host/web-host.lisp" '(fn-web-host-post-form-step))
(let* ((raw (append (fn-wrq-oct "ignored=") (make-list 10003 :initial-element 120)
                    (fn-wrq-oct "&csrf=token&g=local.general&subject=%C3%A9%0AHi&subject=wrong&body=.%0D%0Alast&body=wrong")))
       (conn (fixture-conn 73 :post-form 79)) (healthy (fixture-conn 74 :event))
       (face (%make-fnn-web-face :service :service :conns (list conn healthy)))
       (saved (symbol-function 'fnn-call)) (saved-core (symbol-function 'fnn-core)) (turns 0))
  (fnn-web-fill (fnn-web-conn-in conn) (fnn-octets raw))
  (setf (fnn-web-conn-post-form conn)
        (list :captured 0 (length raw) nil nil (list nil nil nil nil) :scan 0 nil nil nil))
  ;; Recording terminal header seam; actual semantic finish is separately
  ;; exercised with real ACL2 BEGIN/CSRF/340 and legacy-wire reference.
  (setf (symbol-function 'fn-wpf-finish)
        (lambda (config p in out)
          (declare (ignore config in))
          (assert (equal (nth 10 p) (list (fn-wrq-oct "token")
                                         (fn-wrq-oct "local.general") '(195 169 10 72 105))))
          (let ((span (nth 3 (nth 5 p))))
            (fnn-web-fill out (fnn-octets '(80 79 83 84 13 10)))
            (values (list :post-command 79 (fn-wps-cursor nil (car span) (cdr span)) :flow) out))))
  (unwind-protect
      (progn
        (setf (symbol-function 'fnn-core)
              (lambda (name &rest args)
                (if (eq name 'fn-web-host-stream-p) nil (apply saved-core name args))))
        (setf (symbol-function 'fnn-call)
              (lambda (name &rest args)
                (if (eq name 'fn-web-host-post-form-step)
                    (multiple-value-list (apply #'fn-web-host-post-form-step args))
                  (apply saved name args))))
        (loop while (eq (fnn-web-conn-phase conn) :post-form) do
          (incf turns) (assert (< turns 100))
          (fnn-web-post-form face conn)
          (fnn-web-event face healthy))
        (assert (> turns 2)) (assert (eq (fnn-web-conn-phase conn) :feed))
        (assert (eq (fnn-web-conn-phase healthy) :write))
        (assert (not (eq (fnn-web-conn-in conn) (fnn-web-conn-post-source conn))))
        (assert (= (fnn-web-len (fnn-web-conn-post-source conn)) (length raw)))
        (assert (= (fnn-web-len (fnn-web-conn-in conn)) 0))
        (assert (= (fnn-web-len (fnn-web-conn-out conn)) 6)))
    (setf (symbol-function 'fnn-call) saved (symbol-function 'fnn-core) saved-core)))
(format t "NATIVE WEB FORM RAW PASS: actual4096 scan/decode worker turns, first duplicate fields, UTF8, long skipped field, healthy event; no request copy~%")

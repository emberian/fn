; A real one-byte query reference blocks the resident release. The three
; snapshots cover every row column and pool array, plus all pool scalars.
(defun fn2-srh-resident-held-body (fn2-run-installed fn2-run-cache fn2-pool)
 (declare (xargs :stobjs (fn2-run-installed fn2-run-cache fn2-pool) :verify-guards nil))
 (b* ((fn2-run-installed (fn2-run-installed-init 1 fn2-run-installed))
      (fn2-run-cache (fn2-run-cache-init 8 fn2-run-cache))
      (fn2-pool (fn2-pool-init '((2 . 64)) 5 20 fn2-pool))
      ((mv reserve slot gen fn2-pool) (fn2-pool-reserve 0 1 10 3 fn2-pool))
      ((mv written fn2-pool) (fn2-pool-write slot gen 0 165 1 10 3 fn2-pool))
      ((mv cached fn2-run-cache) (fn2-run-cache-install 0 1 slot gen fn2-run-cache))
      ((mv installed fn2-run-installed)
       (fn2-run-install 0 1 1 0 slot gen 0 1 1 1 10 3 fn2-run-installed))
      ((mv interval fn2-run-installed)
       (fn2-run-install-units 0 0 0 fn2-run-installed))
      ((mv retired fn2-run-installed) (fn2-run-retire 0 fn2-run-installed))
      ((mv acquired fn2-pool) (fn2-pool-query-acquire slot gen 0 1 1 10 3 fn2-pool))
      (before-row (list (fn2-srh-run-installed-rows 0 fn2-run-installed)
                        (fn2-run-installed-physical-count fn2-run-installed)
                        (fn2-run-installed-version-floor fn2-run-installed)))
      (before-cache (fn2-srh-run-cache-rows 0 fn2-run-cache))
      (before-pool (fn2-srh-pool-snapshot fn2-pool))
      ((mv held fn2-run-installed fn2-run-cache fn2-pool)
       (fn2-seal-release-row 0 fn2-run-installed fn2-run-cache fn2-pool))
      (retained (and (eq held :held)
       (equal before-row (list (fn2-srh-run-installed-rows 0 fn2-run-installed)
                               (fn2-run-installed-physical-count fn2-run-installed)
                               (fn2-run-installed-version-floor fn2-run-installed)))
       (equal before-cache (fn2-srh-run-cache-rows 0 fn2-run-cache))
       (equal before-pool (fn2-srh-pool-snapshot fn2-pool))))
      ((mv closed last fn2-pool) (fn2-pool-query-release slot gen fn2-pool))
      ((mv retried fn2-run-installed fn2-run-cache fn2-pool)
       (fn2-seal-release-row 0 fn2-run-installed fn2-run-cache fn2-pool))
      (after-release (fn2-srh-pool-snapshot fn2-pool))
      ((mv twice fn2-run-installed fn2-run-cache fn2-pool)
       (fn2-seal-release-row 0 fn2-run-installed fn2-run-cache fn2-pool)))
  (mv (and (eq reserve :ok) (eq written :ok) (eq cached :ok)
           (eq installed :ok) (eq interval :ok) (eq retired :ok)
           (eq acquired :ok) retained (eq closed :ok) last
           (eq retried :more) (eq twice :state)
           (= (fn2-run-installed-state 0 fn2-run-installed) *fn2-run-installed-state-free*)
           (= (fn2-run-cache-state 0 fn2-run-cache) *fn2-run-cache-state-empty*)
           (= (fn2-pool-free-count 0 fn2-pool) 2)
           (equal after-release (fn2-srh-pool-snapshot fn2-pool)))
      fn2-run-installed fn2-run-cache fn2-pool)))

(defun fn2-srh-resident-held-test ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-run-installed fn2-run-cache fn2-pool)
  (fn2-srh-resident-held-body fn2-run-installed fn2-run-cache fn2-pool)))
(assert-event (fn2-srh-resident-held-test))

; The same acquired reference blocks a frozen overlay before its row changes.
(defun fn2-srh-overlay-held-body (fn2-overlays fn2-overlay-index fn2-pool)
 (declare (xargs :stobjs (fn2-overlays fn2-overlay-index fn2-pool) :verify-guards nil))
 (b* ((fn2-overlays (fn2-overlays-init 1 fn2-overlays))
      (fn2-overlay-index (fn2-overlay-index-init 1 fn2-overlay-index))
      (fn2-pool (fn2-pool-init '((2 . 64)) 5 20 fn2-pool))
      ((mv reserve slot gen fn2-pool) (fn2-pool-reserve 0 1 10 3 fn2-pool))
      ((mv started fn2-overlays fn2-pool)
       (fn2-ov-start 0 1 slot gen 0 1 1 10 3 0
        fn2-overlays fn2-overlay-index fn2-pool))
      ((mv frozen fn2-overlays) (fn2-ov-freeze 0 fn2-overlays))
      ((mv written fn2-pool) (fn2-pool-write slot gen 0 165 1 10 3 fn2-pool))
      ((mv acquired fn2-pool) (fn2-pool-query-acquire slot gen 0 1 1 10 3 fn2-pool))
      (before-overlay (fn2-srh-overlays-rows 0 fn2-overlays))
      (before-pool (fn2-srh-pool-snapshot fn2-pool))
      ((mv held fn2-overlays fn2-pool) (fn2-seal-retire 0 fn2-overlays fn2-pool))
      (retained (and (eq held :held)
                     (equal before-overlay (fn2-srh-overlays-rows 0 fn2-overlays))
                     (equal before-pool (fn2-srh-pool-snapshot fn2-pool))))
      ((mv closed last fn2-pool) (fn2-pool-query-release slot gen fn2-pool))
      ((mv retried fn2-overlays fn2-pool) (fn2-seal-retire 0 fn2-overlays fn2-pool))
      (after-release (fn2-srh-pool-snapshot fn2-pool))
      ((mv twice fn2-overlays fn2-pool) (fn2-seal-retire 0 fn2-overlays fn2-pool)))
  (mv (and (eq reserve :ok) (eq started :ok) (eq frozen :ok)
           (eq written :ok) (eq acquired :ok)
           retained (eq closed :ok) last (eq retried :ok) (eq twice :state)
           (= (fn2-overlays-phase 0 fn2-overlays) *fn2-overlay-phase-free*)
           (= (fn2-pool-free-count 0 fn2-pool) 2)
           (equal after-release (fn2-srh-pool-snapshot fn2-pool)))
      fn2-overlays fn2-overlay-index fn2-pool)))

(defun fn2-srh-overlay-held-test ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-overlays fn2-overlay-index fn2-pool)
  (fn2-srh-overlay-held-body fn2-overlays fn2-overlay-index fn2-pool)))
(assert-event (fn2-srh-overlay-held-test))

; A generation at its limit retires the pool slot. That return is accepted:
; the cache is dropped, the installed row freed, and the second call is inert.
(defun fn2-srh-resident-retired-body (fn2-run-installed fn2-run-cache fn2-pool)
 (declare (xargs :stobjs (fn2-run-installed fn2-run-cache fn2-pool) :verify-guards nil))
 (b* ((fn2-run-installed (fn2-run-installed-init 1 fn2-run-installed))
      (fn2-run-cache (fn2-run-cache-init 8 fn2-run-cache))
      (fn2-pool (fn2-pool-init '((1 . 64)) 5 5 fn2-pool))
      ((mv reserve slot gen fn2-pool) (fn2-pool-reserve 0 1 10 3 fn2-pool))
      ((mv cached fn2-run-cache) (fn2-run-cache-install 0 1 slot gen fn2-run-cache))
      ((mv installed fn2-run-installed)
       (fn2-run-install 0 1 1 0 slot gen 0 1 1 1 10 3 fn2-run-installed))
      ((mv interval fn2-run-installed)
       (fn2-run-install-units 0 0 0 fn2-run-installed))
      ((mv retired fn2-run-installed) (fn2-run-retire 0 fn2-run-installed))
      ((mv released fn2-run-installed fn2-run-cache fn2-pool)
       (fn2-seal-release-row 0 fn2-run-installed fn2-run-cache fn2-pool))
      ((mv twice fn2-run-installed fn2-run-cache fn2-pool)
       (fn2-seal-release-row 0 fn2-run-installed fn2-run-cache fn2-pool)))
  (mv (and (eq reserve :ok) (eq cached :ok)
           (eq installed :ok) (eq interval :ok) (eq retired :ok)
           (eq released :more) (eq twice :state)
           (= (fn2-run-installed-state 0 fn2-run-installed) *fn2-run-installed-state-free*)
           (= (fn2-run-cache-state 0 fn2-run-cache) *fn2-run-cache-state-empty*)
           (= (fn2-pool-retired-count fn2-pool) 1)
           (eq (fn2-pool-slot-state slot fn2-pool) :retired))
      fn2-run-installed fn2-run-cache fn2-pool)))
(defun fn2-srh-resident-retired-test ()
 (declare (xargs :verify-guards nil))
 (fn2-run-with-local (fn2-run-installed fn2-run-cache fn2-pool)
  (fn2-srh-resident-retired-body fn2-run-installed fn2-run-cache fn2-pool)))
(assert-event (fn2-srh-resident-retired-test))


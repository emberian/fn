(defun fn2-evb-pressure (fuel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (b* ((free (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (n) (fn2-alloc-total-free fn2-extents) n))
      ((when (equal free 0)) (mv :ok fn2-core))
      ((when (zp fuel)) (mv :fuel fn2-core))
      ((mv code & & & fn2-core)
       (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-control (fn2-core-control fn2-core)))
        (code e ep al fn2-extents fn2-control) (fn2-storage-reserve-children fn2-extents fn2-control)
        (mv code e ep al fn2-core)))
      ((unless (eq code :ok)) (mv code fn2-core)))
  (fn2-evb-pressure (- fuel 1) fn2-core)))


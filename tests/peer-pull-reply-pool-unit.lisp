; Actual K28 pool producer and each outbound client's staged reply operation.
(in-package "ACL2")
(include-book "../books/peer-pull-reply-pool")

(defun fn2-pprp-open (phases status len slot gen fn2-fields fn2-digests fn2-b3 fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-digests fn2-b3 fn2-pool) :verify-guards nil))
  (if (atom phases) (mv :state nil 0 0 fn2-fields fn2-digests fn2-b3)
    (b* (((mv code off end fn2-fields fn2-digests fn2-b3)
          (fn2-peer-pull-open-reply-pool (car phases) status 0 0 len slot gen 1 2 3
                                        fn2-fields fn2-digests fn2-b3 fn2-pool))
         ((when (or (not (eq code :ok)) (endp (cdr phases))))
          (mv code (car phases) off end fn2-fields fn2-digests fn2-b3)))
      (fn2-pprp-open (cdr phases) status len slot gen fn2-fields fn2-digests fn2-b3 fn2-pool))))

(defun fn2-pprp-check (case fn2-fields fn2-digests fn2-b3 fn2-pool)
  (declare (xargs :stobjs (fn2-fields fn2-digests fn2-b3 fn2-pool) :verify-guards nil))
  (b* ((fn2-fields (fn2-fields-init 128 fn2-fields))
       (fn2-digests (fn2-digests-init *fn2-digest-stride* fn2-digests))
       (fn2-b3 (fn2-b3-table-init 1 fn2-b3))
       (fn2-pool (fn2-pool-init '((2 . 1024)) 1 100 fn2-pool))
       ((mv rs slot gen fn2-pool) (fn2-pool-reserve 0 1 2 3 fn2-pool))
       ((mv ls line lg fn2-pool) (fn2-pool-reserve 0 1 2 3 fn2-pool))
       (class (case case (:refused 1) (:uncertain 2) (otherwise 0)))
       (status (case case ((:mismatch :refused) 490) (:uncertain 491) (otherwise 290)))
       (reason (if (equal class 1) "frame" ""))
       (result (if (equal class 0) "cursor" ""))
       ((mv a fn2-pool) (fn2-pool-append-text 0 reason slot gen 1 2 3 fn2-pool))
       ((mv b fn2-pool) (fn2-pool-append-text 0 result slot gen 1 2 3 fn2-pool))
       ((mv sealed at count fn2-fields fn2-digests fn2-b3 fn2-pool)
        (fn2-fnct-put-k28 0 0 class 0 (length reason) (length reason) (length result)
                         slot gen 1 2 3 fn2-fields fn2-digests fn2-b3 fn2-pool))
       ((mv compacted & fn2-pool) (fn2-pool-drop-prefix slot gen at 0 1024 1 2 3 fn2-pool))
       ((mv changed fn2-pool)
        (case case
          (:digest
           (mv-let (code octet) (fn2-pool-read slot gen (- count 1) 1 2 3 fn2-pool)
             (if (eq code :ok) (fn2-pool-write slot gen (- count 1) (logxor octet 1) 1 2 3 fn2-pool)
               (mv code fn2-pool))))
          (:suffix (fn2-pool-write slot gen count 0 1 2 3 fn2-pool))
          (otherwise (mv :ok fn2-pool))))
       (text (concatenate 'string
                          (coerce (explode-nonnegative-integer status 10 nil) 'string)
                          " " (coerce (explode-nonnegative-integer count 10 nil) 'string)))
       ((mv line-code fn2-pool) (fn2-pool-append-text 0 text line lg 1 2 3 fn2-pool))
       ((mv crlf fn2-pool) (fn2-fnct-put-be 0 #x0d0a 2 line lg 1 2 3 fn2-pool))
       ((mv assembled fn2-pool)
        (fn2-pool-copy-range slot gen 0 line lg (fn2-pool-fill-value line fn2-pool)
                             (fn2-pool-fill-value slot fn2-pool) 1 2 3 fn2-pool))
       ((mv counted next observed len) (fn2-peer-pull-reply-count 0 0 line lg 1 2 3 fn2-pool))
       ((mv removed & fn2-pool) (fn2-pool-drop-prefix line lg next 0 1024 1 2 3 fn2-pool))
       ((mv opened stage off end fn2-fields fn2-digests fn2-b3)
        (fn2-pprp-open '(:header :hash :trailer :result) observed len line lg
                       fn2-fields fn2-digests fn2-b3 fn2-pool)))
    (mv (and (eq rs :ok) (eq ls :ok) (eq a :ok) (eq b :ok)
             (eq sealed :ok) (eq compacted :ok) (eq changed :ok)
             (eq line-code :ok) (eq crlf :ok) (eq assembled :ok) (eq removed :ok)
             (eq counted :ok) (equal next (+ 2 (length text))) (equal status observed) (equal count len)
             (case case
               (:accepted
                (and (eq opened :ok) (eq stage :result)
                     (equal end (- len *fn2-fnct-trailer-octets*))
                     (equal (- end off) (length result))))
               (:refused (and (eq opened :refused) (eq stage :result) (equal off 0) (equal end 0)))
               (:uncertain (and (eq opened :uncertain) (eq stage :result) (equal off 0) (equal end 0)))
               (:mismatch (and (eq opened :frame) (eq stage :result)))
               (:digest (and (eq opened :frame) (eq stage :trailer)))
               (:suffix (and (eq opened :frame) (eq stage :header)))))
        fn2-fields fn2-digests fn2-b3 fn2-pool)))

(defun fn2-pprp-test (case)
  (declare (xargs :verify-guards nil))
  (with-local-stobj fn2-fields
    (mv-let (answer fn2-fields)
      (with-local-stobj fn2-digests
        (mv-let (answer fn2-fields fn2-digests)
          (with-local-stobj fn2-b3
            (mv-let (answer fn2-fields fn2-digests fn2-b3)
              (with-local-stobj fn2-pool
                (mv-let (answer fn2-fields fn2-digests fn2-b3 fn2-pool)
                  (fn2-pprp-check case fn2-fields fn2-digests fn2-b3 fn2-pool)
                  (mv answer fn2-fields fn2-digests fn2-b3)))
              (mv answer fn2-fields fn2-digests)))
          (mv answer fn2-fields)))
      answer)))

(assert-event (fn2-pprp-test :accepted))
(assert-event (fn2-pprp-test :refused))
(assert-event (fn2-pprp-test :uncertain))
(assert-event (fn2-pprp-test :mismatch))
(assert-event (fn2-pprp-test :digest))
(assert-event (fn2-pprp-test :suffix))

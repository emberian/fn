; UNEXECUTED dependency-complete source control after the canonical physical
; provider packet (083775bf6/04da370ba and owner-aware core faces) is composed.
; Actual publication/install/retire, authority copier and live scan supply all
; antecedents. No APPLIED, readiness or source authority state is assigned.
(in-package "ACL2")
(include-book "checkpoint-live-catalog-unit")
(include-book "../books/run-physical-readiness-live")
(include-book "../books/checkpoint-live-finish")
; Canonical assembly materializes finish after actual actor/load plan.
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-checkpoint-summary-authority (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-id-engine (w state))))
(make-event (cons 'progn (fn2-test-column-snapshot-events 'fn2-seals (w state))))
(make-event (cons 'progn (fn2-arms-op-face-events 'fn2-checkpoint-live-replace-finish-op 'fn2-checkpoint-live-replace-finish (w state))))
(make-event (cons 'progn (fn2-arms-op-face-events 'fn2-checkpoint-summary-authority-live-begin-op 'fn2-checkpoint-summary-authority-live-begin (w state))))
(make-event (cons 'progn (fn2-arms-op-face-events 'fn2-checkpoint-summary-authority-live-step-op 'fn2-checkpoint-summary-authority-live-step (w state))))
(defun fn2-clf-authority (fuel fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel fn2-core)
  (b* (((mv code fn2-core) (fn2-checkpoint-summary-authority-live-step-op fn2-core)))
   (if (eq code :more) (fn2-clf-authority (- fuel 1) fn2-core) (mv code fn2-core)))))
(defun fn2-clf-resources (fuel progress fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix fuel)))
 (if (zp fuel) (mv :fuel progress fn2-core)
  (b* (((mv code fn2-core) (fn2-run-load-readiness-owned-step 1 fn2-core)))
   (if (eq code :more) (fn2-clf-resources (- fuel 1) (+ 1 progress) fn2-core) (mv code progress fn2-core)))))
(defun fn2-clf-snapshot (fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
             (fn2-checkpoint-summary-authority (fn2-core-checkpoint-summary-authority fn2-core))
             (fn2-id-engine (fn2-core-id-engine fn2-core)) (fn2-seals (fn2-core-seals fn2-core))
             (fn2-c-source-control (fn2-core-c-source-control fn2-core))) (snapshot)
  (list (fn2-test-table-snapshot-fn2-checkpoint-summary fn2-checkpoint-summary)
        (fn2-test-table-snapshot-fn2-checkpoint-summary-authority fn2-checkpoint-summary-authority)
        (fn2-test-table-snapshot-fn2-id-engine fn2-id-engine)
        (fn2-test-table-snapshot-fn2-seals fn2-seals)
        (fn2-test-table-snapshot-fn2-c-source-control fn2-c-source-control)) snapshot))
(defun fn2-clf-body (fn2-core fn2-sim fn2-own)
 (declare (xargs :stobjs (fn2-core fn2-sim fn2-own) :verify-guards nil))
 (b* (((mv produced fn2-core fn2-sim fn2-own) (fn2-clc-body :positive fn2-core fn2-sim fn2-own))
      ((unless produced) (mv nil fn2-core fn2-sim fn2-own))
      (before (fn2-clf-snapshot fn2-core))
      ((mv refused fn2-core) (fn2-checkpoint-live-replace-finish-op fn2-core))
      ((unless (and (eq refused :source) (equal before (fn2-clf-snapshot fn2-core)))) (mv nil fn2-core fn2-sim fn2-own))
      ((mv opened fn2-core) (fn2-checkpoint-summary-authority-live-begin-op fn2-core))
      ((unless (eq opened :more)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv authority fn2-core) (fn2-clf-authority 500 fn2-core))
      ((unless (eq authority :complete)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv scan fn2-core) (fn2-run-load-readiness-live-begin-op fn2-core))
      ((unless (eq scan :more)) (mv nil fn2-core fn2-sim fn2-own))
      ((mv complete progress fn2-core) (fn2-clf-resources 100000 0 fn2-core))
      ((unless (and (eq complete :complete) (posp progress))) (mv nil fn2-core fn2-sim fn2-own))
      (serial (stobj-let ((fn2-c-source-control (fn2-core-c-source-control fn2-core))) (serial)
               (fn2-c-source-control-next-receipt 0 fn2-c-source-control) serial))
      ((mv applied fn2-core) (fn2-checkpoint-live-replace-finish-op fn2-core))
      (actual (stobj-let ((fn2-checkpoint-summary (fn2-core-checkpoint-summary fn2-core))
                         (fn2-c-source-control (fn2-core-c-source-control fn2-core))) (ok)
       (and (= (fn2-checkpoint-summary-phase 0 fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-applied*)
            (posp (fn2-checkpoint-summary-installed 0 fn2-checkpoint-summary))
            (= (fn2-checkpoint-summary-installed 0 fn2-checkpoint-summary) (fn2-checkpoint-summary-count 0 fn2-checkpoint-summary))
            (= (fn2-checkpoint-summary-phase 1 fn2-checkpoint-summary) *fn2-checkpoint-summary-phase-idle*)
            (= (fn2-c-source-control-phase 0 fn2-c-source-control) *fn2-c-source-writer-phase-idle*)
            (= serial (fn2-c-source-control-next-receipt 0 fn2-c-source-control))) ok)))
  (mv (and (eq applied :applied) actual) fn2-core fn2-sim fn2-own)))
(defun fn2-clf-test ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-core (with-local-stobj fn2-sim (with-local-stobj fn2-own
  (mv-let (ok fn2-core fn2-sim fn2-own) (fn2-clf-body fn2-core fn2-sim fn2-own) ok)))))
(assert-event (fn2-clf-test))

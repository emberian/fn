;;; Actual BP resume command and cleanup macro around budget-file admission.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(defun source-definition (path kind name)
  (with-open-file (stream path)
    (let* ((text (make-string (file-length stream)))
           (prefix (format nil "(~a ~a " kind name)))
      (read-sequence text stream)
      (let ((start (search prefix text)))
        (unless start (error "missing definition ~a" name))
        (read-from-string text nil nil :start start)))))
(defparameter +fnn-bp-lifetime+ 1)
(defparameter +fnn-bp-crc-type+ 1)
(defparameter +fnn-bp-hop-limit+ 1)
(defparameter +fnn-tcl-transfer-mru+ 1)
(defvar *fnn-bpnode-budgets* nil)
(defvar *mode* nil)
(defvar *released* 0)
(defvar *driven* 0)
(defun fnn-err (&rest args) (declare (ignore args)))
(defun fnn-bp-config (&rest args) (declare (ignore args)) :config)
(defun fnn-bps-open (&rest args) (declare (ignore args)) :service)
(defun fnn-bpnode-read-budgets (root)
  (declare (ignore root))
  (when (member *mode* '(:budget-fault :budget-and-close-fault)) (error "budget-fault"))
  :budget)
(defun fnn-bpnode-budgeted (event) (assert (eq *fnn-bpnode-budgets* :budget)) event)
(defun fnn-bps-foundation-step (service event)
  (assert (eq service :service)) (assert (equal event '(:operator-resume 17))) :effects)
(defun fnn-bps-drive-effects (service effects)
  (assert (eq service :service)) (assert (eq effects :effects)) (incf *driven*))
(defun fnn-bps-exit-code (service) (assert (eq service :service)) 3)
(defun fnn-bps-release (service)
  (assert (eq service :service)) (incf *released*)
  (when (eq *mode* :budget-and-close-fault) (error "close-fault")))
(eval (source-definition (or (sb-ext:posix-getenv "FN_CLEANUP_HOST_SOURCE") "host/native/io.lisp")
                         "defmacro" "fnn-unwind-cleanups"))
(eval (source-definition (or (sb-ext:posix-getenv "FN_BP_NODE_HOST_SOURCE") "host/native/bp-node.lisp")
                         "defun" "fnn-command-bp-node-resume"))
(dolist (mode '(:success :budget-fault :budget-and-close-fault))
  (let ((*mode* mode) (*released* 0) (*driven* 0) (*fnn-bpnode-budgets* nil))
    (let ((answer (handler-case (fnn-command-bp-node-resume "/bp" "node" 17 nil 0)
                    (error (e) (princ-to-string e)))))
      (assert (= *released* 1))
      (if (eq mode :success)
          (progn (assert (= answer 3)) (assert (= *driven* 1)))
        (progn (assert (equal answer "budget-fault")) (assert (= *driven* 0)))))))
(format t "BP resume budget acquisition cleanup passed (3 paths)~%")

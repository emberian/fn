; Source-executed actual generator, no ACL2/proof/cache process.
(defpackage "ACL2" (:use "CL"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun member-eq (x xs) (member x xs))
(defun nfix (x) (if (and (integerp x) (<= 0 x)) x 0))
(defun zp (x) (<= (nfix x) 0))
(defun intern-in-package-of-symbol (name symbol) (intern name (symbol-package symbol)))
(defun load-accessor-generator (path)
 (with-open-file (in path)
  (loop for form = (read in nil :eof) until (eq form :eof) do
   (when (and (eq (car form) 'defun)
              (member (cadr form) '(fn2-columns-sym fn2-columns-pre
                fn2-columns-col-name fn2-columns-width fn2-columns-fit
                fn2-columns-field-term fn2-columns-accessor-events)))
    (eval form)))))
(load-accessor-generator "books/columns.lisp")
(defun raw-fact-p (event)
 (and (eq (car event) 'defthm)
      (or (search "-RAW-NTH-NATP" (symbol-name (cadr event)))
          (search "-RAW-NTH-BOUND" (symbol-name (cadr event))))))
(defun without-hints (event)
 (if (not (raw-fact-p event)) event
  (let ((copy (copy-list event)))
   (remf (cdddr copy) :hints)
   copy)))
(defun check-case (cols)
 (let ((new (fn2-columns-accessor-events 'fn2-control cols 0 (length cols))))
  ; Each raw fact must reference the earlier public fact, not itself or an
  ; array predicate theorem, and keep exactly the accessor-only theory.
  (loop for event in new for index from 0 when (raw-fact-p event) do
   (let* ((raw-name (symbol-name (cadr event)))
          (suffix (if (search "-NATP" raw-name) "-NATP" "-BOUND"))
          (prefix (subseq raw-name 0 (search "-RAW-NTH-" raw-name)))
          (read (intern prefix "ACL2"))
          (public (intern (concatenate 'string prefix suffix) "ACL2"))
          (hints (getf (cdddr event) :hints)))
    (assert (find public (subseq new 0 index) :key #'cadr))
    (assert (equal hints
     `(("Goal" :in-theory (union-theories '(,read ,(intern (concatenate 'string prefix "$AI") "ACL2") fn2-control-rows)
                                         (theory 'minimal-theory))
               :use ((:instance ,public))))))))
  new))
(let* ((cols (loop for i below 70 collect
               (list (intern (format nil "F~D" i) "ACL2")
                     (nth (mod i 6) '(:u8 :u16 :u32 :u60 :link (:enum test-enum (:a :b)))))))
       (new (check-case cols))
       (current (symbol-function 'fn2-columns-accessor-events))
       (baseline (sb-ext:posix-getenv "FN_COLUMNS_BASELINE")))
 (assert (= (count-if #'raw-fact-p new) 140))
 (check-case nil)
 (check-case '((flag :bool)))
 (assert baseline)
 (load-accessor-generator baseline)
 (let ((old (fn2-columns-accessor-events 'fn2-control cols 0 (length cols))))
  (assert (equal (mapcar #'without-hints old) (mapcar #'without-hints new)))
  (assert (= (count-if-not #'identity (mapcar #'equal old new)) 140)))
 (setf (symbol-function 'fn2-columns-accessor-events) current))
(format t "COLUMNS RAW FACT CONTROLS PASS: 140 hints changed; all other generated forms exact.~%")

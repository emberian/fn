;;; Standalone selected SBCL primitive test: no ACL2/proof or installer claim.
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(let ((args (cdr sb-ext:*posix-argv*)))
  (sb-alien:load-shared-object (first args))
  (sb-alien:load-shared-object (second args))
  (load (third args)))
(sb-alien:define-alien-routine
    ("fn_fs_space_observe_test" fnn-%fs-space-observe-test) sb-alien:int
  (path sb-sys:system-area-pointer) (words sb-sys:system-area-pointer))
(sb-alien:define-alien-routine ("fn_fs_test_entered" fs-test-entered) sb-alien:int)
(sb-alien:define-alien-routine ("fn_fs_test_release" fs-test-release) sb-alien:void)
(defun fs-sample (path)
  (fnn-fs-observation-make (sb-ext:string-to-octets path :external-format :utf-8 :null-terminate t)))
(defun fs-read (sample) (multiple-value-list (fnn-fs-observation-readout sample)))
(defun fs-wide-fields (sample)
  (assert (equal (fs-read sample)
                 '(:returned 0 #x76543210 #xfedcba98 #x01234567 #x89abcdef))))
(let ((sample (fs-sample "/"))
      (missing (fs-sample "/fn-nonexistent-observation-test-20260930/no-such-path")))
  (unwind-protect
      (progn
        (assert (equal (fs-read sample) '(:unobserved 0 0 0 0 0)))
        (assert (eq :returned (fnn-fs-observe-into sample)))
        (assert (= 0 (fnn-fs-observation-code sample)))
        (assert (plusp (+ (third (fs-read sample)) (ash (fourth (fs-read sample)) 32))))
        (assert (eq :returned (fnn-fs-observe-into missing)))
        (assert (= -1 (fnn-fs-observation-code missing)))
        (format t "FS-OBSERVATION real success/failure PASS~%"))
    (fnn-fs-observation-release sample)
    (fnn-fs-observation-release missing)))

(let ((original (symbol-function 'fnn-%fs-space-observe)))
  (unwind-protect
      (progn
        (setf (symbol-function 'fnn-%fs-space-observe) #'fnn-%fs-space-observe-test)
        (let ((sample (fs-sample "wide")))
          (unwind-protect
              (progn
                (fnn-fs-observe-into sample)
                (fs-wide-fields sample)
                ;; A failed repeated observation cannot turn old data into success.
                (setf (sb-sys:sap-ref-8 (fnn-fs-observation-path-sap sample) 0) (char-code #\f))
                (fnn-fs-observe-into sample)
                (assert (equal (fs-read sample)
                               '(:returned -1 #x76543210 #xfedcba98 #x01234567 #x89abcdef)))
                (format t "FS-OBSERVATION wide fields/stale failure PASS~%"))
            (fnn-fs-observation-release sample)
            (assert (eq (fnn-fs-observation-status sample) :released))
            (assert (null (fnn-fs-observation-word-storage sample)))
            (fnn-fs-observation-release sample)))
        (let* ((sample (fs-sample "blocked"))
               (path (fnn-fs-observation-path-sap sample))
               (words (fnn-fs-observation-word-sap sample))
               (worker (sb-thread:make-thread (lambda () (fnn-fs-observe-into sample)))))
          (unwind-protect
              (progn
                (loop repeat 1000 until (= 1 (fs-test-entered)) do (sleep .001))
                (assert (= 1 (fs-test-entered)))
                (assert (eq :uncertain (fnn-fs-observation-status sample)))
                ;; This is a real full GC while the other thread is in a
                ;; controlled foreign wait, using the production C body.
                (assert (eq t (sb-kernel::sub-gc sb-vm:+pseudo-static-generation+)))
                (sb-kernel::post-gc)
                (assert (sb-thread:thread-alive-p worker))
                (assert (eq path (fnn-fs-observation-path-sap sample)))
                (assert (eq words (fnn-fs-observation-word-sap sample)))
                (fs-test-release)
                (assert (eq :returned (sb-thread:join-thread worker :timeout 5 :default :timed-out)))
                (fs-wide-fields sample)
                (format t "FS-OBSERVATION foreign wait/full GC/retained storage PASS~%"))
            (fs-test-release)
            (sb-thread:join-thread worker)
            (fnn-fs-observation-release sample)))
        (let ((sample (fs-sample "wide")))
          (unwind-protect
              (progn
                (setf (symbol-function 'fnn-%fs-space-observe)
                      (lambda (path words)
                        (fnn-%fs-space-observe-test path words)
                        (error "lost foreign acknowledgment")))
                (assert (eq :escaped (handler-case (fnn-fs-observe-into sample)
                                      (error () :escaped))))
                (assert (eq :uncertain (fnn-fs-observation-status sample)))
                (format t "FS-OBSERVATION lost acknowledgment retains uncertainty PASS~%"))
            (fnn-fs-observation-release sample))))
    (setf (symbol-function 'fnn-%fs-space-observe) original)))
(let ((out (fourth (cdr sb-ext:*posix-argv*))))
  (with-open-file (stream out :direction :output :if-exists :supersede)
    (let ((*standard-output* stream))
      (dolist (name '(fnn-%fs-space-observe fnn-fs-observe-into fnn-fs-observation-readout))
        (format t "~&SUBJECT ~s~%" name)
        (disassemble name)))))
(format t "FS-OBSERVATION-COMPONENT PASS~%")

(in-package "CL-USER")
(let* ((pool (list :pool))
       (gate (fnn-runtime-participants-install-for-image pool))
       (hooks 0) (finalizers 0) (worked 0) (completed 0)
       (binding (%fnn-runtime-cleanup-binding
                 gate :recording-cleanup
                 (lambda (subject) (assert (eq subject :recording-cleanup))
                   (values :admitted (list :recording-receipt)))
                 (lambda ()
                   (assert (handler-case
                               (fnn-with-runtime-participants-parked (gate pool) nil)
                             (serious-condition () t)))
                   (incf worked))
                 (lambda (receipt) (assert receipt) (incf completed) :completed)
                 (lambda (receipt cause) (declare (ignore receipt cause))
                   (error "unexpected-fence")))))
  (fnn-with-runtime-participants-parked (gate pool)
    (assert (compiled-function-p (fnn-runtime-participants-original gate))))
  (assert (handler-case
              (fnn-with-runtime-participants-parked (gate (list :wrong-pool)) nil)
            (serious-condition () t)))
  (let ((old-hooks sb-ext:*init-hooks*))
    (unwind-protect
         (progn
           (setf sb-ext:*init-hooks* (list (lambda () (error "unknown-hook-ran"))))
           (assert (handler-case (fnn-runtime-participants-register-image-hooks)
                     (serious-condition () t))))
      (setf sb-ext:*init-hooks* old-hooks)))
  (push (lambda () (incf hooks)) sb-ext:*after-gc-hooks*)
  (funcall (lambda ()
             (let ((object (list :queued-finalizer)))
               (sb-ext:finalize object (lambda () (incf finalizers))))))
  (sb-ext:gc :full t)
  (assert sb-impl::*finalizers-triggered*)
  (fnn-with-runtime-participants-parked (gate pool)
    (assert (zerop hooks))
    (assert (zerop finalizers)))
  (assert (eq :completed (fnn-runtime-participant-cleanup-one binding)))
  (assert (= worked completed 1))
  (assert (fnn-runtime-cleanup-binding-receipt binding))
  (fnn-with-runtime-participants-parked (gate pool)
    (assert (zerop hooks))
    (assert (zerop finalizers)))
  (let ((refusal (%fnn-runtime-cleanup-binding
                  gate :refused (lambda (subject) (declare (ignore subject)) (values :refused nil))
                  (lambda () (error "refused-body-ran"))
                  (lambda (receipt) (declare (ignore receipt))
                    (error "refused-complete-ran"))
                  (lambda (receipt cause) (declare (ignore receipt cause))
                    (error "refused-fence-ran")))))
    (assert (eq :refused (fnn-runtime-participant-cleanup-one refusal))))
  (let* ((cause (make-condition 'simple-error :format-control "fixed-failure"))
         (fenced 0)
         (failed (%fnn-runtime-cleanup-binding
                  gate :failed (lambda (subject) (declare (ignore subject))
                                 (values :admitted (list :retained-fault-receipt)))
                  (lambda () (error cause))
                  (lambda (receipt) (declare (ignore receipt))
                    (error "failed-complete-ran"))
                  (lambda (receipt observed)
                    (assert receipt) (assert (eq observed cause)) (incf fenced)))))
    (assert (eq cause (handler-case (fnn-runtime-participant-cleanup-one failed)
                        (serious-condition (observed) observed))))
    (assert (= fenced 1))
    (assert (fnn-runtime-cleanup-binding-receipt failed))
    (assert (eq cause (fnn-runtime-participants-fault gate)))
    (assert (handler-case
                (fnn-with-runtime-participants-parked (gate pool) nil)
              (serious-condition () t))))
  (fnn-runtime-participants-stop-and-join gate)
  (assert (null sb-impl::*finalizer-thread*))
  (format t "REAL-PARK-HOOK-CLEANUP-JOIN-PASS~%"))

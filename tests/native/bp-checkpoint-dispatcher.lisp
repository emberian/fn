;;; Standalone macro-boundary recording test. No ACL2/runtime qualification.
(unless (find-package "ACL2") (make-package "ACL2" :use '("COMMON-LISP")))
(in-package "ACL2")
(defvar *the-live-state* nil)
(defun user-stobj-alist (state) (declare (ignore state)) (error "unexpected lookup"))
(defun fnn-fault (message) (error "~A" message))
(defvar *recorded-pool* (list :recording-pool))
(defun fnn-live-page-read-pool () *recorded-pool*)
(load (merge-pathnames "../../host/native/bp-controller-registry.lisp" *load-truename*))
(defun rejected-macro-p (form)
  (handler-case (progn (macroexpand-1 form) nil) (error () t)))
(assert (rejected-macro-p '(fnn-core-bp-checkpoint-values 'fn-owner-bp-checkpoint-reserve c d f)))
(assert (rejected-macro-p '(fnn-core-bp-checkpoint-values fn-owner-bp-checkpoint-reserve c f)))
(assert (rejected-macro-p '(fnn-core-bp-checkpoint-values fn-owner-bp-checkpoint-fence-current c f extra)))
(assert (rejected-macro-p '(fnn-core-bp-checkpoint-values unknown-subject c f)))
(let ((evaluated 0) (*fnn-bp-checkpoint-reserve-callback* nil))
  (handler-case
      (fnn-core-bp-checkpoint-values fn-owner-bp-checkpoint-reserve
                                    (progn (incf evaluated) :c) :d 4)
    (error () nil))
  (assert (zerop evaluated)))
(let* ((*fnn-bp-controller-registry* (list :recording-registry))
       (seen nil)
       (*fnn-bp-checkpoint-reserve-callback*
        (lambda (controller demand fuel registry pool)
          (setf seen (list controller demand fuel registry pool))
          (values :recorded :token 2 registry pool))))
  (multiple-value-bind (word token left registry pool)
      (fnn-core-bp-checkpoint-values fn-owner-bp-checkpoint-reserve :c :d 4)
    (assert (equal seen (list :c :d 4 *fnn-bp-controller-registry* *recorded-pool*)))
    (assert (and (eq word :recorded) (eq token :token) (= left 2)
                 (eq registry *fnn-bp-controller-registry*) (eq pool *recorded-pool*)))))
(let* ((*fnn-bp-controller-registry* (list :recording-registry))
       (*fnn-bp-checkpoint-fence-callback*
        (lambda (controller fuel registry pool)
          (assert (and (eq controller :c) (= fuel 4)))
          (values :recorded-fence 3 registry pool))))
  (multiple-value-bind (word left registry pool)
      (fnn-core-bp-checkpoint-values fn-owner-bp-checkpoint-fence-current :c 4)
    (assert (and (eq word :recorded-fence) (= left 3)
                 (eq registry *fnn-bp-controller-registry*) (eq pool *recorded-pool*)))))
(format t "BP checkpoint dispatcher recording assertions passed~%")

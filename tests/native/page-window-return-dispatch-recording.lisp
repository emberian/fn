; Trusted source-body recording test. No ACL2/runtime/installer/join credit.
(require :sb-posix)
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(defvar *answers* nil)
(defvar *calls* 0)
(defvar *death-probes* 0)
(defvar *fnn-window-return-step* nil)
(defun fnn-fault (format-string &rest args) (error (apply #'format nil format-string args)))
(defun fnn-extent-window-p (token) (declare (ignore token)) t)
(defun fnn-core (&rest args) (declare (ignore args)) (incf *death-probes*) (error "unexpected death probe"))
(defun fnn-call (&rest args) (declare (ignore args)) (incf *calls*) (pop *answers*))
(defun fnn-live-page-window-workers () :same-workers)
(defun fnn-live-page-read-pool () :same-pool)
; Read ONLY the actual native subjects and actual retained worker declaration.
(with-open-file (in "host/native/extent.lisp")
 (loop for form = (read in nil :eof) until (eq form :eof) do
  (when (and (consp form)
    (or (and (eq (car form) 'defstruct) (consp (cadr form))
             (eq (caadr form) 'fnn-cold-worker))
        (and (eq (car form) 'defun)
             (member (cadr form) '(fnn-extent-registered-return-step
                                  fnn-extent-executor-actual-return
                                  fnn-extent-executor-observe-returned)))))
   (eval form)
   (when (and (eq (car form) 'defun)
              (eq (cadr form) 'fnn-extent-executor-observe-returned)) (return)))))
(let* ((token (list :full-window-token)) (row (list :retained-assignment))
       (result (list :retained-window-source))
       (worker (%make-fnn-cold-worker :token token :row row :result result :phase :working))
       (*fnn-window-return-step* #'fnn-extent-registered-return-step)
       (*answers* (list (list :yield nil 0 :same-workers :same-pool)
                       (list :yield nil 0 :same-workers :same-pool)
                       (list :returned (list :actual-core-returned-row) 8 :same-workers :same-pool))))
 (fnn-extent-executor-actual-return worker)
 (assert (eq (fnn-cold-worker-phase worker) :returning))
 (assert (eq (fnn-cold-worker-row worker) row))
 (assert (eq (fnn-cold-worker-result worker) result))
 (assert (not (fnn-extent-executor-observe-returned worker)))
 (assert (fnn-extent-executor-observe-returned worker))
 (assert (= *calls* 3)) (assert (= *death-probes* 0))
 (assert (eq (fnn-cold-worker-token worker) token))
 (assert (eq (fnn-cold-worker-result worker) result)))
(let* ((result (list :retained-debt))
       (worker (%make-fnn-cold-worker :token (list :full-token) :result result :phase :working))
       (*fnn-window-return-step* #'fnn-extent-registered-return-step)
       (*answers* (list (list :stale-bindings nil 64 :same-workers :same-pool))))
 (assert (handler-case (progn (fnn-extent-executor-actual-return worker) nil) (error () t)))
 (assert (eq (fnn-cold-worker-phase worker) :return-fenced))
 (assert (not (fnn-extent-executor-observe-returned worker)))
 (assert (eq (fnn-cold-worker-result worker) result)))
(format t "Actual source dispatcher recording PASS; no physical join or installer execution.~%")
(let* ((result (list :unknown-core-publication))
       (worker (%make-fnn-cold-worker :token (list :full-token) :result result :phase :working))
       (*fnn-window-return-step* (lambda (&rest args) (declare (ignore args)) (error "core escape"))))
 (assert (handler-case (progn (fnn-extent-executor-actual-return worker) nil) (error () t)))
 (assert (eq (fnn-cold-worker-phase worker) :return-fenced))
 (assert (not (fnn-extent-executor-observe-returned worker)))
 (assert (eq (fnn-cold-worker-result worker) result)))
(format t "Unknown callback cut retains fenced native custody PASS.~%")

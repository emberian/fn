;;; Actual ATS/connection callbacks and actual owner-gated macro. Scheduler
;;; decision/I/O functions are recordings. Installation is synthetic.
(in-package "ACL2")
(defvar *fnn-control-test-kind* nil)
(defvar *fnn-control-test-pool* nil)
(defvar *fnn-control-test-events* nil)
(defvar *fnn-owner-measure-label* nil)
(defmacro fnn-owner-measured ((label) &body body)
  (declare (ignore label)) `(progn ,@body))
(defun fnn-control-test-record (event)
  (assert (plusp (fn-prp-alloc-active-turns *fnn-control-test-pool*)))
  (push event *fnn-control-test-events*))
(defun fnn-owner-gate-check (gate) (declare (ignore gate)))
(defun fnn-owner-space-preobserve (service)
  (declare (ignore service)) (fnn-control-test-record :preobserve))
(defun fnn-owner-gate-enter (gate class)
  (declare (ignore gate class))
  (fnn-control-test-record :gate-enter)
  ;; No extent exclusion spans a scheduler wait. A competing thread can
  ;; acquire it, while the real active control receipt still prevents GC.
  (let ((waiter (sb-thread:make-thread
                  (lambda () (sb-thread:with-mutex (*fnn-extent-lock*) :acquired)))))
    (assert (eq :acquired (sb-thread:join-thread waiter :timeout 2 :default :timed-out))))
  (when (eq *fnn-control-test-kind* :gate-enter-error) (error "recorded entry failure"))
  (when (eq *fnn-control-test-kind* :draining)
    (fn-aec-pool-drain-internal *fnn-control-test-pool*))
  0)
(defun fnn-ms-since (start) (declare (ignore start)) 0)
(defun fnn-owner-gate-leave (gate class held waited)
  (declare (ignore gate class held waited))
  (fnn-control-test-record :gate-leave)
  ;; Operation may have settled or refused. Its outer control remains owed.
  (assert (= (fn-prp-alloc-active-turns *fnn-control-test-pool*)
             (if (eq *fnn-control-test-kind* :body-escape) 2 1)))
  (when (eq *fnn-control-test-kind* :gate-leave-error) (error "recorded cleanup failure")))
(defun fnn-owner-gate-abort (gate cause)
  (declare (ignore gate cause)) (fnn-control-test-record :gate-abort))
(defun fnn-owner-gate-fail-locked (service gate cause)
  (declare (ignore gate))
  (assert (sb-thread:holding-mutex-p (fnn-owner-service-lock service)))
  (setf (fnn-owner-service-stopping service) t)
  (error cause))

(defun fnn-control-test-run (control operation mio service kind)
  (fnn-with-owner-control-turn (control)
    (fnn-owner-gated (service :reader)
      (fnn-with-connection-operation
          ((nonce current-mio) operation
           (if (eq kind :bad-input) :invalid :reader) nil nil nil mio)
        (assert (= nonce 1))
        (fnn-control-test-record :operation-body)
        (assert (= (fn-prp-alloc-active-turns *fnn-control-test-pool*) 2))
        (multiple-value-bind (erp word token fuel mio1 pool state)
            (fnn-start-test-call
             (fnn-fixed-raw-callback 'fn-owner-index-connection-start)
             current-mio *fnn-control-test-pool*)
          (declare (ignore mio1 state))
          (assert (and (not erp) (eq word :reserved)
                       (equal token '(:connection-holder 3 1 0))))
          (when (eq kind :body-escape) (throw 'fnn-control-abandon :abandoned))
          (multiple-value-bind (released left backing pool1)
              (fn-icr-abort token fuel (fn-mio$c-provider mio) pool)
            (declare (ignore left backing pool1)) (assert (eq released :released)))
          (values :opened :second :third))))))

(dolist (kind '(:success :unavailable :body-yield :bad-input :draining
               :gate-enter-error :gate-leave-error :body-escape :entry-refusal))
  (multiple-value-bind (old-binding mio) (fnn-start-test-fixture kind)
    (let* ((pool (fnn-connection-turn-binding-pool old-binding))
           (slots (create-fn-allocation-turn-slots))
           (service (%make-fnn-owner-service :lock (sb-thread:make-mutex) :gate :recorded)))
      ;; Only this fixture installs the two slots; not a real funded installer.
      (multiple-value-bind (word same)
          (fn-ats-construct-internal '(:owner-control :connection-start) slots pool)
        (assert (and (eq word :constructed) (eq slots same))))
      (let ((control (fnn-owner-control-binding-make pool slots (if (eq kind :entry-refusal) 1 0)))
            (operation (fnn-connection-turn-binding-make pool slots 1)))
        (setf *fnn-control-test-kind* kind *fnn-control-test-pool* pool
              *fnn-control-test-events* nil)
        (let ((outcome (handler-case
                         (catch 'fnn-control-abandon
                           (multiple-value-list (fnn-control-test-run control operation mio service kind)))
                       (serious-condition () :fault))))
          (case kind
            ((:gate-enter-error :gate-leave-error :body-escape)
             (assert (eq outcome (if (eq kind :body-escape) :abandoned :fault)))
             (assert (eq (fn-prp-alloc-mode pool) :recovery))
             (assert (= (fn-prp-alloc-active-turns pool) (if (eq kind :body-escape) 2 1)))
             (assert (= (fn-ats-phasesi 0 slots) 2))
             (assert (= (fn-ats-noncesi 0 slots) 0))
             (when (eq kind :body-escape)
               (assert (eq (fn-omk-at 6 (fn-ibp-connection-pending (fn-mio$c-provider mio)))
                           :registered))
               (assert (eq (fn-omk-at 1 (fn-owner-connection-operation-ticket *the-live-state*))
                           :started))
               (assert (= (fn-ats-phasesi 1 slots) 3))
               (assert (= (fn-ats-noncesi 1 slots) 1))
               (assert (= (fn-prp-alloc-allocated pool) 80)))
             (when (eq kind :gate-leave-error)
               (assert (fnn-owner-service-stopping service))
               (assert (= (fn-ats-phasesi 1 slots) 0))))
            (:entry-refusal
             (assert (equal outcome '(:unsupported-slots 0)))
             (assert (null *fnn-control-test-events*))
             (assert (= (fn-prp-alloc-active-turns pool) 0))
             (assert (= (fn-prp-alloc-allocated pool) 20)))
            (otherwise
             (assert (= (fn-prp-alloc-active-turns pool) 0))
             (assert (= (fn-ats-phasesi 0 slots) 0))
             (assert (= (fn-ats-phasesi 1 slots) 0))
             (assert (eq (first *fnn-control-test-events*) :gate-leave))
             (if (eq kind :success)
                 (progn (assert (equal outcome '(:opened :second :third)))
                        (assert (= (fn-prp-alloc-allocated pool) 80)))
               (progn
                 (assert (eq (first outcome)
                             (case kind (:unavailable :unsupported-runtime)
                                        (:bad-input :refused) (otherwise :yield))))
                 (assert (not (member :operation-body *fnn-control-test-events*)))
                 (assert (= (fn-prp-alloc-allocated pool) (if (eq kind :draining) 30 40)))))))
          (let ((waiter (sb-thread:make-thread
                         (lambda ()
                           (sb-thread:with-mutex ((fnn-owner-service-lock service))
                             (sb-thread:with-mutex (*fnn-extent-lock*) :acquired))))))
            (assert (eq :acquired (sb-thread:join-thread waiter :timeout 2 :default :timed-out))))
          (format t "OWNER-CONTROL case ~s PASS~%" kind))))))
(format t "OWNER-CONTROL-TURN PASS 9 actual-core/caller cases~%")

; Recording execution of actual core bodies using mutable stobj/table shims.
; No ACL2 guard/refinement, raw table cut, family/allocator or native claim.
; Budget/demand are explicitly synthetic internal storage-test inputs.
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")
(declaim (declaration xargs))
(defun booleanp (x) (or (eq x t) (null x)))
(defun posp (x) (and (integerp x) (< 0 x)))
(defun natp (x) (and (integerp x) (<= 0 x)))
(defun nfix (x) (if (natp x) x 0))
(defun zp (x) (or (not (integerp x)) (<= x 0)))
(defun len (x) (length x))
(defun true-listp (x) (if (consp x) (true-listp (cdr x)) (null x)))
(defun implies (a b) (or (not a) b))
(defun member-eq (x xs) (member x xs :test #'eq))
(defun member-equal (x xs) (member x xs :test #'equal))
(defun fn-cbor-ag-car (x) (if (consp x) (car x) nil))
(defun fn-cbor-ag-cdr (x) (if (consp x) (cdr x) nil))
(defun fn-cbor-octetp (x) (and (integerp x) (<= 0 x 255)))
(defun update-nth (n v x) (let ((copy (copy-list x))) (setf (nth n copy) v) copy))
(defmacro mbe (&rest options) (getf options :exec))
(defmacro mv (&rest args) `(values ,@args))
(defmacro mv-let (names expr &body body) `(multiple-value-bind ,names ,expr ,@body))
(defmacro stobj-let (bindings outputs expr result)
 `(let ,bindings (multiple-value-bind ,outputs ,expr ,result)))
(defvar *recording-creators* 0)
(defun recording-stobj (form)
 (let* ((name (second form)) (fields (remove-if-not #'consp (cddr form)))
        (creator (intern (format nil "CREATE-~A" name))) (initial nil))
  (loop for field in fields for index from 0 do
   (let* ((reader (first field)) (options (rest field)) (type (getf options :type))
          (value (getf options :initially)) (writer (intern (format nil "UPDATE-~A" reader))))
    (cond
     ((and (consp type) (eq (car type) 'array))
      (push `(setf (gethash ,index object) (make-array ,(car (third type)) :initial-element ',value)) initial)
      (eval `(defun ,(intern (format nil "~AI" reader)) (at object) (aref (gethash ,index object) at)))
      (eval `(defun ,(intern (format nil "UPDATE-~AI" reader)) (at value object)
               (setf (aref (gethash ,index object) at) value) object)))
     ((and (consp type) (eq (car type) 'stobj-table))
      (push `(setf (gethash ,index object) (make-hash-table :test 'eq)) initial)
      (eval `(defun ,reader (object) (gethash ,index object)))
      (eval `(defun ,(intern (format nil "~A-BOUNDP" reader)) (key object)
               (nth-value 1 (gethash key (,reader object)))))
      ; Default thunk is lazy. Successful child installation is represented
      ; in this recording shim; unknown constructor/table cuts are NOT tested.
      (eval `(defmacro ,(intern (format nil "~A-GET" reader)) (key object default)
               `(multiple-value-bind (value present) (gethash ,key (,',reader ,object))
                 (if present value (setf (gethash ,key (,',reader ,object)) ,default))))))
     (t
      (let ((child (and (symbolp type) (intern (format nil "CREATE-~A" type)))))
       (push `(setf (gethash ,index object)
                   ,(if (and child (fboundp child)) `(,child) `',value)) initial))
      (eval `(defun ,reader (object) (gethash ,index object)))
      (eval `(defun ,writer (value object) (setf (gethash ,index object) value) object))))))
  (eval `(defun ,creator () (incf *recording-creators*)
           (let ((object (make-hash-table))) ,@(reverse initial) object)))))

(with-open-file (stream "books/ninep-session.lisp")
 (loop for form = (read stream nil :end) until (eq form :end) do
  (case (car form)
   (defstobj (recording-stobj form))
   (defun (when (member (second form)
     '(fn-9ps-fid-slotp fn-9ps-request-slotp fn-9ps-walk-finish-owned
       fn-9ps-drain-begin fn-9ps-quiesce-step fn-9ps-fid-bind-owned)) (eval form))))))
(dolist (entry '((fn-9ps-fids-length . 4) (fn-9ps-fid-phase-length . 5)
 (fn-9ps-selection-length . 6) (fn-9ps-fid-borrows-length . 7)
 (fn-9ps-tags-length . 8) (fn-9ps-request-phase-length . 9)
 (fn-9ps-request-receipt-length . 10) (fn-9ps-request-fid-slot-length . 11)
 (fn-9ps-request-borrow-length . 12)))
 (eval `(defun ,(car entry) (s) (length (gethash ,(cdr entry) s)))))


(defun review-held-session ()
 (let ((session (create-fn-ninep-session)))
  (update-fn-9ps-phase :base session)
  (update-fn-9ps-mount-phase :held session)
  (update-fn-9ps-mount-token '(:ninep-mount 7) session)
  (update-fn-9ps-mount-source '(:held-generation 9) session)
  (multiple-value-bind (word next)
   (fn-9ps-fid-bind-owned 0 1 '(:old-selection 9) session)
   (assert (eq word :bound)) next)))
(dolist (phase '(:base :draining-requests :draining-fids :mount-return-ready))
 (let ((session (review-held-session)))
  (unless (eq phase :base)
   (fn-9ps-drain-begin session)
   (unless (eq phase :draining-requests)
    ; Other reset phases explicitly supplied internal metadata witnesses.
    (update-fn-9ps-phase phase session)))
  (multiple-value-bind (word next)
   (fn-9ps-walk-finish-owned 0 0 1 1 1 '(:new-selection 9) session)
   (assert (eq word (if (eq phase :base) :walked :invalid-walk)))
   (assert (eq (fn-9ps-phase next) phase))
   (assert (eq (fn-9ps-mount-phase next) :held))
   (assert (equal (fn-9ps-mount-token next) '(:ninep-mount 7)))
   (assert (equal (fn-9ps-mount-source next) '(:held-generation 9)))
   (assert (equal (fn-9ps-fidsi 0 next) 1))
   (assert (eq (fn-9ps-fid-phasei 0 next) :walked))
   (assert (equal (fn-9ps-selectioni 0 next)
                  (if (eq phase :base) '(:new-selection 9) '(:old-selection 9)))))))
(format t "PASS proposed actual-body fix: actual fid bind followed by base walk completion; actual drain-begin completion and reset metadata phases refuse without changing selected fid/mount fields (recording only).~%")
; Corrupted metadata witness: normal return quiesces/clears fids first; this
; bypass deliberately retains walked while clearing the mount. NOT reachability.
(let ((session (review-held-session)))
 (update-fn-9ps-mount-phase :returned session)
 (update-fn-9ps-mount-token nil session)
 (update-fn-9ps-mount-source nil session)
 (multiple-value-bind (word next)
  (fn-9ps-walk-finish-owned 0 0 1 1 1 '(:new-selection 9) session)
  (assert (eq word :walked))
  (assert (eq (fn-9ps-mount-phase next) :returned)))
 (format t "LIMIT phase-only repair still accepts explicitly corrupted walked/base/lost-mount metadata; normal return clears fids first, no separate reachable mount-loss defect claimed.~%"))

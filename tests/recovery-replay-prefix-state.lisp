; SOURCE-ONLY carried invariant and proof obligations. Not admitted/certified.
; These scans are logical proof/fixture observers, never served operations.
; Every transition below is the actual fn2-recovery-replay-adopt consumer.
(in-package "ACL2")
(include-book "../books/recovery-selected-adopt")
(defun fn2-recovery-replay-position-owned-p (p epoch allocation kind owner fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (stobj-let ((fn2-extents (fn2-core-extents fn2-core))) (owned)
  (and (fn2-alloc-slotp p fn2-extents)
       (= (fn2-extents-state p fn2-extents) *fn2-extent-state-allocated*)
       (eq (fn2-alloc-handle-code p epoch allocation fn2-extents) :ok)
       (= (fn2-extents-owner-kind p fn2-extents) kind)
       (= (fn2-extents-owner-id p fn2-extents) owner)
       (= (fn2-extents-release-pending p fn2-extents) 0)) owned))
(defun fn2-recovery-replay-journal-owned-p (p commit epoch allocation fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (and (fn2-recovery-replay-position-owned-p p epoch allocation *fn2-commit-kind* commit fn2-core)
  (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (owned)
   (and (fn2-alloc-slotp p fn2-extents)
        (> (fn2-extents-installed-root p fn2-extents) 0)
        (fn2-alloc-edge-matchesp (+ 7 (* 2 p)) commit p epoch allocation :installed-root fn2-alloc-edges)) owned)))
(defun fn2-recovery-replay-canonical-chain-p (rank token journal commit je ja fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix rank)))
 (if (zp rank) (and (equal rank 0) (equal token 0))
  (mv-let (code p epoch allocation kind owner next)
   (fn2-recovery-payload-node journal commit je ja token rank fn2-core)
   (declare (ignore p epoch allocation kind owner))
   (and (eq code :ok)
    (fn2-recovery-replay-canonical-chain-p (- rank 1) next journal commit je ja fn2-core)))))
; CONSUMED is exactly COUNT-LEFT at the caller. Its actual nodes must already
; be owned. The residual canonical chain starts at precisely TOKEN,LEFT.
(defun fn2-recovery-replay-consumed-prefix-p (consumed cursor rank token left journal commit je ja fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil :measure (nfix consumed)))
 (if (zp consumed)
  (and (equal consumed 0) (equal cursor token) (equal rank left)
       (fn2-recovery-replay-canonical-chain-p rank cursor journal commit je ja fn2-core))
  (mv-let (code p epoch allocation kind owner next)
   (fn2-recovery-payload-node journal commit je ja cursor rank fn2-core)
   (and (eq code :ok)
        (fn2-recovery-replay-position-owned-p p epoch allocation kind owner fn2-core)
        (fn2-recovery-replay-consumed-prefix-p (- consumed 1) next (- rank 1)
         token left journal commit je ja fn2-core)))))
(defun fn2-recovery-replay-carried-prefix-p (id gen journal commit je ja tag fn2-core)
 (declare (xargs :stobjs fn2-core :verify-guards nil))
 (and (fn2-core-wfp fn2-core)
  (fn2-recovery-idp id fn2-core)
  (equal (fn2-machine-generation id fn2-core) gen)
  (equal (fn2-machine-phase id fn2-core) *fn2-recovery-machine-state-verify*)
  (equal (fn2-machine-rc-mode id fn2-core) *fn2-rec-mode-replay*)
  (equal (fn2-machine-pending id fn2-core) 0)
  (fn2-rp-current-unit-auth-p id gen fn2-core)
  (fn2-recovery-selected-current-p id fn2-core)
  (equal (fn2-machine-rc-pos id fn2-core) journal)
  (equal (fn2-machine-rc-commit id fn2-core) commit)
  (equal (fn2-machine-rc-base-tag id fn2-core) tag)
  (equal (fn2-recovery-cand-epoch journal fn2-core) je)
  (equal (fn2-recovery-cand-allocation journal fn2-core) ja)
  (stobj-let ((fn2-extents (fn2-core-extents fn2-core)) (fn2-alloc-edges (fn2-core-alloc-edges fn2-core))) (valid)
   (and (fn2-alloc-invp fn2-extents) (fn2-alloc-ownership-invp fn2-extents fn2-alloc-edges)) valid)
  (mv-let (code head count) (fn2-recovery-payload-head journal commit je ja fn2-core)
   (and (eq code :ok)
    (let ((stage (fn2-machine-rc-stage id fn2-core))
          (token (fn2-machine-rc-own-token id fn2-core))
          (left (fn2-machine-rc-own-left id fn2-core)))
     (if (member-equal stage '(5 6))
      (and (= token 0) (= left 0)
       (fn2-recovery-replay-canonical-chain-p count head journal commit je ja fn2-core))
      (and (member-equal stage '(7 8)) (natp left) (<= left count)
       (fn2-recovery-replay-journal-owned-p journal commit je ja fn2-core)
       (fn2-recovery-replay-consumed-prefix-p (- count left) head count token left
        journal commit je ja fn2-core))))))))

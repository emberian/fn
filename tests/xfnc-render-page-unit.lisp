; Empty caught-up pages at both cursor widths. Use the sender's actual
; TX writer and independent physical FNCT, K28 and batch receiver decoders.
(in-package "ACL2")
(include-book "../books/xfnc-render-page")

(defun fn2-xwr-run (position fn2-fields fn2-digests fn2-b3 fn2-pool)
 (declare (xargs :stobjs (fn2-fields fn2-digests fn2-b3 fn2-pool) :verify-guards nil))
 (b* ((fn2-fields (fn2-fields-init 256 fn2-fields))
      (fn2-digests (fn2-digests-init *fn2-digest-stride* fn2-digests))
      (fn2-b3 (fn2-b3-table-init 1 fn2-b3))
      (fn2-pool (fn2-pool-init '((1 . 4096)) 1 100 fn2-pool))
      (owner *fn2-conn-kind*) (mask (logior *fn2-nntp-state-tls* *fn2-nntp-state-authenticated* *fn2-nntp-state-peer*))
      ((mv reserve slot gen fn2-pool) (fn2-pool-reserve 0 owner 0 1 fn2-pool))
      ((mv start-code start frame fn2-fields fn2-pool)
       (fn2-xfnc-wire-begin 0 0 8 5 7 12 6 1 1 3 9 position position 0 0 mask
                            slot gen 0 1 fn2-fields fn2-digests fn2-pool))
      (filled (fn2-pool-fill-value slot fn2-pool))
      ((mv hash fn2-digests fn2-b3)
       (fn2-pool-block-hash 0 slot gen frame (- filled frame) owner 0 1 fn2-digests fn2-b3 fn2-pool))
      ((mv seal fn2-pool)
       (fn2-digest-store 32 (fn2-digest-slot 0 *fn2-b3-result*) slot gen filled owner 0 1 fn2-digests fn2-pool))
      (len (- (fn2-pool-fill-value slot fn2-pool) start))
      ((mv move moved fn2-pool) (fn2-xfnc-wire-copy start 0 len 0 slot gen 0 1 fn2-pool))
      ((mv trim fn2-pool) (fn2-pool-truncate slot gen len owner 0 1 fn2-pool))
      (line (- frame start))
      ((mv decimal & declared &) (fn2-gram-arg-digits 4 (- line 6) slot gen owner 0 1 fn2-pool))
      (bytes (fn2-pool-logical-octets len (fn2-pool-base slot fn2-pool) fn2-pool))
      (model (fn2-fnct-open (nthcdr line bytes) 4096))
      ((mv open kind payload fn2-fields fn2-digests fn2-b3)
       (fn2-fnct-open-pool-span 0 0 slot gen line len owner 0 1 fn2-fields fn2-digests fn2-b3 fn2-pool))
      (at (+ line *fn2-fnct-header-octets*))
      ((mv k28 rs re fn2-fields)
       (fn2-xfnc-get-batch-result-span 0 at (+ at payload) slot gen owner 0 1 fn2-fields fn2-pool))
      ((mv wrong & fn2-fields)
       (fn2-xfnc-get-batch-header 0 128 rs re 9 6 1 1 5 7 12 3 position slot gen owner 0 1 fn2-fields fn2-pool))
      ((mv batch tail fn2-fields)
       (fn2-xfnc-get-batch-header 0 128 rs re 8 6 1 1 5 7 12 3 position slot gen owner 0 1 fn2-fields fn2-pool))
      (cursor (fn2-fields-ref-off *fn2-xfnc-batch-header-field-cursor* fn2-fields))
      ((mv vcode version) (fn2-pool-read slot gen (+ 4 cursor) owner 0 1 fn2-pool))
      ((mv damage fn2-pool) (fn2-pool-write slot gen (- len 1) (logxor 1 (car (last bytes))) owner 0 1 fn2-pool))
      ((mv bad & & fn2-fields fn2-digests fn2-b3)
       (fn2-fnct-open-pool-span 0 0 slot gen line len owner 0 1 fn2-fields fn2-digests fn2-b3 fn2-pool)))
   (mv (and (eq reserve :ok) (eq start-code :ok) (eq hash :ok) (eq seal :ok)
            (eq move :done) (equal moved len) (eq trim :ok)
            (equal (take 4 bytes) '(50 57 48 32)) (equal (nth (- line 2) bytes) 13)
            (equal (nth (- line 1) bytes) 10) decimal (equal declared (- len line))
            (equal (take 2 model) '(:ok 28)) (eq open :ok) (equal kind 28)
            (eq k28 :ok) (eq batch :ok) (equal tail re) (eq wrong :scope)
            (eq vcode :ok) (equal version (if (unsigned-byte-p 32 position) 1 2))
            (eq damage :ok) (eq bad :frame))
       fn2-fields fn2-digests fn2-b3 fn2-pool)))

(defun fn2-xwr-check (position)
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-fields
  (mv-let (ok fn2-fields)
   (with-local-stobj fn2-digests
    (mv-let (ok fn2-fields fn2-digests)
     (with-local-stobj fn2-b3
      (mv-let (ok fn2-fields fn2-digests fn2-b3)
       (with-local-stobj fn2-pool
        (mv-let (ok fn2-fields fn2-digests fn2-b3 fn2-pool)
         (fn2-xwr-run position fn2-fields fn2-digests fn2-b3 fn2-pool)
         (mv ok fn2-fields fn2-digests fn2-b3)))
       (mv ok fn2-fields fn2-digests)))
     (mv ok fn2-fields)))
   ok)))

(assert-event (fn2-xwr-check 3))
(assert-event (fn2-xwr-check 4294967296))

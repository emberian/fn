; Actual ordinary pool transitions under an explicit synthetic configured
; credit-state antecedent. This does NOT admit or qualify pool-credit APIs.
(in-package "ACL2")
(include-book "../books/pool")
(include-book "std/util/bstar" :dir :system)
(defun-nx fn2-pfu-view (fn2-pool)
 (declare (xargs :stobjs fn2-pool))
 (list (fn2-pool-view fn2-pool) (fn2-pool-class-countsi 0 fn2-pool)
       (fn2-pool-class-headsi 0 fn2-pool) (fn2-pool-credit-configured fn2-pool)
       (fn2-pool-credit-group-count fn2-pool)
       (fn2-pool-credit-protectedi 0 fn2-pool)
       (fn2-pool-credit-purposei 0 fn2-pool)
       (fn2-pool-credit-phasei 0 fn2-pool)
       (fn2-pool-credit-group-noncei 0 fn2-pool)
       (fn2-pool-credit-group-owner-kindi 0 fn2-pool)
       (fn2-pool-credit-group-owner-sloti 0 fn2-pool)
       (fn2-pool-credit-group-owner-geni 0 fn2-pool)
       (fn2-pool-credit-demandi 0 fn2-pool)
       (fn2-pool-credit-availablei 0 fn2-pool)
 ))
(defun fn2-pfu-configuration-premisep (fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (and (fn2-poolp fn2-pool) (fn2-pool-wfp fn2-pool) (fn2-pool-semanticp fn2-pool)
      (equal (fn2-pool-nclasses fn2-pool) 1) (equal (fn2-pool-credit-configured fn2-pool) 1)
      (equal (fn2-pool-credit-group-count fn2-pool) 1)
      (equal (fn2-pool-credit-protected-length fn2-pool) 1)
      (equal (fn2-pool-credit-purpose-length fn2-pool) 1)
      (equal (fn2-pool-credit-phase-length fn2-pool) 1)
      (equal (fn2-pool-credit-group-nonce-length fn2-pool) 1)
      (equal (fn2-pool-credit-group-owner-kind-length fn2-pool) 1)
      (equal (fn2-pool-credit-group-owner-slot-length fn2-pool) 1)
      (equal (fn2-pool-credit-group-owner-gen-length fn2-pool) 1)
      (equal (fn2-pool-credit-demand-length fn2-pool) 1)
      (equal (fn2-pool-credit-available-length fn2-pool) 1)
      (equal (fn2-pool-credit-protectedi 0 fn2-pool) 2)
      (equal (fn2-pool-credit-purposei 0 fn2-pool) 1)
      (equal (fn2-pool-credit-phasei 0 fn2-pool) 0)
      (equal (fn2-pool-credit-group-noncei 0 fn2-pool) 0)
      (equal (fn2-pool-credit-group-owner-kindi 0 fn2-pool) 0)
      (equal (fn2-pool-credit-group-owner-sloti 0 fn2-pool) 0)
      (equal (fn2-pool-credit-group-owner-geni 0 fn2-pool) 0)
      (equal (fn2-pool-credit-demandi 0 fn2-pool) 2)
      (equal (fn2-pool-credit-availablei 0 fn2-pool) 2)
      (<= (fn2-pool-credit-protectedi 0 fn2-pool) (fn2-pool-class-countsi 0 fn2-pool))))
(defun fn2-pfu-body (fn2-pool)
 (declare (xargs :stobjs fn2-pool :verify-guards nil))
 (b* ((fn2-pool (fn2-pool-init '((6 . 4096)) 1 100 fn2-pool))
      ; Explicit valid idle working-group premise; no call to unqualified
      ; credit configure/begin/reserve/return is made in this fixture.
      (fn2-pool (resize-fn2-pool-credit-protected 1 fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-purpose 1 fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-phase 1 fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-group-nonce 1 fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-group-owner-kind 1 fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-group-owner-slot 1 fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-group-owner-gen 1 fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-demand 1 fn2-pool))
      (fn2-pool (resize-fn2-pool-credit-available 1 fn2-pool))
      (fn2-pool (update-fn2-pool-credit-protectedi 0 2 fn2-pool))
      (fn2-pool (update-fn2-pool-credit-purposei 0 1 fn2-pool))
      (fn2-pool (update-fn2-pool-credit-phasei 0 0 fn2-pool))
      (fn2-pool (update-fn2-pool-credit-group-noncei 0 0 fn2-pool))
      (fn2-pool (update-fn2-pool-credit-group-owner-kindi 0 0 fn2-pool))
      (fn2-pool (update-fn2-pool-credit-group-owner-sloti 0 0 fn2-pool))
      (fn2-pool (update-fn2-pool-credit-group-owner-geni 0 0 fn2-pool))
      (fn2-pool (update-fn2-pool-credit-demandi 0 2 fn2-pool))
      (fn2-pool (update-fn2-pool-credit-availablei 0 2 fn2-pool))
      (fn2-pool (update-fn2-pool-credit-group-count 1 fn2-pool))
      (fn2-pool (update-fn2-pool-credit-configured 1 fn2-pool))
      ((unless (and (fn2-pfu-configuration-premisep fn2-pool)
                    (equal (fn2-pool-reservable-count 0 fn2-pool) 4))) (mv nil fn2-pool))
      ((mv c0 s0 g0 fn2-pool) (fn2-pool-reserve 0 9 0 1 fn2-pool))
      ((mv c1 s1 g1 fn2-pool) (fn2-pool-reserve 0 9 1 1 fn2-pool))
      ((mv c2 s2 g2 fn2-pool) (fn2-pool-reserve 0 9 2 1 fn2-pool))
      ((mv c3 s3 g3 fn2-pool) (fn2-pool-reserve 0 9 3 1 fn2-pool))
      ((unless (and (eq c0 :ok) (eq c1 :ok) (eq c2 :ok) (eq c3 :ok)
                    (no-duplicatesp-equal (list s0 s1 s2 s3))
                    (fn2-pfu-configuration-premisep fn2-pool)
                    (equal (fn2-pool-class-countsi 0 fn2-pool) 2)
                    (equal (fn2-pool-reservable-count 0 fn2-pool) 0))) (mv nil fn2-pool))
      (before (fn2-pfu-view fn2-pool))
      ((mv refused & & fn2-pool) (fn2-pool-reserve 0 9 4 1 fn2-pool))
      ((unless (and (eq refused :exhausted) (equal before (fn2-pfu-view fn2-pool)))) (mv nil fn2-pool))
      ((mv returned fn2-pool) (fn2-pool-release s0 g0 9 0 1 fn2-pool))
      ((unless (and (eq returned :ok) (fn2-pfu-configuration-premisep fn2-pool)
                    (equal (fn2-pool-class-countsi 0 fn2-pool) 3)
                    (equal (fn2-pool-reservable-count 0 fn2-pool) 1))) (mv nil fn2-pool))
      ((mv reacquired s4 g4 fn2-pool) (fn2-pool-reserve 0 9 4 1 fn2-pool))
      (before (fn2-pfu-view fn2-pool))
      ((mv stale fn2-pool) (fn2-pool-release s0 g0 9 0 1 fn2-pool)))
  (mv (and (eq reacquired :ok) (equal s4 s0) (< g0 g4) (eq stale :stale)
           (equal before (fn2-pfu-view fn2-pool))
           (fn2-pfu-configuration-premisep fn2-pool)
           (equal (fn2-pool-class-countsi 0 fn2-pool) 2)
           (equal (fn2-pool-credit-protectedi 0 fn2-pool) 2)) fn2-pool)))
(defun fn2-pfu-run ()
 (declare (xargs :verify-guards nil))
 (with-local-stobj fn2-pool (mv-let (ok fn2-pool) (fn2-pfu-body fn2-pool) ok)))
(assert-event (fn2-pfu-run))

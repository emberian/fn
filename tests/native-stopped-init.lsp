;;; Exercise the actual host startup wrapper with controlled core and I/O seams.
(defpackage "ACL2" (:use "COMMON-LISP"))
(in-package "ACL2")

(with-open-file (source "host/adapter.lisp")
  (loop for form = (read source nil nil) while form
        when (and (consp form) (eq (car form) 'defun)
                  (eq (cadr form) 'fn2-n-make-host))
          do (eval form) (return)
        finally (error "Missing actual fn2-n-make-host")))

(defvar *calls* nil)
(defvar *refused* nil)
(defun fn2-image-profile (profile)
  (push :image-profile *calls*)
  (cons :image profile))
(defun fn2-n-live-core ()
  (push :core *calls*)
  :fixture-core)
(defun fn2-init-executor (profile mode scribe core)
  (assert (and (member profile '((:fixture) (:image :fixture)) :test #'equal)
               (eq mode :echo) (not scribe) (eq core :fixture-core)))
  (push :init *calls*)
  core)
(defun fn2-host-stopped-p (core)
  (assert (eq core :fixture-core))
  (push :stopped-p *calls*)
  *refused*)
(defun fn2-host-stop-reason (core)
  (assert (eq core :fixture-core))
  (push :reason *calls*)
  17)
(defun fn2-n-open-host (profile core &rest options)
  (assert (eq core :fixture-core))
  (push (list :open profile options) *calls*)
  :fixture-host)

(dolist (image '(nil "fixture.img"))
  (let* ((*calls* nil)
         (*refused* t)
         (result (handler-case (fn2-n-make-host '(:fixture) :device-path image)
                   (error (condition) (princ-to-string condition))))
         (prefix (append (when image '(:image-profile)) '(:core :init :stopped-p))))
    (assert (equal result "fn2 executor initialization stopped: 17"))
    (assert (equal (reverse *calls*) (append prefix '(:reason)))))
  (let ((*calls* nil)
        (*refused* nil))
    (assert (eq (fn2-n-make-host '(:fixture) :device-path image :create-size (and image 4096)
                                :control-fd 5 :trace-capacity 8 :kill-at 9)
                :fixture-host))
    (assert (equal (reverse *calls*)
                   (append
                    (when image '(:image-profile))
                    '(:core :init :stopped-p)
                    (list (list :open (if image '(:image :fixture) '(:fixture))
                                (list :control-fd 5 :trace-capacity 8 :kill-at 9
                                      :device-path image :create-size (and image 4096)))))))))
